(module aslExamples/tests/examplesATest
  :x [runTests]
  :i [(aslExamples/optionExample :a optionExample)
      (aslExamples/resultExample :a resultExample)
      (aslExamples/recordExample :a recordExample)
      (aslExamples/enumExample :a enumExample)
      (aslExamples/foldExample :a foldExample)])

fn runTests -> Bool
  (let [(xs (list 4 5))
        (m (mapSet (mapEmpty) "k" 5))
        (cart (recordExample/newCart "ann"))
        (cart2 (recordExample/addItem cart 10))]
    (assert (= (optionExample/firstOrZero xs) 4) "listHead some")
    (assert (= (optionExample/firstOrZero (list)) 0) "listHead none")
    (assert (= (optionExample/lookupOr m "k" 0) 5) "mapGet some")
    (assert (= (optionExample/lookupOr m "z" 7) 7) "mapGet none")
    (assert (= (optionExample/describe (list 9)) "head 9") "describe some")
    (assert (= (optionExample/describe (list)) "empty") "describe none")
    (assert (= (resultExample/parsePositive 4) (ok 4)) "parsePositive ok")
    (assert (= (resultExample/parsePositive 0) (err "not positive")) "parsePositive err")
    (assert (= (resultExample/half 8) (ok 4)) "result match")
    (assert (= (resultExample/halfOr -1 3) 3) "resultOr err")
    (assert (= (resultExample/describe (resultExample/parsePositive 2)) "ok 2") "describe ok")
    (assert (= (recordExample/totalOf cart) 0) "record literal")
    (assert (= (recordExample/totalOf cart2) 10) "field read")
    (assert (= (recordExample/totalOf (recordExample/clearCart cart2)) 0) "with")
    (assert (= (recordExample/label cart2) "ann:10") "label")
    (assert (= (enumExample/area (enumExample/circle 3)) 9) "circle")
    (assert (= (enumExample/area (enumExample/dot)) 0) "dot")
    (assert (= (enumExample/describe (enumExample/square 2)) "square 2") "square")
    (assert (= (foldExample/sumOf (list 1 2 3)) 6) "fold")
    (assert (= (foldExample/product (list 2 3 4)) 24) "fold product")
    (assert (= (foldExample/doubled (list 1 2)) (list 2 4)) "map")
    (assert (= (foldExample/evens (list 1 2 3 4)) (list 2 4)) "filter")
    true)
