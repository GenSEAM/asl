(
  :id "option-result-combinators"
  :src "grammar/corpus/valid/21-option-result-combinators.asl"
  :entry "resolve"
  :cases [
    [
      ["21" 0]
      "ok:43|43|43"
      "optionMap before resultMap: double-then-increment is 43, the other order is 44"
    ]
    [
      ["x" 5]
      "err:E<bad:x>|FB|5"
      "resultMapErr replaced by the identity or by resultMap both give err:bad:x; and the fallback arms of resultOr and resultToOption"
    ]
    [
      ["" 9]
      "err:E<bad:>|FB|9"
      "an empty token still reaches the error path, and (str \"bad:\" \"\") is not \"bad\""
    ]
  ]
)
