(:doc :symbol "asl/agentLoop/grounding.asl#wantsAslCard" :text "true when the task or a gate names an .asl file")
(:doc :symbol "asl/agentLoop/grounding.asl#hintCodes" :text "receipt error codes that get an (:expect) form next turn")
(:doc :symbol "asl/agentLoop/grounding.asl#rejectedReceipts" :text "for each rejected receipt line of a turn's got: op, error code, file and accepted keys")
(:doc :symbol "asl/agentLoop/grounding.asl#rejectHints" :text "one (:expect :op :error :form [:accepted] [:example]) line per distinct op and error among hintCodes")
(:doc :symbol "asl/agentLoop/grounding.asl#lastGot" :text "the got text of the newest loop history entry, empty when there is none")
(:doc :symbol "asl/agentLoop/providers.asl#capTimeouts" :text "a vendor provider whose queue and call timeouts fit in the given seconds left of the wall budget; other providers unchanged")
(:doc :symbol "asl/agentLoop/gateIntegrity.asl#gateIntegrityWritten!" :text "gateIntegrity! over the owned files git reports changed plus the files Leon wrote, so a gitignored write still gets the revert check")
(:doc :symbol "asl/agentLoop/gateIntegrity.asl#testFile?" :text "a path under tests/ or named *Test.*, test_* or *_test.*")
(:doc :symbol "asl/agentLoop/gateIntegrity.asl#implFiles" :text "the changed files that are code under test: neither named by a gate command nor a test file")
(:doc :symbol "asl/agentLoop/gateIntegrity.asl#vacuousForm" :text "the (:gateVacuous :gates (...) :files (...) :passesOnRevert true :do ...) line revertVerdict added to a failed revert check, the one form the writer gets; none when the check passed or failed for another cause")
(:doc :symbol "asl/agentLoop/gateIntegrity.asl#revertVerdict" :text "gates gateRevertVerdict, plus a second message line with the (:gateVacuous ...) form built from the results when no gate failed on revert and some passed, so names with ; , quotes or backslashes reach the writer whole")
(:doc :symbol "asl/agentLoop/gateIntegrity.asl#gateVacuousRounds" :text "the :agentLoop :gateVacuousRounds cap of a config text, a positive integer, default 2: how many finished turns with a gate green on revert go back to the writer before the run ends failed with signal gateIntegrity")
(:doc :symbol "asl/agentLoop/gateIntegrity.asl#vacuousRetry" :text "vacuousForm while the rounds sent are under the cap, else none so the run ends failed with signal gateIntegrity as before")
(:doc :symbol "asl/agentLoop/tests/gateVacuousTest.asl#runTests" :text "the revert check of journal 983e37bce8bba22c becomes one form naming sizedRtTest and sizedRt.asl; other causes send nothing; the cap stops the retry; :gateVacuousRounds is read from config, checked by configProblems")
(:doc :symbol "asl/agentLoop/gitOps.asl#runGatesWatched!" :text "runGates! that kills a gate group like a timeout once the watched pid is gone, checked every half second")
(:doc :symbol "asl/agentLoop/providers.asl#configPathRefusal" :text "the typed ERR_CONFIG_PATH refusal for an in-process gateway config path not ending /.asl/gateway.asn; names the rule (the secrets file, ledger and sessions derive from that HOME), the rejected path and the way out")
(:doc :symbol "asl/agentLoop/gitOps.asl#scratchTree!" :text "a scratch copy of root for judging an answer: a detached git worktree at HEAD plus the uncommitted tracked diff and the untracked unignored files when root is a worktree top, else a plain copy; ok names which kind")
(:doc :symbol "asl/agentLoop/gitOps.asl#scratchDrop!" :text "removes a scratch tree made by scratchTree! and its patch file, pruning the git worktree when its kind is worktree")
(:doc :symbol "asl/agentLoop/gitOps.asl#gitText!" :text "stdout of a bounded argv run in cwd when it exits 0, else none")
(:doc :symbol "asl/agentLoop/main.asl#withRemote" :text "adds the unit the remote param names to an op's params")
(:doc :symbol "asl/agentLoop/main.asl#parentWatch!" :text "starts a forked watcher that ends the run when the parent pid is gone, or none when no parent is set")
(:doc :symbol "asl/agentLoop/main.asl#parentUnwatch!" :text "stops a watcher started by parentWatch!, true when none was running")
(:doc :symbol "asl/agentLoop/pool.asl#withPoolParent" :text "the form text with the pool's parent pid param set")
(:doc :symbol "asl/agentLoop/remoteOps.asl#remoteOpNames" :text "the op names routed to a remote unit")
(:doc :symbol "asl/agentLoop/remoteOps.asl#remoteUnit" :text "the remote unit named by an op's params, empty when the op runs locally")
