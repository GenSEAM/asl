(:doc :symbol "asl/agentLoop/tests/diffTest.asl#opcodeEq" :text "b2: [('insert', 0, 0, 0, 1), ('equal', 0, 1, 1, 2), ('insert', 1, 1, 2, 200)]\nPython version: 3.14.7\nGenerator command:\npython3 -c 'import difflib; a = [\"k\"]; b1 = [\"x\"] + [\"k\"]*3 + [\"x\"]*196; b2 = [\"x\"] + [\"k\"]*2 + [\"x\"]*197; print(\"b1:\", difflib.SequenceMatcher(None, a, b1, autojunk=True).get_opcodes()); print(\"b2:\", difflib.SequenceMatcher(None, a, b2, autojunk=True).get_opcodes())'\nGenerator output:\nb1: [('insert', 0, 0, 0, 1), ('equal', 0, 1, 1, 2), ('insert', 1, 1, 2, 200)]")
