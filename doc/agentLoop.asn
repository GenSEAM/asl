(:doc :symbol "asl/agentLoop/tests/coreEchoTest.asl#runTests" :text "echoed loop frames are detected and stripped from a reply")
(:doc :symbol "asl/agentLoop/tests/frameTest.asl#runTests" :text "the context frame renders within its token ceiling and refuses egress")
(:doc :symbol "asl/agentLoop/tests/leonVerdictTest.asl#runTests" :text "the verdict row Leon reports for a run")
(:doc :symbol "asl/agentLoop/tests/replySpellingTest.asl#runTests" :text "reply spellings of ops are accepted as their canonical forms")
(:doc :symbol "asl/agentLoop/tests/stablePrefixTest.asl#runTests" :text "the system prompt prefix is stable across sessions and tasks")
(:doc :symbol "asl/agentLoop/tests/writeAliasTest.asl#runTests" :text "write and edit shorthands are accepted and shown canonically")
(:doc :symbol "asl/agentLoop/sessionPool.asl#Exec" :text "a local process a turn asks for in place of a hub request: argv, working directory, env, timeout in seconds and descendant limit")
(:doc :symbol "asl/agentLoop/sessionPool.asl#Pool" :text "the session pool: hub socket, slots in flight, memory cap, idle ttl, spill directory, the active, exec and waiting sessions, finished results and the peak counts of in-memory and spilled sessions")
(:doc :symbol "asl/agentLoop/sessionPool.asl#Sess" :text "one session: id, state string, the request its next turn sends, hub fd and read buffer, last activity, tries, hold-until time, busy count, an optional guarded local process and the spill file when parked on disk")
(:doc :symbol "asl/agentLoop/sessionPool.asl#Turn" :text "what a turn function returns for a (state, reply): the next state and either the next request body, a local exec, or the final result, plus headers, a busy flag and a hold time")
(:doc :symbol "asl/agentLoop/sessionPool.asl#asnQuote" :text "text as a quoted ASN string with backslash, quote and newline escaped")
(:doc :symbol "asl/agentLoop/sessionPool.asl#execReply" :text "the (:exec :exit :out :err) reply text a turn function gets for a finished local process")
(:doc :symbol "asl/agentLoop/sessionPool.asl#httpRequest" :text "the HTTP POST of a chat request to the hub: the given headers without framing ones, an X-Asl-Unit header with the session id unless one is present, and the body")
(:doc :symbol "asl/agentLoop/sessionPool.asl#newPool" :text "an empty pool for a hub socket with at least one slot and non-negative memory cap and ttl")
(:doc :symbol "asl/agentLoop/sessionPool.asl#pickNext" :text "the next waiting session to start: among those whose hold time has passed, a warm one if any, and the oldest of them")
(:doc :symbol "asl/agentLoop/sessionPool.asl#poolDone" :text "the finished (id, result) pairs held in the pool")
(:doc :symbol "asl/agentLoop/sessionPool.asl#poolIdle?" :text "true when no session is active, executing or waiting")
(:doc :symbol "asl/agentLoop/sessionPool.asl#poolKnown?" :text "true when a session id is active, executing or waiting in the pool")
(:doc :symbol "asl/agentLoop/sessionPool.asl#poolMemCount" :text "how many waiting sessions are held in memory rather than spilled")
(:doc :symbol "asl/agentLoop/sessionPool.asl#poolStep!" :text "one non-blocking step of the pool: reads ready replies, advances local execs and admits waiting sessions up to the slots; the turn function maps (state, reply) to a Turn")
(:doc :symbol "asl/agentLoop/sessionPool.asl#poolStepG!" :text "poolStep! with a threaded value: the turn function also takes and returns a value d, so the caller can accumulate results; returns the pool and the final value")
(:doc :symbol "asl/agentLoop/sessionPool.asl#poolSubmit!" :text "adds a session in the waiting list with an empty request; its first turn call with an empty reply makes its first request when it is admitted")
(:doc :symbol "asl/agentLoop/sessionPool.asl#poolTakeDone" :text "returns the finished results and a pool with them cleared")
(:doc :symbol "asl/agentLoop/sessionPool.asl#poolWatch" :text "the (fd, 1) pairs to poll: each active session's hub fd and the fds of guarded local processes")
(:doc :symbol "asl/agentLoop/sessionPool.asl#spilledCount" :text "how many waiting sessions are spilled to a file")
(:doc :symbol "asl/agentLoop/poolServe.asl#Serve" :text "the pool process state: listener fd, open control connections, the pool, the receipt directory and the stop flag")
(:doc :symbol "asl/agentLoop/poolServe.asl#newServe" :text "a Serve for a listener fd, a pool and a receipt directory, with no connections and not stopping")
(:doc :symbol "asl/agentLoop/poolServe.asl#serveStep!" :text "one non-blocking step: accepts a connection, steps each connection's line handling, steps the pool and writes finished sessions to receipt files")
(:doc :symbol "asl/agentLoop/poolServe.asl#serveWatch" :text "the (fd, 1) pairs to poll: the listener, each connection and the pool's fds")
(:doc :symbol "asl/agentLoop/poolServe.asl#handleLine!" :text "answers one control line: submit queues a session (queued, or refused for no unit, bad id or duplicate), receipt answers running, done with the file, or unknown, status gives the counters, stop ends the serve")
(:doc :symbol "asl/agentLoop/poolServe.asl#validId?" :text "true when a unit id is 1 to 96 bytes of letters, digits, dot, dash and underscore with no leading dot, since it becomes a file name")
(:doc :symbol "asl/agentLoop/poolServe.asl#quotedAfter" :text "the quoted string after a key in a line, none when the key is absent")
(:doc :symbol "asl/agentLoop/poolServe.asl#asnQuote" :text "asnQuote of the session pool, re-exported for control replies")
(:doc :symbol "asl/agentLoop/poolServe.asl#receiptPath" :text "path of a unit's receipt file, its id under the receipt directory")
(:doc :symbol "asl/agentLoop/providers.asl#HubCall" :text "a request prepared for the hub: socket path, request body and headers")
(:doc :symbol "asl/agentLoop/providers.asl#Ask" :text "the cut turn: askDone with the finished Turn, or askHub with the provider and the exact HubCall to send")
(:doc :symbol "asl/agentLoop/providers.asl#askDone" :text "an Ask carrying a turn already complete, no hub call needed")
(:doc :symbol "asl/agentLoop/providers.asl#askHub" :text "an Ask carrying the provider (turn already counted) and the hub call to send")
(:doc :symbol "asl/agentLoop/providers.asl#nextTurnAsk!" :text "runs a turn up to the hub post: returns askHub with the body when the call goes to the hub socket, askDone otherwise")
(:doc :symbol "asl/agentLoop/providers.asl#nextTurnReply" :text "finishes a cut turn from the hub's raw answer, logs usage, and falls back to a no-tools provider when the hub rejected tools")
(:doc :symbol "asl/agentLoop/providers.asl#hubBusy?" :text "true when a turn failed with Hub HTTP error 503, which means wait, not failure")
(:doc :symbol "asl/agentLoop/providers.asl#acceptHeader" :text "the Accept: application/json header when tools are offered so the reply keeps its tool_calls, none otherwise")
(:doc :symbol "asl/agentLoop/providers.asl#outgoingMessages" :text "the messages a vendor provider would send on the profile chat call, from system, user and the prefill")
(:doc :symbol "asl/agentLoop/providers.asl#profileMessages" :text "the system and user messages followed by an assistant prefill message when the prefill is not empty")
(:doc :symbol "asl/agentLoop/providers.asl#retryAfterSec" :text "the seconds in a [retry-after=N] marker of an error message, 0 when absent")
(:doc :symbol "asl/agentLoop/providers.asl#withPrefill" :text "the provider with an assistant prefill set; other provider kinds unchanged")
(:doc :symbol "asl/agentLoop/providers.asl#withTools" :text "the provider with the offered tool list set; other provider kinds unchanged")
(:doc :symbol "asl/agentLoop/nativeTools.asl#ShapeParam" :text "one parameter of an op shape: key, kind and whether it is required")
(:doc :symbol "asl/agentLoop/nativeTools.asl#ShapeTool" :text "one tool derived from an op shape: name, whether it is the single step tool, the shape text and its parameters")
(:doc :symbol "asl/agentLoop/nativeTools.asl#callForm" :text "the ASN form text for one tool call: the form argument for the step tool, otherwise an op or terminal head (done, escalate) built from the call's arguments")
(:doc :symbol "asl/agentLoop/nativeTools.asl#callsText" :text "the reply text for the parser from a native-tools turn: the forms of every tool call in order after any text content")
(:doc :symbol "asl/agentLoop/nativeTools.asl#shapeTool" :text "parses an op shape text into a ShapeTool, none when it is empty")
(:doc :symbol "asl/agentLoop/nativeTools.asl#stepToolSpec" :text "the JSON function spec of the single step(form) tool")
(:doc :symbol "asl/agentLoop/nativeTools.asl#systemHint" :text "the system prompt line naming the tools channel, empty when the setting is off or false")
(:doc :symbol "asl/agentLoop/nativeTools.asl#toolSpecs" :text "one JSON function spec per offered op shape, named by the op")
(:doc :symbol "asl/agentLoop/nativeTools.asl#toolsHint" :text "the line appended to the system prompt when tools are offered: call them, one op per call, no prose")
(:doc :symbol "asl/agentLoop/nativeTools.asl#validTools?" :text "true for the accepted :tools values: empty, off, false, ops, step")
(:doc :symbol "asl/agentLoop/txn.asl#expectedModule" :text "the module name a path calls for: asl/tools/X gives asl-tools/X, asl/packages/P/src or tests/X gives P/X, otherwise the path without .asl")
(:doc :symbol "asl/agentLoop/txn.asl#importsOf" :text "the module names in the :i [ ... ] list of a source text, the first word of each item")
(:doc :symbol "asl/agentLoop/txn.asl#moduleHints" :text "a hint for staged .asl writes whose module header cannot belong to the file: the module's last segment is not the file's base name, or two writes of the txn declare one module; empty when all are fine")
(:doc :symbol "asl/agentLoop/txn.asl#moduleOf" :text "the module a source text declares: the first word after (module when the text starts with it, else empty")
(:doc :symbol "asl/agentLoop/txn.asl#orderSubs" :text "re-slots the .asl write steps of a txn by their imports so each file resolves against the others whatever order the model wrote them; nothing moves for fewer than two writes, an edit step targeting a file the txn also writes, or an order that already holds")
(:doc :symbol "asl/agentLoop/txn.asl#txnSubs" :text "the sub-forms of a txn form, the inner forms that start with (:")
(:doc :symbol "asl/agentLoop/leonPool.asl#Book" :text "the book of live runs: a list of (session id, Live) pairs")
(:doc :symbol "asl/agentLoop/leonPool.asl#Live" :text "one live Leon run in the pool: its session, wrapped provider run, the outstanding ask if any, provider, exit code, retries, remaining time and the time of the ask")
(:doc :symbol "asl/agentLoop/leonPool.asl#leonExit" :text "the exit code recorded for a session id in the book, -1 when it is not there")
(:doc :symbol "asl/agentLoop/leonPool.asl#leonOpen!" :text "starts a run: the invocation form goes through the CLI check chain, then journal, provider, system prompt, loop env and baseline are set up as the blocking path does; a rejected or early-finished run comes back as its result, a ready one is added to the book and its id is for the caller to submit to the pool")
(:doc :symbol "asl/agentLoop/leonPool.asl#leonTurn!" :text "the pool's turn function: the state is the session id; an empty reply starts or continues the run, any other text is the raw hub answer to the ask the run left outstanding, and a 503 keeps the ask and waits")
(:doc :symbol "asl/agentLoop/journal.asl#buildSystemPromptDrop" :text "the system prompt without the rows a drop list names; an empty list gives the same bytes as buildSystemPrompt")
(:doc :symbol "asl/agentLoop/journal.asl#fallbackRowText" :text "one journal row (:fallback :noTools ...) when a route's 400 to a tools request made the turn fall back to the text protocol: the model, the status and the first 120 characters of the error")
(:doc :symbol "asl/agentLoop/journal.asl#sectionId" :text "the id a prefix row is dropped by: a harness layer by its :id, any other row by its head keyword")
(:doc :symbol "asl/agentLoop/journal.asl#usageRowText" :text "one journal row (:usage :in :cached :out :model) for a provider reply that carried usage")
(:doc :symbol "asl/agentLoop/retry.asl#chargeSeconds" :text "the elapsed seconds of an attempt rounded up, never negative, charged to the wall budget")
(:doc :symbol "asl/agentLoop/context.asl#contextLatestCapBytes" :text "the byte cap for the newest turn's output, twice the read payload, larger than the cap for older turns so the model's latest read is not clipped too hard")
(:doc :symbol "asl/agentLoop/tests/deleteThenRejectedWriteTest.asl#runTests" :text "pins that a delete whose path a later write in the same reply targets is superseded, so a write refused for large escaped content leaves the original file intact")
(:doc :symbol "asl/agentLoop/tests/hubRetryStub.asl#main" :text "stand-in hub for retry tests: mode down answers the first request 503 with Retry-After 2 then a text reply, mode retry answers the first 429 with Retry-After 2 then text, mode long answers every request 429 with Retry-After 9999; every request is appended to the log")
(:doc :symbol "asl/agentLoop/tests/hubRetryTest.asl#runTests" :text "pins that a hub 429 with Retry-After N is a wait: the turn sleeps N seconds and reposts within the queue timeout, and a Retry-After beyond that budget is an ordinary error without retry")
(:doc :symbol "asl/agentLoop/tests/hubStub.asl#main" :text "one-shot stand-in hub: listens on the unix socket in argv 1, writes the first request it reads to the file in argv 2 and answers one ASN reply")
(:doc :symbol "asl/agentLoop/tests/journalUsageTest.asl#runTests" :text "pins that a provider reply's usage block, OpenAI-shaped or the ASN reply's own, lands in the journal as a usage row with in, cached, out and model, that a reply without usage writes nothing, and that the turn meta still carries it")
(:doc :symbol "asl/agentLoop/tests/leonPoolHubTest.asl#runTests" :text "pins that 8 Leon runs of 2 hub calls each share one pool over a stand-in hub holding every reply 3000 ms, all end ok, and the pool wall is over one hold and under twice a single run's wall")
(:doc :symbol "asl/agentLoop/tests/leonPoolRetryAfterTest.asl#runTests" :text "pins that a run answered 429 with Retry-After 2 holds without sleeping the pool thread while another run's calls are answered, shown by the arrival order of the stand-in hub")
(:doc :symbol "asl/agentLoop/tests/leonPoolTest.asl#runTests" :text "pins pool parity: the same scripted case through the blocking path and through the pool driver gives byte-identical journals once session id, root and receipt ids are masked, covering edit, retry, parentGone and a code-routed turn, a check-chain rejection with the same receipt and exit, and 8 runs sharing one pool")
(:doc :symbol "asl/agentLoop/tests/nativeToolsHubTest.asl#runTests" :text "pins an end-to-end run through the hub with a tool-only model: with Leon's default settings it finishes a one-write unit, which it could not with tools off")
(:doc :symbol "asl/agentLoop/tests/nativeToolsTest.asl#runTests" :text "pins native tool calling: op shapes become function schemas, nested txn shapes are not offered, and every tool call reads back as the ASN form the text protocol carries")
(:doc :symbol "asl/agentLoop/tests/neutralHistoryTest.asl#runTests" :text "pins that one model's own markup (think and tool_call tags) is dropped from the transcript before it reaches the next model, which sees only the ASN steps and receipts")
(:doc :symbol "asl/agentLoop/tests/poolDriverTest.asl#runTests" :text "pins poolStepG!: a caller value is threaded through every turn call, the turn's headers reach the wire with X-Asl-Unit once, a 503 re-parks the same request for 1 s without spending a try, and the raw response reaches the turn function")
(:doc :symbol "asl/agentLoop/tests/poolServeTest.asl#runTests" :text "pins the pool control socket on a scripted hub: submit queues, duplicate and path-like ids are refused, a receipt is running until the session ends then a file-backed done, 40 sessions with memCap 4 all leave receipts while no finished session stays in memory, status reports counters and stop sets the flag")
(:doc :symbol "asl/agentLoop/tests/poolServeFormTest.asl#runTests" :text "the pool control line survives newlines: leonClient quoteWord escapes newline, CR and tab so the server reads back a byte-identical (:run :form ...) whose :task keeps every line, and poolServe receipts quote a multi-line :result onto one line that reads back whole at 100 KB")
(:doc :symbol "asl/agentLoop/tests/prefixDropTest.asl#runTests" :text "pins that a :prefix drop list removes exactly the named rows or groups from the system prompt, that an empty list is byte-identical to the full prompt, and that focus is a per-turn tail rather than a prompt row")
(:doc :symbol "asl/agentLoop/tests/prefixHubTest.asl#runTests" :text "pins an end-to-end run through the hub with a :prefix list: the system prompt lacks those layers, each turn ends with the focus tail, and the unit still finishes")
(:doc :symbol "asl/agentLoop/tests/providersAskTest.asl#runTests" :text "pins nextTurnAsk!: with a hub socket it posts nothing and returns askHub with the body and headers nextTurn! then really posts, counts the turn, and nextTurnReply of the stand-in's raw reply gives the same text as the blocking path")
(:doc :symbol "asl/agentLoop/tests/providersHubTest.asl#runTests" :text "pins the hub transport read from hub.asn: a :sock gets the chat with class and unit headers, a dead socket is retried at :backoffMs doubling until :downAfterMs then ERR_GATEWAY_DOWN, :fallback inProcess leaves the hub path, and with no hub.asn the older HTTP path is unchanged")
(:doc :symbol "asl/agentLoop/tests/readOnlyGateTest.asl#runTests" :text "pins that a turn whose ops only read, or whose write or edit changed nothing, reuses the last gate verdict, while a turn that wrote, runs or finishes still runs the gates")
(:doc :symbol "asl/agentLoop/tests/repeatFailureTest.asl#runTests" :text "pins that the same reply whose ops fail and change nothing escalates on its third consecutive turn")
(:doc :symbol "asl/agentLoop/tests/sessionPoolTest.asl#runTests" :text "pins the session pool on a scripted hub: 8 sessions of 5 turns over 8 slots finish in under twice one session's wall, 64 sessions over 8 slots with memCap 16 all finish with waiting sessions spilled to files and the files gone at the end, pickNext prefers the oldest warm session, and an unreachable hub gives up after three tries")
(:doc :symbol "asl/agentLoop/tests/poolBigRequestTest.asl#runTests" :text "gate for LEONPOOL-RETRYAFTER-MAC-HANG: a 600 KB pool request to a hub that reads only between pool steps reaches the hub whole, because the hub fd is non-blocking and the unsent rest is kept and pushed on the next step instead of blocking the worker in a socket send")
(:doc :symbol "asl/agentLoop/tests/toolHubStub.asl#main" :text "stand-in hub for a tool-only model: a request offering tools gets a JSON tool_call, first a step that writes subject.txt green then done, a request without tools gets prose; every request is appended to the file in argv 2")
(:doc :symbol "asl/agentLoop/tests/tools400Stub.asl#main" :text "stand-in hub: in mode tools a request that offers tools gets HTTP 400 and one without gets a text reply, in mode always every request gets 400; every request is appended to the log file")
(:doc :symbol "asl/agentLoop/tests/tools400Test.asl#runTests" :text "pins the 400 fallback: a route answering 400 to a request with tools is retried once without tools in the text protocol, the provider is remembered as no-tools for the next turn, and a 400 without tools is an ordinary error with no retry")
(:doc :symbol "asl/agentLoop/tests/txnOrderTest.asl#runTests" :text "pins txn write ordering: a test written before the src it imports is sent src first, an order that holds, a cycle, and a txn editing a file it also writes stay as written, and a src carrying its test's module header gets a moduleHint naming the expected module")
(:doc :symbol "asl/agentLoop/attractor.asl#validAttractor?" :text "an :attractor value is valid when empty, off or asn: asn opens the system prompt with one compact ASN contract and op examples and prefills (:step where the transport allows")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorOn?" :text "whether the attractor value turns the ASN contract on (asn), as opposed to empty or off")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorContract" :text "the stable prefix: constant text plus the op grammar rows, with no task, session, path, time, turn or model name, so its bytes are the same for every session and a provider prompt cache hits")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorSystem" :text "the system prompt with the attractor contract in front when the attractor is on, else the system prompt unchanged")
(:doc :symbol "asl/agentLoop/attractor.asl#prefixHash" :text "the fnv1a64 hash of the attractor contract when the attractor is on, else empty; journaled per turn to show the prefix stays byte-stable")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorCards" :text "the dynamic tail cards chosen by static rules from the last receipt text, the last parse defect and the write state; each card is named and the names are journaled")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorTail" :text "the text of the chosen cards, one per line, followed by a blank line; empty when no card fired")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorPrefill" :text "the assistant prefill a turn sends when the attractor is on, else empty")
(:doc :symbol "asl/agentLoop/attractor.asl#continueReply" :text "a prefilled reply that arrives as only the continuation gets the prefill put back before parsing; a whole reply is kept as it is")
(:doc :symbol "asl/agentLoop/attractor.asl#proseChars" :text "non-space characters outside every balanced top-level form and outside raw fenced blocks bound to a :raw step")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorCards" :text "the named tail cards for a turn chosen by static rules from the last receipt text, the last parse defect, the write state and the turn count; empty when the attractor is off, and the names are journaled")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorContract" :text "the stable prefix: constant text plus the op grammar rows, with no task, session, path, time, turn or model name, so its bytes are the same for every session and a provider prompt cache can hit")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorOn?" :text "true when the attractor setting is asn")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorPrefill" :text "the assistant prefill (:step when the attractor is on, empty otherwise")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorSystem" :text "the system prompt with the contract in front when the attractor is on, unchanged when off")
(:doc :symbol "asl/agentLoop/attractor.asl#attractorTail" :text "the tail cards' texts joined by newlines and followed by a blank line, empty when there are no cards")
(:doc :symbol "asl/agentLoop/attractor.asl#continueReply" :text "a prefilled reply may arrive as only the continuation or as the whole reply when the transport ignored the prefill; puts the prefill back only in the first case")
(:doc :symbol "asl/agentLoop/attractor.asl#prefixHash" :text "the fnv1a64 hash of the contract as text when the attractor is on, empty otherwise")
(:doc :symbol "asl/agentLoop/attractor.asl#proseChars" :text "the count of non-space characters outside every balanced top-level form and outside raw fenced blocks bound to a raw step")
(:doc :symbol "asl/agentLoop/attractor.asl#validAttractor?" :text "true for the accepted attractor values: empty, off, asn")
(:doc :symbol "asl/agentLoop/main.asl#Checked" :text "what the CLI check chain accepted: parameters, repo root, root dir, timeout, queue timeout and the plan flag")
(:doc :symbol "asl/agentLoop/main.asl#Valid" :text "the check chain's decision: valid with the Checked values, or invalid with the rejection MainResult")
(:doc :symbol "asl/agentLoop/main.asl#valid" :text "a Valid carrying the checked parameters, roots and wall")
(:doc :symbol "asl/agentLoop/main.asl#invalid" :text "a Valid carrying the rejection receipt")
(:doc :symbol "asl/agentLoop/main.asl#checkInvocation" :text "runs the check chain on an invocation, in order: syntax error, deprecated role, unknown op, context file error, missing task or resume, then the root and wall checks; returns the first rejection or the Checked values")
(:doc :symbol "asl/agentLoop/main.asl#paramHas" :text "true when an invocation's parameters hold the key")
(:doc :symbol "asl/agentLoop/main.asl#runArgsOf" :text "the RunArgs of an invocation's parameters, as dispatch builds them, so a pool driver starts a run from the same parameters")
(:doc :symbol "asl/agentLoop/main.asl#LiveAsk" :text "what the first half of a turn hands the second: the system and user text and prefill for the model call, the sent text for history, the attractor card names for the journal and whether the advisor hook was acceptable")
(:doc :symbol "asl/agentLoop/main.asl#liveAsk!" :text "the first half of a live turn: renders the bounded transcript and builds the LiveAsk")
(:doc :symbol "asl/agentLoop/main.asl#liveApply!" :text "the second half of a live turn: applies the model's response and retries to the run and returns the next provider run and step")
(:doc :symbol "asl/agentLoop/main.asl#liveTurn!" :text "one live turn: liveAsk!, the blocking provider call, then liveApply!, with a parent watcher and the wall left passed to the call")
(:doc :symbol "asl/agentLoop/main.asl#liveGone!" :text "the orphan stop of one turn: journals the signal and escalates with reason parentGone, apart from the turn body so a pool driver stops its sessions the same way")
(:doc :symbol "asl/agentLoop/main.asl#parentGone?" :text "true when the parent pid the CLI passed is no longer alive; none means no parent to watch")
(:doc :symbol "asl/agentLoop/main.asl#LiveSession" :text "everything a live run needs once set up: run args, roots, journal path, system prompt, loop env, turn provider and provider call")
(:doc :symbol "asl/agentLoop/main.asl#LivePrep" :text "the result of liveSetup!: prepared with a LiveSession, or prepRejected with a MainResult")
(:doc :symbol "asl/agentLoop/main.asl#prepared" :text "a LivePrep carrying a ready LiveSession")
(:doc :symbol "asl/agentLoop/main.asl#prepRejected" :text "a LivePrep carrying the rejection receipt")
(:doc :symbol "asl/agentLoop/main.asl#liveSetup!" :text "builds a live run: code routing, journal, provider (made with the journal's session id so gateway calls carry it), system prompt and loop env; a journal, backend or harness error is returned as a rejection")
(:doc :symbol "asl/agentLoop/main.asl#liveResult" :text "the MainResult of a finished live run: the formatted receipt with the journal usage and last step, and its exit code")
(:doc :symbol "asl/agentLoop/main.asl#appendRetryLines!" :text "appends one (:retry :turn :attempt) journal row per retry, from the retry count down to 1")
(:doc :symbol "asl/agentLoop/main.asl#attractorProvider" :text "the provider with the wall cap applied and, when the prefill is not empty, the prefill set")
(:doc :symbol "asl/agentLoop/main.asl#focusTail" :text "the per-turn (:focus :goal :gate :next) tail when the prefix list includes focus: the goal cut to 400 characters, the first gate and the suggested next step; empty otherwise")
(:doc :symbol "asl/agentLoop/main.asl#lastStepIn" :text "the last reply in a journal text as its op name: the op of a (:step :op ...) reply, else the head of its first form")
(:doc :symbol "asl/agentLoop/main.asl#prefixDrop" :text "the prefix tokens to drop from the system prompt, the list without focus")
(:doc :symbol "asl/agentLoop/main.asl#stopCause" :text "why the run stopped, for a receipt: the loop signal that ended it, else error for a failed run, gateVacuous for a failed run whose declared gates were green before any write, done for ok, otherwise the status")
(:doc :symbol "asl/agentLoop/main.asl#validPrefix?" :text "true when every token of a :prefix list is a known prefix token")
(:doc :symbol "asl/agentLoop/main.asl#wallLeft" :text "the seconds left of the wall budget, at least 1, none when no positive budget is set, so a model call or gate never outlasts the run")
(:doc :symbol "asl/agentLoop/runLoop.asl#LoopOpen" :text "the result of opening a provider run: openRun with the ProviderRun to drive, or openDone with the RunResult of a run that ended early")
(:doc :symbol "asl/agentLoop/runLoop.asl#openRun" :text "a LoopOpen carrying the provider run ready to drive")
(:doc :symbol "asl/agentLoop/runLoop.asl#openDone" :text "a LoopOpen carrying the result of a run that finished during setup, already cleaned up")
(:doc :symbol "asl/agentLoop/runLoop.asl#loopOpen!" :text "opens a provider run: setup, early results cleaned up, memoization begun for a ready run")
(:doc :symbol "asl/agentLoop/runLoop.asl#loopHead!" :text "the head decision of one turn: returns the provider run with the new state and the step")
(:doc :symbol "asl/agentLoop/runLoop.asl#loopFinish!" :text "finishes a provider run and cleans up; a cleanup error gives a failed result")
(:doc :symbol "asl/agentLoop/tests/attractorTest.asl#runTests" :text "pins the opt-in reply attractor: off is byte-identical, on opens with the stable contract and the raw write example, ends with a prefill put back before parsing, adds a trailing assistant message, picks tail cards by static rules and journals prose chars and the prefix hash")
(:doc :symbol "asl/agentLoop/leonPool.asl#leonDrop" :text "the book without the entry for a unit id")
(:doc :symbol "asl/agentLoop/leonPool.asl#leonRouted?" :text "true when the unit's session has a code route declared for its intent; false for an unknown unit")
(:doc :symbol "asl/agentLoop/leonPool.asl#leonViaHub?" :text "true when the unit's provider sends its model calls to the hub socket (providers hubAsk?); false for an unknown unit")
(:doc :symbol "asl/agentLoop/leonServe.asl#hubSockOf" :text "the :sock value quoted in a hub.asn text, empty when there is none")
(:doc :symbol "asl/agentLoop/leonServe.asl#main" :text "the Leon pool server process: --ctl control socket, --receipts dir, --spill dir, --slots, --deadline and --hub; serves until :stop or the deadline")
(:doc :symbol "asl/agentLoop/leonServe.asl#openRun!" :text "the pool's open hook for a (:run ...): opens the Leon run; a routed run or one whose provider is not the hub ask path is dropped and answered exit 125 with a declined row so the conductor spawns it, otherwise the run joins the pool or its early result is returned")
(:doc :symbol "asl/agentLoop/leonServe.asl#serveLoop!" :text "the serve loop: poll the control socket, the pool's hub sockets and exec children, step the server with the Leon driver, until :stop or the deadline; returns the final server and book")
(:doc :symbol "asl/agentLoop/poolServe.asl#receiptRow" :text "the (:receipt :unit :state done :exit :result) row for a finished unit, newline-terminated")
(:doc :symbol "asl/agentLoop/poolServe.asl#serveStepG!" :text "serveStep! with a driver value: the turn function, the open hook for (:run ...) and the exit lookup for receipts take and return it; one step accepts, reads, steps the pool and writes receipts")
(:doc :symbol "asl/agentLoop/providers.asl#hubAsk?" :text "true for a vendor provider whose HOME/.asl/hub.asn names a :sock, so its model calls go to the hub; script, replay and the other providers answer in process")
(:doc :symbol "asl/agentLoop/tests/holdHubStub.asl#main" :text "stand-in hub run as a bounded child: listens on the unix socket in argv 1, writes the maxInFlight and profile lines to the file in argv 2 and holds each request argv 3 ms before answering the two scripted edit replies")
(:doc :symbol "asl/agentLoop/tests/leonServeTest.asl#runTests" :text "gate for leonServe: scripted runs submitted over the control socket are declined with exit 125, a run the check chain rejects has its exit 2 receipt at once, the same unit id twice is refused, (:status) answers and (:stop) ends the loop")
(:doc :symbol "asl/agentLoop/tests/metricsUnbalancedWriteTest.asl#runTests" :text "gate for metrics determineFailType: a Leon journal with a rejected write whose delimiter repair left items, then an ok write, classes one failure as syntaxUnbalanced and none as semanticOther")
(:doc :symbol "asl/agentLoop/journal.asl#editReceiptsOf" :text "the edit-family receipts (write edit txn flush fix discard delete) of a turn, whole and one per line; the journal row (:turn N :observation ...) holds them so edits stay measurable per model while read bodies stay out")
(:doc :symbol "asl/agentLoop/tests/journalReceiptsTest.asl#runTests" :text "gate for the journal observation row: a scripted run writes an unbalanced file then a good one and the journal holds the rejected and the ok write receipt for their turns and no read receipt")
(:doc :symbol "asl/agentLoop/tests/commitFlagTest.asl#runTests" :text "the (:agent ...) :commit key is the only commit request: absent or false keeps RunArgs.commit false whatever the task prose says, true or a bare :commit sets it, and commit is an accepted key")
(:doc :symbol "asl/agentLoop/tests/leonServeWarmTest.asl#runTests" :text "gate for the deploy warm step on the real daemon entry: nativeTest prepare compiles leonServe into a scratch store with clang, and the next start of the entry reaches its usage error with no module lowered and no clang spawned; the scratch store is removed")
(:doc :symbol "asl/agentLoop/tests/rawProtocolReplayTest.asl#runTests" :text "replays of node2 sessions c925fd5ad8167351 and 7de069c5874e6633 with canned model turns: a plain :content string is written as sent, the one fenced block of a reply binds to a :raw step even before it, an unbound :raw step is shown back without an :error marker and answered with the accepted shape as :hint, an echoed :error code is marked :echoed and not counted toward repeatFailure, gates green on owned files changed before the session end it as done, a (:step :op done) after a write ends it, and green gates on unchanged owned files do not")
