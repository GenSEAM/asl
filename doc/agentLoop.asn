(:doc :symbol "asl/agentLoop/retry.asl#pySplitLines" :text "splitlines: one trailing empty part folds away, matching Python")
(:doc :symbol "asl/agentLoop/retry.asl#specUnescape" :text "the two sequential replaces loop.py's _spec_unescape does, not a full unescape")
