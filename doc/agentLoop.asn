(:doc :symbol "asl/agentLoop/core.asl#hasFormResidue" :text "PROSE-THRESHOLD: true when forms parse but residueWordCount is still nonzero")
(:doc :symbol "asl/agentLoop/core.asl#joinForms" :text "PROSE-THRESHOLD: the text rebuilt from only its parsed top-level forms, residue dropped")
(:doc :symbol "asl/agentLoop/core.asl#checkOwns" :text "a path outside root is never owned")
(:doc :symbol "asl/agentLoop/core.asl#cutTurn" :text "old turns cut to 300 chars")
(:doc :symbol "asl/agentLoop/core.asl#renderWindow" :text "older turns stay append-only while they fit")
(:doc :symbol "asl/agentLoop/core.asl#runReadOnly" :text "a read-only command is an observation turn")
