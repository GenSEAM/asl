(:doc :symbol "asl/agentLoop/tests/journalParityTest.asl#" :text "Replays asl/agentLoop/tests/journalParityFixtures.asn (recorded by tests/parity/agentLoop/journalParityGen.py from loop.py at the pinned base) through asl/agentLoop/journal.asl. File and git cases rebuild the case's temp tree from its setup steps exactly as the recorder did (fixed git identity and dates; base steps copy git show BASE:path), run the port, and compare the returned value, the file tree, the snapshot state and git status with the recorded ones, the temp root written @ROOT@.")
(:doc :symbol "asl/agentLoop/tests/journalParityTest.asl#setupStep!" :text "the recorder's run_setup, step for step")
(:doc :symbol "asl/agentLoop/tests/journalParityTest.asl#filePatchCase" :text "large inputs also bound the time")
(:doc :symbol "asl/agentLoop/pool.asl#" :text "Leon task pool, stage 1 of LEON-POOL-20261026: N (:agent ...) forms run in one Leon process. Admission resolves each task's :root and :owns into claims and refuses both members of any overlapping pair (ERR_OWNS_OVERLAP) before anything runs; admitted tasks are grouped into lanes by git root (roots that nest share a lane), and a single-threaded reactor starts one child per running task through asl/tools/fleet/run forkLimited! (a fork without exec under the fleet lease, timeout and descendant limit), so lanes run at once while a lane runs its tasks in order through asl/agentLoop/main mainWithRoots, each with its own journal under its root, its own receipt and its own log. The child is the trap boundary: a trapping task ends as a :failed :trap true slot and the other lanes go on. A live task is killed (whole process tree) at the earlier of its deadline (its wall budget plus grace, the fork's timeoutMs) and its lane deadline, a task whose tree grows past maxDesc is killed as :failed :verdict :runaway, and a lane past its deadline starts nothing more, so a hung lane ends in :timeout slots. One (:poolReceipt ...) line summarises the run. Native builds only: foreign calls are rejected on other targets.")
(:doc :symbol "asl/agentLoop/pool.asl#PoolTask" :text "one task as admission sees it")
(:doc :symbol "asl/agentLoop/pool.asl#PoolTask.idx" :text "position of the form in the pool's argv")
(:doc :symbol "asl/agentLoop/pool.asl#PoolTask.form" :text "the (:agent ...) form, passed unchanged to mainWithRoots")
(:doc :symbol "asl/agentLoop/pool.asl#PoolTask.root" :text "the resolved absolute :root, the pool's root when absent")
(:doc :symbol "asl/agentLoop/pool.asl#PoolTask.owns" :text "the declared :owns entries")
(:doc :symbol "asl/agentLoop/pool.asl#PoolTask.claims" :text "absolute paths the task may write: claimOf of each :owns entry, or the root itself when :owns is empty")
(:doc :symbol "asl/agentLoop/pool.asl#PoolTask.wallMs" :text "the task's wall budget in ms: :wallBudget, else :timeout plus :queueTimeout (600 + 1200 s by default), at most a day")
(:doc :symbol "asl/agentLoop/pool.asl#PoolSlot" :text "the outcome of one run task")
(:doc :symbol "asl/agentLoop/pool.asl#PoolSlot.idx" :text "the task's position in argv")
(:doc :symbol "asl/agentLoop/pool.asl#PoolSlot.lane" :text "the lane that ran it")
(:doc :symbol "asl/agentLoop/pool.asl#PoolSlot.root" :text "the task's resolved root")
(:doc :symbol "asl/agentLoop/pool.asl#PoolSlot.status" :text "the receipt's :status word, failed when it has none or the task trapped, timeout when a deadline ended or skipped it")
(:doc :symbol "asl/agentLoop/pool.asl#PoolSlot.exit" :text "mainWithRoots exit code")
(:doc :symbol "asl/agentLoop/pool.asl#PoolSlot.startNs" :text "monotonicNs in the pool when the task's child was forked")
(:doc :symbol "asl/agentLoop/pool.asl#PoolSlot.endNs" :text "monotonicNs in the pool when the child was reaped or killed (20 ms poll)")
(:doc :symbol "asl/agentLoop/pool.asl#PoolSlot.end" :text "how the task ended: returned, trap, runaway, task or lane (killed at that deadline), notStarted")
(:doc :symbol "asl/agentLoop/pool.asl#PoolSlot.receipt" :text "the task's (:agentReceipt ...) line, or one the pool writes for a trap (ERR_TRAP with the log's ERR_ line), a deadline or a failed fork (ERR_POOL_DEADLINE, ERR_POOL_FORK)")
(:doc :symbol "asl/agentLoop/pool.asl#PoolLimits" :text "pool bounds")
(:doc :symbol "asl/agentLoop/pool.asl#PoolLimits.slots" :text "most tasks running at once, 0 for one per lane")
(:doc :symbol "asl/agentLoop/pool.asl#PoolLimits.laneMs" :text "each lane's deadline from pool start in ms, 0 for the sum of its tasks' wall budgets plus grace")
(:doc :symbol "asl/agentLoop/pool.asl#PoolLimits.graceMs" :text "time a task may run past its wall budget before it is killed")
(:doc :symbol "asl/agentLoop/pool.asl#PoolLimits.maxDesc" :text "most live descendants a task's child may have before forkAdvance! kills it as runaway")
(:doc :symbol "asl/agentLoop/pool.asl#defaultLimits" :text "slots 0, laneMs 0, graceMs 30000, maxDesc 64")
(:doc :symbol "asl/agentLoop/pool.asl#Refusal" :text "a task refused at admission")
(:doc :symbol "asl/agentLoop/pool.asl#Refusal.idx" :text "the refused task's position in argv")
(:doc :symbol "asl/agentLoop/pool.asl#Refusal.error" :text "ERR_OWNS_OVERLAP")
(:doc :symbol "asl/agentLoop/pool.asl#Refusal.with" :text "positions of the tasks whose claims overlap this one")
(:doc :symbol "asl/agentLoop/pool.asl#Refusal.message" :text "the refused claims, for the reader")
(:doc :symbol "asl/agentLoop/pool.asl#Admission" :text "admit's split of the tasks")
(:doc :symbol "asl/agentLoop/pool.asl#Admission.admitted" :text "tasks whose claims overlap no other task's, in argv order")
(:doc :symbol "asl/agentLoop/pool.asl#Admission.refused" :text "one Refusal per task with an overlapping claim")
(:doc :symbol "asl/agentLoop/pool.asl#claimOf" :text "the absolute, normalised path an :owns entry claims under a root; a glob claims the directory before its first wildcard, so a pattern only widens a claim")
(:doc :symbol "asl/agentLoop/pool.asl#claimsOverlap?" :text "true when a claim of one list equals, contains or lies under a claim of the other, on path-segment boundaries")
(:doc :symbol "asl/agentLoop/pool.asl#taskOf!" :text "parse one (:agent ...) form with main parseInvocation and resolve its root, owns and claims")
(:doc :symbol "asl/agentLoop/pool.asl#admit" :text "split tasks into admitted and refused; both members of an overlapping pair are refused, so no file of either is touched")
(:doc :symbol "asl/agentLoop/pool.asl#lanesOf" :text "group admitted tasks into lanes: tasks whose roots are equal or nest share one lane, ordered by argv position; lanes are ordered by their first task")
(:doc :symbol "asl/agentLoop/pool.asl#runPool!" :text "runPoolWith! with runTask!")
(:doc :symbol "asl/agentLoop/pool.asl#runPoolWith!" :text "run lanes in the fork reactor under limits, each task through the given runner in its own child, with receipt, exit and log files in a scratch dir under TMPDIR removed afterwards; every slot is returned ordered by argv position")
(:doc :symbol "asl/agentLoop/pool.asl#runTask!" :text "the default runner: main mainWithRoots on the task's form at its root")
(:doc :symbol "asl/agentLoop/pool.asl#receiptStatus" :text "the :status word of an (:agentReceipt ...) line, failed when absent")
(:doc :symbol "asl/agentLoop/pool.asl#receiptJournal" :text "the :journal path of an (:agentReceipt ...) line, empty when absent")
(:doc :symbol "asl/agentLoop/pool.asl#poolSummary" :text "the (:poolReceipt :tasks :admitted :lanes :ok :failed :refused :wallMs :sumMs :slots (:slot ...) :refusals (:refused ...)) line; sumMs adds the per-task times, so wallMs below it shows lanes ran at once")
(:doc :symbol "asl/agentLoop/pool.asl#poolExit" :text "2 when any task was refused, 1 when any task did not end ok (failed, trapped or timed out), else 0")
(:doc :symbol "asl/agentLoop/pool.asl#poolMain!" :text "poolMainWith! with defaultLimits at the given slots and runTask!")
(:doc :symbol "asl/agentLoop/pool.asl#poolMainWith!" :text "parse, admit, group and run task forms under limits through a runner, returning the summary and exit code")
(:doc :symbol "asl/agentLoop/pool.asl#main" :text "CLI entry: one (:agent ...) form per argument, rooted at the current directory; prints the (:poolReceipt ...) line and exits with poolExit")
(:doc :symbol "asl/agentLoop/tests/poolTest.asl#" :text "LEON-POOL-20261026 stage 1 gate, offline against script/<id> providers: three disjoint tasks each sleeping 1 s in a run step overlap pairwise in their start and end stamps (a serial pool goes red here); an overlapping :owns pair is refused before any file or journal appears under its root while a disjoint task still runs; a task without a script fixture fails while two tasks sharing another root complete in order in one lane")
(:doc :symbol "asl/agentLoop/tests/poolAdmitTest.asl#" :text "LEON-POOL-20261026 admission without running tasks: claim normalisation and glob widening, segment-boundary overlap, refusal of both members of a pair, lane grouping by nested roots, receipt field reads and the refusal exit code")
(:doc :symbol "asl/agentLoop/tests/poolTrapTest.asl#" :text "LEON-POOL-TRAP gate: three lanes, the runner traps on one task; its slot reads :failed :trap true with ERR_TRAP and the trap's ERR_INT_OVERFLOW line while the other two script tasks report ok; a runner run in the pool process instead of a child ends the whole pool on the trap")
(:doc :symbol "asl/agentLoop/tests/poolDeadlineTest.asl#" :text "LEON-POOL-BOUND gate: a task hung past its :wallBudget plus grace and a lane hung past a 30 s lane deadline (with a task queued behind it) end as :timeout slots (:deadline :task, :deadline :lane, :started false), their run steps killed before they write, while the ordinary lane ends ok and the pool ends near 30 s instead of the 117 s hang")
(:doc :symbol "asl/agentLoop/pool.asl#PoolTask.waitsFor" :text "earlier tasks whose claims overlap this one's, which it waits for in wait mode")
(:doc :symbol "asl/agentLoop/pool.asl#PoolTask.chan" :text "the pool's scratch dir as seen by the running task, the dir poolChannel ask!, asks! and answer! take; empty before the task starts")
(:doc :symbol "asl/agentLoop/pool.asl#PoolSlot.waitedFor" :text "the task's waitsFor, printed as :waitedFor (...) when not empty")
(:doc :symbol "asl/agentLoop/pool.asl#PoolLimits.onOverlap" :text "wait (default): a task whose :owns overlap an earlier task's is admitted and starts after it ends; refuse: both members of the pair are refused as in stage 1")
(:doc :symbol "asl/agentLoop/pool.asl#admitWith" :text "admission by onOverlap mode: refuse splits tasks into admitted and refused like admit; wait admits every task and records the earlier overlapping tasks in its waitsFor, lanesOf then puts overlapping tasks into one lane so they run in argv order")
(:doc :symbol "asl/agentLoop/poolChannel.asl#" :text "Ask/answer between running pool tasks over the pool's scratch dir, ASN only and bounded. A task writes one ASN line to the outbox (ask!, answer!); the pool's single-threaded reactor is the only router: route! moves an ask to the inbox of a running peer, an answer back to the asker, holds an ask to a peer still queued in another lane until that peer starts (the asker's own wait bounds it), and itself answers ERR_PEER_QUEUED_BEHIND (the peer is queued behind the asker in its own lane, so it could only start after the asker ends), ERR_PEER_NOT_RUNNING (absent, finished, or self) or ERR_ASK_LIMIT (past maxAsks asks from one task). Bodies are single-line ASN forms of at most maxBodyBytes (ERR_ASK_NOT_ASN, ERR_ASK_TOO_LARGE before anything is sent); an asker waits at most maxWaitMs (ERR_ASK_TIMEOUT). Files are written to a .tmp name and renamed, so the router never reads half a line.")
(:doc :symbol "asl/agentLoop/poolChannel.asl#PoolMsg" :text "one ask or answer")
(:doc :symbol "asl/agentLoop/poolChannel.asl#PoolMsg.kind" :text "ask or answer")
(:doc :symbol "asl/agentLoop/poolChannel.asl#PoolMsg.id" :text "the ask's id, <from>x<monotonicNs>, which its answer repeats")
(:doc :symbol "asl/agentLoop/poolChannel.asl#PoolMsg.from" :text "sender task index, -1 for an answer the router writes itself")
(:doc :symbol "asl/agentLoop/poolChannel.asl#PoolMsg.to" :text "receiver task index")
(:doc :symbol "asl/agentLoop/poolChannel.asl#PoolMsg.error" :text "an ERR_ code on a router answer, else empty")
(:doc :symbol "asl/agentLoop/poolChannel.asl#PoolMsg.body" :text "the ASN form carried, empty for an error answer")
(:doc :symbol "asl/agentLoop/poolChannel.asl#maxBodyBytes" :text "4096, the largest body a task may send")
(:doc :symbol "asl/agentLoop/poolChannel.asl#maxAsks" :text "32, the most asks one task may send in one pool run")
(:doc :symbol "asl/agentLoop/poolChannel.asl#maxWaitMs" :text "120000, the longest an ask! waits for its answer")
(:doc :symbol "asl/agentLoop/poolChannel.asl#asnForm?" :text "true when s is exactly one single-line parenthesised form, parentheses inside strings ignored")
(:doc :symbol "asl/agentLoop/poolChannel.asl#inboxDir" :text "the inbox of task idx under the pool dir")
(:doc :symbol "asl/agentLoop/poolChannel.asl#outboxDir" :text "the outbox all tasks write to")
(:doc :symbol "asl/agentLoop/poolChannel.asl#openChannel!" :text "create the outbox and one inbox per task index")
(:doc :symbol "asl/agentLoop/poolChannel.asl#msgLine" :text "a PoolMsg as its one wire line (:ask|:answer :id :from :to [:error] :body)")
(:doc :symbol "asl/agentLoop/poolChannel.asl#parseMsg" :text "a wire line back into a PoolMsg; the header ends at the first :body, so a body may hold any text")
(:doc :symbol "asl/agentLoop/poolChannel.asl#ask!" :text "send body to task to and block this task until the answer body comes back, or an ERR_ code")
(:doc :symbol "asl/agentLoop/poolChannel.asl#asks!" :text "take the asks waiting in task idx's inbox, oldest first")
(:doc :symbol "asl/agentLoop/poolChannel.asl#answer!" :text "send body as the answer to ask q")
(:doc :symbol "asl/agentLoop/poolChannel.asl#route!" :text "one routing pass over the outbox; live and queued pair each running and each not yet started task index with its lane id; returns the updated per-task ask counts")
(:doc :symbol "asl/agentLoop/poolOps.asl#" :text "Leon's side of the pool channel as reply ops. (:ask :to i :body (...)) blocks the turn until task i answers and its op receipt is (:ask :to i :status :ok :answer (...)) or :status :rejected :error ERR_..; between turns servePending! hands the asks other tasks sent this one to the model as one (:poolAsks ...) observation, and (:answer :to i :body (...)) or (:answer :id \"..\" :body (...)) posts the reply. A task whose (:agent) form has no :poolChan and :poolIdx gets ERR_NOT_IN_POOL.")
(:doc :symbol "asl/agentLoop/poolOps.asl#PoolSelf" :text "the pool channel dir and task index a Leon run belongs to")
(:doc :symbol "asl/agentLoop/poolOps.asl#PoolSelf.chan" :text "the pool's scratch dir, the dir poolChannel takes")
(:doc :symbol "asl/agentLoop/poolOps.asl#PoolSelf.idx" :text "this task's index in the pool")
(:doc :symbol "asl/agentLoop/poolOps.asl#poolSelf" :text "a PoolSelf, or none when chan is empty or idx is negative")
(:doc :symbol "asl/agentLoop/poolOps.asl#poolSelfOf" :text "the PoolSelf named by an (:agent) form's :poolChan and :poolIdx, none outside a pool")
(:doc :symbol "asl/agentLoop/poolOps.asl#formField" :text "the word after :key in an op form's header, before :body; empty when absent")
(:doc :symbol "asl/agentLoop/poolOps.asl#formBody" :text "the balanced form after :body in an op form, parentheses inside strings ignored")
(:doc :symbol "asl/agentLoop/poolOps.asl#askWaitMs" :text "60000, how long an (:ask) op waits when it names no :waitMs")
(:doc :symbol "asl/agentLoop/poolOps.asl#askReceipt!" :text "run an (:ask) op form: send its body to the peer and return the answer, or the refusal, as one ASN receipt")
(:doc :symbol "asl/agentLoop/poolOps.asl#servePending!" :text "the between-turn hook: move asks waiting in this task's inbox to its served dir and return them as one (:poolAsks ...) observation, empty when there are none")
(:doc :symbol "asl/agentLoop/poolOps.asl#answerReceipt!" :text "run an (:answer) op form: answer the served ask named by :id, or the oldest from task :to, and return the receipt")
(:doc :symbol "asl/agentLoop/poolOps.asl#poolOp?" :text "true for a parsed reply op named ask or answer")
(:doc :symbol "asl/agentLoop/poolOps.asl#poolOpReceipt!" :text "run a parsed pool op and return its receipt")
(:doc :symbol "asl/agentLoop/tests/poolWaitTest.asl#" :text "LEON-POOL-WIRE wait queue gate with a 1 s fake runner: tasks in different roots whose absolute :owns overlap run one after the other, the later naming the earlier in :waitedFor, while a disjoint task runs beside them; under a cap of 2 three disjoint tasks never all run at once")
(:doc :symbol "asl/agentLoop/tests/poolAskTest.asl#" :text "LEON-POOL-WIRE ask/answer gate with a fake runner: an ASN question from task 0 reaches task 1 and its ASN answer comes back; asks to oneself or an absent peer get ERR_PEER_NOT_RUNNING, plain text ERR_ASK_NOT_ASN, the ask past maxAsks ERR_ASK_LIMIT; wire-line round trip and asnForm? cases")
(:doc :symbol "asl/agentLoop/grounding.asl#" :text "LEON-ASL-GROUNDING: the ASL card in Leon's system prompt, cut from tools.asn, the checker's builtin signatures and the canonical examples, and the (:expect) forms sent back after a rejected tool form")
(:doc :symbol "asl/agentLoop/grounding.asl#cardSources" :text "the workspace sources the card is cut from: tools.asn, record.asl, and the checker's builtinSig")
(:doc :symbol "asl/agentLoop/grounding.asl#cardTypeAnchors" :text "sentence prefixes of the type rules the card leads with: no nil, Int and Float, boolean conditions")
(:doc :symbol "asl/agentLoop/grounding.asl#cardSigNames" :text "builtins whose checker signatures the card lists (card R3): the string builtins stringSplit, stringSlice, stringUpper, then the Option-returning ones and fold, chosen for their Option and Result returns and fold's argument order")
(:doc :symbol "asl/agentLoop/grounding.asl#cardExamples" :text "one expression per type rule with the type it checks at, now led by the Option and Result match pair (card R3); groundingTest type-checks each one")
(:doc :symbol "asl/agentLoop/grounding.asl#sigLine" :text "name, parameter types and return type of a builtin as asl-checker/types#builtinSig gives them, empty when unknown")
(:doc :symbol "asl/agentLoop/grounding.asl#typeRules" :text "each type-anchored sentence of the language text, cut at its sentence end")
(:doc :symbol "asl/agentLoop/grounding.asl#cardRuleAnchors" :text "sentence prefixes picked from the tools.asn language topic text")
(:doc :symbol "asl/agentLoop/grounding.asl#languageText!" :text "the unescaped :text of the tools.asn :language topic, or err when absent")
(:doc :symbol "asl/agentLoop/grounding.asl#languageRules" :text "each anchored sentence of the language text, cut at its sentence end; missing anchors are left out")
