(:doc :symbol "asl/agentLoop/tests/leonOrphanResidueTest.asl#runTests" :text "the residues of a dead parent: a blocked model call, gate runs, integrity re-runs and baseline runs end when the watched pid is gone")
(:doc :symbol "asl/agentLoop/tests/gateKillTreeTest.asl#runTests" :text "a timed-out gate leaves no survivor, not even a child in its own process group under the gate CLI")
(:doc :symbol "asl/agentLoop/tests/leonRemoteToolsTest.asl#runTests" :text "Leon tool ops routed to a remote unit through remoteOps")
(:doc :symbol "asl/agentLoop/core.asl#echoHeads" :text "the heads of the frames the loop itself sends or journals, which a model reply must never repeat at top level")
(:doc :symbol "asl/agentLoop/core.asl#isEchoForm" :text "true for a frame whose head is an echo head; a gate frame counts only when it carries the loop-output keys cmd and one of exit, asserts, failed")
(:doc :symbol "asl/agentLoop/core.asl#echoForms" :text "the top-level forms of a reply that echo loop frames")
(:doc :symbol "asl/agentLoop/core.asl#echoCount" :text "how many loop frames a reply echoes")
(:doc :symbol "asl/agentLoop/core.asl#stripEchoes" :text "a reply with every echoed loop frame removed, before findings are read")
(:doc :symbol "asl/agentLoop/core.asl#malformedLine" :text "the journal line (:malformed :turn N :echo K) of a turn whose reply echoed loop frames")
(:doc :symbol "asl/agentLoop/frame.asl#Frame" :text "the context frame of a unit: unit, kind, atoms, owns, gates, os, toolchain and a clipped peers line")
(:doc :symbol "asl/agentLoop/frame.asl#frameMaxTokens" :text "adopted: token ceiling of a rendered context frame")
(:doc :symbol "asl/agentLoop/frame.asl#peersClip" :text "adopted: characters of the peers line kept in a frame")
(:doc :symbol "asl/agentLoop/frame.asl#estimateTokens" :text "token estimate of a text: characters plus three, divided by four")
(:doc :symbol "asl/agentLoop/frame.asl#leaksEgress" :text "true when a frame text would carry a secret or an outward-bound value, so the frame is refused")
(:doc :symbol "asl/agentLoop/frame.asl#renderFrame" :text "the pure context frame of a unit from its env, lane and budget rows, clipped to frameMaxTokens")
(:doc :symbol "asl/agentLoop/providers.asl#attribHeaders" :text "the gateway headers naming the consumer and, once a main turn has run, X-ASL-Turn, so the ledger row joins the session")
