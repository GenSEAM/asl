(:doc :symbol "asl/agentLoop/journal.asl#Snapshot.mode" :text "st_mode & 0o7777; none when it did not exist")
(:doc :symbol "asl/agentLoop/journal.asl#Snapshot.dirs" :text "missing parent dirs, innermost first")
