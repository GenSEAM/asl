(:doc :symbol "asl/grammar/corpus/modules/core/private.asl#" :text "A module whose type declarations stay private to it.")
(:doc :symbol "asl/grammar/corpus/modules/core/shadow.asl#" :text "Binders that shadow this module's own top-level names.")
(:doc :symbol "asl/grammar/corpus/modules/core/shapes.asl#" :text "Plane figures and their measurements.")
(:doc :symbol "asl/grammar/corpus/modules/core/strings.asl#" :text "String helpers reached by the module fixture through an alias.")
(:doc :symbol "asl/grammar/corpus/modules/core/trees.asl#" :text "A parameterised binary tree and a one-field cell for its payload.")
(:doc :symbol "asl/grammar/corpus/modules/text/report.asl#" :text "Rendering for shapes declared in another module.")
(:doc :symbol "asl/grammar/corpus/semantic/exportBareCase.asl#" :text "Exports a union case without its type.")
(:doc :symbol "asl/grammar/corpus/semantic/exportUndefinedType.asl#" :text "Exports a type it does not declare.")
(:doc :symbol "asl/grammar/corpus/semantic/import-cycle/a.asl#" :text "Imports b, which imports a.")
(:doc :symbol "asl/grammar/corpus/semantic/import-cycle/b.asl#" :text "Imports a, which imports b.")
(:doc :symbol "asl/grammar/corpus/semantic/importUnexportedCase.asl#" :text "Constructs a case of a union its import keeps private.")
(:doc :symbol "asl/grammar/corpus/semantic/importUnexportedType.asl#" :text "Names a type its import keeps private.")
(:doc :symbol "asl/grammar/corpus/semantic/importedCallArity.asl#" :text "Calls an imported constructor with the wrong number of arguments.")
(:doc :symbol "asl/grammar/corpus/semantic/importedCtorMissingField.asl#" :text "Constructs an imported record without its required field.")
(:doc :symbol "asl/grammar/corpus/semantic/importedTypeMismatch.asl#" :text "Passes a local value where an imported type is required.")
(:doc :symbol "asl/grammar/corpus/semantic/mixedModuleMatch.asl#" :text "Matches arms drawn from two different unions.")
(:doc :symbol "asl/grammar/corpus/semantic/nonExhaustiveImportedMatch.asl#" :text "Matches an imported union without covering it.")
(:doc :symbol "asl/grammar/corpus/semantic/privateTypeInExportedSignature.asl#" :text "Exports a function over a type it keeps private.")
(:doc :symbol "asl/grammar/corpus/semantic/qualifiedCtorUnexported.asl#" :text "Constructs a record its import keeps private.")
(:doc :symbol "asl/grammar/corpus/semantic/unexportedMember.asl#" :text "Module reaching for a member its import does not export.")
(:doc :symbol "asl/grammar/corpus/semantic/unimportedAliasType.asl#" :text "Names a type through an alias it never imported.")
(:doc :symbol "asl/grammar/corpus/semantic/wrongAliasType.asl#" :text "Reaches a type through the wrong alias.")
(:doc :symbol "asl/grammar/corpus/valid/06-module.asl#" :text "Case-conversion and tallying helpers for report rendering.")
(:doc :symbol "asl/grammar/corpus/valid/08-io.asl#" :text "Echoes files back, reporting a missing source rather than trapping.")
(:doc :symbol "asl/grammar/corpus/valid/09-imported-types.asl#" :text "Short labels for imported shapes.")
(:doc :symbol "asl/grammar/corpus/valid/10-imported-generic-types.asl#" :text "Measurements over trees declared in another module.")
(:doc :symbol "asl/grammar/corpus/valid/11-name-coexistence.asl#" :text "A locally declared Shape beside an imported one.")
(:doc :symbol "asl/grammar/corpus/valid/12-transitive-use.asl#" :text "Consuming a module that speaks in another module's types.")
(:doc :symbol "asl/grammar/corpus/valid/13-module-program.asl#" :text "Prints a description and a measurement of an imported shape.")
(:doc :symbol "asl/grammar/corpus/valid/14-sequenced-bodies.asl#" :text "Every multi-expression body position, each with an observable effect.")
(:doc :symbol "asl/grammar/corpus/valid/15-shadowed-binders.asl#" :text "Reads names an imported module both defines and rebinds.")
(:doc :symbol "asl/grammar/corpus/valid/19-io-errors.asl#" :text "Show a file, or the IoError reading it fails with.")
(:doc :symbol "asl/grammar/corpus/valid/20-option-result-ctors.asl#" :text "Report how a token parses, from both the Option and the Result side.")
(:doc :symbol "asl/grammar/corpus/valid/21-option-result-combinators.asl#" :text "Parse a number, transform it, and report every failure route.")
(:doc :symbol "asl/grammar/corpus/valid/22-boolean-algebra.asl#" :text "Report where a value sits relative to a closed range.")
(:doc :symbol "asl/grammar/corpus/valid/23-numeric.asl#" :text "Report the numeric vocabulary over one pair of values.")
(:doc :symbol "asl/grammar/corpus/valid/24-list-reshaping.asl#" :text "Reshape a range and report every result.")
(:doc :symbol "asl/grammar/corpus/valid/25-list-aggregation.asl#" :text "Summarise a comma-separated list of numbers.")
(:doc :symbol "asl/grammar/corpus/valid/26-map-lifecycle.asl#" :text "Count words, then remove one and report what is left.")
(:doc :symbol "asl/grammar/corpus/valid/27-string-query.asl#" :text "Report where and whether a needle occurs in a haystack.")
(:doc :symbol "asl/grammar/corpus/valid/28-string-transforms.asl#" :text "Report every string transformation over one line.")
(:doc :symbol "asl/grammar/corpus/valid/29-literals.asl#" :text "Literal forms that carry a sign, at every numeric type.")
(:doc :symbol "asl/grammar/corpus/valid/30-nano-program.asl#" :text "Grade the reading named on the command line and print the verdict.")
(:doc :symbol "asl/grammar/corpus/valid/30-nano-projection.asl#" :text "Grade a run of sensor readings against a window, spelled in Nano.")
(:doc :symbol "asl/grammar/corpus/valid/31-alias-keys.asl#" :text "A record keyed by the six Nano option letters.")
(:doc :symbol "asl/grammar/corpus/valid/32-json-case.asl#" :text "Records whose serialized field names differ from their source names.")
(:doc :symbol "asl/grammar/corpus/valid/33-notes.asl#" :text "Two functions and the notes that explain why they are shaped this way.")
(:doc :symbol "asl/grammar/corpus/valid/34-multiline-program.asl#" :text "Prints its own help text and exits.")
(:doc :symbol "asl/grammar/corpus/valid/34-multiline-strings.asl#" :text "A program's help text, spelled as the multi-line literals it really is.")
(:doc :symbol "asl/grammar/corpus/valid/35-metadata-tags.asl#" :text "Demonstrates decoupled metadata annotations.")
(:doc :symbol "asl/grammar/tests/corpusTest.asl#" :text "The grammar corpus keeps its polarity: valid files close every delimiter, invalid/unbalanced.asl does not. Paths are relative to the workspace root.")
(:doc :symbol "asl/grammar/tests/densityTest.asl#" :text "asl/grammar/grammar.asn keeps its token budget: 48 symbols, and every symbol costing more than :tokensBaseline 2 carries a :rationale. Paths are relative to the workspace root.")
(:doc :symbol "asl/grammar/corpus/semantic/exportedWithoutDoc.asl#" :text "Module carrying an undocumented export.")
(:doc :symbol "asl/grammar/corpus/invalid/bareDecimalPoint.asl#half" :text "A float is digits, a point, digits — both sides required. `.5` and `1.` are rejected rather than read as 0.5 and 1.0, because the alternative is a lexer where `.` is sometimes part of a number and sometimes the start of `.-field`, and the constrained-decoding arm cannot afford that ambiguity. The host reads both as names and rejects them as unknown symbols.")
(:doc :symbol "asl/grammar/corpus/invalid/fnTypeparams.asl#f" :text "A lambda takes neither type parameters nor :doc (asl/agentSpecCore.md 4.3): the host reads `fn` followed by anything but a parameter vector as a bad lambda.")
(:doc :symbol "asl/grammar/corpus/invalid/missingArrow.asl#bad" :text "A lambda's return type must be introduced by ->. Without the arrow the host reads the type as the first body expression and rejects it as an unknown name.")
(:doc :symbol "asl/grammar/corpus/invalid/pascalFunction.asl#BadName" :text "Function names are camelCase; PascalCase heads are constructors.")
(:doc :symbol "asl/grammar/corpus/modules/core/private.asl#Hidden" :text "Search-path companion: everything it declares stays private, so a fixture can reach for a type, a case and a record that exist and are not published.")
(:doc :symbol "asl/grammar/corpus/modules/core/shadow.asl#x" :text "Search-path companion: a module whose binders collide with its own top-level names. Every top-level name is emitted under the module's prefix and every binder is emitted bare, so a lowering that resolves an identifier through the unit's name table rather than through lexical scope reaches the definition instead of the binding — on both former targets at once.")
(:doc :symbol "asl/grammar/corpus/modules/core/shapes.asl#Shape" :text "Search-path companion: the module whose type the importing fixtures name. Its export list carries a type beside a function, which is what the whole boundary rests on.")
(:doc :symbol "asl/grammar/corpus/modules/core/strings.asl#concat" :text "Search-path companion for corpus/valid/06-module.asl, which imports it. It is not a gate case: it exists so rule 9 has a real export list to check a qualified name against, which no fixture could do while the module was absent. `trim` is left off the export list for semantic/unexportedMember.asl.")
(:doc :symbol "asl/grammar/corpus/modules/core/trees.asl#Tree" :text "Search-path companion: a parameterised recursive union and a parameterised record, both exported, so an importer can instantiate them across the boundary. T is a free type variable: the host reads no {T} binder and checks no types.")
(:doc :symbol "asl/grammar/corpus/modules/text/report.asl#describe" :text "Search-path companion: it speaks in another module's type, so rule 13 has to be checked against the module that DEFINES a type, not the one naming it.")
(:doc :symbol "asl/grammar/corpus/semantic/builtinArity.asl#allThree?" :text "expect-only: arity `and` is `Bool Bool -> Bool`, not variadic. Builtin arity was excused here because `list` is variadic as a constructor and nullary as a pattern — but a pattern never reaches a call node, so excusing every builtin cost a silent wrong answer: this checked clean and the Python backend emitted `(a and b)`, dropping the third operand with nothing reported.")
(:doc :symbol "asl/grammar/corpus/semantic/builtinAsValue.asl#shout" :text "expect-only: builtin-reference §6 gives a builtin a type, not a value: Core has no first-class reference to one, so a higher-order position takes an `fn` that calls it. Nothing rejected this before, and both backends lowered it to a name that does not exist in their own output — `string_upper(_x)` on Python, `string_upper.clone()` on Rust — because builtins are lowered as inline templates, never as functions. Superseded: the host binds a named builtin as a value, and (map stringUpper xs) runs, so asl-host check passes this file; only operators are not values.")
(:doc :symbol "asl/grammar/corpus/semantic/doubledEquals.asl#zero?" :text "expect-only: builtin-reference `==` is not an operator. It lexes as two `=` tokens, so this is `=` applied to `=`, `n` and `0` — which typed clean and emitted `_agentscript.eq(=, n)` on Python and `(= == n.clone())` on Rust, neither of them a program. Rejecting the operator in argument position is what names the mistake at its cause. Superseded: the host binds `==` as an equality operator, so asl-host check passes this file.")
(:doc :symbol "asl/grammar/corpus/semantic/effectInPureDefun.asl#readConfig" :text "expect: rule-12 The call is well-typed and well-scoped; only the missing marker makes it an error. Nothing context-free can see that `fileRead` touches the world.")
(:doc :symbol "asl/grammar/corpus/semantic/effectInPureLambda.asl#readEach" :text "expect: rule-12 The enclosing fn is marked, but the lambda is not, and the lambda is where the effect happens. A marker on the outside does not cover the inside.")
(:doc :symbol "asl/grammar/corpus/semantic/exponentIsNotALiteral.asl#scaled" :text "expect: rule-2 There is no exponent literal in Core: a number is digits, optionally signed, optionally with a decimal point. So `1.5e3` is the float 1.5 followed by the name `e3`, in both grammars, and the name is unbound. Pinned here because the alternative is that the split reads as arity or as a stray argument somewhere downstream, and the reason stops being visible. Superseded: the host reads 1.5e3 as the float 1500.0, and tests/acceptance/r1Host/reader/surfaceTest.asl asserts an exponent literal, so asl-host check passes this file.")
(:doc :symbol "asl/grammar/corpus/semantic/exportBareCase.asl#Shape" :text "expect-only: rule-2 `circle` is a case of Shape, not a declaration of its own. Cases travel with their type, so a bare case name on the export list names nothing (§4.0) — the surviving alternative would publish a constructor for a type nobody can write.")
(:doc :symbol "asl/grammar/corpus/semantic/exportUndefinedType.asl#shout" :text "expect-only: rule-2 `Missing` is on the export list and is declared nowhere in this module. Same code as an exported-but-undefined function: the entry names nothing.")
(:doc :symbol "asl/grammar/corpus/semantic/import-cycle/a.asl#fromA" :text "expect: rule-11 Half of a two-file cycle. A cycle cannot be expressed in one file, which is why this fixture is a directory: a flat glob would never see it.")
(:doc :symbol "asl/grammar/corpus/semantic/import-cycle/b.asl#fromB" :text "expect: rule-11 The other half; see a.asl.")
(:doc :symbol "asl/grammar/corpus/semantic/importUnexportedCase.asl#make" :text "expect-only: rule-9 `secret` is a case of core/private's Hidden, which is not exported. A case is public exactly when its type is, so reaching one of an unexported union is the same violation as naming the union.")
(:doc :symbol "asl/grammar/corpus/semantic/importUnexportedType.asl#tag" :text "expect-only: rule-9 `Hidden` is declared by core/private and is absent from its export list. The import is well-formed and the qualified type is well-shaped; only the other module's contract says the type is private.")
(:doc :symbol "asl/grammar/corpus/semantic/importedCallArity.asl#big" :text "expect-only: arity `s/circle` is exported and well-shaped, so rule 9 is satisfied; only the declaration in core/shapes says the case takes one argument. Arity does not stop being checkable at a module boundary — the import table carries the callee's parameters.")
(:doc :symbol "asl/grammar/corpus/semantic/importedCtorMissingField.asl#make" :text "expect-only: ctor `value` has no :default, and construction rules do not change across a module boundary. Validating keys against the local schema table instead reports nothing at all here.")
(:doc :symbol "asl/grammar/corpus/semantic/importedTypeMismatch.asl#Shape" :text "expect-only: type A locally declared Shape where the imported one is required. Identity is nominal and keyed by defining module, so the two must not unify — this is the only fixture covering that direction.")
(:doc :symbol "asl/grammar/corpus/semantic/int32LiteralOutOfRange.asl#bump" :text "expect-only: literal-range The same rule at the narrow width, where the literal is in range for Int64 and so only the context decides: `n` fixes the operand type at Int32, and the literal has to fit that, not the width it would take on its own.")
(:doc :symbol "asl/grammar/corpus/semantic/int64LiteralOutOfRange.asl#ceiling" :text "expect-only: literal-range The literal is one past Int64's greatest value. Nothing has been computed, so section 3.1's trap does not apply — the program is wrong before it runs. It has to be rejected here because the former hosts disagreed about it silently: Python has no width to notice with and answers 9223372036854775808, while rustc refuses the same literal outright.")
(:doc :symbol "asl/grammar/corpus/semantic/literalInCallHead.asl#difference" :text "expect-only: not-callable `(-1 2)` is a call whose callee is the number -1, because a sign binds to the digits after it. Written with a space, `(- 1 2)` is subtraction; written without, it is this. Both former backends only discovered it at compile time — a TypeError from Python, E0618 from rustc — so the checker is to name it instead.")
(:doc :symbol "asl/grammar/corpus/semantic/mapFloatKey.asl#lookup" :text "expect-only: map-key-order A Float64 Map key type-checked and could reach no backend: BTreeMap needs Ord, and the specification asks mapKeys for sorted order, which f64 cannot give.")
(:doc :symbol "asl/grammar/corpus/semantic/mapKeyInferred.asl#tally" :text "expect-only: map-key-order No Map is written anywhere: mapFromPairs takes the key type from the list it is given, so a rule reading annotations has nothing to look at and this program reached rustc, where the f64: Ord bound in rt rejected it.")
(:doc :symbol "asl/grammar/corpus/semantic/mapKeyIoError.asl#lookup" :text "expect-only: map-key-order IoError is an opaque host value with no order either; the rule is that a key has one, not that it avoids Float64.")
(:doc :symbol "asl/grammar/corpus/semantic/mapKeyNested.asl#outer" :text "expect-only: map-key-order A Map used as a Map key reaches the same Float64 by two routes. That is one defect, and a pass that recurses after scanning reports it twice.")
(:doc :symbol "asl/grammar/corpus/semantic/mapKeyRecord.asl#Point" :text "expect-only: map-key-order A record is orderable only if every field is. Point holds a Float64, so the Rust lowering derives no Ord for it and BTreeMap<Point, _> does not compile.")
(:doc :symbol "asl/grammar/corpus/semantic/mapKeyThroughTypevar.asl#blank" :text "expect-only: map-key-order The key is the type argument of a generic function, fixed only by the argument at the call site: `probe` writes no Map, and `blank`'s own key is the rigid K of its signature (the host reads no {K} binder). Nothing an annotation-reading rule can see is wrong here.")
(:doc :symbol "asl/grammar/corpus/semantic/mixedModuleMatch.asl#Shape" :text "expect-only: rule-4 The arms mix a local case and an imported one. Keyed on the bare enum name the two collapse to \"Shape\", the arms-mix test cannot fire, and the file checks clean while matching one union's value against another's constructor.")
(:doc :symbol "asl/grammar/corpus/semantic/nonExhaustiveImportedMatch.asl#label" :text "expect-only: rule-4 The match omits `rectangle`. Exhaustiveness left keyed on the local case table reports \"s/circle is not a case of any union\" beside rule-4, and a gate that asserts `want in codes` accepts that — which is why this fixture is expect-only.")
(:doc :symbol "asl/grammar/corpus/semantic/nonExhaustiveMatch.asl#Shape" :text "expect: rule-4 A match over a closed union that omits a case. Every arm is well-formed, so the omission is only visible against the enum that declares the union.")
(:doc :symbol "asl/grammar/corpus/semantic/numericMix.asl#addWidths" :text "expect: rule-6 Both operands are declared, both are integers, and the widths differ. Core has no implicit conversion, so this is an error rather than a widening.")
(:doc :symbol "asl/grammar/corpus/semantic/parenthesisedCaseIsNotABinder.asl#code" :text "expect-only: rule-4 §5.4 gives `(<case> <p>*)` and `<ident>` different meanings: parenthesised is a case test, bare is a binder that matches anything. Read the other way round — `(notFound)` binding rather than testing — the first arm is a catch-all and this match is exhaustive, so the missing cases are exactly what pins the distinction the backends had to agree on.")
(:doc :symbol "asl/grammar/corpus/semantic/privateTypeInExportedSignature.asl#Shape" :text "expect-only: rule-13 `area` is exported and its parameter type is declared here and not exported, so no importer can write the type of what it receives. This scenario survives a fix that checks only the lexical half untouched.")
(:doc :symbol "asl/grammar/corpus/semantic/qualifiedCtorUnexported.asl#make" :text "expect-only: rule-9 core/private declares Vault and does not export it. This reaches the checker through the ctor head, a different path from the qualified-name scan; an implementation that only did the latter reports rule-2 here.")
(:doc :symbol "asl/grammar/corpus/semantic/reservedPrefix.asl#agentscript-internal" :text "expect: rule-7 agentscript- is a reserved compiler-internal prefix (asl/agentSpecCore.md 2). This name is lexically well-formed, so rejection must come from the reserved rule itself and not from an unrelated character-class violation.")
(:doc :symbol "asl/grammar/corpus/semantic/tryInLambda.asl#parseIt" :text "expect: rule-5 The enclosing fn does return a Result, but try sits inside a lambda, where the specification does not say what it returns from. Superseded: the host has no try, so it rejects this file with ERR_UNKNOWN_SYMBOL try, not for rule 5.")
(:doc :symbol "asl/grammar/corpus/semantic/tryOutsideResult.asl#parseIt" :text "expect: rule-5 try propagates an error out of the enclosing fn, and this one does not return a Result, so there is nothing for it to propagate into. Superseded: the host has no try, so it rejects this file with ERR_UNKNOWN_SYMBOL try, not for rule 5.")
(:doc :symbol "asl/grammar/corpus/semantic/unappliedPairType.asl#left" :text "expect-only: type-arity The other half of the same rule: a bare Pair has no first component for `.-first` to name, so the accessor's type cannot be read off it.")
(:doc :symbol "asl/grammar/corpus/semantic/unappliedResultType.asl#parseIt" :text "expect-only: type-arity §3 writes Result applied — `(Result T E)`. Bare, it names no type, and the error half a match would take apart does not exist to be read.")
(:doc :symbol "asl/grammar/corpus/semantic/unboundInCond.asl#classify" :text "expect-only: rule-2 The same undefined call as unboundName.asl, moved inside a cond. `cond`'s children are clauses rather than expressions, and a resolution pass that descends only into expressions reports nothing here — the form checked clean while the identical call one line out was rejected.")
(:doc :symbol "asl/grammar/corpus/semantic/unboundName.asl#total" :text "expect: rule-2 `tallyUp` is called and defined nowhere — not in the prelude, not in this module, not under an alias. No grammar can tell that from a well-formed call.")
(:doc :symbol "asl/grammar/corpus/semantic/unboundTypevar.asl#identity" :text "expect: rule-10 A is used as a type but bound in no { } binder (asl/agentSpecCore.md 9, rule 10). Well-formed to any grammar: nothing context-free distinguishes a bound type variable from an undeclared concrete type name.")
(:doc :symbol "asl/grammar/corpus/semantic/undeterminedLambda.asl#applyLater" :text "expect: annotation The lambda is bound by a let, not passed to anything, so no signature says what its parameter is. Elision is legal where the position determines the type; here nothing does, and the annotation is required.")
(:doc :symbol "asl/grammar/corpus/semantic/unexportedMember.asl#clean" :text "expect: rule-9 `trim` exists in core/strings but is not on its :export list. The import is well-formed and the qualified name is well-shaped; only the imported module's contract says the member is private.")
(:doc :symbol "asl/grammar/corpus/semantic/unimportedAliasType.asl#tag" :text "expect-only: rule-9 `q` is bound by no :import entry, so q/Shape names no module at all. Without a pass that scans type position, nothing looks at this token.")
(:doc :symbol "asl/grammar/corpus/semantic/wrongAliasType.asl#tag" :text "expect-only: rule-9 Two imports, and Shape is reached through the alias that does not define it. \"the module has no such type\" and \"it has one but keeps it private\" share a code path, and this covers the first of them.")
(:doc :symbol "asl/grammar/corpus/semantic/wrongArgumentType.asl#size" :text "expect: type stringLength is declared String -> Int64 in the prelude; the call site says otherwise. Only the signature makes this visible.")
(:doc :symbol "asl/grammar/corpus/semantic/wrongArity.asl#add" :text "expect: arity The call is shaped correctly and passes both grammars; only the declaration it resolves to says how many arguments it should have carried.")
(:doc :symbol "asl/grammar/corpus/semantic/wrongReturnType.asl#label" :text "expect: type The body is well-formed and its value has nothing to do with the declared return type.")
(:doc :symbol "asl/grammar/corpus/valid/01-basics.asl#Point" :text "Records, construction, field access, arithmetic.")
(:doc :symbol "asl/grammar/corpus/valid/02-match.asl#sumList" :text "Pattern matching over Option and Result. A list is not a pattern: it is taken apart through listHead and listTail, which return Options.")
(:doc :symbol "asl/grammar/corpus/valid/03-strings.asl#shout" :text "String builtins, let bindings, Result propagation by match.")
(:doc :symbol "asl/grammar/corpus/valid/04-longest-run.asl#runLength" :text "The worked example from asl/agentSpecCore.md section 7, with its list patterns taken apart through listHead and listTail and its pair through mt, since lists are not patterns and a pair has no .-second field.")
(:doc :symbol "asl/grammar/corpus/valid/05-constructors.asl#smallPrimes" :text "Constructor builtins used as ordinary expressions (spec 6.5, 6.6), not as match patterns. A list is not a pattern (the host rejects (list) in an arm as an unknown symbol), so here each head is only a constructor.")
(:doc :symbol "asl/grammar/corpus/valid/06-module.asl#Box" :text "Module header, type variables in annotations (the host reads no type-parameter binder and does not check them), closed unions, keyed collection.")
(:doc :symbol "asl/grammar/corpus/valid/07-lambda-elision.asl#evens" :text "Lambda annotations elided: each of these positions is an argument to a builtin whose signature fixes the parameter and return types completely, so writing them again could not differ from what the position already says.")
(:doc :symbol "asl/grammar/corpus/valid/08-io.asl#describe" :text "I/O and the effect marker. `!` on a declaration says it touches the world; it is inferred inside a body but written on the signature, because a caller reads the signature and not the body. The host has no fileWrite, so the copy this fixture once made is gone and it only echoes.")
(:doc :symbol "asl/grammar/corpus/valid/09-imported-types.asl#label" :text "A type crossing a module boundary: named in a signature, matched through its imported cases, and constructed. This is also the fixture that names an imported type and therefore has to import its module (§4.0).")
(:doc :symbol "asl/grammar/corpus/valid/10-imported-generic-types.asl#depthOf" :text "A parameterised imported type instantiated at Int64, destructured recursively, and an imported record constructed and read through .-field.")
(:doc :symbol "asl/grammar/corpus/valid/11-name-coexistence.asl#Shape" :text "A local Shape and an imported one coexist: distinct types, distinct spellings. core/shapes is imported under two aliases, and a value reached through one is handed to a function typed by the other — they must be the same type.")
(:doc :symbol "asl/grammar/corpus/valid/12-transitive-use.asl#show" :text "Transitivity: this module calls through an intermediary that speaks in a third module's type, and never imports that third module. Naming the type would require the import — corpus/valid/09 is the fixture that does.")
(:doc :symbol "asl/grammar/corpus/valid/13-module-program.asl#describe" :text "A whole program across a module boundary: an imported union matched, an imported function called, and one module reached through two aliases. The two former backend targets represented that union completely differently — a tagged tuple on one, a namespaced variant on the other — and each derived its representation independently, so only running both proved they agreed.")
(:doc :symbol "asl/grammar/corpus/valid/14-sequenced-bodies.asl#tally" :text "A multi-expression body in every position the grammar admits one: a function body, a `let` body, a `cond` clause, an `:else` clause, a `match` arm and a lambda body. Each non-final expression is a `println`, so an evaluator that skips one without emitting it prints a line short.")
(:doc :symbol "asl/grammar/corpus/valid/15-shadowed-binders.asl#stringFromShadow" :text "A binder inside an imported module must win over a top-level name it collides with. The higher-order case is the sharp one: passing the shadowed name to `map` compiled, type-checked and ran on both former targets while calling the wrong function, so only a written-down expected output catches it.")
(:doc :symbol "asl/grammar/corpus/valid/16-recursive-schema.asl#Node" :text "A self-referential record. The field naming its own declaration has no statically known size on the former Rust target, so it was boxed — and the box had to be put on at construction and taken off at every read, or the declaration was the only place the three agreed.")
(:doc :symbol "asl/grammar/corpus/valid/17-nested-cons.asl#pairwise" :text "Nested list destructuring. A list is not a pattern on the host (cons in an arm is an unknown symbol, and patterns nest one level), so two heads are taken one level at a time through listHead and listTail.")
(:doc :symbol "asl/grammar/corpus/valid/18-pattern-binders.asl#outcome" :text "A bare identifier in a pattern is a binder; a parenthesised one names a case. Both readings of one name appear here: the prelude seeds `notFound` as an IoError case, so the collision is live without anything being declared. Patterns nest one level, so the case test sits in an inner match.")
(:doc :symbol "asl/grammar/corpus/valid/19-io-errors.asl#label" :text "A file reader, and the whole IoError surface it can reach. The six cases are ordinary nullary constructors, so `--labels` executes every one of them and pins its spelling; the host mapping from errno to case is what only a real failing call reaches. The host has no file-append, fileExists?, read-line or read-all, so the log appender this fixture once was is now a reader.")
(:doc :symbol "asl/grammar/corpus/valid/20-option-result-ctors.asl#flag" :text "Both polarities of every Option and Result predicate, inside a single case: one half of the pair parses and one does not, so a predicate stuck at `true` fails on the other half. The pair is returned positionally, which is what makes an argument swap in `pair` visible at all — both components are String.")
(:doc :symbol "asl/grammar/corpus/valid/21-option-result-combinators.asl#resolve" :text "The Option and Result combinators in a chain, with the failure carried all the way to the output. A pipeline that routes its failure through resultToOption discards the error, which is how three different `resultMapErr` bodies once produced byte-identical output; here the mapped error is printed.")
(:doc :symbol "asl/grammar/corpus/valid/22-boolean-algebra.asl#mark" :text "Every comparison and both connectives, reported as eight independent columns. A strict operator written where a non-strict one belongs differs only at the boundary, so the cases put `x` exactly on `lo` and exactly on `hi`; and both connectives take all the operand combinations that separate them.")
(:doc :symbol "asl/grammar/corpus/valid/23-numeric.asl#oi" :text "Every numeric builtin at Int64 and at Float64, in the same shape, because \"exercised\" has meant \"exercised at one type\": `/` and `mod` were counted as covered while their Rust lowerings took i64 alone. The float leg is the half that did not compile. Truncation toward zero, the zero divisor, the Int32 boundary and 2^53+1 each get their own case. The Int64 boundary is the second half: the type is fixed, so an operation whose result leaves it traps rather than widening — which one former host did by not having a width at all. A trap is not a value, so the .run expression cannot assert one: each trap* function is expected to trap when called.")
(:doc :symbol "asl/grammar/corpus/valid/24-list-reshaping.asl#showList" :text "Reshaping a list, with the composed return shapes the former differential harness had to encode: `(Option (List T))` and `(List (Pair A B))`. The slice cases sit on both ends of the half-open interval, and `listGet` reads index 1 — neither the head nor the last element, so an off-by-one is visible.")
(:doc :symbol "asl/grammar/corpus/valid/25-list-aggregation.asl#showFloats" :text "Aggregation over (List Float64), which is the instantiation listSum, listSort, listMin and listMax never had: their Rust lowerings were i64-only or bounded by Ord. The input is unsorted and carries a duplicate, so an identity sort is visible, and the integer entry sorts by a projection, which is the builtin that shipped with its arguments reversed. A NaN is where an ascending sort stops being obvious: it is unordered against every number, so a comparator built out of `<` leaves it wherever the host's algorithm happened to put it, and the two hosts put it in different places.")
(:doc :symbol "asl/grammar/corpus/valid/26-map-lifecycle.asl#tally" :text "A map built, queried and shrunk, with its size printed before and after the removal: a mapRemove that does nothing is indistinguishable from a correct one unless both sizes are shown, and one case removes a key that is absent. The key order is the specification's, not the insertion order, and the two former backends reached it by different routes — sorted() on one, BTreeMap on the other.")
(:doc :symbol "asl/grammar/corpus/valid/27-string-query.asl#mark" :text "Querying a string. Both arguments are String, so a haystack/needle swap type-checks and compiles: the cases assert the index, not merely that one was found. The needle sits at the start in one case and at the end in another, which is what separates stringStartsWith? from stringEndsWith?, and the last case is non-ASCII, where a byte offset and a character offset differ.")
(:doc :symbol "asl/grammar/corpus/valid/28-string-transforms.asl#showInt" :text "Transforming a string, with every operation reported beside the one it could be confused with: lower beside upper, replace over an input that contains the needle more than once, reverse over a non-palindrome, and both parsers over inputs that only one of them accepts.")
(:doc :symbol "asl/grammar/corpus/valid/29-literals.asl#Cursor" :text "A sign belongs to the digits it precedes. `-1` used to be read as the subtraction operator applied to `1` — a legal parse of the same characters, and the one the Earley resolver chose — so `(+ x -1)` lowered to `_agentscript.add(x, _)` and `rt::add(x.clone(), _.clone())`: the wildcard token, leaking out of pattern position, on both backends at once. No fixture had ever written a negative number, so every gate was green over it. Every literal form that can carry a sign is here, because a sign is not the only thing a literal can get wrong: both integer widths at both boundaries (Int64::MIN has no positive counterpart, so it exists only as a signed literal), a negative float, negative zero, a negative literal as a match pattern, as a field default, and inside an elided lambda.")
(:doc :symbol "asl/grammar/corpus/valid/30-nano-program.asl#Reading" :text "The Nano projection as a whole program, which was the only shape that reached the former wasm arm: function-mode cases ran five targets and `main` ran six. The import is the point of it — the reference interpreter recognized a module option by the prefix of its text, so `:i` was an option it did not know and every import a Nano module declared was dropped in silence, leaving the alias unbound at its use site while all four transpilers were green.")
(:doc :symbol "asl/grammar/corpus/valid/30-nano-projection.asl#Sample" :text "The Nano projection, written the way an agent under a token budget writes it: every declaration head in its short spelling, every option keyword in its short spelling, and every type alias in a position a backend has to emit. No corpus fixture had ever been Nano-spelled, so `check_corpus` and the differential gate had only ever seen verbose source — and three of the four backends were printing the alias verbatim, so `pub v: I64`, `readonly v: I64` and `v I64` reached rustc, tsc and go vet, which reject all three. Python hid it by emitting no types at all. `F32` is the case that matters most: it is a reserved width Core does not have, resolving to Float64 and carrying none of a narrower width's semantics. Target: it lowers as Float64 on every backend, not as a per-backend guess at a 32-bit float; today no backend builds (asl build is unimplemented) and the host checks no types.")
(:doc :symbol "asl/grammar/corpus/valid/31-alias-keys.asl#P" :text "A Nano alias is significant only in the position the projection names. `:x` is `:export` in a module header and nothing at all in a constructor argument, so a record whose field names are exactly the six option letters is an ordinary record. This fixture is the pin: a transcoder, formatter or grammar that rewrites `:x` by pattern-matching on the text rather than on the position turns `(P :x 1)` into `(P :export 1)` and every field below stops resolving.")
(:doc :symbol "asl/grammar/corpus/valid/32-json-case.asl#Account" :text "§4.1's wire-naming controls, which are pinned now even though Core ships no serializer, so that adding one later cannot silently change the format. Both grammars rejected `:json-case` until this fixture existed: the specification defined a form no parser accepted, and nothing was looking.")
(:doc :symbol "asl/grammar/corpus/valid/33-notes.asl#initials" :text "A note is a string literal bound to nothing. The body position already admitted\none; the top level did not, so a file banner or a note between declarations had\nnowhere to live. A note is an ADDITION beside the `;` comment, not a replacement\nfor it: the host still reads `;` as a comment to the end of the line. Notes sit between declarations as well as inside them; the host evaluates a\ntop-level one at load and discards it. A note may span lines.")
(:doc :symbol "asl/grammar/corpus/valid/34-multiline-program.asl#helpText" :text "The same literal crossing a process boundary, which is the arm no function-mode case reaches. A newline that arrived as two characters, or as a target's own line ending, shows up here as a stdout mismatch between runners rather than as a compile error. A top-level note spanning two lines, which the host evaluates at load and\n discards, and which therefore proves the erasure, not the escaping.")
(:doc :symbol "asl/grammar/corpus/valid/34-multiline-strings.asl#banner" :text "The STRING terminal admits a raw newline between the quotes, and now that a comment is spelled as a free-standing string, a note running to a second line is ordinary source. Every backend passed the token through verbatim, so the raw newline landed between the target's quotes. Rust takes a multi-line literal and Python, TypeScript and Go reject one, so three of four emitted source their own compiler refused, while the grammar, the checker and every gate stayed green over it: no fixture had ever written one. A raw tab rides along because it is the other character the grammar lets through as itself, and `lines` splits on the escape form of the same newline the banner spells raw, so the two spellings have to arrive as one character. Help text is where a multi-line literal stops being exotic and becomes the\n ordinary case, which is why this module is written as help text.")
(:doc :symbol "asl/grammar/corpus/valid/35-metadata-tags.asl#User" :text "Decoupled metadata tags (:tag) in module, fn, schema and enum. Target: no specification section defines :tag yet; today asl-host check rejects (:tag ...) inside schema and enum with ERR_BAD_DEFINITION.")
