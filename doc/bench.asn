(:doc :symbol "asl/bench/algo/variants/tight.asl#" :text "Most frequent letters in a space-separated string (HumanEval/111).")
(:doc :symbol "asl/bench/gen/core.asl#Card" :text "a prompt card for one arm: arm name, card text, its sha256 digest and its token count")
(:doc :symbol "asl/bench/gen/core.asl#Case" :text "one test case of a task: name (e1, e2 for examples, c1..c6 for graded cases), args as a list of Sx values and the wanted Sx result, where a want headed 'fails' means the call must fail")
(:doc :symbol "asl/bench/gen/core.asl#Config" :text "run configuration: root, aslBin, work dir, out file, repair turns, max tokens, input and output prices, spend cap in pico dollars, checkFirst flag, infraTries (default 6) and infraWaitMs (default 20000)")
(:doc :symbol "asl/bench/gen/core.asl#Grade" :text "result of grading one candidate: stage name, the tool output and the list of failing case names")
(:doc :symbol "asl/bench/gen/core.asl#Outcome" :text "result of one trial: the trial, its turns, rawPass (first turn ok), healedPass, solved (last turn ok), served model, error, wall ms, card token count, header-stripped flag, spend, promptSha and abandoned-call count with its pico cost")
(:doc :symbol "asl/bench/gen/core.asl#Reply" :text "a model reply: text, input and output token counts, served model name, error text, and abandoned call counts with their in and out tokens (all defaulting to 0)")
(:doc :symbol "asl/bench/gen/core.asl#Req" :text "a model request: model, arm, task id, rep, turn, system text, messages as role and text pairs, max tokens and sendsLeft, the sends the cap still covers (default 8)")
(:doc :symbol "asl/bench/gen/core.asl#RunState" :text "running totals of a trial run: spent, done, skipped and callFails counts, and the stopped reason (empty while running)")
(:doc :symbol "asl/bench/gen/core.asl#Sx" :text "parsed s-expression: an atom, a quoted string or a list of Sx values")
(:doc :symbol "asl/bench/gen/core.asl#Task" :text "a generation task: id, family, difficulty, statement, entry name (asl and ts) and entryPy, the signatures for asl, py and ts, two example cases and six graded cases")
(:doc :symbol "asl/bench/gen/core.asl#Trial" :text "one planned trial: index, arm, task, model and repetition number")
(:doc :symbol "asl/bench/gen/core.asl#Turn" :text "one conversation turn of a trial: graded stage, input and output tokens and the reply text")
(:doc :symbol "asl/bench/gen/core.asl#allArms" :text "the five core arms: py, ts, asl, aslParen, aslWrapFn")
(:doc :symbol "asl/bench/gen/core.asl#armKnown?" :text "true when the arm is a core arm or a lab arm")
(:doc :symbol "asl/bench/gen/core.asl#armLang" :text "the language of an arm: py for py, ts for ts, asl for every other arm")
(:doc :symbol "asl/bench/gen/core.asl#aslHarness" :text "the candidate module source: a module header exporting runTests, the code, and a runTests that binds each case as a genCase check (a fails case must return err, others must equal the wanted value) and asserts the conjunction of all of them")
(:doc :symbol "asl/bench/gen/core.asl#asnQuote" :text "wraps a string in double quotes, escaping backslash, double quote, newline, tab and carriage return")
(:doc :symbol "asl/bench/gen/core.asl#bracketToParen" :text "rewrites square brackets outside strings to parens: a bracket right after let or fn becomes a plain open paren, any other becomes the text open-paren list plus a space, and every closing bracket becomes a close paren")
(:doc :symbol "asl/bench/gen/core.asl#callCost" :text "cost of a call in pico dollars: tokIn times priceIn plus tokOut times priceOut")
(:doc :symbol "asl/bench/gen/core.asl#cardFor" :text "the card text of an arm: fixed system sentences for py and ts, for asl arms the llms.txt section The language (asl appends the signature sentence and errors when it is empty, aslParen and aslWrapFn apply their substitution lists), an error for an unknown arm or a missing section")
(:doc :symbol "asl/bench/gen/core.asl#cardOf" :text "the card of an arm from a card list, or an empty card (empty text and sha, 0 tokens) when the arm has none")
(:doc :symbol "asl/bench/gen/core.asl#cardSignatures" :text "reads sigNames.asn text and returns the name and note pair of every (:sig ...) form, or an error prefixed sigNames.asn when the text does not parse")
(:doc :symbol "asl/bench/gen/core.asl#charAt" :text "the one-character string at index i, or the empty string when i is out of range")
(:doc :symbol "asl/bench/gen/core.asl#clip" :text "the text cut to its first n characters, unchanged when it is not longer than n")
(:doc :symbol "asl/bench/gen/core.asl#conventionFor" :text "the prompt sentence on how a missing result and a failure are expressed: None and ValueError for py, undefined and Error for ts, (none) and (err message) for any other language")
(:doc :symbol "asl/bench/gen/core.asl#dateOf" :text "the UTC calendar date YYYY-MM-DD of an epoch nanosecond count, by the days-to-civil conversion")
(:doc :symbol "asl/bench/gen/core.asl#definesEntry?" :text "true when the text declares the name as a whole word after fn, def or function")
(:doc :symbol "asl/bench/gen/core.asl#exampleLine" :text "one example of a task in the arm's language: the call rendered for that language followed by 'returns' and the wanted value, or by a raises ValueError, throws an Error or returns (err message) note for a fails case")
(:doc :symbol "asl/bench/gen/core.asl#expectedPromptSha" :text "the prompt digest a row must carry for a card digest, arm and task: promptShaOf of the card digest and the user prompt")
(:doc :symbol "asl/bench/gen/core.asl#extractCode" :text "the body of the first fenced code block of a reply (after the opening line, up to the closing fence), or none when there is no complete block")
(:doc :symbol "asl/bench/gen/core.asl#failingOf" :text "the case names from the tool output lines that start with FAILCASE, taking the second space-separated field of each")
(:doc :symbol "asl/bench/gen/core.asl#fakeCaller" :text "a stand-in model caller over an Int64 call counter: increments the counter and answers each request with fakeReply! for the given root and plan")
(:doc :symbol "asl/bench/gen/core.asl#fakeReply!" :text "a canned reply for a request from the plan entry of its arm and task (good by default; never, fixed, heal, parse, execute, noBlock or an explicit behaviour=reference text), wrapping the reference solution or a broken variant in a fenced block, with token counts estimated at 4 characters each and an error when no reference file asl/bench/gen/ref/TASK.LANG exists")
(:doc :symbol "asl/bench/gen/core.asl#formatFor" :text "the prompt sentences demanding exactly one fenced code block with the complete solution and no tests, with a no-module-header sentence added for asl")
(:doc :symbol "asl/bench/gen/core.asl#fromWrapFn" :text "converts each top-level (fn name [params] -> ret body) form to a bare fn line with its body indented two spaces, leaving text that does not parse as such a form unchanged")
(:doc :symbol "asl/bench/gen/core.asl#gradeCode!" :text "grades a code string for an arm: py and ts run their own harness, other arms are normalised first; returns the grade and whether a module header was stripped (false for py and ts)")
(:doc :symbol "asl/bench/gen/core.asl#gradeReply!" :text "grades a model reply against the task's graded cases: stage extract with a fixed message when the reply holds no complete fenced block, otherwise gradeCode! on the extracted code; returns the grade and the header-stripped flag")
(:doc :symbol "asl/bench/gen/core.asl#hasWord?" :text "true when the name occurs in the text with no word character (letter, digit, underscore) directly before or after it; false for an empty name")
(:doc :symbol "asl/bench/gen/core.asl#headOf" :text "the text of the first item of an Sx list (empty string when there is none or it is a list)")
(:doc :symbol "asl/bench/gen/core.asl#headerRow" :text "the single :run header row of a results file: run id FABLE-LANG-01, protocol, mode, planSig, models, arms, task ids, reps, repairs, max tokens, temperature 0.2, seed, prices, cap in pico and usd, cards with sha256 and tokens, tool versions, date and note")
(:doc :symbol "asl/bench/gen/core.asl#healedPass!" :text "true when healedStage! for the reply is ok")
(:doc :symbol "asl/bench/gen/core.asl#healedStage!" :text "stage of the reply's code after the asl heal command rewrote it: extract when no code block, harness when the file cannot be written, otherwise the grade stage of the healed copy (infra when the heal child or the grade stayed infrastructure through all attempts)")
(:doc :symbol "asl/bench/gen/core.asl#infraOf" :text "the infrastructure reason of a finished tool child, or empty when it judged the program: nativeCli for a stale or absent native CLI or a refused rebuild (except compile failures of cand. or candHealed.), the fleet verdict when the child was ended by limits, noDiagnostic for a failed check without a diagnostic")
(:doc :symbol "asl/bench/gen/core.asl#kwBool" :text "true when the value after the keyword in an Sx item list has the text true, false when absent or any other text")
(:doc :symbol "asl/bench/gen/core.asl#kwFind" :text "the item that follows the first atom equal to the key in an Sx item list, or none when the key is absent or last")
(:doc :symbol "asl/bench/gen/core.asl#kwInt" :text "the value after the keyword parsed as an Int64, 0 when absent or not a number")
(:doc :symbol "asl/bench/gen/core.asl#kwList" :text "the items of the list value after the keyword, empty when the key is absent or its value is not a list")
(:doc :symbol "asl/bench/gen/core.asl#kwText" :text "the text of the atom or string after the keyword, empty when absent or the value is a list")
(:doc :symbol "asl/bench/gen/core.asl#labArms" :text "the eight lab arms: aslCardAsn, aslCardContrast, aslCardExample, aslCardMin, aslCardStr, aslCardSig, aslCardTextEx, aslCardNoSig")
(:doc :symbol "asl/bench/gen/core.asl#languageSection" :text "the section of llms.txt from after the heading The language up to the next level-two heading, or an error when the heading or the section end is missing")
(:doc :symbol "asl/bench/gen/core.asl#loadCards" :text "reads asl/bench/gen/cards.asn under root and loads every :card row as a Card, verifying each card file against its recorded sha256; the first error ends the load")
(:doc :symbol "asl/bench/gen/core.asl#loadCardsFor" :text "the base cards, plus the rows of cardLab/cards.asn when any requested arm is a lab arm")
(:doc :symbol "asl/bench/gen/core.asl#loadTask" :text "reads and validates the task row asl/bench/gen/tasks/ID.asn under root; errors on an unreadable file, a parse error, a missing id, entry, signature or statement, or when it does not hold exactly 2 examples and 6 graded cases")
(:doc :symbol "asl/bench/gen/core.asl#loadTasks" :text "loads every .asn file of the tasks directory with loadTask in directory order, ignoring other files, stopping at the first error")
(:doc :symbol "asl/bench/gen/core.asl#normaliseAsl" :text "brings candidate asl of an arm to the standard surface (parenToBracket for aslParen, fromWrapFn for aslWrapFn, unchanged otherwise) and strips a leading module header; returns the code and whether a header was stripped")
(:doc :symbol "asl/bench/gen/core.asl#parenSubs" :text "the seven text substitutions (old, new) that turn the language section's square-bracket notation into parens-only notation for the aslParen card")
(:doc :symbol "asl/bench/gen/core.asl#parenToBracket" :text "rewrites the binding list or parameter list that follows let or fn from parens to square brackets, leaving strings untouched, and leaves the form as is when its end is not found")
(:doc :symbol "asl/bench/gen/core.asl#planSig" :text "the fnv1a64 hash, as decimal text, of the models, arms, task ids, reps, repairs, max tokens and seed joined with separators")
(:doc :symbol "asl/bench/gen/core.asl#planTrials" :text "every combination of model, arm, task and rep (1 through reps), ordered by the fnv1a64 hash of the seed and the trial key, and numbered 0 upward in that order")
(:doc :symbol "asl/bench/gen/core.asl#priorSpend" :text "the sum of :costPico over the :trial, :infra and :callFailed rows of an existing results text, or an error when the text does not parse")
(:doc :symbol "asl/bench/gen/core.asl#promptShaOf" :text "sha256 of the card digest, a line break and the user prompt")
(:doc :symbol "asl/bench/gen/core.asl#pyHarness" :text "the candidate python source: the code followed by a __gen_main that runs each case (fails cases must raise ValueError), prints FAILCASE lines for mismatches and a GENRESULT pass or fail line with the failure count, and exits 1 on any failure; a bool is not equal to a non-bool")
(:doc :symbol "asl/bench/gen/core.asl#readForms" :text "parses text into all its top-level Sx forms, or an error from the first malformed one")
(:doc :symbol "asl/bench/gen/core.asl#readSx" :text "reads one Sx form from the byte index, returning it with the index after it, or an error for end of text, an unmatched close paren, an unclosed string or list, or an unexpected character")
(:doc :symbol "asl/bench/gen/core.asl#registryType" :text "the type string of a builtin: the :type of its prelude.asn row, replaced by the checker signature when the checker has one, none when the prelude has no row for the name")
(:doc :symbol "asl/bench/gen/core.asl#removeDir!" :text "removes a directory with rm -rf under fleet limits and returns whether it exited 0, refusing (false) an empty path, the root, or a path that does not contain aslBenchGen")
(:doc :symbol "asl/bench/gen/core.asl#renderAsl" :text "renders a task value in the asl form: strings quoted, atoms as written, and list, tuple (pair), some, none, ok, dict (mapFromPairs or (mapEmpty)), tag, variant and record forms as constructor calls, an unrecognised head as (unknownValue head)")
(:doc :symbol "asl/bench/gen/core.asl#renderPy" :text "renders a task value as python: true and false capitalised, list as [..], tuple as (..), some and ok as the inner value, none as None, dict as {..}, tag as Enum.UPPER_SNAKE, variant and record as calls with snake_case keyword fields, an unrecognised head as unknown_value_head")
(:doc :symbol "asl/bench/gen/core.asl#renderTs" :text "renders a task value as typescript: list and tuple as arrays, some and ok as the inner value, none as undefined, dict as a new Map, tag as its quoted name, variant as an object with a kind field, record as an object, an unrecognised head as unknownValue_head")
(:doc :symbol "asl/bench/gen/core.asl#repairPrompt" :text "the next user message after a failed turn: for stage outputCap a request for a shorter answer with the code block first, otherwise the failing stage, the tool output clipped to 2000 characters, the failing case names when any, and a request for the corrected complete solution")
(:doc :symbol "asl/bench/gen/core.asl#reqChars" :text "character count of a request: system text length plus the lengths of all message texts")
(:doc :symbol "asl/bench/gen/core.asl#reqPromptSha" :text "the prompt digest of a request: promptShaOf of the sha256 of its system text and its first message text (empty when there is no message)")
(:doc :symbol "asl/bench/gen/core.asl#rowVerdict" :text "what a stored trial row says against its task, empty when consistent: a reply naming another task (answers task X), or prompt token counts that fail to grow between turns; empty also when the task id is unknown")
(:doc :symbol "asl/bench/gen/core.asl#runAll!" :text "runs every planned trial in order through trialStep!, threading the caller state and a RunState that starts at the prior spend with zero counts, and returns the final state and totals")
(:doc :symbol "asl/bench/gen/core.asl#runTrial!" :text "runs one trial in its own work directory t<idx> with a sandbox config file: loops turns through the caller and grades each reply, then returns the new caller state and an Outcome with rawPass, healedPass, solved, wall ms and spend")
(:doc :symbol "asl/bench/gen/core.asl#settle!" :text "runs attempt n starting at 1 and, while the grade stage is infra and n is below tries, waits waitMs and retries with n plus 1; any other grade, or the last attempt, is returned")
(:doc :symbol "asl/bench/gen/core.asl#sha256Of" :text "the sha256 digest of the UTF-8 bytes of a text")
(:doc :symbol "asl/bench/gen/core.asl#sigFor" :text "the signature text shown for an arm: the task's python or typescript signature, for aslWrapFn the asl signature with each fn line turned into the wrapped header form, otherwise the asl signature")
(:doc :symbol "asl/bench/gen/core.asl#signatureEntry" :text "one signature sentence entry: the name and type, followed by a comma and the note when the note is not empty")
(:doc :symbol "asl/bench/gen/core.asl#signatureLine!" :text "reads sigNames.asn and prelude.asn under root and returns the builtin signature sentence, or an error naming the unreadable file")
(:doc :symbol "asl/bench/gen/core.asl#signatureSentence" :text "the sentence made of the :sigs :lead text, then the signature entries of the :sig rows joined by semicolons, ending with a period; errors when a name is absent from the prelude, the lead is missing or there is no :sig row")
(:doc :symbol "asl/bench/gen/core.asl#slice" :text "the substring from a to b, with b capped at the text length, empty when out of range")
(:doc :symbol "asl/bench/gen/core.asl#sliceFrom" :text "the substring from index i to the end, empty when out of range")
(:doc :symbol "asl/bench/gen/core.asl#snake" :text "converts a camelCase name to snake_case by prefixing each upper-case character with an underscore and lowering it")
(:doc :symbol "asl/bench/gen/core.asl#stageOfReply" :text "outputCap when max tokens is positive, the reply text is empty and tokOut reached max tokens, otherwise the fallback stage")
(:doc :symbol "asl/bench/gen/core.asl#stripModuleHeader" :text "removes a leading (module ...) form and following whitespace from code and returns the rest with true, or the unchanged code with false when there is no complete module header")
(:doc :symbol "asl/bench/gen/core.asl#sxAtom" :text "Sx variant for a bare atom, carrying its text")
(:doc :symbol "asl/bench/gen/core.asl#sxItems" :text "the items of an Sx list, empty for an atom or a string")
(:doc :symbol "asl/bench/gen/core.asl#sxList" :text "Sx variant for a list, carrying its list of items")
(:doc :symbol "asl/bench/gen/core.asl#sxStr" :text "Sx variant for a quoted string, carrying its unescaped text")
(:doc :symbol "asl/bench/gen/core.asl#sxText" :text "the text of an Sx atom or string, empty for a list")
(:doc :symbol "asl/bench/gen/core.asl#toArm" :text "converts reference asl code to the arm's surface: bracketToParen for aslParen, toWrapFn for aslWrapFn, unchanged otherwise")
(:doc :symbol "asl/bench/gen/core.asl#toWrapFn" :text "converts bare fn lines to (fn name [params] -> ret ...) headers and closes each wrapped function with a paren after its last non-blank line, where the function ends at the next column-0 line")
(:doc :symbol "asl/bench/gen/core.asl#toolVersion!" :text "the trimmed output of a tool version command run from the root directory under a 30 s limit, or absent when it exits non-zero")
(:doc :symbol "asl/bench/gen/core.asl#trialKey" :text "the identity of a trial as arm, task id, model and rep joined by vertical bars")
(:doc :symbol "asl/bench/gen/core.asl#trialRow" :text "the one-line :trial ASN row of an outcome and its cost: key, arm, task, family, model, served, rep, pass flags, call and repair counts, stages, token lists and sums, tokens to green, card tokens, cost, wall ms, header-stripped flag, promptSha, an abandoned note when any, and the quoted replies")
(:doc :symbol "asl/bench/gen/core.asl#tsHarness" :text "the candidate typescript source: the code followed by a deep-equality checker (maps, arrays, objects), per-case checks (fails cases must throw), FAILCASE lines, a GENRESULT pass or fail line with the failure count, and exit code 1 on any failure")
(:doc :symbol "asl/bench/gen/core.asl#usdText" :text "pico dollars as a dollar amount with six decimals (whole part, point, zero-padded micro part), truncating below one micro dollar")
(:doc :symbol "asl/bench/gen/core.asl#usdToMicro" :text "parses a dollar text such as 1.25 into micro dollars, truncating fractions past six digits, none when it is not numeric, negative or has more than one point")
(:doc :symbol "asl/bench/gen/core.asl#userPrompt" :text "the first user message for an arm and task: the statement, the signature, the two examples, the language convention sentence and the format sentence")
(:doc :symbol "asl/bench/gen/core.asl#wrapFnSubs" :text "the three text substitutions (old, new) that rewrite the language section's bare-line function description into the parenthesised (fn name [params] -> ret body) form for the aslWrapFn card")
(:doc :symbol "asl/bench/gen/cardLab/examplesTest.asl#runTests" :text "card-lab gate: every builtin listed in the asl card and the aslCardMin program (pick) is called once with its expected result, covering list, string, map, option, pair, enum, with-record, cond, if and result operations")
(:doc :symbol "asl/bench/gen/cardLab/readProbe.asl#main" :text "entry of the reading probe: subcommand gen builds the items file (--items FILE), subcommand run asks a model (--model, --maxUsd, --card, --tasks, --maxTokens, --items, --out) to predict results and fix mutants; any other first argument returns the usage error")
(:doc :symbol "asl/bench/gen/cardLab/regrade.asl#main" :text "regrades the first reply of every trial row of a results file (args: RESULTS.asn and optional ARM filter) in a temp work dir, prints one regrade row per trial with the new stage, the old rawPass and the clipped output, returns 0, and errs with usage when the file is unreadable")
(:doc :symbol "asl/bench/gen/misses/missCorpusTest.asl#fixtureRows" :text "the fixture rows of asl/bench/gen/misses/catalogue.asn as lists of s-expression items, empty when the catalogue is unreadable or unparsable")
(:doc :symbol "asl/bench/gen/misses/missCorpusTest.asl#healed" :text "runs the heal pipeline on a candidate text named cand.asl with the given prelude vocabulary and returns its heal result")
(:doc :symbol "asl/bench/gen/misses/missCorpusTest.asl#missDir" :text "the directory of the miss corpus, asl/bench/gen/misses")
(:doc :symbol "asl/bench/gen/misses/missCorpusTest.asl#runTests" :text "MISS-ABSORB gate: loads the prelude vocabulary, requires 20 to 60 fixtures covering accept, heal and turn decisions, checks every fixture (absorb to the stored canonical form, diagnosed turn, parse strays) and that the 30 reference solutions come through heal byte-identical")
(:doc :symbol "asl/bench/gen/misses/missCorpusTest.asl#wrap" :text "prefixes a fixture body with the module header of the candidate, (module cand :x []) and a blank line")
(:doc :symbol "asl/bench/gen/misses/replay.asl#MissClass" :text "a miss class from the catalogue with fields id, prior (whether it was a known class before) and marks (output substrings that identify it)")
(:doc :symbol "asl/bench/gen/misses/replay.asl#Seen" :text "the outcome of replaying one failing reply with fields shot, raw (raw stage), err (first error line), cls (miss class), via (accept, heal, extract, harness or none) and after (stage after absorb)")
(:doc :symbol "asl/bench/gen/misses/replay.asl#Shot" :text "one failing ASL reply of a recorded trial with fields key, turn, model, arm, task, recorded (the stage the bench graded it at) and reply (the raw reply text)")
(:doc :symbol "asl/bench/gen/misses/replay.asl#classOf" :text "the id of the first class whose marks occur in the output, or other when none matches")
(:doc :symbol "asl/bench/gen/misses/replay.asl#firstError" :text "the first output line containing ERR_, error or unbound (else the first line), trimmed and clipped to 300 characters")
(:doc :symbol "asl/bench/gen/misses/replay.asl#loadClasses" :text "parses the (:class ...) rows of a catalogue text into miss classes, an empty list when the text does not parse")
(:doc :symbol "asl/bench/gen/misses/replay.asl#main" :text "offline replay: with --results DIR and --work DIR (its name must contain aslBenchGen; also --root, --asl, --limit) replays every failing asl reply of the .asn result files through check, heal, check and test, prints one shot row per reply then per-model, first-turn, per-class and total tallies, returns 0, and errs with usage when the paths are missing or unsuitable")
(:doc :symbol "asl/bench/gen/misses/replay.asl#shotsOf" :text "reads a results text and returns the shots of every trial row, or the parse error")
(:doc :symbol "asl/bench/gen/run.asl#linkIdle?" :text "true when the gateway loop holds no connections, no replies and an empty outbox, so no call is in flight")
(:doc :symbol "asl/bench/gen/run.asl#liveCall!" :text "one chat completion over the in-process gateway link with the pilot limits: up to 8 tries, a 300 s call limit and a 30 s back-off, returning the link and the reply")
(:doc :symbol "asl/bench/gen/run.asl#liveCallWith!" :text "one chat completion with explicit tries, call limit and back-off, tries capped by the request's sendsLeft (at least 1), retrying transient errors and returning the link and the reply with any abandoned sends counted")
(:doc :symbol "asl/bench/gen/run.asl#main" :text "entry of the generation bench: verify, dry, pilot, report TRIALS.asn..., cards and prompt subcommands, any other first argument returns the usage error")
(:doc :symbol "asl/bench/gen/run.asl#readyLink!" :text "returns the link as it is when it carries wiring (even if busy) and opens it through gs/linkOpen! only when it has none")
(:doc :symbol "asl/bench/gen/score.asl#ArmStat" :text "counts for one model and arm with fields model, arm, trials, expected, missing, rawPass, healedPass, solved, tokens, tokensNoCard, repairTurns, greens (sorted token counts of solved trials) and stages (first-failure tally per stage)")
(:doc :symbol "asl/bench/gen/score.asl#Header" :text "the (:run ...) header of a results file with fields arms, models, taskIds and reps")
(:doc :symbol "asl/bench/gen/score.asl#Row" :text "one trial row with fields key, arm, task, model, rep, rawPass, healedPass, solved, calls, tokens (in plus out), sysTok and firstFail")
(:doc :symbol "asl/bench/gen/score.asl#ScoreOut" :text "the scorer result with fields complete, lines, stats, error and rejected (default empty list)")
(:doc :symbol "asl/bench/gen/score.asl#headerOf" :text "builds the Header from the items of a (:run ...) row, reading :arms, :models, :taskIds and :reps")
(:doc :symbol "asl/bench/gen/score.asl#isqrt" :text "integer square root of n by Newton iteration, n itself for n below 2")
(:doc :symbol "asl/bench/gen/score.asl#main" :text "prints the score table for the given trial files and returns 0, errs with usage when no file is given and errs when an arm has missing trials (see report!)")
(:doc :symbol "asl/bench/gen/score.asl#pctText" :text "formats a per-mille integer as a percent with one decimal, with a minus sign for negatives")
(:doc :symbol "asl/bench/gen/score.asl#permille" :text "k over n as a rounded per-mille integer, 0 when n is not positive")
(:doc :symbol "asl/bench/gen/score.asl#quantile" :text "the element of a sorted list at index (pct*(n-1)+50)/100, 0 when the list is empty")
(:doc :symbol "asl/bench/gen/score.asl#rejectOf" :text "why a trial row is refused, empty when accepted: its stored prompt digest differs from the digest rebuilt from the header card sha and its task, or the row's replies and token counts fail gc/rowVerdict")
(:doc :symbol "asl/bench/gen/score.asl#report!" :text "reads and concatenates the result files, loads the task rows of the tree (refusing to score if they do not load), prints the score lines, returns 0 when complete and errs when an arm has missing trials or the text is unreadable")
(:doc :symbol "asl/bench/gen/score.asl#rowOf" :text "builds a Row from the items of a (:trial ...) row, with tokens as :tokInSum plus :tokOutSum")
(:doc :symbol "asl/bench/gen/score.asl#scoreText" :text "scores a results text without task checking, scoreTextWith with an empty task list")
(:doc :symbol "asl/bench/gen/score.asl#scoreTextWith" :text "scores a results text against the given tasks: refuses rows by rejectOf, drops duplicate keys, builds an ArmStat per model and arm, returns arm lines plus H1 to H4 comparisons only when every arm holds all its planned trials and a refusal line otherwise; errors when there is no (:run ...) header or the text is unreadable")
(:doc :symbol "asl/bench/gen/score.asl#stageNames" :text "the eight first-failure stages in order: ok, extract, outputCap, parse, check, execute, correct, harness")
(:doc :symbol "asl/bench/gen/score.asl#statFor" :text "the ArmStat of one model and arm from the rows, comparing rows against the keys expected from the header (arm, task, model, rep 1..reps) to count missing ones")
(:doc :symbol "asl/bench/gen/score.asl#statOf" :text "finds the ArmStat for a model and arm, none when absent")
(:doc :symbol "asl/bench/gen/score.asl#wilson" :text "95 percent Wilson interval for k successes of n as a pair of per-mille bounds in integer arithmetic, (0, 1000) when n is not positive")
(:doc :symbol "asl/bench/gen/tests/abandonTest.asl#runTests" :text "GENRUN-CROSSWIRE gate: abandoned requests are billed by their estimate (spend, row field :abandoned, resume prior spend), a cap just above one estimate stops the run with a budget stop after one failed trial, the request's sendsLeft reflects the cap, and readyLink! keeps the same busy link")
(:doc :symbol "asl/bench/gen/tests/genRunnerTest.asl#runTests" :text "FABLE-LANG-01 gate: pure rendering, fence extraction, wrap and paren spellings, price parsing, civil date and Wilson interval, outputCap stage and repair text, healed-unit failure classification, card chain against llms.txt and sigNames, and a dry run on three tasks and two arms with a fake model whose rows and scorer counts are asserted")
(:doc :symbol "asl/bench/gen/tests/infraDigestTest.asl#runTests" :text "GENRUN-CROSSWIRE gate: infra classification of tool results and retry via settle!, gc/rowVerdict on cross-wired and growing-token replies, a run with a failing CLI writes an infra row and resumes to a raw pass with the prompt digest, and the scorer refuses rows with a foreign digest or reply")
(:doc :symbol "asl/bench/gen/tests/linkCorrelationTest.asl#runTests" :text "GENRUN-CROSSWIRE gate: against a stand-in slow upstream, a call for alpha that passes a 400 ms limit is reported abandoned and the following call for beta gets the answer to beta, never the late alpha answer, leaving the link idle")
(:doc :symbol "asl/bench/gen/tests/validateTest.asl#runTests" :text "GENRUN-CROSSWIRE gate: the validator classes built rows (valid, crossWired, infra, blank), counts them, names the first cross-wired row and why, trusts rows only before the first 330 s trial or cross-wired row, and checks the filtered copy and the printed report line")
(:doc :symbol "asl/bench/gen/validate.asl#FileReport" :text "per-file validation counts with fields trials, valid, crossWired, infra, callFailed, firstBad (line index), firstBadKey, firstBadWhy, slowFrom (index of first slow trial) and trusted")
(:doc :symbol "asl/bench/gen/validate.asl#Judged" :text "one judged line of a results file with fields index, head, key, class, why, wallMs and line")
(:doc :symbol "asl/bench/gen/validate.asl#judgeLine" :text "classifies one line without running tools: a trial row is crossWired (with the verdict as why) or valid, an infra row is infra, any other row gets an empty class")
(:doc :symbol "asl/bench/gen/validate.asl#keptText" :text "the filtered file text: the run header lines and the valid rows before the first cross-wired or slow trial, one per line and ending in a newline")
(:doc :symbol "asl/bench/gen/validate.asl#main" :text "asl run validate.asl [--regrade] [--rows] [--write] RESULTS.asn ...: classifies every row of each file, prints one validate row per file (plus the bad rows with --rows), writes NAME.valid.asn with --write; errs on no file or an unknown flag")
(:doc :symbol "asl/bench/gen/validate.asl#reportLine" :text "the printed (:validate ...) row of a file report with path, counts, firstBad and slowFrom shown as none when 0, and trusted")
(:doc :symbol "asl/bench/gen/validate.asl#reportOf" :text "counts trials, valid, crossWired, infra and callFailed rows over the judged lines and finds the first cross-wired row and the first trial of 330 s or more; trusted counts valid rows before the earlier of the two")
(:doc :symbol "asl/bench/gen/validate.asl#slowWallMs" :text "the wall time of a trial from which its row is untrusted: 330000 ms")
(:doc :symbol "asl/bench/loop/core.asl#Acc" :text "accumulator of one trial's tool loop with fields turns, tokIn and tokOut (per reply), files read, bytesRead, calls (labels in order), stop reason, served model, error and spent")
(:doc :symbol "asl/bench/loop/core.asl#Block" :text "a task-file block with fields head (the words after the #@ marker) and lines (its body lines)")
(:doc :symbol "asl/bench/loop/core.asl#Cfg" :text "loop bench configuration with fields root, aslBin, work, out, maxTurns, maxTokens, trialTokens, resultClip, priceIn, priceOut, capPico, loadMax and loadWaitS")
(:doc :symbol "asl/bench/loop/core.asl#Edit" :text "a text edit with fields file, old, new and all (replace every occurrence)")
(:doc :symbol "asl/bench/loop/core.asl#Half" :text "one language half of a task with fields prompt, seeds and refs and gradeEdits (lists of Edit), accepts (file and text pairs) and absent (texts that must not remain)")
(:doc :symbol "asl/bench/loop/core.asl#LoopTask" :text "a loop bench task with fields id, kind, and the asl and py halves")
(:doc :symbol "asl/bench/loop/core.asl#Outcome" :text "the result of one trial with fields trial, acc, verdict and wallMs")
(:doc :symbol "asl/bench/loop/core.asl#RunState" :text "progress of a run with fields spent, done, skipped and stopped (empty reason while running)")
(:doc :symbol "asl/bench/loop/core.asl#Sandbox" :text "a trial sandbox with fields lang, trial (its directory), pkg (the package directory in it) and pristine (the source package it was copied from)")
(:doc :symbol "asl/bench/loop/core.asl#ToolOut" :text "a tool result with fields text, path and readLike (whether it counts as reading a file)")
(:doc :symbol "asl/bench/loop/core.asl#Trial" :text "one planned trial with fields arm, task, model and rep")
(:doc :symbol "asl/bench/loop/core.asl#Verdict" :text "grading result with fields suiteOk, acceptOk, absentOk, solved and detail")
(:doc :symbol "asl/bench/loop/core.asl#allArms" :text "the four arm names: py, pyB, aslA, aslB")
(:doc :symbol "asl/bench/loop/core.asl#applyEdits!" :text "applies the edits in order to files under the package, summing the replacement counts and stopping at the first error")
(:doc :symbol "asl/bench/loop/core.asl#armKnown?" :text "true when the arm is one of allArms")
(:doc :symbol "asl/bench/loop/core.asl#armLang" :text "py for arms starting with py, asl otherwise")
(:doc :symbol "asl/bench/loop/core.asl#armRich?" :text "true for arms ending in B, the ones with the outline, symbol, replace and rename tools")
(:doc :symbol "asl/bench/loop/core.asl#blocksOf" :text "splits a task text into blocks at lines starting with #@ , each holding the words of its head and its body lines in order; lines before the first marker are dropped")
(:doc :symbol "asl/bench/loop/core.asl#bodyOf" :text "the block's lines joined with newlines, with leading and trailing blank lines dropped")
(:doc :symbol "asl/bench/loop/core.asl#cleanOut" :text "makes tool output relative to the package: strips the sandbox and trial paths, absolute prefixes up to asl/packages/asl-stats/, the cache prefix up to aslLoopBenchSandbox/, and Python warning noise lines")
(:doc :symbol "asl/bench/loop/core.asl#costOf" :text "price in pico dollars of tokIn and tokOut tokens: tokIn*priceIn plus tokOut*priceOut")
(:doc :symbol "asl/bench/loop/core.asl#countOf" :text "number of non-overlapping occurrences of the needle in the text, 0 for an empty needle")
(:doc :symbol "asl/bench/loop/core.asl#grade!" :text "grades a sandbox: restores the pristine tests, applies the gradeEdits and writes the accept files, runs the pristine suite and the accept files, checks that no absent text remains in the source files, and returns suiteOk, acceptOk, absentOk, solved and a clipped failure detail")
(:doc :symbol "asl/bench/loop/core.asl#halfFor" :text "the py half of the task for lang py, the asl half otherwise")
(:doc :symbol "asl/bench/loop/core.asl#halfOf" :text "builds a Half from blocks: the prompt block body, seed, ref and gradeEdit edits (each paired with a following with block, All variants replace everywhere), accept blocks as file and text, and absent blocks as texts")
(:doc :symbol "asl/bench/loop/core.asl#headerName" :text "the defined name on an item header line, skipping keywords like fn, !, def, class, schema, enum and tailrec and cutting at the first open paren, colon, equals sign or open bracket")
(:doc :symbol "asl/bench/loop/core.asl#headerRow" :text "the (:run ...) header row of a results file: protocol, mode, models, arms, task ids, reps, turn and token limits, prices, cap in USD, the sha256 of the pristine asl and py sources, date and note")
(:doc :symbol "asl/bench/loop/core.asl#itemRegion" :text "the zero-based start and end line of the top-level item with the given name, running to the next item start minus trailing blank lines, none when no item has that name")
(:doc :symbol "asl/bench/loop/core.asl#itemStart?" :text "true for a non-empty line whose first character is not a space, tab or closing bracket")
(:doc :symbol "asl/bench/loop/core.asl#loadOf" :text "the one-minute load average integer part read from uptime output, the third word from the end, 0 when unreadable")
(:doc :symbol "asl/bench/loop/core.asl#loadTask" :text "loads asl/bench/loop/tasks/ID.task (and the optional py/tasks/ID.task half), erring when the file lacks a leading #@ task ID KIND line for that id")
(:doc :symbol "asl/bench/loop/core.asl#loadTasks" :text "loads every .task file of the asl tasks directory of the root in directory order, stopping at the first error")
(:doc :symbol "asl/bench/loop/core.asl#loopTrial!" :text "runs one trial: builds the sandbox with the seeds, runs the tool loop with the caller, grades it and returns the new state and an Outcome with wall time; a sandbox failure yields stop sandbox with a failed verdict")
(:doc :symbol "asl/bench/loop/core.asl#makeSandbox!" :text "creates the trial directory under the work dir (whose name must contain aslLoopBench), copies the pristine sources and tests of the language, writes the asl config and manifest, applies the seed edits, and errs when sources are missing or a seed fails")
(:doc :symbol "asl/bench/loop/core.asl#outlineOf" :text "one line per top-level item header and per indented :x or :i line of a text, as line number, colon and the line clipped to 200 characters")
(:doc :symbol "asl/bench/loop/core.asl#pathOk?" :text "true for a non-empty path that is relative, has no .. and no newline")
(:doc :symbol "asl/bench/loop/core.asl#pristineSha!" :text "sha256 of the pristine source and test files of a language joined with newlines")
(:doc :symbol "asl/bench/loop/core.asl#removeWork!" :text "removes a work directory with rm -rf under a fleet limit, only when its name contains aslLoopBench, returning whether rm exited 0")
(:doc :symbol "asl/bench/loop/core.asl#renameWord" :text "replaces whole-word occurrences of old with new (neighbours must not be identifier characters) and returns the new text with the replacement count")
(:doc :symbol "asl/bench/loop/core.asl#runAll!" :text "runs the trials in order skipping those whose key is already in the existing results, appending a row per trial to cfg.out and printing a trialDone line, and stops with a reason on a write failure or the spend cap; returns the state and RunState")
(:doc :symbol "asl/bench/loop/core.asl#scriptCaller" :text "a canned caller that answers each request with the script listed for arm|task at index turn-1, defaulting to a done call, with fake token counts and model fake")
(:doc :symbol "asl/bench/loop/core.asl#solvedOf" :text "true only when the suite, the accept tests and the absent check all hold")
(:doc :symbol "asl/bench/loop/core.asl#sourceFiles!" :text "lists the sandbox source and tests files of the language (src or stats plus tests, .asl or .py) as paths relative to the package")
(:doc :symbol "asl/bench/loop/core.asl#systemFor" :text "the system prompt of an arm: the tag-call protocol, the reply limit, the arm's tool lines and, for asl arms the cards/asl.txt text and for py arms a Python 3.13 note")
(:doc :symbol "asl/bench/loop/core.asl#tagOf" :text "the text between <tag> and </tag> with one leading and one trailing newline trimmed, none when either tag is missing")
(:doc :symbol "asl/bench/loop/core.asl#toolStep!" :text "executes one tool call for an arm: an unknown or empty tool gives an ERR listing the arm's tools, otherwise dispatches to read, grep, edit, write, test, check, outline, symbol, replace, rename, lens or card and returns its ToolOut")
(:doc :symbol "asl/bench/loop/core.asl#trialKey" :text "the trial key arm|taskId|model|rep")
(:doc :symbol "asl/bench/loop/core.asl#trialRow" :text "the (:trial ...) result row: key, arm, task, kind, model, served, rep, solved, stop, the three ok flags, turns, token lists and sums, files read, bytes read, calls, costPico, wallMs, clipped error and the detail when unsolved")
(:doc :symbol "asl/bench/loop/core.asl#userFor" :text "the first user message: the half's prompt followed by Files: and each source file with its line count")
(:doc :symbol "asl/bench/loop/core.asl#verifyTask!" :text "checks a task half has a red seeded state and a green reference: false with a note when the half has no prompt, the seed already passes, the reference edits fail or the reference is not green")
(:doc :symbol "asl/bench/loop/run.asl#main" :text "entry of the loop bench: verify, pilot or report subcommand, printing the usage and returning 2 for no or an unknown command")
(:doc :symbol "asl/bench/loop/tests/loopRunnerTest.asl#runTests" :text "LOOPBENCH gate: pure parts (task blocks, tag parsing, path check, item regions, header names, rename, outline, load parsing, output cleaning, solved rule, arms) and a canned-model run where the good script solves its task and the wrong-constant script does not, with calls, tokens and row fields asserted")
