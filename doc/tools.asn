(:doc :symbol "asl/tools/coord/store.asl#parseLease" :text "lease from ASN text")
(:doc :symbol "asl/tools/coord/store.asl#live?" :text "lease beat within its ttl at now")
(:doc :symbol "asl/tools/coord/store.asl#fenced?" :text "unit leased and the given epoch is its current one")
(:doc :symbol "asl/tools/coord/store.asl#clashPath" :text "first path clashing write-write, write-read or read-write by prefix; empty when disjoint")
(:doc :symbol "asl/tools/coord/store.asl#ownsClash" :text "refusal detail naming the live lease a unit clashes with")
(:doc :symbol "asl/tools/coord/store.asl#readUnits!" :text "all unit rows, sorted by id")
(:doc :symbol "asl/tools/coord/store.asl#readLeases!" :text "all lease rows, live or not")
(:doc :symbol "asl/tools/coord/store.asl#put!" :text "add a unit or update one not held, keeping state and epoch")
(:doc :symbol "asl/tools/coord/store.asl#claim!" :text "grant one unit by id with epoch+1 or refuse with a reason row")
(:doc :symbol "asl/tools/coord/store.asl#claimNext!" :text "grant the first claimable unit, (:none) when nothing is")
(:doc :symbol "asl/tools/coord/store.asl#heartbeat!" :text "renew a lease; refused on a stale epoch")
(:doc :symbol "asl/tools/coord/store.asl#release!" :text "requeue a held unit; refused on a stale epoch")
(:doc :symbol "asl/tools/coord/store.asl#commit!" :text "mark a held unit done with a receipt; refused on a stale epoch")
(:doc :symbol "asl/tools/coord/store.asl#list!" :text "every unit row and live lease")
(:doc :symbol "asl/tools/coord/store.asl#apply!" :text "run one request under the store lock")
(:doc :symbol "asl/tools/coord/store.asl#main" :text "CLI: put, claim (--hold, --drain), heartbeat, release, commit, list")
