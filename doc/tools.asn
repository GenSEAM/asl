(:doc :symbol "asl/tools/obs/corpus.asl#Found" :text "result of reading one source: name, files read, observations and the new byte marks")
(:doc :symbol "asl/tools/obs/corpus.asl#baseName" :text "last path segment of a path")
(:doc :symbol "asl/tools/obs/corpus.asl#collect!" :text "walks the run-log roots, normalises every source row into observations, appends new ones to day files, saves marks and returns a (:corpusCollect ...) summary")
(:doc :symbol "asl/tools/obs/corpus.asl#collectArchive!" :text "reads one archived month back through the same normalisers into day files and returns a summary row")
(:doc :symbol "asl/tools/obs/corpus.asl#dayKey" :text "day string of an observation, unknown when it has no time")
(:doc :symbol "asl/tools/obs/corpus.asl#discoverRoots" :text "run-log roots among the workspace, main checkout, ~/asex, worktrees under ~/projects/worktrees and ~/wt that have a .asl dir")
(:doc :symbol "asl/tools/obs/corpus.asl#hk" :text "short hash key of a path used for its byte mark")
(:doc :symbol "asl/tools/obs/corpus.asl#isDir?" :text "true when the path stats as a directory")
(:doc :symbol "asl/tools/obs/corpus.asl#listDir" :text "names in a directory, empty when it cannot be read")
(:doc :symbol "asl/tools/obs/corpus.asl#loadTable!" :text "loads the failure class table from asl/tools/obs/failClasses.asn under a root")
(:doc :symbol "asl/tools/obs/corpus.asl#main" :text "corpus CLI: collect (or collect --archive), report --by DIM and classes; other input prints usage and exits 2")
(:doc :symbol "asl/tools/obs/corpus.asl#mkdirs!" :text "creates a directory and its parents")
(:doc :symbol "asl/tools/obs/corpus.asl#mtimeMs" :text "file modification time in milliseconds, 0 when missing")
(:doc :symbol "asl/tools/obs/corpus.asl#pickOldest" :text "one path per base name, the one with the smallest time")
(:doc :symbol "asl/tools/obs/corpus.asl#readText" :text "file text, empty when it cannot be read")
(:doc :symbol "asl/tools/obs/corpus.asl#reportText!" :text "loads day-file observations since a day and the lever table and renders the report for a dimension")
(:doc :symbol "asl/tools/obs/corpus.asl#sizeOf" :text "file size in bytes, 0 when missing")
(:doc :symbol "asl/tools/obs/corpus.asl#writeDay!" :text "appends the observations whose id the day file does not hold yet and returns how many were new")
(:doc :symbol "asl/tools/obs/filter.asl#clip" :text "cuts a text to at most n characters")
(:doc :symbol "asl/tools/obs/filter.asl#firstLine" :text "first line of a text, trimmed")
(:doc :symbol "asl/tools/obs/filter.asl#maxText" :text "longest text an observation may carry, 200")
(:doc :symbol "asl/tools/obs/filter.asl#redact" :text "replaces secret-looking tokens, secret or uppercase NAME=value pairs and .asl/mem paths with fixed markers and shortens the home prefix")
(:doc :symbol "asl/tools/obs/filter.asl#safeText" :text "first line of a text, redacted and clipped to maxText")
(:doc :symbol "asl/tools/obs/obs.asl#Obs" :text "observation row: time, host, source, run, unit, case, model, family, intent, card, temperature, turn, tokens in and out, ms, outcome, failClass, sig, gate, exit code and asserts")
(:doc :symbol "asl/tools/obs/obs.asl#blankObs" :text "an Obs with empty text, zero numbers, failClass none and exit and asserts -1")
(:doc :symbol "asl/tools/obs/obs.asl#dayOf" :text "day YYYY-MM-DD of epoch milliseconds")
(:doc :symbol "asl/tools/obs/obs.asl#dayToMs" :text "epoch milliseconds of the start of a YYYY-MM-DD day")
(:doc :symbol "asl/tools/obs/obs.asl#familyOf" :text "lowercased last path segment of a model name with an effort suffix removed")
(:doc :symbol "asl/tools/obs/obs.asl#obsId" :text "digest id of the identifying fields of an observation, so a row seen twice is stored once")
(:doc :symbol "asl/tools/obs/obs.asl#parseObs" :text "parses an (:obs ...) row back into an Obs")
(:doc :symbol "asl/tools/obs/obs.asl#renderObs" :text "renders an Obs as one (:obs ...) row with its id")
(:doc :symbol "asl/tools/obs/report.asl#parseLevers" :text "parses the lever table rows into failClass and levers")
(:doc :symbol "asl/tools/obs/report.asl#rateText" :text "pass rate as integer permille text 0.xx, 1.000 for all pass and none for no calls")
(:doc :symbol "asl/tools/obs/report.asl#report" :text "renders the (:obsReport ...) matrix for a dimension model, case, card, intent or failClass over observations, or an error row for an unknown dimension")
(:doc :symbol "asl/tools/obs/retain.asl#Item" :text "retention candidate: source, path, kind, month, time range, bytes, mtime and size")
(:doc :symbol "asl/tools/obs/retain.asl#apply!" :text "packs every candidate older than keepDays into month archives, appends index rows, removes originals only after verification and returns a (:retainApply ...) summary")
(:doc :symbol "asl/tools/obs/retain.asl#main" :text "retain CLI: plan or apply with --root, --home, --keepDays, --nowMs and --noCollect; other input prints usage and exits 2")
(:doc :symbol "asl/tools/obs/retain.asl#packItem!" :text "appends the header, data and padding members of one item to its month archive and returns the index Member")
(:doc :symbol "asl/tools/obs/retain.asl#plan!" :text "lists the items older than keepDays with their raw bytes by source as a (:retainPlan ...) row without changing anything")
(:doc :symbol "asl/tools/obs/retain.asl#removeVerified!" :text "removes the original only if it still has its planned size and mtime and its member verifies; returns removed, changed or unverified")
(:doc :symbol "asl/tools/obs/sources.asl#Ctx" :text "normaliser context: class table, host label, file time and run label")
(:doc :symbol "asl/tools/obs/sources.asl#benchRow" :text "observation from a (:benchRun ...) row, none for other lines")
(:doc :symbol "asl/tools/obs/sources.asl#calRows" :text "aggregate observations from the CAL ledger lines that carry a :pass fraction")
(:doc :symbol "asl/tools/obs/sources.asl#condRow" :text "observation from a conductor (:t ...) journal row with a verdict, none otherwise")
(:doc :symbol "asl/tools/obs/sources.asl#finalize" :text "fills model, host, normalised signature, failure class and family of an observation from the filtered blob text")
(:doc :symbol "asl/tools/obs/sources.asl#freshRow" :text "observation from a (:fb ...) fresh bench row, none for other lines")
(:doc :symbol "asl/tools/obs/sources.asl#gatewayRow" :text "observation from a gateway (:call ...) ledger row with outcome ok or infra, none for other lines")
(:doc :symbol "asl/tools/obs/sources.asl#journalObs" :text "one observation for a Leon journal session from its session, result and gate rows, failed when it has no result and is old")
(:doc :symbol "asl/tools/obs/sources.asl#outcomeOf" :text "ok for ok, otherwise infra")
(:doc :symbol "asl/tools/obs/sources.asl#receiptObs" :text "observation from a harness receipt row with status, usage and the first gate")
(:doc :symbol "asl/tools/obs/sources.asl#splitFraction" :text "pair of the leading integers of a pass fraction such as 7/8, -1 where missing")
(:doc :symbol "asl/tools/obs/sx.asl#Scan" :text "scanner state for reading the top-level fields of one single-line ASN row")
(:doc :symbol "asl/tools/obs/sx.asl#bodyFields" :text "top-level fields of a form that opens with a key, read through a dummy head")
(:doc :symbol "asl/tools/obs/sx.asl#field" :text "unquoted value of a field, none when absent")
(:doc :symbol "asl/tools/obs/sx.asl#fieldRaw" :text "raw text of a field value, none when absent")
(:doc :symbol "asl/tools/obs/sx.asl#head" :text "row kind: the first atom after the opening paren, cut to 40 characters")
(:doc :symbol "asl/tools/obs/sx.asl#intField" :text "integer value of a field, 0 when absent or not a number")
(:doc :symbol "asl/tools/obs/sx.asl#listItems" :text "raw items of a list value")
(:doc :symbol "asl/tools/obs/sx.asl#maxScan" :text "longest prefix of a row scanned, 24000 bytes")
(:doc :symbol "asl/tools/obs/sx.asl#quoteText" :text "quotes a text with backslash, quote and newline escaped")
(:doc :symbol "asl/tools/obs/sx.asl#scanRow" :text "scans a row byte by byte into key and raw value pairs tracking strings, escapes and nesting")
(:doc :symbol "asl/tools/obs/sx.asl#topFields" :text "top-level key and raw value pairs of a row")
(:doc :symbol "asl/tools/obs/sx.asl#unq" :text "removes the quotes of a quoted raw value and unescapes it")
(:doc :symbol "asl/tools/obs/tests/attribJoinTest.asl#runTests" :text "pins that a ledger row joins its Leon session by :run, first receipt error classes, gateErr priority, and pickOldest keeping the oldest copy and the first on a tie")
(:doc :symbol "asl/tools/obs/tests/obsTest.asl#runTests" :text "pins the observation corpus: class table and fixtures, redaction, per-source normalisers, render and parse inverse, day conversion and order-independent reports")
(:doc :symbol "asl/tools/obs/tests/retainTest.asl#runTests" :text "pins retention: stable plan, pack and verified removal with index rows, byte-identical readback, ledger tail, archived month collect, corrupt member kept, grown source kept and tar header fields")
(:doc :symbol "asl/tools/obs/tests/sxTest.asl#runTests" :text "pins the row scanner: head, unescaped string fields, int fields, nested forms as one value, and keys inside strings ignored")
(:doc :symbol "asl/tools/coord/stall.asl#Cfg" :text "the parsed (:stall ...) ladder row: on, stalledMin, sameOp, emptyReplies, escalateAfter and everyS")
(:doc :symbol "asl/tools/coord/stall.asl#Probe" :text "one writing unit as the conductor reports it: id, lane, worktree, pid alive, and the millisecond time the run started")
(:doc :symbol "asl/tools/coord/stall.asl#Signal" :text "what one unit shows now: served turns, trailing identical-reply streak, trailing empty-reply streak, last op text, newest-turn and newest-write ages in ms, pid alive")
(:doc :symbol "asl/tools/coord/stall.asl#Act" :text "the response to a non-ok verdict: class, the lane to requeue into (strong once escalateAfter stalls are reached) and the note appended to the requeued unit")
(:doc :symbol "asl/tools/coord/stall.asl#Hooks" :text "the two effects the conductor lends the sweep: kill a unit's process tree by id, and requeue a unit by id, lane and note")
(:doc :symbol "asl/tools/coord/stall.asl#stallsPath" :text "path of the stall rows file, stalls.asn in the store directory")
(:doc :symbol "asl/tools/coord/stall.asl#atPath" :text "path of the file holding the time of the last sweep, stallAt.asn in the store directory")
(:doc :symbol "asl/tools/coord/stall.asl#stRowOf" :text "the first line of the text that starts with (:stall, or the empty string when there is none")
(:doc :symbol "asl/tools/coord/stall.asl#cfgErrors" :text "the problems of a (:stall ...) row: each unknown key and each value outside its range (stalledMin 1..1440, sameOp 3..1000, emptyReplies 1..100, escalateAfter 1..20, everyS 5..3600); empty when the row is valid")
(:doc :symbol "asl/tools/coord/stall.asl#cfgOf" :text "the Cfg of a ladder row: an empty row or one with errors gives the disabled defaults (20, 10, 4, 2, 60), a valid row turns the sweep on and reads each key with the same defaults")
(:doc :symbol "asl/tools/coord/stall.asl#replyRows" :text "the reply text of every (:turn N :reply ...) line of a journal, everything after :reply, in order")
(:doc :symbol "asl/tools/coord/stall.asl#sameTrail" :text "how many trailing replies equal the last one; 0 when there are none or the last one is empty")
(:doc :symbol "asl/tools/coord/stall.asl#emptyTrail" :text "how many trailing replies are empty")
(:doc :symbol "asl/tools/coord/stall.asl#servedCount" :text "the number of (:served :turn lines in a journal")
(:doc :symbol "asl/tools/coord/stall.asl#opText" :text "the last reply cut to 100 bytes with backslashes removed and quotes and parens replaced, so it stays inside one quoted ASN string")
(:doc :symbol "asl/tools/coord/stall.asl#signalFrom" :text "builds a Signal from a journal text, the two ages and the pid state")
(:doc :symbol "asl/tools/coord/stall.asl#verdictOf" :text "dead if the pid is gone, then looping on a same-reply or empty-reply streak at its limit, then stalled when both the newest turn and the newest write are older than stalledMin minutes, else ok")
(:doc :symbol "asl/tools/coord/stall.asl#stallCount" :text "how many stall rows in the text already name the unit id")
(:doc :symbol "asl/tools/coord/stall.asl#actOf" :text "the Act for a verdict: strong lane once the prior stall count plus one reaches escalateAfter, and a note naming the class, the count and the op so the next attempt changes approach")
(:doc :symbol "asl/tools/coord/stall.asl#stallRow" :text "one (:stall :unit :class :op :escalate :at) line for stalls.asn")
(:doc :symbol "asl/tools/coord/stall.asl#statMs" :text "file modification time in milliseconds, 0 when the file cannot be read")
(:doc :symbol "asl/tools/coord/stall.asl#newestWrite!" :text "newest file modification time under a worktree in ms, skipping .git, .asl, node_modules and out, within a budget of 40000 entries")
(:doc :symbol "asl/tools/coord/stall.asl#signalOf!" :text "reads a unit's newest agent-loop journal and, only when its newest turn is already older than stalledMin, the newest write, and returns the Signal")
(:doc :symbol "asl/tools/coord/stall.asl#sweep!" :text "one stall pass: at most once per everyS seconds, each unit with a non-ok verdict gets a stall row appended, its tree killed and the unit requeued with the note; returns the rows written, and nothing when the ladder row is absent or invalid")
(:doc :symbol "asl/tools/coord/sched.asl#Cfg" :text "the (:sched ...) config of the light write pool: min, max, step, start, gainShare, flatWindows, softShare, minFreeMB and windowSec")
(:doc :symbol "asl/tools/coord/sched.asl#Win" :text "the counts of one ledger window: ok calls, all calls, rate-limited calls and the output tokens of the ok ones")
(:doc :symbol "asl/tools/coord/sched.asl#Stats" :text "one sample as nextSlots sees it: goodput and prev in ok calls per minute, the 429 share, free MB and load (-1 when unknown), cores and the flat-window count")
(:doc :symbol "asl/tools/coord/sched.asl#defaultCfg" :text "the adopted defaults: min 4, max 64, step 2, start 16, gainShare 0.05, flatWindows 3, softShare 0.30, minFreeMB 3000, windowSec 600")
(:doc :symbol "asl/tools/coord/sched.asl#parseCfg" :text "reads a (:sched ...) row, each key falling back to its default; called only on a present row, since a missing file means no scheduling")
(:doc :symbol "asl/tools/coord/sched.asl#clampF" :text "x limited to the range lo..hi")
(:doc :symbol "asl/tools/coord/sched.asl#quoted" :text "the text of a quoted field of a ledger line, empty when the key is absent; handles values with spaces such as breaker 589s")
(:doc :symbol "asl/tools/coord/sched.asl#rowAt" :text "the :at millisecond time of a ledger line, -1 when it has none")
(:doc :symbol "asl/tools/coord/sched.asl#winOf" :text "counts the call rows with fromMs <= at < toMs: ok, all, rate-limited (429 or the local throttle) and the output tokens of the ok ones; rows the gateway answered without sending a request are not calls")
(:doc :symbol "asl/tools/coord/sched.asl#okPerMin" :text "ok calls of a window per minute")
(:doc :symbol "asl/tools/coord/sched.asl#rateShare" :text "rate-limited calls over all calls of a window, 0.0 when there are none")
(:doc :symbol "asl/tools/coord/sched.asl#nonOkShare" :text "calls that were not ok over all calls of a window, 0.0 when there are none")
(:doc :symbol "asl/tools/coord/sched.asl#nextSlots" :text "the next pool size, one step per window and at most one down: resource pressure steps down by one, a 429 share above softShare holds when goodput rose and steps down when it is flat, healthy growth adds step only with known free RAM above the floor and load under the cores, otherwise hold; the result stays within min and max")
(:doc :symbol "asl/tools/coord/sched.asl#nextFlat" :text "0 when goodput rose, otherwise the flat-window count plus one")
(:doc :symbol "asl/tools/coord/sched.asl#memFreeMB" :text "MemAvailable of a /proc/meminfo text in MB, -1 when absent (macOS), which blocks growth")
(:doc :symbol "asl/tools/coord/sched.asl#loadOne" :text "the one-minute load average from a /proc/loadavg text, -1.0 when unreadable")
(:doc :symbol "asl/tools/coord/sched.asl#healthRows" :text "per provider and per alias over one window: ok per minute, 429 per minute, non-ok share and call count, plus for a provider its alias count, where it limits (account, model, none or unknown) and whether its newest row is an open breaker")
(:doc :symbol "asl/tools/coord/sched.asl#okShareOf" :text "the health multiplier input of a provider: 0.0 when its row says the breaker is open, else 1 minus its non-ok share kept within 0.2..1.0, and 1.0 when the row is absent")
(:doc :symbol "asl/tools/coord/sched.asl#slotsRead!" :text "the persisted pool state as (n (flat at)) from slots.asn; n is -1 when the store has none yet")
(:doc :symbol "asl/tools/coord/sched.asl#slotsDue?" :text "true when no state exists or the last sample is at least periodMs old")
(:doc :symbol "asl/tools/coord/sched.asl#schedTick!" :text "one sample: the ledger lines of the last two windows give goodput and the 429 share, nextSlots moves the persisted value, a change is journalled, and providerHealth.asn is rewritten at most once per window; returns the new slot count")
(:doc :symbol "asl/tools/coord/gateGuard.asl#maxImporters" :text "the cap of 40 importer paths returned by importers")
(:doc :symbol "asl/tools/coord/gateGuard.asl#moduleName" :text "the module name of a source text: the token after the first (module , empty when the text has none")
(:doc :symbol "asl/tools/coord/gateGuard.asl#importsModule?" :text "true when the text lists mod as a whole name in an import position (after a paren, bracket or space, before a space, closer or newline); a module header alone never counts")
(:doc :symbol "asl/tools/coord/gateGuard.asl#importers" :text "paths of files whose text imports any owned module, owned files themselves left out, in input order, at most maxImporters")
(:doc :symbol "asl/tools/coord/gateGuard.asl#shrunk?" :text "true when more than half of the base lines are gone")
(:doc :symbol "asl/tools/coord/gateGuard.asl#shrinkSig" :text "the refusal text for one owned file that lost more than half its base lines, empty when it kept enough or the task text says rewrite")
(:doc :symbol "asl/tools/coord/conductorService.asl#ServiceConfig" :text "the optional ExecStart values of a node: lanes, profile, keys, ledger and ledgerBase, empty meaning absent")
(:doc :symbol "asl/tools/coord/conductorService.asl#noConfig" :text "a ServiceConfig with every value absent")
(:doc :symbol "asl/tools/coord/conductorService.asl#configOf" :text "the ServiceConfig of an install: an install flag wins over the matching key of the conductorService row in the service file")
(:doc :symbol "asl/tools/coord/tests/condRestartTest.asl#runTests" :text "pins the conductor restart drain: with a restart file a writing unit finishes and is applied but its gates are not launched, no next unit is admitted, the restart row records what finished, the file is removed when the loop ends, and the next start resumes the gates and admits the held unit; the restart command writes the file with a deadline")
(:doc :symbol "asl/tools/coord/tests/gateGuardTest.asl#runTests" :text "pins the gate-stage guards: module name from a header, importer finding (whole names only, owned files left out, capped), a header alone not an import, and the more-than-half deletion refusal at its boundary")
(:doc :symbol "asl/tools/coord/tests/redBaseTest.asl#runTests" :text "pins the red-at-base memo: a genuine red is remembered per base sha and gate, reused without running, rerun for another sha or gate, never remembered for a timeout or a green base, rerun on a damaged memo, and the gate text is quoted in the row")
(:doc :symbol "asl/tools/coord/tests/schedTest.asl#runTests" :text "pins the pool sizing: growth by step on rising goodput, hold when flat, the 429 share rules, RAM and load pressure, unknown RAM blocking growth, clamping to min and max including a persisted count outside a changed range, and the flat counter")
(:doc :symbol "asl/tools/coord/tests/stallTest.asl#runTests" :text "pins the stall decision: config defaults and rejection of bad ranges or keys, the ok, looping (same-reply and empty-reply streaks) and stalled verdicts with their limits, and a recent write keeping a quiet unit ok")
(:doc :symbol "asl/tools/coord/conductor.asl#admitWriter?" :text "the writer admission decision: a free jobserver token and enough free memory; an unreadable meminfo (-1) does not block")
(:doc :symbol "asl/tools/coord/conductor.asl#armExtra" :text "the extra write-stage argument of an A/B arm: :attractor asn for the asn arm, empty otherwise")
(:doc :symbol "asl/tools/coord/conductor.asl#armOf" :text "the A/B arm of a unit: asn or off by the parity of the sum of the unit id's character codes; used only under --attractor-ab on")
(:doc :symbol "asl/tools/coord/conductor.asl#baseNote!" :text "how far a unit's tree is behind its base for the receipt: (:base :sha S :behind N)")
(:doc :symbol "asl/tools/coord/conductor.asl#commitWrite!" :text "the driver commit of a write: stages only the owned paths that changed; true when a commit landed")
(:doc :symbol "asl/tools/coord/conductor.asl#depStalled?" :text "true when a waiting unit has a dependency that is missing, blocked or failed; a dependency still queued, ready or in a stage is progress, not a stall")
(:doc :symbol "asl/tools/coord/conductor.asl#depWake!" :text "returns to queued each unit blocked only by deps not merged once none of its :after units is blocked, failed or missing; returns how many woke")
(:doc :symbol "asl/tools/coord/conductor.asl#draining?" :text "true while the restart file exists, meaning the loop is draining")
(:doc :symbol "asl/tools/coord/conductor.asl#firstCallSeen?" :text "true when the unit's agent-loop journal already shows a served model turn")
(:doc :symbol "asl/tools/coord/conductor.asl#flyingIds!" :text "the ids of the units in a stage right now")
(:doc :symbol "asl/tools/coord/conductor.asl#hopsSince" :text "the number of tierHop rows into the given rung whose :at is not before since")
(:doc :symbol "asl/tools/coord/conductor.asl#hubGuard!" :text "refuses the write stage with ERR_HUB_CLIENT_MISSING when the node has a hub socket but the worktree's providers predate the hub client; none otherwise")
(:doc :symbol "asl/tools/coord/conductor.asl#leadBacklogCap" :text "at most 20 lead rows offered per tick")
(:doc :symbol "asl/tools/coord/conductor.asl#leadFresh?" :text "true when the leadOnline row's :at is within leadTtlMs of now")
(:doc :symbol "asl/tools/coord/conductor.asl#leadTtlMs" :text "how long a leadOnline heartbeat counts as a lead being online: 120000 ms (adopted)")
(:doc :symbol "asl/tools/coord/conductor.asl#leonGuard!" :text "a unit worktree must hold the deployed Leon: none when the last commit touching asl/packages/asl-agent is an ancestor of HEAD or a clean worktree rebases onto the deployed main; a stale result when the tree is dirty or the rebase conflicts (aborted)")
(:doc :symbol "asl/tools/coord/conductor.asl#lightSlotsAt!" :text "the light pool size from the store: the jobserver token count without a sched.asn, otherwise slots.asn sampled at most once a minute from the gateway ledger and the given free RAM, load and cores")
(:doc :symbol "asl/tools/coord/conductor.asl#mergeBusy?" :text "true when another unit is merging with a live merge child, since merge stages run one at a time")
(:doc :symbol "asl/tools/coord/conductor.asl#nextRung!" :text "the rung above the lane whose daily cap has room, a capped rung skipped; none when there is none")
(:doc :symbol "asl/tools/coord/conductor.asl#noCommits?" :text "true when the write left no commit past its base; an unreadable count or no worktree counts as none")
(:doc :symbol "asl/tools/coord/conductor.asl#vacuousAround!" :text "the write stage vacuous verdict: reads the tree for a blank slate just before the writer thunk runs and returns (result, vacuous), vacuous only when blank and the gate is listed in :vacuousGates; writeRes calls it, so a retained wip-only branch with a green gate reaches gating")
(:doc :symbol "asl/tools/coord/conductor.asl#blankSlate?" :text "true when the branch holds no commit at all past its base (wip rescue commits included) and no owned change; the vacuous-gate verdict applies only then, so a retained branch with rescued work whose gate is green is real work")
(:doc :symbol "asl/tools/coord/conductor.asl#aheadGreen!" :text "the write stage on a branch already ahead of its base with no uncommitted owned change: when the unit gate is green there it returns the written result without a writer run (green on the merge-base too: the vacuousGate result), journaled as (:ahead ...); none sends the claim to a writer as before")
(:doc :symbol "asl/tools/coord/conductor.asl#onBaseRun!" :text "runs the writer thunk with HEAD soft-reset to the merge-base of HEAD and base, so Leon gate integrity reverts against the unit base and earlier unit commits count; HEAD returns to the branch tip when the writer made no commit; a branch at its base runs the thunk unchanged")
(:doc :symbol "asl/tools/coord/conductor.asl#noEdits?" :text "true when the write has no commit past its base and no changed owned file")
(:doc :symbol "asl/tools/coord/conductor.asl#offerBacklog!" :text "while the lead heartbeat is fresh, writes one lead row for each unit blocked on a plain escalate, oldest first, at most leadBacklogCap per tick; returns the rows written")
(:doc :symbol "asl/tools/coord/conductor.asl#ownedChanges!" :text "the changed paths inside the unit's :owns, untracked ones included; debris outside :owns is not an edit")
(:doc :symbol "asl/tools/coord/conductor.asl#cdErrors" :text "the problems of a (:conductor ...) row: unknown keys and :staleWakeMax outside 1..100")
(:doc :symbol "asl/tools/coord/conductor.asl#pfBackoffS" :text "the :backoffS of a providerFail row, default 60")
(:doc :symbol "asl/tools/coord/conductor.asl#pfCfg" :text "the store's providerFail row when it has no errors, otherwise empty")
(:doc :symbol "asl/tools/coord/conductor.asl#pfDefaultPatterns" :text "the default provider-failure words: err_vendor, err_no_upstream, bad gateway, service unavailable, overloaded, 502, 503, 504, 429, breaker")
(:doc :symbol "asl/tools/coord/conductor.asl#pfErrors" :text "the problems of a providerFail row: unknown keys, :backoffS outside 1..3600, :maxInRow outside 1..100, an empty :patterns list")
(:doc :symbol "asl/tools/coord/conductor.asl#pfMaxInRow" :text "the :maxInRow of a providerFail row, default 6")
(:doc :symbol "asl/tools/coord/conductor.asl#pfPatterns" :text "the :patterns list of a providerFail row, the defaults when the row has none")
(:doc :symbol "asl/tools/coord/conductor.asl#pfRowOf" :text "the (:providerFail ...) line of the store's ladder.asn, empty when absent")
(:doc :symbol "asl/tools/coord/conductor.asl#pickWriteProfile" :text "picks the write profile from a writeProfiles row by a stable hash of the unit id over the weight sum, so a unit keeps its profile across attempts; the base profile when the row is malformed or absent")
(:doc :symbol "asl/tools/coord/conductor.asl#pickWriteProfileH" :text "as pickWriteProfile with a providerHealth text: each weight is scaled by the ok share of its lead provider (0.2..1.0)")
(:doc :symbol "asl/tools/coord/conductor.asl#priorNote!" :text "the note for the fixer on the next rung: the newest failure as :last and the earlier rungs' failures as :history, oldest first")
(:doc :symbol "asl/tools/coord/conductor.asl#promoteDev!" :text "before each train brings main into dev: fast-forward when dev has nothing of its own, else a merge commit; a conflict refuses the train; returns same when dev and repo are the one repo")
(:doc :symbol "asl/tools/coord/conductor.asl#providerFailSig?" :text "true when a failure signature contains any provider-failure pattern, compared case-insensitively")
(:doc :symbol "asl/tools/coord/conductor.asl#providerHit?" :text "true when a failed write is a provider-class failure: signature matches, no commit past base, not stale or vacuous, within maxInRow")
(:doc :symbol "asl/tools/coord/conductor.asl#providerWaiting?" :text "true while a unit's provider backoff has not yet passed")
(:doc :symbol "asl/tools/coord/conductor.asl#pwLast" :text "the newest provider-wait row of a unit as (n until), (0 0) when none")
(:doc :symbol "asl/tools/coord/conductor.asl#redBaseHit" :text "the remembered (exit executed) of a redBase row when its sha and gate match the given ones, none otherwise")
(:doc :symbol "asl/tools/coord/conductor.asl#redBaseRow" :text "one (:redBase :sha :exit :executed :gate) line remembering a red result at a base")
(:doc :symbol "asl/tools/coord/conductor.asl#redCached!" :text "the red-at-base result of a gate: the remembered one for the same sha and gate, else runs the gate and remembers a genuine red")
(:doc :symbol "asl/tools/coord/conductor.asl#repoPath" :text "path of the file naming the conductor's deployed repo, repo.path in the store")
(:doc :symbol "asl/tools/coord/conductor.asl#servedField" :text "the value after a key in a Leon receipt text, quotes and a closing paren dropped, empty when the key is absent")
(:doc :symbol "asl/tools/coord/conductor.asl#servedAliasOf" :text "the :servedAlias of a Leon receipt, empty when absent")
(:doc :symbol "asl/tools/coord/conductor.asl#servedModel" :text "the model a write is journalled under: :servedAlias, else :servedModel, else the older :model tag, unknown when none")
(:doc :symbol "asl/tools/coord/conductor.asl#journalA!" :text "append one transition row to the journal, with :alias A after :model when an alias is known")
(:doc :symbol "asl/tools/coord/conductor.asl#fail!" :text "apply a stage failure to a unit: a write failure wip-rescues the tree, then the lease is released and the unit retries, hops a rung or blocks by its failure count")
(:doc :symbol "asl/tools/coord/conductor.asl#finish!" :text "apply one finished stage result to its unit; a stale-needs-rebase or vacuous-gate write result wip-rescues the tree before the lease is released")
(:doc :symbol "asl/tools/coord/conductor.asl#step!" :text "advance one unit by at most one transition; a writing unit whose lease heartbeat is refused is wip-rescued, killed and returned to ready; returns the capacity left")
(:doc :symbol "asl/tools/coord/conductor.asl#providerRequeue!" :text "requeue a unit after a provider-class write failure with a backoff and no fail count; the tree is wip-rescued first")
(:doc :symbol "asl/tools/coord/conductor.asl#worktreesPath" :text "the file in the store naming the worktree base, written by run from --worktrees")
(:doc :symbol "asl/tools/coord/conductor.asl#wtBase" :text "the conductor worktree base: the store worktrees.path, else repo/../worktrees")
(:doc :symbol "asl/tools/coord/conductor.asl#seedGradeCommits!" :text "one-time migration at conductor start: creates <store>/gradeCommits.asn from the grade commits already on the sh/* unit branches (committer conductor@localhost, grade subject) when the file does not exist, headed by a (:gradeSeed :n N) row; never lazy, never repeats; returns the count, -1 when skipped")
(:doc :symbol "asl/tools/coord/conductor.asl#gradeCommitsPath" :text "the store file recording the grade commits the conductor made, gradeCommits.asn")
(:doc :symbol "asl/tools/coord/conductor.asl#gradeCommitRecorded?" :text "true when the store file records a grade commit with that sha")
(:doc :symbol "asl/tools/coord/conductor.asl#ledgerForged!" :text "true only when the log shows a commit past the base touching .asl/mem/grades.asn whose sha the conductor did not record; a git failure is not forgery but a repo error (ledgerState!)")
(:doc :symbol "asl/tools/coord/conductor.asl#ledgerState!" :text "dir path base: empty when the ledger log is clean, \"forged\" for an unrecorded grade-ledger commit, ERR_REPO_GIT: git log in PATH exit N: TEXT when the log cannot be read")
(:doc :symbol "asl/tools/coord/conductor.asl#ledgerSig!" :text "the failure signature of the ledger guard: LEDGER_FORGED for a forged ledger, ERR_REPO_GIT for a repo that cannot answer, empty when clean")
(:doc :symbol "asl/tools/coord/conductor.asl#repoBrokenPath" :text "dir: the store marker <dir>/repoBroken.asn present exactly while the conductor holds admissions for a broken repo; nodeWatch reads it")
(:doc :symbol "asl/tools/coord/conductor.asl#repoErr!" :text "repo: empty when git rev-parse --git-common-dir succeeds and the directory is its own worktree top level, else the reason; an enclosing repo answering for a directory whose .git is gone counts as broken")
(:doc :symbol "asl/tools/coord/conductor.asl#repoGate!" :text "ctx: every tick asks it first; false stops admissions while repoErr! is non-empty, writing one (:repoBroken :repo :err :at) to the marker, escalations and journal per episode, and journaling (:repoHealthy) and clearing the marker on recovery; true when the store has no repo.path")
(:doc :symbol "asl/tools/coord/conductor.asl#settleWt!" :text "rc dir u path: a missing path is added, a valid worktree is reused, a directory that exists without its own .git is moved to <wtBase>/orphan-ID-MS (journal row (:orphan :unit :moved)), the registrations pruned and the worktree added again")
(:doc :symbol "asl/tools/coord/conductor.asl#worktreeValid?" :text "path: true when git rev-parse --show-toplevel at path answers path itself, so an enclosing repo does not make a stray directory a worktree")
(:doc :symbol "asl/tools/coord/conductor.asl#ledgerGuard" :text "turn a write result that landed ledger-touching commits, or a review pass over such a branch, into a LEDGER_FORGED failure so it is neither gated, reviewed nor merged")
(:doc :symbol "asl/tools/coord/conductor.asl#receiptRowOf" :text "the last output line starting with (: and carrying :usage, Leon final receipt row")
(:doc :symbol "asl/tools/coord/conductor.asl#wipSave!" :text "wip-commit a stopped, lease-lost or failed writer's worktree through worktree wipCommit! and journal one (:wip :unit :reason :branch :sha) row; a failed commit journals wipFailed and keeps the edits")
(:doc :symbol "asl/tools/coord/conductor.asl#gradeLand!" :text "on a review pass append one (:grade :ev UNIT :sha REVIEWED-HEAD :verdict pass :by FAMILY :at ISO) row to .asl/mem/grades.asn in the unit worktree and commit only that file on the unit branch, so a merge or cherry-pick carries the verdict; a path that is not a worktree of the repo or a failed commit journals gradeSkipped and never blocks the merge")
(:doc :symbol "asl/tools/coord/conductor.asl#staleOwnsFor!" :text "the stale-owns warning lines for conductor check: the ledger from --ledger or the store ledger.path against the repo tree; warns only, exit code unchanged")
(:doc :symbol "asl/tools/coord/conductor.asl#requestRequeue!" :text "appends a requeue row for each id to the store's requeue file; true when written")
(:doc :symbol "asl/tools/coord/conductor.asl#requestRestart!" :text "writes the restart file with its time and a deadline graceSec seconds ahead; true when written")
(:doc :symbol "asl/tools/coord/conductor.asl#requeueDrain!" :text "claims the requeue file by rename and puts each named blocked or failed unit back to queued with a clean count, lane, wait and escalation flag; returns how many")
(:doc :symbol "asl/tools/coord/conductor.asl#requeuePath" :text "path of the requeue request file in the store")
(:doc :symbol "asl/tools/coord/conductor.asl#restart!" :text "the drain: waits for in-flight stages until they finish or the deadline passes, journals one restart row with what finished and what was left, and returns the ids that finished")
(:doc :symbol "asl/tools/coord/conductor.asl#restartPath" :text "path of the restart request file in the store")
(:doc :symbol "asl/tools/coord/conductor.asl#restartUntil!" :text "the drain deadline in ms from the restart file, 20 minutes from now when the file has none")
(:doc :symbol "asl/tools/coord/conductor.asl#reuseWt!" :text "brings a reused unit worktree with no tracked change onto its base; a dirty one is used as it stands")
(:doc :symbol "asl/tools/coord/conductor.asl#rungCap" :text "the per-UTC-day cap of a rung from the ladder rows, -1 when there is none")
(:doc :symbol "asl/tools/coord/conductor.asl#schedPace" :text "the pace of the light pool: its token count from lightSlots with no allowance limit")
(:doc :symbol "asl/tools/coord/conductor.asl#staleField" :text "the word after a key in a stale signature, empty when absent")
(:doc :symbol "asl/tools/coord/conductor.asl#staleSig?" :text "true when a signature starts with STALE_NEEDS_REBASE")
(:doc :symbol "asl/tools/coord/conductor.asl#unitHead!" :text "short sha of the unit branch sh/ID in the store repo, empty when absent; the stale signature records it before the wip rescue so the rescue commit wakes the unit")
(:doc :symbol "asl/tools/coord/conductor.asl#staleWake!" :text "wakes a unit blocked awaiting a rebase once the deployed main moved past the head in its stale signature: back to ready for one retry with sig STALE_WOKEN")
(:doc :symbol "asl/tools/coord/conductor.asl#stallHooks" :text "the hooks the stall sweep uses: kill the unit's write run through its run record, and requeue it")
(:doc :symbol "asl/tools/coord/conductor.asl#stallProbes" :text "one probe for each unit that is writing with a launched child and no Res row yet, with pid liveness and run start time")
(:doc :symbol "asl/tools/coord/conductor.asl#stallRequeue!" :text "requeues a stalled unit to ready with the stall note as its newest prior failure, using the strong lane only while that rung has room")
(:doc :symbol "asl/tools/coord/conductor.asl#trainSig" :text "the failure signature of a train from its output lines: a fleetRun verdict, a failed train status, a commit error, fresh red tests or an assert loss, else the generic one")
(:doc :symbol "asl/tools/coord/conductor.asl#vacuousSig" :text "the failure signature for a gate that executed nothing, vacuousGate: followed by the gate")
(:doc :symbol "asl/tools/coord/conductor.asl#vacuousSig?" :text "true when a signature starts with vacuousGate:")
(:doc :symbol "asl/tools/coord/conductor.asl#vacuousWrite?" :text "true when the write output lists the unit's gate among its vacuous gates and the task is not a regression guard")
(:doc :symbol "asl/tools/coord/conductor.asl#warmPath" :text "path of the warm writer row, warm.asn in the store")
(:doc :symbol "asl/tools/coord/conductor.asl#warmWait!" :text "true while this conductor's warm writer is still before its first model turn; the first unit asked after a start becomes the warm writer")
(:doc :symbol "asl/tools/coord/conductor.asl#wrCfg" :text "the store's writers row when it has no errors, otherwise empty")
(:doc :symbol "asl/tools/coord/conductor.asl#wrErrors" :text "the problems of a writers row: unknown keys among :minFreeMb :warmFirst :jobserver :meminfo and out-of-range values")
(:doc :symbol "asl/tools/coord/conductor.asl#wrMinFreeMb" :text "the :minFreeMb of a writers row, default 2000 (adopted)")
(:doc :symbol "asl/tools/coord/conductor.asl#wrRowOf" :text "the (:writers ...) line of the store's ladder.asn, empty when absent")
(:doc :symbol "asl/tools/coord/conductor.asl#writeArm" :text "the A/B arm of the unit's write stage, empty unless attractor A/B is on")
(:doc :symbol "asl/tools/coord/conductor.asl#writerHeld?" :text "true when writer admission holds the unit back: no free token, too little memory, or the warm writer still before its first turn")
(:doc :symbol "asl/tools/fleet/mutate.asl#Mutant" :text "one source edit to try: the file, the exact old text and the new text")
(:doc :symbol "asl/tools/fleet/mutate.asl#MutantOut" :text "the result of a mutant run: whether it applied, the gate's exit code and its executed-assert count")
(:doc :symbol "asl/tools/fleet/mutate.asl#defaultScratch" :text "the directory for mutant copies: aslMutants under TMPDIR or /tmp")
(:doc :symbol "asl/tools/fleet/mutate.asl#mutant" :text "builds a Mutant from a file, old text and new text")
(:doc :symbol "asl/tools/fleet/mutate.asl#mutantDirs!" :text "the names of the copies under the scratch directory that carry an owner pid")
(:doc :symbol "asl/tools/fleet/mutate.asl#mutantRun!" :text "runs one mutant in a throwaway copy of the writer's worktree at its HEAD with its uncommitted and untracked files: applies the edit, runs the gate there under the limits, removes the copy; applied is false when the old text is not found exactly once; the writer's own tree is never touched")
(:doc :symbol "asl/tools/fleet/mutate.asl#mutantRunIn!" :text "mutantRun! with the native CLI cache named: when every changed file (the mutant's and the writer's uncommitted ones) lies outside the deps of the CLI the writer's worktree is pinned to, the copy gets a head pointer to that same build dir and builds nothing; otherwise it builds its own; the answer's cli is pinned or cold, verdict is pass, red, invalid or notApplied, and red is true only for verdict red")
(:doc :symbol "asl/tools/fleet/mutate.asl#verdictOf" :text "exit 0 is pass; a nonzero exit is red only when a runner FAIL line shows a failed assertion (ERR_ASSERT) or a suite that ran assertions; ERR_ASSERT quoted elsewhere, a mutant that does not load, a gate killed by its limits, or a later suite dying after an earlier suite's assertions is invalid and never red")
(:doc :symbol "asl/tools/fleet/mutate.asl#sweepIn!" :text "removes the copies of killed runs; their head markers' files are removed only under the named cache dir, any other path is journaled in headSkips.log and left")
(:doc :symbol "asl/tools/fleet/mutate.asl#cacheDir!" :text "the native CLI cache directory: ASL_NATIVE_CLI_CACHE or HOME/.asl/run/nativeCli")
(:doc :symbol "asl/tools/fleet/mutate.asl#headFile" :text "the head pointer file of a root in a CLI cache: head followed by the root path with every slash turned into an underscore")
(:doc :symbol "asl/tools/fleet/mutate.asl#pinOf!" :text "the native CLI build dir the writer's worktree points to in the cache, or empty when the pointer or the build dir's bin is missing")
(:doc :symbol "asl/tools/fleet/mutate.asl#depsOf!" :text "the dependency paths a native CLI build dir lists in its deps file; empty when none")
(:doc :symbol "asl/tools/fleet/mutate.asl#depHit?" :text "whether a changed file is one of the deps or lies under a listed directory")
(:doc :symbol "asl/tools/fleet/mutate.asl#seedable" :text "true when a pin and a deps list exist and no changed file is a dep, so a copy may reuse the pinned CLI")
(:doc :symbol "asl/tools/fleet/mutate.asl#sweep!" :text "removes the copies whose owner pid is gone, left by a killed run, and prunes their worktree registration; a live run's copy is kept; returns how many were removed")
(:doc :symbol "asl/tools/fleet/run.asl#judge" :text "one limit check of a pooled run: past the timeout or the descendant limit it kills the whole tree, then reads the pipes on (drainFd) before it adds the verdict note, so output written just before the kill stays in the text")
(:doc :symbol "asl/tools/fleet/run.asl#judgeSep" :text "judge for a guarded run with separate stdout and stderr: the kill is followed by a bounded drain of both pipes into outText and errText, then the verdict note")
(:doc :symbol "asl/tools/fleet/run.asl#fleetGroupAt" :text "where the :fleet group starts in a config text: :fleet followed by a space and a paren, or a paren; a key that begins with fleet is not it")
(:doc :symbol "asl/tools/fleet/run.asl#fleetInt" :text "an integer of the :fleet group of a .asl.config.asn text; the default when the group or key is absent or the value is outside lo..hi")
(:doc :symbol "asl/tools/fleet/run.asl#drainConfig!" :text "the drain bounds: :fleet :drainBytes (default 1048576, 0 off) and :fleet :drainMs (default 300) from the .asl.config.asn under ASL_ROOT or the working directory")
(:doc :symbol "asl/tools/fleet/run.asl#Drain" :text "the drain bounds, bytes per pipe and milliseconds")
(:doc :symbol "asl/tools/fleet/run.asl#drainFd" :text "reads an already killed child's pipe on, up to a byte cap and a deadline: true with what was read when the pipe is still open, false at its end; polls 10 ms when nothing is readable")
(:doc :symbol "asl/tools/fleet/tests/runDrainTest.asl#runTests" :text "pins the kill drain: a child that printed 200 lines to stdout and to stderr and was then killed by the judge at once (pooled and guarded) keeps all of them in its text, a zero byte cap turns the drain off, the :fleet values parse with defaults for absent, bad or out-of-range ones, and no child outlives the test")
(:doc :symbol "asl/tools/fleet/run.asl#reapLeasesAt!" :text "reapLeasesIn! with the time the process snapshot was taken: a lease written after that time belongs to an owner forked after the snapshot and is kept; an older lease whose owner is missing from the snapshot, or any lease past its deadline, has its group killed and its row removed; a snapshot without the reaper reaps nothing")
(:doc :symbol "asl/tools/fleet/run.asl#writeLeaseAt!" :text "writes a lease row with an explicit written-at wall time and the recorded start times (seconds) of the group leader and the owner, 0 when unknown; writeLease! uses now and the start times of the current process snapshot")
(:doc :symbol "asl/tools/fleet/run.asl#bornIn" :text "the start time (wall seconds) of a pid in a process snapshot, 0 when the pid is not in it")
(:doc :symbol "asl/tools/fleet/run.asl#sameStart?" :text "whether a recorded start time and a live one are the same process: both known and within 2 seconds, the resolution of ps etime")
(:doc :symbol "asl/tools/fleet/tests/leaseRaceTest.asl#runTests" :text "pins the reaper race: a lease written after the snapshot time keeps its live group and row, an older lease of a gone owner with the recorded start time is reaped with its group, a live leader pid with another or no recorded start time is dropped without a kill, a live owner pid with another start time is a gone owner, and every sleeper is killed and reaped")
(:doc :symbol "asl/tools/fleet/run.asl#guardLoop" :text "runs a guarded child to its end in a blocking loop of guardAdvance! steps, polling its fds when a step made no progress; returns its ProcOut")
(:doc :symbol "asl/tools/fleet/tests/mutateTest.asl#runTests" :text "pins mutantRun!: a mutant goes red in the copy while the writer's tree stays byte-for-byte unchanged, an absent mutant text is not run, every copy and registration is removed, and a run killed mid-gate leaves a stale copy that the next start sweeps; a nonzero exit without an assertion is invalid, not red; a stub builder is called 0 times for a mutant outside the pinned CLI deps and the copy pointer is removed with the copy, and the sweep removes a killed run pointer")
(:doc :symbol "asl/tools/hub/learn.asl#learnTick!" :text "one learning pass: parses the gateway config, replays the tail of the usage ledger over the window through the rate learner, writes the rate store and the by-model-name file; returns how many aliases were learned, or an ERR_HUB_LEARN_CONFIG or ERR_HUB_LEARN_STORE error")
(:doc :symbol "asl/tools/hub/learn.asl#main" :text "the learner process: with --once one tick, otherwise a loop every --every-sec that ends when the --parent pid is gone; flags --gateway, --ledger, --store, --window-sec, --now")
(:doc :symbol "asl/tools/hub/learn.asl#specsOf" :text "the rate-learner specs of a gateway table: each alias's configured rpm as the start and its provider's shared total")
(:doc :symbol "asl/tools/hub/learn.asl#tailLines" :text "the lines of the last maxBytes bytes of a file, read in-process; drops a cut first line only when the read cut it, and returns nothing for a missing file or a path containing a single quote")
(:doc :symbol "asl/tools/hub/learn.asl#totalsOf" :text "the provider rpmTotal of each shared provider in a gateway table, by provider name")
(:doc :symbol "asl/tools/hub/main.asl#HubCfg" :text "the hub daemon config from hub.asn: socket path, lock path, upstream, and the learner interval and window in seconds")
(:doc :symbol "asl/tools/hub/main.asl#hubAsnInt" :text "the number after :key in an ASN text, the fallback when the key is absent")
(:doc :symbol "asl/tools/hub/main.asl#hubAsnString" :text "the quoted string after :key in an ASN text, the fallback when the key is absent")
(:doc :symbol "asl/tools/hub/main.asl#hubCfg!" :text "reads HOME/.asl/hub.asn into a HubCfg, ERR_HUB_NO_HOME when HOME is unset")
(:doc :symbol "asl/tools/hub/main.asl#hubCfgFrom" :text "builds a HubCfg from a hub.asn text, with defaults for the socket under HOME/.asl/run/hub and the lock next to it")
(:doc :symbol "asl/tools/hub/main.asl#hubLock!" :text "takes the hub's lock file and keeps the fd for the life of the process, so a crash leaves no stale lock; an error when another hub holds it")
(:doc :symbol "asl/tools/hub/main.asl#hubMkdirs!" :text "creates a directory and its missing parents; true when it exists afterwards")
(:doc :symbol "asl/tools/hub/main.asl#hubServe!" :text "serves the hub: takes the lock, starts the learner if configured, then runs the gateway server on the unix socket with the configured upstream")
(:doc :symbol "asl/tools/hub/main.asl#hubStatus!" :text "prints (:hub :status :running ...) with exit 0 when the socket accepts a connection, :stopped with exit 1 otherwise")
(:doc :symbol "asl/tools/hub/main.asl#main" :text "hub daemon entry: serve or status, any other mode prints :unsupported and exits 2")
(:doc :symbol "asl/tools/hub/main.asl#startLearner!" :text "with :learnEverySec in hub.asn starts learn.asl as a bounded child that ends when this hub is gone, logging to HOME/.asl/run/hub/learn.log; false when no learner is configured")
(:doc :symbol "asl/tools/hub/measure.asl#fetchStatus!" :text "GET /hub/status over the hub's unix socket; the body is the (:hub ...) form, the HTTP head dropped")
(:doc :symbol "asl/tools/hub/measure.asl#main" :text "prints the (:hubMeasure ...) summary of the usage ledger over --window-min minutes (default 120) ending at --now or the present")
(:doc :symbol "asl/tools/hub/measure.asl#measureText" :text "the (:hubMeasure ...) form for a ledger text and window: calls, ok, real 429, own throttles, calls per minute and the two shares; admitWait is absent because the ledger has none")
(:doc :symbol "asl/tools/hub/measure.asl#rowAt" :text "the :at time of a (:call :at ...) ledger line, -1 for any other line")
(:doc :symbol "asl/tools/hub/measure.asl#rowOutcome" :text "the quoted :outcome of a ledger line, empty when absent")
(:doc :symbol "asl/tools/hub/measure.asl#tally" :text "counts the call rows with fromMs <= at <= toMs by outcome: all, ok, real 429 and own throttle")
(:doc :symbol "asl/tools/hub/preflight.asl#hubPreflight" :text "checks a worktree before a write when the node has a hub: ok noHub without a :sock in hub.asn, ok hubClient when the worktree's providers.asl carries hubAsnPath, else ERR_HUB_CLIENT_MISSING")
(:doc :symbol "asl/tools/hub/tests/hubDaemonTest.asl#runTests" :text "pins the hub daemon on a scratch HOME: socket mode 0600, a second instance exits ERR_HUB_RUNNING, a chat over the socket reaches the upstream once, and a restart takes over the dead hub's lock and stale socket")
(:doc :symbol "asl/tools/hub/tests/hubLearnedTest.asl#runTests" :text "pins learned rates in the hub: a ratesByName entry replaces the configured rpm of the bucket, no store keeps it, and hubLearnedFrom never lifts a bucket paced below its config but takes a lower learned rate")
(:doc :symbol "asl/tools/hub/tests/hubStatusTest.asl#runTests" :text "pins GET /hub/status: an idle hub reports no streams and zero admit samples, a parked client shows as streams, waiting and queued with the bucket row, and after both are answered two admit samples with the wait in p95")
(:doc :symbol "asl/tools/hub/tests/learnLiveTest.asl#runTests" :text "pins the learner process on scratch files: a throttled-only window raises the alias rpm by 20 percent of its start, the by-name file carries the rate and the configured rpm, real 429s cut it by 0.7, and tailLines and the in-process ledger read behave")
(:doc :symbol "asl/tools/hub/tests/measureTest.asl#runTests" :text "pins the measure summary over a synthetic ledger with a fixed now: the counts, per-minute rate and shares for ok, throttled, real 429 and 5xx rows inside the window, rows outside it left out")
(:doc :symbol "asl/tools/hub/tests/preflightTest.asl#runTests" :text "pins the hub preflight on scratch dirs: no hub.asn passes as noHub, a hub with a client-carrying worktree passes, a hub with an old worktree is refused ERR_HUB_CLIENT_MISSING")
(:doc :symbol "asl/tools/hub/tests/sharedBucketTest.asl#runTests" :text "pins the shared bucket: two clients of one model through the hub get one bucket's admissions and the second is parked then answered after a refill, against two separate gateways admitting one each")
(:doc :symbol "asl/tools/svdImport.asl#Peripheral" :text "a parsed SVD peripheral: name, base address, the derivedFrom name if any, and its registers")
(:doc :symbol "asl/tools/svdImport.asl#Register" :text "a parsed SVD register: name, address offset, size, reset value and fields")
(:doc :symbol "asl/tools/svdImport.asl#Field" :text "a parsed SVD field: name, bit offset and bit width")
(:doc :symbol "asl/tools/svdImport.asl#parseSvd" :text "parses SVD XML text into peripherals with derivedFrom peripherals resolved; an error naming the line for malformed input such as a mismatched close tag")
(:doc :symbol "asl/tools/svdImport.asl#findPeriph" :text "the peripheral with the given name, none when absent")
(:doc :symbol "asl/tools/svdImport.asl#regKeys" :text "name:offset:size keys of registers, for comparing with a hand table")
(:doc :symbol "asl/tools/svdImport.asl#fieldKeysOf" :text "name:bitOffset:bitWidth keys of one register's fields, empty when the register is absent")
(:doc :symbol "asl/tools/tests/svdImportTest.asl#runTests" :text "pins parseSvd on a GPIOA and GPIOB fixture against a hand table, that swapped ODR and BSRR offsets fail the comparison, and that a mismatched close tag reports its line")
(:doc :symbol "asl/tools/nativeTest.asl#linkedWorktree?" :text "true when the root is a linked git worktree, whose .git is a file")
(:doc :symbol "asl/tools/nativeTest.asl#defaultCacheDirFor" :text "the native test cache directory: HOME/.asl/run/nativeTest shared by linked worktrees, otherwise .asl/cache/nativeTest under the root")
(:doc :symbol "asl/tools/workspaceConfigCheck.asl#main" :text "asl run workspaceConfigCheck.asl check FILE [SCHEMA]: checks a workspace or home config file against asl/grammar/workspaceConfig.asn, prints the receipt, exit 1 on any error")
(:doc :symbol "asl/tools/audit/run.asl#Lens" :text "one audit lens from the config: its name (knob, swallow or stub), whether findings queue a store row, the models that vote and the consensus rule all or any")
(:doc :symbol "asl/tools/audit/run.asl#AuditCfg" :text "the parsed audit config: report out path, :since tag override, the lenses, the bounded slice size around a finding, the store ledger path and the plan ledgers whose open rows own a file")
(:doc :symbol "asl/tools/audit/run.asl#Finding" :text "one static candidate: id given in run order, lens, file, line, enclosing symbol and its return type, severity, claim and the trimmed evidence line")
(:doc :symbol "asl/tools/audit/run.asl#RunOut" :text "what a run produced: the summary row, the ledger rows text, every finding and the flagged ones the lens rule kept")
(:doc :symbol "asl/tools/audit/run.asl#parseConfig" :text "the first (:audit ...) form of a config text as an AuditCfg; an unknown key at the top or in a lens row, an unknown lens, a rule other than all or any, or an empty :models is an error naming it")
(:doc :symbol "asl/tools/audit/run.asl#scanText" :text "the candidates of the enabled lenses over one file's text, line by line, with the enclosing function header tracked; ids are assigned later in run order")
(:doc :symbol "asl/tools/audit/run.asl#promptOf" :text "the vote prompt for a finding: the lens rule, the claim and the numbered code slice of line plus or minus k, plus the one-line verdict format; no ledger content or env values")
(:doc :symbol "asl/tools/audit/run.asl#real?" :text "true when a model reply says :real true")
(:doc :symbol "asl/tools/audit/run.asl#segs" :text "the non-empty segments of a slash-separated path")
(:doc :symbol "asl/tools/audit/run.asl#flagged?" :text "consensus of one finding: rule all needs every model's vote true and at least one vote, rule any needs one true vote; a failed call counted as a no vote")
(:doc :symbol "asl/tools/audit/run.asl#git!" :text "runs git -C DIR ARGS through the bounded fleet runner (120 s, 8 descendants) and returns its Done")
(:doc :symbol "asl/tools/audit/run.asl#heldBy" :text "pairs (row id, owner id) for each queued finding's file that an open owner already holds; an owner carrying the row's own id is left to the import, and one pair per row id")
(:doc :symbol "asl/tools/audit/run.asl#main" :text "the audit command: run or check, with --config (default ~/.asl/audit.asn), --repo, --since and --dry; check prints the lens names, run prints the summary row; exit 0 ok, 1 config or run error, 2 usage")
(:doc :symbol "asl/tools/audit/run.asl#rangeFiles!" :text "the release tag and the changed asl files under asl/packages and asl/tools from SINCE..HEAD, tests and fixtures excluded, deleted files dropped; an empty SINCE means the last v* tag reachable from HEAD, and no tag or a failed git diff is an error")
(:doc :symbol "asl/tools/audit/run.asl#rowsFor" :text "the ledger text for flagged findings of queue lenses, one (:u ...) row per file with a stable id per tag and file, so a rerun is skipped by the import")
(:doc :symbol "asl/tools/audit/run.asl#run!" :text "one audit run over a repo range: scan, vote through CALL, dedupe against open owners, write findings.asn and rows.asn under the run dir, dry import and then the real import unless dry or the dry one reported bad rows, append the summary row; returns the RunOut")
(:doc :symbol "asl/tools/audit/tests/runTest.asl#runTests" :text "gate for the audit run: config check, consensus rule, a fixture run, the dry run and dedupe against open owners")
(:doc :symbol "asl/tools/coverageRatchet.asl#Count" :text "one package's coverage row: package name, exported lowercase fn count and how many a test mentions")
(:doc :symbol "asl/tools/coverageRatchet.asl#Verdict" :text "the ratchet's decision: the violation lines, the number of packages counted and the covered total")
(:doc :symbol "asl/tools/coverageRatchet.asl#afterLastSeparator" :text "the part of a token after its last dot or slash, or the whole token when it has none")
(:doc :symbol "asl/tools/coverageRatchet.asl#atomEnd" :text "the index where the atom starting at an index ends: the first delimiter byte or the end of the bytes")
(:doc :symbol "asl/tools/coverageRatchet.asl#countPackage" :text "a package's Count: its exports, and those whose bare name is a token of the test set")
(:doc :symbol "asl/tools/coverageRatchet.asl#exportedFns" :text "the lowercase-initial names in a module's :x list")
(:doc :symbol "asl/tools/coverageRatchet.asl#isDelim" :text "true for a byte that ends an atom: space, tab, newline, carriage return, brackets, braces, quotes, backtick, comma, semicolon")
(:doc :symbol "asl/tools/coverageRatchet.asl#main" :text "the coverage ratchet command with --root, --baseline and --update (--date); without update it reports each violation and the totals and exits 1 on any violation, with update it raises the baseline only when no package is below it, and a missing baseline is an error")
(:doc :symbol "asl/tools/coverageRatchet.asl#packageCounts!" :text "the Count of every package under asl/packages with at least one export, against the tokens of all test files under root")
(:doc :symbol "asl/tools/coverageRatchet.asl#parseBaseline" :text "the Count rows of a baseline text; lines that are not well formed (:pkg ...) rows are ignored")
(:doc :symbol "asl/tools/coverageRatchet.asl#parseRow" :text "one baseline line (:pkg NAME :exports N :covered M) as a Count, none when it does not have that shape or a number does not parse")
(:doc :symbol "asl/tools/coverageRatchet.asl#raised" :text "the current counts with each package's covered figure never below its baseline row")
(:doc :symbol "asl/tools/coverageRatchet.asl#readTokens!" :text "the union token set of the given files; an unreadable file adds nothing")
(:doc :symbol "asl/tools/coverageRatchet.asl#renderBaseline" :text "the baseline file text for a date and the Count rows: header with the method, then one row per package")
(:doc :symbol "asl/tools/coverageRatchet.asl#testFiles!" :text "the asl files under asl/packages, asl/prelude, harness, tools and tests whose path is in a tests/ or test/ directory")
(:doc :symbol "asl/tools/coverageRatchet.asl#tokenSet" :text "the set of atoms of a source text, each with its part after the last dot or slash too")
(:doc :symbol "asl/tools/coverageRatchet.asl#verdict!" :text "the Verdict for a root and baseline path: counts the packages, lists every package below its baseline row, and reports a missing baseline as a violation")
(:doc :symbol "asl/tools/coverageRatchet.asl#violations" :text "one line per baseline package whose current covered count is lower or that is absent")
(:doc :symbol "asl/tools/coverageRatchet.asl#walk!" :text "every file path under a directory, recursively, skipping node_modules, .git and .asl; an unreadable directory gives none")
(:doc :symbol "asl/tools/coverageReach.asl#Row" :text "one unreached export: its package, file, name and how many fn bodies mention the name")
(:doc :symbol "asl/tools/coverageReach.asl#Scan" :text "the scan state while reading a source: the fn whose body is being read and the token set of every fn read so far")
(:doc :symbol "asl/tools/coverageReach.asl#headerName" :text "the fn a line declares: the name after fn, fn !, or tailrec fn at the start of the line; empty for an indented fn, a lambda or a longer word that starts with fn")
(:doc :symbol "asl/tools/coverageReach.asl#main" :text "the census command with --root and --limit: prints one (:unreached ...) row per exported fn no test can reach, most mentioned first, then the total; exit 0")
(:doc :symbol "asl/tools/coverageReach.asl#reachable" :text "the fns defined in the edges that are reachable from the seed names by following the names each body mentions")
(:doc :symbol "asl/tools/coverageReach.asl#scanLines" :text "the edges extended with one source: each fn name maps to the set of tokens of its body, header line excluded, a top-level line ending the body")
(:doc :symbol "asl/tools/coverageReach.asl#unreachedRows!" :text "the Rows for every exported fn under asl/packages src and the prelude that is defined but not reachable from any token of any test file, sorted by mentions descending")
(:doc :symbol "asl/tools/fleet/run.asl#cacheEnv!" :text "NAME=dir rows for this process's HOME-keyed caches: the override when set and non-empty, else this HOME's default; the native test cache default only in a linked worktree; pass them with a child's own HOME")
(:doc :symbol "asl/tools/fleet/run.asl#cacheRows" :text "the HOME-keyed caches, each with its override name and its default under HOME: native cli, host, native test, asl1, check and corpus")
(:doc :symbol "asl/tools/fleet/run.asl#fenceOf" :text "the fence of a killer: the pids of itself and every ancestor up to init, and the process groups they are in, so a killer never stops its own chain")
(:doc :symbol "asl/tools/fleet/run.asl#fenced?" :text "true when a root pid is 1 or lower or inside the killer's fence")
(:doc :symbol "asl/tools/fleet/tests/cacheEnvTest.asl#runTests" :text "gate for cacheEnv!: vps.asl is warmed with this HOME and run twice under new empty HOMEs with only PATH and the cache rows, the second answering fast and neither fresh HOME gaining a check cache")
(:doc :symbol "asl/tools/nativeTest.asl#lockLive?" :text "true when the lock file exists and its pid is alive; a lock with no pid is live only while younger than the grace row")
(:doc :symbol "asl/tools/nativeTest.asl#takeLock!" :text "creates the lock file with this process's pid; when it exists, a dead holder or a stale unparsable file is broken and the take retried, up to TRIES; false when a live holder or the tries run out")
(:doc :symbol "asl/tools/nativeTest.asl#unparsableStale?" :text "true when a lock file with no pid is older than the :native :lockGraceS row, since a live creator has the file before the pid is in it")
(:doc :symbol "asl/tools/tests/coverageRatchetTest.asl#runTests" :text "gate for the coverage ratchet on a built fixture tree: missing baseline, update, steady state, a dropped test, a missing or empty root, a refused update below the baseline, parse and raise rows")
(:doc :symbol "asl/tools/tests/coverageReachTest.asl#runTests" :text "gate for the reach census on a built fixture tree: header names, edges of a body, reachability over a chain of three calls, unreached rows with their callers, a cut call leaving a callee unreached")
(:doc :symbol "asl/tools/fleet/run.asl#pinOf" :text "a process key for the known set: a bare pid when its birth time is unknown, else born times 2^23 plus pid, so a recycled pid is a different key")
(:doc :symbol "asl/tools/fleet/run.asl#pinsOf" :text "the keys of the given pids, pinned with the birth time of the matching process row and bare when no row matches")
(:doc :symbol "asl/tools/fleet/run.asl#procsAt" :text "the process rows of a ps text taken at a given second: born is that second minus the elapsed time, -1 when the elapsed time is unknown")
(:doc :symbol "asl/tools/fleet/run.asl#stopGuard!" :text "kills a guarded run with the process groups and birth pins its guard recorded, so a setsid escapee still dies; returns how many of its processes are left alive, 0 when the tree is gone or fenced")
(:doc :symbol "asl/tools/fleet/run.asl#killTreeWith!" :text "kills the tree of root together with the process groups and birth pins a watcher recorded, so a setsid escapee it saw in the tree dies even after it was orphaned out of the lineage; returns how many of its processes are left alive")
(:doc :symbol "asl/tools/renderTag.asl#importFiles" :text "the files named by the module header's :i list, read lexically; a header without one imports nothing")
(:doc :symbol "asl/tools/renderTag.asl#renderEntry" :text "the renderer's entry source, asl/packages/asl-cli/src/verify.asl")
(:doc :symbol "asl/tools/renderTag.asl#renderTagIn!" :text "a 16 hex digit digest of the renderer entry and its direct imports under a root, so a cached checker verdict keys on the renderer source; an unreadable file contributes a missing marker")
(:doc :symbol "asl/tools/tests/renderTagTest.asl#runTests" :text "gate for renderTagIn! on a temp tree holding a verify.asl and the modules its header imports")
(:doc :symbol "asl/tools/goldenRegen.asl#Target" :text "one checked golden target: the receipt row printed for it and whether it drifted, was rewritten or is drift with no explaining commit")
(:doc :symbol "asl/tools/goldenRegen.asl#PathChange" :text "the lines removed and added for one source path in a golden, with the short ids of the commits since the pin that touched that path")
(:doc :symbol "asl/tools/goldenRegen.asl#onlyIn" :text "the lines of A that B does not match as a multiset difference in A's order, so a line twice in A and once in B is reported once")
(:doc :symbol "asl/tools/goldenRegen.asl#significant" :text "the lines worth classifying: blank lines and a lone closing paren are dropped")
(:doc :symbol "asl/tools/goldenRegen.asl#pathOfLine" :text "the first asl/... .asl path a golden line names (a summary :path, a diagnostic locus, a module line, a dependency row), empty when it names none")
(:doc :symbol "asl/tools/goldenRegen.asl#pathCounts" :text "how many of the given lines name each path, keyed by path with the empty path for lines that name none")
(:doc :symbol "asl/tools/goldenRegen.asl#digitsPrefix" :text "the leading decimal digits of a string, empty when it does not start with one")
(:doc :symbol "asl/tools/goldenRegen.asl#numberAfter" :text "the integer written right after the first marker in a text, -1 when the marker or the digits are missing")
(:doc :symbol "asl/tools/goldenRegen.asl#closureFiles" :text "the distinct source paths of the link-closure unit rows at the head of a linked text, in order, up to the (ok) or (err) line")
(:doc :symbol "asl/tools/goldenRegen.asl#git!" :text "runs git -C DIR ARGS through the bounded fleet runner (120 s, 8 descendants) and returns its Done")
(:doc :symbol "asl/tools/goldenRegen.asl#pinOf!" :text "the commit that last changed a path, empty when there is none or git fails; the point a file golden is measured from")
(:doc :symbol "asl/tools/goldenRegen.asl#pinOfText!" :text "the commit that last added or removed a text in a path (git log -S), else the last commit touching the path; the point a digest or count pinned in a test source is measured from")
(:doc :symbol "asl/tools/goldenRegen.asl#commitsIn!" :text "short ids, newest first, of the commits after the pin that touch a path; none when the pin is empty")
(:doc :symbol "asl/tools/goldenRegen.asl#changesOf!" :text "per path named by the removed and added lines: the line counts and the commits since the pin that touched it; lines naming no path are reported under the empty path with no commits")
(:doc :symbol "asl/tools/goldenRegen.asl#untraced?" :text "true when some change has no commit in the range, so the drift is not explained by a source edit and is reviewed instead of re-recorded")
(:doc :symbol "asl/tools/goldenRegen.asl#checkerTarget!" :text "one checker quadGolden text for an entry: recomputed, and on drift diffed by line and classified by path and commit; rewritten only with go set and every path traced, or force")
(:doc :symbol "asl/tools/goldenRegen.asl#irTargets!" :text "the asl-ir quadGoldenTest digests (lowerSourceWith and each linked-IR entry), each recomputed, classified by the commits since the digest was pinned that touched the link-closure files, and applied by replacing the quoted digest in the test source")
(:doc :symbol "asl/tools/goldenRegen.asl#corpusTarget!" :text "the closure size lowerCorpusTest asserts: recomputed from the compiler link closure; on drift the new units are the closure files added after the pin, and applying rewrites the count in the assert and message and names each new unit with its adding commit")
(:doc :symbol "asl/tools/goldenRegen.asl#main" :text "the golden regeneration command: reports the drift of the checker texts, the asl-ir digests and the closure count with the cause commit per path or file, and with --apply rewrites those whose every change traces to a commit (--force overrides); exit 0 nothing pending, 1 drift reported, 2 drift pending with an untraced change")
(:doc :symbol "asl/tools/tests/goldenRegenTest.asl#runTests" :text "gate for goldenRegen: the pure line, path and number helpers and, on a temp three-commit repo, the pin by file and by text, the commits after a pin, and the traced and untraced classification")
(:doc :symbol "asl/tools/fleet/run.asl#reapLeasesIn!" :text "removes and kills the leases in dir whose owner is absent from snap, but only when snap holds self: a snapshot without the reaper itself is broken (fds 0-2 closed gave an empty ps), never proof that every owner died; returns the count reaped")
(:doc :symbol "asl/tools/fleet/tests/childEnvHomeTest.asl#runTests" :text "a child given its own HOME and no ASL_NATIVE_TEST_CACHE inherits the parent's compile cache row; an explicit cache row wins")
(:doc :symbol "asl/tools/nativeTest.asl#suiteFailLine" :text "the FAIL line for a suite the checker rejected: a staged copy under .asl/cache/nativeTest/outside or outsidePkg is shown by the user's path, an in-root file by its rel")
(:doc :symbol "asl/tools/tests/suiteFailLineTest.asl#runTests" :text "outside and outsidePkg staged copies render with the user's path in the FAIL line, diagnostics and :indentFix; in-root paths unchanged")
(:doc :symbol "asl/tools/nativeTest.asl#unitKeyIn" :text "the native module cache key of a link unit: toolchain fingerprint, the unit path relative to root (or @entry), the digest of its file bytes, and each import as its root-relative path plus interface digest, so worktrees at different paths share an object only when text and interfaces match")
(:doc :symbol "asl/tools/tests/unitKeyTest.asl#runTests" :text "gate for NT-CACHE-ABS-PATH-KEY: two roots with the same text share a unit key, and other module text, another import interface or another toolchain fingerprint at the same relative path each give another key")
(:doc :symbol "asl/tools/gateway/claudeSmoke.asl#main" :text "one live smoke of the claude :sessions route: starts one gateway child under fleet/run.asl (300 s, 40 descendants, real HOME), sends two turns of one tiny prompt on one session key through the federation client, prints status, token counts and whether the vendor session id was reused, then kills the child tree; exit 0 only when both turns return 200")
(:doc :symbol "tools/remote/vpsNode.asl#groupText" :text "the text of the first top-level-named group of a config text, parens included, empty when absent; parens inside quoted strings do not count, so a key of another group with the same name is never read through it")
(:doc :symbol "tools/remote/vpsNode.asl#warmArgs" :text "operands of the deploy warm step from the :deploy group only: wall seconds per entry (1..86400, default 900), nice (0..19, default 10) and the entries; an out-of-range or non-numeric value warns on stderr and takes the default, so a bad shipped value never reaches nice or an entry wall")
(:doc :symbol "tools/remote/vpsNode.asl#warmBudgetS" :text "relay round trip budget of the warm step, 120 s plus entries x warmS; worst case 120 + 3 x 86400 = 259320 s at the ceiling, 2820 s at the defaults")
(:doc :symbol "tools/remote/coordDeps.asl#pathLines" :text "the .asl path lines of a command output, trimmed, so a warning line never becomes a closure entry")
(:doc :symbol "tools/remote/coordDeps.asl#importsOf" :text "module names of the :i list in a file header (the text before its first blank line); the :x list, aliases and body forms never count")
(:doc :symbol "tools/remote/coordDeps.asl#moduleIndex" :text "git grep -n '^(module ' output as (module name, path) pairs, test files and noise lines dropped")
(:doc :symbol "tools/remote/coordDeps.asl#indexLookup" :text "the path of a module name in a moduleIndex, none when absent")
(:doc :symbol "tools/remote/coordDeps.asl#closureOf" :text "the entry file plus every file its import headers reach, each once, bounded by a fuel of module visits; a module missing from the index is skipped")
(:doc :symbol "tools/remote/coordDeps.asl#coordTouchedIn?" :text "true when a changed path is a file of the conductor's import closure or lies under asl/tools/coord/; an empty closure (the command failed or timed out) fails closed: any changed path touches")
(:doc :symbol "tools/remote/coordDeps.asl#closureNote" :text "closureUnavailable: when no closure arrived, empty otherwise; prefixes the deploy conductor receipt so the journal says why it restarted")
(:doc :symbol "tools/remote/coordDeps.asl#closure!" :text "the import closure of an entry file in the tree at ROOT, the module index from one git grep; empty when git grep fails")
(:doc :symbol "tools/remote/coordDeps.asl#main" :text "closure ENTRY [ROOT] prints one closure path per line, exit 1 when empty; the deploy runs it in the deployed worktree to decide the conductor restart")
(:doc :symbol "asl/tools/coord/brief.asl#moduleOfPath" :text "module name derived from a source path: asl/packages/P/src/X.asl is P/X, asl/tools/A/B.asl is asl-tools/A/B, another .asl path is itself without the extension, empty for a non-.asl path")
(:doc :symbol "asl/tools/coord/brief.asl#ownedFact" :text "path lines: one brief line for an owned path, exists (N lines) or, when lines is -1, missing with the instruction to create it with one write, plus the derived module name")
(:doc :symbol "asl/tools/coord/brief.asl#sizeAdviceFree" :text "the task text without the lines carrying SMALL EDITS ONLY size advice")
(:doc :symbol "asl/tools/coord/brief.asl#briefFor" :text "task owned: the stored task text with size advice dropped when an owned file is missing and an owned-paths block (state at claim, module name) added; no owned paths returns the text unchanged")
(:doc :symbol "asl/tools/coord/conductor.asl#ownedStates!" :text "wt owns: each owned file with its line count in the unit worktree, -1 when it does not exist yet; directory entries are left out")
(:doc :symbol "asl/tools/coord/conductor.asl#writeResWith" :text "run rc dir u c: the write stage with the Leon run injected (rc lane id prof wt task owns gates extra), writeRes passes runWrite!; a gate records the task text the writer receives")
(:doc :symbol "asl/tools/coord/conductor.asl#briefTask!" :text "wt dir u prior: the writer brief, the stored task text plus the owned paths facts, then the prior note; the store text is not rewritten")
(:doc :symbol "asl/tools/coord/tests/briefTest.asl#runTests" :text "runs the brief suite: module names from paths and the owned-state block on fake states")
