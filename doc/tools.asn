(:doc :symbol "asl/tools/coord/tests/storeTest.asl#runTests" :text "prepare the store binary and run every case")
(:doc :symbol "asl/tools/coord/nodes.asl#" :text "Node registry for the fleet: one (:node ...) row per machine in ~/.asl/nodes.asn with role, arch, os, cores, ram, free disk, clang, worker channels and relay, plus probe! that fills the local row from the OS. Rows hold no tokens. Readers and writers take an explicit path.")
(:doc :symbol "asl/tools/coord/nodes.asl#Node" :text "one machine row")
(:doc :symbol "asl/tools/coord/nodes.asl#Node.id" :text "node name")
(:doc :symbol "asl/tools/coord/nodes.asl#Node.role" :text "primary, worker or macCheck")
(:doc :symbol "asl/tools/coord/nodes.asl#Node.arch" :text "uname -m")
(:doc :symbol "asl/tools/coord/nodes.asl#Node.os" :text "darwin or linux")
(:doc :symbol "asl/tools/coord/nodes.asl#Node.cores" :text "logical cores")
(:doc :symbol "asl/tools/coord/nodes.asl#Node.ramGb" :text "RAM in whole GiB")
(:doc :symbol "asl/tools/coord/nodes.asl#Node.diskFreeGb" :text "free GiB on /")
(:doc :symbol "asl/tools/coord/nodes.asl#Node.clang" :text "first line of clang --version")
(:doc :symbol "asl/tools/coord/nodes.asl#Node.channels" :text "worker lanes the node can run")
(:doc :symbol "asl/tools/coord/nodes.asl#Node.relay" :text "how the node is reached, none when local")
(:doc :symbol "asl/tools/coord/nodes.asl#nodesPath" :text "default ~/.asl/nodes.asn")
(:doc :symbol "asl/tools/coord/nodes.asl#roles" :text "the accepted :role values")
(:doc :symbol "asl/tools/coord/nodes.asl#roleOk?" :text "true when the role is accepted")
(:doc :symbol "asl/tools/coord/nodes.asl#parseNode" :text "row to Node; refuses a row without :id, :role or :arch or with an unknown role")
(:doc :symbol "asl/tools/coord/nodes.asl#addRow" :text "fold step appending one parsed row")
(:doc :symbol "asl/tools/coord/nodes.asl#readNodes!" :text "rows of a nodes file, empty when absent, error on the first bad row")
(:doc :symbol "asl/tools/coord/nodes.asl#renderNode" :text "one row as ASN")
(:doc :symbol "asl/tools/coord/nodes.asl#renderNodes" :text "all rows, one per line")
(:doc :symbol "asl/tools/coord/nodes.asl#writeNodes!" :text "write all rows")
(:doc :symbol "asl/tools/coord/nodes.asl#upsertNode!" :text "replace the row with the same id or append")
(:doc :symbol "asl/tools/coord/nodes.asl#parseCount" :text "first line as an integer, 0 when not one")
(:doc :symbol "asl/tools/coord/nodes.asl#coresCommand" :text "the OS command printing the logical core count")
(:doc :symbol "asl/tools/coord/nodes.asl#probeCores!" :text "logical cores of this machine")
(:doc :symbol "asl/tools/coord/nodes.asl#probeOs!" :text "darwin or linux")
(:doc :symbol "asl/tools/coord/nodes.asl#probeArch!" :text "uname -m")
(:doc :symbol "asl/tools/coord/nodes.asl#probeRamGb!" :text "RAM in whole GiB")
(:doc :symbol "asl/tools/coord/nodes.asl#probeDiskFreeGb!" :text "free GiB on /")
(:doc :symbol "asl/tools/coord/nodes.asl#probeClang!" :text "first line of clang --version")
(:doc :symbol "asl/tools/coord/nodes.asl#probe!" :text "Node row for this machine")
(:doc :symbol "asl/tools/coord/tests/nodesTest.asl#runTests" :text "probe cores equal the OS count, bad rows refused, scratch round trip")
(:doc :symbol "tools/fleet/cache.asl#Toolchain" :text "what a verdict was computed with: target triple, libc, clang version, clang binary digest")
(:doc :symbol "tools/fleet/cache.asl#Toolchain.triple" :text "clang -print-target-triple")
(:doc :symbol "tools/fleet/cache.asl#Toolchain.libc" :text "libSystem version on macOS, ldd version line on Linux")
(:doc :symbol "tools/fleet/cache.asl#Toolchain.clang" :text "first line of clang -v")
(:doc :symbol "tools/fleet/cache.asl#Toolchain.digest" :text "sha256 of the clang binary")
(:doc :symbol "tools/fleet/cache.asl#toolchainOf" :text "build a Toolchain from its probed parts")
(:doc :symbol "tools/fleet/cache.asl#toolchainProbeCommand" :text "shell command printing triple, clang version, libc and clang path, one per line")
(:doc :symbol "tools/fleet/cache.asl#probeToolchain!" :text "Toolchain of this machine")
(:doc :symbol "tools/fleet/cache.asl#toolchainHeader" :text "tab-joined Toolchain, first line of an exported verdict")
(:doc :symbol "tools/fleet/cache.asl#keyWithToolchain" :text "cache key over closure hash, CLI hash and all four Toolchain fields")
(:doc :symbol "tools/fleet/cache.asl#exportVerdict!" :text "write a verdict for another node under exportDir/key with its Toolchain header")
(:doc :symbol "tools/fleet/cache.asl#importInto!" :text "copy exported verdicts whose header equals the given Toolchain into a cache root, returns the count; foreign ones are skipped")
(:doc :symbol "asl/tools/fleet/tests/fleetCacheTest.asl#runTests" :text "key varies with each toolchain field alone; foreign-triple verdict refused on import")
(:doc :symbol "tools/fleet/cache.asl#memoToolchain!" :text "read the Toolchain memo for a clang path from dir while its stamp matches, else call probe and overwrite that one file")
(:doc :symbol "tools/fleet/cache.asl#probeToolchainOnce!" :text "probeToolchain! memoized per process; what cacheKey uses")
(:doc :symbol "tools/fleet/cache.asl#clangPath!" :text "first clang on PATH found without spawning, absent when none")
(:doc :symbol "tools/fleet/cache.asl#clangStamp!" :text "size and mtimeNs of a clang path by fileStat, absent when missing")
(:doc :symbol "tools/fleet/cache.asl#toolchainMemoDir" :text "toolchain memo dir under the fleet cache root")
(:doc :symbol "asl/tools/coord/grade.asl#" :text "FK-GRADE grader picker: chooses a grader on another channel and model family than the writer, runs deterministic pre-checks before any model call, and emits workerStats (:run) and (:grade) rows")
(:doc :symbol "asl/tools/coord/grade.asl#Candidate" :text "a grader candidate: channel, model, available (availability is an input)")
(:doc :symbol "asl/tools/coord/grade.asl#Writer" :text "the writer under grading: unit, channel, model")
(:doc :symbol "asl/tools/coord/grade.asl#Source" :text "a gate source file: path and text, scanned for constant assertions")
(:doc :symbol "asl/tools/coord/grade.asl#Plan" :text "planGo carries the chosen grader; planRefused carries the reject or pending (:grade) row and the problems, made before any model call")
(:doc :symbol "asl/tools/coord/grade.asl#planGo" :text "pre-checks passed and a grader is eligible; the model call may be made")
(:doc :symbol "asl/tools/coord/grade.asl#planRefused" :text "refused before any model call; row is the (:grade) row, problems the reasons")
(:doc :symbol "asl/tools/coord/grade.asl#familyOf" :text "model family from a model name by substring table (google, anthropic, openai, ...); empty for an empty model")
(:doc :symbol "asl/tools/coord/grade.asl#pickGrader" :text "first candidate that is available, on another channel and in another family than the writer; err lists why each was refused")
(:doc :symbol "asl/tools/coord/grade.asl#receiptProblems" :text "receipt problems: parse failure, no redBefore rows, gates that never ran, plus tools/fleet/receipt validateForm")
(:doc :symbol "asl/tools/coord/grade.asl#constantProblems" :text "constant gate assertions found by asl-checker constantAssertDiags in each source")
(:doc :symbol "asl/tools/coord/grade.asl#preChecks" :text "receiptProblems then constantProblems; empty means the grader may be called")
(:doc :symbol "asl/tools/coord/grade.asl#plan" :text "pre-checks first, then pickGrader; returns planGo or planRefused")
(:doc :symbol "asl/tools/coord/grade.asl#runRow" :text "one workerStats (:run ...) row; negative numbers omit their field")
(:doc :symbol "asl/tools/coord/grade.asl#gradeRow" :text "one (:grade :unit :worker :model :writer :verdict :note) row; worker and model are the grader")
(:doc :symbol "asl/tools/coord/grade.asl#statsProblems" :text "problems of a (:run) or (:grade) row against the workerStats shape; empty when valid")
(:doc :symbol "asl/tools/coord/worktree.asl#" :text "FK-WORKTREE node-local worktree lifecycle: add on branch sh/UNIT, list with merged and dirty state, remove-if-merged, archive a dirty diff before a forced removal, rescue a detached head to a branch; only worktrees under base named prefixUNIT are seen")
(:doc :symbol "asl/tools/coord/worktree.asl#Cfg" :text "repo checkout, worktree base dir, unit dir prefix, archive dir and main ref; passed in, never read from env")
(:doc :symbol "asl/tools/coord/worktree.asl#Wt" :text "one listed worktree: unit, path, head, branch, detached, dirty (non-ignored paths), ignored, merged into mainRef, lease (unknown until the coord store lands)")
(:doc :symbol "asl/tools/coord/worktree.asl#Entry" :text "one block of git worktree list --porcelain")
(:doc :symbol "asl/tools/coord/worktree.asl#safeUnit?" :text "true for a unit name of letters, digits, dot, dash and underscore with no leading dot or dash and no double dot")
(:doc :symbol "asl/tools/coord/worktree.asl#wtPath" :text "base/prefixUNIT")
(:doc :symbol "asl/tools/coord/worktree.asl#parseWorktrees" :text "parse git worktree list --porcelain into entries")
(:doc :symbol "asl/tools/coord/worktree.asl#listWt!" :text "worktrees under base named prefixUNIT with dirty, ignored and merged state")
(:doc :symbol "asl/tools/coord/worktree.asl#addWt!" :text "make branch sh/UNIT at rev (default mainRef) in base/prefixUNIT; an existing path or unsafe unit is refused")
(:doc :symbol "asl/tools/coord/worktree.asl#rescueBranch!" :text "branch rescue/UNIT-short8 at a detached head, reused only when it already points there")
(:doc :symbol "asl/tools/coord/worktree.asl#isWorktreeOf!" :text "true when the real path is one of the repo's git worktree list entries")
(:doc :symbol "asl/tools/coord/worktree.asl#secretUntracked!" :text "untracked files at a path that the egress filter flags as secret by path; a wip commit leaves them and the conductor journals their count")
(:doc :symbol "asl/tools/coord/worktree.asl#outsideUntracked!" :text "untracked non-ignored files at a path outside the unit :owns (git pathspecs) and not secret by path; empty owns means none are outside")
(:doc :symbol "asl/tools/coord/worktree.asl#wipCommitOwned!" :text "wipCommitAt! with the unit :owns: tracked edits are committed, untracked files only inside :owns, the others stay in the tree; the conductor journals their count as :leftOutside N")
(:doc :symbol "asl/tools/coord/worktree.asl#wipCommitAt!" :text "wip-commit the non-ignored edits of the worktree at path (ASN message naming unit and reason, rescue branch for a detached head); short sha, empty when clean, an error and no touch when the path is not a worktree of the repo")
(:doc :symbol "asl/tools/coord/worktree.asl#wipCommit!" :text "commit a unit worktree's non-ignored edits as one wip commit with an ASN message naming unit and stop reason, rescue branch for a detached head; returns the short sha, empty when clean or absent")
(:doc :symbol "asl/tools/coord/worktree.asl#removeWt!" :text "rescue a detached head, keep dirty (without force) or unmerged (without force) trees, archive a dirty tree before a forced removal, then git worktree remove; returns a (:wtRemoved) or (:wtKept) row")
(:doc :symbol "asl/tools/coord/conductor.asl#CUnit" :text "state row of one unit: id, st, lane, fail count and signature, waited and parked flags, lease epoch, branch, worktree, model, tokens, costMicro, esc flag, launched flag and await lane")
(:doc :symbol "asl/tools/coord/conductor.asl#Res" :text "result row of one stage child: ok, wt, branch, model, tokens, costMicro, claimedGreen, sig, ms, exit, asserts, verdict and tiers, the union of the four stages")
(:doc :symbol "asl/tools/coord/conductor.asl#Pace" :text "admission interface: tokens returns how many units may be in flight at once, allowance returns how many of them a given lane may hold")
(:doc :symbol "asl/tools/coord/conductor.asl#Ctx" :text "conductor context: store dir, lease holder and ttl, maxWait and maxSame limits, stage deadline, descendant limit, the launch function that builds a stage argv, and the Pace")
(:doc :symbol "asl/tools/coord/conductor.asl#RealCfg" :text "real-run configuration: repo, devRepo, devBranch, worktree cfg, home, keys file, lease and gate seconds, lanes file, writer alias and gateway profile")
(:doc :symbol "asl/tools/coord/conductor.asl#cuDir" :text "directory of the unit state rows, dir/cond")
(:doc :symbol "asl/tools/coord/conductor.asl#cuPath" :text "path of one unit state row, dir/cond/ID.asn")
(:doc :symbol "asl/tools/coord/conductor.asl#journalPath" :text "path of the transition journal, dir/journal.asn")
(:doc :symbol "asl/tools/coord/conductor.asl#escalationsPath" :text "path of the escalation and need rows, dir/escalations.asn")
(:doc :symbol "asl/tools/coord/conductor.asl#runsDir" :text "directory of stage run and result files, dir/runs")
(:doc :symbol "asl/tools/coord/conductor.asl#runPath" :text "path dir/runs/ID-STAGE.EXT of a stage run, result or receipt file")
(:doc :symbol "asl/tools/coord/conductor.asl#runRow" :text "reads the run row of a stage and returns some pair of pid and deadlineMs, or none when the row is missing or unreadable")
(:doc :symbol "asl/tools/coord/conductor.asl#renderCUnit" :text "renders a CUnit as one (:cu ...) ASN row")
(:doc :symbol "asl/tools/coord/conductor.asl#parseCUnit" :text "parses a (:cu ...) row back to a CUnit, or returns the row error")
(:doc :symbol "asl/tools/coord/conductor.asl#readCUnits!" :text "reads every parseable unit state row under dir/cond in name order, skipping unreadable ones")
(:doc :symbol "asl/tools/coord/conductor.asl#writeCUnit!" :text "writes a unit state row atomically through a pid-named temp file and rename")
(:doc :symbol "asl/tools/coord/conductor.asl#costText" :text "formats micro-dollars as dollars with six decimals, for example 1.250000")
(:doc :symbol "asl/tools/coord/conductor.asl#renderRes" :text "renders a Res as one (:res ...) ASN row")
(:doc :symbol "asl/tools/coord/conductor.asl#parseRes" :text "parses a (:res ...) row back to a Res, or returns the row error")
(:doc :symbol "asl/tools/coord/conductor.asl#allowanceUnlimited" :text "allowance function that gives every lane 1000000, meaning no limit")
(:doc :symbol "asl/tools/coord/conductor.asl#fixedPace" :text "builds a Pace with a constant token count and a constant per-lane allowance")
(:doc :symbol "asl/tools/coord/conductor.asl#jobserverPace" :text "builds a Pace whose token count is the jobserver pool size for dir and whose allowance is the given function")
(:doc :symbol "asl/tools/coord/conductor.asl#gateSig" :text "failure signature of gate output: the first error line, else the first line marked fail, error or exit, else the last non-empty line, cut to 160 chars")
(:doc :symbol "asl/tools/coord/conductor.asl#rulingVerdict" :text "maps a ladder ruling action to a review verdict: merge pass, fix fail, await defer, anything else block")
(:doc :symbol "asl/tools/coord/conductor.asl#tick!" :text "one scheduler pass: polls, launches and transitions each unit at most once in id order within the pace capacity; returns 1 when any unit row changed, 0 when idle")
(:doc :symbol "asl/tools/coord/conductor.asl#wake!" :text "moves units parked in awaitReview for a lane back to reviewable with one journal row each; returns how many were woken")
(:doc :symbol "asl/tools/coord/conductor.asl#status!" :text "renders the status text: one row per unit, per-lane token and cost spend, running, blocked and parked id lists and the escalation count")
(:doc :symbol "asl/tools/coord/conductor.asl#drain!" :text "ticks, sleeping 50 ms after an idle tick, until the store is settled or max ticks; returns the ticks run")
(:doc :symbol "asl/tools/coord/conductor.asl#stopAll!" :text "kills the process tree of every in-flight stage and drops its run row; returns how many were stopped")
(:doc :symbol "asl/tools/coord/conductor.asl#gateRowOf" :text "the (:gate ...) line of the store's ladder.asn, empty when absent; its only key is :checkTimeoutS")
(:doc :symbol "asl/tools/coord/conductor.asl#gateErrors" :text "config check of a (:gate ...) row: an unknown key or :checkTimeoutS outside 30..7200 is an error")
(:doc :symbol "asl/tools/coord/conductor.asl#gateCheckS" :text "seconds the asl check before a gate may run: (:gate :checkTimeoutS N) in the store's ladder.asn, default 900 (adopted); a row gateErrors rejects means the default")
(:doc :symbol "asl/tools/coord/conductor.asl#gateTimeoutSig" :text "signature of an asl check that passed its bound: gateTimeout: asl check on FILE passed N s")
(:doc :symbol "asl/tools/coord/conductor.asl#gateTimeoutSig?" :text "true for a gateTimeout signature, a failure kind of its own")
(:doc :symbol "asl/tools/coord/conductor.asl#gateTimeoutRequeue!" :text "a gate stage that timed out stays in gating and runs again with a (:stop :unit :kind gateTimeout :n N) journal row and no fail count; the fourth consecutive timeout is an ordinary gate failure")
(:doc :symbol "asl/tools/coord/conductor.asl#checkOne!" :text "asl check of one file in the unit worktree under the given seconds; empty when it passes, gateTimeout when the bound is hit, else asl check failed with the gate signature")
(:doc :symbol "asl/tools/coord/conductor.asl#blockSig" :text "signature a block gets when it carries none: STAGE: REASON of the move, so a blocked unit always says why")
(:doc :symbol "asl/tools/coord/conductor.asl#wakeRowsOf" :text "the (:wake :await NAME :readyBelow N) lines of the store's ladder.asn")
(:doc :symbol "asl/tools/coord/conductor.asl#wakeErrors" :text "config check of a (:wake ...) row: an unknown key, a missing :await or :readyBelow outside 1..1000 is an error and the row is ignored")
(:doc :symbol "asl/tools/coord/conductor.asl#freeWake!" :text "wakes units parked in awaitReview on a :await NAME of a (:wake) row while a writer slot is free and fewer than :readyBelow units are ready, one per slot; returns the units woken")
(:doc :symbol "asl/tools/coord/conductor.asl#move!" :text "one state change: journal row first, then the unit row with the spend added; a block without a signature gets one from the move")
(:doc :symbol "asl/tools/coord/conductor.asl#waitMore!" :text "counts one wait tick; past maxWait the unit escalates and blocks with the signature waitedOut: WHY")
(:doc :symbol "asl/tools/coord/conductor.asl#parkedOf" :text "the unit with its parked flag set to 1 or 0")
(:doc :symbol "asl/tools/coord/conductor.asl#pickWriteProfileX" :text "pickWriteProfileH with an excluded profile list: those profiles leave the :writeProfiles row before the stable hash picks, unless that would empty it")
(:doc :symbol "asl/tools/coord/conductor.asl#writeProfileFor" :text "the write profile of a unit: the weighted pick of its lane row, leaving out the profiles it stalled on (stalledProfilesOf)")
(:doc :symbol "asl/tools/coord/conductor.asl#stalledProfilePath" :text "<store>/stalledProfiles.asn, one (:stalledProfile :unit :profile :alias :at) row per stall kill")
(:doc :symbol "asl/tools/coord/conductor.asl#stalledProfilesOf" :text "the profiles a unit was running when it was stall-killed, from stalledProfiles.asn")
(:doc :symbol "asl/tools/coord/conductor.asl#gatesRes" :text "reruns the unit declared gate in its worktree under the gate limit (the asl check before it under checkSec) and returns a Res with exit, executed asserts and signature; exit 2 when the unit has no gate")
(:doc :symbol "asl/tools/coord/conductor.asl#loadUnit!" :text "reads the store task row and the state row of a unit id and returns some pair of both, or none when either is missing")
(:doc :symbol "asl/tools/coord/conductor.asl#writeRes!" :text "writes a stage Res row atomically to dir/runs/ID-STAGE.asn")
(:doc :symbol "asl/tools/coord/conductor.asl#realRes" :text "runs one real stage (write, gates, review or merge) for a unit and returns its Res; an unknown stage gives a failing Res")
(:doc :symbol "asl/tools/coord/conductor.asl#realLaunch" :text "returns the launch function that builds the argv of a detached conductor stage child with the options it needs to rebuild its RealCfg")
(:doc :symbol "asl/tools/coord/conductor.asl#attachOrAdd" :text "adds the unit worktree, or when its sh/ID branch already exists attaches it and refreshes its base; returns the path or an error")
(:doc :symbol "asl/tools/coord/conductor.asl#parkedRows!" :text "reads dir/parked.asn and returns a pair of unit id and the need then do text for each parked row")
(:doc :symbol "asl/tools/coord/conductor.asl#needRows!" :text "appends one (:need :unit :needs :do) escalation row per parked unit not yet in the escalations file; returns the rows written")
(:doc :symbol "asl/tools/coord/conductor.asl#importCycle!" :text "imports the plan ledger named in dir/ledger.path through planImport at its base ref and then writes need rows; returns the units put, 0 when no ledger")
(:doc :symbol "asl/tools/coord/conductor.asl#ledgerPath" :text "path of the ledger pointer file, dir/ledger.path")
(:doc :symbol "asl/tools/coord/conductor.asl#offerStrong!" :text "when the strong tier has allowance now, gives blocked units whose newest escalate row offers strong first a fresh lease and an offer file and returns them to awaitReview; returns the count")
(:doc :symbol "asl/tools/coord/conductor.asl#lastTiers" :text "the :tiers text of the newest escalate row of a unit id, empty when there is none")
(:doc :symbol "asl/tools/coord/conductor.asl#tiersOfRows" :text "the tiers text of the first (:escalate ...) row that has a :tiers list, empty when no row has one")
(:doc :symbol "asl/tools/coord/conductor.asl#offeredRung!" :text "returns R3 and consumes the offer file when one exists for the unit, else the empty string")
(:doc :symbol "asl/tools/coord/conductor.asl#offerPath" :text "path of a unit offer file, dir/offers/ID.asn")
(:doc :symbol "asl/tools/coord/conductor.asl#freshBase!" :text "makes a re-attached unit branch descend from its base: keeps it when the base is an ancestor, else rebases, else renames it sh/ID-stale-S and recreates it from the base")
(:doc :symbol "asl/tools/coord/conductor.asl#leonTokens" :text "writer token spend read from the last :usage (:input N ...) row of Leon output, input plus output, 0 when absent")
(:doc :symbol "asl/tools/coord/conductor.asl#leonCost" :text "writer cost in micro-dollars as turns times the model price per call; -1 when there are no turns or no price")
(:doc :symbol "asl/tools/coord/conductor.asl#dropRemotes!" :text "removes every git remote of a dir and returns how many were removed")
(:doc :symbol "asl/tools/coord/conductor.asl#mergeEnv" :text "child environment for the merge train with ASL_E2E=0 pinned")
(:doc :symbol "asl/tools/coord/conductor.asl#realPace" :text "Pace over the jobserver pool of the default root with unlimited lane allowance")
(:doc :symbol "asl/tools/coord/conductor.asl#settled?" :text "true when every store unit has a state row and none is queued, ready or in a stage")
(:doc :symbol "asl/tools/coord/conductor.asl#sigKey" :text "normalizes a failure signature to compare without ids: non-alphanumerics become spaces and any word of six or more chars with a digit becomes #")
(:doc :symbol "asl/tools/coord/conductor.asl#laneSnapshot" :text "current allowance of every lane alias and of each tier as the largest allowance among its lanes, from the gateway text, lanes file and subscription pacing")
(:doc :symbol "asl/tools/coord/conductor.asl#refreshWake!" :text "takes a lane snapshot, runs the refresh, and wakes units of every lane or tier whose allowance rose; returns the units woken")
(:doc :symbol "asl/tools/coord/conductor.asl#startupProblemsFor" :text "coverage problems of the gateway text and lanes file for a RealCfg; an empty list means the run may start")
(:doc :symbol "asl/tools/coord/conductor.asl#stopPath" :text "path of the cooperative stop file, dir/stop")
(:doc :symbol "asl/tools/coord/conductor.asl#requestStop!" :text "writes the stop file and returns whether the write succeeded")
(:doc :symbol "asl/tools/coord/conductor.asl#loopOnce!" :text "one service cycle: with a stop file it stops all stages, removes the file and returns false; else imports, ticks, offers strong and wakes on refresh, and returns true")
(:doc :symbol "asl/tools/coord/conductor.asl#runLoop!" :text "service loop of loopOnce! cycles with cooperative sleeping between ticks and a subscription refresh every everyMs; returns the exit code")
(:doc :symbol "asl/tools/coord/conductor.asl#gatesStage" :text "real gates stage: reruns the gate, and when green runs it at the merge-base for red-before and writes the receipt to dir/runs/ID-receipt.asn; returns the gate Res")
(:doc :symbol "asl/tools/coord/conductor.asl#main" :text "conductor CLI: stage, tick, status, wake LANE, check, stop and run [--ledger] commands over --store, with usage and exit 2 for anything else")
(:doc :symbol "asl/tools/coord/conductorService.asl#Layout" :text "paths of the service install: home, main repo, dev repo, store and source repo")
(:doc :symbol "asl/tools/coord/conductorService.asl#layoutOf" :text "builds a Layout from a home dir: repo home/wt/main, devRepo home/asex-dev, store home/.asl/run/conductor, source home/asex")
(:doc :symbol "asl/tools/coord/conductorService.asl#unitText" :text "text of the systemd user unit asl-conductor.service that runs the conductor with its store and dev repo, with ExecStop stop and Restart always")
(:doc :symbol "asl/tools/coord/conductorService.asl#devRepoSteps" :text "argv steps that clone the source repo to the dev repo and create the dev branch from origin/main; empty when the dev repo already exists")
(:doc :symbol "asl/tools/coord/conductorService.asl#serviceSteps" :text "argv steps for systemctl --user daemon-reload and enable --now of asl-conductor.service")
(:doc :symbol "asl/tools/coord/conductorService.asl#stepText" :text "joins a step argv with spaces")
(:doc :symbol "asl/tools/coord/conductorService.asl#main" :text "install [--home H] [--dry]: dry prints the unit and steps and changes nothing, else creates dirs, runs the dev repo steps, writes the unit and enables the service; other input prints usage and exits 2")
(:doc :symbol "asl/tools/coord/egress.asl#secretLike?" :text "true when lowercased text mentions .asl/mem, a secret needle such as password, bearer or ghp_, or a key shape such as sk- or key= with a long token")
(:doc :symbol "asl/tools/coord/egress.asl#memLike?" :text "true when the lowercased text contains .asl/mem")
(:doc :symbol "asl/tools/coord/egress.asl#secretPath?" :text "true when a lowercased path mentions .asl/mem or a secret file needle such as .env, id_rsa, .pem or .netrc")
(:doc :symbol "asl/tools/coord/egress.asl#leaks?" :text "true when the text is secret-like, same as secretLike?")
(:doc :symbol "asl/tools/coord/egress.asl#leaksWith?" :text "true when the text is secret-like or contains one of the env values")
(:doc :symbol "asl/tools/coord/egress.asl#envLeak?" :text "true when the text contains any env value of at least minEnvValueLength characters")
(:doc :symbol "asl/tools/coord/egress.asl#clip" :text "cuts a string to at most n characters")
(:doc :symbol "asl/tools/coord/egress.asl#unarmored" :text "the lines of a text without its armored blocks: a -----BEGIN line through its -----END line goes whole, an unterminated block takes the rest")
(:doc :symbol "asl/tools/coord/egress.asl#scrubLinesBy" :text "scrubLines with the leak test given: drops armored blocks, blank lines and flagged lines, clips to width, keeps at most maxLines")
(:doc :symbol "asl/tools/coord/egress.asl#scrubLines":text "drops blank lines and lines that leak, clips the rest to width and keeps at most maxLines")
(:doc :symbol "asl/tools/coord/egress.asl#scrubText" :text "scrubLines joined with newlines")
(:doc :symbol "asl/tools/coord/egress.asl#allowedPath?" :text "false for an empty path, one with .. segments, an absolute path outside root, or a secret path, else true")
(:doc :symbol "asl/tools/coord/egress.asl#minEnvValueLength" :text "shortest env value that counts for the leak check, 8")
(:doc :symbol "asl/tools/coord/ladder.asl#tokensOf" :text "splits an alias or model name into lowercase whole tokens at case, digit and separator boundaries")
(:doc :symbol "asl/tools/coord/ladder.asl#familiesIn" :text "distinct families of the table rows whose :match is a whole token run of the name, in row order")
(:doc :symbol "asl/tools/coord/ladder.asl#coverageProblems" :text "lists aliases with several families, with none and not listed unknown, or listed unknown but resolving to a family")
(:doc :symbol "asl/tools/coord/ladder.asl#rankLanes" :text "orders lanes by descending quality, equal quality keeping the caller order")
(:doc :symbol "asl/tools/coord/ladder.asl#Lane" :text "review lane: alias, tier, allowance and quality")
(:doc :symbol "asl/tools/coord/ladder.asl#ReviewUnit" :text "unit under review: id, task, risk, closureChanged, writer alias and channel, startRung, fixesUsed and prior verdicts")
(:doc :symbol "asl/tools/coord/ladder.asl#Verdict" :text "one reviewer verdict: outcome pass, fail or abstain, defects, model and rung")
(:doc :symbol "asl/tools/coord/ladder.asl#Ruling" :text "ladder result: action, rung, defects, awaitLane, grade and escalate rows, all verdicts and why")
(:doc :symbol "asl/tools/coord/ladder.asl#Pick" :text "lane choice: pickOk with the lanes to call, or pickAwait with the lane to wait for and why")
(:doc :symbol "asl/tools/coord/ladder.asl#Step" :text "tally outcome: stepMerge, stepFix with defects, stepEscalate, or stepBlocked with why")
(:doc :symbol "asl/tools/coord/ladder.asl#familyTableAsn" :text "the built-in ASN table mapping alias and model name tokens to model families")
(:doc :symbol "asl/tools/coord/ladder.asl#familyRows" :text "parses a family table into its rows that have a :match, empty when it does not parse")
(:doc :symbol "asl/tools/coord/ladder.asl#familyIn" :text "the one family a name resolves to, empty when it resolves to none or to several")
(:doc :symbol "asl/tools/coord/ladder.asl#selectFree" :text "picks two ranked free lanes of two distinct families other than the writer family, else awaits with the reason")
(:doc :symbol "asl/tools/coord/ladder.asl#selectOne" :text "picks the best ranked lane of a tier outside the writer family, else awaits with the reason")
(:doc :symbol "asl/tools/coord/ladder.asl#parseVerdict" :text "parses a reply into a Verdict; unparseable, missing, contradictory or defect-less fail output is abstain, never pass")
(:doc :symbol "asl/tools/coord/ladder.asl#gatesProven" :text "true when the receipt has a redBefore row and every gate row exited 0 with executed assertions above 0")
(:doc :symbol "asl/tools/coord/ladder.asl#decide" :text "tallies verdicts at a rung into merge, fix, escalate or blocked, requiring proven gates before a merge and one fix round at most")
(:doc :symbol "asl/tools/coord/ladder.asl#scrubLines" :text "drops blank lines and secret-looking lines, clips to width and keeps at most maxLines")
(:doc :symbol "asl/tools/coord/ladder.asl#reviewWriter" :text "the writer alias a review excludes: the unit's model, else the configured fallback; an unknown writer stays unknown so selection waits on writerFamily")
(:doc :symbol "asl/tools/coord/ladder.asl#reviewBrief" :text "the (:review ...) prompt for a unit with scrubbed task, diff and gates and the one-form reply instruction")
(:doc :symbol "asl/tools/coord/ladder.asl#reviewWith" :text "runs the ladder with a given family table from the start rung and returns a Ruling, or an error for an empty table, bad risk or bad startRung")
(:doc :symbol "asl/tools/coord/conductor.asl#realCfg" :text "builds a RealCfg from CLI options: repo, dev-repo, dev, worktrees, archive, home, keys, lanes, writer-alias and profile, with defaults derived from the repo and store")
(:doc :symbol "asl/tools/coord/ladder.asl#review" :text "reviewWith over the built-in familyTableAsn: runs the review ladder for a unit, diff and gates over the lanes with an injected model call and returns a Ruling")
(:doc :symbol "asl/tools/coord/nodes.asl#meshRoles" :text "the mesh roles a node row may list in :roles: cpu, mem, gateway, relay and mac")
(:doc :symbol "asl/tools/coord/nodes.asl#meshRoleOk?" :text "true when a role is one of the mesh roles")
(:doc :symbol "asl/tools/coord/nodes.asl#findNode" :text "the node row with the given id as some, else none")
(:doc :symbol "asl/tools/coord/nodes.asl#hasRole?" :text "true when the node lists the role in its :roles")
(:doc :symbol "asl/tools/coord/nodes.asl#freeSlots" :text "free job slots of a node, its cores minus the slots in use")
(:doc :symbol "asl/tools/coord/nodes.asl#pickFrom" :text "among nodes holding the role that have a used entry, the one with most free slots, or none when that count is not above 0; nodes absent from used are skipped")
(:doc :symbol "asl/tools/coord/planImport.asl#PlanRow" :text "plan ledger row to import: id, doc text, gate, owns, reads, after and channel")
(:doc :symbol "asl/tools/coord/planImport.asl#Report" :text "result of an import: ids put, skipped, parked with their need, and bad")
(:doc :symbol "asl/tools/coord/planImport.asl#rowsOf" :text "selected PlanRows of a ledger text: one-line (:u :id ...) forms marked :auto true or :queue conductor with a :do and status queued or none, deduped by id")
(:doc :symbol "asl/tools/coord/planImport.asl#importable?" :text "true when the row has owns and a gate")
(:doc :symbol "asl/tools/coord/planImport.asl#needOf" :text "what keeps a row from importing: owns, gate, or after for a dependency neither known nor importable; empty when nothing")
(:doc :symbol "asl/tools/coord/planImport.asl#resolve" :text "fixpoint over the importable rows returning the ids that stay importable once rows waiting on parked rows are parked")
(:doc :symbol "asl/tools/coord/planImport.asl#plan!" :text "turns ledger rows not yet in the store into tasks (unless dry), writes parked.asn from the rows still parked, and returns a Report")
(:doc :symbol "asl/tools/coord/planImport.asl#refreshable?" :text "true when a unit state and await are not a stage in flight (writing gating awaitReview reviewing merging), not merged and not blocked awaiting the lead or a rebase, so plan! may rewrite its task text, owns and gate from a changed ledger row")
(:doc :symbol "asl/tools/coord/planImport.asl#ownsLive?" :text "true when an owned path, or for a non-glob path the directory it would be created in, exists under root; a glob needs the directory before its first star")
(:doc :symbol "asl/tools/coord/planImport.asl#staleOwns" :text "one (:staleOwns :id ID :paths (...)) warning line per ledger row whose :owns names a path absent from the tree under root")
(:doc :symbol "asl/tools/coord/planImport.asl#report" :text "renders a Report as one (:import ...) row")
(:doc :symbol "asl/tools/coord/planImport.asl#main" :text "import --ledger FILE --store DIR [--base REF] [--dry]: prints the import report; usage and exit 2 on other input, exit 1 on read or import error")
(:doc :symbol "asl/tools/coord/quality.asl#Cell" :text "pass count and total of one alias at one place")
(:doc :symbol "asl/tools/coord/quality.asl#Lie" :text "one recorded false green claim of an alias at a place")
(:doc :symbol "asl/tools/coord/quality.asl#Ranked" :text "ranked alias at a place with quality in permille, total and a rank class")
(:doc :symbol "asl/tools/coord/quality.asl#qualityOf" :text "permille pass rate minus 50 per lie, floored at 0, and 0 when total is not positive")
(:doc :symbol "asl/tools/coord/quality.asl#spreadPermille" :text "permille tolerance of the pass spread over the total, 1000 when total is not positive")
(:doc :symbol "asl/tools/coord/quality.asl#rankPlace" :text "ranks the aliases of one place by quality descending, grouping into classes of those within the spread of the class top")
(:doc :symbol "asl/tools/coord/requests.asl#Unit" :text "requesting unit state: id, root, owns, external flag, requests and escalations left, gates run, wall budget, time granted and write persisted flags")
(:doc :symbol "asl/tools/coord/requests.asl#Lease" :text "a path leased to a unit")
(:doc :symbol "asl/tools/coord/requests.asl#Pace" :text "pace fact: whether the next lane has allowance")
(:doc :symbol "asl/tools/coord/requests.asl#Request" :text "writer request: reqEscalate, reqNeedCtx, reqNeedOwns, reqNeedTime or reqSplit")
(:doc :symbol "asl/tools/coord/requests.asl#Decision" :text "outcome of a request: granted flag, op, why, heldBy, journal row and the updated Unit")
(:doc :symbol "asl/tools/coord/requests.asl#reqEscalate" :text "request to escalate with a reason, what was seen and what was tried")
(:doc :symbol "asl/tools/coord/requests.asl#reqNeedCtx" :text "request for a bounded slice of a path by symbol")
(:doc :symbol "asl/tools/coord/requests.asl#reqNeedOwns" :text "request to widen the lease to a path")
(:doc :symbol "asl/tools/coord/requests.asl#reqNeedTime" :text "request to raise the wall budget by sec seconds")
(:doc :symbol "asl/tools/coord/requests.asl#reqSplit" :text "request to split work into unit rows for the plan queue with a reason")
(:doc :symbol "asl/tools/coord/requests.asl#decide" :text "pure decision of a request: refused when no requests are left, else escalate, context, owns, time or split rules apply, every decision charging one request")
(:doc :symbol "asl/tools/coord/requests.asl#opName" :text "name of a request: escalate, needCtx, needOwns, needTime or split")
(:doc :symbol "asl/tools/coord/requests.asl#journalRow" :text "one (:request :unit :op :granted :why) journal row of a decision, with heldBy in place of why when a lease holds the path")
(:doc :symbol "asl/tools/coord/requests.asl#signature" :text "op, why and holder of a decision joined with bars")
(:doc :symbol "asl/tools/coord/requests.asl#repeatCount" :text "0 for a granted decision, else 1 plus how many earlier signatures in history equal this one")
(:doc :symbol "asl/tools/coord/requests.asl#secretLike?" :text "true when a lowercased path contains a secret needle such as .env, token, .pem or id_rsa")
(:doc :symbol "asl/tools/coord/requests.asl#underRoot?" :text "true for a relative path without .. segments or an absolute path inside root, false for empty paths")
(:doc :symbol "asl/tools/coord/requests.asl#covers?" :text "true when a lease path equals the path or is its directory prefix")
(:doc :symbol "asl/tools/coord/reviewStage.asl#LaneRow" :text "lane table row: alias, tier, quality and default allowance")
(:doc :symbol "asl/tools/coord/reviewStage.asl#RevOut" :text "review stage output: ruling action, models, tokens, costMicro, signature and ladder rows")
(:doc :symbol "asl/tools/coord/reviewStage.asl#tableFor" :text "ladder family table with the lane file :familyExtra rows added")
(:doc :symbol "asl/tools/coord/reviewStage.asl#modelRows" :text "alias and provider pair of every model row of a gateway config text")
(:doc :symbol "asl/tools/coord/reviewStage.asl#costRows" :text "alias to micro-dollar price per call of every gateway model row, -1 when unpriced and 0 for free-tier aliases")
(:doc :symbol "asl/tools/coord/reviewStage.asl#usageCost" :text "sum of :costMicros over the usage rows, -1 as soon as one call was unpriced")
(:doc :symbol "asl/tools/coord/reviewStage.asl#laneTable" :text "the :lanes rows of a lane file text")
(:doc :symbol "asl/tools/coord/reviewStage.asl#laneRowsOf" :text "LaneRows parsed from a lane file text")
(:doc :symbol "asl/tools/coord/reviewStage.asl#unknownOf" :text "aliases listed under :unknown in a lane file text")
(:doc :symbol "asl/tools/coord/reviewStage.asl#paceAllowance" :text "calls allowed by a subscription pace: the default when unknown, 0 past hard limit or expired, 1 over soft limit, else 5 times the factor and at least 1")
(:doc :symbol "asl/tools/coord/reviewStage.asl#lanesFor" :text "ladder Lanes built from the lane table with subscription-paced allowances")
(:doc :symbol "asl/tools/coord/reviewStage.asl#startupProblems" :text "startup refusals: family coverage problems, lanes not in the gateway, without family or with a tier other than free, paid or strong, and an empty lane table")
(:doc :symbol "asl/tools/coord/reviewStage.asl#usageSum" :text "sum of the :tokens of the usage rows of a text")
(:doc :symbol "asl/tools/coord/reviewStage.asl#tokenSum" :text "token total of a provider usage record: its total keys, else prompt, completion, input and output keys")
(:doc :symbol "asl/tools/coord/reviewStage.asl#callModelFor!" :text "builds the ladder model call: an in-process provider turn per alias and prompt, appending one usage row per call to the usage path")
(:doc :symbol "asl/tools/coord/reviewStage.asl#reviewUnit!" :text "runs the ladder over the lane table and returns a RevOut with action, models, tokens, cost, signature and rows")
(:doc :symbol "asl/tools/coord/reviewStage.asl#allowanceMap" :text "alias to allowance for every lane row, taken from subscription pace where the alias provider has a subscription")
(:doc :symbol "asl/tools/coord/reviewStage.asl#risingLanes" :text "aliases whose allowance is higher in the after snapshot than in the before one")
(:doc :symbol "asl/tools/coord/risk.asl#RiskInput" :text "facts of a change scored for risk: names, deleted, line count, added lines, closure, gate kind, prior signatures, mutant history and public surface")
(:doc :symbol "asl/tools/coord/risk.asl#Signal" :text "one named risk signal with its weight")
(:doc :symbol "asl/tools/coord/risk.asl#Risk" :text "risk assessment: score, tier and the signals that fired")
(:doc :symbol "asl/tools/coord/risk.asl#packageOf" :text "package name of a path from its asl/host, asl/packages or asl/tools segment (asl/agentLoop/ is agentLoop), else its first segment")
(:doc :symbol "asl/tools/coord/risk.asl#signalsOf" :text "the weighted signals of an input: closure 3, hot package 2, spread 1, deletes 2, spawn or fs 3, gate kind, prior sigs 1, mutant 1 and public surface 1")
(:doc :symbol "asl/tools/coord/risk.asl#tierOf" :text "tier of a score: high from 5, med from 2, else low")
(:doc :symbol "asl/tools/coord/risk.asl#assess" :text "scores an input as the sum of its signal weights and returns the Risk with its tier")
(:doc :symbol "asl/tools/coord/store.asl#q" :text "quotes a string as an ASN string with backslash, quote and newline escaped")
(:doc :symbol "asl/tools/coord/store.asl#qList" :text "renders strings as a parenthesised list of quoted strings")
(:doc :symbol "asl/tools/coord/store.asl#rowFields" :text "parses a row and returns its fields when its tag matches, else an error")
(:doc :symbol "asl/tools/coord/store.asl#textField" :text "text value of a row field, empty when absent")
(:doc :symbol "asl/tools/coord/store.asl#intField" :text "integer value of a row field, 0 when absent")
(:doc :symbol "asl/tools/coord/store.asl#opt" :text "value after --key in the args, else the fallback")
(:doc :symbol "asl/tools/coord/store.asl#intOpt" :text "integer value after --key in the args, else the fallback")
(:doc :symbol "asl/tools/coord/tests/conductorStage.asl#main" :text "fixture stage child of conductorTest: logs its start, sleeps or dies as the argv says, then writes a fake or real gates Res row for the unit")
(:doc :symbol "asl/tools/coord/tests/conductorTest.asl#runTests" :text "pins the conductor over fixture stage children: dag order, owns serialisation, admission, signature escalation, wake, untrusted green claims, timeouts, kills, resume, spend, strong offers and merge retry")
(:doc :symbol "asl/tools/coord/tests/conductorWireTest.asl#runTests" :text "pins the conductor wiring with fakes: branch attach and prune, remote dropping, spend and cost, merge env, signature keys, allowances, refresh wake, ladder wiring, service unit and coverage")
(:doc :symbol "asl/tools/coord/tests/e2eSmokeTest.asl#runTests" :text "end to end smoke of one doc unit through write, gates, review and merge on a scratch dev clone; runs only when ASL_E2E is 1 and otherwise passes as skipped")
(:doc :symbol "asl/tools/coord/tests/egressTest.asl#runTests" :text "pins egress filtering: secret shapes, env value leaks, scrubbing of lines and text, and allowed or refused paths")
(:doc :symbol "asl/tools/coord/tests/ladderTest.asl#runTests" :text "pins the review ladder: family resolution, lane selection and ranking, verdict parsing, merge, split, abstain, fix cap, risk, await, blocked, brief, token and coverage rules")
(:doc :symbol "asl/tools/coord/tests/planImportTest.asl#runTests" :text "pins plan import on a fixture ledger: dry run writes nothing, only complete resolvable rows become tasks, others are parked with their need, a second import is idempotent, and a row that gains owns imports")
(:doc :symbol "asl/tools/coord/tests/qualityTest.asl#runTests" :text "pins quality scoring, rank classes by spread, and the lie penalty")
(:doc :symbol "asl/tools/coord/tests/requestsTest.asl#runTests" :text "pins request decisions: escalate, context, owns, time and split rules, the request bound, and determinism with repeat counts")
(:doc :symbol "asl/tools/coord/tests/riskTest.asl#runTests" :text "pins the risk base case, each signal weight and the tier thresholds")
(:doc :symbol "asl/tools/coord/tests/triggersTest.asl#runTests" :text "pins the trigger table: quiet input, result rows, signatures, ladder, risk and pace triggers, lease, stale and wait triggers, and infra suppression")
(:doc :symbol "asl/tools/coord/triggers.asl#TrigIn" :text "flat trigger input record mirroring unit, result, pace, journal, ladder and base facts")
(:doc :symbol "asl/tools/coord/triggers.asl#blankTrigIn" :text "a TrigIn with quiet defaults that fires no trigger")
(:doc :symbol "asl/tools/coord/triggers.asl#fired" :text "ids of the triggers fired by an input, same as triggerIds")
(:doc :symbol "asl/tools/coord/triggers.asl#decide" :text "id and action of the highest-priority fired trigger as id then action, empty when none fires")
(:doc :symbol "asl/tools/coord/triggers.asl#actionOf" :text "action text for a trigger id given the input, empty for an unknown id")
(:doc :symbol "asl/tools/coord/triggers.asl#triggerIds" :text "fired trigger ids in priority order; an infra class keeps only infra, lease, pace, stale, wait and claude triggers")
(:doc :symbol "asl/tools/coord/worktree.asl#Act" :text "planned action on a worktree: the Wt, its age in seconds and its verdict")
(:doc :symbol "asl/tools/coord/worktree.asl#protectedUnit?" :text "true for main, train, units ending -train and units starting dev- or vtbot-")
(:doc :symbol "asl/tools/coord/worktree.asl#ageSec!" :text "seconds since the newer of the HEAD and index files of the worktree git dir changed, 0 when unknown")
(:doc :symbol "asl/tools/coord/worktree.asl#gcWt!" :text "reports merged, dirty-merged and unmerged worktrees and, with apply, removes the merged ones and prunes; returns a (:wtGc ...) row")
(:doc :symbol "asl/tools/coord/worktree.asl#auditWt!" :text "finds merged worktrees older than olderSec and returns exit 1 or 0 with a (:wtAudit ...) row")
(:doc :symbol "asl/tools/coord/worktree.asl#main" :text "gc [--apply] or audit [--older SEC] with --keep and --only lists; other verbs print an error row and exit 2")
(:doc :symbol "asl/tools/obs/archive.asl#octalText" :text "octal digits of a non-negative integer")
