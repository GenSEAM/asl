(:doc :symbol "asl/tools/coord/store.asl#" :text "Row-keyed unit queue with fenced leases in one store dir: unit rows, lease rows, a flock and tmp+rename writes.")
(:doc :symbol "asl/tools/coord/store.asl#Lease" :text "a granted hold on one unit")
(:doc :symbol "asl/tools/coord/store.asl#defaultDir!" :text "~/.asl/run/coord")
(:doc :symbol "asl/tools/coord/store.asl#parseLease" :text "lease from ASN text")
(:doc :symbol "asl/tools/coord/store.asl#live?" :text "lease beat within its ttl at now")
(:doc :symbol "asl/tools/coord/nodes.asl#Node" :text "one machine row")
(:doc :symbol "asl/tools/coord/nodes.asl#nodesPath" :text "default ~/.asl/nodes.asn")
(:doc :symbol "asl/tools/coord/nodes.asl#readNodes!" :text "rows of a nodes file, empty when absent, error on the first bad row")
(:doc :symbol "asl/tools/coord/nodes.asl#renderNodes" :text "all rows, one per line")
(:doc :symbol "asl/tools/coord/nodes.asl#upsertNode!" :text "replace the row with the same id or append")
(:doc :symbol "asl/tools/coord/nodes.asl#probeCores!" :text "logical cores of this machine")
(:doc :symbol "asl/tools/coord/nodes.asl#probeOs!" :text "darwin or linux")
(:doc :symbol "asl/tools/coord/nodes.asl#probeArch!" :text "uname -m")
(:doc :symbol "asl/tools/coord/nodes.asl#probeRamGb!" :text "RAM in whole GiB")
(:doc :symbol "asl/tools/coord/nodes.asl#probeDiskFreeGb!" :text "free GiB on /")
(:doc :symbol "asl/tools/coord/nodes.asl#probeClang!" :text "first line of clang --version")
(:doc :symbol "asl/tools/coord/nodes.asl#findNode" :text "the node row with the given id as some, else none")
(:doc :symbol "asl/tools/coord/sched.asl#defaultCfg" :text "the adopted defaults: min 4, max 64, step 2, start 16, gainShare 0.05, flatWindows 3, softShare 0.30, minFreeMB 3000, windowSec 600")
(:doc :symbol "asl/tools/coverageRatchet.asl#verdict!" :text "the Verdict for a root and baseline path: counts the packages, lists every package below its baseline row, and reports a missing baseline as a violation")
(:doc :symbol "asl/tools/coord/commitGuard.asl#Hit" :text "schema of one finding: rule, path, why and block flag")
(:doc :symbol "asl/tools/coord/commitGuard.asl#Receipt" :text "schema of the guard result: code, status, rows as a list of Hit and text")
(:doc :symbol "asl/tools/coord/leadStream.asl#emitAt!" :text "runDir nowMs src sev kind key unit why: appends one event to the lead stream under runDir for this node and returns true on success")
(:doc :symbol "asl/tools/coord/sched.asl#Disk" :text "schema of disk state: usedPct and freeMb")
(:doc :symbol "asl/tools/coord/sched.asl#diskLevel" :text "d cfg: the disk level as stop when usage reaches the stop percentage or free space is below the minimum, low at the low percentage, else ok")
(:doc :symbol "asl/tools/vcs/git.asl#applyPatch!" :text "repo patch reverse: applies patch to repo with git apply, reversed when reverse is set, and returns the git output")
(:doc :symbol "asl/tools/vcs/git.asl#applyPatchChecked!" :text "repo patch reverse quiet: applies a patch with git apply and returns the output, or an error for a non-exit verdict")
(:doc :symbol "asl/tools/vcs/git.asl#diff!" :text "repo base headRef paths: the diff between the resolved base and headRef, limited to paths, with an error exit when a ref does not resolve")
(:doc :symbol "asl/tools/vcs/git.asl#Out" :text "schema of a git outcome: exit and out")
(:doc :symbol "asl/tools/vcs/git.asl#worktreeAdd!" :text "repo path sha: adds a worktree at path at commit sha of repo, refused for an unsafe path or unresolved sha")
(:doc :symbol "asl/tools/vcs/vcs.asl#applyPatch!" :text "repo patch reverse: runs the git apply patch step and returns its vcs receipt")
(:doc :symbol "asl/tools/vcs/vcs.asl#commit!" :text "repo aslRoot paths msg mode: commits the paths with msg in mode and returns the vcs receipt, via commitWith! with no tool root")
(:doc :symbol "asl/tools/vcs/vcs.asl#commitWith!" :text "repo aslRoot toolRoot paths msg mode: refuses an empty path list, else commits the paths with msg and mode and returns the vcs receipt")
(:doc :symbol "asl/tools/vcs/vcs.asl#restore!" :text "repo rev paths: restores paths to rev and returns the vcs receipt")
(:doc :symbol "asl/tools/vcs/vcs.asl#stage!" :text "repo paths: stages paths and returns the vcs receipt, refused when no paths are named or a path is bad")
(:doc :symbol "asl/tools/vcs/vcs.asl#VcsReceipt" :text "schema of a vcs receipt: code and text")
(:doc :symbol "asl/tools/vcs/vcs.asl#worktreeAdd!" :text "repo path sha: adds a worktree at path for sha and returns the vcs receipt")
(:doc :symbol "asl/tools/vcs/vcs.asl#worktreeRemove!" :text "repo path: removes the worktree at path and returns the vcs receipt")
(:doc :symbol "asl/tools/fleet/model.asl#parseForms" :text "parse source text into its top-level forms, or the reader error")
(:doc :symbol "asl/tools/fleet/model.asl#itemsOf" :text "the child forms of a list form, empty for an atom")
(:doc :symbol "asl/tools/fleet/model.asl#kvGet" :text "the form following the keyword key in a list of items, none when the key is absent")
(:doc :symbol "asl/tools/fleet/model.asl#unquote" :text "strip one pair of surrounding double quotes from a value")
(:doc :symbol "asl/tools/fleet/model.asl#atomsOf" :text "the atom texts of the children of a list form")
(:doc :symbol "asl/tools/fleet/model.asl#textOf" :text "the unquoted text of an atom or string form")
(:doc :symbol "asl/tools/fleet/model.asl#intOf" :text "an optional form read as an Int64, none when absent or not a number")
(:doc :symbol "asl/tools/fleet/model.asl#asnQuote" :text "a string as an ASN double-quoted literal with quotes and backslashes escaped")
(:doc :symbol "asl/tools/fleet/model.asl#asnStrings" :text "a list of strings as a parenthesised list of ASN quoted literals")
(:doc :symbol "asl/tools/fleet/model.asl#makeEmpty" :text "an empty list form, the neutral value for missing lookups")
(:doc :symbol "asl/tools/coord/janitor.asl#tick!" :text "Deletes nothing unless ~/.asl/conductor/janitor.asn holds :mode apply, and then only the paths of the plan it wrote to runDir/janitor.asn.")
(:doc :symbol "asl/tools/coord/mergeCheck.asl#" :text "Blocks only on what the change introduces: the caller passes --base as the merge-base so a unit behind main does not block, and pre-existing reds become plan rows.")
(:doc :symbol "asl/tools/nativeTest.asl#maxWallS" :text "upper bound of a suite wall in seconds: 7200")
(:doc :symbol "asl/tools/nativeTest.asl#mutantSlot!" :text "a fresh ephemeral slot directory in the native cache store for one mutant build, which the caller removes after the run")
(:doc :symbol "asl/tools/nativeTest.asl#prepareTestSelected" :text "builds, through the test slot cache, the test binary of a suite whose :x export list also names the selected function")
(:doc :symbol "asl/tools/nativeTest.asl#selectionSource" :text "Puts the function at the head of the :x list because a selected run may call only exported names; a file without :x is an error.")
(:doc :symbol "asl/tools/nativeTest.asl#withoutPeakLines" :text "the text with the runner's peak-RSS marker lines removed, keeping any text before the marker on the same line and the trailing newline")
(:doc :symbol "asl/tools/nativeTest.asl#withoutRunnerSwitches" :text "the environment rows without ASL_ASSERT_KEEP_GOING and ASL_NATIVE_TEST_STATS, the switches only the runner sets")
(:doc :symbol "asl/tools/nativeTest.asl#prepareAll" :text "All paths share one toolchain fingerprint so their objects land in one cache.")
(:doc :symbol "asl/tools/nativeTest.asl#takeLock!" :text "Breaks a lock whose holder died or whose unparsable file went stale and retries, so a crashed runner never blocks the next one.")
(:doc :symbol "asl/tools/nativeTest.asl#runWatched" :text "Runs under the fleet lease with its own wall (3600 s when none is given) and an optional ps-sampled RSS cap, killing the whole tree at a limit.")
