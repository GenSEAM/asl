(module aslCrawlerTests/cliTest
  :x [runTests]
  :i [])

fn ! runTests -> Bool
  (let [(host (optionOr (envGet "ASL_HOST") "asl/host/out/asl-host"))
        (tick (stringFromInt64 (monotonicNs)))
        (dir (str "/tmp/aslCrawlerCli_" tick))
        (made (dirCreate dir))
        (fixture (str dir "/response.html"))
        (crawlUrl "https://example.test/crawler-fixture")
        (tiktokUrl "https://www.tiktok.com/@creator/video/9876543210")
        (exportPath (str dir "/bundle.js"))
        (scriptPath (str dir "/action.asn"))
        (shellPath (str dir "/unsafe.sh"))
        (shellMarker (str dir "/shell-ran"))
        (curlPath (str dir "/curl"))
        (requestLog (str dir "/requests.log"))
        (dirnamePath (str dir "/dirname"))
        (curlBody (str "<!doctype html><html><head><title>Recorded crawler fixture</title></head>"
                       "<body><main>Fixture page</main>"
                       "<script id=\"SIGI_STATE\" type=\"application/json\">"
                       "{\"ItemModule\":{\"9876543210\":{\"id\":\"9876543210\","
                       "\"desc\":\"Recorded caption\",\"author\":{\"uniqueId\":\"creator\"},"
                       "\"stats\":{\"diggCount\":\"321\",\"commentCount\":\"17\"},"
                       "\"music\":{\"title\":\"Recorded sound\"}}}}</script></body></html>"))
        (_ (fileWrite fixture curlBody))
        (gatewayReceipt "(:browserActionReceipt :id \"act-exec-001\" :status :ok :op \"navigate\" :duration 45 :url \"https://example.test\" :artifact \"artifacts/snapshot.asn\" :snapshot \"(:pageSnapshot :status :ok)\" :text \"Browser action navigate executed successfully\")\n")
        (failedGatewayReceipt "(:browserActionReceipt :id \"act-fail-001\" :status :failed :error \"target unavailable\")\n")
        (curlScript (str "#!/bin/sh\ncase \" $* \" in *\"/api/asl/browser/status\"*) printf '%s\\n' \"$*\" >> \"$CRAWL_REQUEST_LOG\"; printf '%s\\n' \"$CRAWL_STATUS_FIXTURE\" ;; *\" -X POST \"*) printf '%s\\n' \"$*\" >> \"$CRAWL_REQUEST_LOG\"; [ -z \"${CRAWL_GATEWAY_EXIT:-}\" ] || { echo gatewayDown >&2; exit \"$CRAWL_GATEWAY_EXIT\"; }; printf '%s\\n' \"$CRAWL_GATEWAY_FIXTURE\" ;; *) exec /bin/cat \"$CRAWL_FIXTURE\" ;; esac\n"))
        (_ (fileWrite curlPath curlScript))
        (_ (fileChmod curlPath 493))
        (dirnameScript (str "#!/bin/sh\ncase \"$1\" in */*) printf '%s\\n' \"${1%/*}\" ;; *) printf '.\\n' ;; esac\n"))
        (_ (fileWrite dirnamePath dirnameScript))
        (_ (fileChmod dirnamePath 493))
        (_ (fileWrite scriptPath "(:automationAction :op :navigate :target \"https://example.test\")\n"))
        (_ (fileWrite shellPath (str "#!/bin/sh\ntouch " shellMarker "\n")))
        (_ (fileChmod shellPath 493))
        (root (optionOr (envGet "PWD") "."))
        (envPrefix (str "ASL_HOST=" host " PATH=" dir " CRAWL_ROOT=" root " CRAWL_FIXTURE=" fixture " CRAWL_REQUEST_LOG=" requestLog " CRAWL_GATEWAY_FIXTURE='" gatewayReceipt "' "))
        (noSnapshotEnv (stringReplace envPrefix gatewayReceipt "(:browserActionReceipt :status :ok)\n"))
        (activeGatewayEnv (str envPrefix "CRAWL_STATUS_FIXTURE='extension-primary' "))
        (crawl (processRun (str envPrefix "./bin/asl-crawler crawl " crawlUrl " --mode staticHttp --distill asn")))
        (tiktok (processRun (str envPrefix "./bin/asl-crawler tiktok " tiktokUrl " --extract")))
        (automate (processRun (str envPrefix "./bin/asl-crawler automate " scriptPath)))
        (failedEnvPrefix (stringReplace envPrefix gatewayReceipt failedGatewayReceipt))
        (gatewayFailed (processRun (str failedEnvPrefix "./bin/asl-crawler automate " scriptPath)))
        (automateShell (processRun (str envPrefix "./bin/asl-crawler automate " shellPath)))
        (shellExecuted (fileExists? shellMarker))
        (tiktokWatch (processRun (str envPrefix "./bin/asl-crawler tiktok " tiktokUrl " --watch 6")))
        (extensionCrawl (processRun (str envPrefix "./bin/asl-crawler crawl " crawlUrl " --mode extension")))
        (fallbackExtension (processRun (str noSnapshotEnv "./bin/asl-crawler crawl " crawlUrl " --mode extension")))
        (autoExtension (processRun (str activeGatewayEnv "./bin/asl-crawler crawl " crawlUrl " --mode auto")))
        (browserCrawl (processRun (str envPrefix "./bin/asl-crawler crawl " crawlUrl " --browser chrome")))
        (offlineExtension (processRun (str "CRAWL_GATEWAY_EXIT=7 " envPrefix "./bin/asl-crawler crawl " crawlUrl " --mode extension")))
        (failedExtension (processRun (str failedEnvPrefix "./bin/asl-crawler crawl " crawlUrl " --mode extension")))
        (failedWordReceipt "(:browserActionReceipt :id \"act-word-001\" :status :ok :snapshot \"(:pageSnapshot :status :ok)\" :text \"failed login page was captured\")\n")
        (failedWordEnv (stringReplace envPrefix gatewayReceipt failedWordReceipt))
        (failedWordCrawl (processRun (str failedWordEnv "./bin/asl-crawler crawl " crawlUrl " --mode extension")))
        (failedWordAutomate (processRun (str failedWordEnv "./bin/asl-crawler automate " scriptPath)))
        (agentStatus (processRun (str envPrefix "./bin/asl-crawler agent --status")))
        (agentExport (processRun (str envPrefix "./bin/asl-crawler agent --export " exportPath " --max-nodes 7 --no-stealth --no-kinetics")))
        (exportedOk (fileExists? exportPath))
        (status (processRun (str envPrefix "./bin/asl-crawler status")))
        (session (processRun (str envPrefix "./bin/asl-crawler session tiktok")))
        (requests (resultOr (fileReadString requestLog) ""))
        (cleaned (processRun (str "/bin/rm -rf " dir)))]
    (do
      (assert (= crawl.exitCode 0) "crawl launcher exits successfully without Python")
      (assert (stringContains? crawl.stdout "(:pageSnapshot") "crawl launcher prints an ASN page receipt")
      (assert (stringContains? crawl.stdout "Recorded crawler fixture") "crawl launcher consumes the recorded fixture")
      (assert (= tiktok.exitCode 0) "tiktok launcher exits successfully without Python")
      (assert (stringContains? tiktok.stdout "(:mediaMetadataReceipt") "tiktok launcher prints an ASN metadata receipt")
      (assert (stringContains? tiktok.stdout "Recorded caption") "tiktok launcher extracts fixture metadata")
      (assert (= automate.exitCode 0) "automate dispatch exits successfully after gateway receipt")
      (assert (stringContains? automate.stdout "(:browserActionReceipt") "automate returns the gateway action receipt")
      (assert (stringContains? automate.stdout "artifacts/snapshot.asn") "automate returns the recorded gateway artifact field")
      (assert (stringContains? automate.stdout "Browser action navigate executed successfully") "automate preserves the recorded gateway result text")
      (assert (!= gatewayFailed.exitCode 0) "a :failed gateway receipt returns a non-zero exit")
      (assert (stringContains? gatewayFailed.stdout ":status :failed") "failed gateway receipt remains visible")
      (assert (= automateShell.exitCode 0) "shell-looking automation input is sent to the gateway as data")
      (assert (not shellExecuted) "automation never executes a supplied shell script")
      (assert (stringContains? requests "-X POST") "automation uses HTTP POST for the gateway action")
      (assert (stringContains? requests ":navigate") "automate sends the actual script to the gateway transport")
      (assert (stringContains? requests "https://example.test") "automate preserves the script target in its gateway request")
      (assert (= tiktokWatch.exitCode 0) "tiktok watch dispatch exits successfully")
      (assert (stringContains? tiktokWatch.stdout "(:browserActionReceipt") "tiktok watch returns the gateway receipt")
      (assert (stringContains? requests "watchMedia") "tiktok watch dispatches a watchMedia action")
      (assert (stringContains? requests ":duration 6") "tiktok watch preserves its requested duration")
      (assert (= extensionCrawl.exitCode 0) "extension crawl uses gateway dispatch")
      (assert (stringContains? extensionCrawl.stdout "(:browserActionReceipt") "extension crawl returns gateway receipt")
      (assert (stringContains? fallbackExtension.stdout "(:pageSnapshot") "extension response without a snapshot falls back to static HTTP")
      (assert (stringContains? autoExtension.stdout "(:browserActionReceipt") "auto mode dispatches through an active browser extension")
      (assert (stringContains? requests "/api/asl/browser/status") "auto mode probes extension readiness before choosing a fetcher")
      (assert (= browserCrawl.exitCode 0) "browser-family crawl uses gateway dispatch")
      (assert (stringContains? requests "?browser=chrome") "browser-family selector reaches the gateway URL")
      (assert (= offlineExtension.exitCode 0) "extension dispatch that errors falls back to static HTTP")
      (assert (stringContains? offlineExtension.stdout "(:pageSnapshot") "offline extension fallback returns a static page snapshot")
      (assert (stringContains? requests "/api/asl/browser/exec") "offline extension fallback first attempted the gateway")
      (assert (= failedExtension.exitCode 0) "extension failed receipt falls back to static HTTP")
      (assert (stringContains? failedExtension.stdout "(:pageSnapshot") "extension failed receipt fallback returns a static page snapshot")
      (assert (= failedWordCrawl.exitCode 0) "a snapshot receipt whose text contains the word failed is a success")
      (assert (stringContains? failedWordCrawl.stdout "act-word-001") "a snapshot receipt whose text contains the word failed is printed unchanged")
      (assert (= failedWordAutomate.exitCode 0) "an ok automation receipt whose text contains the word failed exits 0")
      (assert (= agentStatus.exitCode 0) "agent status launcher exits successfully")
      (assert (stringContains? agentStatus.stdout "(:inBrowserAgent") "agent status launcher prints ASN")
      (assert (= agentExport.exitCode 0) "agent export launcher exits successfully")
      (assert (stringContains? agentExport.stdout "(:agentBundle :exported") "agent export launcher prints ASN")
      (assert exportedOk "agent export launcher writes the requested bundle")
      (assert (= status.exitCode 0) "status launcher exits successfully")
      (assert (stringContains? status.stdout "(:crawlerStatus") "status launcher prints ASN")
      (assert (stringContains? status.stdout ":extensionActive :unverified") "status reports extension activation as unverified")
      (assert (stringContains? status.stdout ":localStealthBrowser") "status reports the detected browser path field")
      (assert (stringContains? status.stdout ":inBrowserAgentReady :unknown") "status reports agent readiness as unknown, not a hard-coded success")
      (assert (stringContains? status.stdout ":supportedModes [:patchright :staticHttp :cloudProxy :auto :extension]") "status lists the gateway-backed extension mode")
      (assert (= session.exitCode 1) "session launcher reports unverified session status")
      (assert (stringContains? session.stdout "(:sessionInfo") "session launcher prints ASN")
      true))
