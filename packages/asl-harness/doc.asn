(:doc :symbol "asl/packages/asl-harness/src/launch.asl#parseHarness" :text "load_harness: layers, attractors and modes")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#parseClients" :text "load_clients: fields per client id")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#clientField" :text "client_field: string fields only")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#migrateOn" :text "re.search(r':migrate\\s+true\\b')")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#hostPaths" :text "asl-host is off PATH outside the repo")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#fillText" :text "re.sub(r'\\{(\\w+)\\}') over the fill table")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#render" :text "launch.render: the prompt for one client")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#pathJoin" :text "posixpath.join of two parts")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#absPath" :text "os.path.abspath against a given cwd")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#jsonStr" :text "json.dumps of a string, ensure_ascii")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#buildArgv" :text "launch.build_argv per client and flags")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#writePrompt!" :text "launch.write_prompt; extra dir empty for claude and codex")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#parseArgs" :text "main's option checks before any launch")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#runPlan" :text "main after parsing: render, write, argv")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#mainWith!" :text "launch.main with gathered context")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#posixExitCode" :text "procWaitPid (HB5, out of this unit's owns) reports a signal-killed child as -signal, distinguishable from a genuine 0..255 exit; every reap caller here treats its result as a POSIX shell-style exit code, so a signal death is renormalized to the conventional 128+signal (e.g. 143 for SIGTERM) matching the retired launcher originally recorded behavior")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#abandon" :text "a failed pump must not leave the child")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#runCapture!" :text "argv child captured; a missing tool errs")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#runChild!" :text "agy exits 0 on a run without output")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#whichIn!" :text "shutil.which over a PATH value")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#probe!" :text "workspace facts read from git and files")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#platform!" :text "platform.system release machine")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#today!" :text "datetime.date.today in local time")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#pruneRunDirs!" :text "a dead launch leaves its prompt dir")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#finish" :text "a closed stdout fails the launch")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#main" :text "asl launch entry; ASL_ROOT names the repo")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#mainIn!" :text "mainIn! takes the repository root as an argument, for a caller (the native asl binary) that cannot export ASL_ROOT into its own environment")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#promptBoundary" :text "the line claude reads as the end of the static system prompt; render puts it before the layers marked :volatile")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#vendorFills" :text "fills {agyWorkerWait} and {codexOutputCut} from the :workerWait and :outputCut fields of clients.asn")
(:doc :symbol "asl/packages/asl-harness/tests/collectTest.asl#" :text "Replays synthetic claude, codex and agy transcripts under tests/fixtures/collect/home through asl-harness/collect: scans, run selection and the run.asn receipt")
(:doc :symbol "asl/packages/asl-harness/src/collect.asl#" :text "Session collector: finds the transcript one asl launch run produced in the client's own store and writes the counts-only (:launchRun ...) receipt to <runDir>/run.asn; claude and codex input counts are uncached input, agy input is its input_tokens; the stores are claude projects/<cwd slug>/*.jsonl, codex sessions/Y/M/D/rollout-*.jsonl (session_meta cwd), agy brain/<id>/.system_generated/logs/transcript.jsonl (no cwd, window only)")
(:doc :symbol "asl/packages/asl-harness/src/collect.asl#Scan" :text "counts of one transcript: turns, tokIn (uncached input), tokOut, tokCached, tools and errors by name")
(:doc :symbol "asl/packages/asl-harness/src/collect.asl#scanClaude" :text "claude jsonl: turns = distinct assistant message ids, usage kept per id (last record wins), in = input + cache creation, tool_use by name, is_error tool_results and isApiErrorMessage as errors")
(:doc :symbol "asl/packages/asl-harness/src/collect.asl#scanCodex" :text "codex rollout jsonl: turns = token_usage_record lines (token_count lines if none), tokens from the last token_count total (input minus cached), function_call and custom_tool_call by name, error events")
(:doc :symbol "asl/packages/asl-harness/src/collect.asl#scanAgy" :text "agy transcript.jsonl: PLANNER_RESPONSE steps are turns and carry input, cache_read and output tokens and tool_calls; a status other than DONE counts as step<STATUS>")
(:doc :symbol "asl/packages/asl-harness/src/collect.asl#isoEpoch" :text "UTC epoch seconds of a YYYY-MM-DDTHH:MM:SS prefix, 0 when malformed")
(:doc :symbol "asl/packages/asl-harness/src/collect.asl#epochDays" :text "UTC date of epoch seconds as YYYY/MM/DD, the codex sessions subdirectory")
(:doc :symbol "asl/packages/asl-harness/src/collect.asl#slugOf" :text "claude project directory name of a cwd: every non-alphanumeric character becomes a dash")
(:doc :symbol "asl/packages/asl-harness/src/collect.asl#receiptText" :text "the (:launchRun ...) receipt line for a matched transcript; counts and paths only, no message text")
(:doc :symbol "asl/packages/asl-harness/src/collect.asl#pickTranscript!" :text "the single transcript of a client written since startedAt whose first event is not earlier than startedAt - 5s; err with the reason when none or several match")
(:doc :symbol "asl/packages/asl-harness/src/collect.asl#collect!" :text "pick, scan and write <runDir>/run.asn, returns its path; no or ambiguous transcript writes (:transcript :none :why ...)")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#renderAsn" :text "--format asn: the harness5.asn layers selected by the same facts as render, printed one (:layer ...) form per line; literal ids inlined as strings, explicit (:fill X) forms and bare fill names in argument position 2 or later of a statement carry their value; the glossary of referenced terms follows the static layers, the claude boundary line and the volatile layers come last")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#glossaryOf" :text "(:glossary (:term ...)) holding the allow-listed terms (glossaryKeep, at most 12) that the rendered layers reference directly, in terms.asn order, once each; every other term is a plain name in the layers, defined in terms.asn")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#renderAsnFor" :text "reads asl/grammar/harness5.asn and terms.asn and renders them for one client; aslMore is the space-joined names of the tools.asn ops that have a :brief")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#formatPick" :text "--format prose|asn is a launch option removed from the client argv; prose is the default")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#workerAsn" :text "agy worker prompt in ASN: the render without the delegate and agyOnce layers plus the workerReport layer")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#stepIn" :text "relays the launcher's stdin to the child's stdin pipe; end of input or a failed write closes the pipe")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#runCollected!" :text "one-shot runs (-p, --print, codex exec) run as a child so the launcher outlives them: wait, propagate the exit code, then collect! the receipt with the sha256 of the rendered prompt; a collect error is one stderr line. Interactive sessions still exec, since procSpawnv gives the child pipes, not the tty")
(:doc :symbol "asl/packages/asl-harness/tests/launchTest.asl#checkAsn" :text "ASN render: balanced one form per line, every symbol resolves to a terms id or schema key (seeded unknown red), plaintext share under 0.10, byte-stable prefix (layer order mutant red), glossary and fill checks")
(:doc :symbol "asl/packages/asl-harness/tests/launchTest.asl#checkAsnCli" :text "--format asn through the launcher with stub clients: print-prompt, default prose unchanged, bogus format, one-shot tails of claude codex and agy untouched, agy worker prompt")
(:doc :symbol "asl/packages/asl-harness/tests/launchTest.asl#checkCollector" :text "one-shot stub runs: run.asn with the prompt digest and exit code, stdin reaches the child, exit propagated, collect failure is soft")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#asnPrint" :text "one Asn value as a single-line ASN form; strings quoted, symbols and numbers as written")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#asnQuote" :text "a string as an ASN string literal, backslash and quote escaped")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#renderAsnText" :text "renderAsn over harness5 and terms texts already read; pure, so tests feed it mutated grammar text")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#writePromptWith!" :text "writePrompt! with an optional override for the agy worker prompt, used by --format asn")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#sweepRuns!" :text "at each launch, before pruning: a run dir whose pid is dead, that has start.asn and no run.asn gets its receipt from collect! with the recorded startedAt, cwd and prompt digest and exit -1 (not observed, since the interactive client was exec'd)")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#keepReceipt?" :text "pruneRunDirs! keeps a dead run dir whose run.asn is under 7 days old, so a swept receipt survives the prune that follows it")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#writeStart!" :text "before exec, (:launchStart :client :startedAt :cwd :promptDigest) into <runDir>/start.asn for the sweep")
(:doc :symbol "asl/packages/asl-harness/tests/launchTest.asl#checkSweep" :text "interactive stub exec leaves start.asn, the next launch writes run.asn for it; live pid and already-collected dirs untouched")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#absentPaths" :text "ids of the harness5 path literals whose file does not exist under the project root; their :from and :lit pairs are dropped from an ASN render so a render outside asex names no asex files")
