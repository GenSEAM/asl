(:doc :symbol "asl/packages/asl-harness/src/launch.asl#" :text "asl launch: render the harness system prompt from asl/grammar/harness.asn, build each client's argv and exec it; port of the retired Python launcher and its asn reader")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#L12" :text "one ASN value, as asn.py reads it")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#isWordB" :text "regex \\w, non-ASCII counted as a letter")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#cpIndex" :text "asn.py reports offsets in characters")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#spaceLen" :text "str.isspace over UTF-8, 0 when not a space")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#digitRun" :text "digits with single underscores between them")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#pyInt" :text "int(tok) in canonical str form")
(:doc :symbol "asl/packages/asl-harness/src/launch.asl#pyFloat" :text "float(tok) in repr form")
