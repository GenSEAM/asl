(module asl-harness/core
  :doc "Pluggable multi-modal agent harness and capability adapter router"
  :export [Capability AgentAction ActionResult route-action execute-step]
  :import [(core/strings :as s)])

(defenum Capability
  (:case code-gen     []                   "Code generation and compiler AST manipulation")
  (:case browser-use  [(headless Bool)]    "Web browser automation and DOM interaction")
  (:case computer-use [(os String)]        "Desktop OS and terminal computer use")
  (:case chat-rag     [(memory-k Int64)]   "Conversational memory and context compression"))

(defenum AgentAction
  (:case eval-code       [(source String) (target String)] "Compile and execute code")
  (:case navigate-page   [(url String)]                    "Browse to target web page")
  (:case os-exec         [(command String)]                "Run local shell command")
  (:case query-memory    [(prompt String)]                 "Vector similarity memory lookup"))

(defschema ActionResult
  (:field success Bool "Execution status")
  (:field latency Float64 "Runtime latency in ms")
  (:field payload String "Serialized result or error output"))

(defun route-action [(cap Capability) (act AgentAction)] -> Bool
  :doc "Validates if capability permits target action"
  (match cap
    ((code-gen)
      (match act
        ((eval-code s t) true)
        ((navigate-page u) false)
        ((os-exec c) false)
        ((query-memory p) false)))
    ((browser-use h)
      (match act
        ((navigate-page u) true)
        ((eval-code s t) false)
        ((os-exec c) false)
        ((query-memory p) false)))
    ((computer-use os)
      (match act
        ((os-exec c) true)
        ((eval-code s t) true)
        ((navigate-page u) false)
        ((query-memory p) false)))
    ((chat-rag k)
      (match act
        ((query-memory p) true)
        ((eval-code s t) false)
        ((navigate-page u) false)
        ((os-exec c) false)))))

(defun execute-step [(action AgentAction)] -> ActionResult
  :doc "Executes an action within the safe isolated sandbox"
  (match action
    ((eval-code src tgt)
      (ActionResult :success true :latency 0.038 :payload (s/concat "Emitted Wasm: " tgt)))
    ((navigate-page url)
      (ActionResult :success true :latency 14.2 :payload (s/concat "Loaded DOM: " url)))
    ((os-exec cmd)
      (ActionResult :success true :latency 2.1 :payload (s/concat "Exit 0: " cmd)))
    ((query-memory p)
      (ActionResult :success true :latency 0.08 :payload (s/concat "Top match: " p)))))
