(module asl-target-sh/tests/astTest
  :x [runTests]
  :i [(asl-target-sh/ast :a ast)])

fn testShAstNodes -> Bool
  (let [(strLit (ast/makeShLitStr "hello world"))
        (intLit (ast/makeShLitInt 42))
        (varRef (ast/makeShVar "user_path"))
        (testNode (ast/makeShTestExpr "-n" varRef strLit))
        (assignStmt (ast/makeShAssign "user_path" strLit true false))
        (callStmt (ast/makeShCall "echo" (list strLit) (list)))
        (ifStmt (ast/makeShIf testNode (list callStmt) (list)))
        (fnDef (ast/makeShFunction "init_env" (list assignStmt ifStmt)))
        (script (ast/makeShScript "#!/bin/sh" (list "Generated by ASL") (list fnDef) (list (ast/makeShCall "init_env" (list) (list)))))]
    (assert (= strLit.tag "litStr") "String literal tag must be litStr")
    (assert (= strLit.strVal "hello world") "String literal payload must match")
    (assert (= strLit.quoteKind "single") "String literals must default to single quote for safety")
    (assert (= intLit.tag "litInt") "Integer literal tag must be litInt")
    (assert (= intLit.intVal 42) "Integer literal value must be 42")
    (assert (= varRef.tag "var") "Variable reference tag must be var")
    (assert (= varRef.strVal "user_path") "Variable reference name must match")
    (assert (= varRef.quoteKind "double") "Variable references must default to double quote for expansion")
    (assert (= assignStmt.tag "assign") "Assignment statement tag must be assign")
    (assert assignStmt.isLocal "Assignment should be local")
    (assert (= ifStmt.tag "if") "If statement tag must be if")
    (assert (= (listLength ifStmt.thenStmts) 1) "Then branch must have 1 statement")
    (assert (= fnDef.name "init_env") "Function definition name must match")
    (assert (= script.shebang "#!/bin/sh") "Script shebang must be #!/bin/sh")
    (assert (= (listLength script.functions) 1) "Script must have 1 function")
    (refute (= strLit.tag "var") "String literal must not be mistaken for variable")
    (refute (= strLit.quoteKind "raw") "String literal must not be unquoted raw")
    true)

fn runTests -> Bool
  (testShAstNodes)
