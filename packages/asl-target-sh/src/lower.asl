(module asl-target-sh/lower
  :x [lowerAslToSh
      lowerTopForm
      lowerFnDecl
      lowerLetBindings
      lowerExpr
      sampleLoweredScript
      defunToShFn
      emitShSourceFromForms]
  :i [(asl-target-sh/ast :a ast) (asl-target-sh/emitSh :a em) (asl-parser/ast :a a)])

fn lowerExpr expr: Any -> ast/ShExpr
  (let [(s (stringTrim (str expr)))]
    (if (and (stringStartsWith? s "\"") (stringEndsWith? s "\""))
      (let [(inner (optionOr (stringSlice s 1 (- (stringLength s) 1)) ""))]
        (ast/makeShLitStr inner))
      (if (some? (stringToInt64 s))
        (ast/makeShLitInt (optionOr (stringToInt64 s) 0))
        (ast/makeShVar s))))

fn lowerLetBindings bindings: (List Any) -> (List ast/ShStmt)
  (map (fn [(b Any)] -> ast/ShStmt
         (let [(bStr (str b))]
           (let [(varName (if (= bStr "") "temp_var" bStr))]
             (ast/makeShAssign varName (ast/makeShLitStr "") true false))))
       bindings)

fn lowerFnDecl name: String bodyStmts: (List ast/ShStmt) -> ast/ShFunction
  (ast/makeShFunction (em/mangleIdent name) bodyStmts)

fn lowerTopForm form: Any -> (Option ast/ShFunction)
  (let [(fStr (str form))]
    (if (stringStartsWith? fStr "fn ")
      (let [(parts (stringSplit fStr " "))
            (fnName (optionOr (listGet parts 1) "unnamed_fn"))]
        (some (lowerFnDecl fnName (list))))
      none))

fn lowerAslToSh forms: (List Any) -> ast/ShScript
  (let [(fns (map (fn [(o (Option ast/ShFunction))]
                    (mt o
                      ((some f) f)
                      (else (ast/makeShFunction "" (list)))))
                  (filter some? (map lowerTopForm forms))))
        (mainCall (list (ast/makeShCall "main" (list) (list))))]
    (ast/makeShScript
      "#!/bin/sh"
      (list "Generated by ASL Target Shell (Pure Tree-to-Tree)")
      fns
      mainCall))

fn sampleLoweredScript -> ast/ShScript
  (let [(statusVar (ast/makeShVar "status"))
        (statusLit (ast/makeShLitStr "ASL_SHELL_OK"))
        (assignStmt (ast/makeShAssign "status" statusLit true false))
        (printCall (ast/makeShCall "printf" (list (ast/makeShLitStr "%s\\n") statusVar) (list)))
        (retStmt (ast/makeShReturn (ast/makeShLitInt 0)))
        (fnMain (ast/makeShFunction "main" (list assignStmt printCall retStmt)))
        (callMain (ast/makeShCall "main" (list) (list)))]
    (ast/makeShScript
      "#!/bin/sh"
      (list "Sovereign ASL Live POSIX Execution Harness")
      (list fnMain)
      (list callMain)))

fn unpackForms forms: (List a/TopForm) -> (List a/TopForm)
  (if (= (listLength forms) 1)
    (mt (listHead forms)
      ((some form)
       (mt form
         ((a/topModule m) m.defs)
         (else forms)))
      (else forms))
    forms)

fn defunToShFn d: a/DefunNode -> ast/ShFunction
  (let [(name d.name)
        (stmts (list (ast/makeShReturn (ast/makeShLitInt 0))))]
    (ast/makeShFunction (em/mangleIdent name) stmts))

fn emitShSourceFromForms forms: (List a/TopForm) path: String -> String
  (let [(effForms (unpackForms forms))
        (shFns (fold (fn [(acc (List ast/ShFunction)) (form a/TopForm)]
                       (mt form
                         ((a/topDefun d) (listAppend acc (list (defunToShFn d))))
                         (else acc)))
                     (list) effForms))
        (mainCall (list (ast/makeShCall "main" (list) (list))))
        (script (ast/makeShScript
                  "#!/bin/sh"
                  (list "Transpiled by ASL Target Shell (Tree-to-Tree)" (str "Source: " path))
                  shFns
                  mainCall))]
    (em/formatShScript script))
