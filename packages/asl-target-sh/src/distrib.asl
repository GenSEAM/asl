(module asl-target-sh/distrib
  :x [generateInstallPs1
      generateAslCmd
      generateInstallShHeader
      generateInstallSh
      formatGeneratedHeader
      distribTargetsList
      main
      installMain!
      shellQuote
      skillOps
      stripBlock
      civilFromDays
      RunResult
      runArgv!
      chmodTo!
      writeOut!
      writeErr!
      sliceFrom
      sliceTo
      splitLines
      joinLines
      readText!
      isRegular!
      isDir!
      modeOf!
      isExecutable!
      isMachO
      isElf
      isScript
      isRunnable!
      defaultRepoUrl
      prebuiltBaseUrl!
      repoUrl!
      dirName
      symlink?
      copyTree!
      pkgOf!
      generatePortableAsl
      emitPortableEntry!
      aslEntry!
      portableEntry?
      stepClone!
      answersOp?
      stepProbe!
      Step
      Inst]
  :i [(asl-target-sh/emitPs1 :a ps1) (asl-target-sh/emitCmd :a cmd) (asl-target-sh/emitSh :a sh)])

fn formatGeneratedHeader lang: String targetName: String ssotPath: String -> String
  (let [(commentPrefix (if (= lang "cmd") "::" "#"))]
    (str
      commentPrefix " ============================================================================\n"
      commentPrefix " Generated by AgentScript (ASL) Target Generator (" targetName ").\n"
      commentPrefix " DO NOT EDIT THIS FILE BY HAND.\n"
      commentPrefix " Single Source of Truth (SSOT): " ssotPath "\n"
      commentPrefix " All modifications must be made to the ASL source and compiled via: asl target distrib\n"
      commentPrefix " ============================================================================\n"))

fn distribTargetsList -> (List String)
  (list "posix-shell" "windows-powershell" "windows-cmd")

fn generateAslCmd version: String -> String
  (let [(header (formatGeneratedHeader "cmd" "asl-target-sh/emitCmd" "asl/packages/asl-target-sh/src/distrib.asl"))
        (lines (list
          header
          "set \"SCRIPT_DIR=%~dp0\""
          ""
          ":: Locate asl.wasm and run-wasm.js"
          "if exist \"%SCRIPT_DIR%asl.wasm\" ("
          "  set \"WASM_BIN=%SCRIPT_DIR%asl.wasm\""
          "  set \"RUN_JS=%SCRIPT_DIR%run-wasm.js\""
          ") else if exist \"%SCRIPT_DIR%..\\asl.wasm\" ("
          "  set \"WASM_BIN=%SCRIPT_DIR%..\\asl.wasm\""
          "  set \"RUN_JS=%SCRIPT_DIR%..\\run-wasm.js\""
          ") else ("
          "  set \"WASM_BIN=%SCRIPT_DIR%asl.wasm\""
          "  set \"RUN_JS=%SCRIPT_DIR%run-wasm.js\""
          ")"
          ""
          "if \"%~1\"==\"--version\" goto :show_version"
          "if \"%~1\"==\"-v\" goto :show_version"
          "if \"%~1\"==\"\" goto :show_help"
          "if \"%~1\"==\"--help\" goto :show_help"
          "if \"%~1\"==\"-h\" goto :show_help"
          ""
          ":: If native zero-dependency asl.exe exists, run it"
          "if exist \"%SCRIPT_DIR%asl.exe\" ("
          "  \"%SCRIPT_DIR%asl.exe\" %*"
          "  exit /b %ERRORLEVEL%"
          ")"
          ""
          "where node >nul 2>&1"
          "if %ERRORLEVEL% equ 0 ("
          "  node \"%RUN_JS%\" %*"
          "  exit /b %ERRORLEVEL%"
          ")"
          ""
          "where bun >nul 2>&1"
          "if %ERRORLEVEL% equ 0 ("
          "  bun run \"%RUN_JS%\" %*"
          "  exit /b %ERRORLEVEL%"
          ")"
          ""
          "where wasmtime >nul 2>&1"
          "if %ERRORLEVEL% equ 0 ("
          "  wasmtime run --dir=. \"%WASM_BIN%\" %*"
          "  exit /b %ERRORLEVEL%"
          ")"
          ""
          "echo Error: ASL on Windows requires a WebAssembly/WASI runtime (wasmtime, node, bun, or wasmer). >&2"
          "exit /b 1"
          ""
          ":show_version"
          (str "echo asl " version " (wasm-wasi windows-x64 substrate)")
          "exit /b 0"
          ""
          ":show_help"
          "echo AgentScript Native CLI (WASM/WASI substrate for Windows)"
          "echo Usage: asl ^<command^> [args...]"
          "exit /b 0"))]
    (stringJoin lines "\n"))

fn generateInstallPs1 version: String -> String
  (let [(header (formatGeneratedHeader "ps1" "asl-target-sh/emitPs1" "asl/packages/asl-target-sh/src/distrib.asl"))
        (aslCmdCode (generateAslCmd version))]
    (str
      header
      "# AgentScript Universal Installer for Windows (PowerShell)\n"
      "# Usage: irm https://aslang.dev/install.ps1 | iex\n"
      "$ErrorActionPreference = \"Stop\"\n\n"
      "$Version = \"" version "\"\n"
      "$InstallDir = \"$env:LOCALAPPDATA\\asl\\bin\"\n"
      "New-Item -ItemType Directory -Force -Path $InstallDir | Out-Null\n\n"
      "Write-Host \"Installing AgentScript (ASL) for Windows...\" -ForegroundColor Cyan\n\n"
      "$AslCmdPath = Join-Path $InstallDir \"asl.cmd\"\n\n"
      "@\"\n"
      aslCmdCode "\n"
      "\"@ | Set-Content -Path $AslCmdPath -Encoding ASCII\n\n"
      "$UserPath = [System.Environment]::GetEnvironmentVariable(\"Path\", [System.EnvironmentVariableTarget]::User)\n"
      "if ($UserPath -notlike \"*$InstallDir*\") {\n"
      "    [System.Environment]::SetEnvironmentVariable(\"Path\", \"$UserPath;$InstallDir\", [System.EnvironmentVariableTarget]::User)\n"
      "    $env:Path = \"$env:Path;$InstallDir\"\n"
      "    Write-Host \"✓ Added $InstallDir to User PATH\" -ForegroundColor Green\n"
      "}\n\n"
      "Write-Host \"✓ ASL successfully installed to $InstallDir\\asl.cmd\" -ForegroundColor Green\n"
      "Write-Host \"⚡ Run: asl --version\" -ForegroundColor Yellow\n"))

fn generateInstallShHeader -> String
  (formatGeneratedHeader "sh" "asl-target-sh" "asl/packages/asl-target-sh/src/distrib.asl & asl/grammar/rules.asn")

(schema SpawnedProc (:f pid Int64) (:f stdin Int64) (:f stdout Int64) (:f stderr Int64))

(schema RunResult (:f code Int64) (:f out String) (:f errText String))


fn writeFd! fd: Int64 s: String -> Bool
  (if (stringEmpty? s)
    true
    (mt (fdWrite fd s)
      ((ok n) (writeFd! fd (optionOr (stringSlice s n (stringLength s)) "")))
      ((err _) false)))

fn writeOut! s: String -> Bool
  (writeFd! 1 s)

fn writeErr! s: String -> Bool
  (writeFd! 2 s)

fn sliceFrom s: String i: Int64 -> String
  (let [(n (stringLength s))]
    (optionOr (stringSlice s (max 0 (min i n)) n) ""))

fn sliceTo s: String i: Int64 -> String
  (optionOr (stringSlice s 0 (max 0 (min i (stringLength s)))) "")

fn splitLines s: String -> (List String)
  (if (stringEmpty? s)
    (list)
    (let [(parts (stringSplit s "\n"))]
      (if (stringEndsWith? s "\n") (listTake parts (- (listLength parts) 1)) parts)))

fn joinLines xs: (List String) -> String
  (if (listEmpty? xs) "" (str (stringJoin xs "\n") "\n"))

fn readText! path: String -> (Result String String)
  (fileReadString path)

fn isRegular! path: String -> Bool
  (mt (fileStat path) ((ok st) st.isFile) ((err _) false))

fn isDir! path: String -> Bool
  (mt (fileStat path) ((ok st) st.isDir) ((err _) false))

fn modeOf! path: String -> Int64
  (mt (fileStat path) ((ok st) st.mode) ((err _) 0))

fn isExecutable! path: String -> Bool
  (and (isRegular! path) (not (= (& (modeOf! path) 73) 0)))

fn isArchX86_64 arch: String -> Bool
  (or (= arch "x86_64") (= arch "amd64") (= arch "x64"))

fn isArchArm64 arch: String -> Bool
  (or (= arch "arm64") (= arch "aarch64"))

fn targetCpuType arch: String -> Int64
  (cond
    ((isArchX86_64 arch) 16777223)
    ((isArchArm64 arch) 16777228)
    (else -1))

fn isMachOFat bs: Bytes -> Bool
  (and (>= (bytesLength bs) 4)
       (let [(b0 (bytesGet bs 0)) (b1 (bytesGet bs 1)) (b2 (bytesGet bs 2)) (b3 (bytesGet bs 3))]
         (or
           (and (= b0 202) (= b1 254) (= b2 186) (= b3 190))
           (and (= b0 190) (= b1 186) (= b2 254) (= b3 202)))))

fn isMachO bs: Bytes -> Bool
  (and (>= (bytesLength bs) 4)
       (let [(b0 (bytesGet bs 0)) (b1 (bytesGet bs 1)) (b2 (bytesGet bs 2)) (b3 (bytesGet bs 3))]
         (or
           (and (= b0 207) (= b1 250) (= b2 237) (= b3 254))
           (and (= b0 254) (= b1 237) (= b2 250) (= b3 207))
           (and (= b0 206) (= b1 250) (= b2 237) (= b3 254))
           (and (= b0 254) (= b1 237) (= b2 250) (= b3 206))
           (and (= b0 202) (= b1 254) (= b2 186) (= b3 190))
           (and (= b0 190) (= b1 186) (= b2 254) (= b3 202)))))

fn fatContainsArch bs: Bytes targetCpu: Int64 bigEndian: Bool i: Int64 count: Int64 -> Bool
  (if (>= i count)
    false
    (let [(off (+ 8 (* i 20)))]
      (if (< (bytesLength bs) (+ off 4))
        false
        (let [(cpu (if bigEndian
                     (+ (+ (* (bytesGet bs off) 16777216) (* (bytesGet bs (+ off 1)) 65536))
                        (+ (* (bytesGet bs (+ off 2)) 256) (bytesGet bs (+ off 3))))
                     (+ (+ (bytesGet bs off) (* (bytesGet bs (+ off 1)) 256))
                        (+ (* (bytesGet bs (+ off 2)) 65536) (* (bytesGet bs (+ off 3)) 16777216)))))]
          (if (= cpu targetCpu)
            true
            (fatContainsArch bs targetCpu bigEndian (+ i 1) count))))))

fn machOHasArch bs: Bytes arch: String -> Bool
  (let [(targetCpu (targetCpuType arch))]
    (if (= targetCpu -1)
      false
      (cond
        ((isMachOFat bs)
          (if (< (bytesLength bs) 8)
            false
            (let [(bigEndian (= (bytesGet bs 0) 202))
                  (narch (if bigEndian
                           (+ (+ (* (bytesGet bs 4) 16777216) (* (bytesGet bs 5) 65536))
                              (+ (* (bytesGet bs 6) 256) (bytesGet bs 7)))
                           (+ (+ (bytesGet bs 4) (* (bytesGet bs 5) 256))
                              (+ (* (bytesGet bs 6) 65536) (* (bytesGet bs 7) 16777216)))))]
              (fatContainsArch bs targetCpu bigEndian 0 narch))))
        ((< (bytesLength bs) 8) false)
        (else
          (let [(b0 (bytesGet bs 0))
                (cputype (if (or (= b0 207) (= b0 206))
                           (+ (+ (bytesGet bs 4) (* (bytesGet bs 5) 256))
                              (+ (* (bytesGet bs 6) 65536) (* (bytesGet bs 7) 16777216)))
                           (+ (+ (* (bytesGet bs 4) 16777216) (* (bytesGet bs 5) 65536))
                              (+ (* (bytesGet bs 6) 256) (bytesGet bs 7)))))]
            (= cputype targetCpu))))))

fn isElf bs: Bytes -> Bool
  (and (>= (bytesLength bs) 4)
       (= (bytesGet bs 0) 127)
       (= (bytesGet bs 1) 69)
       (= (bytesGet bs 2) 76)
       (= (bytesGet bs 3) 70))

fn elfHasArch bs: Bytes arch: String -> Bool
  (if (< (bytesLength bs) 20)
    false
    (let [(data (bytesGet bs 5))
          (mLow (bytesGet bs 18))
          (mHigh (bytesGet bs 19))
          (machine (cond
                     ((= data 1) (+ mLow (* mHigh 256)))
                     ((= data 2) (+ (* mLow 256) mHigh))
                     (else -1)))]
      (cond
        ((isArchX86_64 arch) (= machine 62))
        ((isArchArm64 arch) (= machine 183))
        (else false))))

fn isScript bs: Bytes -> Bool
  (and (>= (bytesLength bs) 2)
       (= (bytesGet bs 0) 35)
       (= (bytesGet bs 1) 33))

fn isRunnable! path: String os: String arch: String -> Bool
  (and (isExecutable! path)
       (mt (fileReadRange path 0 4096)
         ((err _) false)
         ((ok bs)
           (cond
             ((isScript bs) true)
             ((isMachO bs) (and (= os "darwin") (machOHasArch bs arch)))
             ((isElf bs) (and (= os "linux") (elfHasArch bs arch)))
             (else false)))))

fn dirName path: String -> String
  (let [(n (stringLength path))
        (cut (lastSlash path (- n 1)))]
    (cond
      ((< cut 0) ".")
      ((= cut 0) "/")
      (else (sliceTo path cut))))

fn lastSlash s: String i: Int64 -> Int64
  (cond
    ((< i 0) -1)
    ((= (optionOr (stringSlice s i (+ i 1)) "") "/") i)
    (else (lastSlash s (- i 1))))

(schema Io (:f outOpen Bool) (:f errOpen Bool) (:f out String) (:f errText String))

fn readyOn? ready: (List (Pair Int64 Int64)) fd: Int64 -> Bool
  (listAny? (fn [p] (= (pairFirst p) fd)) ready)

fn pumpStep! fd: Int64 open: Bool acc: String -> (Pair Bool String)
  (mt (fdRead fd 65536)
    ((ok chunk) (if (stringEmpty? chunk) (do (fdClose fd) (pair false acc)) (pair true (str acc chunk))))
    ((err e) (if (= e "wouldBlock") (pair open acc) (do (fdClose fd) (pair false acc)))))

fn pumpIo! sp: SpawnedProc io: Io deadlineNs: Int64 -> (Pair Bool Io)
  (if (not (or io.outOpen io.errOpen))
    (pair true io)
    (let [(leftMs (/ (- deadlineNs (monotonicNs)) 1000000))
          (fds (listAppend (if io.outOpen (list (pair sp.stdout 1)) (list)) (if io.errOpen (list (pair sp.stderr 1)) (list))))]
      (if (<= leftMs 0)
        (do (if io.outOpen (fdClose sp.stdout) (ok ())) (if io.errOpen (fdClose sp.stderr) (ok ())) (pair false io))
        (mt (fdPoll fds leftMs)
          ((err _) (do (if io.outOpen (fdClose sp.stdout) (ok ())) (if io.errOpen (fdClose sp.stderr) (ok ())) (pair false io)))
          ((ok ready)
            (let [(o (if (and io.outOpen (readyOn? ready sp.stdout)) (pumpStep! sp.stdout true io.out) (pair io.outOpen io.out)))
                  (e (if (and io.errOpen (readyOn? ready sp.stderr)) (pumpStep! sp.stderr true io.errText) (pair io.errOpen io.errText)))]
              (pumpIo! sp (Io :outOpen (pairFirst o) :errOpen (pairFirst e) :out (pairSecond o) :errText (pairSecond e)) deadlineNs)))))))

fn runArgv! argv: (List String) cwd: (Option String) env: (Option (List String)) timeoutMs: Int64 -> (Result RunResult String)
  (mt (procSpawnv argv cwd env)
    ((err e) (err e))
    ((ok sp)
      (let [(closed (fdClose sp.stdin))
            (pumped (pumpIo! sp (Io :outOpen true :errOpen true :out "" :errText "") (+ (monotonicNs) (* timeoutMs 1000000))))
            (io (pairSecond pumped))]
        (if (pairFirst pumped)
          (mt (procWaitPid sp.pid false)
            ((err e) (err e))
            ((ok code) (ok (RunResult :code (optionOr code -1) :out io.out :errText io.errText))))
          (do (procKill (- 0 sp.pid) "SIGKILL")
              (procWaitPid sp.pid false)
              (ok (RunResult :code 142 :out io.out :errText io.errText)))))))

fn chmodTo! path: String mode: Int64 -> (Result Unit String)
  (mt (runArgv! (list "chmod" (if (= mode 493) "755" "644") path) (none) (none) 60000)
    ((ok r) (if (= r.code 0) (ok ()) (err (str "chmod " path ": " r.errText))))
    ((err e) (err (str "ERR_TOOL_ABSENT chmod: " e))))

fn ! symlink? dir: String name: String -> Bool
  (and (entryIn? dir name)
       (mt (realPath (str dir "/" name))
         ((err _) true)
         ((ok real) (mt (realPath dir) ((ok d) (not (= real (str d "/" name)))) ((err _) true)))))

fn ! entryIn? dir: String name: String -> Bool
  (mt (dirList dir) ((ok names) (listContains? names name)) ((err _) false))

fn generateInstallSh -> String
  (str
    "#!/bin/sh\n"
    (generateInstallShHeader)
    "# AgentScript Universal Installer bootstrap: it only finds or builds asl-host and runs the ASL installer\n"
    "# Canonical URL: https://aslang.dev/install.sh\n"
    "# Usage: curl -fsSL https://aslang.dev/install.sh | sh\n"
    "set -eu\n"
    "REPO_URL=\"${REPO_URL:-https://github.com/GenSEAM/asl.git}\"\n"
    "export REPO_URL\n"
    "FROM=pipe\n"
    "ROOT=\"\"\n"
    "case \"$0\" in\n"
    "  *install.sh) if [ -f \"$0\" ]; then FROM=file; ROOT=\"$(cd -P \"$(dirname \"$0\")/..\" && pwd)\"; fi ;;\n"
    "esac\n"
    "die() { echo \"✗ $*\" >&2; exit 1; }\n"
    "pkg_of() {\n"
    "  if [ -f \"$1/asl/packages/asl-target-sh/src/distrib.asl\" ]; then echo \"$1/asl\"\n"
    "  elif [ -f \"$1/packages/asl-target-sh/src/distrib.asl\" ]; then echo \"$1\"\n"
    "  else return 1; fi\n"
    "}\n"
    "host_of() {\n"
    "  if [ ! -x \"$1/host/out/asl-host\" ] || [ -n \"$(find \"$1/host/src/\" \"$1/prelude/\" \"$1/host/build.sh\" -newer \"$1/host/out/asl-host\" 2>/dev/null | head -n 1)\" ]; then\n"
    "    sh \"$1/host/build.sh\" >&2 || [ -x \"$1/host/out/asl-host\" ] || return 1\n"
    "  fi\n"
    "  echo \"$1/host/out/asl-host\"\n"
    "}\n"
    "case \"${1:-}\" in\n"
    "  --tier|--render-rules|--check-rules|--render-home|--render-lexicon|--render-installers|--check-installers)\n"
    "    [ -n \"$ROOT\" ] || die \"install.sh $1 runs from a checkout, not from a pipe\"\n"
    "    PKG=\"$(pkg_of \"$ROOT\")\" || die \"no ASL installer under $ROOT\"\n"
    "    HOST=\"$(host_of \"$PKG\")\" || die \"cannot build asl-host in $PKG/host (needs a C compiler)\"\n"
    "    exec \"$HOST\" run \"$PKG/packages/asl-target-sh/src/rules.asl\" \"$ROOT\" \"$@\" ;;\n"
    "esac\n"
    "OS=\"$(uname -s | tr '[:upper:]' '[:lower:]')\"\n"
    "ARCH=\"$(uname -m)\"\n"
    "case \"$OS\" in\n"
    "  *mingw*|*cygwin*|*msys*|windows_nt)\n"
    "    echo \"Windows environment detected via $OS. Delegating to PowerShell installer...\"\n"
    "    PS1_SCRIPT=\"$(cd \"$(dirname \"$0\")\" 2>/dev/null && pwd)/install.ps1\"\n"
    "    if [ \"$FROM\" = file ] && [ -f \"$PS1_SCRIPT\" ]; then\n"
    "      powershell.exe -ExecutionPolicy Bypass -File \"$PS1_SCRIPT\" || powershell -ExecutionPolicy Bypass -File \"$PS1_SCRIPT\"\n"
    "    else\n"
    "      powershell.exe -ExecutionPolicy Bypass -Command \"irm https://aslang.dev/install.ps1 | iex\"\n"
    "    fi\n"
    "    exit 0 ;;\n"
    "esac\n"
    "SRC_ARG=\"\"; HOME_ARG=\"${HOME:-}\"; DRY=0; PREV=\"\"\n"
    "for A in \"$@\"; do\n"
    "  case \"$PREV\" in --source) case \"$A\" in -*) ;; *) SRC_ARG=\"$A\" ;; esac ;; --home) HOME_ARG=\"$A\" ;; esac\n"
    "  case \"$A\" in --source=*) SRC_ARG=\"${A#*=}\" ;; --home=*) HOME_ARG=\"${A#*=}\" ;; --dry-run) DRY=1 ;; esac\n"
    "  PREV=\"$A\"\n"
    "done\n"
    "TREE=\"\"\n"
    "if [ -n \"$ROOT\" ] && pkg_of \"$ROOT\" >/dev/null; then TREE=\"$ROOT\"\n"
    "else\n"
    "  FROM=pipe\n"
    "  if [ -n \"$SRC_ARG\" ] && [ -d \"$SRC_ARG\" ] && pkg_of \"$SRC_ARG\" >/dev/null; then TREE=\"$(cd -P \"$SRC_ARG\" && pwd)\"\n"
    "  else\n"
    "    TREE=\"$HOME_ARG/.asl/repo\"\n"
    "    if [ ! -d \"$TREE/.git\" ]; then\n"
    "      [ \"$DRY\" -eq 0 ] || die \"--dry-run needs a local tree: run install.sh from a checkout or pass --source DIR\"\n"
    "      command -v git >/dev/null 2>&1 || die \"ERR_TOOL_ABSENT git: needed to fetch $REPO_URL\"\n"
    "      git clone --depth 1 \"$REPO_URL\" \"$TREE\" >&2\n"
    "    fi\n"
    "  fi\n"
    "fi\n"
    "PKG=\"$(pkg_of \"$TREE\")\" || die \"no ASL installer in $TREE\"\n"
    "HOST=\"$(host_of \"$PKG\")\" || die \"cannot build asl-host in $PKG/host (needs a C compiler)\"\n"
    "export ASL_HOST=\"$HOST\"\n"
    "TTY=none\n"
    "if [ -t 0 ]; then TTY=tty\n"
    "elif [ -e /dev/tty ]; then\n"
    "  if (: </dev/tty) 2>/dev/null; then TTY=devtty; else TTY=devttyFail; fi\n"
    "fi\n"
    "INSTALLER=\"$PKG/packages/asl-target-sh/src/distrib.asl\"\n"
    "if [ \"$DRY\" -eq 0 ] && [ -e \"$TREE/.git\" ] && git -C \"$TREE\" rev-parse --git-dir >/dev/null 2>&1; then\n"
    "  git -C \"$TREE\" config --local merge.asnRows.driver \"\\\"$HOST\\\" run \\\"$PKG/tools/mergeRows/mergeRows.asl\\\" %O %A %B %P\"\n"
    "  git -C \"$TREE\" config --local merge.asnRows.name 'ASN row-keyed merge (MRG1)'\n"
    "fi\n"
    "if [ \"$TTY\" = devtty ]; then exec \"$HOST\" run \"$INSTALLER\" \"$TREE\" \"$FROM\" \"$TTY\" \"$OS\" \"$ARCH\" \"$@\" </dev/tty; fi\n"
    "exec \"$HOST\" run \"$INSTALLER\" \"$TREE\" \"$FROM\" \"$TTY\" \"$OS\" \"$ARCH\" \"$@\"\n")

(schema Inst (:f tree String) (:f from String) (:f tty String) (:f os String) (:f arch String) (:f home String) (:f installDir String) (:f dry Bool) (:f autoYes Bool) (:f filter String) (:f skip Bool) (:f purge Bool) (:f force Bool) (:f sourceDir String) (:f entry String) (:f prebuilt Bool) (:f links (List String)) (:f answeredOps String))

(enum Step (:c go [(st Inst)] "continue") (:c stop [(code Int64)] "exit with code"))

fn withEntry st: Inst entry: String prebuilt: Bool sourceDir: String -> Inst
  (with st :sourceDir sourceDir :entry entry :prebuilt prebuilt :answeredOps "")

fn withLink st: Inst link: String -> Inst
  (with st :links (listAppend st.links (list link)))

fn withAnsweredOps st: Inst opsStr: String -> Inst
  (with st :answeredOps opsStr)

fn say! line: String -> Bool
  (writeOut! (str line "\n"))

fn warn! line: String -> Bool
  (writeErr! (str line "\n"))

fn die! msg: String -> Step
  (do (warn! (str "✗ " msg)) (stop 1))

fn shellQuote s: String -> String
  (if (stringEmpty? s)
    "''"
    (let [(chars (stringChars s))]
      (str (stringJoin (map (fn [c] (quoteChar c true)) (listTake chars 1)) "")
           (stringJoin (map (fn [c] (quoteChar c false)) (listDrop chars 1)) ""))))

fn quoteChar c: String first: Bool -> String
  (if (or (listContains? (list " " "\t" "\n" "'" "\"" "\\" "|" "&" ";" "(" ")" "<" ">" "!" "{" "}" "*" "[" "]" "?" "^" "$" "`" ",") c) (and first (= c "#")))
    (str "\\" c)
    c)

fn act! st: Inst argv: (List String) -> Step
  (if st.dry
    (do (say! (str "  would run:" (fold (fn [acc a] (str acc " " (shellQuote a))) "" argv))) (go st))
    (actRun! st argv))

fn actRun! st: Inst argv: (List String) -> Step
  (let [(cmd (optionOr (listHead argv) ""))]
    (cond
      ((= cmd "mkdir") (mt (dirCreate (optionOr (listLast argv) "")) ((ok _) (go st)) ((err e) (die! e))))
      ((= cmd "rm") (do (if (pathExists? (optionOr (listLast argv) "")) (pathRemove (optionOr (listLast argv) "")) (ok ())) (go st)))
      (else (passThrough! st argv (none)))))

fn ! pathExists? p: String -> Bool
  (or (ok? (fileStat p)) (entryIn? (dirName p) (baseName p)))

fn baseName p: String -> String
  (sliceFrom p (+ (lastSlash p (- (stringLength p) 1)) 1))

fn passThrough! st: Inst argv: (List String) cwd: (Option String) -> Step
  (mt (runArgv! argv cwd (none) 600000)
    ((err e) (die! (str "ERR_TOOL_ABSENT " (optionOr (listHead argv) "") ": " e)))
    ((ok r) (do (writeOut! r.out) (writeErr! r.errText) (if (= r.code 0) (go st) (stop r.code)))))

fn then s: Step f: (fn [Inst] -> Step) -> Step
  (mt s ((go st) (f st)) ((stop c) (stop c)))

(schema Opts (:f dry Bool) (:f autoYes Bool) (:f filter String) (:f skip Bool) (:f purge Bool) (:f force Bool) (:f sourceDir String) (:f home String) (:f bad String) (:f code Int64))

fn optSet o: Opts key: String val: String -> Opts
  (Opts :dry (if (= key "dry") true o.dry) :autoYes (if (= key "yes") true o.autoYes) :filter (if (= key "filter") val o.filter)
        :skip (cond ((= key "skip") true) ((= key "skills") false) (else o.skip)) :purge (if (= key "purge") true o.purge)
        :force (if (= key "source") true o.force) :sourceDir (if (and (= key "source") (not (stringEmpty? val))) val o.sourceDir)
        :home (if (= key "home") val o.home) :bad (if (= key "bad") val o.bad) :code (cond ((= key "bad") 2) ((= key "badHome") 1) (else o.code)))

fn parseOpts args: (List String) o: Opts -> Opts
  (mt (listHead args)
    ((none) o)
    ((some a)
      (let [(rest (optionOr (listTail args) (list)))
            (next (optionOr (listHead rest) ""))]
        (cond
          ((listContains? (list "-y" "--yes" "--all") a) (parseOpts rest (optSet o "yes" "")))
          ((= a "--no-skills") (parseOpts rest (optSet o "skip" "")))
          ((= a "--skills") (parseOpts rest (optSet o "skills" "")))
          ((= a "--purge") (parseOpts rest (optSet o "purge" "")))
          ((= a "--dry-run") (parseOpts rest (optSet o "dry" "")))
          ((stringStartsWith? a "--agents=") (parseOpts rest (optSet o "filter" (sliceFrom a 9))))
          ((stringStartsWith? a "--home=") (parseOpts rest (optSet o "home" (sliceFrom a 7))))
          ((= a "--home") (if (stringEmpty? next)
                             (with o :bad "install.sh: --home needs a directory" :code 1)
                             (parseOpts (optionOr (listTail rest) (list)) (optSet o "home" next))))
          ((stringStartsWith? a "--source=") (parseOpts rest (optSet o "source" (sliceFrom a 9))))
          ((= a "--source") (if (and (not (stringEmpty? next)) (not (stringStartsWith? next "-")))
                               (parseOpts (optionOr (listTail rest) (list)) (optSet o "source" next))
                               (parseOpts rest (optSet o "source" ""))))
          (else (optSet o "bad" (str "install.sh: unknown option " a)))))))

fn aslEntry! root: String os: String arch: String -> (Option String)
  (listHead (filter (fn [p] (isRunnable! p os arch))
    (listAppend (list (str root "/bin/asl") (str root "/asl/asl") (str root "/asl"))
                (list (str root "/host/out/asl") (str root "/asl/host/out/asl")))))

fn pkgOf! tree: String -> (Option String)
  (cond
    ((isRegular! (str tree "/asl/packages/asl-target-sh/src/distrib.asl")) (some (str tree "/asl")))
    ((isRegular! (str tree "/packages/asl-target-sh/src/distrib.asl")) (some tree))
    (else (none)))

fn portableEntry? path: String -> Bool
  (stringEndsWith? path "/host/out/asl")

fn generatePortableAsl -> String
  (str
    "#!/bin/sh\n"
    "# AgentScript (ASL) Portable CLI entry point\n"
    "set -eu\n"
    "CDPATH=\n"
    "PRG=\"$0\"\n"
    "while [ -L \"$PRG\" ] || [ -h \"$PRG\" ]; do\n"
    "  if command -v readlink >/dev/null 2>&1; then\n"
    "    TARGET=\"$(readlink \"$PRG\")\"\n"
    "  else\n"
    "    DIR=\"$(CDPATH= cd -P -- \"$(dirname -- \"$PRG\")\" && pwd -P)\"\n"
    "    TARGET=\"$(CDPATH= cd -P -- \"$DIR\" && pwd -P)/$(basename -- \"$PRG\")\"\n"
    "    PRG=\"$TARGET\"\n"
    "    break\n"
    "  fi\n"
    "  case \"$TARGET\" in\n"
    "    /*) PRG=\"$TARGET\" ;;\n"
    "    *) PRG=\"$(CDPATH= cd -P -- \"$(dirname -- \"$PRG\")\" && pwd -P)/$TARGET\" ;;\n"
    "  esac\n"
    "done\n"
    "HERE=\"$(CDPATH= cd -P -- \"$(dirname -- \"$PRG\")\" && pwd -P)\"\n"
    "HOST=\"${ASL_HOST:-}\"\n"
    "if [ -z \"$HOST\" ] || [ ! -x \"$HOST\" ]; then\n"
    "  if [ -x \"$HERE/asl-host\" ]; then HOST=\"$HERE/asl-host\"\n"
    "  elif [ -x \"$HERE/../host/out/asl-host\" ]; then HOST=\"$(CDPATH= cd -P -- \"$HERE/../host/out\" && pwd -P)/asl-host\"\n"
    "  elif [ -x \"$HERE/host/out/asl-host\" ]; then HOST=\"$(CDPATH= cd -P -- \"$HERE/host/out\" && pwd -P)/asl-host\"\n"
    "  elif [ -x \"$HERE/../asl/host/out/asl-host\" ]; then HOST=\"$(CDPATH= cd -P -- \"$HERE/../asl/host/out\" && pwd -P)/asl-host\"\n"
    "  elif [ -x \"$HERE/asl/host/out/asl-host\" ]; then HOST=\"$(CDPATH= cd -P -- \"$HERE/asl/host/out\" && pwd -P)/asl-host\"\n"
    "  elif command -v asl-host >/dev/null 2>&1; then HOST=\"$(command -v asl-host)\"\n"
    "  else echo \"asl: cannot locate asl-host binary\" >&2; exit 1; fi\n"
    "fi\n"
    "PKG=\"\"\n"
    "if [ -f \"$HERE/packages/asl-cli/src/main.asl\" ]; then PKG=\"$HERE\"\n"
    "elif [ -f \"$HERE/../packages/asl-cli/src/main.asl\" ]; then PKG=\"$(CDPATH= cd -P -- \"$HERE/..\" && pwd -P)\"\n"
    "elif [ -f \"$HERE/../../packages/asl-cli/src/main.asl\" ]; then PKG=\"$(CDPATH= cd -P -- \"$HERE/../..\" && pwd -P)\"\n"
    "elif [ -f \"$HERE/asl/packages/asl-cli/src/main.asl\" ]; then PKG=\"$HERE/asl\"\n"
    "elif [ -f \"$HERE/../asl/packages/asl-cli/src/main.asl\" ]; then PKG=\"$(CDPATH= cd -P -- \"$HERE/..\" && pwd -P)/asl\"\n"
    "elif [ -f \"$HERE/../../asl/packages/asl-cli/src/main.asl\" ]; then PKG=\"$(CDPATH= cd -P -- \"$HERE/../..\" && pwd -P)/asl\"\n"
    "fi\n"
    "case \"${1:-}\" in\n"
    "  check) shift; exec \"$HOST\" check \"$@\" ;;\n"
    "  test) shift; exec \"$HOST\" test \"$@\" ;;\n"
    "  run) shift; exec \"$HOST\" run \"$@\" ;;\n"
    "  eval) shift; exec \"$HOST\" eval \"$@\" ;;\n"
    "  parse) shift; exec \"$HOST\" parse \"$@\" ;;\n"
    "  --version|version|-v)\n"
    "    if [ -n \"$PKG\" ] && [ -f \"$PKG/packages/asl-cli/src/main.asl\" ]; then\n"
    "      export ASL_HOST=\"$HOST\"\n"
    "      exec \"$HOST\" run \"$PKG/packages/asl-cli/src/main.asl\" \"$@\"\n"
    "    else\n"
    "      exec \"$HOST\" version\n"
    "    fi ;;\n"
    "  *) \n"
    "    if [ -n \"$PKG\" ] && [ -f \"$PKG/packages/asl-cli/src/main.asl\" ]; then\n"
    "      export ASL_HOST=\"$HOST\"\n"
    "      exec \"$HOST\" run \"$PKG/packages/asl-cli/src/main.asl\" \"$@\"\n"
    "    fi\n"
    "    echo \"asl: unknown command ${1:-}\" >&2; exit 2 ;;\n"
    "esac\n")
fn emitPortableEntry! root: String st: Inst -> (Option String)
  (mt (pkgOf! root)
    ((none) (none))
    ((some pkg)
      (let [(cli (str pkg "/packages/asl-cli/src/main.asl"))]
        (if (not (isRegular! cli))
          (none)
          (let [(target (str pkg "/host/out/asl"))]
            (if st.dry
              (do (say! (str "  would emit portable entry: " target)) (some target))
              (let [(madeDir (dirCreate (str pkg "/host/out")))
                    (script (generatePortableAsl))
                    (w1 (fileWrite target script))
                    (c1 (chmodTo! target 493))]
                (if (and (ok? madeDir) (ok? w1) (ok? c1) (isRunnable! target st.os st.arch))
                  (some target)
                  (none)))))))))

fn tempDir! tag: String -> (Result String String)
  (let [(base (optionOr (envGet "TMPDIR") "/tmp"))
        (dir (str (if (stringEndsWith? base "/") (sliceTo base (- (stringLength base) 1)) base) "/" tag "." (stringFromInt64 (procSelf)) "." (stringFromInt64 (nowNs))))]
    (mt (dirCreate dir) ((ok _) (ok dir)) ((err e) (err e))))

fn firstField s: String -> String
  (optionOr (listHead (filter (fn [w] (not (stringEmpty? w))) (stringSplit (stringReplace (stringReplace s "\t" " ") "\n" " ") " "))) "")

fn stepSource! st: Inst -> Step
  (let [(src st.sourceDir)]
    (cond
      ((stringEmpty? src) (go st))
      ((not (isDir! src)) (die! (str "--source " src " is not a directory")))
      (else
        (let [(real (resultOr (realPath src) src))
              (entryOpt (mt (aslEntry! real st.os st.arch)
                          ((some e) (some e))
                          ((none) (emitPortableEntry! real st))))]
          (mt entryOpt
            ((none) (die! (str "no asl entry point in " real " (looked for bin/asl, asl/asl, asl)")))
            ((some e) (do (say! (str "\u{1F4E6} Installing ASL from " real)) (go (withEntry st e false real)))))))))

fn archTag arch: String -> String
  (cond
    ((or (= arch "x86_64") (= arch "amd64")) "x64")
    ((or (= arch "arm64") (= arch "aarch64")) "arm64")
    (else "unknown"))

fn defaultRepoUrl -> String
  "https://github.com/GenSEAM/asl.git"

fn repoUrl! -> String
  (optionOr (envGet "REPO_URL") (defaultRepoUrl))

fn prebuiltBaseUrl! -> (Option String)
  (mt (envGet "ASL_PREBUILT_URL")
    ((some u) (if (stringEmpty? u) (none) (some u)))
    ((none)
      (if (= (repoUrl!) (defaultRepoUrl))
        (some "https://github.com/GenSEAM/asl/releases/download/v0.1.0")
        (none))))

fn curlTo! url: String out: String -> Bool
  (mt (runArgv! (list "curl" "-fsSL" url "-o" out) (none) (none) 600000)
    ((ok r) (= r.code 0))
    ((err _) false))

fn stepPrebuilt! st: Inst -> Step
  (let [(tag (archTag st.arch))]
    (if (or (not (stringEmpty? st.entry)) (= tag "unknown") st.force)
      (go st)
      (mt (prebuiltBaseUrl!)
        ((none) (go st))
        ((some base)
          (let [(tarName (str "asl-0.1.0-" st.os "-" tag ".tar.gz"))
                (url (str base "/" tarName))]
            (if st.dry
              (do (say! (str "  would download " url " (+ .sha256), verify, and extract into " st.installDir "; falling back to a source tree if unavailable")) (go st))
              (do (say! (str "\u{1F680} Downloading pre-built ASL binary for " st.os "-" tag "..."))
                  (mt (tempDir! "asl-dl")
                    ((err e) (die! e))
                    ((ok tmp)
                      (let [(tarPath (str tmp "/" tarName))
                            (sumPath (str tmp "/" tarName ".sha256"))
                            (got (and (curlTo! url tarPath) (curlTo! (str url ".sha256") sumPath)))
                            (result (if got (verifyAndExtract! st tarPath sumPath) (do (warn! "ℹ\u{FE0F}  Pre-built binary package or verified checksum unavailable; falling back to source...") (go st))))]
                        (do (pathRemove tmp) result)))))))))))

fn verifyAndExtract! st: Inst tarPath: String sumPath: String -> Step
  (let [(expected (firstField (resultOr (fileReadString sumPath) "")))
        (actual (mt (fileReadBytes tarPath) ((ok b) (bytesSha256 b)) ((err _) "")))]
    (if (and (not (stringEmpty? expected)) (= expected actual))
      (then (mt (dirCreate st.installDir) ((ok _) (go st)) ((err e) (die! e)))
        (fn [s1] (then (passThrough! s1 (list "tar" "-xzf" tarPath "--no-same-owner" "-C" s1.installDir) (none))
                   (fn [s2] (let [(target (str s2.installDir "/asl"))
                                  (made (if (isRegular! target) (runArgv! (list "chmod" "+x" target) (none) (none) 60000) (err "absent")))]
                              (do (say! "✓ Pre-built binary verified via SHA-256.") (go (withEntry s2 target true s2.sourceDir))))))))
      (do (warn! "⚠\u{FE0F}  Cryptographic checksum mismatch for pre-built binary; falling back to source...") (go st))))

fn stepCheckout! st: Inst -> Step
  (if (or (not (stringEmpty? st.entry)) (not (= st.from "file")))
    (go st)
    (let [(entryOpt (mt (aslEntry! st.tree st.os st.arch)
                      ((some e) (some e))
                      ((none) (emitPortableEntry! st.tree st))))]
      (mt entryOpt
        ((none) (go st))
        ((some e) (do (say! (str "\u{1F4E6} Installing ASL from local checkout " st.tree)) (go (withEntry st e false st.tree)))))))

fn stepClone! st: Inst -> Step
  (if (not (stringEmpty? st.entry))
    (go st)
    (let [(clone (str st.home "/.asl/repo"))]
      (do (say! (str "\u{1F4E6} Installing ASL from " (repoUrl!) " into " clone))
          (then (if (isDir! (str clone "/.git")) (act! st (list "git" "-C" clone "pull" "--ff-only")) (act! st (list "git" "clone" "--depth" "1" (repoUrl!) clone)))
            (fn [s1] (let [(entryOpt (mt (aslEntry! clone s1.os s1.arch)
                                      ((some e) (some e))
                                      ((none) (emitPortableEntry! clone s1))))]
                       (mt entryOpt
                         ((some e) (go (withEntry s1 e false clone)))
                         ((none) (if s1.dry (go (withEntry s1 (str clone "/bin/asl") false clone)) (die! (str "no asl entry point in " clone " (looked for bin/asl, asl/asl, asl)")))))))))))

fn link! st: Inst src: String target: String -> Step
  (then (act! st (list "ln" "-sfn" src target)) (fn [s1] (go (withLink s1 target))))

fn linkAll! st: Inst pairs: (List (Pair String String)) -> Step
  (mt (listHead pairs)
    ((none) (go st))
    ((some p) (then (link! st (pairFirst p) (pairSecond p)) (fn [s1] (linkAll! s1 (optionOr (listTail pairs) (list)))))))

fn ! ownerWritable? path: String -> Bool
  (not (= (& (modeOf! path) 128) 0))

fn stepLinks! st: Inst -> Step
  (let [(dir st.installDir)
        (entryDir (dirName st.entry))
        (companions (filter (fn [c] (isRegular! (str entryDir "/" c))) (list "asl-engine" "lens" "consilium" "asl-mesh" "asl-gateway")))
        (own (if st.prebuilt (list)
               (listAppend (list (pair st.entry (str dir "/asl")) (pair st.entry (str dir "/agentscript")))
                           (map (fn [c] (pair (str entryDir "/" c) (str dir "/" c))) companions))))
        (local (str st.home "/.local/bin"))
        (userLinks (if (and (isDir! local) (ownerWritable? local)) (list (pair (str dir "/asl") (str local "/asl")) (pair (str dir "/agentscript") (str local "/agentscript"))) (list)))]
    (then (act! st (list "mkdir" "-p" dir)) (fn [s1] (linkAll! s1 (listAppend own userLinks)))))

fn unlinkCreated! st: Inst -> Bool
  (fold (fn [acc l] (do (if (symlink? (dirName l) (baseName l)) (pathRemove l) (ok ())) acc)) true st.links)

fn skillOps text: String -> (List String)
  (let [(lines (splitLines text))
        (pub (filter (fn [l] (stringStartsWith? l "Public ops:")) lines))]
    (listAppend
      (fold (fn [acc l] (listAppend acc (filter (fn [w] (not (stringEmpty? w))) (stringSplit (stringReplace (stringReplace (stringReplace (stringReplace (sliceFrom l 11) "," " ") "." " ") "\t" " ") "\r" " ") " ")))) (list) pub)
      (bulletOps lines false (list))))

fn bulletOps lines: (List String) found: Bool acc: (List String) -> (List String)
  (mt (listHead lines)
    ((none) (listReverse acc))
    ((some l)
      (let [(rest (optionOr (listTail lines) (list)))]
        (cond
          ((stringStartsWith? l "Public ops:") (bulletOps rest true acc))
          ((and (not found) (stringStartsWith? l "- `(:") (> (stringLength l) 5) (alphaByte? (sliceFrom l 5)))
            (bulletOps rest found (cons (bulletName (sliceFrom l 5)) acc)))
          (else (bulletOps rest found acc))))))

fn alphaByte? s: String -> Bool
  (let [(c (sliceTo s 1))] (and (not (stringEmpty? c)) (or (and (>= (charCode c) 65) (<= (charCode c) 90)) (and (>= (charCode c) 97) (<= (charCode c) 122)))))

fn bulletName s: String -> String
  (let [(sp (optionOr (stringIndexOf s " ") (stringLength s)))
        (pa (optionOr (stringIndexOf s ")") (stringLength s)))]
    (sliceTo s (if (< sp pa) sp pa)))

fn skillText! st: Inst -> (Result String String)
  (let [(a (str st.tree "/asl/skills/asl-toolbelt/SKILL.md"))
        (b (str st.tree "/skills/asl-toolbelt/SKILL.md"))]
    (cond
      ((isRegular! a) (fileReadString a))
      ((isRegular! b) (fileReadString b))
      (else (err (str "no toolbelt skill in " st.tree " (looked for asl/skills/asl-toolbelt/SKILL.md, skills/asl-toolbelt/SKILL.md)")))))

fn servesOp? out: String op: String -> Bool
  (listAny? (fn [l] (opInLine l (str "(:op :" op) 0)) (splitLines out))

fn opInLine l: String key: String from: Int64 -> Bool
  (mt (stringIndexOf (sliceFrom l from) key)
    ((none) false)
    ((some rel)
      (let [(at (+ from rel (stringLength key)))
            (c (optionOr (stringSlice l at (+ at 1)) ""))]
        (if (listContains? (list "" " " "\t" ")" "\r") c) true (opInLine l key (+ from rel 1))))))

fn probeEnv! home: String -> (List String)
  (listAppend (filter (fn [r] (not (or (stringStartsWith? r "ASL_ROOT=") (stringStartsWith? r "HOME=")))) (envList)) (list (str "HOME=" home)))

fn ! answersOp? bin: String op: String home: String dir: String -> Bool
  (mt (runArgv! (list bin "(:tools :scope :all)") (some dir) (some (probeEnv! home)) 5000)
    ((err _) false)
    ((ok r) (and (= r.code 0) (servesOp? (str r.out r.errText) op))))

fn stepProbe! st: Inst ops: (List String) -> Step
  (let [(bin (str st.installDir "/asl"))]
    (if st.dry
      (do (say! (str "  would probe: " bin " '(:tools)' must list " (spaceList ops))) (go st))
      (mt (tempDir! "asl-probe")
        ((err e) (die! e))
        ((ok dir)
          (let [(ran (runArgv! (list bin "(:tools :scope :all)") (some dir) (some (probeEnv! st.home)) 120000))
                (out (trimNewlines (mt ran ((ok r) (str r.out r.errText)) ((err e) e))))
                (failed (mt ran ((ok r) (not (= r.code 0))) ((err _) true)))]
            (cond
              ((listEmpty? ops)
                (do (pathRemove dir) (die! "the embedded skill documents no ops; re-render with scripts/install.sh --render-rules")))
              ((portableEntry? st.entry)
                (let [(answered (filter (fn [op] (answersOp? bin op st.home dir)) ops))
                      (rm (pathRemove dir))]
                  (if (listEmpty? answered)
                    (do (unlinkCreated! st) (die! (str "installed portable CLI " bin " failed to answer any ops; links removed: " (trimNewlines (sliceTo out 400)))))
                    (do (say! (str "  installed portable CLI answers ops: " (spaceList answered)))
                        (go (withAnsweredOps st (spaceList answered)))))))
              (failed
                (do (pathRemove dir) (unlinkCreated! st) (die! (str "installed " bin " failed to answer (:tools); links removed: " (trimNewlines (sliceTo out 400))))))
              (else
                (let [(rm (pathRemove dir))
                      (missing (filter (fn [op] (not (servesOp? out op))) ops))]
                  (if (listEmpty? missing)
                    (go st)
                    (do (unlinkCreated! st) (die! (str "installed " bin " (" st.entry ") does not serve ops the skill documents:" (fold (fn [acc m] (str acc " " m)) "" missing) " (its (:tools) has no (:op :name ...) entries for them; links removed)"))))))))))))

fn spaceList xs: (List String) -> String
  (fold (fn [acc x] (str acc x " ")) "" xs)

fn trimNewlines s: String -> String
  (if (stringEndsWith? s "\n") (trimNewlines (sliceTo s (- (stringLength s) 1))) s)

fn addToPath! st: Inst config: String -> Bool
  (let [(dir st.installDir)]
    (if (and (isRegular! config) (not (stringContains? (resultOr (fileReadString config) "") dir)))
      (if st.dry
        (say! (str "  would append PATH export for " dir " to " config))
        (mt (fileWrite config (str (resultOr (fileReadString config) "") "\n# AgentScript (ASL) CLI\nexport PATH=\"" dir ":$PATH\"\n"))
          ((ok _) (say! (str "✓ Added " dir " to " config)))
          ((err e) (warn! (str "install.sh: " e)))))
      true))

(schema Civil (:f y Int64) (:f m Int64) (:f d Int64))

fn civilFromDays z0: Int64 -> Civil
  (let [(z (+ z0 719468))
        (era (/ (if (>= z 0) z (- z 146096)) 146097))
        (doe (- z (* era 146097)))
        (yoe (/ (- (- (+ doe (/ doe 36524)) (/ doe 1460)) (/ doe 146096)) 365))
        (doy (- doe (- (+ (* 365 yoe) (/ yoe 4)) (/ yoe 100))))
        (mp (/ (+ (* 5 doy) 2) 153))
        (d (+ (- doy (/ (+ (* 153 mp) 2) 5)) 1))
        (m (if (< mp 10) (+ mp 3) (- mp 9)))
        (y (+ (+ yoe (* era 400)) (if (<= m 2) 1 0)))]
    (Civil :y y :m m :d d))

fn pad2 n: Int64 -> String
  (if (< n 10) (str "0" (stringFromInt64 n)) (stringFromInt64 n))

fn stamp! -> String
  (let [(secs (/ (nowNs) 1000000000))
        (days (/ secs 86400))
        (rem (- secs (* days 86400)))
        (c (civilFromDays days))]
    (str (stringFromInt64 c.y) (pad2 c.m) (pad2 c.d) (pad2 (/ rem 3600)) (pad2 (/ (mod rem 3600) 60)) (pad2 (mod rem 60)) "-" (stringFromInt64 (procSelf))))

fn backupTag home: String path: String -> String
  (let [(rel (if (stringStartsWith? path (str home "/")) (sliceFrom path (+ (stringLength home) 1)) path))
        (stripped (dropLeading rel))]
    (stringReplace (stringReplace stripped "/" "_") "." "_"))

fn dropLeading s: String -> String
  (if (or (stringStartsWith? s ".") (stringStartsWith? s "/")) (dropLeading (sliceFrom s 1)) s)

fn writeSkill! st: Inst text: String dir: String -> Bool
  (if st.dry
    (say! (str "  would write " dir "/SKILL.md"))
    (let [(made (dirCreate dir))
          (tmp (str dir "/SKILL.md." (stringFromInt64 (procSelf)) ".tmp"))]
      (mt (fileWrite tmp text)
        ((err e) (warn! (str "install.sh: " e)))
        ((ok _) (mt (pathRename tmp (str dir "/SKILL.md"))
                  ((ok _) (say! (str "  ✓ Installed skill: " dir "/SKILL.md")))
                  ((err e) (warn! (str "install.sh: " e))))))))

fn blank? l: String -> Bool
  (stringEmpty? (stringReplace (stringReplace (stringReplace (stringReplace l " " "") "\t" "") "\r" "") "\n" ""))

fn stripBlock text: String -> String
  (let [(kept (listReverse (pairSecond (fold (fn [(acc (Pair Bool (List String))) (l String)] -> (Pair Bool (List String))
                                               (cond
                                                 ((stringContains? l "<!-- ASL_TOOLBELT_START -->") (pair true (pairSecond acc)))
                                                 ((stringContains? l "<!-- ASL_TOOLBELT_END -->") (pair false (pairSecond acc)))
                                                 ((pairFirst acc) acc)
                                                 (else (pair false (cons l (pairSecond acc))))))
                                         (pair false (list)) (splitLines text)))))
        (lastIdx (lastNonBlank kept 0 -1))
        (upto (listTake kept (+ lastIdx 1)))
        (trimmed (dropBlanks upto))]
    (joinLines (listReverse (pairSecond (fold (fn [(acc (Pair Bool (List String))) (l String)] -> (Pair Bool (List String))
                                                (let [(b (blank? l))]
                                                  (if (and b (pairFirst acc)) (pair b (pairSecond acc)) (pair b (cons l (pairSecond acc))))))
                                          (pair false (list)) trimmed)))))

fn lastNonBlank xs: (List String) i: Int64 last: Int64 -> Int64
  (mt (listHead xs)
    ((none) last)
    ((some l) (lastNonBlank (optionOr (listTail xs) (list)) (+ i 1) (if (blank? l) last i))))

fn dropBlanks xs: (List String) -> (List String)
  (mt (listHead xs) ((some l) (if (blank? l) (dropBlanks (optionOr (listTail xs) (list))) xs)) ((none) xs))

fn copyFile! src: String dst: String -> (Result Unit String)
  (mt (fileReadBytes src) ((ok b) (fileWrite dst b)) ((err e) (err e)))

fn copyTree! src: String dst: String -> (Result Unit String)
  (if (isDir! src)
    (mt (dirCreate dst)
      ((err e) (err e))
      ((ok _) (mt (dirList src)
                ((err e) (err e))
                ((ok names) (fold (fn [acc n] (mt acc ((ok _) (copyTree! (str src "/" n) (str dst "/" n))) ((err e) (err e)))) (ok ()) names)))))
    (copyFile! src dst))

fn stripToolbelt! st: Inst backupRoot: String stampText: String target: String -> Bool
  (let [(text (resultOr (fileReadString target) ""))]
    (cond
      ((not (and (isRegular! target) (stringContains? text "<!-- ASL_TOOLBELT_START -->"))) true)
      ((not (stringContains? text "<!-- ASL_TOOLBELT_END -->")) (warn! (str "  ⚠\u{FE0F} " target " has ASL_TOOLBELT_START without ASL_TOOLBELT_END; left unchanged")))
      (st.dry (say! (str "  would back up and strip the ASL_TOOLBELT block from " target)))
      (else
        (let [(bdir (str backupRoot "/directives-" stampText))
              (saved (mt (dirCreate bdir) ((ok _) (copyFile! target (str bdir "/" (backupTag st.home target)))) ((err e) (err e))))]
          (if (err? saved)
            (warn! (str "  ⚠\u{FE0F} Failed to back up " target "; left unchanged"))
            (let [(out (stripBlock text))]
              (if (stringEmpty? out)
                (do (pathRemove target) (say! (str "  ✓ Removed legacy toolbelt directive file: " target " (backup in " bdir ")")))
                (mt (fileWrite (str target "." (stringFromInt64 (procSelf)) ".tmp") out)
                  ((err e) (warn! (str "install.sh: " e)))
                  ((ok _) (do (pathRename (str target "." (stringFromInt64 (procSelf)) ".tmp") target)
                              (say! (str "  ✓ Stripped legacy toolbelt block: " target " (backup in " bdir ")"))))))))))))

fn agentMatch? selected: String id: String -> Bool
  (or (= selected "all") (stringContains? (str "," selected ",") (str "," id ",")))

fn readLine! prompt: String tty: String -> (Option String)
  (if (not (or (= tty "tty") (= tty "devtty")))
    (none)
    (do (writeErr! prompt) (readLineFrom! "")))

fn readLineFrom! acc: String -> (Option String)
  (mt (fdRead 0 1)
    ((err _) (none))
    ((ok c) (cond
              ((stringEmpty? c) (none))
              ((= c "\n") (some (trimBlanks acc)))
              (else (readLineFrom! (str acc c))))))

fn trimBlanks s: String -> String
  (stringTrim s)

fn detected! home: String -> (List Bool)
  (list (isDir! (str home "/.claude"))
        (or (isDir! (str home "/.cursor")) (isRegular! (str home "/.cursorrules")))
        (isDir! (str home "/.codeium/windsurf"))
        (isDir! (str home "/.gemini"))
        (isDir! (str home "/.factory"))
        (isDir! (str home "/.codex")))

fn flagAt xs: (List Bool) i: Int64 -> Bool
  (optionOr (listGet xs i) false)

fn detectLine! on: Bool yes: String no: String -> Bool
  (say! (if on yes no))

(schema Choice (:f proceed Bool) (:f selected String))

fn chooseAgents! st: Inst -> Choice
  (cond
    ((not (stringEmpty? st.filter)) (Choice :proceed true :selected st.filter))
    ((and (not st.autoYes) (not (= st.tty "none")))
      (let [(p1 (say! ""))
            (ans (stringLower (optionOr (readLine! "\u{1F916} Install the asl-toolbelt skill for AI coding agents? [Y/n] " st.tty) "y")))]
        (if (or (= ans "n") (= ans "no"))
          (do (say! "⚡ Skipping agent skills setup.") (Choice :proceed false :selected ""))
          (let [(p2 (say! ""))
                (all (stringLower (optionOr (readLine! "Configure all detected agents? [Y/n] " st.tty) "y")))]
            (if (or (= all "n") (= all "no"))
              (let [(p3 (say! "Available agent IDs: claude, cursor, windsurf, gemini, factory, codex, agents"))
                    (picked (stringLower (optionOr (readLine! "Enter comma-separated agent IDs: " st.tty) "all")))]
                (Choice :proceed true :selected (if (stringEmpty? picked) "all" picked)))
              (Choice :proceed true :selected "all"))))))
    (else (do (say! "Mode: Automatic setup (all detected agents enabled).") (Choice :proceed true :selected "all"))))

fn leakedSkills -> (List String)
  (list "impl" "imple" "plan-verifier" "orchestration" "steps" "steps-implement" "steps-plan" "steps-review")

fn agentHomes home: String -> (List String)
  (map (fn [d] (str home d))
    (list "/.gemini/config/plugins/toolbelt/skills" "/.gemini/config/skills" "/.gemini/skills" "/.claude/skills" "/.cursor/skills" "/.codeium/windsurf/skills" "/.factory/skills" "/.codex/skills" "/.agents/skills"))

fn purgeOne! st: Inst backupDir: String backedUp: Int64 d: String s: String -> Int64
  (let [(target (str d "/" s))
        (isStub (and (isDir! target) (or st.purge (and (isRegular! (str target "/SKILL.md")) (stringContains? (resultOr (fileReadString (str target "/SKILL.md")) "") "<!-- ASL_INTERNAL_WORKFLOW_STUB -->")))))]
    (cond
      ((not isStub) backedUp)
      (st.dry (do (say! (str "  would archive and remove legacy ASL stub: " target)) backedUp))
      (else
        (let [(b (if (= backedUp 0) (if (ok? (dirCreate backupDir)) 1 -1) backedUp))
              (ns (str backupDir "/" (backupTag st.home d)))]
          (if (and (= b 1) (ok? (dirCreate ns)) (ok? (copyTree! target (str ns "/" s))))
            (do (if (and (ok? (pathRemove target)) (not (pathExists? target)))
                  (say! (str "  ✓ Archived and removed legacy ASL stub: " target " (backup in " ns ")"))
                  (warn! (str "  ⚠\u{FE0F} Archived to " ns " but failed to remove " target)))
                b)
            (do (warn! (str "  ⚠\u{FE0F} Failed to back up " target "; preserving without removal for V0 safety")) b))))))

fn pluginJson -> String
  "{\n  \"name\": \"toolbelt\",\n  \"description\": \"Pure-ASN asl toolbelt skill: bounded reads and symbol slices, edits validated at staging, batched check and test gates.\"\n}\n"

fn stepGemini! st: Inst text: String selected: String gemini: Bool -> Step
  (if (and (or (agentMatch? selected "gemini") (agentMatch? selected "antigravity")) (or gemini (not (= selected "all"))))
    (let [(home st.home)
          (plugin (str home "/.gemini/config/plugins/toolbelt"))]
      (do (writeSkill! st text (str home "/.gemini/config/skills/asl-toolbelt"))
          (writeSkill! st text (str home "/.gemini/skills/asl-toolbelt"))
          (then (act! st (list "mkdir" "-p" (str plugin "/skills")))
            (fn [s1] (then (act! s1 (list "rm" "-rf" (str plugin "/harnesses")))
                       (fn [s2] (do (if s2.dry (say! (str "  would write " plugin "/plugin.json")) (mt (fileWrite (str plugin "/plugin.json") (pluginJson)) ((ok _) true) ((err e) (warn! (str "install.sh: " e)))))
                                    (writeSkill! s2 text (str plugin "/skills/asl-toolbelt"))
                                    (go s2))))))))
    (go st))

fn stepSkills! st: Inst text: String -> Step
  (if st.skip
    (do (say! "⚡ Skipping agent skills installation (--no-skills specified).") (go st))
    (let [(home st.home)
          (banner (do (say! "") (say! "================================================================================")
                      (say! "         AgentScript (ASL) Multi-Agent Toolbelt Skill Setup                    ")
                      (say! "================================================================================")))
          (has (detected! home))
          (shown (do (say! "Detected AI coding agent environments:")
                     (detectLine! (flagAt has 0) "  [✓] Claude Code (~/.claude)" "  [ ] Claude Code")
                     (detectLine! (flagAt has 1) "  [✓] Cursor (~/.cursor)" "  [ ] Cursor")
                     (detectLine! (flagAt has 2) "  [✓] Windsurf (~/.codeium/windsurf)" "  [ ] Windsurf")
                     (detectLine! (flagAt has 3) "  [✓] Antigravity / Gemini (~/.gemini)" "  [ ] Antigravity / Gemini")
                     (detectLine! (flagAt has 4) "  [✓] Factory Droid (~/.factory)" "  [ ] Factory Droid")
                     (detectLine! (flagAt has 5) "  [✓] Codex / OpenAI (~/.codex)" "  [ ] Codex / OpenAI")
                     (say! "  [✓] Universal Agents Standard (~/.agents)")))
          (choice (chooseAgents! st))]
      (if (not choice.proceed)
        (go st)
        (let [(sel choice.selected)
              (backupRoot (str home "/.asl/backups"))
              (stampText (stamp!))
              (want (fn [id on] (and (agentMatch? sel id) (or on (not (= sel "all"))))))
              (w1 (do (say! "") (say! "--> Installing the asl-toolbelt skill...")
                      (if (agentMatch? sel "agents") (writeSkill! st text (str home "/.agents/skills/asl-toolbelt")) true)
                      (if (want "claude" (flagAt has 0)) (writeSkill! st text (str home "/.claude/skills/asl-toolbelt")) true)
                      (if (want "cursor" (flagAt has 1)) (writeSkill! st text (str home "/.cursor/skills/asl-toolbelt")) true)
                      (if (want "windsurf" (flagAt has 2)) (writeSkill! st text (str home "/.codeium/windsurf/skills/asl-toolbelt")) true)))]
          (then (stepGemini! st text sel (flagAt has 3))
            (fn [s1] (let [(w2 (do (if (want "factory" (flagAt has 4)) (writeSkill! s1 text (str home "/.factory/skills/asl-toolbelt")) true)
                                   (if (want "codex" (flagAt has 5)) (writeSkill! s1 text (str home "/.codex/skills/asl-toolbelt")) true)
                                   (fold (fn [acc f] (do (stripToolbelt! s1 backupRoot stampText f) acc)) true
                                     (map (fn [f] (str home f)) (list "/.claude/CLAUDE.md" "/.codex/AGENTS.md" "/.factory/AGENTS.md" "/.cursorrules" "/.agents/rules/asl-toolbelt.md" "/.cursor/rules/asl-toolbelt.mdc" "/.codeium/windsurf/rules/asl-toolbelt.md" "/.gemini/config/rules/asl-toolbelt.md" "/.gemini/config/plugins/toolbelt/rules/asl-toolbelt.md")))
                                   (retireCommand! s1 backupRoot stampText)
                                   (purgeAll! s1)))]
                       (then (act! s1 (list "rm" "-f" (str home "/.claude/commands/asl-build.md")))
                         (fn [s2] (do (say! "") (say! (if s2.dry "Dry run complete: nothing was written." "✓ asl-toolbelt skill installed for the selected agents.")) (go s2)))))))))))

fn retireCommand! st: Inst backupRoot: String stampText: String -> Bool
  (let [(cmd (str st.home "/.claude/commands/asl.md"))
        (bdir (str backupRoot "/directives-" stampText))]
    (cond
      ((not (and (isRegular! cmd) (stringContains? (resultOr (fileReadString cmd) "") "# /asl: Activate Native ASL Toolchain"))) true)
      (st.dry (say! (str "  would back up and remove " cmd)))
      ((and (ok? (dirCreate bdir)) (ok? (copyFile! cmd (str bdir "/claude_commands_asl.md"))))
        (do (pathRemove cmd) (say! (str "  ✓ Removed legacy /asl command (backup in " bdir ")"))))
      (else true)))

fn purgeAll! st: Inst -> Bool
  (let [(backupDir (str st.home "/.asl/backups/skills-" (stamp!)))]
    (do (fold (fn [b d] (fold (fn [b2 s] (purgeOne! st backupDir b2 d s)) b (leakedSkills))) 0 (agentHomes st.home))
        true))

fn stepPath! st: Inst -> Step
  (do (fold (fn [acc f] (do (addToPath! st (str st.home f)) acc)) true (list "/.zshrc" "/.bashrc" "/.profile"))
      (say! (if st.dry
             (str "Dry run: would install " st.installDir "/asl -> " st.entry)
             (if (stringEmpty? st.answeredOps)
               (str "✓ ASL installed and answering (:tools): " st.installDir "/asl -> " st.entry)
               (str "✓ ASL installed, portable CLI, ops available: " (stringTrim st.answeredOps)))))
      (go st))

fn argAt args: (List String) i: Int64 -> String
  (optionOr (listGet args i) "")

fn codeOf s: Step -> Int64
  (mt s ((go _) 0) ((stop c) c))

fn installMain! args: (List String) -> Int64
  (let [(o (parseOpts (listDrop args 5) (Opts :dry false :autoYes false :filter "" :skip false :purge false :force false :sourceDir "" :home (optionOr (envGet "HOME") "") :bad "" :code 0)))
        (home o.home)]
    (cond
      ((not (stringEmpty? o.bad)) (do (warn! o.bad) o.code))
      ((not (stringStartsWith? home "/")) (do (warn! (str "install.sh: HOME must be an absolute path, got '" home "'")) 2))
      (else
        (let [(st (Inst :tree (argAt args 0) :from (argAt args 1) :tty (argAt args 2) :os (argAt args 3) :arch (argAt args 4) :home home
                        :installDir (str home "/.asl/bin") :dry o.dry :autoYes o.autoYes :filter o.filter :skip o.skip :purge o.purge
                        :force o.force :sourceDir o.sourceDir :entry "" :prebuilt false :links (list) :answeredOps ""))
              (hdr (if o.dry (say! (str "Dry run: nothing is written; HOME=" home)) true))]
          (codeOf
            (then (stepSource! st) (fn [s1]
            (then (stepPrebuilt! s1) (fn [s2]
            (then (stepCheckout! s2) (fn [s3]
            (then (stepClone! s3) (fn [s4]
            (then (stepLinks! s4) (fn [s5]
              (mt (skillText! s5)
                ((err e) (die! e))
                ((ok text)
                  (then (stepProbe! s5 (skillOps text)) (fn [s6]
                  (then (stepPath! s6) (fn [s7]
                    (stepSkills! s7 text))))))))))))))))))))))

fn ! main args: (List String) -> (Result Int64 String)
  (ok (installMain! args))
