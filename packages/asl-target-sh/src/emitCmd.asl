(module asl-target-sh/emitCmd
  :x [escapeCmdString
      formatCmdEcho
      formatCmdCall
      formatCmdScript]
  :i [])

fn escapeCmdString s: String -> String
  (let [(s1 (stringReplace s "^" "^^"))
        (s2 (stringReplace s1 "&" "^&"))
        (s3 (stringReplace s2 "|" "^|"))
        (s4 (stringReplace s3 "<" "^<"))]
    (stringReplace s4 ">" "^>"))

fn formatCmdEcho msg: String -> String
  (str "echo " (escapeCmdString msg) "\n")

fn formatCmdCall cmd: String args: (List String) -> String
  (let [(joined (stringJoin args " "))]
    (if (= joined "")
      (str cmd "\n")
      (str cmd " " joined "\n")))

fn formatCmdScript comments: (List String) lines: (List String) -> String
  (let [(headerComments (map (fn [(c String)] -> String (str ":: " c "\n")) comments))
        (commentsJoined (stringJoin headerComments ""))
        (bodyJoined (stringJoin lines "\n"))]
    (str
      "@echo off\n"
      "setlocal enableextensions\n"
      ":: Generated by AgentSlang (ASL) Target Generator (asl-target-sh/emitCmd). DO NOT EDIT BY HAND.\n\n"
      commentsJoined
      (if (= commentsJoined "") "" "\n")
      bodyJoined
      "\n"))
