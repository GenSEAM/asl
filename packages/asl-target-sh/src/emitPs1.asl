(module asl-target-sh/emitPs1
  :x [escapePs1SingleQuotes
      escapePs1DoubleQuotes
      manglePs1Ident
      formatPs1Expr
      formatPs1Stmt
      formatPs1Function
      formatPs1Script]
  :i [(asl-target-sh/ast :a ast)])

fn escapePs1SingleQuotes s: String -> String
  (stringReplace s "'" "''")

fn escapePs1DoubleQuotes s: String -> String
  (let [(s1 (stringReplace s "`" "``"))
        (s2 (stringReplace s1 "\"" "`\""))]
    (stringReplace s2 "$" "`$"))

fn manglePs1Ident name: String -> String
  (let [(cleaned (stringReplace name "-" "_"))]
    cleaned)

fn makePs1Indent level: Int64 -> String
  (cond
    ((<= level 0) "")
    ((= level 1) "    ")
    ((= level 2) "        ")
    ((= level 3) "            ")
    (else "                "))

fn formatPs1Expr expr: ast/ShExpr -> String
  (let [(tag expr.tag)]
    (cond
      ((= tag "litStr")
        (let [(kind expr.quoteKind)
              (rawVal expr.strVal)]
          (if (= kind "single")
            (str "'" (escapePs1SingleQuotes rawVal) "'")
            (if (= kind "double")
              (str "\"" (escapePs1DoubleQuotes rawVal) "\"")
              rawVal))))
      ((= tag "litInt")
        (stringFromInt64 expr.intVal))
      ((= tag "var")
        (let [(vName (manglePs1Ident expr.strVal))]
          (str "$" vName)))
      ((= tag "binOp")
        (let [(lOpt expr.left)
              (rOpt expr.right)]
          (let [(l (mt lOpt ((some x) (formatPs1Expr x)) ((none) "")))
                (r (mt rOpt ((some y) (formatPs1Expr y)) ((none) "")))]
            (str l " " expr.op " " r))))
      (else "")))

fn formatPs1Stmt stmt: ast/ShStmt indent: Int64 -> String
  (let [(ind (makePs1Indent indent))
        (tag stmt.tag)]
    (cond
      ((= tag "assign")
        (let [(vName (manglePs1Ident stmt.name))
              (valStr (formatPs1Expr stmt.expr))]
          (str ind "$" vName " = " valStr "\n")))
      ((= tag "if")
        (let [(testStr (formatPs1Expr stmt.expr))
              (thenCode (stringJoin (map (fn [(s ast/ShStmt)] -> String (formatPs1Stmt s (+ indent 1))) stmt.thenStmts) ""))
              (elseList stmt.elseStmts)]
          (if (listEmpty? elseList)
            (str ind "if (" testStr ") {\n" thenCode ind "}\n")
            (let [(elseCode (stringJoin (map (fn [(s ast/ShStmt)] -> String (formatPs1Stmt s (+ indent 1))) elseList) ""))]
              (str ind "if (" testStr ") {\n" thenCode ind "} else {\n" elseCode ind "}\n")))))
      ((= tag "call")
        (let [(cmdName (manglePs1Ident stmt.name))
              (argStrs (map (fn [(a ast/ShExpr)] -> String (formatPs1Expr a)) stmt.args))
              (argsJoined (if (listEmpty? argStrs) "" (str " " (stringJoin argStrs " "))))]
          (str ind cmdName argsJoined "\n")))
      ((= tag "return")
        (let [(codeStr (formatPs1Expr stmt.expr))]
          (str ind "return " codeStr "\n")))
      ((= tag "exit")
        (let [(codeStr (formatPs1Expr stmt.expr))]
          (str ind "exit " codeStr "\n")))
      (else "")))

fn formatPs1Function fnDef: ast/ShFunction -> String
  (let [(name (manglePs1Ident fnDef.name))
        (bodyStrs (map (fn [(s ast/ShStmt)] -> String (formatPs1Stmt s 1)) fnDef.body))
        (bodyJoined (if (listEmpty? bodyStrs) "    # no-op\n" (stringJoin bodyStrs "")))]
    (str "function " name " {\n" bodyJoined "}\n\n"))

fn formatPs1Script comments: (List String) functions: (List ast/ShFunction) body: (List ast/ShStmt) -> String
  (let [(headerComments (map (fn [(c String)] -> String (str "# " c "\n")) comments))
        (commentsJoined (stringJoin headerComments ""))
        (fnStrs (map (fn [(f ast/ShFunction)] -> String (formatPs1Function f)) functions))
        (fnsJoined (stringJoin fnStrs ""))
        (bodyStrs (map (fn [(s ast/ShStmt)] -> String (formatPs1Stmt s 0)) body))
        (bodyJoined (stringJoin bodyStrs ""))]
    (str
      "# Generated by AgentScript (ASL) Target Generator (asl-target-sh/emitPs1). DO NOT EDIT BY HAND.\n"
      "$ErrorActionPreference = \"Stop\"\n\n"
      commentsJoined
      (if (= commentsJoined "") "" "\n")
      fnsJoined
      bodyJoined))
