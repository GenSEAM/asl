(module asl/packages/asl-derive/tests/codecDerivationTest :x [RunTests runTests] :i [(asl-derive/derive :a drv) (asl-sql/schemaGen :a sg)])

(schema UserRecord (:f id Int) (:f name Str) (:f active Bool) (:f email (Option Str)))

(schema Point2D (:f x Int) (:f y Int) (:f label Str))

fn makeUserFields -> (List drv/FieldDef)
  (list (drv/makeField "id" "Int" false) (drv/makeField "name" "Str" false) (drv/makeField "active" "Bool" false) (drv/makeField "email" "Str" true))

fn makePointFields -> (List drv/FieldDef)
  (list (drv/makeField "x" "Int" false) (drv/makeField "y" "Int" false) (drv/makeField "label" "Str" false))

fn testJsonCodecDerivation -> Bool
  (let [(userSchema (drv/makeRecordSchema "UserRecord" "users" (some "id") (makeUserFields))) (pointSchema (drv/makeRecordSchema "Point2D" "points" (none) (makePointFields))) (userCodec (drv/deriveJsonCodec userSchema)) (pointCodec (drv/deriveJsonCodec pointSchema)) (uVals1 (list (pair "id" "101") (pair "name" "\"Alice\"") (pair "active" "true") (pair "email" "\"alice@example.com\""))) (uVals2 (list (pair "id" "102") (pair "name" "\"Bob\"") (pair "active" "false") (pair "email" "null"))) (pVals (list (pair "x" "45") (pair "y" "90") (pair "label" "\"Origin\""))) (json1 (drv/formatRecordToJson userSchema uVals1)) (json2 (drv/formatRecordToJson userSchema uVals2)) (jsonP (drv/formatRecordToJson pointSchema pVals)) (parsed1 (drv/parseJsonToFieldPairs userSchema json1)) (parsed2 (drv/parseJsonToFieldPairs userSchema json2)) (parsedP (drv/parseJsonToFieldPairs pointSchema jsonP))] (assert (= userCodec.status "ok") "UserRecord JSON codec generation must succeed") (assert (= userCodec.schemaName "UserRecord") "Codec must reference UserRecord schema") (assert (stringContains? userCodec.encoderSource "serializeUserRecordToJson") "Encoder source must declare serializeUserRecordToJson") (assert (stringContains? userCodec.encoderSource "r.id") "Encoder source must directly access id field") (assert (stringContains? userCodec.encoderSource "r.name") "Encoder source must directly access name field") (assert (stringContains? userCodec.encoderSource "r.active") "Encoder source must directly access active field") (assert (stringContains? userCodec.encoderSource "r.email") "Encoder source must directly access email field") (assert (stringContains? userCodec.decoderSource "deserializeUserRecordFromJson") "Decoder source must declare deserializeUserRecordFromJson") (assert (stringContains? userCodec.decoderSource ":id") "Decoder source must bind id field") (assert (stringContains? userCodec.decoderSource ":email") "Decoder source must bind email field") (assert (= pointCodec.status "ok") "Point2D JSON codec generation must succeed") (assert (= pointCodec.schemaName "Point2D") "Codec must reference Point2D schema") (assert (stringContains? pointCodec.encoderSource "serializePoint2DToJson") "Encoder source must declare serializePoint2DToJson") (assert (stringContains? pointCodec.encoderSource "r.x") "Encoder source must directly access x coordinate") (assert (stringContains? pointCodec.encoderSource "r.y") "Encoder source must directly access y coordinate") (assert (stringContains? pointCodec.encoderSource "r.label") "Encoder source must directly access label field") (assert (stringContains? json1 "\"id\": 101") "JSON output must contain serialized id") (assert (stringContains? json1 "\"name\": \"Alice\"") "JSON output must contain serialized name") (assert (stringContains? json1 "\"email\": \"alice@example.com\"") "JSON output must contain optional email") (assert (stringContains? json2 "\"email\": null") "None option must serialize to JSON null") (assert (stringContains? jsonP "\"label\": \"Origin\"") "Point JSON must contain label") (assert (= (listLength parsed1) 4) "Parsed UserRecord 1 must contain 4 fields") (assert (= (listLength parsedP) 3) "Parsed Point2D must contain 3 fields") (refute (stringContains? userCodec.encoderSource "...") "Refutation: UserRecord encoder source must not contain dummy ellipsis") (refute (stringContains? userCodec.decoderSource "...") "Refutation: UserRecord decoder source must not contain dummy ellipsis") (refute (stringContains? pointCodec.encoderSource "...") "Refutation: Point2D encoder source must not contain dummy ellipsis") (refute (stringContains? userCodec.encoderSource "reflection") "Refutation: Generated code must contain zero runtime reflection") (refute (stringContains? json2 "\"email\": \"alice@example.com\"") "Refutation: Bob JSON must not contain Alice email") (refute (= json1 json2) "Refutation: Distinct user records must produce distinct JSON representations") (refute (= json1 jsonP) "Refutation: Distinct schemas must produce distinct JSON representations") true)

fn testAsnCodecDerivation -> Bool
  (let [(userSchema (drv/makeRecordSchema "UserRecord" "users" (some "id") (makeUserFields))) (pointSchema (drv/makeRecordSchema "Point2D" "points" (none) (makePointFields))) (userCodec (drv/deriveAsnCodec userSchema)) (pointCodec (drv/deriveAsnCodec pointSchema)) (uVals1 (list (pair "id" "201") (pair "name" "\"Carol\"") (pair "active" "true") (pair "email" "(some \"carol@asl.org\")"))) (uVals2 (list (pair "id" "202") (pair "name" "\"Dan\"") (pair "active" "false") (pair "email" "(none)"))) (pVals (list (pair "x" "10") (pair "y" "20") (pair "label" "\"Target\""))) (asn1 (drv/formatRecordToAsn userSchema uVals1)) (asn2 (drv/formatRecordToAsn userSchema uVals2)) (asnP (drv/formatRecordToAsn pointSchema pVals)) (parsed1 (drv/parseAsnToFieldPairs userSchema asn1)) (parsed2 (drv/parseAsnToFieldPairs userSchema asn2)) (parsedP (drv/parseAsnToFieldPairs pointSchema asnP))] (assert (= userCodec.status "ok") "ASN codec generation must succeed") (assert (stringContains? userCodec.encoderSource "serializeUserRecordToAsn") "Encoder source must declare serializeUserRecordToAsn") (assert (stringContains? userCodec.encoderSource "(:UserRecord") "Encoder source must format :UserRecord tag") (assert (stringContains? userCodec.encoderSource ":id") "Encoder source must format :id field") (assert (stringContains? userCodec.encoderSource ":name") "Encoder source must format :name field") (assert (stringContains? userCodec.encoderSource ":email") "Encoder source must format :email field") (assert (stringContains? userCodec.decoderSource "deserializeUserRecordFromAsn") "Decoder source must declare deserializeUserRecordFromAsn") (assert (= pointCodec.status "ok") "Point2D ASN codec generation must succeed") (assert (stringContains? pointCodec.encoderSource "serializePoint2DToAsn") "Point2D encoder source must declare serializePoint2DToAsn") (assert (stringContains? pointCodec.encoderSource "(:Point2D") "Point2D encoder source must format :Point2D tag") (assert (stringStartsWith? asn1 "(:UserRecord") "ASN serialization must start with type identifier tag") (assert (stringContains? asn1 ":id 201") "ASN serialization must contain :id key-value pair") (assert (stringContains? asn1 ":email (some \"carol@asl.org\")") "ASN serialization must contain wrapped (some ...) option") (assert (stringContains? asn2 ":email (none)") "ASN serialization of none must serialize to (none)") (assert (stringStartsWith? asnP "(:Point2D") "Point ASN must start with :Point2D") (assert (= (listLength parsed1) 4) "Parsed UserRecord must yield 4 field pairs") (assert (= (listLength parsedP) 3) "Parsed Point2D must yield 3 field pairs") (refute (stringContains? userCodec.encoderSource "...") "Refutation: ASN encoder source must not contain dummy ellipsis") (refute (stringContains? userCodec.decoderSource "...") "Refutation: ASN decoder source must not contain dummy ellipsis") (refute (stringContains? pointCodec.encoderSource "...") "Refutation: Point ASN encoder source must not contain dummy ellipsis") (refute (stringContains? asn1 ":email (none)") "Refutation: Record with email must not serialize to (none)") (refute (= asn1 asn2) "Refutation: Distinct ASN records must not produce identical ASN text") (refute (= asn1 asnP) "Refutation: Distinct schemas must produce distinct ASN representations") true)

fn testVariantCodecDerivation -> Bool
  (let [(cases (list (drv/makeVariantCase "Circle" (some "Int")) (drv/makeVariantCase "Rect" (some "Int")) (drv/makeVariantCase "Empty" (none)))) (vSchema (drv/makeVariantSchema "Shape" cases)) (vCodec (drv/deriveVariantCodec vSchema))] (assert (= vCodec.status "ok") "Variant codec generation must succeed") (assert (= vCodec.schemaName "Shape") "Variant codec must reference Shape schema") (assert (= vCodec.totalCases 3) "Variant codec must account for 3 arms") (assert (= vCodec.caseNames "Circle,Rect,Empty") "Variant codec must list all case tags") (assert (stringContains? vCodec.encoderSource "serializeShapeToAsn") "Variant encoder must declare serializeShapeToAsn") (assert (stringContains? vCodec.encoderSource "(Circle payload)") "Variant encoder must match Circle payload") (assert (stringContains? vCodec.encoderSource "(Rect payload)") "Variant encoder must match Rect payload") (assert (stringContains? vCodec.encoderSource "(Empty)") "Variant encoder must match unit Empty constructor") (assert (stringContains? vCodec.decoderSource "deserializeShapeFromAsn") "Variant decoder must declare deserializeShapeFromAsn") (refute (stringContains? vCodec.encoderSource "...") "Refutation: Variant encoder must not contain dummy ellipsis") (refute (stringContains? vCodec.decoderSource "...") "Refutation: Variant decoder must not contain dummy ellipsis") (refute (= vCodec.totalCases 0) "Refutation: Total cases cannot be zero") true)

fn testSqlSchemaDerivation -> Bool
  (let [(userSchema (drv/makeRecordSchema "UserRecord" "users" (some "id") (makeUserFields))) (pointSchema (drv/makeRecordSchema "Point2D" "points" (none) (makePointFields))) (pgSql (sg/deriveSqlTableSchema userSchema "postgres")) (sqliteSql (sg/deriveSqlTableSchema userSchema "sqlite")) (duckSql (sg/deriveSqlTableSchema userSchema "duckdb")) (pointSql (sg/deriveSqlTableSchema pointSchema "sqlite"))] (assert (stringContains? pgSql "CREATE TABLE IF NOT EXISTS users") "Postgres DDL must contain CREATE TABLE clause") (assert (stringContains? pgSql "id BIGINT PRIMARY KEY") "Postgres DDL must declare BIGINT PRIMARY KEY for id") (assert (stringContains? pgSql "name TEXT NOT NULL") "Postgres DDL must declare non-nullable TEXT name") (assert (stringContains? pgSql "active BOOLEAN NOT NULL") "Postgres DDL must declare non-nullable BOOLEAN active") (assert (stringContains? pgSql "email TEXT") "Postgres DDL must declare nullable TEXT email") (assert (stringContains? sqliteSql "CREATE TABLE IF NOT EXISTS users") "SQLite DDL must contain CREATE TABLE clause") (assert (stringContains? sqliteSql "id INTEGER PRIMARY KEY") "SQLite DDL must declare INTEGER PRIMARY KEY for id") (assert (stringContains? duckSql "CREATE TABLE IF NOT EXISTS users") "DuckDB DDL must contain CREATE TABLE clause") (assert (stringContains? duckSql "id BIGINT PRIMARY KEY") "DuckDB DDL must declare BIGINT PRIMARY KEY for id") (assert (stringContains? pointSql "CREATE TABLE IF NOT EXISTS points") "Point SQLite DDL must contain points table") (assert (stringContains? pointSql "x INTEGER NOT NULL") "Point SQLite DDL must declare non-nullable x") (assert (stringContains? pointSql "y INTEGER NOT NULL") "Point SQLite DDL must declare non-nullable y") (assert (stringContains? pointSql "label TEXT NOT NULL") "Point SQLite DDL must declare non-nullable label") (refute (stringContains? pgSql "email TEXT NOT NULL") "Refutation: Optional email column must not carry NOT NULL in Postgres") (refute (stringContains? sqliteSql "email TEXT NOT NULL") "Refutation: Optional email column must not carry NOT NULL in SQLite") (refute (stringContains? pgSql "id INTEGER PRIMARY KEY") "Refutation: Postgres 64-bit int primary key must not use INTEGER") (refute (= pgSql "") "Refutation: Postgres DDL must not be empty string") (refute (= pgSql pointSql) "Refutation: Distinct schemas must yield distinct DDL") true)

fn testRecordVisitorDerivation -> Bool
  (let [(userSchema (drv/makeRecordSchema "UserRecord" "users" (some "id") (makeUserFields))) (pointSchema (drv/makeRecordSchema "Point2D" "points" (none) (makePointFields))) (userVis (drv/deriveRecordVisitor userSchema)) (pointVis (drv/deriveRecordVisitor pointSchema))] (assert (= userVis.status "ok") "UserRecord visitor generation must succeed") (assert (= userVis.schemaName "UserRecord") "Visitor must reference UserRecord") (assert (= userVis.totalFields 4) "UserRecord visitor must account for 4 fields") (assert (= userVis.fieldNames "id,name,active,email") "Visitor must enumerate all field names") (assert (stringContains? userVis.visitorSource "visitUserRecordFields") "Visitor source must declare visitUserRecordFields") (assert (stringContains? userVis.visitorSource "(visitor \"id\" \"Int\" r.id)") "Visitor source must directly access id") (assert (stringContains? userVis.visitorSource "(visitor \"name\" \"Str\" r.name)") "Visitor source must directly access name") (assert (stringContains? userVis.visitorSource "(visitor \"active\" \"Bool\" r.active)") "Visitor source must directly access active") (assert (= pointVis.status "ok") "Point2D visitor generation must succeed") (assert (= pointVis.schemaName "Point2D") "Visitor must reference Point2D") (assert (= pointVis.totalFields 3) "Point2D visitor must account for 3 fields") (assert (= pointVis.fieldNames "x,y,label") "Point2D visitor must enumerate x,y,label") (assert (stringContains? pointVis.visitorSource "visitPoint2DFields") "Visitor source must declare visitPoint2DFields") (assert (stringContains? pointVis.visitorSource "(visitor \"x\" \"Int\" r.x)") "Point2D visitor must directly access x") (refute (stringContains? userVis.visitorSource "...") "Refutation: UserRecord visitor source must not contain dummy ellipsis") (refute (stringContains? pointVis.visitorSource "...") "Refutation: Point2D visitor source must not contain dummy ellipsis") (refute (= userVis.totalFields 0) "Refutation: UserRecord total fields cannot be zero") (refute (= userVis.fieldNames pointVis.fieldNames) "Refutation: Distinct schemas must yield distinct field names") true)

fn runTests -> Bool
  (let [(okJson (testJsonCodecDerivation)) (okAsn (testAsnCodecDerivation)) (okVariant (testVariantCodecDerivation)) (okSql (testSqlSchemaDerivation)) (okVis (testRecordVisitorDerivation))] (and (and (and okJson okAsn) okVariant) (and okSql okVis)))

fn RunTests -> Bool
  (runTests)
