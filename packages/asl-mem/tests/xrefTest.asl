(module aslMem/testXref :x [runTests] :i [(aslMem/xref :a x)])

fn runTests -> Bool
  (let [(g0 (x/makeXrefGraph))
        (g1 (x/xrefAddEdge g0 "task:A" "task:B" "depends-on"))
        (g2 (x/xrefAddEdge g1 "task:B" "adr:001" "provenance"))
        (g3 (x/xrefAddEdge g2 "task:A" "task:C" "prerequisite"))
        (depsB (x/findDependents g3 "task:B"))
        (prereqsA (x/findPrerequisites g3 "task:A"))
        (provB (x/findProvenance g3 "task:B"))
        (fwdA (x/xrefForwardEdges g3 "task:A"))
        (bwdB (x/xrefBackwardEdges g3 "task:B"))]
    (assert (x/xrefHasNode? g3 "task:A") "Graph must contain task:A")
    (assert (x/xrefHasNode? g3 "task:B") "Graph must contain task:B")
    (assert (x/xrefHasNode? g3 "task:C") "Graph must contain task:C")
    (assert (x/xrefHasNode? g3 "adr:001") "Graph must contain adr:001")
    (assert (not (x/xrefHasNode? g3 "task:UNKNOWN")) "Graph must not contain unknown node")
    (assert (listContains? depsB "task:A") "task:A must depend on task:B")
    (assert (not (listContains? depsB "task:C")) "task:C must not depend on task:B")
    (assert (listContains? prereqsA "task:C") "task:C must be prerequisite of task:A")
    (assert (listContains? provB "adr:001") "adr:001 must be provenance of task:B")
    (assert (listContains? fwdA "task:B") "Forward edges of A must contain B")
    (assert (listContains? fwdA "task:C") "Forward edges of A must contain C")
    (assert (listContains? bwdB "task:A") "Backward edges of B must contain A")
    true)
