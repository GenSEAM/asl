(module aslMem/tests/visibilityScopeTest :x [runTests testIsolatedSessionScope testWorkspaceLineageScope testSovereignSystemScope testGlobalAnchorPredicate] :i [(visibilityScope :a vs)])

fn testIsolatedSessionScope -> Bool
  (let [(ctx (vs/makeVisibilityContext "/tmp/scratch" "sess-unanchored" "/home/user/.asl" false "" "" (list) (list "/home/user/projects/asex" "/home/user/projects/datahub-react") (list) (list "sess-unanchored" "sess-peer-1" "sess-peer-2") (list "repo-genseam" "repo-datahub-react")))] (assert (= ctx.tier (vs/tierIsolatedSession)) "Tier must resolve to tier-isolated-session") (assert (= (listLength ctx.visibleWorktrees) 0) "Zero worktrees must be visible in isolated session") (assert (= (listLength ctx.visibleRepos) 0) "Zero repositories must be visible in isolated session") (assert (= (listLength ctx.visibleSessionIds) 1) "Only own session must be visible") (assert (= (preludeHead ctx.visibleSessionIds) "sess-unanchored") "Visible session must match active session ID") true)

fn testWorkspaceLineageScope -> Bool
  (let [(childWts (list "/home/user/projects/worktrees/genseam-feat-1" "/home/user/projects/worktrees/genseam-hotfix")) (allWts (list "/home/user/projects/asex" "/home/user/projects/worktrees/genseam-feat-1" "/home/user/projects/datahub-react" "/home/user/projects/fronts/react")) (wsSessions (list "sess-child-agent-1")) (allSessions (list "sess-main" "sess-child-agent-1" "sess-datahub-agent")) (ctx (vs/makeVisibilityContext "/home/user/projects/asex" "sess-main" "/home/user/.asl" true "/home/user/projects/asex" "repo-genseam" childWts allWts wsSessions allSessions (list "repo-genseam" "repo-datahub-react")))] (assert (= ctx.tier (vs/tierWorkspaceLineage)) "Tier must resolve to tier-workspace-lineage") (assert (= ctx.activeWorkspaceRoot "/home/user/projects/asex") "Active workspace root must match current workspace") (assert (= (listLength ctx.visibleWorktrees) 3) "Visible worktrees must contain workspace root and both children") (assert (= (listLength ctx.visibleRepos) 1) "Only current repository must be visible") (assert (= (preludeHead ctx.visibleRepos) "repo-genseam") "Visible repository must be repo-genseam") (assert (= (listLength ctx.visibleSessionIds) 2) "Only active and child workspace sessions must be visible") true)

fn testSovereignSystemScope -> Bool
  (let [(allWts (list "/home/user/projects/asex" "/home/user/projects/datahub-react" "/home/user/projects/pcp")) (allSessions (list "sess-1" "sess-2" "sess-3")) (allRepos (list "repo-genseam" "repo-datahub-react" "repo-pcp")) (ctx (vs/makeVisibilityContext "/home/user" "sess-sovereign-admin" "/home/user/.asl" false "" "" (list) allWts (list) allSessions allRepos))] (assert (= ctx.tier (vs/tierSovereignSystem)) "Tier must resolve to tier-sovereign-system") (assert (= (listLength ctx.visibleWorktrees) 3) "All 3 system worktrees must be visible") (assert (= (listLength ctx.visibleRepos) 3) "All 3 system repositories must be visible") (assert (= (listLength ctx.visibleSessionIds) 3) "All 3 system sessions must be visible") true)

fn testGlobalAnchorPredicate -> Bool
  (do (assert (vs/isGlobalAslAnchor? "/home/user" "/home/user/.asl") "Exact parent of .asl must return true") (assert (vs/isGlobalAslAnchor? "/home/user/" "/home/user/.asl/") "Trailing slash variants must return true") (assert (not (vs/isGlobalAslAnchor? "/home/user/projects/asex" "/home/user/.asl")) "Child workspace must return false") (assert (not (vs/isGlobalAslAnchor? "/tmp" "/home/user/.asl")) "Unrelated path must return false") true)

fn runTests -> Bool
  (let [(t1 (testIsolatedSessionScope)) (t2 (testWorkspaceLineageScope)) (t3 (testSovereignSystemScope)) (t4 (testGlobalAnchorPredicate))] (and t1 (and t2 (and t3 t4))))
