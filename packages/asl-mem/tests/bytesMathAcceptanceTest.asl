(module asl-mem/tests/bytesMathAcceptanceTest :x [runTests RunTests! testBytesAllocationAndIndexing testBytesVectorMathAccuracy! testBytesBase64Roundtrip! testHighDimensionalVectorPerformance! testDualPolarityRefutations!] :i [(aslMem/math :a math)])

fn testBytesAllocationAndIndexing -> Bool
  (let [(b (bytesAlloc 64))] (assert (= (bytesLength b) 64) "bytesAlloc 64 allocates exactly 64 bytes (8 float64 slots)") (bytesSetFloat64 b 0 3.141592653589793) (bytesSetFloat64 b 1 2.718281828459045) (bytesSetFloat64 b 7 42.0) (assert (< (abs (- (bytesGetFloat64 b 0) 3.141592653589793)) 0.0000000001) "slot 0 reads back pi") (assert (< (abs (- (bytesGetFloat64 b 1) 2.718281828459045)) 0.0000000001) "slot 1 reads back e") (assert (= (bytesGetFloat64 b 7) 42.0) "slot 7 reads back 42.0") (assert (= (bytesGetFloat64 b 2) 0.0) "uninitialized slot 2 is 0.0") true)

fn testBytesVectorMathAccuracy! -> Bool
  (let [(v1 (math/bytesFromListF64! (list 1.0 2.0 3.0))) (v2 (math/bytesFromListF64! (list 4.0 5.0 6.0))) (dot (math/vectorDotBytes v1 v2))] (assert (= (bytesLength v1) 24) "v1 has 3 slots * 8 = 24 bytes") (assert (= (bytesLength v2) 24) "v2 has 3 slots * 8 = 24 bytes") (assert (= dot 32.0) "dot product 1*4 + 2*5 + 3*6 = 32.0") (let [(norm1 (math/vectorNormBytes v1)) (norm2 (math/vectorNormBytes v2)) (cosSim (math/vectorCosineSimBytes v1 v2))] (assert (> norm1 3.74) "norm1 is approx sqrt(14) ~ 3.7416") (assert (< norm1 3.75) "norm1 upper bound") (assert (> cosSim 0.97) "cosine similarity is > 0.97") (assert (<= cosSim 1.0) "cosine similarity is <= 1.0") (let [(orth1 (math/bytesFromListF64! (list 1.0 0.0))) (orth2 (math/bytesFromListF64! (list 0.0 1.0)))] (assert (= (math/vectorDotBytes orth1 orth2) 0.0) "orthogonal vectors have dot product 0.0") (assert (= (math/vectorCosineSimBytes orth1 orth2) 0.0) "orthogonal vectors have cosine similarity 0.0") true)))

fn testBytesBase64Roundtrip! -> Bool
  (let [(b (bytesAlloc 32))] (bytesSetFloat64 b 0 10.5) (bytesSetFloat64 b 1 -20.25) (bytesSetFloat64 b 2 30.125) (bytesSetFloat64 b 3 -40.0625) (let [(b64 (bytesToBase64 b)) (restored (resultOr (bytesFromBase64 b64) (bytesAlloc 0)))] (assert (> (stringLength b64) 0) "base64 encoding is non-empty") (assert (= (bytesLength restored) 32) "restored bytes has identical 32-byte length") (assert (= (bytesGetFloat64 restored 0) 10.5) "restored slot 0 matches") (assert (= (bytesGetFloat64 restored 1) -20.25) "restored slot 1 matches") (assert (= (bytesGetFloat64 restored 2) 30.125) "restored slot 2 matches") (assert (= (bytesGetFloat64 restored 3) -40.0625) "restored slot 3 matches") true))

fn populateBufferLoop! b: Bytes idx: I64 count: I64 val: F64 -> Unit
  (if (>= idx count) () (do (bytesSetFloat64 b idx val) (populateBufferLoop! b (+ idx 1) count (+ val 0.001))))

fn testHighDimensionalVectorPerformance! -> Bool
  (let [(dim 1536) (byteSize (* dim 8)) (v1 (bytesAlloc byteSize)) (v2 (bytesAlloc byteSize))] (populateBufferLoop! v1 0 dim 0.01) (populateBufferLoop! v2 0 dim 0.02) (let [(dot (math/vectorDotBytes v1 v2))] (assert (> dot 0.0) "1536-dim dot product is computed cleanly and > 0") (let [(norm1 (math/vectorNormBytes v1)) (norm2 (math/vectorNormBytes v2)) (sim (math/vectorCosineSimBytes v1 v2))] (assert (> norm1 0.0) "norm1 is positive") (assert (> norm2 0.0) "norm2 is positive") (assert (> sim 0.99) "nearly parallel vectors have similarity > 0.99") (assert (<= sim 1.0) "similarity does not exceed 1.0") true)))

fn testDualPolarityRefutations! -> Bool
  (let [(b (bytesAlloc 16))] (refute (= (bytesLength b) 0) "bytesAlloc 16 refutes zero length") (refute (= (bytesLength b) 32) "bytesAlloc 16 refutes 32 length") (assert (= (bytesLength b) 16) "bytesAlloc 16 length is 16") (refute (!= (bytesGetFloat64 b 0) 0.0) "uninitialized slot refutes non-zero") (assert (= (bytesGetFloat64 b 0) 0.0) "uninitialized slot is 0.0") (let [(v1 (math/bytesFromListF64! (list 1.0 0.0))) (v2 (math/bytesFromListF64! (list 0.0 1.0))) (vSame (math/bytesFromListF64! (list 1.0 0.0))) (vOpp (math/bytesFromListF64! (list -1.0 0.0)))] (refute (> (math/vectorDotBytes v1 v2) 0.00001) "orthogonal dot product refutes positive") (refute (< (math/vectorDotBytes v1 v2) -0.00001) "orthogonal dot product refutes negative") (refute (< (math/vectorCosineSimBytes v1 vSame) 0.99999) "identical vectors refute cosine sim < 1") (refute (> (math/vectorCosineSimBytes v1 vOpp) -0.99999) "opposite vectors refute cosine sim > -1") (let [(vDiffDim (math/bytesFromListF64! (list 1.0 2.0 3.0)))] (refute (= (math/vectorDotBytes v1 vDiffDim) 100.0) "mismatched dimension dot product refutes arbitrary value") (assert (= (math/vectorDotBytes v1 vDiffDim) 0.0) "mismatched dimension dot product returns 0.0 safely")) (let [(zeroVec (math/bytesFromListF64! (list 0.0 0.0)))] (refute (> (math/vectorNormBytes zeroVec) 0.0) "zero vector refutes positive norm") (assert (= (math/vectorNormBytes zeroVec) 0.0) "zero vector norm is 0.0") (refute (> (math/vectorCosineSimBytes zeroVec v1) 0.0) "zero vector cosine sim refutes positive") (assert (= (math/vectorCosineSimBytes zeroVec v1) 0.0) "zero vector cosine sim is 0.0")) (let [(b64 (bytesToBase64 b))] (refute (stringEmpty? b64) "bytes base64 refutes empty string") (let [(fromEmpty (resultOr (bytesFromBase64 "") (bytesAlloc 1)))] (refute (> (bytesLength fromEmpty) 0) "empty base64 string refutes positive bytes length") (assert (= (bytesLength fromEmpty) 0) "empty base64 string produces 0 bytes"))) (let [(bEqual1 (bytesAlloc 8)) (bEqual2 (bytesAlloc 8))] (bytesSetFloat64 bEqual1 0 123.456) (bytesSetFloat64 bEqual2 0 123.456) (refute (!= bEqual1 bEqual2) "identically populated bytes refute inequality") (assert (= bEqual1 bEqual2) "identically populated bytes are equal") (bytesSetFloat64 bEqual2 0 999.0) (refute (= bEqual1 bEqual2) "differing bytes refute equality") (assert (!= bEqual1 bEqual2) "differing bytes are not equal")) true))

fn ! runTests -> Bool
  (do (assert (testBytesAllocationAndIndexing) "testBytesAllocationAndIndexing must pass") (assert (testBytesVectorMathAccuracy!) "testBytesVectorMathAccuracy must pass") (assert (testBytesBase64Roundtrip!) "testBytesBase64Roundtrip must pass") (assert (testHighDimensionalVectorPerformance!) "testHighDimensionalVectorPerformance must pass") (assert (testDualPolarityRefutations!) "testDualPolarityRefutations must pass") true)

fn RunTests! -> Bool
  (runTests)
