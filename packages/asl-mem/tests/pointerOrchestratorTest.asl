(module aslMem/tests/pointerOrchestratorTest :x [testContextChunkScoringAndDensity testContextChunkRankingAndBudgetBoundary testPerceptualPointerCreationAndFormats testDynamicPointerExpansionAndDereference! testPointerOrchestratorBudgetEnforcement testCrossTierBudgetBoundaries runTests] :i [(pointerOrchestrator :a po) (aslHarness/contextPriority :a cp)])

fn makeString1000 -> Str
  (let [(s10 "0123456789") (s100 (str s10 s10 s10 s10 s10 s10 s10 s10 s10 s10))] (str s100 s100 s100 s100 s100 s100 s100 s100 s100 s100))

fn makeString2400 -> Str
  (let [(s1000 (makeString1000)) (s10 "0123456789") (s100 (str s10 s10 s10 s10 s10 s10 s10 s10 s10 s10)) (s400 (str s100 s100 s100 s100))] (str s1000 s1000 s400))

fn testContextChunkScoringAndDensity -> Bool
  (let [(c1 (cp/scoreContextChunk "chunk-ast-1" "ast-outline" 100 0.9)) (c2 (cp/scoreContextChunk "chunk-diff-2" "recent-diff" 100 0.4)) (c3 (cp/scoreContextChunk "chunk-bulky-3" "ast-outline" 500 0.9))] (assert (= c1.chunkId "chunk-ast-1") "Chunk id matches") (assert (= c1.kind "ast-outline") "Chunk kind matches") (assert (> c1.priorityScore c2.priorityScore) "Higher relevance yields higher priority") (assert (> c1.priorityScore c3.priorityScore) "Bulky footprint penalized for equal relevance") (assert (not c1.retained) "Initial retained status is false") true)

fn testContextChunkRankingAndBudgetBoundary -> Bool
  (let [(c1 (cp/scoreContextChunk "c1" "ast-outline" 300 0.9)) (c2 (cp/scoreContextChunk "c2" "task-memory" 200 0.8)) (c3 (cp/scoreContextChunk "c3" "recent-diff" 400 0.7)) (c4 (cp/scoreContextChunk "c4" "ast-outline" 200 0.2)) (c5 (cp/scoreContextChunk "c5" "ast-outline" 600 0.1)) (ranked (cp/rankContextChunks (list c4 c2 c5 c1 c3))) (firstC (optionOr (listHead ranked) c4)) (budgeted (cp/applyTokenBudget ranked 1200)) (retained (cp/filterRetainedChunks budgeted)) (totalTok (cp/totalRetainedTokens budgeted)) (firstBudgeted (optionOr (listHead budgeted) c4)) (lastBudgeted (optionOr (listHead (listReverse budgeted)) c4))] (assert (= firstC.chunkId c2.chunkId) "Top ranked chunk is highest priority") (assert (>= (listLength retained) 3) "At least 3 chunks retained within budget") (assert (<= totalTok 1200) "Total retained tokens within budget ceiling") (assert (> totalTok 0) "Total retained tokens positive") (assert firstBudgeted.retained "First chunk retained") (assert (not lastBudgeted.retained) "Trailing chunk evicted") true)

fn testPerceptualPointerCreationAndFormats -> Bool
  (let [(p1 (po/makePointerSpec "ptr-sym-vfs" "sym" "vfs-read" 12 "VFS read symbol")) (p2 (po/makePointerSpec "ptr-file-vfs" "file" "asl/packages/asl-mem/src/vfs.asl" 10 "VFS module source")) (p3 (po/makePointerSpec "ptr-chunk-1" "chunk" "chunk-001" 14 "AST context chunk")) (fmt (po/formatPointerSpec p1)) (parsedOpt (po/parsePointerSpec fmt)) (parsedOk (mt parsedOpt ((none) false) ((some parsed) (and (= parsed.id "ptr-sym-vfs") (= parsed.tokens 12)))))] (assert (= p1.kind "sym") "Pointer kind is sym") (assert (= p2.tokens 10) "Pointer tokens match") (assert (= p3.target "chunk-001") "Target chunk id matches") (assert (stringStartsWith? fmt "(:ptr :kind \"sym\"") "Serialized prefix matches S-expression specification") (assert parsedOk "Parsed pointer matches serialized attributes") true)

fn testDynamicPointerExpansionAndDereference! -> Bool
  (let [(p (po/makePointerSpec "ptr-sym-vfs" "sym" "vfs-read" 12 "VFS read symbol")) (rawBody (makeString1000)) (expanded (po/derefPointer p rawBody)) (collapsed (po/collapsePointer expanded)) (rehydrated (po/rehydratePointer! collapsed))] (assert (not p.isExpanded) "Pointer unexpanded initially") (assert (= (po/totalActiveTokens (list p)) 12) "Compact token footprint is 12") (assert expanded.isExpanded "Pointer marked expanded after dereference") (assert (= (po/totalActiveTokens (list expanded)) 250) "Active tokens equals 250 after dereference") (assert (not collapsed.isExpanded) "Pointer marked unexpanded after collapse") (assert (= (po/totalActiveTokens (list collapsed)) 12) "Active tokens returns to 12 after collapse") (assert rehydrated.isExpanded "Rehydrated pointer marked expanded") (assert (= rehydrated.payload rawBody) "Rehydrated payload matches raw-body") (assert (= (po/totalActiveTokens (list rehydrated)) 250) "Active tokens equals 250 after rehydration") true)

fn testPointerOrchestratorBudgetEnforcement -> Bool
  (let [(payload2400 (makeString2400)) (p1 (po/derefPointer (po/makePointerSpec "p1" "sym" "s1" 15 "s1") payload2400)) (p2 (po/derefPointer (po/makePointerSpec "p2" "sym" "s2" 15 "s2") payload2400)) (p3 (po/derefPointer (po/makePointerSpec "p3" "sym" "s3" 15 "s3") payload2400)) (p4 (po/derefPointer (po/makePointerSpec "p4" "sym" "s4" 15 "s4") payload2400)) (p5 (po/derefPointer (po/makePointerSpec "p5" "sym" "s5" 15 "s5") payload2400)) (p6 (po/derefPointer (po/makePointerSpec "p6" "sym" "s6" 15 "s6") payload2400)) (orchestrated (po/orchestrateContextPointers (list p1 p2 p3 p4 p5 p6) 1500)) (firstP (optionOr (listHead orchestrated) p1)) (tail1 (optionOr (listTail orchestrated) (list))) (secondP (optionOr (listHead tail1) p1)) (lastP (optionOr (listHead (listReverse orchestrated)) p1))] (assert firstP.isExpanded "First priority pointer expanded") (assert secondP.isExpanded "Second priority pointer expanded") (assert (not lastP.isExpanded) "Trailing pointer collapsed into compact stub") (assert (< (po/totalActiveTokens orchestrated) 1500) "Total active tokens strictly below budget ceiling") (assert (po/isContextMinimal? orchestrated 1500) "Context remains strictly minimal under 1500 token ceiling") true)

fn testCrossTierBudgetBoundaries -> Bool
  (let [(slmRet (cp/totalRetainedTokens (cp/applyTokenBudget (list (cp/scoreContextChunk "c1" "k" 2000 0.9) (cp/scoreContextChunk "c2" "k" 1000 0.8)) 2500))) (midRet (cp/totalRetainedTokens (cp/applyTokenBudget (list (cp/scoreContextChunk "c1" "k" 5000 0.9) (cp/scoreContextChunk "c2" "k" 4000 0.8)) 8000))) (minimalCheck (po/isContextMinimal? (list (po/makePointerSpec "p1" "sym" "t1" 10 "s") (po/makePointerSpec "p2" "sym" "t2" 15 "s")) 1500)) (resExact (cp/applyTokenBudget (list (cp/scoreContextChunk "c-exact" "k" 500 0.9)) 500)) (exactFit (let [(h (optionOr (listHead resExact) (cp/scoreContextChunk "d" "k" 0 0.0)))] h.retained)) (resOver (cp/applyTokenBudget (list (cp/scoreContextChunk "c-over" "k" 501 0.9)) 500)) (overflowEvicted (let [(h (optionOr (listHead resOver) (cp/scoreContextChunk "d" "k" 0 0.0)))] (not h.retained)))] (assert (<= slmRet 2500) "SLM token budget ceiling enforced") (assert (<= midRet 8000) "Mid-tier token budget ceiling enforced") (assert minimalCheck "Minimal base context invariant verified") (assert exactFit "Exact-fit chunk retained") (assert overflowEvicted "Overflow chunk evicted") true)

fn testLosslessCollapseAndRehydrate! -> Bool
  (let [(p (po/makePointerSpec "ptr-lossless" "sym" "testSym" 12 "Lossless symbol")) (body "defn computeTotal [x y] (+ x y)") (expanded (po/derefPointer p body)) (collapsed (po/collapsePointer expanded))] (assert (not collapsed.isExpanded) "Collapsed pointer is not expanded") (assert (= collapsed.payload "") "Collapsed payload is empty") (assert (= collapsed.vfsRef body) "Collapsed pointer preserves vfs-ref") (let [(restored (po/rehydratePointer! collapsed))] (assert restored.isExpanded "Restored pointer is expanded") (assert (= restored.payload body) "Restored payload matches original body") true))

fn ! runTests -> Bool
  (and (testContextChunkScoringAndDensity) (and (testContextChunkRankingAndBudgetBoundary) (and (testPerceptualPointerCreationAndFormats) (and (testDynamicPointerExpansionAndDereference!) (and (testPointerOrchestratorBudgetEnforcement) (and (testCrossTierBudgetBoundaries) (testLosslessCollapseAndRehydrate!)))))))
