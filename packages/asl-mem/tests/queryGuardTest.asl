(module aslMem/queryGuardTest :x [runTests] :i [(aslMem/queryGuard :a qg)])

fn testInitialState -> Bool
  (let [(g (qg/makeQueryGuard "sess-1"))] (assert (= g.sessionId "sess-1") "SessionId matches") (assert (= g.helpCount 0) "Initial helpCount is 0") (assert (= g.emptyCount 0) "Initial emptyCount is 0") (assert (= g.invalidCount 0) "Initial invalidCount is 0") (assert (= g.hardHelpLimit 2) "Initial hardHelpLimit is 2") (assert (= g.hardInvalidLimit 3) "Initial hardInvalidLimit is 3") (assert (not (qg/isTripped? g)) "Initial guard is not tripped") (assert (not (qg/isTripped g)) "Initial guard isTripped alias is false") (assert (= (qg/remainingHelpBudget g) 2) "Initial help budget is 2") (assert (= (qg/remainingInvalidBudget g) 3) "Initial invalid budget is 3") (assert (stringContains? (qg/formatHelpBudget g) ":helpRemaining 2") "Budget format matches") true)

fn testHelpLimitAndTripping -> Bool
  (let [(g0 (qg/makeQueryGuard "sess-help")) (g1 (qg/recordHelpQuery g0)) (g2 (qg/recordHelpQuery g1)) (g3 (qg/recordHelpQuery g2)) (g4 (qg/recordHelpQuery g3))] (assert (= g1.helpCount 1) "1st help call count is 1") (assert (not (qg/isTripped? g1)) "1st help call does not trip") (assert (= (qg/remainingHelpBudget g1) 1) "1st help call leaves 1 remaining") (assert (stringContains? (qg/formatHelpBudget g1) ":helpRemaining 1") "Budget has 1 remaining") (assert (= g2.helpCount 2) "2nd help call count is 2") (assert (not (qg/isTripped? g2)) "2nd help call does not trip") (assert (= (qg/remainingHelpBudget g2) 0) "2nd help call leaves 0 remaining") (assert (stringContains? (qg/formatCircuitWarning g2) "[CIRCUIT_WARNING]") "Warning contains tag") (assert (= g3.helpCount 3) "3rd help call count is 3") (assert (qg/isTripped? g3) "3rd help call trips circuit breaker") (assert (= (qg/remainingHelpBudget g3) 0) "Tripped help budget clamped to 0") (let [(diag (qg/formatEscalationDiagnostic g3))] (assert (stringContains? diag ":circuit-breaker :status :tripped :tool \"mem\"") "Diagnostic has header") (assert (stringContains? diag "Hard help query limit exceeded (3 consecutive calls without state progression)") "Diagnostic has reason") (assert (stringContains? diag ":escalate :operator") "Diagnostic escalates to operator")) (assert (qg/isTripped? g4) "Subsequent help call remains tripped") (assert (= g4.helpCount 4) "4th help call count is 4") true)

fn testInvalidLimitAndTripping -> Bool
  (let [(i0 (qg/makeQueryGuard "sess-inv")) (i1 (qg/recordInvalidInvocation i0)) (i2 (qg/recordInvalidInvocation i1)) (i3 (qg/recordInvalidInvocation i2)) (i4 (qg/recordInvalidInvocation i3))] (assert (= i1.invalidCount 1) "1st invalid count is 1") (assert (not (qg/isTripped? i1)) "1st invalid does not trip") (assert (= (qg/remainingInvalidBudget i1) 2) "1st invalid leaves 2 remaining") (assert (= i2.invalidCount 2) "2nd invalid count is 2") (assert (not (qg/isTripped? i2)) "2nd invalid does not trip") (assert (= (qg/remainingInvalidBudget i2) 1) "2nd invalid leaves 1 remaining") (assert (= i3.invalidCount 3) "3rd invalid count is 3") (assert (qg/isTripped? i3) "3rd invalid trips circuit breaker") (assert (= (qg/remainingInvalidBudget i3) 0) "Tripped invalid budget clamped to 0") (let [(diag (qg/formatEscalationDiagnostic i3))] (assert (stringContains? diag ":circuit-breaker :status :tripped :tool \"mem\"") "Invalid diagnostic header") (assert (stringContains? diag "Hard invalid query limit exceeded (3 consecutive syntax/usage errors)") "Invalid diagnostic reason") (assert (stringContains? diag ":escalate :operator") "Invalid diagnostic escalates to operator")) (assert (qg/isTripped? i4) "Subsequent invalid call remains tripped") true)

fn testEmptyInvocationAndTripping -> Bool
  (let [(e0 (qg/makeQueryGuard "sess-empty")) (e1 (qg/recordEmptyInvocation e0)) (e2 (qg/recordEmptyInvocation e1)) (e3 (qg/recordEmptyInvocation e2))] (assert (= e1.emptyCount 1) "1st empty count is 1") (assert (= e1.invalidCount 1) "1st empty increments invalid count") (assert (not (qg/isTripped? e1)) "1st empty does not trip") (assert (= e2.emptyCount 2) "2nd empty count is 2") (assert (= e2.invalidCount 2) "2nd empty increments invalid count") (assert (not (qg/isTripped? e2)) "2nd empty does not trip") (assert (= e3.emptyCount 3) "3rd empty count is 3") (assert (= e3.invalidCount 3) "3rd empty increments invalid count") (assert (qg/isTripped? e3) "3rd empty trips circuit breaker") true)

fn testProductiveActionResetsHelp -> Bool
  (let [(g0 (qg/makeQueryGuard "sess-reset")) (g1 (qg/recordHelpQuery g0)) (g2 (qg/recordHelpQuery g1)) (g3 (qg/recordHelpQuery g2))] (assert (qg/isTripped? g3) "Precondition: guard is tripped after 3 help calls") (let [(res (qg/recordProductiveAction g3))] (assert (not (qg/isTripped? res)) "Productive action closes tripped circuit") (assert (= res.helpCount 0) "Help count reset to 0") (assert (= res.invalidCount 0) "Invalid count reset to 0") (assert (= res.emptyCount 0) "Empty count reset to 0") (assert (= res.lastAction "productive") "Last action is productive") (let [(h1 (qg/recordHelpQuery res)) (h2 (qg/recordHelpQuery h1))] (assert (not (qg/isTripped? h2)) "Can make 2 help calls after reset without trip") (let [(h3 (qg/recordHelpQuery h2))] (assert (qg/isTripped? h3) "Trips again on 3rd help call after reset")))) true)

fn testProductiveActionResetsInvalid -> Bool
  (let [(i0 (qg/makeQueryGuard "sess-inv-reset")) (i1 (qg/recordInvalidInvocation i0)) (i2 (qg/recordInvalidInvocation i1)) (i3 (qg/recordInvalidInvocation i2))] (assert (qg/isTripped? i3) "Precondition: guard tripped after 3 invalid calls") (let [(res (qg/recordProductiveActionWithAction i3 "replace"))] (assert (not (qg/isTripped? res)) "Productive action resets tripped invalid guard") (assert (= res.invalidCount 0) "Invalid count reset to 0") (assert (= res.lastAction "replace") "Last action is replace")) true)

fn testInterleavingResetsCounters -> Bool
  (let [(g0 (qg/makeQueryGuard "sess-interleaved")) (g1 (qg/recordHelpQuery g0)) (g2 (qg/recordHelpQuery g1))] (assert (= g2.helpCount 2) "2 help calls recorded") (assert (not (qg/isTripped? g2)) "Not yet tripped") (let [(p1 (qg/recordProductiveActionWithAction g2 "diff"))] (assert (= p1.helpCount 0) "Help count reset by intervening diff") (let [(g3 (qg/recordHelpQuery p1)) (g4 (qg/recordHelpQuery g3))] (assert (= g4.helpCount 2) "2 more help calls permitted") (assert (not (qg/isTripped? g4)) "Still not tripped after productive diff") true)))

fn testCustomLimitsAndReset -> Bool
  (let [(cg (qg/makeQueryGuardWithLimits "sess-custom" 1 1)) (c1 (qg/recordHelpQuery cg))] (assert (= cg.hardHelpLimit 1) "Custom help limit is 1") (assert (= cg.hardInvalidLimit 1) "Custom invalid limit is 1") (assert (not (qg/isTripped? c1)) "1st help within limit") (let [(c2 (qg/recordHelpQuery c1))] (assert (qg/isTripped? c2) "2nd help trips when limit is 1") (let [(rst (qg/resetQueryGuard c2))] (assert (not (qg/isTripped? rst)) "resetQueryGuard clears trip") (assert (= rst.helpCount 0) "resetQueryGuard zeroes count") true)))

fn testSerializationAndCustomDiagnostic -> Bool
  (let [(g (qg/makeQueryGuard "sess-ser")) (s (qg/formatQueryGuardState g))] (assert (stringContains? s "(:query-guard") "Serialized has tag") (assert (stringContains? s ":sessionId \"sess-ser\"") "Serialized has sessionId") (assert (stringContains? s ":helpCount 0") "Serialized has helpCount") (assert (stringContains? s ":hardHelpLimit 2") "Serialized has hardHelpLimit") (assert (stringContains? s ":hardInvalidLimit 3") "Serialized has hardInvalidLimit") (assert (stringContains? s ":isTripped false") "Serialized has isTripped false") (let [(custom (qg/formatEscalationDiagnosticWithReason g "Custom lock reason"))] (assert (stringContains? custom ":circuit-breaker :status :tripped :tool \"mem\"") "Custom diag has tool") (assert (stringContains? custom ":reason \"Custom lock reason\"") "Custom diag has reason") (assert (stringContains? custom ":escalate :operator") "Custom diag escalates")) true)

fn runTests -> Bool
  (do (assert (testInitialState) "testInitialState passed") (assert (testHelpLimitAndTripping) "testHelpLimitAndTripping passed") (assert (testInvalidLimitAndTripping) "testInvalidLimitAndTripping passed") (assert (testEmptyInvocationAndTripping) "testEmptyInvocationAndTripping passed") (assert (testProductiveActionResetsHelp) "testProductiveActionResetsHelp passed") (assert (testProductiveActionResetsInvalid) "testProductiveActionResetsInvalid passed") (assert (testInterleavingResetsCounters) "testInterleavingResetsCounters passed") (assert (testCustomLimitsAndReset) "testCustomLimitsAndReset passed") (assert (testSerializationAndCustomDiagnostic) "testSerializationAndCustomDiagnostic passed") true)
