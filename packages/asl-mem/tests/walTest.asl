(module aslMem/testWal :x [runTests] :i [(aslMem/wal :a w)])

fn runTests -> Bool
  (let [(entry (w/WalEntry :seqNum 1 :timestampEpoch 100 :opType (w/opPutVector) :key "k" :payload "p")) (frame (w/formatWalFrame entry))] (assert (stringContains? frame "(WalEntry") "frame has tag") (assert (stringContains? frame ":seq 1") "frame has seq") (assert (stringContains? frame ":epoch 100") "frame has epoch") (assert (stringContains? frame "\"v+\"") "frame has op") (assert (stringContains? frame "\"k\"") "frame has key") (assert (stringContains? frame "\"p\"") "frame has payload") (mt (w/parseWalFrame frame) ((some parsed) (assert (= parsed.seqNum 1) "parsed seqNum matches") (assert (= parsed.timestampEpoch 100) "parsed timestampEpoch matches") (assert (= (w/opTypeToString parsed.opType) "v+") "parsed opType matches") (assert (= parsed.key "k") "parsed key matches") (assert (= parsed.payload "p") "parsed payload matches")) ((none) (assert false "parseWalFrame returned none for formatted frame"))) true)
