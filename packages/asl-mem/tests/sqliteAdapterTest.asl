(module asl/packages/asl-mem/tests/sqliteAdapterTest :x [runTests RunTests testSqliteInitializationAndTableCreation testSqliteWriteAndReadRecord testSqliteIndexedQuery testSqliteDeleteRecord testDualPolarityRefutations] :i [(sqliteAdapter :a sa)])

fn testSqliteInitializationAndTableCreation -> Bool
  (let [(st (sa/initSqliteStorage "primary.db"))] (assert (= st.dbPath "primary.db") "Database path matches primary.db") (refute (!= st.dbPath "primary.db") "Database path must refute mismatch") (assert (sa/hasTable? st "tasks") "tasks table exists") (assert (sa/hasTable? st "decisions") "decisions table exists") (assert (sa/hasTable? st "notes") "notes table exists") (refute (sa/hasTable? st "phantom_table") "Phantom table must refute existence") (refute (sa/hasTable? st "audit_logs") "Undeclared table must refute existence") true)

fn testSqliteWriteAndReadRecord -> Bool
  (let [(st0 (sa/initSqliteStorage "test.db")) (taskId "task-101") (phase "Phase488") (status "pending") (payload "(:task :id \"task-101\" :status :pending)") (wRes1 (sa/sqliteWriteRecord st0 "tasks" taskId phase status payload))] (assert (ok? wRes1) "Writing initial record returns ok") (refute (err? wRes1) "Writing initial record must not return error") (let [(st1 (optionOr (mt wRes1 ((ok s) (some s)) ((err _) (none))) st0)) (rRes1 (sa/sqliteReadRecord st1 "tasks" taskId))] (assert (ok? rRes1) "Reading inserted record returns ok") (refute (err? rRes1) "Reading inserted record must not return error") (let [(row1 (optionOr (mt rRes1 ((ok r) (some r)) ((err _) (none))) (sa/makeEmptyRow)))] (assert (= row1.id taskId) "Row id matches task-101") (assert (= row1.phase phase) "Row phase matches Phase488") (assert (= row1.status status) "Row status matches pending") (assert (= row1.payload payload) "Row payload matches initial payload") (refute (!= row1.id taskId) "Row id must refute divergence") (refute (!= row1.phase phase) "Row phase must refute divergence") (let [(updatedPayload "(:task :id \"task-101\" :status :completed)") (wRes2 (sa/sqliteWriteRecord st1 "tasks" taskId phase "completed" updatedPayload))] (assert (ok? wRes2) "Updating existing record returns ok") (refute (err? wRes2) "Updating existing record must not return error") (let [(st2 (optionOr (mt wRes2 ((ok s) (some s)) ((err _) (none))) st1)) (rRes2 (sa/sqliteReadRecord st2 "tasks" taskId))] (assert (ok? rRes2) "Reading updated record returns ok") (let [(row2 (optionOr (mt rRes2 ((ok r) (some r)) ((err _) (none))) (sa/makeEmptyRow)))] (assert (= row2.status "completed") "Row status updated to completed") (assert (= row2.payload updatedPayload) "Row payload updated to new payload") (refute (= row2.status "pending") "Row status must refute old pending value") true))))))

fn testSqliteIndexedQuery -> Bool
  (let [(st0 (sa/initSqliteStorage "query.db")) (w1 (sa/sqliteWriteRecord st0 "tasks" "task-1" "PhaseA" "ready" "(:task :id \"task-1\")"))] (let [(st1 (optionOr (mt w1 ((ok s) (some s)) ((err _) (none))) st0)) (w2 (sa/sqliteWriteRecord st1 "tasks" "task-2" "PhaseA" "ready" "(:task :id \"task-2\")"))] (let [(st2 (optionOr (mt w2 ((ok s) (some s)) ((err _) (none))) st1)) (w3 (sa/sqliteWriteRecord st2 "tasks" "task-3" "PhaseA" "blocked" "(:task :id \"task-3\")"))] (let [(st3 (optionOr (mt w3 ((ok s) (some s)) ((err _) (none))) st2)) (w4 (sa/sqliteWriteRecord st3 "tasks" "task-4" "PhaseB" "ready" "(:task :id \"task-4\")"))] (let [(st4 (optionOr (mt w4 ((ok s) (some s)) ((err _) (none))) st3)) (qPhaseAReady (sa/sqliteQueryRecords st4 "tasks" "PhaseA" "ready")) (qPhaseABlocked (sa/sqliteQueryRecords st4 "tasks" "PhaseA" "blocked")) (qPhaseBReady (sa/sqliteQueryRecords st4 "tasks" "PhaseB" "ready")) (qNone (sa/sqliteQueryRecords st4 "tasks" "PhaseB" "blocked"))] (assert (ok? qPhaseAReady) "Query PhaseA ready returns ok") (refute (err? qPhaseAReady) "Query PhaseA ready must refute error") (let [(rowsAReady (optionOr (mt qPhaseAReady ((ok r) (some r)) ((err _) (none))) (list)))] (assert (= (listLength rowsAReady) 2) "PhaseA ready count must be 2") (refute (!= (listLength rowsAReady) 2) "PhaseA ready count must refute non-2") (let [(r0 (optionOr (listGet rowsAReady 0) (sa/makeEmptyRow))) (r1 (optionOr (listGet rowsAReady 1) (sa/makeEmptyRow)))] (assert (= r0.phase "PhaseA") "First row is PhaseA") (assert (= r0.status "ready") "First row is ready") (assert (= r1.phase "PhaseA") "Second row is PhaseA") (assert (= r1.status "ready") "Second row is ready") (refute (= r0.phase "PhaseB") "First row must not be PhaseB"))) (let [(rowsABlocked (optionOr (mt qPhaseABlocked ((ok r) (some r)) ((err _) (none))) (list)))] (assert (= (listLength rowsABlocked) 1) "PhaseA blocked count must be 1") (refute (!= (listLength rowsABlocked) 1) "PhaseA blocked count must refute non-1")) (let [(rowsBReady (optionOr (mt qPhaseBReady ((ok r) (some r)) ((err _) (none))) (list)))] (assert (= (listLength rowsBReady) 1) "PhaseB ready count must be 1") (refute (!= (listLength rowsBReady) 1) "PhaseB ready count must refute non-1")) (let [(rowsNone (optionOr (mt qNone ((ok r) (some r)) ((err _) (none))) (list)))] (assert (= (listLength rowsNone) 0) "PhaseB blocked count must be 0") (refute (!= (listLength rowsNone) 0) "PhaseB blocked count must refute non-0")) true)))))

fn testSqliteDeleteRecord -> Bool
  (let [(st0 (sa/initSqliteStorage "del.db")) (w (sa/sqliteWriteRecord st0 "decisions" "dec-01" "PhaseX" "accepted" "(:decision :id \"dec-01\")"))] (let [(st1 (optionOr (mt w ((ok s) (some s)) ((err _) (none))) st0)) (delRes (sa/sqliteDeleteRecord st1 "decisions" "dec-01"))] (assert (ok? delRes) "Deleting existing record returns ok") (refute (err? delRes) "Deleting existing record must not return error") (let [(st2 (optionOr (mt delRes ((ok s) (some s)) ((err _) (none))) st1)) (readDeleted (sa/sqliteReadRecord st2 "decisions" "dec-01")) (queryAfter (sa/sqliteQueryRecords st2 "decisions" "PhaseX" "accepted"))] (assert (err? readDeleted) "Reading deleted record returns error") (refute (ok? readDeleted) "Reading deleted record must refute ok") (let [(rowsAfter (optionOr (mt queryAfter ((ok r) (some r)) ((err _) (none))) (list)))] (assert (= (listLength rowsAfter) 0) "Query after delete returns empty list") (refute (!= (listLength rowsAfter) 0) "Query after delete must refute non-empty list")) (let [(readFromSt1 (sa/sqliteReadRecord st1 "decisions" "dec-01"))] (assert (ok? readFromSt1) "Original state st1 remains unchanged (immutable)") (refute (err? readFromSt1) "Original state st1 read must refute error")) true)))

fn testDualPolarityRefutations -> Bool
  (let [(st (sa/initSqliteStorage "guard.db")) (emptyRow (sa/makeEmptyRow))] (assert (= emptyRow.id "") "Empty row id is empty string") (assert (= emptyRow.phase "") "Empty row phase is empty string") (assert (= emptyRow.status "") "Empty row status is empty string") (assert (= emptyRow.payload "") "Empty row payload is empty string") (refute (!= emptyRow.id "") "Empty row id refutes non-empty") (let [(badTableWrite (sa/sqliteWriteRecord st "unknown" "1" "p" "s" "data")) (badTableRead (sa/sqliteReadRecord st "unknown" "1")) (badTableDel (sa/sqliteDeleteRecord st "unknown" "1")) (badTableQuery (sa/sqliteQueryRecords st "unknown" "p" "s"))] (assert (err? badTableWrite) "Write to unknown table errors") (refute (ok? badTableWrite) "Write to unknown table refutes ok") (assert (err? badTableRead) "Read from unknown table errors") (refute (ok? badTableRead) "Read from unknown table refutes ok") (assert (err? badTableDel) "Delete from unknown table errors") (refute (ok? badTableDel) "Delete from unknown table refutes ok") (assert (err? badTableQuery) "Query on unknown table errors") (refute (ok? badTableQuery) "Query on unknown table refutes ok")) (let [(emptyIdWrite (sa/sqliteWriteRecord st "tasks" "" "p" "s" "data")) (emptyIdRead (sa/sqliteReadRecord st "tasks" "")) (emptyIdDel (sa/sqliteDeleteRecord st "tasks" ""))] (assert (err? emptyIdWrite) "Write with empty id errors") (refute (ok? emptyIdWrite) "Write with empty id refutes ok") (assert (err? emptyIdRead) "Read with empty id errors") (refute (ok? emptyIdRead) "Read with empty id refutes ok") (assert (err? emptyIdDel) "Delete with empty id errors") (refute (ok? emptyIdDel) "Delete with empty id refutes ok")) (let [(missingRead (sa/sqliteReadRecord st "tasks" "absent-key")) (missingDel (sa/sqliteDeleteRecord st "tasks" "absent-key"))] (assert (err? missingRead) "Read absent key errors") (refute (ok? missingRead) "Read absent key refutes ok") (assert (err? missingDel) "Delete absent key errors") (refute (ok? missingDel) "Delete absent key refutes ok")) (let [(stAlpha (sa/initSqliteStorage "alpha.db")) (stBeta (sa/initSqliteStorage "beta.db"))] (assert (!= stAlpha.dbPath stBeta.dbPath) "Distinct states have distinct dbPath") (refute (= stAlpha.dbPath stBeta.dbPath) "Distinct states refute equal dbPath")) true)

fn runTests -> Bool
  (do (assert (testSqliteInitializationAndTableCreation) "testSqliteInitializationAndTableCreation passed") (assert (testSqliteWriteAndReadRecord) "testSqliteWriteAndReadRecord passed") (assert (testSqliteIndexedQuery) "testSqliteIndexedQuery passed") (assert (testSqliteDeleteRecord) "testSqliteDeleteRecord passed") (assert (testDualPolarityRefutations) "testDualPolarityRefutations passed") true)

fn RunTests -> Bool
  (runTests)
