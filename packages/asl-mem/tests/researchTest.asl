(module aslMem/tests/researchTest :x [runTests testResearchDirectHitZeroTokens testResearchCacheMissDelegation testResearchStoreAndRecall] :i [(research :a res)])

fn testResearchDirectHitZeroTokens -> Bool
  (let [(fact1 (res/makeResearchFact "fact-1" "agent memory architecture" "Deterministic direct hit returns zero tokens" "https://asl.dev/mem" 0.95)) (cache (res/storeResearchFact fact1 (list))) (outcome (res/queryResearchMemory "agent memory architecture" cache 0.85))] (assert outcome.isDirectHit "High confidence fact must trigger direct hit") (assert (= outcome.tokenCost 0) "Direct hit must incur zero token cost") (assert (not outcome.delegated) "Direct hit must not be delegated") (assert (= outcome.fact "Deterministic direct hit returns zero tokens") "Retrieved fact must match canonical fact text") true)

fn testResearchCacheMissDelegation -> Bool
  (let [(outcomeEmpty (res/queryResearchMemory "unseen esoteric theorem" (list) 0.85)) (lowFact (res/makeResearchFact "fact-2" "speculative query" "unverified hypothesis" "forum" 0.60)) (cache2 (res/storeResearchFact lowFact (list))) (outcomeLow (res/queryResearchMemory "speculative query" cache2 0.85))] (assert (not outcomeEmpty.isDirectHit) "Cache miss must not be direct hit") (assert (= outcomeEmpty.tokenCost 150) "Cache miss token cost must be 150") (assert outcomeEmpty.delegated "Cache miss must delegate to research agent") (assert (not outcomeLow.isDirectHit) "Low confidence fact must not trigger direct hit") (assert (= outcomeLow.tokenCost 150) "Low confidence fact query token cost must be 150") (assert outcomeLow.delegated "Low confidence fact query must delegate to research agent") true)

fn testResearchStoreAndRecall -> Bool
  (let [(cache0 (list)) (miss (res/queryResearchMemory "compiler pipeline phases" cache0 0.85))] (assert miss.delegated "Initial query before storage must delegate") (let [(newFact (res/makeResearchFact "fact-3" "compiler pipeline phases" "Lex, Parse, Check, Codegen" "manual" 0.92)) (cache1 (res/storeResearchFact newFact cache0)) (hit (res/queryResearchMemory "compiler pipeline phases" cache1 0.85))] (assert hit.isDirectHit "Subsequent query after storage must be direct hit") (assert (= hit.tokenCost 0) "Subsequent direct hit must incur 0 token cost") (assert (not hit.delegated) "Subsequent direct hit must not delegate") (assert (= hit.fact "Lex, Parse, Check, Codegen") "Recalled fact must match stored payload") (let [(updatedFact (res/makeResearchFact "fact-3" "compiler pipeline phases" "Lex, Parse, Check, Codegen, Verify" "manual-v2" 0.99)) (cache2 (res/storeResearchFact updatedFact cache1))] (assert (= (listLength cache2) 1) "Updating fact must maintain unique cache entry") (let [(hit2 (res/queryResearchMemory "compiler pipeline phases" cache2 0.85))] (assert (= hit2.fact "Lex, Parse, Check, Codegen, Verify") "Recalled fact must reflect updated payload") true))))

fn runTests -> Bool
  (and (testResearchDirectHitZeroTokens) (and (testResearchCacheMissDelegation) (testResearchStoreAndRecall)))
