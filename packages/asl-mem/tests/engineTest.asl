(module aslMem/engineTest :x [runTests testWalVectorRecovery] :i [(ring :a r) (wal :a w) (graph :a g) (snapshot :a snap) (engine :a eng)])

fn testRingBufferOverwrite -> Bool
  (let [(buf0 (r/makeRingBuffer 3 (r/policyOverwriteOldest))) (res1 (r/ringPush buf0 "item-1")) (res2 (r/ringPush res1.buffer "item-2")) (res3 (r/ringPush res2.buffer "item-3")) (isFull (r/ringIsFull? res3.buffer)) (res4 (r/ringPush res3.buffer "item-4")) (recent (r/ringPeekRecent res4.buffer 3))] (assert isFull "Ring buffer must be full after 3 pushes") (assert res4.wasEvicted "Fourth push must trigger eviction") (assert (= res4.buffer.evictedCount 1) "Evicted count must be 1") (assert (= (listLength recent) 3) "Recent items length must be 3") (assert (= (optionOr (listHead recent) "") "item-2") "Oldest retained item must be item-2") (assert (= (r/ringUtilization res4.buffer) 100) "Ring utilization must be 100") true)

fn testRingBufferReject -> Bool
  (let [(buf0 (r/makeRingBuffer 2 (r/policyReject))) (res1 (r/ringPush buf0 "a")) (res2 (r/ringPush res1.buffer "b")) (res3 (r/ringPush res2.buffer "c"))] (assert (r/ringIsFull? res2.buffer) "Ring buffer must be full at capacity 2") (assert res3.rejected "Pushing beyond capacity must be rejected") (assert (= (listLength res3.buffer.items) 2) "Items count must remain at capacity 2") true)

fn testWalSerialization -> Bool
  (let [(wal0 (w/makeWalState "/tmp/test.wal")) (pair1 (w/appendWalEntry wal0 (w/opPutVector) "v-1" "v:{v-1|sample|[0.1,0.2]}" 1740000000)) (entry (pairSecond pair1)) (frame (w/formatWalFrame entry)) (parsed (w/parseWalFrame frame))] (mt parsed ((some p) (do (assert (= p.seqNum 1) "Sequence number must be 1") (assert (= p.key "v-1") "Key must match v-1") (assert (= p.timestampEpoch 1740000000) "Timestamp must match 1740000000") true)) ((none) (do (assert false "Parsed entry must not be none") false))))

fn testGraphBatchAndIndex -> Bool
  (let [(n1 (g/GraphNode :id "n1" :label "pkg" :content "core" :timestampEpoch 1000 :confidence 1.0)) (n2 (g/GraphNode :id "n2" :label "pkg" :content "ui" :timestampEpoch 1000 :confidence 1.0)) (e1 (g/GraphEdge :sourceId "n1" :targetId "n2" :relation "imports" :weight 1.0 :timestampEpoch 1000)) (emptyG (g/KnowledgeGraph :nodes (list) :edges (list))) (gBatched (g/addNodesBatch emptyG (list n1 n2))) (gFull (g/addEdgesBatch gBatched (list e1))) (idx (g/buildGraphIndex gFull)) (foundN1 (g/findNodeFast idx "n1")) (neighbors (g/findNeighborsFast idx "n1")) (isFound (mt foundN1 ((some _) true) ((none) false)))] (assert (= (listLength gFull.nodes) 2) "Graph must contain 2 nodes") (assert (= (listLength gFull.edges) 1) "Graph must contain 1 edge") (assert isFound "Node n1 must be found in graph index") (assert (= (listLength neighbors) 1) "Node n1 must have 1 neighbor") true)

fn testEngineLifecycle -> Bool
  (let [(engine0 (eng/makeEngine (eng/modeJournaledWal) 10 "/tmp/eng.wal" "/tmp/snap.asn")) (node1 (g/GraphNode :id "ent-1" :label "concept" :content "Agentic RAM" :timestampEpoch 1000 :confidence 0.99)) (eng1 (eng/enginePutNode engine0 node1 1000)) (eng2 (eng/enginePutVector eng1 "v-1" "query embedding" (list 0.5 0.5) 1000)) (stats (eng/engineStats eng2)) (snapPair (eng/engineCheckpoint eng2 2000)) (snapText (pairSecond snapPair))] (assert (= stats.vectorCount 1) "Vector count must be 1") (assert (= stats.nodeCount 1) "Node count must be 1") (assert (stringContains? snapText ":snapshot-manifest") "Snapshot must contain header") (assert (stringContains? snapText "v:{v-1") "Snapshot must contain vector entry") true)

fn testWalCrashRecovery -> Bool
  (let [(e1 (w/WalEntry :seqNum 1 :timestampEpoch 1000 :opType (w/opPutNode) :key "n-1" :payload "n:{n-1|entity|1000|1.0|Alpha}")) (e2 (w/WalEntry :seqNum 2 :timestampEpoch 1001 :opType (w/opPutNode) :key "n-2" :payload "n:{n-2|entity|1001|1.0|Beta}")) (e3 (w/WalEntry :seqNum 3 :timestampEpoch 1002 :opType (w/opPutEdge) :key "n-1" :payload "e:{n-1|n-2|connects|1.0|1002}")) (e4 (w/WalEntry :seqNum 4 :timestampEpoch 1003 :opType (w/opDelNode) :key "n-1" :payload "DELETED")) (walLog (stringJoin (list (w/formatWalFrame e1) (w/formatWalFrame e2) (w/formatWalFrame e3) (w/formatWalFrame e4)) "\n")) (baseEng (eng/makeEngine (eng/modeJournaledWal) 10 "/tmp/eng.wal" "/tmp/snap.asn")) (recovered (eng/engineRecover baseEng walLog)) (stats (eng/engineStats recovered))] (assert (= stats.nodeCount 1) "Recovered node count must be 1") (assert (= stats.edgeCount 0) "Recovered edge count must be 0 after deletion") (assert (= stats.walEntriesCommitted 4) "Recovered WAL sequence must be 4") true)

fn testWalVectorRecovery -> Bool
  (let [(e1 (w/WalEntry :seqNum 1 :timestampEpoch 1000 :opType (w/opPutVector) :key "v-1" :payload "v:{v-1|query embedding|[0.5,0.5]}")) (e2 (w/WalEntry :seqNum 2 :timestampEpoch 1001 :opType (w/opPutVector) :key "v-2" :payload "v:{v-2|document embedding|[0.8,0.2]}")) (walLog (stringJoin (list (w/formatWalFrame e1) (w/formatWalFrame e2)) "\n")) (baseEng (eng/makeEngine (eng/modeJournaledWal) 10 "/tmp/eng.wal" "/tmp/snap.asn")) (recovered (eng/engineRecover baseEng walLog)) (stats (eng/engineStats recovered))] (assert (= stats.vectorCount 2) "Recovered vector count must be 2") (assert (= stats.walEntriesCommitted 2) "Recovered committed WAL sequence must be 2") true)

fn testWalRollback -> Bool
  (let [(wal0 (w/makeWalState "/tmp/test-rollback.wal")) (pair1 (w/appendWalEntry wal0 (w/opPutNode) "n-1" "node-data" 1000)) (pair2 (w/appendWalEntry (pairFirst pair1) (w/opPutNode) "n-2" "node-data-2" 1001)) (stDirty (pairFirst pair2)) (stRolled (w/walRollbackUnflushed stDirty))] (assert (= (listLength stDirty.unflushed) 2) "Dirty unflushed list length must be 2") (assert (= (listLength stRolled.unflushed) 0) "Rolled back unflushed list length must be 0") (assert (= stRolled.currentSeq 0) "Rolled back sequence must be 0") true)

fn runTests -> Bool
  (fold (fn [(acc Bool) (p Bool)] -> Bool (and acc p)) true (list (testRingBufferOverwrite) (testRingBufferReject) (testWalSerialization) (testGraphBatchAndIndex) (testEngineLifecycle) (testWalCrashRecovery) (testWalVectorRecovery) (testWalRollback)))
