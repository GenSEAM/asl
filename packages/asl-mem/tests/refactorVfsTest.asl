(module aslMem/refactorVfsTest :x [testStageRefactorDiff testCommitStagedRefactorSuccess testCommitStagedRefactorConflict testRollbackStagedRefactor testPreviewTokenSavings runTests] :i [(vfs :a v) (refactorVfs :a rv) (asl-compiler/compactRewrite :a cr)])

fn testStageRefactorDiff -> Bool
  (let [(reg0 (v/vfsInit)) (src "(let [(norm (normalize-path p))] (stringStartsWith? norm \"/root\"))") (reg1 (v/vfsWrite reg0 "src/main.asl" src)) (rules (cr/defaultCompactionRules)) (planOpt (rv/stageRefactorDiff reg1 "src/main.asl" rules))] (assert (some? planOpt) "Staging refactor diff on existing buffer must succeed") (mt planOpt ((none) false) ((some plan) (do (assert (> (stringLength plan.diff) 0) "Diff must not be empty for modified buffer") (assert (> plan.tokensSaved 0) "Estimated tokens saved must be greater than zero") (assert (= plan.stagedContent "(let [(norm (v/norm p))] (txt/starts? norm \"/root\"))") "Staged content must replace verbose tokens with modular aliases") (assert (= plan.status "staged") "Plan status must be staged") true))))

fn testCommitStagedRefactorSuccess -> Bool
  (let [(reg0 (v/vfsInit)) (src "(task-claim task-1 session-a)") (reg1 (v/vfsWrite reg0 "tasks/run.asl" src)) (rules (cr/defaultCompactionRules)) (planOpt (rv/stageRefactorDiff reg1 "tasks/run.asl" rules))] (assert (some? planOpt) "Plan must be created cleanly") (mt planOpt ((none) false) ((some plan) (let [(commitOpt (rv/commitStagedRefactor reg1 plan))] (assert (some? commitOpt) "Commit must succeed when buffer CAS hash matches base hash") (mt commitOpt ((none) false) ((some reg2) (let [(bufOpt (v/vfsRead reg2 "tasks/run.asl"))] (assert (some? bufOpt) "Committed buffer must be readable from updated registry") (mt bufOpt ((none) false) ((some b) (do (assert (= b.content "(task/claim task-1 session-a)") "Committed buffer must contain staged content") (assert (= b.casHash plan.stagedHash) "Committed buffer CAS hash must equal staged hash") true))))))))))

fn testCommitStagedRefactorConflict -> Bool
  (let [(reg0 (v/vfsInit)) (src "(supervise-step proc-1 0)") (reg1 (v/vfsWrite reg0 "proc/runner.asl" src)) (rules (cr/defaultCompactionRules)) (planOpt (rv/stageRefactorDiff reg1 "proc/runner.asl" rules))] (assert (some? planOpt) "Plan must be created cleanly") (mt planOpt ((none) false) ((some plan) (let [(regDrifted (v/vfsWrite reg1 "proc/runner.asl" "(supervise-step proc-1 999)")) (commitOpt (rv/commitStagedRefactor regDrifted plan))] (assert (none? commitOpt) "Commit must fail with none on CAS hash conflict") (let [(curBuf (optionOr (v/vfsRead regDrifted "proc/runner.asl") (v/VFSBuffer :path "" :content "" :baseContent "" :casHash "" :baseHash "" :revision 0 :dirty false :loadedAt 0)))] (assert (= curBuf.content "(supervise-step proc-1 999)") "Drifted content must remain untouched on rejected commit") true)))))

fn testRollbackStagedRefactor -> Bool
  (let [(reg0 (v/vfsInit)) (src "(stringContains? text \"needle\")") (reg1 (v/vfsWrite reg0 "search/query.asl" src)) (rules (cr/defaultCompactionRules)) (planOpt (rv/stageRefactorDiff reg1 "search/query.asl" rules))] (assert (some? planOpt) "Plan must be created cleanly") (mt planOpt ((none) false) ((some plan) (let [(commitOpt (rv/commitStagedRefactor reg1 plan))] (assert (some? commitOpt) "Initial commit must succeed") (mt commitOpt ((none) false) ((some reg2) (let [(regRolled (rv/rollbackStagedRefactor reg2 plan)) (bufRolled (optionOr (v/vfsRead regRolled "search/query.asl") (v/VFSBuffer :path "" :content "" :baseContent "" :casHash "" :baseHash "" :revision 0 :dirty false :loadedAt 0)))] (assert (= bufRolled.content src) "Rollback must restore pristine original content") (assert (= bufRolled.casHash plan.baseHash) "Rollback must restore original CAS base hash") true)))))))

fn testPreviewTokenSavings -> Bool
  (let [(rules (cr/defaultCompactionRules)) (src1 "(stringStartsWith? a b)") (s1 (rv/previewTokenSavings src1 rules)) (src2 "(stringStartsWith? (vfs-normalize-path file-path) \"/root/dir\")") (s2 (rv/previewTokenSavings src2 rules)) (src3 "(+ a b)") (s3 (rv/previewTokenSavings src3 rules))] (assert (= s1 2) "Single rule token savings must match rule specification") (assert (= s2 5) "Composite multi-rule token savings must equal sum of rule savings") (assert (= s3 0) "Unrelated expressions without verbose tokens must have 0 savings") true)

fn runTests -> Bool
  (do (assert (testStageRefactorDiff) "test-stage-refactor-diff must pass") (assert (testCommitStagedRefactorSuccess) "test-commit-staged-refactor-success must pass") (assert (testCommitStagedRefactorConflict) "test-commit-staged-refactor-conflict must pass") (assert (testRollbackStagedRefactor) "test-rollback-staged-refactor must pass") (assert (testPreviewTokenSavings) "test-preview-token-savings must pass") true)
