(module aslMem/tests/tokenRegexTest :x [runTests testCompileTokenPattern testMatchExactSequence testMatchQuantifiers testGreedyVsNongreedy testCaptureGroups testScanTokenStream testFindTokenSubsequences] :i [(tokenRegex :a tr)])

fn testCompileTokenPattern -> Bool
  (let [(m (tr/compileTokenPattern "def <fn-name> _* foo+ bar? any*? opt?? (?<rest>_)")) (pats m.patterns) (p0 (optionOr (listGet pats 0) (tr/TokenPattern :kind "" :literal (none) :quantifier "" :captureGroup (none)))) (p1 (optionOr (listGet pats 1) (tr/TokenPattern :kind "" :literal (none) :quantifier "" :captureGroup (none)))) (p2 (optionOr (listGet pats 2) (tr/TokenPattern :kind "" :literal (none) :quantifier "" :captureGroup (none)))) (p5 (optionOr (listGet pats 5) (tr/TokenPattern :kind "" :literal (none) :quantifier "" :captureGroup (none)))) (p7 (optionOr (listGet pats 7) (tr/TokenPattern :kind "" :literal (none) :quantifier "" :captureGroup (none))))] (assert (= (listLength pats) 8) "Matcher must compile exactly 8 pattern elements") (assert (and (= p0.kind "literal") (and (= p0.literal (some "def")) (= p0.quantifier "1"))) "Element 0 must be literal def with quantifier 1") (assert (and (= p1.kind "wildcard") (= p1.captureGroup (some "fn-name"))) "Element 1 must be wildcard with fn-name capture group") (assert (and (= p2.kind "wildcard") (= p2.quantifier "*")) "Element 2 must be wildcard with * quantifier") (assert (and (= p5.kind "any") (= p5.quantifier "*?")) "Element 5 must be any with *? non-greedy quantifier") (assert (and (= p7.captureGroup (some "rest")) (= p7.quantifier "1")) "Element 7 must have rest capture group and quantifier 1") true)

fn testMatchExactSequence -> Bool
  (let [(m (tr/compileTokenPattern "module foo :d")) (tokens0 (list "module" "foo" ":d" "body" "end")) (r0 (tr/matchTokenStream m tokens0 0)) (tokens1 (list "prefix" "module" "foo" ":d")) (r1 (tr/matchTokenStream m tokens1 1)) (tokensBad (list "module" "bar" ":d")) (rBad (tr/matchTokenStream m tokensBad 0))] (assert r0.matched "Pattern must match exact token sequence at index 0") (assert (= r0.tokensConsumed 3) "Pattern must consume exactly 3 tokens at index 0") (assert r1.matched "Pattern must match exact token sequence at offset 1") (assert (= r1.tokensConsumed 3) "Pattern must consume exactly 3 tokens at offset 1") (assert (and (not rBad.matched) (= rBad.tokensConsumed 0)) "Mismatched token must fail match with zero tokens consumed") true)

fn testMatchQuantifiers -> Bool
  (let [(mOpt (tr/compileTokenPattern "a b? c")) (rOpt0 (tr/matchTokenStream mOpt (list "a" "c") 0)) (rOpt1 (tr/matchTokenStream mOpt (list "a" "b" "c") 0)) (mStar (tr/compileTokenPattern "a b* c")) (rStar0 (tr/matchTokenStream mStar (list "a" "c") 0)) (rStar3 (tr/matchTokenStream mStar (list "a" "b" "b" "b" "c") 0)) (mPlus (tr/compileTokenPattern "a b+ c")) (rPlus0 (tr/matchTokenStream mPlus (list "a" "c") 0)) (rPlus1 (tr/matchTokenStream mPlus (list "a" "b" "c") 0))] (assert (and rOpt0.matched (= rOpt0.tokensConsumed 2)) "? quantifier must match 0 occurrences consuming 2 tokens") (assert (and rOpt1.matched (= rOpt1.tokensConsumed 3)) "? quantifier must match 1 occurrence consuming 3 tokens") (assert (and rStar0.matched (= rStar0.tokensConsumed 2)) "* quantifier must match 0 occurrences consuming 2 tokens") (assert (and rStar3.matched (= rStar3.tokensConsumed 5)) "* quantifier must match 3 occurrences consuming 5 tokens") (assert (not rPlus0.matched) "+ quantifier must reject 0 occurrences") (assert (and rPlus1.matched (= rPlus1.tokensConsumed 3)) "+ quantifier must match 1 occurrence consuming 3 tokens") true)

fn testGreedyVsNongreedy -> Bool
  (let [(tokens (list "x" "a" "b" "a" "y")) (mGreedy (tr/compileTokenPattern "x <mid:_*> a y")) (rGreedy (tr/matchTokenStream mGreedy tokens 0)) (mNongreedy (tr/compileTokenPattern "x <mid:_*?> a b a y")) (rNongreedy (tr/matchTokenStream mNongreedy tokens 0)) (repTokens (list "start" "t" "t" "t" "end")) (mGreedyPlus (tr/compileTokenPattern "start <rep:t+> t end")) (rGreedyPlus (tr/matchTokenStream mGreedyPlus repTokens 0)) (mNongreedyPlus (tr/compileTokenPattern "start <rep:t+?> t t end")) (rNongreedyPlus (tr/matchTokenStream mNongreedyPlus repTokens 0))] (assert rGreedy.matched "Greedy * pattern must match sequence") (assert (and (= rGreedy.tokensConsumed 5) (= (optionOr (mapGet rGreedy.captures "mid") (list)) (list "a" "b"))) "Greedy * must consume maximal mid tokens [a b]") (assert (and rNongreedy.matched (= (listLength (optionOr (mapGet rNongreedy.captures "mid") (list))) 0)) "Non-greedy *? must consume minimal 0 tokens to allow downstream match") (assert (and rGreedyPlus.matched (= (listLength (optionOr (mapGet rGreedyPlus.captures "rep") (list))) 2)) "Greedy + must consume maximal tokens [t t]") (assert (and rNongreedyPlus.matched (= (listLength (optionOr (mapGet rNongreedyPlus.captures "rep") (list))) 1)) "Non-greedy +? must consume minimal tokens [t]") true)

fn testCaptureGroups -> Bool
  (let [(mAst (tr/compileTokenPattern "( def <name:_> ( <args:_*> ) )")) (astTokens (list "(" "def" "compute" "(" "x" "y" "z" ")" ")")) (rAst (tr/matchTokenStream mAst astTokens 0)) (mDual (tr/compileTokenPattern "( module (?<mod>foo) :v <ver:bar> )")) (dualTokens (list "(" "module" "foo" ":v" "bar" ")")) (rDual (tr/matchTokenStream mDual dualTokens 0))] (assert rAst.matched "AST function pattern must match sequence") (assert (= (optionOr (mapGet rAst.captures "name") (list)) (list "compute")) "name capture group must contain function symbol compute") (assert (= (optionOr (mapGet rAst.captures "args") (list)) (list "x" "y" "z")) "args capture group must contain argument list [x y z]") (assert (= (optionOr (mapGet rDual.captures "mod") (list)) (list "foo")) "mod capture group must capture foo via (?<mod>...)") (assert (= (optionOr (mapGet rDual.captures "ver") (list)) (list "bar")) "ver capture group must capture bar via <ver:...>") true)

fn testScanTokenStream -> Bool
  (let [(m (tr/compileTokenPattern "fn _")) (stream (list "let" "x" "fn" "f1" "and" "fn" "f2" "end")) (results (tr/scanTokenStream m stream)) (m0 (optionOr (listGet results 0) (tr/TokenMatchResult :matched false :tokensConsumed 0 :captures (mapEmpty)))) (m1 (optionOr (listGet results 1) (tr/TokenMatchResult :matched false :tokensConsumed 0 :captures (mapEmpty)))) (emptyRes (tr/scanTokenStream m (list "no" "matching" "elements")))] (assert (= (listLength results) 2) "Stream must yield exactly 2 non-overlapping matches") (assert (= m0.tokensConsumed 2) "First scan match must consume 2 tokens") (assert (= m1.tokensConsumed 2) "Second scan match must consume 2 tokens") (assert (= (listLength emptyRes) 0) "Non-matching stream must yield 0 results") true)

fn testFindTokenSubsequences -> Bool
  (let [(m (tr/compileTokenPattern "( :f _ _ )")) (stream (list "dfs" "Rec" "(" ":f" "a" "Str" ")" "mid" "(" ":f" "b" "I64" ")")) (spans (tr/findTokenSubsequences m stream)) (s0 (optionOr (listGet spans 0) (pair 0 0))) (s1 (optionOr (listGet spans 1) (pair 0 0)))] (assert (= (listLength spans) 2) "Subsequence search must find 2 spans") (assert (and (= (pairFirst s0) 2) (= (pairSecond s0) 7)) "First subsequence span must be [2, 7)") (assert (and (= (pairFirst s1) 8) (= (pairSecond s1) 13)) "Second subsequence span must be [8, 13)") (assert (= (- (pairSecond s0) (pairFirst s0)) 5) "Span width must equal consumed token length of 5") true)

fn runTests -> Bool
  (and (testCompileTokenPattern) (and (testMatchExactSequence) (and (testMatchQuantifiers) (and (testGreedyVsNongreedy) (and (testCaptureGroups) (and (testScanTokenStream) (testFindTokenSubsequences)))))))
