(module asl-mem/tests/sqliteAdapterAcceptanceTest :x [runTests RunTests testSqliteInitializationAndTableCreation testSqliteWriteAndReadRecord testSqliteIndexedQuery testSqliteDeleteRecord testDualPolarityRefutations] :i [(sqliteAdapter :a sa)])

fn testSqliteInitializationAndTableCreation -> Bool
  (let [(st (sa/initSqliteStorage "agent.db"))] (assert (= st.dbPath "agent.db") "Database path matches agent.db") (assert (sa/hasTable? st "tasks") "tasks table exists") (assert (sa/hasTable? st "decisions") "decisions table exists") (assert (sa/hasTable? st "notes") "notes table exists") (refute (sa/hasTable? st "phantom_table") "Phantom table must refute existence") true)

fn testSqliteWriteAndReadRecord -> Bool
  (let [(st0 (sa/initSqliteStorage "agent.db")) (taskId "Task48804") (phase "Phase488") (status "completed") (asnPayload "(:task :id \"Task48804\" :status :completed :title \"SQLite Adapter\")") (writeRes (sa/sqliteWriteRecord st0 "tasks" taskId phase status asnPayload))] (assert (ok? writeRes) "Writing task record to SQLite returns ok") (refute (err? writeRes) "Writing task record must not error") (let [(st1 (optionOr (match writeRes ((ok s) (some s)) ((err _) (none))) st0)) (readRes (sa/sqliteReadRecord st1 "tasks" taskId))] (assert (ok? readRes) "Reading task record returns ok") (let [(row (optionOr (match readRes ((ok r) (some r)) ((err _) (none))) (sa/makeEmptyRow)))] (assert (= row.id taskId) "Row id matches Task48804") (assert (= row.status status) "Row status matches completed") (assert (= row.payload asnPayload) "Row payload matches exact ASN payload") (refute (!= row.id taskId) "Row id must refute divergence") true)))

fn testSqliteIndexedQuery -> Bool
  (let [(st0 (sa/initSqliteStorage "agent.db")) (w1 (sa/sqliteWriteRecord st0 "tasks" "T1" "PhaseA" "ready" "(:task :id \"T1\")"))] (let [(st1 (optionOr (match w1 ((ok s) (some s)) ((err _) (none))) st0)) (w2 (sa/sqliteWriteRecord st1 "tasks" "T2" "PhaseA" "ready" "(:task :id \"T2\")"))] (let [(st2 (optionOr (match w2 ((ok s) (some s)) ((err _) (none))) st1)) (w3 (sa/sqliteWriteRecord st2 "tasks" "T3" "PhaseB" "blocked" "(:task :id \"T3\")"))] (let [(st3 (optionOr (match w3 ((ok s) (some s)) ((err _) (none))) st2)) (qRes (sa/sqliteQueryRecords st3 "tasks" "PhaseA" "ready"))] (assert (ok? qRes) "Querying records by phase and status returns ok") (let [(rows (optionOr (match qRes ((ok r) (some r)) ((err _) (none))) (list)))] (assert (= (listLength rows) 2) "Found exactly 2 ready tasks in PhaseA") (refute (!= (listLength rows) 2) "Query result count must refute non-2") (let [(r0 (optionOr (listGet rows 0) (sa/makeEmptyRow))) (r1 (optionOr (listGet rows 1) (sa/makeEmptyRow)))] (assert (= r0.phase "PhaseA") "First row belongs to PhaseA") (assert (= r1.phase "PhaseA") "Second row belongs to PhaseA") (refute (= r0.phase "PhaseB") "Row must not belong to PhaseB") true))))))

fn testSqliteDeleteRecord -> Bool
  (let [(st0 (sa/initSqliteStorage "agent.db")) (w (sa/sqliteWriteRecord st0 "tasks" "TDel" "PhaseA" "ready" "(:task :id \"TDel\")"))] (let [(st1 (optionOr (match w ((ok s) (some s)) ((err _) (none))) st0)) (delRes (sa/sqliteDeleteRecord st1 "tasks" "TDel"))] (assert (ok? delRes) "Deleting record returns ok") (let [(st2 (optionOr (match delRes ((ok s) (some s)) ((err _) (none))) st1)) (rRes (sa/sqliteReadRecord st2 "tasks" "TDel"))] (assert (err? rRes) "Reading deleted record returns error") (refute (ok? rRes) "Deleted record must refute ok") true)))

fn testDualPolarityRefutations -> Bool
  (let [(st (sa/initSqliteStorage "agent.db")) (badTableWrite (sa/sqliteWriteRecord st "invalid_table" "1" "p" "s" "data")) (badTableRead (sa/sqliteReadRecord st "invalid_table" "1")) (missingRead (sa/sqliteReadRecord st "tasks" "NonexistentId")) (missingDel (sa/sqliteDeleteRecord st "tasks" "NonexistentId"))] (assert (err? badTableWrite) "Writing to invalid table returns error") (refute (ok? badTableWrite) "Writing to invalid table refutes ok") (assert (err? badTableRead) "Reading from invalid table returns error") (refute (ok? badTableRead) "Reading from invalid table refutes ok") (assert (err? missingRead) "Reading nonexistent ID returns error") (refute (ok? missingRead) "Reading nonexistent ID refutes ok") (assert (err? missingDel) "Deleting nonexistent ID returns error") (refute (ok? missingDel) "Deleting nonexistent ID refutes ok") (let [(badTableDel (sa/sqliteDeleteRecord st "invalid_table" "1"))] (assert (err? badTableDel) "Deleting from invalid table returns error") (refute (ok? badTableDel) "Deleting from invalid table refutes ok")) (let [(emptyIdRead (sa/sqliteReadRecord st "tasks" ""))] (assert (err? emptyIdRead) "Empty ID read returns error") (refute (ok? emptyIdRead) "Empty ID read refutes ok")) (let [(emptyIdWrite (sa/sqliteWriteRecord st "tasks" "" "p" "s" "data"))] (assert (err? emptyIdWrite) "Empty ID write returns error") (refute (ok? emptyIdWrite) "Empty ID write refutes ok")) (let [(emptyQuery (sa/sqliteQueryRecords st "invalid_table" "PhaseA" "ready"))] (assert (err? emptyQuery) "Query invalid table returns error") (refute (ok? emptyQuery) "Query invalid table refutes ok")) (let [(stA (sa/initSqliteStorage "db1.db")) (stB (sa/initSqliteStorage "db2.db"))] (assert (!= stA.dbPath stB.dbPath) "Different db paths produce distinct states") (refute (= stA.dbPath stB.dbPath) "Different db paths refute equality")) true)

fn runTests -> Bool
  (do (assert (testSqliteInitializationAndTableCreation) "testSqliteInitializationAndTableCreation passed") (assert (testSqliteWriteAndReadRecord) "testSqliteWriteAndReadRecord passed") (assert (testSqliteIndexedQuery) "testSqliteIndexedQuery passed") (assert (testSqliteDeleteRecord) "testSqliteDeleteRecord passed") (assert (testDualPolarityRefutations) "testDualPolarityRefutations passed") true)

fn RunTests -> Bool
  (runTests)
