(module aslMem/tests/taskLeaseTest :x [TestLeaseMake TestLeaseRenewHeartbeat TestLeaseExpirationPredicate TestLeaseStealingActiveRejected TestLeaseStealingExpiredSuccess TestLeaseAsnSerialization TestLeaseModularAliases runTests] :i [(taskLease :a lease)])

fn TestLeaseMake -> Bool
  (let [(l (lease/makeSessionLease "task-397-01" "sess-alpha" "implementer" 5000 10000))] (assert (= l.taskId "task-397-01") "Task id must match") (assert (= l.sessionId "sess-alpha") "Session id must match") (assert (= l.holderRole "implementer") "Holder role must match") (assert (= l.acquiredAt 10000) "Acquired-at must match creation epoch") (assert (= l.renewedAt 10000) "Renewed-at must initially match creation epoch") (assert (= l.expiresAt 15000) "Expires-at must equal acquired-at plus ttl") (assert (= l.ttlMs 5000) "TTL must match configured duration") (assert (= l.heartbeatCount 0) "Heartbeat count must initialize to 0") (assert (not (lease/isLeaseExpired? l 10000)) "Lease must not be expired at creation") (assert (not (lease/isLeaseExpired? l 14999)) "Lease must not be expired before TTL") true)

fn TestLeaseRenewHeartbeat -> Bool
  (let [(l0 (lease/makeSessionLease "task-397-01" "sess-alpha" "implementer" 5000 10000)) (l1 (lease/renewSessionLease l0 12000)) (l2 (lease/renewSessionLease l1 14500))] (assert (= l1.heartbeatCount 1) "First renewal must increment heartbeat count to 1") (assert (= l1.renewedAt 12000) "First renewal must update renewed-at to 12000") (assert (= l1.expiresAt 17000) "First renewal must extend expiration to 12000 + 5000") (assert (= l2.heartbeatCount 2) "Second renewal must increment heartbeat count to 2") (assert (= l2.renewedAt 14500) "Second renewal must update renewed-at to 14500") (assert (= l2.expiresAt 19500) "Second renewal must extend expiration to 14500 + 5000") (assert (= l2.acquiredAt 10000) "Original acquired-at must be preserved across renewals") (assert (= l2.sessionId "sess-alpha") "Session ID must be preserved across renewals") true)

fn TestLeaseExpirationPredicate -> Bool
  (let [(l (lease/makeSessionLease "task-397-01" "sess-alpha" "implementer" 3000 1000))] (assert (not (lease/isLeaseExpired? l 999)) "Lease is not expired before creation") (assert (not (lease/isLeaseExpired? l 1000)) "Lease is not expired at creation") (assert (not (lease/isLeaseExpired? l 3999)) "Lease is not expired at ms 3999") (assert (lease/isLeaseExpired? l 4000) "Lease is expired exactly at deadline 4000") (assert (lease/isLeaseExpired? l 5000) "Lease is expired well past deadline 5000") true)

fn TestLeaseStealingActiveRejected -> Bool
  (let [(l0 (lease/makeSessionLease "task-397-01" "sess-alpha" "implementer" 5000 10000)) (attempt (lease/stealExpiredLease l0 "sess-beta" "implementer" 6000 12000))] (assert (= attempt.sessionId "sess-alpha") "Active lease theft must be rejected, retaining original session") (assert (= attempt.expiresAt 15000) "Active lease expiration must remain unchanged") (assert (= attempt.ttlMs 5000) "Active lease TTL must remain unchanged") (assert (= attempt.heartbeatCount 0) "Heartbeat count must remain unchanged on rejected theft") true)

fn TestLeaseStealingExpiredSuccess -> Bool
  (let [(l0 (lease/makeSessionLease "task-397-01" "sess-alpha" "implementer" 5000 10000)) (lRenewed (lease/renewSessionLease l0 11000)) (stolen (lease/stealExpiredLease lRenewed "sess-beta" "implementer" 8000 16500))] (assert (lease/isLeaseExpired? lRenewed 16500) "Lease must be expired at 16500") (assert (= stolen.sessionId "sess-beta") "Stolen lease must belong to new session") (assert (= stolen.holderRole "implementer") "Stolen lease holder role must match new agent") (assert (= stolen.acquiredAt 16500) "Stolen lease acquired-at must be set to stealing epoch") (assert (= stolen.renewedAt 16500) "Stolen lease renewed-at must be set to stealing epoch") (assert (= stolen.expiresAt 24500) "Stolen lease expires-at must be 16500 + 8000") (assert (= stolen.ttlMs 8000) "Stolen lease TTL must be updated to new TTL") (assert (= stolen.heartbeatCount 0) "Stolen lease heartbeat count must reset to 0") (assert (not (lease/isLeaseExpired? stolen 16500)) "Stolen lease must be active at acquisition") true)

fn TestLeaseAsnSerialization -> Bool
  (let [(l (lease/makeSessionLease "task-397-01" "sess-alpha" "implementer" 5000 10000)) (asnStr (lease/formatLeaseAsn l))] (assert (stringContains? asnStr "(:lease") "Serialized output must contain (:lease tag") (assert (stringContains? asnStr ":task-id \"task-397-01\"") "Serialized output must contain task id") (assert (stringContains? asnStr ":session-id \"sess-alpha\"") "Serialized output must contain session id") (assert (stringContains? asnStr ":holder-role \"implementer\"") "Serialized output must contain holder role") (assert (stringContains? asnStr ":acquired-at 10000") "Serialized output must contain acquired-at") (assert (stringContains? asnStr ":expires-at 15000") "Serialized output must contain expires-at") (assert (stringContains? asnStr ":ttl-ms 5000") "Serialized output must contain ttl-ms") (assert (stringContains? asnStr ":heartbeat-count 0") "Serialized output must contain heartbeat-count") true)

fn TestLeaseModularAliases -> Bool
  (let [(l0 (lease/make "task-397-01" "sess-mod" "scout" 4000 20000)) (l1 (lease/renew l0 21000)) (expiredPre (lease/expired? l1 22000)) (expiredPost (lease/expired? l1 26000)) (l2 (lease/steal l1 "sess-stolen" "planner" 5000 26000)) (asnStr (lease/formatLease l2))] (assert (not expiredPre) "Modular expired? must report false before deadline") (assert expiredPost "Modular expired? must report true at deadline") (assert (= l2.sessionId "sess-stolen") "Modular steal must update session ID") (assert (= l2.holderRole "planner") "Modular steal must update holder role") (assert (stringContains? asnStr "(:lease") "Modular format must return ASN") (assert (stringContains? asnStr "sess-stolen") "Modular format must contain new session") true)

fn runTests -> Bool
  (and (TestLeaseMake) (and (TestLeaseRenewHeartbeat) (and (TestLeaseExpirationPredicate) (and (TestLeaseStealingActiveRejected) (and (TestLeaseStealingExpiredSuccess) (and (TestLeaseAsnSerialization) (TestLeaseModularAliases)))))))
