(module aslMem/tasksContingencyTest :x [testAnticipatedRiskConstruction testTaskToleranceConstruction testLeewayAndStrictInvariantValidation testEscalationTriggerMatching testAsnSerialization runTests] :i [(tasks :a t)])

fn testAnticipatedRiskConstruction -> Bool
  (let [(r (t/makeAnticipatedRisk "Name collision in imported module" "Compilation failure duplicate symbol" "Use explicit module alias (:i [(mod :a m)])" "asl check target.asl"))] (do (assert (= r.condition "Name collision in imported module") "Condition must match") (assert (= r.impact "Compilation failure duplicate symbol") "Impact must match") (assert (= r.prescribedMitigation "Use explicit module alias (:i [(mod :a m)])") "Mitigation must match") (assert (= r.contingencyGate "asl check target.asl") "Contingency gate must match") true))

fn testTaskToleranceConstruction -> Bool
  (let [(r (t/makeAnticipatedRisk "AST limit" "Over-token" "Factor helper" "asl check")) (tol (t/makeTaskTolerance (list "C0001" "C0003" "wire-protocol") (list "internal-helper-decomposition" "extra-tests") (list r) (list "edits-outside-owns" "broken-api")))] (do (assert (= (listLength tol.strictInvariants) 3) "Strict invariants count must be 3") (assert (= (listLength tol.varianceLeeway) 2) "Variance leeway count must be 2") (assert (= (listLength tol.anticipatedRisks) 1) "Anticipated risks count must be 1") (assert (= (listLength tol.escalationTriggers) 2) "Escalation triggers count must be 2") true))

fn testLeewayAndStrictInvariantValidation -> Bool
  (let [(r (t/makeAnticipatedRisk "AST limit" "Over-token" "Factor helper" "asl check")) (tol (t/makeTaskTolerance (list "C0001" "wire-protocol") (list "internal-helper-decomposition" "extra-tests") (list r) (list "edits-outside-owns")))] (do (assert (t/taskIsWithinLeeway? tol "internal-helper-decomposition") "Permitted leeway action must pass") (assert (t/taskIsWithinLeeway? tol "extra-tests") "Extra tests action must pass") (assert (not (t/taskIsWithinLeeway? tol "C0001")) "Strict invariant must be rejected") (assert (not (t/taskIsWithinLeeway? tol "wire-protocol")) "Wire protocol violation must be rejected") (assert (not (t/taskIsWithinLeeway? tol "unlisted-arbitrary-action")) "Unlisted action must be rejected") true))

fn testEscalationTriggerMatching -> Bool
  (let [(tol (t/makeTaskTolerance (list "C0001") (list "extra-tests") (list) (list "edits-outside-owns" "broken-api-signature")))] (do (assert (t/taskHasEscalationTrigger? tol "edits-outside-owns") "Known trigger must be detected") (assert (t/taskHasEscalationTrigger? tol "broken-api-signature") "Known trigger must be detected") (assert (not (t/taskHasEscalationTrigger? tol "normal-local-edit")) "Benign event must not trigger escalation") (assert (not (t/taskHasEscalationTrigger? tol "extra-tests")) "Permitted action must not trigger escalation") true))

fn testAsnSerialization -> Bool
  (let [(r (t/makeAnticipatedRisk "Name collision" "Compile error" "Use alias" "asl check")) (tol (t/makeTaskTolerance (list "C0001" "C0003") (list "helper-decomposition") (list r) (list "edits-outside-owns"))) (sRisk (t/formatAnticipatedRiskAsn r)) (sTol (t/formatTaskToleranceAsn tol))] (do (assert (stringContains? sRisk ":risk") "Risk ASN must contain :risk tag") (assert (stringContains? sRisk ":condition \"Name collision\"") "Risk ASN must contain condition") (assert (stringContains? sRisk ":mitigation \"Use alias\"") "Risk ASN must contain mitigation") (assert (stringContains? sTol ":tolerance") "Tolerance ASN must contain :tolerance tag") (assert (stringContains? sTol ":strict [\"C0001\" \"C0003\"]") "Tolerance ASN must contain strict list") (assert (stringContains? sTol ":leeway [\"helper-decomposition\"]") "Tolerance ASN must contain leeway list") (assert (stringContains? sTol ":escalate [\"edits-outside-owns\"]") "Tolerance ASN must contain escalate list") true))

fn runTests -> Bool
  (do (assert (testAnticipatedRiskConstruction)) (assert (testTaskToleranceConstruction)) (assert (testLeewayAndStrictInvariantValidation)) (assert (testEscalationTriggerMatching)) (assert (testAsnSerialization)) true)
