(module asl-mem/tests/compactVfsStmAcceptanceTest :x [runTests RunTests! testCompactSyntaxModernization! testVfsSymbolSymmetryAndCasIntegrity testStmTransactionsAndMerges! testCompactRecordSerialization testDualPolarityProbes] :i [(aslMem/vfs :a vfs) (aslMem/stm :a stm) (aslMem/compact :a cmp)])

fn testCompactSyntaxModernization! -> Bool
  (let [(res (fileReadString "asl/packages/asl-mem/src/compact.asl"))] (assert (ok? res) "compact.asl exists and is readable") (refute (err? res) "compact.asl refutes read failure") (match res ((err _) (assert false "compact.asl unreadable")) ((ok content) (assert (> (stringLength content) 0) "compact.asl is non-empty") (refute (= (stringLength content) 0) "compact.asl refutes empty content") (assert (stringContains? content "fn encodeVectorFrame") "compact.asl affirms modern fn encodeVectorFrame") (assert (stringContains? content "fn serializeGraphNode") "compact.asl affirms modern fn serializeGraphNode") (assert (stringContains? content "fn formatCompactLedger") "compact.asl affirms modern fn formatCompactLedger") (refute (stringContains? content "(df encodeVectorFrame") "compact.asl refutes legacy df encodeVectorFrame") (refute (stringContains? content "(df serializeGraphNode") "compact.asl refutes legacy df serializeGraphNode") (refute (stringContains? content "(df formatCompactLedger") "compact.asl refutes legacy df formatCompactLedger") (refute (stringContains? content "\n(defun ") "compact.asl refutes legacy defun form"))) true)

fn testVfsSymbolSymmetryAndCasIntegrity -> Bool
  (let [(reg0 (vfs/vfsInit)) (reg1 (vfs/vfsWrite reg0 "test.txt" "hello world")) (bufOpt (vfs/vfsRead reg1 "test.txt"))] (assert (some? bufOpt) "vfsWrite and vfsRead resolve written buffer") (refute (none? bufOpt) "vfsRead refutes none for written buffer") (match bufOpt ((none) (assert false "buffer should exist")) ((some buf) (assert (= buf.content "hello world") "buffer content matches") (refute (!= buf.content "hello world") "buffer content refutes divergence") (assert (> (stringLength buf.casHash) 0) "casHash is non-empty") (refute (= (stringLength buf.casHash) 0) "casHash refutes empty hash") (assert (not buf.dirty) "pristine buffer is not dirty") (refute buf.dirty "pristine buffer refutes dirty state"))) (let [(diffList (match bufOpt ((some b) (vfs/vfsDiff b)) ((none) (list))))] (assert (listEmpty? diffList) "pristine buffer has empty diff") (refute (not (listEmpty? diffList)) "pristine buffer refutes non-empty diff")) true)

fn testStmTransactionsAndMerges! -> Bool
  (let [(tx0 (stm/stmBegin "tx-1" "agent-1" 100)) (tx1 (stm/stmWrite! tx0 "state.asn" "key: 42")) (snapOpt (stm/stmGetSnapshot tx1 "state.asn"))] (assert (= tx1.status "active") "STM transaction status is active") (refute (!= tx1.status "active") "STM status refutes inactive") (assert (some? snapOpt) "Snapshot found for staged write") (refute (none? snapOpt) "Snapshot refutes none") (match snapOpt ((none) (assert false "snap should be some")) ((some snap) (assert (= snap.stagedContent "key: 42") "stagedContent matches written value") (refute (!= snap.stagedContent "key: 42") "stagedContent refutes mismatch") (assert snap.dirty "staged snapshot is dirty") (refute (not snap.dirty) "staged snapshot refutes clean state"))) (let [(txAborted (stm/stmRollback tx1 "test abort"))] (assert (= txAborted.status "aborted") "STM rollback sets aborted status") (refute (= txAborted.status "active") "STM rollback refutes active status")) true)

fn testCompactRecordSerialization -> Bool
  (let [(rec (cmp/encodeVectorFrame "vec-42" "semantic text" (list 0.5 1.5 2.5)))] (assert (= rec.id "vec-42") "CompactRecord id matches") (refute (!= rec.id "vec-42") "CompactRecord id refutes divergence") (assert (= rec.frameType "vector") "CompactRecord frameType is vector") (refute (!= rec.frameType "vector") "CompactRecord frameType refutes non-vector") (assert (stringContains? rec.payload ":id \"vec-42\"") "payload contains properly quoted :id") (refute (stringContains? rec.payload ":id \"\"vec-42\"\"") "payload refutes redundant double quotes on :id") (assert (stringContains? rec.payload ":text \"semantic text\"") "payload contains properly quoted :text") (refute (stringContains? rec.payload ":text \"\"semantic text\"\"") "payload refutes redundant double quotes on :text") (let [(ledger (cmp/formatCompactLedger (list rec)))] (assert (> (stringLength ledger) 0) "formatCompactLedger produces non-empty output") (refute (= (stringLength ledger) 0) "formatCompactLedger refutes empty string") true))

fn testDualPolarityProbes -> Bool
  (let [(emptyReg (vfs/vfsInit)) (nonExistent (vfs/vfsRead emptyReg "nonexistent/file.asl"))] (assert (none? nonExistent) "Reading nonexistent file returns none") (refute (some? nonExistent) "Reading nonexistent file refutes some") (let [(casFail (vfs/vfs-cas-update emptyReg "conflict.txt" "wrong-hash" "content"))] (assert (err? casFail) "CAS update with invalid expected hash returns err") (refute (ok? casFail) "CAS update with invalid expected hash refutes ok")) (let [(emptyTx (stm/stmBegin "tx-empty" "agent-2" 200)) (missingSnap (stm/stmGetSnapshot emptyTx "missing.txt"))] (assert (none? missingSnap) "Snapshot on untouched file returns none") (refute (some? missingSnap) "Snapshot on untouched file refutes some") true))

fn ! runTests -> Bool
  (do (assert (testCompactSyntaxModernization!) "testCompactSyntaxModernization passed") (assert (testVfsSymbolSymmetryAndCasIntegrity) "testVfsSymbolSymmetryAndCasIntegrity passed") (assert (testStmTransactionsAndMerges!) "testStmTransactionsAndMerges passed") (assert (testCompactRecordSerialization) "testCompactRecordSerialization passed") (assert (testDualPolarityProbes) "testDualPolarityProbes passed") true)

fn RunTests! -> Bool
  (runTests)
