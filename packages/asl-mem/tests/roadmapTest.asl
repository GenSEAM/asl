(module aslMem/tests/roadmapTest :x [runTests testItemAndPhaseRecords testLeaseAndRoadmapRecords testDefrecordSerialization testPhaseLifecycleAndClaim testDualProjectionEngine] :i [(roadmap :a rm) (projector :a prj)])

fn testItemAndPhaseRecords -> Bool
  (let [(it1 (rm/makeItem "296.1" "Roadmap Grammar" "pending" "asl check asl/packages/asl-mem/src/roadmap.asl")) (it2 (rm/makeItem "296.2" "CAS Versioning" "pending" "asl test asl/packages/asl-mem/tests/roadmap_test.asl")) (p (rm/makePhase "phase-296" "Native ASL Roadmap" "in-progress" "Wave E" "asl gate" (list it1 it2)))] (assert (= it1.id "296.1") "Item 1 ID must match") (assert (= it1.name "Roadmap Grammar") "Item 1 name must match") (assert (= it1.status "pending") "Item 1 status must be pending") (assert (= p.id "phase-296") "Phase ID must match") (assert (= p.wave "Wave E") "Phase wave must match") (assert (= p.status "in-progress") "Phase status must match") (assert (= (listLength p.items) 2) "Phase must contain 2 items") true)

fn testLeaseAndRoadmapRecords -> Bool
  (let [(now 1000) (ttl 30000) (l (rm/makeLease "phase-296" "agent-alpha" now ttl)) (p (rm/makePhase "phase-296" "Native ASL Roadmap" "pending" "Wave E" "asl gate" (list))) (r (rm/makeRoadmap "iter-2026" (list p)))] (assert (= l.phaseId "phase-296") "Lease phase-id must match") (assert (= l.agentId "agent-alpha") "Lease agent-id must match") (assert (rm/isLeaseActive? l 1500) "Lease must be active within TTL window") (assert (not (rm/isLeaseActive? l 32000)) "Lease must expire after acquired plus TTL") (assert (= r.iteration "iter-2026") "Roadmap iteration must match") (assert (= r.version 1) "Initial roadmap version must be 1") (assert (= (listLength r.phases) 1) "Roadmap must have 1 phase") true)

fn testDefrecordSerialization -> Bool
  (let [(p1 (rm/makePhase "phase-283" "WASM AOT" "done" "Wave A" "asl gate" (list))) (p2 (rm/makePhase "phase-284" "HM Type Checker" "done" "Wave A" "asl gate" (list))) (r (rm/makeRoadmap "iter-test" (list p1 p2))) (asn (rm/formatRoadmapAsn r))] (assert (stringContains? asn "(:roadmap") "Serialization must include :roadmap root") (assert (stringContains? asn ":iteration \"iter-test\"") "Iteration must match in ASN") (assert (stringContains? asn ":schema (id name status wave gate)") "Defrecord schema header must be present") (assert (stringContains? asn "\"phase-283\" \"WASM AOT\" \"done\" \"Wave A\"") "Phase 283 tuple must match") (assert (stringContains? asn "\"phase-284\" \"HM Type Checker\" \"done\" \"Wave A\"") "Phase 284 tuple must match") true)

fn testPhaseLifecycleAndClaim -> Bool
  (let [(it1 (rm/makeItem "296.1" "Grammar" "pending" "gate1")) (p1 (rm/makePhase "phase-296" "Engine" "pending" "Wave E" "gate" (list it1))) (r0 (rm/makeRoadmap "iter-test" (list p1))) (pFound (rm/phaseGet r0 "phase-296")) (pMiss (rm/phaseGet r0 "phase-nonexistent"))] (assert (some? pFound) "Existing phase must be found") (assert (none? pMiss) "Nonexistent phase must return none") (let [(p2 (rm/makePhase "phase-297" "Harness" "pending" "Wave E" "gate" (list))) (r1 (rm/phaseRegister r0 p2))] (assert (= r1.version 2) "Version must increment after register") (assert (= (listLength r1.phases) 2) "Roadmap must now have 2 phases") (let [(claimRes (rm/phaseClaim r1 "phase-296" "worker-1" 1000 30000))] (assert claimRes.success "Phase claim must succeed on unleased phase") (assert (some? claimRes.lease) "Claim result must include lease") (let [(r2 claimRes.roadmap) (r3 (rm/itemComplete r2 "phase-296" "296.1" "worker-1" 1000)) (pUpd (optionOr (rm/phaseGet r3 "phase-296") p1)) (firstIt (optionOr (listHead pUpd.items) it1))] (assert (= firstIt.status "completed") "Work item status must be updated to completed") (let [(r4 (rm/phaseComplete r3 "phase-296" "worker-1" 1000)) (pDone (optionOr (rm/phaseGet r4 "phase-296") p1))] (assert (= pDone.status "completed") "Phase status must be updated to completed") (assert (= (listLength r4.leases) 0) "Completed phase must release its active leases") true)))))

fn testDualProjectionEngine -> Bool
  (let [(row (prj/formatPhaseStatusRow "phase-296" "in-progress" "asl gate")) (sMd (prj/projectStatusMd "iter-2026" row)) (pItem (prj/formatPlanItem "296.1" "Defrecord Schema" "done" "asl check")) (pMd (prj/projectPlanMd "phase-296" "Roadmap Engine" "Execute roadmap engine" "asl gate" pItem)) (dual (prj/projectDualManifest "iter-2026" "phase-296" "Roadmap Engine" "in-progress" "Wave E" "asl gate"))] (assert (stringContains? row "| `phase-296` | in-progress | `asl gate` | PASS |") "Table row must match") (assert (stringContains? sMd "# Current Status: `iter-2026`") "Status markdown must include title") (assert (stringContains? sMd "## Active Roadmap Waves") "Status markdown must include waves header") (assert (stringContains? pMd "# Plan: Roadmap Engine") "Plan markdown must include phase plan title") (assert (stringContains? pMd "### Item 296.1: Defrecord Schema") "Plan markdown must include item header") (assert (stringContains? pMd "asl gate") "Plan markdown must include acceptance gate") (assert (= dual.targetPlanPath ".plans/phase-296/PLAN.md") "Dual projection path must be canonical") (assert (stringContains? dual.statusMd "phase-296") "Dual projection status must contain phase ID") true)

fn runTests -> Bool
  (and (testItemAndPhaseRecords) (and (testLeaseAndRoadmapRecords) (and (testDefrecordSerialization) (and (testPhaseLifecycleAndClaim) (testDualProjectionEngine)))))
