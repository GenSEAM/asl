(module aslMem/tests/vfsForkTest :x [runTests testForkVfsBranch testSpeculativeWriteIsolation testCommitBranch! testAbortBranch! testCompensatingSagas testBranchDiffAndMultiFork] :i [(vfs :a v) (vfsFork :a vf)])

fn getBranchBuffer branch: vf/VFSBranch targetPath: Str -> (Option v/VFSBuffer)
  (fold (fn [(acc (Option v/VFSBuffer)) (b v/VFSBuffer)] -> (Option v/VFSBuffer) (mt acc ((some found) (some found)) ((none) (if (= b.path targetPath) (some b) (none))))) (none) branch.buffers)

fn testForkVfsBranch -> Bool
  (let [(reg0 (v/vfsInit)) (reg1 (v/vfsWrite reg0 "src/main.asl" "(module main :x [])")) (reg2 (v/vfsWrite reg1 "docs/readme.md" "# Readme")) (branch (vf/forkVfsBranch reg2 "branch-alpha"))] (assert (= branch.branchId "branch-alpha") "Branch id must match fork branch-id parameter") (assert (= branch.parentId "root") "Parent id must be root") (assert (= branch.status "active") "Initial branch status must be active") (assert (= (listLength branch.buffers) 2) "Forked branch must inherit all buffers from parent registry") (assert (= (listLength branch.buffers) reg2.size) "Forked branch buffer count must match root registry size") (assert (= branch.createdAtMs 1725793200000) "Branch created timestamp must be initialized") true)

fn testSpeculativeWriteIsolation -> Bool
  (let [(reg0 (v/vfsWrite (v/vfsInit) "app.asl" "version 1.0")) (branch0 (vf/forkVfsBranch reg0 "spec-overlay")) (branch1 (vf/writeBranchBuffer branch0 "app.asl" "version 2.0-speculative")) (branch2 (vf/writeBranchBuffer branch1 "helper.asl" "helper code")) (rootApp (optionOr (v/vfsRead reg0 "app.asl") (v/VFSBuffer :path "" :content "" :baseContent "" :casHash "" :baseHash "" :revision 0 :dirty true :loadedAt 0 :leaseHolder "" :leaseExpiresAt 0 :leaseToken 0))) (bufApp (optionOr (getBranchBuffer branch2 "app.asl") (v/VFSBuffer :path "" :content "" :baseContent "" :casHash "" :baseHash "" :revision 0 :dirty false :loadedAt 0 :leaseHolder "" :leaseExpiresAt 0 :leaseToken 0))) (bufHlp (optionOr (getBranchBuffer branch2 "helper.asl") (v/VFSBuffer :path "" :content "" :baseContent "" :casHash "" :baseHash "" :revision 0 :dirty false :loadedAt 0 :leaseHolder "" :leaseExpiresAt 0 :leaseToken 0)))] (assert (= reg0.size 1) "Root registry size must remain 1 after branch writes") (assert (= (listLength reg0.activePaths) 1) "Root registry active paths must not include speculative paths") (assert (= rootApp.content "version 1.0") "Root registry buffer content must remain pristine") (assert (none? (v/vfsRead reg0 "helper.asl")) "New speculative path must not exist in root registry") (assert (and (= bufApp.content "version 2.0-speculative") (and (= bufApp.revision 2) bufApp.dirty)) "Branch buffer must have updated content revision and dirty flag") (assert (and (= bufHlp.content "helper code") bufHlp.dirty) "Newly added branch buffer must have staged content and dirty flag") true)

fn testCommitBranch! -> Bool
  (let [(reg0 (v/vfsWrite (v/vfsInit) "base.txt" "base v1")) (branch0 (vf/forkVfsBranch reg0 "commit-feature")) (branch1 (vf/writeBranchBuffer branch0 "base.txt" "base v2 committed")) (branch2 (vf/writeBranchBuffer branch1 "new.txt" "new file payload")) (reg1 (vf/commitBranch! branch2 reg0)) (bufBase (optionOr (v/vfsRead reg1 "base.txt") (v/VFSBuffer :path "" :content "" :baseContent "" :casHash "" :baseHash "" :revision 0 :dirty true :loadedAt 0 :leaseHolder "" :leaseExpiresAt 0 :leaseToken 0))) (bufNew (optionOr (v/vfsRead reg1 "new.txt") (v/VFSBuffer :path "" :content "" :baseContent "" :casHash "" :baseHash "" :revision 0 :dirty true :loadedAt 0 :leaseHolder "" :leaseExpiresAt 0 :leaseToken 0))) (aborted (vf/abortBranch branch2)) (regNoop (vf/commitBranch! aborted reg0))] (assert (= reg1.size 2) "Committed registry size must increase to 2") (assert (= (listLength reg1.activePaths) 2) "Committed registry active paths count must equal 2") (assert (= bufBase.content "base v2 committed") "Committed buffer content must match branch modification") (assert (= bufNew.content "new file payload") "New buffer from branch must be committed to registry") (assert (= regNoop.size 1) "Committing aborted non-active branch must leave registry unmodified") (assert (none? (v/vfsRead regNoop "new.txt")) "Non-active branch commit must not introduce new paths to root") true)

fn testAbortBranch! -> Bool
  (let [(reg0 (v/vfsWrite (v/vfsInit) "config.asn" "(:mode :prod)")) (branch0 (vf/forkVfsBranch reg0 "bad-experiment")) (branch1 (vf/writeBranchBuffer branch0 "config.asn" "(:mode :corrupt)")) (branch2 (vf/writeBranchBuffer branch1 "temp.log" "error log")) (aborted (vf/abortBranch branch2)) (rejectedWrite (vf/writeBranchBuffer aborted "config.asn" "(:mode :fixed)")) (regAfterAbort (vf/commitBranch! aborted reg0))] (assert (= aborted.status "aborted") "Aborted branch status must be aborted") (assert (= (listLength aborted.buffers) 0) "Aborting branch must prune all speculative buffer deltas") (assert (= rejectedWrite.status "aborted") "Write to aborted branch must be rejected preserving aborted status") (assert (= (listLength rejectedWrite.buffers) 0) "Write to aborted branch must not add buffers") (assert (= regAfterAbort.size 1) "Committing aborted branch must not alter root registry size") true)

fn testBranchDiffAndMultiFork -> Bool
  (let [(reg0 (v/vfsWrite (v/vfsWrite (v/vfsInit) "doc.txt" "line 1\nline 2") "static.txt" "unchanged line")) (branchA0 (vf/forkVfsBranch reg0 "branch-a")) (branchB0 (vf/forkVfsBranch reg0 "branch-b")) (branchA1 (vf/writeBranchBuffer branchA0 "doc.txt" "line 1\nline 2 modified")) (branchB1 (vf/writeBranchBuffer branchB0 "doc.txt" "line 1\nline 2 alternate")) (bufA (optionOr (getBranchBuffer branchA1 "doc.txt") (v/VFSBuffer :path "" :content "" :baseContent "" :casHash "" :baseHash "" :revision 0 :dirty false :loadedAt 0 :leaseHolder "" :leaseExpiresAt 0 :leaseToken 0))) (bufB (optionOr (getBranchBuffer branchB1 "doc.txt") (v/VFSBuffer :path "" :content "" :baseContent "" :casHash "" :baseHash "" :revision 0 :dirty false :loadedAt 0 :leaseHolder "" :leaseExpiresAt 0 :leaseToken 0))) (diffAOpt (vf/branchDiff branchA1 "doc.txt")) (diffA (optionOr diffAOpt "")) (diffStatic (optionOr (vf/branchDiff branchA1 "static.txt") "non-empty-fallback")) (diffMissing (vf/branchDiff branchA1 "missing.txt")) (diffB (optionOr (vf/branchDiff branchB1 "doc.txt") ""))] (assert (!= bufA.content bufB.content) "Independent parallel branches must maintain distinct content payloads") (assert (some? diffAOpt) "Branch diff on modified file must return some diff string") (assert (stringContains? diffA "+line 2 modified") "Branch diff must contain added line delta") (assert (= diffStatic "") "Branch diff on clean unchanged file must emit empty string") (assert (none? diffMissing) "Branch diff on non-existent path must return None") (assert (stringContains? diffB "+line 2 alternate") "Branch B diff must contain its own unique modification") true)

fn testCompensatingSagas -> Bool
  (let [(reg0 (v/vfsInit)) (branch0 (vf/forkVfsBranch reg0 "saga-branch")) (saga1 (vf/CompensatingAction :actionId "saga-kill-proc" :kind "process" :target "pid:4291" :handler "procSignal:SIGKILL" :registeredAtMs 1773410000000)) (saga2 (vf/CompensatingAction :actionId "saga-release-lock" :kind "lock" :target "flock:/tmp/engine.lock" :handler "unlink" :registeredAtMs 1773410001000)) (branch1 (vf/registerCompensation branch0 saga1)) (branch2 (vf/registerCompensation branch1 saga2)) (aborted (vf/abortBranch branch2))] (assert (= (listLength branch0.compensations) 0) "Initial branch must have 0 compensating actions") (assert (= (listLength branch2.compensations) 2) "Branch2 must have 2 registered compensating actions") (assert (= aborted.status "aborted") "Aborted branch status must be aborted") (assert (= (listLength aborted.compensations) 0) "Aborting branch must flush all compensating actions") true)

fn ! runTests -> Bool
  (and (testForkVfsBranch) (and (testSpeculativeWriteIsolation) (and (testCommitBranch!) (and (testAbortBranch!) (and (testCompensatingSagas) (testBranchDiffAndMultiFork))))))
