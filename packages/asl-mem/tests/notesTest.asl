(module memNotesTest :i [(aslMem/notes :a n)])

fn testNotesLifecycle -> Bool
  (let [(note1 (n/makeNote "n1" "token-economy" "auditor" "sess-01" "2026-09-09" "active" (list "asl/asl" "harness/paradigm.asn") (list "tokens" "density" "prefixes") "BPE tokenizers penalize hyphenated shortcodes; prefix plus number is 2 tokens." "Empirical tiktoken run on cl100k and o200k." "Adopt 2-token compact shortcode convention.")) (note2 (n/makeNote "n2" "session-recovery" "implementer" "sess-02" "2026-09-09" "archived" (list "asl/packages/asl-mem/src/tasks.asl") (list "tasks" "sessions") "In-flight tasks persist in in_flight.asn with step-index." "Verified by tests/test_task_protocol_e2e.sh." "Enable seamless crash recovery.")) (asnStr (n/formatNoteAsn note1)) (mdStr (n/projectNoteMd note1)) (promotedTask (n/notePromoteToTask note1 "t388-1")) (promotedAdr (n/notePromoteToAdr note1 "d45"))] (assert (= note1.id "n1") "a1") (assert (= note1.topic "token-economy") "a2") (assert (n/noteIsActive? note1) "a3") (assert (not (n/noteIsActive? note2)) "a4") (assert (n/noteHasTag? note1 "tokens") "a5") (assert (n/noteHasTag? note1 "density") "a6") (assert (not (n/noteHasTag? note1 "nonexistent")) "a7") (assert (n/noteScopeMatches? note1 "asl/asl") "a8") (assert (n/noteScopeMatches? note1 "harness/paradigm.asn") "a9") (assert (not (n/noteScopeMatches? note1 "foreign/path.py")) "a10") (assert (n/noteMatchesQuery? note1 "token") "a11") (assert (n/noteMatchesQuery? note1 "n1") "a12") (assert (n/noteMatchesQuery? note1 "BPE") "a13") (assert (not (n/noteMatchesQuery? note1 "unrelated-query")) "a14") (assert (stringContains? asnStr "(:note") "a15") (assert (stringContains? asnStr ":id \"n1\"") "a16") (assert (stringContains? asnStr ":tags [:tokens :density :prefixes]") "a17") (assert (stringContains? mdStr "# Note [n1]: token-economy") "a18") (assert (stringContains? mdStr "## Empirical Fact") "a19") (assert (stringContains? mdStr "## Grounded Evidence") "a20") (assert (stringContains? mdStr "## Architectural Consequence") "a21") (assert (= promotedTask.status "promoted-to-task") "a22") (assert (stringContains? promotedTask.consequence "t388-1") "a23") (assert (= promotedAdr.status "promoted-to-adr") "a24") (assert (stringContains? promotedAdr.consequence "d45") "a25") true)

fn runTests -> Bool
  (testNotesLifecycle)

