(module asl-mem/tests/projectionStorageAcceptanceTest :x [runTests RunTests testProjectionReplayAndWatermark testProjectionAggregateMeasures testStorageEngineAndOpfsWebLocks testDualPolarityRefutations] :i [(aslMem/projection :a proj) (aslMem/storageFile :a storage) (aslMem/wal :a wal)])

fn testProjectionReplayAndWatermark -> Bool
  (let [(p0 (proj/makeProjectionState "partition-1")) (e1 (wal/makeWalEntry 1 1000 (wal/opPutNode) "item-1" "{\"val\": 100}")) (e2 (wal/makeWalEntry 2 1001 (wal/opPutNode) "item-2" "{\"val\": 200}")) (e3 (wal/makeWalEntry 3 1002 (wal/opPutNode) "item-3" "{\"val\": 300}")) (batch (list e1 e2 e3)) (p1 (proj/replayWalBatch p0 batch))] (assert (= p1.appliedSeq 3) "projection advances appliedSeq to 3") (assert (= (proj/getEntityCount p1) 3) "projection contains 3 entities") (assert (proj/hasEntity? p1 "item-1") "contains item-1") (assert (proj/hasEntity? p1 "item-2") "contains item-2") (assert (proj/hasEntity? p1 "item-3") "contains item-3") (let [(pReplayed (proj/replayWalBatch p1 batch))] (assert (= pReplayed.appliedSeq 3) "replaying already-applied batch maintains appliedSeq at 3") (assert (= (proj/getEntityCount pReplayed) 3) "replaying already-applied batch maintains 3 entities (no double-counting)") (let [(e4 (wal/makeWalEntry 4 1003 (wal/opDelNode) "item-2" "")) (p2 (proj/replayWalEntry pReplayed e4))] (assert (= p2.appliedSeq 4) "advances appliedSeq to 4") (assert (= (proj/getEntityCount p2) 2) "entity count decrements to 2 after deletion") (assert (not (proj/hasEntity? p2 "item-2")) "deleted item-2 is no longer present") (assert (proj/hasEntity? p2 "item-1") "item-1 remains present") (assert (proj/hasEntity? p2 "item-3") "item-3 remains present") true)))

fn testProjectionAggregateMeasures -> Bool
  (let [(p0 (proj/makeProjectionState "orders-partition")) (e1 (wal/makeWalEntry 1 1000 (wal/opPutNode) "order-1" "{\"amount\": 150}")) (e2 (wal/makeWalEntry 2 1001 (wal/opPutNode) "order-2" "{\"amount\": 250}")) (p1 (proj/replayWalBatch p0 (list e1 e2)))] (assert (= p1.appliedSeq 2) "appliedSeq matches 2") (assert (= (proj/getMetricTotal p1 "orderCount") 2) "orderCount metric is 2") (assert (= (proj/getMetricTotal p1 "totalRevenue") 400) "totalRevenue metric is 400") true)

fn testStorageEngineAndOpfsWebLocks -> Bool
  (let [(engine (storage/makeOpfsStorage "agent_memory"))] (assert (= (storage/getRootPrefix engine) "agent_memory") "root prefix is agent_memory") (let [(lockRes1 (storage/acquireWebLock engine "tab-A" 1000))] (match lockRes1 ((none) (assert false "lockRes1 missing")) ((some engine1) (assert (storage/isLockedBy? engine1 "tab-A") "engine is locked by tab-A") (let [(lockRes2 (storage/acquireWebLock engine1 "tab-B" 1001))] (assert (none? lockRes2) "tab-B cannot acquire lock while tab-A holds it") (let [(writeRes (storage/opfsWrite engine1 "tab-A" "state.bin" "checkpoint-data-12345"))] (match writeRes ((none) (assert false "writeRes missing")) ((some engine2) (let [(readData (storage/opfsRead engine2 "state.bin"))] (assert (some? readData) "read from written OPFS file succeeds") (assert (match readData ((none) false) ((some readDataVal) (= readDataVal "checkpoint-data-12345"))) "data matches written bytes") (let [(releaseRes (storage/releaseWebLock engine2 "tab-A"))] (match releaseRes ((none) (assert false "releaseRes missing")) ((some engine3) (assert (not (storage/isLockedBy? engine3 "tab-A")) "tab-A lock released") (let [(lockRes3 (storage/acquireWebLock engine3 "tab-B" 1002))] (assert (some? lockRes3) "tab-B can acquire lock after tab-A releases it") true)))))))))))))

fn testDualPolarityRefutations -> Bool
  (let [(p0 (proj/makeProjectionState "p-test")) (e1 (wal/makeWalEntry 1 1000 (wal/opPutNode) "k1" "{\"amount\": 50}")) (p1 (proj/replayWalEntry p0 e1))] (refute (= p1.appliedSeq 0) "replaying entry 1 refutes appliedSeq 0") (assert (= p1.appliedSeq 1) "replaying entry 1 confirms appliedSeq 1") (let [(pStale (proj/replayWalEntry p1 e1))] (refute (> pStale.appliedSeq 1) "stale replay refutes incrementing appliedSeq") (refute (> (proj/getEntityCount pStale) 1) "stale replay refutes incrementing entity count") (refute (> (proj/getMetricTotal pStale "orderCount") 1) "stale replay refutes double-counting orderCount") (refute (> (proj/getMetricTotal pStale "totalRevenue") 50) "stale replay refutes double-counting revenue")) (let [(pNonExistent (proj/makeProjectionState "empty-part"))] (refute (proj/hasEntity? pNonExistent "ghost") "empty projection refutes ghost entity") (refute (> (proj/getEntityCount pNonExistent) 0) "empty projection refutes positive entity count") (refute (> pNonExistent.appliedSeq 0) "empty projection refutes positive appliedSeq")) (let [(storage (storage/makeOpfsStorage "test_dir"))] (match (storage/acquireWebLock storage "holder" 1000) ((none) (assert false "holder lock acquisition missing")) ((some locked) (refute (storage/isLockedBy? locked "intruder") "lock refutes intruder identity") (refute (some? (storage/acquireWebLock locked "intruder" 1001)) "conflicting lock acquisition refutes some") (refute (some? (storage/opfsWrite locked "intruder" "hack.bin" "payload")) "unauthorized writer refutes write success") (refute (some? (storage/releaseWebLock locked "intruder")) "unauthorized release refutes success") (match (storage/releaseWebLock locked "holder") ((none) (assert false "holder lock release missing")) ((some unlocked) (refute (storage/isLockedBy? unlocked "holder") "released lock refutes holder identity") (let [(emptyRead (storage/opfsRead unlocked "non-existent-file.bin"))] (refute (some? emptyRead) "reading absent file refutes some") (assert (none? emptyRead) "reading absent file returns none"))))))) (let [(pDeleted (proj/replayWalEntry p1 (wal/makeWalEntry 2 1001 (wal/opDelNode) "k1" "")))] (refute (proj/hasEntity? pDeleted "k1") "deleted entity refutes presence") (refute (> (proj/getEntityCount pDeleted) 0) "projection after delete refutes positive entity count")) true)

fn runTests -> Bool
  (do (assert (testProjectionReplayAndWatermark) "testProjectionReplayAndWatermark must pass") (assert (testProjectionAggregateMeasures) "testProjectionAggregateMeasures must pass") (assert (testStorageEngineAndOpfsWebLocks) "testStorageEngineAndOpfsWebLocks must pass") (assert (testDualPolarityRefutations) "testDualPolarityRefutations must pass") true)

fn RunTests -> Bool
  (runTests)
