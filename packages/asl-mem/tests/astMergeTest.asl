(module aslMem/tests/astMergeTest :x [runTests TestDisjointFormMerge TestIdenticalMutationDeduplication TestDivergentModificationConflict TestDeleteVsModifyConflict TestSexpListSetUnion TestTaskFormMerge] :i [(astMerge :a am)])

fn TestDisjointFormMerge -> Bool
  (let [(baseCode (str "(module app :x [f1 f2])\n\n" "(df f1 [] -> I64 10)\n\n" "(df f2 [] -> I64 20)")) (branchA (str "(module app :x [f1 f2])\n\n" "(df f1 [] -> I64 999)\n\n" "(df f2 [] -> I64 20)")) (branchB (str "(module app :x [f1 f2])\n\n" "(df f1 [] -> I64 10)\n\n" "(df f2 [] -> I64 888)")) (res (am/universalAst3wayMerge baseCode branchA branchB)) (merged res.mergedContent)] (assert res.clean "Disjoint form mutations must merge cleanly without conflict") (assert (= (listLength res.conflicts) 0) "Clean merge must report 0 conflicts") (assert (= (listLength res.collisions) 0) "Clean merge must have empty collisions list") (assert (= res.mergedFormsCount 3) "Must preserve all 3 AST forms") (assert (stringContains? merged "999") "Merged content must include branch A mutation") (assert (stringContains? merged "888") "Merged content must include branch B mutation") (assert (stringContains? merged "module app") "Merged content must preserve module declaration") true)

fn TestIdenticalMutationDeduplication -> Bool
  (let [(baseCode (str "(df f1 [] -> I64 10)\n\n(df f2 [] -> I64 20)")) (branchA (str "(df f1 [] -> I64 42)\n\n(df f2 [] -> I64 20)")) (branchB (str "(df f1 [] -> I64 42)\n\n(df f2 [] -> I64 20)")) (res (am/universalAst3wayMerge baseCode branchA branchB)) (merged res.mergedContent)] (assert res.clean "Identical mutations must merge cleanly") (assert (= (listLength res.conflicts) 0) "Identical mutations must have 0 conflicts") (assert (= res.mergedFormsCount 2) "Deduplicated merge must preserve exactly 2 forms") (assert (stringContains? merged "42") "Merged content must contain updated form") true)

fn TestDivergentModificationConflict -> Bool
  (let [(baseCode (str "(df f1 [] -> I64 10)\n\n(df f2 [] -> I64 20)")) (branchA (str "(df f1 [] -> I64 111)\n\n(df f2 [] -> I64 20)")) (branchB (str "(df f1 [] -> I64 222)\n\n(df f2 [] -> I64 20)")) (res (am/universalAst3wayMerge baseCode branchA branchB)) (cols res.collisions)] (assert (not res.clean) "Divergent mutations to same form must trigger collision") (assert (= (listLength res.conflicts) 1) "Must report exactly 1 conflict") (assert (= (listLength cols) 1) "Must contain exactly 1 ASTCollisionRecord") (let [(c (optionOr (listGet cols 0) (am/ASTCollisionRecord :symbolId "" :baseForm "" :branchA "" :branchB "" :collisionType "")))] (assert (= c.symbolId "f1") "Conflicted symbol ID must be f1") (assert (= c.collisionType "divergent-modification") "Collision type must be divergent-modification") (assert (stringContains? c.branchA "111") "Collision record branch A must contain 111") (assert (stringContains? c.branchB "222") "Collision record branch B must contain 222")) true)

fn TestDeleteVsModifyConflict -> Bool
  (let [(baseCode (str "(df f1 [] -> I64 10)\n\n(df f2 [] -> I64 20)")) (branchA (str "(df f2 [] -> I64 20)")) (branchB (str "(df f1 [] -> I64 999)\n\n(df f2 [] -> I64 20)")) (res (am/universalAst3wayMerge baseCode branchA branchB)) (cols res.collisions)] (assert (not res.clean) "Delete vs modify must trigger collision") (assert (= (listLength res.conflicts) 1) "Must report exactly 1 conflict") (let [(c (optionOr (listGet cols 0) (am/ASTCollisionRecord :symbolId "" :baseForm "" :branchA "" :branchB "" :collisionType "")))] (assert (= c.symbolId "f1") "Conflicted symbol must be f1") (assert (= c.collisionType "delete-vs-modify") "Collision type must be delete-vs-modify")) true)

fn TestSexpListSetUnion -> Bool
  (let [(base (list "core" "mem")) (listA (list "core" "mem" "bus" "vdom")) (listB (list "core" "mem" "bus" "voice")) (merged (am/mergeSexpLists base listA listB))] (assert (= (listLength merged) 5) "Merged list must contain exactly 5 unique entries") (assert (listContains? merged "core") "Merged list must contain core") (assert (listContains? merged "mem") "Merged list must contain mem") (assert (listContains? merged "bus") "Merged list must contain bus") (assert (listContains? merged "vdom") "Merged list must contain vdom") (assert (listContains? merged "voice") "Merged list must contain voice") true)

fn TestTaskFormMerge -> Bool
  (let [(baseTasks (str "(:task :id \"T1\" :state :completed)\n\n" "(:task :id \"T2\" :state :ready)")) (branchA (str "(:task :id \"T1\" :state :completed)\n\n" "(:task :id \"T2\" :state :in_progress)\n\n" "(:task :id \"T3\" :state :ready)")) (branchB (str "(:task :id \"T1\" :state :completed)\n\n" "(:task :id \"T2\" :state :ready)\n\n" "(:task :id \"T4\" :state :ready)")) (res (am/universalAst3wayMerge baseTasks branchA branchB)) (merged res.mergedContent)] (assert res.clean "Disjoint task additions and status advancement must merge cleanly") (assert (= res.mergedFormsCount 4) "Merged task list must contain all 4 tasks") (assert (stringContains? merged "T3") "Merged tasks must include T3 from branch A") (assert (stringContains? merged "T4") "Merged tasks must include T4 from branch B") (assert (stringContains? merged ":in_progress") "Merged tasks must preserve in_progress status for T2") true)

fn runTests -> Bool
  (and (TestDisjointFormMerge) (and (TestIdenticalMutationDeduplication) (and (TestDivergentModificationConflict) (and (TestDeleteVsModifyConflict) (and (TestSexpListSetUnion) (TestTaskFormMerge))))))
