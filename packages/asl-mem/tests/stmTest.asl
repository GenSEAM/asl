(module aslMem/tests/stmTest :x [runTests TestStmBeginAndSnapshot TestStmWriteAndDirtyTracking! TestStmAtomicCommitCleanTrunk! TestStmConcurrentReconciliation! TestStmCollisionAbortsAtomically! TestStmRollback] :i [(stm :a s)])

fn TestStmBeginAndSnapshot -> Bool
  (let [(tx0 (s/stmBegin "tx-101" "agent-alpha" 100)) (tx1 (s/stmRead tx0 "src/module_a.asl" "(fn f1 [] -> I64 10)")) (snapOpt (s/stmGetSnapshot tx1 "src/module_a.asl"))] (assert (= tx0.status "active") "Transaction status must be active") (assert (= tx0.txId "tx-101") "Transaction ID must match") (assert (= tx0.agentId "agent-alpha") "Agent ID must match") (mt snapOpt ((none) (assert false "Snapshot must exist after stm-read")) ((some snap) (assert (= snap.path "src/module_a.asl") "Snapshot path must match") (assert (not snap.dirty) "Snapshot must not be dirty after initial read") (assert (= snap.baseContent "(fn f1 [] -> I64 10)") "Base content must match trunk"))) true)

fn TestStmWriteAndDirtyTracking! -> Bool
  (let [(tx0 (s/stmBegin "tx-102" "agent-beta" 101)) (tx1 (s/stmRead tx0 "src/lib.asl" "(fn x [] -> I64 1)")) (tx2 (s/stmWrite! tx1 "src/lib.asl" "(fn x [] -> I64 999)")) (snapOpt (s/stmGetSnapshot tx2 "src/lib.asl")) (dirty (s/stmDirtyFiles tx2))] (assert (= (listLength dirty) 1) "Must report exactly 1 dirty file") (assert (listContains? dirty "src/lib.asl") "Dirty list must include src/lib.asl") (mt snapOpt ((none) (assert false "Snapshot must be present")) ((some snap) (assert snap.dirty "Snapshot must be marked dirty after write") (assert (= snap.baseContent "(fn x [] -> I64 1)") "Base content must remain unchanged") (assert (= snap.stagedContent "(fn x [] -> I64 999)") "Staged content must contain new value"))) true)

fn TestStmAtomicCommitCleanTrunk! -> Bool
  (let [(tx0 (s/stmBegin "tx-103" "agent-gamma" 102)) (tx1 (s/stmRead tx0 "file1.asl" "(fn a [] -> I64 1)")) (tx2 (s/stmRead tx1 "file2.asl" "(fn b [] -> I64 2)")) (tx3 (s/stmWrite! tx2 "file1.asl" "(fn a [] -> I64 100)")) (tx4 (s/stmWrite! tx3 "file2.asl" "(fn b [] -> I64 200)")) (trunkPaths (list "file1.asl" "file2.asl")) (trunkContents (list "file1.asl:(fn a [] -> I64 1)" "file2.asl:(fn b [] -> I64 2)")) (res (s/stmValidateAndMerge tx4 trunkPaths trunkContents))] (assert res.committed "Commit must succeed when trunk is clean") (assert (= (listLength res.touchedFiles) 2) "Must touch both files") (assert (= (listLength res.conflictedFiles) 0) "Must have 0 conflicted files") (assert (= (listLength res.reconciledFiles) 0) "Zero files reconciled if clean") (assert (= (listLength res.mergedContents) 2) "Must return merged contents for both files") true)

fn TestStmConcurrentReconciliation! -> Bool
  (let [(baseCode (str "(fn f1 [] -> I64 1)\n\n(fn f2 [] -> I64 2)")) (stagedCode (str "(fn f1 [] -> I64 999)\n\n(fn f2 [] -> I64 2)")) (trunkCode (str "(fn f1 [] -> I64 1)\n\n(fn f2 [] -> I64 888)")) (tx0 (s/stmBegin "tx-104" "agent-delta" 103)) (tx1 (s/stmRead tx0 "module.asl" baseCode)) (tx2 (s/stmWrite! tx1 "module.asl" stagedCode)) (trunkPaths (list "module.asl")) (trunkContents (list (str "module.asl:" trunkCode))) (res (s/stmValidateAndMerge tx2 trunkPaths trunkContents))] (assert res.committed "Commit must succeed via automatic AST reconciliation") (assert (= (listLength res.reconciledFiles) 1) "Must report 1 reconciled file") (assert (listContains? res.reconciledFiles "module.asl") "Reconciled list must include module.asl") (let [(mergedFirst (optionOr (listGet res.mergedContents 0) ""))] (assert (stringContains? mergedFirst "999") "Merged content must include transaction edit") (assert (stringContains? mergedFirst "888") "Merged content must include concurrent trunk edit")) true)

fn TestStmCollisionAbortsAtomically! -> Bool
  (let [(baseCode (str "(fn f1 [] -> I64 1)\n\n(fn f2 [] -> I64 2)")) (stagedCode (str "(fn f1 [] -> I64 111)\n\n(fn f2 [] -> I64 2)")) (trunkCode (str "(fn f1 [] -> I64 222)\n\n(fn f2 [] -> I64 2)")) (tx0 (s/stmBegin "tx-105" "agent-epsilon" 104)) (tx1 (s/stmRead tx0 "collision.asl" baseCode)) (tx2 (s/stmWrite! tx1 "collision.asl" stagedCode)) (trunkPaths (list "collision.asl")) (trunkContents (list (str "collision.asl:" trunkCode))) (res (s/stmValidateAndMerge tx2 trunkPaths trunkContents))] (assert (not res.committed) "Commit must fail when unresolvable AST collision occurs") (assert (= (listLength res.conflictedFiles) 1) "Must report 1 conflicted file") (assert (listContains? res.conflictedFiles "collision.asl") "Conflicted list must contain collision.asl") (mt res.errorMessage ((none) (assert false "Error message must be populated on abort")) ((some msg) (assert (stringContains? msg "AST collision") "Error message must mention AST collision"))) true)

fn TestStmRollback -> Bool
  (let [(tx0 (s/stmBegin "tx-106" "agent-zeta" 105)) (tx1 (s/stmRollback tx0 "Manual agent compensation"))] (assert (= tx1.status "aborted") "Status must be aborted") (assert (= (listLength tx1.compensations) 1) "Must contain 1 compensation entry") (assert (listContains? tx1.compensations "Manual agent compensation") "Compensation reason must match") true)

fn ! runTests -> Bool
  (and (TestStmBeginAndSnapshot) (and (TestStmWriteAndDirtyTracking!) (and (TestStmAtomicCommitCleanTrunk!) (and (TestStmConcurrentReconciliation!) (and (TestStmCollisionAbortsAtomically!) (TestStmRollback))))))
