(module asl-mem/tests/walAcceptanceTest :x [runTests RunTests testWalQuoteEscapingRoundtrip testWalChecksumIntegrity testWalStreamGapDetection testOutboxAndAppliedSeqCheckpoint testDualPolarityRefutations] :i [(aslMem/wal :a wal) (aslMem/checkpoint :a ckpt) (aslMem/vfs :a vfs)])

fn testWalQuoteEscapingRoundtrip -> Bool
  (let [(nestedPayload "{\"user\": \"alice\", \"bio\": \"line 1\\nline 2\", \"quote\": \"he said \\\"hello\\\"\"}") (entry (wal/makeWalEntry 1 1726500000 (wal/opPutNode) "entity-101" nestedPayload)) (frame (wal/formatWalFrame entry)) (parsedOpt (wal/parseWalFrame frame))] (assert (some? parsedOpt) "formatted frame with quotes and newlines parses cleanly") (match parsedOpt ((none) (assert false "parsedOpt missing")) ((some parsed) (assert (= parsed.seqNum 1) "seqNum matches 1") (assert (= parsed.timestampEpoch 1726500000) "timestamp matches") (assert (= parsed.key "entity-101") "key matches") (assert (= parsed.payload nestedPayload) "nested quotes payload roundtrips bit-for-bit identical") (assert (> parsed.checksum 0) "checksum is non-zero") true)))

fn testWalChecksumIntegrity -> Bool
  (let [(entry (wal/makeWalEntry 2 1726500001 (wal/opPutVector) "vec-42" "vector payload [0.1, 0.2]")) (frame (wal/formatWalFrame entry)) (parsedValid (wal/parseWalFrame frame))] (assert (some? parsedValid) "valid frame passes CRC check") (let [(corruptedPayloadFrame (stringReplace frame "[0.1, 0.2]" "[0.9, 0.2]")) (parsedCorrupt (wal/parseWalFrame corruptedPayloadFrame))] (assert (none? parsedCorrupt) "corrupted payload fails CRC check and returns none") (let [(corruptedCrcFrame (stringReplace frame ":crc " ":crc 9999999")) (parsedCrcMismatch (wal/parseWalFrame corruptedCrcFrame))] (assert (none? parsedCrcMismatch) "tampered CRC value fails verification and returns none") true)))

fn testWalStreamGapDetection -> Bool
  (let [(e1 (wal/makeWalEntry 1 1000 (wal/opPutNode) "k1" "p1")) (e2 (wal/makeWalEntry 2 1001 (wal/opPutNode) "k2" "p2")) (e3 (wal/makeWalEntry 3 1002 (wal/opPutNode) "k3" "p3")) (e4 (wal/makeWalEntry 4 1003 (wal/opPutNode) "k4" "p4")) (f1 (wal/formatWalFrame e1)) (f2 (wal/formatWalFrame e2)) (f3 (wal/formatWalFrame e3)) (f4 (wal/formatWalFrame e4)) (validStream (str f1 "\n" f2 "\n" f3 "\n" f4)) (gapStream (str f1 "\n" f2 "\n" f4)) (validRes (wal/parseWalStreamStrict validStream 1)) (gapRes (wal/parseWalStreamStrict gapStream 1))] (match validRes ((wal/walSuccess entries) (assert (= (listLength entries) 4) "sequential stream parses 4 entries")) (_ (assert false "sequential stream must succeed"))) (match gapRes ((wal/walGap expSeq actSeq) (assert (= expSeq 3) "gap correctly identifies missing sequence 3") (assert (= actSeq 4) "gap correctly identifies actual encountered sequence 4")) (_ (assert false "gap stream must return walGap"))) true)

fn testOutboxAndAppliedSeqCheckpoint -> Bool
  (let [(outbox (ckpt/OutboxEntry :id "msg-1" :eventType "entityCreated" :payload "{\"id\": 101}" :seq 42 :createdAt 1726500000 :processed false))] (assert (= outbox.id "msg-1") "outbox id matches") (assert (= outbox.eventType "entityCreated") "outbox eventType matches") (assert (= outbox.seq 42) "outbox seq matches 42") (assert (not outbox.processed) "outbox processed is false") (let [(reg (vfs/makeVFSRegistry)) (cp (ckpt/createVfsCheckpointWithSeq reg "phase-534" 42)) (asnDoc (ckpt/formatCheckpointAsn cp)) (parsedCpOpt (ckpt/parseCheckpointAsn asnDoc))] (assert (stringContains? asnDoc ":applied-seq 42") "formatted checkpoint includes :applied-seq") (assert (some? parsedCpOpt) "parsed checkpoint is some") (match parsedCpOpt ((none) (assert false "parsedCpOpt missing")) ((some parsedCp) (assert (= parsedCp.appliedSeq 42) "restored checkpoint preserves appliedSeq watermark") (assert (= parsedCp.phaseId "phase-534") "restored checkpoint preserves phaseId") true))))

fn testDualPolarityRefutations -> Bool
  (let [(entry (wal/makeWalEntry 1 1000 (wal/opPutNode) "k" "payload")) (frame (wal/formatWalFrame entry))] (let [(corruptedF (stringReplace frame ":op \"n+\"" ":op \"unknown_op\"")) (parsedBadOp (wal/parseWalFrame corruptedF))] (refute (some? parsedBadOp) "unknown operation code must refute some") (assert (none? parsedBadOp) "unknown operation returns none")) (let [(badFrame "") (parsedEmpty (wal/parseWalFrame badFrame))] (refute (some? parsedEmpty) "empty frame string must refute some") (assert (none? parsedEmpty) "empty frame returns none")) (let [(flippedByteFrame (stringReplace frame ":seq 1" ":seq 2")) (parsedFlipped (wal/parseWalFrame flippedByteFrame))] (refute (some? parsedFlipped) "frame with mismatched sequence number must refute some") (assert (none? parsedFlipped) "frame with mismatched sequence returns none")) (let [(truncatedFrame (stringSlice frame 0 20))] (refute (match truncatedFrame ((none) true) ((some truncatedFrameVal) (some? (wal/parseWalFrame truncatedFrameVal)))) "truncated frame must refute some") (assert (match truncatedFrame ((none) false) ((some truncatedFrameVal2) (none? (wal/parseWalFrame truncatedFrameVal2)))) "truncated frame returns none")) (let [(e1 (wal/makeWalEntry 1 1000 (wal/opPutNode) "k1" "p1")) (e3 (wal/makeWalEntry 3 1002 (wal/opPutNode) "k3" "p3")) (gapOnlyStream (str (wal/formatWalFrame e1) "\n" (wal/formatWalFrame e3))) (gapRes (wal/parseWalStreamStrict gapOnlyStream 1))] (refute (wal/isWalSuccess? gapRes) "gap stream must refute success") (assert (wal/isWalGap? gapRes) "gap stream confirms walGap")) (let [(reg (vfs/makeVFSRegistry)) (cp (ckpt/createVfsCheckpointWithSeq reg "test-phase" 100)) (doc (ckpt/formatCheckpointAsn cp))] (refute (stringContains? doc ":applied-seq 0") "watermarked checkpoint refutes default sequence 0") (assert (stringContains? doc ":applied-seq 100") "watermarked checkpoint confirms sequence 100")) (let [(legacyDoc "(:checkpoint\n  :id \"cp-legacy-1\"\n  :phase-id \"phase-old\"\n  :created-at-ms 1000\n  :cas-root \"root\"\n  :dirty-count 0\n  :buffers [\n  ])") (legacyParsed (ckpt/parseCheckpointAsn legacyDoc))] (assert (some? legacyParsed) "legacy checkpoint without :applied-seq parses for backward compatibility") (refute (match legacyParsed ((none) true) ((some legacyParsedVal) (!= legacyParsedVal.appliedSeq 0))) "legacy checkpoint defaults appliedSeq to 0") (assert (match legacyParsed ((none) false) ((some legacyParsedVal2) (= legacyParsedVal2.appliedSeq 0))) "legacy appliedSeq is 0")) (let [(st (wal/makeWalState "test.wal")) (p1 (wal/appendWalEntry st (wal/opPutNode) "k1" "v1" 100)) (st1 (pairFirst p1)) (p2 (wal/appendWalEntry st1 (wal/opPutNode) "k2" "v2" 101)) (st2 (pairFirst p2))] (refute (= st2.currentSeq 1) "second entry refutes seq 1") (assert (= st2.currentSeq 2) "second entry has seq 2") (assert (= (listLength st2.unflushed) 2) "unflushed has 2 entries") (let [(drainPair (wal/walDrainUnflushed st2)) (stDrained (pairFirst drainPair)) (drainedList (pairSecond drainPair))] (refute (> (listLength stDrained.unflushed) 0) "drained state refutes unflushed entries") (assert (= (listLength stDrained.unflushed) 0) "drained state has 0 unflushed") (assert (= (listLength drainedList) 2) "drained list has 2 entries"))) (let [(validEntry (wal/makeWalEntry 1 1000 (wal/opPutNode) "key" "val")) (validF (wal/formatWalFrame validEntry)) (validParsed (wal/parseWalFrame validF))] (refute (none? validParsed) "valid frame refutes none")) (let [(corruptedStream (str (wal/formatWalFrame (wal/makeWalEntry 1 1000 (wal/opPutNode) "k1" "p1")) "\n" "invalid-corrupted-wal-frame\n")) (corruptRes (wal/parseWalStreamStrict corruptedStream 1))] (refute (wal/isWalSuccess? corruptRes) "corrupt stream refutes success") (refute (wal/isWalGap? corruptRes) "corrupt stream refutes gap") (assert (wal/isWalCorrupt? corruptRes) "corrupt stream confirms walCorrupt")) (let [(e1 (wal/makeWalEntry 1 1000 (wal/opPutNode) "k1" "p1")) (e2 (wal/makeWalEntry 2 1001 (wal/opPutNode) "k2" "p2")) (stream (str (wal/formatWalFrame e1) "\n" (wal/formatWalFrame e2))) (res (wal/parseWalStreamStrict stream 1))] (refute (wal/isWalGap? res) "valid stream refutes walGap") (refute (wal/isWalCorrupt? res) "valid stream refutes walCorrupt") (assert (wal/isWalSuccess? res) "valid stream confirms success")) (let [(ob (ckpt/OutboxEntry :id "m1" :eventType "created" :payload "{}" :seq 1 :createdAt 1000 :processed false))] (refute ob.processed "fresh outbox entry refutes processed true") (refute (stringEmpty? ob.id) "outbox entry refutes empty id") (refute (= ob.seq 0) "outbox entry refutes seq 0")) true)

fn runTests -> Bool
  (do (assert (testWalQuoteEscapingRoundtrip) "testWalQuoteEscapingRoundtrip must pass") (assert (testWalChecksumIntegrity) "testWalChecksumIntegrity must pass") (assert (testWalStreamGapDetection) "testWalStreamGapDetection must pass") (assert (testOutboxAndAppliedSeqCheckpoint) "testOutboxAndAppliedSeqCheckpoint must pass") (assert (testDualPolarityRefutations) "testDualPolarityRefutations must pass") true)

fn RunTests -> Bool
  (runTests)
