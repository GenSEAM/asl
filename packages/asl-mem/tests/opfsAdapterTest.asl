(module asl/packages/asl-mem/tests/opfsAdapterTest :x [runTests RunTests testOpfsInitialization testOpfsWriteAndRead testOpfsAtomicFlushAndReload testOpfsPathSandboxGuards testDualPolarityRefutations] :i [(../src/opfsAdapter :a oa)])

fn testOpfsInitialization -> Bool
  (let [(st (oa/initOpfsStorage "agent_memory"))] (assert (= st.rootPrefix "agent_memory") "Root prefix is agent_memory") (assert (= (listLength st.records) 0) "Initial record count is 0") (refute (!= st.rootPrefix "agent_memory") "Root prefix refutes mismatch") true)

fn testOpfsWriteAndRead -> Bool
  (let [(st0 (oa/initOpfsStorage "agent_memory")) (rec "(:task :id \"Task-01\" :status :done)") (writeRes (oa/opfsWriteRecord st0 "tasks/01.asn" rec))] (assert (ok? writeRes) "Writing record to OPFS returns ok") (refute (err? writeRes) "Writing record must not error") (let [(st1 (optionOr (mt writeRes ((ok s) (some s)) ((err _) (none))) st0)) (readRes (oa/opfsReadRecord st1 "tasks/01.asn"))] (assert (ok? readRes) "Reading written record returns ok") (let [(content (optionOr (mt readRes ((ok c) (some c)) ((err _) (none))) ""))] (assert (= content rec) "Read content matches exact written record") (assert (stringContains? content "Task-01") "Content contains Task-01") (refute (!= content rec) "Content must refute divergence") true)))

fn testOpfsAtomicFlushAndReload -> Bool
  (let [(st0 (oa/initOpfsStorage "agent_memory")) (recA "(:note :id \"N1\" :text \"alpha\")") (recB "(:note :id \"N2\" :text \"beta\")") (wRes1 (oa/opfsWriteRecord st0 "notes/n1.asn" recA))] (assert (ok? wRes1) "Write N1 ok") (let [(st1 (optionOr (mt wRes1 ((ok s) (some s)) ((err _) (none))) st0)) (wRes2 (oa/opfsWriteRecord st1 "notes/n2.asn" recB))] (assert (ok? wRes2) "Write N2 ok") (let [(st2 (optionOr (mt wRes2 ((ok s) (some s)) ((err _) (none))) st1)) (flushRes (oa/opfsFlush st2))] (assert (ok? flushRes) "Flushing OPFS returns ok") (refute (err? flushRes) "Flushing OPFS must not error") (let [(stFlushed (optionOr (mt flushRes ((ok s) (some s)) ((err _) (none))) st2)) (listRes (oa/opfsListRecords stFlushed))] (assert (ok? listRes) "Listing records returns ok") (let [(items (optionOr (mt listRes ((ok l) (some l)) ((err _) (none))) (list)))] (assert (= (listLength items) 2) "Found exactly 2 persisted records") (refute (!= (listLength items) 2) "Persisted record count refutes non-2") true)))))

fn testOpfsPathSandboxGuards -> Bool
  (let [(st (oa/initOpfsStorage "agent_memory")) (escWrite1 (oa/opfsWriteRecord st "../escape.txt" "hack")) (escWrite2 (oa/opfsWriteRecord st "/etc/passwd" "hack")) (escRead (oa/opfsReadRecord st "../secret.txt")) (emptyRead (oa/opfsReadRecord st ""))] (assert (err? escWrite1) "Relative escape write returns error") (refute (ok? escWrite1) "Relative escape write refutes ok") (assert (err? escWrite2) "Absolute path write returns error") (refute (ok? escWrite2) "Absolute path write refutes ok") (assert (err? escRead) "Escape read returns error") (refute (ok? escRead) "Escape read refutes ok") (assert (err? emptyRead) "Empty path read returns error") (refute (ok? emptyRead) "Empty path read refutes ok") true)

fn testDualPolarityRefutations -> Bool
  (let [(st (oa/initOpfsStorage "agent_memory")) (missingRead (oa/opfsReadRecord st "nonexistent.asn")) (delMissing (oa/opfsDeleteRecord st "nonexistent.asn"))] (assert (err? missingRead) "Reading nonexistent record returns error") (refute (ok? missingRead) "Reading nonexistent record refutes ok") (assert (err? delMissing) "Deleting nonexistent record returns error") (refute (ok? delMissing) "Deleting nonexistent record refutes ok") (let [(delEsc (oa/opfsDeleteRecord st "../escape.txt"))] (assert (err? delEsc) "Deleting outside sandbox returns error") (refute (ok? delEsc) "Deleting outside sandbox refutes ok")) (let [(emptyDel (oa/opfsDeleteRecord st ""))] (assert (err? emptyDel) "Empty path delete returns error") (refute (ok? emptyDel) "Empty path delete refutes ok")) (let [(stEmpty (oa/initOpfsStorage ""))] (assert (!= st.rootPrefix stEmpty.rootPrefix) "Non-empty prefix does not equal empty") (refute (= st.rootPrefix stEmpty.rootPrefix) "Non-empty prefix refutes empty prefix")) (let [(stA (oa/initOpfsStorage "alpha")) (stB (oa/initOpfsStorage "beta"))] (assert (!= stA.rootPrefix stB.rootPrefix) "Different root prefixes produce distinct states") (refute (= stA.rootPrefix stB.rootPrefix) "Different root prefixes refute equality")) true)

fn runTests -> Bool
  (do (assert (testOpfsInitialization) "testOpfsInitialization passed") (assert (testOpfsWriteAndRead) "testOpfsWriteAndRead passed") (assert (testOpfsAtomicFlushAndReload) "testOpfsAtomicFlushAndReload passed") (assert (testOpfsPathSandboxGuards) "testOpfsPathSandboxGuards passed") (assert (testDualPolarityRefutations) "testDualPolarityRefutations passed") true)

fn RunTests -> Bool
  (runTests)
