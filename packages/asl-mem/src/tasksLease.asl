(module aslMem/tasksLease :x [taskClaim taskClaimSession taskIsClaimedBy? taskIsLeaseExpired? taskRecoverSession taskSpawnSubtask taskStart taskAdvanceStep taskCaptureHandoff taskAttachReceipt taskComplete claim settle] :i [(tasksStore :a ts)])

fn taskClaim task: ts/TaskRecord nowEpoch: I64 -> ts/TaskRecord
  (ts/TaskRecord :id task.id :parentId task.parentId :phase task.phase :title task.title :kind task.kind :lane task.lane :state "claimed" :priority task.priority :ownerRole task.ownerRole :createdAt task.createdAt :updatedAt nowEpoch :startedAt task.startedAt :completedAt task.completedAt :owns task.owns :targetSymbols task.targetSymbols :relatedSymbols task.relatedSymbols :dependsOn task.dependsOn :gate task.gate :why task.why :spec task.spec :acceptanceCriteria task.acceptanceCriteria :stepIndex task.stepIndex :actionDag task.actionDag :handoffContext task.handoffContext :receipts task.receipts :sessionId task.sessionId :leaseExpiresAt task.leaseExpiresAt :effort task.effort :risk task.risk :rootCause task.rootCause :consequences task.consequences :drawbacks task.drawbacks)

fn taskClaimSession task: ts/TaskRecord sessionId: Str leaseMs: I64 nowEpoch: I64 -> ts/TaskRecord
  (if (and (or (= task.state "claimed") (= task.state "in-progress")) (and (!= task.sessionId "") (and (!= task.sessionId sessionId) (not (taskIsLeaseExpired? task nowEpoch))))) task (ts/TaskRecord :id task.id :parentId task.parentId :phase task.phase :title task.title :kind task.kind :lane task.lane :state "claimed" :priority task.priority :ownerRole task.ownerRole :createdAt task.createdAt :updatedAt nowEpoch :startedAt task.startedAt :completedAt task.completedAt :owns task.owns :targetSymbols task.targetSymbols :relatedSymbols task.relatedSymbols :dependsOn task.dependsOn :gate task.gate :why task.why :spec task.spec :acceptanceCriteria task.acceptanceCriteria :stepIndex task.stepIndex :actionDag task.actionDag :handoffContext task.handoffContext :receipts task.receipts :sessionId sessionId :leaseExpiresAt (+ nowEpoch leaseMs) :effort task.effort :risk task.risk :rootCause task.rootCause :consequences task.consequences :drawbacks task.drawbacks))

fn taskIsClaimedBy? task: ts/TaskRecord sessionId: Str -> Bool
  (= task.sessionId sessionId)

fn taskIsLeaseExpired? task: ts/TaskRecord nowEpoch: I64 -> Bool
  (and (> task.leaseExpiresAt 0) (>= nowEpoch task.leaseExpiresAt))

fn taskRecoverSession task: ts/TaskRecord newSessionId: Str leaseMs: I64 nowEpoch: I64 -> ts/TaskRecord
  (ts/TaskRecord :id task.id :parentId task.parentId :phase task.phase :title task.title :kind task.kind :lane task.lane :state "in-progress" :priority task.priority :ownerRole task.ownerRole :createdAt task.createdAt :updatedAt nowEpoch :startedAt (if (= task.startedAt 0) nowEpoch task.startedAt) :completedAt task.completedAt :owns task.owns :targetSymbols task.targetSymbols :relatedSymbols task.relatedSymbols :dependsOn task.dependsOn :gate task.gate :why task.why :spec task.spec :acceptanceCriteria task.acceptanceCriteria :stepIndex task.stepIndex :actionDag task.actionDag :handoffContext task.handoffContext :receipts task.receipts :sessionId newSessionId :leaseExpiresAt (+ nowEpoch leaseMs) :effort task.effort :risk task.risk :rootCause task.rootCause :consequences task.consequences :drawbacks task.drawbacks)

fn taskSpawnSubtask parent: ts/TaskRecord subtaskId: Str title: Str owns: (List Str) nowEpoch: I64 -> ts/TaskRecord
  (ts/TaskRecord :id subtaskId :parentId parent.id :phase parent.phase :title title :kind "task-spawn" :lane parent.lane :state "queued" :priority parent.priority :ownerRole parent.ownerRole :createdAt nowEpoch :updatedAt nowEpoch :startedAt 0 :completedAt 0 :owns owns :targetSymbols (list) :relatedSymbols (list) :dependsOn (list parent.id) :gate parent.gate :why (str "Discovered sub-task derived from " parent.id) :spec (str "Sub-task dynamically spawned during execution of " parent.id) :acceptanceCriteria (list "exit-code 0") :stepIndex 0 :actionDag (list "Execute discovered sub-task") :handoffContext "" :receipts (list) :sessionId "" :leaseExpiresAt 0 :effort parent.effort :risk parent.risk :rootCause "" :consequences (list) :drawbacks (list))

fn taskStart task: ts/TaskRecord nowEpoch: I64 -> ts/TaskRecord
  (ts/TaskRecord :id task.id :parentId task.parentId :phase task.phase :title task.title :kind task.kind :lane task.lane :state "in-progress" :priority task.priority :ownerRole task.ownerRole :createdAt task.createdAt :updatedAt nowEpoch :startedAt nowEpoch :completedAt task.completedAt :owns task.owns :targetSymbols task.targetSymbols :relatedSymbols task.relatedSymbols :dependsOn task.dependsOn :gate task.gate :why task.why :spec task.spec :acceptanceCriteria task.acceptanceCriteria :stepIndex task.stepIndex :actionDag task.actionDag :handoffContext task.handoffContext :receipts task.receipts :sessionId task.sessionId :leaseExpiresAt task.leaseExpiresAt :effort task.effort :risk task.risk :rootCause task.rootCause :consequences task.consequences :drawbacks task.drawbacks)

fn taskAdvanceStep task: ts/TaskRecord nowEpoch: I64 -> ts/TaskRecord
  (ts/TaskRecord :id task.id :parentId task.parentId :phase task.phase :title task.title :kind task.kind :lane task.lane :state task.state :priority task.priority :ownerRole task.ownerRole :createdAt task.createdAt :updatedAt nowEpoch :startedAt task.startedAt :completedAt task.completedAt :owns task.owns :targetSymbols task.targetSymbols :relatedSymbols task.relatedSymbols :dependsOn task.dependsOn :gate task.gate :why task.why :spec task.spec :acceptanceCriteria task.acceptanceCriteria :stepIndex (+ task.stepIndex 1) :actionDag task.actionDag :handoffContext task.handoffContext :receipts task.receipts :sessionId task.sessionId :leaseExpiresAt task.leaseExpiresAt :effort task.effort :risk task.risk :rootCause task.rootCause :consequences task.consequences :drawbacks task.drawbacks)

fn taskCaptureHandoff task: ts/TaskRecord contextSnapshot: Str nowEpoch: I64 -> ts/TaskRecord
  (ts/TaskRecord :id task.id :parentId task.parentId :phase task.phase :title task.title :kind task.kind :lane task.lane :state task.state :priority task.priority :ownerRole task.ownerRole :createdAt task.createdAt :updatedAt nowEpoch :startedAt task.startedAt :completedAt task.completedAt :owns task.owns :targetSymbols task.targetSymbols :relatedSymbols task.relatedSymbols :dependsOn task.dependsOn :gate task.gate :why task.why :spec task.spec :acceptanceCriteria task.acceptanceCriteria :stepIndex task.stepIndex :actionDag task.actionDag :handoffContext contextSnapshot :receipts task.receipts :sessionId task.sessionId :leaseExpiresAt task.leaseExpiresAt :effort task.effort :risk task.risk :rootCause task.rootCause :consequences task.consequences :drawbacks task.drawbacks)

fn taskAttachReceipt task: ts/TaskRecord receipt: ts/TaskReceipt nowEpoch: I64 -> ts/TaskRecord
  (let [(rAsn (ts/formatReceiptAsn receipt)) (newState (if (ts/receiptIsVerified? receipt) "completed" "failed")) (compTs (if (ts/receiptIsVerified? receipt) nowEpoch 0))] (ts/TaskRecord :id task.id :parentId task.parentId :phase task.phase :title task.title :kind task.kind :lane task.lane :state newState :priority task.priority :ownerRole task.ownerRole :createdAt task.createdAt :updatedAt nowEpoch :startedAt task.startedAt :completedAt compTs :owns task.owns :targetSymbols task.targetSymbols :relatedSymbols task.relatedSymbols :dependsOn task.dependsOn :gate task.gate :why task.why :spec task.spec :acceptanceCriteria task.acceptanceCriteria :stepIndex task.stepIndex :actionDag task.actionDag :handoffContext task.handoffContext :receipts (listAppend task.receipts (list rAsn)) :sessionId task.sessionId :leaseExpiresAt task.leaseExpiresAt :effort task.effort :risk task.risk :rootCause task.rootCause :consequences task.consequences :drawbacks task.drawbacks))

fn taskComplete task: ts/TaskRecord receipt: Str nowEpoch: I64 -> ts/TaskRecord
  (ts/TaskRecord :id task.id :parentId task.parentId :phase task.phase :title task.title :kind task.kind :lane task.lane :state "completed" :priority task.priority :ownerRole task.ownerRole :createdAt task.createdAt :updatedAt nowEpoch :startedAt task.startedAt :completedAt nowEpoch :owns task.owns :targetSymbols task.targetSymbols :relatedSymbols task.relatedSymbols :dependsOn task.dependsOn :gate task.gate :why task.why :spec task.spec :acceptanceCriteria task.acceptanceCriteria :stepIndex task.stepIndex :actionDag task.actionDag :handoffContext task.handoffContext :receipts (listAppend task.receipts (list receipt)) :sessionId task.sessionId :leaseExpiresAt task.leaseExpiresAt :effort task.effort :risk task.risk :rootCause task.rootCause :consequences task.consequences :drawbacks task.drawbacks)

fn claim task: ts/TaskRecord nowEpoch: I64 -> ts/TaskRecord
  (taskClaim task nowEpoch)

fn settle task: ts/TaskRecord receipt: Str nowEpoch: I64 -> ts/TaskRecord
  (taskComplete task receipt nowEpoch)
