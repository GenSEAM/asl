(module asl-mem/store
  :doc "In-memory vector embeddings store and cosine similarity search engine"
  :export [VectorEntry SearchMatch dot-product cosine-similarity top-k]
  :import [(core/strings :as s)])

(defschema VectorEntry
  (:field id String "Unique document / item ID")
  (:field text String "Raw text snippet")
  (:field embedding (List Float64) "Dense vector embeddings"))

(defschema SearchMatch
  (:field entry VectorEntry "Matched document")
  (:field score Float64 "Cosine similarity score [-1.0, 1.0]"))

(defun dot-product [(a (List Float64)) (b (List Float64))] -> Float64
  :doc "Computes dot product between two float vectors"
  (match a
    ((list) 0.0)
    ((cons h1 t1)
      (match b
        ((list) 0.0)
        ((cons h2 t2) (+ (* h1 h2) (dot-product t1 t2)))))))

(defun approx-sqrt [(n Float64)] -> Float64
  :doc "Newton-Raphson square root approximation"
  (if (<= n 0.0)
      0.0
      (let [(x0 (/ n 2.0))
            (x1 (/ (+ x0 (/ n x0)) 2.0))
            (x2 (/ (+ x1 (/ n x1)) 2.0))]
        x2)))

(defun cosine-similarity [(a (List Float64)) (b (List Float64))] -> Float64
  :doc "Computes normalized cosine similarity"
  (let [(dot (dot-product a b))
        (norm-a (approx-sqrt (dot-product a a)))
        (norm-b (approx-sqrt (dot-product b b)))]
    (if (or (== norm-a 0.0) (== norm-b 0.0))
        0.0
        (/ dot (* norm-a norm-b)))))

(defun top-k [(query-vec (List Float64)) (entries (List VectorEntry)) (k Int64)] -> (List SearchMatch)
  :doc "Ranks items by cosine similarity"
  (match entries
    ((list) (list))
    ((cons head tail)
      (let [(sim (cosine-similarity query-vec (.-embedding head)))
            (match-item (SearchMatch :entry head :score sim))]
        (cons match-item (top-k query-vec tail (- k 1)))))))
