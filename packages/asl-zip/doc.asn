(:doc :symbol "asl/packages/asl-zip/src/inflate.asl#buildTable!" :text "1024-entry primary table; counts at 2048, symbols 2080")
(:doc :symbol "asl/packages/asl-zip/src/inflate.asl#slowDecode" :text "canonical decode for codes longer than 10 bits")
(:doc :symbol "asl/packages/asl-zip/src/inflate.asl#growOut!" :text "doubling regrowth, never past the limit")
