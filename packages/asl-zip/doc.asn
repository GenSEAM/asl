(:doc :symbol "asl/packages/asl-zip/src/gzip.asl#" :text "RFC 1952 pure-ASL gzip decoder and CRC-32")
(:doc :symbol "asl/packages/asl-zip/src/gzip.asl#crcTables!" :text "xor bytes at a*256+b; CRC table at 65536")
(:doc :symbol "asl/packages/asl-zip/src/gzip.asl#crc4!" :text "four interleaved streams overlap the table lookups")
(:doc :symbol "asl/packages/asl-zip/src/gzip.asl#mulMod" :text "zlib multmodp; bit 31 is x^0")
(:doc :symbol "asl/packages/asl-zip/src/gzip.asl#crcCombine" :text "zlib crc32_combine joins the four streams")
(:doc :symbol "asl/packages/asl-zip/src/gzip.asl#members!" :text "members share one ISIZE-preallocated output buffer")
(:doc :symbol "asl/packages/asl-zip/src/gzip.asl#gunzipWithLimit!" :text "output above limit bytes is an Err")
(:doc :symbol "asl/packages/asl-zip/src/inflate.asl#" :text "Pure AgentScript RFC 1951 DEFLATE decoder")
(:doc :symbol "asl/packages/asl-zip/src/inflate.asl#overrun?" :text "consumed bits past input end mean truncation")
(:doc :symbol "asl/packages/asl-zip/src/inflate.asl#buildTable!" :text "1024-entry primary table; counts at 2048, symbols 2080")
(:doc :symbol "asl/packages/asl-zip/src/inflate.asl#slowDecode" :text "canonical decode for codes longer than 10 bits")
(:doc :symbol "asl/packages/asl-zip/src/inflate.asl#growOut!" :text "doubling regrowth, never past the limit")
(:doc :symbol "asl/packages/asl-zip/src/inflate.asl#joinTables" :text "literal table at 0, distance table at 2720")
(:doc :symbol "asl/packages/asl-zip/src/inflate.asl#huff!" :text "self-recursive only, so native code is one loop")
(:doc :symbol "asl/packages/asl-zip/src/inflate.asl#inflateAppend!" :text "decode into out from op, capped at limit")
(:doc :symbol "asl/packages/asl-zip/tests/inflateSpeedTest.asl#" :text "Native gunzip throughput gate (INFLATE3). runTests, under asl-host, writes a deterministic 64 MB CSV-like text (a fixed LCG, about 2.7:1 under gzip -6), compresses it with the system gzip -6 and takes the system gzip -dc output as the reference; it then builds this very module natively (asl1 build to LLVM IR, /usr/bin/clang -O2 against libaslrt.a) and runs the artifact under perl, which reports the child's user+sys CPU seconds. main, in the artifact, gunzips the input with asl-zip, compares the output with the reference byte for byte, and decodes the edge fixtures: an empty member, stored blocks, a truncated member and a bad CRC. The gate asserts byte equality, the edge results and at least 50 MB/s of decoded output per CPU second, the CPU time covering the whole process (reading both files and the comparison included).")
(:doc :symbol "asl/packages/asl-zip/tests/inflateSpeedTest.asl#edgeOk!" :text "ok when gunzip of the fixture equals the plain fixture, else what differs.")
(:doc :symbol "asl/packages/asl-zip/tests/inflateSpeedTest.asl#edgeErr!" :text "The error text of gunzip of the fixture, or ok when it decodes.")
(:doc :symbol "asl/packages/asl-zip/tests/inflateSpeedTest.asl#generator" :text "perl writing the fixture text to its argument: rows of a millisecond clock, one of 8 symbols, a price, a size, a side and an id, from the LCG x = (1103515245 x + 12345) mod 2^31 seeded 12345, until 64000000 bytes.")
(:doc :symbol "asl/packages/asl-zip/tests/inflateSpeedTest.asl#cpuRunner" :text "perl running its arguments as a child and printing the child's user+sys CPU seconds and exit code on stderr.")
(:doc :symbol "asl/packages/asl-zip/tests/inflateSpeedTest.asl#field" :text "The value after key= in text up to the next space or newline, or empty.")
(:doc :symbol "asl/packages/asl-zip/tests/zipTest.asl#" :text "Acceptance and conformance tests for pure-ASL DEFLATE and gzip decoder")
