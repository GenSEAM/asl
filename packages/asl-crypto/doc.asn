(:doc :symbol "asl/packages/asl-crypto/src/aes.asl#" :text "FIPS-197 AES block cipher for 128, 192, and 256 bit keys.")
(:doc :symbol "asl/packages/asl-crypto/src/fernet.asl#" :text "Fernet token verification and AES-CBC message recovery.")
(:doc :symbol "asl/packages/asl-crypto/src/hmac.asl#" :text "RFC 2104 HMAC-SHA256 and constant-time byte equality.")
(:doc :symbol "asl/packages/asl-crypto/tests/aesTest.asl#" :text "FIPS-197 AES block vectors and CBC padding validation.")
(:doc :symbol "asl/packages/asl-crypto/tests/fernetFixture.asl#" :text "Fernet spec verify.json vector, decoded AES fields, and expected plaintext.")
(:doc :symbol "asl/packages/asl-crypto/tests/fernetTest.asl#" :text "Fernet token verification vectors and rejection cases.")
(:doc :symbol "asl/packages/asl-crypto/tests/hmacTest.asl#" :text "RFC 4231 SHA-256 HMAC vectors and constant-time equality behaviour.")
(:doc :symbol "asl/packages/asl-crypto/src/sha.asl#" :text "FIPS 180-4 SHA-1 and SHA-512 on Bytes, plus RFC 2104 HMAC-SHA512 with a 128-byte block.")
(:doc :symbol "asl/packages/asl-crypto/src/random.asl#" :text "OS entropy from /dev/urandom: randomBytes (0 to 1048576 bytes) and lowercase RFC 4122 version-4 UUIDs.")
(:doc :symbol "asl/packages/asl-crypto/tests/shaRandTest.asl#" :text "SHA-1/SHA-512 NIST vectors, RFC 4231 HMAC-SHA512 cases 1, 2 and 6, randomBytes and UUID checks.")
(:doc :symbol "asl/packages/asl-crypto/tests/shaRandTest.asl#runTests" :text "Returns true after asserting SHA-1/SHA-512 vectors, HMAC-SHA512 cases, randomBytes bounds and 1000 unique version-4 UUIDs; fails by assert on any mismatch.")
(:doc :symbol "asl/packages/asl-crypto/src/sha.asl#sha1" :text "Returns the 20-byte FIPS 180-4 SHA-1 digest of the input Bytes; never fails.")
(:doc :symbol "asl/packages/asl-crypto/src/sha.asl#sha512" :text "Returns the 64-byte FIPS 180-4 SHA-512 digest of the input Bytes; never fails.")
(:doc :symbol "asl/packages/asl-crypto/src/sha.asl#hmacSha512" :text "Returns the 64-byte RFC 2104 HMAC-SHA512 of msg under key with a 128-byte block, hashing keys longer than the block; never fails.")
(:doc :symbol "asl/packages/asl-crypto/src/random.asl#randomBytes" :text "Returns n random bytes read from /dev/urandom; errs when n is below 0 or above 1048576 or the read fails.")
(:doc :symbol "asl/packages/asl-crypto/src/random.asl#uuidV4" :text "Returns a lowercase 8-4-4-4-12 RFC 4122 version-4 UUID with variant 10 bits set; errs when the underlying randomBytes read fails.")
