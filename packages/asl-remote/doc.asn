(:doc :symbol "asl/packages/asl-remote/src/target.asl#" :text "Remote target routing: a workspace .asl/target.asn (:target :exec remote :node NODE :wt UNIT), or asl --on NODE:UNIT for one call, sends asl forms, test and check to the worktree wt/UNIT on that node through tools/remote/on.asl; asl --local ignores the profile; no file means local as before")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#Target" :text "a remote worktree: node id (empty for the default node of ~/.asl/remote.asn) and worktree unit")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#Route" :text "one routed call: node, unit, verb (forms, test or check) and its arguments; a forms route holds the whole batch as one argument")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#profileRel" :text "the workspace-relative path of the target profile, .asl/target.asn")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#parseOn" :text "NODE:UNIT or UNIT to a Target; default as NODE is the default node; names outside [A-Za-z0-9-] are refused")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#parseProfile" :text "a target.asn text to some Target for :exec remote, none for :exec local, err for anything else")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#loadProfile!" :text "parseProfile of ROOT/.asl/target.asn; an absent file is none")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#findProfile!" :text "the profile of the nearest enclosing directory that has .asl/target.asn, searched no higher than the first directory holding .asl.config.asn or .git")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#routeOf" :text "the routing decision for a CLI argv under a profile: --local is local, --on SPEC routes forms, test and check and refuses other verbs, a remote profile routes forms and test or check with files, everything else stays local")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#remoteArgv" :text "the argv run inside the remote worktree: env -u ASL_ROOT -u ASL_PRELUDE ./bin/asl BATCH for forms, niced ./bin/asl test|check FILES otherwise")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#timeoutOf" :text "the remote bound in seconds: 1800 for test, 600 for forms and check, as tools/remote/vps.asl uses")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#onArgv" :text "the local asl run argv of tools/remote/on.asl for a route, the default node spelled default")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#promptLine" :text "the one launcher prompt line telling an agent its code lives in NODE:wt/UNIT and is reached only through asl forms, test and check")
(:doc :symbol "asl/packages/asl-remote/src/target.asl#localArgs" :text "the argv for local dispatch: a leading --local dropped, anything else unchanged")
