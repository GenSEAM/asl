(module asl-audio/tests/voiceIntentTest :x [runTests] :i [(asl-audio/voiceIntent :a vi)])

; (:m :ref COVBATCH5 :do "voice utterance to action keyword in English and Russian, first rule wins, default query")
fn runTests -> Bool
  (do (assert (= (vi/extractActionFromUtterance "run the test") "test") "test word gives test")
      (assert (= (vi/extractActionFromUtterance "запусти тесты") "test") "Russian tests give test")
      (assert (= (vi/extractActionFromUtterance "please CHECK it") "check") "check is matched without case")
      (assert (= (vi/extractActionFromUtterance "проверь") "check") "Russian check")
      (assert (= (vi/extractActionFromUtterance "read the file") "read") "read")
      (assert (= (vi/extractActionFromUtterance "прочитай") "read") "Russian read")
      (assert (= (vi/extractActionFromUtterance "flush now") "flush") "flush")
      (assert (= (vi/extractActionFromUtterance "сохрани") "flush") "Russian save is flush")
      (assert (= (vi/extractActionFromUtterance "примени") "flush") "Russian apply is flush")
      (assert (= (vi/extractActionFromUtterance "reset it") "reset") "reset")
      (assert (= (vi/extractActionFromUtterance "сбрось") "reset") "Russian reset")
      (assert (= (vi/extractActionFromUtterance "kill it") "kill") "kill")
      (assert (= (vi/extractActionFromUtterance "убей") "kill") "Russian kill")
      (assert (= (vi/extractActionFromUtterance "останови") "kill") "Russian stop is kill")
      (assert (= (vi/extractActionFromUtterance "edit this") "edit") "edit")
      (assert (= (vi/extractActionFromUtterance "измени") "edit") "Russian edit")
      (assert (= (vi/extractActionFromUtterance "what is this") "query") "no keyword gives query")
      (assert (= (vi/extractActionFromUtterance "") "query") "empty utterance gives query")
      (assert (= (vi/extractActionFromUtterance "test then check") "test") "test outranks check")
      (assert (= (vi/extractActionFromUtterance "check and read") "check") "check outranks read")
      (assert (= (vi/classifyIntentTeleologyTier (vi/extractActionFromUtterance "kill it")) "tier2") "an extracted kill is tier2")
      true)
