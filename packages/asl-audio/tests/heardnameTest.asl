(module asl-audio/tests/heardnameTest :x [runTests] :i [(asl-audio/heardname :a hn)])

; (:m :ref COVBATCH5 :do "voice symbol matching: camelCase stems split to lowercase words, a latinized and phoneme-folded query picks the best candidate by symbol, stems or path, and a confidence floor decides the match")
fn cand symbol: String path: String -> hn/AstSymbolCandidate
  (hn/makeAstSymbolCandidate symbol path "fn")

fn runTests -> Bool
  (let [(cands (list (cand "writeFile" "src/w") (cand "readFile" "src/r") (cand "reader" "src/x")))
        (exact (hn/matchVoiceQueryToAstSymbol "read file" cands 0.6))
        (cyr (hn/matchVoiceQueryToAstSymbol "ридер" (list (cand "writeFile" "src/w") (cand "reader" "src/x")) 0.6))
        (miss (hn/matchVoiceQueryToAstSymbol "zzzzzz" cands 0.6))
        (none1 (hn/matchVoiceQueryToAstSymbol "read file" (list) 0.6))
        (high (hn/matchVoiceQueryToAstSymbol "read file" cands 0.93))
        (byPath (hn/matchVoiceQueryToAstSymbol "src/w" (list (cand "alpha" "lib/a") (cand "beta" "src/w")) 0.6))]
    (do (assert (= (hn/splitCamelCaseStems "findUserName") "find user name") "camel case splits at each capital into lowercase words")
        (assert (= (hn/splitCamelCaseStems "lower") "lower") "a name without capitals is unchanged")
        (assert (= (hn/splitCamelCaseStems "Foo") "foo") "a leading capital gives no leading space")
        (assert (= (hn/splitCamelCaseStems "") "") "empty name gives empty stems")
        (assert (= (hn/splitCamelCaseStems "aB") "a b") "single letter words split")
        (assert exact.isMatched "an exact spoken phrase matches")
        (assert (= exact.matchedSymbol "readFile") "the best scoring candidate is chosen even when it is not first")
        (assert (= exact.matchedPath "src/r") "the path of the best candidate is returned")
        (assert (= exact.confidence 0.92) "a query containing the stems scores 0.92")
        (assert (= exact.rawQuery "read file") "the raw query is kept")
        (assert (= exact.latinizedQuery "read file") "latin text is not changed by latinization")
        (assert cyr.isMatched "a Russian query matches after latinizing and folding phonemes")
        (assert (= cyr.latinizedQuery "rider") "ридер latinizes to rider")
        (assert (= cyr.matchedSymbol "reader") "rider folds to reader's ea sound")
        (assert (not miss.isMatched) "an unrelated query is not matched")
        (assert (= miss.matchedSymbol "") "no match gives an empty symbol")
        (assert (= miss.matchedPath "") "no match gives an empty path")
        (assert (not none1.isMatched) "no candidates give no match")
        (assert (= none1.confidence 0.0) "no candidates give confidence zero")
        (assert (not high.isMatched) "a confidence floor above the best score rejects the match")
        (assert (= high.confidence 0.92) "the best score is still reported when rejected")
        (assert byPath.isMatched "a query equal to the path matches")
        (assert (= byPath.matchedSymbol "beta") "the path score selects the candidate")
        true))
