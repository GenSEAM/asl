(:skill
  :name "asl-contracts"
  :guide "SKILL.md"
  :desc "Map of asl/packages/asl-contracts, an experimental pure AgentSlang package of contract records and validation functions (a smart-contract state-transition sketch, pipeline stage contracts, and tool descriptors with scopes and secret masking). Use when reading, changing or testing those modules. It has no SMT or Z3 proofs, no Wasm Stylus or CosmWasm ABI and no chain connection; those are named in its manifest description only."
  :rules [
    (:rule :type "mandatory" :text "Transitions are pure functions returning a TransitionResult record (success, events, errorMsg) built by transitionSuccess or transitionRevert in src/spec.asl.")
    (:rule :type "mandatory" :text "Amounts are I64; validateNonNegativeBalance rejects a negative amount. Nothing proves balance conservation.")
    (:rule :type "mandatory" :text "SMT-LIB2 proofs and a Wasm Stylus ABI are plans named in manifest.asn; no code in the package implements them.")
  ]
  :tools [
    (:tool :name "asl-contracts-spec-test" :command "asl/host/out/asl-host test asl/packages/asl-contracts/tests/specTest.asl" :purpose "Run the state-transition sketch suite from the workspace root")
    (:tool :name "asl-contracts-stage-test" :command "asl/host/out/asl-host test asl/packages/asl-contracts/tests/stageTest.asl" :purpose "Run the pipeline stage contract suite from the workspace root")
    (:tool :name "asl-contracts-toolplane-test" :command "asl/host/out/asl-host test asl/packages/asl-contracts/tests/toolPlaneTest.asl" :purpose "Run the tool descriptor suite from the workspace root")
  ])
