   "aslAgentCore/dispatch"
   "aslAgentCore/fsm"
   "aslAgentCore/onion"
   "aslAgentCore/premise"
   "aslAgentCore/promptTree"
   "aslAgentCore/promptpool"
   "aslAgentCore/protocol"
   "aslAgentCore/scheduler"
   "aslAgentCore/statemachine"
   "aslAgentCore/taskstore"
   "aslAgentCore/tasktypes"
   "aslAgentCore/threads"
   "aslAgentCore/types"
   "aslAgentCore/promptAudit"
   "aslAgentCore/fiberPool"
   "aslAgentCore/fastKnowledgeCache"
   "aslAgentCore/workerSupervisor"
   "aslAgentCore/omniDaemon"
 ]
 :dependencies ["asl-text"])
