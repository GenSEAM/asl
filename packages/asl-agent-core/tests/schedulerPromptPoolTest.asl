(module asl/packages/asl-agent-core/tests/schedulerPromptPoolTest :x [runTests] :i [(asl-text/string :a s) (aslAgentCore/scheduler :a sc) (aslAgentCore/promptpool :a pp) (aslAgentCore/tasktypes :a tt) (aslAgentCore/taskstore :a ts) (aslAgentCore/statemachine :a sm)])

fn testSchedulerSyntaxIntegrity! -> Bool
  (let [(res (fileRead "asl/packages/asl-agent-core/src/scheduler.asl")) (code (resultOr res ""))] (assert (ok? res) "scheduler.asl must exist and be readable") (refute (err? res) "scheduler.asl refutes read failure") (assert (> (stringLength code) 100) "scheduler.asl length must exceed 100 characters") (assert (stringContains? code "fn schedulerCreate") "scheduler.asl affirms modern fn schedulerCreate") (assert (stringContains? code "fn schedulerDrain") "scheduler.asl affirms modern fn schedulerDrain") (assert (stringContains? code "fn schedulerReapStale") "scheduler.asl affirms modern fn schedulerReapStale") (assert (stringContains? code "fn schedulerReleaseProject") "scheduler.asl affirms modern fn schedulerReleaseProject") (assert (stringContains? code "fn schedulerReleaseTask") "scheduler.asl affirms modern fn schedulerReleaseTask") (assert (stringContains? code "fn schedulerReleaseLane") "scheduler.asl affirms modern fn schedulerReleaseLane") (assert (stringContains? code "fn isReapableState?") "scheduler.asl affirms modern fn isReapableState?") (refute (stringContains? code "(df schedulerCreate") "scheduler.asl refutes legacy df schedulerCreate") (refute (stringContains? code "(df schedulerDrain") "scheduler.asl refutes legacy df schedulerDrain") (refute (stringContains? code "(df schedulerReapStale") "scheduler.asl refutes legacy df schedulerReapStale") (refute (stringContains? code "(df ") "scheduler.asl refutes all legacy df definitions") (refute (stringContains? code "(defun ") "scheduler.asl refutes legacy defun") (refute (stringContains? code "defn ") "scheduler.asl refutes foreign defn") true)

fn testPromptPoolSyntaxIntegrity! -> Bool
  (let [(res (fileRead "asl/packages/asl-agent-core/src/promptpool.asl")) (code (resultOr res ""))] (assert (ok? res) "promptpool.asl must exist and be readable") (refute (err? res) "promptpool.asl refutes read failure") (assert (> (stringLength code) 100) "promptpool.asl length must exceed 100 characters") (assert (stringContains? code "fn poolCapDefault") "promptPool.asl affirms modern fn poolCapDefault") (assert (stringContains? code "fn ttlMsDefault") "promptPool.asl affirms modern fn ttlMsDefault") (assert (stringContains? code "fn promptPoolCreate") "promptPool.asl affirms modern fn promptPoolCreate") (assert (stringContains? code "fn promptPoolPush") "promptPool.asl affirms modern fn promptPoolPush") (assert (stringContains? code "fn promptPoolPrune") "promptPool.asl affirms modern fn promptPoolPrune") (assert (stringContains? code "fn renderPromptPool") "promptPool.asl affirms modern fn renderPromptPool") (assert (stringContains? code "fn multiPoolCreate") "promptPool.asl affirms modern fn multiPoolCreate") (assert (stringContains? code "fn multiPoolPush") "promptPool.asl affirms modern fn multiPoolPush") (assert (stringContains? code "fn multiPoolGet") "promptPool.asl affirms modern fn multiPoolGet") (assert (stringContains? code "fn multiPoolPruneAll") "promptPool.asl affirms modern fn multiPoolPruneAll") (refute (stringContains? code "(df promptPoolCreate") "promptPool.asl refutes legacy df promptPoolCreate") (refute (stringContains? code "(df renderPromptPool") "promptPool.asl refutes legacy df renderPromptPool") (refute (stringContains? code "(df ") "promptPool.asl refutes all legacy df definitions") (refute (stringContains? code "(defun ") "promptPool.asl refutes legacy defun") (refute (stringContains? code "defn ") "promptPool.asl refutes foreign defn") true)

fn testSchedulerDrainMutualExclusion! -> Bool
  (let [(t1 (tt/taskRecordCreate "task-p1-1" "lane-alpha" "/ws/project-alpha" (tt/priorityNormal) 100 "cmd-1")) (t2 (tt/taskRecordCreate "task-p1-2" "lane-alpha" "/ws/project-alpha" (tt/priorityNormal) 200 "cmd-2")) (t3 (tt/taskRecordCreate "task-p2-1" "lane-beta" "/ws/project-beta" (tt/priorityNormal) 150 "cmd-3")) (s0 (ts/taskstoreCreate "/ws/.asl/mem/tasks")) (s1 (resultOr (ts/taskstorePut! s0 t1) s0)) (s2 (resultOr (ts/taskstorePut! s1 t2) s1)) (s3 (resultOr (ts/taskstorePut! s2 t3) s2)) (cfg (sc/SchedulerConfig :maxConcurrent 4 :staleTimeoutMs 5000)) (sched0 (sc/schedulerCreate cfg)) (drainRes0 (resultOr (sc/schedulerDrain! sched0 s3) (sc/DrainResult :scheduler sched0 :store s3 :claimedTasks (list)))) (claimed drainRes0.claimedTasks) (sched1 drainRes0.scheduler) (store1 drainRes0.store)] (assert (= (listLength claimed) 2) "Scheduler drain must claim exactly 2 tasks across 2 distinct projects") (let [(c1 (optionOr (listHead claimed) t1)) (cRest (optionOr (listTail claimed) (list))) (c2 (optionOr (listHead cRest) t1))] (assert (= c1.id "task-p1-1") "First claimed task must be earliest task-p1-1") (assert (= c2.id "task-p2-1") "Second claimed task must be task-p2-1 from distinct project-beta") (let [(t2InStore (optionOr (ts/taskstoreGet store1 "task-p1-2") t1))] (assert (= t2InStore.state (tt/stateQueued)) "Conflicting task-p1-2 on same project must remain state-queued") (refute (= t2InStore.state (tt/stateRouting)) "Conflicting task-p1-2 must not transition to state-routing") (assert (listContains? sched1.activeProjects "/ws/project-alpha") "activeProjects must track project-alpha") (assert (listContains? sched1.activeProjects "/ws/project-beta") "activeProjects must track project-beta") (refute (listContains? sched1.activeProjects "/ws/project-gamma") "activeProjects refutes unmanaged project-gamma") (let [(schedRel (sc/schedulerReleaseProject sched1 "/ws/project-alpha"))] (assert (not (listContains? schedRel.activeProjects "/ws/project-alpha")) "schedulerReleaseProject evicts project-alpha") (assert (listContains? schedRel.activeProjects "/ws/project-beta") "project-beta remains active after alpha release") (let [(drainRes1 (resultOr (sc/schedulerDrain! schedRel store1) (sc/DrainResult :scheduler schedRel :store store1 :claimedTasks (list)))) (claimed1 drainRes1.claimedTasks)] (assert (= (listLength claimed1) 1) "After releasing lock, scheduler drain claims remaining task-p1-2") (let [(cFollow (optionOr (listHead claimed1) t1))] (assert (= cFollow.id "task-p1-2") "Claimed task is now task-p1-2") (refute (= (listLength claimed1) 0) "Second drain must not be empty after lock release") true))))))

fn testSchedulerReapingAndStateInvariants! -> Bool
  (do (assert (sc/isReapableState? (tt/stateRouting)) "stateRouting is reapable") (assert (sc/isReapableState? (tt/stateClarification)) "stateClarification is reapable") (assert (sc/isReapableState? (tt/stateReady)) "stateReady is reapable") (assert (sc/isReapableState? (tt/stateExecuting)) "stateExecuting is reapable") (assert (sc/isReapableState? (tt/stateVerifying)) "stateVerifying is reapable") (refute (sc/isReapableState? (tt/stateQueued)) "stateQueued is not reapable") (refute (sc/isReapableState? (tt/stateDone)) "stateDone is not reapable") (refute (sc/isReapableState? (tt/stateFailed)) "stateFailed is not reapable") (refute (sc/isReapableState? (tt/stateCancelled)) "stateCancelled is not reapable") (let [(tStale (tt/taskRecordCreate "task-stale" "lane-stale" "/ws/stale-proj" (tt/priorityNormal) 1000 "stale")) (st0 (ts/taskstoreCreate "/ws/.asl/mem/tasks")) (st1 (resultOr (ts/taskstorePut! st0 tStale) st0)) (st2 (resultOr (ts/taskstoreClaim! st1 "task-stale") st1)) (st3 (resultOr (ts/taskstoreTransition! st2 "task-stale" (tt/stateExecuting) 1000) st2)) (cfg (sc/SchedulerConfig :maxConcurrent 3 :staleTimeoutMs 4000)) (sch (sc/SchedulerState :config cfg :activeProjects (list "/ws/stale-proj") :activeLanes (mapSet (mapEmpty) "lane-stale" 1))) (reapRes (resultOr (sc/schedulerReapStale! sch st3 6000) (sc/ReapResult :scheduler sch :store st3 :reapedCount 0)))] (assert (= reapRes.reapedCount 1) "Stale executing task exceeding 4000ms threshold must be reaped") (refute (= reapRes.reapedCount 0) "Reap result refutes zero reaped count on expired task") (let [(reapedTask (optionOr (ts/taskstoreGet reapRes.store "task-stale") tStale))] (assert (= reapedTask.state (tt/stateQueued)) "Reaped task must return to stateQueued") (refute (= reapedTask.state (tt/stateExecuting)) "Reaped task refutes remaining in stateExecuting") (assert (not (listContains? reapRes.scheduler.activeProjects "/ws/stale-proj")) "Active project lock must be released on reap") (refute (listContains? reapRes.scheduler.activeProjects "/ws/stale-proj") "Project lock refutation") true)))

fn testPromptPoolHistoryFraming -> Bool
  (let [(pool (pp/promptPoolCreate "lane-main" 3 10000))] (assert (= pool.cap 3) "Pool capacity must be 3") (assert (= pool.ttlMs 10000) "Pool TTL must be 10000") (let [(emptyRender (pp/renderPromptPool pool "initial instruction" 1000))] (assert (stringContains? emptyRender "<current-instruction>") "Empty pool renders <current-instruction>") (assert (stringContains? emptyRender "initial instruction") "Empty pool renders initial instruction text") (refute (stringContains? emptyRender "<prior-context>") "Empty pool refutes <prior-context>") (refute (stringContains? emptyRender "</prior-context>") "Empty pool refutes closing </prior-context>") (let [(p1 (pp/promptPoolPush pool "Step 1: Setup database" 1000)) (p2 (pp/promptPoolPush p1 "Step 2: Add migration" 2000)) (p3 (pp/promptPoolPush p2 "Step 3: Run seed" 3000)) (rendered3 (pp/renderPromptPool p3 "Step 4: Verify endpoints" 4000))] (assert (stringContains? rendered3 "<prior-context>") "Populated pool affirms <prior-context>") (assert (stringContains? rendered3 "</prior-context>") "Populated pool affirms </prior-context>") (assert (stringContains? rendered3 "<current-instruction>") "Populated pool affirms <current-instruction>") (assert (stringContains? rendered3 "Step 1: Setup database") "Populated pool affirms turn 1") (assert (stringContains? rendered3 "Step 2: Add migration") "Populated pool affirms turn 2") (assert (stringContains? rendered3 "Step 3: Run seed") "Populated pool affirms turn 3") (assert (stringContains? rendered3 "Step 4: Verify endpoints") "Populated pool affirms current instruction") (let [(p4 (pp/promptPoolPush p3 "Step 4: Run tests" 5000))] (assert (= (listLength p4.entries) 3) "Capacity clamps entries to 3") (let [(rendered4 (pp/renderPromptPool p4 "Step 5: Deploy" 6000))] (refute (stringContains? rendered4 "Step 1: Setup database") "Oldest entry evicted upon exceeding capacity") (assert (stringContains? rendered4 "Step 2: Add migration") "Turn 2 retained") (let [(renderedExpired (pp/renderPromptPool p4 "Step 6: Maintenance" 30000))] (refute (stringContains? renderedExpired "<prior-context>") "Expired pool refutes <prior-context>") (assert (stringContains? renderedExpired "<current-instruction>") "Expired pool renders only current instruction") true))))))

fn ! runTests -> Bool
  (and (testSchedulerSyntaxIntegrity!) (and (testPromptPoolSyntaxIntegrity!) (and (testSchedulerDrainMutualExclusion!) (and (testSchedulerReapingAndStateInvariants!) (testPromptPoolHistoryFraming)))))
