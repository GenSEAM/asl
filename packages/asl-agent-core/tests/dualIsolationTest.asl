(module asl/packages/asl-agent-core/tests/dualIsolationTest
  :x [runTests]
  :i [(asl/packages/asl-agent-core/src/fastKnowledgeCache :a kc)
      (asl/packages/asl-agent-core/src/fiberPool :a fp)
      (asl/packages/asl-agent-core/src/workerSupervisor :a ws)
      (asl/packages/asl-agent-core/src/omniDaemon :a od)
      (aslAgent/omniIntent :a oi)
      (aslAgent/frontAgent :a fa)
      (aslAgent/unbiasedContext :a uc)
      (aslVoice/voiceBuffer :a vb)
      (aslVoice/conversationalContext :a cc)
      (aslAgent/omniIngress :a ing)])

fn testFastKnowledgeCacheAndFibers -> Bool
  (let [(cache (kc/knowledgeCacheCreate))
        (c1 (kc/knowledgeIndexSymbol cache "FiberPool" "aslAgentCore/fiberPool" "asl/packages/asl-agent-core/src/fiberPool.asl" "anchor-fp" "schema"))
        (c2 (kc/knowledgeUpdateTask c1 "Task59301" ":active"))
        (c3 (kc/knowledgeRecordDefect c2 "DEF-NONE"))
        (c4 (kc/knowledgeAddNote c3 "Fast cache initialized with zero IPC tax"))
        (symOpt (kc/knowledgeLookupSymbol c4 "FiberPool"))
        (taskStatus (kc/knowledgeGetTaskStatus c4 "Task59301"))
        (pool (fp/fiberPoolCreate 16))
        (s1 (fp/fiberSpawn pool (fp/prioCritical) "(+ 1 1)" 1000))
        (p1 (pairFirst s1))
        (id1 (pairSecond s1))
        (s2 (fp/fiberSpawn p1 (fp/prioInteractive) "(lookup 'foo)" 1005))
        (p2 (pairFirst s2))
        (id2 (pairSecond s2))
        (nextRunnable (optionOr (fp/fiberNextRunnable p2) ""))]
    (assert (some? symOpt) "Symbol FiberPool found in fast cache")
    (assert (= (optionOr taskStatus "") ":active") "Task status matches in cache")
    (assert (= (listLength c4.defectLedger) 1) "Defect ledger tracked in memory")
    (assert (= (listLength c4.notesSnapshot) 1) "Notes snapshot tracked in memory")
    (assert (= (mapSize p2.activeFibers) 2) "Pool has 2 active fibers")
    (assert (= nextRunnable id1) "Critical fiber runs ahead of interactive")
    true)

fn testWorkerSupervisorAndLimits -> Bool
  (let [(cfg (ws/SupervisorLimitsConfig :slidingIdleMs 10000 :maxWallClockMs 900000 :maxMemMb 1024))
        (pool (ws/workerPoolCreate cfg))
        (s1 (ws/workerSpawn pool (ws/sandboxWorkspaceWrite) (list "src/") 12345 100000))
        (p1 (pairFirst s1))
        (wId1 (pairSecond s1))
        (recOpt (mapGet p1.workers wId1))
        (p2 (ws/workerHeartbeat p1 wId1 105000 64))
        (check1 (ws/workerCheckLimits p2 108000))
        (stalled1 (pairSecond check1))
        (check2 (ws/workerCheckLimits p2 120000))
        (stalled2 (pairSecond check2))
        (p3 (ws/workerReap (pairFirst check2) wId1))]
    (assert (= (mapSize p1.workers) 1) "Worker registered in supervisor")
    (assert (some? recOpt) "Worker record found")
    (assert (= (listLength stalled1) 0) "Worker active within 5s is not stalled")
    (assert (= (listLength stalled2) 1) "Worker idle for 15s exceeds the 10s idle limit and is stalled")
    (assert (= (mapSize p3.workers) 0) "Stalled worker was reaped from supervisor")
    true)

fn testOmniDaemonSupervisionLoop -> Bool
  (let [(wCfg (ws/SupervisorLimitsConfig :slidingIdleMs 10000 :maxWallClockMs 900000 :maxMemMb 1024))
        (dCfg (od/DaemonConfig :socketPath "/tmp/asl-engine.sock" :httpPort 8765 :maxFibers 32 :maxWorkers 8 :limitsCfg wCfg))
        (st (od/daemonInit dCfg 1000))
        (ticked (od/daemonTick st 2000))
        (status (od/formatDaemonStatus ticked))]
    (assert (= ticked.cfg.maxFibers 32) "Daemon fiber capacity configured")
    (assert (= ticked.cfg.maxWorkers 8) "Daemon worker capacity configured")
    (assert (= (listLength ticked.activeIngressChannels) 4) "Daemon must open 4 ingress channels")
    (assert (> (stringLength status) 0) "Daemon status ASN rendered")
    (assert (stringContains? status ":daemon-status") "Status contains daemon header")
    true)

fn testOmniIntentAndFrontAgentRouting -> Bool
  (let [(codeDirect "refactor fastKnowledgeCache for zero copy")
        (resDirect "search for references to FiberPool in agent-core")
        (browserDirect "open browser to https://gemini.google.com and click cart")
        (ideaDirect "note: consider compiling ASL directly to WASM")
        (syncDirect "sync schema between asex and stonefish")
        (sysDirect "asl daemon status")
        (iCode (oi/classifyOmniIntent codeDirect))
        (iRes (oi/classifyOmniIntent resDirect))
        (iBrowser (oi/classifyOmniIntent browserDirect))
        (iIdea (oi/classifyOmniIntent ideaDirect))
        (iSync (oi/classifyOmniIntent syncDirect))
        (iSys (oi/classifyOmniIntent sysDirect))
        (faCfg (fa/FrontAgentConfig :workspaceRoot "/workspace" :daemonSocket "/tmp/asl-engine.sock" :voiceEnabled true))
        (faSt (fa/frontAgentInit faCfg))
        (faHandleRes (fa/frontAgentHandleDirective faSt codeDirect))
        (faReceipt (pairSecond faHandleRes))
        (frontRes (fa/formatFrontAgentReceipt faReceipt))
        (reqVoice (ing/IngressRequest :protocol (ing/protoVoiceStream) :endpoint "mic0" :rawPayload "open browser to cart" :authHeader "voice-sig"))
        (frameVoice (ing/ingressNormalize reqVoice 800005))]
    (assert (oi/isCodeTask? iCode) "Code task classified correctly")
    (assert (oi/isResearch? iRes) "Research classified correctly")
    (assert (oi/isBrowserAction? iBrowser) "Browser action classified correctly")
    (assert (= (oi/domainToString iIdea.domain) ":ideaCapture") "Idea capture classified correctly")
    (assert (= (oi/domainToString iSync.domain) ":crossProjectSync") "Sync classified correctly")
    (assert (= (oi/domainToString iSys.domain) ":systemControl") "System control classified correctly")
    (assert (= iCode.targetSubstrate "worker-jail") "Code task targets worker jail")
    (assert (= iRes.targetSubstrate "cognitive-fiber") "Research targets cognitive fiber")
    (assert iCode.requiresGate "Code task requires verification gate")
    (assert (not iRes.requiresGate) "Research does not require gate")
    (assert (> (stringLength frontRes) 0) "Front-agent emits receipt")
    (assert (= frameVoice.sourceProtocol "voice") "Voice ingress normalized")
    (assert (= frameVoice.targetEngine "gateway-browser") "Voice browser action routed to gateway")
    true)

fn testUnbiasedContextSanitization -> Bool
  (let [(preamble "You are a helpful AI assistant developed by an enterprise.")
        (clean "refactor fiber pool in agent-core")
        (isFluffAccepted (uc/refutePersonaPreamble preamble))
        (isCleanAccepted (uc/refutePersonaPreamble clean))
        (rawObs "Sure! Here is the output:\nexit: 0, asserts: 18 passed cleanly.")
        (sanitized (uc/sanitizeObservation rawObs))
        (intent (oi/classifyOmniIntent clean))
        (symbols (list "fiberPoolCreate" "fiberSpawn"))
        (obs (list sanitized))
        (attractors (list ":simplicity" ":verification"))
        (owns (list "asl/packages/asl-agent-core/src/fiberPool.asl"))
        (frame (uc/buildUnbiasedContextFrame intent symbols obs attractors owns))
        (formatted (uc/formatUnbiasedContextFrame frame))]
    (refute (uc/refutePersonaPreamble preamble) "Persona preamble must be rejected by refutePersonaPreamble")
    (assert (uc/refutePersonaPreamble clean) "Clean prompt must be accepted")
    (assert (stringContains? sanitized "exit: 0") "Sanitized observation preserves exit code")
    (assert (not (stringContains? sanitized "Sure!")) "Sanitized observation purges greeting")
    (assert (= (listLength frame.symbols) 2) "Frame symbols preserved")
    (assert (stringContains? formatted ":unbiased-context-frame") "Formatted contains frame header")
    true)

fn testVoiceBufferAndBargeIn -> Bool
  (let [(cfg (vb/VoiceBufferConfig :sampleRate 16000 :preRollFrames 5 :speechActivationFrames 3 :silenceHangoverFrames 3))
        (st0 (vb/voiceBufferCreate cfg))
        (f1 (list 0.05 0.15))
        (r1 (vb/voiceBufferStepFrame cfg st0 f1 true))
        (st1 (pairFirst r1))
        (r2 (vb/voiceBufferStepFrame cfg st1 f1 true))
        (st2 (pairFirst r2))
        (r3 (vb/voiceBufferStepFrame cfg st2 f1 true))
        (st3 (pairFirst r3))
        (res3 (pairSecond r3))
        (r4 (vb/voiceBufferStepFrame cfg st3 f1 false))
        (st4 (pairFirst r4))
        (r5 (vb/voiceBufferStepFrame cfg st4 f1 false))
        (st5 (pairFirst r5))
        (r6 (vb/voiceBufferStepFrame cfg st5 f1 false))
        (st6 (pairFirst r6))
        (res6 (pairSecond r6))
        (cCtx (cc/conversationalContextCreate "dev1"))
        (bargeInCheck (cc/checkBargeInInterrupt cCtx true true))
        (bargeInDetected (pairSecond bargeInCheck))]
    (assert st3.isUtteranceActive "Speech activates after 3 hysteresis frames")
    (assert (= res3.actionKind "speech-started") "Res3 is speech-started")
    (assert (vb/isUtteranceSettled? res6) "Utterance settles after 3 hangover silence frames")
    (assert (not st6.isUtteranceActive) "Voice buffer state resets to inactive after settling")
    (assert bargeInDetected "Barge-in interrupt triggers playback cutoff when user speaks over audio")
    true)

fn testMutantRefutations -> Bool
  (let [(m1Intent (oi/classifyOmniIntent "refactor file engine/runtime.asl"))
        (m2Cfg (ws/SupervisorLimitsConfig :slidingIdleMs 10000 :maxWallClockMs 900000 :maxMemMb 1024))
        (m2Pool (ws/workerPoolCreate m2Cfg))
        (m2Spawn (ws/workerSpawn m2Pool (ws/sandboxWorkspaceWrite) (list "src/") 9999 1000))
        (m2P1 (pairFirst m2Spawn))
        (m2Check (ws/workerCheckLimits m2P1 25000))
        (m2Stalled (pairSecond m2Check))
        (m4Code (oi/classifyOmniIntent "refactor compiler pipeline"))]
    (do
      (assert (oi/isCodeTask? m1Intent) "Mutant 1 killed: Mutating code is strictly routed to worker-jail")
      (refute (oi/isResearch? m1Intent) "Mutant 1 killed: In-process fiber must NEVER execute mutating code")
      (assert (= (listLength m2Stalled) 1) "Mutant 2 killed: 24s idle worker is flagged as stalled by the 10s idle limit")
      (refute (uc/refutePersonaPreamble "As an AI language model, I am pleased to assist you.") "Mutant 3 killed: Persona fluff strictly refuted")
      (assert (oi/isCodeTask? m4Code) "Mutant 4 killed: Refactor directive is classified as :codeTask")
      (refute (oi/isResearch? m4Code) "Mutant 4 killed: Refactor directive is NOT misclassified as :research")
      true))

fn runTests -> Bool
  (do
    (assert (testFastKnowledgeCacheAndFibers) "Fast knowledge cache and fiber pool must pass")
    (assert (testWorkerSupervisorAndLimits) "Worker supervisor and limits must pass")
    (assert (testOmniDaemonSupervisionLoop) "Omni-daemon supervision loop must pass")
    (assert (testOmniIntentAndFrontAgentRouting) "Omni-intent and front agent routing must pass")
    (assert (testUnbiasedContextSanitization) "Unbiased context sanitization must pass")
    (assert (testVoiceBufferAndBargeIn) "Voice buffer and barge-in must pass")
    (assert (testMutantRefutations) "Four mutant refutations must pass")
    true)
