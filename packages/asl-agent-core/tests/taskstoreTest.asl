(module asl/packages/asl-agent-core/tests/taskstoreTest :x [testStateMachine testTaskstorePersistenceAndClaims testSchedulerMutualExclusionAndFairness testStaleClaimReaper testTaskKindsAndOutcomes testTaskstoreInFlightTrackingAndSpawning! runTests] :i [(tasktypes :a tt) (statemachine :a sm) (taskstore :a ts) (scheduler :a sc)])

fn testStateMachine -> Bool
  (do (assert (sm/validTransition? (tt/stateQueued) (tt/stateRouting)) "state-queued -> state-routing must be valid") (assert (sm/validTransition? (tt/stateRouting) (tt/stateReady)) "state-routing -> state-ready must be valid") (assert (sm/validTransition? (tt/stateReady) (tt/stateExecuting)) "state-ready -> state-executing must be valid") (assert (sm/validTransition? (tt/stateExecuting) (tt/stateVerifying)) "state-executing -> state-verifying must be valid") (assert (sm/validTransition? (tt/stateVerifying) (tt/stateDone)) "state-verifying -> state-done must be valid") (assert (not (sm/validTransition? (tt/stateDone) (tt/stateRouting))) "Terminal state-done must not allow transition to state-routing") (assert (not (sm/validTransition? (tt/stateQueued) (tt/stateDone))) "Skipping execution stages from state-queued to state-done must be invalid") (assert (sm/isTerminalState? (tt/stateDone)) "state-done must be classified as terminal state") (assert (sm/isTerminalState? (tt/stateFailed)) "state-failed must be classified as terminal state") (assert (sm/isTerminalState? (tt/stateCancelled)) "state-cancelled must be classified as terminal state") (assert (not (sm/isTerminalState? (tt/stateExecuting))) "state-executing must not be classified as terminal state") true)

fn ! testTaskstorePersistenceAndClaims -> Bool
  (let [(t1 (tt/taskRecordCreate "task-1" "lane-1" "/ws/proj-1" (tt/priorityNormal) 200 "payload-1")) (store0 (ts/taskstoreCreate "/ws/.asl/mem/tasks"))] (assert (= t1.id "task-1") "Task record id must match constructor argument") (assert (= t1.createdAt 200) "Task record created-at must match constructor argument") (let [(putRes1 (ts/taskstorePut! store0 t1))] (assert (ok? putRes1) "taskstore-put must succeed with ok") (let [(store1 (resultOr putRes1 store0)) (gotOpt (ts/taskstoreGet store1 "task-1"))] (assert (some? gotOpt) "taskstore-get must find persisted task-1") (let [(gotT1 (optionOr gotOpt t1))] (assert (= gotT1.lane "lane-1") "Retrieved task lane must match") (assert (= gotT1.state (tt/stateQueued)) "Initial task state must be state-queued") (let [(t2 (tt/taskRecordCreate "task-2" "lane-1" "/ws/proj-1" (tt/priorityHigh) 100 "payload-2")) (t3 (tt/taskRecordCreate "task-3" "lane-1" "/ws/proj-1" (tt/priorityLow) 300 "payload-3")) (store2 (resultOr (ts/taskstorePut! store1 t2) store1)) (store3 (resultOr (ts/taskstorePut! store2 t3) store2)) (queuedList (ts/taskstoreListQueued store3))] (assert (= (listLength queuedList) 3) "taskstore-list-queued must return all 3 queued tasks") (let [(firstQ (optionOr (listHead queuedList) t1)) (restQ1 (optionOr (listTail queuedList) (list))) (secondQ (optionOr (listHead restQ1) t1)) (restQ2 (optionOr (listTail restQ1) (list))) (thirdQ (optionOr (listHead restQ2) t1))] (assert (= firstQ.id "task-2") "First queued task must be task-2 with earliest created-at 100") (assert (= secondQ.id "task-1") "Second queued task must be task-1 with created-at 200") (assert (= thirdQ.id "task-3") "Third queued task must be task-3 with created-at 300") (let [(claim1Res (ts/taskstoreClaim! store3 "task-2"))] (assert (ok? claim1Res) "Atomic claim on task-2 must succeed with ok") (let [(storeClaimed (resultOr claim1Res store3)) (claimedTask (optionOr (ts/taskstoreGet storeClaimed "task-2") t2))] (assert (= claimedTask.state (tt/stateRouting)) "Claimed task state must transition to state-routing") (let [(doubleClaimRes (ts/taskstoreClaim! storeClaimed "task-2"))] (assert (err? doubleClaimRes) "Double claiming already claimed task-2 must return err") (let [(transRes (ts/taskstoreTransition! storeClaimed "task-2" (tt/stateReady) 500))] (assert (ok? transRes) "Valid transition from state-routing to state-ready must succeed") true))))))))))

fn ! testSchedulerMutualExclusionAndFairness -> Bool
  (let [(tA1 (tt/taskRecordCreate "task-a1" "lane-a" "/ws/proj-1" (tt/priorityNormal) 100 "cmd-1")) (tA2 (tt/taskRecordCreate "task-a2" "lane-a" "/ws/proj-1" (tt/priorityNormal) 200 "cmd-2")) (storeM0 (ts/taskstoreCreate "/ws/.asl/mem/tasks")) (storeM1 (resultOr (ts/taskstorePut! storeM0 tA1) storeM0)) (storeM2 (resultOr (ts/taskstorePut! storeM1 tA2) storeM1)) (cfgM (sc/SchedulerConfig :maxConcurrent 5 :staleTimeoutMs 5000)) (schedM (sc/schedulerCreate cfgM)) (drainResM (resultOr (sc/schedulerDrain! schedM storeM2) (sc/DrainResult :scheduler schedM :store storeM2 :claimedTasks (list)))) (claimedM drainResM.claimedTasks)] (assert (= (listLength claimedM) 1) "Scheduler drain must claim at most 1 task per project path") (let [(firstClaimed (optionOr (listHead claimedM) tA1))] (assert (= firstClaimed.id "task-a1") "First task on proj-1 must be claimed") (let [(a2InStore (optionOr (ts/taskstoreGet drainResM.store "task-a2") tA1))] (assert (= a2InStore.state (tt/stateQueued)) "Conflicting task-a2 on same project must remain in state-queued") (let [(cfgC (sc/SchedulerConfig :maxConcurrent 2 :staleTimeoutMs 5000)) (schedC (sc/schedulerCreate cfgC)) (tP1 (tt/taskRecordCreate "task-p1" "lane-1" "/ws/proj-p1" (tt/priorityNormal) 100 "p1")) (tP2 (tt/taskRecordCreate "task-p2" "lane-2" "/ws/proj-p2" (tt/priorityNormal) 200 "p2")) (tP3 (tt/taskRecordCreate "task-p3" "lane-3" "/ws/proj-p3" (tt/priorityNormal) 300 "p3")) (storeC0 (ts/taskstoreCreate "/ws/.asl/mem/tasks")) (storeC1 (resultOr (ts/taskstorePut! storeC0 tP1) storeC0)) (storeC2 (resultOr (ts/taskstorePut! storeC1 tP2) storeC1)) (storeC3 (resultOr (ts/taskstorePut! storeC2 tP3) storeC2)) (drainResC (resultOr (sc/schedulerDrain! schedC storeC3) (sc/DrainResult :scheduler schedC :store storeC3 :claimedTasks (list)))) (claimedC drainResC.claimedTasks)] (assert (= (listLength claimedC) 2) "Scheduler drain must respect global max-concurrent ceiling of 2") (let [(tL11 (tt/taskRecordCreate "task-l1-1" "lane-a" "/ws/proj-a1" (tt/priorityNormal) 100 "l1-1")) (tL12 (tt/taskRecordCreate "task-l1-2" "lane-a" "/ws/proj-a2" (tt/priorityNormal) 200 "l1-2")) (tL21 (tt/taskRecordCreate "task-l2-1" "lane-b" "/ws/proj-b1" (tt/priorityNormal) 300 "l2-1")) (storeF0 (ts/taskstoreCreate "/ws/.asl/mem/tasks")) (storeF1 (resultOr (ts/taskstorePut! storeF0 tL11) storeF0)) (storeF2 (resultOr (ts/taskstorePut! storeF1 tL12) storeF1)) (storeF3 (resultOr (ts/taskstorePut! storeF2 tL21) storeF2)) (cfgF (sc/SchedulerConfig :maxConcurrent 2 :staleTimeoutMs 5000)) (schedF (sc/schedulerCreate cfgF)) (drainResF (resultOr (sc/schedulerDrain! schedF storeF3) (sc/DrainResult :scheduler schedF :store storeF3 :claimedTasks (list)))) (claimedF drainResF.claimedTasks)] (assert (= (listLength claimedF) 2) "Lane fairness drain must claim 2 tasks across lanes") (let [(fTask1 (optionOr (listHead claimedF) tL11)) (fRest (optionOr (listTail claimedF) (list))) (fTask2 (optionOr (listHead fRest) tL11))] (assert (= fTask1.id "task-l1-1") "First claimed task must be task-l1-1 from lane-a") (assert (= fTask2.id "task-l2-1") "Second claimed task must be task-l2-1 from idle lane-b") (let [(l12InStore (optionOr (ts/taskstoreGet drainResF.store "task-l1-2") tL11))] (assert (= l12InStore.state (tt/stateQueued)) "Secondary task task-l1-2 in busy lane-a must remain state-queued") (let [(schedRel (sc/schedulerReleaseProject drainResM.scheduler "/ws/proj-1"))] (assert (= (listLength schedRel.activeProjects) 0) "Releasing project lock must evict project from active-projects") true))))))))

fn ! testStaleClaimReaper -> Bool
  (let [(tSr (tt/taskRecordCreate "task-sr" "lane-sr" "/ws/proj-sr" (tt/priorityNormal) 1000 "sr")) (storeR0 (ts/taskstoreCreate "/ws/.asl/mem/tasks")) (storeR1 (resultOr (ts/taskstorePut! storeR0 tSr) storeR0)) (storeClaimed (resultOr (ts/taskstoreClaim! storeR1 "task-sr") storeR1)) (cfgR (sc/SchedulerConfig :maxConcurrent 5 :staleTimeoutMs 5000)) (schedR0 (sc/schedulerCreate cfgR)) (schedR1 (sc/SchedulerState :config cfgR :activeProjects (list "/ws/proj-sr") :activeLanes (mapSet (mapEmpty) "lane-sr" 1))) (reapResR (resultOr (sc/schedulerReapStale! schedR1 storeClaimed 7000) (sc/ReapResult :scheduler schedR1 :store storeClaimed :reapedCount 0)))] (assert (= reapResR.reapedCount 1) "Abandoned routing task exceeding heartbeat threshold must be reaped") (let [(srReaped (optionOr (ts/taskstoreGet reapResR.store "task-sr") tSr))] (assert (= srReaped.state (tt/stateQueued)) "Reaped routing task must be reset to state-queued") (assert (not (listContains? reapResR.scheduler.activeProjects "/ws/proj-sr")) "Reaping routing task must release its project lock") (let [(tSe (tt/taskRecordCreate "task-se" "lane-se" "/ws/proj-se" (tt/priorityNormal) 1000 "se")) (storeE0 (resultOr (ts/taskstorePut! reapResR.store tSe) reapResR.store)) (storeE1 (resultOr (ts/taskstoreClaim! storeE0 "task-se") storeE0)) (storeE2 (resultOr (ts/taskstoreTransition! storeE1 "task-se" (tt/stateReady) 1100) storeE1)) (storeE3 (resultOr (ts/taskstoreTransition! storeE2 "task-se" (tt/stateExecuting) 1200) storeE2)) (schedE (sc/SchedulerState :config cfgR :activeProjects (list "/ws/proj-se") :activeLanes (mapSet (mapEmpty) "lane-se" 1))) (reapResE (resultOr (sc/schedulerReapStale! schedE storeE3 7000) (sc/ReapResult :scheduler schedE :store storeE3 :reapedCount 0)))] (assert (= reapResE.reapedCount 1) "Abandoned executing task exceeding heartbeat threshold must be reaped") (let [(seReaped (optionOr (ts/taskstoreGet reapResE.store "task-se") tSe))] (assert (= seReaped.state (tt/stateQueued)) "Reaped executing task must be reset to state-queued") (let [(tAct (tt/taskRecordCreate "task-act" "lane-act" "/ws/proj-act" (tt/priorityNormal) 6000 "act")) (storeA0 (resultOr (ts/taskstorePut! reapResE.store tAct) reapResE.store)) (storeA1 (resultOr (ts/taskstoreClaim! storeA0 "task-act") storeA0)) (schedA (sc/SchedulerState :config cfgR :activeProjects (list "/ws/proj-act") :activeLanes (mapSet (mapEmpty) "lane-act" 1))) (reapResA (resultOr (sc/schedulerReapStale! schedA storeA1 7000) (sc/ReapResult :scheduler schedA :store storeA1 :reapedCount 0)))] (assert (= reapResA.reapedCount 0) "Active unexpired task within heartbeat threshold must not be reaped") (let [(actTask (optionOr (ts/taskstoreGet reapResA.store "task-act") tAct))] (assert (= actTask.state (tt/stateRouting)) "Active unexpired task must remain in state-routing") (let [(tSc (tt/taskRecordCreate "task-sc" "lane-sc" "/ws/proj-sc" (tt/priorityNormal) 1000 "sc")) (storeC0 (resultOr (ts/taskstorePut! reapResA.store tSc) reapResA.store)) (storeC1 (resultOr (ts/taskstoreClaim! storeC0 "task-sc") storeC0)) (storeC2 (resultOr (ts/taskstoreTransition! storeC1 "task-sc" (tt/stateClarification) 1050) storeC1)) (schedC (sc/SchedulerState :config cfgR :activeProjects (list "/ws/proj-sc") :activeLanes (mapSet (mapEmpty) "lane-sc" 1))) (reapResC (resultOr (sc/schedulerReapStale! schedC storeC2 7000) (sc/ReapResult :scheduler schedC :store storeC2 :reapedCount 0)))] (assert (= reapResC.reapedCount 1) "Abandoned clarification task exceeding heartbeat threshold must be reaped") (let [(scReaped (optionOr (ts/taskstoreGet reapResC.store "task-sc") tSc))] (assert (= scReaped.state (tt/stateQueued)) "Reaped clarification task must be reset to state-queued") (assert (not (listContains? reapResC.scheduler.activeProjects "/ws/proj-sc")) "Reaping clarification task must release project lock") (let [(tSy (tt/taskRecordCreate "task-sy" "lane-sy" "/ws/proj-sy" (tt/priorityNormal) 1000 "sy")) (storeY0 (resultOr (ts/taskstorePut! reapResC.store tSy) reapResC.store)) (storeY1 (resultOr (ts/taskstoreClaim! storeY0 "task-sy") storeY0)) (storeY2 (resultOr (ts/taskstoreTransition! storeY1 "task-sy" (tt/stateReady) 1100) storeY1)) (storeY3 (resultOr (ts/taskstoreTransition! storeY2 "task-sy" (tt/stateExecuting) 1200) storeY2)) (storeY4 (resultOr (ts/taskstoreTransition! storeY3 "task-sy" (tt/stateVerifying) 1250) storeY3)) (schedY (sc/SchedulerState :config cfgR :activeProjects (list "/ws/proj-sy") :activeLanes (mapSet (mapEmpty) "lane-sy" 1))) (reapResY (resultOr (sc/schedulerReapStale! schedY storeY4 7000) (sc/ReapResult :scheduler schedY :store storeY4 :reapedCount 0)))] (assert (= reapResY.reapedCount 1) "Abandoned verifying task exceeding heartbeat threshold must be reaped") (let [(syReaped (optionOr (ts/taskstoreGet reapResY.store "task-sy") tSy))] (assert (= syReaped.state (tt/stateQueued)) "Reaped verifying task must be reset to state-queued") (assert (not (listContains? reapResY.scheduler.activeProjects "/ws/proj-sy")) "Reaping verifying task must release project lock") true))))))))))

fn testTaskKindsAndOutcomes -> Bool
  (let [(kMut (tt/kindCodeMutation)) (kSpw (tt/kindTaskSpawn)) (kAud (tt/kindAuditVerdict)) (outcome (tt/makeTaskOutcome kMut (list "src/a.asl") (list "C1") "doc.md" "exit 0"))] (assert (= (listLength outcome.mutatedPaths) 1) "Outcome must have 1 mutated path") (assert (= (listLength outcome.spawnedTaskIds) 1) "Outcome must have 1 spawned task id") (assert (= outcome.artifactPath "doc.md") "Outcome artifact path must match") (assert (= outcome.receipt "exit 0") "Outcome receipt must match") (assert (tt/taskStateInFlight? (tt/stateRouting)) "state-routing must be in-flight") (assert (tt/taskStateInFlight? (tt/stateReady)) "state-ready must be in-flight") (assert (tt/taskStateInFlight? (tt/stateExecuting)) "state-executing must be in-flight") (assert (tt/taskStateInFlight? (tt/stateVerifying)) "state-verifying must be in-flight") (assert (not (tt/taskStateInFlight? (tt/stateQueued))) "state-queued must not be in-flight") (assert (not (tt/taskStateInFlight? (tt/stateDone))) "state-done must not be in-flight") true)

fn testTaskstoreInFlightTrackingAndSpawning! -> Bool
  (let [(store0 (ts/taskstoreCreate "/ws/.asl/mem/tasks")) (t1 (tt/taskRecordCreate "task-m1" "lane-1" "/ws" (tt/priorityNormal) 100 "cmd-1")) (t2 (tt/taskRecordCreate "task-m2" "lane-1" "/ws" (tt/priorityNormal) 200 "cmd-2")) (store1 (resultOr (ts/taskstorePut! store0 t1) store0)) (store2 (resultOr (ts/taskstorePut! store1 t2) store1)) (storeClaimed (resultOr (ts/taskstoreClaim! store2 "task-m1") store2))] (assert (= (ts/taskstoreCountByState storeClaimed (tt/stateQueued)) 1) "Queued count must be 1") (assert (= (ts/taskstoreCountByState storeClaimed (tt/stateRouting)) 1) "Routing count must be 1") (let [(inFlight (ts/taskstoreListInFlight storeClaimed))] (assert (= (listLength inFlight) 1) "In-flight task list count must be 1") (assert (= (optionOr (listHead inFlight) t1).id "task-m1") "In-flight task must be task-m1") (let [(parent t2) (childrenPayloads (list "child payload 1" "child payload 2")) (storeSpawned (ts/taskstoreSpawnChildren! storeClaimed parent childrenPayloads 300))] (assert (= (ts/taskstoreCountByState storeSpawned (tt/stateQueued)) 3) "Queued count must be 3 after spawning 2 children") (let [(c1Opt (ts/taskstoreGet storeSpawned "task-m2-child-1")) (c2Opt (ts/taskstoreGet storeSpawned "task-m2-child-2"))] (assert (some? c1Opt) "Child 1 must be present in store") (assert (some? c2Opt) "Child 2 must be present in store") (let [(c1 (optionOr c1Opt t1))] (assert (= c1.payload "child payload 1") "Child 1 payload must match") (assert (= c1.state (tt/stateQueued)) "Child 1 state must be state-queued") true)))))

fn ! runTests -> Bool
  (do (assert (testStateMachine) "test-state-machine suite must pass") (assert (testTaskstorePersistenceAndClaims) "test-taskstore-persistence-and-claims suite must pass") (assert (testSchedulerMutualExclusionAndFairness) "test-scheduler-mutual-exclusion-and-fairness suite must pass") (assert (testStaleClaimReaper) "test-stale-claim-reaper suite must pass") (assert (testTaskKindsAndOutcomes) "test-task-kinds-and-outcomes suite must pass") (assert (testTaskstoreInFlightTrackingAndSpawning!) "test-taskstore-in-flight-tracking-and-spawning suite must pass") true)
