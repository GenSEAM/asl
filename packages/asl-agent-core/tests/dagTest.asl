(module aslCore/dagTest :x [runTests testDagCreate testDagAddNode testDagCanActivate testDagFalsifyCascadingInvalidation testDagCasOcc] :i [(premise :a p) (dag :a d)])

fn testDagCreate -> Bool
  (let [(dag (d/dagCreate))] (assert (= (listLength dag.nodes) 0) "Nodes list must be empty") (assert (= dag.version 0) "Initial version must be 0") (assert (= (listLength dag.falsifiedPremises) 0) "Falsified premises list must be empty") true)

fn testDagAddNode -> Bool
  (let [(dag0 (d/dagCreate)) (node1 (d/TaskNode :id "task-1" :title "Initialize schema" :state (d/taskPending) :dependencies (list) :premises (list "prem-1"))) (dag1 (d/dagAddNode dag0 node1)) (found (d/dagFindNode dag1 "task-1")) (missing (d/dagFindNode dag1 "task-missing"))] (assert (= (listLength dag1.nodes) 1) "DAG must have 1 node after addition") (assert (mt found ((some n) (and (= n.id "task-1") (= n.title "Initialize schema"))) ((none) false)) "Found node must match inserted task-1") (assert (mt missing ((some _) false) ((none) true)) "Missing node lookup must return none") true)

fn testDagCanActivate -> Bool
  (let [(dag0 (d/dagCreate)) (node1 (d/TaskNode :id "t1" :title "Task 1" :state (d/taskPending) :dependencies (list) :premises (list "prem-ok"))) (node2 (d/TaskNode :id "t2" :title "Task 2" :state (d/taskPending) :dependencies (list "t1") :premises (list))) (node3 (d/TaskNode :id "t3" :title "Task 3" :state (d/taskCompleted) :dependencies (list) :premises (list))) (node4 (d/TaskNode :id "t4" :title "Task 4" :state (d/taskPending) :dependencies (list "t3") :premises (list))) (dag1 (d/dagAddNode (d/dagAddNode (d/dagAddNode (d/dagAddNode dag0 node1) node2) node3) node4))] (assert (d/dagCanActivate? dag1 "t1") "t1 with no dependencies should activate") (assert (not (d/dagCanActivate? dag1 "t2")) "t2 with pending dependency t1 must not activate") (assert (d/dagCanActivate? dag1 "t4") "t4 with completed dependency t3 should activate") (assert (not (d/dagCanActivate? dag1 "t3")) "t3 already completed must not activate") (assert (not (d/dagCanActivate? dag1 "t-nonexistent")) "nonexistent task must not activate") true)

fn testDagFalsifyCascadingInvalidation -> Bool
  (let [(premRec (p/makePremise "p-vector" "Vector indexing is sub-millisecond")) (falsifiedRec (p/falsifyPremise premRec)) (dag0 (d/dagCreate)) (nodeDep (d/TaskNode :id "t-search" :title "Vector Search" :state (d/taskPending) :dependencies (list) :premises (list "p-vector"))) (nodeOther (d/TaskNode :id "t-keyword" :title "Keyword Search" :state (d/taskPending) :dependencies (list) :premises (list "p-text"))) (dag1 (d/dagAddNode (d/dagAddNode dag0 nodeDep) nodeOther))] (let [(canActBefore (d/dagCanActivate? dag1 "t-search")) (dag2 (d/dagFalsifyPremise dag1 "p-vector")) (foundDep (d/dagFindNode dag2 "t-search")) (foundOther (d/dagFindNode dag2 "t-keyword"))] (assert (stringContains? (p/formatPremise falsifiedRec) "falsified true") "Falsified premise formatting must reflect falsified true") (assert canActBefore "t-search must be activatable before premise falsification") (assert (= dag2.version 1) "Falsifying premise must bump DAG version to 1") (assert (d/dagIsFalsified? dag2 "p-vector") "p-vector must be recorded as falsified") (assert (not (d/dagIsFalsified? dag2 "p-text")) "p-text must not be recorded as falsified") (assert (mt foundDep ((some n) (mt n.state ((taskInvalidated) true) (_ false))) ((none) false)) "t-search dependent on falsified premise must transition to task-invalidated") (assert (mt foundOther ((some n) (mt n.state ((taskPending) true) (_ false))) ((none) false)) "t-keyword without falsified premise must remain pending") (assert (not (d/dagCanActivate? dag2 "t-search")) "t-search must not be activatable after invalidation") true))

fn testDagCasOcc -> Bool
  (let [(dag0 (d/dagCreate)) (node (d/TaskNode :id "t1" :title "Task 1" :state (d/taskPending) :dependencies (list) :premises (list))) (dag1 (d/dagAddNode dag0 node))] (let [(casOk (d/dagCasVersion dag0 0 dag1)) (casConflict (d/dagCasVersion dag0 99 dag1)) (dagBumped (d/dagFalsifyPremise dag1 "prem-x"))] (assert (mt casOk ((some updated) (= (listLength updated.nodes) 1)) ((none) false)) "CAS must succeed with matching version 0") (assert (mt casConflict ((some _) false) ((none) true)) "CAS must fail with conflicting version 99") (assert (mt (d/dagCasVersion dagBumped 1 dag0) ((some _) true) ((none) false)) "CAS must succeed on version 1 for bumped DAG") (assert (mt (d/dagCasVersion dagBumped 0 dag0) ((some _) false) ((none) true)) "CAS must fail on stale version 0 for bumped DAG") true))

fn runTests -> Bool
  (and (testDagCreate) (testDagAddNode) (testDagCanActivate) (testDagFalsifyCascadingInvalidation) (testDagCasOcc))
