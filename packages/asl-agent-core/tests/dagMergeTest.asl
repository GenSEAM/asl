(module aslAgentCore/tests/dagMergeTest :x [runTests TestStateLatticeOrdering TestDisjointSubtaskSplice TestReconciledTaskStateAndDependencyUnion TestCycleDetectionRejection] :i [(dagMerge :a dm)])

fn TestStateLatticeOrdering -> Bool
  (do (assert (= (dm/resolveStateLattice "pending" "active") "active") "Active must dominate pending") (assert (= (dm/resolveStateLattice "active" "completed") "completed") "Completed must dominate active") (assert (= (dm/resolveStateLattice "completed" "pending") "completed") "Completed must dominate pending") (assert (= (dm/resolveStateLattice "completed" "failed") "failed") "Failed must dominate completed") true)

fn TestDisjointSubtaskSplice -> Bool
  (let [(root (dm/MergedTaskNode :id "T1" :title "Root Task" :stateStr "active" :dependencies (list) :premises (list))) (sub1 (dm/MergedTaskNode :id "T1.1" :title "Subtask 1" :stateStr "pending" :dependencies (list "T1") :premises (list))) (sub2 (dm/MergedTaskNode :id "T1.2" :title "Subtask 2" :stateStr "pending" :dependencies (list "T1") :premises (list))) (base (list root)) (branchA (list root sub1)) (branchB (list root sub2)) (res (dm/dagMergeBranches base branchA branchB))] (assert res.validDag "Spliced DAG must be valid and acyclic") (assert (= (listLength res.mergedNodes) 3) "Merged DAG must contain 3 nodes") (assert (listContains? res.addedByA "T1.1") "Must record T1.1 from branch A") (assert (listContains? res.addedByB "T1.2") "Must record T1.2 from branch B") (assert (= (listLength res.reconciledNodes) 1) "Root node T1 must be reconciled") true)

fn TestReconciledTaskStateAndDependencyUnion -> Bool
  (let [(t0 (dm/MergedTaskNode :id "T2" :title "Build Task" :stateStr "active" :dependencies (list "dep1") :premises (list "premise-a"))) (tBranchA (dm/MergedTaskNode :id "T2" :title "Build Task" :stateStr "completed" :dependencies (list "dep1" "dep2") :premises (list "premise-a"))) (tBranchB (dm/MergedTaskNode :id "T2" :title "Build Task" :stateStr "active" :dependencies (list "dep1" "dep3") :premises (list "premise-a" "premise-b"))) (base (list t0)) (branchA (list tBranchA)) (branchB (list tBranchB)) (res (dm/dagMergeBranches base branchA branchB))] (assert res.validDag "Merged DAG must be valid") (assert (= (listLength res.mergedNodes) 1) "Must contain exactly 1 merged node") (let [(mergedNode (optionOr (listGet res.mergedNodes 0) (dm/MergedTaskNode :id "" :title "" :stateStr "" :dependencies (list) :premises (list))))] (assert (= mergedNode.stateStr "completed") "State must resolve monotonically to completed") (assert (= (listLength mergedNode.dependencies) 3) "Dependencies must union to 3 items") (assert (listContains? mergedNode.dependencies "dep1") "Must include dep1") (assert (listContains? mergedNode.dependencies "dep2") "Must include dep2") (assert (listContains? mergedNode.dependencies "dep3") "Must include dep3") (assert (= (listLength mergedNode.premises) 2) "Premises must union to 2 items") (assert (listContains? mergedNode.premises "premise-b") "Must include premise-b")) true)

fn TestCycleDetectionRejection -> Bool
  (let [(t1A (dm/MergedTaskNode :id "TA" :title "A" :stateStr "pending" :dependencies (list "TB") :premises (list))) (t2B (dm/MergedTaskNode :id "TB" :title "B" :stateStr "pending" :dependencies (list "TA") :premises (list))) (base (list)) (branchA (list t1A)) (branchB (list t2B)) (res (dm/dagMergeBranches base branchA branchB))] (assert (not res.validDag) "Direct mutual cycle must be flagged invalid") (mt res.errorMessage ((none) (assert false "Cycle error message must be set")) ((some msg) (assert (stringContains? msg "cycle") "Error message must mention cycle"))) true)

fn runTests -> Bool
  (and (TestStateLatticeOrdering) (and (TestDisjointSubtaskSplice) (and (TestReconciledTaskStateAndDependencyUnion) (TestCycleDetectionRejection))))
