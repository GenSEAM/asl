@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --ground: 248 247 252;
    --sunken: 238 235 245;
    --surface: 255 255 255;
    --inset: 244 242 248;
    --line: 225 219 236;
    --line-strong: 146 128 176;
    --ink: 24 18 36;
    --ink-2: 76 64 96;
    --ink-3: 112 98 134;
    --signal: 126 34 206;
    --signal-soft: 147 51 234;
    --shadow-hue: 270 25% 10%;
    --shadow-strength: 0.08;
  }

  .dark {
    --ground: 12 9 20;
    --sunken: 4 2 7;
    --surface: 24 19 39;
    --inset: 17 13 29;
    --line: 48 38 72;
    --line-strong: 136 102 198;
    --ink: 246 244 255;
    --ink-2: 198 183 253;
    --ink-3: 152 140 175;
    --signal: 176 96 255;
    --signal-soft: 198 142 255;
    --shadow-hue: 270 50% 5%;
    --shadow-strength: 0.65;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 6rem;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
  }

  body {
    margin: 0;
    width: 100%;
    max-width: 100vw;
    background-color: rgb(var(--ground));
    color: rgb(var(--ink));
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  code, pre, .font-mono {
    font-family: 'Fira Code', 'SFMono-Regular', Menlo, Monaco, Consolas, monospace;
    font-variant-ligatures: none;
  }

  :focus-visible {
    outline: 2px solid rgb(var(--signal));
    outline-offset: 3px;
    border-radius: 4px;
  }

  ::selection {
    background: rgb(var(--signal) / 0.18);
    color: rgb(var(--ink));
  }

  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: rgb(var(--ground));
  }

  ::-webkit-scrollbar-thumb {
    background: rgb(var(--line-strong) / 0.35);
    border-radius: 999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: rgb(var(--signal));
  }

}

@layer components {
  .rule-hairline {
    height: 1px;
    background-color: rgb(var(--line));
  }
  .shell {
    max-width: 72rem;
    margin-left: auto;
    margin-right: auto;
  }
  .canvas-wide {
    max-width: 80rem;
    margin-left: auto;
    margin-right: auto;
  }

  /* Cyberpunk Neon Bloom, Glassmorphism & Ambient Light Utilities */
  .neon-glow-pill {
    background: rgba(24, 19, 39, 0.92);
    border: 1px solid rgba(176, 96, 255, 0.65);
    box-shadow: 0 0 12px rgba(176, 96, 255, 0.5), 0 0 35px rgba(176, 96, 255, 0.35), inset 0 0 15px rgba(176, 96, 255, 0.12);
  }

  .neon-card {
    background: rgba(24, 19, 39, 0.72);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(176, 96, 255, 0.22);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 4px 24px rgba(12, 9, 20, 0.6);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .neon-card:hover {
    border-color: rgba(192, 132, 252, 0.55);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 0 28px rgba(176, 96, 255, 0.35);
    transform: translateY(-2px);
  }

  .neon-title-gradient {
    background: linear-gradient(180deg, #FFFFFF 0%, #E9D5FF 50%, #C084FC 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 18px rgba(192, 132, 252, 0.35));
  }

  .neon-text-glow {
    text-shadow: 0 0 12px rgba(192, 132, 252, 0.55), 0 0 28px rgba(176, 96, 255, 0.35);
  }

  .neon-svg-glow {
    filter: drop-shadow(0 0 10px rgba(176, 96, 255, 0.45)) drop-shadow(0 0 25px rgba(192, 132, 252, 0.25));
  }

  .ambient-top-light {
    background: radial-gradient(ellipse 75% 45% at 50% -10%, rgba(176, 96, 255, 0.25), transparent 70%);
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
