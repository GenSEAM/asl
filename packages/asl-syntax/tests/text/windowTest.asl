(module asl-syntax/tests/text/windowTest
  :x [runTests]
  :i [(asl-syntax/core/source :a src)
      (asl-syntax/text :a txt)
      (asl-syntax/textWindow :a win)
      (asl-syntax/core/bytesText :a btxt)])

fn testWindowedRangeParity! -> Bool
  (let [(manifestPath "asl/packages/asl-syntax/manifest.asn")
        (win1 (resultOr (win/readWindowedRangeFileReceipt! manifestPath 1 3 200 12000) ""))
        (txt1 (resultOr (txt/readRangeFileReceipt! manifestPath 1 3 200 12000) ""))
        (_ (assert (= win1 txt1) "windowed range 1..3 equals whole-file path"))
        (win2 (resultOr (win/readWindowedRangeFileReceipt! manifestPath 1 6 2 12000) ""))
        (txt2 (resultOr (txt/readRangeFileReceipt! manifestPath 1 6 2 12000) ""))
        (_ (assert (= win2 txt2) "windowed truncated range limit 2 equals whole-file path"))
        (win3 (resultOr (win/readWindowedRangeFileReceipt! manifestPath 100 110 200 12000) ""))
        (txt3 (resultOr (txt/readRangeFileReceipt! manifestPath 100 110 200 12000) ""))
        (_ (assert (= win3 txt3) "windowed out-of-bounds range equals whole-file path"))]
    true)

fn testWindowedRangeFixtures! -> Bool
  (let [(crlfPath "asl/packages/asl-forms/tests/fixtures/ws/crlf.txt")
        (winCrlf (resultOr (win/readWindowedRangeFileReceipt! crlfPath 1 2 200 12000) ""))
        (txtCrlf (resultOr (txt/readRangeFileReceipt! crlfPath 1 2 200 12000) ""))
        (_ (assert (= winCrlf txtCrlf) "windowed crlf range equals whole-file path"))
        (invPath "tests/acceptance/r1Host/fixtures/zstd/neg/truncated-3.zst")
        (winInv (resultOr (win/readWindowedRangeFileReceipt! invPath 1 1 200 12000) ""))
        (txtInv (resultOr (txt/readRangeFileReceipt! invPath 1 1 200 12000) ""))
        (_ (assert (= winInv txtInv) "windowed invalid bytes range equals whole-file path"))
        (binPath "asl/packages/asl-forms/tests/fixtures/ws/image.png")
        (winBin (resultOr (win/readWindowedRangeFileReceipt! binPath 1 2 200 12000) ""))
        (txtBin (resultOr (txt/readRangeFileReceipt! binPath 1 2 200 12000) ""))
        (_ (assert (= winBin txtBin) "windowed binary rejection equals whole-file path"))]
    true)

fn testWindowedAnchorParity! -> Bool
  (let [(manifestPath "asl/packages/asl-syntax/manifest.asn")
        (win1 (resultOr (win/readWindowedAnchorFileReceipt! manifestPath "version" 1 20) ""))
        (txt1 (resultOr (txt/readAnchorFileReceipt! manifestPath "version" 1 20) ""))
        (_ (assert (= win1 txt1) "windowed anchor version limit 20 equals whole-file path"))
        (win2 (resultOr (win/readWindowedAnchorFileReceipt! manifestPath "version" 1 0) ""))
        (txt2 (resultOr (txt/readAnchorFileReceipt! manifestPath "version" 1 0) ""))
        (_ (assert (= win2 txt2) "windowed anchor version default limit equals whole-file path"))
        (win3 (resultOr (win/readWindowedAnchorFileReceipt! manifestPath "nonexistent" 1 0) ""))
        (txt3 (resultOr (txt/readAnchorFileReceipt! manifestPath "nonexistent" 1 0) ""))
        (_ (assert (= win3 txt3) "windowed anchor nonexistent equals whole-file path"))
        (crlfPath "asl/packages/asl-forms/tests/fixtures/ws/crlf.txt")
        (winCrlf (resultOr (win/readWindowedAnchorFileReceipt! crlfPath "two" 1 10) ""))
        (txtCrlf (resultOr (txt/readAnchorFileReceipt! crlfPath "two" 1 10) ""))
        (_ (assert (= winCrlf txtCrlf) "windowed crlf anchor equals whole-file path"))
        (invPath "tests/acceptance/r1Host/fixtures/zstd/neg/truncated-3.zst")
        (winInv (resultOr (win/readWindowedAnchorFileReceipt! invPath "(" 1 10) ""))
        (txtInv (resultOr (txt/readAnchorFileReceipt! invPath "(" 1 10) ""))
        (_ (assert (= winInv txtInv) "windowed invalid bytes anchor equals whole-file path"))
        (binPath "asl/packages/asl-forms/tests/fixtures/ws/image.png")
        (winBin (resultOr (win/readWindowedAnchorFileReceipt! binPath "PNG" 1 100) ""))
        (txtBin (resultOr (txt/readAnchorFileReceipt! binPath "PNG" 1 100) ""))
        (_ (assert (= winBin txtBin) "windowed binary anchor refusal equals whole-file path"))]
    true)

fn testWindowedAnchorAmbiguity! scratchDir: String -> Bool
  (let [(filePath (str scratchDir "/ambiguous.txt"))
        (content "alpha marker\nbeta marker\ngamma unique\n")
        (writeRes (processRun (str "printf '" content "' > " filePath)))
        (_ (assert (= writeRes.exitCode 0) "ambiguous test fixture created"))
        (winAmb (resultOr (win/readWindowedAnchorFileReceipt! filePath "marker" 0 0) ""))
        (txtAmb (resultOr (txt/readAnchorFileReceipt! filePath "marker" 0 0) ""))
        (_ (assert (= winAmb txtAmb) "windowed ambiguous anchor receipt equals whole-file path"))
        (winOcc1 (resultOr (win/readWindowedAnchorFileReceipt! filePath "marker" 1 20) ""))
        (txtOcc1 (resultOr (txt/readAnchorFileReceipt! filePath "marker" 1 20) ""))
        (_ (assert (= winOcc1 txtOcc1) "windowed anchor occurrence 1 equals whole-file path"))
        (winOcc2 (resultOr (win/readWindowedAnchorFileReceipt! filePath "marker" 2 20) ""))
        (txtOcc2 (resultOr (txt/readAnchorFileReceipt! filePath "marker" 2 20) ""))
        (_ (assert (= winOcc2 txtOcc2) "windowed anchor occurrence 2 equals whole-file path"))
        (winOcc3 (resultOr (win/readWindowedAnchorFileReceipt! filePath "marker" 3 20) ""))
        (txtOcc3 (resultOr (txt/readAnchorFileReceipt! filePath "marker" 3 20) ""))
        (_ (assert (= winOcc3 txtOcc3) "windowed anchor occurrence out of bounds equals whole-file path"))]
    true)

fn testLineIndexAndTail! scratchDir: String -> Bool
  (let [(filePath (str scratchDir "/sample.txt"))
        (content "line one\nline two\nline three\nline four\nline five\n")
        (writeRes (processRun (str "printf '" content "' > " filePath)))
        (_ (assert (= writeRes.exitCode 0) "sample fixture created"))
        (idxRes (win/buildLineIndexDefault! filePath))
        (_ (assert (ok? idxRes) "buildLineIndex succeeds"))
        (idx (resultOr idxRes (win/LineIndex :path "" :fileSize 0 :totalLines 0 :lineStarts (i64ArrayGenerate 0 (fn [(i Int64)] -> Int64 0)))))
        (_ (assert (= (win/lineIndexTotalLines idx) 5) "lineIndexTotalLines equals 5"))
        (_ (assert (= (win/lineIndexFileSize idx) (stringLength content)) "lineIndexFileSize matches"))
        (off1 (win/lineIndexLineOffset idx 1))
        (_ (assert (some? off1) "lineOffset line 1 is some"))
        (_ (assert (= (optionOr off1 -1) 0) "lineOffset line 1 is 0"))
        (off2 (win/lineIndexLineOffset idx 2))
        (_ (assert (some? off2) "lineOffset line 2 is some"))
        (_ (assert (= (optionOr off2 -1) 9) "lineOffset line 2 is 9"))
        (offBad (win/lineIndexLineOffset idx 10))
        (_ (assert (none? offBad) "lineOffset out of bounds returns none"))
        (indexedRec (win/readIndexedRangeReceipt! idx 2 4 200 12000))
        (txtRec (resultOr (txt/readRangeFileReceipt! filePath 2 4 200 12000) ""))
        (_ (assert (= indexedRec txtRec) "readIndexedRangeReceipt matches txt/readRangeFileReceipt"))
        (tail2Res (win/readWindowedTail! filePath 2 4096))
        (_ (assert (ok? tail2Res) "readWindowedTail 2 lines succeeds"))
        (tail2 (resultOr tail2Res ""))
        (_ (assert (= tail2 "line four\nline five\n") "tail 2 lines content matches"))
        (tailReceiptRes (win/readWindowedTailFileReceipt! filePath 2))
        (_ (assert (ok? tailReceiptRes) "readWindowedTailFileReceipt succeeds"))
        (tailReceipt (resultOr tailReceiptRes ""))
        (_ (assert (stringContains? tailReceipt "line four") "tail receipt contains tail content"))
        (tailLarge (resultOr (win/readWindowedTail! filePath 50 4096) ""))
        (_ (assert (= tailLarge content) "tail larger than file returns whole file"))]
    true)

fn testBytesText -> Bool
  (let [(emptyBs (stringToBytes ""))
        (sEmpty (btxt/bytesToString emptyBs))
        (_ (assert (= sEmpty "") "bytesToString empty bytes is empty string"))
        (c65 (btxt/byteStr 65))
        (_ (assert (= c65 "A") "byteStr 65 is A"))
        (asciiBs (stringToBytes "Hello, world!"))
        (sAscii (btxt/bytesToString asciiBs))
        (_ (assert (= sAscii "Hello, world!") "bytesToString ascii matches"))]
    true)

fn testGeneratedLogExportedFunctions! scratchDir: String -> Bool
  (let [(logPath (str scratchDir "/stream.log"))
        (missingPath (str scratchDir "/missing.log"))
        (genCmd (str "awk 'BEGIN { for (i = 1; i <= 200; i++) { if (i == 42) printf \"2026-09-26T05:30:42.000Z [ERROR] critical-alert disk-full event-42\\n\"; else printf \"2026-09-26T05:30:%02d.000Z [INFO] worker-%d log entry line %d\\n\", i % 60, i % 5, i } }' > " logPath))
        (genRes (processRun genCmd))
        (_ (assert (= genRes.exitCode 0) "test log generated successfully"))
        (wholeText (resultOr (fileReadString logPath) ""))
        (cWin (resultOr (win/countLinesInFile! logPath 64) 0))
        (wholeLines (txt/splitLinesKeepEnds wholeText (stringToBytes wholeText) (stringLength wholeText) 0 0 (list)))
        (cTxt (listLength wholeLines))
        (_ (assert (= cWin cTxt) "countLinesInFile matches whole-file line count on generated log"))
        (_ (assert (= cWin 200) "countLinesInFile returns exact line count 200"))
        (cMissing (win/countLinesInFile! missingPath 64))
        (_ (assert (err? cMissing) "countLinesInFile missing file returns err"))
        (rWin1 (resultOr (win/readWindowedRange! logPath 10 15 200 12000 64) ""))
        (rTxt1 (resultOr (txt/readRange wholeText 10 15 200 12000) ""))
        (_ (assert (= rWin1 rTxt1) "readWindowedRange lines 10..15 matches txt/readRange"))
        (rWinLim (resultOr (win/readWindowedRange! logPath 10 20 3 12000 64) ""))
        (rTxtLim (resultOr (txt/readRange wholeText 10 20 3 12000) ""))
        (_ (assert (= rWinLim rTxtLim) "readWindowedRange limit 3 matches txt/readRange"))
        (rWinBytes (resultOr (win/readWindowedRange! logPath 10 20 200 120 64) ""))
        (rTxtBytes (resultOr (txt/readRange wholeText 10 20 200 120) ""))
        (_ (assert (= rWinBytes rTxtBytes) "readWindowedRange maxBytes 120 matches txt/readRange"))
        (rWinOob (win/readWindowedRange! logPath 300 350 200 12000 64))
        (rTxtOob (txt/readRange wholeText 300 350 200 12000))
        (_ (assert (= rWinOob rTxtOob) "readWindowedRange out-of-range matches txt/readRange err"))
        (_ (assert (err? rWinOob) "readWindowedRange out-of-range is err"))
        (rWinRev (win/readWindowedRange! logPath 20 10 200 12000 64))
        (rTxtRev (txt/readRange wholeText 20 10 200 12000))
        (_ (assert (= rWinRev rTxtRev) "readWindowedRange inverted range matches txt/readRange err"))
        (_ (assert (err? rWinRev) "readWindowedRange inverted range is err"))
        (rWinMissing (win/readWindowedRange! missingPath 1 5 200 12000 64))
        (_ (assert (err? rWinMissing) "readWindowedRange missing file returns err"))
        (idxRes (win/buildLineIndex! logPath 64))
        (_ (assert (ok? idxRes) "buildLineIndex on generated log succeeds"))
        (idx (resultOr idxRes (win/LineIndex :path "" :fileSize 0 :totalLines 0 :lineStarts (i64ArrayGenerate 0 (fn [(i Int64)] -> Int64 0)))))
        (_ (assert (= (win/lineIndexTotalLines idx) 200) "lineIndexTotalLines matches 200"))
        (iWin1 (resultOr (win/readIndexedRange! idx 10 15 200 12000) ""))
        (_ (assert (= iWin1 rTxt1) "readIndexedRange lines 10..15 matches txt/readRange"))
        (iWinLim (resultOr (win/readIndexedRange! idx 10 20 3 12000) ""))
        (_ (assert (= iWinLim rTxtLim) "readIndexedRange limit 3 matches txt/readRange"))
        (iWinBytes (resultOr (win/readIndexedRange! idx 10 20 200 120) ""))
        (_ (assert (= iWinBytes rTxtBytes) "readIndexedRange maxBytes 120 matches txt/readRange"))
        (iWinOob (win/readIndexedRange! idx 300 350 200 12000))
        (_ (assert (= iWinOob rTxtOob) "readIndexedRange out-of-range matches txt/readRange err"))
        (_ (assert (err? iWinOob) "readIndexedRange out-of-range is err"))
        (iWinRev (win/readIndexedRange! idx 20 10 200 12000))
        (_ (assert (= iWinRev rTxtRev) "readIndexedRange inverted range matches txt/readRange err"))
        (_ (assert (err? iWinRev) "readIndexedRange inverted range is err"))
        (missingIdx (win/LineIndex :path missingPath :fileSize 100 :totalLines 10 :lineStarts (i64ArrayGenerate 10 (fn [(i Int64)] -> Int64 (* i 10)))))
        (iWinMissing (win/readIndexedRange! missingIdx 1 5 200 12000))
        (_ (assert (err? iWinMissing) "readIndexedRange missing file returns err"))
        (aWin1 (resultOr (win/readWindowedAnchor! logPath "critical-alert" 1 100) ""))
        (aTxt1 (resultOr (txt/readAnchor wholeText "critical-alert" 1 100) ""))
        (_ (assert (= aWin1 aTxt1) "readWindowedAnchor critical-alert matches txt/readAnchor"))
        (_ (assert (stringContains? aWin1 "disk-full") "readWindowedAnchor contains expected text"))
        (aWinOcc2 (resultOr (win/readWindowedAnchor! logPath "worker-2" 2 100) ""))
        (aTxtOcc2 (resultOr (txt/readAnchor wholeText "worker-2" 2 100) ""))
        (_ (assert (= aWinOcc2 aTxtOcc2) "readWindowedAnchor worker-2 occurrence 2 matches txt/readAnchor"))
        (aWinOob (win/readWindowedAnchor! logPath "worker-2" 999 100))
        (aTxtOob (txt/readAnchor wholeText "worker-2" 999 100))
        (_ (assert (= aWinOob aTxtOob) "readWindowedAnchor out-of-range occurrence matches txt/readAnchor err"))
        (_ (assert (err? aWinOob) "readWindowedAnchor out-of-range occurrence is err"))
        (aWinNone (win/readWindowedAnchor! logPath "nonexistent-event-tag" 1 100))
        (aTxtNone (txt/readAnchor wholeText "nonexistent-event-tag" 1 100))
        (_ (assert (= aWinNone aTxtNone) "readWindowedAnchor nonexistent anchor matches txt/readAnchor err"))
        (_ (assert (err? aWinNone) "readWindowedAnchor nonexistent anchor is err"))
        (aWinMissing (win/readWindowedAnchor! missingPath "critical-alert" 1 100))
        (_ (assert (err? aWinMissing) "readWindowedAnchor missing file returns err"))]
    true)

fn test50MbLogGate! scratchDir: String -> Bool
  (let [(bigPath (str scratchDir "/big_50mb.log"))
        (genCmd (str "yes '2026-09-26T05:30:00.000Z [INFO] worker-pool-42 task executed successfully with status 200 ok!! 12ms' | head -c 52428800 > " bigPath))
        (genRes (processRun genCmd))
        (_ (assert (= genRes.exitCode 0) "50 MB log generated successfully"))
        (szRes (fileSize bigPath))
        (_ (assert (ok? szRes) "fileSize ok on 50 MB log"))
        (sz (resultOr szRes 0))
        (_ (assert (= sz 52428800) "50 MB log file size is exactly 52428800 bytes"))
        (t0 (monotonicNs))
        (read4kRes (fileReadRange bigPath 25000000 4096))
        (t1 (monotonicNs))
        (elapsedMs (/ (- t1 t0) 1000000))
        (_ (assert (ok? read4kRes) "windowed 4 KB read on 50 MB log ok"))
        (bs (resultOr read4kRes (stringToBytes "")))
        (_ (assert (= (bytesLength bs) 4096) "windowed read buffer is 4096 bytes"))
        (_ (assert (<= elapsedMs 20) "4 KB window read <= 20 ms"))
        (tailRes (win/readWindowedTail! bigPath 3 4096))
        (_ (assert (ok? tailRes) "readWindowedTail on 50 MB log ok"))
        (tailStr (resultOr tailRes ""))
        (_ (assert (stringContains? tailStr "worker-pool-42") "50 MB tail content contains expected log message"))
        (count50MbRes (win/countLinesInFile! bigPath 65536))
        (_ (assert (ok? count50MbRes) "countLinesInFile on 50 MB log ok"))
        (_ (assert (= (resultOr count50MbRes 0) 524288) "countLinesInFile on 50 MB log is exactly 524288"))
        (winRange50MbRes (win/readWindowedRange! bigPath 1 2 200 12000 65536))
        (_ (assert (ok? winRange50MbRes) "readWindowedRange on 50 MB log ok"))
        (winRange50Mb (resultOr winRange50MbRes ""))
        (_ (assert (stringContains? winRange50Mb "worker-pool-42") "readWindowedRange 50 MB contains expected log line"))
        (winRange50MbOob (win/readWindowedRange! bigPath 600000 600010 200 12000 65536))
        (_ (assert (err? winRange50MbOob) "readWindowedRange on 50 MB log out-of-range is err"))
        (rssCmd (str "sh -c 'if /usr/bin/time -l true >/dev/null 2>&1; then /usr/bin/time -l asl/host/out/asl-host eval \"(fileReadRange \\\"" bigPath "\\\" 25000000 4096)\" 2>&1 | awk \"/maximum resident set size/{print \\$1}\"; else /usr/bin/time -v asl/host/out/asl-host eval \"(fileReadRange \\\"" bigPath "\\\" 25000000 4096)\" 2>&1 | awk \"/Maximum resident set size/{print \\$6 * 1024}\"; fi'"))
        (rssRun (processRun rssCmd))
        (_ (assert (= rssRun.exitCode 0) "rss measurement command executed cleanly"))
        (rssOut (stringTrim rssRun.stdout))
        (rssBytes (optionOr (stringToInt64 rssOut) 0))
        (_ (assert (> rssBytes 0) "measured peak RSS is positive"))
        (_ (assert (< rssBytes 15728640) "peak RSS below 2x window count bound (< 15 MB, whole-file > 50 MB)"))
        (rmRes (processRun (str "rm -f " bigPath)))
        (_ (assert (= rmRes.exitCode 0) "50 MB log cleaned up"))]
    true)

fn ! runTests -> Bool
  (let [(mktempRes (processRun "mktemp -d /tmp/asl_st2_test_XXXXXX"))
        (_ (assert (= mktempRes.exitCode 0) "mktemp scratch directory created"))
        (scratchDir (stringTrim mktempRes.stdout))
        (_ (testWindowedRangeParity!))
        (_ (testWindowedRangeFixtures!))
        (_ (testWindowedAnchorParity!))
        (_ (testWindowedAnchorAmbiguity! scratchDir))
        (_ (testLineIndexAndTail! scratchDir))
        (_ (testBytesText))
        (_ (testGeneratedLogExportedFunctions! scratchDir))
        (_ (test50MbLogGate! scratchDir))
        (cleanRes (processRun (str "rm -rf " scratchDir)))
        (_ (assert (= cleanRes.exitCode 0) "scratch directory cleaned up"))]
    true)
