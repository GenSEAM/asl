(module asl-syntax/tests/registryTest
  :x [runTests]
  :i [(asl-syntax/registry :a reg)])

fn testShebangCases -> Bool
  (do
    (assert (= (reg/languageByShebang "#!/bin/bash") "shell") "shebang /bin/bash is shell")
    (assert (= (reg/languageByShebang "#!/bin/sh") "shell") "shebang /bin/sh is shell")
    (assert (= (reg/languageByShebang "#!/bin/zsh") "shell") "shebang /bin/zsh is shell")
    (assert (= (reg/languageByShebang "#!/bin/dash") "shell") "shebang /bin/dash is shell")
    (assert (= (reg/languageByShebang "#!/bin/ksh") "shell") "shebang /bin/ksh is shell")
    (assert (= (reg/languageByShebang "#!/usr/bin/env bash") "shell") "shebang env bash is shell")
    (assert (= (reg/languageByShebang "#!/usr/bin/env sh") "shell") "shebang env sh is shell")
    (assert (= (reg/languageByShebang "#!/usr/bin/env -S bash -e") "shell") "shebang env -S bash is shell")
    (assert (= (reg/languageByShebang "#!/usr/bin/env python") "python") "shebang env python is python")
    (assert (= (reg/languageByShebang "#!/usr/bin/env python3") "python") "shebang env python3 is python")
    (assert (= (reg/languageByShebang "#!/usr/bin/python3.11") "python") "shebang python3.11 is python")
    (assert (= (reg/languageByShebang "#!/usr/bin/env python -O") "python") "shebang env python arguments are ignored")
    (assert (= (reg/languageByShebang "#!/usr/local/bin/python") "python") "absolute Python interpreter path is recognized")
    (assert (= (reg/languageByShebang "#!/usr/bin/python") "python") "shebang python is python")
    (assert (= (reg/languageByShebang "#!/usr/bin/env node") "javascript") "shebang env node is javascript")
    (assert (= (reg/languageByShebang "#!/usr/local/bin/node") "javascript") "shebang node is javascript")
    (assert (= (reg/languageByShebang "#!/usr/bin/env perl") "perl") "shebang env perl is perl")
    (assert (= (reg/languageByShebang "#!/usr/bin/env ruby") "ruby") "shebang env ruby is ruby")
    (assert (= (reg/languageByShebang "#!/usr/bin/env pwsh") "shebang.pwsh") "unknown interpreter keeps shebang kind")
    (assert (= (reg/languageByShebang "not a shebang line") "") "non-shebang returns empty")
    true)

fn testMarkdownInfoCases -> Bool
  (do
    (assert (= (reg/languageByMarkdownInfo "python") "python") "markdown python")
    (assert (= (reg/languageByMarkdownInfo "py") "python") "markdown py")
    (assert (= (reg/languageByMarkdownInfo "py3") "python") "markdown py3")
    (assert (= (reg/languageByMarkdownInfo "javascript") "javascript") "markdown javascript")
    (assert (= (reg/languageByMarkdownInfo "js") "javascript") "markdown js")
    (assert (= (reg/languageByMarkdownInfo "typescript") "typescript") "markdown typescript")
    (assert (= (reg/languageByMarkdownInfo "ts") "typescript") "markdown ts")
    (assert (= (reg/languageByMarkdownInfo "tsx") "typescript") "markdown tsx")
    (assert (= (reg/languageByMarkdownInfo "jsx") "javascript") "markdown jsx")
    (assert (= (reg/languageByMarkdownInfo "asl") "asl") "markdown asl")
    (assert (= (reg/languageByMarkdownInfo "asn") "asn") "markdown asn")
    (assert (= (reg/languageByMarkdownInfo "sh") "shell") "markdown sh")
    (assert (= (reg/languageByMarkdownInfo "bash") "shell") "markdown bash")
    (assert (= (reg/languageByMarkdownInfo "shell") "shell") "markdown shell")
    (assert (= (reg/languageByMarkdownInfo "c") "c") "markdown c")
    (assert (= (reg/languageByMarkdownInfo "cpp") "cpp") "markdown cpp")
    (assert (= (reg/languageByMarkdownInfo "rust") "rust") "markdown rust")
    (assert (= (reg/languageByMarkdownInfo "rs") "rust") "markdown rs")
    (assert (= (reg/languageByMarkdownInfo "go") "go") "markdown go")
    (assert (= (reg/languageByMarkdownInfo "golang") "go") "markdown golang")
    (assert (= (reg/languageByMarkdownInfo "json") "json") "markdown json")
    (assert (= (reg/languageByMarkdownInfo "yaml") "yaml") "markdown yaml")
    (assert (= (reg/languageByMarkdownInfo "yml") "yaml") "markdown yml")
    (assert (= (reg/languageByMarkdownInfo "toml") "toml") "markdown toml")
    (assert (= (reg/languageByMarkdownInfo "html") "html") "markdown html")
    (assert (= (reg/languageByMarkdownInfo "css") "css") "markdown css")
    (assert (= (reg/languageByMarkdownInfo "sql") "sql") "markdown sql")
    (assert (= (reg/languageByMarkdownInfo "swift") "swift") "markdown swift")
    (assert (= (reg/languageByMarkdownInfo "ruby") "ruby") "markdown ruby")
    (assert (= (reg/languageByMarkdownInfo "zig") "zig") "markdown zig")
    (assert (= (reg/languageByMarkdownInfo "python title=\"hello.py\"") "python") "markdown info with title")
    (assert (= (reg/languageByMarkdownInfo "ts {1-3}") "typescript") "markdown info with lines")
    true)

fn testHtmlTypeCases -> Bool
  (do
    (assert (= (reg/languageByHtmlType "text/javascript") "javascript") "html text/javascript")
    (assert (= (reg/languageByHtmlType "application/javascript") "javascript") "html application/javascript")
    (assert (= (reg/languageByHtmlType "module") "javascript") "html module")
    (assert (= (reg/languageByHtmlType "text/typescript") "typescript") "html text/typescript")
    (assert (= (reg/languageByHtmlType "text/css") "css") "html text/css")
    (assert (= (reg/languageByHtmlType "application/json") "json") "html application/json")
    (assert (= (reg/languageByHtmlType "importmap") "json") "html importmap")
    (assert (= (reg/languageByHtmlType "text/html") "html") "html text/html")
    true)

fn testMimeCases -> Bool
  (do
    (assert (= (reg/languageByMime "application/javascript") "javascript") "mime app js")
    (assert (= (reg/languageByMime "text/javascript") "javascript") "mime text js")
    (assert (= (reg/languageByMime "application/typescript") "typescript") "mime app ts")
    (assert (= (reg/languageByMime "text/typescript") "typescript") "mime text ts")
    (assert (= (reg/languageByMime "text/x-python") "python") "mime text x-python")
    (assert (= (reg/languageByMime "application/x-python-code") "python") "mime app python")
    (assert (= (reg/languageByMime "text/x-shellscript") "shell") "mime shellscript")
    (assert (= (reg/languageByMime "application/x-sh") "shell") "mime x-sh")
    (assert (= (reg/languageByMime "text/x-c") "c") "mime x-c")
    (assert (= (reg/languageByMime "text/x-rust") "rust") "mime x-rust")
    (assert (= (reg/languageByMime "text/x-go") "go") "mime x-go")
    (assert (= (reg/languageByMime "application/json") "json") "mime json")
    (assert (= (reg/languageByMime "text/yaml") "yaml") "mime yaml")
    (assert (= (reg/languageByMime "application/yaml") "yaml") "mime app yaml")
    (assert (= (reg/languageByMime "application/toml") "toml") "mime toml")
    (assert (= (reg/languageByMime "text/markdown") "markdown") "mime markdown")
    (assert (= (reg/languageByMime "text/html") "html") "mime html")
    (assert (= (reg/languageByMime "text/css") "css") "mime css")
    (assert (= (reg/languageByMime "application/xml") "xml") "mime xml")
    (assert (= (reg/languageByMime "application/wasm") "wasm") "mime wasm")
    (assert (= (reg/languageByMime "text/x-asl") "asl") "mime asl")
    (assert (= (reg/languageByMime "text/x-asn") "asn") "mime asn")
    true)

fn testExtensionCases -> Bool
  (do
    (assert (= (reg/languageByExtension ".asl") "asl") "ext .asl")
    (assert (= (reg/languageByExtension "asl") "asl") "ext asl without dot")
    (assert (= (reg/languageByExtension ".asn") "asn") "ext .asn")
    (assert (= (reg/languageByExtension ".py") "python") "ext .py")
    (assert (= (reg/languageByExtension ".ts") "typescript") "ext .ts")
    (assert (= (reg/languageByExtension ".tsx") "typescript") "ext .tsx")
    (assert (= (reg/languageByExtension ".js") "javascript") "ext .js")
    (assert (= (reg/languageByExtension ".jsx") "javascript") "ext .jsx")
    (assert (= (reg/languageByExtension ".c") "c") "ext .c")
    (assert (= (reg/languageByExtension ".h") "c") "ext .h")
    (assert (= (reg/languageByExtension ".cpp") "cpp") "ext .cpp")
    (assert (= (reg/languageByExtension ".rs") "rust") "ext .rs")
    (assert (= (reg/languageByExtension ".go") "go") "ext .go")
    (assert (= (reg/languageByExtension ".java") "java") "ext .java")
    (assert (= (reg/languageByExtension ".sh") "shell") "ext .sh")
    (assert (= (reg/languageByExtension ".bash") "shell") "ext .bash")
    (assert (= (reg/languageByExtension ".zsh") "shell") "ext .zsh")
    (assert (= (reg/languageByExtension ".json") "json") "ext .json")
    (assert (= (reg/languageByExtension ".yaml") "yaml") "ext .yaml")
    (assert (= (reg/languageByExtension ".yml") "yaml") "ext .yml")
    (assert (= (reg/languageByExtension ".toml") "toml") "ext .toml")
    (assert (= (reg/languageByExtension ".md") "markdown") "ext .md")
    (assert (= (reg/languageByExtension ".swift") "swift") "ext .swift")
    (assert (= (reg/languageByExtension ".rb") "ruby") "ext .rb")
    (assert (= (reg/languageByExtension ".kt") "kotlin") "ext .kt")
    (assert (= (reg/languageByExtension ".zig") "zig") "ext .zig")
    (assert (= (reg/languageByExtension ".lua") "lua") "ext .lua")
    (assert (= (reg/languageByExtension ".pl") "perl") "ext .pl")
    (assert (= (reg/languageByExtension ".php") "php") "ext .php")
    (assert (= (reg/languageByExtension ".ps1") "powershell") "ext .ps1")
    (assert (= (reg/languageByExtension ".unknownext123") "") "unknown ext returns empty")
    true)

fn ! runTests -> Bool
  (do
    (assert (testShebangCases) "shebang suite")
    (assert (testMarkdownInfoCases) "markdown info suite")
    (assert (testHtmlTypeCases) "html type suite")
    (assert (testMimeCases) "mime suite")
    (assert (testExtensionCases) "extension suite")
    true)
