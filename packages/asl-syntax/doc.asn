(:doc :symbol "asl/packages/asl-syntax/src/asl/layout.asl#" :text "Lossless indented ASL syntax tree with layout nodes and SExpr lowering")
(:doc :symbol "asl/packages/asl-syntax/src/asl/layout.asl#lowerTopFormText" :text "joinFnHeader (asl-parser/ast, out of this unit's owns) folds a fn header whose param list continues onto indented name: or -> lines back onto its first line before indentParser sees it; without that step a multi-line header's arrow is missed, its return type silently defaults to Unit and the continuation lines are misread as body forms.")
(:doc :symbol "asl/packages/asl-syntax/src/asl/layout.asl#escapeFormStringNewlines" :text "escape newlines inside multiline string literals")
(:doc :symbol "asl/packages/asl-syntax/src/asl/layout.asl#formHasMultilineString?" :text "check if form bytes have multiline string")
(:doc :symbol "asl/packages/asl-syntax/src/asl/layout.asl#lowerTopFormText" :text "PARSER-inferredUnitConsumers / INFERUNIT round 2: lowerTopFormText's job is to hand the host a canonical form it can read natively, and the host already infers an arrow-less fn's return type from its body, so the lowered form drops the synthetic -> :inferredUnit pair rather than leaking that sentinel into canonical ASL. Delegated to ip/stripInferredUnit (asl-parser/indentParser, which also defines the sentinel) rather than keeping a private copy; the prior copy here matched (rd/sexprHead h) on any SExpr, atom or list, and kept scanning past the header into the body, so a body form like (-> x) false-matched and lost real body forms")
(:doc :symbol "asl/packages/asl-syntax/src/asl/lex.asl#" :text "Lossless ASL and ASN lexical tokenizer. Unicode brace escapes take one to six hex digits naming a Unicode scalar value, at most U+10FFFF with surrogates rejected, the same accept set as the host reader")
(:doc :symbol "asl/packages/asl-syntax/src/asl/lex.asl#lexPending" :text "a pending token is one more bytes could extend: its end is the offset a resumed scan continues from, pendingError marks a string already holding an invalid escape")
(:doc :symbol "asl/packages/asl-syntax/src/asl/lex.asl#scanHexRun" :text "-1 when count hex digits start at p, else the offset of the first non-hex byte, or -2 when the buffer ends first")
(:doc :symbol "asl/packages/asl-syntax/src/asl/lex.asl#scanBracedEscape" :text "braced digits from p; verdict at the closer")
(:doc :symbol "asl/packages/asl-syntax/src/asl/lex.asl#scanFourHexEscape" :text "legacy 4-digit form; surrogate refuted at last digit")
(:doc :symbol "asl/packages/asl-syntax/src/asl/lex.asl#scanEscape" :text "status 0 valid, 1 invalid, 2 needs more bytes")
(:doc :symbol "asl/packages/asl-syntax/src/asl/lex.asl#scanStringFrom" :text "a string the buffer end cuts, even inside an escape, comes back pending with the escape's backslash as resume offset; at the true end of input every such string is an error token to the end")
(:doc :symbol "asl/packages/asl-syntax/src/asl/lex.asl#stringErrorAt" :text "offset of the first byte that makes the string starting before i invalid whatever follows, -1 when none is in the buffer")
(:doc :symbol "asl/packages/asl-syntax/src/asl/lex.asl#lexResume" :text "one scanner for whole and incremental lexing: final treats the buffer end as end of input; otherwise a token more bytes could extend comes back pending with its resume offset, so a resumed scan never rereads what it has passed")
(:doc :symbol "asl/packages/asl-syntax/src/asl/paren.asl#" :text "Lossless ASL and ASN paren syntax tree with error recovery")
(:doc :symbol "asl/packages/asl-syntax/src/asl/paren.asl#parseStep" :text "one token of the paren parse, shared by parseTokens and the incremental parser")
(:doc :symbol "asl/packages/asl-syntax/src/asl/symbols.asl#" :text "Lossless ASL and ASN symbol index, byte and line ranges, and dotted lookup")
(:doc :symbol "asl/packages/asl-syntax/src/core/bench.asl#" :text "Benchmark harness computing median of 5 runs and ms per 100 KB")
(:doc :symbol "asl/packages/asl-syntax/src/core/bytesText.asl#" :text "Pure ASL byte and byte-array string conversion routines")
(:doc :symbol "asl/packages/asl-syntax/src/core/corpus.asl#" :text "Corpus driver for syntax roundtripping and upstream manifest verification")
(:doc :symbol "asl/packages/asl-syntax/src/core/cursor.asl#" :text "Cursor navigation, ancestors, siblings, and line ranges for syntax trees")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#" :text "Pure ASL canonical formatter for repaired ASL and ASN text: takes the caller's repair result, re-spaces only the touched lines token by token (no token added, dropped or changed beyond the repair's own edits), and leaves every untouched line byte-identical")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#resolveLang" :text "the language comes only from the caller: an explicit asl or asn, or a path whose extension decides it")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#langForPath" :text "map a file extension to its language; any other extension is an error, never a guess")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#checkRepairedLines" :text "delimiter edits never add or remove a newline except a closer appended after a final newline, so every line the repaired text changes must be one an item names; anything else means text and items disagree")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#touchedLinesFromRepaired" :text "touched lines are the distinct lines the items name; delimiter edits never add or remove a newline, so these numbers hold in the repaired text")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#isOpenDelim?" :text "check if token kind is opening delimiter")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#isCloseDelim?" :text "check if token kind is closing delimiter")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#isOnlyClosingDelims?" :text "check if string has only closing delimiters")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#contentTokens" :text "non-trivia tokens of a text")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#lineEndsWithComment?" :text "check if line ends with a comment token")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#takeWhileWhitespace" :text "collect whitespace characters prefix")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#leadingIndent" :text "extract leading whitespace of line")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#shouldSeparate" :text "re-spacing never moves a token boundary: tokens written together stay together, a run of blanks becomes one space, and blanks after an opener or before a closer or comma go away")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#formatTokensLoop" :text "fold tokens to formatted line string")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#formatSingleLine" :text "a line keeps its own terminator: a trailing carriage return is set aside before re-spacing and restored after")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#formatLineBody" :text "re-space one touched line token by token, keeping its indentation; no token is added, dropped or changed")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#appendBeforeCr" :text "append closers to a line before its carriage return, so the line keeps its terminator")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#splitLines" :text "split text into lines dropping the empty piece after a final newline")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#dominantTerminator" :text "CRLF when most line ends of the original are CRLF")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#joinLines" :text "join output lines; the text ends with a terminator exactly when the original did, a final line keeping its own carriage return and a repaired final line without one taking the dominant terminator")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#findPrevContentEntry" :text "find previous non-dropped non-empty entry index")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#updateEntryAt" :text "replace entry at index in LineEntry list")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#attachClosingPass" :text "a touched line holding only closers joins the previous content line; untouched closer lines are left where they are")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#keepEntry?" :text "a touched line emptied by a deletion disappears; untouched blank lines stay")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#pinnedLines" :text "lines a multi-line token such as a string spans; tokenizing one of them alone would misread the token, so they are never re-spaced")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#formatLines" :text "re-space touched lines, attach touched closer-only lines to the previous content line, copy every other line byte for byte; ASL and ASN share it because it only moves blanks")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#formatText" :text "one code path for clean and repaired input: the caller's repair result supplies the repaired text and the items that name the touched lines; the language is validated here and chose the repair; repair is never re-run here")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#formatBytes" :text "byte form of formatText")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#formatRepair" :text "formatter applies each fault's at-site edit, as G2")
(:doc :symbol "asl/packages/asl-syntax/src/core/format.asl#formatFile!" :text "repair and format a file in the language its extension names")
(:doc :symbol "asl/packages/asl-syntax/src/core/incremental.asl#" :text "Streaming incremental syntax parser with early fatal error detection")
(:doc :symbol "asl/packages/asl-syntax/src/core/incremental.asl#IncrementalState" :text "claim holds the length up to which buf is written; a state appends in place only while it owns that length, so earlier states stay valid")
(:doc :symbol "asl/packages/asl-syntax/src/core/incremental.asl#appendChunk!" :text "appends in place only when this state owns the written length and capacity suffices; otherwise copies, so a forked state never sees a sibling's bytes")
(:doc :symbol "asl/packages/asl-syntax/src/core/incremental.asl#stringFatalOffset" :text "offset of the first invalid escape in the string token starting at start; the token start if the scan finds none")
(:doc :symbol "asl/packages/asl-syntax/src/core/incremental.asl#tokenFatal" :text "a finished token is fatal when it is an invalid string or a closer that cannot match; no later byte can repair either")
(:doc :symbol "asl/packages/asl-syntax/src/core/incremental.asl#pendingFatal" :text "a pending string already holding an invalid escape is fatal now, at the offset of the byte that made it so")
(:doc :symbol "asl/packages/asl-syntax/src/core/incremental.asl#scanLoop" :text "the fatal offset rescans a string at most once per state, since the first fatal error is kept")
(:doc :symbol "asl/packages/asl-syntax/src/core/incremental.asl#flushLoop" :text "finishes the pending token as if the input ended here, exactly as prn/parseBytes treats the end of its buffer")
(:doc :symbol "asl/packages/asl-syntax/src/core/outline.asl#" :text "Outline formatting and ASN receipt generation byte-identical to aslForms")
(:doc :symbol "asl/packages/asl-syntax/src/core/print.asl#" :text "Lossless printing of syntax trees by leaf slice concatenation")
(:doc :symbol "asl/packages/asl-syntax/src/core/source.asl#" :text "Pure AgentScript Source mapping, line indexing, and binaryKind classification")
(:doc :symbol "asl/packages/asl-syntax/src/core/symbols.asl#" :text "SymbolDef, dotted lookup, nearest names, anchor resolution and reparse guard")
(:doc :symbol "asl/packages/asl-syntax/src/core/tree.asl#" :text "Green syntax tree Token and Node structures with byte spans and tiling check")
