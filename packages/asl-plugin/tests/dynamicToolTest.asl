(module asl-plugin/dynamicToolTest :x [runTests] :i [(dynamicTool :a dt) (asl-text/text :a txt)])

fn testEmptyPlaneAndBaseTools -> Bool
  (let [(plane (dt/emptyPlane)) (tools (dt/baseTools))] (assert (= (listLength tools) 4) "Base tools must contain exactly 4 meta-tools") (assert (listContains? tools "eval") "Base tools must contain eval") (assert (listContains? tools "batch") "Base tools must contain batch") (assert (listContains? tools "tool-load") "Base tools must contain tool-load") (assert (listContains? tools "tool-unload") "Base tools must contain tool-unload") (assert (dt/baseLandscape? plane) "Empty plane must satisfy base-landscape predicate") (assert (= (dt/toolCount plane) 4) "Initial tool count must be exactly 4") true)

fn testDomainLoadingAndLookup -> Bool
  (let [(p1 (dt/createParam "sym" ":str" false "Target symbol name")) (p2 (dt/createParam "format" ":str" true "Output format option")) (t1 (dt/createTool "callers" "intel" (list p1 p2) "(:graph :callers)" "Find callers" "(:graph (Caller > Target:call Line:int))")) (dIntel (dt/createDomain "intel" "Code intelligence" (list t1) "(:graph (Node > Target:edge))")) (plane (dt/emptyPlane)) (pMounted (dt/loadDomain plane dIntel))] (assert (= p1.name "sym") "Param name must match") (assert (= p1.paramType ":str") "Param type must match") (assert (= t1.name "callers") "Tool name must match") (assert (= t1.domain "intel") "Tool domain must match") (assert (= dIntel.name "intel") "Domain name must match") (assert (= (listLength dIntel.tools) 1) "Domain must contain 1 tool") (assert (dt/domainLoaded? pMounted "intel") "Intel domain must be marked loaded") (refute (dt/baseLandscape? pMounted) "Mounted plane must not be base landscape") (assert (= (dt/toolCount pMounted) 5) "Tool count must increase to 5") (assert (dt/hasTool? pMounted "callers") "Mounted tool callers must be accessible") (assert (dt/hasTool? pMounted "eval") "Base meta-tool eval must remain accessible") (assert (some? (dt/lookupTool pMounted "callers")) "Lookup for callers must return some") (assert (none? (dt/lookupTool pMounted "nonexistent")) "Lookup for unknown tool must return none") true)

fn testDomainUnloadingAndReceipts -> Bool
  (let [(p1 (dt/createParam "sym" ":str" false "Target symbol")) (t1 (dt/createTool "callers" "intel" (list p1) ":graph" "Find callers" "")) (dIntel (dt/createDomain "intel" "Code intelligence" (list t1) "")) (plane (dt/emptyPlane)) (pMounted (dt/loadDomain plane dIntel)) (rcpt (dt/mountReceipt dIntel)) (pUnmounted (dt/unloadDomain pMounted "intel")) (uRcpt (dt/unmountReceipt "intel" 1))] (assert (= rcpt.status "ok") "Mount receipt status must be ok") (assert (= rcpt.mountedCount 1) "Mount receipt count must be 1") (assert (= rcpt.domain "intel") "Mount receipt domain must be intel") (refute (dt/domainLoaded? pUnmounted "intel") "Intel domain must not be loaded after unload") (refute (dt/hasTool? pUnmounted "callers") "Callers tool must not be present after unload") (assert (dt/baseLandscape? pUnmounted) "Tool plane must revert to base landscape after unload") (assert (= (dt/toolCount pUnmounted) 4) "Tool count must revert to 4") (assert (= uRcpt.status "ok") "Unmount receipt status must be ok") (assert (= uRcpt.unmountedCount 1) "Unmount receipt count must be 1") true)

fn testTurnResetAndTokenLandscape -> Bool
  (let [(p1 (dt/createParam "path" ":str" false "File path")) (t1 (dt/createTool "read" "fs" (list p1) ":str" "Read file" "")) (dFs (dt/createDomain "fs" "Filesystem operations" (list t1) "")) (plane (dt/emptyPlane)) (pMounted (dt/loadDomain plane dFs)) (pReset (dt/resetTurn pMounted)) (lsEmpty (dt/activeLandscape (dt/emptyPlane))) (lsMounted (dt/activeLandscape pMounted))] (assert (dt/baseLandscape? pReset) "Plane after turn reset must be base landscape") (assert (= (dt/toolCount pReset) 4) "Reset plane must have exactly 4 tools") (assert lsEmpty.baseOnly "Empty landscape base-only flag must be true") (assert (= lsEmpty.totalCount 4) "Empty landscape tool count must be 4") (assert (< lsEmpty.tokenFootprint 200) "Base landscape token footprint must be <= 200") (refute lsMounted.baseOnly "Mounted landscape base-only flag must be false") (assert (= lsMounted.totalCount 5) "Mounted landscape tool count must be 5") true)

fn testAdjacencyGraphDsl -> Bool
  (let [(g1 (dt/formatGraph "CallerA" (list "TargetB:call" "TargetC:call"))) (g2 (dt/formatGraph "Leaf" (list)))] (assert (= g1 "(:graph (CallerA > TargetB:call TargetC:call))") "Adjacency DSL must match expected format") (assert (stringContains? g1 ">") "Adjacency DSL must contain transition symbol >") (assert (stringContains? g1 "CallerA") "Adjacency DSL must contain source node") (assert (= g2 "(:graph (Leaf))") "Empty edge graph must format without transition symbol") true)

fn testDenseToolRendering -> Bool
  (let [(r1 (dt/renderDenseTool "mem.query" "query [scope] [limit]" "vector semantic search AST")) (r2 (dt/renderDenseTool "mem.flush" "" "persist staged edits disk"))] (assert (= r1 "(:tool :name \"mem.query\" :sig \"query [scope] [limit]\" :d \"vector semantic search AST\")") "Dense tool query matches format") (assert (= r2 "(:tool :name \"mem.flush\" :sig \"\" :d \"persist staged edits disk\")") "Dense tool flush matches format") (assert (stringContains? r1 ":name \"mem.query\"") "Query name present") (assert (stringContains? r1 ":sig \"query [scope] [limit]\"") "Query sig present") (assert (stringContains? r1 ":d \"vector semantic search AST\"") "Query doc present") (refute (stringContains? r1 ":schema") "Dense tool must not contain verbose schema") (refute (stringContains? r2 "old-schema") "Dense tool must not contain old schema") true)

fn testDenseKeywordDensityValidation -> Bool
  (let [(d1 "vector semantic search AST") (d2 "stage atomic string replacement") (d3 "inspect staged RAM diffs") (d4 "persist staged edits disk") (d5 "clear staged RAM buffers") (d6 "append durable memory ledger") (d7 "read section without disk") (d8 "render holistic hierarchy telemetry") (tooShort1 "search") (tooShort0 "") (tooLong1 "one two three four five six") (tooLong2 "this is a very long descriptive docstring exceeding maximum words")] (assert (= (dt/countWords d1) 4) "d1 word count is 4") (assert (= (dt/countWords d2) 4) "d2 word count is 4") (assert (= (dt/countWords d3) 4) "d3 word count is 4") (assert (= (dt/countWords d4) 4) "d4 word count is 4") (assert (= (dt/countWords d5) 4) "d5 word count is 4") (assert (= (dt/countWords d6) 4) "d6 word count is 4") (assert (= (dt/countWords d7) 4) "d7 word count is 4") (assert (= (dt/countWords d8) 4) "d8 word count is 4") (assert (dt/validDenseDoc? d1) "d1 is valid dense doc") (assert (dt/validDenseDoc? d2) "d2 is valid dense doc") (assert (dt/validDenseDoc? d3) "d3 is valid dense doc") (assert (dt/validDenseDoc? d4) "d4 is valid dense doc") (assert (dt/validDenseDoc? d5) "d5 is valid dense doc") (assert (dt/validDenseDoc? d6) "d6 is valid dense doc") (assert (dt/validDenseDoc? d7) "d7 is valid dense doc") (assert (dt/validDenseDoc? d8) "d8 is valid dense doc") (refute (dt/validDenseDoc? tooShort1) "Single word doc must be refuted") (refute (dt/validDenseDoc? tooShort0) "Empty doc must be refuted") (refute (dt/validDenseDoc? tooLong1) "6-word doc must be refuted") (refute (dt/validDenseDoc? tooLong2) "Long doc must be refuted") true)

fn testDenseLandscapeCompilation -> Bool
  (let [(t1 (dt/renderDenseTool "mem.query" "query [scope] [limit]" "vector semantic search AST")) (t2 (dt/renderDenseTool "mem.edit" "file old new" "stage atomic string replacement")) (t3 (dt/renderDenseTool "mem.diff" "[file]" "inspect staged RAM diffs")) (t4 (dt/renderDenseTool "mem.flush" "" "persist staged edits disk")) (t5 (dt/renderDenseTool "mem.discard" "" "clear staged RAM buffers")) (t6 (dt/renderDenseTool "mem.write" "kind payload" "append durable memory ledger")) (t7 (dt/renderDenseTool "mem.doc" "file section" "read section without disk")) (t8 (dt/renderDenseTool "mem.tree" "[path]" "render holistic hierarchy telemetry")) (allDense (list t1 t2 t3 t4 t5 t6 t7 t8)) (plane (dt/emptyPlane)) (rendered (dt/renderDenseLandscape plane allDense)) (tokens (txt/estimateTokens rendered)) (emptyPlaneNoMeta (dt/ToolPlane :baseMeta (list) :activeDomains (list) :mountedTools (mapEmpty) :turnCounter 0)) (renderedOnlyDense (dt/renderDenseLandscape emptyPlaneNoMeta allDense)) (tokensOnlyDense (txt/estimateTokens renderedOnlyDense))] (assert (stringStartsWith? rendered "(:tools [") "Dense landscape starts with :tools [") (assert (stringEndsWith? rendered "])") "Dense landscape ends with ])") (assert (stringContains? rendered ":meta-tool :name \"eval\"") "Base meta eval included") (assert (stringContains? rendered ":meta-tool :name \"batch\"") "Base meta batch included") (assert (stringContains? rendered ":name \"mem.query\"") "mem.query included") (assert (stringContains? rendered ":name \"mem.edit\"") "mem.edit included") (assert (stringContains? rendered ":name \"mem.diff\"") "mem.diff included") (assert (stringContains? rendered ":name \"mem.flush\"") "mem.flush included") (assert (stringContains? rendered ":name \"mem.discard\"") "mem.discard included") (assert (stringContains? rendered ":name \"mem.write\"") "mem.write included") (assert (stringContains? rendered ":name \"mem.doc\"") "mem.doc included") (assert (stringContains? rendered ":name \"mem.tree\"") "mem.tree included") (assert (< tokens 300) "Full dense landscape token estimate must be < 300") (assert (< tokensOnlyDense 200) "Pure dense tools token estimate must be < 200") (refute (stringContains? renderedOnlyDense ":meta-tool") "Pure dense tools must not have meta tools") (refute (stringContains? rendered "unknown-tool") "Rendered landscape must not have unknown tools") true)

fn testLookupToolHelp -> Bool
  (let [(hQuery (dt/lookupToolHelp "mem.query")) (hQueryShort (dt/lookupToolHelp "query")) (hEdit (dt/lookupToolHelp "mem.edit")) (hReplace (dt/lookupToolHelp "replace")) (hDiff (dt/lookupToolHelp "mem.diff")) (hFlush (dt/lookupToolHelp "mem.flush")) (hDiscard (dt/lookupToolHelp "mem.discard")) (hWrite (dt/lookupToolHelp "mem.write")) (hDoc (dt/lookupToolHelp "mem.doc")) (hTree (dt/lookupToolHelp "mem.tree")) (hDomain (dt/lookupToolHelp "mem")) (hEval (dt/lookupToolHelp "eval")) (hUnknown (dt/lookupToolHelp "nonexistent"))] (assert (some? hQuery) "mem.query help found") (assert (some? hQueryShort) "query alias help found") (assert (stringContains? (optionOr hQuery "") ":tool \"mem.query\"") "Query help contains tool name") (assert (stringContains? (optionOr hQuery "") ":status :help") "Query help contains status help") (assert (some? hEdit) "mem.edit help found") (assert (some? hReplace) "replace alias help found") (assert (stringContains? (optionOr hEdit "") ":alias [\"replace\"]") "Edit help contains alias") (assert (some? hDiff) "mem.diff help found") (assert (some? hFlush) "mem.flush help found") (assert (some? hDiscard) "mem.discard help found") (assert (stringContains? (optionOr hDiscard "") "Non-destructive on help") "Discard contains non-destructive guard") (assert (some? hWrite) "mem.write help found") (assert (some? hDoc) "mem.doc help found") (assert (some? hTree) "mem.tree help found") (assert (some? hDomain) "mem domain help found") (assert (stringContains? (optionOr hDomain "") ":domain \"mem\"") "Domain help contains domain mem") (assert (some? hEval) "eval help found") (assert (none? hUnknown) "Unknown tool returns none") (refute (some? hUnknown) "Unknown tool must refute is-some") true)

fn runTests -> Bool
  (and (testEmptyPlaneAndBaseTools) (and (testDomainLoadingAndLookup) (and (testDomainUnloadingAndReceipts) (and (testTurnResetAndTokenLandscape) (and (testAdjacencyGraphDsl) (and (testDenseToolRendering) (and (testDenseKeywordDensityValidation) (and (testDenseLandscapeCompilation) (testLookupToolHelp)))))))))
