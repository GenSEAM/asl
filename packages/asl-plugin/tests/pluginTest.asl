(module asl-plugin/tests/pluginTest :x [runTests] :i [(asl-plugin/plugin :a pl) (asl-plugin/security :a sec) (asl-plugin/types :a t)])

fn ensureTestFixtures! dir: Str -> Bool
  (let [(cmd (str "mkdir -p " dir " && printf 'sqlite-wasm-payload' > " dir "/sqlite.wasm && printf 'main-wasm-payload' > " dir "/main.wasm && printf 'sh-bin-payload' > " dir "/sh.bin")) (res (processRun cmd))] (= res.exitCode 0))

fn testRegistryAndLookup! -> Bool
  (let [(dir "tmp/sandbox_plugin_test_reg")] (do (ensureTestFixtures! dir) (let [(reg (pl/emptyRegistry)) (hash1 "21d9fc8331ad4a1c506ad427cb9e64fcad1efb189d621a8bdbcc226be959673e") (cap (t/PluginCapability :name "cap-db" :version "1.0.0" :doc "SQL database access")) (exp (t/PluginExport :symbolName "query" :signature "(query Str (List Str)) -> (Result Str Str)" :doc "SQL query" :requiredCapability "cap-db")) (manifest (t/PluginManifest :id "plugin-sqlite" :name "SQLite Embedded Driver" :version "0.1.0" :kind (t/kindWasm) :capabilities (list cap) :exports (list exp) :entrypoint "sqlite.wasm" :integritySha256 hash1)) (updatedRegRes (pl/registerPlugin reg manifest dir))] (assert (ok? updatedRegRes) "register plugin ok") (mt updatedRegRes ((ok updatedReg) (let [(found (pl/lookupManifest updatedReg "plugin-sqlite")) (inst (pl/lookupInstance updatedReg "plugin-sqlite")) (hasCap (pl/hasCapability? manifest "cap-db"))] (assert (some? found) "plugin found") (assert (some? inst) "instance found") (assert hasCap "has capability") true)) ((err _) false)))))

fn testValidateManifest! -> Bool
  (let [(dir "tmp/sandbox_plugin_test_val")] (do (ensureTestFixtures! dir) (let [(hash2 "d44bce49ea9c053b17999a06853aabfdf591c61724425fcac597a776dc982767") (cap (t/PluginCapability :name "cap-db" :version "1.0.0" :doc "SQL database access")) (exp (t/PluginExport :symbolName "query" :signature "(query Str (List Str)) -> (Result Str Str)" :doc "SQL query" :requiredCapability "cap-db")) (valid (t/PluginManifest :id "p1" :name "Plugin One" :version "1.0.0" :kind (t/kindWasm) :capabilities (list cap) :exports (list exp) :entrypoint "main.wasm" :integritySha256 hash2)) (invalid (t/PluginManifest :id "" :name "Invalid" :version "1.0.0" :kind (t/kindWasm) :capabilities (list) :exports (list) :entrypoint "main.wasm" :integritySha256 "mock-hash"))] (assert (ok? (sec/validateManifestSecurity! valid dir)) "valid manifest ok") (assert (err? (sec/validateManifestSecurity! invalid dir)) "invalid manifest err") true)))

fn testDispatchCall! -> Bool
  (let [(dir "tmp/sandbox_plugin_test_disp")] (do (ensureTestFixtures! dir) (let [(reg (pl/emptyRegistry)) (hash3 "1af2c6494b4a15fab5654e5f7ddae87166239460c270545386f132010e89db9a") (cap (t/PluginCapability :name "cap-sh" :version "0.1.0" :doc "Shell Driver")) (exp (t/PluginExport :symbolName "exec" :signature "() -> Unit" :doc "Shell execution" :requiredCapability "cap-sh")) (m (t/PluginManifest :id "p-sh" :name "Shell Driver" :version "0.1.0" :kind (t/kindHostDriver) :capabilities (list cap) :exports (list exp) :entrypoint "sh.bin" :integritySha256 hash3)) (reg2Res (pl/registerPlugin reg m dir))] (assert (ok? reg2Res) "reg2 ok") (mt reg2Res ((ok reg2) (let [(secret "test-key") (sigOk (sec/computeCallerSignature! "user-1" (list "cap-sh") "100" secret)) (sigBad (sec/computeCallerSignature! "user-2" (list) "100" secret)) (authOk (t/CallerAuth :identity "user-1" :grantedCapabilities (list "cap-sh") :nonce "100" :signature sigOk)) (authBad (t/CallerAuth :identity "user-2" :grantedCapabilities (list) :nonce "100" :signature sigBad)) (buf (t/PluginBuffer :ptr 0 :size 0)) (resOk (pl/dispatchCall reg2 (t/PluginCall :pluginId "p-sh" :symbolName "exec" :auth authOk :buffer buf) secret)) (resMissingSym (pl/dispatchCall reg2 (t/PluginCall :pluginId "p-sh" :symbolName "non-existent" :auth authOk :buffer buf) secret)) (resMissingPlugin (pl/dispatchCall reg2 (t/PluginCall :pluginId "unknown" :symbolName "exec" :auth authOk :buffer buf) secret)) (resAuthFail (pl/dispatchCall reg2 (t/PluginCall :pluginId "p-sh" :symbolName "exec" :auth authBad :buffer buf) secret))] (assert (ok? resOk) "res-ok success") (refute (ok? resMissingSym) "missing-sym fails") (refute (ok? resMissingPlugin) "missing-plugin fails") (refute (ok? resAuthFail) "auth-fail fails") (mt resOk ((ok receipt) (do (assert (= receipt.invocationCount 1) "receipt count is 1") true)) ((err _) false)))) ((err _) false)))))

fn ! runTests -> Bool
  (let [(r1 (testRegistryAndLookup!)) (r2 (testValidateManifest!)) (r3 (testDispatchCall!))] (and r1 (and r2 r3)))
