(module asl-plugin/tests/targetRegistryAcceptanceTest :x [runTests testDynamicTargetRegistration! testDispatchTargetCodegen testUnregisteredTargetStructuredError testTargetRegistryD77Refutations] :i [(targetRegistry :a tr) (asl-parser/ast :a a)])

fn testDynamicTargetRegistration! -> Bool
  (let [(cManRes (fileReadString "asl/packages/asl-compiler/manifest.asn")) (gManRes (fileReadString "asl/packages/asl-codegen/manifest.asn")) (cMan (match cManRes ((ok s) s) ((err _) ""))) (gMan (match gManRes ((ok s) s) ((err _) "")))] (assert (> (stringLength cMan) 0) "asl-compiler manifest exists") (assert (> (stringLength gMan) 0) "asl-codegen manifest exists") (assert (not (stringContains? cMan "asl-plugin")) "asl-compiler manifest does not import asl-plugin") (refute (stringContains? cMan "asl-plugin") "asl-compiler manifest refutes asl-plugin under D77") (assert (not (stringContains? gMan "asl-plugin")) "asl-codegen manifest does not import asl-plugin") (refute (stringContains? gMan "asl-plugin") "asl-codegen manifest refutes asl-plugin under D77") (let [(reg0 (tr/emptyTargetRegistry)) (targets0 (tr/listRegisteredTargets reg0))] (assert (= (listLength targets0) 0) "Initial registry has 0 registered targets") (refute (> (listLength targets0) 0) "Initial registry refutes positive target count under D77") (let [(mockWat (fn [(forms (List a/TopForm)) (opts (Map Str Str))] -> (Result Str Str) (ok "(module (func $main (nop)))"))) (mockRust (fn [(forms (List a/TopForm)) (opts (Map Str Str))] -> (Result Str Str) (ok "fn main() {}"))) (mockGo (fn [(forms (List a/TopForm)) (opts (Map Str Str))] -> (Result Str Str) (ok "package main\nfunc main() {}"))) (reg1 (tr/registerTarget reg0 "wat" "WebAssembly Text format backend" mockWat)) (reg2 (tr/registerTarget reg1 "rust" "Safe Rust backend" mockRust)) (reg3 (tr/registerTarget reg2 "go" "Go backend" mockGo)) (targets3 (tr/listRegisteredTargets reg3))] (assert (tr/hasTarget? reg3 "wat") "reg3 has registered wat target") (refute (not (tr/hasTarget? reg3 "wat")) "reg3 refutes absence of wat target") (assert (tr/hasTarget? reg3 "rust") "reg3 has registered rust target") (refute (not (tr/hasTarget? reg3 "rust")) "reg3 refutes absence of rust target") (assert (tr/hasTarget? reg3 "go") "reg3 has registered go target") (refute (not (tr/hasTarget? reg3 "go")) "reg3 refutes absence of go target") (assert (not (tr/hasTarget? reg3 "wasm-legacy")) "reg3 does not have unregistered target") (refute (tr/hasTarget? reg3 "wasm-legacy") "reg3 refutes unregistered target presence") (assert (= (listLength targets3) 3) "reg3 has exactly 3 registered targets") (refute (not (= (listLength targets3) 3)) "reg3 refutes target count not equal to 3") (assert (listContains? targets3 "wat") "targets list contains wat") (assert (listContains? targets3 "rust") "targets list contains rust") (assert (listContains? targets3 "go") "targets list contains go") (refute (listContains? targets3 "c99") "targets list refutes c99 prior to registration") (assert (some? (tr/lookupTarget reg3 "wat")) "lookupTarget wat returns some") (refute (none? (tr/lookupTarget reg3 "wat")) "lookupTarget wat refutes none") (assert (none? (tr/lookupTarget reg3 "c99")) "lookupTarget c99 returns none") (refute (some? (tr/lookupTarget reg3 "c99")) "lookupTarget c99 refutes some") (let [(docWat (optionOr (mapGet reg3.docstrings "wat") ""))] (assert (stringContains? docWat "WebAssembly") "docstrings contains expected wat description") (refute (stringEmpty? docWat) "wat docstring refutes empty string under D77")) true)))

fn testDispatchTargetCodegen -> Bool
  (let [(src "(df add [(x I32) (y I32)] -> I32 (+ x y))") (parseRes (a/parse src))] (assert (ok? parseRes) "Source parsing succeeds") (refute (err? parseRes) "Source parsing refutes error under D77") (match parseRes ((err _) false) ((ok forms) (let [(mockWatEmitter (fn [(fList (List a/TopForm)) (opts (Map Str Str))] -> (Result Str Str) (let [(optLevel (optionOr (mapGet opts "opt") "0"))] (ok (str "(module (func $add (param $x i32) (param $y i32) (result i32) (i32.add (local.get $x) (local.get $y))))\n(opt " optLevel ")"))))) (mockRustEmitter (fn [(fList (List a/TopForm)) (opts (Map Str Str))] -> (Result Str Str) (ok "pub fn add(x: i32, y: i32) -> i32 { x + y }"))) (reg (tr/emptyTargetRegistry)) (reg1 (tr/registerTarget reg "wat" "WebAssembly text emitter" mockWatEmitter)) (reg2 (tr/registerTarget reg1 "rust" "Rust target emitter" mockRustEmitter)) (optsWat (mapSet (mapEmpty) "opt" "2")) (resWat (tr/dispatchTargetCodegen reg2 "wat" forms optsWat)) (resRust (tr/dispatchTargetCodegen reg2 "rust" forms (mapEmpty)))] (assert (ok? resWat) "WAT code emission dispatch succeeds") (refute (err? resWat) "WAT code emission dispatch refutes error") (assert (ok? resRust) "Rust code emission dispatch succeeds") (refute (err? resRust) "Rust code emission dispatch refutes error") (match resWat ((err _) false) ((ok codeWat) (do (assert (stringContains? codeWat "func $add") "Emitted WAT contains func $add") (refute (stringEmpty? codeWat) "Emitted WAT code refutes empty string") (assert (stringContains? codeWat "(opt 2)") "Emitted WAT contains propagated option") true))) (match resRust ((err _) false) ((ok codeRust) (do (assert (stringContains? codeRust "pub fn add") "Emitted Rust contains pub fn add") (refute (stringEmpty? codeRust) "Emitted Rust code refutes empty string") true))) true))))

fn testUnregisteredTargetStructuredError -> Bool
  (let [(reg (tr/emptyTargetRegistry)) (resWat (tr/dispatchTargetCodegen reg "wat" (list) (mapEmpty))) (resRust (tr/dispatchTargetCodegen reg "rust" (list) (mapEmpty))) (resUnknown (tr/dispatchTargetCodegen reg "nonexistent-target" (list) (mapEmpty)))] (assert (err? resWat) "Dispatch to unregistered wat yields error") (refute (ok? resWat) "Dispatch to unregistered wat refutes ok") (assert (err? resRust) "Dispatch to unregistered rust yields error") (refute (ok? resRust) "Dispatch to unregistered rust refutes ok") (assert (err? resUnknown) "Dispatch to unregistered nonexistent-target yields error") (refute (ok? resUnknown) "Dispatch to unregistered nonexistent-target refutes ok") (match resWat ((ok _) false) ((err msgWat) (do (assert (= msgWat "unsupported-target: wat") "wat error message matches expected specification") (refute (stringEmpty? msgWat) "wat error message refutes empty string under D77") (assert (stringStartsWith? msgWat "unsupported-target: ") "wat error message has structured prefix") true))) (match resRust ((ok _) false) ((err msgRust) (do (assert (= msgRust "unsupported-target: rust") "rust error message matches expected specification") (refute (stringEmpty? msgRust) "rust error message refutes empty string under D77") true))) (match resUnknown ((ok _) false) ((err msgUnknown) (do (assert (= msgUnknown "unsupported-target: nonexistent-target") "unknown error message matches expected format") (refute (stringEmpty? msgUnknown) "unknown error message refutes empty string under D77") true))))

fn testTargetRegistryD77Refutations -> Bool
  (let [(reg0 (tr/emptyTargetRegistry)) (mockV1 (fn [(forms (List a/TopForm)) (opts (Map Str Str))] -> (Result Str Str) (ok "output-v1"))) (mockV2 (fn [(forms (List a/TopForm)) (opts (Map Str Str))] -> (Result Str Str) (ok "output-v2"))) (regV1 (tr/registerTarget reg0 "wat" "WAT backend v1" mockV1))] (refute (tr/hasTarget? reg0 "wat") "Empty registry refutes presence of wat target under D77") (refute (some? (tr/lookupTarget reg0 "wat")) "Empty registry refutes lookup some under D77") (refute (listContains? (tr/listRegisteredTargets reg0) "wat") "Empty registry refutes wat in target list") (let [(resUnreg (tr/dispatchTargetCodegen reg0 "wat" (list) (mapEmpty)))] (refute (ok? resUnreg) "Dispatch on empty registry refutes ok under D77") (match resUnreg ((ok _) false) ((err errMsg) (do (refute (not (= errMsg "unsupported-target: wat")) "Refutes mismatched error message on unregistered wat") (refute (= errMsg "") "Refutes empty error string") true)))) (let [(regConflict (tr/registerTarget regV1 "wat" "WAT backend v2 updated" mockV2)) (targetsConflict (tr/listRegisteredTargets regConflict)) (resDispatch (tr/dispatchTargetCodegen regConflict "wat" (list) (mapEmpty)))] (assert (= (listLength targetsConflict) 1) "Target count remains 1 after overwriting duplicate registration") (refute (> (listLength targetsConflict) 1) "Target count refutes duplicate entry under D77") (refute (not (= (listLength targetsConflict) 1)) "Target count refutes anything other than 1") (assert (ok? resDispatch) "Dispatch to updated target succeeds") (refute (err? resDispatch) "Dispatch to updated target refutes error") (match resDispatch ((err _) false) ((ok output) (do (assert (= output "output-v2") "Output matches updated emitter implementation") (refute (= output "output-v1") "Output refutes superseded emitter implementation under D77") (refute (stringEmpty? output) "Output refutes empty string") true))) (let [(docUpdated (optionOr (mapGet regConflict.docstrings "wat") ""))] (assert (stringContains? docUpdated "v2 updated") "Docstring updated to v2 description") (refute (stringContains? docUpdated "backend v1") "Docstring refutes superseded v1 description under D77")) true))

fn ! runTests -> Bool
  (do (assert (testDynamicTargetRegistration!) "testDynamicTargetRegistration must pass") (assert (testDispatchTargetCodegen) "testDispatchTargetCodegen must pass") (assert (testUnregisteredTargetStructuredError) "testUnregisteredTargetStructuredError must pass") (assert (testTargetRegistryD77Refutations) "testTargetRegistryD77Refutations must pass") true)
