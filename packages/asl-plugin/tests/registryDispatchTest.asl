(module asl/packages/asl-plugin/tests/registryDispatchTest :x [testEmptyRegistryAndSeal testSSOTInstanceDecoupling testRegisterPluginWithJail! testDispatchCallSuccess! testReplayNonceRejectionAndFaultPreservation! testSymbolNotFoundFaultPreservation! testMissingPluginFaultPreservation testUnauthorizedCapabilityFaultPreservation! testDualPolarityRefutations runTests] :i [(asl-plugin/types :a t) (asl-plugin/plugin :a pl) (asl-plugin/security :a sec)])

fn ensureFixtures! -> Bool
  (let [(cmd "mkdir -p tmp/sandbox_51305 && printf 'valid-wasm-bytes' > tmp/sandbox_51305/plugin.wasm") (res (processRun cmd))] (= res.exitCode 0))

fn testEmptyRegistryAndSeal -> Bool
  (let [(reg (pl/emptyRegistry))] (assert (= reg.sealed false) "Empty registry must not be sealed") (assert (= (mapSize reg.manifests) 0) "Empty registry manifests must be empty") (assert (= (mapSize reg.instances) 0) "Empty registry instances must be empty") (assert (= (mapSize reg.capabilityIndex) 0) "Empty registry capability index must be empty") (assert (= (mapSize reg.callerNonces) 0) "Empty registry caller nonces must be empty") (let [(sealedReg (pl/sealRegistry reg))] (assert (= sealedReg.sealed true) "Sealed registry must have sealed true") (assert (= (mapSize sealedReg.manifests) 0) "Sealed registry manifests preserved") true))

fn testSSOTInstanceDecoupling -> Bool
  (let [(inst (t/PluginInstance :pluginId "p-decoupled" :memoryHandle 4096 :invocationCount 5))] (assert (= inst.pluginId "p-decoupled") "Instance holds only pluginId SSOT reference") (assert (= inst.memoryHandle 4096) "Instance holds memory handle") (assert (= inst.invocationCount 5) "Instance holds invocation count") true)

fn testRegisterPluginWithJail! -> Bool
  (do (ensureFixtures!) (let [(reg (pl/emptyRegistry)) (cap (t/PluginCapability :name "cap-compute" :version "1.0.0" :doc "Compute cap")) (exp (t/PluginExport :symbolName "exec" :signature "() -> Unit" :doc "Exec" :requiredCapability "cap-compute")) (manifest (t/PluginManifest :id "test-calc" :name "Calculator" :version "1.0.0" :kind (t/kindWasm) :capabilities (list cap) :exports (list exp) :entrypoint "plugin.wasm" :integritySha256 "5c6729ce3324b9e1ee1fc187216e757c3d0a86ea142812827235221e455f58aa")) (regRes (pl/registerPlugin reg manifest "tmp/sandbox_51305"))] (assert (ok? regRes) "registerPlugin must succeed with valid sandboxed file") (mt regRes ((ok reg1) (let [(mOpt (pl/lookupManifest reg1 "test-calc")) (iOpt (pl/lookupInstance reg1 "test-calc"))] (assert (some? mOpt) "Manifest must be found in registry") (assert (some? iOpt) "Instance must be found in registry") (mt iOpt ((some inst) (do (assert (= inst.pluginId "test-calc") "Initial instance pluginId matches") (assert (= inst.invocationCount 0) "Initial instance invocationCount is zero") (assert (= inst.memoryHandle 0) "Initial instance memoryHandle is zero") true)) ((none) false)))) ((err _) false))))

fn testDispatchCallSuccess! -> Bool
  (do (ensureFixtures!) (let [(reg (pl/emptyRegistry)) (cap (t/PluginCapability :name "cap-compute" :version "1.0.0" :doc "Compute cap")) (exp (t/PluginExport :symbolName "exec" :signature "() -> Unit" :doc "Exec" :requiredCapability "cap-compute")) (manifest (t/PluginManifest :id "test-calc" :name "Calculator" :version "1.0.0" :kind (t/kindWasm) :capabilities (list cap) :exports (list exp) :entrypoint "plugin.wasm" :integritySha256 "5c6729ce3324b9e1ee1fc187216e757c3d0a86ea142812827235221e455f58aa")) (regRes (pl/registerPlugin reg manifest "tmp/sandbox_51305"))] (mt regRes ((ok reg1) (let [(secret "test-secret") (caps (list "cap-compute")) (sig (sec/computeCallerSignature! "caller-alice" caps "100" secret)) (auth (t/CallerAuth :identity "caller-alice" :grantedCapabilities caps :nonce "100" :signature sig)) (call (t/PluginCall :pluginId "test-calc" :symbolName "exec" :auth auth :buffer (t/PluginBuffer :ptr 0 :size 0))) (dispRes (pl/dispatchCall reg1 call secret))] (assert (ok? dispRes) "dispatchCall must return ok DispatchReceipt") (mt dispRes ((ok receipt) (do (assert (= receipt.invocationCount 1) "Receipt invocation count must be 1") (let [(updatedReg receipt.registry) (instOpt (pl/lookupInstance updatedReg "test-calc"))] (assert (some? instOpt) "Updated instance must exist in receipt registry") (mt instOpt ((some inst) (do (assert (= inst.invocationCount 1) "Registry instance invocation count updated to 1") (assert (= (optionOr (mapGet updatedReg.callerNonces "caller-alice") 0) 100) "Registry caller nonce recorded") true)) ((none) false))))) ((err _) false)))) ((err _) false))))

fn testReplayNonceRejectionAndFaultPreservation! -> Bool
  (do (ensureFixtures!) (let [(reg (pl/emptyRegistry)) (cap (t/PluginCapability :name "cap-compute" :version "1.0.0" :doc "Compute cap")) (exp (t/PluginExport :symbolName "exec" :signature "() -> Unit" :doc "Exec" :requiredCapability "cap-compute")) (manifest (t/PluginManifest :id "test-calc" :name "Calculator" :version "1.0.0" :kind (t/kindWasm) :capabilities (list cap) :exports (list exp) :entrypoint "plugin.wasm" :integritySha256 "5c6729ce3324b9e1ee1fc187216e757c3d0a86ea142812827235221e455f58aa")) (regRes (pl/registerPlugin reg manifest "tmp/sandbox_51305"))] (mt regRes ((ok reg1) (let [(secret "test-secret") (caps (list "cap-compute")) (sig1 (sec/computeCallerSignature! "caller-alice" caps "200" secret)) (auth1 (t/CallerAuth :identity "caller-alice" :grantedCapabilities caps :nonce "200" :signature sig1)) (call1 (t/PluginCall :pluginId "test-calc" :symbolName "exec" :auth auth1 :buffer (t/PluginBuffer :ptr 0 :size 0))) (dispRes1 (pl/dispatchCall reg1 call1 secret))] (mt dispRes1 ((ok receipt1) (let [(regAfterCall1 receipt1.registry) (callReplay (t/PluginCall :pluginId "test-calc" :symbolName "exec" :auth auth1 :buffer (t/PluginBuffer :ptr 0 :size 0))) (dispResReplay (pl/dispatchCall regAfterCall1 callReplay secret))] (assert (err? dispResReplay) "Replay with same nonce must fail") (mt dispResReplay ((err fault) (do (let [(isUnauthorized (mt fault.error ((t/errUnauthorized msg) (stringContains? msg "nonce")) ((t/errNotFound _) false) ((t/errDuplicateId _) false) ((t/errInvalidSignature _) false) ((t/errSandboxEscape _) false) ((t/errExecutionTrap _) false) ((t/errTimeout _) false) ((t/errUnimplemented _) false) ((t/errRegistrySealed) false)))] (assert isUnauthorized "Fault error must be errUnauthorized for nonce replay")) (let [(preservedReg fault.registry) (instOpt (pl/lookupInstance preservedReg "test-calc"))] (assert (some? instOpt) "Fault registry must preserve test-calc instance") (mt instOpt ((some inst) (do (assert (= inst.invocationCount 1) "Fault registry preserves prior invocation count") true)) ((none) false))))) ((ok _) false)))) ((err _) false)))) ((err _) false))))

fn testSymbolNotFoundFaultPreservation! -> Bool
  (do (ensureFixtures!) (let [(reg (pl/emptyRegistry)) (cap (t/PluginCapability :name "cap-compute" :version "1.0.0" :doc "Compute cap")) (exp (t/PluginExport :symbolName "exec" :signature "() -> Unit" :doc "Exec" :requiredCapability "cap-compute")) (manifest (t/PluginManifest :id "test-calc" :name "Calc" :version "1.0.0" :kind (t/kindWasm) :capabilities (list cap) :exports (list exp) :entrypoint "plugin.wasm" :integritySha256 "5c6729ce3324b9e1ee1fc187216e757c3d0a86ea142812827235221e455f58aa")) (regRes (pl/registerPlugin reg manifest "tmp/sandbox_51305"))] (mt regRes ((ok reg1) (let [(secret "secret") (caps (list "cap-compute")) (sig (sec/computeCallerSignature! "caller-bob" caps "50" secret)) (auth (t/CallerAuth :identity "caller-bob" :grantedCapabilities caps :nonce "50" :signature sig)) (call (t/PluginCall :pluginId "test-calc" :symbolName "unknownSymbol" :auth auth :buffer (t/PluginBuffer :ptr 0 :size 0))) (dispRes (pl/dispatchCall reg1 call secret))] (assert (err? dispRes) "Nonexistent symbol dispatch must fail") (mt dispRes ((err fault) (do (assert (some? (pl/lookupManifest fault.registry "test-calc")) "Fault preserves manifest") true)) ((ok _) false)))) ((err _) false))))

fn ! testMissingPluginFaultPreservation -> Bool
  (let [(reg (pl/emptyRegistry)) (auth (t/CallerAuth :identity "caller-carol" :grantedCapabilities (list "cap-compute") :nonce "10" :signature "sig")) (call (t/PluginCall :pluginId "missing-plugin" :symbolName "exec" :auth auth :buffer (t/PluginBuffer :ptr 0 :size 0))) (dispRes (pl/dispatchCall reg call "secret"))] (assert (err? dispRes) "Missing plugin dispatch must fail") (mt dispRes ((err fault) (do (let [(isNotFound (mt fault.error ((t/errNotFound id) (= id "missing-plugin")) ((t/errUnauthorized _) false) ((t/errDuplicateId _) false) ((t/errInvalidSignature _) false) ((t/errSandboxEscape _) false) ((t/errExecutionTrap _) false) ((t/errTimeout _) false) ((t/errUnimplemented _) false) ((t/errRegistrySealed) false)))] (assert isNotFound "Fault error must be errNotFound for missing plugin")) (assert (= fault.registry.sealed false) "Preserved registry sealed state intact") true)) ((ok _) false)))

fn testUnauthorizedCapabilityFaultPreservation! -> Bool
  (do (ensureFixtures!) (let [(reg (pl/emptyRegistry)) (cap (t/PluginCapability :name "cap-admin" :version "1.0.0" :doc "Admin cap")) (exp (t/PluginExport :symbolName "adminExec" :signature "() -> Unit" :doc "Admin" :requiredCapability "cap-admin")) (manifest (t/PluginManifest :id "test-admin" :name "Admin" :version "1.0.0" :kind (t/kindWasm) :capabilities (list cap) :exports (list exp) :entrypoint "plugin.wasm" :integritySha256 "5c6729ce3324b9e1ee1fc187216e757c3d0a86ea142812827235221e455f58aa")) (regRes (pl/registerPlugin reg manifest "tmp/sandbox_51305"))] (mt regRes ((ok reg1) (let [(secret "secret") (caps (list "cap-other")) (sig (sec/computeCallerSignature! "caller-unauth" caps "300" secret)) (authLacking (t/CallerAuth :identity "caller-unauth" :grantedCapabilities caps :nonce "300" :signature sig)) (call (t/PluginCall :pluginId "test-admin" :symbolName "adminExec" :auth authLacking :buffer (t/PluginBuffer :ptr 0 :size 0))) (dispRes (pl/dispatchCall reg1 call secret))] (assert (err? dispRes) "Unauthorized caller must fail dispatch") (mt dispRes ((err fault) (do (let [(isUnauth (mt fault.error ((t/errUnauthorized _) true) ((t/errNotFound _) false) ((t/errDuplicateId _) false) ((t/errInvalidSignature _) false) ((t/errSandboxEscape _) false) ((t/errExecutionTrap _) false) ((t/errTimeout _) false) ((t/errUnimplemented _) false) ((t/errRegistrySealed) false)))] (assert isUnauth "Fault error must be errUnauthorized")) (assert (some? (pl/lookupManifest fault.registry "test-admin")) "Registry preserved") true)) ((ok _) false)))) ((err _) false))))

fn ! testDualPolarityRefutations -> Bool
  (let [(reg (pl/emptyRegistry)) (sealedReg (pl/sealRegistry reg))] (refute reg.sealed "emptyRegistry must not be sealed") (refute (not sealedReg.sealed) "sealRegistry must result in sealed true") (refute (err? (ok (t/DispatchReceipt :registry reg :buffer (t/PluginBuffer :ptr 0 :size 0) :invocationCount 1))) "DispatchReceipt must wrap into ok") (refute (ok? (err (t/DispatchFault :registry reg :error (t/errNotFound "p")))) "DispatchFault must wrap into err") (refute (ok? (pl/registerPlugin sealedReg (t/PluginManifest :id "p" :name "P" :version "1" :kind (t/kindWasm) :capabilities (list) :exports (list) :entrypoint "p.wasm" :integritySha256 "sha") "tmp")) "Sealed registry cannot register plugins") true)

fn ! runTests -> Bool
  (do (assert (ensureFixtures!) "ensureFixtures must succeed") (assert (testEmptyRegistryAndSeal) "testEmptyRegistryAndSeal must pass") (assert (testSSOTInstanceDecoupling) "testSSOTInstanceDecoupling must pass") (assert (testRegisterPluginWithJail!) "testRegisterPluginWithJail must pass") (assert (testDispatchCallSuccess!) "testDispatchCallSuccess must pass") (assert (testReplayNonceRejectionAndFaultPreservation!) "testReplayNonceRejectionAndFaultPreservation must pass") (assert (testSymbolNotFoundFaultPreservation!) "testSymbolNotFoundFaultPreservation must pass") (assert (testMissingPluginFaultPreservation) "testMissingPluginFaultPreservation must pass") (assert (testUnauthorizedCapabilityFaultPreservation!) "testUnauthorizedCapabilityFaultPreservation must pass") (assert (testDualPolarityRefutations) "testDualPolarityRefutations must pass") true)
