(module asl/packages/asl-plugin/tests/pluginTypesTest :x [testCallerAuthInstantiation testPluginInstanceSSOT testDispatchReceiptAndFault testErrorVariants testDualPolarityRefutations runTests] :i [(asl-plugin/types :a t)])

fn testCallerAuthInstantiation -> Bool
  (let [(auth (t/CallerAuth :identity "subagent-1" :grantedCapabilities (list "cap-crypto" "cap-fs") :nonce "1789416398000" :signature "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"))] (assert (= auth.identity "subagent-1") "Caller identity matches") (assert (= (listLength auth.grantedCapabilities) 2) "Granted capabilities count matches") (assert (= auth.nonce "1789416398000") "Monotonic nonce matches") (assert (= auth.signature "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") "Signature matches") true)

fn testPluginInstanceSSOT -> Bool
  (let [(inst (t/PluginInstance :pluginId "plugin-crypto" :memoryHandle 9999 :invocationCount 12))] (assert (= inst.pluginId "plugin-crypto") "Plugin ID matches SSOT key") (assert (= inst.memoryHandle 9999) "Memory handle matches") (assert (= inst.invocationCount 12) "Invocation count matches") true)

fn testDispatchReceiptAndFault -> Bool
  (let [(reg (t/PluginRegistry :manifests (mapEmpty) :instances (mapEmpty) :capabilityIndex (mapEmpty) :callerNonces (mapEmpty) :sealed false)) (buf (t/PluginBuffer :ptr 1024 :size 256)) (receipt (t/DispatchReceipt :registry reg :buffer buf :invocationCount 42)) (fault (t/DispatchFault :registry reg :error (t/errUnauthorized "Capability cap-net denied")))] (assert (= receipt.invocationCount 42) "Receipt invocation count matches") (assert (= receipt.buffer.size 256) "Receipt buffer size matches") (assert (= receipt.registry.sealed false) "Receipt registry sealed state matches") (assert (= fault.registry.sealed false) "Fault registry preserved state matches") (let [(errName (mt fault.error ((t/errUnauthorized msg) msg) ((t/errNotFound _) "not-found") ((t/errDuplicateId _) "duplicate") ((t/errInvalidSignature _) "sig") ((t/errSandboxEscape _) "escape") ((t/errExecutionTrap _) "trap") ((t/errTimeout _) "timeout") ((t/errUnimplemented _) "unimpl") ((t/errRegistrySealed) "sealed")))] (assert (= errName "Capability cap-net denied") "Fault contains errUnauthorized variant")) true)

fn testErrorVariants -> Bool
  (let [(errObj (t/errUnauthorized "Access denied: missing token")) (matched (mt errObj ((t/errUnauthorized msg) msg) ((t/errNotFound _) "not-found") ((t/errDuplicateId _) "duplicate") ((t/errInvalidSignature _) "sig") ((t/errSandboxEscape _) "escape") ((t/errExecutionTrap _) "trap") ((t/errTimeout _) "timeout") ((t/errUnimplemented _) "unimpl") ((t/errRegistrySealed) "sealed")))] (assert (= matched "Access denied: missing token") "errUnauthorized matches cleanly") true)

fn testDualPolarityRefutations -> Bool
  (let [(auth (t/CallerAuth :identity "caller-0" :grantedCapabilities (list "cap-auth") :nonce "42" :signature "sig-token")) (reg (t/PluginRegistry :manifests (mapEmpty) :instances (mapEmpty) :capabilityIndex (mapEmpty) :callerNonces (mapEmpty) :sealed false)) (buf (t/PluginBuffer :ptr 0 :size 0)) (receipt (t/DispatchReceipt :registry reg :buffer buf :invocationCount 1)) (fault (t/DispatchFault :registry reg :error (t/errUnauthorized "forbidden")))] (refute (stringEmpty? auth.signature) "CallerAuth signature must not be empty") (refute (stringEmpty? auth.nonce) "CallerAuth nonce must not be empty") (refute (= receipt.invocationCount 0) "DispatchReceipt invocation count must not be zero") (refute fault.registry.sealed "DispatchFault registry must not be sealed by default") (refute (ok? (err fault.error)) "Fault error wrapped in Result must not be ok") true)

fn runTests -> Bool
  (do (assert (testCallerAuthInstantiation) "testCallerAuthInstantiation must pass") (assert (testPluginInstanceSSOT) "testPluginInstanceSSOT must pass") (assert (testDispatchReceiptAndFault) "testDispatchReceiptAndFault must pass") (assert (testErrorVariants) "testErrorVariants must pass") (assert (testDualPolarityRefutations) "testDualPolarityRefutations must pass") true)
