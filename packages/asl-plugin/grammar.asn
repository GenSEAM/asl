;; Package Grammar & Exported Symbol Registry (ASN)
;; asl-plugin
(:grammar
  :package asl-plugin
  :version "0.1.0"
  :tokens-baseline 1
  :symbols [
    ;; 1-Token Baseline Types
    (:sym :name "PluginCall" :kind :type :tokens 1)
    (:sym :name "PluginCapability" :kind :type :tokens 1)
    (:sym :name "PluginExport" :kind :type :tokens 1)
    (:sym :name "PluginKind" :kind :type :tokens 1)
    (:sym :name "PluginManifest" :kind :type :tokens 1)
    (:sym :name "PluginRegistry" :kind :type :tokens 1)
    (:sym :name "PluginResult" :kind :type :tokens 1)

    ;; <= 2-Token Primary API Symbols
    (:sym :name "dispatch-call" :kind :fn :tokens 2)
    (:sym :name "empty-registry" :kind :fn :tokens 2)
    (:sym :name "format-manifest" :kind :fn :tokens 2)
    (:sym :name "has-capability?" :kind :fn :tokens 2)
    (:sym :name "lookup-plugin" :kind :fn :tokens 2)
    (:sym :name "register-plugin" :kind :fn :tokens 2)
    (:sym :name "run-tests" :kind :fn :tokens 2)
    (:sym :name "validate-manifest" :kind :fn :tokens 2)

    ;; Dynamic Tool Plane Types
    (:sym :name "ActiveLandscape" :kind :type :tokens 1)
    (:sym :name "MountReceipt" :kind :type :tokens 1)
    (:sym :name "ToolDef" :kind :type :tokens 1)
    (:sym :name "ToolDomain" :kind :type :tokens 1)
    (:sym :name "ToolParam" :kind :type :tokens 1)
    (:sym :name "ToolPlane" :kind :type :tokens 1)
    (:sym :name "UnmountReceipt" :kind :type :tokens 1)

    ;; Dynamic Tool Plane Functions (<= 2 tokens)
    (:sym :name "active-domains" :kind :fn :tokens 2)
    (:sym :name "active-landscape" :kind :fn :tokens 2)
    (:sym :name "base-landscape?" :kind :fn :tokens 2)
    (:sym :name "base-tools" :kind :fn :tokens 2)
    (:sym :name "create-domain" :kind :fn :tokens 2)
    (:sym :name "create-param" :kind :fn :tokens 2)
    (:sym :name "create-tool" :kind :fn :tokens 2)
    (:sym :name "domain-loaded?" :kind :fn :tokens 2)
    (:sym :name "empty-plane" :kind :fn :tokens 2)
    (:sym :name "estimate-tokens" :kind :fn :tokens 2)
    (:sym :name "format-graph" :kind :fn :tokens 2)
    (:sym :name "has-tool?" :kind :fn :tokens 2)
    (:sym :name "load-domain" :kind :fn :tokens 2)
    (:sym :name "lookup-tool" :kind :fn :tokens 2)
    (:sym :name "mount-receipt" :kind :fn :tokens 2)
    (:sym :name "render-landscape" :kind :fn :tokens 2)
    (:sym :name "render-param" :kind :fn :tokens 2)
    (:sym :name "render-tool" :kind :fn :tokens 2)
    (:sym :name "reset-turn" :kind :fn :tokens 2)
    (:sym :name "tool-count" :kind :fn :tokens 2)
    (:sym :name "unload-domain" :kind :fn :tokens 2)
    (:sym :name "unmount-receipt" :kind :fn :tokens 2)

    ;; Multi-Token Symbols (with :rationale)
    (:sym :name "find-plugins-by-capability" :kind :fn :tokens 4
          :rationale "Cannot be reduced to 'find-plugins': explicitly scopes query filtering by advertised capability keyword rather than name or version")
  ])
