(:package aslAgent
 :version "0.1.0"
 :entry "src/omniIntent.asl"
 :description "Omni-channel intent classification, front-agent directive dispatch, unbiased-context sanitation, ingress protocol framing, on-host computer-use action routing, and model-role routing (the much larger agent/CLI package this once was got deleted in DEAD-PACKAGES/eba523678 as dead; these six modules remain live: the first four imported by asl-agent-core/tests/dualIsolationTest.asl, computerUse by tests/acceptance/hostComputerUseAxTest.asl, modelRouter by tools/tests/modelBlindDispatchTest.asl)"
 :aslFirst true
 :modules [
   "aslAgent/computerUse"
   "aslAgent/frontAgent"
   "aslAgent/modelRouter"
   "aslAgent/omniIngress"
   "aslAgent/omniIntent"
   "aslAgent/unbiasedContext"
 ]
 :dependencies ["asl-text"])
