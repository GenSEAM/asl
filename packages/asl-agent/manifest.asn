(:package aslAgent
 :version "0.1.0"
 :entry "src/main.asl"
 :description "Leon, the agent loop (core, loop, turn, txn, gates, journal, providers, pool, main CLI and the rest of the loop modules), plus omni-channel intent classification, front-agent directive dispatch, unbiased-context sanitation, ingress protocol framing, on-host computer-use action routing, and model-role routing"
 :aslFirst true
 :modules [
   "aslAgent/agentConfig"
   "aslAgent/aslOps"
   "aslAgent/attractor"
   "aslAgent/bus"
   "aslAgent/card"
   "aslAgent/claimBacking"
   "aslAgent/claims"
   "aslAgent/computerUse"
   "aslAgent/context"
   "aslAgent/core"
   "aslAgent/coreCli"
   "aslAgent/diff"
   "aslAgent/exec"
   "aslAgent/frame"
   "aslAgent/frontAgent"
   "aslAgent/gateIntegrity"
   "aslAgent/gates"
   "aslAgent/gitOps"
   "aslAgent/grounding"
   "aslAgent/journal"
   "aslAgent/leonPool"
   "aslAgent/leonServe"
   "aslAgent/loop"
   "aslAgent/loopState"
   "aslAgent/main"
   "aslAgent/metrics"
   "aslAgent/modelRouter"
   "aslAgent/nativeTools"
   "aslAgent/omniIngress"
   "aslAgent/omniIntent"
   "aslAgent/pathResolve"
   "aslAgent/plan"
   "aslAgent/pool"
   "aslAgent/poolChannel"
   "aslAgent/poolOps"
   "aslAgent/poolServe"
   "aslAgent/providers"
   "aslAgent/remoteOps"
   "aslAgent/reply"
   "aslAgent/retry"
   "aslAgent/runLoop"
   "aslAgent/runOps"
   "aslAgent/sessionPool"
   "aslAgent/toolCalls"
   "aslAgent/turn"
   "aslAgent/txn"
   "aslAgent/unbiasedContext"
 ]
 :dependencies ["asl-text" "asl-json" "asl-proc" "asl-forms" "asl-gateway" "asl-harness" "asl-engine" "asl-checker"])
