(:doc :symbol "asl/packages/asl-agent/src/core.asl#restOf" :text "tail of a list, assuming it is non-empty")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#sliceOf" :text "byte slice of a string from i to j, assuming the bounds are valid")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#ch" :text "the one-byte string at index i")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#isDigit" :text "true when the one-byte string is 0 through 9")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#isWordByte" :text "true for ASCII letters, digits, underscore, or any byte of 0xC0 and above (UTF-8 lead bytes)")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#isSpace" :text "true for space and the control characters tab through carriage return")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#runEnd" :text "index of the first byte at or after i where test fails, or n")
