(:doc :symbol "asl/packages/asl-agent/src/core.asl#renderTranscript" :text "renders history turns within a character budget as text, using the window renderer and appending its last turn")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#progName" :text "last path segment of w, the program name without its directories")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#changePlan" :text "per path, \"keep\" if the path is inside the effective owns else \"restore\"")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#editDistance" :text "Levenshtein edit distance between a and b, computed row by row")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#nearestOp" :text "maps an unknown op name to an accepted op via alias or closest edit distance, or \"\" when nothing is close")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#terminalForms" :text "terminal form templates for a mode: findings/escalate for scout, done/escalate otherwise")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#dataFindings" :text "turns a reply of data-only forms or explicit findings into findings forms, or empty when the reply is a real op")
