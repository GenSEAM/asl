(:doc :symbol "asl/packages/asl-agent/tests/leonCodeRouteTest.asl#runTests" :text "LEON code route: a code-intent run drives the gateway codeRoute step machine for its model call")
(:doc :symbol "asl/packages/asl-agent/tests/leonOrphanResidueTest.asl#runTests" :text "the residues of a dead parent: a blocked model call, gate runs, integrity re-runs and baseline runs end when the watched pid is gone")
(:doc :symbol "asl/packages/asl-agent/tests/gateKillTreeTest.asl#runTests" :text "a timed-out gate leaves no survivor, not even a child in its own process group under the gate CLI")
(:doc :symbol "asl/packages/asl-agent/tests/leonRemoteToolsTest.asl#runTests" :text "Leon tool ops routed to a remote unit through remoteOps")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#echoHeads" :text "the heads of the frames the loop itself sends or journals, which a model reply must never repeat at top level")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#isEchoForm" :text "true for a frame whose head is an echo head; a gate frame counts only when it carries the loop-output keys cmd and one of exit, asserts, failed")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#echoForms" :text "the top-level forms of a reply that echo loop frames")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#echoCount" :text "how many loop frames a reply echoes")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#stripEchoes" :text "a reply with every echoed loop frame removed, before findings are read")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#malformedLine" :text "the journal line (:malformed :turn N :echo K) of a turn whose reply echoed loop frames")
(:doc :symbol "asl/packages/asl-agent/src/frame.asl#Frame" :text "the context frame of a unit: unit, kind, atoms, owns, gates, os, toolchain and a clipped peers line")
(:doc :symbol "asl/packages/asl-agent/src/frame.asl#frameMaxTokens" :text "adopted: token ceiling of a rendered context frame")
(:doc :symbol "asl/packages/asl-agent/src/frame.asl#peersClip" :text "adopted: characters of the peers line kept in a frame")
(:doc :symbol "asl/packages/asl-agent/src/frame.asl#estimateTokens" :text "token estimate of a text: characters plus three, divided by four")
(:doc :symbol "asl/packages/asl-agent/src/frame.asl#leaksEgress" :text "true when a frame text would carry a secret or an outward-bound value, so the frame is refused")
(:doc :symbol "asl/packages/asl-agent/src/frame.asl#renderFrame" :text "the pure context frame of a unit from its env, lane and budget rows, clipped to frameMaxTokens")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#attribHeaders" :text "the gateway headers naming the consumer and, once a main turn has run, X-ASL-Turn, so the ledger row joins the session")
(:doc :symbol "asl/packages/asl-agent/tests/attribHeadersTest.asl#runTests" :text "attribution headers of every gateway call")
(:doc :symbol "asl/packages/asl-agent/tests/coreEchoTest.asl#runTests" :text "echoed loop frames are detected and stripped from a reply")
(:doc :symbol "asl/packages/asl-agent/tests/frameTest.asl#runTests" :text "the context frame renders within its token ceiling and refuses egress")
(:doc :symbol "asl/packages/asl-agent/tests/leonVerdictTest.asl#runTests" :text "the verdict row Leon reports for a run")
(:doc :symbol "asl/packages/asl-agent/tests/replySpellingTest.asl#runTests" :text "reply spellings of ops are accepted as their canonical forms")
(:doc :symbol "asl/packages/asl-agent/tests/stablePrefixTest.asl#runTests" :text "the system prompt prefix is stable across sessions and tasks")
(:doc :symbol "asl/packages/asl-agent/tests/writeAliasTest.asl#runTests" :text "write and edit shorthands are accepted and shown canonically")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#Exec" :text "a local process a turn asks for in place of a hub request: argv, working directory, env, timeout in seconds and descendant limit")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#Pool" :text "the session pool: hub socket, slots in flight, memory cap, idle ttl, spill directory, the active, exec and waiting sessions, finished results and the peak counts of in-memory and spilled sessions")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#Sess" :text "one session: id, state string, the request its next turn sends, hub fd and read buffer, last activity, tries, hold-until time, busy count, an optional guarded local process and the spill file when parked on disk")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#Turn" :text "what a turn function returns for a (state, reply): the next state and either the next request body, a local exec, or the final result, plus headers, a busy flag and a hold time")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#asnQuote" :text "text as a quoted ASN string with backslash, quote and newline escaped")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#execReply" :text "the (:exec :exit :out :err) reply text a turn function gets for a finished local process")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#httpRequest" :text "the HTTP POST of a chat request to the hub: the given headers without framing ones, an X-Asl-Unit header with the session id unless one is present, and the body")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#newPool" :text "an empty pool for a hub socket with at least one slot and non-negative memory cap and ttl")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#pickNext" :text "the next waiting session to start: among those whose hold time has passed, a warm one if any, and the oldest of them")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#poolDone" :text "the finished (id, result) pairs held in the pool")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#poolIdle?" :text "true when no session is active, executing or waiting")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#poolKnown?" :text "true when a session id is active, executing or waiting in the pool")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#poolMemCount" :text "how many waiting sessions are held in memory rather than spilled")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#poolStep!" :text "one non-blocking step of the pool: reads ready replies, advances local execs and admits waiting sessions up to the slots; the turn function maps (state, reply) to a Turn")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#poolStepG!" :text "poolStep! with a threaded value: the turn function also takes and returns a value d, so the caller can accumulate results; returns the pool and the final value")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#poolSubmit!" :text "adds a session in the waiting list with an empty request; its first turn call with an empty reply makes its first request when it is admitted")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#poolTakeDone" :text "returns the finished results and a pool with them cleared")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#poolWatch" :text "the (fd, 1) pairs to poll: each active session's hub fd and the fds of guarded local processes")
(:doc :symbol "asl/packages/asl-agent/src/sessionPool.asl#spilledCount" :text "how many waiting sessions are spilled to a file")
(:doc :symbol "asl/packages/asl-agent/src/poolServe.asl#Serve" :text "the pool process state: listener fd, open control connections, the pool, the receipt directory and the stop flag")
(:doc :symbol "asl/packages/asl-agent/src/poolServe.asl#newServe" :text "a Serve for a listener fd, a pool and a receipt directory, with no connections and not stopping")
(:doc :symbol "asl/packages/asl-agent/src/poolServe.asl#serveStep!" :text "one non-blocking step: accepts a connection, steps each connection's line handling, steps the pool and writes finished sessions to receipt files")
(:doc :symbol "asl/packages/asl-agent/src/poolServe.asl#serveWatch" :text "the (fd, 1) pairs to poll: the listener, each connection and the pool's fds")
(:doc :symbol "asl/packages/asl-agent/src/poolServe.asl#handleLine!" :text "answers one control line: submit queues a session (queued, or refused for no unit, bad id or duplicate), receipt answers running, done with the file, or unknown, status gives the counters, stop ends the serve")
(:doc :symbol "asl/packages/asl-agent/src/poolServe.asl#validId?" :text "true when a unit id is 1 to 96 bytes of letters, digits, dot, dash and underscore with no leading dot, since it becomes a file name")
(:doc :symbol "asl/packages/asl-agent/src/poolServe.asl#quotedAfter" :text "the quoted string after a key in a line, none when the key is absent")
(:doc :symbol "asl/packages/asl-agent/src/poolServe.asl#asnQuote" :text "asnQuote of the session pool, re-exported for control replies")
(:doc :symbol "asl/packages/asl-agent/src/poolServe.asl#receiptPath" :text "path of a unit's receipt file, its id under the receipt directory")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#HubCall" :text "a request prepared for the hub: socket path, request body and headers")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#Ask" :text "the cut turn: askDone with the finished Turn, or askHub with the provider and the exact HubCall to send")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#askDone" :text "an Ask carrying a turn already complete, no hub call needed")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#askHub" :text "an Ask carrying the provider (turn already counted) and the hub call to send")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#nextTurnAsk!" :text "runs a turn up to the hub post: returns askHub with the body when the call goes to the hub socket, askDone otherwise")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#nextTurnReply" :text "finishes a cut turn from the hub's raw answer, logs usage, and falls back to a no-tools provider when the hub rejected tools")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#hubBusy?" :text "true when a turn failed with Hub HTTP error 503, which means wait, not failure")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#acceptHeader" :text "the Accept: application/json header when tools are offered so the reply keeps its tool_calls, none otherwise")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#outgoingMessages" :text "the messages a vendor provider would send on the profile chat call, from system, user and the prefill")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#profileMessages" :text "the system and user messages followed by an assistant prefill message when the prefill is not empty")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#retryAfterSec" :text "the seconds in a [retry-after=N] marker of an error message, 0 when absent")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#withPrefill" :text "the provider with an assistant prefill set; other provider kinds unchanged")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#withTools" :text "the provider with the offered tool list set; other provider kinds unchanged")
(:doc :symbol "asl/packages/asl-agent/src/nativeTools.asl#ShapeParam" :text "one parameter of an op shape: key, kind and whether it is required")
(:doc :symbol "asl/packages/asl-agent/src/nativeTools.asl#ShapeTool" :text "one tool derived from an op shape: name, whether it is the single step tool, the shape text and its parameters")
(:doc :symbol "asl/packages/asl-agent/src/nativeTools.asl#callForm" :text "the ASN form text for one tool call: the form argument for the step tool, otherwise an op or terminal head (done, escalate) built from the call's arguments")
(:doc :symbol "asl/packages/asl-agent/src/nativeTools.asl#callsText" :text "the reply text for the parser from a native-tools turn: the forms of every tool call in order after any text content")
(:doc :symbol "asl/packages/asl-agent/src/nativeTools.asl#shapeTool" :text "parses an op shape text into a ShapeTool, none when it is empty")
(:doc :symbol "asl/packages/asl-agent/src/nativeTools.asl#stepToolSpec" :text "the JSON function spec of the single step(form) tool")
(:doc :symbol "asl/packages/asl-agent/src/nativeTools.asl#systemHint" :text "the system prompt line naming the tools channel, empty when the setting is off or false")
(:doc :symbol "asl/packages/asl-agent/src/nativeTools.asl#toolSpecs" :text "one JSON function spec per offered op shape, named by the op")
(:doc :symbol "asl/packages/asl-agent/src/nativeTools.asl#toolsHint" :text "the line appended to the system prompt when tools are offered: call them, one op per call, no prose")
(:doc :symbol "asl/packages/asl-agent/src/nativeTools.asl#validTools?" :text "true for the accepted :tools values: empty, off, false, ops, step")
(:doc :symbol "asl/packages/asl-agent/src/txn.asl#expectedModule" :text "the module name a path calls for: asl/tools/X gives asl-tools/X, asl/packages/P/src or tests/X gives P/X, otherwise the path without .asl")
(:doc :symbol "asl/packages/asl-agent/src/txn.asl#importsOf" :text "the module names in the :i [ ... ] list of a source text, the first word of each item")
(:doc :symbol "asl/packages/asl-agent/src/txn.asl#moduleHints" :text "a hint for staged .asl writes whose module header cannot belong to the file: the module's last segment is not the file's base name, or two writes of the txn declare one module; empty when all are fine")
(:doc :symbol "asl/packages/asl-agent/src/txn.asl#moduleOf" :text "the module a source text declares: the first word after (module when the text starts with it, else empty")
(:doc :symbol "asl/packages/asl-agent/src/txn.asl#orderSubs" :text "re-slots the .asl write steps of a txn by their imports so each file resolves against the others whatever order the model wrote them; nothing moves for fewer than two writes, an edit step targeting a file the txn also writes, or an order that already holds")
(:doc :symbol "asl/packages/asl-agent/src/txn.asl#txnSubs" :text "the sub-forms of a txn form, the inner forms that start with (:")
(:doc :symbol "asl/packages/asl-agent/src/leonPool.asl#Book" :text "the book of live runs: a list of (session id, Live) pairs")
(:doc :symbol "asl/packages/asl-agent/src/leonPool.asl#Live" :text "one live Leon run in the pool: its session, wrapped provider run, the outstanding ask if any, provider, exit code, retries, remaining time and the time of the ask")
(:doc :symbol "asl/packages/asl-agent/src/leonPool.asl#leonExit" :text "the exit code recorded for a session id in the book, -1 when it is not there")
(:doc :symbol "asl/packages/asl-agent/src/leonPool.asl#leonOpen!" :text "starts a run: the invocation form goes through the CLI check chain, then journal, provider, system prompt, loop env and baseline are set up as the blocking path does; a rejected or early-finished run comes back as its result, a ready one is added to the book and its id is for the caller to submit to the pool")
(:doc :symbol "asl/packages/asl-agent/src/leonPool.asl#leonTurn!" :text "the pool's turn function: the state is the session id; an empty reply starts or continues the run, any other text is the raw hub answer to the ask the run left outstanding, and a 503 keeps the ask and waits")
(:doc :symbol "asl/packages/asl-agent/src/journal.asl#buildSystemPromptDrop" :text "the system prompt without the rows a drop list names; an empty list gives the same bytes as buildSystemPrompt")
(:doc :symbol "asl/packages/asl-agent/src/journal.asl#fallbackRowText" :text "one journal row (:fallback :noTools ...) when a route's 400 to a tools request made the turn fall back to the text protocol: the model, the status and the first 120 characters of the error")
(:doc :symbol "asl/packages/asl-agent/src/journal.asl#sectionId" :text "the id a prefix row is dropped by: a harness layer by its :id, any other row by its head keyword")
(:doc :symbol "asl/packages/asl-agent/src/journal.asl#usageRowText" :text "one journal row (:usage :in :cached :out :model) for a provider reply that carried usage")
(:doc :symbol "asl/packages/asl-agent/src/retry.asl#chargeSeconds" :text "the elapsed seconds of an attempt rounded up, never negative, charged to the wall budget")
(:doc :symbol "asl/packages/asl-agent/tests/contextConfigScopeTest.asl#runTests" :text "the context settings and parseDefectEscalate are read only as top-level keys of :agentLoop: the same key in another group, a nested list or a doc string is not read, and a value that is not a positive integer reads as absent")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#contextLatestCapBytes" :text "the byte cap for the newest turn's output, twice the read payload, larger than the cap for older turns so the model's latest read is not clipped too hard")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#contextWindowLatestCapBytes" :text "the newest-turn cap: the window chars (contextTokens x charsPerToken) over contextCompactStep+1, since that many turns keep their first rendering until the next compaction point, never above contextLatestCapBytes; 4800 at 8k tokens, 72000 at 120k")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#readRangesOf" :text "file:start-end of each successful read receipt in a turn's got, used by the dropped-turn digest and the mustEdit known list")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#sameMarkedGot" :text "a got whose read receipts an earlier kept turn's rendering still shows whole, with that content replaced by (:same :turn N)")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#mustEditForm" :text "the (:mustEdit :readOnly n :known (ranges) [:more k] :owns (files)) form a read-only streak gets at the nudge point, at most the newest 24 ranges; with no :owns it asks for findings or done instead of an edit")
(:doc :symbol "asl/packages/asl-agent/tests/readLoopContextTest.asl#runTests" :text "pins the read-loop fixes: (:same :turn N) for a re-read still whole in the kept window and never for a clipped one, a stale marker re-rendered, the dropped-turn :read digest, one mustEdit at 6 of the default readOnlyTurnCap 12 and exactly one per prompt after it, the 24-range :known cap and the no-owns text")
(:doc :symbol "asl/packages/asl-agent/tests/deleteThenRejectedWriteTest.asl#runTests" :text "pins that a delete whose path a later write in the same reply targets is superseded, so a write refused for large escaped content leaves the original file intact")
(:doc :symbol "asl/packages/asl-agent/tests/hubRetryStub.asl#main" :text "stand-in hub for retry tests: mode down answers the first request 503 with Retry-After 2 then a text reply, mode retry answers the first 429 with Retry-After 2 then text, mode long answers every request 429 with Retry-After 9999; every request is appended to the log")
(:doc :symbol "asl/packages/asl-agent/tests/hubRetryTest.asl#runTests" :text "pins that a hub 429 with Retry-After N is a wait: the turn sleeps N seconds and reposts within the queue timeout, and a Retry-After beyond that budget is an ordinary error without retry")
(:doc :symbol "asl/packages/asl-agent/tests/hubStub.asl#main" :text "one-shot stand-in hub: listens on the unix socket in argv 1, writes the first request it reads to the file in argv 2 and answers one ASN reply")
(:doc :symbol "asl/packages/asl-agent/tests/journalUsageTest.asl#runTests" :text "pins that a provider reply's usage block, OpenAI-shaped or the ASN reply's own, lands in the journal as a usage row with in, cached, out and model, that a reply without usage writes nothing, and that the turn meta still carries it")
(:doc :symbol "asl/packages/asl-agent/tests/leonPoolHubTest.asl#runTests" :text "pins that 8 Leon runs of 2 hub calls each share one pool over a stand-in hub holding every reply 3000 ms, all end ok, and the pool wall is over one hold and under twice a single run's wall")
(:doc :symbol "asl/packages/asl-agent/tests/leonPoolRetryAfterTest.asl#runTests" :text "pins that a run answered 429 with Retry-After 2 holds without sleeping the pool thread while another run's calls are answered, shown by the arrival order of the stand-in hub")
(:doc :symbol "asl/packages/asl-agent/tests/leonPoolTest.asl#runTests" :text "pins pool parity: the same scripted case through the blocking path and through the pool driver gives byte-identical journals once session id, root and receipt ids are masked, covering edit, retry, parentGone and a code-routed turn, a check-chain rejection with the same receipt and exit, and 8 runs sharing one pool")
(:doc :symbol "asl/packages/asl-agent/tests/leonPoolTest.asl#Out" :text "outcome of one scripted run with fields exit, stdout and journal (the session journal text)")
(:doc :symbol "asl/packages/asl-agent/tests/leonPoolTest.asl#blocked!" :text "runs one agent form through the blocking path mainWithRoots and returns its exit, stdout and the journal of the session named in stdout, an empty journal when no session id is printed")
(:doc :symbol "asl/packages/asl-agent/tests/leonPoolTest.asl#diffMsg" :text "failure text for two runs whose journals differ: the tag, both journal lengths and the lines found only in the blocking journal and only in the pool journal")
(:doc :symbol "asl/packages/asl-agent/tests/leonPoolTest.asl#pooled!" :text "runs one agent form through the pool driver in process (a pool of 4 workers pumped for at most 120 s) and returns its exit and session journal, the early result when leonOpen! already ended the run, and exit -1 when the run is not found")
(:doc :symbol "asl/packages/asl-agent/tests/leonPoolTest.asl#prepBase!" :text "creates a fixture root: the mvp fixture file with the given text, a config with specCheck off, subject.txt holding before, the extra files, and a git repository on main with one initial commit of subject.txt or of everything when addAll is set; true when every step succeeded")
(:doc :symbol "asl/packages/asl-agent/tests/nativeToolsHubTest.asl#runTests" :text "pins an end-to-end run through the hub with a tool-only model: with Leon's default settings it finishes a one-write unit, which it could not with tools off")
(:doc :symbol "asl/packages/asl-agent/tests/nativeToolsTest.asl#runTests" :text "pins native tool calling: op shapes become function schemas, nested txn shapes are not offered, and every tool call reads back as the ASN form the text protocol carries")
(:doc :symbol "asl/packages/asl-agent/tests/neutralHistoryTest.asl#runTests" :text "pins that one model's own markup (think and tool_call tags) is dropped from the transcript before it reaches the next model, which sees only the ASN steps and receipts")
(:doc :symbol "asl/packages/asl-agent/tests/poolDriverTest.asl#runTests" :text "pins poolStepG!: a caller value is threaded through every turn call, the turn's headers reach the wire with X-Asl-Unit once, a 503 re-parks the same request for 1 s without spending a try, and the raw response reaches the turn function")
(:doc :symbol "asl/packages/asl-agent/tests/poolServeTest.asl#runTests" :text "pins the pool control socket on a scripted hub: submit queues, duplicate and path-like ids are refused, a receipt is running until the session ends then a file-backed done, 40 sessions with memCap 4 all leave receipts while no finished session stays in memory, status reports counters and stop sets the flag")
(:doc :symbol "asl/packages/asl-agent/tests/poolServeFormTest.asl#runTests" :text "the pool control line survives newlines: leonClient quoteWord escapes newline, CR and tab so the server reads back a byte-identical (:run :form ...) whose :task keeps every line, and poolServe receipts quote a multi-line :result onto one line that reads back whole at 100 KB")
(:doc :symbol "asl/packages/asl-agent/tests/prefixDropTest.asl#runTests" :text "pins that a :prefix drop list removes exactly the named rows or groups from the system prompt, that an empty list is byte-identical to the full prompt, and that focus is a per-turn tail rather than a prompt row")
(:doc :symbol "asl/packages/asl-agent/tests/prefixHubTest.asl#runTests" :text "pins an end-to-end run through the hub with a :prefix list: the system prompt lacks those layers, each turn ends with the focus tail, and the unit still finishes")
(:doc :symbol "asl/packages/asl-agent/tests/providersAskTest.asl#runTests" :text "pins nextTurnAsk!: with a hub socket it posts nothing and returns askHub with the body and headers nextTurn! then really posts, counts the turn, and nextTurnReply of the stand-in's raw reply gives the same text as the blocking path")
(:doc :symbol "asl/packages/asl-agent/tests/providersHubTest.asl#runTests" :text "pins the hub transport read from hub.asn: a :sock gets the chat with class and unit headers, a dead socket is retried at :backoffMs doubling until :downAfterMs then ERR_GATEWAY_DOWN, :fallback inProcess leaves the hub path, and with no hub.asn the older HTTP path is unchanged")
(:doc :symbol "asl/packages/asl-agent/tests/readOnlyGateTest.asl#runTests" :text "pins that a turn whose ops only read, or whose write or edit changed nothing, reuses the last gate verdict, while a turn that wrote, runs or finishes still runs the gates")
(:doc :symbol "asl/packages/asl-agent/tests/repeatFailureTest.asl#runTests" :text "pins that the same reply whose ops fail and change nothing escalates on its third consecutive turn")
(:doc :symbol "asl/packages/asl-agent/tests/sessionPoolTest.asl#runTests" :text "pins the session pool on a scripted hub: 8 sessions of 5 turns over 8 slots finish in under twice one session's wall, 64 sessions over 8 slots with memCap 16 all finish with waiting sessions spilled to files and the files gone at the end, pickNext prefers the oldest warm session, and an unreachable hub gives up after three tries")
(:doc :symbol "asl/packages/asl-agent/tests/poolBigRequestTest.asl#runTests" :text "gate for LEONPOOL-RETRYAFTER-MAC-HANG: a 600 KB pool request to a hub that reads only between pool steps reaches the hub whole, because the hub fd is non-blocking and the unsent rest is kept and pushed on the next step instead of blocking the worker in a socket send")
(:doc :symbol "asl/packages/asl-agent/tests/toolHubStub.asl#main" :text "stand-in hub for a tool-only model: a request offering tools gets a JSON tool_call, first a step that writes subject.txt green then done, a request without tools gets prose; every request is appended to the file in argv 2")
(:doc :symbol "asl/packages/asl-agent/tests/tools400Stub.asl#main" :text "stand-in hub: in mode tools a request that offers tools gets HTTP 400 and one without gets a text reply, in mode always every request gets 400; every request is appended to the log file")
(:doc :symbol "asl/packages/asl-agent/tests/tools400Test.asl#runTests" :text "pins the 400 fallback: a route answering 400 to a request with tools is retried once without tools in the text protocol, the provider is remembered as no-tools for the next turn, and a 400 without tools is an ordinary error with no retry")
(:doc :symbol "asl/packages/asl-agent/tests/txnOrderTest.asl#runTests" :text "pins txn write ordering: a test written before the src it imports is sent src first, an order that holds, a cycle, and a txn editing a file it also writes stay as written, and a src carrying its test's module header gets a moduleHint naming the expected module")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#validAttractor?" :text "an :attractor value is valid when empty, off or asn: asn opens the system prompt with one compact ASN contract and op examples and prefills (:step where the transport allows")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorOn?" :text "whether the attractor value turns the ASN contract on (asn), as opposed to empty or off")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorContract" :text "the stable prefix: constant text plus the op grammar rows, with no task, session, path, time, turn or model name, so its bytes are the same for every session and a provider prompt cache hits")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorSystem" :text "the system prompt with the attractor contract in front when the attractor is on, else the system prompt unchanged")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#prefixHash" :text "the fnv1a64 hash of the attractor contract when the attractor is on, else empty; journaled per turn to show the prefix stays byte-stable")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorCards" :text "the dynamic tail cards chosen by static rules from the last receipt text, the last parse defect and the write state; each card is named and the names are journaled")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorTail" :text "the text of the chosen cards, one per line, followed by a blank line; empty when no card fired")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorPrefill" :text "the assistant prefill a turn sends when the attractor is on, else empty")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#continueReply" :text "a prefilled reply that arrives as only the continuation gets the prefill put back before parsing; a whole reply is kept as it is")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#proseChars" :text "non-space characters outside every balanced top-level form and outside raw fenced blocks bound to a :raw step")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorCards" :text "the named tail cards for a turn chosen by static rules from the last receipt text, the last parse defect, the write state and the turn count; empty when the attractor is off, and the names are journaled")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorContract" :text "the stable prefix: constant text plus the op grammar rows, with no task, session, path, time, turn or model name, so its bytes are the same for every session and a provider prompt cache can hit")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorOn?" :text "true when the attractor setting is asn")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorPrefill" :text "the assistant prefill (:step when the attractor is on, empty otherwise")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorSystem" :text "the system prompt with the contract in front when the attractor is on, unchanged when off")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#attractorTail" :text "the tail cards' texts joined by newlines and followed by a blank line, empty when there are no cards")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#continueReply" :text "a prefilled reply may arrive as only the continuation or as the whole reply when the transport ignored the prefill; puts the prefill back only in the first case")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#prefixHash" :text "the fnv1a64 hash of the contract as text when the attractor is on, empty otherwise")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#proseChars" :text "the count of non-space characters outside every balanced top-level form and outside raw fenced blocks bound to a raw step")
(:doc :symbol "asl/packages/asl-agent/src/attractor.asl#validAttractor?" :text "true for the accepted attractor values: empty, off, asn")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#Checked" :text "what the CLI check chain accepted: parameters, repo root, root dir, timeout, queue timeout and the plan flag")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#Valid" :text "the check chain's decision: valid with the Checked values, or invalid with the rejection MainResult")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#valid" :text "a Valid carrying the checked parameters, roots and wall")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#invalid" :text "a Valid carrying the rejection receipt")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#checkInvocation" :text "runs the check chain on an invocation, in order: syntax error, deprecated role, unknown op, context file error, missing task or resume, then the root and wall checks; returns the first rejection or the Checked values")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#paramHas" :text "true when an invocation's parameters hold the key")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#runArgsOf" :text "the RunArgs of an invocation's parameters, as dispatch builds them, so a pool driver starts a run from the same parameters")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#LiveAsk" :text "what the first half of a turn hands the second: the system and user text and prefill for the model call, the sent text for history, the attractor card names for the journal and whether the advisor hook was acceptable")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#liveAsk!" :text "the first half of a live turn: renders the bounded transcript and builds the LiveAsk")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#liveApply!" :text "the second half of a live turn: applies the model's response and retries to the run and returns the next provider run and step")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#liveTurn!" :text "one live turn: liveAsk!, the blocking provider call, then liveApply!, with a parent watcher and the wall left passed to the call")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#liveGone!" :text "the orphan stop of one turn: journals the signal and escalates with reason parentGone, apart from the turn body so a pool driver stops its sessions the same way")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#parentGone?" :text "true when the parent pid the CLI passed is no longer alive; none means no parent to watch")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#LiveSession" :text "everything a live run needs once set up: run args, roots, journal path, system prompt, loop env, turn provider and provider call")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#LivePrep" :text "the result of liveSetup!: prepared with a LiveSession, or prepRejected with a MainResult")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#prepared" :text "a LivePrep carrying a ready LiveSession")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#prepRejected" :text "a LivePrep carrying the rejection receipt")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#liveSetup!" :text "builds a live run: code routing, journal, provider (made with the journal's session id so gateway calls carry it), system prompt and loop env; a journal, backend or harness error is returned as a rejection")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#liveResult" :text "the MainResult of a finished live run: the formatted receipt with the journal usage and last step, and its exit code")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#appendRetryLines!" :text "appends one (:retry :turn :attempt) journal row per retry, from the retry count down to 1")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#attractorProvider" :text "the provider with the wall cap applied and, when the prefill is not empty, the prefill set")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#focusTail" :text "the per-turn (:focus :goal :gate :next) tail when the prefix list includes focus: the goal cut to 400 characters, the first gate and the suggested next step; empty otherwise")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#lastStepIn" :text "the last reply in a journal text as its op name: the op of a (:step :op ...) reply, else the head of its first form")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#prefixDrop" :text "the prefix tokens to drop from the system prompt, the list without focus")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#stopCause" :text "why the run stopped, for a receipt: the loop signal that ended it, else error for a failed run, gateVacuous for a failed run whose declared gates were green before any write, done for ok, otherwise the status")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#validPrefix?" :text "true when every token of a :prefix list is a known prefix token")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#wallLeft" :text "the seconds left of the wall budget, at least 1, none when no positive budget is set, so a model call or gate never outlasts the run")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#graderWall" :text "wallBudget, elapsed: the whole unreserved wall left (ra.wallBudget, not the reserved loop wall) less graderGraceSec for the finish's grader call, at least 1, none when unbounded")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#LoopOpen" :text "the result of opening a provider run: openRun with the ProviderRun to drive, or openDone with the RunResult of a run that ended early")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#openRun" :text "a LoopOpen carrying the provider run ready to drive")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#openDone" :text "a LoopOpen carrying the result of a run that finished during setup, already cleaned up")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#loopOpen!" :text "opens a provider run: setup, early results cleaned up, memoization begun for a ready run")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#loopHead!" :text "the head decision of one turn: returns the provider run with the new state and the step")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#loopFinish!" :text "finishes a provider run and cleans up; a cleanup error gives a failed result")
(:doc :symbol "asl/packages/asl-agent/tests/attractorTest.asl#runTests" :text "pins the opt-in reply attractor: off is byte-identical, on opens with the stable contract and the raw write example, ends with a prefill put back before parsing, adds a trailing assistant message, picks tail cards by static rules and journals prose chars and the prefix hash")
(:doc :symbol "asl/packages/asl-agent/src/leonPool.asl#leonDrop" :text "the book without the entry for a unit id")
(:doc :symbol "asl/packages/asl-agent/src/leonPool.asl#leonRouted?" :text "true when the unit's session has a code route declared for its intent; false for an unknown unit")
(:doc :symbol "asl/packages/asl-agent/src/leonPool.asl#leonViaHub?" :text "true when the unit's provider sends its model calls to the hub socket (providers hubAsk?); false for an unknown unit")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#hubSockOf" :text "the :sock value quoted in a hub.asn text, empty when there is none")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#main" :text "the Leon pool server process: --ctl control socket, --receipts dir, --spill dir, --slots, --deadline and --hub; serves until :stop or the deadline")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#openRun!" :text "the pool's open hook for a (:run ...): opens the Leon run; a routed run or one whose provider is not the hub ask path is dropped and answered exit 125 with a declined row so the conductor spawns it, otherwise the run joins the pool or its early result is returned")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#serveLoop!" :text "the serve loop: poll the control socket, the pool's hub sockets and exec children, step the server with the Leon driver, until :stop or the deadline; returns the final server and book")
(:doc :symbol "asl/packages/asl-agent/src/poolServe.asl#receiptRow" :text "the (:receipt :unit :state done :exit :result) row for a finished unit, newline-terminated")
(:doc :symbol "asl/packages/asl-agent/src/poolServe.asl#serveStepG!" :text "serveStep! with a driver value: the turn function, the open hook for (:run ...) and the exit lookup for receipts take and return it; one step accepts, reads, steps the pool and writes receipts")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#hubAsk?" :text "true for a vendor provider whose HOME/.asl/hub.asn names a :sock, so its model calls go to the hub; script, replay and the other providers answer in process")
(:doc :symbol "asl/packages/asl-agent/tests/holdHubStub.asl#main" :text "stand-in hub run as a bounded child: listens on the unix socket in argv 1, writes the maxInFlight and profile lines to the file in argv 2 and holds each request argv 3 ms before answering the two scripted edit replies")
(:doc :symbol "asl/packages/asl-agent/tests/leonServeTest.asl#runTests" :text "gate for leonServe: scripted runs submitted over the control socket are declined with exit 125, a run the check chain rejects has its exit 2 receipt at once, the same unit id twice is refused, (:status) answers and (:stop) ends the loop")
(:doc :symbol "asl/packages/asl-agent/tests/metricsUnbalancedWriteTest.asl#runTests" :text "gate for metrics determineFailType: a Leon journal with a rejected write whose delimiter repair left items, then an ok write, classes one failure as syntaxUnbalanced and none as semanticOther")
(:doc :symbol "asl/packages/asl-agent/src/journal.asl#editReceiptsOf" :text "the edit-family receipts (write edit txn flush fix discard delete) of a turn, whole and one per line; the journal row (:turn N :observation ...) holds them so edits stay measurable per model while read bodies stay out")
(:doc :symbol "asl/packages/asl-agent/tests/journalReceiptsTest.asl#runTests" :text "gate for the journal observation row: a scripted run writes an unbalanced file then a good one and the journal holds the rejected and the ok write receipt for their turns and no read receipt")
(:doc :symbol "asl/packages/asl-agent/tests/commitFlagTest.asl#runTests" :text "the (:agent ...) :commit key is the only commit request: absent or false keeps RunArgs.commit false whatever the task prose says, true or a bare :commit sets it, and commit is an accepted key")
(:doc :symbol "asl/packages/asl-agent/tests/leonServeWarmTest.asl#runTests" :text "gate for the deploy warm step on the real daemon entry: nativeTest prepare compiles leonServe into a scratch store with clang, and the next start of the entry reaches its usage error with no module lowered and no clang spawned; the scratch store is removed")
(:doc :symbol "asl/packages/asl-agent/tests/rawProtocolReplayTest.asl#runTests" :text "replays of node2 sessions c925fd5ad8167351 and 7de069c5874e6633 with canned model turns: a plain :content string is written as sent, the one fenced block of a reply binds to a :raw step even before it, an unbound :raw step is shown back without an :error marker and answered with the accepted shape as :hint, an echoed :error code is marked :echoed and not counted toward repeatFailure, gates green on owned files changed before the session end it as done, a (:step :op done) after a write ends it, and green gates on unchanged owned files do not")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#freeCtl!" :text "makes the control socket path free for a new listener: absent is fine; anything but a socket is refused as ctlNotSocket and left; a live peer or a busy one is refused; a refused connect (no listener) removes the socket and its owner record when the recorded owner is gone or none was ever recorded (a pool of before the record, or one that died between listen and record), and is refused when the recorded owner is alive (a live pool at a full backlog is refused too on macOS)")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#probeCtl!" :text "connects to the control socket: live when it answers, stale on the platform's refusal or a missing file, busy after the given tries a delay apart on any other error (EAGAIN, EINTR, EMFILE)")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#ctlStaleError?" :text "true when a connect error proves a socket file stale on the given platform: ECONNREFUSED named per platform (io:111 on Linux, io:61 on Darwin where 61 is not ENODATA) or ENOENT")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#startOf!" :text "the start time text of a process from ps -o lstart= (same on Linux and macOS, whitespace normalised), empty when ps does not answer; run through fleet/run with a 5 s limit")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#ownerPath" :text "path of the owner record beside the control socket, ctl.sock.pid, written by the pool after it binds: (:owner :pid N :start S)")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#ownerState!" :text "alive when the recorded pid runs with the recorded start time (or ps does not answer), gone when no such process runs or its start time differs (a reused pid), unknown when the record is absent or unreadable; a refused socket is removed by freeCtl! unless the state is alive")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#lockCtl!" :text "takes ctl.sock.lock by exclusive create with the starter's pid; a live holder refuses the start; a dead holder's lock is removed only if it still holds the text just read and then created once more")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#bindCtl!" :text "under the starter lock: frees the control path (freeCtl!), listens, writes the owner record, releases the lock; a failing owner record write is an error (ctlOwnerRecord) that closes and removes the socket just bound; a live listener's socket is never removed")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#cfgInt" :text "integer value of the key in a config text, the fallback when absent or not a number; read the :leonPool group only, through groupText")
(:doc :symbol "asl/packages/asl-agent/src/leonServe.asl#groupText" :text "the text of the first group named group of a config text, parens included, empty when absent; parens inside quoted strings do not count, so a key of another group with the same name is never read through it")
(:doc :symbol "asl/packages/asl-agent/tests/leonServeSocketTest.asl#runTests" :text "gate for the control socket start: absent, refused with no owner record (removed, and bound again with a record written), a live listener with no record (refused, untouched), an owner record that cannot be written (error, socket removed), with a gone owner (removed with its record), with a live owner and with a reused pid, a live listener, a listener at its connect limit (kept), a directory and a regular file (intact), errno naming per platform, the :leonPool group scope, the starter lock, the owner record bindCtl! writes")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#withExclude" :text "sets the excluded model on a vendor provider so the gateway routes the grader call to a different model than the writer")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#withTurnContext" :text "updates the loop state's contextTokens, readCap and wroteSinceGate after a turn")
(:doc :symbol "asl/packages/asl-agent/src/retry.asl#allDown?" :text "true for the gateway replies that mean every model of the route is down: no model answered, or every pool in breaker cooldown")
(:doc :symbol "asl/packages/asl-agent/src/retry.asl#retryTurnWaiting!" :text "retryTurn! that, after the quick retries of an all-down reply, sleeps its Retry-After or pauseSec inside waitLeft and the wall left and calls again with attempt numbers that keep counting")
(:doc :symbol "asl/packages/asl-agent/tests/readStreakCauseTest.asl#runTests" :text "the kept-turn cap from the context window, the read-streak nudge line and the readStreak config rows, and a recorded run where a read two turns back stays whole, the nudge names the configured stop and readStreakEscalate 20 runs past 12")
(:doc :symbol "asl/packages/asl-agent/tests/gitGlobalOptsTest.asl#runTests" :text "git commit, reset, tag and file checkout behind -c, -C, --git-dir, --work-tree, --namespace and --config-env are refused, also inside sh -c; read-only forms behind them stay allowed")
(:doc :symbol "asl/packages/asl-agent/tests/servedAliasTest.asl#runTests" :text "the served alias and model reach the journal row and the receipt, and a reply naming neither adds nothing")
(:doc :symbol "asl/packages/asl-agent/tests/allDownWaitTest.asl#runTests" :text "a fake gateway all down for two rounds of quick retries: the turn waits for the hint or the configured pause inside the all-down and wall budgets and resumes the same call; other errors and spent budgets end the turn as before")
(:doc :symbol "asl/packages/asl-agent/tests/pathResolveTest.asl#runTests" :text "the path resolver on a module-name layout, and a recorded run whose read, tree and write name module paths and land on the real files")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#readStreakNudgeIn" :text "the :readStreakNudge row of the :agentLoop group of a config text, none when absent or not a positive integer")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#readStreakEscalateIn" :text "the :readStreakEscalate row of the :agentLoop group of a config text, none when absent or not a positive integer")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#readStreakNudgeFor!" :text "the read-streak nudge threshold of a run root: its .asl.config.asn row, else 6")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#readStreakEscalateFor!" :text "the read-streak stop threshold of a run root: its .asl.config.asn row, else 12")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#readStreakNudgeLine" :text "the prompt line that names the turns left before the readStreak stop, empty below the nudge threshold or while no declared gate is red")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#renderTranscriptKept" :text "renderTranscriptBounded with its own byte cap for kept turns between the summary lines and the newest turn")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#contextKeptCapBytes" :text "byte cap of a kept turn for a context window: half the window over keepTurns plus compaction step minus 1 turns, at least toolCapBytes and at most the newest-turn cap")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#allDownWaitSecIn" :text "the :allDownWaitSec row of the :agentLoop group of a config text")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#allDownPauseSecIn" :text "the :allDownPauseSec row of the :agentLoop group of a config text")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#allDownWaitSecFor!" :text "seconds a turn of a run root may wait in all on an all-down gateway, else 1200")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#allDownPauseSecFor!" :text "pause of a run root between all-down rounds without a Retry-After, else 60")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#liveProviderWait!" :text "the live turn retry with all-down waits configured by the run root")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#providerWaitSleep!" :text "wraps the live turn sleep so every provider retry pause first appends (:providerWait :turn N :sec S) to the run journal")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#servedAlias" :text "the gateway alias that answered a turn, from the alias of its served fields")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#servedLine" :text "the journal row (:served :turn N :model M :alias A) of a turn, none when the reply names neither")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#servedIn" :text "the alias and model of the last served row of a journal text")
(:doc :symbol "asl/packages/asl-agent/src/pathResolve.asl#" :text "resolves a step path that does not exist to the one workspace path it names")
(:doc :symbol "asl/packages/asl-agent/src/pathResolve.asl#resolvedOps" :text "the step ops whose :file or :path is resolved")
(:doc :symbol "asl/packages/asl-agent/src/pathResolve.asl#resolveIn" :text "the one candidate a missing path names: drop leading segments until candidates end in the rest, narrow several to those carrying a dropped segment, none when zero or several are left")
(:doc :symbol "asl/packages/asl-agent/src/pathResolve.asl#dirsOf" :text "every directory holding a listed file, each once")
(:doc :symbol "asl/packages/asl-agent/src/pathResolve.asl#resolveOp!" :text "the op with its missing path replaced by the resolved one and the path as sent, else the op unchanged and none; a write resolves only a missing parent directory")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#withRetryAfter" :text "the status reason of a 429, 502 or 503 with its Retry-After header appended as [retry-after=N]")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#redGateOf" :text "true when the latest result of any declared gate is red")
(:doc :symbol "asl/packages/asl-agent/tests/writeRejectTest.asl#runTests" :text "a write step whose file text follows the closed :raw step without a fence, or follows :raw as a quoted string, binds as its content; a fenced block still binds; a checker refusal carries the checker's syntaxMessage as its message")
(:doc :symbol "asl/packages/asl-agent/src/txn.asl#balanceFix" :text "the specific hint for an unbalanced write: the line where the unclosed form opens and the closer it expects, or the line and column of the closer with nothing to close, none for balanced text")
(:doc :symbol "asl/packages/asl-agent/tests/unbalancedHintTest.asl#runTests" :text "balanceFix names the opening line and expected closer of an unclosed form and the position of an extra closer, and the write receipt hint carries it instead of the generic advice")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#doneNoWriteTurns" :text "default number of consecutive done-only turns with nothing written before a run stops with doneNoWrite, 2")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#doneNoWriteTurnsIn" :text "the :doneNoWriteTurns row of the :agentLoop group of a config text, none when absent or not a positive integer")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#doneNoWriteTurnsFor!" :text "the done-only stop threshold of a run root: its .asl.config.asn row, else 2")
(:doc :symbol "asl/packages/asl-agent/tests/doneNoWriteTest.asl#runTests" :text "a recorded run with a green gate and only done replies ends with the doneNoWrite signal within the configured turns, 2 by default, and the config row moves the threshold")
(:doc :symbol "asl/packages/asl-agent/tests/leonPoolAllDownTest.asl#runTests" :text "the pool's all-down branch: spent quick retries and a 502 no model answered hold the ask allDownPauseSec as holdMs with waited advanced and the ask repeated; with waited at allDownWaitSec the ask settles")
(:doc :symbol "asl/packages/asl-agent/tests/malformedReplyTest.asl#runTests" :text "a recorded run of broken tool-call wrapper replies gets the expected step shape after the first and ends with the malformedReply signal at the second")
(:doc :symbol "asl/packages/asl-agent/src/runOps.asl#outsideRootVerdict!" :text "why a run command is refused as reaching outside the root: rm, mv, ln, rmdir, unlink, chmod, chown, chgrp, truncate, tee, touch, mkdir, cp, install, rsync and dd targets, find with a delete or exec action, xargs feeding a writer or shell or interpreter, eval and sh -c, -lc or -ec inner commands, inline python, perl, ruby or node code naming a path outside the root, .., ~ or HOME, wrappers (nice, env, timeout, sudo, stdbuf, ionice, nohup) looked through, GIT_DIR, GIT_WORK_TREE and git -c core.worktree, git -C/--git-dir/--work-tree, a symlink inside the root resolved by real path, any ~name, $ or backtick word that is not a leading ~, $HOME, $PWD (substituted with the jail HOME and the root), an absolute path under the real HOME, rm or mv of .git, git worktree remove/prune, git prune, git gc --prune; none when allowed; ordinary in-root work and reads are never refused")
(:doc :symbol "asl/packages/asl-agent/src/runOps.asl#jailCacheEnv!" :text "the private cache variable rows (name=dir) of a jail home, created; jail#jailCacheEnv!")
(:doc :symbol "asl/packages/asl-agent/src/runOps.asl#spawnEnv!" :text "the environment of a run op child: the allowlisted rows of the parent (jail#passName?), then PWD, HOME and TMPDIR inside the root's jail home and the cache directories; hidden variables dropped")
(:doc :symbol "asl/packages/asl-agent/src/runOps.asl#jailHome" :text "the HOME a run op child gets: <root>/.asl/run/agentLoop/home")
(:doc :symbol "asl/packages/asl-agent/tests/runHomeJailTest.asl#runTests" :text "run ops get the jail HOME and TMPDIR, refuse commands touching paths outside the root, the real HOME or .git internals with ERR_RUN_OUTSIDE_ROOT, and a normal command in the root still runs; every known bypass (~name, $PWD, find -delete, xargs, rsync, eval, sh -lc, interpreters, wrapper flags, GIT_DIR, symlinks) is refused and in-root work stays allowed; the cache rows are checked under a fake real HOME")
(:doc :symbol "asl/packages/asl-agent/src/txn.asl#balanceRepair" :text "the repaired text when exactly one stray closer is deleted or exactly one unclosed opener at the end of the text is closed, accepted only when the result balances and the quotes pair, none otherwise")
(:doc :symbol "asl/packages/asl-agent/tests/autofixCloserTest.asl#runTests" :text "balanceRepair repairs one stray closer and one trailing unclosed opener and refuses two of either, an unpaired quote and an opener cut by the next form; a write with one stray closer persists with a repaired field and an ambiguous one keeps the refusal")
(:doc :symbol "asl/packages/asl-agent/tests/ownedMissingTest.asl#runTests" :text "reads of owned files that do not exist answer owned file missing and do not end a run with readStreak while a gate is red")
(:doc :symbol "asl/packages/asl-agent/tests/repeatRefusalTest.asl#runTests" :text "three identical refused writes end with repeatFailure and the turn before carries the refusal text with the instruction to change the content")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#nextReadStreakOf" :text "the next readStreak: a persisted write resets it, a turn that persisted nothing but attempted a write or edit (refused) or read a missing file extends it at most notFoundStreakCap turns in a row, any other turn extends it (LEON-YIELD-F2)")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#writeAttempt?" :text "true when a reply held a write or edit step, whatever became of it")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#modelEscalationReceipt" :text "the (:escalate :reason :seen :tried) receipt of a model's own escalate op, none when the reply held none; the run stops at once with signal modelEscalated instead of running on to a readStreak stop (LEON-YIELD-F3)")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#modelEscalationReason" :text "the reason text of a model's own escalate op, from either the (:escalate ...) form or a (:step :op escalate) step")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#dedupeReadOps" :text "drops a read-only step that repeats an earlier one of the same reply ignoring :id, when no mutating step lies between them; returns the kept steps and how many were dropped, which the reply reports as (:duplicateOps :dropped n) together with the byte-identical steps parse already dropped (LEON-YIELD-F4)")
(:doc :symbol "asl/packages/asl-agent/tests/leonYieldTest.asl#" :text "LEON-YIELD F2, F3, F4 driven through main with a scripted provider and a red declared gate: refused writes do not end as readStreak while pure reads do, a model escalate ends as modelEscalated with its reason, reads differing only in :id run once and the reply names the drop; plus pure unit asserts of the helpers")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#stalledTurnCapIn" :text "consecutive stalled turns (nothing persisted; a missing-file read or an attempted write or edit) after which the run stops as readStreak with cause refusedWrites or notFound; :agentLoop :stalledTurnCap, default 12 adopted (LEON-YIELD-F2B)")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#opRowText" :text "the (:op :turn N :name OP :file F :status ok|err [:error CODE]) journal row of one applied step, written by liveOpRow! in liveExecOps!; steps without a name (done, escalate) and pool ops write none (TRIAL-LEON-OPROWS)")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#readOnlyTail" :text "how many turns at the end of the history sent only read-only steps, skipping turns whose only non-read steps were refused writes; at readOnlyTurnCapIn (adopted 12, :agentLoop :readOnlyTurnCap) the run stops as readStreak with cause readOnly, with no exemption before the first write (LEON-READLOOP)")
(:doc :symbol "asl/packages/asl-agent/tests/opRowsTest.asl#" :text "TRIAL-LEON-OPROWS: a read, a write outside :owns and an owned edit leave three op rows ok, err ERR_OWNS, ok; LEON-READLOOP: twenty reads stop at the cap with cause readOnly, a configured cap applies, reads alternating with gate steps do not stop")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#readOnlyEntry?" :text "a history turn is non-progress for the readOnly cap when it persisted no write (history :wrote 0) and every step is a read-only op; a turn with a refused write is refusedWriteEntry? instead, which neither counts nor resets (LEON-WRITE-REJECT-LOOP)")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#refusedWriteEntry?" :text "entry: true when the turn persisted no write, attempted a write, edit, delete or txn, and sent nothing but reads beside it; readOnlyTail skips such a turn, stalledTurnCap bounds a run of them (LEON-WRITE-REJECT-LOOP)")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#liveOpRow!" :text "writes the op row; a step without a usable :op is named ? with status err and the receipt's error code (ERR_NO_OP when none); done, escalate and pool ops write none (LEON-OPROWS-M2)")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#toolRootOr" :text "the repo root a run's tool ops use: its :toolRoot (a built tree, the base build) when given, else the checkout it runs in; check, test and forms then run <toolRoot>/bin/asl with the run root as cwd, so a unit that edits CLI sources is not refused ERR_NATIVE_STALE (LEON-TOOLROOT) Substituting it for the repo root also moves what liveSetup! and the dry run read from the repo root: asl/grammar/calibration.asn for the code route and the system prompt are read from the toolRoot tree, not from the worktree.")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#toolRootUsable?" :text "true when the run has no :toolRoot or its <toolRoot>/bin/asl is a file with the owner execute bit; execute refuses a run otherwise with ERR_TOOLROOT before any step")
(:doc :symbol "asl/packages/asl-agent/tests/toolRootTest.asl#" :text "LEON-TOOLROOT: symlink-clone trees, one whose bin/asl answers ERR_NATIVE_STALE and one that logs its calls; with :toolRoot the check op runs the good tree with the run root as cwd, without it the stale tree refuses as before")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#MemoEntry" :text "schema of a memoized asl run: the run, its run id rid and its age")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#contextTokensForIn" :text "model contextTokens split gatewayText: the explicit contextTokens when truthy, else the context tokens of the model alias row in gatewayText, else a family default for the alias or the row name, else the small default")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#contextTokensAt!" :text "model contextTokens split path: contextTokensForIn with the gateway text read from path, which is not read when contextTokens is truthy")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#contextTokensFor!" :text "model contextTokens split: contextTokensAt! with the gateway config path from ASL_GATEWAY_CONFIG and HOME")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#gatewayConfigPathFrom" :text "configured home: the configured path when non-empty, else home followed by /.asl/gateway.asn")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#aliasRowText" :text "text alias: the model row of alias in gateway text, from its opening to the next model row or the end, or empty when the alias is empty or absent")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#freezeTranscriptHistory" :text "history keepTurns toolCapBytes keptCapBytes latestCapBytes: the history with turns before the compaction cut frozen, the kept turns rendered under the larger of the tool and kept caps, and the latest turn under the larger of the tool and latest caps")
(:doc :symbol "asl/packages/asl-agent/src/gateIntegrity.asl#unwiredFns" :text "implNow implHead: the names of functions defined in implNow but not at implHead whose name occurs exactly once across all implNow texts, so are never called")
(:doc :symbol "asl/packages/asl-agent/src/gateIntegrity.asl#revertTimeout" :text "timeout: timeout when under 60, else at least 900")
(:doc :symbol "asl/packages/asl-agent/src/gateIntegrity.asl#revertTimeoutWithin" :text "timeout, left: revertTimeout cut to the seconds of wall left, at least 1; none keeps the floor")
(:doc :symbol "asl/packages/asl-agent/src/gateIntegrity.asl#gateIntegrityWithin!" :text "gates, owns, root, results, timeout, env, written, watch, base, wall: gateIntegrityWritten! whose revert runs end inside the wall left; under revertMinSec the check ends unfinished with :revertKind wall")
(:doc :symbol "asl/packages/asl-agent/src/gates.asl#gateTimesPath" :text "no args: the path of gateTimes.asn under HOME/.asl/run")
(:doc :symbol "asl/packages/asl-agent/src/gates.asl#gateRaisedSec" :text "recordedMs: the raised gate timeout in seconds, 1.5 times the recorded milliseconds rounded up")
(:doc :symbol "asl/packages/asl-agent/src/gates.asl#gateSuiteOf" :text "cmd: the last whitespace-separated token of cmd ending in .asl or .sh as an option, none when there is none")
(:doc :symbol "asl/packages/asl-agent/src/gates.asl#gateTimeoutCapSec" :text "no args: the cap on a raised gate timeout, the constant 3600 seconds")
(:doc :symbol "asl/packages/asl-agent/src/gates.asl#gateTimeoutFit" :text "recordedMs timeoutSec: true when 1.5 times the recorded time exceeds timeoutSec, so the gate would not fit its timeout")
(:doc :symbol "asl/packages/asl-agent/src/gates.asl#gateTimeoutFit!" :text "timesPath cmd timeoutSec: the recorded milliseconds of the suite named in cmd when gateTimeoutFit says it would not fit timeoutSec, none when there is no suite, no record or it fits")
(:doc :symbol "asl/packages/asl-agent/src/gates.asl#readGateTimes!" :text "path: the suite to recorded milliseconds map parsed from the gate times file at path, empty when the file is absent or unreadable")
(:doc :symbol "asl/packages/asl-agent/src/gitOps.asl#runGatesIn!" :text "gates root timeoutSec env watch timesPath: runs the id and command gates in order under root and returns one record each; after a failed build.sh gate the rest are skipped afterBuildFail, and a gate whose recorded time times 1.5 would not fit timeoutSec runs with a raised timeout up to 3600 or is skipped gateTimeoutFit")
(:doc :symbol "asl/packages/asl-agent/src/journal.asl#checkpoint!" :text "w rootDir journalPath sessionId turn: writes a checkpoint row with the turn and the current patch to the journal when the hand-back patch exists and differs from the saved one, true when written")
(:doc :symbol "asl/packages/asl-agent/src/journal.asl#resumeApplied" :text "w2 rootDir patch label r: the result of applying a saved patch on resume; a nonzero exit gives the Written with a label and cut message as the failure, otherwise the patch file is removed and its relative path recorded")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#liveTxnTargets" :text "op: the file paths of the write and edit sub-steps of a live txn op, without empty paths")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#opKey" :text "op: a key string of an op's fields other than form and id, each name and value prefixed by its length and a colon")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#readOnlyOps" :text "no args: the op names that count as read-only: read query q check outline tree diff tools help gitDiff gitLog gitShow note observe search research crawl intent intel")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#readOnlyTurnCapIn" :text "cfgText: the readOnlyTurnCap of the agentLoop block in cfgText when it is a positive integer, else the default of 12")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#resumed" :text "ra st: the RunArgs of ra with task, mode hint, owns, gates, base and, when ra has none, the intent taken from the resume state")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#reuseGateDigest?" :text "previous current: true when a previous digest exists and equals current")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#worktreeDigest!" :text "owns root: the sha256 of the git diff against HEAD plus the paths and contents of untracked files under owns")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#buildDryRunPreview!" :text "vendor mode rootDir model timeout queueTimeout env: the dry-run info of dryRunInfo! with its last flag false")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#commitFields" :text "commit: the result fields for a pair of sha and note, a commit with commitIndexStale when the note is set, else a commitError with the escaped reason, else empty")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#commitLanded!" :text "env rootDir r: for a vcs receipt with code 0 journals the commit and, when the receipt marks the index stale, a stale marker and returns the sha pair, otherwise defers to committed!")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#modelFamily" :text "name: the lower-cased last path segment of name with a kimi- prefix and a -thinking suffix removed")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#specCheckWanted?" :text "specCheck status targets: true when specCheck is set, the status is ok and targets is not empty")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#specTargets" :text "written dirty: the distinct paths of written followed by dirty")
(:doc :symbol "asl/packages/asl-agent/src/txn.asl#largeFileHint" :text "no args: the hint text telling the model to change an existing file with one edit per fn rather than resending it")
(:doc :symbol "asl/packages/asl-agent/src/txn.asl#retryTemplate" :text "tf sizeBytes: the retry step template for file tf, a write step with raw content under 4096 bytes, otherwise an edit step with placeholder old and new text")
(:doc :symbol "asl/packages/asl-agent/tests/commitGuardWireTest.asl#runTests" :text "no args: runs the agent loop in temp git repos with a commit guard message and checks how the guard verdict shows in the journal")
(:doc :symbol "asl/packages/asl-agent/tests/contextAliasTest.asl#runTests" :text "no args: checks contextTokensForIn and contextTokensFor for a known alias, an unknown alias, a prefix alias and a plain alias row")
(:doc :symbol "asl/packages/asl-agent/tests/gateBuildFailSkipTest.asl#runTests" :text "no args: checks that runGatesIn! skips the gates after a failed build gate")
(:doc :symbol "asl/packages/asl-agent/tests/gateDigestLoopTest.asl#runTests" :text "no args: runs the loop with an unchanged and a changed worktree between gates and compares how many gate runs each makes")
(:doc :symbol "asl/packages/asl-agent/tests/gateDigestReuseTest.asl#runTests" :text "no args: checks reuseGateDigest? for equal, different and missing digests and worktreeDigest! on a temp repo")
(:doc :symbol "asl/packages/asl-agent/tests/gateRevertCompileTest.asl#runTests" :text "no args: checks the gate revert verdicts for a compile error, an assertion failure and both")
(:doc :symbol "asl/packages/asl-agent/tests/gateRevertTimeoutTest.asl#runTests" :text "no args: checks the gate revert decision for a timed-out gate against an assertion failure")
(:doc :symbol "asl/packages/asl-agent/tests/gateTimeoutGuardTest.asl#runTests" :text "no args: checks gateTimeoutFit! against a fixture gate times file for a slow and a fast suite")
(:doc :symbol "asl/packages/asl-agent/tests/gateTimeoutRaiseTest.asl#runTests" :text "no args: checks that runGatesIn! raises or skips gate timeouts from a fixture gate times file")
(:doc :symbol "asl/packages/asl-agent/tests/gitInitKit.asl#initGitRepoWith!" :text "root name email files: initializes a git repo on main in root with the user name and email, adds files and commits them as initial, true when every step succeeds")
(:doc :symbol "asl/packages/asl-agent/tests/gitOpsScratchTest.asl#runTests" :text "no args: checks the git ops scratch handling in a temp repo and its scratch sibling")
(:doc :symbol "asl/packages/asl-agent/tests/journalResumeAppliedTest.asl#runTests" :text "no args: checks resumeApplied for a failed apply and a successful one against a temp patch file")
(:doc :symbol "asl/packages/asl-agent/tests/killCheckpointDriver.asl#main" :text "args: the driver for killCheckpointTest, which sets up a git repo at the root argument, applies an edit and then stalls with a long sleep so the test can kill it")
(:doc :symbol "asl/packages/asl-agent/tests/killCheckpointTest.asl#runTests" :text "no args: runs the kill checkpoint driver bounded, then checks the journal it left for a checkpoint row")
(:doc :symbol "asl/packages/asl-agent/tests/leonYieldTest.asl#runTests" :text "no args: runs recorded loops of reads, refused writes, an escalation and duplicate ids and checks when the loop yields")
(:doc :symbol "asl/packages/asl-agent/tests/mainBatchDriver.asl#main" :text "args: the driver of the main batch test, which runs its rows loop for the root directory argument or the current repo")
(:doc :symbol "asl/packages/asl-agent/tests/modelFamilyTest.asl#runTests" :text "no args: checks that modelFamily maps plain, vendor-prefixed, kimi- and thinking names of one model to its family name")
(:doc :symbol "asl/packages/asl-agent/tests/noChangeOkTest.asl#runTests" :text "no args: checks that a run whose edit is rejected does not end ok and journals the noChange signal")
(:doc :symbol "asl/packages/asl-agent/tests/opRowsTest.asl#runTests" :text "no args: runs recorded loops of mixed read, write, gate and run ops and checks how ops are counted into rows")
(:doc :symbol "asl/packages/asl-agent/tests/pathGuardInputTest.asl#runTests" :text "no args: checks the path guard on op input using an exec environment with stubbed callbacks")
(:doc :symbol "asl/packages/asl-agent/tests/readCapQueryTest.asl#runTests" :text "no args: checks that turns made only of query, search, intel or outline ops count as read-only, and that refused writes neither count nor reset the read-only tail")
(:doc :symbol "asl/packages/asl-agent/tests/readNudgeTest.asl#runTests" :text "no args: runs a recorded loop of reads under a readOnlyTurnCap of 6 and checks the read nudge")
(:doc :symbol "asl/packages/asl-agent/tests/revertGateTest.asl#runTests" :text "no args: runs (:step :op gate :revert F) on a scratch repo and checks red, not red, new-file, unchanged, owns and bad-rev answers, that F is restored byte for byte, that git show REV:F > F in a run is refused, that a timeout on revert is unknown not red, and that a mid-revert snapshot is swept back unless its lock is live (LEON-REVERT-NO-RESTORE)")
(:doc :symbol "asl/packages/asl-agent/tests/readStreakRejectedWritesTest.asl#runTests" :text "no args: checks the read streak stop for a run of rejected txn writes against a run of reads")
(:doc :symbol "asl/packages/asl-agent/tests/retryTemplateTest.asl#runTests" :text "no args: checks retryTemplate for a small file and a large one")
(:doc :symbol "asl/packages/asl-agent/tests/revertTimeoutFloorTest.asl#runTests" :text "no args: checks revertTimeout gives a 300 s gate timeout 900 s, keeps a longer one and keeps one under 60 s")
(:doc :symbol "asl/packages/asl-agent/tests/finishWallHookTest.asl#runTests" :text "no args: checks through the CLI that a 300 s grader and a revert gate past the 900 s floor both end on the wall inside the outer bound, with a receipt")
(:doc :symbol "asl/packages/asl-agent/tests/revertWallTest.asl#runTests" :text "no args: checks a revert check with 14 s of wall and a 900 s floor ends unfinished near the wall with its gate child gone and the change restored, and the grader wall")
(:doc :symbol "asl/packages/asl-agent/tests/specDirtyTest.asl#runTests" :text "no args: checks specTargets merges written and dirty paths without duplicates and specCheckWanted? is true only with an ok status and targets")
(:doc :symbol "asl/packages/asl-agent/tests/specSystemTest.asl#runTests" :text "no args: checks the grader system text does not fail a change for missing process evidence and names the commit line as a harness check")
(:doc :symbol "asl/packages/asl-agent/tests/toolRootTest.asl#runTests" :text "no args: builds two tree clones and checks a toolRoot is used for tool ops and a toolRoot without bin/asl is refused ERR_TOOLROOT")
(:doc :symbol "asl/packages/asl-agent/tests/txnLinkedHintTest.asl#runTests" :text "no args: checks the hint that linked edits across a txn must be sent together as one when a single edit cannot pass")
(:doc :symbol "asl/packages/asl-agent/tests/txnSnapshotTest.asl#runTests" :text "no args: runs a scripted txn edit in a fixture repo and checks liveTxnTargets keeps only the write and edit targets")
(:doc :symbol "asl/packages/asl-agent/tests/unwiredRetryTest.asl#runTests" :text "no args: checks the unwired function retry is returned for rounds under the cap and spent at the cap")
(:doc :symbol "asl/packages/asl-agent/tests/vacuousAtDoneTest.asl#runTests" :text "no args: runs the loop with a gate that passes vacuously and checks how a done with no real assertion is handled")
(:doc :symbol "asl/packages/asl-agent/tests/wholeWriteTest.asl#runTests" :text "no args: checks that a whole write of an existing 5000-byte file is rejected while a 100-byte file is allowed")
(:doc :symbol "asl/packages/asl-agent/tests/wireCheckTest.asl#runTests" :text "no args: checks the wiring check on fixtures where a helper is called, left uncalled or removed")
(:doc :symbol "asl/packages/asl-agent/src/gitOps.asl#runGatesPar!" :text "gates root timeoutSec env watch limit: runs the gates with at most limit at once, using the recorded gate times, and returns one record list per gate in gate order")
(:doc :symbol "asl/packages/asl-agent/tests/gatesParallelTest.asl#runTests" :text "no args: checks that gates run up to the parallelism cap with overlapping stamps, keep gate order in the result and mark pool rows; true when all hold")
(:doc :symbol "asl/packages/asl-agent/tests/turnTimeTest.asl#runTests" :text "no args: runs a scripted session in a temp git repo and checks one (:turnTime :turn N :modelMs :gateMs :toolMs :totalMs) journal row per turn; true when all hold")
(:doc :symbol "asl/packages/asl-agent/src/agentConfig.asl#agentLoopBlock" :text "args: the text of a .asl.config.asn; returns (some block) with the text of the first top-level :agentLoop group, delimiters included, or none when the group is absent; pure, reads no file")
(:doc :symbol "asl/packages/asl-agent/src/agentConfig.asl#agentLoopValue" :text "args: config text and a key such as :baseline; returns (some value) with the value token of that top-level key of the :agentLoop group, quotes removed, or none when the group or the key is absent; a key in a doc string, a nested group or another group never matches; pure")
(:doc :symbol "asl/packages/asl-agent/src/agentConfig.asl#positiveInt" :text "args: a string; returns (some n) when it is non-empty, all ASCII digits and n is greater than zero, else none (empty, signed, decimal, zero or not an Int64); pure")
(:doc :symbol "asl/packages/asl-agent/src/agentConfig.asl#configProblems" :text "args: config text; returns one message per invalid :agentLoop value: a trailing key with no value, a non-positive-integer :readOutlineBytes :wallReserveSec :wallGateMinSec :gateVacuousRounds or :gateMaxDescendants, a :baseline or :specCheck that is not true or false, an empty :graderIntent or :graderProfile; an empty list means the config is valid and the run may start; pure")
(:doc :symbol "asl/packages/asl-agent/src/agentConfig.asl#configText!" :text "args: a root directory; returns the content of <root>/.asl.config.asn, or the empty string when it cannot be read; effect: one file read, never an error")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#ownedDigest!" :text "args: the owned paths and a root; returns the sha256 of the owned dirty state: git diff --binary HEAD limited to the owned paths plus the contents of untracked unignored files under them; effect: runs git and reads files; a lower rung hands this value over as :inheritedBase, and a run ends ok without work of its own only when its journaled :inheritedBase row equals the current value")
(:doc :symbol "asl/packages/asl-agent/tests/finishWallBudgetTest.asl#runTests" :text "a run whose wall budget leaves less than :wallFinishMinSec for the finish writes a partialReceipt row first, skips the spec-check grader as (:verdict skipped :reason wallBudget) and exits needsReview before the outer bound; with room left the grader runs")
(:doc :symbol "asl/packages/asl-agent/src/providers.asl#parseScriptFixture" :text "a script fixture parses to its turns, grader fields and :gradeDelayMs; an unquoted value such as :gradeDelayMs 8000 ends at the next space or paren")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#wallBounded?" :text "args: a wall budget option; true only for a positive budget, 0 and none mean unbounded")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#finishLeftFor" :text "args: wall budget option, reserve seconds, elapsed seconds; the seconds left for the finish, none when the budget is none or 0")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#finishShortFor" :text "args: finish seconds left and the minimum; true when a limit exists and is below the minimum")
(:doc :symbol "asl/packages/asl-agent/tests/journalClipTest.asl#runTests" :text "fallbackRowText and focusTail cut a CJK tail back to its character start instead of mid-character")
(:doc :symbol "asl/packages/asl-agent/src/grounding.asl#toolCard" :text "the tool card text for a ranking of builtin names: :wrong, :sigs, :lookup, within toolCapTokens")
(:doc :symbol "asl/packages/asl-agent/src/grounding.asl#toolCardCapped" :text "toolCard with an explicit token cap; sigs are filled in rank order until the byte budget (cap*4) is spent")
(:doc :symbol "asl/packages/asl-agent/src/grounding.asl#toolCapTokens" :text "2000, the tool card cap counted as bytes/4")
(:doc :symbol "asl/packages/asl-agent/src/grounding.asl#toolErrNames" :text "builtins whose names or arguments the journals show models getting wrong, most first; measured 2026-11-12")
(:doc :symbol "asl/packages/asl-agent/src/grounding.asl#toolWrongNames" :text "invented spelling to the real builtin, measured in the journals: println! println, isSome some?, readFile fileReadString, replaceAll stringReplace")
(:doc :symbol "asl/packages/asl-agent/src/grounding.asl#errorCounts" :text "journal text to (name count) pairs from unbound symbol, ERR_ARITY and argument to receipts, count descending then name")
(:doc :symbol "asl/packages/asl-agent/src/grounding.asl#rankedBuiltins" :text "the names of an errorCounts list that the checker knows as builtins, in rank order")
(:doc :symbol "asl/packages/asl-agent/src/grounding.asl#tokensOf" :text "bytes/3 rounded up, a conservative token bound (code runs about 3 chars per token) used for the tool card cap")
(:doc :symbol "asl/packages/asl-agent/src/grounding.asl#toolLookup" :text "the lookup row text: ASL is not on the web, with the ops that work today for repo names, one function, file shape, builtin signature and op help")
(:doc :symbol "asl/packages/asl-agent/src/grounding.asl#namesAfter" :text "the name-character runs that follow each occurrence of a marker in a text")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#escalateUnread" :text "owns text touched: the owned files (paths with an extension, no glob) whose name the escalate form text mentions and that no step of the run named yet; the loop refuses the first such escalation with a read hint (LEON-ESCALATE-UNREAD)")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#escalateRefusal" :text "unread: the (:escalateRefused :unread (...) :do ...) form added to the turn's answer when an escalation is refused for unread owned files (LEON-ESCALATE-UNREAD)")
(:doc :symbol "asl/packages/asl-agent/tests/escalateUnreadTest.asl#runTests" :text "no args: checks escalateUnread and runs recorded loops where an escalation naming unread subject.txt is refused, the one after a read stops the run, and one naming no owned file stops at once (LEON-ESCALATE-UNREAD)")
(:doc :symbol "asl/packages/asl-agent/src/gates.asl#gateWholeTree?" :text "cmd: true when the gate command runs noSelfHostTest.asl or build.sh, which check the whole tree whatever a turn edited")
(:doc :symbol "asl/packages/asl-agent/src/gates.asl#gatesForTurn" :text "gates doneTurn: all gates on the done turn or when every gate is whole-tree, else the gates without the whole-tree ones, order kept")
(:doc :symbol "asl/packages/asl-agent/tests/gateDeferWholeTreeTest.asl#runTests" :text "no args: checks whole-tree gate deferral to the done turn and the revertTimeout reason on a timed-out revert run")
(:doc :symbol "asl/packages/asl-agent/tests/gateDeferLoopTest.asl#runTests" :text "no args: recorded loops with a unit gate and a build.sh gate: the write turn runs only the unit gate and is not terminal, the done turn runs the whole-tree gate, and a red whole-tree gate at done keeps the run from its terminal check (PERF-VACUOUS-GATES-AT-DONE)")
(:doc :symbol "asl/packages/asl-agent/tests/busTest.asl#runTests" :text "the terminal-run inbox on a scratch HOME: whole rows, lock held elsewhere blocks an emit, waitFor returns the row, the deadline returns none, a row landing mid-wait is found, a torn last line is not a row")
(:doc :symbol "asl/packages/asl-agent/tests/busEmitLoopTest.asl#runTests" :text "no args: a recorded run with :unit busUnitX on a root whose :agentLoop :busHome is a scratch dir leaves exactly one bus row for that unit with its exit code and journal; a run without :unit leaves none (SIGNAL-LEON-DONE)")
(:doc :symbol "asl/packages/asl-agent/src/exec.asl#sweepRevertBackups!" :text "root: puts back every file a run killed mid-revert left at its :rev text (from the entry's .bak, or removes it when it was absent), skipping entries whose .lock a live run holds, drops the entries and answers the restored paths; runLoop calls it before the baseline (LEON-REVERT-NO-RESTORE M2)")
(:doc :symbol "asl/packages/asl-agent/tests/revertSweepLoopTest.asl#runTests" :text "no args: a dead run's revert entry is swept at the next run's start: the file is restored, the entry removed and the journal holds (:revertSwept :files (...)) (LEON-REVERT-NO-RESTORE)")
(:doc :symbol "asl/packages/asl-agent/tests/helpBuiltinTest.asl#runTests" :text "run the builtin help cases: help on a builtin answers ok with the checker signature line and the receipt shows it, an op name keeps the op help, an unknown name gets no line")
(:doc :symbol "asl/packages/asl-agent/tests/opHintsTest.asl#runTests" :text "run the op-hint cases: test with :path and the tests synonym are read as the registered op with a canonical note, help takes :about, a step with no op answers ERR_NO_OP with its inferred form, the blocked-path repeat key ignores ./ and the absolute spelling, a run outside root offers the root-relative run, an unbalanced refusal names line and column")
(:doc :symbol "asl/packages/asl-agent/tests/opHintsLiveTest.asl#runTests" :text "run a live loop with a red gate three times: a write sent as the canonical op, under the synonym savefile and with the :filename key is restored each time, and the journal names the canonical op")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#readsIn" :text "a journal text's read summary for the receipt: :n read-only op rows (note excluded), :distinct places, and the top readsTop places by count then latest turn as (:at path#symbol|path:range|op :count C :last T); empty when nothing was read")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#unnamedOnly?" :text "true when a reply's ops are all steps naming no op, a turn that read nothing")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#shapeRow" :text "the (:turn N :shape :repaired (..) :left (..)) journal row for a reply whose step forms were rewritten or left, none when both lists are empty")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#repairedIn" :text "the receipt's :repaired field from a journal's shape rows: :turns, then each kind with its count under :kinds and :left; empty without a row")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#LoopResult.repaired" :text "the :repaired receipt field built by repairedIn, empty when no step shape was rewritten or left")
(:doc :symbol "asl/packages/asl-agent/src/toolCalls.asl#ShapeFix" :text "a reply with its step forms made canonical, and the kinds rewritten and left")
(:doc :symbol "asl/packages/asl-agent/src/toolCalls.asl#ShapeFix.text" :text "the reply text after the rewrites")
(:doc :symbol "asl/packages/asl-agent/src/toolCalls.asl#ShapeFix.repaired" :text "one kind per rewritten form: argKey, emptyStep, bareOp, opQuote, argQuote")
(:doc :symbol "asl/packages/asl-agent/src/toolCalls.asl#ShapeFix.left" :text "one kind per step form left as sent because it does not map one to one: argKey, emptyStep, opShape")
(:doc :symbol "asl/packages/asl-agent/src/toolCalls.asl#canonSteps" :text "rewrites top-level (:step ...) forms in arg_key, bare-op or single-quoted shape to the canonical step and drops an empty (:step@@) beside a named step; strings and fenced blocks are skipped")
(:doc :symbol "asl/packages/asl-agent/tests/writeFailTopTest.asl#" :text "Node2 2026-11-17 malformed step replies through canonSteps and turnReply, the receipt tally, and script-provider runs for arg_key writes, unnamed turns and a held vacuous finished turn.")
(:doc :symbol "asl/packages/asl-agent/tests/writeFailTopTest.asl#runTests" :text "LEON-WRITE-FAIL-TOP gate on recorded node2 replies and script-provider runs: an alternate step shape that maps one to one is rewritten and counted under :repaired, one that does not is left and counted under :left, and a turn of unnamed steps holds the read streak")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#streakIn" :text "the streak count of the journal's last :signal :readStreak row (the leading number of its :reason), 0 when the run did not stop on one")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#readAtOf" :text "where a read step looked: #symbol, else :start-end or :from-to as given, else empty; journalled as :at on the op row")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#opRowAt" :text "opRowText with :at \"place\" before :status when place is not empty, the plain row otherwise")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#readsTop" :text "20, the most places a receipt's :reads lists")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#readsKeyChars" :text "120, the most characters of one place a receipt's :reads shows; places are tallied by their whole name")
(:doc :symbol "asl/packages/asl-agent/tests/receiptReadsTest.asl#" :text "Gate: readsIn, streakIn, readAtOf and opRowAt on journal text as a live run writes it, including the readsTop and readsKeyChars caps and the 4 KB bound")
(:doc :symbol "asl/packages/asl-agent/tests/receiptReadsTest.asl#runTests" :text "runs the receipt reads gate: places, ranking, caps, streak and the op row :at")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#" :text "LEON-RUN-HOME-JAIL, B-02: the boundary of a unit child (run, manage, gate): an allowlisted environment and an OS sandbox, sandbox-exec on macOS and bwrap on Linux, with writes only under the root and the jail home (its private caches inside), the shared caches read-only, the root's .git and the real HOME out of reach, no process information or signal beyond its own sandbox, loopback-only network unless the unit declares :net true; refused when no sandbox tool applies, lexical only by the opt-in row of <HOME>/.asl/config.asn (FABLE-BLIND-03)")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#childEnv!" :text "childEnvIn! with this process's HOME; the private caches are seeded only when the root carries bin/asl")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#jailOf!" :text "jailPlan! with the tool that applies now, the opt-in of this process's HOME and the shared caches as read-only sources")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#jailWrap!" :text "the child argv inside its jail: sandbox-exec with the generated profile, bwrap with its binds, unchanged when lexical, the refusal stub when refused")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#seatbeltProfile" :text "the sandbox-exec profile of a jail")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#bwrapArgs" :text "the bwrap argv prefix of a jail; not yet run on a Linux host")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#childEnvIn!" :text "the environment of a unit child: inherited rows by allowlist, then PWD, HOME, TMPDIR and the private cache directories, hidden names dropped; seed true clones the shared caches first")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#cacheSources!" :text "the shared cache directories that exist, by variable name: the inherited value, else the real home's default")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#seedCaches!" :text "clones each shared cache into its missing private directory (copy-on-write, bounded, corpus cache excluded) and re-seeds the private native CLI cache from the shared one on every call; returns one (cache, outcome) row per cache touched")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#jailPlan!" :text "the jail of one child with every input explicit: mode os with its tool, write and read directories, or refused, or lexical by opt-in")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#jailMode" :text "os with a tool, else lexical with the opt-in, else refused")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#lexicalOptIn!" :text "true when <realHome>/.asl/config.asn has :agentLoop (:jailLexicalOnly true)")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#refusedArgv" :text "the argv run in place of a refused child: prints ERR_RUN_SANDBOX_ABSENT and exits 126")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#absentNote" :text "the refusal line of a refused jail")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#linkFree!" :text "true when a path lies under base, has no .. segment and no existing part of it below base is a symlink (lstat); the harness creates, seeds and writes in a jail home only on such paths (JAIL-SEED-SYMLINK)")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#CliSource" :text "one shared native CLI pointer a private head may follow: the cli directory, its mtime, whether it is the head's own or borrowed from the tool root, and whether its source snapshot fits the root (LEON-JAIL-CLI-CACHE)")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#resyncNeeded?" :text "the gate of the re-seed: a missing private head, a shared pointer newer than it, or a private entry the root's sources moved past is looked at again; otherwise nothing is read beyond a stat per pointer (LEON-JAIL-CLI-CACHE)")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#pickSource" :text "what a private head becomes: the private entry when it fits the root, else the newest fitting shared entry (both stamped now), else the head's own shared pointer with its mtime, else the borrowed one with the verify stamp (LEON-JAIL-CLI-CACHE)")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#resyncCli!" :text "re-seeds the private native CLI cache from the shared one on every jailed call: each current head follows the entry pickSource names (the unit's own root may follow the tool root's entry when its sources fit it), the cli directory copied, never linked; one outcome per head touched, resync or failed (LEON-JAIL-CLI-CACHE)")
(:doc :symbol "asl/packages/asl-agent/tests/runJailHolesTest.asl#" :text "Gate FABLE-BLIND-03: a test op is a jailed unit child, cache variables are private, ps shows no other process's environment, no signal leaves the sandbox, a refused jail runs nothing, temporary files go under TMPDIR; fixtures only under /private/tmp/leonjail-holes-*")
(:doc :symbol "asl/packages/asl-agent/tests/runJailHolesTest.asl#runTests" :text "runs the jail holes gate")
(:doc :symbol "asl/packages/asl-agent/tests/runJailPlanTest.asl#" :text "Gate FABLE-BLIND-03: fail-closed mode and its opt-in row, cache seeding, read-only shared caches under the sandbox, bwrap argv and seatbelt profile rules; LEON-JAIL-CLI-CACHE: both platform plans expose the shared native CLI cache read-only and redirect the child to the private one, and no plan covers the decoy keys.env, gateway.asn or .env.free, which a jailed child cannot read; fixtures only under /private/tmp/leonjail-plan-*")
(:doc :symbol "asl/packages/asl-agent/tests/runJailPlanTest.asl#runTests" :text "runs the jail plan gate")
(:doc :symbol "asl/packages/asl-agent/tests/jailCliCacheTest.asl#" :text "Gate LEON-JAIL-CLI-CACHE and JAIL-SEED-SYMLINK: the private native CLI cache follows the shared one after a deploy, a jailed bin/asl check after a deploy runs without a native build in its private cache, and planted symlinks at the private cache, a private head or cli directory, a shared head or cli directory or the jail home are refused with nothing written through them; the re-seed reads only plain, size-capped files (a symlinked, FIFO or oversize deps, source or snapshot file is suspect, never read) and prunes unreferenced private copies; fixtures only under /private/tmp/leonjailcli-*")
(:doc :symbol "asl/packages/asl-agent/tests/jailCliCacheTest.asl#runTests" :text "runs the jail CLI cache gate")
(:doc :symbol "asl/packages/asl-agent/tests/jailCliCacheDriver.asl#" :text "one re-seed of a fixture private native CLI cache in its own process, so jailCliCacheTest bounds it through fleet/run (a FIFO must fail by the bound, not hang the suite)")
(:doc :symbol "asl/packages/asl-agent/tests/jailCliCacheDriver.asl#main" :text "args: home, shared cache, root, head names; prints (:rows :stamp) of one seedCachesWith! call")
(:doc :symbol "asl/packages/asl-agent/src/runOps.asl#spawnEnvOf!" :text "spawnEnv! over the given inherited rows")
(:doc :symbol "asl/packages/asl-agent/src/runOps.asl#withNet" :text "a run context whose children may use the network, from the unit's :net true")
(:doc :symbol "asl/packages/asl-agent/tests/runOsJailTest.asl#" :text "Gate LEON-RUN-HOME-JAIL: a unit child cannot change markers outside its root or the root's .git, cannot list the real HOME or connect off the machine, and inherits no credential or harness setting; fixtures only under /private/tmp/leonjail-fable-*")
(:doc :symbol "asl/packages/asl-agent/tests/runOsJailTest.asl#runTests" :text "runs the OS jail gate")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#baselineVerdicts?" :text "True when the journal's (:baseline :green :red) row names every declared gate and none sits in its :lost list, so the baseline produced a verdict for each")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#baselineRanWith?" :text "baselineRan? and the baseline produced verdicts for the gates; only then does an empty baselineGreen mean red before")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#heldRounds" :text "Number of greenDoneHeld rows in the run journal, the rounds a held green close spent against :gateVacuousRounds")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#vacuousShown" :text "The baseline-green gates a result lists as vacuousGates: none when the run ended ok, wrote a test file of its own and its integrity check ran a revert and saw failsOnRevert")
(:doc :symbol "asl/packages/asl-agent/src/runLoop.asl#baselineLost?" :text "True for a baseline gate row with no verdict: it timed out, was skipped or never ran (a spawn failure row has no stdout key)")
(:doc :symbol "asl/packages/asl-agent/src/retry.asl#junkReply?" :text "true when a reply text carries provider template leakage: it contains <ifm|, </ifm| or <ds_safety, or has the control-token opener <| at its start or right after its first word with no whitespace before it. Quoted code or markup with < and the empty string are not junk.")
(:doc :symbol "asl/packages/asl-agent/src/retry.asl#junkTurn" :text "the turn with its ok reply replaced by the transient error ERR_PROVIDER_JUNK, same provider and meta; retryTurnLoop! uses it so a junk reply is retried under the transient budget and never returned as ok")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#ReadSpan" :text "one read receipt as a span: the file, its first and last line numbers and the lines read")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#asnUnescape" :text "the string with ASN backslash escapes resolved, as the reader would yield it from a quoted literal")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#keptBefore" :text "the history entries before the last one that still have rendered text, the ones the model already has above")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#readSpanOf" :text "the span of an ok read receipt line that carries :content, or none for any other line")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#rereadAsk" :text "the (:reread :n N :owns (...) :do ...) form sent when n reads repeat lines already in context and nothing changed, asking for findings or done, or for the edit when the task owns files")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#rereadAskDue" :text "true when the repeated reads since the last write crossed 2 or a further step of 4 (6, 10, ...) on this turn: seen is the total so far, now the count added by this turn")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#rereadCount" :text "how many ok read receipts in the text carry the reread mark and the note that the lines are unchanged and already in context")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#rereadMarked" :text "a turn's receipts with every repeated read answered from the kept turns, paired with how many were answered that way; unchanged when no turn is kept")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#rereadStaleGot" :text "the receipts text with each reread note checked against the turns still kept: a note that points at a turn no longer kept is rewritten so the model is not sent to lines it cannot see")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#spanCovers" :text "true when big is the same file, contains the line range of small and holds exactly the same lines there")
(:doc :symbol "asl/packages/asl-agent/src/exec.asl#withNet" :text "the execution environment with its :net flag set to the given value, which is the unit's declared :net true or false")
(:doc :symbol "asl/packages/asl-agent/src/runOps.asl#withScratch" :text "the run context with its scratch list set to the given directories outside the root that a unit child may write")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#baselineRan?" :text "true when the baseline pass ran for this run: the run is not resumed and the :agentLoop :baseline setting is not false")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#redBefore?" :text "true when some gate was red before the work: with a baseline pass, a gate missing from the baseline green list, otherwise whether the session saw a red gate in its results")
(:doc :symbol "asl/packages/asl-agent/src/main.asl#rereadEntry?" :text "true when the journal entry lists operations, none of them wrote, and every one is a reread of content the session already shows")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#Jail" :text "the sandbox plan of a unit child: mode, sandbox tool, root, writable, readable and listable paths, the real home, whether network is allowed and a reason text")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#envKey" :text "the variable name of a NAME=value environment row, the whole row when it has no equals sign")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#secretName?" :text "true when the upper-cased variable name contains KEY, TOKEN, SECRET, PASSWORD, PASSWD, CREDENTIAL, AUTH, COOKIE or SESSION")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#cacheNames" :text "the six cache variable names a unit child never inherits and instead gets private rows for")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#passName?" :text "true when an inherited variable may pass to a unit child: it is not secret-looking and is on the plain allowlist or starts with LC_")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#scrubEnv" :text "the inherited rows that pass the allowlist and are not overridden, followed by the harness's own rows, which pass whatever their name")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#jailHome" :text "the jail home of a root, the directory root/.asl/run/agentLoop/home that holds the child's HOME (its TMPDIR is jailTmp, outside the tree)")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#jailTmp" :text "the child TMPDIR of a root: one directory per real root under /tmp, outside the task tree, created by childEnvIn! and bound writable by jailPlan!")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#envSignals!" :text "whether the env at a path accepts --ignore-signal and --default-signal, proven by running it with true; decides whether a bwrap child is wrapped")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#binTargetDir" :text "the directory of the resolved bin/asl target when it lies outside the real tool root, an empty string otherwise")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#binDirRefusal" :text "the refusal message when the resolved bin/asl target directory is the real HOME or above it, an empty string otherwise")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#jailCacheEnv!" :text "the private cache rows NAME=value for a jail home, creating each directory unless a symlink lies on its path; the test cache only in a linked worktree")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#cliHeadName" :text "the name of the head pointer file for a root in the native CLI cache: head followed by the root with each slash replaced by an underscore")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#currentHeads" :text "the head pointer names a unit child can start from: its own root's and the root of the inherited ASL_CLI_ROOT, without empty or repeated names")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#cloneKind!" :text "how this machine clones into a directory: clonefile on macOS, elsewhere reflink when a probe file clones inside it, otherwise none")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#cliCopyArgv" :text "the command that copies a cli directory as a clone: cp -cRp on macOS, cp -Rp with reflink auto elsewhere")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#seedHow" :text "how a private cache was seeded: clone when the clone worked, cliEntry for the native CLI cache, cold when the file system cannot clone, else a failed text")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#seedCachesWith!" :text "seeds each private cache of a jail home from its shared source by the given clone kind and returns one pair of cache name and outcome per cache it tried")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#seedReportText" :text "the seed report text: one (:seed :cache name :how outcome) line per row")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#jailTool!" :text "the sandbox tool that works right now, sandbox-exec or the bwrap path, proven by running true under it, or an empty string when none applies")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#lexicalJail" :text "a Jail in lexical mode with no sandbox tool, no write, read or list paths and no real home, for the given root and net flag")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#denialText?" :text "true when the text holds Operation not permitted or Read-only file system, the marks of a sandbox refusal")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#sandboxNote" :text "the note a unit receives when the OS sandbox refused an operation, listing what it may write, that it cannot read the real HOME, and the network limit unless the jail allows net")
(:doc :symbol "asl/packages/asl-agent/src/turn.asl#moduleWrite" :text "The write step for a reply that is only the text of the one owned .asl file, when its module header maps to that path without doubt; none otherwise")
(:doc :symbol "asl/packages/asl-agent/src/exec.asl#moduleMismatch!" :text "Why an .asl write is refused for its module header (a tests module outside tests/, or a test file given the module of the existing src file of its package), empty when it fits")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#toolRootRows!" :text "The env rows for a jailed asl call with ASL_CLI_ROOT set to the real root of the aslBin it runs, replacing an inherited one")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#ownedNewNote" :text "the opening words of the answer to a read of an owned file that does not exist yet: owned file does not exist yet")
(:doc :symbol "asl/packages/asl-agent/src/gateIntegrity.asl#gateIntegrityWithChanged!" :text "The gate integrity check over a given list of changed files: revert to the revision and require a gate to fail, or for an all-new implementation require a gate to fail on the mutant with exported fns cut to type defaults")
(:doc :symbol "asl/packages/asl-agent/src/gateIntegrity.asl#cutExports" :text "A module text with the body of every exported fn whose return type has a default cut to that default")
(:doc :symbol "asl/packages/asl-agent/tests/absorbArgKeyTest.asl#runTests" :text "ABSORB-AGENT gate on recorded node2 replies: a step form or op chain written as arg_key markup, with DSML parameter tags or a tool_call, function or invoke tail, runs as the step it names only when it maps to exactly one step")
(:doc :symbol "asl/packages/asl-agent/tests/absorbFileFormTest.asl#runTests" :text "ABSORB-AGENT K4 and K10 gate: a pasted source-file form is answered as file text with the write step, not as an undeclared op, in a step and inside a txn, and an :owns element of two paths joined by an escaped quote pair is read as those two paths")
(:doc :symbol "asl/packages/asl-agent/tests/absorbRawCorpusTest.asl#runTests" :text "raw binder corpus gate: the fixture corpus holds its 116 real replies with :raw fields and at least the 31 replies bound before still bind")
(:doc :symbol "asl/packages/asl-agent/tests/absorbRawCrossTest.asl#runTests" :text "raw binder gate on the recorded STD-BASE64 turn 1: a txn of two writes, each :raw content followed by its fenced block, binds each block by place with no raw field missing, so the reply is no longer the crossed one that was recorded")
(:doc :symbol "asl/packages/asl-agent/tests/absorbRawLayoutTest.asl#runTests" :text "raw binder layout gate: each of the grader's layouts either binds every :raw field right or binds nothing in the whole reply, never a wrong or partial binding")
(:doc :symbol "asl/packages/asl-agent/tests/absorbRawLowsTest.asl#runTests" :text "ABSORB-AGENT-LOWS gate: a :raw on a foreign key refuses the whole reply, an edit binds its tail blocks in the order its fields are written, prose between two tail blocks refuses the reply, and one block for two :raw slots refuses it")
(:doc :symbol "asl/packages/asl-agent/tests/gateNewModuleTest.asl#runTests" :text "GATEINTEGRITY-NEW-MODULE gate: a new module with a real test passes the integrity check by a mutant that fails the test by assertion and the module is restored byte for byte, a vacuous test still fails as gateVacuous, and a module that exists at the revert revision keeps the compile revert check")
(:doc :symbol "asl/packages/asl-agent/tests/greenDoneTest.asl#runTests" :text "LEON-GREEN-NO-DONE gate: a run whose gates are all green closes at once with a greenDone signal and an ok result without asking a further turn, a :commit true run commits with a subject line, and a gate that turns green by changing the owned file without a model write is run again instead of reusing its red result")
(:doc :symbol "asl/packages/asl-agent/tests/jailSeedAfterGateTest.asl#runTests" :text "LOOPRED-JAIL-SEED gate: after a gate env on a fixture root without bin/asl left the private nativeCli empty, an asl read op still exits 0 and the seeded nativeCli holds only the active cli directories")
(:doc :symbol "asl/packages/asl-agent/tests/jailTaskHeadTest.asl#runTests" :text "jail task head gate on fixture trees with fixed file times: a task with the tool's CLI sources and no head of its own borrows the tool's binary, an old task head whose entry fits its sources is restamped without a rebuild, and a task whose sources differ or whose entry no longer fits them stays old")
(:doc :symbol "asl/packages/asl-agent/tests/jailToolHeadTest.asl#runTests" :text "LEON-STEP-BODY-LOST gate: for a task rooted in its own repository the tool root's private head is not older than its sources when the CLI snapshot matches them, and a CLI whose snapshot differs stays older than them")
(:doc :symbol "asl/packages/asl-agent/tests/leonPoolJunkTest.asl#runTests" :text "PROVIDER-JUNK-RETRY gate on the blocking and the pool path: a reply with template leakage then a valid step gives one retry row and the valid turn, and junk on every attempt ends with ERR_PROVIDER_JUNK in the journal")
(:doc :symbol "asl/packages/asl-agent/tests/moduleTrackedTest.asl#runTests" :text "module header check gate: every .asl file git ls-files lists, written back as it is, is accepted, so the check refuses no file the workspace already tracks")
(:doc :symbol "asl/packages/asl-agent/tests/moduleWriteTest.asl#runTests" :text "bare module reply gate: a bare (module ...) text, also in one fenced block, is the write of the one owned .asl file byte for byte with one final newline only when its header maps to that path without doubt, else nothing is written")
(:doc :symbol "asl/packages/asl-agent/tests/procTreeKit.asl#ProcRow" :text "one ps row with fields pid, ppid, stat and args (the whole command line)")
(:doc :symbol "asl/packages/asl-agent/tests/procTreeKit.asl#anyLive!" :text "true when the current ps listing holds a non-zombie process whose pid is in the list")
(:doc :symbol "asl/packages/asl-agent/tests/procTreeKit.asl#hasArgs?" :text "true when the command line of some row contains the given text")
(:doc :symbol "asl/packages/asl-agent/tests/procTreeKit.asl#hostRows!" :text "the parsed rows of ps -ww -eo pid,ppid,stat,args run under fleet limits, an empty list when ps fails")
(:doc :symbol "asl/packages/asl-agent/tests/procTreeKit.asl#liveNaming!" :text "the pids of treeNaming! for a marker")
(:doc :symbol "asl/packages/asl-agent/tests/procTreeKit.asl#parseRow" :text "a ProcRow from one ps line, the words after the third joined as args; none when the line has fewer than four words or its pid is not a positive number")
(:doc :symbol "asl/packages/asl-agent/tests/procTreeKit.asl#probeSeesSelf!" :text "true when the ps listing holds the test process itself, the positive control for a claim that nothing names a root any more")
(:doc :symbol "asl/packages/asl-agent/tests/procTreeKit.asl#sleeperCmd" :text "a shell command that sleeps 40 s as the child of a shell carrying the fixture root on its command line")
(:doc :symbol "asl/packages/asl-agent/tests/procTreeKit.asl#treeIn" :text "the non-zombie rows whose command line contains the marker, plus every non-zombie descendant of them")
(:doc :symbol "asl/packages/asl-agent/tests/procTreeKit.asl#treeNaming!" :text "treeIn over the current ps listing for a marker")
(:doc :symbol "asl/packages/asl-agent/tests/providerJunkRetryTest.asl#runTests" :text "PROVIDER-JUNK-RETRY gate over a scripted transport: the four measured junk replies are retried as provider junk, junk then a valid reply yields the valid turn, and junk on every attempt ends with the error code")
(:doc :symbol "asl/packages/asl-agent/tests/providerWaitRowTest.asl#runTests" :text "WRITE-STAGE-YIELD gate: each provider retry pause appends one providerWait row with its turn and seconds to the run journal before it sleeps, and the wrapper returns what the wrapped sleep returned")
(:doc :symbol "asl/packages/asl-agent/tests/rawAdjacentTest.asl#runTests" :text "AGENT-AUDIT-FIX gate on the single-block exception of the raw binder: a quoted gate output, a block quoted between other steps, a block before another write or txn step and a block after another step are never written into a :raw write, which needs the block adjacent before its form")
(:doc :symbol "asl/packages/asl-agent/tests/readMissingArgTest.asl#runTests" :text "K9-MISSING-ARG gate: a read step with no :file is refused with ERR_MISSING_ARG and a ready read of the first owned file, a misspelt path within two edits of one existing file is read there and reported as repaired, and a read of an owned file that does not exist yet is answered without an error")
(:doc :symbol "asl/packages/asl-agent/tests/rereadTest.asl#runTests" :text "LEONFIX-READSTREAK gate: a read of lines an earlier kept turn still shows is answered by a reread notice, the second repeat asks for the edit and names the owned files, an edit to the file ends the cache for it, and asnUnescape inverts escapeAsn")
(:doc :symbol "asl/packages/asl-agent/tests/stepBodyGradeTest.asl#runTests" :text "LEON-STEP-BODY-LOST grade gate: a text or native tool call runs only what the model sent, byte for byte, and a call that does not map one to one (a form beside op and cmd, two form keys, done with prose arguments) runs nothing and is named under :left")
(:doc :symbol "asl/packages/asl-agent/tests/stepBodyLostTest.asl#runTests" :text "LEON-STEP-BODY-LOST gate on recorded node2 turns: a text tool call sent after the step prefill as a parenthesised JSON object is turned into the step it names (read, symbol, run argv, gate, write) with its arguments instead of an empty step")
(:doc :symbol "asl/packages/asl-agent/tests/stepGluedHeadTest.asl#runTests" :text "LEON-STEP-BODY-LOST gate: a step head glued to a known op, such as stepnop before a quoted read, is read as that op with its arguments, and an unknown glued word stays as sent")
(:doc :symbol "asl/packages/asl-agent/tests/toolRootRowsTest.asl#runTests" :text "LEON-STEP-BODY-LOST gate, nothing run: the env rows a jailed asl call builds name the tool root of the aslBin it runs as ASL_CLI_ROOT, never an inherited one, and an aslBin that is not ROOT/bin/asl leaves the rows as given")
(:doc :symbol "asl/packages/asl-agent/tests/commitResumeFlagTest.asl#runTests" :text "run every case of the suite")
(:doc :symbol "asl/packages/asl-agent/src/exec.asl#withGateSame" :text "env recs: the execution environment carrying the gate verdicts still valid for this turn, one record per gate with cmd, exit, stdout, stderr and since; a gate step all of whose gates are among them answers from them marked :same true :since N and starts no process")
(:doc :symbol "asl/packages/asl-agent/src/exec.asl#aliasedOp" :text "op env: the op with a synonym op name read as the registered op and a key alias (:path, :filename, :about) copied to its canonical key, :aliased carrying the canonical step form; the live loop applies it before classifying an op")
(:doc :symbol "asl/packages/asl-agent/src/exec.asl#fileFormHeads" :text "the form heads that are text from a source file, not steps: a step naming one is refused with the write hint")
(:doc :symbol "asl/packages/asl-agent/src/exec.asl#opSynonymNames" :text "every op synonym name aliasedOp reads as a registered op; none may be a file form head or a data form head")
(:doc :symbol "asl/packages/asl-agent/tests/gateSameLoopTest.asl#runTests" :text "no args: scripted loop runs over a counting gate script; checks the baseline verdict form in the first turn's text, the stored answer a gate step gets when nothing was written since the gate last ran, a real run for a gate step after a write in the same reply, and the closing line after a red and after a green gate")
(:doc :symbol "asl/packages/asl-agent/src/loopState.asl#GateMemo" :text "one stored gate verdict: the owned-tree digest it was taken on, the turn that ran it (0 for the pass before the first turn) and the gate result")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#scanFits!" :text "the shared native CLI store is keyed by content: when no head candidate fits the root, every other cli-* directory of the shared store (at most scanCap plain directories, read-only) whose source snapshot equals the root sources becomes a candidate, so a writer branched from an older base takes that entry instead of building (LEON-JAIL-SHARED-CLI)")
(:doc :symbol "asl/packages/asl-agent/src/jail.asl#scanCap" :text "the most cli-* entries of the shared store one re-seed examines when no head names a fitting one (LEON-JAIL-SHARED-CLI)")
(:doc :symbol "asl/packages/asl-agent/tests/jailSharedCliTest.asl#" :text "Gate LEON-JAIL-SHARED-CLI: a writer whose CLI sources equal an older shared cli-<digest> entry no head names copies it and does not build, sources that fit no entry do not take a foreign one, and the shared store is not writable from the jail")
(:doc :symbol "asl/packages/asl-agent/tests/jailSharedCliTest.asl#runTests" :text "runs the shared CLI store gate")
(:doc :symbol "asl/packages/asl-agent/tests/jailToolSharedTest.asl#" :text "Gate NODE-CLI-REBUILD-PER-TREE: an edit of a file outside the entry deps keeps the main entry, an edit of a file the deps name (gateway or tool) leaves the head behind so the unit builds its own CLI, a failed build is not answered by the main entry")
(:doc :symbol "asl/packages/asl-agent/tests/jailToolSharedTest.asl#runTests" :text "runs the per-tree CLI gate")
(:doc :symbol "asl/packages/asl-agent/tests/runOpsTest.asl#plainFileMode!" :text "the mode a plainly created file gets under the test process's umask, probed beside the journal log (NODE-AGENT-BASE-REDS)")
(:doc :symbol "asl/packages/asl-agent/tests/runOpsTest.asl#canonMode!" :text "a recorded file mode as the fixture's 420 when it is the plain created mode of this machine, else itself, so the recorded originals hold under any umask without hiding a wrong mode")
(:doc :symbol "asl/packages/asl-agent/tests/gateKillTreeTest.asl#ownGroup" :text "the launcher that puts the fixture child in its own process group: setsid where it exists, empty (case skipped) otherwise")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#runExit" :text "the exit code field of a RunAslResult")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#runStdout" :text "the captured stdout text of a RunAslResult")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#runStderr" :text "the captured stderr text of a RunAslResult")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#runTimedOut" :text "true when the asl run hit its timeout, from RunAslResult")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#runSeconds" :text "the wall-clock seconds the asl run took, from RunAslResult")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#runFellBack" :text "the fallback reason recorded on a RunAslResult, empty when no transport fallback occurred")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#chooseTransportFor" :text "an explicit ASL_TRANSPORT value wins, else forms safe in process run inProcess, else defers to chooseTransport; returns mode and env prefix")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#readOutlineBytes" :text "default whole-file read limit in bytes (16384) above which a read returns an outline instead")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#readOutlineBytesIn" :text "parses :readOutlineBytes from config text as a positive integer, none when absent or not positive")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#readOutlineBytesFor!" :text "reads the workspace config's :readOutlineBytes; default when absent, an error string when set to a non-positive-integer")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#memoRunDir!" :text "the tool-memo directory of a session as some path when it exists, else none")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#memoRunBegin!" :text "prunes stale memo dirs and creates this session's memo run directory; returns the id or an error")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#memoRunBeginIfOn!" :text "starts a session memo run only when the workspace enabled :toolMemo; true when memo is off")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#memoRunEnd!" :text "removes the session's memo run directory; true when removed or the session id is unusable")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#toolMemoIn" :text "true when config text has :agentLoop :toolMemo set to true")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#toolMemoOn!" :text "reads root/.asl.config.asn and reports whether :toolMemo is true, false when unreadable")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#memoKey" :text "sha256 of form, path and current file contents, so a memo key changes when the file changes; none if unreadable")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#memoGet!" :text "reads a memo file whose header holds code, output length, run id and timestamp; none when missing, malformed or stale")
(:doc :symbol "asl/packages/asl-agent/src/aslOps.asl#memoPut!" :text "writes a memo entry (code, output length, run id, time, then stdout and stderr) to a pid-suffixed temp file and renames it atomically")
(:doc :symbol "asl/packages/asl-agent/src/card.asl#buildCard" :text "assembles the AgentCard from allowlist, deliverables, backends, gateway pools and receipt field names under a root, propagating the first error")
(:doc :symbol "asl/packages/asl-agent/src/card.asl#formatCardAsn" :text "renders an AgentCard as a multi-line (:agentCard ...) ASN string with keys, allowlist, deliverables, backends and pools")
(:doc :symbol "asl/packages/asl-agent/src/card.asl#main" :text "prints the agent card for the root given as first non-flag arg or ASL_ROOT_DIR or the current dir; exits 0")
(:doc :symbol "asl/packages/asl-agent/src/claimBacking.asl#executedAsserts" :text "sums executed-assertion counts parsed from runner output (N assertion(s) executed), else from :asserts N anchors; none when neither appears")
(:doc :symbol "asl/packages/asl-agent/src/claimBacking.asl#claimedCounts" :text "integers a sentence attaches to assertions: N assert... before the word and :asserts N after the keyword")
(:doc :symbol "asl/packages/asl-agent/src/claimBacking.asl#suiteTokens" :text "the Test-suffixed suite names mentioned in a sentence, with path and .asl suffix stripped")
(:doc :symbol "asl/packages/asl-agent/src/claimBacking.asl#claimSentences" :text "splits a reply into trimmed non-empty sentences on newlines and period-space")
(:doc :symbol "asl/packages/asl-agent/src/claimBacking.asl#unbackedGateClaims" :text "reply sentences claiming gate passes or counts not backed by the latest green gate runs, each cut to 120 chars")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptId" :text "the id field of a Receipt")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptCmd" :text "the command field of a Receipt")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptOp" :text "the op field of a Receipt")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptStatus" :text "the status field of a Receipt")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptError" :text "the error field of a Receipt")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptNeedsConfirm" :text "the needsConfirm flag of a Receipt")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptHasExit" :text "true when the Receipt recorded an exit code")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptExit" :text "the recorded exit code of a Receipt")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptGateRuns" :text "the (gate, exit) pairs a Receipt recorded")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptHasSpan" :text "true when the Receipt carries a read span")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptSpanStart" :text "the span start offset of a Receipt")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptSpanEnd" :text "the span end offset of a Receipt")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#receiptFile" :text "the file path field of a Receipt")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#claimBacked" :text "the backed flag of either an evidence or prose Claim")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#claimCmd" :text "the command of an evidence Claim, empty for a prose Claim")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#claimReceiptOpt" :text "the cited receipt id of an evidence Claim, none for a prose Claim")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#claimExitOpt" :text "the claimed exit code of an evidence Claim, none for a prose Claim")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#claimText" :text "the sentence text of a prose Claim, empty for an evidence Claim")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#claimIsEvidence?" :text "true for an evidenceClaim, false for a proseClaim")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#claimsResultTotal" :text "the total claim count of a ClaimsResult")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#claimsResultUnbacked" :text "the unbacked claim count of a ClaimsResult")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#claimsResultClaims" :text "the claim list of a ClaimsResult")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#evidenceUpdateNew" :text "true when the evidence update brought new coverage or keys")
