(:doc :symbol "asl/packages/asl-agent/src/core.asl#stripForms" :text "replaces every top-level parenthesized form with a single space, keeping the prose between them")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#dictGet" :text "looks up key k in a key-value list, returning some value or none")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#dictHas" :text "true when the key-value list holds key k")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#dictOr" :text "value for key k, or an empty kvStr when the key is absent")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#truthy" :text "true for some kvStr that is non-empty or some kvInt that is not \"0\"; none is false")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#headOf" :text "keyword after the opening paren of a form, like \"step\" from \"(:step ...)\", or \"\" if none")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#strBodyEnd" :text "index of the closing unescaped quote at or after i, skipping backslash pairs, or -1 if unterminated")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#parseKv" :text "parses one form into key-value pairs: \"_head\" keyword, then string, integer and atom fields")
