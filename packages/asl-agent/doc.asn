(:doc :symbol "asl/packages/asl-agent/src/context.asl#contextToolCapBytesFor!" :text "tool output byte cap from root/.asl.config.asn when that file exists, else the default 1500")
(:doc :symbol "asl/packages/asl-agent/src/context.asl#contextMaxOlderLines" :text "default of 50 summary lines kept for turns that aged out of the window")
