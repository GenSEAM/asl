(:doc :symbol "asl/packages/asl-agent/src/core.asl#serOps" :text "serializes a list of op records as an (ops (op (k v)...)...) string")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#serKey" :text "serializes an evidence key as a (key v...) string")
