(:doc :symbol "asl/packages/asl-agent/src/core.asl#serString" :text "double-quoted ASN string that also escapes carriage return and tab")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#asnUnescape" :text "decodes backslash-n, t, quote and backslash escapes; an unknown escape drops the backslash and its character")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#formEnd" :text "scans from j tracking paren depth and string escapes, returning the end index and remaining depth once depth reaches zero")
