(:doc :symbol "asl/packages/asl-agent/src/core.asl#stripRight" :text "drops the trailing characters of s that satisfy test")
(:doc :symbol "asl/packages/asl-agent/src/core.asl#effectiveOwns" :text "owns list, or the match-everything list (\"**\") when owns is empty")
