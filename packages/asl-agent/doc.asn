(:doc :symbol "asl/packages/asl-agent/src/claims.asl#oldStructuralKeys" :text "argument keys skipped as non-prose by the old prose-claim scan; ends with claim")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#newStructuralKeys" :text "argument keys skipped as non-prose by the new prose-claim scan; same as old but ends with commit")
(:doc :symbol "asl/packages/asl-agent/src/claims.asl#hasNegatorNear" :text "true when one of the three words before matchStart in a sentence is a negator")
