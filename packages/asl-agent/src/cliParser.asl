(module aslAgent/cliParser :x [parseOpts parseCliArgs] :i [(cli :a cli) (policy :a pol)])

fn parseOpts args: (List Str) opts: cli/CliOptions -> (Result cli/CliOptions Str)
  (if (listEmpty? args) (ok opts) (let [(head (optionOr (listHead args) "")) (tail (optionOr (listTail args) (list)))] (cond ((or (= head "-h") (= head "--help")) (err "help")) ((or (= head "-v") (= head "--version")) (err "version")) ((= head "--repl") (parseOpts tail (cli/CliOptions :autonomy opts.autonomy :modelId opts.modelId :singlePrompt opts.singlePrompt :evalPath opts.evalPath :isRepl true :isSimple opts.isSimple))) ((or (= head "-s") (= head "--simple")) (parseOpts tail (cli/CliOptions :autonomy opts.autonomy :modelId opts.modelId :singlePrompt opts.singlePrompt :evalPath opts.evalPath :isRepl opts.isRepl :isSimple true))) ((or (= head "-a") (= head "--autonomy")) (if (listEmpty? tail) (err "missing argument for autonomy") (parseOpts (optionOr (listTail tail) (list)) (cli/CliOptions :autonomy (cli/parseAutonomyFlag (optionOr (listHead tail) "")) :modelId opts.modelId :singlePrompt opts.singlePrompt :evalPath opts.evalPath :isRepl opts.isRepl :isSimple opts.isSimple)))) ((or (= head "-m") (= head "--model")) (if (listEmpty? tail) (err "missing argument for model") (parseOpts (optionOr (listTail tail) (list)) (cli/CliOptions :autonomy opts.autonomy :modelId (optionOr (listHead tail) "") :singlePrompt opts.singlePrompt :evalPath opts.evalPath :isRepl opts.isRepl :isSimple opts.isSimple)))) ((or (= head "-p") (= head "--prompt")) (if (listEmpty? tail) (err "missing argument for prompt") (parseOpts (optionOr (listTail tail) (list)) (cli/CliOptions :autonomy opts.autonomy :modelId opts.modelId :singlePrompt (optionOr (listHead tail) "") :evalPath opts.evalPath :isRepl opts.isRepl :isSimple opts.isSimple)))) ((or (= head "-e") (= head "--eval")) (if (listEmpty? tail) (err "missing argument for eval") (parseOpts (optionOr (listTail tail) (list)) (cli/CliOptions :autonomy opts.autonomy :modelId opts.modelId :singlePrompt opts.singlePrompt :evalPath (optionOr (listHead tail) "") :isRepl opts.isRepl :isSimple opts.isSimple)))) ((stringStartsWith? head "-") (err (str "invalid flag: " head))) (else (ok opts)))))

fn parseCliArgs args: (List Str) -> (Result cli/CliOptions Str)
  (parseOpts args (cli/makeSimpleCliOptions (pol/levelGuarded) "gemma-4-31b-it" "" "" false false))
