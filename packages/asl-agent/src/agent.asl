(module aslAgent/agent :x [AgentState AgentSession StepResult AgentOperatingMode modeSimple modeMaintainer makeAgentSession makeAutonomySession stepAgent! stepAgentWithHostCall! runBoundedSession! runInMode!] :i [(policy :a pol) (ffi :a ffi) (tui :a tui) (taskDag :a dag) (modelRouter :a router) (reviewBreaker :a rev)])

(enum AgentOperatingMode (:c modeSimple [] "Lightweight direct tool execution loop without DAG or review overhead") (:c modeMaintainer [] "Sovereign project maintainer mode with DAG orchestration and model routing"))

(schema AgentState (:f phase Str) (:f currentStep I64) (:f maxSteps I64) (:f goal Str) (:f lastOutput Str) (:f isTerminal Bool))

(schema AgentSession (:f state AgentState) (:f manifest pol/PermissionManifest) (:f autonomy pol/AutonomyLevel) (:f history (List Str)))

(schema StepResult (:f session AgentSession) (:f actionTaken Str) (:f success Bool) (:f observation Str))

fn makeAgentSession goal: Str manifest: pol/PermissionManifest -> AgentSession
  (makeAutonomySession goal manifest (pol/levelAuto))

fn makeAutonomySession goal: Str manifest: pol/PermissionManifest autonomy: pol/AutonomyLevel -> AgentSession
  (AgentSession :state (AgentState :phase "idle" :currentStep 0 :maxSteps 10 :goal goal :lastOutput "" :isTerminal false) :manifest manifest :autonomy autonomy :history (list))

fn stepAgentWithHostCall! session: AgentSession toolName: Str targetPath: Str payload: Str hostCall: (Fn [Str Str Str] -> (Result Str Str)) -> StepResult
  (let [(st session.state) (curStep st.currentStep) (maxStep st.maxSteps) (manifest session.manifest) (autonomy session.autonomy)] (cond (st.isTerminal (StepResult :session session :actionTaken "session already terminal" :success true :observation session.state.lastOutput)) ((>= curStep maxStep) (let [(updatedSt (AgentState :phase "error" :currentStep curStep :maxSteps maxStep :goal st.goal :lastOutput "Step budget exhausted (anti-OOM limit reached)" :isTerminal true))] (StepResult :session (AgentSession :state updatedSt :manifest manifest :autonomy autonomy :history (cons "step-budget-exceeded" session.history)) :actionTaken "aborted: step budget ceiling" :success false :observation "Step budget exhausted (anti-OOM limit reached)"))) ((= toolName "finish") (let [(updatedSt (AgentState :phase "complete" :currentStep (+ curStep 1) :maxSteps maxStep :goal st.goal :lastOutput payload :isTerminal true))] (StepResult :session (AgentSession :state updatedSt :manifest manifest :autonomy autonomy :history (cons (str "final-answer: " payload) session.history)) :actionTaken "finish" :success true :observation payload))) (else (let [(perm (pol/checkAutonomyPermission toolName targetPath manifest autonomy))] (if (not perm.allowed) (let [(errMsg (str "Policy violation: " perm.reason)) (updatedSt (AgentState :phase "error" :currentStep (+ curStep 1) :maxSteps maxStep :goal st.goal :lastOutput errMsg :isTerminal true))] (StepResult :session (AgentSession :state updatedSt :manifest manifest :autonomy autonomy :history (cons errMsg session.history)) :actionTaken (str "denied: " perm.code) :success false :observation errMsg)) (if (not perm.silent) (let [(promptMsg (str "Confirmation required: " perm.reason)) (updatedSt (AgentState :phase "reasoning" :currentStep (+ curStep 1) :maxSteps maxStep :goal st.goal :lastOutput promptMsg :isTerminal false))] (StepResult :session (AgentSession :state updatedSt :manifest manifest :autonomy autonomy :history (cons promptMsg session.history)) :actionTaken (str "prompt:" toolName) :success true :observation promptMsg)) (let [(cap (if (or (= toolName "read") (or (= toolName "write") (= toolName "patch"))) "fs" "exec")) (act (if (= toolName "read") "read" (if (= toolName "write") "write" "exec"))) (ffiRes (hostCall cap act targetPath)) (foldingLog (tui/formatToolCall toolName targetPath "ok")) (updatedSt (AgentState :phase "reasoning" :currentStep (+ curStep 1) :maxSteps maxStep :goal st.goal :lastOutput (mt ffiRes ((ok val) val) ((err e) e)) :isTerminal false))] (StepResult :session (AgentSession :state updatedSt :manifest manifest :autonomy autonomy :history (cons foldingLog session.history)) :actionTaken (str "executed:" toolName) :success (mt ffiRes ((ok _) true) ((err _) false)) :observation updatedSt.lastOutput))))))))

fn stepAgent! session: AgentSession toolName: Str targetPath: Str payload: Str -> StepResult
  (stepAgentWithHostCall! session toolName targetPath payload ffi/hostCall!)

fn runBoundedSession! session: AgentSession -> AgentSession
  (if session.state.isTerminal session (let [(res (stepAgent! session "finish" "" "goal completed"))] res.session))

fn runInMode! mode: AgentOperatingMode prompt: Str workspaceRoot: Str manifest: pol/PermissionManifest autonomy: pol/AutonomyLevel -> Str
  (mt mode ((modeSimple) (let [(sess (makeAutonomySession prompt manifest autonomy)) (s1 (stepAgent! sess "read" (str workspaceRoot "/manifest.asn") "")) (s2 (stepAgent! s1.session "finish" "" "simple directive completed"))] (str "SIMPLE-MODE: " s2.session.state.lastOutput))) ((modeMaintainer) (let [(t1 (dag/makeTaskNode "t1-inspect" "Inspect workspace manifest" "triage" (list))) (t2 (dag/makeTaskNode "t2-plan" "Plan architectural changes" "review" (list "t1-inspect"))) (t3 (dag/makeTaskNode "t3-impl" "Execute verified implementation" "coding" (list "t2-plan"))) (dagPlan (dag/makeTaskDag "plan-01" (list t1 t2 t3))) (routerMatrix (router/defaultRoutingMatrix)) (routeEp (router/resolveModelForRole (router/roleCoding) routerMatrix false)) (revEx (rev/makeReviewExchange prompt 2))] (str "MAINTAINER-MODE: " (dag/formatDagSummary dagPlan) " | Model: " routeEp.modelId " | Review ceiling: " (stringFromInt64 revEx.maxRounds) " rounds"))))
