;; Agent Sovereign Declarative Test Case Store (ASN)
(:caseRegistry
  :package "asl-agent"
  :feature "sovereign-maintainer-swarm-orchestrator"
  :cases [
    (:case :id "c-agent-pos-001" :polarity :positive :desc "make-agent-session initializes in idle phase with max-steps 10" :input "(:goal \"optimize wasm\")" :expect :ok)
    (:case :id "c-agent-pos-002" :polarity :positive :desc "step-agent executes within capability bounds under L2:FullAuto" :input "(:tool \"fs-read\" :target \"main.asl\")" :expect :ok)
    (:case :id "c-agent-pos-003" :polarity :positive :desc "tui format-session-dashboard returns valid terminal boxart" :input "(:dashboard-width 80)" :expect :ok)
    (:case :id "c-agent-neg-001" :polarity :negative :desc "L0:ReadOnly rejects destructive file write action" :input "(:tool \"fs-write\" :target \"main.asl\")" :expect :errPermissionDenied)
    (:case :id "c-agent-neg-002" :polarity :negative :desc "step-agent rejects execution once max-steps ceiling is reached" :input "(:current-step 10 :max-steps 10)" :expect :errStepCeiling)
    (:case :id "c-agent-edge-001" :polarity :edge :desc "make-autonomy-session handles empty goal string safely" :input "(:goal \"\")" :expect :ok)
    (:case :id "c-agent-edge-002" :polarity :edge :desc "session trace log prunes old observations to prevent context degradation" :input "(:history-count 50)" :expect :ok)
    (:case :id "c-dag-pos-001" :polarity :positive :desc "DAG ready queue resolves independent root nodes" :input "(:nodes [\"t1\" \"t2\"] :deps [[] [\"t1\"]])" :expect :ok)
    (:case :id "c-dag-pos-002" :polarity :positive :desc "DAG topologically unblocks dependent tasks upon upstream completion" :input "(:completed \"t1\")" :expect :ok)
    (:case :id "c-dag-neg-001" :polarity :negative :desc "DAG deadlock detector flags circular dependencies" :input "(:cycle [\"t1\" \"t2\"])" :expect :errDagDeadlock)
    (:case :id "c-dag-status-001" :polarity :positive :desc "Node status converts to canonical string" :input "(:status :pending)" :expect "pending")
    (:case :id "c-dag-status-002" :polarity :positive :desc "Completed status converts to canonical string" :input "(:status :completed)" :expect "completed")
    (:case :id "c-dag-status-neg-001" :polarity :negative :desc "Distinct node statuses do not collide" :input "(:compare [:pending :completed])" :expect :distinct)
    (:case :id "c-dag-box-001" :polarity :positive :desc "DAG box-art renders node labels" :input "(:dag \"dag-render\")" :expect :ok)
    (:case :id "c-dag-box-002" :polarity :positive :desc "DAG box-art renders child nodes" :input "(:dag \"dag-render\")" :expect :ok)
    (:case :id "c-dag-box-003" :polarity :positive :desc "DAG box-art renders directed dependency arrows" :input "(:dag \"dag-render\")" :expect :ok)
    (:case :id "c-dag-box-neg-001" :polarity :negative :desc "DAG box-art output is non-empty" :input "(:dag \"dag-render\")" :expect :ok)
    (:case :id "c-dag-vdom-001" :polarity :positive :desc "DAG VDOM renders root div with task-dag class" :input "(:dag \"dag-vdom\")" :expect :ok)
    (:case :id "c-dag-vdom-002" :polarity :positive :desc "DAG VDOM renders data-dag-id attribute" :input "(:dag \"dag-vdom\")" :expect :ok)
    (:case :id "c-dag-vdom-003" :polarity :positive :desc "DAG VDOM renders node title elements" :input "(:dag \"dag-vdom\")" :expect :ok)
    (:case :id "c-dag-vdom-neg-001" :polarity :negative :desc "DAG VDOM reports incomplete status on pending nodes" :input "(:dag \"dag-vdom\")" :expect :incomplete)
    (:case :id "c-router-pos-001" :polarity :positive :desc "Model router assigns designated models to task roles" :input "(:role :review)" :expect :gemini2.5Pro)
    (:case :id "c-router-neg-001" :polarity :negative :desc "Offline mode forces graceful degradation to local SLM" :input "(:offline true)" :expect :gemma431bIt)
    (:case :id "c-rev-pos-001" :polarity :positive :desc "Review breaker approves on clean review" :input "(:verdict :approved)" :expect :ok)
    (:case :id "c-rev-neg-001" :polarity :negative :desc "Review breaker trips and escalates to human on 2nd consecutive rejection" :input "(:rejections 2)" :expect :errReviewEscalated)
    (:case :id "c-mode-pos-001" :polarity :positive :desc "Simple mode runs direct tool execution bypass" :input "(:mode :simple)" :expect :ok)
    (:case :id "c-mode-pos-002" :polarity :positive :desc "Maintainer mode initializes full DAG and review envelope" :input "(:mode :maintainer)" :expect :ok)
    (:case :id "c-corr-pos-001" :polarity :positive :desc "Freedom corridor populates default invariants and explorations" :input "(:corridor \"corr-01\")" :expect :ok)
    (:case :id "c-corr-neg-001" :polarity :negative :desc "Freedom corridor rejects gate weakening and comment violations" :input "(:action \"weaken gate\")" :expect :errCorridorViolation)
    (:case :id "c-fb-pos-001" :polarity :positive :desc "Intent contract transitions to grounded state" :input "(:stage :grounded)" :expect :ok)
    (:case :id "c-fb-pos-002" :polarity :positive :desc "Explain-Once memory grounding serializes contract and corridor to persistent ASN" :input "(:ground true)" :expect :ok)
    (:case :id "c-fb-pos-003" :polarity :positive :desc "Intent contract decomposes into 4-stage Swarm DAG" :input "(:decompose true)" :expect :ok)
    (:case :id "c-fb-neg-001" :polarity :negative :desc "Decomposed Swarm DAG possesses valid unblocked dependency structure with zero deadlocks" :input "(:deadlock-check true)" :expect :ok)
  ]
)
