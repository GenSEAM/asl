(:case :fn "wrongCitationNote" :id "wrong_mixed" :items ((:item :hasReceipt true :text "abc123") (:item :hasReceipt false :text "bash foo.sh")) :want "wrong citation: \"abc123\" \"bash foo.sh\" names no receipt of this session, or its recorded exit differs; an (:evidence (:receipt id ...)) form cites the :id of a receipt above and is never itself a claim")
