(:case :id "sliceStartPastEnd" :fn "gitOp" :op "(:step :op \"gitShow\" :path \"big.txt\" :start 999)" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitShow\") (path \"big.txt\") (status \"rejected\") (error \"ERR_BAD_ARG\") (message \":start 999 is past the last line; the answer has 60 lines\"))")
(:case :id "sliceStartPastEndNoPath" :fn "gitOp" :op "(:step :op \"gitShow\" :start 9999)" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitShow\") (path nil) (status \"rejected\") (error \"ERR_BAD_ARG\") (message \":start 9999 is past the last line; the answer has 167 lines\"))")
(:case :id "badStartZero" :fn "gitOp" :op "(:step :op \"gitShow\" :path \"a.txt\" :start 0)" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitShow\") (status \"rejected\") (error \"ERR_BAD_ARG\") (message \":start and :end are line numbers from 1, :end not before :start (got 0, None)\") (path \"a.txt\"))")
(:case :id "badStartStr" :fn "gitOp" :op "(:step :op \"gitShow\" :path \"a.txt\" :start \"0\")" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitShow\") (status \"rejected\") (error \"ERR_BAD_ARG\") (message \":start and :end are line numbers from 1, :end not before :start (got '0', None)\") (path \"a.txt\"))")
(:case :id "badEndWord" :fn "gitOp" :op "(:step :op \"gitShow\" :end \"x'y\")" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitShow\") (status \"rejected\") (error \"ERR_BAD_ARG\") (message \":start and :end are line numbers from 1, :end not before :start (got None, \\\"x'y\\\")\"))")
(:case :id "badEndBeforeStart" :fn "gitOp" :op "(:step :op \"gitShow\" :path \"a.txt\" :start 5 :end 2)" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitShow\") (status \"rejected\") (error \"ERR_BAD_ARG\") (message \":start and :end are line numbers from 1, :end not before :start (got 5, 2)\") (path \"a.txt\"))")
(:case :id "badStartNegative" :fn "gitOp" :op "(:step :op \"gitShow\" :start \"-3\")" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitShow\") (status \"rejected\") (error \"ERR_BAD_ARG\") (message \":start and :end are line numbers from 1, :end not before :start (got '-3', None)\"))")
(:case :id "emptyStartIgnored" :fn "gitOp" :op "(:step :op \"gitShow\" :path \"b.txt\" :rev \"v1\" :start \"\")" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitShow\") (status \"ok\") (cmd \"git show v1:b.txt\") (exit 0) (stdout \"bravo\\n\") (path \"b.txt\") (content \"bravo\\n\"))")
(:case :id "unknownOp" :fn "gitOp" :op "(:step :op \"gitBlame\" :path \"a.txt\")" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitBlame\") (status \"rejected\") (error \"ERR_EFFECT_UNDECLARED\"))")
(:case :id "missingRoot" :fn "gitOp" :op "(:step :op \"gitLog\")" :root "@BASE@/nosuch" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitLog\") (status \"rejected\") (error \"ERR_GIT_FAILED\") (message \"[Errno 2] No such file or directory: '@BASE@/nosuch'\") (exit 1))")
(:case :id "missingRootWithPath" :fn "gitOp" :op "(:step :op \"gitShow\" :path \"a.txt\")" :root "@BASE@/nosuch" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitShow\") (status \"rejected\") (error \"ERR_GIT_FAILED\") (message \"[Errno 2] No such file or directory: '@BASE@/nosuch'\") (exit 1))")
(:case :id "fileRoot" :fn "gitOp" :op "(:step :op \"gitLog\")" :root "@BASE@/repo/a.txt" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitLog\") (status \"rejected\") (error \"ERR_GIT_FAILED\") (message \"[Errno 20] Not a directory: '@BASE@/repo/a.txt'\") (exit 1))")
(:case :id "emptyRoot" :fn "gitOp" :op "(:step :op \"gitDiff\" :path \"a/b\")" :root "" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitDiff\") (status \"rejected\") (error \"ERR_GIT_FAILED\") (message \"[Errno 2] No such file or directory: ''\") (exit 1))")
(:case :id "gitTimeout" :fn "gitOp" :op "(:step :op \"gitLog\" :path \"a.txt\")" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 1 :cap 8000 :env "slow" :want "(r (id \"ID\") (op \"gitLog\") (status \"rejected\") (error \"ERR_GIT_FAILED\") (message \"git gitLog killed after 1 s\") (timeout true) (seconds 1) (exit 1))")
(:case :id "gitQuietFailure" :fn "gitOp" :op "(:step :op \"gitLog\")" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "quiet" :want "(r (id \"ID\") (op \"gitLog\") (status \"rejected\") (cmd \"git log -n 10\") (exit 3) (stdout \"quiet stdout\\n\") (content \"quiet stdout\\n\") (error \"ERR_GIT_FAILED\") (message \"git gitLog failed\"))")
(:case :id "inheritEnvShow" :fn "gitOp" :op "(:step :op \"gitShow\" :path \"a.txt\" :rev \"v1\")" :root "@BASE@/repo" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "inherit" :want "(r (id \"ID\") (op \"gitShow\") (status \"ok\") (cmd \"git show v1:a.txt\") (exit 0) (stdout \"alpha 1\\nalpha 2\\nalpha 3\\nalpha 4\\nalpha 5\\n\") (path \"a.txt\") (content \"alpha 1\\nalpha 2\\nalpha 3\\nalpha 4\\nalpha 5\\n\"))")
(:case :id "notRepo" :fn "gitOp" :op "(:step :op \"gitLog\")" :root "@BASE@/outside" :mode "scout" :defaultBase "" :t 30 :cap 8000 :env "clean" :want "(r (id \"ID\") (op \"gitLog\") (status \"rejected\") (cmd \"git log -n 10\") (exit 128) (stdout \"\") (content \"fatal: not a git repository (or any of the parent directories): .git\\n\") (error \"ERR_GIT_FAILED\") (message \"fatal: not a git repository (or any of the parent directories): .git\"))")
(:case :id "pirEmpty" :fn "isPathInRepo" :path "" :root "@BASE@/repo" :want "true")
(:case :id "pirBlank" :fn "isPathInRepo" :path "   " :root "@BASE@/repo" :want "true")
(:case :id "pirRel" :fn "isPathInRepo" :path "a.txt" :root "@BASE@/repo" :want "true")
(:case :id "pirDotDot" :fn "isPathInRepo" :path ".." :root "@BASE@/repo" :want "false")
(:case :id "pirDotDotSlash" :fn "isPathInRepo" :path "../x" :root "@BASE@/repo" :want "false")
(:case :id "pirNormDotDot" :fn "isPathInRepo" :path "a/../../x" :root "@BASE@/repo" :want "false")
(:case :id "pirAbsIn" :fn "isPathInRepo" :path "@BASE@/repo/sub" :root "@BASE@/repo" :want "true")
(:case :id "pirAbsOut" :fn "isPathInRepo" :path "@BASE@/outside" :root "@BASE@/repo" :want "false")
(:case :id "pirRootItself" :fn "isPathInRepo" :path "@BASE@/repo" :root "@BASE@/repo" :want "true")
(:case :id "pirPrefixSibling" :fn "isPathInRepo" :path "@BASE@/repository" :root "@BASE@/repo" :want "false")
(:case :id "pirAliasIn" :fn "isPathInRepo" :path "@BASE@/repo/zz/none" :root "@BASE@/alias" :want "true")
(:case :id "pirAliasOut" :fn "isPathInRepo" :path "@BASE@/outside/o.txt" :root "@BASE@/alias" :want "false")
(:case :id "pirLinkOutLexical" :fn "isPathInRepo" :path "outlink/o.txt" :root "@BASE@/repo" :want "true")
(:case :id "pirEmptyRootRel" :fn "isPathInRepo" :path "x/y" :root "" :want "true")
(:case :id "pirEmptyRootUp" :fn "isPathInRepo" :path "../y" :root "" :want "false")
(:case :id "pirSlashRoot" :fn "isPathInRepo" :path "/etc" :root "/" :want "true")
(:case :id "pirDoubleSlash" :fn "isPathInRepo" :path "//x" :root "@BASE@/repo" :want "false")
(:case :id "pirTrailingDots" :fn "isPathInRepo" :path "sub/./" :root "@BASE@/repo" :want "true")
(:case :id "laAbsent" :fn "lineArg" :op "(:step)" :want "none")
(:case :id "laEmpty" :fn "lineArg" :op "(:step :start \"\")" :want "none")
(:case :id "laInt" :fn "lineArg" :op "(:step :start 7)" :want "7")
(:case :id "laIntZero" :fn "lineArg" :op "(:step :start 0)" :want "bad")
(:case :id "laStr" :fn "lineArg" :op "(:step :start \"12\")" :want "12")
(:case :id "laStrSpaced" :fn "lineArg" :op "(:step :start \" 4 \")" :want "4")
(:case :id "laStrZero" :fn "lineArg" :op "(:step :start \"0\")" :want "bad")
(:case :id "laStrNeg" :fn "lineArg" :op "(:step :start \"-2\")" :want "bad")
(:case :id "laStrWord" :fn "lineArg" :op "(:step :start \"abc\")" :want "bad")
(:case :id "laStrPlus" :fn "lineArg" :op "(:step :start \"+3\")" :want "bad")
(:case :id "gsEmpty" :fn "gitSlice" :text "" :start 0 :end -1 :cap 100 :want "(slice \"\" 1 0 0)")
(:case :id "gsAll" :fn "gitSlice" :text "a\nb\nc\n" :start 0 :end -1 :cap 100 :want "(slice \"a\\nb\\nc\\n\" 1 3 3)")
(:case :id "gsNoTrailing" :fn "gitSlice" :text "a\nb" :start 0 :end -1 :cap 100 :want "(slice \"a\\nb\" 1 2 2)")
(:case :id "gsRange" :fn "gitSlice" :text "a\nb\nc\nd\n" :start 2 :end 3 :cap 100 :want "(slice \"b\\nc\\n\" 2 3 4)")
(:case :id "gsStartPast" :fn "gitSlice" :text "a\nb\n" :start 5 :end -1 :cap 100 :want "(slice \"\" 5 4 2)")
(:case :id "gsCap" :fn "gitSlice" :text "aaaa\nbbbb\ncccc\n" :start 0 :end -1 :cap 7 :want "(slice \"aaaa\\n\" 1 1 3)")
(:case :id "gsCapFirstCut" :fn "gitSlice" :text "abcdefgh\nij\n" :start 0 :end -1 :cap 3 :want "(slice \"abc\" 1 1 2)")
(:case :id "gsSeparators" :fn "gitSlice" :text "xyzwv u\nts\n" :start 0 :end -1 :cap 100 :want "(slice \"xyzwv u\\r\\nt\\rs\\n\" 1 8 8)")
(:case :id "gsUnicodeCap" :fn "gitSlice" :text "äöüß\né\n" :start 0 :end -1 :cap 2 :want "(slice \"äö\" 1 1 2)")
(:case :id "gsEndPast" :fn "gitSlice" :text "a\nb\n" :start 1 :end 9 :cap 100 :want "(slice \"a\\nb\\n\" 1 2 2)")
(:case :id "nfShowNoRev" :fn "nextForm" :opName "gitShow" :op "(:step)" :start 4 :want "(:step :op \"gitShow\" :rev \"HEAD\" :start 4 :end n)")
(:case :id "nfShowRevPath" :fn "nextForm" :opName "gitShow" :op "(:step :rev \"v1\" :path \"a\\\"b.txt\")" :start 9 :want "(:step :op \"gitShow\" :rev \"v1\" :path \"a\\\"b.txt\" :start 9 :end n)")
(:case :id "nfDiffBase" :fn "nextForm" :opName "gitDiff" :op "(:step :base \"HEAD~1\" :path \"x\")" :start 2 :want "(:step :op \"gitDiff\" :path \"x\" :base \"HEAD~1\" :start 2 :end n)")
(:case :id "nfDiffNoBase" :fn "nextForm" :opName "gitDiff" :op "(:step :rev \"ignored\")" :start 3 :want "(:step :op \"gitDiff\" :start 3 :end n)")
(:case :id "nfLogLimitInt" :fn "nextForm" :opName "gitLog" :op "(:step :limit 5 :base \"ignored\")" :start 6 :want "(:step :op \"gitLog\" :limit 5 :start 6 :end n)")
(:case :id "nfLogLimitStr" :fn "nextForm" :opName "gitLog" :op "(:step :limit \"7\")" :start 8 :want "(:step :op \"gitLog\" :limit 7 :start 8 :end n)")
(:case :id "nfLogLimitEmpty" :fn "nextForm" :opName "gitLog" :op "(:step :limit \"\")" :start 2 :want "(:step :op \"gitLog\" :start 2 :end n)")
(:case :id "nfLogNoLimit" :fn "nextForm" :opName "gitLog" :op "(:step :path \"p\\nq\")" :start 2 :want "(:step :op \"gitLog\" :path \"p\\nq\" :start 2 :end n)")
(:case :id "gatesEmpty" :fn "runGates" :root "@BASE@/repo" :t 30 :env "clean" :n 0 :want "(gates)")
(:case :id "gatesPassAndFail" :fn "runGates" :root "@BASE@/repo" :t 30 :env "clean" :n 2 :g0 "echo hi; echo err >&2" :g1 "exit 3" :want "(gates (r (id \"ID\") (cmd \"echo hi; echo err >&2\") (exit 0) (stdout \"hi\\n\") (stderr \"err\\n\")) (r (id \"ID\") (cmd \"exit 3\") (exit 3) (stdout \"\") (stderr \"\")))")
(:case :id "gatesEnvBytecode" :fn "runGates" :root "@BASE@/repo" :t 30 :env "clean" :n 1 :g0 "echo \"[$PYTHONDONTWRITEBYTECODE]\"; pwd" :want "(gates (r (id \"ID\") (cmd \"echo \\\"[$PYTHONDONTWRITEBYTECODE]\\\"; pwd\") (exit 0) (stdout \"[1]\\n@BASE@/repo\\n\") (stderr \"\")))")
(:case :id "gatesNewlines" :fn "runGates" :root "@BASE@/repo" :t 30 :env "clean" :n 2 :g0 "printf 'a\\r\\nb\\rc'" :g1 "printf 'x\\r' >&2" :want "(gates (r (id \"ID\") (cmd \"printf 'a\\\\r\\\\nb\\\\rc'\") (exit 0) (stdout \"a\\nb\\nc\") (stderr \"\")) (r (id \"ID\") (cmd \"printf 'x\\\\r' >&2\") (exit 0) (stdout \"\") (stderr \"x\\n\")))")
(:case :id "gatesTimeout" :fn "runGates" :root "@BASE@/repo" :t 1 :env "clean" :n 1 :g0 "echo before; echo errBefore >&2; sleep 5; echo after" :want "(gates (r (id \"ID\") (cmd \"echo before; echo errBefore >&2; sleep 5; echo after\") (exit nil) (stdout \"before\\n\") (stderr \"errBefore\\n\") (timeout true) (seconds 1)))")
(:case :id "gatesMissingRoot" :fn "runGates" :root "@BASE@/nosuch" :t 30 :env "clean" :n 1 :g0 "echo never" :want "(gates (r (id \"ID\") (cmd \"echo never\") (exit 1) (stderr \"[Errno 2] No such file or directory: '@BASE@/nosuch'\")))")
(:case :id "gatesAliasRoot" :fn "runGates" :root "@BASE@/alias" :t 30 :env "clean" :n 1 :g0 "cat a.txt | wc -l | tr -d ' '" :want "(gates (r (id \"ID\") (cmd \"cat a.txt | wc -l | tr -d ' '\") (exit 0) (stdout \"6\\n\") (stderr \"\")))")
(:case :id "gatesInheritEnv" :fn "runGates" :root "@BASE@/repo" :t 30 :env "inherit" :n 1 :g0 "echo \"[$PYTHONDONTWRITEBYTECODE]\"" :want "(gates (r (id \"ID\") (cmd \"echo \\\"[$PYTHONDONTWRITEBYTECODE]\\\"\") (exit 0) (stdout \"[1]\\n\") (stderr \"\")))")
(:case :id "gatesTimeoutKillsGroup" :fn "runGatesGroup" :root "@BASE@/repo" :t 1 :env "clean" :n 1 :g0 "sleep 300 & echo $! > @BASE@/bg.pid; sleep 300" :want "(gates (r (id \"ID\") (cmd \"sleep 300 & echo $! > @BASE@/bg.pid; sleep 300\") (exit nil) (stdout \"\") (stderr \"\") (timeout true) (seconds 1))) (alive false)")
(:case :id "pfNone" :fn "preflight" :root "@BASE@/repo" :env "clean" :none 1 :n 0 :want "(bad)")
(:case :id "pfNoneFormat" :fn "formatPreflight" :of "pfNone" :want "")
(:case :id "pfEmpty" :fn "preflight" :root "@BASE@/repo" :env "clean" :none 0 :n 0 :want "(bad)")
(:case :id "pfEmptyFormat" :fn "formatPreflight" :of "pfEmpty" :want "")
(:case :id "pfAllValid" :fn "preflight" :root "@BASE@/repo" :env "clean" :none 0 :n 3 :g0 "echo ok" :g1 "true && false" :g2 "for i in 1 2; do echo $i; done" :want "(bad)")
(:case :id "pfAllValidFormat" :fn "formatPreflight" :of "pfAllValid" :want "")
(:case :id "pfStubSyntax" :fn "preflight" :root "@BASE@/repo" :env "shStub" :none 0 :n 4 :g0 "echo ok" :g1 "if then fi" :g2 "echo 'open" :g3 "echo \"q\" done" :want "(bad (r (n 2) (cmd \"if then fi\") (message \"stub sh: syntax error in: if then fi\\nsecond line\")) (r (n 3) (cmd \"echo 'open\") (message \"stub sh: syntax error in: echo 'open\\nsecond line\")))")
(:case :id "pfStubSyntaxFormat" :fn "formatPreflight" :of "pfStubSyntax" :want "(:n 2 :cmd \"if then fi\" :shell \"sh\" :message \"stub sh: syntax error in: if then fi\\nsecond line\") (:n 3 :cmd \"echo 'open\" :shell \"sh\" :message \"stub sh: syntax error in: echo 'open\\nsecond line\")")
(:case :id "pfQuietExit" :fn "preflight" :root "@BASE@/repo" :env "shQuiet" :none 0 :n 1 :g0 "echo x" :want "(bad (r (n 1) (cmd \"echo x\") (message \"sh -n exited 2\")))")
(:case :id "pfQuietExitFormat" :fn "formatPreflight" :of "pfQuietExit" :want "(:n 1 :cmd \"echo x\" :shell \"sh\" :message \"sh -n exited 2\")")
(:case :id "pfTimeout" :fn "preflight" :root "@BASE@/repo" :env "shSlow" :none 0 :n 1 :g0 "echo slow" :want "(bad (r (n 1) (cmd \"echo slow\") (message \"sh -n exited None\")))")
(:case :id "pfTimeoutFormat" :fn "formatPreflight" :of "pfTimeout" :want "(:n 1 :cmd \"echo slow\" :shell \"sh\" :message \"sh -n exited None\")")
(:case :id "pfMissingRoot" :fn "preflight" :root "@BASE@/nosuch" :env "clean" :none 0 :n 2 :g0 "echo x" :g1 "y" :want "(bad (r (n 1) (cmd \"echo x\") (message \"[Errno 2] No such file or directory: '@BASE@/nosuch'\")) (r (n 2) (cmd \"y\") (message \"[Errno 2] No such file or directory: '@BASE@/nosuch'\")))")
(:case :id "pfMissingRootFormat" :fn "formatPreflight" :of "pfMissingRoot" :want "(:n 1 :cmd \"echo x\" :shell \"sh\" :message \"[Errno 2] No such file or directory: '@BASE@/nosuch'\") (:n 2 :cmd \"y\" :shell \"sh\" :message \"[Errno 2] No such file or directory: '@BASE@/nosuch'\")")
(:case :id "pfEmptyRoot" :fn "preflight" :root "" :env "shStub" :none 0 :n 2 :g0 "echo ok" :g1 "((" :want "(bad (r (n 2) (cmd \"((\") (message \"stub sh: syntax error in: ((\\nsecond line\")))")
(:case :id "pfEmptyRootFormat" :fn "formatPreflight" :of "pfEmptyRoot" :want "(:n 2 :cmd \"((\" :shell \"sh\" :message \"stub sh: syntax error in: ((\\nsecond line\")")
(:case :id "ownsEmpty" :fn "changedOwned" :root "@BASE@/repo" :n 0 :want "(files)")
(:case :id "ownsModified" :fn "changedOwned" :root "@BASE@/repo" :n 2 :o0 "a.txt" :o1 "sub" :want "(files \"a.txt\" \"sub/new.txt\")")
(:case :id "ownsRenamed" :fn "changedOwned" :root "@BASE@/repo" :n 2 :o0 "b.txt" :o1 "b2.txt" :want "(files \"b.txt -> b2.txt\")")
(:case :id "ownsQuotedAndSpace" :fn "changedOwned" :root "@BASE@/repo" :n 2 :o0 "q\"t.txt" :o1 "sp ace.txt" :want "(files \"\\\"q\\\\\\\"t.txt\\\"\" \"\\\"sp ace.txt\\\"\")")
(:case :id "ownsUntrackedLink" :fn "changedOwned" :root "@BASE@/repo" :n 2 :o0 "outlink" :o1 "uni.txt" :want "(files \"outlink\")")
(:case :id "ownsWholeTree" :fn "changedOwned" :root "@BASE@/repo" :n 1 :o0 "." :want "(files \"a.txt\" \"b.txt -> b2.txt\" \"\\\"q\\\\\\\"t.txt\\\"\" \"\\\"sp ace.txt\\\"\" \"outlink\" \"sub/new.txt\")")
(:case :id "ownsNotRepo" :fn "changedOwned" :root "@BASE@/outside" :n 1 :o0 "o.txt" :want "(files)")
