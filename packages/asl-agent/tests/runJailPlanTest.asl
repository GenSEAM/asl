(module aslAgent/tests/runJailPlanTest
  :x [runTests]
  :i [(aslAgent/jail :a jl) (aslAgent/core :a c) (asl-tools/fleet/run :a fr)])

; (:m :ref FABLE-BLIND-03 :do "the jail plan with every input explicit, on a stand-in HOME under one <tmp>/leonjail-plan-<ns> directory removed at the end (tmp is /private/tmp where that is a directory, else /tmp): no sandbox tool means refused unless the stand-in HOME's config opts into the lexical guard, and a row in the unit's own root never counts; private caches start as a clone of the shared ones; under the OS sandbox the shared cache is readable and not writable while the rest of the stand-in HOME stays unreadable; the bwrap argv binds the shared cache read-only inside its own process namespace and /tmp. JAIL-LINUX: the bwrap argv is asserted as data on any machine (/run masked, the hidden HOME sealed read-only), and the no-clone seed of the native CLI cache runs here with the clone kind passed as none. Where this test already runs inside a sandbox the tool probe is empty and the end-to-end part is skipped by name")
fn ! readText! p: String -> String
  (resultOr (fileReadString p) "")

fn rowOf rows: (List String) name: String -> String
  (optionOr (listHead (filter (fn [row] (stringStartsWith? row (str name "="))) rows)) "")

; (:m :ref JAIL-LINUX :do "D4: macOS keeps its fixtures under /private/tmp, the real path of /tmp there; Linux has no /private")
fn ! tmpBase! -> String
  (match (fileStat "/private/tmp") ((ok st) (if st.isDir "/private/tmp" "/tmp")) ((err _) "/tmp"))

fn ! mtimeOf! p: String -> Int64
  (match (fileStat p) ((ok st) st.mtimeNs) ((err _) -1))

fn ! runTests -> Bool
  (let [base (str (tmpBase!) "/leonjail-plan-" (stringFromInt64 (monotonicNs)))
        root (str base "/root")
        fakeHome (str base "/realHome")
        optHome (str base "/optHome")
        sharedCli (str fakeHome "/.asl/run/nativeCli")
        sharedCheck (str base "/sharedCheck")
        madeDirs (and (ok? (dirCreate root)) (and (ok? (dirCreate sharedCli)) (and (ok? (dirCreate sharedCheck)) (ok? (dirCreate (str optHome "/.asl"))))))
        wroteShared (and (ok? (fileWrite (str sharedCli "/head_x") "pointer\n")) (and (ok? (fileWrite (str sharedCheck "/entry") "checked\n")) (ok? (fileWrite (str fakeHome "/secret.txt") "secret\n"))))
        wroteOpt (fileWrite (str optHome "/.asl/config.asn") "(:config (:agentLoop (:jailLexicalOnly true)))\n")
        wroteRootOpt (fileWrite (str root "/.asl.config.asn") "(:config (:agentLoop (:jailLexicalOnly true)))\n")
        rootHead (jl/cliHeadName (resultOr (realPath root) root))
        activeCli (str sharedCli "/cli-active")
        wroteEntry (and (ok? (dirCreate activeCli)) (and (ok? (fileWrite (str activeCli "/bin") "binary\n")) (and (ok? (dirCreate (str sharedCli "/cli-other"))) (and (ok? (fileWrite (str sharedCli "/cli-other/bin") "other\n"))
                     (and (ok? (fileWrite (str sharedCli "/" rootHead) (str activeCli "\n"))) (ok? (fileUtime (str sharedCli "/" rootHead) 1700000000000000000)))))))
        wroteNo (fileWrite (str fakeHome "/.asl/config.asn") "(:config (:agentLoop (:jailLexicalOnly false)))\n")
        inherited (list "PATH=/usr/bin:/bin" (str "ASL_CHECK_CACHE=" sharedCheck))
        home (jl/jailHome root)
        kind (jl/cloneKind! base)
        rows (jl/childEnvIn! root inherited (list) fakeHome true)
        seedReport (readText! (str home "/.asl/seedReport.asn"))
        seededBin (readText! (str home "/.asl/run/nativeCli/cli-active/bin"))
        seededCli (readText! (str home "/.asl/run/nativeCli/head_x"))
        seededCheck (readText! (str home "/.asl/cache/check/entry"))
        sources (map pairSecond (jl/cacheSources! inherited fakeHome))
        heads (jl/currentHeads (resultOr (realPath root) root) (list "PATH=/usr/bin:/bin"))
        plainHome (str base "/plainHome")
        plainCli (str plainHome "/.asl/run/nativeCli")
        plainRows (jl/seedCachesWith! "none" plainHome (jl/cacheSources! inherited fakeHome) heads)
        plainHead (readText! (str plainCli "/" rootHead))
        plainOther (readText! (str plainCli "/head_x"))
        plainBin (readText! (str plainCli "/cli-active/bin"))
        plainStray (ok? (fileStat (str plainCli "/cli-other")))
        plainCheck (ok? (fileStat (str plainHome "/.asl/cache/check")))
        plainLeft (resultOr (dirList (str plainHome "/.asl/run")) (list))
        plainStamp (mtimeOf! (str plainCli "/" rootHead))
        lostHome (str base "/lostHome")
        lostRows (jl/seedCachesWith! "none" lostHome (jl/cacheSources! inherited fakeHome) (list "head_absent"))
        lostLeft (resultOr (dirList (str lostHome "/.asl/run")) (list))
        strayHome (str base "/strayHome")
        wroteStray (fileWrite (str sharedCli "/head_stray") (str fakeHome "/secret.txt\n"))
        strayRows (jl/seedCachesWith! "none" strayHome (jl/cacheSources! inherited fakeHome) (list "head_stray"))
        coldRoot (str base "/cold")
        madeCold (dirCreate coldRoot)
        coldRows (jl/childEnvIn! coldRoot inherited (list) fakeHome false)
        coldSeeded (ok? (fileStat (str (jl/jailHome coldRoot) "/.asl/run/nativeCli/head_x")))
        optNo (or (jl/lexicalOptIn! fakeHome) (or (jl/lexicalOptIn! root) (jl/lexicalOptIn! "")))
        optYes (jl/lexicalOptIn! optHome)
        refusedPlan (jl/jailPlan! "" (jl/lexicalOptIn! fakeHome) root home rows (list) (list) false fakeHome sources)
        optPlan (jl/jailPlan! "" (jl/lexicalOptIn! optHome) root home rows (list) (list) false optHome (list))
        tool (jl/jailTool!)
        plan (jl/jailPlan! tool false root home rows (list) (list) false fakeHome sources)
        script (str "echo planted > " sharedCli "/planted 2> /dev/null; echo planted > " sharedCheck "/planted 2> /dev/null; "
                 "cat " sharedCli "/head_x > readShared.txt 2> /dev/null; cat " fakeHome "/secret.txt > readSecret.txt 2> /dev/null; "
                 "echo own > \"$ASL_NATIVE_CLI_CACHE/own.txt\"; exit 0")
        ran (if (stringEmpty? tool) -1 (fr/runOneLimited (fr/job (jl/jailWrap! plan (list "/bin/sh" "-c" script)) root rows) (fr/limits 30 16)).exit)
        plantedCli (ok? (fileStat (str sharedCli "/planted")))
        plantedCheck (ok? (fileStat (str sharedCheck "/planted")))
        readShared (readText! (str root "/readShared.txt"))
        readSecret (readText! (str root "/readSecret.txt"))
        ownSeen (readText! (str home "/.asl/run/nativeCli/own.txt"))
        linux (jl/Jail :mode "os" :tool "/usr/bin/bwrap" :root "/r/unit" :writes (list "/r/unit" "/r/unit/.asl/run/agentLoop/home") :reads (list "/h/.asl/run/nativeCli") :lists (list) :realHome "/h" :net false)
        bwrap (c/joinSep (jl/bwrapArgs linux) " ")
        bwrapNet (c/joinSep (jl/bwrapArgs (with linux :net true)) " ")
        bwrapHomeWrite (c/joinSep (jl/bwrapArgs (with linux :writes (list "/r/unit" "/h"))) " ")
        bwrapNoHome (c/joinSep (jl/bwrapArgs (with linux :realHome "")) " ")
        profile (jl/seatbeltProfile (with linux :tool "sandbox-exec"))
        cleaned (pathRemove base)]
    (do
      (assert (and madeDirs (and wroteShared (and wroteEntry (and (ok? wroteStray) (and (ok? wroteOpt) (and (ok? wroteRootOpt) (and (ok? wroteNo) (ok? madeCold)))))))) "the fixture (root, stand-in HOME with a shared cache holding an active and an unused cli entry and a secret, opt-in HOME) was built")
      (assert (= (jl/jailMode "" false) "refused") "no sandbox tool and no opt-in is refused")
      (assert (= (jl/jailMode "" true) "lexical") "no sandbox tool with the opt-in is lexical")
      (assert (and (= (jl/jailMode "sandbox-exec" false) "os") (= (jl/jailMode "/usr/bin/bwrap" true) "os")) "a sandbox tool is used whatever the opt-in says")
      (assert (not optNo) "false, a row in the unit's root config, or no HOME is not an opt-in")
      (assert optYes "<HOME>/.asl/config.asn :agentLoop (:jailLexicalOnly true) is the opt-in")
      (assert (and (= refusedPlan.mode "refused") (stringContains? (jl/absentNote refusedPlan) "ERR_RUN_SANDBOX_ABSENT")) "a plan without a tool is refused and says so")
      (assert (= (listTake (jl/jailWrap! refusedPlan (list "/bin/echo" "ran")) 2) (list "/bin/sh" "-c")) "a refused plan wraps to the refusal stub, not the command")
      (assert (and (= optPlan.mode "lexical") (= (jl/jailWrap! optPlan (list "/bin/echo" "ran")) (list "/bin/echo" "ran"))) "an opted-in plan is lexical and leaves the argv alone")
      (assert (= (rowOf rows "ASL_NATIVE_CLI_CACHE") (str "ASL_NATIVE_CLI_CACHE=" home "/.asl/run/nativeCli")) "the native CLI cache row is private")
      (assert (= (rowOf rows "ASL_CHECK_CACHE") (str "ASL_CHECK_CACHE=" home "/.asl/cache/check")) "an inherited cache row is replaced by the private one")
      (assert (and (= seededCli "pointer\n") (= seededBin "binary\n")) (str "a new private cache starts as a clone of its shared source: the pointers and the active cli entry on every file system, clone kind " kind ", got " seededCli " " seededBin))
      (assert (= seededCheck (if (= kind "none") "" "checked\n")) (str "the check cache is cloned where the file system clones (macOS clonefile, reflink) and starts cold where it cannot (ext4: a plain copy of gigabytes is not made), clone kind " kind ", got " seededCheck))
      (assert (stringContains? seedReport (str "(:seed :cache \"ASL_NATIVE_CLI_CACHE\" :how \"" (if (= kind "none") "cliEntry" "clone") "\")")) (str "the seed outcome of each cache is written to the jail home's seed report: " seedReport))
      (assert (and (= (jl/seedHow "clonefile" true "ASL_CHECK_CACHE") "clone") (and (= (jl/seedHow "reflink" false "ASL_NATIVE_CLI_CACHE") "cliEntry") (and (= (jl/seedHow "none" false "ASL_NATIVE_CLI_CACHE") "cliEntry") (and (= (jl/seedHow "none" false "ASL_CHECK_CACHE") "cold") (stringStartsWith? (jl/seedHow "reflink" false "ASL_CHECK_CACHE") "failed")))))
        "a clone that worked is the seed; without one the native CLI cache falls back to its active entry, another cache is cold without a clone kind and failed when its clone broke")
      (assert (and (listContains? plainRows (pair "ASL_NATIVE_CLI_CACHE" "cliEntry")) (listContains? plainRows (pair "ASL_CHECK_CACHE" "cold"))) (str "without a clone kind the native CLI cache is seeded from its active entry and the check cache is reported cold: " (c/joinSep (map (fn [r] (str (pairFirst r) "=" (pairSecond r))) plainRows) " ")))
      (assert (and (= plainBin "binary\n") (= plainOther "pointer\n")) (str "the no-clone seed copies the active cli directory and every head pointer, got " plainBin " " plainOther))
      (assert (= plainHead (str plainCli "/cli-active\n")) (str "the root's private head pointer names the private copy, got " plainHead))
      (assert (= plainStamp 1700000000000000000) (str "the repointed head keeps the shared pointer's mtime, so a stale CLI still reads as stale, got " (stringFromInt64 plainStamp)))
      (assert (and (not plainStray) (and (not plainCheck) (= plainLeft (list "nativeCli")))) (str "the no-clone seed copies no other cli directory, no other cache, and leaves no partial copy: " (c/joinSep plainLeft " ")))
      (assert (and (listAny? (fn [r] (and (= (pairFirst r) "ASL_NATIVE_CLI_CACHE") (stringStartsWith? (pairSecond r) "failed: no head pointer"))) lostRows) (listEmpty? lostLeft)) (str "a root with no head pointer in the shared cache is a reported failed seed that leaves nothing behind: " (jl/seedReportText lostRows)))
      (assert (and (listAny? (fn [r] (and (= (pairFirst r) "ASL_NATIVE_CLI_CACHE") (stringStartsWith? (pairSecond r) "failed"))) strayRows) (not (ok? (fileStat (str strayHome "/.asl/run/nativeCli"))))) "a head pointer naming anything but a cli directory inside the shared cache copies nothing")
      (assert (stringContains? (jl/seedReportText lostRows) "(:seed :cache \"ASL_NATIVE_CLI_CACHE\" :how \"failed: no head pointer") "a failed seed is a row of the seed report, not a silent cold start")
      (assert (and (not coldSeeded) (= (rowOf coldRows "ASL_NATIVE_CLI_CACHE") (str "ASL_NATIVE_CLI_CACHE=" (jl/jailHome coldRoot) "/.asl/run/nativeCli"))) "without seeding the private cache is empty and still private")
      (assert (and (listContains? sources sharedCli) (listContains? sources sharedCheck)) "the shared caches are the read-only sources")
      (assert (or (stringEmpty? tool) (and (listContains? plan.reads sharedCli) (not (listAny? (fn [w] (or (= w sharedCli) (= w sharedCheck))) plan.writes)))) "the plan reads the shared caches and never writes them")
      (assert (or (stringEmpty? tool) (= ran 0)) (str "the probe ran inside the sandbox, exit " (stringFromInt64 ran)))
      (assert (and (not plantedCli) (not plantedCheck)) "a unit child cannot plant a file in a shared cache")
      (assert (or (stringEmpty? tool) (= readShared "pointer\n")) (str "a unit child reads the shared cache, got " readShared))
      (assert (stringEmpty? readSecret) "the rest of the stand-in HOME stays unreadable")
      (assert (or (stringEmpty? tool) (= ownSeen "own\n")) "a unit child writes its private cache")
      (assert (stringContains? bwrap "--ro-bind /h/.asl/run/nativeCli /h/.asl/run/nativeCli") "bwrap binds the shared cache read-only")
      (assert (not (stringContains? bwrap "--bind /h/.asl/run/nativeCli")) "bwrap never binds the shared cache read-write")
      (assert (and (stringContains? bwrap "--unshare-pid") (and (stringContains? bwrap "--proc /proc") (stringContains? bwrap "--tmpfs /tmp"))) "bwrap gives the child its own process namespace, /proc and /tmp")
      (assert (stringContains? bwrap "--tmpfs /tmp --tmpfs /run") "D1: bwrap masks /run (D-Bus, the user systemd manager, agent sockets) with an empty tmpfs")
      (assert (and (not (stringContains? bwrap "/run/systemd/resolve")) (stringContains? bwrapNet "--tmpfs /run --ro-bind-try /run/systemd/resolve /run/systemd/resolve")) "D1: the resolver directory is bound back under the masked /run only with :net true")
      (assert (stringContains? bwrap "--bind /r/unit/.asl/run/agentLoop/home /r/unit/.asl/run/agentLoop/home --remount-ro /h --unshare-net") (str "D3: the tmpfs over the real HOME is sealed read-only after every bind, so a write there fails instead of vanishing: " bwrap))
      (assert (and (not (stringContains? bwrapHomeWrite "--remount-ro")) (not (stringContains? bwrapNoHome "--remount-ro"))) "D3: a HOME the jail writes, or no HOME, is not sealed")
      (assert (not (stringContains? profile "no-sandbox")) "nothing in the seatbelt profile runs outside the sandbox")
      (assert (stringContains? profile "(deny process-info*)(allow process-info* (target same-sandbox))") "process information stops at the sandbox")
      (assert (stringContains? profile "(deny signal)(allow signal (target same-sandbox))") "signals stop at the sandbox")
      (assert (ok? cleaned) "the fixture directory was removed")
      true))
