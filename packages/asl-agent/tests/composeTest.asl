(module asl/packages/asl-agent/tests/composeTest :x [runTests] :i [(asl-text/string :a s) (aslAgent/computerUse :a cu) (aslAgent/compose :a cmp) (aslAgent/cli :a cli) (aslAgent/policy :a pol)])

fn testAgentSyntaxModernization! -> Bool
  (let [(resCli (fileRead "asl/packages/asl-agent/src/cli.asl")) (codeCli (resultOr resCli "")) (resCmp (fileRead "asl/packages/asl-agent/src/compose.asl")) (codeCmp (resultOr resCmp "")) (resCu (fileRead "asl/packages/asl-agent/src/computerUse.asl")) (codeCu (resultOr resCu ""))] (assert (ok? resCli) "cli.asl must exist and be readable") (refute (err? resCli) "cli.asl refutes read failure") (assert (stringContains? codeCli "fn makeCliOptions") "cli.asl affirms modern fn makeCliOptions") (assert (stringContains? codeCli "fn parseCliArgs") "cli.asl affirms modern fn parseCliArgs") (refute (stringContains? codeCli "(df ") "cli.asl refutes legacy df definitions") (refute (stringContains? codeCli "(defun ") "cli.asl refutes legacy defun") (assert (ok? resCmp) "compose.asl must exist and be readable") (refute (err? resCmp) "compose.asl refutes read failure") (assert (stringContains? codeCmp "fn makeEmptyComposition") "compose.asl affirms modern fn makeEmptyComposition") (assert (stringContains? codeCmp "fn addUnresolvedQuestion") "compose.asl affirms modern fn addUnresolvedQuestion") (refute (stringContains? codeCmp "(df ") "compose.asl refutes legacy df definitions") (refute (stringContains? codeCmp "(defun ") "compose.asl refutes legacy defun") (assert (ok? resCu) "computerUse.asl must exist and be readable") (refute (err? resCu) "computerUse.asl refutes read failure") (assert (stringContains? codeCu "fn makeSpatialBox") "computerUse.asl affirms modern fn makeSpatialBox") (assert (stringContains? codeCu "fn executeComputerAction") "computerUse.asl affirms modern fn executeComputerAction") (refute (stringContains? codeCu "(df ") "computerUse.asl refutes legacy df definitions") (refute (stringContains? codeCu "(defun ") "computerUse.asl refutes legacy defun") (refute (stringContains? codeCu "string-from-i64") "computerUse.asl refutes obsolete string-from-i64") (assert (stringContains? codeCu "stringFromInt64") "computerUse.asl affirms canonical stringFromInt64") true)

fn testComputerUsePrimitivesAndPayloads -> Bool
  (let [(box (cu/makeSpatialBox 120 240 800 600))] (assert (= box.x 120) "box x coordinate must match") (assert (= box.y 240) "box y coordinate must match") (assert (= box.width 800) "box width must match") (assert (= box.height 600) "box height must match") (refute (< box.x 0) "box x refutes negative coordinate") (refute (< box.width 0) "box width refutes negative dimension") (let [(actClick (cu/makeComputerAction "act-1" (cu/substrateBrowser) (cu/actionClick) "#btn-submit" "" box false)) (actDestr (cu/makeComputerAction "act-2" (cu/substrateTerminal) (cu/actionType) "terminal" "rm -rf /tmp" box true)) (actConf (cu/confirmComputerAction actDestr))] (assert (cu/isActionPermitted? actClick) "non-destructive action is permitted") (refute (cu/isActionPermitted? actDestr) "unconfirmed destructive action is not permitted") (assert (cu/isActionPermitted? actConf) "confirmed destructive action is permitted") (let [(cdp (cu/formatCdpPayload actClick))] (assert (stringContains? cdp "\"x\":120") "CDP click payload contains x coordinate") (assert (stringContains? cdp "\"y\":240") "CDP click payload contains y coordinate") (assert (stringContains? cdp "Input.dispatchMouseEvent") "CDP click payload contains method") (refute (stringContains? cdp "undefined") "CDP payload refutes undefined tokens") (let [(ax (cu/formatAccessibilityPayload actClick))] (assert (stringContains? ax ":box (:x 120 :y 240)") "accessibility payload contains box coordinates") (assert (stringContains? ax ":target \"#btn-submit\"") "accessibility payload contains target selector") (let [(receipt (cu/ComputerActionReceipt :actionId "act-1" :exitCode 0 :status "success" :observation "clicked button" :durationMs 15)) (recAsn (cu/formatComputerReceiptAsn receipt))] (assert (stringContains? recAsn ":id \"act-1\"") "receipt ASN contains id") (assert (stringContains? recAsn ":status \"success\"") "receipt ASN contains status") (assert (stringContains? recAsn ":exit 0") "receipt ASN contains exit code") (assert (stringContains? recAsn ":latency-ms 15") "receipt ASN contains latency") (refute (stringContains? recAsn ":exit -1") "receipt ASN refutes wrong exit code") true)))))

fn testCompositionModelAndReasoning -> Bool
  (let [(c0 (cmp/makeEmptyComposition))] (assert (= (listLength c0.openQuestions) 0) "empty composition has 0 open questions") (assert (= (listLength c0.assumedFacts) 0) "empty composition has 0 assumed facts") (refute (> (listLength c0.openQuestions) 0) "empty composition refutes non-empty questions") (let [(q1 (cmp/makeUnresolvedQuestion "u1" "API port?" (cmp/operator))) (q2 (cmp/makeUnresolvedQuestion "u2" "Database schema location?" (cmp/lookup))) (c1 (cmp/addUnresolvedQuestion c0 q1)) (c2 (cmp/addUnresolvedQuestion c1 q2))] (assert (= (listLength c2.openQuestions) 2) "composition has 2 open questions") (refute (= (listLength c2.openQuestions) 1) "composition refutes 1 question") (let [(f1 (cmp/makeAssumedFact "a1" "Port 8080 default")) (c3 (cmp/addAssumedFact c2 f1)) (rendered (cmp/renderCompositionContext c3))] (assert (stringContains? rendered ":open-count 2") "rendered context affirms open-count 2") (assert (stringContains? rendered ":assumed-count 1") "rendered context affirms assumed-count 1") (refute (stringContains? rendered ":open-count 0") "rendered context refutes open-count 0") (let [(c4 (cmp/closeUnresolvedQuestion c3 "u1"))] (assert (= (listLength c4.openQuestions) 1) "open questions decreased to 1 after close") (refute (= (listLength c4.openQuestions) 2) "open questions refutes 2 after close") (let [(lookups (cmp/extractPendingLookups c4))] (assert (= (listLength lookups) 1) "pending lookups length is 1") (let [(c5 (cmp/resolveLookupQuestion c4 "u2" "schema in db/schema.asl"))] (assert (= (listLength c5.openQuestions) 0) "all questions resolved") (assert (= (listLength c5.assumedFacts) 2) "assumed facts increased to 2") (refute (= (listLength c5.assumedFacts) 1) "facts refutes 1 after resolution") true))))))

fn ! runTests -> Bool
  (and (testAgentSyntaxModernization!) (and (testComputerUsePrimitivesAndPayloads) (testCompositionModelAndReasoning)))
