(module aslAgent/tests/busTest
  :x [runTests]
  :i [(aslAgent/bus :a bus)
      (asl-tools/fleet/run :a fr)])

; (:m :ref SIGNAL-LEON-DONE :do "the shared terminal-run inbox on a scratch HOME, never the real one: whole single-line rows, the lock serialises writers, waitFor returns the row, a deadline returns none, a row that lands mid-wait is found")
fn ev unit: String at: Int64 -> bus/BusEvent
  (bus/BusEvent :unit unit :stop "done" :head "abc1234" :gates "G1 G2" :exit 0 :asserts 12 :receiptPath "/tmp/r \"q\".asn" :at at)

fn nowMs -> Int64
  (/ (nowNs) 1000000)

fn ! runTests -> Bool
  (let [(home (stringTrim (resultOr (fr/shellOut "/usr/bin/mktemp -d /tmp/busTest.XXXXXX" 5000) "")))
        (path (bus/busPath home))
        (none0 (bus/readEvents! path))
        (e1 (bus/emitTerminal! path (ev "U1" 100)))
        (e2 (bus/emitTerminal! path (ev "U2" 200)))
        (bad (bus/emitTerminal! path (ev "" 300)))
        (text (resultOr (fileReadString path) ""))
        (rows (match (bus/readEvents! path) ((ok r) r) ((err _) (list))))
        (lines (filter (fn [(s String)] -> Bool (not (stringEmpty? s))) (stringSplit text "\n")))
        (held (fileLock (str path ".lock") true))
        (blocked (bus/emitTerminal! path (ev "U3" 300)))
        (rowsBlocked (match (bus/readEvents! path) ((ok r) (listLength r)) ((err _) -1)))
        (released (match held ((ok fd) (fdClose fd)) ((err e) (err e))))
        (after (bus/emitTerminal! path (ev "U3" 300)))
        (found (bus/waitFor! path "U2" 0 (+ (nowMs) 2000)))
        (stale (bus/waitFor! path "U2" 201 (+ (nowMs) 300)))
        (t0 (nowMs))
        (missing (bus/waitFor! path "NOPE" 0 (+ t0 400)))
        (src (str home "/late.asn"))
        (w (fileWrite src (str (bus/eventLine (ev "LATE" 500)) "\n")))
        (t1 (nowMs))
        (bg (fr/shellOut (str "(/bin/sleep 1; /bin/cat " src " >> " path ") >/dev/null 2>&1 &") 5000))
        (late (bus/waitFor! path "LATE" 0 (+ t1 8000)))
        (torn (fileAppend path "(:event :unit \"TORN\" :stop"))
        (tornRows (match (bus/readEvents! path) ((ok r) r) ((err _) (list))))
        (cleaned (fr/shellOut (str "/bin/rm -rf " home) 5000))]
    (do
      (assert (= none0 (ok (list))) "no file means no events")
      (assert (and (ok? e1) (ok? e2)) "two emits succeed")
      (assert (err? bad) "an event without a unit is refused")
      (assert (= (listLength lines) 2) (str "two rows, one line each: " text))
      (assert (and (= (listLength rows) 2) (= (listGet rows 0) (some (ev "U1" 100))) (= (listGet rows 1) (some (ev "U2" 200))))
        "both rows parse back whole, quotes in a field intact")
      (assert (err? blocked) "while another process holds the lock an emit waits out its bounded retries and errs")
      (assert (= rowsBlocked 2) "the blocked emit wrote nothing")
      (assert (and (ok? released) (ok? after)) "after release the emit goes through")
      (assert (= found (some (ev "U2" 200))) "waitFor returns the unit's row")
      (assert (= stale none) "a row older than sinceMs is not returned")
      (assert (= missing none) "the deadline returns none")
      (assert (and (ok? bg) (= late (some (ev "LATE" 500))))
        "a row that lands mid-wait is returned")
      (assert (= (listLength tornRows) 4) (str "a half-written last line is not a row: " (stringFromInt64 (listLength tornRows))))
      (assert (= (bus/parseEvent "(:event :unit \"X\")") none) "a row missing fields is not an event")
      (assert (ok? cleaned) "scratch removed")
      true))
