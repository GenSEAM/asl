(module aslAgent/tuiWorkspaceRouterTest :x [testTuiWorkspaceRouter! runTests] :i [(aslAgent/tuiWorkspaceRouter :a r)])

fn testTuiWorkspaceRouter! -> Bool
  (let [(s0 (r/makeInitialRouterState!))
        (f0Str (r/focusTargetToString s0.focus))
        (s1 (r/cycleFocusForward s0))
        (f1Str (r/focusTargetToString s1.focus))
        (s2 (r/cycleFocusForward s1))
        (f2Str (r/focusTargetToString s2.focus))
        (s3 (r/cycleFocusForward s2))
        (f3Str (r/focusTargetToString s3.focus))
        (s4 (r/cycleFocusForward s3))
        (f4Str (r/focusTargetToString s4.focus))
        (s5 (r/cycleFocusForward s4))
        (f5Str (r/focusTargetToString s5.focus))
        (sBack (r/cycleFocusBackward s1))
        (fBackStr (r/focusTargetToString sBack.focus))
        (sProjNext (r/selectNextItem s1))
        (sProjPrev (r/selectPrevItem sProjNext))
        (sPrompt (r/setPromptBuffer s0 "Implement Phase 612 TUI Cockpit"))
        (payload (r/formatOmniIntentPayload sPrompt))
        (sCleared (r/clearPromptBuffer sPrompt))]
    (assert (= f0Str "workspace") "Initial focus is workspace")
    (assert (= f1Str "project") "Focus cycles to project")
    (assert (= f2Str "tasks") "Focus cycles to tasks")
    (assert (= f3Str "observatory") "Focus cycles to observatory")
    (assert (= f4Str "omniPrompt") "Focus cycles to omniPrompt")
    (assert (= f5Str "workspace") "Focus cycles back to workspace")
    (assert (= fBackStr "workspace") "Backward focus cycles to workspace")
    (assert (= sProjNext.selectedProjectIdx 1) "selectNextItem advances project index to 1")
    (assert (= sProjPrev.selectedProjectIdx 0) "selectPrevItem returns project index to 0")
    (assert (= sPrompt.promptBuffer "Implement Phase 612 TUI Cockpit") "Prompt buffer set correctly")
    (assert (= sCleared.promptBuffer "") "Prompt buffer cleared")
    (assert (stringContains? payload ":omniIntentPayload") "Payload has omniIntentPayload root")
    (assert (stringContains? payload (optionOr (envGet "PWD") ".")) "Payload contains the active workspace URI from this process")
    (assert (stringContains? payload "asl/packages/asl-core") "Payload contains active project path")
    (assert (stringContains? payload "Implement Phase 612 TUI Cockpit") "Payload contains prompt text")

    (refute (= (r/focusTargetToString s0.focus) "omniPrompt")
      "Initial focus must not be omniPrompt")

    (refute (stringEmpty? payload)
      "Formatted omni intent payload must never be empty")
    true)

fn ! runTests -> Bool
  (testTuiWorkspaceRouter!)
