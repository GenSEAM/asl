(:planFixture :cases 54 :date "2026-09-26")
(:case :id "tree_simple" :fn "planTree" :input "(:plan (:step :id s1 :do \"test\" :check \"c\"))" :status "ok")
(:case :id "tree_escapes" :fn "planTree" :input "(:step :id s1 :do \"hello \\\"world\\\"\\n\\\\\")" :status "ok")
(:case :id "tree_unbalanced_open" :fn "planTree" :input "(:step :id s1" :status "err" :want "an unbalanced '('")
(:case :id "tree_unbalanced_close" :fn "planTree" :input ")" :status "err" :want "an unbalanced ')'")
(:case :id "tree_unclosed_quote" :fn "planTree" :input "\"hello" :status "err" :want "an unbalanced '('")
(:case :id "fields_flag_and_stray" :fn "planFields" :input "(:item :flag stray :key \"val\" trailingStray :flag2)" :status "ok" :want "(fields (kv (flag \"stray\") (key \"val\") (flag2 true)) (lists))")
(:case :id "fields_stray_leading" :fn "planFields" :input "(:item strayItem :flag1 :flag2 :name \"test\")" :status "ok" :want "(fields (kv (flag1 true) (flag2 true) (name \"test\")) (lists))")
(:case :id "steps_valid_two" :fn "planSteps" :input "((:step :id s1 :do \"task 1\" :check \"check 1\") (:step :id s2 :do \"task 2\" :check \"\"))" :status "ok" :want "((:step :id s1 :do \"task 1\" :check \"check 1\") (:step :id s2 :do \"task 2\"))")
(:case :id "steps_invalid_not_step" :fn "planSteps" :input "((:notstep :id s1))" :status "err" :want "each plan item is (:step :id s :do s :check s)")
(:case :id "steps_invalid_id" :fn "planSteps" :input "((:step :id \"bad id\" :do \"d\"))" :status "err" :want "a step :id is 1 to 32 letters, digits, '_', '.' or '-'")
(:case :id "steps_missing_do" :fn "planSteps" :input "((:step :id s1 :do \"   \"))" :status "err" :want "step s1 needs :do s, and :check is a string")
(:case :id "steps_duplicate_id" :fn "planSteps" :input "((:step :id s1 :do \"a\") (:step :id s1 :do \"b\"))" :status "err" :want "step id s1 appears twice")
(:case :id "steps_empty" :fn "planSteps" :input "()" :status "err" :want "a plan holds at least one (:step :id s :do s :check s)")
(:case :id "steps_flag_and_stray" :fn "planSteps" :input "((:step stray1 :flag :id s1 :do \"task 1\" :check \"check 1\" stray2 :flag2))" :status "ok" :want "((:step :id s1 :do \"task 1\" :check \"check 1\"))")
(:case :id "steps_do_over_chars" :fn "planSteps" :input "((:step :id s1 :do \"\" :check \"c\"))" :status "err" :want "step s1: :do and :check are at most 300 chars each")
(:case :id "steps_check_over_chars" :fn "planSteps" :input "((:step :id s1 :do \"d\" :check \"\"))" :status "err" :want "step s1: :do and :check are at most 300 chars each")
(:case :id "steps_over_max_steps" :fn "planSteps" :input "((:step :id s1 :do \"d\") (:step :id s2 :do \"d\") (:step :id s3 :do \"d\") (:step :id s4 :do \"d\") (:step :id s5 :do \"d\") (:step :id s6 :do \"d\") (:step :id s7 :do \"d\") (:step :id s8 :do \"d\") (:step :id s9 :do \"d\") (:step :id s10 :do \"d\") (:step :id s11 :do \"d\") (:step :id s12 :do \"d\") (:step :id s13 :do \"d\") (:step :id s14 :do \"d\") (:step :id s15 :do \"d\") (:step :id s16 :do \"d\") (:step :id s17 :do \"d\") (:step :id s18 :do \"d\") (:step :id s19 :do \"d\") (:step :id s20 :do \"d\") (:step :id s21 :do \"d\"))" :status "err" :want "a plan holds at most 20 steps")
(:case :id "open_all" :fn "planOpen" :input "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"\") (:step :id s2 :do \"d2\" :check \"\")) :done () :dropped ())" :want "s1 s2")
(:case :id "open_some" :fn "planOpen" :input "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"\") (:step :id s2 :do \"d2\" :check \"\") (:step :id s3 :do \"d3\" :check \"\")) :done ((:done :id s1 :ev \"ev1\")) :dropped ((:dropped :id s2 :why \"why\")))" :want "s3")
(:case :id "open_none" :fn "planOpen" :input "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"\")) :done ((:done :id s1 :ev \"ev1\")) :dropped ())" :want "")
(:case :id "advance_initial" :fn "planAdvance" :input "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"\") (:step :id s2 :do \"d2\" :check \"\")) :done () :dropped ())" :turn 1 :wantCurrent "s1" :wantSince 1)
(:case :id "advance_same" :fn "planAdvance" :input "(:planState :on true :current \"s1\" :since 1 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"\") (:step :id s2 :do \"d2\" :check \"\")) :done () :dropped ())" :turn 2 :wantCurrent "s1" :wantSince 1)
(:case :id "advance_next" :fn "planAdvance" :input "(:planState :on true :current \"s2\" :since 3 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"\") (:step :id s2 :do \"d2\" :check \"\")) :done ((:done :id s1 :ev \"ev1\")) :dropped ())" :turn 3 :wantCurrent "s2" :wantSince 3)
(:case :id "slot_empty" :fn "planSlot" :input "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps () :done () :dropped ())" :want "")
(:case :id "slot_steps" :fn "planSlot" :input "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\" :check \"\")) :done () :dropped ())" :want "(:plan (:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\"))")
(:case :id "now_no_steps" :fn "planNow" :input "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps () :done () :dropped ())" :turn 1 :want "(:none)")
(:case :id "now_nudge" :fn "planNow" :input "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn 2 :steps () :done () :dropped ())" :turn 2 :want "(:missing \"no plan yet: add (:plan (:step :id s1 :do s :check s) ...) beside your next steps\")")
(:case :id "now_active" :fn "planNow" :input "(:planState :on true :current \"s1\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"\") (:step :id s2 :do \"d2\" :check \"\")) :done () :dropped ())" :turn 3 :want "(:done () :current s1 :turnsOnCurrent 2)")
(:case :id "now_reconciled" :fn "planNow" :input "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"\") (:step :id s2 :do \"d2\" :check \"\")) :done ((:done :id s1 :ev \"ev1\")) :dropped ((:dropped :id s2 :why \"why\")))" :turn 4 :want "(:done (s1) :dropped (s2) :allReconciled true)")
(:case :id "summary_counts" :fn "planSummary" :input "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"\") (:step :id s2 :do \"d2\" :check \"\")) :done ((:done :id s1 :ev \"ev1\")) :dropped ((:dropped :id s2 :why \"why\")))" :want "2 1 1 0")
(:case :id "field_str" :fn "planField" :steps 2 :done 1 :dropped 1 :revisions 0 :want " :plan (:steps 2 :done 1 :dropped 1 :revisions 0)")
(:case :id "evidence_ids" :fn "planEvidenceIds" :want "e1 e5")
(:case :id "step_plan_init" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps () :done () :dropped ())" :op "plan" :form "(:plan (:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\"))" :evidenceIds "" :status "ok" :msg "plan set: 2 steps" :entry ":plan ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\"))" :steps "s1 s2")
(:case :id "step_plan_already_set" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\" :check \"\")) :done () :dropped ())" :op "plan" :form "(:plan (:step :id s3 :do \"d3\"))" :evidenceIds "" :status "rejected" :msg "a plan is set; change it with (:plan :revise ((:step ...) ...) :why s)" :err "ERR_PLAN_SET")
(:case :id "step_plan_revise_no_why" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\" :check \"\")) :done () :dropped ())" :op "plan" :form "(:plan :revise ((:step :id s3 :do \"d3\")))" :evidenceIds "" :status "rejected" :msg "a revision needs :why s" :err "ERR_MISSING_ARG")
(:case :id "step_plan_done_ok" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\" :check \"\")) :done () :dropped ())" :op "planDone" :form "(:planDone :id s1 :ev \"e1\")" :evidenceIds "e1" :status "ok" :msg "s1 done" :entry ":planDone :id s1 :ev \"e1\"" :steps "s1 s2")
(:case :id "step_plan_done_fake_ev" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\" :check \"\")) :done ((:done :id s1 :ev \"e1\")) :dropped ())" :op "planDone" :form "(:planDone :id s2 :ev \"fake\")" :evidenceIds "e1" :status "rejected" :msg ":ev fake is no receipt :id of this run; cite the :id of a receipt that shows the step's :check" :err "ERR_PLAN_EV")
(:case :id "step_plan_drop_ok" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\" :check \"\")) :done ((:done :id s1 :ev \"e1\")) :dropped ())" :op "planDrop" :form "(:planDrop :id s2 :why \"unneeded\")" :evidenceIds "" :status "ok" :msg "s2 dropped" :entry ":planDrop :id s2 :why \"unneeded\"" :steps "s1 s2")
(:case :id "step_plan_drop_done" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\" :check \"\")) :done ((:done :id s1 :ev \"e1\")) :dropped ((:dropped :id s2 :why \"unneeded\")))" :op "planDrop" :form "(:planDrop :id s1 :why \"already done\")" :evidenceIds "" :status "rejected" :msg "s1 is done; a done step is not dropped" :err "ERR_PLAN_STEP")
(:case :id "step_plan_revise_ok" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\" :check \"\")) :done ((:done :id s1 :ev \"e1\")) :dropped ((:dropped :id s2 :why \"unneeded\")))" :op "plan" :form "(:plan :revise ((:step :id s3 :do \"d3\")) :why \"changed mind\")" :evidenceIds "" :status "ok" :msg "plan revised: 2 steps" :entry ":planRevise :why \"changed mind\" :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s3 :do \"d3\"))" :steps "s1 s3" :revs 1)
(:case :id "step_err_parse_unbalanced" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps () :done () :dropped ())" :op "plan" :form "(:plan (:step :id s1" :evidenceIds "" :status "rejected" :msg "the plan form does not parse: an unbalanced '('" :err "ERR_PARSE")
(:case :id "step_err_parse_multi" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps () :done () :dropped ())" :op "plan" :form "(:plan (:step :id s1 :do \"d\")) (:plan (:step :id s2 :do \"d\"))" :evidenceIds "" :status "rejected" :msg "one (plan ...) form is expected" :err "ERR_PARSE")
(:case :id "step_err_plan_none_revise" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps () :done () :dropped ())" :op "plan" :form "(:plan :revise ((:step :id s1 :do \"d\")) :why \"w\")" :evidenceIds "" :status "rejected" :msg "no plan to revise; set one with (:plan (:step :id s1 :do s :check s) ...)" :err "ERR_PLAN_NONE")
(:case :id "step_err_plan_none_done" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps () :done () :dropped ())" :op "planDone" :form "(:planDone :id s1 :ev \"e1\")" :evidenceIds "e1" :status "rejected" :msg "no plan yet; set one with (:plan (:step :id s1 :do s :check s) ...)" :err "ERR_PLAN_NONE")
(:case :id "step_err_plan_none_drop" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps () :done () :dropped ())" :op "planDrop" :form "(:planDrop :id s1 :why \"w\")" :evidenceIds "" :status "rejected" :msg "no plan yet; set one with (:plan (:step :id s1 :do s :check s) ...)" :err "ERR_PLAN_NONE")
(:case :id "step_err_invalid_arg_empty" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps () :done () :dropped ())" :op "plan" :form "(:plan ())" :evidenceIds "" :status "rejected" :msg "each plan item is (:step :id s :do s :check s)" :err "ERR_INVALID_ARG")
(:case :id "step_err_invalid_arg_bad_step" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps () :done () :dropped ())" :op "plan" :form "(:plan (:notstep :id s1))" :evidenceIds "" :status "rejected" :msg "each plan item is (:step :id s :do s :check s)" :err "ERR_INVALID_ARG")
(:case :id "step_err_invalid_arg_revise_over_20" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\" :check \"\")) :done ((:done :id s1 :ev \"e1\")) :dropped ())" :op "plan" :form "(:plan :revise ((:step :id s2 :do \"d\") (:step :id s3 :do \"d\") (:step :id s4 :do \"d\") (:step :id s5 :do \"d\") (:step :id s6 :do \"d\") (:step :id s7 :do \"d\") (:step :id s8 :do \"d\") (:step :id s9 :do \"d\") (:step :id s10 :do \"d\") (:step :id s11 :do \"d\") (:step :id s12 :do \"d\") (:step :id s13 :do \"d\") (:step :id s14 :do \"d\") (:step :id s15 :do \"d\") (:step :id s16 :do \"d\") (:step :id s17 :do \"d\") (:step :id s18 :do \"d\") (:step :id s19 :do \"d\") (:step :id s20 :do \"d\") (:step :id s21 :do \"d\")) :why \"many\")" :evidenceIds "" :status "rejected" :msg "a plan holds at most 20 steps, done ones included" :err "ERR_INVALID_ARG")
(:case :id "step_err_plan_step_unknown" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\" :check \"\")) :done () :dropped ())" :op "planDone" :form "(:planDone :id unknown :ev \"e1\")" :evidenceIds "e1" :status "rejected" :msg "no step unknown; the steps are s1 s2" :err "ERR_PLAN_STEP")
(:case :id "step_err_missing_arg_drop_why" :fn "planStep" :plan "(:planState :on true :current \"\" :since 0 :revisions 0 :nudgeTurn -1 :steps ((:step :id s1 :do \"d1\" :check \"c1\") (:step :id s2 :do \"d2\" :check \"\")) :done () :dropped ())" :op "planDrop" :form "(:planDrop :id s2)" :evidenceIds "" :status "rejected" :msg "a drop needs :why s" :err "ERR_MISSING_ARG")
(:case :id "replay_full" :fn "planReplay" :input "(:session :id \"x\" :task \"t\" :plan true)\n(:turn 1 :plan ((:step :id s1 :do \"read f3\" :check \"c3\") (:step :id s2 :do \"read f4\" :check \"c4\")))\n(:turn 2 :planDone :id s1 :ev \"00aa\")\n(:turn 3 :planRevise :why \"w\" :steps ((:step :id s1 :do \"read f3\" :check \"c3\") (:step :id s3 :do \"c\")))\n(:turn 4 :planDrop :id s3 :why \"gone\")" :steps "s1 s3" :revisions 1 :nowTurn 5 :now "(:done (s1) :dropped (s3) :allReconciled true)")
(:case :id "replay_malformed_line" :fn "planReplay" :input "(:session :id \"x\" :task \"t\" :plan true)\n(:turn 1 :plan ((:step :id s1 :do \"read f3\" :check \"c3\")))\n(:turn 2 malformed line\n(:turn 3 :planDone :id s1 :ev \"00aa\")" :steps "s1" :revisions 0 :nowTurn 4 :now "(:done (s1) :allReconciled true)")
(:case :id "replay_invalid_step_form" :fn "planReplay" :input "(:session :id \"x\" :task \"t\" :plan true)\n(:turn 1 :plan ((:step :id s1 :do \"read f3\" :check \"c3\")))\n(:turn 2 :planRevise :why \"w\" :steps ((:notstep)))\n(:turn 3 :planDone :id s1 :ev \"00aa\")" :steps "s1" :revisions 0 :nowTurn 4 :now "(:done (s1) :allReconciled true)")
(:case :id "replay_missing_ev" :fn "planReplay" :input "(:session :id \"x\" :task \"t\" :plan true)\n(:turn 1 :plan ((:step :id s1 :do \"read f3\" :check \"c3\")))\n(:turn 2 :planDone :id s1)\n(:turn 3 :planDone :id s1 :ev \"00aa\")" :steps "s1" :revisions 0 :nowTurn 4 :now "(:done (s1) :allReconciled true)")
