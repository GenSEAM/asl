(:diffTest :id "empty_both" :a "" :b "" :from "orig.txt" :to "mod.txt" :context 3 :expected "")
(:diffTest :id "pure_insert_single" :a "" :b "hello\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -0,0 +1 @@\n+hello\n")
(:diffTest :id "pure_insert_multi" :a "" :b "line1\nline2\nline3\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -0,0 +1,3 @@\n+line1\n+line2\n+line3\n")
(:diffTest :id "pure_delete_single" :a "hello\n" :b "" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1 +0,0 @@\n-hello\n")
(:diffTest :id "pure_delete_multi" :a "line1\nline2\nline3\n" :b "" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,3 +0,0 @@\n-line1\n-line2\n-line3\n")
(:diffTest :id "no_nl_a" :a "line1\nline2" :b "line1\nline2\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,2 +1,2 @@\n line1\n-line2+line2\n")
(:diffTest :id "no_nl_b" :a "line1\nline2\n" :b "line1\nline2" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,2 +1,2 @@\n line1\n-line2\n+line2")
(:diffTest :id "no_nl_both" :a "line1\nline2" :b "line1\nmodified" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,2 +1,2 @@\n line1\n-line2+modified")
(:diffTest :id "no_nl_single" :a "foo" :b "bar" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1 +1 @@\n-foo+bar")
(:diffTest :id "insert_start" :a "b\nc\n" :b "a\nb\nc\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,2 +1,3 @@\n+a\n b\n c\n")
(:diffTest :id "insert_mid" :a "a\nc\n" :b "a\nb\nc\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,2 +1,3 @@\n a\n+b\n c\n")
(:diffTest :id "insert_end" :a "a\nb\n" :b "a\nb\nc\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,2 +1,3 @@\n a\n b\n+c\n")
(:diffTest :id "delete_start" :a "a\nb\nc\n" :b "b\nc\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,3 +1,2 @@\n-a\n b\n c\n")
(:diffTest :id "delete_mid" :a "a\nb\nc\n" :b "a\nc\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,3 +1,2 @@\n a\n-b\n c\n")
(:diffTest :id "delete_end" :a "a\nb\nc\n" :b "a\nb\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,3 +1,2 @@\n a\n b\n-c\n")
(:diffTest :id "multiple_hunks_2" :a "L1\nL2\nL3\nL4\nL5\nL6\nL7\nL8\nL9\nL10\nL11\nL12\nL13\nL14\nL15\nL16\nL17\nL18\nL19\nL20\nL21\nL22\nL23\nL24\nL25\nL26\nL27\nL28\nL29\nL30\n" :b "L1\nL2_mod\nL3\nL4\nL5\nL6\nL7\nL8\nL9\nL10\nL11\nL12\nL13\nL14\nL15\nL16\nL17\nL18\nL19\nL20\nL21\nL22\nL23\nL24\nL25\nL26\nL27\nL28_mod\nL29\nL30\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,5 +1,5 @@\n L1\n-L2\n+L2_mod\n L3\n L4\n L5\n@@ -25,6 +25,6 @@\n L25\n L26\n L27\n-L28\n+L28_mod\n L29\n L30\n")
(:diffTest :id "multiple_hunks_3" :a "L1\nL2\nL3\nL4\nL5\nL6\nL7\nL8\nL9\nL10\nL11\nL12\nL13\nL14\nL15\nL16\nL17\nL18\nL19\nL20\nL21\nL22\nL23\nL24\nL25\nL26\nL27\nL28\nL29\nL30\n" :b "L1\nL2_mod\nL3\nL4\nL5\nL6\nL7\nL8\nL9\nL10\nL11\nL12\nL13\nL14\nL15_mod\nL16\nL17\nL18\nL19\nL20\nL21\nL22\nL23\nL24\nL25\nL26\nL27\nL28_mod\nL29\nL30\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,5 +1,5 @@\n L1\n-L2\n+L2_mod\n L3\n L4\n L5\n@@ -12,7 +12,7 @@\n L12\n L13\n L14\n-L15\n+L15_mod\n L16\n L17\n L18\n@@ -25,6 +25,6 @@\n L25\n L26\n L27\n-L28\n+L28_mod\n L29\n L30\n")
(:diffTest :id "context_overlap_n3" :a "L1\nL2\nL3\nL4\nL5\nL6\nL7\nL8\nL9\nL10\nL11\nL12\nL13\nL14\nL15\nL16\nL17\nL18\nL19\nL20\nL21\nL22\nL23\nL24\nL25\nL26\nL27\nL28\nL29\nL30\n" :b "L1\nL2\nL3_mod\nL4\nL5\nL6\nL7\nL8_mod\nL9\nL10\nL11\nL12\nL13\nL14\nL15\nL16\nL17\nL18\nL19\nL20\nL21\nL22\nL23\nL24\nL25\nL26\nL27\nL28\nL29\nL30\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,11 +1,11 @@\n L1\n L2\n-L3\n+L3_mod\n L4\n L5\n L6\n L7\n-L8\n+L8_mod\n L9\n L10\n L11\n")
(:diffTest :id "context_no_overlap_n1" :a "L1\nL2\nL3\nL4\nL5\nL6\nL7\nL8\nL9\nL10\nL11\nL12\nL13\nL14\nL15\nL16\nL17\nL18\nL19\nL20\nL21\nL22\nL23\nL24\nL25\nL26\nL27\nL28\nL29\nL30\n" :b "L1\nL2\nL3_mod\nL4\nL5\nL6\nL7\nL8_mod\nL9\nL10\nL11\nL12\nL13\nL14\nL15\nL16\nL17\nL18\nL19\nL20\nL21\nL22\nL23\nL24\nL25\nL26\nL27\nL28\nL29\nL30\n" :from "orig.txt" :to "mod.txt" :context 1 :expected "--- orig.txt\n+++ mod.txt\n@@ -2,3 +2,3 @@\n L2\n-L3\n+L3_mod\n L4\n@@ -7,3 +7,3 @@\n L7\n-L8\n+L8_mod\n L9\n")
(:diffTest :id "identical_short" :a "alpha\nbeta\n" :b "alpha\nbeta\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "")
(:diffTest :id "identical_long" :a "L1\nL2\nL3\nL4\nL5\nL6\nL7\nL8\nL9\nL10\nL11\nL12\nL13\nL14\nL15\nL16\nL17\nL18\nL19\nL20\nL21\nL22\nL23\nL24\nL25\nL26\nL27\nL28\nL29\nL30\n" :b "L1\nL2\nL3\nL4\nL5\nL6\nL7\nL8\nL9\nL10\nL11\nL12\nL13\nL14\nL15\nL16\nL17\nL18\nL19\nL20\nL21\nL22\nL23\nL24\nL25\nL26\nL27\nL28\nL29\nL30\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "")
(:diffTest :id "replace_multi" :a "1\n2\n3\n" :b "A\nB\nC\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,3 +1,3 @@\n-1\n-2\n-3\n+A\n+B\n+C\n")
(:diffTest :id "replace_single" :a "1\n2\n3\n4\n5\n" :b "1\n2\nX\n4\n5\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,5 +1,5 @@\n 1\n 2\n-3\n+X\n 4\n 5\n")
(:diffTest :id "mixed_edits" :a "line 1\nline 2\nline 3\nline 4\nline 5\nline 6\nline 7\nline 8\nline 9\nline 10\nline 11\nline 12\nline 13\nline 14\nline 15\nline 16\nline 17\nline 18\nline 19\n" :b "line 1\nline 2\nline 3\nline 4\nline 5 modified\nline 6\nline 7\nline 8\nline 9\nline 10\nline 12\nline 13\nline 14\nline 15\nline 16\nline 16 inserted\nline 17\nline 18\nline 19\n" :from "orig.txt" :to "mod.txt" :context 2 :expected "--- orig.txt\n+++ mod.txt\n@@ -3,5 +3,5 @@\n line 3\n line 4\n-line 5\n+line 5 modified\n line 6\n line 7\n@@ -9,5 +9,4 @@\n line 9\n line 10\n-line 11\n line 12\n line 13\n@@ -15,4 +14,5 @@\n line 15\n line 16\n+line 16 inserted\n line 17\n line 18\n")
(:diffTest :id "custom_names" :a "hello\n" :b "world\n" :from "a/src/file.txt" :to "b/src/file.txt" :context 3 :expected "--- a/src/file.txt\n+++ b/src/file.txt\n@@ -1 +1 @@\n-hello\n+world\n")
(:diffTest :id "crlf_change" :a "a\nb\n" :b "a\nc\n" :from "orig.txt" :to "mod.txt" :context 3 :expected "--- orig.txt\n+++ mod.txt\n@@ -1,2 +1,2 @@\n a\n-b\n+c\n")
(:ratioTest :id "r_empty" :a "" :b "" :expected "1.0")
(:ratioTest :id "r_empty_left" :a "" :b "hello" :expected "0.0")
(:ratioTest :id "r_empty_right" :a "world" :b "" :expected "0.0")
(:ratioTest :id "r_identical" :a "agentLoop" :b "agentLoop" :expected "1.0")
(:ratioTest :id "r_difflib_eg1" :a "abcd" :b "bcde" :expected "0.75")
(:ratioTest :id "r_apple" :a "apple" :b "apples" :expected "0.9090909090909091")
(:ratioTest :id "r_kitten" :a "kitten" :b "sitting" :expected "0.6153846153846154")
(:ratioTest :id "r_rosetta" :a "rosettacode" :b "raisethysword" :expected "0.5")
(:ratioTest :id "r_disjoint" :a "abcdef" :b "123456" :expected "0.0")
(:ratioTest :id "r_test_bang" :a "test" :b "test!" :expected "0.8888888888888888")
(:ratioTest :id "r_reverse" :a "abc" :b "cba" :expected "0.3333333333333333")
(:ratioTest :id "r_spaces" :a "a b c" :b "a  b  c" :expected "0.8333333333333334")
(:ratioTest :id "r_multiline_ident" :a "hello world\n" :b "hello world\n" :expected "1.0")
(:ratioTest :id "r_multiline_diff" :a "line1\nline2\n" :b "line1\nline3\n" :expected "0.9166666666666666")
(:ratioTest :id "r_windiff_eg" :a "ab" :b "acab" :expected "0.6666666666666666")
(:ratioTest :id "r_banana" :a "banana" :b "anana" :expected "0.9090909090909091")
(:ratioTest :id "r_qabxcd" :a "qabxcd" :b "abycdf" :expected "0.6666666666666666")
(:ratioTest :id "r_quick_brown" :a "The quick brown fox" :b "The fast brown fox" :expected "0.7567567567567568")
(:ratioTest :id "r_xyz" :a "xyz" :b "x1y2z3" :expected "0.6666666666666666")
(:ratioTest :id "r_short_long" :a "short" :b "much longer string with short inside" :expected "0.24390243902439024")
(:ratioTest :id "r_repeated" :a "abcabcabc" :b "abcxyzabc" :expected "0.6666666666666666")
(:ratioTest :id "r_under_200_autojunk_bound" :a "abcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcde" :b "abcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeedcbaedcbaedcbaedcbaedcba" :expected "0.8914285714285715")
(:ratioTest :id "r_over_200_autojunk_active" :a "abcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcde" :b "abcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeedcbaedcbaedcbaedcbaedcba" :expected "0.9")
(:ratioTest :id "r_over_200_identical" :a "abcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcde" :b "abcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcde" :expected "1.0")
(:ratioTest :id "r_over_200_disjoint" :a "abcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcdeabcde" :b "1234512345123451234512345123451234512345123451234512345123451234512345123451234512345123451234512345123451234512345123451234512345123451234512345123451234512345123451234512345123451234512345123451234512345123451234512345123451234512345123451234512345" :expected "0.0")
