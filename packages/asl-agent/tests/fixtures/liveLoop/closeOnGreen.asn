(:script :id "liveLoopCloseOnGreen" :mode :implement
  :turns (
    (:turn :num 1 :reply "(:intent :deliver patch :why \"fix the bug\") (:step :op \"write\" :file \"subject.txt\" :content \"blue\\n\")")
    (:turn :num 2 :reply "(:step :op \"write\" :file \"subject.txt\" :content \"green\\n\")")
  )
)
