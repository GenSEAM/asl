;; Package Grammar & Exported Symbol Registry (ASN)
;; @genseam/asl-sh
(:grammar
  :package @genseam/asl-sh
  :version "0.1.0"
  :tokens-baseline 1
  :symbols [
    ;; 1-Token Baseline Types
    (:sym :name "Diagnostic" :kind :type :tokens 1)
    (:sym :name "DiagnosticSummary" :kind :type :tokens 1)
    (:sym :name "LogEntry" :kind :type :tokens 1)
    (:sym :name "LogLevel" :kind :type :tokens 1)
    (:sym :name "Pipeline" :kind :type :tokens 1)
    (:sym :name "ProcessCmd" :kind :type :tokens 1)
    (:sym :name "ProcessError" :kind :type :tokens 1)
    (:sym :name "ProcessOutput" :kind :type :tokens 1)
    (:sym :name "ReducedStream" :kind :type :tokens 1)
    (:sym :name "ReductionConfig" :kind :type :tokens 1)

    ;; <= 2-Token Primary API Symbols
    (:sym :name "cmd" :kind :fn :tokens 1)
    (:sym :name "collapse-cr" :kind :fn :tokens 2)
    (:sym :name "dedup-lines" :kind :fn :tokens 2)
    (:sym :name "default-config" :kind :fn :tokens 2)
    (:sym :name "err!" :kind :fn :tokens 1)
    (:sym :name "exec!" :kind :fn :tokens 1)
    (:sym :name "extract-diagnostics" :kind :fn :tokens 2)
    (:sym :name "format-entry" :kind :fn :tokens 2)
    (:sym :name "info!" :kind :fn :tokens 1)
    (:sym :name "log-err!" :kind :fn :tokens 2)
    (:sym :name "log-info!" :kind :fn :tokens 2)
    (:sym :name "log-warn!" :kind :fn :tokens 2)
    (:sym :name "make-pipeline" :kind :fn :tokens 2)
    (:sym :name "pipe!" :kind :fn :tokens 1)
    (:sym :name "reduce-lines" :kind :fn :tokens 2)
    (:sym :name "reduce-stream" :kind :fn :tokens 2)
    (:sym :name "reduce-text" :kind :fn :tokens 2)
    (:sym :name "run-cmd!" :kind :fn :tokens 2)
    (:sym :name "run-pipeline!" :kind :fn :tokens 2)
    (:sym :name "run-simple!" :kind :fn :tokens 2)
    (:sym :name "run-tests" :kind :fn :tokens 2)
    (:sym :name "run-tests!" :kind :fn :tokens 2)
    (:sym :name "strip-ansi" :kind :fn :tokens 2)
    (:sym :name "summarize-diagnostics" :kind :fn :tokens 2)
    (:sym :name "warn!" :kind :fn :tokens 1)
    (:sym :name "window-lines" :kind :fn :tokens 2)
    (:sym :name "with-cwd" :kind :fn :tokens 2)
    (:sym :name "with-stdin" :kind :fn :tokens 2)
    (:sym :name "with-timeout" :kind :fn :tokens 2)

    ;; Multi-Token Symbols (with :rationale)
    (:sym :name "clean-terminal-text" :kind :fn :tokens 3
          :rationale "Domain utility implementing clean terminal text")
    (:sym :name "collapse-cr-line" :kind :fn :tokens 3
          :rationale "Domain utility implementing collapse cr line")
    (:sym :name "collapse-cr-segment" :kind :fn :tokens 3
          :rationale "Domain utility implementing collapse cr segment")
    (:sym :name "extract-python-frame" :kind :fn :tokens 3
          :rationale "Domain utility implementing extract python frame")
    (:sym :name "parse-file-loc" :kind :fn :tokens 3
          :rationale "Parser extracting file loc")
    (:sym :name "parse-pytest-diagnostic" :kind :fn :tokens 3
          :rationale "Parser extracting pytest diagnostic")
    (:sym :name "parse-tsc-diagnostic" :kind :fn :tokens 3
          :rationale "Parser extracting tsc diagnostic")
    (:sym :name "scan-stream-diagnostics" :kind :fn :tokens 3
          :rationale "Domain utility implementing scan stream diagnostics")
    (:sym :name "test-ansi-stripping" :kind :fn :tokens 3
          :rationale "Test case verifying ansi stripping")
    (:sym :name "test-cr-collapsing" :kind :fn :tokens 3
          :rationale "Test case verifying cr collapsing")
    (:sym :name "test-diagnostic-extraction" :kind :fn :tokens 3
          :rationale "Test case verifying diagnostic extraction")
    (:sym :name "test-line-dedup" :kind :fn :tokens 3
          :rationale "Test case verifying line dedup")
    (:sym :name "test-reduce-stream-integration" :kind :fn :tokens 4
          :rationale "Test case verifying reduce stream integration")
    (:sym :name "test-retention-windowing" :kind :fn :tokens 3
          :rationale "Test case verifying retention windowing")
  ])
