(:doc :symbol "asl/packages/asl-media/src/probe.asl#" :text "Typed ffprobe and ffmpeg runner: parse ffprobe JSON into records, build argv, spawn bounded children with a path allowlist")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#ProbeStream" :text "One stream of a probed file; fps is the rational fpsNum/fpsDen, fpsDen 0 means unknown")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#ProbeInfo" :text "Container name, duration seconds, bit rate, size, streams and format tags of a probed file")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#parseProbe" :text "ffprobe -print_format json text to (Result ProbeInfo String); err is labelled mediaParse")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#parseRational" :text "num/den text to a pair; anything else, or a zero denominator, is 0/0")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#probeArgv" :text "argv for ffprobe with json format and streams output")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#ffmpegArgv" :text "ffmpeg argv with -nostdin and -hide_banner before the caller args")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#pathAllowed?" :text "absolute path under one of the roots, no .. segment, no NUL")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#probe!" :text "probe a file under the allowlist with a timeout; errs are mediaPathNotAllowed, mediaTimeout, mediaExit or mediaParse")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#runFfmpeg!" :text "run ffmpeg after every input passes the allowlist; returns stdout or a labelled err")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#defaultFfprobe" :text "/opt/homebrew/bin/ffprobe")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#defaultFfmpeg" :text "/opt/homebrew/bin/ffmpeg")
(:doc :symbol "asl/packages/asl-media/tests/probeTest.asl#runTests" :text "probe fixture, rational, allowlist, argv, spawn label and hung-child kill gates")
(:doc :symbol "asl/packages/asl-media/src/png.asl#" :text "PNG decode to RGBA8 and encode from RGBA8 over asl-zip inflate and deflate, with zlib framing and adler32")
(:doc :symbol "asl/packages/asl-media/src/png.asl#PngImage" :text "decoded image: size, source bit depth and colour type, gAMA*100000 or -1, sRGB intent or -1, iCCP and tRNS flags, RGBA8 bytes")
(:doc :symbol "asl/packages/asl-media/src/png.asl#pngDecode!" :text "bytes and a pixel budget to a PngImage; colour types 0 2 3 4 6 at 1 to 16 bits, all filters, tRNS applied as alpha, chunk CRC and adler32 checked; Adam7 is a labelled pngUnsupported; errs are labelled pngSignature pngTruncated pngCrc pngZlib pngStructure pngFilter pngPalette pngLimit")
(:doc :symbol "asl/packages/asl-media/src/png.asl#pngEncode!" :text "width height RGBA8 bytes to PNG bytes: colour type 6, per-row minimum-sum filter, one IDAT, deterministic")
(:doc :symbol "asl/packages/asl-media/src/png.asl#adler32" :text "RFC 1950 adler32 of the whole bytes")
(:doc :symbol "asl/packages/asl-media/src/png.asl#zlibWrap!" :text "raw bytes to a zlib stream: header 78 9c, deflate level 6, adler32 trailer")
(:doc :symbol "asl/packages/asl-media/tests/pngTest.asl#runTests" :text "png fixture digests, known pixels, metadata, error labels, round trips, determinism and 1024x1024 gates")
