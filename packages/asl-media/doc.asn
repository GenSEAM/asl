(:doc :symbol "asl/packages/asl-media/src/probe.asl#" :text "Typed ffprobe and ffmpeg runner: parse ffprobe JSON into records, build argv, spawn bounded children with a path allowlist")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#ProbeStream" :text "One stream of a probed file; fps is the rational fpsNum/fpsDen, fpsDen 0 means unknown")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#ProbeInfo" :text "Container name, duration seconds, bit rate, size, streams and format tags of a probed file")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#parseProbe" :text "ffprobe -print_format json text to (Result ProbeInfo String); err is labelled mediaParse")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#parseRational" :text "num/den text to a pair; anything else, or a zero denominator, is 0/0")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#probeArgv" :text "argv for ffprobe with json format and streams output")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#ffmpegArgv" :text "ffmpeg argv with -nostdin and -hide_banner before the caller args")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#inputAllowed!" :text "pathAllowed? plus the real path of an existing input under a real root, so a symlink out of the root is refused")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#outputAllowed!" :text "pathAllowed? plus the real parent directory under a root and, for an existing symlink output, its real target; a dangling symlink is refused")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#pathAllowed?" :text "absolute path under one of the roots, no .. segment, no NUL")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#probe!" :text "probe a file under the allowlist with a timeout; errs are mediaPathNotAllowed, mediaTimeout, mediaExit or mediaParse")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#runFfmpeg!" :text "run ffmpeg after every input and every declared output passes the allowlist (symlinks resolved, outputs by parent directory); returns stdout or a labelled err; args are options only: inputs become -i pairs and outputs trail, and a path, protocol, file-reading filter, -y, -i or bare file name in args is mediaArgRefused (so subtitles burn-in is not expressible here)")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#argBad?" :text "true when an ffmpeg args token is not one of the checked inputs or outputs and looks like a path, protocol, file-reading filter, overwrite or input flag, or bare file name")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#whichBin!" :text "first PATH entry holding a file with the name, else the fallback")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#ffprobeBin!" :text "ffprobe from PATH, else defaultFfprobe")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#ffmpegBin!" :text "ffmpeg from PATH, else defaultFfmpeg")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#defaultFfprobe" :text "/opt/homebrew/bin/ffprobe")
(:doc :symbol "asl/packages/asl-media/src/probe.asl#defaultFfmpeg" :text "/opt/homebrew/bin/ffmpeg")
(:doc :symbol "asl/packages/asl-media/tests/probeTest.asl#runTests" :text "probe fixture, rational, allowlist, argv, spawn label and hung-child kill gates")
(:doc :symbol "asl/packages/asl-media/src/png.asl#" :text "PNG decode to RGBA8 and encode from RGBA8 over asl-zip inflate and deflate, with zlib framing and adler32")
(:doc :symbol "asl/packages/asl-media/src/png.asl#PngImage" :text "decoded image: size, source bit depth and colour type, gAMA*100000 or -1, sRGB intent or -1, iCCP and tRNS flags, RGBA8 bytes")
(:doc :symbol "asl/packages/asl-media/src/png.asl#pngDecode!" :text "bytes and a pixel budget to a PngImage; colour types 0 2 3 4 6 at 1 to 16 bits, all filters, tRNS applied as alpha, chunk CRC and adler32 checked; Adam7 is a labelled pngUnsupported; Adam7 is a labelled pngUnsupported; inflate output is capped at height*(stride+1); IHDR must be first and 13 bytes, PLTE a multiple of 3 up to 768; errs are labelled pngSignature pngTruncated pngCrc pngZlib pngStructure pngFilter pngPalette pngLimit")
(:doc :symbol "asl/packages/asl-media/src/png.asl#pngEncode!" :text "width height RGBA8 bytes to PNG bytes: colour type 6, per-row minimum-sum filter, one IDAT, deterministic")
(:doc :symbol "asl/packages/asl-media/src/png.asl#adler32" :text "RFC 1950 adler32 of the whole bytes")
(:doc :symbol "asl/packages/asl-media/src/png.asl#zlibWrap!" :text "raw bytes to a zlib stream: header 78 9c, deflate level 6, adler32 trailer")
(:doc :symbol "asl/packages/asl-media/tests/pngTest.asl#runTests" :text "png fixture digests, known pixels, metadata, error labels, round trips, determinism and 1024x1024 gates")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#" :text "RIFF/WAVE reader and writer for PCM 8 16 24 32 bit and float32 with peak, RMS, DC offset, clipping and silence measures")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#WavAudio" :text "decoded audio: channels, rate, source bit depth, float flag, frames, interleaved Float64 samples in a Bytes")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#WavStats" :text "peak, rms, clipCount, silenceRatio and dcOffset of a WavAudio")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#wavDecode!" :text "bytes and a frame budget to WavAudio; walks chunks tolerating LIST and odd padding, extensible format by subformat tag; errs are labelled wavTruncated wavFormat wavStructure wavUnsupported wavLimit wavFloat")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#wavEncode!" :text "WavAudio to canonical 44-byte-header WAV bytes at 16 24 32 bit PCM or float32; PCM scales by 2^(bits-1) with clamping so decode inverts it")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#wavStats" :text "stats with a clip threshold and a silence threshold, both linear magnitudes; empty audio gives zeros")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#wavSampleAt" :text "sample at interleaved index i")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#wavFrames" :text "frame count")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#wavSilentFrames" :text "frames whose every channel magnitude is below the threshold")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#pow2f" :text "2 to the integer power as Float64")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#float32FromBits" :text "IEEE-754 binary32 bits to Float64; infinity and NaN are an err")
(:doc :symbol "asl/packages/asl-media/src/wav.asl#float32ToBits" :text "Float64 to nearest binary32 bits (half away from zero, not to even), denormals handled, NaN is 0x7FC00000, -0.0 encodes as +0.0, overflow clamps to the largest finite")
(:doc :symbol "asl/packages/asl-media/tests/wavTest.asl#runTests" :text "wav fixtures, float32 bit patterns, round trips, error labels and stats gates")
(:doc :symbol "asl/packages/asl-media/src/loudness.asl#" :text "ITU-R BS.1770-4 integrated loudness with K-weighting, 400 ms blocks at 100 ms hop, absolute -70 LUFS and relative -10 LU gates")
(:doc :symbol "asl/packages/asl-media/src/loudness.asl#Biquad" :text "direct-form biquad coefficients, a0 normalised to 1")
(:doc :symbol "asl/packages/asl-media/src/loudness.asl#shelfCoeffs" :text "K-weighting high-shelf stage for a sample rate")
(:doc :symbol "asl/packages/asl-media/src/loudness.asl#highpassCoeffs" :text "K-weighting RLB high-pass stage for a sample rate")
(:doc :symbol "asl/packages/asl-media/src/loudness.asl#blockEnergies!" :text "per-block mean square of the K-weighted, channel-weighted signal as (Bytes of Float64, block count)")
(:doc :symbol "asl/packages/asl-media/src/loudness.asl#integratedLufs!" :text "WavAudio to integrated LUFS; err loudnessRate under 3400 Hz, loudnessShort under one block, loudnessSilent when nothing passes the gates; channels 3 to 5 weigh 1.0 and per-block energies use a double prefix sum, whose rounding is not bounded for multi-hour input")
(:doc :symbol "asl/packages/asl-media/tests/loudnessTest.asl#runTests" :text "BS.1770 48 kHz coefficients, -23 LUFS sine, gating and error-label gates")
(:doc :symbol "asl/packages/asl-media/src/image.asl#" :text "RGBA8 image primitives over Bytes: build, crop, pad, flip, premultiply, source-over composite, alpha, gray, histogram and mean; every op returns a new Image and a bad request is a labelled err")
(:doc :symbol "asl/packages/asl-media/src/image.asl#Image" :text "width, height and straight-alpha RGBA8 Bytes of exactly width*height*4, row-major, top row first")
(:doc :symbol "asl/packages/asl-media/src/image.asl#maxImagePixels" :text "67108864, the largest width*height any op accepts")
(:doc :symbol "asl/packages/asl-media/src/image.asl#dimOk?" :text "true when width and height are positive, each at most maxImagePixels and the product too (no overflow)")
(:doc :symbol "asl/packages/asl-media/src/image.asl#clampByte" :text "clamp an Int64 to 0..255")
(:doc :symbol "asl/packages/asl-media/src/image.asl#roundHalfUp" :text "Float64 to Int64 by floor(f+0.5)")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imageNew" :text "validate size and byte count into an Image; err imageSize")
(:doc :symbol "asl/packages/asl-media/src/image.asl#fillBytes!" :text "set out[j] = f(j) for j from j to n, the shared per-byte loop")
(:doc :symbol "asl/packages/asl-media/src/image.asl#gatherBytes!" :text "set out[j] = src[f(j)] for j from j to n, the shared copy loop")
(:doc :symbol "asl/packages/asl-media/src/image.asl#chanOk?" :text "true for a channel value in 0..255")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imageSolid" :text "a w by h image of one RGBA colour; errs imageSize and imageChannel")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imageCrop" :text "the w by h window at x,y; err imageBounds when it is empty, negative-origin or leaves the image")
(:doc :symbol "asl/packages/asl-media/src/image.asl#blitRows!" :text "copy a source image into a destination canvas at dx,dy without clipping")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imagePad" :text "add top right bottom left pixels of one fill colour around the image; err imageBounds on a negative size, imageChannel on a bad colour")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imageFlipH" :text "mirror each row")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imageFlipV" :text "swap rows top to bottom")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imagePremultiply" :text "colour = (c*a+127)/255 integer, alpha unchanged")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imageUnpremultiply" :text "colour = (c*255+a/2)/a clamped to 255, alpha 0 gives colour 0")
(:doc :symbol "asl/packages/asl-media/src/image.asl#blendByte" :text "one output byte of source-over on straight alpha: alpha = round((sa*255+da*(255-sa))/255), colour = round((sc*sa*255+dc*da*(255-sa))/(sa*255+da*(255-sa))), all integer")
(:doc :symbol "asl/packages/asl-media/src/image.asl#clampOffset" :text "clamp a composite offset to plus or minus twice maxImagePixels, which is fully outside any image, so offset arithmetic never overflows")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imageComposite" :text "source-over of src onto dst with src top-left at ox,oy; offsets are clamped by clampOffset; the part of src outside dst is clipped and a src fully outside changes nothing; returns a new image of the destination size")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imageAlpha" :text "width*height alpha bytes")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imageGray" :text "BT.601 integer gray (299r+587g+114b+500)/1000 into r g b with alpha 255")
(:doc :symbol "asl/packages/asl-media/src/image.asl#countLoop!" :text "count one channel into 256 Float64 slots")
(:doc :symbol "asl/packages/asl-media/src/image.asl#countList" :text "256 counts from the slot buffer")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imageHistogram" :text "256 counts of channel 0..3; err imageChannel otherwise")
(:doc :symbol "asl/packages/asl-media/src/image.asl#sumChannel!" :text "sum one channel across the image")
(:doc :symbol "asl/packages/asl-media/src/image.asl#imageMean" :text "mean of channel 0..3 as Float64; err imageChannel otherwise")
(:doc :symbol "asl/packages/asl-media/tests/imageTest.asl#runTests" :text "construction, crop bounds, pad, flips, premultiply round trip, composite on closed-form pixels with offsets and clipping, gray, alpha, histogram and mean gates")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#" :text "separable resize of an Image by nearest, bilinear, area or lanczos3 with Float64 weights, rounded half up")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#imageResize" :text "resize to w by h by a method name; errs imageSize for a bad target and imageMethod for an unknown name; area is the exact box overlap, bilinear and lanczos3 widen by the scale on downscale, nearest samples the centre")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#resizeMethods" :text "nearest bilinear area lanczos3")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#weightRange" :text "first tap and last tap source index of an output index, clamped to the image")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#kernelWeight" :text "unnormalised weight of source pixel i for output pixel o")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#pi" :text "3.141592653589793")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#sinc" :text "sin(pi x)/(pi x), 1 at 0")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#scaleOf" :text "source over destination size as Float64")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#filterScale" :text "max of the scale and 1, the kernel widening on downscale")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#support" :text "kernel half-width in source pixels")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#tapStride" :text "Float64 slots per output row of the weight table")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#sumWeights!" :text "sum of the kernel weights of a tap range")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#writeTaps!" :text "write normalised weights of one output row")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#buildRows!" :text "fill the weight table for every output index")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#weightTable!" :text "per output index: first tap, tap count, normalised weights")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#slotI" :text "Int64 read of a Float64 slot")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#tapSum!" :text "weighted sum over the taps of one output sample")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#hPass!" :text "horizontal pass into a Float64 buffer")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#vPass!" :text "vertical pass into rounded clamped bytes")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#nearestImage" :text "centre-sample resize, (2o+1)*s/(2d)")
(:doc :symbol "asl/packages/asl-media/src/imageResize.asl#weightedImage!" :text "two-pass weighted resize")
(:doc :symbol "asl/packages/asl-media/tests/imageResizeTest.asl#runTests" :text "area block means and fractional overlap, nearest, bilinear, identity at equal size, constant images, a python-oracle lanczos value, error labels and a 2048 to 1024 resize gates")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#" :text "64-bit perceptual hashes of an Image in an Int64: dHash, pHash, hex text and hamming distance")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#imageDHash" :text "(Result Int64 String): gray, area to 9x8, bit = left greater than right, row-major, first bit most significant; a resize err is returned")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#imagePHash" :text "(Result Int64 String): gray, area to 32x32, DCT-II of the 8x8 lowest frequencies, bit = coefficient greater than the median of the 63 AC coefficients (DC is compared but not part of the median); defined here, not bit-compatible with other libraries")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#hashHex" :text "16 lower-case hex digits of a hash")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#hammingDistance" :text "number of differing bits of two hashes")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#grayAt" :text "red byte of a pixel, the gray value after imageGray")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#dBits!" :text "dHash bit accumulator")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#cosAt" :text "cos((2x+1) u pi / 64)")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#rowSum!" :text "one row DCT sum")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#rowDct!" :text "horizontal DCT of every row for u 0..7")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#colSum!" :text "one column DCT sum")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#coefs" :text "the 64 low-frequency coefficients row-major by v then u")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#medianOf" :text "element 31 of the sorted 63 AC coefficients")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#bitsOf" :text "coefficients above the median to hash bits")
(:doc :symbol "asl/packages/asl-media/src/imageHash.asl#hexDigit" :text "one hex digit")
(:doc :symbol "asl/packages/asl-media/tests/imageHashTest.asl#runTests" :text "dHash fixtures, hamming and hex, pHash pinned to a python DCT oracle, scale invariance and flip sensitivity gates")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#" :text "SRT and WebVTT cues: parse, write with escapes, time formatting, word grouping into cues and cue checks; all times are integer milliseconds")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#Cue" :text "one caption cue: start and end ms, text with newlines, and the VTT cue settings kept verbatim")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#Word" :text "one timed word for groupWords")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#GroupLimits" :text "groupWords limits: characters per line, lines, minimum and maximum duration ms, characters per second, pause ms that forces a break")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#msFromSeconds" :text "seconds to ms, half up")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#pad" :text "non-negative Int64 to a zero-padded string of a width")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#zeros" :text "list of n zero strings, helper for pad")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#formatTime" :text "(Result String String): ms to HH:MM:SS then the separator then mmm, comma for SRT and dot for VTT; a negative ms is an err labelled captionTime")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#parseTime" :text "HH:MM:SS,mmm or MM:SS.mmm to ms; every field must be plain digits (no sign), minutes and seconds below 60, hours uncapped; anything else is an err labelled captionTime")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#normalise" :text "strip a UTF-8 BOM and turn CRLF and lone CR into LF")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#blocks" :text "text to blank-line separated blocks of lines")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#blockLoop" :text "blocks accumulator")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#arrow?" :text "true when a line holds the --> timing arrow")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#cueOfBlock" :text "one block to a cue or none for an index-only or NOTE, STYLE or REGION block; a bad timing line is an err")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#listIndexOf2" :text "index of the first timing line in a block")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#cuesOf" :text "blocks to cues, stopping at the first err")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#parseSrt" :text "SRT text to cues; BOM and CRLF accepted, index lines dropped, an err names the block")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#parseVtt" :text "WebVTT text to cues; header, NOTE, STYLE and REGION blocks dropped, cue ids dropped, settings kept, entities unescaped")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#escapeVtt" :text "escape & < > for a VTT payload after dropping blank and whitespace-only lines; the cue tags i b u and their closers stay as markup, every other angle bracket is escaped")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#unescapeVtt" :text "inverse of escapeVtt")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#cleanSrt" :text "SRT payload text: blank and whitespace-only lines are removed so a cue never ends early and no text after the blank line is lost")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#writeSrt" :text "cues to SRT text with 1-based indexes; an err captionText when a cue text holds the --> arrow")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#srtBlock" :text "one SRT block")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#writeVtt" :text "(Result String String): cues to WebVTT text with the WEBVTT header, escaped payloads and settings after the timing; a negative cue time is an err labelled captionTime")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#numbered" :text "cues paired with 1-based indexes")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#enumLoop" :text "numbered accumulator")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#cueOverlaps" :text "indexes of cues that start before the previous cue ends")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#overlapLoop" :text "cueOverlaps accumulator")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#charsOf" :text "characters of a word list joined by single spaces")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#wrapLines" :text "greedy wrap of words into lines of at most maxChars")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#wrapLoop" :text "wrapLines accumulator")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#lastWord" :text "last word of a non-empty list")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#firstWord" :text "first word of a non-empty list")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#sentenceEnd?" :text "true when a word ends in . ! or ?")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#fits?" :text "true when adding words keeps lines, duration and characters per second inside the limits")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#cueOf" :text "words to one cue with wrapped text")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#groupLoop" :text "greedy grouping loop: breaks at the limits, a sentence end or a pause")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#settle" :text "stretch cues shorter than minMs into the gap before the next cue")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#settleLoop" :text "settle accumulator")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#groupWords" :text "timed words to cues by a greedy grouping under the limits")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#cueViolations" :text "indexes of cues that break a limit")
(:doc :symbol "asl/packages/asl-media/src/captions.asl#violationLoop" :text "cueViolations accumulator")
(:doc :symbol "asl/packages/asl-media/src/align.asl#" :text "Word error rate by unit-cost Levenshtein alignment and ASR time mapping onto script words")
(:doc :symbol "asl/packages/asl-media/src/align.asl#AlignOp" :text "one alignment step: kind match sub del or ins and the reference and hypothesis indexes, -1 when absent")
