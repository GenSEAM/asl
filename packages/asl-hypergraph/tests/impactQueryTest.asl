(module asl/packages/asl-hypergraph/tests/impactQueryTest :x [RunTests runTests] :i [(asl-hypergraph :a hyper) (asl-hypergraph/model :a model) (asl-hypergraph/index :a index) (asl-hypergraph/query :a query) (asl-cli/impact :a cliImpact)])

fn isOk? r: (Result T E) -> Bool
  (mt r ((ok _) true) ((err _) false))

fn isErr? r: (Result T E) -> Bool
  (mt r ((ok _) false) ((err _) true))

fn sampleModuleA -> Str
  (str "(module sample/mathEngine\n" "  :x [addNumbers computeFactorial MathResult])\n\n" "(dfs MathResult\n" "  (:field value Int64 \"The computed integer value\"))\n\n" "(df addNumbers [(a Int64) (b Int64)] -> Int64\n" "  (+ a b))\n\n" "(df computeFactorial [(n Int64)] -> Int64\n" "  (if (<= n 1)\n" "      1\n" "      (* n (computeFactorial (- n 1)))))\n")

fn sampleModuleB -> Str
  (str "(module sample/calcService\n" "  :x [evaluateExpression runBatchCalculation])\n\n" "(df evaluateExpression [(x Int64) (y Int64)] -> Int64\n" "  (addNumbers x y))\n\n" "(df runBatchCalculation [(items (List Int64))] -> Int64\n" "  (addNumbers (evaluateExpression 1 2) (computeFactorial 5)))\n")

fn sampleTestModule -> Str
  (str "(module tests/sample/calcServiceTest\n" "  :x [runTests])\n\n" "(df ! testAddition [] -> Bool\n" "  (= (addNumbers 2 3) 5))\n\n" "(df ! testFactorial [] -> Bool\n" "  (= (computeFactorial 3) 6))\n\n" "(df ! runTests [] -> Bool\n" "  (and (testAddition) (testFactorial)))\n")

fn highFanInCorpus -> (List (Pair Str Str))
  (list (pair "sample/target" (str "(module sample/target :x [coreAction])\n" "(df coreAction [] -> Int64 42)\n")) (pair "sample/caller1" "(module sample/caller1 :x [f1]) (df f1 [] -> Int64 (coreAction))\n") (pair "sample/caller2" "(module sample/caller2 :x [f2]) (df f2 [] -> Int64 (coreAction))\n") (pair "sample/caller3" "(module sample/caller3 :x [f3]) (df f3 [] -> Int64 (coreAction))\n") (pair "sample/caller4" "(module sample/caller4 :x [f4]) (df f4 [] -> Int64 (coreAction))\n") (pair "sample/caller5" "(module sample/caller5 :x [f5]) (df f5 [] -> Int64 (coreAction))\n") (pair "sample/caller6" "(module sample/caller6 :x [f6]) (df f6 [] -> Int64 (coreAction))\n") (pair "sample/caller7" "(module sample/caller7 :x [f7]) (df f7 [] -> Int64 (coreAction))\n") (pair "tests/t1" "(module tests/t1 :x [runTests]) (df ! test1 [] -> Bool (= (coreAction) 42))\n") (pair "tests/t2" "(module tests/t2 :x [runTests]) (df ! test2 [] -> Bool (= (coreAction) 42))\n") (pair "tests/t3" "(module tests/t3 :x [runTests]) (df ! test3 [] -> Bool (= (coreAction) 42))\n") (pair "tests/t4" "(module tests/t4 :x [runTests]) (df ! test4 [] -> Bool (= (coreAction) 42))\n") (pair "tests/t5" "(module tests/t5 :x [runTests]) (df ! test5 [] -> Bool (= (coreAction) 42))\n"))

fn testHypergraphDataModel -> Bool
  (let [(node (model/makeHyperNode "mod/sub:foo" "function" "mod/sub" "foo" "Computes foo")) (edge (model/makeHyperEdge "mod/sub:caller" "calls" "mod/sub:foo" "body")) (testEdge (model/makeHyperEdge "tests/mod:testFoo" "tests" "mod/sub:foo" "body")) (idx (model/makeHyperIndex 1 (list node) (list edge testEdge) 1789720000000)) (receipt (model/makeImpactReceipt "foo" (list "caller") 1 (list "testFoo") 1 (list "Int64") "ok"))] (assert (= node.id "mod/sub:foo") "Node id correctly stored") (assert (= node.kind "function") "Node kind correctly stored") (assert (= node.module "mod/sub") "Node module correctly stored") (assert (= node.symbol "foo") "Node symbol correctly stored") (assert (= node.doc "Computes foo") "Node doc correctly stored") (refute (= node.id "mod/sub:bar") "Node id is not bar") (refute (= node.kind "struct") "Node kind is not struct") (assert (= edge.source "mod/sub:caller") "Edge source matches") (assert (= edge.relation "calls") "Edge relation matches") (assert (= edge.target "mod/sub:foo") "Edge target matches") (assert (= edge.anchor "body") "Edge anchor matches") (refute (= edge.relation "mutates") "Edge relation is not mutates") (assert (= idx.version 1) "Index version matches") (assert (= (listLength idx.nodes) 1) "Index node count matches") (assert (= (listLength idx.edges) 2) "Index edge count matches") (refute (= idx.version 2) "Index version is not 2") (assert (= receipt.symbol "foo") "Receipt symbol matches") (assert (= receipt.callersCount 1) "Receipt callersCount matches") (assert (= receipt.testsCount 1) "Receipt testsCount matches") (assert (= receipt.status "ok") "Receipt status is ok") (refute (= receipt.status "not-found") "Receipt status is not not-found") (let [(targetEdges (model/findEdgesByTarget idx.edges "mod/sub:foo" (none))) (callTargetEdges (model/findEdgesByTarget idx.edges "mod/sub:foo" (some "calls"))) (testTargetEdges (model/findEdgesByTarget idx.edges "mod/sub:foo" (some "tests"))) (missingTargetEdges (model/findEdgesByTarget idx.edges "nonExistent" (none))) (sourceEdges (model/findEdgesBySource idx.edges "mod/sub:caller" (none))) (foundNode (model/findNodeById idx.nodes "mod/sub:foo")) (missingNode (model/findNodeById idx.nodes "mod/sub:missing"))] (assert (= (listLength targetEdges) 2) "Found 2 edges targeting foo") (assert (= (listLength callTargetEdges) 1) "Found 1 calls edge targeting foo") (assert (= (listLength testTargetEdges) 1) "Found 1 tests edge targeting foo") (assert (= (listLength sourceEdges) 1) "Found 1 source edge from caller") (assert (some? foundNode) "Found existing node by id") (refute (some? missingNode) "Missing node is not found") (refute (> (listLength missingTargetEdges) 0) "Missing target has zero edges")) true)

fn testModuleExtractionAndIndexBuilding -> Bool
  (let [(modA (sampleModuleA)) (modB (sampleModuleB)) (modTest (sampleTestModule)) (extractedA (index/extractNodesAndEdgesFromModule "sample/mathEngine" modA)) (nodesA (pairFirst extractedA)) (edgesA (pairSecond extractedA))] (assert (>= (listLength nodesA) 3) "Module A extracts at least 3 declaration nodes") (refute (= (listLength nodesA) 0) "Extracted nodes in Module A is non-empty") (let [(fnAddOpt (model/findNodeById nodesA "sample/mathEngine:addNumbers")) (fnFactOpt (model/findNodeById nodesA "sample/mathEngine:computeFactorial")) (structOpt (model/findNodeById nodesA "sample/mathEngine:MathResult"))] (assert (some? fnAddOpt) "addNumbers node extracted") (assert (some? fnFactOpt) "computeFactorial node extracted") (assert (some? structOpt) "MathResult struct node extracted") (mt structOpt ((some sn) (do (assert (= sn.kind "struct") "MathResult kind is struct") (refute (= sn.kind "function") "MathResult is not function"))) ((none) (assert false "MathResult struct must be present")))) (let [(modules (list (pair "sample/mathEngine" modA) (pair "sample/calcService" modB) (pair "tests/sample/calcServiceTest" modTest))) (idx (hyper/buildHypergraphFromModules modules)) (allNodes idx.nodes) (allEdges idx.edges)] (assert (>= (listLength allNodes) 7) "Unified hypergraph index contains at least 7 nodes") (assert (>= (listLength allEdges) 4) "Unified hypergraph index contains at least 4 edges") (refute (= (listLength allNodes) 0) "Unified index nodes list is not empty") (refute (= (listLength allEdges) 0) "Unified index edges list is not empty") (let [(callersOfAdd (model/findEdgesByTarget allEdges "addNumbers" (some "calls"))) (testsOfAdd (model/findEdgesByTarget allEdges "addNumbers" (some "tests")))] (assert (>= (listLength callersOfAdd) 1) "addNumbers has inbound callers from calcService") (assert (>= (listLength testsOfAdd) 1) "addNumbers has test linkage from calcServiceTest") (refute (= (listLength callersOfAdd) 0) "Callers of addNumbers is not zero") (refute (= (listLength testsOfAdd) 0) "Tests of addNumbers is not zero")) true))

fn testIndexSerializationRoundtrip -> Bool
  (let [(modA (sampleModuleA)) (modules (list (pair "sample/mathEngine" modA))) (origIdx (hyper/buildHypergraphFromModules modules)) (serialized (hyper/serializeHyperIndex origIdx))] (assert (stringContains? serialized "(:hyperIndex") "Serialized text contains :hyperIndex header") (assert (stringContains? serialized ":nodes [") "Serialized text contains :nodes block") (assert (stringContains? serialized ":edges [") "Serialized text contains :edges block") (assert (stringContains? serialized "sample/mathEngine:addNumbers") "Serialized text contains symbol identifier") (refute (stringContains? serialized ":line") "Zero-line-number invariant: serialized index contains no line numbers") (refute (stringContains? serialized ":col") "Zero-line-number invariant: serialized index contains no col numbers") (let [(deserializedRes (hyper/deserializeHyperIndex serialized))] (assert (isOk? deserializedRes) "Deserialization succeeds on valid ASN index") (mt deserializedRes ((ok restoredIdx) (do (assert (= restoredIdx.version origIdx.version) "Restored version matches original") (assert (= (listLength restoredIdx.nodes) (listLength origIdx.nodes)) "Restored nodes count matches original") (assert (= (listLength restoredIdx.edges) (listLength origIdx.edges)) "Restored edges count matches original") (refute (!= restoredIdx.version 1) "Restored index version is exactly 1"))) ((err msg) (assert false (str "Deserialization failed unexpectedly: " msg))))) (let [(malformedText "(:hyperIndex :broken") (badRes (hyper/deserializeHyperIndex malformedText))] (assert (isErr? badRes) "Malformed index text fails deserialization cleanly") (refute (isOk? badRes) "Malformed index text does not report ok")) true)

fn testQuerySymbolImpactAndCeiling -> Bool
  (let [(modules (list (pair "sample/mathEngine" (sampleModuleA)) (pair "sample/calcService" (sampleModuleB)) (pair "tests/sample/calcServiceTest" (sampleTestModule)))) (idx (hyper/buildHypergraphFromModules modules)) (receipt (hyper/querySymbolImpact idx "addNumbers")) (formatted (hyper/formatImpactReceipt receipt)) (tokens (hyper/estimateReceiptTokens formatted))] (assert (= receipt.symbol "addNumbers") "Receipt symbol is addNumbers") (assert (= receipt.status "ok") "Receipt status is ok") (assert (>= receipt.callersCount 1) "Receipt reports at least 1 caller") (assert (>= receipt.testsCount 1) "Receipt reports at least 1 test") (refute (= receipt.status "not-found") "Found symbol does not report not-found") (assert (stringContains? formatted "(:impact-receipt") "Formatted receipt starts with :impact-receipt") (assert (stringContains? formatted ":symbol \"addNumbers\"") "Formatted receipt contains symbol name") (assert (stringContains? formatted ":callers") "Formatted receipt contains :callers") (assert (stringContains? formatted ":tests") "Formatted receipt contains :tests") (assert (< tokens 80) "Formatted receipt token count strictly satisfies sub-80-token ceiling") (refute (>= tokens 80) "Token count is strictly less than 80 tokens") (refute (stringContains? formatted ":line") "Zero-line-number invariant: no line numbers in impact receipt") (refute (stringContains? formatted ":col") "Zero-line-number invariant: no column numbers in impact receipt") (let [(missingReceipt (hyper/querySymbolImpact idx "nonExistentSymbol")) (missingFormatted (hyper/formatImpactReceipt missingReceipt))] (assert (= missingReceipt.status "not-found") "Unknown symbol reports status :not-found") (assert (= missingReceipt.callersCount 0) "Unknown symbol reports 0 callers") (assert (= missingReceipt.testsCount 0) "Unknown symbol reports 0 tests") (refute (= missingReceipt.status "ok") "Unknown symbol does not report ok") (refute (> missingReceipt.callersCount 0) "Unknown symbol has no callers")) (let [(fanInModules (highFanInCorpus)) (fanInIdx (hyper/buildHypergraphFromModules fanInModules)) (fanInReceipt (hyper/querySymbolImpact fanInIdx "coreAction")) (fanInFormatted (hyper/formatImpactReceipt fanInReceipt)) (fanInTokens (hyper/estimateReceiptTokens fanInFormatted))] (assert (= fanInReceipt.callersCount 7) "High fan-in reports total 7 inbound callers") (assert (= (listLength fanInReceipt.callers) 6) "Callers truncated to 5 entries plus 1 overflow summary label") (assert (fold (fn [(acc Bool) (s Str)] -> Bool (or acc (stringContains? s "+2 more callers"))) false fanInReceipt.callers) "Callers contains overflow label +2 more callers") (refute (= (listLength fanInReceipt.callers) 7) "Callers list does not exceed truncation boundary") (assert (= fanInReceipt.testsCount 5) "High fan-in reports total 5 test dependencies") (assert (= (listLength fanInReceipt.tests) 4) "Tests truncated to 3 entries plus 1 overflow summary label") (assert (fold (fn [(acc Bool) (s Str)] -> Bool (or acc (stringContains? s "+2 more tests"))) false fanInReceipt.tests) "Tests contains overflow label +2 more tests") (refute (= (listLength fanInReceipt.tests) 5) "Tests list does not exceed truncation boundary") (assert (< fanInTokens 80) "High fan-in truncated receipt strictly satisfies sub-80-token ceiling") (refute (>= fanInTokens 80) "Truncated token density is strictly less than 80")) true)

fn testCliImpactIntegration! -> Bool
  (let [(helpMsg (cliImpact/formatImpactHelp))] (assert (stringContains? helpMsg "Usage: asl impact <symbol>") "Manual contains usage header") (assert (stringContains? helpMsg "GroundTruthOverReport") "Manual mentions GroundTruthOverReport principle") (assert (stringContains? helpMsg "Zero-Line-Number") "Manual mentions Zero-Line-Number invariant") (refute (stringContains? helpMsg ":line") "Zero-line-number invariant: manual contains no line number instructions") (let [(emptyRes (cliImpact/runImpactCommand! (list)))] (assert (isOk? emptyRes) "Empty command arguments returns ok usage manual") (mt emptyRes ((ok msg) (assert (stringContains? msg "Usage: asl impact") "Empty args output contains usage")) ((err _) (assert false "Empty args should not fail")))) (let [(helpRes (cliImpact/runImpactCommand! (list "--help")))] (assert (isOk? helpRes) "--help flag returns ok usage manual") (mt helpRes ((ok msg) (assert (stringContains? msg "Usage: asl impact") "Help output contains usage")) ((err _) (assert false "Help should not fail")))) (let [(queryRes (cliImpact/runImpactCommand! (list "parsePatch")))] (assert (isOk? queryRes) "Valid query returns ok receipt") (mt queryRes ((ok msg) (do (assert (stringContains? msg "(:impact-receipt") "Query output contains :impact-receipt") (assert (stringContains? msg ":symbol \"parsePatch\"") "Query output contains symbol") (refute (stringContains? msg ":line") "Zero-line-number invariant: query output contains no line number"))) ((err _) (assert false "Query should succeed")))) true)

fn testDualPolarityRefutations -> Bool
  (let [(modules (list (pair "sample/mathEngine" (sampleModuleA)) (pair "sample/calcService" (sampleModuleB)))) (origIdx (hyper/buildHypergraphFromModules modules)) (baseReceipt (hyper/querySymbolImpact origIdx "addNumbers"))] (assert (> baseReceipt.callersCount 0) "Baseline query observes callers") (refute (= baseReceipt.callersCount 0) "Baseline callers count is not zero") (let [(mutantModules (list (pair "sample/mathEngine" (str "(module sample/mathEngine :x [addNumbersMutated])\n" "(df addNumbersMutated [(a Int64) (b Int64)] -> Int64 (+ a b))\n")) (pair "sample/calcService" (str "(module sample/calcService :x [calcMutated])\n" "(df calcMutated [] -> Int64 (addNumbersMutated 1 2))\n")))) (mutantIdx (hyper/buildHypergraphFromModules mutantModules)) (mutantReceipt (hyper/querySymbolImpact mutantIdx "addNumbers"))] (assert (= mutantReceipt.status "not-found") "Mutated symbol in target causes addNumbers to be not-found") (assert (= mutantReceipt.callersCount 0) "Mutated target graph has 0 callers for old symbol") (refute (= mutantReceipt.status "ok") "Mutated target graph does not report ok status")) (let [(severedModules (list (pair "sample/mathEngine" (sampleModuleA)) (pair "sample/calcService" (str "(module sample/calcService :x [isolatedFn])\n" "(df isolatedFn [] -> Int64 0)\n")))) (severedIdx (hyper/buildHypergraphFromModules severedModules)) (severedReceipt (hyper/querySymbolImpact severedIdx "addNumbers"))] (assert (= severedReceipt.callersCount 0) "Severed caller edge drops callers count to 0") (refute (> severedReceipt.callersCount 0) "Severed graph has no callers for target")) (let [(mutatedSerialized "(:hyperIndex :version 1 :nodes [ (:node :broken) ] :edges [])") (corruptRes (hyper/deserializeHyperIndex mutatedSerialized))] (assert (isErr? corruptRes) "Corrupted node format refutes clean deserialization") (refute (isOk? corruptRes) "Corrupted node does not yield ok Result")) true)

fn ! runTests -> Bool
  (and (testHypergraphDataModel) (and (testModuleExtractionAndIndexBuilding) (and (testIndexSerializationRoundtrip) (and (testQuerySymbolImpactAndCeiling) (and (testCliImpactIntegration!) (testDualPolarityRefutations))))))
