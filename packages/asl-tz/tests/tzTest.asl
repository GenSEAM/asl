(module asl-tz/tzTest
  :x [runTests]
  :i [(asl-tz/tzif :a tz) (asl-tz/zone :a z)])

fn makeVersionFixture version: Int64 -> Bytes
  (let [(bytes (bytesAlloc (if (= version 0) 54 110)))
        (firstEnd (if (= version 0) 0 54))]
    (bytesSet bytes 0 84) (bytesSet bytes 1 90) (bytesSet bytes 2 105) (bytesSet bytes 3 102)
    (bytesSet bytes 4 version) (bytesSet bytes 39 1) (bytesSet bytes 43 4)
    (bytesSet bytes 50 85) (bytesSet bytes 51 84) (bytesSet bytes 52 67)
    (if (= version 0) (bytesSet bytes 53 0)
      (let [(p firstEnd)]
        (bytesSet bytes p 84) (bytesSet bytes (+ p 1) 90) (bytesSet bytes (+ p 2) 105) (bytesSet bytes (+ p 3) 102)
        (bytesSet bytes (+ p 4) version) (bytesSet bytes (+ p 39) 1) (bytesSet bytes (+ p 43) 4)
        (bytesSet bytes 104 85) (bytesSet bytes 105 84) (bytesSet bytes 106 67) (bytesSet bytes 107 0)
        (bytesSet bytes 108 10) (bytesSet bytes 109 10)))
    bytes)

fn makeFooterFixtureCopy base: Bytes out: Bytes i: Int64 -> Bool
  (if (>= i 108) true (let [(set (bytesSet out i (bytesGet base i)))] (makeFooterFixtureCopy base out (+ i 1))))

fn makeFooterFixtureFooterLoop footerBytes: Bytes out: Bytes i: Int64 -> Bool
  (if (>= i (bytesLength footerBytes)) true
    (let [(set (bytesSet out (+ 109 i) (bytesGet footerBytes i)))] (makeFooterFixtureFooterLoop footerBytes out (+ i 1))))

fn makeFooterFixture footer: String -> Bytes
  (let [(base (makeVersionFixture 50)) (footerBytes (stringToBytes footer))
        (out (bytesAlloc (+ 110 (+ (bytesLength footerBytes) 1))))]
    (makeFooterFixtureCopy base out 0)
    (bytesSet out 108 10)
    (makeFooterFixtureFooterLoop footerBytes out 0)
    (bytesSet out (+ 109 (bytesLength footerBytes)) 10)
    out)

fn ! runTests -> Bool
  (let [(nyResult (fileReadBytes "asl/packages/asl-tz/tests/fixtures/America_New_York.tzif"))
        (berlinResult (fileReadBytes "asl/packages/asl-tz/tests/fixtures/Europe_Berlin.tzif"))
        (sydneyResult (fileReadBytes "asl/packages/asl-tz/tests/fixtures/Australia_Sydney.tzif"))]
    (match nyResult
      ((err e) (assert false (str "New York fixture readable: " e)))
      ((ok nyBytes)
        (match (tz/tzifParse nyBytes)
          ((err e) (assert false (str "New York TZif parses: " e)))
          ((ok parsed)
            (assert (= (tz/tzifVersion parsed) "2") "New York TZif v2 fixture parses")
            (assert (>= (tz/tzifTransitionCount parsed) 100) "New York fixture has historical transition records")
            (assert (= (z/zoneOffset parsed 1710053999) -18000) "New York before 2024 spring transition is EST")
            (assert (= (z/zoneOffset parsed -5364662400) -17762) "New York 1800 pre-first-transition vector is LMT")
            (assert (= (z/zoneOffset parsed 1710054000) -14400) "New York at 2024 spring transition is EDT")
            (assert (= (z/zoneOffset parsed 1730613599) -14400) "New York before 2024 fall transition is EDT")
            (assert (= (z/zoneOffset parsed 1730613600) -18000) "New York at 2024 fall transition is EST")
            (assert (= (z/zoneAbbreviation parsed 1710054000) "EDT") "New York daylight abbreviation is EDT")
            (assert (stringContains? (tz/tzifFooter parsed) "M3.2.0") "New York POSIX footer is retained")
            (assert (err? (z/localToUtc parsed 2215045800 "err")) "New York footer-era spring gap is detected")
            (assert (= (resultOr (z/localToUtc parsed 2215045800 "earlier") -99) 2215063800) "New York footer-era gap earlier policy")
            (assert (= (resultOr (z/localToUtc parsed 2215045800 "later") -99) 2215060200) "New York footer-era gap later policy")
            (assert (err? (z/localToUtc parsed 2235605400 "err")) "New York footer-era fall fold is detected")
            (assert (= (resultOr (z/localToUtc parsed 2235605400 "first") -99) 2235619800) "New York footer-era fold first policy")
            (assert (= (resultOr (z/localToUtc parsed 2235605400 "second") -99) 2235623400) "New York footer-era fold second policy")
            (assert (err? (z/localToUtc parsed 1710037800 "err")) "New York real spring gap rejects")
            (assert (= (resultOr (z/localToUtc parsed 1710037800 "earlier") -99) 1710055800) "New York spring gap earlier uses old offset")
            (assert (= (resultOr (z/localToUtc parsed 1710037800 "later") -99) 1710052200) "New York spring gap later uses new offset")
            (assert (err? (z/localToUtc parsed 1730597400 "err")) "New York real fall fold rejects")
            (assert (= (resultOr (z/localToUtc parsed 1730597400 "first") -99) 1730611800) "New York fall fold first is earlier instant")
            (assert (= (resultOr (z/localToUtc parsed 1730597400 "second") -99) 1730615400) "New York fall fold second is later instant")))))
    (match berlinResult
      ((err e) (assert false (str "Berlin fixture readable: " e)))
      ((ok berlinBytes)
        (match (tz/tzifParse berlinBytes)
          ((err e) (assert false (str "Berlin TZif parses: " e)))
          ((ok parsed)
            (assert (= (tz/tzifVersion parsed) "2") "Berlin TZif v2 fixture parses")
            (assert (= (z/zoneOffset parsed 1711846799) 3600) "Berlin before spring transition is CET")
            (assert (= (z/zoneOffset parsed -5364662400) 3208) "Berlin 1800 pre-first-transition vector is LMT")
            (assert (= (z/zoneOffset parsed 1711846800) 7200) "Berlin at spring transition is CEST")
            (assert (= (z/zoneOffset parsed 1729990799) 7200) "Berlin before fall transition is CEST")
            (assert (= (z/zoneOffset parsed 1729990800) 3600) "Berlin at fall transition is CET")
            (assert (err? (z/localToUtc parsed 1711852200 "err")) "Berlin real spring gap rejects")
            (assert (= (resultOr (z/localToUtc parsed 1711852200 "earlier") -99) 1711848600) "Berlin spring gap earlier uses old offset")
            (assert (= (resultOr (z/localToUtc parsed 1711852200 "later") -99) 1711845000) "Berlin spring gap later uses new offset")
            (assert (err? (z/localToUtc parsed 1729996200 "err")) "Berlin real fall fold rejects")
            (assert (= (resultOr (z/localToUtc parsed 1729996200 "first") -99) 1729989000) "Berlin fall fold first is earlier instant")
            (assert (= (resultOr (z/localToUtc parsed 1729996200 "second") -99) 1729992600) "Berlin fall fold second is later instant")))))
    (match sydneyResult
      ((err e) (assert false (str "Sydney fixture readable: " e)))
      ((ok sydneyBytes)
        (match (tz/tzifParse sydneyBytes)
          ((err e) (assert false (str "Sydney TZif parses: " e)))
          ((ok parsed)
            (assert (= (tz/tzifVersion parsed) "2") "Sydney TZif v2 fixture parses")
            (assert (= (z/zoneOffset parsed 1712419199) 39600) "Sydney before autumn transition is AEDT")
            (assert (= (z/zoneOffset parsed -5364662400) 36292) "Sydney 1800 pre-first-transition vector is LMT")
            (assert (= (z/zoneOffset parsed 1712419200) 36000) "Sydney at autumn transition is AEST")
            (assert (= (z/zoneOffset parsed 1728143999) 36000) "Sydney before spring transition is AEST")
            (assert (= (z/zoneOffset parsed 1728144000) 39600) "Sydney at spring transition is AEDT")
            (assert (err? (z/localToUtc parsed 1728181800 "err")) "Sydney real spring gap rejects")
            (assert (= (resultOr (z/localToUtc parsed 1728181800 "earlier") -99) 1728145800) "Sydney spring gap earlier uses old offset")
            (assert (= (resultOr (z/localToUtc parsed 1728181800 "later") -99) 1728142200) "Sydney spring gap later uses new offset")
            (assert (err? (z/localToUtc parsed 1712457000 "err")) "Sydney real fall fold rejects")
            (assert (= (resultOr (z/localToUtc parsed 1712457000 "first") -99) 1712417400) "Sydney fall fold first is earlier instant")
            (assert (= (resultOr (z/localToUtc parsed 1712457000 "second") -99) 1712421000) "Sydney fall fold second is later instant")))))
    (assert (err? (tz/tzifParse (bytesAlloc 10))) "truncated TZif header is a typed error")
    (assert (err? (tz/tzifParse (makeFooterFixture "EST5EDT,M3.2.0"))) "incomplete POSIX footer is rejected")
    (assert (err? (tz/tzifParse (makeFooterFixture "EST5EDT,broken,M11.1.0"))) "malformed POSIX transition rule is rejected")
    (assert (err? (tz/tzifParse (makeFooterFixture "ESTxEDT,M3.2.0,M11.1.0"))) "malformed POSIX offset is rejected")
    (assert (= (tz/tzifVersion (resultOr (tz/tzifParse (makeVersionFixture 0)) (tz/tzifData "bad" [] [] [0] [false] [""] ""))) "1") "TZif v1 fixture parses with four-byte times")
    (assert (= (tz/tzifVersion (resultOr (tz/tzifParse (makeVersionFixture 51)) (tz/tzifData "bad" [] [] [0] [false] [""] ""))) "3") "TZif v3 fixture parses with eight-byte times")
    (assert (= (tz/tzifVersion (resultOr (tz/tzifParse (makeVersionFixture 52)) (tz/tzifData "bad" [] [] [0] [false] [""] ""))) "4") "TZif v4 fixture parses with eight-byte times")
    (let [(bad (bytesAlloc 44))]
      (bytesSet bad 0 88)
      (assert (err? (tz/tzifParse bad)) "bad TZif magic is a typed error"))
    (let [(badIndex (bytesAlloc 59))
          (utcZone (tz/tzifData "1" [] [] [0] [false] ["UTC"] ""))]
      (bytesSet badIndex 0 84)
      (bytesSet badIndex 1 90)
      (bytesSet badIndex 2 105)
      (bytesSet badIndex 3 102)
      (bytesSet badIndex 35 1)
      (bytesSet badIndex 39 1)
      (bytesSet badIndex 43 4)
      (bytesSet badIndex 48 1)
      (bytesSet badIndex 55 85)
      (bytesSet badIndex 56 84)
      (bytesSet badIndex 57 67)
      (assert (err? (tz/tzifParse badIndex)) "out-of-range TZif transition type index is a typed error")
      (assert (= (z/zoneOffset utcZone 123) 0) "UTC zone conversion remains at zero offset")
      (assert (= (z/zoneAbbreviation utcZone 123) "UTC") "UTC abbreviation is preserved"))
    (assert (not (tz/safeZoneName? "../etc/passwd")) "zone loader rejects traversal names")
    (let [(syntheticGap (tz/tzifData "2" [100] [1] [0 3600] [false true] ["STD" "DST"] ""))
          (syntheticFold (tz/tzifData "2" [1000] [1] [3600 0] [true false] ["DST" "STD"] ""))]
      (assert (= (resultOr (z/localToUtc syntheticGap 1000 "earlier") -99) 1000) "gap earlier policy uses pre-transition offset")
      (assert (= (resultOr (z/localToUtc syntheticGap 1000 "later") -99) -2600) (str "gap later policy uses post-transition offset: " (stringFromInt64 (resultOr (z/localToUtc syntheticGap 1000 "later") -99))))
      (assert (err? (z/localToUtc syntheticGap 1000 "err")) "gap err policy rejects missing local time")
      (assert (= (resultOr (z/localToUtc syntheticFold 2000 "first") -99) -1600) "fold first policy selects earlier instant")
      (assert (= (resultOr (z/localToUtc syntheticFold 2000 "second") -99) 2000) "fold second policy selects later instant")
      (assert (err? (z/localToUtc syntheticFold 2000 "err")) "fold err policy rejects repeated local time"))
    (let [(sameOffsets (tz/tzifData "1" [] [] [0 0] [false false] ["A" "B"] ""))]
      (assert (= (resultOr (z/localToUtc sameOffsets 1234 "err") -99) 1234) "duplicate offset types are not reported as a fold"))
    (let [(julianFooter (tz/tzifData "2" [] [] [0 3600] [false true] ["STD" "DST"] "STD0DST,J60/0,J300/0"))
          (ordinalFooter (tz/tzifData "2" [] [] [0 3600] [false true] ["STD" "DST"] "STD0DST,59/0,300/0"))
          (angleFooter (tz/tzifData "2" [] [] [10800] [false] ["+03"] "<+03>-3"))]
      (assert (= (z/zoneOffset julianFooter 2214172800) 3600) "POSIX Jn rules skip leap day")
      (assert (= (z/zoneOffset ordinalFooter 2214086400) 3600) "POSIX numeric day rules include leap day")
      (assert (= (z/zoneOffset angleFooter 2208988800) 10800) "POSIX angle-bracket abbreviations and reversed offsets parse"))
    (let [(malformedAbbr (bytesAlloc 53))]
      (bytesSet malformedAbbr 0 84) (bytesSet malformedAbbr 1 90) (bytesSet malformedAbbr 2 105) (bytesSet malformedAbbr 3 102)
      (bytesSet malformedAbbr 39 1) (bytesSet malformedAbbr 43 3) (bytesSet malformedAbbr 50 65) (bytesSet malformedAbbr 51 66) (bytesSet malformedAbbr 52 67)
      (let [(parsed (tz/tzifParse malformedAbbr))]
        (assert (err? parsed) "unterminated abbreviation table is rejected")
        (assert (match parsed ((err e) (stringContains? e "offset:53")) ((ok _) false)) "unterminated abbreviation reports its byte offset")))
    (match (fileReadBytes "asl/packages/asl-tz/tests/fixtures/America_New_York.tzif")
      ((err e) (assert false (str "New York footer fixture readable: " e)))
      ((ok bytes) (match (tz/tzifParse bytes) ((err e) (assert false (str "New York footer parses: " e)))
        ((ok zone) (assert (= (z/zoneOffset zone 2208988800) -18000) (str "New York POSIX footer winter offset after table: " (stringFromInt64 (z/zoneOffset zone 2208988800))))
          (assert (= (z/zoneOffset zone 2225041200) -14400) "New York POSIX footer summer offset after table")
          (assert (not (z/zoneIsDst zone 2208988800)) "New York footer winter is standard time")
          (assert (z/zoneIsDst zone 2225041200) "New York footer summer is daylight time")
          (assert (= (z/zoneAbbreviation zone 2225041200) "EDT") "New York footer returns daylight abbreviation")
          (assert (= (z/zoneOffset zone 2215061999) -18000) "New York footer start rule applies standard offset immediately before transition")
          (assert (= (z/zoneOffset zone 2215062000) -14400) "New York footer start rule applies daylight offset at transition")
          (assert (= (z/zoneOffset zone 2235621599) -14400) "New York footer end rule applies daylight offset immediately before transition")
          (assert (= (z/zoneOffset zone 2235621600) -18000) "New York footer end rule applies standard offset at transition")))))
    (match (fileReadBytes "asl/packages/asl-tz/tests/fixtures/Europe_Berlin.tzif")
      ((err e) (assert false (str "Berlin footer fixture readable: " e)))
      ((ok bytes) (match (tz/tzifParse bytes) ((err e) (assert false (str "Berlin footer parses: " e)))
        ((ok zone) (assert (= (z/zoneOffset zone 2208988800) 3600) "Berlin POSIX footer winter offset after table")
          (assert (= (z/zoneOffset zone 2225041200) 7200) "Berlin POSIX footer summer offset after table")))))
    (match (fileReadBytes "asl/packages/asl-tz/tests/fixtures/Australia_Sydney.tzif")
      ((err e) (assert false (str "Sydney footer fixture readable: " e)))
      ((ok bytes) (match (tz/tzifParse bytes) ((err e) (assert false (str "Sydney footer parses: " e)))
        ((ok zone) (assert (= (z/zoneOffset zone 2208988800) 39600) "Sydney POSIX footer summer offset after table")
          (assert (= (z/zoneOffset zone 2225041200) 36000) "Sydney POSIX footer winter offset after table")
          (assert (= (z/zoneOffset zone 2233152000) 39600) "Sydney POSIX footer applies its southern-hemisphere start rule")))))
    (if (fileExists? "/usr/share/zoneinfo/America/New_York")
      (match (tz/loadZone "America/New_York")
        ((err e) (assert false (str "system zone file loads: " e)))
        ((ok systemZone) (assert (= (tz/tzifVersion systemZone) "2") "OS timezone database can load a zone")))
      (assert (not (fileExists? "/usr/share/zoneinfo/America/New_York")) "OS zone database absence is detected"))
    true)
