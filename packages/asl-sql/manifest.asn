(:package asl-sql
 :version "0.1.0"
 :entry "src/core/sql.asl"
 :description "Cross-dialect SQL text from an AST: literals in value position are bound as parameters; identifiers, JSON paths, rawSql and UPDATE/DELETE clauses are not escaped yet (ROADMAP P0); nothing executes queries"
 :aslFirst true
 :modules [
   "asl-sql/ddl"
   "asl-sql/schemaGen"
   "duckdbAdapter"
   "asl-sql/core"
   "asl-sql/semantic/expand"
   "asl-sql/semantic/lower"
   "asl-sql/semantic/schema"
 ]
 :dependencies ["asl-derive" "asl-text" "asl-parser"])
