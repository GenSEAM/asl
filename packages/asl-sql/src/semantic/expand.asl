(module asl-sql/semantic/expand :x [SemanticQuery ExpandedQuery makeSemanticQuery expandQuery expandExpr] :i [(asl-sql/core :a sql) (asl-sql/semantic/schema :a sem) (asl-text/string :a s)])

(schema SemanticQuery (:f fromEntity String) (:f selectFields (List String)) (:f selectMeasures (List String)) (:f whereExpr (Option sql/SqlExpr)) (:f orderBy (Option String)) (:f orderDir sql/OrderDir) (:f limitCount (Option Int64)) (:f offsetCount (Option Int64)))

(schema ExpandedQuery (:f rootEntity sem/EntityModel) (:f projectedFields (List sql/SqlExpr)) (:f projectedMeasures (List sql/SqlExpr)) (:f whereClause (Option sql/SqlExpr)) (:f requiredRelations (List sem/RelationDef)) (:f groupBy (List String)) (:f orderBy (Option String)) (:f orderDir sql/OrderDir) (:f limitCount (Option Int64)) (:f offsetCount (Option Int64)))

fn makeSemanticQuery fromEntity: String selectFields: (List String) selectMeasures: (List String) whereExpr: (Option sql/SqlExpr) orderBy: (Option String) orderDir: sql/OrderDir limitCount: (Option Int64) offsetCount: (Option Int64) -> SemanticQuery
  (SemanticQuery :fromEntity fromEntity :selectFields selectFields :selectMeasures selectMeasures :whereExpr whereExpr :orderBy orderBy :orderDir orderDir :limitCount limitCount :offsetCount offsetCount)

fn listContainsStr lst: (List String) item: String -> Bool
  (if (listEmpty? lst) false (mt (listHead lst) ((some x) (if (= x item) true (listContainsStr (optionOr (listTail lst) (list)) item))) ((none) false)))

fn expandExpr expr: sql/SqlExpr model: sem/EntityModel schema: sem/SemanticSchema visited: (List String) -> (Result sql/SqlExpr String)
  (mt expr ((col name) (if (listContainsStr visited name) (err (str "Cycle detected in derived field: " name)) (mt (sem/findDerived model name) ((some d) (expandExpr d.expr model schema (cons name visited))) ((none) (if (stringContains? name ".") (let [(parts (stringSplit name ".")) (relName (optionOr (listHead parts) "")) (colName (optionOr (listHead (optionOr (listTail parts) (list))) ""))] (mt (sem/findRelation model relName) ((some r) (ok (sql/qualCol r.targetEntity colName))) ((none) (ok (sql/col name))))) (ok (sql/col name))))))) ((binary op l r) (mt (expandExpr l model schema visited) ((err e) (err e)) ((ok el) (mt (expandExpr r model schema visited) ((err e) (err e)) ((ok er) (ok (sql/binary op el er))))))) ((andExpr l r) (mt (expandExpr l model schema visited) ((err e) (err e)) ((ok el) (mt (expandExpr r model schema visited) ((err e) (err e)) ((ok er) (ok (sql/andExpr el er))))))) ((orExpr l r) (mt (expandExpr l model schema visited) ((err e) (err e)) ((ok el) (mt (expandExpr r model schema visited) ((err e) (err e)) ((ok er) (ok (sql/orExpr el er))))))) ((notExpr inner) (mt (expandExpr inner model schema visited) ((err e) (err e)) ((ok ei) (ok (sql/notExpr ei))))) ((arith op l r) (mt (expandExpr l model schema visited) ((err e) (err e)) ((ok el) (mt (expandExpr r model schema visited) ((err e) (err e)) ((ok er) (ok (sql/arith op el er))))))) ((agg fn arg distinct) (mt (expandExpr arg model schema visited) ((err e) (err e)) ((ok ea) (ok (sql/agg fn ea distinct))))) ((alias inner asName) (mt (expandExpr inner model schema visited) ((err e) (err e)) ((ok ei) (ok (sql/alias ei asName))))) (_ (ok expr)))

fn collectReferencedRelations expr: sql/SqlExpr model: sem/EntityModel -> (List sem/RelationDef)
  (mt expr ((col name) (if (stringContains? name ".") (let [(parts (stringSplit name ".")) (relName (optionOr (listHead parts) ""))] (mt (sem/findRelation model relName) ((some r) (list r)) ((none) (list)))) (list))) ((qualCol tbl col) (let [(rels model.relations)] (filter (fn [(r sem/RelationDef)] -> Bool (= r.targetEntity tbl)) rels))) ((binary _ l r) (listAppend (collectReferencedRelations l model) (collectReferencedRelations r model))) ((andExpr l r) (listAppend (collectReferencedRelations l model) (collectReferencedRelations r model))) ((orExpr l r) (listAppend (collectReferencedRelations l model) (collectReferencedRelations r model))) ((notExpr inner) (collectReferencedRelations inner model)) ((arith _ l r) (listAppend (collectReferencedRelations l model) (collectReferencedRelations r model))) ((agg _ arg _) (collectReferencedRelations arg model)) ((alias inner _) (collectReferencedRelations inner model)) (_ (list)))

fn expandFieldsList fields: (List String) model: sem/EntityModel schema: sem/SemanticSchema -> (Result (List sql/SqlExpr) String)
  (if (listEmpty? fields) (ok (list)) (mt (listHead fields) ((none) (ok (list))) ((some fName) (let [(restFields (optionOr (listTail fields) (list)))] (if (stringContains? fName ".") (let [(parts (stringSplit fName ".")) (relName (optionOr (listHead parts) "")) (colName (optionOr (listHead (optionOr (listTail parts) (list))) ""))] (mt (sem/findRelation model relName) ((some r) (let [(expr (sql/alias (sql/qualCol r.targetEntity colName) (str relName "_" colName)))] (mt (expandFieldsList restFields model schema) ((err e) (err e)) ((ok restExprs) (ok (cons expr restExprs)))))) ((none) (err (str "Unknown relation in field: " fName))))) (mt (sem/findField model fName) ((some f) (let [(expr (sql/col f.name))] (mt (expandFieldsList restFields model schema) ((err e) (err e)) ((ok restExprs) (ok (cons expr restExprs)))))) ((none) (mt (sem/findDerived model fName) ((some d) (mt (expandExpr d.expr model schema (list fName)) ((err e) (err e)) ((ok ex) (let [(expr (sql/alias ex fName))] (mt (expandFieldsList restFields model schema) ((err e) (err e)) ((ok restExprs) (ok (cons expr restExprs)))))))) ((none) (err (str "Unknown field: " fName " on entity: " model.name)))))))))))

fn expandMeasuresList measures: (List String) model: sem/EntityModel schema: sem/SemanticSchema -> (Result (List sql/SqlExpr) String)
  (if (listEmpty? measures) (ok (list)) (mt (listHead measures) ((none) (ok (list))) ((some mName) (let [(restMeasures (optionOr (listTail measures) (list)))] (mt (sem/findMeasure model mName) ((some m) (mt (expandExpr m.expr model schema (list)) ((err e) (err e)) ((ok ex) (let [(aggEx (sql/alias (sql/agg m.aggFn ex m.distinct) mName))] (mt (expandMeasuresList restMeasures model schema) ((err e) (err e)) ((ok restM) (ok (cons aggEx restM)))))))) ((none) (err (str "Unknown measure: " mName " on entity: " model.name))))))))

fn deduplicateRelations rels: (List sem/RelationDef) -> (List sem/RelationDef)
  (if (listEmpty? rels) (list) (mt (listHead rels) ((none) (list)) ((some r) (let [(tailR (optionOr (listTail rels) (list))) (restDedup (deduplicateRelations tailR)) (matches (filter (fn [(x sem/RelationDef)] -> Bool (= x.targetEntity r.targetEntity)) restDedup))] (if (> (listLength matches) 0) restDedup (cons r restDedup))))))

fn expandQuery schema: sem/SemanticSchema q: SemanticQuery -> (Result ExpandedQuery String)
  (mt (sem/findEntity schema q.fromEntity) ((none) (err (str "Entity not found: " q.fromEntity))) ((some model) (mt (expandFieldsList q.selectFields model schema) ((err e) (err e)) ((ok projFields) (mt (expandMeasuresList q.selectMeasures model schema) ((err e) (err e)) ((ok projMeasures) (let [(whereRes (mt q.whereExpr ((none) (ok (none))) ((some w) (mt (expandExpr w model schema (list)) ((err e) (err e)) ((ok ew) (ok (some ew)))))))] (mt whereRes ((err e) (err e)) ((ok expWhere) (let [(whereRels (mt expWhere ((none) (list)) ((some ew) (collectReferencedRelations ew model)))) (fieldRels (fold (fn [(acc (List sem/RelationDef)) (f sql/SqlExpr)] -> (List sem/RelationDef) (listAppend acc (collectReferencedRelations f model))) (list) projFields)) (allRels (deduplicateRelations (listAppend whereRels fieldRels))) (groups (if (> (listLength projMeasures) 0) (fold (fn [(acc (List String)) (f sql/SqlExpr)] -> (List String) (mt f ((col n) (cons n acc)) ((qualCol _ c) (cons c acc)) ((alias _ n) (cons n acc)) (_ acc))) (list) projFields) (list)))] (ok (ExpandedQuery :rootEntity model :projectedFields projFields :projectedMeasures projMeasures :whereClause expWhere :requiredRelations allRels :groupBy (listReverse groups) :orderBy q.orderBy :orderDir q.orderDir :limitCount q.limitCount :offsetCount q.offsetCount))))))))))))
