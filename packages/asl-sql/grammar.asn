(:grammar
  :package asl-sql
  :version "0.1.0"
  :tokens-baseline 1
  :symbols [
    (:sym :name "BinaryOp" :kind :type :tokens 1)
    (:sym :name "ColumnDef" :kind :type :tokens 1)
    (:sym :name "InsertQuery" :kind :type :tokens 1)
    (:sym :name "JoinType" :kind :type :tokens 1)
    (:sym :name "OrderDir" :kind :type :tokens 1)
    (:sym :name "RenderedQuery" :kind :type :tokens 1)
    (:sym :name "SelectQuery" :kind :type :tokens 1)
    (:sym :name "SqlColumnType" :kind :type :tokens 1)
    (:sym :name "SqlDialect" :kind :type :tokens 1)
    (:sym :name "SqlExpr" :kind :type :tokens 1)
    (:sym :name "SqlJoin" :kind :type :tokens 1)
    (:sym :name "TableDef" :kind :type :tokens 1)
    (:sym :name "UpdateQuery" :kind :type :tokens 1)
    (:sym :name "UpsertQuery" :kind :type :tokens 1)

    (:sym :name "bool-expr" :kind :fn :tokens 2)
    (:sym :name "col-expr" :kind :fn :tokens 2)
    (:sym :name "collect-params" :kind :fn :tokens 2)
    (:sym :name "count-params" :kind :fn :tokens 2)
    (:sym :name "default-dialect" :kind :fn :tokens 2)
    (:sym :name "int-expr" :kind :fn :tokens 2)
    (:sym :name "is-parameterized" :kind :fn :tokens 2)
    (:sym :name "make-column" :kind :fn :tokens 2)
    (:sym :name "make-insert" :kind :fn :tokens 2)
    (:sym :name "make-join" :kind :fn :tokens 2)
    (:sym :name "make-select" :kind :fn :tokens 2)
    (:sym :name "make-table" :kind :fn :tokens 2)
    (:sym :name "make-update" :kind :fn :tokens 2)
    (:sym :name "make-upsert" :kind :fn :tokens 2)
    (:sym :name "raw-expr" :kind :fn :tokens 2)
    (:sym :name "render-delete" :kind :fn :tokens 2)
    (:sym :name "render-insert" :kind :fn :tokens 2)
    (:sym :name "render-placeholder" :kind :fn :tokens 2)
    (:sym :name "render-select" :kind :fn :tokens 2)
    (:sym :name "render-update" :kind :fn :tokens 2)
    (:sym :name "render-upsert" :kind :fn :tokens 2)
    (:sym :name "run-tests" :kind :fn :tokens 2)
    (:sym :name "str-expr" :kind :fn :tokens 2)

    (:sym :name "count-pair-params" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'count-params': specifically counts key-value insertion/update pairs rather than flat positional parameters")
    (:sym :name "dialect-param-prefix" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'param-prefix': requires explicit dialect qualification to avoid collision with generic query parameter placeholders")
    (:sym :name "dialect-quote-char" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'quote-char': disambiguates SQL dialect identifier escaping delimiters from string literal quotes")
    (:sym :name "is-literal-param" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'is-literal': distinguishes inlined SQL literal values from external bound parameters")
    (:sym :name "json-get-expr" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'json-get': specifies AST expression node construction for dialect-aware JSON property access")
    (:sym :name "make-column-custom" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'make-column': distinguishes user-defined custom DDL column definitions from standard typed column helpers")
    (:sym :name "render-binary-op" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'render-op': distinguishes infix binary operations (comparison/arithmetic) from unary/logical operators")
    (:sym :name "render-column-def" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'render-column': specifies complete DDL column definition rendering (types, constraints, defaults)")
    (:sym :name "render-create-table" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'create-table': separates DDL string rendering from in-memory schema table definitions")
    (:sym :name "render-expr-str" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'render-expr': explicitly denotes rendering to raw SQL string fragment rather than AST node")
    (:sym :name "render-json-path" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'json-path': separates dialect-aware JSON path expression rendering from path string representations")
    (:sym :name "render-logical-op" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'render-op': isolates WHERE/HAVING boolean combinator rendering (AND, OR, NOT) from binary expressions")
    (:sym :name "test-sql-ddl" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-ddl': isolates SQL dialect DDL generation assertions from general schema compiler tests")
    (:sym :name "test-sql-dialects" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-dialects': scopes test specifically to multi-engine SQL dialect differences")
    (:sym :name "test-sql-select" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-select': isolates SQL query generation tests from DDL and mutation statements")
    (:sym :name "test-ddl-table-creation" :kind :fn :tokens 4
          :rationale "Verifies DDL CREATE TABLE rendering")
    (:sym :name "test-ddl-column-types" :kind :fn :tokens 4
          :rationale "Verifies DDL column types mapping across SQL dialects")
    (:sym :name "type-to-sql-string" :kind :fn :tokens 4
          :rationale "Cannot be reduced to 'type-to-sql': distinguishes DDL type declaration string rendering from query expression lowering")
  ])
