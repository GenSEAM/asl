(module asl/packages/asl-sql/tests/semanticLayerTest :x [runTests RunTests testSqlExprExtensions testSemanticSchemaDefinition testSemanticExpansionAndCycles testSemanticLowering testDualPolarityRefutations] :i [(asl-sql/core :a sql) (asl-sql/semantic/schema :a sem) (asl-sql/semantic/expand :a exp) (asl-sql/semantic/lower :a low)])

fn testSqlExprExtensions -> Bool
  (let [(aExpr (sql/arithExpr "+" (sql/colExpr "amount") (sql/colExpr "tax"))) (sumExpr (sql/aggExpr "sum" (sql/colExpr "amount") false)) (cntDist (sql/aggExpr "count" (sql/colExpr "id") true)) (alExpr (sql/aliasExpr (sql/colExpr "total") "grand_total")) (qcExpr (sql/qualColExpr "orders" "status")) (w1 (sql/makeWhen (sql/binary (sql/eq) (sql/colExpr "status") (sql/strExpr "paid")) (sql/rawExpr "1"))) (w2 (sql/makeWhen (sql/binary (sql/eq) (sql/colExpr "status") (sql/strExpr "pending")) (sql/rawExpr "0"))) (caseEx (sql/caseWhenExpr (list w1 w2) (sql/rawExpr "-1"))) (renderedArith (sql/renderExprStr aExpr (sql/postgres) 1)) (renderedAgg (sql/renderExprStr sumExpr (sql/postgres) 1)) (renderedDist (sql/renderExprStr cntDist (sql/postgres) 1)) (renderedCase (sql/renderExprStr caseEx (sql/postgres) 1)) (pCount (sql/countParams caseEx)) (params (sql/collectParams caseEx))] (assert (= renderedArith "(amount) + (tax)") "arithmetic renders with operator") (assert (= renderedAgg "SUM(amount)") "agg renders function name") (assert (= renderedDist "COUNT(DISTINCT id)") "agg distinct renders DISTINCT") (assert (stringContains? renderedCase "CASE WHEN status = $1 THEN 1") "caseWhen renders WHEN branch 1") (assert (stringContains? renderedCase "WHEN status = $2 THEN 0") "caseWhen renders WHEN branch 2") (assert (stringContains? renderedCase "ELSE -1 END") "caseWhen renders ELSE and END") (assert (= pCount 2) "caseWhen has 2 literal parameters") (assert (= (listLength params) 2) "collectParams extracts 2 parameters") (let [(sel (sql/SelectQuery :columns (list "user_id" "SUM(amount) AS rev") :fromTable "orders" :joins (list) :whereClause (some (sql/binary (sql/gt) (sql/colExpr "amount") (sql/intExpr 0))) :groupBy (list "user_id") :havingClause (some (sql/binary (sql/gt) sumExpr (sql/intExpr 1000))) :orderColumn (none) :orderDir (sql/asc) :limitCount (some 25) :offsetCount (none) :forUpdateSkipLocked false :returningColumns (list))) (resPg (sql/renderSelect sel (sql/postgres))) (sqlPg resPg.sql)] (assert (stringContains? sqlPg "GROUP BY user_id") "renders GROUP BY") (assert (stringContains? sqlPg "HAVING SUM(amount) > $2") "renders HAVING clause with threaded param index") (assert (= resPg.paramCount 2) "renders 2 bound parameters") true))

fn buildSampleSchema -> sem/SemanticSchema
  (let [(fOrders (list (sem/makeFieldDef "id" "Int64") (sem/makeFieldDef "user_id" "Int64") (sem/makeFieldDef "amount" "Float64") (sem/makeFieldDef "tax" "Float64") (sem/makeFieldDef "status" "String"))) (dOrders (list (sem/makeDerivedField "total" (sql/arithExpr "+" (sql/colExpr "amount") (sql/colExpr "tax"))) (sem/makeDerivedField "isPaid" (sql/binary (sql/eq) (sql/colExpr "status") (sql/strExpr "paid"))))) (mOrders (list (sem/makeMeasureDef "totalRevenue" "sum" (sql/colExpr "amount") false) (sem/makeMeasureDef "orderCount" "count" (sql/colExpr "id") false))) (rOrders (list (sem/makeRelationDef "user" "users" "toOne" "user_id" "id") (sem/makeRelationDef "items" "order_items" "toMany" "id" "order_id"))) (mUsers (sem/makeEntityModel "users" "id" "users" (list (sem/makeFieldDef "id" "Int64") (sem/makeFieldDef "email" "String")) (list) (list (sem/makeMeasureDef "userCount" "count" (sql/colExpr "id") false)) (list))) (mOrder (sem/makeEntityModel "orders" "id" "orders" fOrders dOrders mOrders rOrders))] (sem/makeSemanticSchema (list mOrder mUsers)))

fn testSemanticSchemaDefinition -> Bool
  (let [(schema (buildSampleSchema)) (ordersOpt (sem/findEntity schema "orders"))] (assert (some? ordersOpt) "orders entity exists in schema") (mt ordersOpt ((none) (assert false "ordersOpt missing")) ((some orders) (let [(fAmount (sem/findField orders "amount")) (dTotal (sem/findDerived orders "total")) (mRev (sem/findMeasure orders "totalRevenue")) (rUser (sem/findRelation orders "user"))] (assert (some? fAmount) "amount field exists") (assert (some? dTotal) "total derived virtual field exists") (assert (some? mRev) "totalRevenue measure exists") (assert (some? rUser) "user relation exists") (assert (mt rUser ((none) false) ((some rUserVal) (= rUserVal.card "toOne"))) "user relation is toOne") true))))

fn testSemanticExpansionAndCycles -> Bool
  (let [(schema (buildSampleSchema)) (q (exp/makeSemanticQuery "orders" (list "id" "total") (list "totalRevenue") (some (sql/andExpr (sql/colExpr "isPaid") (sql/binary (sql/gt) (sql/colExpr "total") (sql/intExpr 100)))) (some "total") (sql/desc) (some 10) (none)))] (mt (exp/expandQuery schema q) ((err e) (assert false (str "expandQuery failed: " e))) ((ok expanded) (let [(wClause expanded.whereClause)] (assert (some? wClause) "expanded query has where clause") (mt wClause ((none) (assert false "wClause missing")) ((some wClauseVal) (let [(wStr (sql/renderExprStr wClauseVal (sql/postgres) 1))] (assert (stringContains? wStr "status = $1") "inlined isPaid into status check") (assert (stringContains? wStr "(amount) + (tax)") "inlined total into (amount) + (tax)") true)))))) (let [(cycleD (list (sem/makeDerivedField "a" (sql/arithExpr "+" (sql/colExpr "b") (sql/intExpr 1))) (sem/makeDerivedField "b" (sql/arithExpr "+" (sql/colExpr "a") (sql/intExpr 1))))) (cycleModel (sem/makeEntityModel "cycles" "id" "cycles" (list) cycleD (list) (list))) (cycleSchema (sem/makeSemanticSchema (list cycleModel))) (cycleQ (exp/makeSemanticQuery "cycles" (list "a") (list) (none) (none) (sql/asc) (none) (none))) (cycleRes (exp/expandQuery cycleSchema cycleQ))] (assert (err? cycleRes) "cycle in derived fields returns error") (assert (stringContains? (mt cycleRes ((err e) e) ((ok _) "")) "Cycle") "error message indicates cycle") true))

fn testSemanticLowering -> Bool
  (let [(schema (buildSampleSchema)) (q (exp/makeSemanticQuery "orders" (list "id" "user.email" "total") (list "totalRevenue") (some (sql/colExpr "isPaid")) (some "id") (sql/asc) (some 5) (some 0)))] (mt (exp/expandQuery schema q) ((err e) (assert false (str "query expansion failed: " e))) ((ok expanded) (mt (low/lowerQuery schema expanded) ((err e2) (assert false (str "lowering failed: " e2))) ((ok sel) (let [(rendered (sql/renderSelect sel (sql/postgres))) (sqlStr rendered.sql)] (assert (stringContains? sqlStr "SELECT ") "generates SELECT") (assert (stringContains? sqlStr "LEFT JOIN users ON") "generates LEFT JOIN for user relation") (assert (stringContains? sqlStr "GROUP BY ") "generates GROUP BY for measure query") (assert (stringContains? sqlStr "LIMIT 5") "preserves root LIMIT") (assert (= rendered.paramCount 1) "binds isPaid parameter") true))))))

fn testDualPolarityRefutations -> Bool
  (let [(schema (buildSampleSchema))] (let [(badQ (exp/makeSemanticQuery "nonexistent_table" (list "id") (list) (none) (none) (sql/asc) (none) (none))) (badRes (exp/expandQuery schema badQ))] (refute (ok? badRes) "nonexistent entity query must not succeed") (assert (err? badRes) "nonexistent entity query returns error")) (let [(badColQ (exp/makeSemanticQuery "orders" (list "ghost_column") (list) (none) (none) (sql/asc) (none) (none))) (badColRes (exp/expandQuery schema badColQ))] (refute (ok? badColRes) "unknown column must not succeed") (assert (err? badColRes) "unknown column returns error")) (let [(injStr "'; DROP TABLE orders; --") (paramExpr (sql/strExpr injStr)) (binExpr (sql/binary (sql/eq) (sql/colExpr "status") paramExpr)) (pCount (sql/countParams binExpr)) (params (sql/collectParams binExpr)) (rendered (sql/renderExprStr binExpr (sql/postgres) 1))] (refute (stringContains? rendered "DROP TABLE") "malicious payload must not be inlined into SQL text") (refute (stringContains? rendered injStr) "raw input string must not appear in SQL text") (assert (= rendered "status = $1") "malicious input is strictly isolated into $1") (assert (= pCount 1) "parameter count is exactly 1") (assert (= (listLength params) 1) "parameter list length is 1")) (let [(renderedSq (sql/renderExprStr (sql/strExpr "sample") (sql/sqlite) 1))] (refute (stringContains? renderedSq "$1") "sqlite dialect refutes postgres $1 placeholder") (assert (= renderedSq "?") "sqlite dialect renders ?")) (let [(ordersOpt (sem/findEntity schema "orders"))] (refute (none? ordersOpt) "orders entity must not be none") (mt ordersOpt ((none) (assert false "ordersOpt missing")) ((some orders) (refute (some? (sem/findField orders "nonexistent")) "nonexistent field refutes some") (refute (some? (sem/findDerived orders "nonexistent")) "nonexistent derived refutes some") (refute (some? (sem/findMeasure orders "nonexistent")) "nonexistent measure refutes some") (refute (some? (sem/findRelation orders "nonexistent")) "nonexistent relation refutes some")))) (let [(cycleD (list (sem/makeDerivedField "x" (sql/colExpr "y")) (sem/makeDerivedField "y" (sql/colExpr "x")))) (cm (sem/makeEntityModel "c2" "id" "c2" (list) cycleD (list) (list))) (cs (sem/makeSemanticSchema (list cm))) (cq (exp/makeSemanticQuery "c2" (list "x") (list) (none) (none) (sql/asc) (none) (none))) (cr (exp/expandQuery cs cq))] (refute (ok? cr) "2-step cycle must not succeed") (assert (err? cr) "2-step cycle returns err")) (let [(selfD (list (sem/makeDerivedField "loop" (sql/colExpr "loop")))) (sm (sem/makeEntityModel "cSelf" "id" "cSelf" (list) selfD (list) (list))) (ss (sem/makeSemanticSchema (list sm))) (sq (exp/makeSemanticQuery "cSelf" (list "loop") (list) (none) (none) (sql/asc) (none) (none))) (sr (exp/expandQuery ss sq))] (refute (ok? sr) "self-referential loop must not succeed") (assert (err? sr) "self-referential loop returns err")) (let [(q (exp/makeSemanticQuery "orders" (list "id") (list) (none) (none) (sql/asc) (none) (none)))] (mt (exp/expandQuery schema q) ((err _) (assert false "simple query expansion failed")) ((ok exp) (mt (low/lowerQuery schema exp) ((err _) (assert false "simple query lowering failed")) ((ok sel) (let [(rendered (sql/renderSelect sel (sql/postgres)))] (refute (stringContains? rendered.sql "GROUP BY") "row-only query refutes GROUP BY") (refute (stringContains? rendered.sql "HAVING") "row-only query refutes HAVING") (refute (stringContains? rendered.sql "LEFT JOIN") "joinless query refutes LEFT JOIN"))))))) true)

fn runTests -> Bool
  (do (assert (testSqlExprExtensions) "testSqlExprExtensions must pass") (assert (testSemanticSchemaDefinition) "testSemanticSchemaDefinition must pass") (assert (testSemanticExpansionAndCycles) "testSemanticExpansionAndCycles must pass") (assert (testSemanticLowering) "testSemanticLowering must pass") (assert (testDualPolarityRefutations) "testDualPolarityRefutations must pass") true)

fn RunTests -> Bool
  (runTests)
