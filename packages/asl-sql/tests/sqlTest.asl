(module asl-sql/test :x [testSqlSelect testSqlJoinParams testSqlDialects testSqlDdl runTests] :i [(core :a sql) (ddl :a ddl)])

fn testSqlSelect -> Bool
  (let [(sel (sql/makeSelect (list "id" "name") "users" (none))) (rendered (sql/renderSelect sel (sql/sqlite))) (whereCond (sql/binary (sql/eq) (sql/colExpr "id") (sql/intExpr 42))) (selWhere (sql/makeSelect (list "id" "name") "users" (some whereCond))) (renderedWhere (sql/renderSelect selWhere (sql/postgres))) (jCond (sql/binary (sql/eq) (sql/colExpr "users.id") (sql/colExpr "orders.user_id"))) (j (sql/makeJoin (sql/innerJoin) "orders" jCond)) (selFull (sql/SelectQuery :columns (list "id") :fromTable "users" :joins (list j) :whereClause (none) :groupBy (list) :havingClause (none) :orderColumn (some "id") :orderDir (sql/desc) :limitCount (some 10) :offsetCount (some 5) :forUpdateSkipLocked true :returningColumns (list "id"))) (renderedFull (sql/renderSelect selFull (sql/postgres))) (fullSql renderedFull.sql)] (do (assert (> (stringLength rendered.sql) 0) "rendered select length > 0") (assert (= (listLength rendered.params) 0) "rendered params count is 0") (assert (= (listLength renderedWhere.params) 1) "rendered where params count is 1") (assert (stringContains? fullSql "INNER JOIN orders ON") "full sql contains INNER JOIN") (refute (stringContains? fullSql "DELETE FROM") "full sql must not contain DELETE") true))

fn testSqlJoinParams -> Bool
  (let [(jCond1 (sql/binary (sql/eq) (sql/colExpr "orders.status") (sql/strExpr "completed"))) (j1 (sql/makeJoin (sql/innerJoin) "orders" jCond1)) (jCond2 (sql/binary (sql/gt) (sql/colExpr "items.price") (sql/intExpr 100))) (j2 (sql/makeJoin (sql/leftJoin) "items" jCond2)) (whereCond (sql/binary (sql/eq) (sql/colExpr "users.active") (sql/boolExpr true))) (q (sql/SelectQuery :columns (list "users.id" "orders.total") :fromTable "users" :joins (list j1 j2) :whereClause (some whereCond) :groupBy (list) :havingClause (none) :orderColumn (none) :orderDir (sql/asc) :limitCount (none) :offsetCount (none) :forUpdateSkipLocked false :returningColumns (list))) (resPg (sql/renderSelect q (sql/postgres))) (resSq (sql/renderSelect q (sql/sqlite))) (sqlPg resPg.sql) (sqlSq resSq.sql)] (do (assert (= resPg.paramCount 3) "param count must be 3") (assert (= (listLength resPg.params) 3) "params list length must be 3") (assert (stringContains? sqlPg "INNER JOIN orders ON orders.status = $1") "pg inner join") (assert (stringContains? sqlSq "INNER JOIN orders ON orders.status = ?") "sqlite inner join") (refute (stringContains? sqlPg "DROP") "must not contain drop") true))

fn testSqlDialects -> Bool
  (let [(qPg (sql/dialectQuoteChar (sql/postgres))) (qMy (sql/dialectQuoteChar (sql/mysql))) (qSq (sql/dialectQuoteChar (sql/sqlite)))] (do (assert (= qPg "\"") "pg quote char is double quote") (assert (= qMy "`") "mysql quote char is backtick") (assert (= qSq "\"") "sqlite quote char is double quote") (refute (= qPg "`") "pg quote char is not backtick") true))

fn testSqlDdl -> Bool
  (let [(colId (ddl/makeColumn "id" (ddl/colInt64) true false)) (colName (ddl/makeColumn "username" (ddl/colText) false false)) (tbl (ddl/makeTable "accounts" (list colId colName))) (createSql (ddl/renderCreateTable tbl (sql/sqlite))) (ins (ddl/makeInsert "accounts" (list "id" "username") (list "1" "'eddie'"))) (insSqlSqlite (ddl/renderInsert ins (sql/sqlite))) (insSqlPg (ddl/renderInsert ins (sql/postgres))) (ups (ddl/makeUpsert "accounts" (list "id" "username") (list "1" "'eddie'") (list "id") (list "username"))) (upsSqlPg (ddl/renderUpsert ups (sql/postgres))) (upsSqlSq (ddl/renderUpsert ups (sql/sqlite)))] (do (assert (> (stringLength createSql) 0) "create table sql length > 0") (assert (stringContains? insSqlSqlite "VALUES (?, ?);") "sqlite insert values") (assert (stringContains? insSqlPg "VALUES ($1, $2);") "pg insert values") (refute (stringContains? createSql "DROP TABLE") "create table must not contain drop") true))

fn runTests -> Bool
  (do (assert (testSqlSelect)) (assert (testSqlJoinParams)) (assert (testSqlDialects)) (assert (testSqlDdl)) true)
