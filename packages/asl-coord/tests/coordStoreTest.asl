(module asl-coord/tests/coordStoreTest
  :x [runTests]
  :i [(asl-store/types :a ty) (asl-store-fs/fs :a fs) (asl-coord/lease :a ls) (asl-coord/core :a co) (asl-coord/needs :a nd) (asl-coord/presence :a pr)])

; (:m :ref VS-COORD :do "every store lives in a scratch dir under the worktree's .asl/cache, never in ~/.asl; time is the now argument of each Ctx, so no assertion waits or reads a clock")
fn ! scratch -> String
  (str (resultOr (realPath ".") ".") "/.asl/cache/coordStoreTest-" (stringFromInt64 (procSelf)))

fn ! rmTree! p: String -> Unit
  (match (fileStat p)
    ((err _) ())
    ((ok st) (let [(_ (if st.isDir (map (fn [(n String)] -> Unit (rmTree! (str p "/" n))) (resultOr (dirList p) (list))) (list)))
                   (_ (pathRemove p))]
               ())))

; (:m :ref VS-COORD :do "a context whose first CAS of one unit's claims row is preceded by a rival action, so the rival commits after this claim scanned and before it writes, and only the gate CAS can notice the lost race; the rollback CAS of the same row passes through")
fn ! hookCtx! st: fs/FsStore scope: String unit: String rival: (fn [] -> Unit) -> co/Ctx
  (let [(hook (ty/Key :collection "hook" :id (str scope "-" unit)))]
    (co/Ctx :call (fn [(op ty/Op)] -> ty/Reply
                    (match op
                      ((ty/opCas k _ _ _ _)
                        (if (and (= k.collection "claims") (= k.id (str scope "/" unit)))
                          (match (fs/fsCall! st (ty/opGet hook (t0)))
                            ((ty/rAbsent) (do (fs/fsCall! st (ty/opPut hook "1" 0 (t0))) (rival) (fs/fsCall! st op)))
                            (_ (fs/fsCall! st op)))
                          (fs/fsCall! st op)))
                      (_ (fs/fsCall! st op))))
            :scope scope :now (t0)
            :gone (fn [(l ls/Lease)] -> Bool false) :alive (fn [(l ls/Lease)] -> Bool false) :legacy (list) :retireLegacy (fn [(u String)] -> Unit ())))

fn t0 -> Int64
  1800000000000

fn ! mk! st: fs/FsStore scope: String now: Int64 -> co/Ctx
  (co/Ctx :call (fn [(op ty/Op)] -> ty/Reply (fs/fsCall! st op)) :scope scope :now now
          :gone (fn [(l ls/Lease)] -> Bool false) :alive (fn [(l ls/Lease)] -> Bool false) :legacy (list) :retireLegacy (fn [(u String)] -> Unit ()))

fn leaseAt unit: String owns: (List String) agent: String at: Int64 -> ls/Lease
  (with (lease unit owns agent) :at at)

fn lease unit: String owns: (List String) agent: String -> ls/Lease
  (ls/Lease :unit unit :owns owns :branch (str "sh/" unit) :worktree (str "/w/" unit) :agent agent :host "h" :pid 0 :at 0 :ttl 7200)

fn errI r: (Result Int64 String) -> String
  (match r ((ok n) (str "OK " (stringFromInt64 n))) ((err e) e))

fn okText r: (Result String String) -> String
  (match r ((ok s) s) ((err e) (str "ERR " e)))

fn errText r: (Result String String) -> String
  (match r ((ok s) (str "OK " s)) ((err e) e))

fn ! rowsIn! ctx: co/Ctx -> Int64
  (match (co/claimsOf ctx) ((ok h) (listLength h)) ((err _) -1))

; (:m :ref VS-COORD :do "the plan's gate: two agents of different projects claim overlapping owns in one repository scope and the second is refused with the holder; a stale-epoch heartbeat is refused; a lease expires exactly when now > at + ttl; a need posted from scope automate is listed from scope asex")
fn ! runTests -> Bool
  (let [(dir (scratch))
        (_ (rmTree! dir))
        (opened (fs/fsOpen! dir 1000))]
    (match opened
      ((err e) (do (assert false (str "open " e)) false))
      ((ok st)
        (let [(a (mk! st "asex" (t0)))
              (firstClaim (co/claimLease a (lease "VS-A" (list "asl/packages/asl-coord") "agentA")))
              (second (co/claimLease a (lease "VS-B" (list "asl/packages/asl-coord/src/core.asl") "agentB")))
              (otherScope (co/claimLease (mk! st "automate" (t0)) (lease "VS-B" (list "asl/packages/asl-coord") "agentB")))
              (independent (co/claimLease a (lease "VS-C" (list "asl/packages/asl-vault") "agentC")))
              (held (match (co/claimsOf a) ((ok h) h) ((err _) (list))))
              (epochA (match (listHead held) ((some h) h.epoch) ((none) 0)))
              (revA (match (listHead held) ((some h) h.rev) ((none) 0)))
              (hbOk (co/heartbeatLease a "VS-A" epochA revA))
              (hbStale (co/heartbeatLease a "VS-A" epochA revA))
              (hbMissing (co/heartbeatLease a "VS-Z" 1 1))
              (reclaimSame (co/claimLease a (lease "VS-A" (list "asl/packages/asl-coord") "agentA")))
              (reclaimOther (co/claimLease a (lease "VS-A" (list "asl/packages/asl-coord") "agentOther")))
              (releaseWrong (co/releaseLease a "VS-A" "VS-B" (lease "VS-A" (list) "agentA")))
              (releaseOwn (co/releaseLease a "VS-A" "VS-A" (lease "VS-A" (list) "agentA")))
              (afterRelease (co/claimLease a (lease "VS-B" (list "asl/packages/asl-coord/src/core.asl") "agentB")))
              (allowedOwn (co/pathAllowedIn a "VS-B" "asl/packages/asl-coord/src/core.asl"))
              (allowedOutside (co/pathAllowedIn a "VS-B" "asl/packages/asl-vault/x.asl"))
              (allowedFree (co/pathAllowedIn a "VS-D" "asl/packages/asl-text/x.asl"))
              (edge (mk! st "ttl" (t0)))
              (ttlClaim (co/claimLease edge (lease "T1" (list "p") "agentT")))
              (atBoundary (co/claimLease (mk! st "ttl" (+ (t0) 7200000)) (lease "T2" (list "p") "agentU")))
              (pastBoundary (co/claimLease (mk! st "ttl" (+ (t0) 7200001)) (lease "T2" (list "p") "agentU")))
              (liveHolder (co/Ctx :call (fn [(op ty/Op)] -> ty/Reply (fs/fsCall! st op)) :scope "alive" :now (t0)
                                  :gone (fn [(l ls/Lease)] -> Bool false) :alive (fn [(l ls/Lease)] -> Bool true) :legacy (list) :retireLegacy (fn [(u String)] -> Unit ())))
              (aliveClaim (co/claimLease liveHolder (lease "L1" (list "q") "agentL")))
              (aliveLate (co/claimLease (with liveHolder :now (+ (t0) 99999999)) (lease "L2" (list "q") "agentM")))
              (goneCtx (co/Ctx :call (fn [(op ty/Op)] -> ty/Reply (fs/fsCall! st op)) :scope "gone" :now (t0)
                               :gone (fn [(l ls/Lease)] -> Bool (= l.unit "G1")) :alive (fn [(l ls/Lease)] -> Bool false) :legacy (list) :retireLegacy (fn [(u String)] -> Unit ())))
              (goneClaim (co/claimLease goneCtx (lease "G1" (list "r") "agentG")))
              (goneTake (co/claimLease goneCtx (lease "G2" (list "r") "agentH")))
              (nA (mk! st "automate" (t0)))
              (nB (mk! st "asex" (+ (t0) 5)))
              (posted (nd/needPost nA "automate" "agentN" "asl-text" "stringPad" "asl '(:x)'" "p2"))
              (needId (match posted ((ok id) id) ((err _) "")))
              (listedOpen (nd/needList nB "open" "asl-text"))
              (listedOther (nd/needList nB "open" "asl-know"))
              (takeFirst (nd/needTake nB needId "VS-TAKE"))
              (takeSecond (nd/needTake nB needId "VS-OTHER"))
              (closeWrong (nd/needClose nB needId "VS-OTHER" "done"))
              (closeRight (nd/needClose nB needId "VS-TAKE" "done"))
              (listedDone (nd/needList nB "done" ""))
              (posted2 (nd/needPost nB "asex" "agentN" "asl-text" "other" "" "p3"))
              (beat (pr/beat nA "agentP" "automate" "U1" 60000))
              (presNow (pr/agentsList (mk! st "asex" (+ (t0) 59999))))
              (presLate (pr/agentsList (mk! st "asex" (+ (t0) 60000))))
              (legacyCtx (mk! st "legacy" (+ (t0) 10)))
              (raw "(:lease :unit \"OLD\" :owns (\"x/y\") :branch \"sh/OLD\" :worktree \"/w/OLD\" :agent \"ag\" :host \"h\" :pid 0 :at 1790000000000000000 :ttl 7200)")
              (imp1 (co/importLegacy legacyCtx (list (pair raw 1799999999000))))
              (imp2 (co/importLegacy legacyCtx (list (pair raw 1799999999000))))
              (legacyHeld (match (co/claimsOf legacyCtx) ((ok h) h) ((err _) (list))))
              (legacyAt (match (listHead legacyHeld) ((some h) h.lease.at) ((none) 0)))
              (raceCtx (hookCtx! st "race" "LATE" (fn [] -> Unit (let [(_ (co/claimLease (mk! st "race" (t0)) (lease "RIVAL" (list "z") "agentRival")))] ()))))
              (raced (co/claimLease raceCtx (lease "LATE" (list "z/w") "agentLate")))
              (u1 (co/claimLease (mk! st "d2" (t0)) (lease "U" (list "a") "agentU")))
              (d2Ctx (hookCtx! st "d2" "U" (fn [] -> Unit (let [(_ (co/claimLease (mk! st "d2" (t0)) (lease "V" (list "b") "agentV")))] ()))))
              (u2 (co/claimLease d2Ctx (lease "U" (list "a" "b") "agentU")))
              (d2Held (match (co/claimsOf (mk! st "d2" (t0))) ((ok h) h) ((err _) (list))))
              (uOwns (match (listFind (fn [(h co/Held)] -> Bool (= h.lease.unit "U")) d2Held) ((some h) h.lease.owns) ((none) (list "missing"))))
              (hasV (some? (listFind (fn [(h co/Held)] -> Bool (= h.lease.unit "V")) d2Held)))
              (n1 (with (mk! st "n1" (t0)) :legacy (list (leaseAt "LU" (list "lu") "agentX" (t0)))))
              (n1y (co/claimLease n1 (lease "LU" (list "lu") "agentY")))
              (n1o (co/claimLease n1 (lease "OTH" (list "lu/x") "agentO")))
              (n1rows (rowsIn! n1))
              (n1x (co/claimLease n1 (lease "LU" (list "lu") "agentX")))
              (n2v (co/claimLease (mk! st "n2" (t0)) (lease "U1" (list "a") "agentZ")))
              (n2 (with (mk! st "n2" (+ (t0) 1000)) :legacy (list (leaseAt "U1" (list "a" "b") "agentZ" (+ (t0) 500)))))
              (n2b (co/claimLease n2 (lease "B" (list "b") "agentB")))
              (n2old (with (mk! st "n2" (+ (t0) 1000)) :legacy (list (leaseAt "U1" (list "a" "b") "agentZ" (- (t0) 5)))))
              (n2c (co/claimLease n2old (lease "C" (list "b") "agentC")))
              (errCtx (co/Ctx :call (fn [(op ty/Op)] -> ty/Reply (match op ((ty/opCas k _ _ _ _) (if (= k.collection "claimGates") (ty/rErr "io" "boom") (fs/fsCall! st op))) (_ (fs/fsCall! st op)))) :scope "n4" :now (t0) :gone (fn [(l ls/Lease)] -> Bool false) :alive (fn [(l ls/Lease)] -> Bool false) :legacy (list) :retireLegacy (fn [(u String)] -> Unit ())))
              (n4 (co/claimLease errCtx (lease "E4" (list "e4") "agentE")))
              (n4rows (rowsIn! (mk! st "n4" (t0))))
              (ep (mk! st "ep" (t0)))
              (e1c (co/claimLease ep (lease "E" (list "e") "agentE")))
              (e1h (match (co/claimsOf ep) ((ok h) (listHead h)) ((err _) (none))))
              (e1 (match e1h ((some h) h.epoch) ((none) -1)))
              (r1 (match e1h ((some h) h.rev) ((none) -1)))
              (erel (co/releaseLease ep "E" "E" (lease "E" (list) "agentE")))
              (e2c (co/claimLease ep (lease "E" (list "e") "agentE")))
              (e2h (match (co/claimsOf ep) ((ok h) (listHead h)) ((err _) (none))))
              (e2 (match e2h ((some h) h.epoch) ((none) -1)))
              (r2 (match e2h ((some h) h.rev) ((none) -1)))
              (hbOld (co/heartbeatLease ep "E" e1 r2))
              (hbNew (co/heartbeatLease ep "E" e2 r2))
              (racedCount (rowsIn! (mk! st "race" (t0))))]
          (do
            (assert (ok? firstClaim) "the first claim in scope asex succeeds")
            (assert (and (not (ok? second)) (stringContains? (errText second) ":unit \"VS-B\" :by \"VS-A\" :path \"asl/packages/asl-coord/src/core.asl\"")) (str "an agent of another project claiming a path below a live claim is refused with the holder: " (errText second)))
            (assert (ok? otherScope) "the same owns in another repository scope do not clash")
            (assert (ok? independent) "a disjoint path in the same scope is claimed")
            (assert (> epochA 0) "a lease carries an epoch from the scope gate")
            (assert (ok? hbOk) "a heartbeat at the granted epoch is accepted")
            (assert (and (not (ok? hbStale)) (stringContains? (errI hbStale) ":stale true")) (str "a heartbeat at the old epoch is refused as stale: " (errI hbStale)))
            (assert (stringContains? (errI hbMissing) ":absent true") "a heartbeat for a unit with no lease is refused")
            (assert (ok? reclaimSame) "the owner re-claiming its unit refreshes it")
            (assert (not (ok? reclaimOther)) "another agent cannot take over a live unit")
            (assert (not (ok? releaseWrong)) "a different unit cannot release a live lease")
            (assert (ok? releaseOwn) "the holder releases its lease")
            (assert (ok? afterRelease) "the refused path is free after the release")
            (assert (ok? allowedOwn) "the holder edits inside its owns")
            (assert (stringContains? (errText allowedOutside) ":refused") "the holder is refused outside its owns")
            (assert (ok? allowedFree) "an unclaimed path is allowed to an unleased unit")
            (assert (ok? ttlClaim) "a lease is granted")
            (assert (not (ok? atBoundary)) "a lease is still live at now = at + ttl")
            (assert (ok? pastBoundary) "a lease expires when now > at + ttl")
            (assert (ok? aliveClaim) "a lease with a live declared holder is granted")
            (assert (not (ok? aliveLate)) "a lease past its TTL stays while its declared holder is alive")
            (assert (ok? goneClaim) "the lease of a unit about to be judged gone is granted")
            (assert (ok? goneTake) "a lease whose worktree or branch is gone is retired and its paths claimed")
            (assert (ok? posted) (str "a need is posted from scope automate: " (errText posted)))
            (assert (match listedOpen ((ok rows) (and (= (listLength rows) 1) (stringContains? (optionOr (listHead rows) "") ":project \"automate\""))) ((err _) false)) "the need posted from scope automate is listed from scope asex with its project")
            (assert (match listedOther ((ok rows) (listEmpty? rows)) ((err _) false)) "listing filters by package")
            (assert (ok? takeFirst) "a unit takes an open need")
            (assert (not (ok? takeSecond)) "a second unit cannot take a taken need")
            (assert (not (ok? closeWrong)) "only the taking unit closes a need")
            (assert (ok? closeRight) "the taking unit closes the need")
            (assert (match listedDone ((ok rows) (= (listLength rows) 1)) ((err _) false)) "a closed need lists as done")
            (assert (and (ok? posted2) (!= (okText posted2) needId)) "two needs get different ids")
            (assert (ok? beat) "presence is written")
            (assert (match presNow ((ok rows) (= (listLength rows) 1)) ((err _) false)) "presence is listed before its TTL")
            (assert (match presLate ((ok rows) (listEmpty? rows)) ((err _) false)) "presence expires at now >= at + ttl without a sweeper")
            (assert (match imp1 ((ok n) (= n 1)) ((err _) false)) "legacy lease files are imported as rows")
            (assert (match imp2 ((ok n) (= n 0)) ((err _) false)) "a second import does nothing")
            (assert (and (= (listLength legacyHeld) 1) (= legacyAt 1799999999000)) "an imported lease takes the file mtime as its heartbeat")
            (assert (not (ok? raced)) (str "a claim that loses the gate race removes its row, rescans and is refused: " (errText raced)))
            (assert (stringContains? (errText raced) ":by \"RIVAL\"") "the loser's refusal names the winner")
            (assert (= racedCount 1) "the loser's row is gone")
            (assert (and (not (ok? u2)) (stringContains? (errText u2) ":by \"V\"")) (str "an enlarging re-claim that loses the gate race is refused by the winner: " (errText u2)))
            (assert (and (ok? u1) (= uOwns (list "a")) hasV) (str "the lost re-claim leaves the unit's row as it was read and the winner kept: " (stringJoin uOwns ",")))
            (assert (and (ok? e1c) (ok? erel) (ok? e2c) (!= e1 e2) (= r1 r2)) (str "release and claim again repeats the row revision but not the epoch: " (stringFromInt64 e1) " " (stringFromInt64 e2) " rev " (stringFromInt64 r1) " " (stringFromInt64 r2)))
            (assert (and (not (ok? hbOld)) (ok? hbNew)) "a heartbeat of the old epoch is refused at an equal revision and the current epoch is accepted")
            (assert (and (not (ok? n1y)) (stringContains? (errText n1y) ":unit \"LU\"")) (str "a legacy lease of one owner cannot be claimed by another: " (errText n1y)))
            (assert (and (stringContains? (errText n1o) ":by \"LU\"") (= n1rows 0)) "the legacy owner's paths stay protected and the refused claim wrote no row")
            (assert (ok? n1x) "the legacy owner itself can claim its unit")
            (assert (and (ok? n2v) (not (ok? n2b)) (stringContains? (errText n2b) ":by \"U1\"")) (str "a legacy rewrite with newer owns and a later heartbeat wins over the vault row: " (errText n2b)))
            (assert (ok? n2c) "an older legacy file loses to the vault row")
            (assert (and (not (ok? n4)) (= n4rows 0)) (str "a gate CAS that errs removes the row this claim wrote: " (errText n4) " rows " (stringFromInt64 n4rows)))
            (let [(_ (rmTree! dir))] (assert (not (fileExists? dir)) "the scratch store is removed"))
            true)))))
