(:package asl-coord
 :version "0.2.0"
 :entry "src/claims.asl"
 :description "Shared scope claim leases, needs and presence as rows of the machine's asl-store vault: pure rules over a Ctx of plain functions, asl-coord/locate the only host module"
 :aslFirst true
 :modules ["asl-coord/paths" "asl-coord/lease" "asl-coord/core" "asl-coord/needs" "asl-coord/presence" "asl-coord/locate" "asl-coord/claims"]
 :dependencies ["asl-store" "asl-store-fs"])
