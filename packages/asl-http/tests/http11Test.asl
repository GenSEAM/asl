(module asl/packages/asl-http/tests/http11Test :x [RunTests runTests] :i [(asl-http/http11 :a http) (asl-net/socket :a net)])

fn testHttpGrammarAndTypes -> Bool
  (let [(headers (http/makeHeaders (list (pair "Host" "agentslang.org") (pair "Content-Type" "application/json") (pair "X-Custom-Header" "ASL-Web/0.1.0")))) (req (http/makeRequest "GET" "/api/status" headers "" "HTTP/1.1")) (res (http/makeResponse 200 "OK" (http/makeHeaders (list (pair "Content-Length" "15"))) "{\"ok\": true}"))] (assert (= req.method "GET") "Request method must match constructor") (assert (= req.path "/api/status") "Request path must match constructor") (assert (= req.version "HTTP/1.1") "HTTP protocol version must be HTTP/1.1") (assert (= (optionOr (http/getHeader req "Host") "") "agentslang.org") "Header lookup by exact key must succeed") (assert (= (optionOr (http/getHeader req "host") "") "agentslang.org") "Header lookup must be case-insensitive (lowercase host)") (assert (= (optionOr (http/getHeader req "CONTENT-TYPE") "") "application/json") "Header lookup must be case-insensitive (uppercase CONTENT-TYPE)") (assert (= res.statusCode 200) "Response status code must be 200") (assert (= res.reasonPhrase "OK") "Response reason phrase must be OK") (assert (= res.body "{\"ok\": true}") "Response body must match payload") (refute (not (= req.method "GET")) "Refutation: Request method cannot drift") (refute (= (optionOr (http/getHeader req "host") "") "") "Refutation: Case-insensitive header lookup cannot fail") (refute (not (= res.statusCode 200)) "Refutation: Status code cannot mutate") (refute (= res.body "") "Refutation: Response body cannot be empty") true)

fn testHttp11RequestParsing -> Bool
  (let [(rawGet "GET /index.html HTTP/1.1\r\nHost: example.com\r\nUser-Agent: AgentSlang/0.1.0\r\n\r\n") (parseGetRes (http/parseHttpRequest rawGet)) (rawPost "POST /api/v1/submit HTTP/1.1\r\nHost: api.asl\r\nContent-Length: 18\r\nContent-Type: application/json\r\n\r\n{\"status\": \"ready\"}") (parsePostRes (http/parseHttpRequest rawPost)) (rawQuery "GET /search?q=asl&limit=10 HTTP/1.1\r\nHost: search.asl\r\n\r\n") (parseQueryRes (http/parseHttpRequest rawQuery))] (assert (ok? parseGetRes) "GET request must parse successfully") (let [(reqGet (resultOr parseGetRes (http/makeRequest "<parse-failed>" "<parse-failed>" (http/makeHeaders (list)) "<parse-failed>" "<parse-failed>")))] (assert (= reqGet.method "GET") "Parsed GET method matches") (assert (= reqGet.path "/index.html") "Parsed GET path matches") (assert (= (optionOr (http/getHeader reqGet "Host") "") "example.com") "Parsed GET Host header matches") (assert (= reqGet.body "") "GET request body must be empty")) (assert (ok? parsePostRes) "POST request must parse successfully") (let [(reqPost (resultOr parsePostRes (http/makeRequest "<parse-failed>" "<parse-failed>" (http/makeHeaders (list)) "<parse-failed>" "<parse-failed>")))] (assert (= reqPost.method "POST") "Parsed POST method matches") (assert (= reqPost.path "/api/v1/submit") "Parsed POST path matches") (assert (= (optionOr (http/getHeader reqPost "Content-Type") "") "application/json") "Parsed POST Content-Type matches") (assert (= reqPost.body "{\"status\": \"ready\"}") "Parsed POST body matches payload")) (assert (ok? parseQueryRes) "Query parameter request must parse successfully") (let [(reqQuery (resultOr parseQueryRes (http/makeRequest "<parse-failed>" "<parse-failed>" (http/makeHeaders (list)) "<parse-failed>" "<parse-failed>")))] (assert (= reqQuery.path "/search") "Parsed path strips query string") (assert (= (optionOr (http/getQueryParam reqQuery "q") "") "asl") "Query param q matches") (assert (= (optionOr (http/getQueryParam reqQuery "limit") "") "10") "Query param limit matches")) (refute (err? parseGetRes) "Refutation: Valid GET request cannot produce parse error") (refute (err? parsePostRes) "Refutation: Valid POST request cannot produce parse error") (refute (not (= (resultOr parsePostRes (http/makeRequest "<parse-failed>" "<parse-failed>" (http/makeHeaders (list)) "<parse-failed>" "<parse-failed>")).body "{\"status\": \"ready\"}")) "Refutation: POST body cannot diverge") (refute (= (optionOr (http/getQueryParam (resultOr parseQueryRes (http/makeRequest "<parse-failed>" "<parse-failed>" (http/makeHeaders (list)) "<parse-failed>" "<parse-failed>")) "q") "") "") "Refutation: Query parameter cannot be dropped") true)

fn testChunkedTransferEncodingParsing -> Bool
  (let [(rawChunked "POST /upload HTTP/1.1\r\nHost: upload.asl\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n") (parseRes (http/parseHttpRequest rawChunked)) (badChunked "POST /upload HTTP/1.1\r\nHost: upload.asl\r\nTransfer-Encoding: chunked\r\n\r\nZZZ\r\nhello\r\n0\r\n\r\n") (badParseRes (http/parseHttpRequest badChunked))] (assert (ok? parseRes) "Valid chunked request must parse successfully") (let [(req (resultOr parseRes (http/makeRequest "<parse-failed>" "<parse-failed>" (http/makeHeaders (list)) "<parse-failed>" "<parse-failed>")))] (assert (= req.body "hello world") "Chunked bodies must concatenate into single payload") (assert (= req.method "POST") "Chunked request method preserved") (assert (= req.path "/upload") "Chunked request path preserved")) (assert (err? badParseRes) "Invalid chunk size (ZZZ) must produce parse error") (refute (err? parseRes) "Refutation: Valid chunked payload cannot return error") (refute (not (= (resultOr parseRes (http/makeRequest "<parse-failed>" "<parse-failed>" (http/makeHeaders (list)) "<parse-failed>" "<parse-failed>")).body "hello world")) "Refutation: Chunked body cannot drop chunks") (refute (ok? badParseRes) "Refutation: Malformed non-hex chunk length cannot be accepted") true)

fn testMalformedRequestRejections -> Bool
  (let [(resNoProto (http/parseHttpRequest "GET /index.html\r\nHost: bad.com\r\n\r\n")) (resNoTarget (http/parseHttpRequest "GET HTTP/1.1\r\nHost: bad.com\r\n\r\n")) (resBadLen (http/parseHttpRequest "POST /data HTTP/1.1\r\nHost: bad.com\r\nContent-Length: not-a-number\r\n\r\nbody")) (resNoColon (http/parseHttpRequest "GET / HTTP/1.1\r\nHost bad.com\r\n\r\n")) (resEmpty (http/parseHttpRequest ""))] (assert (err? resNoProto) "Missing HTTP version must be rejected") (assert (err? resNoTarget) "Missing request path must be rejected") (assert (err? resBadLen) "Non-numeric Content-Length must be rejected") (assert (err? resNoColon) "Header line without colon must be rejected") (assert (err? resEmpty) "Empty payload must be rejected") (refute (ok? resNoProto) "Refutation: Missing protocol version cannot be accepted") (refute (ok? resNoTarget) "Refutation: Missing target cannot be accepted") (refute (ok? resBadLen) "Refutation: Malformed Content-Length cannot be accepted") (refute (ok? resNoColon) "Refutation: Malformed header cannot be accepted") (refute (ok? resEmpty) "Refutation: Empty request cannot be accepted") true)

fn testHttpResponseFormatting -> Bool
  (let [(res200 (http/makeResponse 200 "OK" (http/makeHeaders (list (pair "Content-Type" "text/plain") (pair "Content-Length" "12"))) "Hello World!")) (wire200 (http/formatHttpResponse res200)) (res404 (http/makeResponse 404 "Not Found" (http/makeHeaders (list (pair "Content-Length" "9"))) "Not Found")) (wire404 (http/formatHttpResponse res404))] (assert (stringStartsWith? wire200 "HTTP/1.1 200 OK\r\n") "Response must begin with status line HTTP/1.1 200 OK") (assert (stringContains? wire200 "Content-Type: text/plain\r\n") "Formatted response includes Content-Type") (assert (stringContains? wire200 "Content-Length: 12\r\n") "Formatted response includes Content-Length") (assert (stringEndsWith? wire200 "\r\n\r\nHello World!") "Formatted response ends with header delimiter and body") (assert (stringStartsWith? wire404 "HTTP/1.1 404 Not Found\r\n") "Response must begin with HTTP/1.1 404 Not Found") (refute (not (stringStartsWith? wire200 "HTTP/1.1 200 OK\r\n")) "Refutation: Status line cannot diverge") (refute (not (stringContains? wire200 "Hello World!")) "Refutation: Wire representation must contain body") (refute (not (stringStartsWith? wire404 "HTTP/1.1 404 Not Found\r\n")) "Refutation: 404 status line cannot diverge") true)

fn ! testNonBlockingSocketPrimitivesAndLoop -> Bool
  (let [(cfg (net/makeSocketConfig "127.0.0.1" 0 true)) (server (net/openServerSocket cfg)) (readRes (net/readSocketBytes 999 1024)) (writeRes (net/writeSocketBytes 999 "HTTP/1.1 200 OK\r\n\r\n")) (bound (mt server ((ok s) s.port) ((err _) 0))) (idleAccept (mt server ((ok s) (err? (net/acceptSocketConnection s.fd))) ((err _) false))) (closed (mt server ((ok s) (resultOr (net/closeSocket s.fd) false)) ((err _) false)))] (assert (= cfg.host "127.0.0.1") "Socket host matches config") (assert (= cfg.port 0) "Socket config asks the kernel for a free port") (assert cfg.nonBlocking "Socket nonBlocking flag must be true") (assert (ok? server) "Server socket initialization must succeed") (assert (> bound 0) "The listener reports the port the kernel bound") (assert idleAccept "A non-blocking listener fails accept with no pending client instead of blocking") (assert closed "The listener descriptor closes") (assert (err? readRes) "Read from unopened socket FD 999 must return an error") (assert (err? writeRes) "Write to unopened socket FD 999 must return an error") (refute (not cfg.nonBlocking) "Refutation: Server socket must be configured as non-blocking") (refute (not (= cfg.port 0)) "Refutation: Config port cannot mutate") (refute (err? server) "Refutation: Valid server config cannot fail initialization") true)

fn ! runTests -> Bool
  (let [(okGrammar (testHttpGrammarAndTypes)) (okParse (testHttp11RequestParsing)) (okChunk (testChunkedTransferEncodingParsing)) (okReject (testMalformedRequestRejections)) (okFormat (testHttpResponseFormatting)) (okSocket (testNonBlockingSocketPrimitivesAndLoop))] (and (and okGrammar okParse) (and okChunk (and okReject (and okFormat okSocket)))))

fn ! RunTests -> Bool
  (runTests)
