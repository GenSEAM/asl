(:doc :symbol "asl/packages/asl-http/src/download.asl#" :text "HTTP downloads through the curl capability fallback until asl-http has a native TLS client; not available for wasm targets. Files are downloaded beside the destination, length-checked and atomically renamed.")
(:doc :symbol "asl/packages/asl-http/src/http11.asl#" :text "Pure AgentSlang Streaming HTTP/1.1 Protocol Engine and Wire Codec")
(:doc :symbol "asl/packages/asl-http/src/http2.asl#" :text "Pure AgentSlang RFC 7540 HTTP/2 Binary Framing Codec and RFC 7541 HPACK Compression Engine")
(:doc :symbol "asl/packages/asl-http/src/wsProtocol.asl#" :text "Pure AgentSlang RFC 6455 WebSocket Protocol Frame Codec, Header Parser, and Control Handlers")
(:doc :symbol "asl/packages/asl-http/src/wsProtocol.asl#WebSocketFrame.fin" :text "True if final fragment (FIN bit = 1)")
(:doc :symbol "asl/packages/asl-http/src/wsProtocol.asl#WebSocketFrame.rsv" :text "Reserved extension bits (RSV1-3, must be 0)")
(:doc :symbol "asl/packages/asl-http/src/wsProtocol.asl#WebSocketFrame.opcode" :text "Frame opcode: 0x1 text, 0x2 binary, 0x8 close, 0x9 ping, 0xA pong")
(:doc :symbol "asl/packages/asl-http/src/wsProtocol.asl#WebSocketFrame.masked" :text "True if payload masked with 4-byte key (client to server)")
(:doc :symbol "asl/packages/asl-http/src/wsProtocol.asl#WebSocketFrame.payloadLength" :text "Payload length in bytes (7-bit, 16-bit, or 64-bit)")
(:doc :symbol "asl/packages/asl-http/src/wsProtocol.asl#WebSocketFrame.maskKey" :text "4-byte XOR masking key")
(:doc :symbol "asl/packages/asl-http/src/wsProtocol.asl#WebSocketFrame.payloadStr" :text "Decoded payload string")
(:doc :symbol "asl/packages/asl-http/tests/downloadTest.asl#" :text "HTTPDL: download status, exact Content-Length, file SHA-256, failure cleanup, and request timeout against an ASL loopback server.")
(:doc :symbol "asl/packages/asl-http/tests/http11Test.asl#" :text "Acceptance gate for Task 53801: Non-Blocking POSIX Socket Primitives & Pure ASL Streaming HTTP/1.1 Engine under ADR D81 and D77")
(:doc :symbol "asl/packages/asl-http/tests/http2Test.asl#" :text "Popperian Falsifiable Unit Test Suite for RFC 7540 Binary HTTP/2 Framing and HPACK Table")
(:doc :symbol "asl/packages/asl-http/tests/wsProtocolTest.asl#" :text "Unit tests for pure ASL RFC 6455 WebSocket frame codec, masking, and control frames in asl-http")
(:doc :symbol "asl/packages/asl-http/src/httpResponse.asl#" :text "HTTP/1.1 response parser for clients: status line, ordered headers with case-insensitive lookup, obs-fold and duplicates, chunked (with trailers) or Content-Length framing, response streams and curl -D header blocks; malformed or truncated input is an ERR_HTTP_ labelled err")
(:doc :symbol "asl/packages/asl-http/src/httpResponse.asl#parseHttpResponse" :text "raw: one HttpResponse from the front of raw; bytes after a framed body are ignored; err text starts with an ERR_HTTP_ label")
(:doc :symbol "asl/packages/asl-http/src/httpResponse.asl#parseHttpResponseNext" :text "raw: one HttpResponse and the bytes after it, for pipelined or redirected responses")
(:doc :symbol "asl/packages/asl-http/src/httpResponse.asl#parseHttpResponses" :text "raw: every response of a stream in order (a 301 then a 200 when a redirect was followed); an err names the response number")
(:doc :symbol "asl/packages/asl-http/src/httpResponse.asl#parseHeaderBlocks" :text "text: curl -D output, one header block per hop; each block's status and headers, body empty, no body read even with a Content-Length")
(:doc :symbol "asl/packages/asl-http/src/httpResponse.asl#headerValues" :text "headers name: every value of the header, case-insensitive on the name, in arrival order")
(:doc :symbol "asl/packages/asl-http/src/httpResponse.asl#decodeChunked" :text "s: a chunked body decoded: data, trailer fields and the bytes after the message; truncated or malformed chunks are errs")
(:doc :symbol "asl/packages/asl-http/src/httpResponse.asl#Chunked" :text "a decoded chunked body: body, trailers (name value pairs) and rest (bytes after the message)")
(:doc :symbol "asl/packages/asl-http/tests/httpResponseTest.asl#" :text "DS-HTTPRESP: response status line, header case, obs-fold, duplicates, Content-Length and chunked framing with trailers, 301 then 200 streams, curl -D blocks, labelled errs and every proper prefix an err, never a trap")
(:doc :symbol "asl/packages/asl-http/tests/httpResponseTest.asl#runTests" :text "runs the DS-HTTPRESP response parser fixtures; true when every assertion holds")
