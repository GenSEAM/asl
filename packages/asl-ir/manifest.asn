(:package asl-ir
 :version "0.1.0"
 :entry "src/main.asl"
 :description "AgentSlang Typed Monomorphic ANF Core Intermediate Representation and AST Patch Engine"
 :aslFirst true
 :modules [
   "asl-ir/main"
   "asl-ir/types"
   "asl-ir/anf"
   "asl-ir/lowering"
   "asl-ir/lower"
   "asl-ir/drops"
   "asl-ir/verify"
   "asl-ir/printer"
   "asl-ir/patch"
   "asl-ir/link"
 ]
 :dependencies ["asl-parser" "asl-checker"])
