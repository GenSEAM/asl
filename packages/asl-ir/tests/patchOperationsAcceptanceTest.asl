(module asl-ir/tests/patchOperationsAcceptanceTest :x [RunTests runTests] :i [(asl-ir/patch :a patch)])

fn isOk? r: (Result T E) -> Bool
  (match r ((ok _) true) ((err _) false))

fn isErr? r: (Result T E) -> Bool
  (match r ((ok _) false) ((err _) true))

fn sampleModuleSource -> Str
  (str "(module math/sample\n" "  :x [calcArea scaleValue])\n\n" "(df calcArea [(w Int64) (h Int64)] -> Int64\n" "  (* w h))\n\n" "(df scaleValue [(x Int64) (factor Int64)] -> Int64\n" "  (+ x factor))")

fn testAstPatchReplaceOperation -> Bool
  (let [(src (sampleModuleSource)) (p (patch/makeReplacePatch "p-replace-01" "math/sample" "math/sample:calcArea" "body" "(* w h)" "(+ w h)")) (res (patch/applyPatch p src))] (assert res.success "Patch with valid subtree replacement must succeed") (assert (stringContains? res.patchedSource "(+ w h)") "Patched source must contain new expression (+ w h)") (assert (not (stringContains? res.patchedSource "(* w h)")) "Patched source must not contain old expression (* w h)") (assert (some? res.inversePatch) "Successful patch must generate inverse rollback patch") (let [(inv (optionOr res.inversePatch p)) (invRes (patch/applyPatch inv res.patchedSource))] (assert invRes.success "Inverse patch application must succeed") (assert (stringContains? invRes.patchedSource "(* w h)") "Inverse patch must restore original expression (* w h)") (refute (stringContains? res.patchedSource "(* w h)") "Refutation: Patched source must not retain original (* w h)") (refute (stringContains? invRes.patchedSource "(+ w h)") "Refutation: Rollback source must not retain mutant (+ w h)") (refute (not res.success) "Refutation: Valid replace patch cannot fail") (refute (not invRes.success) "Refutation: Valid rollback patch cannot fail")) true)

fn testAstPatchSpliceOperation -> Bool
  (let [(src (sampleModuleSource)) (insNodes (list "(let [(pad 1)] pad)")) (op (patch/makePatchOpSplice "math/sample:scaleValue" "body" 0 (list) insNodes)) (p (patch/makeAstPatch "p-splice-01" "math/sample" (none) (none) (list op))) (res (patch/applyPatch p src))] (assert res.success "Valid splice insertion at index 0 must succeed") (assert (stringContains? res.patchedSource "(let [(pad 1)] pad)") "Patched source must contain spliced expression") (let [(badOp (patch/makePatchOpSplice "math/sample:scaleValue" "body" 99 (list) insNodes)) (badPatch (patch/makeAstPatch "p-bad-splice" "math/sample" (none) (none) (list badOp))) (badRes (patch/applyPatch badPatch src))] (assert (not badRes.success) "Out-of-bounds splice index must fail") (assert (= (listLength badRes.diagnostics) 1) "Out-of-bounds splice must emit exactly 1 diagnostic") (let [(diag (optionOr (listGet badRes.diagnostics 0) (patch/makePatchDiag "" "" "" "")))] (assert (= diag.code "ERR_PATCH_INDEX_OUT_OF_BOUNDS") "Diagnostic code must be ERR_PATCH_INDEX_OUT_OF_BOUNDS") (refute badRes.success "Refutation: Out-of-bounds splice must not succeed") (refute (= diag.code "ERR_PATCH_INVALID_SYNTAX") "Refutation: Diagnostic code must not be generic syntax error") (refute (stringContains? badRes.patchedSource "(let [(pad 1)] pad)") "Refutation: Failed splice must leave source untouched"))) true)

fn testAstPatchRenameOperation -> Bool
  (let [(src (sampleModuleSource)) (op (patch/makePatchOpRename "math/sample:calcArea" "w" "width")) (p (patch/makeAstPatch "p-rename-01" "math/sample" (none) (none) (list op))) (res (patch/applyPatch p src))] (assert res.success "Valid identifier rename must succeed") (assert (stringContains? res.patchedSource "(width Int64)") "Parameter w must be renamed to width") (assert (stringContains? res.patchedSource "(* width h)") "Body reference w must be renamed to width") (assert (not (stringContains? res.patchedSource "(w Int64)")) "Old parameter name (w Int64) must not remain") (let [(badOp (patch/makePatchOpRename "math/sample:calcArea" "nonExistentVar" "newVar")) (badPatch (patch/makeAstPatch "p-bad-rename" "math/sample" (none) (none) (list badOp))) (badRes (patch/applyPatch badPatch src))] (assert (not badRes.success) "Renaming non-existent identifier must fail") (refute badRes.success "Refutation: Renaming non-existent variable cannot succeed") (refute (stringContains? badRes.patchedSource "newVar") "Refutation: Target source must not contain newVar on failed rename") (refute (= res.patchedSource src) "Refutation: Successful rename must alter source text")) true)

fn testAstPatchRetypeOperation -> Bool
  (let [(src (sampleModuleSource)) (opRet (patch/makePatchOpRetype "math/sample:calcArea" "retType" "Int64" "Float64")) (pRet (patch/makeAstPatch "p-retype-01" "math/sample" (none) (none) (list opRet))) (resRet (patch/applyPatch pRet src))] (assert resRet.success "Valid return type retype must succeed") (assert (stringContains? resRet.patchedSource "-> Float64") "Patched return type must be Float64") (let [(opParam (patch/makePatchOpRetype "math/sample:calcArea" "param:w" "Int64" "Float64")) (pParam (patch/makeAstPatch "p-retype-02" "math/sample" (none) (none) (list opParam))) (resParam (patch/applyPatch pParam src))] (assert resParam.success "Valid parameter retype must succeed") (assert (stringContains? resParam.patchedSource "(w Float64)") "Patched parameter type must be Float64") (let [(badOp (patch/makePatchOpRetype "math/sample:calcArea" "retType" "String" "Float64")) (badPatch (patch/makeAstPatch "p-bad-retype" "math/sample" (none) (none) (list badOp))) (badRes (patch/applyPatch badPatch src))] (assert (not badRes.success) "Mismatched oldType in retype must fail") (let [(diag (optionOr (listGet badRes.diagnostics 0) (patch/makePatchDiag "" "" "" "")))] (assert (= diag.code "ERR_PATCH_OLD_NODE_MISMATCH") "Mismatched oldType must yield ERR_PATCH_OLD_NODE_MISMATCH") (refute badRes.success "Refutation: Mismatched oldType must not succeed") (refute (stringContains? badRes.patchedSource "Float64") "Refutation: Failed retype must not alter source") (refute (= diag.code "ERR_PATCH_SYMBOL_NOT_FOUND") "Refutation: Error must not be symbol not found")))) true)

fn testAstPatchDiagnosticsAndRejections -> Bool
  (let [(src (sampleModuleSource)) (emptyPatch (patch/makeAstPatch "p-empty" "math/sample" (none) (none) (list))) (resEmpty (patch/applyPatch emptyPatch src))] (assert (not resEmpty.success) "Empty ops patch must be rejected") (let [(dEmpty (optionOr (listGet resEmpty.diagnostics 0) (patch/makePatchDiag "" "" "" "")))] (assert (= dEmpty.code "ERR_PATCH_EMPTY_OPS") "Empty patch must emit ERR_PATCH_EMPTY_OPS")) (let [(symPatch (patch/makeReplacePatch "p-bad-sym" "math/sample" "missingFunction" "body" "a" "b")) (resSym (patch/applyPatch symPatch src))] (assert (not resSym.success) "Non-existent symbol patch must fail") (let [(dSym (optionOr (listGet resSym.diagnostics 0) (patch/makePatchDiag "" "" "" "")))] (assert (= dSym.code "ERR_PATCH_SYMBOL_NOT_FOUND") "Missing symbol must emit ERR_PATCH_SYMBOL_NOT_FOUND"))) (let [(nodePatch (patch/makeReplacePatch "p-mismatch" "math/sample" "calcArea" "body" "(/ w h)" "(+ w h)")) (resNode (patch/applyPatch nodePatch src))] (assert (not resNode.success) "Mismatched oldNode must fail") (let [(dNode (optionOr (listGet resNode.diagnostics 0) (patch/makePatchDiag "" "" "" "")))] (assert (= dNode.code "ERR_PATCH_OLD_NODE_MISMATCH") "Mismatched oldNode must emit ERR_PATCH_OLD_NODE_MISMATCH"))) (let [(syntaxPatch (patch/makeReplacePatch "p-syntax" "math/sample" "calcArea" "body" "(* w h)" "(* w (unclosed")) (resSyntax (patch/applyPatch syntaxPatch src))] (assert (not resSyntax.success) "Replacement with syntax error must fail in-memory roundtrip validation") (let [(dSyntax (optionOr (listGet resSyntax.diagnostics 0) (patch/makePatchDiag "" "" "" "")))] (assert (or (= dSyntax.code "ERR_PATCH_INVALID_SYNTAX") (= dSyntax.code "ERR_PATCH_VALIDATION_FAILED")) "Syntax error must emit invalid syntax or validation failed diagnostic"))) (let [(expectedDigest "0000000000000000") (op (patch/makePatchOpReplace "calcArea" "body" "(* w h)" "(+ w h)")) (ccPatch (patch/makeAstPatch "p-cc" "math/sample" (some expectedDigest) (none) (list op))) (resCc (patch/applyPatch ccPatch src))] (assert (not resCc.success) "Concurrency conflict preRoot mismatch must fail") (let [(dCc (optionOr (listGet resCc.diagnostics 0) (patch/makePatchDiag "" "" "" "")))] (assert (= dCc.code "ERR_CONCURRENCY_CONFLICT") "Digest mismatch must emit ERR_CONCURRENCY_CONFLICT"))) (let [(vRes (patch/verifyPatch (patch/makeReplacePatch "p-vfy" "math/sample" "calcArea" "body" "(* w h)" "(+ w h)") src))] (assert (isOk? vRes) "verifyPatch on valid patch must return ok")) (let [(vBad (patch/verifyPatch (patch/makeReplacePatch "p-vfy-bad" "math/sample" "missing" "body" "a" "b") src))] (assert (isErr? vBad) "verifyPatch on invalid patch must return err")) (refute resEmpty.success "Refutation: Empty ops must not succeed") (refute (patch/applyPatch (patch/makeReplacePatch "p-bad-sym" "math/sample" "missingFunction" "body" "a" "b") src).success "Refutation: Missing symbol must not succeed") (refute (patch/applyPatch (patch/makeReplacePatch "p-mismatch" "math/sample" "calcArea" "body" "(/ w h)" "(+ w h)") src).success "Refutation: Mismatched oldNode must not succeed") (refute (patch/applyPatch (patch/makeReplacePatch "p-syntax" "math/sample" "calcArea" "body" "(* w h)" "(* w (unclosed") src).success "Refutation: Unclosed delimiter replacement must not succeed") (refute (patch/applyPatch (patch/makeAstPatch "p-cc" "math/sample" (some "0000000000000000") (none) (list (patch/makePatchOpReplace "calcArea" "body" "(* w h)" "(+ w h)"))) src).success "Refutation: Concurrency digest conflict must not succeed") (refute (isOk? (patch/verifyPatch (patch/makeReplacePatch "p-vfy-bad" "math/sample" "missing" "body" "a" "b") src)) "Refutation: verifyPatch on bad patch cannot return ok") true)

fn testAstPatchParserAndSerializer -> Bool
  (let [(patchAsn (str "(:astPatch :id \"patch-asn-01\" :targetModule \"math/sample\"\n" "  :ops [\n" "    (:replace :target \"calcArea\" :anchor \"body\" :oldNode \"(* w h)\" :newNode \"(+ w h)\")\n" "    (:rename :target \"scaleValue\" :oldName \"factor\" :newName \"delta\")\n" "  ])")) (pRes (patch/parsePatch patchAsn))] (assert (isOk? pRes) "parsePatch on valid ASN text must return ok") (let [(p (optionOr (match pRes ((ok parsed) (some parsed)) ((err _) (none))) (patch/makeAstPatch "" "" (none) (none) (list))))] (assert (= p.id "patch-asn-01") "Parsed patch id must match patch-asn-01") (assert (= p.targetModule "math/sample") "Parsed targetModule must match math/sample") (assert (= (listLength p.ops) 2) "Parsed ops count must be exactly 2") (let [(rendered (patch/renderPatch p)) (pRes2 (patch/parsePatch rendered))] (assert (isOk? pRes2) "re-parsing rendered patch must succeed") (let [(p2 (optionOr (match pRes2 ((ok parsed2) (some parsed2)) ((err _) (none))) (patch/makeAstPatch "" "" (none) (none) (list))))] (assert (= p2.id p.id) "Roundtrip patch id must be identical") (refute (isErr? pRes) "Refutation: Valid ASN patch parsing cannot error") (refute (isErr? pRes2) "Refutation: Roundtrip ASN patch parsing cannot error") (refute (!= (listLength p2.ops) 2) "Refutation: Roundtrip ops count must be 2")))) (let [(badAsn "(:wrongHead :id \"bad\")") (badRes (patch/parsePatch badAsn))] (assert (isErr? badRes) "Parsing wrong head must return error") (refute (isOk? badRes) "Refutation: Malformed head cannot parse as ok")) true)

fn testDualPolarityMutationUnification -> Bool
  (let [(src (sampleModuleSource)) (mutantPatch (patch/makeReplacePatch "divModFloorOmitMutant" "math/sample" "calcArea" "body" "(* w h)" "(+ w h)")) (res (patch/applyPatch mutantPatch src))] (assert res.success "Mutant AST replace patch must apply cleanly") (assert (stringContains? res.patchedSource "(+ w h)") "Mutant code must contain injected bug (+ w h)") (let [(inv (optionOr res.inversePatch mutantPatch)) (rollbackRes (patch/applyPatch inv res.patchedSource))] (assert (stringContains? rollbackRes.patchedSource "(* w h)") "Rollback must restore original operator (* w h)") (assert (not (stringContains? rollbackRes.patchedSource "(+ w h)")) "Rollback must not retain mutant operator (+ w h)") (refute (stringContains? res.patchedSource "(* w h)") "Refutation: Mutant code must not retain original operator") (refute (not (stringContains? rollbackRes.patchedSource "(* w h)")) "Refutation: Rollback must contain original operator") (refute (stringContains? rollbackRes.patchedSource "(+ w h)") "Refutation: Rollback must not contain mutant operator") (refute (not rollbackRes.success) "Refutation: Mutant rollback cannot fail")) true)

fn testZeroLineNumberInvariant -> Bool
  (let [(src (sampleModuleSource)) (p (patch/makeReplacePatch "p-zero-line" "math/sample" "math/sample:calcArea" "body" "(* w h)" "(+ w h)")) (rendered (patch/renderPatch p)) (res (patch/applyPatch p src)) (badPatch (patch/makeReplacePatch "p-bad" "math/sample" "missing" "body" "a" "b")) (badRes (patch/applyPatch badPatch src))] (assert (not (stringContains? rendered ":line")) "Rendered patch must not contain :line keyword") (assert (not (stringContains? rendered "#L")) "Rendered patch must not contain #L marker") (assert (not (stringContains? rendered ":col")) "Rendered patch must not contain :col keyword") (assert (stringContains? rendered "math/sample:calcArea") "Rendered patch must address target by Module:symbol") (let [(diag (optionOr (listGet badRes.diagnostics 0) (patch/makePatchDiag "" "" "" "")))] (assert (not (stringContains? diag.message "line ")) "Diagnostic message must not refer to line numbers") (assert (= diag.target "missing") "Diagnostic target must reference symbol name") (refute (stringContains? rendered ":line") "Refutation: Zero-line-number invariant forbids line numbers in patch ASN") (refute (stringContains? rendered "#L") "Refutation: Zero-line-number invariant forbids markdown line anchors") (refute (stringContains? diag.message "line ") "Refutation: Diagnostic must not contain line references") (refute (stringContains? diag.message "col ") "Refutation: Diagnostic must not contain column references")) true)

fn runTests -> Bool
  (and (testAstPatchReplaceOperation) (testAstPatchSpliceOperation) (testAstPatchRenameOperation) (testAstPatchRetypeOperation) (testAstPatchDiagnosticsAndRejections) (testAstPatchParserAndSerializer) (testDualPolarityMutationUnification) (testZeroLineNumberInvariant))

fn RunTests -> Bool
  (runTests)
