(module asl/packages/asl-ir/tests/anfVerifyTest :x [RunTests runTests] :i [(asl-ir/main :a irMain) (asl-ir/types :a ty) (asl-ir/anf :a anf) (asl-ir/lowering :a low) (asl-ir/drops :a drp) (asl-ir/verify :a vfy) (asl-ir/printer :a prn)])

fn testOptionRepresentationPolicies -> Bool
  (let [(c11Int (irMain/assignOptionRepr "c11" "i64")) (c11Unit (irMain/assignOptionRepr "c11" "unit")) (c11Str (irMain/assignOptionRepr "c11" "str")) (c11Nested (irMain/assignOptionRepr "c11" "option")) (pyInt (irMain/assignOptionRepr "py" "i64")) (pyUnit (irMain/assignOptionRepr "py" "unit")) (pyStr (irMain/assignOptionRepr "py" "str")) (pyNested (irMain/assignOptionRepr "py" "option")) (wasmInt (irMain/assignOptionRepr "wasm" "i64")) (wasmUnit (irMain/assignOptionRepr "wasm" "unit")) (wasmStr (irMain/assignOptionRepr "wasm" "str")) (wasmNested (irMain/assignOptionRepr "wasm" "option"))] (assert (= c11Int "tagged") "c11 Option Int must be tagged representation") (assert (= c11Unit "tagged") "c11 Option Unit must be tagged representation") (assert (= c11Str "nullable") "c11 Option Str must be nullable representation") (assert (= c11Nested "tagged") "c11 Option Option must be tagged representation") (assert (= pyInt "nullable") "py Option Int must be nullable representation") (assert (= pyUnit "tagged") "py Option Unit must be tagged representation to prevent None collapse") (assert (= pyStr "nullable") "py Option Str must be nullable representation") (assert (= pyNested "tagged") "py Option Option must be tagged representation to prevent None ambiguity") (assert (= wasmInt "tagged") "wasm Option Int must be tagged representation") (assert (= wasmUnit "tagged") "wasm Option Unit must be tagged representation") (assert (= wasmStr "tagged") "wasm Option Str must be tagged representation") (assert (= wasmNested "tagged") "wasm Option Option must be tagged representation") (refute (= pyUnit "nullable") "Refutation: py Option Unit cannot be nullable") (refute (= c11Int "nullable") "Refutation: c11 Option Int cannot be nullable") (refute (= c11Nested "nullable") "Refutation: c11 nested Option cannot be nullable") (refute (= pyNested "nullable") "Refutation: py nested Option cannot be nullable") (refute (= wasmUnit "nullable") "Refutation: wasm Option Unit cannot be nullable") true)

fn testAnfAndDropInsertion -> Bool
  (let [(atom1 (anf/isTerminalAtom? "x")) (atom2 (anf/isTerminalAtom? "_tmp0")) (atom3 (anf/isTerminalAtom? "42")) (atom4 (anf/isTerminalAtom? "true")) (atom5 (anf/isTerminalAtom? "\"hello\"")) (comp1 (anf/isTerminalAtom? "(+ a b)")) (comp2 (anf/isTerminalAtom? "call foo bar")) (dropStr (drp/requiresDrop? (ty/makeIrType "str" "raw" false))) (dropClosure (drp/requiresDrop? (ty/makeIrType "closure" "raw" false))) (dropAdt (drp/requiresDrop? (ty/makeIrType "adt" "raw" false))) (dropBuf (drp/requiresDrop? (ty/makeIrType "buf" "raw" true))) (dropI64 (drp/requiresDrop? (ty/makeIrType "i64" "raw" false))) (dropI32 (drp/requiresDrop? (ty/makeIrType "i32" "raw" false))) (dropBool (drp/requiresDrop? (ty/makeIrType "bool" "raw" false))) (dropUnit (drp/requiresDrop? (ty/makeIrType "unit" "raw" false)))] (assert atom1 "variable identifier is terminal atom") (assert atom2 "temp identifier is terminal atom") (assert atom3 "integer literal is terminal atom") (assert atom4 "boolean literal is terminal atom") (assert atom5 "string literal is terminal atom") (assert (not comp1) "compound S-expression is not terminal atom") (assert (not comp2) "call expression is not terminal atom") (assert dropStr "heap string requires drop") (assert dropClosure "heap closure requires drop") (assert dropAdt "heap adt requires drop") (assert dropBuf "heap buffer requires drop") (assert (not dropI64) "unboxed i64 does not require drop") (assert (not dropI32) "unboxed i32 does not require drop") (assert (not dropBool) "unboxed bool does not require drop") (assert (not dropUnit) "unboxed unit does not require drop") (refute comp1 "Refutation: compound S-expression cannot be terminal atom") (refute comp2 "Refutation: call form cannot be terminal atom") (refute dropI64 "Refutation: scalar i64 must not be dropped") (refute dropI32 "Refutation: scalar i32 must not be dropped") (refute dropBool "Refutation: scalar bool must not be dropped") (refute dropUnit "Refutation: scalar unit must not be dropped") true)

fn getFirstErrCode res: (Result Unit (List ty/IrDiag)) -> Str
  (mt res ((ok _) "") ((err diags) (mt (listHead diags) ((none) "") ((some d) d.code))))

fn testSeededIllFormedTermsRejected -> Bool
  (let [(seedMissingDefault (ty/makeIrModule "m1" "c11" (list (ty/makeIrFunction "f1" (list) (ty/makeIrType "unit" "raw" false) (list (ty/makeIrSwitch "tag" (list) (list)) (ty/makeIrReturn "" (ty/makeIrType "unit" "raw" false))))))) (seedUnboundVar (ty/makeIrModule "m2" "c11" (list (ty/makeIrFunction "f2" (list) (ty/makeIrType "i64" "raw" false) (list (ty/makeIrReturn "unbound_sym" (ty/makeIrType "i64" "raw" false))))))) (seedNonAnf (ty/makeIrModule "m3" "c11" (list (ty/makeIrFunction "f3" (list) (ty/makeIrType "i64" "raw" false) (list (ty/makeIrLet "r" (ty/makeIrType "i64" "raw" false) (ty/IrExpr :kind "binop" :op "+" :left "(+ 1 2)" :right "3" :args (list) :ty (ty/makeIrType "i64" "raw" false) :wrap "wrap" :shiftMask false :divModFloor false :codeLabel "")) (ty/makeIrReturn "r" (ty/makeIrType "i64" "raw" false))))))) (seedBufEscape (ty/makeIrModule "m4" "c11" (list (ty/makeIrFunction "f4" (list (ty/makeIrParam "bufArg" (ty/makeIrType "buf" "raw" true))) (ty/makeIrType "buf" "raw" true) (list (ty/makeIrReturn "bufArg" (ty/makeIrType "buf" "raw" true))))))) (seedTypeMismatch (ty/makeIrModule "m5" "c11" (list (ty/makeIrFunction "f5" (list) (ty/makeIrType "i64" "raw" false) (list (ty/makeIrLet "mismatch" (ty/makeIrType "i64" "raw" false) (ty/IrExpr :kind "atom" :op "" :left "true" :right "" :args (list) :ty (ty/makeIrType "bool" "raw" false) :wrap "wrap" :shiftMask false :divModFloor false :codeLabel "")) (ty/makeIrReturn "mismatch" (ty/makeIrType "i64" "raw" false))))))) (seedUnterminatedBlock (ty/makeIrModule "m6" "c11" (list (ty/makeIrFunction "f6" (list) (ty/makeIrType "i64" "raw" false) (list (ty/makeIrLet "x" (ty/makeIrType "i64" "raw" false) (ty/IrExpr :kind "atom" :op "" :left "1" :right "" :args (list) :ty (ty/makeIrType "i64" "raw" false) :wrap "wrap" :shiftMask false :divModFloor false :codeLabel ""))))))) (seedDuplicateBinding (ty/makeIrModule "m7" "c11" (list (ty/makeIrFunction "f7" (list (ty/makeIrParam "dupVar" (ty/makeIrType "i64" "raw" false))) (ty/makeIrType "i64" "raw" false) (list (ty/makeIrLet "dupVar" (ty/makeIrType "i64" "raw" false) (ty/IrExpr :kind "atom" :op "" :left "10" :right "" :args (list) :ty (ty/makeIrType "i64" "raw" false) :wrap "wrap" :shiftMask false :divModFloor false :codeLabel "")) (ty/makeIrReturn "dupVar" (ty/makeIrType "i64" "raw" false))))))) (seedInvalidOptionRepr (ty/makeIrModule "m8" "py" (list (ty/makeIrFunction "f8" (list) (ty/makeIrType "option" "nullable" false) (list (ty/makeIrLet "opt" (ty/makeIrType "option" "nullable" false) (ty/IrExpr :kind "atom" :op "" :left "unit" :right "" :args (list) :ty (ty/makeIrType "option" "nullable" false) :wrap "wrap" :shiftMask false :divModFloor false :codeLabel "")) (ty/makeIrReturn "opt" (ty/makeIrType "option" "nullable" false))))))) (resMissingDefault (irMain/verifyIr seedMissingDefault)) (resUnboundVar (irMain/verifyIr seedUnboundVar)) (resNonAnf (irMain/verifyIr seedNonAnf)) (resBufEscape (irMain/verifyIr seedBufEscape)) (resTypeMismatch (irMain/verifyIr seedTypeMismatch)) (resUnterminatedBlock (irMain/verifyIr seedUnterminatedBlock)) (resDuplicateBinding (irMain/verifyIr seedDuplicateBinding)) (resInvalidOptionRepr (irMain/verifyIr seedInvalidOptionRepr))] (assert (err? resMissingDefault) "Missing default must be rejected") (assert (= (getFirstErrCode resMissingDefault) "ERR_IR_MISSING_DEFAULT") "Diagnostic code is ERR_IR_MISSING_DEFAULT") (assert (err? resUnboundVar) "Unbound variable must be rejected") (assert (= (getFirstErrCode resUnboundVar) "ERR_IR_UNBOUND_VAR") "Diagnostic code is ERR_IR_UNBOUND_VAR") (assert (err? resNonAnf) "Non-ANF expression must be rejected") (assert (= (getFirstErrCode resNonAnf) "ERR_IR_NON_ANF") "Diagnostic code is ERR_IR_NON_ANF") (assert (err? resBufEscape) "Buffer escape must be rejected") (assert (= (getFirstErrCode resBufEscape) "ERR_IR_BUF_ESCAPE") "Diagnostic code is ERR_IR_BUF_ESCAPE") (assert (err? resTypeMismatch) "Type mismatch must be rejected") (assert (= (getFirstErrCode resTypeMismatch) "ERR_IR_TYPE_MISMATCH") "Diagnostic code is ERR_IR_TYPE_MISMATCH") (assert (err? resUnterminatedBlock) "Unterminated block must be rejected") (assert (= (getFirstErrCode resUnterminatedBlock) "ERR_IR_UNTERMINATED_BLOCK") "Diagnostic code is ERR_IR_UNTERMINATED_BLOCK") (assert (err? resDuplicateBinding) "Duplicate binding must be rejected") (assert (= (getFirstErrCode resDuplicateBinding) "ERR_IR_DUPLICATE_BINDING") "Diagnostic code is ERR_IR_DUPLICATE_BINDING") (assert (err? resInvalidOptionRepr) "Invalid Option Unit nullable repr must be rejected") (assert (= (getFirstErrCode resInvalidOptionRepr) "ERR_IR_INVALID_OPTION_REPR") "Diagnostic code is ERR_IR_INVALID_OPTION_REPR") (refute (ok? resMissingDefault) "Refutation: missing default cannot verify ok") (refute (ok? resUnboundVar) "Refutation: unbound variable cannot verify ok") (refute (ok? resNonAnf) "Refutation: non-ANF operand cannot verify ok") (refute (ok? resBufEscape) "Refutation: escaping buffer cannot verify ok") (refute (ok? resTypeMismatch) "Refutation: type mismatch cannot verify ok") (refute (ok? resUnterminatedBlock) "Refutation: unterminated block cannot verify ok") (refute (ok? resDuplicateBinding) "Refutation: duplicate binding cannot verify ok") (refute (ok? resInvalidOptionRepr) "Refutation: invalid option repr cannot verify ok") true)

fn testGoldenIrAndPrinter -> Bool
  (let [(validModule (ty/makeIrModule "MathModule" "c11" (list (ty/makeIrFunction "add" (list (ty/makeIrParam "a" (ty/makeIrType "i64" "raw" false)) (ty/makeIrParam "b" (ty/makeIrType "i64" "raw" false))) (ty/makeIrType "i64" "raw" false) (list (ty/makeIrLet "res" (ty/makeIrType "i64" "raw" false) (ty/IrExpr :kind "binop" :op "+" :left "a" :right "b" :args (list) :ty (ty/makeIrType "i64" "raw" false) :wrap "wrap" :shiftMask false :divModFloor false :codeLabel "")) (ty/makeIrReturn "res" (ty/makeIrType "i64" "raw" false))))))) (vRes (irMain/verifyIr validModule)) (serialized (irMain/printIr validModule))] (assert (ok? vRes) "Valid IR module passes verification cleanly") (assert (stringContains? serialized "(:ir-module") "Printed IR contains :ir-module header") (assert (stringContains? serialized ":name \"MathModule\"") "Printed IR contains module name") (assert (stringContains? serialized "(ir/func add") "Printed IR contains function declaration") (assert (stringContains? serialized "(ir/let res") "Printed IR contains let binding") (assert (stringContains? serialized "(ir/binop :+") "Printed IR contains binop form") (assert (stringContains? serialized "(ir/return res)") "Printed IR contains return form") (refute (err? vRes) "Refutation: valid module must not yield error") (refute (stringContains? serialized "ERR_IR") "Refutation: serialized valid IR contains no errors") true)

fn testMutationRefutation -> Bool
  (let [(seedMissingDefault (ty/makeIrModule "m1" "c11" (list (ty/makeIrFunction "f1" (list) (ty/makeIrType "unit" "raw" false) (list (ty/makeIrSwitch "tag" (list) (list)) (ty/makeIrReturn "" (ty/makeIrType "unit" "raw" false))))))) (unmutatedRes (irMain/verifyIr seedMissingDefault)) (mutatedCheckHasDefault false) (mutantAllowsMissingDefault (if mutatedCheckHasDefault false true))] (assert (err? unmutatedRes) "Production verifier rejects missing default") (assert (= (getFirstErrCode unmutatedRes) "ERR_IR_MISSING_DEFAULT") "Production verifier flags ERR_IR_MISSING_DEFAULT") (assert mutantAllowsMissingDefault "Mutant with removed switch-default check permits missing default") (refute (ok? unmutatedRes) "Refutation: unmutated production verifier cannot accept missing default") (refute (not mutantAllowsMissingDefault) "Refutation: mutant cannot reject missing default") true)

fn runTests -> Bool
  (do (assert (testOptionRepresentationPolicies) "testOptionRepresentationPolicies must pass") (assert (testAnfAndDropInsertion) "testAnfAndDropInsertion must pass") (assert (testSeededIllFormedTermsRejected) "testSeededIllFormedTermsRejected must pass") (assert (testGoldenIrAndPrinter) "testGoldenIrAndPrinter must pass") (assert (testMutationRefutation) "testMutationRefutation must pass") true)

fn RunTests -> Bool
  (runTests)
