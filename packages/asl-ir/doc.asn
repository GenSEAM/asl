(:doc :symbol "asl/packages/asl-ir/src/main.asl#" :text "Top-level API for AgentSlang Core IR lowering, verification, printing, and AST patching")
(:doc :symbol "asl/packages/asl-ir/src/main.asl#lowerModule" :text "An IrModule of the functions, each body passed through toAnf and insertDrops.")
(:doc :symbol "asl/packages/asl-ir/src/main.asl#verifyIr" :text "Verify an IrModule with asl-ir/verify verifyIr.")
(:doc :symbol "asl/packages/asl-ir/src/main.asl#printIr" :text "Render an IrModule as text with asl-ir/printer printIr.")
(:doc :symbol "asl/packages/asl-ir/src/patch.asl#" :text "Pure ASL Canonical AST Patch Algebra, Parser, and In-Memory Roundtrip Validator")
(:doc :symbol "asl/packages/asl-ir/src/patch.asl#makePatchOpReplace" :text "A replace operation of oldNode by newNode at the anchor inside the target symbol.")
(:doc :symbol "asl/packages/asl-ir/src/patch.asl#makePatchOpRetype" :text "A retype operation of oldType to newType at the anchor inside the target symbol.")
(:doc :symbol "asl/packages/asl-ir/src/patch.asl#computeAstDigest" :text "A digest of the source text: its length and a rolling hash of its characters.")
(:doc :symbol "asl/packages/asl-ir/src/patch.asl#applyPatch" :text "Apply the operations in order after checking the pre digest, returning the patched source, its inverse and diagnostics.")
(:doc :symbol "asl/packages/asl-ir/src/patch.asl#verifyPatch" :text "Ok when applyPatch succeeds on the source, else its diagnostics.")
(:doc :symbol "asl/packages/asl-ir/src/patch.asl#parsePatch" :text "Read an :astPatch form into an AstPatch, or a PatchDiag naming the malformed part.")
(:doc :symbol "asl/packages/asl-ir/src/patch.asl#renderPatch" :text "Render a patch as an (:astPatch ...) form that parsePatch reads back.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#ssaInstr" :text "An SsaInstr assigning the operation's result to dest at the type.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#ssaEdge" :text "An SsaEdge to the target block passing the arguments to its parameters.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#ssaCase" :text "An SsaCase sending the variant to the edge.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#ssaRecordDecl" :text "Every field is boxed (kind 255) and kept in declared order.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#ssaExternTyped" :text "A typed SsaExtern from its name, parameter types and return type.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#ssaExternNative" :text "A typed, non-variadic C ABI SsaExtern for a C symbol (ffiRoute's foreign targets and helpers): native is true, so the LLVM target emits a plain ccc declare and call even when every type is i64 or f64.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#ssaTyName" :text "The printed name of an SsaTy, including a schema-known record Val.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#ssaAbiName" :text "A record Val passes as val in every ABI; other types pass in the register class ssaTyName names.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#termEdges" :text "The outgoing edges of a terminator, switch cases before the default.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#opOperands" :text "The value names an operation reads, in operand order.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#builtinEntries" :text "Builtins with a direct runtime entry, operand and result types as letters: v Val, i i64, f f64, b i1.")
(:doc :symbol "asl/packages/asl-ir/src/types.asl#builtinEntry" :text "The direct runtime entry of a builtin called with arity operands, none when it has none and goes through asl_rt_builtin by name.")
(:doc :symbol "asl/packages/asl-ir/src/verify.asl#verifyIr" :text "Ok when verifyModule finds nothing, else its diagnostics.")
(:doc :symbol "asl/packages/asl-ir/src/verify.asl#verifySsa" :text "Ok when verifySsaDiags finds nothing, else its diagnostics.")
(:doc :symbol "asl/packages/asl-ir/src/link.asl#preludePath" :text "Path of the prelude the host loader falls back to, relative to the repository root.")
(:doc :symbol "asl/packages/asl-ir/src/link.asl#loadClosure!" :text "Load the entry file and its transitive imports, imports before their importers; err with every read, parse, resolve, duplicate-module and reserved-module-name diagnostic.")
(:doc :symbol "asl/packages/asl-ir/src/link.asl#importForms" :text "Map each import alias of a unit to the parsed top forms of its resolved dependency.")
(:doc :symbol "asl/packages/asl-ir/src/link.asl#linkWith!" :text "Load the closure of the entry file and link it against the given prelude file.")
(:doc :symbol "asl/packages/asl-ir/src/link.asl#linkEntry!" :text "Load the closure of the entry file and link it against the host prelude at preludePath.")
(:doc :symbol "asl/packages/asl-ir/src/lower.asl#builtinArity" :text "Operand count of a builtin the lowering emits as opBuiltin, -1 when variadic, none when the name is not one.")
(:doc :symbol "asl/packages/asl-ir/src/lower.asl#lowerLinked" :text "Lower one module of a linked closure, qualifying its symbols by module name and resolving imports and the prelude through the scope.")
(:doc :symbol "asl/packages/asl-ir/src/lower.asl#lowerSource" :text "Parse the source and lower it as a standalone module; a parse error is one ERR_LOWER_PARSE diagnostic.")
(:doc :symbol "asl/packages/asl-ir/src/blocks.asl#" :text "Shared shape for source targets that emit a linked SSA module: block contexts, self tail calls through forwarding join blocks, identifier mangling, string quoting and export names.")
(:doc :symbol "asl/packages/asl-ir/src/blocks.asl#mangle" :text "prefix followed by name with every non-identifier byte escaped as escape plus its two lowercase hex digits, so a qualified or symbolic ASL name becomes one target-safe identifier.")
(:doc :symbol "asl/packages/asl-ir/src/blocks.asl#quoted" :text "s as a double-quoted string literal, escaping backslash, quote, newline, carriage return and tab.")
(:doc :symbol "asl/packages/asl-ir/src/blocks.asl#paramNames" :text "The declared names of ps, in order.")
(:doc :symbol "asl/packages/asl-ir/src/blocks.asl#labelIndex" :text "label's position among ctx's blocks, as a string; -1 when label is unknown.")
(:doc :symbol "asl/packages/asl-ir/src/blocks.asl#locals" :text "Every name fn0 binds: each block's own parameters followed by its instructions' destinations, in block order.")
(:doc :symbol "asl/packages/asl-ir/src/blocks.asl#collect" :text "results with every err laid out in order as a list of messages, or every ok value in order when none failed.")
(:doc :symbol "asl/packages/asl-ir/src/blocks.asl#exportName" :text "fnName with its 'moduleName.' prefix stripped, when it has that prefix and names no further '@' local; none for a name outside the module or a compiler-generated local.")
