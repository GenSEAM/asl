(module asl-engine/tests/wire2CoverTest
  :x [runTests]
  :i [(asl-engine/wire :a w)])

fn ! runTests -> Bool
  (let [
        (activeNormal (w/formatCliStatusActive 1234 "workspace" "/tmp/engine.sock" 42 512 "/var/run/asl/engine.pid"))
        (activeZero (w/formatCliStatusActive 0 "" "" 0 0 ""))
        (activeMax (w/formatCliStatusActive 9223372036854775807 "max-scope" "/max/path.sock" 9223372036854775807 9223372036854775807 "/max/pid"))
        (activeEmptyStrings (w/formatCliStatusActive 100 "" "" 10 20 ""))

        (stoppedNormal (w/formatCliStatusStopped "workspace" "/tmp/engine.sock" "/var/run/asl/engine.pid"))
        (stoppedEmpty (w/formatCliStatusStopped "" "" ""))
        (stoppedLong (w/formatCliStatusStopped "very-long-scope-name-with-many-characters" "/very/long/socket/path/that/exceeds/typical/limits.sock" "/very/long/pid/file/path/that/exceeds/typical/limits.pid"))
        (activeNegative (w/formatCliStatusActive (- 1) "neg-scope" "/neg.sock" (- 1) (- 1) "/neg.pid"))
        (stoppedPartial (w/formatCliStatusStopped "" "/only/socket.sock" ""))
       ]
    (do
      (assert (stringContains? activeNormal "=== ASL ENGINE STATUS ===") "activeNormal has header")
      (assert (stringContains? activeNormal "State:            ACTIVE (PID 1234)") "activeNormal has correct state line")
      (assert (stringContains? activeNormal "Scope:            workspace") "activeNormal has correct scope")
      (assert (stringContains? activeNormal "UNIX Socket:      /tmp/engine.sock") "activeNormal has correct socket")
      (assert (stringContains? activeNormal "Memory RSS:       42 MB (Ceiling: 512 MB)") "activeNormal has correct memory")
      (assert (stringContains? activeNormal "PID File:         /var/run/asl/engine.pid") "activeNormal has correct pid file")
      (assert (stringContains? activeNormal "Authority:        ADR0081 / D120 Dual-Mode Context Isolation") "activeNormal has authority line")
      (assert (stringContains? activeNormal "Ingress Channels: unix-socket, terminal-cli, rpc") "activeNormal has ingress line")

      (assert (stringContains? activeZero "=== ASL ENGINE STATUS ===") "activeZero has header")
      (assert (stringContains? activeZero "State:            ACTIVE (PID 0)") "activeZero has PID 0")
      (assert (stringContains? activeZero "Scope:            ") "activeZero has empty scope")
      (assert (stringContains? activeZero "UNIX Socket:      ") "activeZero has empty socket")
      (assert (stringContains? activeZero "Memory RSS:       0 MB (Ceiling: 0 MB)") "activeZero has zero memory")
      (assert (stringContains? activeZero "PID File:         ") "activeZero has empty pid file")
      (assert (stringContains? activeZero "Authority:        ADR0081 / D120 Dual-Mode Context Isolation") "activeZero has authority line")
      (assert (stringContains? activeZero "Ingress Channels: unix-socket, terminal-cli, rpc") "activeZero has ingress line")

      (assert (stringContains? activeMax "=== ASL ENGINE STATUS ===") "activeMax has header")
      (assert (stringContains? activeMax "State:            ACTIVE (PID 9223372036854775807)") "activeMax has max PID")
      (assert (stringContains? activeMax "Scope:            max-scope") "activeMax has scope")
      (assert (stringContains? activeMax "UNIX Socket:      /max/path.sock") "activeMax has socket")
      (assert (stringContains? activeMax "Memory RSS:       9223372036854775807 MB (Ceiling: 9223372036854775807 MB)") "activeMax has max memory")
      (assert (stringContains? activeMax "PID File:         /max/pid") "activeMax has pid file")
      (assert (stringContains? activeMax "Authority:        ADR0081 / D120 Dual-Mode Context Isolation") "activeMax has authority line")
      (assert (stringContains? activeMax "Ingress Channels: unix-socket, terminal-cli, rpc") "activeMax has ingress line")

      (assert (stringContains? activeEmptyStrings "=== ASL ENGINE STATUS ===") "activeEmptyStrings has header")
      (assert (stringContains? activeEmptyStrings "State:            ACTIVE (PID 100)") "activeEmptyStrings has PID 100")
      (assert (stringContains? activeEmptyStrings "Scope:            ") "activeEmptyStrings has empty scope")
      (assert (stringContains? activeEmptyStrings "UNIX Socket:      ") "activeEmptyStrings has empty socket")
      (assert (stringContains? activeEmptyStrings "Memory RSS:       10 MB (Ceiling: 20 MB)") "activeEmptyStrings has memory")
      (assert (stringContains? activeEmptyStrings "PID File:         ") "activeEmptyStrings has empty pid file")
      (assert (stringContains? activeEmptyStrings "Authority:        ADR0081 / D120 Dual-Mode Context Isolation") "activeEmptyStrings has authority line")
      (assert (stringContains? activeEmptyStrings "Ingress Channels: unix-socket, terminal-cli, rpc") "activeEmptyStrings has ingress line")

      (assert (stringContains? stoppedNormal "=== ASL ENGINE STATUS ===") "stoppedNormal has header")
      (assert (stringContains? stoppedNormal "State:            STOPPED") "stoppedNormal has STOPPED state")
      (assert (stringContains? stoppedNormal "Scope:            workspace") "stoppedNormal has correct scope")
      (assert (stringContains? stoppedNormal "UNIX Socket:      /tmp/engine.sock") "stoppedNormal has correct socket")
      (assert (stringContains? stoppedNormal "PID File:         /var/run/asl/engine.pid") "stoppedNormal has correct pid file")
      (assert (stringContains? stoppedNormal "Authority:        ADR0081 / D120 Dual-Mode Context Isolation") "stoppedNormal has authority line")
      (refute (stringContains? stoppedNormal "Memory RSS:") "stoppedNormal has no memory line")
      (refute (stringContains? stoppedNormal "Ingress Channels:") "stoppedNormal has no ingress line")

      (assert (stringContains? stoppedEmpty "=== ASL ENGINE STATUS ===") "stoppedEmpty has header")
      (assert (stringContains? stoppedEmpty "State:            STOPPED") "stoppedEmpty has STOPPED state")
      (assert (stringContains? stoppedEmpty "Scope:            ") "stoppedEmpty has empty scope")
      (assert (stringContains? stoppedEmpty "UNIX Socket:      ") "stoppedEmpty has empty socket")
      (assert (stringContains? stoppedEmpty "PID File:         ") "stoppedEmpty has empty pid file")
      (assert (stringContains? stoppedEmpty "Authority:        ADR0081 / D120 Dual-Mode Context Isolation") "stoppedEmpty has authority line")
      (refute (stringContains? stoppedEmpty "Memory RSS:") "stoppedEmpty has no memory line")
      (refute (stringContains? stoppedEmpty "Ingress Channels:") "stoppedEmpty has no ingress line")

      (assert (stringContains? stoppedLong "=== ASL ENGINE STATUS ===") "stoppedLong has header")
      (assert (stringContains? stoppedLong "State:            STOPPED") "stoppedLong has STOPPED state")
      (assert (stringContains? stoppedLong "Scope:            very-long-scope-name-with-many-characters") "stoppedLong has long scope")
      (assert (stringContains? stoppedLong "UNIX Socket:      /very/long/socket/path/that/exceeds/typical/limits.sock") "stoppedLong has long socket")
      (assert (stringContains? stoppedLong "PID File:         /very/long/pid/file/path/that/exceeds/typical/limits.pid") "stoppedLong has long pid file")
      (assert (stringContains? stoppedLong "Authority:        ADR0081 / D120 Dual-Mode Context Isolation") "stoppedLong has authority line")
      (refute (stringContains? stoppedLong "Memory RSS:") "stoppedLong has no memory line")
      (refute (stringContains? stoppedLong "Ingress Channels:") "stoppedLong has no ingress line")

      (assert (stringContains? activeNegative "State:            ACTIVE (PID -1)") "activeNegative has negative PID")
      (assert (stringContains? activeNegative "Scope:            neg-scope") "activeNegative has scope")
      (assert (stringContains? activeNegative "UNIX Socket:      /neg.sock") "activeNegative has socket")
      (assert (stringContains? activeNegative "Memory RSS:       -1 MB (Ceiling: -1 MB)") "activeNegative has negative memory")
      (assert (stringContains? activeNegative "PID File:         /neg.pid") "activeNegative has pid file")
      (assert (stringContains? activeNegative "Authority:        ADR0081 / D120 Dual-Mode Context Isolation") "activeNegative has authority line")
      (assert (stringContains? activeNegative "Ingress Channels: unix-socket, terminal-cli, rpc") "activeNegative has ingress line")

      (assert (stringContains? stoppedPartial "=== ASL ENGINE STATUS ===") "stoppedPartial has header")
      (assert (stringContains? stoppedPartial "State:            STOPPED") "stoppedPartial has STOPPED state")
      (assert (stringContains? stoppedPartial "Scope:            ") "stoppedPartial has empty scope")
      (assert (stringContains? stoppedPartial "UNIX Socket:      /only/socket.sock") "stoppedPartial has socket")
      (assert (stringContains? stoppedPartial "PID File:         ") "stoppedPartial has empty pid file")
      (assert (stringContains? stoppedPartial "Authority:        ADR0081 / D120 Dual-Mode Context Isolation") "stoppedPartial has authority line")
      (refute (stringContains? stoppedPartial "Memory RSS:") "stoppedPartial has no memory line")
      (refute (stringContains? stoppedPartial "Ingress Channels:") "stoppedPartial has no ingress line")

      true))
