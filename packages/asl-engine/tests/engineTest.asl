(module asl-engine/tests/engineTest
  :x [runTests]
  :i [(asl-engine/wire :a w)
      (asl-engine/lease :a lse)
      (asl-engine/breaker :a brk)
      (asl-engine/guard :a grd)
      (asl-engine/watchdog :a wd)
      (asl-engine/supervisor :a sp)
      (asl-engine/transport :a tp)
      (asl-engine/engine :a eng)
      (asl-engine/build :a bld)])

fn ! runTests -> Bool
  (let [
        (valid1 (w/validSessionId? "sess-1.2_3"))
        (valid2 (w/validSessionId? "bad..id"))
        (valid3 (w/validSessionId? ""))
        (valid4 (w/validSessionId? "bad/slash"))
        (strip1 (w/stripLeadingColon ":action"))
        (strip2 (w/stripLeadingColon "action"))
        (parsed1 (w/parseSimpleSExpr "(:ping)"))
        (parsed2 (w/parseSimpleSExpr "(:manage :action spawn :id my-id :cmd \"echo hi\")"))
        (argAct (w/getArgOr (pairSecond parsed2) "action" ""))
        (argId (w/getArgOr (pairSecond parsed2) "id" ""))
        (argCmd (w/getArgOr (pairSecond parsed2) "cmd" ""))

        (testSock "/tmp/asl_test_lease_unit.sock")
        (lPath (lse/lockPathFor testSock))
        (lease1Res (lse/acquireLease! testSock))
        (lease1 (resultOr lease1Res (lse/LeaseLock :acquired false :fd -1 :lockPath "" :error "fail")))
        (lease2Res (lse/acquireLease! testSock))
        (lease2Err (mt lease2Res ((ok _) "") ((err e) e)))
        (_rel1 (lse/releaseLease! lease1))
        (lease3Res (lse/acquireLease! testSock))
        (lease3Ok (ok? lease3Res))
        (lease3 (resultOr lease3Res (lse/LeaseLock :acquired false :fd -1 :lockPath "" :error "fail")))
        (_rel2 (lse/releaseLease! lease3))

        (v1 (brk/evaluateBreaker "" 1000 false "/path/engine.log"))
        (v2 (brk/evaluateBreaker "980\n990\n995" 1000 false "/path/engine.log"))
        (vForce (brk/evaluateBreaker "980\n990\n995" 1000 true "/path/engine.log"))
        (vOld (brk/evaluateBreaker "900\n910" 1000 false "/path/engine.log"))

        (sOk (grd/evaluateRss 200 384 512))
        (sSoft (grd/evaluateRss 400 384 512))
        (sCrit (grd/evaluateRss 600 384 512))
        (realRss (grd/sampleCurrentRssMb!))

        (act0 (wd/makeEngineActivity 900 1000))
        (actStart (wd/activityOnRequestStart act0 1010))
        (actEnd (wd/activityOnRequestEnd actStart 1020))
        (idle0 (wd/isIdle 1000 1000 0 0 900))
        (idleElapsed (wd/isIdle 1900 1000 0 0 900))
        (idleInFlight (wd/isIdle 2000 1000 1 0 900))
        (idleSessions (wd/isIdle 2000 1000 0 2 900))
        (idleDisabled (wd/isIdle 2000 1000 0 0 0))
        (lt (wd/checkLifetimeStatus! "/nonexistent/socket.sock" "/tmp"))

        (sup0 (sp/makeSupervisorState))
        (spawnEcho (sp/spawnSession! sup0 "test-sess-echo" "echo test-output-42" "/tmp" false 1000))
        (sup1 (pairFirst spawnEcho))
        (spawnEchoReceipt (pairSecond spawnEcho))
        (_sleepEcho (sleepMs 150))
        (pollEcho (sp/pollSession! sup1 "test-sess-echo" 1001))
        (sup2 (pairFirst pollEcho))
        (pollEchoReceipt (pairSecond pollEcho))
        (tailEcho (sp/tailSession! sup2 "test-sess-echo" 10))
        (spawnSleep (sp/spawnSession! sup2 "test-sess-kill" "sleep 30" "/tmp" false 1000))
        (sup3 (pairFirst spawnSleep))
        (killRes (sp/killSession! sup3 "test-sess-kill"))
        (sup4 (pairFirst killRes))
        (killReceipt (pairSecond killRes))
        (pollKill (sp/pollSession! sup4 "test-sess-kill" 1001))
        (pollKillReceipt (pairSecond pollKill))
        (listRec (sp/listSessionsReceipt sup4))
        (_rmEcho (pathRemove "/tmp/asl-sessions/test-sess-echo.log"))
        (_rmKill (pathRemove "/tmp/asl-sessions/test-sess-kill.log"))

        (transChoice (tp/chooseTransport! "" "/tmp/nonexistent-socket.sock"))
        (transExplicit (tp/chooseTransport! "subprocess" "/tmp/any.sock"))
        (transAvailable (tp/chooseTransport! "" "/tmp"))
        (evalRes (tp/runEngineEval! (bld/runnerBin! (resultOr (realPath ".") ".")) "(+ 21 21)"))

        (wsCfg (eng/resolveScope! "/tmp/myrepo" "workspace"))
        (sysCfg (eng/resolveScope! "/tmp/myrepo" "system"))
        (taskCfg (eng/resolveScope! "/tmp/myrepo" "task-456"))
        (chkOk (eng/checkSocketPath "/tmp/short.sock" true))
        (chkFail (eng/checkSocketPath "/tmp/toolong/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.sock" true))
        (cmdPingRes (eng/cmdPing! "/tmp/nonexistent_dir" "workspace"))
        (cmdStopRes (eng/cmdStop! "/tmp/nonexistent_dir" "workspace"))
        (traversalToken "en1-path-secret")
        (traversalTarget "/tmp/en1-path-secret.log")
        (seedTraversalFile (processRun (str "printf outside-log-content > " traversalTarget)))
        (traversalId (str "../../tmp/" traversalToken))
        (traversalTail (sp/tailSession! sup0 traversalId 10))
        (_removeTraversalFile (pathRemove traversalTarget))
       ]
    (do
      (assert valid1 "valid session id alphanum")
      (refute valid2 "invalid session id double dot")
      (refute valid3 "invalid session id empty")
      (refute valid4 "invalid session id slash")
      (assert (= strip1 "action") "strip colon with prefix")
      (assert (= strip2 "action") "strip colon without prefix")
      (assert (= (pairFirst parsed1) "ping") "parseSimpleSExpr ping op")
      (assert (= (pairFirst parsed2) "manage") "parseSimpleSExpr manage op")
      (assert (= argAct "spawn") "getArgOr action")
      (assert (= argId "my-id") "getArgOr id")
      (assert (= argCmd "echo hi") "getArgOr cmd")

      (assert (= lPath "/tmp/asl_test_lease_unit.sock.lock") "lockPathFor convention")
      (assert lease1.acquired "lease1 acquired")
      (assert (> lease1.fd 0) "lease1 valid fd")
      (assert (= lease2Err (lse/formatLeaseBusyMessage testSock)) "lease collision error")
      (assert lease3Ok "lease3 re-acquired after release")

      (refute v1.tripped "breaker clean initial")
      (assert (= v1.count 1) "breaker count incremented")
      (assert v2.tripped "breaker tripped on 3 restarts")
      (assert (= v2.count 3) "breaker count 3")
      (assert (stringContains? v2.message "ASL ENGINE CIRCUIT BREAKER TRIPPED") "breaker diagnostic message")
      (refute vForce.tripped "breaker force override")
      (assert (= vForce.count 0) "breaker force count reset")
      (refute vOld.tripped "breaker window expiration")

      (assert (= sOk.level ":ok") "rss level ok")
      (assert (= sSoft.level ":soft-exceeded") "rss level soft")
      (assert (= sCrit.level ":critical") "rss level critical")
      (assert (stringContains? sCrit.criticalMessage "memory ceiling exceeded") "rss emergency message")
      (assert (>= realRss 0) "real procRusage rss sampled")

      (assert (= act0.inFlight 0) "initial activity inFlight 0")
      (assert (= actStart.inFlight 1) "activity start inFlight 1")
      (assert (= actEnd.inFlight 0) "activity end inFlight 0")
      (refute idle0 "not idle elapsed < idleSec")
      (assert idleElapsed "idle elapsed >= idleSec")
      (refute idleInFlight "not idle when inFlight > 0")
      (refute idleSessions "not idle when sessions active")
      (refute idleDisabled "not idle when idleSec is 0")
      (refute lt.alive "watchdog missing socket")
      (refute lt.socketExists "watchdog socket absent")
      (assert lt.rootExists "watchdog root present")

      (assert (and (stringStartsWith? spawnEchoReceipt "(:receipt :status :ok :id \"test-sess-echo\" :pid ") (stringEndsWith? spawnEchoReceipt " :state :active)")) "spawn session receipt")
      (assert (stringStartsWith? pollEchoReceipt "(:receipt :status :ok :id \"test-sess-echo\" :state :completed :exitCode 0 :durationMs ") "poll session completed")
      (assert (stringContains? tailEcho "test-output-42") "tail session output")
      (assert (= killReceipt "(:receipt :status :ok :id \"test-sess-kill\" :state :terminated)") "kill session receipt")
      (assert (stringStartsWith? pollKillReceipt "(:receipt :status :ok :id \"test-sess-kill\" :state :terminated :exitCode 137 :durationMs ") "poll killed session")
      (assert (stringContains? listRec ":sessions") "list sessions receipt")

      (assert (= (pairFirst transChoice) "subprocess") "chooseTransport fallback")
      (assert (= (pairFirst transExplicit) "subprocess") "chooseTransport env")
      (assert (= (pairFirst transAvailable) "subprocess") "existing socket path selects subprocess transport")
      (assert (stringContains? (pairSecond transAvailable) "socket transport is not implemented by this package") "existing socket path reports unavailable socket transport")
      (assert (= evalRes.exitCode 0) "runEngineEval! exit 0")
      (assert (= (stringTrim evalRes.stdout) "42") "runEngineEval! output 42")

      (assert (= wsCfg.scope "workspace") "resolveScope workspace")
      (assert (= wsCfg.socketPath "/tmp/myrepo/.asl/engine.sock") "workspace socket path")
      (assert (= sysCfg.scope "system") "resolveScope system")
      (assert (= taskCfg.scope "task-456") "resolveScope task")
      (assert (ok? chkOk) "checkSocketPath ok")
      (assert (err? chkFail) "checkSocketPath fail on long path")
      (assert (= cmdPingRes "(:pong :status :offline :scope \"workspace\")") "cmdPing! offline")
      (assert (= cmdStopRes "ASL Engine is not running (Scope: workspace).") "cmdStop! not running")
      (assert (= seedTraversalFile.exitCode 0) "seed traversal log file")
      (assert (not (stringContains? traversalTail "outside-log-content")) "tail rejects path traversal session id")
      true))
