;; Receipts recorded from bin/asl-engine
(:engineParityFixtures
  :recordedCount 24
  :cases [
    (:case :id "cli_version" :kind "cli" :req "--version" :want "asl-engine 0.1.0 (Resident Engine & Context Isolation Supervisor, ADR0081/D120)")
    (:case :id "cli_ping_offline_ws" :kind "cli" :req "ping" :want "(:pong :status :offline :scope \"workspace\")")
    (:case :id "cli_ping_offline_sys" :kind "cli" :req "--scope system ping" :want "(:pong :status :offline :scope \"system\")")
    (:case :id "cli_ping_offline_task" :kind "cli" :req "--scope task-abc ping" :want "(:pong :status :offline :scope \"task-abc\")")
    (:case :id "socket_path_too_long" :kind "socket" :req "/tmp/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.sock" :want "(:engine :status :error :error-code ERR_SOCKET_PATH_TOO_LONG :path \"/tmp/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.sock\" :bytes 120 :limit 104)")
    (:case :id "breaker_tripped" :kind "breaker" :req "restart" :want "=== [ASL ENGINE CIRCUIT BREAKER TRIPPED] ===\nEngine has restarted 3 times within the last 30 seconds.\nHalting automatic restart loop to prevent flapping / restart storm.\nUse 'asl engine restart --force' to override or inspect logs at /path/to/worktree/.asl/engine.log.")
    (:case :id "lease_held" :kind "lease" :req "run" :want "[Engine] Engine already active for socket /tmp/asl_lse_Z38DCa/engine.sock (lock held).")
    (:case :id "wire_ping" :kind "wire" :req "(:ping)" :want "(:pong :status :ok :pid 50696 :uptimeSec 0 :scope \"workspace\")")
    (:case :id "wire_sleep" :kind "wire" :req "(:sleep :sec 0.1)" :want "(:receipt :status :ok :op :sleep :slept 0.1)")
    (:case :id "wire_engine_ping" :kind "wire" :req "(:engine :action :ping)" :want "(:receipt :status :ok :op :pong :pid 50696 :uptimeSec 0 :scope \"workspace\")")
    (:case :id "wire_spawn_invalid_id" :kind "wire" :req "(:manage :action spawn :id bad..id :cmd \"echo 1\")" :want "(:receipt :status :error :error-code \":ERR_INVALID_ID\" :id \"bad..id\" :message \"Session id must match [A-Za-z0-9._-]{1,128} and must not contain ..\")")
    (:case :id "wire_spawn_missing_cmd" :kind "wire" :req "(:manage :action spawn :id s1)" :want "(:receipt :status :error :message \"Missing cmd or id for spawn\")")
    (:case :id "wire_spawn_nonexistent_cwd" :kind "wire" :req "(:manage :action spawn :id s1 :cmd \"echo 1\" :cwd \"/nonexistent/dir\")" :want "(:receipt :status :error :id \"s1\" :message \"no directory /nonexistent/dir\")")
    (:case :id "wire_poll_missing_id" :kind "wire" :req "(:manage :action poll)" :want "(:receipt :status :error :message \"Missing id for poll\")")
    (:case :id "wire_poll_not_found" :kind "wire" :req "(:manage :action poll :id nonexistent)" :want "(:receipt :status :not-found :id \"nonexistent\")")
    (:case :id "wire_tail_missing_id" :kind "wire" :req "(:manage :action tail)" :want "(:receipt :status :error :message \"Missing id for tail\")")
    (:case :id "wire_tail_not_found" :kind "wire" :req "(:manage :action tail :id nonexistent)" :want "(:receipt :status :not-found :id \"nonexistent\")")
    (:case :id "wire_kill_missing_id" :kind "wire" :req "(:manage :action kill)" :want "(:receipt :status :error :message \"Missing id for kill\")")
    (:case :id "wire_kill_not_found" :kind "wire" :req "(:manage :action kill :id nonexistent)" :want "(:receipt :status :not-found :id \"nonexistent\")")
    (:case :id "wire_send_missing_id" :kind "wire" :req "(:manage :action send)" :want "(:receipt :status :error :message \"Missing id for send\")")
    (:case :id "wire_send_not_found" :kind "wire" :req "(:manage :action send :id nonexistent :text \"hi\")" :want "(:receipt :status :not-found :id \"nonexistent\")")
    (:case :id "wire_list_empty" :kind "wire" :req "(:manage :action list)" :want "(:receipt :status :ok :sessions [])")
    (:case :id "wire_unknown_op" :kind "wire" :req "(:foobar_op)" :want "(:receipt :status :error :message \"Unknown engine op: foobar_op\")")
    (:case :id "wire_engine_stop" :kind "wire" :req "(:engine :action :stop)" :want "(:receipt :status :ok :engine :stopping :pid 50696 :scope \"workspace\")")
  ])
