(module asl-engine/tests/wire1CoverTest
  :x [runTests]
  :i [(asl-engine/wire :a w)])

fn ! runTests -> Bool
  (let [
    (uNl (w/unescapeStr "a\\nb"))
    (uQuote (w/unescapeStr "\"hi\""))
    (uBs (w/unescapeStr "x\\\\y"))
    (uEmpty (w/unescapeStr ""))
    (uMax (w/unescapeStr (stringJoin (list "a\\nb" "\\\"c\\\"" "x\\\\y") "")))
    (spSpace (w/isSpace? " "))
    (spTab (w/isSpace? "\t"))
    (spNl (w/isSpace? "\n"))
    (spCr (w/isSpace? "\r"))
    (spA (w/isSpace? "a"))
    (spEmpty (w/isSpace? ""))
    (tS "(:ping :id x)")
    (tTok (w/tokenizeLoop tS 0 (stringLength tS) (list)))
    (tTokCount (listLength tTok))
    (tTok0 (match (listGet tTok 0) ((some v) v) ((none) "")))
    (tTok1 (match (listGet tTok 1) ((some v) v) ((none) "")))
    (tTok2 (match (listGet tTok 2) ((some v) v) ((none) "")))
    (tQ ":cmd \"echo hi\"")
    (tQTok (w/tokenizeLoop tQ 0 (stringLength tQ) (list)))
    (tQTok0 (match (listGet tQTok 0) ((some v) v) ((none) "")))
    (tQTok1 (match (listGet tQTok 1) ((some v) v) ((none) "")))
    (tEmpty (w/tokenizeLoop "" 0 0 (list)))
    (tEmptyNone (match (listHead tEmpty) ((none) true) ((some _) false)))
    (args (list (pair ":id" "abc") (pair "cmd" "ls")))
    (ga1 (match (w/getArg args "id") ((some v) v) ((none) "")))
    (gaNone (match (w/getArg args "missing") ((none) true) ((some _) false)))
    (gaEmpty (match (w/getArg (list) "id") ((none) true) ((some _) false)))
    (gaColon (match (w/getArg args ":id") ((some v) v) ((none) "")))
    (gar1 (match (w/getArgRaw args "cmd") ((some v) v) ((none) "")))
    (garNone (match (w/getArgRaw args "missing") ((none) true) ((some _) false)))
    (garRaw (match (w/getArgRaw (list (pair "x" ":val")) "x") ((some v) v) ((none) "")))
    (f1 (w/formatReceiptOk "hi"))
    (f1e (w/formatReceiptOk ""))
    (f2 (w/formatReceiptError "bad thing"))
    (f2n (w/formatReceiptError "a\nb"))
    (f2e (w/formatReceiptError ""))
    (f3 (w/formatReceiptErrorCode "E1" "m"))
    (f4 (w/formatReceiptInvalidId "bad id"))
    (f4Dotdot (w/formatReceiptInvalidId "a..b"))
    (f5 (w/formatReceiptNotFound "s1"))
    (f5e (w/formatReceiptNotFound ""))
    (f6 (w/formatPongOk 42 7 "user"))
    (f6z (w/formatPongOk 0 0 ""))
    (f7 (w/formatPongOffline "user"))
    (f7e (w/formatPongOffline ""))
    (f8 (w/formatPongUnresponsive "timeout"))
    (f8e (w/formatPongUnresponsive ""))
    (f9 (w/formatEngineStatusReceipt 5 60 "12.5" 2 "/tmp/s.sock" "user" "1.0" "1.0" false 0 ""))
    (f10 (w/formatEngineStoppingReceipt 9 "user"))
    (f11 (w/formatEnginePongReceipt 3 10 "user"))
    (f12 (w/formatSleepReceipt "150ms"))
    (f13 (w/formatSocketPathTooLong "/x" 110 108))
    (f14 (w/formatSpawnActiveReceipt "s1" 7))
    (f15 (w/formatPollRunningReceipt "s1" 250))
    (f16 (w/formatPollFinishedReceipt "s1" "exited" 0 100))
    (f16n (w/formatPollFinishedReceipt "s2" "failed" -1 0))
    (f17 (w/formatTailReceipt "s1" (list "a" "b")))
    (f17e (w/formatTailReceipt "s1" (list)))
    (f18 (w/formatKillReceipt "s1"))
    (f19 (w/formatSendReceipt "s1" 0))
    (f20 (w/formatListSessionsReceipt (list "a" "b")))
    (f20e (w/formatListSessionsReceipt (list)))
  ]
    (do
      (assert (= uNl "a\nb") "unescapeStr turns escaped newline into newline")
      (assert (= uQuote "\"hi\"") "unescapeStr turns escaped quote into quote")
      (assert (= uBs "x\\y") "unescapeStr turns double backslash into one")
      (assert (= uEmpty "") "unescapeStr empty string stays empty")
      (assert spSpace "isSpace? space is true")
      (assert spTab "isSpace? tab is true")
      (assert spNl "isSpace? newline is true")
      (assert spCr "isSpace? carriage return is true")
      (assert (not spA) "isSpace? letter is false")
      (assert (not spEmpty) "isSpace? empty string is false")
      (assert (= tTokCount 3) "tokenizeLoop yields three tokens")
      (assert (= tTok0 ":ping") "tokenizeLoop first bare token")
      (assert (= tTok1 ":id") "tokenizeLoop second bare token")
      (assert (= tTok2 "x") "tokenizeLoop bare token stops before closing paren")
      (assert (= tQTok0 ":cmd") "tokenizeLoop quoted input keyword token")
      (assert (= tQTok1 "\"echo hi\"") "tokenizeLoop keeps quoted token with quotes")
      (assert tEmptyNone "tokenizeLoop empty input yields empty list")
      (assert (= ga1 "abc") "getArg finds value by key")
      (assert gaNone "getArg missing key is none")
      (assert gaEmpty "getArg on empty list is none")
      (assert (= gaColon "abc") "getArg strips leading colon from key")
      (assert (= gar1 "ls") "getArgRaw finds raw value")
      (assert garNone "getArgRaw missing key is none")
      (assert (= garRaw ":val") "getArgRaw keeps value unstripped")
      (assert (= f1 "(:receipt :status :ok hi)") "formatReceiptOk normal payload")
      (assert (= f1e "(:receipt :status :ok )") "formatReceiptOk empty payload")
      (assert (= f2 "(:receipt :status :error :message \"bad thing\")") "formatReceiptError normal message")
      (assert (= f2n "(:receipt :status :error :message \"a\\nb\")") "formatReceiptError escapes newline in message")
      (assert (= f2e "(:receipt :status :error :message \"\")") "formatReceiptError empty message")
      (assert (= f3 "(:receipt :status :error :error-code \"E1\" :message \"m\")") "formatReceiptErrorCode normal")
      (assert (= f4 "(:receipt :status :error :error-code \":ERR_INVALID_ID\" :id \"bad id\" :message \"Session id must match [A-Za-z0-9._-]{1,128} and must not contain ..\")") "formatReceiptInvalidId exact text")
      (assert (stringContains? f4Dotdot ":ERR_INVALID_ID") "formatReceiptInvalidId .. rejected")
      (assert (= f5 "(:receipt :status :not-found :id \"s1\")") "formatReceiptNotFound normal id")
      (assert (= f5e "(:receipt :status :not-found :id \"\")") "formatReceiptNotFound empty id")
      (assert (= f6 "(:pong :status :ok :pid 42 :uptimeSec 7 :scope \"user\")") "formatPongOk normal values")
      (assert (= f6z "(:pong :status :ok :pid 0 :uptimeSec 0 :scope \"\")") "formatPongOk zero pid uptime and empty scope")
      (assert (= f7 "(:pong :status :offline :scope \"user\")") "formatPongOffline normal scope")
      (assert (= f7e "(:pong :status :offline :scope \"\")") "formatPongOffline empty scope")
      (assert (= f8 "(:pong :status :unresponsive :error \"timeout\")") "formatPongUnresponsive normal error")
      (assert (= f8e "(:pong :status :unresponsive :error \"\")") "formatPongUnresponsive empty error")
      (assert (= f9 "(:receipt :status :ok :engine :active :pid 5 :uptimeSec 60 :rssMb 12.5 :activeSessions 2 :socket \"/tmp/s.sock\" :scope \"user\" :version \"1.0\" :diskVersion \"1.0\" :stale false :updates 0 :updatedFrom \"\")") "formatEngineStatusReceipt full field set")
      (assert (= f10 "(:receipt :status :ok :engine :stopping :pid 9 :scope \"user\")") "formatEngineStoppingReceipt normal")
      (assert (= f11 "(:receipt :status :ok :op :pong :pid 3 :uptimeSec 10 :scope \"user\")") "formatEnginePongReceipt normal")
      (assert (= f12 "(:receipt :status :ok :op :sleep :slept 150ms)") "formatSleepReceipt normal slept value")
      (assert (= f13 "(:engine :status :error :error-code ERR_SOCKET_PATH_TOO_LONG :path \"/x\" :bytes 110 :limit 108)") "formatSocketPathTooLong normal")
      (assert (= f14 "(:receipt :status :ok :id \"s1\" :pid 7 :state :active)") "formatSpawnActiveReceipt normal")
      (assert (= f15 "(:receipt :status :ok :id \"s1\" :state :running :durationMs 250)") "formatPollRunningReceipt normal")
      (assert (= f16 "(:receipt :status :ok :id \"s1\" :state exited :exitCode 0 :durationMs 100)") "formatPollFinishedReceipt zero exit code")
      (assert (= f16n "(:receipt :status :ok :id \"s2\" :state failed :exitCode -1 :durationMs 0)") "formatPollFinishedReceipt negative exit code and zero duration")
      (assert (= f17 "(:receipt :status :ok :id \"s1\" :lines [\"a\" \"b\"])") "formatTailReceipt two lines")
      (assert (= f17e "(:receipt :status :ok :id \"s1\" :lines [])") "formatTailReceipt empty line list")
      (assert (= f18 "(:receipt :status :ok :id \"s1\" :state :terminated)") "formatKillReceipt normal")
      (assert (= f19 "(:receipt :status :ok :id \"s1\" :sent 0)") "formatSendReceipt zero bytes")
      (assert (= f20 "(:receipt :status :ok :sessions [a b])") "formatListSessionsReceipt two sessions")
      (assert (= f20e "(:receipt :status :ok :sessions [])") "formatListSessionsReceipt empty list")
      true))
