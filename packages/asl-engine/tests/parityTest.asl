(module asl-engine/tests/parityTest
  :x [runTests]
  :i [(asl-engine/breaker :a brk)
      (asl-engine/lease :a lse)
      (asl-engine/engine :a eng)])

fn shellQuote s: String -> String
  (str "'" (stringReplace s "'" "'\\''") "'")

; (:m :ref MAINFIX16 :do "without --root, the CLI subprocess resolves its rootDir from the real toolchain root (bld/entryPath! -> toolRootOf), while the in-process eng/cmdPing! call below is handed an explicit rootDir; under asl train's parallel suites (or just an ambient 'asl engine start' left running in this workspace) that implicit toolchain root can host a real, live resident engine, so the CLI side answers :online while the in-process side -- pointed elsewhere -- answers :offline, and the two never agree. Both sides now target the same fresh .asl/cache/engineParityRoot (created and removed with dirCreate/pathRemove, no bare child) (env -u strips any ambient ASL_ENGINE_* override too) so the comparison is about ping logic, not ambient engine state; the root is removed again once both sides have answered")
fn ! runTests -> Bool
  (let [(root ".asl/cache/engineParityRoot")
        (_freshRoot (pathRemove root))
        (_mkRoot (dirCreate root))
        (envClean "env -u ASL_ENGINE_SOCKET -u ASL_ENGINE_PID_FILE -u ASL_ENGINE_ENTRY -u ASL_ENGINE_SCOPE ")
        (rWs (eng/cmdPing! root "workspace"))
        (rSys (eng/cmdPing! root "system"))
        (rTask (eng/cmdPing! root "task-abc"))
        (cliPingWs (processRun (str envClean "./bin/asl engine --root " (shellQuote root) " ping")))
        (cliPingSys (processRun (str envClean "./bin/asl engine --root " (shellQuote root) " --scope system ping")))
        (cliPingTask (processRun (str envClean "./bin/asl engine --root " (shellQuote root) " --scope task-abc ping")))
        (_cleanupRoot (pathRemove root))
        (longSock "/tmp/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.sock")
        (sockCheck (eng/checkSocketPath longSock true))
        (sockErr (match sockCheck ((err e) e) ((ok _) "")))
        (vTripped (brk/evaluateBreaker "1000\n1010\n1020" 1025 false "/tmp/asl-engine.log"))
        (lseMsg (lse/formatLeaseBusyMessage "/tmp/asl_lse_Z38DCa/engine.sock"))
        (cfg (eng/resolveScope! "/tmp" "workspace"))
        (rt (eng/makeEngineRuntime cfg 1000))
        (resSleep (eng/dispatchRequest! rt "(:sleep :sec 0.1)" 1000))
        (resBadId (eng/dispatchRequest! rt "(:manage :action spawn :id bad..id :cmd \"echo 1\")" 1000))
        (resNoCmd (eng/dispatchRequest! rt "(:manage :action spawn :id s1)" 1000))
        (resNoCwd (eng/dispatchRequest! rt "(:manage :action spawn :id s1 :cmd \"echo 1\" :cwd \"/nonexistent/dir\")" 1000))
        (resPollNoId (eng/dispatchRequest! rt "(:manage :action poll)" 1000))
        (resPollNotFound (eng/dispatchRequest! rt "(:manage :action poll :id nonexistent)" 1000))
        (resTailNoId (eng/dispatchRequest! rt "(:manage :action tail)" 1000))
        (resTailNotFound (eng/dispatchRequest! rt "(:manage :action tail :id nonexistent)" 1000))
        (resKillNoId (eng/dispatchRequest! rt "(:manage :action kill)" 1000))
        (resKillNotFound (eng/dispatchRequest! rt "(:manage :action kill :id nonexistent)" 1000))
        (resSendNoId (eng/dispatchRequest! rt "(:manage :action send)" 1000))
        (resSendNotFound (eng/dispatchRequest! rt "(:manage :action send :id nonexistent :text \"hi\")" 1000))
        (resListEmpty (eng/dispatchRequest! rt "(:manage :action list)" 1000))
        (resUnknownOp (eng/dispatchRequest! rt "(:foobar_op)" 1000))
        (resEngineStop (eng/dispatchRequest! rt "(:engine :action :stop)" 1000))]
    (do
      (assert (= rWs "(:pong :status :offline :scope \"workspace\")") "unit: ping offline workspace")
      (assert (= rSys "(:pong :status :offline :scope \"system\")") "unit: ping offline system")
      (assert (= rTask "(:pong :status :offline :scope \"task-abc\")") "unit: ping offline task")
      (assert (= cliPingWs.exitCode 0) "runtime workspace ping exits successfully")
      (assert (= (stringTrim cliPingWs.stdout) rWs) "workspace ping matches the engine CLI")
      (assert (= cliPingSys.exitCode 0) "runtime system ping exits successfully")
      (assert (= (stringTrim cliPingSys.stdout) rSys) "system ping matches the engine CLI")
      (assert (= cliPingTask.exitCode 0) "runtime task ping exits successfully")
      (assert (= (stringTrim cliPingTask.stdout) rTask) "task ping matches the engine CLI")
      (assert (= sockErr "(:engine :status :error :error-code ERR_SOCKET_PATH_TOO_LONG :path \"/tmp/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.sock\" :bytes 120 :limit 104)") "unit: socket path too long receipt")
      (assert vTripped.tripped "unit: breaker tripped state")
      (assert (= vTripped.message "=== [ASL ENGINE CIRCUIT BREAKER TRIPPED] ===\nEngine has restarted 3 times within the last 30 seconds.\nHalting automatic restart loop to prevent flapping / restart storm.\nUse 'asl engine restart --force' to override or inspect logs at /tmp/asl-engine.log.") "unit: breaker tripped message")
      (assert (= lseMsg "[Engine] Engine already active for socket /tmp/asl_lse_Z38DCa/engine.sock (lock held).") "unit: lease held message")
      (assert (= (pairSecond resSleep) "(:receipt :status :ok :op :sleep :slept 0.1)") "unit: sleep receipt")
      (assert (= (pairSecond resBadId) "(:receipt :status :error :error-code \":ERR_INVALID_ID\" :id \"bad..id\" :message \"Session id must match [A-Za-z0-9._-]{1,128} and must not contain ..\")") "unit: bad id receipt")
      (assert (= (pairSecond resNoCmd) "(:receipt :status :error :message \"Missing :cmd for spawn\")") "unit: spawn missing cmd")
      (assert (= (pairSecond resNoCwd) "(:receipt :status :error :id \"s1\" :message \"no directory /nonexistent/dir\")") "unit: spawn nonexistent cwd")
      (assert (= (pairSecond resPollNoId) "(:receipt :status :error :message \"Missing id for poll\")") "unit: poll missing id")
      (assert (= (pairSecond resPollNotFound) "(:receipt :status :not-found :id \"nonexistent\")") "unit: poll not found")
      (assert (= (pairSecond resTailNoId) "(:receipt :status :error :message \"Missing id for tail\")") "unit: tail missing id")
      (assert (= (pairSecond resTailNotFound) "(:receipt :status :not-found :id \"nonexistent\")") "unit: tail not found")
      (assert (= (pairSecond resKillNoId) "(:receipt :status :error :message \"Missing id for kill\")") "unit: kill missing id")
      (assert (= (pairSecond resKillNotFound) "(:receipt :status :not-found :id \"nonexistent\")") "unit: kill not found")
      (assert (= (pairSecond resSendNoId) "(:receipt :status :error :message \"Missing id for send\")") "unit: send missing id")
      (assert (= (pairSecond resSendNotFound) "(:receipt :status :not-found :id \"nonexistent\")") "unit: send not found")
      (assert (= (pairSecond resListEmpty) "(:receipt :status :ok :sessions [])") "unit: list empty")
      (assert (= (pairSecond resUnknownOp) "(:receipt :status :error :message \"Unknown engine op: foobar_op\")") "unit: unknown op")
      (assert (stringStartsWith? (pairSecond resEngineStop) "(:receipt :status :ok :engine :stopping :pid ") "unit: engine stop")
      true))
