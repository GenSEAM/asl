(module aslAgentBus/tests/priorityBusTest
  :x [RunTests runTests]
  :i [(bus :a b)])

fn testMessagePriorityClassification -> Bool
  (let [(msgP0Abort (b/AgentMessage :sender "supervisor" :target "worker1" :payload "(:abort :reason \"timeout\")" :timestamp 100))
        (msgP0Cancel (b/AgentMessage :sender "supervisor" :target "worker2" :payload "(:cancel :task \"t9\")" :timestamp 101))
        (msgP0Breaker (b/AgentMessage :sender "circuit" :target "bus" :payload "(:circuit-breaker :trip true)" :timestamp 102))
        (msgP1Audit (b/AgentMessage :sender "verifier" :target "bus" :payload "(:audit :receipt \"pass\")" :timestamp 103))
        (msgP1Wake (b/AgentMessage :sender "timer" :target "agent" :payload "(:wake :condition \"ready\")" :timestamp 104))
        (msgP2Data (b/AgentMessage :sender "author" :target "reviewer" :payload "(:diff :file \"foo.asl\")" :timestamp 105))
        (msgP3Telem (b/AgentMessage :sender "worker1" :target "bus" :payload "(:sparkline :cpu 12)" :timestamp 106))
        (msgP3Metric (b/AgentMessage :sender "worker2" :target "bus" :payload "(:metric :heap 512)" :timestamp 107))
        (p0Abort (b/classifyMessagePriority msgP0Abort))
        (p0Cancel (b/classifyMessagePriority msgP0Cancel))
        (p0Breaker (b/classifyMessagePriority msgP0Breaker))
        (p1Audit (b/classifyMessagePriority msgP1Audit))
        (p1Wake (b/classifyMessagePriority msgP1Wake))
        (p2Data (b/classifyMessagePriority msgP2Data))
        (p3Telem (b/classifyMessagePriority msgP3Telem))
        (p3Metric (b/classifyMessagePriority msgP3Metric))]
    (assert (mt p0Abort ((prioP0Control) true) (_ false)) "msgP0Abort classified as P0 Control")
    (assert (mt p0Cancel ((prioP0Control) true) (_ false)) "msgP0Cancel classified as P0 Control")
    (assert (mt p0Breaker ((prioP0Control) true) (_ false)) "msgP0Breaker classified as P0 Control")
    (assert (mt p1Audit ((prioP1Audit) true) (_ false)) "msgP1Audit classified as P1 Audit")
    (assert (mt p1Wake ((prioP1Audit) true) (_ false)) "msgP1Wake classified as P1 Audit")
    (assert (mt p2Data ((prioP2Data) true) (_ false)) "msgP2Data classified as P2 Data")
    (assert (mt p3Telem ((prioP3Telemetry) true) (_ false)) "msgP3Telem classified as P3 Telemetry")
    (assert (mt p3Metric ((prioP3Telemetry) true) (_ false)) "msgP3Metric classified as P3 Telemetry")
    (refute (mt p0Abort ((prioP2Data) true) (_ false)) "Refutation: P0 Abort cannot be P2 Data")
    (refute (mt p1Audit ((prioP3Telemetry) true) (_ false)) "Refutation: P1 Audit cannot be P3 Telemetry")
    (refute (mt p3Telem ((prioP0Control) true) (_ false)) "Refutation: P3 Telem cannot be P0 Control")
    true)

fn testPriorityQueueOrderingAndPreemption -> Bool
  (let [(q0 (b/makePriorityBusQueue))
        (msgTelem (b/AgentMessage :sender "w1" :target "bus" :payload "(:sparkline :mem 80)" :timestamp 200))
        (msgData (b/AgentMessage :sender "w2" :target "w3" :payload "(:ast :node 42)" :timestamp 201))
        (msgAudit (b/AgentMessage :sender "v1" :target "bus" :payload "(:audit :receipt \"green\")" :timestamp 202))
        (msgAbort (b/AgentMessage :sender "sup" :target "w1" :payload "(:abort :now true)" :timestamp 203))
        (q1 (b/pushPriorityEvent q0 msgTelem))
        (q2 (b/pushPriorityEvent q1 msgData))
        (q3 (b/pushPriorityEvent q2 msgAudit))
        (q4 (b/pushPriorityEvent q3 msgAbort))
        (len4 (b/priorityQueueLength q4))
        (popRes1 (b/popPriorityEvent q4))
        (qAfter1 (pairFirst popRes1))
        (optMsg1 (pairSecond popRes1))
        (popRes2 (b/popPriorityEvent qAfter1))
        (qAfter2 (pairFirst popRes2))
        (optMsg2 (pairSecond popRes2))
        (popRes3 (b/popPriorityEvent qAfter2))
        (qAfter3 (pairFirst popRes3))
        (optMsg3 (pairSecond popRes3))
        (popRes4 (b/popPriorityEvent qAfter3))
        (qAfter4 (pairFirst popRes4))
        (optMsg4 (pairSecond popRes4))
        (popRes5 (b/popPriorityEvent qAfter4))
        (optMsg5 (pairSecond popRes5))
        (lenFinal (b/priorityQueueLength (pairFirst popRes5)))]
    (assert (= len4 4) "Queue length is 4 after pushing 4 distinct priority events")
    (assert (mt optMsg1 ((some m) (stringContains? m.payload ":abort")) ((none) false)) "First popped message is P0 Abort supervisory signal")
    (assert (mt optMsg2 ((some m) (stringContains? m.payload ":audit")) ((none) false)) "Second popped message is P1 Audit verification signal")
    (assert (mt optMsg3 ((some m) (stringContains? m.payload ":ast")) ((none) false)) "Third popped message is P2 Data standard payload")
    (assert (mt optMsg4 ((some m) (stringContains? m.payload ":sparkline")) ((none) false)) "Fourth popped message is P3 Telemetry low-priority metric")
    (assert (mt optMsg5 ((some _) false) ((none) true)) "Fifth pop on empty queue returns none")
    (assert (= lenFinal 0) "Queue length is 0 after draining all lanes")
    (refute (= len4 0) "Refutation: Queue length cannot be 0 after 4 pushes")
    (refute (mt optMsg1 ((some m) (stringContains? m.payload ":sparkline")) ((none) false)) "Refutation: Telemetry must never preempt supervisory control")
    true)

fn testAntiStarvationSlot -> Bool
  (let [(q0 (b/makePriorityBusQueue))
        (mD1 (b/AgentMessage :sender "a" :target "b" :payload "(:diff :hunk 1)" :timestamp 301))
        (mD2 (b/AgentMessage :sender "a" :target "b" :payload "(:diff :hunk 2)" :timestamp 302))
        (mD3 (b/AgentMessage :sender "a" :target "b" :payload "(:diff :hunk 3)" :timestamp 303))
        (mD4 (b/AgentMessage :sender "a" :target "b" :payload "(:diff :hunk 4)" :timestamp 304))
        (mT1 (b/AgentMessage :sender "w" :target "bus" :payload "(:sparkline :val 99)" :timestamp 305))
        (q1 (b/pushPriorityEvent q0 mD1))
        (q2 (b/pushPriorityEvent q1 mD2))
        (q3 (b/pushPriorityEvent q2 mD3))
        (q4 (b/pushPriorityEvent q3 mD4))
        (q5 (b/pushPriorityEvent q4 mT1))
        (p1 (b/popPriorityEvent q5))
        (p2 (b/popPriorityEvent (pairFirst p1)))
        (p3 (b/popPriorityEvent (pairFirst p2)))
        (p4 (b/popPriorityEvent (pairFirst p3)))
        (p5 (b/popPriorityEvent (pairFirst p4)))
        (opt4 (pairSecond p4))
        (opt5 (pairSecond p5))]
    (assert (mt opt4 ((some m) (stringContains? m.payload ":sparkline")) ((none) false)) "Pop 4 serves P3 telemetry after 3 consecutive high-priority events (anti-starvation)")
    (assert (mt opt5 ((some m) (stringContains? m.payload ":diff :hunk 4")) ((none) false)) "Pop 5 serves remaining P2 data event")
    (refute (mt opt4 ((some m) (stringContains? m.payload ":diff :hunk 4")) ((none) false)) "Refutation: P3 must not be starved indefinitely")
    true)

fn testMessageTtlExpiration -> Bool
  (let [(msgFresh (b/AgentMessage :sender "s1" :target "t1" :payload "(:diff :fresh true)" :timestamp 1000))
        (msgExpired (b/AgentMessage :sender "s2" :target "t2" :payload "(:diff :expired true)" :timestamp 500))
        (isFreshExpired (b/isExpiredMessage? msgFresh 1100 200))
        (isOldExpired (b/isExpiredMessage? msgExpired 1100 200))
        (q0 (b/makePriorityBusQueue))
        (q1 (b/pushPriorityEvent q0 msgExpired))
        (q2 (b/pushPriorityEvent q1 msgFresh))
        (popRes (b/popPriorityEventTimed q2 1100 200))
        (qRemaining (pairFirst popRes))
        (poppedMsg (pairSecond popRes))]
    (assert (not isFreshExpired) "Fresh message within TTL is not expired")
    (refute isFreshExpired "Refutation: Fresh message must not be flagged as expired")
    (assert isOldExpired "Old message exceeding TTL is expired")
    (refute (not isOldExpired) "Refutation: Stale message must be flagged as expired")
    (assert (mt poppedMsg ((some m) (stringContains? m.payload ":fresh")) ((none) false)) "Timed pop drops expired message and pops fresh message")
    (assert (= (b/priorityQueueLength qRemaining) 0) "Queue is empty after dropping expired and popping fresh")
    (refute (mt poppedMsg ((some m) (stringContains? m.payload ":expired")) ((none) false)) "Refutation: Expired message must never be popped")
    true)

fn testFairQueuingUnderP0Flood -> Bool
  (let [(q0 (b/makePriorityBusQueue))
        (mP0A (b/AgentMessage :sender "sup" :target "bus" :payload "(:abort :id 1)" :timestamp 100))
        (mP0B (b/AgentMessage :sender "sup" :target "bus" :payload "(:abort :id 2)" :timestamp 101))
        (mP0C (b/AgentMessage :sender "sup" :target "bus" :payload "(:abort :id 3)" :timestamp 102))
        (mP0D (b/AgentMessage :sender "sup" :target "bus" :payload "(:abort :id 4)" :timestamp 103))
        (mP1Audit (b/AgentMessage :sender "aud" :target "bus" :payload "(:audit :id 1)" :timestamp 104))
        (q1 (b/pushPriorityEvent q0 mP0A))
        (q2 (b/pushPriorityEvent q1 mP0B))
        (q3 (b/pushPriorityEvent q2 mP0C))
        (q4 (b/pushPriorityEvent q3 mP0D))
        (q5 (b/pushPriorityEvent q4 mP1Audit))
        (p1 (b/popPriorityEvent q5))
        (p2 (b/popPriorityEvent (pairFirst p1)))
        (p3 (b/popPriorityEvent (pairFirst p2)))
        (p4 (b/popPriorityEvent (pairFirst p3)))
        (optP4 (pairSecond p4))]
    (assert (mt optP4 ((some m) (stringContains? m.payload ":audit :id 1")) ((none) false)) "Pop 4 serves P1 audit during continuous P0 flood (multi-lane anti-starvation)")
    (refute (mt optP4 ((some m) (stringContains? m.payload ":abort :id 4")) ((none) false)) "Refutation: P1 audit must not be starved by P0 flood")
    true)

fn testIpcMessageFrameSerialization -> Bool
  (let [(frame (b/makeIpcMessageFrame "control" "w1" "w2" "(:msg 1)" 1000))
        (packed (b/packIpcFrame frame))
        (unpacked (b/unpackIpcFrame packed))
        (corrupted (str "control\u001fw1\u001fw2\u001f(:corrupted)\u001f1000\u001f" (stringFromInt64 frame.checksum)))
        (unpackedCorrupted (b/unpackIpcFrame corrupted))]
    (assert (> (stringLength packed) 0) "packed IPC frame is non-empty")
    (assert (some? unpacked) "unpacked IPC frame is valid")
    (assert (b/verifyIpcFrame frame) "frame passes checksum verification")
    (assert (none? unpackedCorrupted) "unpack rejects corrupted payload with invalid checksum")
    (refute (some? unpackedCorrupted) "corrupted IPC frame refutes successful unpacking")
    true)

fn runTests -> Bool
  (let [(t1 (testMessagePriorityClassification))
        (t2 (testPriorityQueueOrderingAndPreemption))
        (t3 (testAntiStarvationSlot))
        (t4 (testMessageTtlExpiration))
        (t5 (testFairQueuingUnderP0Flood))
        (t6 (testInFlightAckProtocol))
        (t7 (testInFlightNackAndDeadLetterQueue))
        (t8 (testStarvationEscapeStrictPriorityOrdering))
        (t9 (testIpcMessageFrameSerialization))]
    (and (and (and (and (and (and (and (and t1 t2) t3) t4) t5) t6) t7) t8) t9))

fn testInFlightAckProtocol -> Bool
  (let [(q0 (b/makePriorityBusQueue))
        (msg (b/AgentMessage :sender "w1" :target "w2" :payload "(:task :id \"t1\")" :timestamp 100))
        (q1 (b/pushPriorityEvent q0 msg))
        (popRes (b/popPriorityEventLeased q1 "inflight-1" 150))
        (qPopped (pairFirst popRes))
        (optPopped (pairSecond popRes))
        (inFlightCountBefore (listLength qPopped.inFlight))
        (qAcked (b/busAckMessage qPopped "inflight-1"))
        (inFlightCountAfter (listLength qAcked.inFlight))]
    (do
      (assert (mt optPopped ((some m) (= m.sender "w1")) ((none) false)) "Message was popped and leased")
      (assert (= inFlightCountBefore 1) "In-flight message list has 1 element before ACK")
      (assert (= inFlightCountAfter 0) "In-flight message list is empty after ACK")
      (refute (= inFlightCountBefore 0) "Refutation: In-flight count must not be 0 before ACK")
      (refute (= inFlightCountAfter 1) "Refutation: In-flight count must not remain 1 after ACK")
      true))

fn testInFlightNackAndDeadLetterQueue -> Bool
  (let [(q0 (b/makePriorityBusQueue))
        (msg (b/AgentMessage :sender "w1" :target "w2" :payload "(:diff :payload \"failing\")" :timestamp 200))
        (q1 (b/pushPriorityEvent q0 msg))
        (pop1 (b/popPriorityEventLeased q1 "inflight-fail" 250))
        (qInFlight (pairFirst pop1))
        (qNacked1 (b/busNackMessage qInFlight "inflight-fail" 2))
        (inFlightAfterNack1 (listLength qNacked1.inFlight))
        (stats1 (b/busDlqStats qNacked1))
        (dlqCount1 stats1.totalCount)
        (pop2 (b/popPriorityEventLeased qNacked1 "inflight-fail" 260))
        (qInFlight2 (pairFirst pop2))
        (qNacked2 (b/busNackMessage qInFlight2 "inflight-fail" 2))
        (stats2 (b/busDlqStats qNacked2))
        (dlqCount2 stats2.totalCount)
        (drainRes (b/busDlqDrain qNacked2))
        (qDrained (pairFirst drainRes))
        (drainedList (pairSecond drainRes))
        (statsAfterDrain (b/busDlqStats qDrained))]
    (do
      (assert (= inFlightAfterNack1 0) "In-flight buffer cleared after NACK retry")
      (assert (= dlqCount1 0) "Message re-enqueued on first NACK retry, DLQ count is 0")
      (assert (= dlqCount2 1) "Message moved to DLQ after reaching max retries")
      (assert (= (listLength drainedList) 1) "Drained DLQ contains exactly 1 dead-lettered message")
      (assert (= statsAfterDrain.totalCount 0) "DLQ stats totalCount is 0 after drain")
      (refute (= dlqCount2 0) "Refutation: DLQ count must not be 0 after exceeding max retries")
      (refute (= (listLength drainedList) 0) "Refutation: Drained list must not be empty")
      true))

fn testStarvationEscapeStrictPriorityOrdering -> Bool
  (let [(q0 (b/makePriorityBusQueue))
        (mP0A (b/AgentMessage :sender "sup" :target "bus" :payload "(:abort :id 1)" :timestamp 100))
        (mP0B (b/AgentMessage :sender "sup" :target "bus" :payload "(:abort :id 2)" :timestamp 101))
        (mP0C (b/AgentMessage :sender "sup" :target "bus" :payload "(:abort :id 3)" :timestamp 102))
        (mP0D (b/AgentMessage :sender "sup" :target "bus" :payload "(:abort :id 4)" :timestamp 103))
        (mP1Audit (b/AgentMessage :sender "aud" :target "bus" :payload "(:audit :receipt \"p1-critical\")" :timestamp 104))
        (mP3Telem (b/AgentMessage :sender "w1" :target "bus" :payload "(:sparkline :cpu 99)" :timestamp 105))
        (q1 (b/pushPriorityEvent q0 mP0A))
        (q2 (b/pushPriorityEvent q1 mP0B))
        (q3 (b/pushPriorityEvent q2 mP0C))
        (q4 (b/pushPriorityEvent q3 mP0D))
        (q5 (b/pushPriorityEvent q4 mP3Telem))
        (q6 (b/pushPriorityEvent q5 mP1Audit))
        (p1 (b/popPriorityEvent q6))
        (p2 (b/popPriorityEvent (pairFirst p1)))
        (p3 (b/popPriorityEvent (pairFirst p2)))
        (p4 (b/popPriorityEvent (pairFirst p3)))
        (optP4 (pairSecond p4))]
    (do
      (assert (mt optP4 ((some m) (stringContains? m.payload ":audit :receipt \"p1-critical\"")) ((none) false)) "Starvation escape serves P1 audit before P3 telemetry under P0 flood")
      (refute (mt optP4 ((some m) (stringContains? m.payload ":sparkline")) ((none) false)) "Refutation: P3 telemetry must not steal starvation slot ahead of P1 audit")
      true))

fn RunTests -> Bool
  (runTests)
