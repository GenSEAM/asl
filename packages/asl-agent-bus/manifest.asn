(:package aslAgentBus
 :version "0.1.0"
 :entry "src/bus.asl"
 :description "High-frequency in-memory agent-to-agent communication mesh"
 :aslFirst true
 :modules [
   "aslAgentBus/ambient"
   "aslAgentBus/bridge"
   "aslAgentBus/browserBridge"
   "aslAgentBus/bus"
   "aslAgentBus/cluster"
   "aslAgentBus/gateway"
   "aslAgentBus/mesh"
   "aslAgentBus/mvccBus"
   "aslAgentBus/ndAsn"
   "aslAgentBus/presence"
   "aslAgentBus/procTelemetry"
   "aslAgentBus/toolPlane"
   "aslAgentBus/transport"
   "aslAgentBus/types"
   "aslAgentBus/wire"
   "aslAgentBus/networkBridge"
   "aslAgentBus/asnlRing"
   "aslAgentBus/transportPatch"
 ]
 :dependencies ["asl-contracts" "asl-text" "asl-agent-core"])
