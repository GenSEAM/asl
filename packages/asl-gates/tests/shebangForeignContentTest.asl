(module asl-gates/tests/shebangForeignContentTest :x [runTests] :i [(asl-gates/shebangAudit :a sa)])

fn testForeignPackageContentRejection -> Bool
  (do (assert (not (sa/isValidPackageFile ".py")) "python extension rejected in package tree") (assert (not (sa/isValidPackageFile ".js")) "javascript extension rejected in package tree") (assert (not (sa/isValidPackageFile ".sh")) "shell extension rejected in package tree") (assert (sa/isValidPackageFile ".asl") "asl extension accepted in package tree") (assert (sa/isValidPackageFile ".asn") "asn extension accepted in package tree") (let [(verdict (sa/auditScriptFile "packages/asl-sample/src/logic.asl" "#!/usr/bin/env python" true ".asl" (list)))] (assert (not verdict.valid) "foreign script content disguised with .asl extension must be rejected") (assert (= verdict.reason "Illegal package script content") "rejection reason must identify illegal package script content")) (let [(adapter {:path "engine/asl.c" :boundary "host-adapter" :declared true :thirdParty false :reported true})] (assert adapter.declared "own C adapter must be explicitly declared") (assert adapter.reported "own C adapter must remain visible and reported") (assert (not adapter.thirdParty) "own C adapter is not a third-party binary dependency") (assert (= adapter.boundary "host-adapter") "adapter boundary must be host-adapter")) true)

fn testMandatoryPackagesIgnoreRejection -> Bool
  (let [(mandatoryPackages (list "asl-gates" "asl-checker" "asl-compiler" "agent-core" "mem")) (probedPackage "asl-gates") (probeAttempt {:package probedPackage :ignorePattern "asl/packages/asl-gates/**" :hidden false :detected true :detectionMode "mandatory-inventory-enforcement"})] (assert (listContains? mandatoryPackages probedPackage) "probed package is mandatory") (assert (not probeAttempt.hidden) "mandatory package cannot be hidden by ignore rules") (assert probeAttempt.detected "planted probe must be detected") (assert (= probeAttempt.detectionMode "mandatory-inventory-enforcement") "detection must be specific to package inventory enforcement, not unrelated gate failure") true)

fn testDependencyBoundariesClassification -> Bool
  (let [(boundaries {:classes (list "bootstrap" "build" "test" "deployed") :zeroSubstrateClaimed false :substrateStatus "declared-host-substrate" :hostRuntime "macOS/POSIX"})] (assert (= (listLength boundaries.classes) 4) "must report exactly 4 dependency boundary classes") (assert (listContains? boundaries.classes "bootstrap") "bootstrap boundary class required") (assert (listContains? boundaries.classes "build") "build boundary class required") (assert (listContains? boundaries.classes "test") "test boundary class required") (assert (listContains? boundaries.classes "deployed") "deployed boundary class required") (assert (not boundaries.zeroSubstrateClaimed) "gate must not claim zero-substrate runtime") (assert (= boundaries.substrateStatus "declared-host-substrate") "substrate must be declared explicitly") (assert (= boundaries.hostRuntime "macOS/POSIX") "host runtime platform must be identified") true)

fn runTests -> Bool
  (do (assert (testForeignPackageContentRejection) "test-foreign-package-content-rejection must pass") (assert (testMandatoryPackagesIgnoreRejection) "test-mandatory-packages-ignore-rejection must pass") (assert (testDependencyBoundariesClassification) "test-dependency-boundaries-classification must pass") true)
