(module asl-gates/tests/vacuityArgvTest :x [runTests] :i [(asl-gates/vacuity :a vac)])

fn ! runTests -> Bool
  (let [(repo "/tmp/asl PR1 repo '$(touch PWNED) ; touch PWNED2")
        (work "/tmp/asl PR1 work '$(touch PWNED) ; touch PWNED2")
        (name "test candidate space ' $(touch PWNED) ; touch PWNED2.asl")
        (src (str repo "/" name))
        (dst (str work "/" name))]
    (do
      (pathRemove repo)
      (pathRemove work)
      (pathRemove "PWNED")
      (pathRemove "PWNED2")
      (dirCreate repo)
      (fileWrite src (stringToBytes "candidate contents"))
      (fileChmod src 493)
      (vac/runAt! (list "/usr/bin/touch" "-t" "200001010000" src) (none))
      (dirCreate (str work "/tests/fixtures"))
      (dirCreate (str repo "/tests/fixtures/nested"))
      (fileWrite (str repo "/tests/fixtures/nested/data.txt") (stringToBytes "nested fixture"))
      (vac/runAt! (list "git" "init" "-q" repo) (none))
      (vac/copyUncommittedTestFiles! repo work "true")
      (dirCreate (str repo "/tree/nested"))
      (fileWrite (str repo "/tree/nested/leaf.txt") (stringToBytes "merged leaf"))
      (dirCreate (str work "/tree"))
      (fileWrite (str repo "/locked.txt") (stringToBytes "unreadable"))
      (fileChmod (str repo "/locked.txt") 0)
      (let [(candidateOk (and (fileExists? dst) (= (mt (fileReadString dst) ((ok text) text) ((err _) "")) "candidate contents")))
            (modeOk (= (mt (fileStat src) ((ok stat) stat.mode) ((err _) 0)) (mt (fileStat dst) ((ok stat) stat.mode) ((err _) 0))))
            (timeOk (= (mt (fileStat src) ((ok stat) stat.mtimeNs) ((err _) 0)) (mt (fileStat dst) ((ok stat) stat.mtimeNs) ((err _) 0))))
            (dirOk (= (mt (fileReadString (str work "/tests/fixtures/nested/data.txt")) ((ok text) text) ((err _) "")) "nested fixture"))
            (readErrorOk (not (vac/copyFileTo! (str repo "/missing") (str work "/missing"))))
            (_ (fileWrite (str work "/blocked") (stringToBytes "not a directory")))
            (writeErrorOk (not (vac/copyFileTo! src (str work "/blocked/child"))))
            (mergeOk (and (vac/copyFileTo! (str repo "/tree") (str work "/tree"))
                          (= (mt (fileReadString (str work "/tree/nested/leaf.txt")) ((ok text) text) ((err _) "")) "merged leaf")
                          (not (fileExists? (str work "/tree/tree")))))
            (copyErrorOk (not (vac/copyFileTo! (str repo "/locked.txt") (str work "/locked.txt"))))
            (rawOut (vac/runAt! (list "/bin/sh" "-c" "printf 'raw\\n\\n'; printf 'err\\n' >&2") (none)))
            (rawOk (and (= rawOut.stdout "raw\n\n") (= rawOut.stderr "err\n")))
            (records (vac/statusRecords (str "R  tests/new name.asl" "\u0000" "tests/old.asl" "\u0000" "?? tests/t a;b.sh" "\u0000")))
            (recordsOk (= records (list "R  tests/new name.asl" "?? tests/t a;b.sh")))
            (captured (vac/runAt! (list "/bin/sh" "-c" "printf process-out; printf process-err >&2") (none)))
            (closedOut (vac/runAt! (list "/bin/sh" "-c" "exec 1>&-; sleep 0.1; printf delayed >&2") (none)))
            (cwdOut (vac/runAt! (list "/bin/pwd") (some repo)))
            (streamsOk (and (= closedOut.stdout "") (= closedOut.stderr "delayed")))
            (cwdOk (stringContains? cwdOut.stdout "asl PR1 repo"))
            (stdoutOk (= captured.stdout "process-out"))
            (stderrOk (= captured.stderr "process-err"))
            (safeOk (and (not (fileExists? "PWNED")) (not (fileExists? "PWNED2"))))]
        (do
          (pathRemove repo)
          (pathRemove work)
          (pathRemove "PWNED")
          (pathRemove "PWNED2")
          (assert candidateOk "a hostile untracked name from real git status is copied verbatim")
          (assert modeOk "copy preserves file permissions")
          (assert timeOk "copy preserves file timestamps")
          (assert dirOk "untracked fixture files listed by git status -z are copied")
          (assert mergeOk "a directory copies into an existing destination directory without nesting")
          (assert copyErrorOk "copy reports a cp failure on an unreadable source")
          (assert rawOk "vacuity process reader keeps trailing newlines raw")
          (assert recordsOk "status records split on NUL and drop rename origins")
          (assert readErrorOk "copy reports source read failures")
          (assert writeErrorOk "copy reports destination write failures")
          (assert stdoutOk "vacuity process reader retains stdout")
          (assert streamsOk "vacuity reader keeps an already-closed stdout clean while stderr remains open")
          (assert cwdOk "vacuity process runs in the requested working directory")
          (assert stderrOk "vacuity process reader retains stderr")
          (assert safeOk "path text never executes shell substitutions")
          true))))
