(module asl-gates/tests/siteClaimsRejectionTest :x [runTests] :i [(asl-gates/siteClaims :a sc)])

fn testClaimEvidenceRejectionReasons -> Bool
  (let [(missingSourceClaim {:metric "-64.7%" :source "bench/nonexistent_file.py" :fixtureDigest "sha256-abc123" :lockValue "-64.7%" :measuredValue "-64.7%" :grounded false :reason "missing-source"}) (wrongDigestClaim {:metric "-64.7%" :source "bench/token_frames.lock" :fixtureDigest "sha256-wrong-digest" :lockValue "-64.7%" :measuredValue "-64.7%" :grounded false :reason "wrong-fixture-digest"}) (wrongMetricClaim {:metric "bogus-compression-ratio" :source "bench/token_frames.lock" :fixtureDigest "sha256-valid-digest" :lockValue "bogus-compression-ratio" :measuredValue "bogus-compression-ratio" :grounded false :reason "wrong-metric"}) (mismatchedLockClaim {:metric "-64.7%" :source "bench/token_frames.lock" :fixtureDigest "sha256-valid-digest" :lockValue "-64.7%" :measuredValue "-12.3%" :grounded false :reason "mismatched-lock-value"})] (assert (not missingSourceClaim.grounded) "missing source must not be grounded") (assert (= missingSourceClaim.reason "missing-source") "missing source must fail with reason missing-source") (assert (not wrongDigestClaim.grounded) "wrong fixture digest must not be grounded") (assert (= wrongDigestClaim.reason "wrong-fixture-digest") "wrong digest must fail with reason wrong-fixture-digest") (assert (not wrongMetricClaim.grounded) "wrong metric must not be grounded") (assert (= wrongMetricClaim.reason "wrong-metric") "wrong metric must fail with reason wrong-metric") (assert (not mismatchedLockClaim.grounded) "mismatched lock value must not be grounded") (assert (= mismatchedLockClaim.reason "mismatched-lock-value") "mismatched lock must fail with reason mismatched-lock-value") (assert (not (= missingSourceClaim.reason wrongDigestClaim.reason)) "missing source and wrong digest reasons must be distinct") (assert (not (= wrongDigestClaim.reason wrongMetricClaim.reason)) "wrong digest and wrong metric reasons must be distinct") (assert (not (= wrongMetricClaim.reason mismatchedLockClaim.reason)) "wrong metric and mismatched lock reasons must be distinct") true)

fn testEmptyCatalogRejection -> Bool
  (let [(emptyCatalog (list)) (registry (sc/standardClaims)) (report (sc/runClaimsAudit emptyCatalog registry)) (validClaim {:metric "-64.7%" :source "bench/token_frames.lock" :fixtureDigest "sha256-valid-digest" :lockValue "-64.7%" :measuredValue "-64.7%" :grounded true :reason "reproduced-and-verified"})] (assert (= validClaim.grounded true) "valid claim must be grounded") (assert (= validClaim.reason "reproduced-and-verified") "valid claim must be reproduced and verified") (assert (= report.status "FAIL") "empty catalog must produce status FAIL") (assert (> report.total 0) "non-empty expected inventory is required") true)

fn testFileExistenceInsufficiency -> Bool
  (let [(unverifiedClaim {:metric "<100ms" :source "packages/asl-eddie/benchmark/run.js" :fileExists true :runnerLabel "success" :lockValue "<100ms" :measuredValue "unmeasured" :numericalAgreement false :grounded false :reason "unverified-numerical-agreement"})] (assert unverifiedClaim.fileExists "source file exists") (assert (= unverifiedClaim.runnerLabel "success") "runner label indicates success") (assert (not unverifiedClaim.numericalAgreement) "numerical agreement is absent") (assert (not unverifiedClaim.grounded) "claim without numerical agreement must not be grounded") (assert (= unverifiedClaim.reason "unverified-numerical-agreement") "rejection reason must identify unverified numerical agreement") (assert (not (= unverifiedClaim.lockValue unverifiedClaim.measuredValue)) "lock value and measured value must match for grounding") true)

fn runTests -> Bool
  (do (assert (testClaimEvidenceRejectionReasons) "test-claim-evidence-rejection-reasons must pass") (assert (testEmptyCatalogRejection) "test-empty-catalog-rejection must pass") (assert (testFileExistenceInsufficiency) "test-file-existence-insufficiency must pass") true)
