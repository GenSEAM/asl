(:doc :symbol "asl/packages/asl-gates/tests/gatesTest.asl#" :text "Unit tests for pure AgentScript verification gate runners.")
(:doc :symbol "asl/packages/asl-gates/tests/gatesTest.asl#testAllowlistedPathsMissingFileIsError" :text "a missing allowlist must surface as an error, never as an empty allowlist that silently reports every candidate clean")
(:doc :symbol "asl/packages/asl-gates/tests/gatesTest.asl#testAuditPackageTreeZeroForeignMissingAllowlistIsRed" :text "gate4's violation channel is the only place auditPackageTreeZeroForeign can report a bad allowlist, so a missing allowlist must flow through as a named violation, not an empty-clean pass")
(:doc :symbol "asl/packages/asl-gates/tests/gatesTest.asl#testIsForeignFileUnreadableIsError" :text "an unreadable file (e.g. a chmod 000 shebang script) must not be silently treated as not-foreign; it must surface as a named read error")
(:doc :symbol "asl/packages/asl-gates/tests/gatesTest.asl#testAuditPackageTreeZeroForeignUnreadableFileIsRed" :text "gate4 must go red, naming the file, when a candidate file cannot be read, not pass it as not-foreign")
(:doc :symbol "asl/packages/asl-gates/tests/gatesTest.asl#testAllowlistedPathsUnparseableIsError" :text "an allowlist that does not parse must be an error naming the file and the parse failure, not a list of fragments")
(:doc :symbol "asl/packages/asl-gates/tests/gatesTest.asl#testAllowlistedPathsZeroEntriesIsError" :text "an existing allowlist with zero (:path ...) entries is a configuration error; the live file has hundreds of entries")
(:doc :symbol "asl/packages/asl-gates/tests/gatesTest.asl#testAllowlistedPathsMalformedEntryIsError" :text "an entry the foreign audit cannot parse (no :kind) is a malformed allowlist, not a silently accepted path")
(:doc :symbol "asl/packages/asl-gates/tests/gatesTest.asl#testAuditPackageTreeZeroForeignUnparseableAllowlistIsRed" :text "gate4 must report the allowlist parse failure itself, not the files it would have exempted")
(:doc :symbol "asl/packages/asl-gates/tests/gatesTest.asl#testCollectDirectoryFilesUnreadableSubdirIsError" :text "find exits 1 on an unreadable subdirectory and its partial listing hides the files in it; that must surface as an error naming the directory and find's stderr")
(:doc :symbol "asl/packages/asl-gates/tests/gatesTest.asl#testAuditPackageTreeZeroForeignUnreadableSubdirIsRed" :text "gate4 on a tree with an unreadable subdirectory holding a .py must go red naming the listing failure, not pass 0 files")
