(:doc :symbol "asl/packages/asl-gates/tests/gatesHardeningTest.asl#testCommandLines" :text "a listing command that exits non-zero must be an error carrying the command and stderr, and a zero exit yields sorted non-empty lines, so no pipe is needed")
