(:doc :symbol "asl/packages/asl-gates/src/dyck.asl#receipt" :text "The (:unbalanced ...) receipt of a file: its path, line, column and evidence text, followed by the extra fields.")
(:doc :symbol "asl/packages/asl-gates/src/dyck.asl#reportFile!" :text "One file balance verdict as exit code and receipt line; hint adds fields for an unbalanced file so a caller with a repair engine can name the fix without this module depending on it.")
(:doc :symbol "asl/packages/asl-gates/src/dyck.asl#mainWith" :text "Balance check over paths with a hint function for unbalanced files; with no path it prints usage and returns 64, otherwise it returns the processed result.")
(:doc :symbol "asl/packages/asl-gates/src/gates.asl#isForeignFile?" :text "Whether a path is a foreign-language source file by its detected language; an error when the file cannot be read.")
(:doc :symbol "asl/packages/asl-gates/src/grammarGate.asl#isRegistered?" :text "True when a symbol name has an entry in the registry.")
(:doc :symbol "asl/packages/asl-gates/src/lexiconGate.asl#isSpokenMishearing?" :text "True when the term equals one of the spoken mishearing terms.")
(:doc :symbol "asl/packages/asl-gates/src/manifestGate.asl#isValidPkgName?" :text "True when a package name has no @ and is longer than 2 characters.")
(:doc :symbol "asl/packages/asl-gates/src/polarity.asl#isTestSymbol?" :text "True for test names by naming: starts with test- or test_, ends with -test, or starts with Test; run-tests and test-runner are excluded.")
(:doc :symbol "asl/packages/asl-gates/src/polarity.asl#isNegativeAssertion?" :text "True when the expression holds at least one negative assertion such as refute, assert-reject, assert-err or assert-false.")
(:doc :symbol "asl/packages/asl-gates/src/skillsGate.asl#isCleanOfLegacy?" :text "True when the content does not mention skyloom, or mentions it only together with the word alias.")
(:doc :symbol "asl/packages/asl-gates/src/skillsGate.asl#isValidYamlDescription?" :text "True when a description starts with a block or quote marker, or holds no colon followed by a space.")
(:doc :symbol "asl/packages/asl-gates/src/stratification.asl#isKernelClean?" :text "True when the trimmed kernel content holds none of the forbidden markers such as @scout, @coder and @reviewer.")
(:doc :symbol "asl/packages/asl-gates/src/suiteRunner.asl#nativeCliReady?" :text "True when the newest native CLI dir for the real root is fresh: it has a binary and every dependency file matches its tree copy.")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#" :text "audit landed: the main commits since a checkpoint that are neither merge nor ledger-only and have no :ev id whose newest covering row in .asl/mem/grades.asn is a pass for a head that is that commit or a descendant; a wip commit on main is a finding")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#Commit" :text "one parsed git log record: sha, parent count, message, touched files")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#evIds" :text "the :ev ids of a commit: its first line parsed as one ASN form and :ev read from it, so an :ev inside a string never counts; a message that is not one form has none")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#exemptKind" :text "merge or ledger for a commit the audit skips, empty otherwise; a wip rescue commit is not exempt on main")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#GradeRow" :text "one parsed ledger verdict row: ev, sha, verdict, base")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#gradeRows" :text "the ledger rows in file order as GradeRow (ev, sha, verdict, base); base is empty for an old row; a row that does not parse as a form is dropped")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#rowFieldsAny" :text "the fields of the first form of a text whatever its tag, an error when it is not one ASN form")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#rowText" :text "one key of a one-form text as text, empty when the text is not a form or lacks the key")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#rowItems" :text "one key of a one-form text as a list of words (a list, a string or a symbol value)")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#fromShas" :text "the source shas a cherry-pick -x message names, from its (cherry picked from commit SHA) lines")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#headSince" :text "the :since checkpoint of the (:gradesHead ...) row, empty when absent")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#gradeRow" :text "one (:grade :ev :sha [:base] :verdict :by :at) ledger row; base is the merge-base of the reviewed head with main at grade time, a pass row covers only commits in base..sha")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#isoOfMs" :text "UTC YYYY-MM-DDTHH:MM:SSZ of an epoch in milliseconds")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#parseLog" :text "commits of git log --name-only --format=@@C@@%H@@%P@@%B@@F@@ output, reversed (oldest first for real log output)")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#landedChecks" :text "one failed check per audited commit that is a wip commit (ERR_WIP_ON_MAIN) or has no covering pass row (ERR_UNGRADED, ERR_NO_EV); covers (candidate sha, row sha) says the row reviewed head is that commit or a descendant; one passed check counting the audited commits otherwise")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#ledgerPath" :text "the grades ledger path inside the repo, .asl/mem/grades.asn")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#cmdLanded!" :text "audit landed [--since REF]: REF defaults to the head row of the ledger; no checkpoint fails, none is guessed; exit 1 on any ungraded commit")
(:doc :symbol "asl/packages/asl-gates/tests/auditLandedTest.asl#runTests" :text "pure rules, log parsing and a git fixture for audit landed")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#evIdsLoose" :text "the tolerant :ev reader for a first line the ASN reader refuses (a mixed-case hyphenated symbol like W1b-FIX): the line without its strings, then the words after the first :ev")
(:doc :symbol "asl/packages/asl-gates/src/auditLanded.asl#stripStrings" :text "a line with its string literals dropped, backslash escapes honoured")
(:doc :symbol "asl/packages/asl-gates/src/auditForeign.asl#Audit" :text "schema of a foreign audit result: checks (the Check list), head, tail (strings)")
(:doc :symbol "asl/packages/asl-gates/src/auditGates.asl#allowAbsentCheck!" :text "root: the vcsDirect check for a tree whose .asl/mem/vcsDirectAllow.asn is absent: fails ERR_VCS_NO_MAIN when there is no merge base with main, fails ERR_VCS_ALLOW_DELETED when the file exists at HEAD or at the merge base, else a skipped check")
(:doc :symbol "asl/packages/asl-gates/src/auditGates.asl#cacheMode" :text "argv: the cache mode of the command line: off for --no-cache, else the value after --cache-dir, else empty (the runner store)")
(:doc :symbol "asl/packages/asl-gates/src/auditGates.asl#coreSweepArgv" :text "the core argv of the full check sweep: check --all")
(:doc :symbol "asl/packages/asl-gates/src/auditGates.asl#suiteGateChecks!" :text "id results ledger root: the gate checks of a suite run: one per ledger reconcile failure; fails ERR_NO_SUITES when results are empty, ERR_ALL_SKIPPED when every suite skipped, else one pass check counting the results")
(:doc :symbol "asl/packages/asl-gates/src/auditGates.asl#vcsDirectCheck!" :text "root noCache: the vcsDirect check, run with mode off when noCache is true and the runner store otherwise")
(:doc :symbol "asl/packages/asl-gates/src/auditGates.asl#vcsDirectCheckIn!" :text "root mode: the vcsDirect check: allowlist absent goes to allowAbsentCheck!; else runs the audit with mode (empty runner store, off no cache, else a cache dir) and passes on a receipt with :status :ok, fails ERR_VCS_DIRECT on a violation receipt and with the audit's error code on an audit error")
(:doc :symbol "asl/packages/asl-gates/src/auditGates.asl#vcsErrCode" :text "e: the ERR_VCS_NO_MAIN or ERR_VCS_CACHE_TRACKED code the error text contains, else ERR_VCS_DIRECT_AUDIT")
(:doc :symbol "asl/packages/asl-gates/src/runnerMain.asl#redForCapture?" :text "r: true when the suite result cause is neither OK nor SKIPPED")
(:doc :symbol "asl/packages/asl-gates/src/suiteRunner.asl#aslResult!" :text "snap suite code out: the SuiteResult of an asl suite: the host verdict, red as ERR_CONSTANT_ASSERT when OK but constant assertions cover all asserts, red as ERR_DECLARED_GAP when OK but declared exceeds executed asserts plus refutes, else OK or the host cause with its digest")
(:doc :symbol "asl/packages/asl-gates/src/suiteRunner.asl#countConstant!" :text "path: the number of assert forms in the file whose condition is constant (checked by checkGuard), 0 when the file cannot be read")
(:doc :symbol "asl/packages/asl-gates/src/suiteRunner.asl#countedAsserts" :text "r: the asserts of a suite result, 0 when it was SKIPPED")
(:doc :symbol "asl/packages/asl-gates/src/suiteRunner.asl#countedDeclared" :text "r: the declared assertions of a suite result, 0 when it was SKIPPED")
(:doc :symbol "asl/packages/asl-gates/src/suiteRunner.asl#countedRefutes" :text "r: the refutes of a suite result, 0 when it was SKIPPED")
(:doc :symbol "asl/packages/asl-gates/src/suiteRunner.asl#skipAllowedPaths" :text "text: the suite paths named by the :suite values of the (:skip rows of a skipAllowed text, one per row")
(:doc :symbol "asl/packages/asl-gates/src/suiteRunner.asl#skipDecision!" :text "snap suite: some reason when the snapshot skipAllowed.asn has a row for the suite whose precondition does not hold, none when the file is absent, has no row or the precondition holds")
(:doc :symbol "asl/packages/asl-gates/src/suiteRunner.asl#suiteJobFor!" :text "snap suite baseS skip: the Job that runs a suite: a no-op sh exit 0 with a 10 s timeout when skip is some, the script itself for a .sh suite, else the native runner test argv; the timeout is the slow-suite value or baseS in ms")
(:doc :symbol "asl/packages/asl-gates/src/suiteRunner.asl#toResult!" :text "snap real suite d skip: the SuiteResult of a finished job: a SKIPPED result carrying the skip reason when skip is some, shellResult for a .sh suite, else aslResult! on the snapshot-stripped output")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#allowKeys" :text "text: the site keys of an allowlist text, same as parseAllow")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#audit!" :text "root allowPath: auditAt! with the default base; Ok receipt text or Err")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#auditAt!" :text "root allowPath base: auditWith! using the runner store cache; Ok receipt text or Err")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#auditWith!" :text "root allowPath base cache: the audit receipt for the tree (violation or ok, with the base, grown rows and cache note) plus the run time :ms; cache is empty for the runner store, off for no cache, or a directory; Err when a tracked path sits under .asl/cache, a file, the allowlist or the base cannot be read, or HEAD does not resolve")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#cacheCap" :text "the row count, 20000, past which a cache store keeps only the rows this run used")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#cacheDirFor!" :text "root mode: cacheDirWith! using the HOME environment value")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#cacheDirWith!" :text "root mode home: the scan cache directory: empty for mode off, mode itself when non-empty, else the runner store under home keyed by the first 16 hex of the sha256 of the real git common dir; Err when home is unusable or the git common dir cannot be read")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#cacheText" :text "used: the cache file text: one row per key in sorted order, key TAB row, each ending with the row end mark, joined by newlines")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#cap" :text "args: the cache mode of the command line: off for --no-cache, else the value after --cache-dir, else empty")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#coveredVerbs" :text "the verbs the scanner covers: the vcs verbs plus worktree")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#declaredVerbs" :text "text: some list of the verbs named by the :verbs value on the first line of an allowlist text, none when it declares none")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#decodeString" :text "raw: the text of a string token: outer quotes dropped and the escapes n t r and backslash decoded")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#emitRows" :text "sites why: allowlist (:site ...) rows, one per distinct site key with :n when it occurs more than once and :why set to why, joined by newlines")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#excluded?" :text "path: true when the path is under asl/tools/vcs/, which the audit never scans")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#grownOf" :text "allow baseAllow baseVerbs: the allowlist keys beyond their base count whose verb the base covered, as a pair of product keys and keys under a tests directory")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#headerVerbs" :text "text: the verb set of a base allowlist: its declared :verbs, else the legacy verbs")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#Helpers" :text "schema of the git helper set: local (helper keys file|symbol), names (their unique bare names)")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#helpersOf" :text "files: the Helpers of a tree by data: files outside the vcs layer that contain git are tokenized and rescanned until no fn joins the set, at most 8 rounds")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#keyFile" :text "the file name of the store secret: vcsDirectAudit.key")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#main" :text "args: the command line entry: --root (default .), --allow, --base, --emit prints baseline rows, --helpers prints the helper names, else prints the audit receipt; exit 0 clean, 1 violation, 2 error")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#mergeUsed" :text "a b: the map a with every key of b set to its value in b")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#namesDigest" :text "h: the sha256 hex of the sorted helper names joined by blanks")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#parseAllow" :text "text: the site keys of an allowlist text: each (:site S ... :argv A [:n N]) row gives S|A repeated N times (default 1)")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#parseCache" :text "text: the cache rows as a map from key to the row text after the key; only lines ending with TAB and dot and holding a key count, others are dropped")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#receiptOf" :text "v allowed: the receipt of a verdict with the allowed count, no grown rows and no extra fields")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#receiptWith" :text "v allowed grown extra: the (:vcsDirectAudit :v 1 ...) receipt: :status :ok when there are no new, stale or grown entries, else :violation, with :sites, :allowed, :new, :stale and the extra text")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#rowEnd" :text "the end mark of a cache row: TAB and dot")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#rowMac" :text "secret key body: the keyed digest of a cache row, sha256 of secret and the sha256 of secret key and body")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#scanCached!" :text "dir files: the sites of the files and a note, scanned through the signed cache of dir, empty dir means no cache; the note is empty or why the cache could not be written, which happens only when a row was a miss")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#scanFiles" :text "files: the sites of a tree of path and text pairs, scanned with its helper set")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#scanFilesC" :text "old files: the sites of a tree and the cache rows used, scanned through the cache map old, with the same sites as scanFiles")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#scanSource" :text "file source: the sites of one source text in source order, empty under asl/tools/vcs")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#segmentsOf" :text "text: the command segments of a shell text, split at && || ; & newlines, $( and backquotes and a pipe with a blank on either side, each as its words after leading shell keywords")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#signRows" :text "secret rows: the rows with a TAB and rowMac digest appended to each body")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#Site" :text "schema of a direct git site: file, symbol, verb")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#siteKey" :text "s: the key of a site: file#symbol|git verb")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#storeRoot" :text "the runner cache store root from the HOME environment value, Err when HOME is unset or blank")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#storeRootFrom" :text "home: Ok of home/.asl/run/vcsDirect, Err ERR_VCS_STORE_NO_HOME when home is none or blank")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#trackedAsl!" :text "root: the tracked .asl paths of root from git ls-files, Err when the listing fails")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#vcsVerbs" :text "the git verbs the audit covers: commit add update-ref commit-tree push reset checkout restore apply clean stash rm")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#verbsDrift" :text "text: how the allowlist header differs from the covered verbs: header:absent when it declares none, missing:V for a covered verb it drops, extra:V for one it adds")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#verbsTag" :text "the verbsTagOf value for the vcs verbs and worktree verbs")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#verbsTagOf" :text "verbs wverbs: the first 12 hex of the sha256 of the verbs and the worktree-prefixed wverbs joined by blanks, part of every cache key")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#verbState" :text "items skipPh: what the words after git name: v:VERB for a covered verb, word for any other verb, param when the verb comes from a value, none when nothing follows; values of valued global options are skipped")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#Verdict" :text "schema of an audit verdict: found (Site list), newSites and stale (key lists)")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#verdictOf" :text "sites allow: the Verdict of the sites against the allowlist keys: newSites are keys beyond the allowlist, stale are allowlist keys beyond the sites, counted by occurrence")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#verifiedRows" :text "secret rows: the rows whose last TAB field equals rowMac of the rest, with the digest removed; rows with fewer than 3 fields or a wrong digest are dropped")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#viewKey" :text "sha hd h file: the cache key of one file: its content sha, the helper names digest hd, verbsTag, x or n for excluded, and the sorted helper names defined in that file")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#worktreeVerbs" :text "the worktree subcommands the audit covers: add remove prune move")
(:doc :symbol "asl/packages/asl-gates/src/vcsDirectAudit.asl#writeAtomic!" :text "path text: writes text to a temp file path.tmpPID and renames it over path; the empty string on success, else the error text with the temp file removed")
(:doc :symbol "asl/packages/asl-gates/tests/auditForeignAppendOnlyTest.asl#runTests" :text "audit foreign append-only baseline on a temp git repo: an appended row or reindented row stays green, a rewritten or deleted past :raise row fails foreignRaise")
(:doc :symbol "asl/packages/asl-gates/tests/skipAccountingTest.asl#runTests" :text "skip accounting: only suites in skipAllowed.asn are SKIPPED with zero asserts, an unlisted skip row is ERR_SKIP_NOT_ALLOWED, all-skipped fails ERR_ALL_SKIPPED, the decision is made once before the run")
(:doc :symbol "asl/packages/asl-gates/tests/vcsAuditWireTest.asl#runTests" :text "vcsDirect wired into audit consistency on fixture repos: a clean tree passes, a seeded site fails ERR_VCS_DIRECT, a deleted allowlist ERR_VCS_ALLOW_DELETED, no main ERR_VCS_NO_MAIN, a tracked cache ERR_VCS_CACHE_TRACKED")
(:doc :symbol "asl/packages/asl-gates/tests/vcsDirectAuditTest.asl#runTests" :text "vcsDirectAudit on in-memory trees: new, allowed and stale sites, patterns, allowlist parsing, helpers by data, shell shapes and occurrence counts")
