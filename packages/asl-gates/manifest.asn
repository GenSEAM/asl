(:package asl-gates
 :version "0.1.0"
 :entry "src/gates.asl"
 :description "Pure AgentScript Verification Gate Runners & Continuous Audit Engine"
 :aslFirst true
 :modules ["asl-gates/annotationLint"
           "asl-gates/dyck"
           "asl-gates/gateRunner"
           "asl-gates/gates"
           "asl-gates/grammarGate"
           "asl-gates/lexiconGate"
           "asl-gates/manifestGate"
           "asl-gates/metaAudit"
           "asl-gates/polarity"
           "asl-gates/ruleCheckers"
           "asl-gates/shebangAudit"
           "asl-gates/siteClaims"
           "asl-gates/skillsGate"
           "asl-gates/stratification"
           "asl-gates/suiteRunner"
           "asl-gates/vacuity"]
 :dependencies ["asl-parser" "asl-checker" "asl-compiler" "asl-text" "asl-syntax"])
