(module asl/packages/asl-web/tests/proxyV2Test :x [runTests] :i [(asl-net/unix :a unix) (asl-web/proxy :a proxy) (asl-http/http11 :a http)])

fn handoffLines -> (List String)
  (list "handoff refuses a server that is not listening ok" "handoff over channel -1 is an EINVAL send error ok" "receive on channel -1 is an EINVAL receive error ok"
        "receive from a closed sender carries no descriptor ok" "receive refuses a path that is not a socket ok" "handoff sends the listener ok"
        "received descriptor is a new one ok" "adopted server keeps path, status and permissions ok" "adopted listener accepts after the original fd closed ok")

fn ! sh cmd: String -> ProcessOutput
  (processRun cmd)

fn ! testUnixDomainSocketServer! -> Bool
  (let [(made (sh "mktemp -d"))
        (dir (stringTrim made.stdout))
        (cfg (unix/makeUnixSocketConfig (str dir "/vm.sock") true 432))
        (serverRes (unix/openUnixServerSocket cfg))
        (badServerRes (unix/openUnixServerSocket (unix/makeUnixSocketConfig "" true 432)))]
    (do (assert (= made.exitCode 0) "mktemp -d makes a work directory")
        (assert cfg.unlinkStale "Unlink stale socket flag is true")
        (assert (= cfg.permissions 432) "Permissions match config (0660 = 432 decimal)")
        (mt serverRes
          ((err e) (assert false (str "Unix domain server socket initialization must succeed: " e)))
          ((ok server) (do (assert (= server.status "listening") "Server socket status is listening")
                           (assert (ok? (unix/closeUnixSocket server)) "Unix socket close must succeed"))))
        (assert (= badServerRes (err "ERR_UNIX_SOCKET_EMPTY_PATH")) "Empty socket path must be rejected")
        (let [(ll (str dir "/handoff.ll"))
              (bin (str dir "/handoff"))
              (built (sh (str "asl/host/out/asl-host run asl/packages/asl-compiler/src/asl1.asl build asl/packages/asl-web/tests/fixtures/handoffProgram.asl -o " ll)))
              (linked (sh (str "/usr/bin/clang -Wno-override-module -x ir " ll " -x none asl/host/out/libaslrt.a -lm -o " bin)))
              (ran (sh (str bin " " dir)))]
          (do (assert (= built.exitCode 0) (str "asl1 builds handoffProgram: " built.stdout built.stderr))
              (assert (= linked.exitCode 0) (str "handoffProgram links: " linked.stderr))
              (assert (= ran.stdout (str (stringJoin (handoffLines) "\n") "\n")) (str "handoffProgram passes every check: " ran.stdout ran.stderr))
              (assert (= ran.exitCode 0) (str "handoffProgram exits 0, got " ran.exitCode))
              (refute (fileExists? (str dir "/proxy.sock")) "Refutation: the adopted server's close leaves no socket file")))
        (assert (= (sh (str "rm -rf " dir)).exitCode 0) "work directory removed")
        true))

fn testProxyV2HeaderParsing -> Bool
  (let [(validHdr (proxy/makeProxyV2Header 2 "PROXY" "AF_INET" "STREAM" "192.168.1.100" "10.0.0.1" 45678 443)) (wireValid (proxy/encodeProxyV2Header validHdr)) (parseRes (proxy/parseProxyV2Header wireValid)) (ipv6Hdr (proxy/makeProxyV2Header 2 "PROXY" "AF_INET6" "STREAM" "2001:db8::1" "2001:db8::2" 54321 443)) (wireIpv6 (proxy/encodeProxyV2Header ipv6Hdr)) (parseIpv6Res (proxy/parseProxyV2Header wireIpv6)) (localHdr (proxy/makeProxyV2Header 2 "LOCAL" "AF_UNSPEC" "UNSPEC" "" "" 0 0)) (wireLocal (proxy/encodeProxyV2Header localHdr)) (parseLocalRes (proxy/parseProxyV2Header wireLocal)) (badMagic "BAD_PROXY_MAGIC_HEADER_BYTES") (badParseRes (proxy/parseProxyV2Header badMagic))] (assert (ok? parseRes) "Valid PROXY v2 header must parse successfully") (mt parseRes ((err _) (assert false "parseRes missing")) ((ok hdr) (assert (= hdr.version 2) "PROXY version must be 2") (assert (= hdr.command "PROXY") "PROXY command matches") (assert (= hdr.family "AF_INET") "Address family is AF_INET") (assert (= hdr.protocol "STREAM") "Transport protocol is STREAM") (assert (= hdr.srcIp "192.168.1.100") "Client source IP matches") (assert (= hdr.dstIp "10.0.0.1") "Destination IP matches") (assert (= hdr.srcPort 45678) "Client source port matches") (assert (= hdr.dstPort 443) "Destination port matches"))) (assert (ok? parseIpv6Res) "Valid IPv6 PROXY v2 header must parse successfully") (mt parseIpv6Res ((err _) (assert false "parseIpv6Res missing")) ((ok ip6) (assert (= ip6.family "AF_INET6") "IPv6 address family matches") (assert (= ip6.srcIp "2001:db8::1") "IPv6 source IP matches") (assert (= ip6.dstIp "2001:db8::2") "IPv6 destination IP matches") (assert (= ip6.srcPort 54321) "IPv6 source port matches"))) (assert (ok? parseLocalRes) "LOCAL health check PROXY v2 header parses successfully") (mt parseLocalRes ((err _) (assert false "parseLocalRes missing")) ((ok lHdr) (assert (= lHdr.command "LOCAL") "LOCAL command preserved"))) (assert (err? badParseRes) "Invalid magic prefix must be rejected") (assert (= (mt badParseRes ((err e) e) ((ok _) "")) "ERR_PROXY_V2_INVALID_MAGIC") "Error code matches ERR_PROXY_V2_INVALID_MAGIC") (refute (err? parseRes) "Refutation: Valid PROXY v2 header cannot return error") (refute (mt parseRes ((err _) true) ((ok parseResVal) (not (= parseResVal.version 2)))) "Refutation: PROXY version must be 2") (refute (mt parseRes ((err _) true) ((ok parseResVal2) (not (= parseResVal2.command "PROXY")))) "Refutation: PROXY command must match") (refute (mt parseRes ((err _) true) ((ok parseResVal3) (not (= parseResVal3.srcIp "192.168.1.100")))) "Refutation: Client IP cannot mutate") (refute (mt parseRes ((err _) true) ((ok parseResVal4) (not (= parseResVal4.srcPort 45678)))) "Refutation: Source port cannot mutate") (refute (err? parseIpv6Res) "Refutation: IPv6 PROXY v2 header cannot fail") (refute (mt parseIpv6Res ((err _) true) ((ok parseIpv6ResVal) (not (= parseIpv6ResVal.srcIp "2001:db8::1")))) "Refutation: IPv6 client IP must match") (refute (mt parseLocalRes ((err _) true) ((ok parseLocalResVal) (not (= parseLocalResVal.command "LOCAL")))) "Refutation: LOCAL command must match") (refute (ok? badParseRes) "Refutation: Invalid PROXY magic cannot be accepted") true)

fn testProxyHeaderMiddlewareResolution -> Bool
  (let [(headersFull (http/makeHeaders (list (pair "X-Forwarded-For" "203.0.113.195, 70.41.3.18, 150.172.238.178") (pair "X-Forwarded-Proto" "https, http") (pair "X-Forwarded-Host" "app.agentscript.org") (pair "Host" "internal-backend")))) (reqFull (http/makeRequest "GET" "/api/user" headersFull "" "HTTP/1.1")) (headersRealIp (http/makeHeaders (list (pair "X-Real-IP" "198.51.100.22") (pair "Host" "example.com")))) (reqRealIp (http/makeRequest "GET" "/" headersRealIp "" "HTTP/1.1")) (headersEmptyXff (http/makeHeaders (list (pair "X-Forwarded-For" "") (pair "X-Real-IP" "198.51.100.22") (pair "Host" "example.com")))) (reqEmptyXff (http/makeRequest "GET" "/" headersEmptyXff "" "HTTP/1.1")) (headersDirect (http/makeHeaders (list (pair "Host" "direct.com")))) (reqDirect (http/makeRequest "GET" "/" headersDirect "" "HTTP/1.1")) (proxyHdr (proxy/makeProxyV2Header 2 "PROXY" "AF_INET" "STREAM" "198.51.100.99" "10.0.0.1" 50000 80))] (assert (= (proxy/resolveClientIp reqFull (none)) "203.0.113.195") "X-Forwarded-For extracts leftmost client IP") (assert (= (proxy/resolveClientProto reqFull) "https") "X-Forwarded-Proto resolves to https even with comma values") (assert (= (proxy/resolveClientHost reqFull) "app.agentscript.org") "X-Forwarded-Host preferred over Host") (assert (= (proxy/resolveClientIp reqRealIp (none)) "198.51.100.22") "X-Real-IP fallback succeeds") (assert (= (proxy/resolveClientIp reqEmptyXff (none)) "198.51.100.22") "Empty X-Forwarded-For falls back to X-Real-IP") (assert (= (proxy/resolveClientProto reqRealIp) "http") "Protocol defaults to http when header missing") (assert (= (proxy/resolveClientHost reqRealIp) "example.com") "Host header used when X-Forwarded-Host absent") (assert (= (proxy/resolveClientIp reqDirect (none)) "127.0.0.1") "Client IP defaults to 127.0.0.1 without proxy headers") (assert (= (proxy/resolveClientIp reqFull (some proxyHdr)) "198.51.100.99") "PROXY v2 header takes highest precedence over HTTP headers") (refute (= (proxy/resolveClientIp reqFull (none)) "") "Refutation: Resolved client IP cannot be empty") (refute (not (= (proxy/resolveClientProto reqFull) "https")) "Refutation: Proto cannot diverge") (refute (not (= (proxy/resolveClientHost reqFull) "app.agentscript.org")) "Refutation: Host cannot diverge") (refute (= (proxy/resolveClientIp reqRealIp (none)) "127.0.0.1") "Refutation: Real IP cannot fall back to loopback") (refute (= (proxy/resolveClientIp reqEmptyXff (none)) "127.0.0.1") "Refutation: Empty XFF cannot fall back to loopback if Real-IP present") (refute (not (= (proxy/resolveClientProto reqRealIp) "http")) "Refutation: Default proto must be http") (refute (not (= (proxy/resolveClientHost reqRealIp) "example.com")) "Refutation: Host fallback must match example.com") (refute (not (= (proxy/resolveClientIp reqFull (some proxyHdr)) "198.51.100.99")) "Refutation: PROXY v2 precedence cannot be bypassed") true)

fn ! runTests -> Bool
  (let [(okUnix (testUnixDomainSocketServer!)) (okProxy (testProxyV2HeaderParsing)) (okResolve (testProxyHeaderMiddlewareResolution))] (and (and okUnix okProxy) okResolve))
