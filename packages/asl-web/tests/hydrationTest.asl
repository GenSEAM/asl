(module asl/packages/asl-web/tests/hydrationTest :x [RunTests runTests] :i [(vdom :a v) (html :a h) (asl-web/ssr :a ssr) (asl-web/hydrate :a hyd)])

fn unwrapErr r: (Result T E) dflt: E -> E
  (mt r ((err e) e) ((ok _) dflt))

fn testSsrHtmlStreamGeneration -> Bool
  (let [(title "AgentScript Web Substrate") (headerNode (h/h1 (mapSet (mapEmpty) "class" "heading-title") (list (v/text "Welcome to AgentScript")))) (paraNode (h/p (mapEmpty) (list (v/text "Fast, pure, zero-cost SSR & WASM state hydration.")))) (btnAttrs (mapSet (mapSet (mapEmpty) "id" "counter-btn") "type" "button")) (btnNode (h/button btnAttrs (list (v/text "Count: 0")))) (inputAttrs (mapSet (mapSet (mapEmpty) "type" "text") "placeholder" "Enter name...")) (inputNode (h/input inputAttrs)) (appVNode (h/div (mapSet (mapEmpty) "id" "app") (list headerNode paraNode btnNode inputNode))) (stateData "(:state :count 0 :user \"guest\" :items [\"alpha\" \"beta\"])") (docChunks (ssr/renderSsrDocument title appVNode stateData)) (chunkCount (listLength docChunks)) (wireStream (ssr/formatChunkedStream docChunks))] (assert (> chunkCount 1) "SSR produces multiple streaming document chunks") (assert (stringContains? wireStream "Welcome to AgentScript") "Rendered HTML stream contains header text") (assert (stringContains? wireStream "class=\"heading-title\"") "Rendered HTML stream contains element attributes") (assert (stringContains? wireStream "<input placeholder=\"Enter name...\" type=\"text\">") "Void elements render self-closing without closing tag") (assert (stringContains? wireStream "id=\"asl-state\"") "Rendered HTML stream contains embedded ASN state script tag") (assert (stringEndsWith? wireStream "0\r\n\r\n") "Chunked wire stream terminates with RFC 9112 zero chunk delimiter") (refute (= chunkCount 0) "Refutation: SSR chunk count cannot be zero") (refute (not (stringContains? wireStream "id=\"app\"")) "Refutation: App root container must be present") (refute (not (stringEndsWith? wireStream "0\r\n\r\n")) "Refutation: Chunked stream must terminate with terminal chunk") (refute (stringContains? wireStream "</input>") "Refutation: Void tags must not emit closing tags") true)

fn testAsnStateEmbeddingAndScriptEscaping -> Bool
  (let [(benignState "(:app :theme \"dark\" :version \"0.1.0\")") (benignSerialized (ssr/serializeAsnState benignState)) (maliciousPayload "(:payload \"attack </script><script>alert(1)</script>\")") (escapedPayload (ssr/serializeAsnState maliciousPayload))] (assert (stringContains? benignSerialized "dark") "Serialized benign state contains property values") (assert (not (stringContains? escapedPayload "</script>")) "Closing script tags are neutralized to prevent DOM injection") (assert (stringContains? escapedPayload "<\\/script>") "Escaped script tag uses safe forward-slash escaping") (refute (stringContains? escapedPayload "</script>") "Refutation: Escaped payload must never contain unescaped closing script tag") (refute (stringEmpty? benignSerialized) "Refutation: Serialized state cannot be empty") true)

fn testSsrBackpressureAndCancellation -> Bool
  (let [(initState (ssr/makeSsrStreamState 65536)) (chunk1 "<div>Header</div>") (chunk2 "<main>Content</main>") (afterEmit (ssr/handleStreamBackpressure initState "WRITE" chunk1)) (pausedState (ssr/handleStreamBackpressure afterEmit "EAGAIN" chunk2)) (drainedState (ssr/handleStreamBackpressure pausedState "DRAIN" "")) (cancelledState (ssr/handleStreamBackpressure drainedState "EPIPE" ""))] (assert (= initState.status "streaming") "Initial stream state is streaming") (assert (= afterEmit.chunksEmitted 1) "Emitted chunk incremented count") (assert (= pausedState.status "paused") "EAGAIN pauses stream on backpressure") (assert (= (listLength pausedState.bufferedChunks) 1) "Buffered chunk retained during pause") (assert (> pausedState.bytesBuffered 0) "Buffered bytes tracked accurately") (assert (= drainedState.status "streaming") "DRAIN resumes streaming status") (assert (= drainedState.bytesBuffered 0) "DRAIN flushes buffered bytes") (assert (= cancelledState.status "cancelled") "EPIPE cancels stream immediately on client disconnect") (refute (not (= pausedState.status "paused")) "Refutation: Backpressure must pause stream") (refute (not (= drainedState.status "streaming")) "Refutation: Drain must resume stream") (refute (not (= cancelledState.status "cancelled")) "Refutation: Disconnect must cancel stream") (refute (= pausedState.bytesBuffered 0) "Refutation: Paused stream must track non-zero buffered bytes") true)

fn testClientSideWasmHydration -> Bool
  (let [(sampleHtml "<!DOCTYPE html><html><body><div id=\"app\"><h1>Heading</h1><p>Body text</p></div><script type=\"application/asn\" id=\"asl-state\">(:count 10 :user \"admin\")</script></body></html>") (extractRes (hyd/parseInlineAsnState sampleHtml)) (serverTree (h/div (mapEmpty) (list (h/h1 (mapEmpty) (list (v/text "Heading"))) (h/p (mapEmpty) (list (v/text "Body text")))))) (clientTree (h/div (mapEmpty) (list (h/h1 (mapEmpty) (list (v/text "Heading"))) (h/p (mapEmpty) (list (v/text "Body text")))))) (parityRes (hyd/verifyHydrationParity serverTree clientTree)) (mountRes (hyd/hydrateVNodeTree clientTree))] (assert (ok? extractRes) "Inline ASN state successfully extracted from script tag") (assert (mt extractRes ((err _) false) ((ok extractResVal) (= extractResVal "(:count 10 :user \"admin\")"))) "Extracted state matches original payload") (assert (ok? parityRes) "Identical server and client trees yield zero hydration mismatch") (assert (mt parityRes ((err _) false) ((ok parityResVal) (= parityResVal "inSync"))) "Parity verification confirms inSync status") (assert (ok? mountRes) "Client VNode tree hydration mounting succeeds") (refute (err? extractRes) "Refutation: Valid state script cannot fail extraction") (refute (mt extractRes ((err _) true) ((ok extractResVal2) (not (= extractResVal2 "(:count 10 :user \"admin\")")))) "Refutation: Extracted state must not mutate") (refute (err? parityRes) "Refutation: Identical trees cannot report mismatch") true)

fn testHydrationMismatchRejections -> Bool
  (let [(serverBase (h/div (mapEmpty) (list (h/h1 (mapEmpty) (list (v/text "Server Heading"))) (h/p (mapEmpty) (list (v/text "Para 1")))))) (clientTagDiverge (h/div (mapEmpty) (list (h/h2 (mapEmpty) (list (v/text "Server Heading"))) (h/p (mapEmpty) (list (v/text "Para 1")))))) (clientTextDiverge (h/div (mapEmpty) (list (h/h1 (mapEmpty) (list (v/text "Client Heading"))) (h/p (mapEmpty) (list (v/text "Para 1")))))) (clientCountDiverge (h/div (mapEmpty) (list (h/h1 (mapEmpty) (list (v/text "Server Heading")))))) (clientTypeDiverge (h/div (mapEmpty) (list (v/text "Raw Text") (h/p (mapEmpty) (list (v/text "Para 1")))))) (tagRes (hyd/verifyHydrationParity serverBase clientTagDiverge)) (textRes (hyd/verifyHydrationParity serverBase clientTextDiverge)) (countRes (hyd/verifyHydrationParity serverBase clientCountDiverge)) (typeRes (hyd/verifyHydrationParity serverBase clientTypeDiverge)) (badHtmlMissingScript "<html><body><div>Content</div></body></html>") (missingScriptRes (hyd/parseInlineAsnState badHtmlMissingScript))] (assert (err? tagRes) "Diverged element tag triggers hydration mismatch error") (assert (= (unwrapErr tagRes (hyd/HydrationMismatch :kind "" :path "" :expected "" :actual "")).kind "tag") "Mismatch kind identifies tag divergence") (assert (err? textRes) "Diverged text node content triggers hydration mismatch error") (assert (= (unwrapErr textRes (hyd/HydrationMismatch :kind "" :path "" :expected "" :actual "")).kind "text") "Mismatch kind identifies text divergence") (assert (err? countRes) "Diverged child count triggers hydration mismatch error") (assert (= (unwrapErr countRes (hyd/HydrationMismatch :kind "" :path "" :expected "" :actual "")).kind "childCount") "Mismatch kind identifies childCount divergence") (assert (err? typeRes) "Diverged node type (element vs text) triggers hydration mismatch error") (assert (= (unwrapErr typeRes (hyd/HydrationMismatch :kind "" :path "" :expected "" :actual "")).kind "nodeType") "Mismatch kind identifies nodeType divergence") (assert (err? missingScriptRes) "Missing state script tag is rejected with error") (assert (= (unwrapErr missingScriptRes "") "ERR_HYDRATE_MISSING_STATE_SCRIPT") "Missing script yields ERR_HYDRATE_MISSING_STATE_SCRIPT") (refute (ok? tagRes) "Refutation: Tag divergence cannot pass parity verification") (refute (ok? textRes) "Refutation: Text divergence cannot pass parity verification") (refute (ok? countRes) "Refutation: Child count divergence cannot pass parity verification") (refute (ok? typeRes) "Refutation: Node type divergence cannot pass parity verification") (refute (ok? missingScriptRes) "Refutation: Missing state script cannot succeed") true)

fn runTests -> Bool
  (let [(okStream (testSsrHtmlStreamGeneration)) (okEmbed (testAsnStateEmbeddingAndScriptEscaping)) (okBackpressure (testSsrBackpressureAndCancellation)) (okHydrate (testClientSideWasmHydration)) (okMismatch (testHydrationMismatchRejections))] (and (and (and (and okStream okEmbed) okBackpressure) okHydrate) okMismatch))

fn RunTests -> Bool
  (runTests)
