(module asl-foreign/test :x [runTests] :i [(block :a f)])

fn runTests -> Bool
  (do (assert (stringContains? (f/js "a
b") "a
b") "JS block preserves literal newlines") (assert (= (f/js (str "x" "y")) (str "x" "y")) "JS block preserves composed body bytes") (assert (= (f/py "x") "x") "Python tag preserves body") (assert (= (f/sh "x") "x") "shell tag preserves body") (assert (= (f/sql "x") "x") "SQL tag preserves body") (assert (= (f/html "x") "x") "HTML tag preserves body") (assert (= (f/css "x") "x") "CSS tag preserves body") (assert (= (f/llvm "x") "x") "LLVM tag preserves body") (assert (= (f/c "x") "x") "C tag preserves body") (assert (= (f/jsStr "a\"b\\c") "a\\\"b\\\\c") "jsStr escapes quote and backslash from a value") (assert (= (f/jsStr "a\nb") "a\\nb") "jsStr escapes newline") (assert (= (f/jsStr "a\rb") "a\\rb") "jsStr escapes carriage return") (assert (= (f/jsStr "</script>") "<\\/script>") "jsStr protects closing script sequence") (assert (= (f/shArg "a'b") "'a'\\''b'") "shArg quotes apostrophe safely") (assert (= (f/pyStr "a'b\\c") "a\\'b\\\\c") "pyStr escapes quote and backslash") (assert (= (f/sqlStr "a'b") "a''b") "sqlStr doubles single quote") (assert (= (f/htmlText "a<b&c") "a&lt;b&amp;c") "htmlText escapes markup") (assert (= (f/htmlAttr "a<&\"'") "a&lt;&amp;&quot;&#39;") "htmlAttr escapes attribute delimiters") (assert (= (f/cssStr "a\nb") "a\\a b") "cssStr escapes newline") (assert (= (f/jsNum 100) "100") "jsNum renders numeric context") (assert (= (f/jsStr "a'b") "a\\'b") "jsStr escapes apostrophe") (assert (= (f/pyStr "a\nb") "a\\nb") "pyStr escapes newline") (assert (= (f/pyStr "a\rb") "a\\rb") "pyStr escapes carriage return") (assert (= (f/pyStr "a\"b") "a\\\"b") "pyStr escapes double quote") (assert (= (f/cssStr "a\rb") "a\\d b") "cssStr escapes carriage return") (assert (= (f/cssStr "a\"b'c\\d") "a\\\"b\\'c\\\\d") "cssStr escapes quotes and backslash") (assert (= (f/htmlText "a>b") "a&gt;b") "htmlText escapes greater-than") (assert (= (f/htmlAttr "a>b") "a&gt;b") "htmlAttr escapes greater-than") true)
