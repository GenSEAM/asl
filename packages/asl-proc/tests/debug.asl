(module asl-proc/debug :x [runTests] :i [(asl-plugin/types :a ty) (asl-plugin/security :a sec)])

fn ! runTests -> Bool
  (let [(hash2 "6403203dd5a0867eb14d104ee8a73730bd72dd9ad92e78d996a6dba0a5dcfc01") (cap (ty/PluginCapability :name "cap-db" :version "1.0.0" :doc "SQL database access")) (exp (ty/PluginExport :symbolName "query" :signature "(query Str (List Str)) -> (Result Str Str)" :requiredCapability "cap-db")) (valid (ty/PluginManifest :id "p1" :name "Plugin One" :version "1.0.0" :kind (ty/kindWasm) :capabilities (list cap) :exports (list exp) :entrypoint "main.wasm" :integritySha256 hash2)) (res (sec/validateManifestSecurity! valid "sandbox"))] (mt res ((ok _) ()) ((err e) (mt e ((ty/errNotFound id) (assert (= id "sandbox") (str "ty/errNotFound " id))) ((ty/errDuplicateId id) (assert (= id "sandbox") (str "ty/errDuplicateId " id))) ((ty/errInvalidSignature id) (assert (= id "sandbox") (str "ty/errInvalidSignature " id))) ((ty/errUnauthorized id) (assert (= id "sandbox") (str "ty/errUnauthorized " id))) ((ty/errSandboxEscape id) (assert (= id "sandbox") (str "ty/errSandboxEscape " id))) ((ty/errExecutionTrap id) (assert (= id "sandbox") (str "ty/errExecutionTrap " id))) ((ty/errTimeout id) (assert (= id "sandbox") "ty/errTimeout")) ((ty/errUnimplemented id) (assert (= id "sandbox") (str "ty/errUnimplemented " id))) ((ty/errRegistrySealed) ())))) true)
