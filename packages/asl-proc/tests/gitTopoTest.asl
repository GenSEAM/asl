(module asl-proc/gitTopoTest :x [runTests] :i [(gitTopo :a topo)])

fn testGitTopoPorcelainV2 -> Bool
  (let [(statusText (str "# worktree /home/user/projects/asex\n" "# branch.oid 1234567890abcdef1234567890abcdef12345678\n" "# branch.head main\n" "# branch.upstream origin/main\n" "# branch.ab +2 -1\n" "1 M. N... 100644 100644 100644 1234 5678 staged_file.txt\n" "1 .M N... 100644 100644 100644 1234 5678 unstaged_file.txt\n" "? untracked_file.txt\n" "u conflict_file.txt\n")) (t (topo/gitTopoParse statusText)) (fmt (topo/gitTopoFormat t))] (assert (= t.branch "main") "Branch name must be parsed as main") (assert (= t.commit "1234567890abcdef1234567890abcdef12345678") "Commit OID must match fixture") (assert (= t.oid "1234567890abcdef1234567890abcdef12345678") "OID alias must match commit") (assert (= t.upstream "origin/main") "Upstream tracking reference must be parsed as origin/main") (refute t.detached "Detached status must be false for branch main") (assert (= t.root "/home/user/projects/asex") "Root path must match fixture worktree") (assert (= t.worktreeRoot "/home/user/projects/asex") "Worktree root alias must match root") (assert (= t.staged 1) "Staged changes count must be exactly 1") (assert (= t.unstaged 1) "Unstaged changes count must be exactly 1") (assert (= t.untracked 1) "Untracked files count must be exactly 1") (assert (= t.conflicts 1) "Conflicts count must be exactly 1") (assert (= t.ahead 2) "Ahead count must be parsed as 2") (assert (= t.behind 1) "Behind count must be parsed as 1") (assert (= fmt "(:where-am-i :branch \"main\" :commit \"1234567890abcdef1234567890abcdef12345678\" :upstream \"origin/main\" :root \"/home/user/projects/asex\" :clean false :staged 1 :unstaged 1 :untracked 1 :conflicts 1 :ahead 2 :behind 1)") "Formatted ASN where-am-i string must match expected structure") true)

fn testGitTopoDetachedHead -> Bool
  (let [(statusText (str "# worktree /tmp/detached-repo\n" "# branch.oid deadbeefcafe1234567890abcdef1234567890ab\n" "# branch.head (detached)\n")) (t (topo/gitTopoParse statusText)) (fmt (topo/gitTopoFormat t))] (assert (= t.branch "(detached)") "Branch name must be (detached)") (assert t.detached "Detached status must be true for (detached) head") (assert (= t.commit "deadbeefcafe1234567890abcdef1234567890ab") "Commit OID must match detached commit") (assert (= t.upstream "") "Upstream must be empty when no tracking branch is configured") (assert (= t.root "/tmp/detached-repo") "Root must match worktree header") (assert (= t.staged 0) "Clean repo must have 0 staged changes") (assert (= t.unstaged 0) "Clean repo must have 0 unstaged changes") (assert (= t.untracked 0) "Clean repo must have 0 untracked files") (assert (= t.conflicts 0) "Clean repo must have 0 conflicts") (assert (= t.ahead 0) "Clean repo must have 0 ahead") (assert (= t.behind 0) "Clean repo must have 0 behind") (assert (= fmt "(:where-am-i :branch \"(detached)\" :commit \"deadbeefcafe1234567890abcdef1234567890ab\" :detached true :root \"/tmp/detached-repo\" :clean true :staged 0 :unstaged 0 :untracked 0 :conflicts 0 :ahead 0 :behind 0)") "Clean detached repo must format with :detached true and :clean true") true)

fn testGitWorktreeParse -> Bool
  (let [(wtText (str "worktree /home/user/projects/asex\n" "HEAD aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n" "branch refs/heads/main\n" "\n" "worktree /home/user/projects/asex-wt1\n" "HEAD bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\n" "branch refs/heads/feature-1\n" "locked work in progress\n" "\n" "worktree /home/user/projects/asex-wt2\n" "HEAD cccccccccccccccccccccccccccccccccccccccc\n" "detached\n" "prunable gitdir file points to non-existent location\n")) (wts (topo/gitWorktreeParse wtText))] (assert (= (listLength wts) 3) "Must parse exactly 3 worktrees") (let [(w0 (optionOr (listGet wts 0) (topo/GitWorktreeEntry :path "" :commit "" :head "" :branch "" :locked false :lockReason "" :prunable false))) (w1 (optionOr (listGet wts 1) (topo/GitWorktreeEntry :path "" :commit "" :head "" :branch "" :locked false :lockReason "" :prunable false))) (w2 (optionOr (listGet wts 2) (topo/GitWorktreeEntry :path "" :commit "" :head "" :branch "" :locked false :lockReason "" :prunable false)))] (assert (= w0.path "/home/user/projects/asex") "Worktree 0 path must be root path") (assert (= w0.commit "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "Worktree 0 commit must match HEAD") (assert (= w0.head "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") "Worktree 0 head alias must match commit") (assert (= w0.branch "main") "Worktree 0 branch ref must strip refs/heads/ prefix") (refute w0.locked "Worktree 0 must not be locked") (refute w0.prunable "Worktree 0 must not be prunable") (assert (= w1.path "/home/user/projects/asex-wt1") "Worktree 1 path must match") (assert (= w1.commit "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb") "Worktree 1 commit must match") (assert (= w1.branch "feature-1") "Worktree 1 branch must be feature-1") (assert w1.locked "Worktree 1 must be marked locked") (assert (= w1.lockReason "work in progress") "Worktree 1 lock reason must be extracted") (refute w1.prunable "Worktree 1 must not be prunable") (assert (= w2.path "/home/user/projects/asex-wt2") "Worktree 2 path must match") (assert (= w2.commit "cccccccccccccccccccccccccccccccccccccccc") "Worktree 2 commit must match") (assert (= w2.branch "(detached)") "Worktree 2 with detached keyword must report branch as (detached)") (refute w2.locked "Worktree 2 must not be locked") (assert w2.prunable "Worktree 2 must be marked prunable") (let [(fmt (topo/gitWorktreesFormat wts))] (assert (= fmt "(:git-worktrees :count 3 :entries ((:git-worktree :path \"/home/user/projects/asex\" :commit \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" :branch \"main\") (:git-worktree :path \"/home/user/projects/asex-wt1\" :commit \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\" :branch \"feature-1\" :locked true :lock-reason \"work in progress\") (:git-worktree :path \"/home/user/projects/asex-wt2\" :commit \"cccccccccccccccccccccccccccccccccccccccc\" :branch \"(detached)\" :prunable true)))") "Worktree roster format must match expected ASN") true)))

fn testGitLogParse -> Bool
  (let [(logText (str "1111111111111111111111111111111111111111|Alice|2026-09-08|feat: initial commit\n" "2222222222222222222222222222222222222222|Bob|2026-09-08|fix: resolve issue with \"quotes\"\n")) (commits (topo/gitLogParse logText))] (assert (= (listLength commits) 2) "Must parse exactly 2 commits from log text") (let [(c0 (optionOr (listGet commits 0) (topo/GitCommitEntry :hash "" :shortHash "" :author "" :date "" :message "" :summary ""))) (c1 (optionOr (listGet commits 1) (topo/GitCommitEntry :hash "" :shortHash "" :author "" :date "" :message "" :summary "")))] (assert (= c0.hash "1111111111111111111111111111111111111111") "Commit 0 full hash must match") (assert (= c0.shortHash "1111111") "Commit 0 short hash must be 7 chars prefix") (assert (= c0.author "Alice") "Commit 0 author must be Alice") (assert (= c0.date "2026-09-08") "Commit 0 date must be 2026-09-08") (assert (= c0.message "feat: initial commit") "Commit 0 message must match") (assert (= c0.summary "feat: initial commit") "Commit 0 summary alias must match message") (assert (= c1.hash "2222222222222222222222222222222222222222") "Commit 1 full hash must match") (assert (= c1.shortHash "2222222") "Commit 1 short hash must be 7 chars prefix") (assert (= c1.author "Bob") "Commit 1 author must be Bob") (assert (= c1.date "2026-09-08") "Commit 1 date must be 2026-09-08") (assert (= c1.message "fix: resolve issue with \"quotes\"") "Commit 1 message must preserve raw quotes") (let [(fmt (topo/gitLogFormat commits))] (assert (= fmt "(:git-log :count 2 :commits ((:git-commit :hash \"1111111111111111111111111111111111111111\" :short \"1111111\" :author \"Alice\" :date \"2026-09-08\" :message \"feat: initial commit\") (:git-commit :hash \"2222222222222222222222222222222222222222\" :short \"2222222\" :author \"Bob\" :date \"2026-09-08\" :message \"fix: resolve issue with \\\"quotes\\\"\")))") "Commit log format must properly escape quotes in JSON format") true)))

fn testGitEdgeCases -> Bool
  (let [(emptyTopo (topo/gitTopoParse "")) (emptyWts (topo/gitWorktreeParse "")) (emptyCommits (topo/gitLogParse ""))] (assert (= emptyTopo.branch "unknown") "Empty status text must produce unknown branch") (assert (= emptyTopo.commit "") "Empty status text must produce empty commit") (assert (= (listLength emptyWts) 0) "Empty worktree text must produce 0 entries") (assert (= (topo/gitWorktreesFormat emptyWts) "(:git-worktrees :count 0 :entries ())") "Empty worktree list must format with count 0 and empty entries") (assert (= (listLength emptyCommits) 0) "Empty log text must produce 0 commits") (assert (= (topo/gitLogFormat emptyCommits) "(:git-log :count 0 :commits ())") "Empty log list must format with count 0 and empty commits") true)

fn runTests -> Bool
  (and (testGitTopoPorcelainV2) (and (testGitTopoDetachedHead) (and (testGitWorktreeParse) (and (testGitLogParse) (testGitEdgeCases)))))
