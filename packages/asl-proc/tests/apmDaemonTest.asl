(module asl-proc/apmDaemonTest :x [runTests] :i [(apm :a apm) (deadline :a wd)])

fn testSingletonLock -> Bool
  (let [(vAcq (apm/resolveLock "/tmp/test.lock" 100 0 false)) (vColl (apm/resolveLock "/tmp/test.lock" 200 100 true)) (vStale (apm/resolveLock "/tmp/test.lock" 300 999 false)) (vSelf (apm/resolveLock "/tmp/test.lock" 100 100 true))] (assert vAcq.acquired "Fresh lock must be acquired") (assert (= vAcq.status ":acquired") "Status must be :acquired") (assert (= vAcq.event ":lock-acquired") "Event must be :lock-acquired") (refute vColl.acquired "Collision must refuse lock acquisition") (assert (= vColl.status ":collision") "Collision status must be :collision") (assert (= vColl.event ":lock-refused") "Collision event must be :lock-refused") (assert vStale.acquired "Stale lock must be reclaimed") (assert (= vStale.status ":stale") "Stale lock status must be :stale") (assert (= vStale.event ":lock-reclaimed") "Stale lock event must be :lock-reclaimed") (assert vSelf.acquired "Self lock re-entry must be permitted") true)

fn testStreamFramingNewline -> Bool
  (let [(b1 "(:ping)\n(:next)\n") (r1 (apm/parseStreamFrame b1)) (f1 (pairFirst r1)) (rem1 (pairSecond r1))] (assert (some? f1) "First frame must be extracted") (mt f1 ((some frame) (assert (= frame.payload "(:ping)") "Frame payload must be (:ping)") (assert (= frame.kind "newline") "Frame kind must be newline") (assert frame.valid "Frame must be valid") (assert (= rem1 "(:next)\n") "Remaining buffer must preserve subsequent frames") (let [(r2 (apm/parseStreamFrame rem1)) (f2 (pairFirst r2)) (rem2 (pairSecond r2))] (assert (some? f2) "Second frame must be extracted") (mt f2 ((some frame2) (assert (= frame2.payload "(:next)") "Second frame payload must be (:next)") (assert (= rem2 "") "Remaining buffer after second frame must be empty") true) ((none) false)))) ((none) false)))

fn testStreamFramingContentLength -> Bool
  (let [(header "Content-Length: 14\n\n(:ping :seq 1)TRAILING") (parsed (apm/parseStreamFrame header)) (f (pairFirst parsed)) (rem (pairSecond parsed))] (assert (some? f) "Content-Length frame must be parsed") (mt f ((some frame) (assert (= frame.kind "content-length") "Frame kind must be content-length") (assert (= frame.length 14) "Extracted length must be 14") (assert (= frame.payload "(:ping :seq 1)") "Payload must match chunk length") (assert (= rem "TRAILING") "Remaining buffer must preserve trailing data") true) ((none) false)))

fn testSupervisor10sDeadline -> Bool
  (let [(okVerdict (wd/checkStepDeadline 2500 10000)) (timeoutVerdict (wd/checkStepDeadline 10001 10000)) (supOk (apm/superviseStep 400 10000 ":ping")) (supTimeout (apm/superviseStep 10500 10000 ":exec-slow"))] (refute okVerdict.timedOut "Step under 10s must not time out") (assert (= okVerdict.errorCode ":none") "Normal step must have :none error code") (assert timeoutVerdict.timedOut "Step over 10s must trigger the deadline timeout") (assert (= timeoutVerdict.errorCode ":ERR_STEP_TIMEOUT") "Breached deadline must emit :ERR_STEP_TIMEOUT") (assert (= timeoutVerdict.event ":step-timeout-recycled") "Breached deadline must emit :step-timeout-recycled") (assert (= supOk.status ":ok") "Supervisor status for fast step must be :ok") (refute supOk.workerRecycled "Supervisor must not recycle worker for fast step") (assert (= supTimeout.status ":recycled") "Supervisor status on 10s timeout must be :recycled") (assert (= supTimeout.exitCode 124) "Deadline timeout exit code must be 124") (assert (= supTimeout.errorCode ":ERR_STEP_TIMEOUT") "Supervisor error code must be :ERR_STEP_TIMEOUT") (assert supTimeout.workerRecycled "Worker must be marked as recycled") true)

fn testIntrospectionTable -> Bool
  (let [(e1 (apm/makeDaemonEntry "751f1272" 14842 42 ":active" ":idle")) (tbl (apm/formatDaemonTable (list e1)))] (assert (stringContains? tbl "DAEMON ID") "Table must contain DAEMON ID header") (assert (stringContains? tbl "751f1272") "Table must contain daemon ID") (assert (stringContains? tbl "14842") "Table must contain PID") (assert (stringContains? tbl ":active") "Table must contain status") true)

fn testCountParenBalanceNegativeGuard -> Bool
  (let [(bInvalid (apm/countParenBalance ")(")) (bValid (apm/countParenBalance "(:ok)")) (bExtraClose (apm/countParenBalance "())("))] (assert (< bInvalid 0) ")( must yield negative balance") (refute (apm/isBalancedFrame? ")(") ")( must not be considered balanced") (assert (= bValid 0) "(:ok) must have zero balance") (assert (apm/isBalancedFrame? "(:ok)") "(:ok) is balanced") (assert (< bExtraClose 0) "())( must yield negative balance") (refute (apm/isBalancedFrame? "())(") "())( is not balanced") true)

fn testStreamFramingMultiline -> Bool
  (let [(b1 "(:task\n  :name \"build\"\n  :timeout 5000)\n(:next)\n") (r1 (apm/parseStreamFrame b1)) (f1 (pairFirst r1)) (rem1 (pairSecond r1))] (assert (some? f1) "Multiline frame must be extracted") (mt f1 ((some frame) (assert (= frame.payload "(:task\n  :name \"build\"\n  :timeout 5000)") "Multiline payload matches") (assert (= frame.kind "newline") "Frame kind is newline") (assert frame.valid "Frame is valid") (assert (= rem1 "(:next)\n") "Remaining buffer preserved") (let [(r2 (apm/parseStreamFrame rem1)) (f2 (pairFirst r2)) (rem2 (pairSecond r2))] (assert (some? f2) "Next frame extracted") (mt f2 ((some frame2) (assert (= frame2.payload "(:next)") "Second frame payload is (:next)") (assert (= rem2 "") "Remaining buffer empty") true) ((none) false)))) ((none) false)))

fn testOobDemuxerActiveRamBounded -> Bool
  (let [(d0 (apm/makeOobDemuxer "tmp/test-oob.spool" 67108864)) (chunk "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n") (d300 (fold (fn [(demuxer apm/OobDemuxer) (_i Int64)] -> apm/OobDemuxer (apm/oobDemuxChunk demuxer chunk)) d0 (range 0 300)))] (assert (= d300.totalBytes 24300) "Total bytes reflects cumulative throughput (300 * 81)") (assert (<= d300.bufferBytes 17000) "Active bufferBytes bounded by 200-line RAM ring buffer (<= 200 * 81)") (refute d300.isTerminated "Demuxer is not terminated by cumulative throughput") true)

fn runTests -> Bool
  (let [(r1 (testSingletonLock)) (r2 (testStreamFramingNewline)) (r3 (testStreamFramingContentLength)) (r4 (testSupervisor10sDeadline)) (r5 (testIntrospectionTable)) (r6 (testCountParenBalanceNegativeGuard)) (r7 (testStreamFramingMultiline)) (r8 (testOobDemuxerActiveRamBounded))] (assert r1 "testSingletonLock failed") (assert r2 "testStreamFramingNewline failed") (assert r3 "testStreamFramingContentLength failed") (assert r4 "testSupervisor10sDeadline failed") (assert r5 "testIntrospectionTable failed") (assert r6 "testCountParenBalanceNegativeGuard failed") (assert r7 "testStreamFramingMultiline failed") (assert r8 "testOobDemuxerActiveRamBounded failed") true)
