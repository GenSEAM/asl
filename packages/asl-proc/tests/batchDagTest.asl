(module asl-proc/batchDagTest :x [runTests] :i [(batchDag :a dag)])

fn testStepCreationAndLookup -> Bool
  (let [(s1 (dag/dagStepCreate 1 "init" "ping" "" (list))) (s2 (dag/dagStepCreate 2 "check" "git" "where" (list "init"))) (steps (list s1 s2)) (foundOk (dag/dagFindStep steps "init")) (foundNum (dag/dagFindStep steps "2")) (foundMissing (dag/dagFindStep steps "missing-name"))] (assert (some? foundOk) "Positive lookup by name must succeed") (assert (= (optionOr foundOk s1).op "ping") "Positive lookup by name retrieves correct op") (assert (some? foundNum) "Positive lookup by numeric string id must succeed") (assert (= (optionOr foundNum s2).subop "where") "Positive lookup by numeric string id retrieves correct subop") (assert (none? foundMissing) "Negative lookup for nonexistent step must return none") (refute (some? foundMissing) "Refutation: missing step cannot be resolved") true)

fn testValidDependencies -> Bool
  (let [(s1 (dag/dagStepCreate 1 "init" "ping" "" (list))) (s2 (dag/dagStepCreate 2 "work" "status" "" (list "init"))) (plan (dag/dagPlanCreate "seq" (list s1 s2))) (checked (dag/dagValidateDeps plan))] (assert checked.isValid "Acyclic valid plan must be marked valid") (assert (stringEmpty? checked.errorMsg) "Valid plan must carry empty error message") (assert (= (listLength checked.steps) 2) "Validated plan preserves all declared steps") true)

fn testMissingDependencyRejection -> Bool
  (let [(s1 (dag/dagStepCreate 1 "step-a" "ping" "" (list "ghost-dep"))) (plan (dag/dagPlanCreate "par" (list s1))) (checked (dag/dagValidateDeps plan))] (refute checked.isValid "Plan with missing dependency must be marked invalid") (assert (stringContains? checked.errorMsg "Missing dependency reference: ghost-dep") "Error message must cite missing dependency identifier") (assert (> (stringLength checked.errorMsg) 0) "Error message string is non-empty") true)

fn testSelfDependencyRejection -> Bool
  (let [(s1 (dag/dagStepCreate 1 "step-cyclic" "ping" "" (list "step-cyclic"))) (plan (dag/dagPlanCreate "wave" (list s1))) (checked (dag/dagValidateDeps plan))] (refute checked.isValid "Plan with self-dependency cycle must be marked invalid") (assert (stringContains? checked.errorMsg "Self-dependency detected on step: step-cyclic") "Error message must report self-dependency") (assert (= checked.mode "wave") "Execution mode is preserved in invalid plan") true)

fn testSequentialFailFastSkip -> Bool
  (let [(s1 (dag/BatchDagStep :id 1 :name "step1" :op "ping" :subop "" :status "ok" :deps (list) :reason "")) (s2 (dag/BatchDagStep :id 2 :name "step2" :op "exec" :subop "" :status "error" :deps (list) :reason "exit 1")) (s3 (dag/BatchDagStep :id 3 :name "step3" :op "status" :subop "" :status "pending" :deps (list) :reason "")) (s4 (dag/BatchDagStep :id 4 :name "step4" :op "read" :subop "" :status "pending" :deps (list) :reason "")) (stepped (dag/dagSkipOnPriorFailure (list s1 s2 s3 s4))) (r1 (optionOr (listGet stepped 0) s1)) (r2 (optionOr (listGet stepped 1) s2)) (r3 (optionOr (listGet stepped 2) s3)) (r4 (optionOr (listGet stepped 3) s4))] (assert (= r1.status "ok") "Step 1 prior to error remains ok") (assert (= r2.status "error") "Step 2 keeps error status") (assert (= r3.status "skipped") "Step 3 is marked skipped after prior error") (assert (= r3.reason "aborted-by-prior-error") "Step 3 carries standard fail-fast skip reason") (assert (= r4.status "skipped") "Step 4 is marked skipped after prior error") (refute (= r3.status "pending") "Negative assertion: Step 3 is no longer pending") (refute (= r4.status "ok") "Negative assertion: Step 4 is not ok") true)

fn testWaveCascadingAbort -> Bool
  (let [(s1 (dag/BatchDagStep :id 10 :name "w2-a" :op "sym" :subop "" :status "pending" :deps (list) :reason "")) (s2 (dag/BatchDagStep :id 11 :name "w2-b" :op "find" :subop "" :status "pending" :deps (list) :reason "")) (aborted (dag/dagSkipWaveOnFailure true (list s1 s2))) (passed (dag/dagSkipWaveOnFailure false (list s1 s2))) (a1 (optionOr (listGet aborted 0) s1)) (a2 (optionOr (listGet aborted 1) s2)) (p1 (optionOr (listGet passed 0) s1))] (assert (= a1.status "skipped") "Step 1 in wave 2 is skipped on wave 1 failure") (assert (= a1.reason "aborted-by-prior-wave-failure") "Step 1 carries wave failure reason") (assert (= a2.status "skipped") "Step 2 in wave 2 is skipped on wave 1 failure") (assert (= p1.status "pending") "Wave 2 steps remain intact when wave 1 succeeds") (refute (= a1.status "pending") "Negative assertion: aborted wave step is not pending") true)

fn testBatchSummaryFormatting -> Bool
  (let [(s1 (dag/BatchDagStep :id 1 :name "s1" :op "ping" :subop "" :status "ok" :deps (list) :reason "")) (s2 (dag/BatchDagStep :id 2 :name "s2" :op "exec" :subop "" :status "error" :deps (list) :reason "")) (s3 (dag/BatchDagStep :id 3 :name "s3" :op "read" :subop "" :status "skipped" :deps (list) :reason "")) (summary (dag/dagFormatSummary (list s1 s2 s3)))] (assert (stringContains? summary ":total 3") "Summary reports total 3") (assert (stringContains? summary ":ok 1") "Summary reports ok 1") (assert (stringContains? summary ":error 1") "Summary reports error 1") (assert (stringContains? summary ":skipped 1") "Summary reports skipped 1") (refute (stringContains? summary ":total 0") "Negative assertion: total cannot be 0") true)

fn runTests -> Bool
  (and (testStepCreationAndLookup) (and (testValidDependencies) (and (testMissingDependencyRejection) (and (testSelfDependencyRejection) (and (testSequentialFailFastSkip) (and (testWaveCascadingAbort) (testBatchSummaryFormatting)))))))
