(:doc :symbol "asl/packages/asl-proc/src/spool.asl#DiskSpool.currentBytes" :text "Current byte size of spool data")
(:doc :symbol "asl/packages/asl-proc/src/spool.asl#DiskSpool.content" :text "Spool byte content")
