(module asl-proc/diagnostics :x [Diagnostic DiagnosticSummary parseFileLoc extractPythonFrame parseTscDiagnostic parsePytestDiagnostic extractDiagnostics summarizeDiagnostics scanStreamDiagnostics])

(schema Diagnostic (:f kind String) (:f severity String) (:f message String) (:f file String) (:f line Int64) (:f col Int64) (:f raw (List String)))

(schema DiagnosticSummary (:f errors Int64) (:f warnings Int64) (:f failures Int64) (:f diagnostics (List Diagnostic)))

fn parseFileLoc s: String -> (Pair String (Pair Int64 Int64))
  (let [(parts (stringSplit s ":")) (n (listLength parts))] (cond ((>= n 3) (let [(f (optionOr (listGet parts 0) "")) (lStr (optionOr (listGet parts 1) "")) (cStr (optionOr (listGet parts 2) "")) (l (optionOr (stringToInt64 (stringTrim lStr)) 0)) (c (optionOr (stringToInt64 (stringTrim cStr)) 0))] (pair f (pair l c)))) ((= n 2) (let [(f (optionOr (listGet parts 0) "")) (lStr (optionOr (listGet parts 1) "")) (l (optionOr (stringToInt64 (stringTrim lStr)) 0))] (pair f (pair l 0)))) (else (pair s (pair 0 0)))))

fn extractPythonFrame line: String -> (Pair String Int64)
  (let [(f (if (stringContains? line "File \"") (let [(after (optionOr (listGet (stringSplit line "File \"") 1) "")) (fileParts (stringSplit after "\""))] (optionOr (listGet fileParts 0) "")) "")) (l (if (stringContains? line ", line ") (let [(afterLine (optionOr (listGet (stringSplit line ", line ") 1) "")) (lineNumStr (optionOr (listGet (stringSplit afterLine ",") 0) "")) (cleanNum (optionOr (listGet (stringSplit lineNumStr " ") 0) ""))] (optionOr (stringToInt64 (stringTrim cleanNum)) 0)) 0))] (pair f l))

fn parseTscDiagnostic line: String -> (Option Diagnostic)
  (let [(isErr (stringContains? line " - error TS")) (isWarn (stringContains? line " - warning TS"))] (if (or isErr isWarn) (let [(marker (if isErr " - error TS" " - warning TS")) (sev (if isErr "error" "warning")) (halves (stringSplit line marker)) (locStr (stringTrim (optionOr (listGet halves 0) ""))) (msgTail (stringTrim (optionOr (listGet halves 1) ""))) (loc (parseFileLoc locStr)) (msg (str "TS" msgTail))] (some (Diagnostic :kind "tsc" :severity sev :message msg :file (pairFirst loc) :line (pairFirst (pairSecond loc)) :col (pairSecond (pairSecond loc)) :raw (list line)))) (none)))

fn parsePytestDiagnostic line: String -> (Option Diagnostic)
  (let [(isFailed (stringStartsWith? line "FAILED ")) (isError (stringStartsWith? line "ERROR "))] (if (or isFailed isError) (let [(sev (if isFailed "failure" "error")) (leadLen (if isFailed 7 6)) (body (optionOr (stringSlice line leadLen (stringLength line)) "")) (dashParts (stringSplit body " - ")) (target (optionOr (listGet dashParts 0) "")) (msg (if (> (listLength dashParts) 1) (optionOr (listGet dashParts 1) "") body)) (file (optionOr (listGet (stringSplit target "::") 0) target))] (some (Diagnostic :kind "pytest" :severity sev :message msg :file (stringTrim file) :line 0 :col 0 :raw (list line)))) (none)))

(schema DiagLoopState (:f inTb Bool) (:f tbLines (List String)) (:f tbFile String) (:f tbLine Int64) (:f pendingRustc (Option Diagnostic)) (:f items (List Diagnostic)))

fn closeTraceback st: DiagLoopState errMsg: String -> DiagLoopState
  (let [(rawAll (listReverse st.tbLines)) (d (Diagnostic :kind "python" :severity "error" :message errMsg :file st.tbFile :line st.tbLine :col 0 :raw rawAll))] (with st :inTb false :tbLines (list) :tbFile "" :tbLine 0 :items (cons d st.items)))

fn stepDiagnostic st: DiagLoopState line: String -> DiagLoopState
  (if st.inTb (cond ((stringContains? line "File \"") (let [(frame (extractPythonFrame line))] (with st :inTb true :tbLines (cons line st.tbLines) :tbFile (pairFirst frame) :tbLine (pairSecond frame)))) ((or (stringStartsWith? line " ") (stringStartsWith? line "\t")) (with st :inTb true :tbLines (cons line st.tbLines))) ((stringContains? line "Error") (closeTraceback (with st :inTb true :tbLines (cons line st.tbLines)) line)) (else (let [(closed (closeTraceback st "Python Traceback"))] (stepDiagnostic closed line)))) (mt st.pendingRustc ((some rd) (if (stringContains? line "--> ") (let [(locStr (stringTrim (optionOr (listGet (stringSplit line "--> ") 1) ""))) (loc (parseFileLoc locStr)) (resolvedD (Diagnostic :kind "rustc" :severity rd.severity :message rd.message :file (pairFirst loc) :line (pairFirst (pairSecond loc)) :col (pairSecond (pairSecond loc)) :raw (listAppend rd.raw (list line))))] (DiagLoopState :inTb false :tbLines (list) :tbFile "" :tbLine 0 :pendingRustc (none) :items (cons resolvedD st.items))) (let [(flushed (DiagLoopState :inTb false :tbLines (list) :tbFile "" :tbLine 0 :pendingRustc (none) :items (cons rd st.items)))] (stepDiagnostic flushed line)))) ((none) (cond ((stringStartsWith? line "Traceback (most recent call last):") (with st :inTb true :tbLines (list line) :tbFile "" :tbLine 0 :pendingRustc (none))) ((or (stringStartsWith? line "error[") (stringStartsWith? line "error:")) (with st :inTb false :tbLines (list) :tbFile "" :tbLine 0 :pendingRustc (some (Diagnostic :kind "rustc" :severity "error" :message line :file "" :line 0 :col 0 :raw (list line))))) ((or (stringStartsWith? line "warning[") (stringStartsWith? line "warning:")) (with st :inTb false :tbLines (list) :tbFile "" :tbLine 0 :pendingRustc (some (Diagnostic :kind "rustc" :severity "warning" :message line :file "" :line 0 :col 0 :raw (list line))))) (else (mt (parseTscDiagnostic line) ((some td) (DiagLoopState :inTb false :tbLines (list) :tbFile "" :tbLine 0 :pendingRustc (none) :items (cons td st.items))) ((none) (mt (parsePytestDiagnostic line) ((some pd) (DiagLoopState :inTb false :tbLines (list) :tbFile "" :tbLine 0 :pendingRustc (none) :items (cons pd st.items))) ((none) (if (or (stringStartsWith? line "fatal: ") (stringStartsWith? line "[ERROR] ")) (let [(gd (Diagnostic :kind "generic" :severity "error" :message line :file "" :line 0 :col 0 :raw (list line)))] (DiagLoopState :inTb false :tbLines (list) :tbFile "" :tbLine 0 :pendingRustc (none) :items (cons gd st.items))) st))))))))))

fn extractDiagnostics lines: (List String) -> (List Diagnostic)
  (let [(init (DiagLoopState :inTb false :tbLines (list) :tbFile "" :tbLine 0 :pendingRustc (none) :items (list))) (fin (fold stepDiagnostic init lines)) (withRustc (mt fin.pendingRustc ((some rd) (cons rd fin.items)) ((none) fin.items))) (finalItems (if fin.inTb (let [(rawTb (listReverse fin.tbLines)) (tbD (Diagnostic :kind "python" :severity "error" :message "Python Traceback" :file fin.tbFile :line fin.tbLine :col 0 :raw rawTb))] (cons tbD withRustc)) withRustc))] (listReverse finalItems))

fn summarizeDiagnostics items: (List Diagnostic) -> DiagnosticSummary
  (let [(counts (fold (fn [(acc (pair Int64 (pair Int64 Int64))) (d Diagnostic)] -> (Pair Int64 (Pair Int64 Int64)) (let [(errs (pairFirst acc)) (warns (pairFirst (pairSecond acc))) (fails (pairSecond (pairSecond acc))) (sev d.severity)] (cond ((= sev "error") (pair (+ errs 1) (pair warns fails))) ((= sev "warning") (pair errs (pair (+ warns 1) fails))) ((= sev "failure") (pair errs (pair warns (+ fails 1)))) (else acc)))) (pair 0 (pair 0 0)) items))] (DiagnosticSummary :errors (pairFirst counts) :warnings (pairFirst (pairSecond counts)) :failures (pairSecond (pairSecond counts)) :diagnostics items))

fn scanStreamDiagnostics text: String -> DiagnosticSummary
  (let [(norm (stringReplace text "\r\n" "\n")) (lines (stringSplit norm "\n")) (diags (extractDiagnostics lines))] (summarizeDiagnostics diags))
