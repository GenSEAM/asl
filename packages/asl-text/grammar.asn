(:grammar
  :package asl-text
  :version "0.1.0"
  :tokensBaseline 1
  :symbols [
    (:sym :name "ExtractedDoc" :kind :type :tokens 1)
    (:sym :name "ContextChunk" :kind :type :tokens 1)
    (:sym :name "ContextualClause" :kind :type :tokens 1)
    (:sym :name "UnescapeState" :kind :type :tokens 1)

    (:sym :name "stripEnclosed" :kind :fn :tokens 2
          :rationale "Removes substrings enclosed between opening and closing delimiters")
    (:sym :name "cleanHtml" :kind :fn :tokens 2
          :rationale "Strips script, style, nav, footer, comments, and boilerplate tags")
    (:sym :name "extractHtml" :kind :fn :tokens 2
          :rationale "Extracts structured ExtractedDoc from raw HTML input")
    (:sym :name "extractMarkdown" :kind :fn :tokens 2
          :rationale "Extracts structured ExtractedDoc from markdown text")
    (:sym :name "extractPlaintext" :kind :fn :tokens 2
          :rationale "Normalizes unstructured plain text into ExtractedDoc")
    (:sym :name "extractContext" :kind :fn :tokens 2
          :rationale "Polyglot context extractor routing across supported formats")
    (:sym :name "chunkText" :kind :fn :tokens 2
          :rationale "Splits arbitrary text into sliding-window ContextChunks with overlap")
    (:sym :name "chunkDoc" :kind :fn :tokens 2
          :rationale "Chunks ExtractedDoc into indexed ContextChunks retaining source metadata")
    (:sym :name "extractClauses" :kind :fn :tokens 2
          :rationale "Extracts structured contextual clauses with heading breadcrumbs")
    (:sym :name "runTests" :kind :fn :tokens 2
          :rationale "Standard test runner entrypoint")

    (:sym :name "decodeHtmlEntities" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Replaces standard HTML character entity references with UTF-8 characters")
    (:sym :name "extractJsonKv" :kind :fn :tokens 3
          :rationale "Extracts normalized key-value fields from JSON text payloads")
    (:sym :name "extractXmlAtom" :kind :fn :tokens 3
          :rationale "Extracts clean text content from XML or Atom feed entries")
    (:sym :name "formatChunkMarkdown" :kind :fn :tokens 3
          :rationale "Formats single ContextChunk with citation index and origin header")
    (:sym :name "formatContextRag" :kind :fn :tokens 3
          :rationale "Compiles chunks into token-bounded indexed markdown context block")
    (:sym :name "formatDocsRag" :kind :fn :tokens 3
          :rationale "Compiles multiple extracted documents into indexed prompt context")
    (:sym :name "formatClauseBreadcrumb" :kind :fn :tokens 3
          :rationality :contextSpecific :contextDependent true
          :rationale "Formats contextual breadcrumb prefix for RAG ingestion")
    (:sym :name "formatContextualClause" :kind :fn :tokens 3
          :rationality :contextSpecific :contextDependent true
          :rationale "Formats contextual clause breadcrumb header for RAG context")
    (:sym :name "extractContextualClauses" :kind :fn :tokens 3
          :rationality :contextSpecific :contextDependent true
          :rationale "Extracts hierarchical contextual clauses with breadcrumb preservation")
    (:sym :name "docToAsn" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Encodes ExtractedDoc into compact, canonical ASN S-expression")
    (:sym :name "chunkToAsn" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Encodes ContextChunk into compact, canonical ASN S-expression")
    (:sym :name "clauseToAsn" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Encodes ContextualClause into compact canonical ASN S-expression")
    (:sym :name "escapeAsnStr" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Escapes backslashes, double quotes, and control characters for ASN literals")
    (:sym :name "unescapeAsnStr" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Inverts ASN string literal escaping")
    (:sym :name "escapeJsonStr" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Escapes backslashes, double quotes, and control characters for RFC 8259 JSON literals")
    (:sym :name "unescapeJsonStr" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Inverts RFC 8259 JSON string literal escaping")
    (:sym :name "escapeShArg" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Wraps string argument in POSIX single quotes escaping internal quotes")

    (:sym :name "txt/starts?" :kind :fn :tokens 2
          :rationale "Modular 1-to-2 token alias for string-starts-with?")
    (:sym :name "txt/ends?" :kind :fn :tokens 2
          :rationale "Modular 1-to-2 token alias for string suffix checking")
    (:sym :name "txt/has?" :kind :fn :tokens 2
          :rationale "Modular 1-to-2 token alias for string-contains?")
    (:sym :name "txt/split" :kind :fn :tokens 2
          :rationale "Modular 1-to-2 token alias for string-split")
    (:sym :name "txtStarts?" :kind :fn :tokens 2
          :rationale "Hyphen compatibility alias for txt/starts?")
    (:sym :name "txtEnds?" :kind :fn :tokens 2
          :rationale "Hyphen compatibility alias for txt/ends?")
    (:sym :name "txtHas?" :kind :fn :tokens 2
          :rationale "Hyphen compatibility alias for txt/has?")
    (:sym :name "txtSplit" :kind :fn :tokens 2
          :rationale "Hyphen compatibility alias for txt/split")

    (:sym :name "EmojiViolation" :kind :type :tokens 1)
    (:sym :name "EmojiScanResult" :kind :type :tokens 1)
    (:sym :name "hasRawEmoji?" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Detects presence of raw UTF-8 emoji byte sequences per invariant C2")
    (:sym :name "scanLineEmoji" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Scans an individual line for raw emoji characters and produces optional violation")
    (:sym :name "scanFileEmoji" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Scans all lines of a file and accumulates emoji violations")
    (:sym :name "auditAsnEmojis" :kind :fn :tokens 3
          :rationality :absolute :contextDependent false
          :rationale "Audits a list of file contents and returns true if zero emoji violations exist")
    (:sym :name "stripQuotes" :kind :fn :tokens 2
          :rationale "Strips outer double quotes from string values if present")
    (:sym :name "stripColon" :kind :fn :tokens 2
          :rationale "Strips leading colon from keyword or symbol string")
    (:sym :name "estimateTokens" :kind :fn :tokens 2
          :rationale "Deterministic BPE token count estimation based on character length")
    (:sym :name "calcSavings" :kind :fn :tokens 2
          :rationale "Calculates token savings percentage between original and ASN representation")
    (:sym :name "extractBetween" :kind :fn :tokens 2
          :rationale "Extracts substring between prefix and subsequent suffix")
    (:sym :name "concat" :kind :fn :tokens 1)
    (:sym :name "join" :kind :fn :tokens 1)
  ])

