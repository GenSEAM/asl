(:doc :symbol "asl/packages/asl-text/src/string.asl#stringClipUtf8" :text "s cut to at most n bytes without splitting a UTF-8 character: a cut inside a character moves back to its first byte; n <= 0 gives empty, n >= the byte length returns s")
