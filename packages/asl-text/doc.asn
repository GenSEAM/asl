(:doc :symbol "asl/packages/asl-text/src/escape.asl#" :text "Canonical Pure AgentSlang String Escaping and Wire Serialization Engine.")
(:doc :symbol "asl/packages/asl-text/src/string.asl#" :text "Pure AgentSlang high-performance modular string primitives and 1-to-2 token aliases per d46 and d47.")
(:doc :symbol "asl/packages/asl-text/src/text.asl#" :text "Pure AgentSlang text engine: HTML parsing, entity decoding, multi-format text extraction, chunking, and ASN structuring.")
(:doc :symbol "asl/packages/asl-text/src/say.asl#" :text "Line output to stdout and stderr for packages of every layer; asl-cli/system delegates here (LAYER-CUT-01)")
(:doc :symbol "asl/packages/asl-text/src/say.asl#say!" :text "prints text and a newline to stdout, returns true")
(:doc :symbol "asl/packages/asl-text/src/say.asl#sayErr!" :text "prints text and a newline to stderr, returns true")
