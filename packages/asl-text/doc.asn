(:doc :symbol "asl/packages/asl-text/src/say.asl#sayErr!" :text "prints text and a newline to stderr, returns true")
(:doc :symbol "asl/packages/asl-text/tests/emojiGuardTest.asl#" :text "Comprehensive falsifiable test suite for pure AgentSlang emoji guard per C2.")
(:doc :symbol "asl/packages/asl-text/tests/escapeTest.asl#" :text "Unit tests for pure AgentSlang canonical string escaping engine.")
(:doc :symbol "asl/packages/asl-text/tests/modularAliasesTest.asl#" :text "Unit verification suite for 1-to-2 token modular aliases in asl-text and mem/vfs per d46 and d47.")
(:doc :symbol "asl/packages/asl-text/tests/textTest.asl#" :text "Unit tests for pure AgentSlang text extraction, HTML parsing, contextual clauses, and ASN structuring")
(:doc :symbol "asl/packages/asl-text/src/pad.asl#" :text "Pure AgentSlang string padding and truncation helpers operating on Unicode code points.")
(:doc :symbol "asl/packages/asl-text/src/pad.asl#padStart" :text "Left-pad s to width code points using fill, repeated and cut as needed.")
(:doc :symbol "asl/packages/asl-text/src/pad.asl#padEnd" :text "Right-pad s to width code points using fill, repeated and cut as needed.")
(:doc :symbol "asl/packages/asl-text/src/pad.asl#center" :text "Center s in width code points, extra fill on the right.")
(:doc :symbol "asl/packages/asl-text/src/pad.asl#truncate" :text "Cut s to width code points including marker; marker longer than width returns the marker's prefix.")
(:doc :symbol "asl/packages/asl-text/tests/stringClipTest.asl#runTests" :text "stringClipUtf8 bounds and ASCII cuts, and every cut inside a 2-, 3- and 4-byte character moving back to its start")
(:doc :symbol "asl/packages/asl-text/tests/padTest.asl#runTests" :text "pad gate: padStart on ascii and cyrillic text, padEnd, center, and truncate with a marker, an empty marker, a width above the length and a marker wider than the width")
(:doc :symbol "asl/packages/asl-text/src/queryString.asl#" :text "Pure AgentSlang URL query string codec: ordered key/value pairs with repeated keys kept, + and %XX decoding, and an escaping builder.")
(:doc :symbol "asl/packages/asl-text/src/queryString.asl#parseQuery" :text "Split s on &, drop empty segments, split each at the first =, urlDecode key and value; order and repeated keys preserved; empty s gives no pairs.")
(:doc :symbol "asl/packages/asl-text/src/queryString.asl#buildQuery" :text "Join urlEncode(key)=urlEncode(value) with & in list order; empty list gives the empty string; parseQuery(buildQuery(p)) equals p.")
(:doc :symbol "asl/packages/asl-text/src/queryString.asl#urlEncode" :text "Escape ASCII specials as uppercase %XX and space as +; unreserved alnum -_.~ and non-ASCII or control chars pass through unchanged.")
(:doc :symbol "asl/packages/asl-text/src/queryString.asl#urlDecode" :text "Decode + to space and %XX (either hex case) to the printable ASCII char; truncated or invalid escapes and non-printable codes are kept literally.")
(:doc :symbol "asl/packages/asl-text/tests/queryStringTest.asl#runTests" :text "queryString gate: encode/decode tables, general and lowercase %XX, invalid escapes kept, ordered and repeated keys, empty query, exact build output, and round-trip parse(build(parse)) including encoded specials.")
(:doc :symbol "asl/packages/asl-text/src/dotenv.asl#" :text "Pure AgentSlang dotenv parser and renderer: KEY=VALUE lines with single and double quotes, export prefix and comments, no variable expansion, never reads the environment.")
(:doc :symbol "asl/packages/asl-text/src/dotenv.asl#parseDotenv" :text "Parse dotenv text into ordered key/value rows; skips blank lines and hash comments, strips the export prefix and matching single or double quotes, decodes backslash escapes inside double quotes, performs no variable expansion.")
(:doc :symbol "asl/packages/asl-text/src/dotenv.asl#renderDotenv" :text "Render rows as KEY=VALUE lines, double-quoting and escaping values with edge whitespace, quotes, backslashes, hash or newlines so parseDotenv round-trips every rendered row.")
(:doc :symbol "asl/packages/asl-text/tests/dotenvTest.asl#runTests" :text "dotenv gate: simple rows, single and double quotes, export prefix and comments, no expansion, escape decoding, and render/parse round-trip including edge spaces and embedded quotes.")
(:doc :symbol "asl/packages/asl-text/src/slug.asl#" :text "Pure AgentSlang slug engine: lowercase ascii words joined by a separator, Latin accent folding, run collapsing, edge trimming, and word-boundary max length.")
(:doc :symbol "asl/packages/asl-text/src/slug.asl#slugify" :text "s folded to lowercase ascii words joined by sep; accents fold (ae, oe, ss, th included), non-alphanumerics collapse to one sep, edges trimmed; over maxLen cuts on a word boundary, or mid-word when no separator fits")
(:doc :symbol "asl/packages/asl-text/tests/slugTest.asl#runTests" :text "slug gate: basic joining, collapsing and trimming, accent and ligature folds, word-boundary maxLen cuts, multi-char separators, and empty/punctuation/digit edge cases")
(:doc :symbol "asl/packages/asl-text/src/ini.asl#" :text "Pure AgentSlang INI parser and deterministic renderer: sections of key/value rows, comments, quoted values, repeated keys last wins.")
(:doc :symbol "asl/packages/asl-text/src/ini.asl#IniRow" :text "One key/value row of an INI section: the key and value strings as parsed, the value unquoted and trimmed.")
(:doc :symbol "asl/packages/asl-text/src/ini.asl#IniSection" :text "One INI section: its name (empty for global keys before the first header) and its key/value rows with repeated keys collapsed to the last value.")
(:doc :symbol "asl/packages/asl-text/src/ini.asl#IniRow.key" :text "Key of a key/value row, trimmed")
(:doc :symbol "asl/packages/asl-text/src/ini.asl#IniRow.value" :text "Value of a key/value row, unquoted and trimmed")
(:doc :symbol "asl/packages/asl-text/src/ini.asl#IniSection.name" :text "Section name, empty for global keys before the first header")
(:doc :symbol "asl/packages/asl-text/src/ini.asl#IniSection.rows" :text "Key/value rows of the section, repeated keys collapsed to the last value")
(:doc :symbol "asl/packages/asl-text/src/ini.asl#parseIni" :text "Parse INI text into sections; comments (# or ;) and blank lines skipped, quoted values unquoted, repeated keys last wins; err on a bad header, a line without =, or an empty key")
(:doc :symbol "asl/packages/asl-text/src/ini.asl#renderIni" :text "Render sections deterministically: sections sorted by name with global keys first, rows sorted by key, values quoted when they have surrounding spaces or quotes")
(:doc :symbol "asl/packages/asl-text/tests/iniTest.asl#runTests" :text "ini gate: keys sorted, comments and blanks skipped, repeated keys last wins, quoted values and quote round trip, sections sorted with global keys first, and parse errors for a missing =, an unclosed header and an empty key")
(:doc :symbol "asl/packages/asl-text/src/markdownTable.asl#renderTable" :text "rows of cells rendered as a markdown table whose columns are padded to the widest cell and whose separator row carries the per-column alignment markers l, r or c; no rows gives the empty string")
(:doc :symbol "asl/packages/asl-text/src/markdownTable.asl#parseTable" :text "the header and body rows of a markdown table as trimmed cell lists, blank lines ignored; err when there is no header row or the second row is not a separator")
(:doc :symbol "asl/packages/asl-text/src/markdownTable.asl#parseAligns" :text "one alignment marker per column, l, r or c, read from the separator row; err when there is no header row or the second row is not a separator")
(:doc :symbol "asl/packages/asl-text/tests/markdownTableTest.asl#runTests" :text "render, parse, edge, empty-cell round-trip and narrow-alignment tests of markdownTable, true when all pass")
