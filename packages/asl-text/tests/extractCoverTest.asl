(module asl-text/tests/extractCoverTest :x [runTests] :i [(asl-text/text :a txt)])

; (:m :ref COVBATCH2 :do "extractPlaintext, extractXmlAtom, formatChunkMarkdown had no call path from any test")
fn runTests -> Bool
  (let [(plain (txt/extractPlaintext "  a   b \n\n  c  " "s"))
        (empty (txt/extractPlaintext "" "e"))
        (atom (txt/extractXmlAtom "<entry><title>  A &amp; B </title><summary>Hello <b>world</b></summary></entry>" "feed"))
        (viaContent (txt/extractXmlAtom "<entry><content>Body text</content></entry>" "feed"))
        (untitled (txt/extractXmlAtom "<entry><summary>Only summary</summary></entry>" "feed.xml"))
        (bare (txt/extractXmlAtom "<p>raw</p>" "bare"))
        (chunk (txt/ContextChunk :id "i" :content "body" :index 3 :charCount 4 :source "doc.md"))]
    (do
      (assert (= plain.content "a b\nc") "whitespace runs collapse and blank lines go")
      (assert (= plain.title "s") "plain text takes its source as title")
      (assert (= plain.format "text") "plain text format")
      (assert (= plain.source "s") "plain text keeps the source")
      (assert (= plain.charCount 5) "char count is the cleaned length")
      (assert (= empty.content "") "empty text stays empty")
      (assert (= empty.charCount 0) "empty text has count 0")
      (assert (= atom.title "A & B") "the title is trimmed and entity-decoded")
      (assert (= atom.content "Hello world") "the summary wins and its tags are stripped")
      (assert (= atom.format "xml") "xml format")
      (assert (= atom.charCount 11) "xml char count is the content length")
      (assert (= viaContent.content "Body text") "content is used when there is no summary")
      (assert (= untitled.title "feed.xml") "no title falls back to the source")
      (assert (= untitled.content "Only summary") "summary content")
      (assert (= bare.content "raw") "no summary or content cleans the whole document")
      (assert (= (txt/formatChunkMarkdown chunk) "[3] (doc.md):\nbody\n") "a chunk renders index, source and body")
      (assert (= (txt/formatChunkMarkdown (with chunk :content "" :index 0)) "[0] (doc.md):\n\n") "an empty chunk keeps its header")
      true))
