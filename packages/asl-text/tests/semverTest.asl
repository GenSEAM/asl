(module asl-text/tests/semverTest :x [runTests] :i [(asl-text/semver :a sv)])

fn mkV mj: Int64 mn: Int64 pt: Int64 -> sv/Version
  (sv/Version :major mj :minor mn :patch pt :pre (list) :build (list))

fn pv s: String -> sv/Version
  (resultOr (sv/parse s) (mkV 0 0 0))

fn testParse -> Bool
  (do (assert (ok? (sv/parse "1.2.3")) "parse 1.2.3 ok")
      (assert (err? (sv/parse "1.2")) "core needs 3 parts")
      (assert (err? (sv/parse "01.2.3")) "leading zero major")
      (assert (err? (sv/parse "1.02.3")) "leading zero minor")
      (assert (err? (sv/parse "1.2.03")) "leading zero patch")
      (assert (ok? (sv/parse "1.0.0-alpha")) "prerelease alpha ok")
      (assert (ok? (sv/parse "1.0.0-alpha.1")) "prerelease alpha.1 ok")
      (assert (err? (sv/parse "1.0.0-alpha..1")) "empty pre id err")
      (assert (err? (sv/parse "1.0.0-")) "trailing hyphen err")
      (assert (ok? (sv/parse "1.0.0+build")) "build ok")
      (assert (ok? (sv/parse "1.0.0+001")) "build leading zero ok")
      (assert (err? (sv/parse "1.0.0+")) "trailing plus err")
      (assert (ok? (sv/parse "1.0.0-alpha+beta")) "alpha+beta ok")
      (assert (err? (sv/parse "1.0.0-alpha_beta")) "underscore err")
      (assert (err? (sv/parse "1.0.0-01")) "numeric pre leading zero err")
      (assert (ok? (sv/parse "1.0.0-0")) "numeric pre zero ok")
      (assert (err? (sv/parse "9223372036854775808.0.0")) "core overflow err")
      true)

fn testCompare -> Bool
  (do (assert (= (sv/compare (mkV 1 0 0) (mkV 2 0 0)) -1) "1.0.0 < 2.0.0")
      (assert (= (sv/compare (mkV 2 0 0) (mkV 1 0 0)) 1) "2.0.0 > 1.0.0")
      (assert (= (sv/compare (mkV 1 0 0) (mkV 1 1 0)) -1) "minor")
      (assert (= (sv/compare (mkV 1 0 0) (mkV 1 0 1)) -1) "patch")
      (assert (= (sv/compare (mkV 1 0 0) (mkV 1 0 0)) 0) "equal")
      (assert (< (sv/compare (pv "1.0.0-alpha") (pv "1.0.0-alpha.1")) 0) "alpha < alpha.1")
      (assert (< (sv/compare (pv "1.0.0-alpha.1") (pv "1.0.0-alpha.beta")) 0) "1 < beta")
      (assert (< (sv/compare (pv "1.0.0-alpha.beta") (pv "1.0.0-beta")) 0) "beta after alpha.beta")
      (assert (< (sv/compare (pv "1.0.0-beta") (pv "1.0.0-beta.2")) 0) "beta < beta.2")
      (assert (< (sv/compare (pv "1.0.0-beta.2") (pv "1.0.0-beta.11")) 0) "beta.2 < beta.11")
      (assert (< (sv/compare (pv "1.0.0-beta.11") (pv "1.0.0-rc.1")) 0) "rc after beta")
      (assert (< (sv/compare (pv "1.0.0-rc.1") (mkV 1 0 0)) 0) "rc < release")
      (assert (= (sv/compare (pv "1.0.0+build") (pv "1.0.0+other")) 0) "build ignored")
      (assert (> (sv/compare (pv "1.0.0-999999999999999999999999") (pv "1.0.0-2")) 0) "big numeric pre")
      (assert (< (sv/compare (pv "1.0.0-2") (pv "1.0.0-999999999999999999999999")) 0) "small numeric pre")
      true)

fn testSatisfies -> Bool
  (let [(v1 (mkV 1 2 3))
        (v2 (mkV 1 5 0))
        (v3 (mkV 2 0 0))
        (v4 (mkV 0 2 5))
        (v5 (mkV 0 3 0))
        (v6 (mkV 0 0 4))
        (v7 (mkV 0 0 3))]
    (do (assert (sv/satisfies v1 "^1.2.3") "caret lower")
        (assert (sv/satisfies v2 "^1.2.3") "caret upper")
        (assert (not (sv/satisfies v3 "^1.2.3")) "caret excl")
        (assert (sv/satisfies v4 "^0.2.3") "caret 0.x lower")
        (assert (not (sv/satisfies v5 "^0.2.3")) "caret 0.x excl")
        (assert (sv/satisfies v7 "^0.0.3") "caret 0.0.x lower")
        (assert (not (sv/satisfies v6 "^0.0.3")) "caret 0.0.x excl")
        (assert (sv/satisfies v1 "~1.2.3") "tilde lower")
        (assert (not (sv/satisfies v2 "~1.2.3")) "tilde excl")
        (assert (sv/satisfies (mkV 1 2 9) "~1.2.3") "tilde patch ok")
        (assert (sv/satisfies (mkV 1 5 0) "~1") "tilde major only")
        (assert (sv/satisfies (mkV 0 5 0) "^0") "caret zero major only")
        (assert (sv/satisfies (pv "1.2.3-alpha") "^1.2.3-alpha") "caret pre lower")
        (assert (sv/satisfies (pv "1.2.3-beta") "^1.2.3-alpha") "caret pre beta")
        (assert (not (sv/satisfies (pv "1.2.4-beta") "^1.2.3-alpha")) "caret pre other tuple")
        (assert (sv/satisfies v1 ">=1.0.0") "gte")
        (assert (not (sv/satisfies v1 "<1.0.0")) "lt")
        (assert (sv/satisfies v1 "=1.2.3") "eq")
        (assert (not (sv/satisfies v1 "=1.2.4")) "neq")
        (assert (sv/satisfies v1 ">1.2.2") "gt")
        (assert (not (sv/satisfies v1 ">1.2.3")) "not gt")
        (assert (sv/satisfies v1 "<=1.2.3") "lte")
        (assert (not (sv/satisfies v1 "<=1.2.2")) "not lte")
        (assert (sv/satisfies v1 "1.2.3") "bare eq")
        (assert (not (sv/satisfies (mkV 1 2 1) ">1.2")) "gt partial excludes same minor")
        (assert (sv/satisfies (mkV 1 3 0) ">1.2") "gt partial starts next minor")
        (assert (sv/satisfies (mkV 1 2 1) "<=1.2") "lte partial covers minor series")
        (assert (not (sv/satisfies (mkV 1 3 0) "<=1.2")) "lte partial excludes next minor")
        (assert (not (sv/satisfies (mkV 1 9 9) ">1")) "gt major only excludes same major")
        (assert (sv/satisfies (mkV 2 0 0) ">1") "gt major only starts next major")
        (assert (sv/satisfies (mkV 1 9 9) "<=1") "lte major only covers major series")
        (assert (not (sv/satisfies (mkV 2 0 0) "<=1")) "lte major only excludes next major")
        (assert (sv/satisfies (mkV 1 2 1) ">=1.2") "gte partial includes minor series")
        (assert (not (sv/satisfies (mkV 1 2 1) "<1.2")) "lt partial excludes minor series")
        true))

fn runTests -> Bool
  (and (testParse) (testCompare) (testSatisfies))
