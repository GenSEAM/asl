;; Package Grammar & Exported Symbol Registry (ASN)
;; @genseam/asl-bridge
(:grammar
  :package @genseam/asl-bridge
  :version "0.1.0"
  :tokens-baseline 1
  :symbols [
    ;; 1-Token Baseline Types
    (:sym :name "DbColumn" :kind :type :tokens 1)
    (:sym :name "DbResult" :kind :type :tokens 1)
    (:sym :name "DriverKind" :kind :type :tokens 1)
    (:sym :name "QueryPlan" :kind :type :tokens 1)
    (:sym :name "TableDef" :kind :type :tokens 1)
    (:sym :name "TierKind" :kind :type :tokens 1)

    ;; <= 2-Token Primary API Symbols
    (:sym :name "col-category" :kind :fn :tokens 2)
    (:sym :name "driver-tier" :kind :fn :tokens 2)
    (:sym :name "kysely-type" :kind :fn :tokens 2)
    (:sym :name "plan-custom" :kind :fn :tokens 2)
    (:sym :name "plan-query" :kind :fn :tokens 2)
    (:sym :name "route-workload" :kind :fn :tokens 2)
    (:sym :name "run-tests" :kind :fn :tokens 2)
    (:sym :name "sample-table" :kind :fn :tokens 2)
    (:sym :name "seaorm-type" :kind :fn :tokens 2)
    (:sym :name "sqlalchemy-type" :kind :fn :tokens 2)

    ;; Multi-Token Symbols (with verified architectural :rationale)
    (:sym :name "driver-kind-to-str" :kind :fn :tokens 4
          :rationale "Converts DriverKind enum variant into canonical driver string identifier")
    (:sym :name "drizzle-col-builder" :kind :fn :tokens 3
          :rationale "Builds TypeScript Drizzle ORM column builder expression with dialect-specific constraints")
    (:sym :name "drizzle-type-fn" :kind :fn :tokens 3
          :rationale "Maps ASL primitive column type to corresponding Drizzle column builder function")
    (:sym :name "is-host-tier?" :kind :fn :tokens 3
          :rationale "Predicate testing whether target workload requires host IPC execution tier")
    (:sym :name "is-microvm-tier?" :kind :fn :tokens 3
          :rationale "Predicate testing whether target workload requires isolated microVM execution tier")
    (:sym :name "is-wasm-tier?" :kind :fn :tokens 3
          :rationale "Predicate testing whether target workload executes in sandboxed WebAssembly tier")
    (:sym :name "make-db-column" :kind :fn :tokens 3
          :rationale "Constructs DbColumn record specifying name, type, nullability, and primary key status")
    (:sym :name "make-db-result" :kind :fn :tokens 3
          :rationale "Encapsulates database execution output containing returned row maps and affected row count")
    (:sym :name "make-query-plan" :kind :fn :tokens 3
          :rationale "Builds execution plan binding SQL statement, target execution tier, and query parameters")
    (:sym :name "make-table-def" :kind :fn :tokens 3
          :rationale "Constructs entity table schema definition binding table name with typed column schema list")
    (:sym :name "render-kysely-col" :kind :fn :tokens 3
          :rationale "Transpiles DbColumn schema definition into TypeScript Kysely interface field declaration")
    (:sym :name "render-seaorm-col" :kind :fn :tokens 3
          :rationale "Transpiles DbColumn schema definition into Rust SeaORM entity struct field with derive annotations")
    (:sym :name "render-sqlalchemy-col" :kind :fn :tokens 3
          :rationale "Transpiles DbColumn schema definition into Python SQLAlchemy Column attribute assignment")
    (:sym :name "str-to-driver-kind" :kind :fn :tokens 4
          :rationale "Parses canonical driver string identifier into typed DriverKind enum variant")
    (:sym :name "str-to-tier-kind" :kind :fn :tokens 4
          :rationale "Parses execution tier name string into typed TierKind enum variant")
    (:sym :name "table-to-drizzle" :kind :fn :tokens 3
          :rationale "Generates complete TypeScript Drizzle ORM schema table definition from TableDef record")
    (:sym :name "table-to-kysely" :kind :fn :tokens 3
          :rationale "Generates complete TypeScript Kysely database interface definition from TableDef record")
    (:sym :name "table-to-seaorm" :kind :fn :tokens 3
          :rationale "Generates complete Rust SeaORM entity struct and Model/ActiveModel definitions from TableDef")
    (:sym :name "table-to-sqlalchemy" :kind :fn :tokens 3
          :rationale "Generates complete Python SQLAlchemy declarative base model class from TableDef record")
    (:sym :name "test-ports-and-types" :kind :fn :tokens 4
          :rationale "Test suite verifying DbColumn, TableDef, QueryPlan, and DriverKind/TierKind conversions")
    (:sym :name "test-router-planning" :kind :fn :tokens 3
          :rationale "Test suite validating query planning defaults and tier selection per driver kind")
    (:sym :name "test-router-workload" :kind :fn :tokens 3
          :rationale "Test suite validating workload tier routing based on socket and GPU requirements")
    (:sym :name "test-schema-drizzle" :kind :fn :tokens 3
          :rationale "Test suite validating TypeScript Drizzle ORM schema transpilation")
    (:sym :name "test-schema-kysely" :kind :fn :tokens 3
          :rationale "Test suite validating TypeScript Kysely interface transpilation")
    (:sym :name "test-schema-seaorm" :kind :fn :tokens 3
          :rationale "Test suite validating Rust SeaORM entity struct transpilation")
    (:sym :name "test-schema-sqlalchemy" :kind :fn :tokens 3
          :rationale "Test suite validating Python SQLAlchemy declarative model transpilation")
    (:sym :name "tier-kind-to-str" :kind :fn :tokens 4
          :rationale "Converts TierKind enum variant into canonical execution tier name string")
    (:sym :name "to-pascal-case" :kind :fn :tokens 3
          :rationale "Converts snake_case and kebab-case identifiers to PascalCase for type and struct names")
  ])
