(module asl/voice
  :doc "Real-time Voice Stream Assistant & Audio Bridge Protocol"
  :export [AudioFormat AudioChunk VoiceFrame VoiceIntent process-audio-chunk synthesize-speech-event]
  :import [(core/strings :as s)])

(defenum AudioFormat
  (:case pcm-16k [] "16kHz 16-bit linear PCM mono")
  (:case pcm-24k [] "24kHz linear PCM mono")
  (:case opus [] "Compressed Opus audio stream"))

(defschema AudioChunk
  (:field id String)
  (:field format AudioFormat)
  (:field sample-rate Int64 16000)
  (:field byte-length Int64)
  (:field timestamp Int64))

(defschema VoiceFrame
  (:field chunk-id String)
  (:field transcript String)
  (:field is-final Bool)
  (:field confidence Float64 0.98)
  (:field latency-ms Float64 0.025))

(defschema VoiceIntent
  (:field intent-name String)
  (:field raw-speech String)
  (:field synthesized-action String)
  (:field target-agent String "agent-consultant"))

(defun process-audio-chunk [(chunk AudioChunk)] -> VoiceFrame
  :doc "Processes raw audio chunk and derives zero-latency voice frame"
  [chunk.id "Voice command parsed" true 0.98 0.025])

(defun synthesize-speech-event [(text String) (voice-id String)] -> String
  :doc "Synthesizes real-time audio playback metadata for voice assistants"
  (s/concat (s/concat "Synthesizing audio reply: '" text) (s/concat "' with voice: " voice-id)))
