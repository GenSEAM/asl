(:knowGroups :rule "L0 lists one line per group; a package card belongs to the group whose :members names it, core/* cards form the core group; a card no row lists lands in an other group that knowCardsTest rejects, so a new package needs a member entry here")
(:group :id "agent" :purpose "agent loop, bus and message core, harness, mesh orchestration, gateway, replay, memory, small models" :members "asl-agent asl-agent-bus asl-agent-core asl-harness asl-mesh asl-coord asl-gateway asl-replay asl-slm asl-mem")
(:group :id "runtime" :purpose "processes, sockets, scheduling, engine, remote targets, runtime memory, packaging, contracts, time zones, blob store" :members "asl-engine asl-net asl-proc asl-remote asl-sched asl-runtime asl-utils asl-tz asl-cas asl-pack asl-plugin asl-contracts")
(:group :id "frontend" :purpose "parsing, syntax trees, grammar, type checker, IR, compiler driver, lint, schema derive, forms, conformance, tokenizer" :members "asl-parser asl-syntax asl-grammar asl-checker asl-ir asl-compiler asl-lint asl-derive asl-forms asl-foreign asl-conform asl-transpile asl-codegen asl-tokenizer")
(:group :id "targets" :purpose "code generation backends: C, Go, JavaScript, LLVM, Python, shell, Swift" :members "asl-target-c asl-target-go asl-target-js asl-target-llvm asl-target-py asl-target-sh asl-target-swift")
(:group :id "tooling" :purpose "command line, help catalog, knowledge cards, verification gates, code intelligence, hypergraph" :members "asl-cli asl-help asl-know asl-gates asl-intel asl-hypergraph")
(:group :id "data" :purpose "formats, protocols and numbers: JSON, CSV, Parquet, zip, regex, SQL, S3, HTTP, crypto, text, statistics" :members "asl-json asl-csv asl-parquet asl-zip asl-regex asl-sql asl-s3 asl-http asl-crypto asl-text asl-stats")
(:group :id "media" :purpose "HTML, UI, virtual DOM, ffmpeg media, audio, voice, vectorising images, browser plugin, web crawler" :members "asl-html asl-ui asl-vdom asl-media asl-audio asl-voice asl-vector asl-browser-plugin asl-crawler")
