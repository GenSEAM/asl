(:doc :symbol "asl/packages/asl-know/src/know.asl#ratchetDiff" :text "Pair of computed rows not listed and listed rows no longer computed")
(:doc :symbol "asl/packages/asl-know/src/know.asl#writeCards!" :text "Write every rendered card file; the count written or the first failure")
(:doc :symbol "asl/packages/asl-know/src/know.asl#know!" :text "Answer a query against the cards written under ROOT")
