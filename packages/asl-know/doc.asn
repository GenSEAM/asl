(:doc :symbol "asl/packages/asl-know/src/scan.asl#" :text "Source facts for knowledge cards: module headers, column-0 declarations, doc.asn rows and prelude.asn builtins, read as text")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#Decl" :text "One column-0 declaration: name, kind fn, fn!, type or ctor, its header text, and the enum owning a ctor")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#Module" :text "A source module: path, declared name, export list and declarations by name")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#Package" :text "A package: manifest description and entry, dependencies, modules and doc.asn rows")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#Builtin" :text "A prelude builtin: name, prelude.asn section, checker type and doc")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#quoteEnd" :text "Byte index of the closing quote of an ASN string starting at i, skipping backslash escapes; -1 when unterminated")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#unescape" :text "Undo ASN string escapes; newline and tab escapes become spaces")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#fieldAfter" :text "The unescaped string value after key in a single-line ASN row, or none")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#compact" :text "Collapse newlines and runs of blanks into single spaces, trimmed")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#docRows!" :text "Map from doc.asn :symbol to :text for one ledger file; an unreadable file is an empty map")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#moduleOf" :text "Module facts from source text: header name and :x exports, fn, schema, enum and constructor declarations")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#sourceFiles!" :text "Every .asl file under a directory, recursively, in dirList order")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#packagesOf!" :text "Every directory under asl/packages with a manifest.asn, scanned into Package facts")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#builtinsFrom" :text "Prelude builtins from prelude.asn text, typed by the checker builtinSig when it knows the name, absent names dropped")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#builtinsOf!" :text "builtinsFrom applied to ROOT/asl/prelude/prelude.asn")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#returnType" :text "The text after the first arrow of a signature, or empty")
(:doc :symbol "asl/packages/asl-know/src/scan.asl#effectful?" :text "True for a fn declared fn ! or a name ending in !")
(:doc :symbol "asl/packages/asl-know/src/render.asl#" :text "Renders the L0 index, L1 cards and L2 symbol rows as single-line ASN frames")
(:doc :symbol "asl/packages/asl-know/src/render.asl#Card" :text "One rendered card: id, purpose, index keys, the card line, its L2 rows and its missing-contract rows")
(:doc :symbol "asl/packages/asl-know/src/render.asl#q" :text "ASN string literal with backslash, quote, newline and tab escaped")
(:doc :symbol "asl/packages/asl-know/src/render.asl#unquoteRow" :text "The string of a line holding one ASN string literal, or none")
(:doc :symbol "asl/packages/asl-know/src/render.asl#tokensOf" :text "Token estimate as bytes/3.6 rounded up, calibrated on o200k counts of the L0 index 2026-10-15; knowCardsTest checks the index against o200k counts")
(:doc :symbol "asl/packages/asl-know/src/render.asl#camelId" :text "Example file stem for a card id: asl-json becomes aslJson, core/list becomes coreList")
(:doc :symbol "asl/packages/asl-know/src/render.asl#cardFile" :text "Card file name for a card id: slash becomes dash, plus .asn")
(:doc :symbol "asl/packages/asl-know/src/render.asl#exampleText" :text "An example module text up to its selfTest fn, trimmed")
(:doc :symbol "asl/packages/asl-know/src/render.asl#pitTags" :text "Pitfall tags of a declaration: result, option, effect, ctor, record; explained by the language card")
(:doc :symbol "asl/packages/asl-know/src/render.asl#packageCard" :text "L1 card and L2 rows of a package, entry module first; signatures fill about 600 bytes, further names about 160, five modules listed")
(:doc :symbol "asl/packages/asl-know/src/render.asl#areaCards" :text "One L1 card per prelude.asn section with an L2 row per builtin")
(:doc :symbol "asl/packages/asl-know/src/render.asl#langCard" :text "The core/lang card from lang.asn rules and pitfall tags plus the coreLang example")
(:doc :symbol "asl/packages/asl-know/src/render.asl#indexText" :text "L0 index: one (:g id count purpose members) line per group; the per-card lines are in index-GROUP.asn")
(:doc :symbol "asl/packages/asl-know/src/render.asl#missingOf" :text "Sorted missing rows of all cards: card#module/name nodecl or nodoc")
(:doc :symbol "asl/packages/asl-know/src/render.asl#allCards!" :text "Every card: language card, prelude areas, then packages in directory order")
(:doc :symbol "asl/packages/asl-know/src/query.asl#" :text "Intent query over written cards: IDF-weighted term overlap, camelCase split, exact names first, filled to a token budget")
(:doc :symbol "asl/packages/asl-know/src/query.asl#Row" :text "A loaded L2 row with its card, name, line and name and text terms")
(:doc :symbol "asl/packages/asl-know/src/query.asl#Entry" :text "A loaded card with its line, card terms and rows")
(:doc :symbol "asl/packages/asl-know/src/query.asl#termsOf" :text "Lower-case search terms of a text: camelCase and punctuation split, stop words dropped, plural s stripped, a few synonyms added (directory dir, shell process, decompress gunzip)")
(:doc :symbol "asl/packages/asl-know/src/query.asl#loadEntries!" :text "Every card file of a cards directory except the index*.asn files, loaded as entries")
(:doc :symbol "asl/packages/asl-know/src/query.asl#answer" :text "Answer for a query: an exact card id or symbol, else up to two ranked cards and twelve ranked rows within budget")
(:doc :symbol "asl/packages/asl-know/src/know.asl#" :text "asl know: gen writes the cards, check reports drift, ratchet rewrites missing.asn, q answers a query")
(:doc :symbol "asl/packages/asl-know/src/know.asl#rendered!" :text "Every card file name with the bytes the source renders to")
