(:card "asl-regex" :purpose "Pure ASL regular-expression library with RE2-style linear-time Pike VM execution (no backtracking)" :import "(asl-regex/regex :a x)" :modules ((:m "asl-regex/regex" :doc "Pure ASL linear-time regular expression engine (RE2-styl...")) :sigs ("schema Match { start: Int64 end: Int64 text: String groups: (List (Option String))" "schema Regex { pattern: String unanchoredCode: I64Array unanchoredLen: Int64 anchoredCode: I64Array anchoredLen: Int64 nsub: Int64 classes: ..." "regex-compile! pattern: String -> (Result Regex String)" "regex-compile-flags! pattern: String multiline: Bool dotall: Bool ignoreCase: Bool -> (Result Regex String)" "regex-search! re: Regex s: String -> (Option Match)" "regex-match-full! re: Regex s: String -> (Option Match)" "regex-find-all! re: Regex s: String -> (List Match)") :more (regex-replace-all! regex-group regex-match?) :effects (regex-compile! regex-compile-flags! regex-search! regex-match-full! regex-find-all! regex-replace-all! regex-match?) :fails (regex-compile! regex-compile-flags!) :example "(module asl-know/examples/aslRegex :x [countNumbers! firstGroup! selfTest] :i [(asl-regex/regex :a rx)])\n\nfn ! countNumbers! s: String -> Int64\n  (match (rx/regex-compile! \"[0-9]+\")\n    ((err _) -1)\n    ((ok re) (listLength (rx/regex-find-all! re s))))\n\nfn ! firstGroup! s: String -> String\n  (match (rx/regex-compile! \"id=([0-9]+)\")\n    ((err _) \"\")\n    ((ok re)\n      (match (rx/regex-search! re s)\n        ((none) \"\")\n        ((some m) (optionOr (rx/regex-group m 1) \"\")))))")
(:sym "Match" :mod "asl-regex/regex" :kind type :sig "schema Match { start: Int64 end: Int64 text: String groups: (List (Option String))")
(:sym "Regex" :mod "asl-regex/regex" :kind type :sig "schema Regex { pattern: String unanchoredCode: I64Array unanchoredLen: Int64 anchoredCode: I64Array anchoredLen: Int64 nsub: Int64 classes: (List Bytes) multiline: Bool dotall: Bool ignoreCase: Bool")
(:sym "regex-compile!" :mod "asl-regex/regex" :sig "regex-compile! pattern: String -> (Result Regex String)" :pit (result effect))
(:sym "regex-compile-flags!" :mod "asl-regex/regex" :sig "regex-compile-flags! pattern: String multiline: Bool dotall: Bool ignoreCase: Bool -> (Result Regex String)" :pit (result effect))
(:sym "regex-search!" :mod "asl-regex/regex" :sig "regex-search! re: Regex s: String -> (Option Match)" :pit (option effect))
(:sym "regex-match-full!" :mod "asl-regex/regex" :sig "regex-match-full! re: Regex s: String -> (Option Match)" :pit (option effect))
(:sym "regex-find-all!" :mod "asl-regex/regex" :sig "regex-find-all! re: Regex s: String -> (List Match)" :pit (effect))
(:sym "regex-replace-all!" :mod "asl-regex/regex" :sig "regex-replace-all! re: Regex s: String template: String -> String" :pit (effect))
(:sym "regex-group" :mod "asl-regex/regex" :sig "regex-group m: Match i: Int64 -> (Option String)" :pit (option))
(:sym "regex-match?" :mod "asl-regex/regex" :kind fn! :sig "regex-match? re: Regex s: String -> Bool" :pit (effect))
