(:card "asl-utils" :purpose "Optional coreutils-style commands missing on macOS or Linux, in pure AgentSlang: timeout" :import "(asl-utils/timeout :a x)" :modules ((:m "asl-utils/timeout" :doc "asl timeout SECS -- argv...: GNU timeout convention (exi...")) :sigs ("parseTimeout text: String -> (Option Int64)" "timeoutMsOf text: String -> Int64" "exitOfStatus status: Int64 -> Int64" "timeoutRun! ms: Int64 argv: (List String) -> Int64" "drainFd! fd: Int64 isOpen: Bool dest: Int64 -> Bool" "readRest! fd: Int64 isOpen: Bool acc: String -> String" "cmdOf args: (List String) -> (List String)" "brokenPipe? e: String -> Bool" "closure procs: (List fr/Proc) members: (List Int64) self: Int64 rounds: Int64 -> (List Int64)" "startOf starts: (List (Pair Int64 String)) pid: Int64 -> String") :more (Run) :effects (timeoutRun! drainFd! readRest!) :example none)
(:sym "parseTimeout" :mod "asl-utils/timeout" :sig "parseTimeout text: String -> (Option Int64)" :pit (option))
(:sym "timeoutMsOf" :mod "asl-utils/timeout" :sig "timeoutMsOf text: String -> Int64")
(:sym "exitOfStatus" :mod "asl-utils/timeout" :sig "exitOfStatus status: Int64 -> Int64")
(:sym "timeoutRun!" :mod "asl-utils/timeout" :kind fn! :sig "timeoutRun! ms: Int64 argv: (List String) -> Int64" :doc "Limits until PROCSHIM-DETACH gives a real process group: a descendant that called setsid or double-forked away from the tree is out of reach and survives expiry; the tree is tracked by parentage and re-swept every 0.5 s, each pid pinned to ..." :pit (effect))
(:sym "drainFd!" :mod "asl-utils/timeout" :kind fn! :sig "drainFd! fd: Int64 isOpen: Bool dest: Int64 -> Bool" :pit (effect))
(:sym "readRest!" :mod "asl-utils/timeout" :kind fn! :sig "readRest! fd: Int64 isOpen: Bool acc: String -> String" :pit (effect))
(:sym "cmdOf" :mod "asl-utils/timeout" :sig "cmdOf args: (List String) -> (List String)")
(:sym "brokenPipe?" :mod "asl-utils/timeout" :sig "brokenPipe? e: String -> Bool")
(:sym "closure" :mod "asl-utils/timeout" :sig "closure procs: (List fr/Proc) members: (List Int64) self: Int64 rounds: Int64 -> (List Int64)")
(:sym "startOf" :mod "asl-utils/timeout" :sig "startOf starts: (List (Pair Int64 String)) pid: Int64 -> String")
(:sym "Run" :mod "asl-utils/timeout" :kind type :sig "(schema Run (:f pid Int64) (:f outFd Int64) (:f errFd Int64) (:f inFd Int64) (:f outOpen Bool) (:f errOpen Bool) (:f inOpen Bool) (:f srcOpen Bool) (:f pending String) (:f known (List (Pair Int64 String))) (:f sweptNs Int64) (:f deadlineNs Int64))" :pit (record))
