(:card "asl-utils" :purpose "Optional coreutils-style commands missing on macOS or Linux, in pure AgentSlang: timeout; and the script kit: flags, args, env, glob, atomic edits with --dry diffs, guarded children" :import "(asl-utils/timeout :a x)" :deps (asl-regex) :modules ((:m "asl-utils/timeout") (:m "asl-utils/binaryHeap") (:m "asl-utils/checksums") (:m "asl-utils/deque") (:m "asl-utils/duration")) :moduleCount 10 :sigs ("parseTimeout text: String -> (Option Int64)" "timeoutMsOf text: String -> Int64" "exitOfStatus status: Int64 -> Int64" "timeoutRun! ms: Int64 argv: (List String) -> Int64" "drainFd! fd: Int64 isOpen: Bool dest: Int64 -> Bool" "readRest! fd: Int64 isOpen: Bool acc: String -> String" "cmdOf args: (List String) -> (List String)" "brokenPipe? e: String -> Bool" "closure procs: (List fr/Proc) members: (List Int64) self: Int64 rounds: Int64 -> (List Int64)" "startOf starts: (List (Pair Int64 String)) pid: Int64 -> String") :more (Run push pop peek fromList toSortedList adler32 fnv1a32 fnv1a64 crc32 Deque empty pushFront pushBack popFront popBack toList parseDuration formatDuration) :moreCount 53 :effects (timeoutRun! drainFd! readRest! run! env glob! globGit! readText!) :fails (parseDuration hexDecode parse run! readText! readLines! writeText! editRx!) :example none)
(:sym "parseTimeout" :mod "asl-utils/timeout" :sig "parseTimeout text: String -> (Option Int64)" :pit (option))
(:sym "timeoutMsOf" :mod "asl-utils/timeout" :sig "timeoutMsOf text: String -> Int64")
(:sym "exitOfStatus" :mod "asl-utils/timeout" :sig "exitOfStatus status: Int64 -> Int64")
(:sym "timeoutRun!" :mod "asl-utils/timeout" :kind fn! :sig "timeoutRun! ms: Int64 argv: (List String) -> Int64" :pit (effect))
(:sym "drainFd!" :mod "asl-utils/timeout" :kind fn! :sig "drainFd! fd: Int64 isOpen: Bool dest: Int64 -> Bool" :pit (effect))
(:sym "readRest!" :mod "asl-utils/timeout" :kind fn! :sig "readRest! fd: Int64 isOpen: Bool acc: String -> String" :pit (effect))
(:sym "cmdOf" :mod "asl-utils/timeout" :sig "cmdOf args: (List String) -> (List String)")
(:sym "brokenPipe?" :mod "asl-utils/timeout" :sig "brokenPipe? e: String -> Bool")
(:sym "closure" :mod "asl-utils/timeout" :sig "closure procs: (List fr/Proc) members: (List Int64) self: Int64 rounds: Int64 -> (List Int64)")
(:sym "startOf" :mod "asl-utils/timeout" :sig "startOf starts: (List (Pair Int64 String)) pid: Int64 -> String")
(:sym "Run" :mod "asl-utils/timeout" :kind type :sig "(schema Run (:f pid Int64) (:f outFd Int64) (:f errFd Int64) (:f inFd Int64) (:f outOpen Bool) (:f errOpen Bool) (:f inOpen Bool) (:f srcOpen Bool) (:f pending String) (:f known (List (Pair Int64 String))) (:f sweptNs Int64) (:f deadlineNs Int64))" :pit (record))
(:sym "push" :mod "asl-utils/binaryHeap" :sig "push cmp: (fn [Int64 Int64] -> Int64) h: (List Int64) x: Int64 -> (List Int64)")
(:sym "pop" :mod "asl-utils/binaryHeap" :sig "pop cmp: (fn [Int64 Int64] -> Int64) h: (List Int64) -> (Pair (Option Int64) (List Int64))")
(:sym "peek" :mod "asl-utils/binaryHeap" :sig "peek h: (List Int64) -> (Option Int64)" :pit (option))
(:sym "fromList" :mod "asl-utils/binaryHeap" :sig "fromList cmp: (fn [Int64 Int64] -> Int64) xs: (List Int64) -> (List Int64)")
(:sym "toSortedList" :mod "asl-utils/binaryHeap" :sig "toSortedList cmp: (fn [Int64 Int64] -> Int64) h: (List Int64) -> (List Int64)")
(:sym "adler32" :mod "asl-utils/checksums" :sig "adler32 bs: Bytes -> Int64")
(:sym "fnv1a32" :mod "asl-utils/checksums" :sig "fnv1a32 bs: Bytes -> Int64")
(:sym "fnv1a64" :mod "asl-utils/checksums" :sig "fnv1a64 bs: Bytes -> Int64")
(:sym "crc32" :mod "asl-utils/checksums" :sig "crc32 bs: Bytes -> Int64")
(:sym "Deque" :mod "asl-utils/deque" :kind type :sig "(schema Deque (:f front (List Int64)) (:f back (List Int64)))" :pit (record))
(:sym "empty" :mod "asl-utils/deque" :sig "empty -> Deque")
(:sym "pushFront" :mod "asl-utils/deque" :sig "pushFront d: Deque x: Int64 -> Deque")
(:sym "pushBack" :mod "asl-utils/deque" :sig "pushBack d: Deque x: Int64 -> Deque")
(:sym "popFront" :mod "asl-utils/deque" :sig "popFront d: Deque -> (Option (Pair Int64 Deque))" :pit (option))
(:sym "popBack" :mod "asl-utils/deque" :sig "popBack d: Deque -> (Option (Pair Int64 Deque))" :pit (option))
(:sym "toList" :mod "asl-utils/deque" :sig "toList d: Deque -> (List Int64)")
(:sym "parseDuration" :mod "asl-utils/duration" :sig "parseDuration s: String -> (Result Int64 String)" :pit (result))
(:sym "formatDuration" :mod "asl-utils/duration" :sig "formatDuration ms: Int64 -> String")
(:sym "hexEncode" :mod "asl-utils/hex" :sig "hexEncode bs: Bytes -> String")
(:sym "hexDecode" :mod "asl-utils/hex" :sig "hexDecode s: String -> (Result Bytes String)" :pit (result))
(:sym "hexDump" :mod "asl-utils/hex" :sig "hexDump bs: Bytes width: Int64 -> String")
(:sym "Kit" :mod "asl-utils/kit" :kind type :sig "(schema Kit (:f flags (List Flag)) (:f vals (Map String String)) (:f args (List String)) (:f help Bool) (:f dry Bool) (:f outside Bool) (:f root String))" :pit (record))
(:sym "Flag" :mod "asl-utils/kit" :kind type :sig "(schema Flag (:f name String) (:f kind String) (:f value String) (:f note String))" :pit (record))
(:sym "Out" :mod "asl-utils/kit" :kind type :sig "(schema Out (:f exit Int64) (:f out String) (:f err String))" :pit (record))
(:sym "Op" :mod "asl-utils/kit" :kind type :sig "(schema Op (:f tag String) (:f text String) (:f ai Int64) (:f bi Int64))" :pit (record))
(:sym "Diff" :mod "asl-utils/kit" :kind type :sig "(schema Diff (:f text String) (:f hunks Int64))" :pit (record))
(:sym "specOf" :mod "asl-utils/kit" :sig "specOf text: String -> (List Flag)")
(:sym "parse" :mod "asl-utils/kit" :sig "parse argv: (List String) spec: String -> (Result Kit String)" :pit (result))
(:sym "help" :mod "asl-utils/kit" :sig "help k: Kit -> String")
(:sym "run!" :mod "asl-utils/kit" :kind fn! :sig "run! argv: (List String) spec: String body: (fn [Kit] -> (Result Unit String)) -> (Result Unit String)" :pit (result effect))
(:sym "flag" :mod "asl-utils/kit" :sig "flag k: Kit name: String -> String")
(:sym "flagInt" :mod "asl-utils/kit" :sig "flagInt k: Kit name: String -> Int64")
(:sym "flagOn?" :mod "asl-utils/kit" :sig "flagOn? k: Kit name: String -> Bool")
(:sym "arg" :mod "asl-utils/kit" :sig "arg k: Kit i: Int64 fallback: String -> String")
(:sym "argNum" :mod "asl-utils/kit" :sig "argNum k: Kit i: Int64 fallback: Int64 -> Int64")
(:sym "env" :mod "asl-utils/kit" :kind fn! :sig "env name: String fallback: String -> String" :pit (effect))
(:sym "glob!" :mod "asl-utils/kit" :kind fn! :sig "glob! pat: String -> (List String)" :pit (effect))
(:sym "globGit!" :mod "asl-utils/kit" :kind fn! :sig "globGit! pat: String -> (List String)" :pit (effect))
(:sym "globRegex" :mod "asl-utils/kit" :sig "globRegex pat: String -> String")
(:sym "readText!" :mod "asl-utils/kit" :kind fn! :sig "readText! p: String -> (Result String String)" :pit (result effect))
(:sym "readLines!" :mod "asl-utils/kit" :kind fn! :sig "readLines! p: String -> (Result (List String) String)" :pit (result effect))
(:sym "writeText!" :mod "asl-utils/kit" :kind fn! :sig "writeText! p: String text: String -> (Result Unit String)" :pit (result effect))
(:sym "inside?" :mod "asl-utils/kit" :kind fn! :sig "inside? k: Kit p: String -> Bool" :pit (effect))
(:sym "edit!" :mod "asl-utils/kit" :kind fn! :sig "edit! k: Kit p: String f: (fn [String] -> String) -> (Result Unit String)" :pit (effect))
(:sym "editAll!" :mod "asl-utils/kit" :kind fn! :sig "editAll! k: Kit paths: (List String) f: (fn [String] -> String) -> (Result Unit String)" :pit (effect))
(:sym "editRx!" :mod "asl-utils/kit" :kind fn! :sig "editRx! k: Kit paths: (List String) pat: String template: String -> (Result Unit String)" :pit (result effect))
(:sym "replaceAll" :mod "asl-utils/kit" :sig "replaceAll s: String from: String to: String -> String")
(:sym "sub" :mod "asl-utils/kit" :sig "sub pat: String s: String template: String -> (Result String String)" :pit (result))
(:sym "found?" :mod "asl-utils/kit" :sig "found? pat: String s: String -> (Result Bool String)" :pit (result))
(:sym "diff" :mod "asl-utils/kit" :sig "diff path: String old: String new: String -> Diff")
(:sym "sh!" :mod "asl-utils/kit" :kind fn! :sig "sh! argv: (List String) -> Out" :pit (effect))
(:sym "shFor!" :mod "asl-utils/kit" :kind fn! :sig "shFor! secs: Int64 argv: (List String) -> Out" :pit (effect))
(:sym "quote" :mod "asl-utils/kit" :sig "quote s: String -> String")
(:sym "binarySearch" :mod "asl-utils/lists" :sig "binarySearch xs: (List Int64) x: Int64 -> (Option Int64)" :pit (option))
(:sym "lowerBound" :mod "asl-utils/lists" :sig "lowerBound xs: (List Int64) x: Int64 -> Int64")
(:sym "windows" :mod "asl-utils/lists" :sig "windows xs: (List T) n: Int64 -> (List (List T))")
(:sym "groupAdjacent" :mod "asl-utils/lists" :sig "groupAdjacent xs: (List T) key: (fn [T] -> K) -> (List (List T))")
(:sym "dedupSorted" :mod "asl-utils/lists" :sig "dedupSorted xs: (List T) -> (List T)")
(:sym "mean" :mod "asl-utils/stats" :sig "mean xs: (List Float64) -> (Result Float64 String)" :pit (result))
(:sym "median" :mod "asl-utils/stats" :sig "median xs: (List Float64) -> (Result Float64 String)" :pit (result))
(:sym "variance" :mod "asl-utils/stats" :sig "variance xs: (List Float64) -> (Result Float64 String)" :pit (result))
(:sym "stddev" :mod "asl-utils/stats" :sig "stddev xs: (List Float64) -> (Result Float64 String)" :pit (result))
(:sym "percentile" :mod "asl-utils/stats" :sig "percentile xs: (List Float64) p: Float64 -> (Result Float64 String)" :pit (result))
(:sym "histogram" :mod "asl-utils/stats" :sig "histogram xs: (List Float64) bins: Int64 -> (Result (List Int64) String)" :pit (result))
(:sym "Dsu" :mod "asl-utils/unionFind" :kind type :sig "(schema Dsu (:f parent (Map Int64 Int64)) (:f rank (Map Int64 Int64)) (:f count Int64))" :pit (record))
(:sym "empty" :mod "asl-utils/unionFind" :sig "empty -> Dsu")
(:sym "add" :mod "asl-utils/unionFind" :sig "add d: Dsu n: Int64 -> Dsu")
(:sym "find" :mod "asl-utils/unionFind" :sig "find d: Dsu n: Int64 -> (Pair Dsu Int64)")
(:sym "union" :mod "asl-utils/unionFind" :sig "union d0: Dsu a: Int64 b: Int64 -> Dsu")
(:sym "connected" :mod "asl-utils/unionFind" :sig "connected d: Dsu a: Int64 b: Int64 -> Bool")
(:sym "componentCount" :mod "asl-utils/unionFind" :sig "componentCount d: Dsu -> Int64")
