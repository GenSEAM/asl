(:card "asl-utils" :purpose "Optional coreutils-style commands missing on macOS or Linux, in pure AgentSlang: timeout; and the script kit: flags, args, env, glob, atomic edits with --dry diffs, guarded children" :import "(asl-utils/timeout :a x)" :deps (asl-regex) :modules ((:m "asl-utils/timeout" :doc "asl timeout SECS -- argv...: GNU timeout convention (exi...") (:m "asl-utils/kit" :doc "Script kit: (kit/run! args \"n=1000 out=x\" (fn [k] ...)) ...")) :sigs ("parseTimeout text: String -> (Option Int64)" "timeoutMsOf text: String -> Int64" "exitOfStatus status: Int64 -> Int64" "timeoutRun! ms: Int64 argv: (List String) -> Int64" "drainFd! fd: Int64 isOpen: Bool dest: Int64 -> Bool" "readRest! fd: Int64 isOpen: Bool acc: String -> String" "cmdOf args: (List String) -> (List String)" "brokenPipe? e: String -> Bool" "closure procs: (List fr/Proc) members: (List Int64) self: Int64 rounds: Int64 -> (List Int64)" "startOf starts: (List (Pair Int64 String)) pid: Int64 -> String") :more (Run Kit Flag Out Op Diff specOf parse help run! flag flagInt flagOn? arg argNum env glob! globGit! globRegex readText! readLines! writeText! inside? edit!) :moreCount 9 :effects (timeoutRun! drainFd! readRest! run! env glob! globGit! readText!) :fails (parse run! readText! readLines! writeText! editRx! sub found?) :example none)
(:sym "parseTimeout" :mod "asl-utils/timeout" :sig "parseTimeout text: String -> (Option Int64)" :doc "SECS (integer or decimal, 0 = no limit) to milliseconds; none for malformed, negative, nan or overflowing input." :pit (option))
(:sym "timeoutMsOf" :mod "asl-utils/timeout" :sig "timeoutMsOf text: String -> Int64" :doc "parseTimeout with malformed input mapped to -1 (usage error, exit 125).")
(:sym "exitOfStatus" :mod "asl-utils/timeout" :sig "exitOfStatus status: Int64 -> Int64" :doc "Wait status to shell exit code: the child's code, or 128 plus the signal number when it was signalled.")
(:sym "timeoutRun!" :mod "asl-utils/timeout" :kind fn! :sig "timeoutRun! ms: Int64 argv: (List String) -> Int64" :doc "Limits until PROCSHIM-DETACH gives a real process group: a descendant that called setsid or double-forked away from the tree is out of reach and survives expiry; the tree is tracked by parentage and re-swept every 0.5 s, each pid pinned to ..." :pit (effect))
(:sym "drainFd!" :mod "asl-utils/timeout" :kind fn! :sig "drainFd! fd: Int64 isOpen: Bool dest: Int64 -> Bool" :doc "Forward the rest of fd to dest after the child exited; false when dest is closed." :pit (effect))
(:sym "readRest!" :mod "asl-utils/timeout" :kind fn! :sig "readRest! fd: Int64 isOpen: Bool acc: String -> String" :doc "Read fd to EOF or EAGAIN, appending to acc." :pit (effect))
(:sym "cmdOf" :mod "asl-utils/timeout" :sig "cmdOf args: (List String) -> (List String)" :doc "The command after SECS, with one leading -- removed.")
(:sym "brokenPipe?" :mod "asl-utils/timeout" :sig "brokenPipe? e: String -> Bool" :doc "True when a write error means the reader of our stdout or stderr is gone (EPIPE), which ends the run with exit 141.")
(:sym "closure" :mod "asl-utils/timeout" :sig "closure procs: (List fr/Proc) members: (List Int64) self: Int64 rounds: Int64 -> (List Int64)" :doc "Descendants of members by parentage plus same-group orphans, iterated up to rounds times, excluding the shim itself.")
(:sym "startOf" :mod "asl-utils/timeout" :sig "startOf starts: (List (Pair Int64 String)) pid: Int64 -> String" :doc "Pinned start time of pid from a snapshot, empty when unknown; a pid whose start time changed is never signalled.")
(:sym "Run" :mod "asl-utils/timeout" :kind type :sig "(schema Run (:f pid Int64) (:f outFd Int64) (:f errFd Int64) (:f inFd Int64) (:f outOpen Bool) (:f errOpen Bool) (:f inOpen Bool) (:f srcOpen Bool) (:f pending String) (:f known (List (Pair Int64 String))) (:f sweptNs Int64) (:f deadlineNs Int64))" :doc "State of one timed run: the spawned child, its fds, the deadline and the descendant pids pinned to their start times." :pit (record))
(:sym "Kit" :mod "asl-utils/kit" :kind type :sig "(schema Kit (:f flags (List Flag)) (:f vals (Map String String)) (:f args (List String)) (:f help Bool) (:f dry Bool) (:f outside Bool) (:f root String))" :doc "Parsed command line: declared flags, their values by name, positionals, help, dry and allow-outside switches, and the real path of the working directory." :pit (record))
(:sym "Flag" :mod "asl-utils/kit" :kind type :sig "(schema Flag (:f name String) (:f kind String) (:f value String) (:f note String))" :doc "One declared flag: name, kind (int, bool or str, from its default), default value and help note." :pit (record))
(:sym "Out" :mod "asl-utils/kit" :kind type :sig "(schema Out (:f exit Int64) (:f out String) (:f err String))" :doc "Result of a child run: exit code, stdout and stderr." :pit (record))
(:sym "Op" :mod "asl-utils/kit" :kind type :sig "(schema Op (:f tag String) (:f text String) (:f ai Int64) (:f bi Int64))" :doc "One diff line: eq, del or ins, its text with its newline, and its old and new line numbers." :pit (record))
(:sym "Diff" :mod "asl-utils/kit" :kind type :sig "(schema Diff (:f text String) (:f hunks Int64))" :doc "Unified diff text and its hunk count." :pit (record))
(:sym "specOf" :mod "asl-utils/kit" :sig "specOf text: String -> (List Flag)" :doc "Flag spec \"n=1000 dry out=x\" to flags: the default's text sets the kind (true/false bool, integer int, else str), a bare name is a bool off by default; --dry and --allow-outside are added when not declared.")
(:sym "parse" :mod "asl-utils/kit" :sig "parse argv: (List String) spec: String -> (Result Kit String)" :doc "Command line to a Kit: --name value, --name=value, a bare --name for a bool, -h or --help, -- ends flags, a negative number is a positional; an unknown flag is an error that lists the known ones." :pit (result))
(:sym "help" :mod "asl-utils/kit" :sig "help k: Kit -> String" :doc "Generated help: one line per flag with its kind, default and note.")
(:sym "run!" :mod "asl-utils/kit" :kind fn! :sig "run! argv: (List String) spec: String body: (fn [Kit] -> (Result Unit String)) -> (Result Unit String)" :doc "Parse argv against spec; on -h print help and return ok, on a parse error return it (a script statement then exits 1 naming it), else run body with the Kit rooted at the working directory." :pit (result effect))
(:sym "flag" :mod "asl-utils/kit" :sig "flag k: Kit name: String -> String" :doc "Value of a declared flag as text; an undeclared name traps with ERR_ARG and the known flags.")
(:sym "flagInt" :mod "asl-utils/kit" :sig "flagInt k: Kit name: String -> Int64" :doc "Value of a declared int flag; traps with ERR_ARG when the value is not an integer.")
(:sym "flagOn?" :mod "asl-utils/kit" :sig "flagOn? k: Kit name: String -> Bool" :doc "True when a bool flag is on.")
(:sym "arg" :mod "asl-utils/kit" :sig "arg k: Kit i: Int64 fallback: String -> String" :doc "Positional i after flags are removed, or fallback.")
(:sym "argNum" :mod "asl-utils/kit" :sig "argNum k: Kit i: Int64 fallback: Int64 -> Int64" :doc "Positional i as an integer, or fallback when absent or not an integer.")
(:sym "env" :mod "asl-utils/kit" :kind fn! :sig "env name: String fallback: String -> String" :doc "Environment variable or fallback; read-only, and the kit never prints it." :pit (effect))
(:sym "glob!" :mod "asl-utils/kit" :kind fn! :sig "glob! pat: String -> (List String)" :doc "Files matching a pattern relative to the working directory, sorted: * and ? stay inside one path segment, ** crosses directories; .git is skipped, symlinked directories are not followed, an unreadable directory prints a skipped receipt on s..." :pit (effect))
(:sym "globGit!" :mod "asl-utils/kit" :kind fn! :sig "globGit! pat: String -> (List String)" :doc "glob! over git ls-files --cached --others --exclude-standard, so .gitignore rules apply exactly; traps with ERR_IO when git fails." :pit (effect))
(:sym "globRegex" :mod "asl-utils/kit" :sig "globRegex pat: String -> String" :doc "Anchored regex source for a glob pattern.")
(:sym "readText!" :mod "asl-utils/kit" :kind fn! :sig "readText! p: String -> (Result String String)" :doc "Whole file as text." :pit (result effect))
(:sym "readLines!" :mod "asl-utils/kit" :kind fn! :sig "readLines! p: String -> (Result (List String) String)" :doc "File lines without their newlines; a final newline adds no empty line." :pit (result effect))
(:sym "writeText!" :mod "asl-utils/kit" :kind fn! :sig "writeText! p: String text: String -> (Result Unit String)" :doc "Atomic write: a temporary file in the same directory, the old file's mode, fsync, then rename over the target; the temporary file is removed on any failure." :pit (result effect))
(:sym "inside?" :mod "asl-utils/kit" :kind fn! :sig "inside? k: Kit p: String -> Bool" :doc "True when the path (or its parent when it does not exist) resolves inside the kit's working directory." :pit (effect))
(:sym "edit!" :mod "asl-utils/kit" :kind fn! :sig "edit! k: Kit p: String f: (fn [String] -> String) -> (Result Unit String)" :doc "Read, apply f, and write atomically; unchanged text prints (:skipped path :why \"unchanged\"), --dry prints the diff and (:wouldEdit path :hunks n), a write prints (:edited path :hunks n); a path outside the working directory is an error unle..." :pit (effect))
(:sym "editAll!" :mod "asl-utils/kit" :kind fn! :sig "editAll! k: Kit paths: (List String) f: (fn [String] -> String) -> (Result Unit String)" :doc "edit! over paths in order, stopping at the first error." :pit (effect))
(:sym "editRx!" :mod "asl-utils/kit" :kind fn! :sig "editRx! k: Kit paths: (List String) pat: String template: String -> (Result Unit String)" :doc "editAll! with a regex replacement; template groups are \\1 to \\9 and \\0 for the whole match; a bad regex is an error before any file is read." :pit (result effect))
(:sym "replaceAll" :mod "asl-utils/kit" :sig "replaceAll s: String from: String to: String -> String" :doc "Replace every occurrence of a literal string.")
(:sym "sub" :mod "asl-utils/kit" :sig "sub pat: String s: String template: String -> (Result String String)" :doc "Regex replace-all over a string; a bad regex is an error." :pit (result))
(:sym "found?" :mod "asl-utils/kit" :sig "found? pat: String s: String -> (Result Bool String)" :doc "True when the regex matches somewhere in the string; a bad regex is an error." :pit (result))
(:sym "diff" :mod "asl-utils/kit" :sig "diff path: String old: String new: String -> Diff" :doc "Line diff of two texts as a unified diff with 3 lines of context: common prefix and suffix are trimmed, an equal-length middle is paired line by line, otherwise it is one replaced block; a missing final newline is marked.")
(:sym "sh!" :mod "asl-utils/kit" :kind fn! :sig "sh! argv: (List String) -> Out" :doc "Run argv (no shell) through fleet/run runGuarded in the working directory with a 120 s timeout and at most 64 descendants." :pit (effect))
(:sym "shFor!" :mod "asl-utils/kit" :kind fn! :sig "shFor! secs: Int64 argv: (List String) -> Out" :doc "sh! with a timeout in seconds." :pit (effect))
(:sym "quote" :mod "asl-utils/kit" :sig "quote s: String -> String" :doc "ASN string literal of a text, as receipts print paths.")
