(:card "asl-http" :purpose "Pure AgentSlang Streaming HTTP/1.1 and HTTP/2 Protocol Engine" :import "(asl-http/http11 :a x)" :modules ((:m "asl-http/http11" :doc "Pure AgentSlang Streaming HTTP/1.1 Protocol Engine and W...") (:m "asl-http/download" :doc "HTTP downloads through the curl capability fallback unti...") (:m "asl-http/http2" :doc "Pure AgentSlang RFC 7540 HTTP/2 Binary Framing Codec and...") (:m "asl-http/wsProtocol" :doc "Pure AgentSlang RFC 6455 WebSocket Protocol Frame Codec,...")) :sigs ("(schema HttpHeaders (:f entries (List (pair String String))))" "(schema HttpRequest (:f method String) (:f path String) (:f version String) (:f headers HttpHeaders) (:f body String) (:f query String))" "(schema HttpResponse (:f statusCode Int64) (:f reasonPhrase String) (:f headers HttpHeaders) (:f body String))" "makeHeaders pairs: (List (Pair String String)) -> HttpHeaders" "getHeader target: HttpRequest name: String -> (Option String)" "getHeaderFromHeaders headers: HttpHeaders name: String -> (Option String)") :more (makeRequest makeResponse parseHttpRequest getQueryParam formatHttpResponse HttpDownload curlTimeout httpDownload httpHead Http2Frame HpackTable HpackEntry) :moreCount 60 :effects (httpDownload httpHead) :fails (parseHttpRequest httpDownload httpHead decodeHttp2Frame decodeBinaryFrame decodeHpack) :example "(module asl-know/examples/aslHttp :x [pathOf selfTest] :i [(asl-http/http11 :a http)])\n\nfn pathOf raw: String -> String\n  (mt (http/parseHttpRequest raw)\n    ((err e) (str \"error: \" e))\n    ((ok req) (str req.method \" \" req.path)))")
(:sym "HttpHeaders" :mod "asl-http/http11" :kind type :sig "(schema HttpHeaders (:f entries (List (pair String String))))" :pit (record))
(:sym "HttpRequest" :mod "asl-http/http11" :kind type :sig "(schema HttpRequest (:f method String) (:f path String) (:f version String) (:f headers HttpHeaders) (:f body String) (:f query String))" :pit (record))
(:sym "HttpResponse" :mod "asl-http/http11" :kind type :sig "(schema HttpResponse (:f statusCode Int64) (:f reasonPhrase String) (:f headers HttpHeaders) (:f body String))" :pit (record))
(:sym "makeHeaders" :mod "asl-http/http11" :sig "makeHeaders pairs: (List (Pair String String)) -> HttpHeaders")
(:sym "getHeader" :mod "asl-http/http11" :sig "getHeader target: HttpRequest name: String -> (Option String)" :pit (option))
(:sym "getHeaderFromHeaders" :mod "asl-http/http11" :sig "getHeaderFromHeaders headers: HttpHeaders name: String -> (Option String)" :pit (option))
(:sym "makeRequest" :mod "asl-http/http11" :sig "makeRequest method: String path: String headers: HttpHeaders body: String version: String -> HttpRequest")
(:sym "makeResponse" :mod "asl-http/http11" :sig "makeResponse statusCode: Int64 reasonPhrase: String headers: HttpHeaders body: String -> HttpResponse")
(:sym "parseHttpRequest" :mod "asl-http/http11" :sig "parseHttpRequest raw: String -> (Result HttpRequest String)" :pit (result))
(:sym "getQueryParam" :mod "asl-http/http11" :sig "getQueryParam req: HttpRequest key: String -> (Option String)" :pit (option))
(:sym "formatHttpResponse" :mod "asl-http/http11" :sig "formatHttpResponse res: HttpResponse -> String")
(:sym "HttpDownload" :mod "asl-http/download" :kind type :sig "(schema HttpDownload (:f status Int64) (:f bytes Int64) (:f contentLength Int64) (:f sha256 String))" :pit (record))
(:sym "curlTimeout" :mod "asl-http/download" :sig "curlTimeout timeoutMs: Int64 -> String")
(:sym "httpDownload" :mod "asl-http/download" :kind fn! :sig "httpDownload url: String path: String timeoutMs: Int64 -> (Result HttpDownload String)" :pit (result effect))
(:sym "httpHead" :mod "asl-http/download" :kind fn! :sig "httpHead url: String timeoutMs: Int64 -> (Result (Pair Int64 Int64) String)" :pit (result effect))
(:sym "Http2Frame" :mod "asl-http/http2" :kind type :sig "(schema Http2Frame (:f frameType Int64) (:f flags Int64) (:f streamId Int64) (:f length Int64) (:f payload String))" :pit (record))
(:sym "HpackTable" :mod "asl-http/http2" :kind type :sig "(schema HpackTable (:f maxSize Int64) (:f currentSize Int64) (:f entries (List HpackEntry)))" :pit (record))
(:sym "HpackEntry" :mod "asl-http/http2" :kind type :sig "(schema HpackEntry (:f name String) (:f value String) (:f size Int64))" :pit (record))
(:sym "Http2Stream" :mod "asl-http/http2" :kind type :sig "(schema Http2Stream (:f streamId Int64) (:f state String) (:f windowSize Int64))" :pit (record))
(:sym "makeHttp2Frame" :mod "asl-http/http2" :sig "makeHttp2Frame frameType: Int64 flags: Int64 streamId: Int64 payload: String -> Http2Frame")
(:sym "encodeHttp2Frame" :mod "asl-http/http2" :sig "encodeHttp2Frame frame: Http2Frame -> String")
(:sym "decodeHttp2Frame" :mod "asl-http/http2" :sig "decodeHttp2Frame raw: String -> (Result Http2Frame String)" :pit (result))
(:sym "encodeBinaryFrame" :mod "asl-http/http2" :sig "encodeBinaryFrame frame: Http2Frame -> String")
(:sym "decodeBinaryFrame" :mod "asl-http/http2" :sig "decodeBinaryFrame raw: String -> (Result Http2Frame String)" :pit (result))
(:sym "makeDataFrame" :mod "asl-http/http2" :sig "makeDataFrame streamId: Int64 payload: String endStream: Bool -> Http2Frame")
(:sym "makeHeadersFrame" :mod "asl-http/http2" :sig "makeHeadersFrame streamId: Int64 payload: String endHeaders: Bool endStream: Bool -> Http2Frame")
(:sym "makeSettingsFrame" :mod "asl-http/http2" :sig "makeSettingsFrame streamId: Int64 isAck: Bool payload: String -> Http2Frame")
(:sym "makePingFrame" :mod "asl-http/http2" :sig "makePingFrame payload: String isAck: Bool -> Http2Frame")
(:sym "makeRstStreamFrame" :mod "asl-http/http2" :sig "makeRstStreamFrame streamId: Int64 errorCode: Int64 -> Http2Frame")
(:sym "makeGoawayFrame" :mod "asl-http/http2" :sig "makeGoawayFrame lastStreamId: Int64 errorCode: Int64 debugMsg: String -> Http2Frame")
(:sym "makeWindowUpdateFrame" :mod "asl-http/http2" :sig "makeWindowUpdateFrame streamId: Int64 windowSizeIncrement: Int64 -> Http2Frame")
(:sym "makeHpackTable" :mod "asl-http/http2" :sig "makeHpackTable maxSize: Int64 -> HpackTable")
(:sym "hpackTableAdd" :mod "asl-http/http2" :sig "hpackTableAdd tbl: HpackTable name: String value: String -> HpackTable")
(:sym "hpackTableEvict" :mod "asl-http/http2" :sig "hpackTableEvict entries: (List HpackEntry) curSize: Int64 maxSize: Int64 -> (Pair (List HpackEntry) Int64)")
(:sym "encodeHpack" :mod "asl-http/http2" :sig "encodeHpack tbl: HpackTable headers: http/HttpHeaders -> (Pair HpackTable String)")
(:sym "decodeHpack" :mod "asl-http/http2" :sig "decodeHpack tbl: HpackTable wireBlock: String -> (Result (Pair HpackTable http/HttpHeaders) String)" :pit (result))
