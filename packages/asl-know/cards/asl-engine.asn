(:card "asl-engine" :purpose "Resident Runtime Engine & Context Isolation Supervisor: Lifecycle, FileLock Lease, Circuit Breaker, RSS Guard, Watchdogs, Idle Exit, Subprocess Transport, Unix-Socket Server and the asl engine CLI" :import "(asl-engine/engine :a x)" :deps (asl-json) :modules ((:m "asl-engine/engine" :doc "Pure ASL engine supervisor coordinator, lifecycle manage...") (:m "asl-engine/breaker" :doc "Pure ASL anti-flapping circuit breaker for supervisor re...") (:m "asl-engine/build" :doc "Engine build identity: the CLI entry the daemon runs, th...") (:m "asl-engine/cli" :doc "asl engine command line on asl-host, ported from the ret...") (:m "asl-engine/guard" :doc "Pure ASL RSS ceiling guard and memory threshold monitor")) :moduleCount 12 :sigs ("(schema EngineConfig (:f scope String) (:f rootDir String) (:f socketPath String) (:f pidFile String) (:f logFile String) (:f idleSec Int64)..." "(schema EngineRuntime (:f config EngineConfig) (:f supervisor sp/SupervisorState) (:f activity wd/EngineActivity) (:f lease lse/LeaseLock) (..." "resolveScope! rootDir: String scopeOpt: String -> EngineConfig" "checkSocketPath socketPath: String isDarwin: Bool -> (Result Unit String)" "makeEngineRuntime config: EngineConfig nowSec: Int64 -> EngineRuntime" "withBuild rt: EngineRuntime build: bld/EngineBuild -> EngineRuntime") :more (withSupervisor dispatchRequest! formatRssMb cmdStatus! cmdPing! cmdStart! cmdStop! cmdRestart! cmdRun! cmdEval! BreakerVerdict parseTimestamps formatTimestamps) :moreCount 101 :effects (resolveScope! dispatchRequest! cmdStatus! cmdPing! cmdStart! cmdStop! cmdRestart! cmdRun!) :fails (checkSocketPath cmdStart! cmdRestart! cmdRun! checkBreakerFile! acquireLease! releaseLease! serve!) :example none)
(:sym "EngineConfig" :mod "asl-engine/engine" :kind type :sig "(schema EngineConfig (:f scope String) (:f rootDir String) (:f socketPath String) (:f pidFile String) (:f logFile String) (:f idleSec Int64) (:f maxRssMb Int64) (:f softRssMb Int64))" :pit (record))
