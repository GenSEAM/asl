(:card "asl-know" :purpose "Tiered knowledge surface for models: L0 index, L1 cards per package and language area, L2 rows per symbol, generated from code, doc.asn and checked examples, queried by intent within a token budget" :import "(asl-know/know :a x)" :deps (asl-checker) :modules ((:m "asl-know/know") (:m "asl-know/examples/aslCrypto") (:m "asl-know/examples/aslCsv") (:m "asl-know/examples/aslHttp") (:m "asl-know/examples/aslJson")) :moduleCount 18 :sigs ("generatedIndex? path: String -> Bool" "genReceipt n: Int64 orphans: (List String) other: (List String) -> String" "genLineOf n: Int64 groups: (List r/Group) cards: (List r/Card) -> String" "genLine! root: String n: Int64 -> String" "dropStaleIndexes! dir: String files: (List (Pair String String)) -> (Result Int64 String)" "rendered! root: String -> (List (Pair String String))" "cardsDir root: String -> String" "staleFiles! root: String -> (List String)" "ratchetRows! root: String -> (List String)") :more (ratchetDiff writeCards! know! signHex cell pathOf intField emitPair rowCount! countNumbers! firstGroup! gunzipText! digest lineCount! Point Shape area describe) :moreCount 53 :effects (generatedIndex? genLine! dropStaleIndexes! rendered! staleFiles! ratchetRows! writeCards! know!) :fails (dropStaleIndexes! writeCards! parsePort) :example none)
