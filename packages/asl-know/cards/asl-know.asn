(:card "asl-know" :purpose "Tiered knowledge surface for models: L0 index, L1 cards per package and language area, L2 rows per symbol, generated from code, doc.asn and checked examples, queried by intent within a token budget" :import "(asl-know/know :a x)" :deps (asl-checker) :modules ((:m "asl-know/know" :doc "asl know: gen writes the cards, check reports drift, rat...") (:m "asl-know/examples/aslCrypto") (:m "asl-know/examples/aslCsv") (:m "asl-know/examples/aslHttp") (:m "asl-know/examples/aslJson")) :moduleCount 18 :sigs ("rendered! root: String -> (List (Pair String String))" "cardsDir root: String -> String" "staleFiles! root: String -> (List String)" "ratchetRows! root: String -> (List String)" "ratchetDiff listed: (List String) computed: (List String) -> (Pair (List String) (List String))" "writeCards! root: String -> (Result Int64 String)" "know! root: String query: String budget: Int64 -> String" "signHex key: String msg: String -> String" "cell text: String row: Int64 col: Int64 -> String" "pathOf raw: String -> String" "intField src: String key: String -> Int64" "emitPair k: String v: String -> String") :more (rowCount! countNumbers! firstGroup! gunzipText! digest lineCount! Point Shape area describe total summary wordCounts parsePort shout Entry Row termsOf) :moreCount 32 :effects (rendered! staleFiles! ratchetRows! writeCards! know! rowCount! countNumbers! firstGroup!) :fails (writeCards! parsePort) :example none)
(:sym "rendered!" :mod "asl-know/know" :kind fn! :sig "rendered! root: String -> (List (Pair String String))" :doc "Every card file name with the bytes the source renders to" :pit (effect))
(:sym "cardsDir" :mod "asl-know/know" :sig "cardsDir root: String -> String" :doc "ROOT/asl/packages/asl-know/cards")
(:sym "staleFiles!" :mod "asl-know/know" :kind fn! :sig "staleFiles! root: String -> (List String)" :doc "Card files that are absent, differ from their render, or are not rendered at all" :pit (effect))
(:sym "ratchetRows!" :mod "asl-know/know" :kind fn! :sig "ratchetRows! root: String -> (List String)" :doc "Rows listed in missing.asn" :pit (effect))
(:sym "ratchetDiff" :mod "asl-know/know" :sig "ratchetDiff listed: (List String) computed: (List String) -> (Pair (List String) (List String))" :doc "Pair of computed rows not listed and listed rows no longer computed")
(:sym "writeCards!" :mod "asl-know/know" :kind fn! :sig "writeCards! root: String -> (Result Int64 String)" :doc "Write every rendered card file; the count written or the first failure" :pit (result effect))
(:sym "know!" :mod "asl-know/know" :kind fn! :sig "know! root: String query: String budget: Int64 -> String" :doc "Answer a query against the cards written under ROOT" :pit (effect))
(:sym "signHex" :mod "asl-know/examples/aslCrypto" :sig "signHex key: String msg: String -> String" :doc "HMAC-SHA256 hex of a message under a key")
(:sym "cell" :mod "asl-know/examples/aslCsv" :sig "cell text: String row: Int64 col: Int64 -> String" :doc "One CSV cell by row and column, empty when absent")
(:sym "pathOf" :mod "asl-know/examples/aslHttp" :sig "pathOf raw: String -> String" :doc "Method and path of a raw HTTP/1.1 request")
(:sym "intField" :mod "asl-know/examples/aslJson" :sig "intField src: String key: String -> Int64" :doc "An integer field of a JSON object; -1 parse error, -2 absent, -3 not an integer")
(:sym "emitPair" :mod "asl-know/examples/aslJson" :sig "emitPair k: String v: String -> String" :doc "A one-pair JSON object as text")
(:sym "rowCount!" :mod "asl-know/examples/aslParquet" :kind fn! :sig "rowCount! path: String -> Int64" :doc "Row count of a Parquet file, -1 when it does not open" :pit (effect))
(:sym "countNumbers!" :mod "asl-know/examples/aslRegex" :kind fn! :sig "countNumbers! s: String -> Int64" :doc "How many digit runs a string holds" :pit (effect))
(:sym "firstGroup!" :mod "asl-know/examples/aslRegex" :kind fn! :sig "firstGroup! s: String -> String" :doc "The digits after id= in a string, or empty" :pit (effect))
(:sym "gunzipText!" :mod "asl-know/examples/aslZip" :kind fn! :sig "gunzipText! data: Bytes -> String" :doc "Text of gzip bytes, or the error message" :pit (effect))
(:sym "digest" :mod "asl-know/examples/coreBytes" :sig "digest s: String -> String" :doc "Byte length, base64 and SHA-256 of a string")
(:sym "lineCount!" :mod "asl-know/examples/coreIo" :kind fn! :sig "lineCount! path: String -> Int64" :doc "Non-empty lines of a file, -1 when unreadable" :pit (effect))
(:sym "Point" :mod "asl-know/examples/coreLang" :kind type :sig "(schema Point (:f x Int64) (:f y Int64))" :doc "A record with x and y" :pit (record))
(:sym "Shape" :mod "asl-know/examples/coreLang" :kind type :sig "enum Shape (circle r: Int64) (rect w: Int64 h: Int64)" :doc "A circle or a rectangle")
(:sym "area" :mod "asl-know/examples/coreLang" :sig "area s: Shape -> Int64" :doc "Area of a shape, pi taken as 3")
(:sym "describe" :mod "asl-know/examples/coreLang" :sig "describe n: Int64 -> String" :doc "Sign of a number in words")
(:sym "total" :mod "asl-know/examples/coreLang" :sig "total xs: (List Int64) -> Int64" :doc "Sum of the even numbers plus the first one")
(:sym "summary" :mod "asl-know/examples/coreList" :sig "summary xs: (List Int64) -> String" :doc "Length, doubled top two, sum above 2 and last element")
(:sym "wordCounts" :mod "asl-know/examples/coreMap" :sig "wordCounts text: String -> (Map String Int64)" :doc "Count of each blank-separated word")
(:sym "parsePort" :mod "asl-know/examples/coreOption" :sig "parsePort s: String -> (Result Int64 String)" :doc "A port number in 1..65535 or the reason it is not one" :pit (result))
(:sym "shout" :mod "asl-know/examples/coreString" :sig "shout s: String -> String" :doc "Words reversed, joined by dashes and upper-cased")
(:sym "Entry" :mod "asl-know/query" :kind type :sig "(schema Entry (:f id String) (:f line String) (:f terms (List String)) (:f rows (List Row)))" :doc "A loaded card with its line, card terms and rows" :pit (record))
(:sym "Row" :mod "asl-know/query" :kind type :sig "(schema Row (:f card String) (:f name String) (:f line String) (:f nameTerms (List String)) (:f textTerms (List String)))" :doc "A loaded L2 row with its card, name, line and name and text terms" :pit (record))
(:sym "termsOf" :mod "asl-know/query" :sig "termsOf s: String -> (List String)" :doc "Lower-case search terms of a text: camelCase and punctuation split, stop words dropped, plural s stripped, a few synonyms added (directory dir, shell process, decompress gunzip)")
(:sym "loadEntries!" :mod "asl-know/query" :kind fn! :sig "loadEntries! dir: String -> (List Entry)" :doc "Every card file of a cards directory except index.asn, loaded as entries" :pit (effect))
(:sym "answer" :mod "asl-know/query" :sig "answer es: (List Entry) query: String budget: Int64 -> String" :doc "Answer for a query: an exact card id or symbol, else up to two ranked cards and twelve ranked rows within budget")
(:sym "Card" :mod "asl-know/render" :kind type :sig "(schema Card (:f id String) (:f purpose String) (:f keys (List String)) (:f line String) (:f rows (List String)) (:f missing (List String)))" :doc "One rendered card: id, purpose, index keys, the card line, its L2 rows and its missing-contract rows" :pit (record))
(:sym "q" :mod "asl-know/render" :sig "q s: String -> String" :doc "ASN string literal with backslash, quote, newline and tab escaped")
(:sym "unquoteRow" :mod "asl-know/render" :sig "unquoteRow l: String -> (Option String)" :doc "The string of a line holding one ASN string literal, or none" :pit (option))
(:sym "tokensOf" :mod "asl-know/render" :sig "tokensOf s: String -> Int64" :doc "Token estimate as bytes/3.6 rounded up, calibrated on o200k counts of the L0 index 2026-10-15; knowCardsTest checks the index against o200k counts")
(:sym "camelId" :mod "asl-know/render" :sig "camelId id: String -> String" :doc "Example file stem for a card id: asl-json becomes aslJson, core/list becomes coreList")
(:sym "cardFile" :mod "asl-know/render" :sig "cardFile id: String -> String" :doc "Card file name for a card id: slash becomes dash, plus .asn")
(:sym "exampleText" :mod "asl-know/render" :sig "exampleText src: String -> String" :doc "An example module text up to its selfTest fn, trimmed")
(:sym "pitTags" :mod "asl-know/render" :sig "pitTags d: sc/Decl -> (List String)" :doc "Pitfall tags of a declaration: result, option, effect, ctor, record; explained by the language card")
(:sym "packageCard" :mod "asl-know/render" :sig "packageCard p: sc/Package ex: String -> Card" :doc "L1 card and L2 rows of a package, entry module first; signatures fill about 600 bytes, further names about 160, five modules listed")
(:sym "areaCards" :mod "asl-know/render" :sig "areaCards bs: (List sc/Builtin) exOf: (fn [String] -> String) -> (List Card)" :doc "One L1 card per prelude.asn section with an L2 row per builtin")
(:sym "langCard" :mod "asl-know/render" :sig "langCard spec: String ex: String -> Card" :doc "The core/lang card from lang.asn rules and pitfall tags plus the coreLang example")
(:sym "indexText" :mod "asl-know/render" :sig "indexText cards: (List Card) -> String" :doc "L0 index: one line per card with id, purpose and two key names")
(:sym "missingOf" :mod "asl-know/render" :sig "missingOf cards: (List Card) -> (List String)" :doc "Sorted missing rows of all cards: card#module/name nodecl or nodoc")
(:sym "allCards!" :mod "asl-know/render" :kind fn! :sig "allCards! root: String -> (List Card)" :doc "Every card: language card, prelude areas, then packages in directory order" :pit (effect))
(:sym "Decl" :mod "asl-know/scan" :kind type :sig "(schema Decl (:f name String) (:f kind String) (:f sig String) (:f owner String))" :doc "One column-0 declaration: name, kind fn, fn!, type or ctor, its header text, and the enum owning a ctor" :pit (record))
(:sym "Module" :mod "asl-know/scan" :kind type :sig "(schema Module (:f path String) (:f name String) (:f exports (List String)) (:f decls (Map String Decl)))" :doc "A source module: path, declared name, export list and declarations by name" :pit (record))
(:sym "Package" :mod "asl-know/scan" :kind type :sig "(schema Package (:f name String) (:f description String) (:f entry String) (:f deps (List String)) (:f modules (List Module)) (:f docs (Map String String)))" :doc "A package: manifest description and entry, dependencies, modules and doc.asn rows" :pit (record))
(:sym "Builtin" :mod "asl-know/scan" :kind type :sig "(schema Builtin (:f name String) (:f sec String) (:f type String) (:f doc String))" :doc "A prelude builtin: name, prelude.asn section, checker type and doc" :pit (record))
(:sym "quoteEnd" :mod "asl-know/scan" :sig "quoteEnd b: Bytes n: Int64 i: Int64 -> Int64" :doc "Byte index of the closing quote of an ASN string starting at i, skipping backslash escapes; -1 when unterminated")
(:sym "unescape" :mod "asl-know/scan" :sig "unescape s: String -> String" :doc "Undo ASN string escapes; newline and tab escapes become spaces")
(:sym "fieldAfter" :mod "asl-know/scan" :sig "fieldAfter line: String key: String -> (Option String)" :doc "The unescaped string value after key in a single-line ASN row, or none" :pit (option))
(:sym "compact" :mod "asl-know/scan" :sig "compact s: String -> String" :doc "Collapse newlines and runs of blanks into single spaces, trimmed")
(:sym "docRows!" :mod "asl-know/scan" :kind fn! :sig "docRows! path: String retired: (List String) -> (Map String String)" :doc "Map from doc.asn :symbol to :text for one ledger file; an unreadable file is an empty map" :pit (effect))
(:sym "moduleOf" :mod "asl-know/scan" :sig "moduleOf path: String text: String -> Module" :doc "Module facts from source text: header name and :x exports, fn, schema, enum and constructor declarations")
(:sym "packagesOf!" :mod "asl-know/scan" :kind fn! :sig "packagesOf! root: String -> (List Package)" :doc "Every directory under asl/packages with a manifest.asn, scanned into Package facts" :pit (effect))
(:sym "builtinsOf!" :mod "asl-know/scan" :kind fn! :sig "builtinsOf! root: String -> (List Builtin)" :doc "builtinsFrom applied to ROOT/asl/prelude/prelude.asn" :pit (effect))
(:sym "builtinsFrom" :mod "asl-know/scan" :sig "builtinsFrom text: String -> (List Builtin)" :doc "Prelude builtins from prelude.asn text, typed by the checker builtinSig when it knows the name, absent names dropped")
(:sym "sourceFiles!" :mod "asl-know/scan" :kind fn! :sig "sourceFiles! dir: String -> (List String)" :doc "Every .asl file under a directory, recursively, in dirList order" :pit (effect))
(:sym "returnType" :mod "asl-know/scan" :sig "returnType sig: String -> String" :doc "The text after the first arrow of a signature, or empty")
(:sym "effectful?" :mod "asl-know/scan" :sig "effectful? d: Decl -> Bool" :doc "True for a fn declared fn ! or a name ending in !")
