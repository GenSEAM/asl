(:card "core/list" :purpose "List builtins, no import" :sigs ("list : T... -> (List T)" "cons : T (List T) -> (List T)" "listEmpty? : (List T) -> Bool" "listLength : (List T) -> Int64" "listGet : (List T) Int64 -> (Option T)" "listHead : (List T) -> (Option T)" "listTail : (List T) -> (Option (List T))" "listAppend : (List T) (List T) -> (List T)" "listReverse : (List T) -> (List T)" "listSlice : (List T) Int64 Int64 -> (Option (List T))" "listContains? : (List T) T -> Bool" "listIndexOf : (List T) T -> (Option Int64)" "listSort : (List T) -> (List T)" "listSortBy : (fn [T] -> K) (List T) -> (List T)" "map : (fn [A] -> B) (List A) -> (List B)") :more (filter fold arenaRun parMap parFold range listTake listDrop listLast listAny? listAll? listFind listCount listFlatMap enumerate zip listSum listMin listMax) :moreCount 1 :example "(module asl-know/examples/coreList :x [summary selfTest] :i [])\n\nfn summary xs: (List Int64) -> String\n  (let [(sorted (listSortBy (fn [(x Int64)] -> Int64 (- 0 x)) xs))\n        (doubled (map (fn [(x Int64)] -> Int64 (* 2 x)) (listTake sorted 2)))\n        (big (filter (fn [(x Int64)] -> Bool (> x 2)) xs))]\n    (str (listLength xs) \" \" (stringJoin (map stringFromInt64 doubled) \",\") \" \" (listSum big) \" \" (optionOr (listLast xs) 0)))")
(:sym "list" :sig "list : T... -> (List T)" :doc "Construct a list; [a b] is the same value." :pit (variadic))
(:sym "cons" :sig "cons : T (List T) -> (List T)" :doc "Prepend an element.")
(:sym "listEmpty?" :sig "listEmpty? : (List T) -> Bool" :doc "True when the list has no elements.")
(:sym "listLength" :sig "listLength : (List T) -> Int64" :doc "Element count.")
(:sym "listGet" :sig "listGet : (List T) Int64 -> (Option T)" :doc "Element at an index, or none." :pit (option))
(:sym "listHead" :sig "listHead : (List T) -> (Option T)" :doc "First element, or none." :pit (option))
(:sym "listTail" :sig "listTail : (List T) -> (Option (List T))" :doc "All but the first element, or none when empty." :pit (option))
(:sym "listAppend" :sig "listAppend : (List T) (List T) -> (List T)" :doc "Concatenate two lists.")
(:sym "listReverse" :sig "listReverse : (List T) -> (List T)" :doc "Reverse order.")
(:sym "listSlice" :sig "listSlice : (List T) Int64 Int64 -> (Option (List T))" :doc "Half-open slice, or none when out of range." :pit (option))
(:sym "listContains?" :sig "listContains? : (List T) T -> Bool" :doc "True when the element occurs.")
(:sym "listIndexOf" :sig "listIndexOf : (List T) T -> (Option Int64)" :doc "Index of the first occurrence, or none." :pit (option))
(:sym "listSort" :sig "listSort : (List T) -> (List T)" :doc "Stable ascending merge sort; a NaN sorts last.")
(:sym "listSortBy" :sig "listSortBy : (fn [T] -> K) (List T) -> (List T)" :doc "Stable ascending sort by a derived key; a NaN key sorts last.")
(:sym "map" :sig "map : (fn [A] -> B) (List A) -> (List B)" :doc "Apply a function to every element.")
(:sym "filter" :sig "filter : (fn [T] -> Bool) (List T) -> (List T)" :doc "Keep elements satisfying a predicate, which must return a Bool.")
(:sym "fold" :sig "fold : (fn [B A] -> B) B (List A) -> B" :doc "Left fold with an initial accumulator.")
(:sym "arenaRun" :sig "arenaRun : (fn [] -> T) -> T" :doc "Call a thunk in its own memory region: under the untraced RC runtime its allocations are freed together on return and the result is copied out.")
(:sym "parMap" :sig "parMap : (fn [A] -> B) (List A) Int64 -> (List B)" :doc "Apply a function in parallel across worker processes via fork+pipe, preserving input order. If fork is unavailable, falls back to sequential map (D151). Propagates worker traps as ERR_WORKER_TRAP.")
(:sym "parFold" :sig "parFold : (fn [B A] -> B) (fn [B B] -> B) B (List A) Int64 -> B" :doc "Fold a list in parallel across worker processes via fork+pipe. Each chunk i folds step from init and chunk results are combined with combine. Requires init to be an identity of combine and combine associative, so the result does not depend ...")
(:sym "range" :sig "range : Int64 Int64 -> (List Int64)" :doc "Half-open integer range; empty when start is not below end.")
(:sym "listTake" :sig "listTake : (List T) Int64 -> (List T)" :doc "The first n elements, fewer when the list is shorter; n <= 0 gives (list).")
(:sym "listDrop" :sig "listDrop : (List T) Int64 -> (List T)" :doc "The list without its first n elements; (list) when it is shorter.")
(:sym "listLast" :sig "listLast : (List T) -> (Option T)" :doc "The last element, or none for an empty list." :pit (option))
(:sym "listAny?" :sig "listAny? : (fn [T] -> Bool) (List T) -> Bool" :doc "True when the predicate holds for some element; stops at the first.")
(:sym "listAll?" :sig "listAll? : (fn [T] -> Bool) (List T) -> Bool" :doc "True when the predicate holds for every element, so true for an empty list.")
(:sym "listFind" :sig "listFind : (fn [T] -> Bool) (List T) -> (Option T)" :doc "The first element the predicate holds for, or none; stops at the first match.")
(:sym "listCount" :sig "listCount : (fn [T] -> Bool) (List T) -> Int64" :doc "How many elements the predicate holds for; 0 for an empty list.")
(:sym "listFlatMap" :sig "listFlatMap : (fn [A] -> (List B)) (List A) -> (List B)" :doc "Map then concatenate: each element's resulting list in order, back to back.")
(:sym "enumerate" :sig "enumerate : (List T) -> (List (Pair Int64 T))" :doc "Each element paired with its index from 0.")
(:sym "zip" :sig "zip : (List A) (List B) -> (List (Pair A B))" :doc "Pair up elements, truncating to the shorter list.")
(:sym "listSum" :sig "listSum : (List Int64) -> Int64" :doc "Sum of elements, 0 when empty. Traps on Int64 overflow.")
(:sym "listMin" :sig "listMin : (List T) -> (Option T)" :doc "Least element, or none when empty." :pit (option))
(:sym "listMax" :sig "listMax : (List T) -> (Option T)" :doc "Greatest element, or none when empty." :pit (option))
(:sym "partial" :sig "partial : (fn [A... B...] -> R) A... -> (fn [B...] -> R)" :doc "Bind leading arguments of a function." :pit (variadic))
