(:card "core/map" :purpose "Map builtins, no import" :sigs ("mapEmpty : () -> (Map K V)" "mapGet : (Map K V) K -> (Option V)" "mapGetOr : (Map K V) K V -> V" "mapSet : (Map K V) K V -> (Map K V)" "mapRemove : (Map K V) K -> (Map K V)" "mapHas? : (Map K V) K -> Bool" "mapSize : (Map K V) -> Int64" "mapKeys : (Map K V) -> (List K)" "mapValues : (Map K V) -> (List V)" "mapPairs : (Map K V) -> (List (Pair K V))" "mapFromPairs : (List (Pair K V)) -> (Map K V)") :example "(module asl-know/examples/coreMap :x [wordCounts selfTest] :i [])\n\nfn wordCounts text: String -> (Map String Int64)\n  (fold (fn [(m (Map String Int64)) (w String)] -> (Map String Int64) (mapSet m w (+ 1 (mapGetOr m w 0))))\n        (mapEmpty)\n        (filter (fn [(w String)] -> Bool (not (stringEmpty? w))) (stringSplit text \" \")))")
(:sym "mapEmpty" :sig "mapEmpty : () -> (Map K V)" :doc "The empty map.")
(:sym "mapGet" :sig "mapGet : (Map K V) K -> (Option V)" :doc "Value for a key, or none." :pit (option))
(:sym "mapGetOr" :sig "mapGetOr : (Map K V) K V -> V" :doc "Value for a key, or the given default when absent.")
(:sym "mapSet" :sig "mapSet : (Map K V) K V -> (Map K V)" :doc "Map with the key bound to the value; entries stay ordered by key.")
(:sym "mapRemove" :sig "mapRemove : (Map K V) K -> (Map K V)" :doc "Map without the key.")
(:sym "mapHas?" :sig "mapHas? : (Map K V) K -> Bool" :doc "True when the key is present.")
(:sym "mapSize" :sig "mapSize : (Map K V) -> Int64" :doc "Number of entries.")
(:sym "mapKeys" :sig "mapKeys : (Map K V) -> (List K)" :doc "Keys, sorted.")
(:sym "mapValues" :sig "mapValues : (Map K V) -> (List V)" :doc "Values, ordered by sorted key.")
(:sym "mapPairs" :sig "mapPairs : (Map K V) -> (List (Pair K V))" :doc "Entries as pairs, ordered by sorted key.")
(:sym "mapFromPairs" :sig "mapFromPairs : (List (Pair K V)) -> (Map K V)" :doc "Build from pairs; later entries win.")
