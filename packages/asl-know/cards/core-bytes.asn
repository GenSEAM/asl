(:card "core/bytes" :purpose "Bytes builtins, no import" :sigs ("bytesLength : Bytes -> Int64" "bytesAlloc : Int64 -> Bytes" "bytesGet : Bytes Int64 -> Int64" "bytesSet : Bytes Int64 Int64 -> Unit" "bytesGetFloat64 : Bytes Int64 -> Float64" "bytesSetFloat64 : Bytes Int64 Float64 -> Unit" "stringToBytes : String -> Bytes" "bytesToBase64 : Bytes -> String" "bytesFromBase64 : String -> (Result Bytes String)" "charCode : String -> Int64" "& : Int64 Int64 -> Int64" "| : Int64 Int64 -> Int64" "^ : Int64 Int64 -> Int64" "~ : Int64 -> Int64" "popcount64 : Int64 -> Int64" "bytesSha256 : Bytes -> String" "zstdDecompress : Bytes -> (Result Bytes String)") :fails (bytesFromBase64 zstdDecompress) :example "(module asl-know/examples/coreBytes :x [digest selfTest] :i [])\n\nfn digest s: String -> String\n  (let [(b (stringToBytes s))]\n    (str (bytesLength b) \":\" (bytesToBase64 b) \":\" (bytesSha256 b)))")
(:sym "bytesLength" :sig "bytesLength : Bytes -> Int64" :doc "Byte count.")
(:sym "bytesAlloc" :sig "bytesAlloc : Int64 -> Bytes" :doc "n zero bytes; a negative n traps with ERR_RANGE.")
(:sym "bytesGet" :sig "bytesGet : Bytes Int64 -> Int64" :doc "The byte at an index, 0..255; an index outside the bytes traps with ERR_RANGE.")
(:sym "bytesSet" :sig "bytesSet : Bytes Int64 Int64 -> Unit" :doc "Overwrite the byte at an index in place; an index outside the bytes or a value outside 0..255 traps with ERR_RANGE.")
(:sym "bytesGetFloat64" :sig "bytesGetFloat64 : Bytes Int64 -> Float64" :doc "The native-endian Float64 in 8-byte slot i; a slot outside the bytes traps with ERR_RANGE.")
(:sym "bytesSetFloat64" :sig "bytesSetFloat64 : Bytes Int64 Float64 -> Unit" :doc "Overwrite 8-byte slot i in place; a slot outside the bytes traps with ERR_RANGE, an Int value with ERR_TYPE.")
(:sym "stringToBytes" :sig "stringToBytes : String -> Bytes" :doc "The UTF-8 bytes of a string. The one string primitive past stringLength, stringSlice and stringConcat; charCode and fnv1a64 derive from it.")
(:sym "bytesToBase64" :sig "bytesToBase64 : Bytes -> String" :doc "RFC 4648 base64 with = padding.")
(:sym "bytesFromBase64" :sig "bytesFromBase64 : String -> (Result Bytes String)" :doc "Decode padded RFC 4648 base64; a character outside the alphabet, misplaced padding or a length not a multiple of 4 is an err." :pit (result))
(:sym "charCode" :sig "charCode : String -> Int64" :doc "Unicode code point of the first character, so (charCode \"é\") is 233; the empty string traps.")
(:sym "&" :sig "& : Int64 Int64 -> Int64" :doc "Bitwise and on two's complement Int64. Retired bitAnd is ERR_UNKNOWN_SYMBOL.")
(:sym "|" :sig "| : Int64 Int64 -> Int64" :doc "Bitwise or on two's complement Int64. Retired bitOr is ERR_UNKNOWN_SYMBOL.")
(:sym "^" :sig "^ : Int64 Int64 -> Int64" :doc "Bitwise exclusive or on two's complement Int64. Retired bitXor is ERR_UNKNOWN_SYMBOL.")
(:sym "~" :sig "~ : Int64 -> Int64" :doc "Bitwise complement, (- -1 x). Retired bitNot is ERR_UNKNOWN_SYMBOL.")
(:sym "popcount64" :sig "popcount64 : Int64 -> Int64" :doc "Number of one bits in the two's complement Int64, so (popcount64 -1) is 64.")
(:sym "bytesSha256" :sig "bytesSha256 : Bytes -> String" :doc "SHA-256 digest as 64 lower-case hex characters.")
(:sym "zstdDecompress" :sig "zstdDecompress : Bytes -> (Result Bytes String)" :doc "Decompress a zstd frame; the failure is a message." :pit (result))
