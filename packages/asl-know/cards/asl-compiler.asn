(:card "asl-compiler" :purpose "Pure AgentSlang 100% Self-Hosted Compiler Toolchain" :import "(asl-compiler/compiler :a x)" :deps (asl-parser asl-checker asl-codegen asl-ir asl-target-llvm asl-target-swift asl-target-sh asl-target-c) :modules ((:m "asl-compiler/compiler" :doc "Self-hosting AgentSlang compiler core: parse, check and ...") (:m "asl-compiler/asl1" :doc "Stage-1 compiler driver. asl1 build ENTRY -o OUT.ll [--r...") (:m "asl-compiler/checkCache" :doc "Verdict cache for asl1 check (CHECK-SPEED). The key is t...") (:m "asl-compiler/compactRewrite" :doc "Automated token shrinking AST rewriter pass for 1-to-2 t...") (:m "asl-compiler/comptime" :doc "Pure Effect-Typed comptime Interpreter with Fuel Bounds ...")) :moduleCount 18 :sigs ("(schema CompileResult (:f ok Bool) (:f code Str) (:f diagnostics (List Str)))" "compileSourceToC99 src: Str path: Str isFreestanding: Bool -> CompileResult" "compilePackageToC99! entryFile: Str roots: (List Str) isFreestanding: Bool -> (Result CompileResult Str)" "compilePackageToLlvm! entryFile: Str roots: (List Str) -> (Result CompileResult Str)" "compilePackageToLlvmWith! entryFile: Str roots: (List Str) rcMode: Str -> (Result CompileResult Str)" "compilePackageToLlvmFor! entryFile: Str roots: (List Str) rcMode: Str target: Str -> (Result CompileResult Str)") :more (formatDiagnostic formatIrDiagnostics compileSourceTarget compileStandaloneTarget verifyPackageCapabilities eliminateDeadCapabilities usage Verdict cacheDir!) :moreCount 188 :effects (compilePackageToC99! compilePackageToLlvm! compilePackageToLlvmWith! compilePackageToLlvmFor! cacheDir! verdictKey! lookup! store!) :fails (compilePackageToC99! compilePackageToLlvm! compilePackageToLlvmWith! compilePackageToLlvmFor! store! replay! parseSnippet parseDiagnosticReceipt) :example none)
(:sym "CompileResult" :mod "asl-compiler/compiler" :kind type :sig "(schema CompileResult (:f ok Bool) (:f code Str) (:f diagnostics (List Str)))" :pit (record))
(:sym "compileSourceToC99" :mod "asl-compiler/compiler" :sig "compileSourceToC99 src: Str path: Str isFreestanding: Bool -> CompileResult" :doc "Parse and check one standalone source, then emit ISO C99; diagnostics instead of code on failure.")
(:sym "compilePackageToC99!" :mod "asl-compiler/compiler" :kind fn! :sig "compilePackageToC99! entryFile: Str roots: (List Str) isFreestanding: Bool -> (Result CompileResult Str)" :doc "Load the entry file and its imports, check the entry, and emit one C99 unit for the whole closure." :pit (result effect))
(:sym "compilePackageToLlvm!" :mod "asl-compiler/compiler" :kind fn! :sig "compilePackageToLlvm! entryFile: Str roots: (List Str) -> (Result CompileResult Str)" :doc "Load the entry file and its imports, check the entry, lower the closure to IR and emit LLVM IR with a main." :pit (result effect))
(:sym "compilePackageToLlvmWith!" :mod "asl-compiler/compiler" :kind fn! :sig "compilePackageToLlvmWith! entryFile: Str roots: (List Str) rcMode: Str -> (Result CompileResult Str)" :doc "compilePackageToLlvm! with the RC mode passed to emitLlvmProgramNativeWith!: 0 tracing, 1 counted, asan, notrace; compilePackageToLlvm! is mode 0." :pit (result effect))
(:sym "compilePackageToLlvmFor!" :mod "asl-compiler/compiler" :kind fn! :sig "compilePackageToLlvmFor! entryFile: Str roots: (List Str) rcMode: Str target: Str -> (Result CompileResult Str)" :doc "compilePackageToLlvmWith! for an explicit target triple: the empty string means the host triple; rcMode as in compilePackageToLlvmWith!." :pit (result effect))
(:sym "formatDiagnostic" :mod "asl-compiler/compiler" :sig "formatDiagnostic d: ty/Diagnostic -> Str" :doc "One checker diagnostic as path:line:col: [code] message.")
(:sym "formatIrDiagnostics" :mod "asl-compiler/compiler" :sig "formatIrDiagnostics diags: (List irTy/IrDiag) -> (List Str)")
(:sym "compileSourceTarget" :mod "asl-compiler/compiler" :sig "compileSourceTarget src: Str target: Str deps: (Map Str r/ModuleSummary) path: Str -> CompileResult" :doc "Compile one source for a named target; c99, c and c-embedded are the targets built in.")
(:sym "compileStandaloneTarget" :mod "asl-compiler/compiler" :sig "compileStandaloneTarget src: Str target: Str path: Str -> CompileResult" :doc "compileSourceTarget with no dependency summaries.")
(:sym "verifyPackageCapabilities" :mod "asl-compiler/compiler" :sig "verifyPackageCapabilities declared: (List Str) used: (List Str) -> Bool" :doc "True when every used capability is among the declared ones.")
(:sym "eliminateDeadCapabilities" :mod "asl-compiler/compiler" :sig "eliminateDeadCapabilities sourceCode: Str requestedCaps: (List Str) -> Str" :doc "Replace the platform calls of capabilities not requested with a constant 0.")
(:sym "usage" :mod "asl-compiler/asl1" :sig "usage -> String" :doc "The command-line synopsis printed on a usage error.")
(:sym "Verdict" :mod "asl-compiler/checkCache" :kind type :sig "(schema Verdict (:f exitCode Int64) (:f body String))" :doc "A stored check result: the exit code and the exact standard-error text." :pit (record))
(:sym "cacheDir!" :mod "asl-compiler/checkCache" :kind fn! :sig "cacheDir! -> String" :doc "ASL_CHECK_CACHE when set and non-empty, else ~/.asl/cache/check." :pit (effect))
(:sym "verdictKey!" :mod "asl-compiler/checkCache" :kind fn! :sig "verdictKey! entry: String -> (Option String)" :doc "The cache key of entry, or none when the entry or a file of either closure cannot be resolved or read." :pit (option effect))
(:sym "keyText" :mod "asl-compiler/checkCache" :sig "keyText entryReal: String deps: String checker: String -> String" :doc "The text hashed into a key: magic line, entry path, path=sha lines of the entry closure, then of the checker closure.")
(:sym "encodeVerdict" :mod "asl-compiler/checkCache" :sig "encodeVerdict key: String v: Verdict -> String" :doc "Serialises a verdict: magic line, key, exit code, sha256 of the body, then the body.")
(:sym "decodeVerdict" :mod "asl-compiler/checkCache" :sig "decodeVerdict key: String text: String -> (Option Verdict)" :doc "Parses a stored verdict; a wrong magic or key, a non-integer exit code, a truncated text or a body not matching its digest is none, a miss, never an error." :pit (option))
(:sym "lookup!" :mod "asl-compiler/checkCache" :kind fn! :sig "lookup! key: String -> (Option Verdict)" :doc "The stored verdict for key, or none when it is absent or does not decode." :pit (option effect))
(:sym "store!" :mod "asl-compiler/checkCache" :kind fn! :sig "store! key: String v: Verdict -> (Result Unit String)" :doc "Writes the verdict to a temporary file beside its entry and renames it into place, so readers see a whole entry or none; removes the temporary file on failure." :pit (result effect))
(:sym "replay!" :mod "asl-compiler/checkCache" :kind fn! :sig "replay! v: Verdict -> (Result Int64 String)" :doc "Prints the stored body to standard error exactly as the cold run did and returns its exit code." :pit (result effect))
(:sym "CompactionRule" :mod "asl-compiler/compactRewrite" :kind type :sig "(schema CompactionRule (:f verbose Str) (:f compact Str) (:f savings I64))" :pit (record))
(:sym "makeCompactionRule" :mod "asl-compiler/compactRewrite" :sig "makeCompactionRule verbose: Str compact: Str savings: I64 -> CompactionRule" :doc "Constructs a compaction rewrite rule mapping verbose to compact forms.")
(:sym "rewriteAstTokens" :mod "asl-compiler/compactRewrite" :sig "rewriteAstTokens src: Str rules: (List CompactionRule) -> Str" :doc "Rewrites verbose AST symbol tokens according to compaction rules.")
(:sym "compactionTarget?" :mod "asl-compiler/compactRewrite" :sig "compactionTarget? sym: Str rules: (List CompactionRule) -> Bool" :doc "Returns true when a symbol matches a compaction rule target.")
(:sym "defaultCompactionRules" :mod "asl-compiler/compactRewrite" :sig "defaultCompactionRules -> (List CompactionRule)" :doc "Returns the default list of symbol compaction rules.")
(:sym "ComptimeConfig" :mod "asl-compiler/comptime" :kind type :sig "(schema ComptimeConfig (:f fuelBudget Int) (:f pureOnly Bool) (:f maxAstNodes Int))" :pit (record))
(:sym "ComptimeResult" :mod "asl-compiler/comptime" :kind type :sig "(schema ComptimeResult (:f status Str) (:f fuelRemaining Int) (:f nodeCount Int) (:f outputValue Str) (:f diagnosticCode Str) (:f diagnosticMessage Str))" :pit (record))
(:sym "makeComptimeConfig" :mod "asl-compiler/comptime" :sig "makeComptimeConfig fuelBudget: Int pureOnly: Bool maxAstNodes: Int -> ComptimeConfig" :doc "Constructs compile-time evaluation configuration parameters.")
(:sym "makeComptimeResult" :mod "asl-compiler/comptime" :sig "makeComptimeResult status: Str fuelRemaining: Int nodeCount: Int outputValue: Str diagnosticCode: Str diagnosticMessage: Str -> ComptimeResult" :doc "Constructs compile-time evaluation result record.")
(:sym "evalComptime" :mod "asl-compiler/comptime" :sig "evalComptime sourceStr: Str fuelBudget: Int -> ComptimeResult" :doc "Evaluates an expression at compile time with a specified fuel budget.")
(:sym "evalComptimeWithConfig" :mod "asl-compiler/comptime" :sig "evalComptimeWithConfig sourceStr: Str cfg: ComptimeConfig -> ComptimeResult" :doc "Evaluates an expression at compile time using the given configuration.")
(:sym "checkPurity" :mod "asl-compiler/comptime" :sig "checkPurity expr: Str -> Bool" :doc "Checks whether an expression contains only pure operations.")
(:sym "consumeFuel" :mod "asl-compiler/comptime" :sig "consumeFuel currentFuel: Int cost: Int -> Int" :doc "Decrements remaining fuel budget by evaluation cost.")
(:sym "expandQuasiquote" :mod "asl-compiler/comptime" :sig "expandQuasiquote form: Str -> Str" :doc "Expands quasiquote and unquote forms within an expression string.")
(:sym "gensym" :mod "asl-compiler/comptime" :kind fn! :sig "gensym prefix: Str -> Str" :doc "Generates a unique symbol name with the given prefix." :pit (effect))
(:sym "monotonicAfter" :mod "asl-compiler/comptime" :kind fn! :sig "monotonicAfter previous: Int -> Int" :doc "Busy-waits on the monotonic clock until it reads strictly later than previous, for gensym's unique timestamp suffix." :pit (effect))
(:sym "foldArithmetic" :mod "asl-compiler/comptime" :sig "foldArithmetic op: Str leftStr: Str rightStr: Str -> Str" :doc "Performs compile-time constant folding for arithmetic and string ops.")
(:sym "isPureOp?" :mod "asl-compiler/comptime" :sig "isPureOp? op: Str -> Bool" :doc "Returns true when an operation is pure and side-effect free.")
(:sym "parseSnippet" :mod "asl-compiler/comptime" :sig "parseSnippet s: Str -> (Result rd/SExpr Str)" :doc "Parses an ASL expression snippet into an S-expression." :pit (result))
(:sym "foldBinaryList" :mod "asl-compiler/comptime" :sig "foldBinaryList op: Str args: (List Str) -> Str" :doc "Folds a binary operation across a list of string arguments.")
(:sym "evalNodeRecursive" :mod "asl-compiler/comptime" :sig "evalNodeRecursive node: rd/SExpr fuelIn: Int nodesIn: Int maxNodes: Int -> (Pair Str (List Int))" :doc "Recursively evaluates an AST node within fuel and complexity limits.")
(:sym "evalArgsLoop" :mod "asl-compiler/comptime" :sig "evalArgsLoop args: (List rd/SExpr) fuelIn: Int nodesIn: Int maxNodes: Int acc: (List Str) -> (Pair (List Str) (List Int))" :doc "Evaluates function arguments sequentially tracking fuel and node count.")
(:sym "SelfHealingDiagnostic" :mod "asl-compiler/diagnostics" :kind type :sig "(schema SelfHealingDiagnostic (:f code Str) (:f symbol Str) (:f anchor Str) (:f message Str) (:f suggestedPatch (Option patch/AstPatch)))" :pit (record))
(:sym "makeSelfHealingDiagnostic" :mod "asl-compiler/diagnostics" :sig "makeSelfHealingDiagnostic code: Str symbol: Str anchor: Str message: Str suggestedPatch: (Option patch/AstPatch) -> SelfHealingDiagnostic" :doc "Constructs a self-healing diagnostic record with optional patch.")
(:sym "emitDiagnosticWithPatch" :mod "asl-compiler/diagnostics" :sig "emitDiagnosticWithPatch code: Str symbol: Str anchor: Str message: Str suggestedPatch: (Option patch/AstPatch) -> SelfHealingDiagnostic" :doc "Constructs and emits a self-healing diagnostic with suggested patch.")
(:sym "suggestMissingImportPatch" :mod "asl-compiler/diagnostics" :sig "suggestMissingImportPatch targetModule: Str existingImports: Str missingImport: Str -> patch/AstPatch" :doc "Creates an AST patch suggesting a missing module import.")
(:sym "suggestMissingMatchBranchPatch" :mod "asl-compiler/diagnostics" :sig "suggestMissingMatchBranchPatch targetModule: Str fnSymbol: Str oldMatchExpr: Str missingBranch: Str -> patch/AstPatch" :doc "Creates an AST patch suggesting a missing pattern match arm.")
(:sym "suggestTypeMismatchPatch" :mod "asl-compiler/diagnostics" :sig "suggestTypeMismatchPatch targetModule: Str fnSymbol: Str oldType: Str newType: Str -> patch/AstPatch" :doc "Creates an AST patch suggesting a function return type fix.")
(:sym "suggestMissingExportPatch" :mod "asl-compiler/diagnostics" :sig "suggestMissingExportPatch targetModule: Str existingExports: Str symbolToExport: Str -> patch/AstPatch" :doc "Creates an AST patch suggesting an export vector addition.")
(:sym "formatDiagnosticWithPatch" :mod "asl-compiler/diagnostics" :sig "formatDiagnosticWithPatch d: SelfHealingDiagnostic -> Str" :doc "Formats a self-healing diagnostic record into an ASN receipt string.")
(:sym "renderDiagnosticReceipt" :mod "asl-compiler/diagnostics" :sig "renderDiagnosticReceipt d: SelfHealingDiagnostic -> Str" :doc "Renders a self-healing diagnostic receipt to string form.")
(:sym "parseDiagnosticReceipt" :mod "asl-compiler/diagnostics" :sig "parseDiagnosticReceipt content: Str -> (Result SelfHealingDiagnostic Str)" :doc "Parses a diagnostic receipt string into a SelfHealingDiagnostic record." :pit (result))
(:sym "emitElf64" :mod "asl-compiler/elf" :sig "emitElf64 irNodes: Any -> Map" :doc "Emits ELF64 binary image structures for an IR module.")
(:sym "writeElfHeaders" :mod "asl-compiler/elf" :sig "writeElfHeaders entryPoint: Any -> Map" :doc "Constructs ELF64 file and program headers map with entry point.")
(:sym "elfSections" :mod "asl-compiler/elf" :sig "elfSections textSize: Any dataSize: Any -> List" :doc "Constructs standard ELF section headers map for text and data.")
(:sym "sysvAbi" :mod "asl-compiler/elf" :sig "sysvAbi -> Map" :doc "Returns System V x86_64 ABI register conventions and alignment map.")
(:sym "hostLinuxAdapter" :mod "asl-compiler/elf" :sig "hostLinuxAdapter -> Map" :doc "Returns host platform adapter configuration for Linux systems.")
(:sym "hostWindowsAdapter" :mod "asl-compiler/elf" :sig "hostWindowsAdapter -> Map" :doc "Returns host platform adapter configuration for Windows systems.")
(:sym "hostWasiAdapter" :mod "asl-compiler/elf" :sig "hostWasiAdapter -> Map" :doc "Returns host platform adapter configuration for WASI environments.")
(:sym "normalizeWin32Path" :mod "asl-compiler/elf" :sig "normalizeWin32Path p: Any -> Str" :doc "Normalizes backslashes to forward slashes in a Windows path.")
(:sym "qpcToNanoseconds" :mod "asl-compiler/elf" :sig "qpcToNanoseconds qpc: Any freq: Any -> Int64" :doc "Converts Windows QueryPerformanceCounter ticks to nanoseconds.")
(:sym "iocpRingInit" :mod "asl-compiler/elf" :sig "iocpRingInit cap: Any -> Map" :doc "Initializes an IOCP event completion ring buffer.")
(:sym "iocpRingPush" :mod "asl-compiler/elf" :sig "iocpRingPush ring: Any event: Any -> Map" :doc "Pushes an event onto an IOCP completion ring buffer.")
(:sym "iocpRingPop" :mod "asl-compiler/elf" :sig "iocpRingPop ring: Any -> Map" :doc "Pops the oldest event from an IOCP completion ring buffer.")
(:sym "translateIocpEvent" :mod "asl-compiler/elf" :sig "translateIocpEvent ring: Any event: Any -> Map" :doc "Translates and enqueues an IOCP completion event.")
(:sym "EvalValue" :mod "asl-compiler/evaluator" :kind type :sig "(enum EvalValue (:c valInt [(v Int64)] \"64-bit signed integer value\") (:c valFloat [(v Float64)] \"64-bit floating point value\") (:c valStr [(v String)] \"String value\") (:c valBool [(v Bool)] \"Boolean truth value\") (:c valNull [] \"Unit / Null value\") (:c valList [(items (List EvalValue))] \"List of va ...")
(:sym "EvalEnv" :mod "asl-compiler/evaluator" :kind type :sig "(schema EvalEnv (:f bindings (Map String EvalValue)) (:f parentFrames (List (Map String EvalValue))))" :pit (record))
(:sym "makeRootEnv" :mod "asl-compiler/evaluator" :sig "makeRootEnv -> EvalEnv" :doc "Creates a root evaluation environment with empty binding scopes.")
(:sym "makeChildEnv" :mod "asl-compiler/evaluator" :sig "makeChildEnv parent: EvalEnv -> EvalEnv" :doc "Creates a child evaluation environment pushing current scope into parent frames.")
(:sym "envLookup" :mod "asl-compiler/evaluator" :sig "envLookup env: EvalEnv name: String -> (Option EvalValue)" :doc "Looks up a variable name in the environment and enclosing parent scopes." :pit (option))
(:sym "envBind" :mod "asl-compiler/evaluator" :sig "envBind env: EvalEnv name: String val: EvalValue -> EvalEnv" :doc "Binds a variable name to an evaluation value in the environment.")
(:sym "evalAtom" :mod "asl-compiler/evaluator" :sig "evalAtom atomStr: String env: EvalEnv -> EvalValue" :doc "Evaluates an atomic literal or variable reference in the environment.")
(:sym "evalBuiltinArithmetic" :mod "asl-compiler/evaluator" :sig "evalBuiltinArithmetic op: String a: Int64 b: Int64 -> EvalValue" :doc "Evaluates a binary arithmetic operation on integer values.")
(:sym "evalBuiltinComparison" :mod "asl-compiler/evaluator" :sig "evalBuiltinComparison op: String a: EvalValue b: EvalValue -> EvalValue" :doc "Evaluates comparison operations between two evaluation values.")
(:sym "evalBuiltinLogic" :mod "asl-compiler/evaluator" :sig "evalBuiltinLogic op: String a: Bool b: Bool -> EvalValue" :doc "Evaluates boolean logic operations on evaluation values.")
(:sym "evalBuiltinString" :mod "asl-compiler/evaluator" :sig "evalBuiltinString op: String args: (List EvalValue) -> EvalValue" :doc "Evaluates string manipulation builtins on evaluation argument values.")
(:sym "evalBuiltinList" :mod "asl-compiler/evaluator" :sig "evalBuiltinList op: String args: (List EvalValue) -> EvalValue" :doc "Evaluates list constructor and accessor builtins.")
(:sym "evalBuiltinIo!" :mod "asl-compiler/evaluator" :sig "evalBuiltinIo! op: String args: (List EvalValue) -> EvalValue" :doc "Evaluates file and console I/O builtins via WASI interface." :pit (effect))
(:sym "evalBuiltinSys!" :mod "asl-compiler/evaluator" :sig "evalBuiltinSys! op: String args: (List EvalValue) -> EvalValue" :doc "Evaluates system execution builtins." :pit (effect))
(:sym "evalSpecialForm!" :mod "asl-compiler/evaluator" :sig "evalSpecialForm! op: String args: (List rd/SExpr) env: EvalEnv -> EvalValue" :doc "Evaluates special forms including if, let, match, and lambda." :pit (effect))
(:sym "evalSexpr!" :mod "asl-compiler/evaluator" :sig "evalSexpr! expr: rd/SExpr env: EvalEnv -> EvalValue" :doc "Evaluates an S-expression AST node within the evaluation environment." :pit (effect))
(:sym "evalAssert" :mod "asl-compiler/evaluator" :sig "evalAssert condVal: EvalValue msgStr: String -> EvalValue" :doc "Evaluates an assert condition returning boolean true or error value.")
(:sym "truthy?" :mod "asl-compiler/evaluator" :sig "truthy? v: EvalValue -> Bool" :doc "Determines whether an evaluation value is logically true.")
(:sym "evalResultIsOk?" :mod "asl-compiler/evaluator" :sig "evalResultIsOk? v: EvalValue -> Bool" :doc "Returns true when an evaluation value is not an error.")
(:sym "formatVal" :mod "asl-compiler/evaluator" :sig "formatVal v: EvalValue -> String" :doc "Formats an evaluation value into its human-readable string representation.")
(:sym "applyClosure!" :mod "asl-compiler/evaluator" :sig "applyClosure! closure: EvalValue argVals: (List EvalValue) -> EvalValue" :doc "Calls a closure value with arguments bound in its captured environment." :pit (effect))
(:sym "evalValuesEqual?" :mod "asl-compiler/evaluator" :sig "evalValuesEqual? a: EvalValue b: EvalValue -> Bool" :doc "Structural equality of two evaluator values of the same variant.")
(:sym "emitMachoArm64" :mod "asl-compiler/macho" :sig "emitMachoArm64 irNodes: Any -> Map" :doc "Emits Mach-O 64-bit binary headers and section layout for ARM64.")
(:sym "writeMachoHeaders" :mod "asl-compiler/macho" :sig "writeMachoHeaders ncmds: Any sizeofcmds: Any -> Map" :doc "Constructs Mach-O 64-bit load commands and file header.")
(:sym "arm64Instructions" :mod "asl-compiler/macho" :sig "arm64Instructions opcode: Any rd: Any rn: Any rm: Any -> Map" :doc "Constructs a representation of an ARM64 machine instruction.")
(:sym "machoSections" :mod "asl-compiler/macho" :sig "machoSections textSize: Any dataSize: Any -> List" :doc "Constructs Mach-O 64-bit text and data section definitions.")
(:sym "hostDarwinAdapter" :mod "asl-compiler/macho" :sig "hostDarwinAdapter -> Map" :doc "Returns host platform adapter configuration for macOS Darwin.")
(:sym "machTimeToNanoseconds" :mod "asl-compiler/macho" :sig "machTimeToNanoseconds ticks: Any numer: Any denom: Any -> Int64" :doc "Converts Mach continuous time ticks to nanoseconds.")
(:sym "canonicalizePathDarwin" :mod "asl-compiler/macho" :sig "canonicalizePathDarwin path: Any -> Str" :doc "Canonicalizes path separators for Darwin filesystem paths.")
(:sym "expandLetPair" :mod "asl-compiler/macro" :sig "expandLetPair k: Str v: Str pairExpr: Str bodyExpr: Str -> Str" :doc "Expands (let-pair [k v] pairExpr bodyExpr) into canonical let with pairFirst and pairSecond.")
(:sym "expandIfLet" :mod "asl-compiler/macro" :sig "expandIfLet bindingVar: Str optExpr: Str thenExpr: Str elseExpr: Str -> Str" :doc "Expands (if-let [var opt] then else) into canonical mt pattern match on some/none.")
(:sym "expandWhenLet" :mod "asl-compiler/macro" :sig "expandWhenLet bindingVar: Str optExpr: Str bodyExpr: Str -> Str" :doc "Expands (when-let [var opt] body) into canonical if-let with (none) fallback.")
(:sym "expandCond" :mod "asl-compiler/macro" :sig "expandCond clauses: (List (Pair Str Str)) defaultExpr: Str -> Str" :doc "Expands a list of cond test/body clauses and fallback into nested if expressions.")
(:sym "expandCase" :mod "asl-compiler/macro" :sig "expandCase valExpr: Str arms: (List (Pair Str Str)) defaultExpr: Str -> Str" :doc "Expands case expression on valExpr into a let binding and nested equality checks.")
(:sym "expandLetStar" :mod "asl-compiler/macro" :sig "expandLetStar bindings: (List (Pair Str Str)) bodyExpr: Str -> Str" :doc "Expands sequential let bindings (let* ((k1 v1) (k2 v2)) body) into nested canonical let forms.")
(:sym "expandPipe" :mod "asl-compiler/macro" :sig "expandPipe initialExpr: Str forms: (List Str) -> Str" :doc "Expands thread-first pipeline (-> x (f1 a) (f2 b)) by threading the accumulator into the first argument position of each form.")
(:sym "optionMap" :mod "asl-compiler/monad" :sig "optionMap opt: (Option A) f: (fn [A] -> B) -> (Option B)" :doc "Maps a transformation function over an Option value.")
(:sym "option-and-then" :mod "asl-compiler/monad" :sig "option-and-then opt: (Option A) f: (fn [A] -> (Option B)) -> (Option B)" :doc "Chains an Option value with a function returning an Option." :pit (option))
(:sym "option-unwrap-or" :mod "asl-compiler/monad" :sig "option-unwrap-or opt: (Option A) fallback: A -> A" :doc "Unwraps an Option value returning fallback when none.")
(:sym "resultMap" :mod "asl-compiler/monad" :sig "resultMap res: (Result T E) f: (fn [T] -> U) -> (Result U E)" :doc "Maps a transformation function over an ok Result value.")
(:sym "resultMapErr" :mod "asl-compiler/monad" :sig "resultMapErr res: (Result T E) f: (fn [E] -> F) -> (Result T F)" :doc "Maps an error transformation function over an err Result value.")
(:sym "result-and-then" :mod "asl-compiler/monad" :sig "result-and-then res: (Result T E) f: (fn [T] -> (Result U E)) -> (Result U E)" :doc "Chains a Result value with a function returning a Result." :pit (result))
(:sym "result-unwrap-or" :mod "asl-compiler/monad" :sig "result-unwrap-or res: (Result T E) fallback: T -> T" :doc "Unwraps a Result value returning fallback when err.")
(:sym "foldConstants" :mod "asl-compiler/optFold" :sig "foldConstants expr: rd/SExpr -> rd/SExpr" :doc "Recursively simplifies constant expressions across an S-expression tree.")
(:sym "foldArithmetic" :mod "asl-compiler/optFold" :sig "foldArithmetic op: Str a1: rd/SExpr a2: rd/SExpr -> (Option rd/SExpr)" :doc "Folds constant arithmetic expressions into simplified literal forms." :pit (option))
(:sym "foldLogic" :mod "asl-compiler/optFold" :sig "foldLogic op: Str a1: rd/SExpr a2: rd/SExpr -> (Option rd/SExpr)" :doc "Folds boolean logic operations on constant expressions." :pit (option))
(:sym "foldBranches" :mod "asl-compiler/optFold" :sig "foldBranches condExpr: rd/SExpr thenExpr: rd/SExpr elseExpr: rd/SExpr -> rd/SExpr" :doc "Eliminates unreachable conditional branches on constant predicates.")
(:sym "asInt" :mod "asl-compiler/optFold" :sig "asInt s: rd/SExpr -> (Option Int64)" :doc "Extracts an integer value from an atomic S-expression if valid." :pit (option))
(:sym "asBool" :mod "asl-compiler/optFold" :sig "asBool s: rd/SExpr -> (Option Bool)" :doc "Extracts a boolean value from an atomic S-expression if valid." :pit (option))
(:sym "simplifyBoolean" :mod "asl-compiler/optFold" :sig "simplifyBoolean expr: rd/SExpr -> rd/SExpr" :doc "Simplifies boolean expressions using algebraic identities.")
(:sym "dceBlock" :mod "asl-compiler/optFold" :sig "dceBlock expr: rd/SExpr -> rd/SExpr" :doc "Eliminates dead code expressions within sequential blocks.")
(:sym "evalComptimeConstant" :mod "asl-compiler/optFold" :sig "evalComptimeConstant expr: rd/SExpr -> (Option rd/SExpr)" :doc "Evaluates compile-time constant expressions to simplified forms." :pit (option))
(:sym "foldLetBindings" :mod "asl-compiler/optFold" :sig "foldLetBindings expr: rd/SExpr -> rd/SExpr" :doc "Folds constant let-bindings by propagating evaluated comptime constants into body.")
(:sym "substituteVar" :mod "asl-compiler/optFold" :sig "substituteVar expr: rd/SExpr varName: Str replacement: rd/SExpr -> rd/SExpr" :doc "Substitutes free occurrences of varName with replacement within an S-expression AST.")
(:sym "sexprEquals?" :mod "asl-compiler/optFold" :sig "sexprEquals? a: rd/SExpr b: rd/SExpr -> Bool" :doc "Returns true when two S-expressions have identical rendered text.")
(:sym "QueryKey" :mod "asl-compiler/salsa" :kind type :sig "(schema QueryKey (:f symbol Str) (:f kind Str))" :pit (record))
