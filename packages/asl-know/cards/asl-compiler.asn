(:card "asl-compiler" :purpose "Pure AgentSlang 100% Self-Hosted Compiler Toolchain" :import "(asl-compiler/compiler :a x)" :deps (asl-parser asl-checker asl-codegen asl-ir asl-target-llvm asl-target-swift asl-target-sh asl-target-c) :modules ((:m "asl-compiler/compiler") (:m "asl-compiler/asl1") (:m "asl-compiler/checkCache") (:m "asl-compiler/compactRewrite" :doc "Automated token shrinking AST rewriter pass for 1-to-2 t...") (:m "asl-compiler/comptime")) :moduleCount 18 :sigs ("(schema CompileResult (:f ok Bool) (:f code Str) (:f diagnostics (List Str)))" "compileSourceToC99 src: Str path: Str isFreestanding: Bool -> CompileResult" "compilePackageToC99! entryFile: Str roots: (List Str) isFreestanding: Bool -> (Result CompileResult Str)" "compilePackageToLlvm! entryFile: Str roots: (List Str) -> (Result CompileResult Str)" "compilePackageToLlvmWith! entryFile: Str roots: (List Str) rcMode: Str -> (Result CompileResult Str)" "compilePackageToLlvmFor! entryFile: Str roots: (List Str) rcMode: Str target: Str -> (Result CompileResult Str)") :more (formatDiagnostic formatIrDiagnostics compileSourceTarget compileStandaloneTarget verifyPackageCapabilities eliminateDeadCapabilities usage Verdict cacheDir!) :moreCount 192 :effects (compilePackageToC99! compilePackageToLlvm! compilePackageToLlvmWith! compilePackageToLlvmFor! cacheDir! verdictKey! verdictKeyWith! lookup!) :fails (compilePackageToC99! compilePackageToLlvm! compilePackageToLlvmWith! compilePackageToLlvmFor! store! replay! parseSnippet parseDiagnosticReceipt) :example none)
