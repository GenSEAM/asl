(:card "asl-parser" :purpose "100% Self-Hosted Pure AgentSlang S-Expression Lexer, Reader & AST Parser" :import "(asl-parser/lexer :a x)" :modules ((:m "asl-parser/lexer" :doc "100% Self-Hosted AgentSlang S-Expression Lexer and Token...") (:m "asl-parser/ast" :doc "Typed AST nodes for the four section-4 heads, parseable ...") (:m "asl-parser/astConverter" :doc "Bidirectional AST Converter and Roundtrip Equivalence be...") (:m "asl-parser/astPrinter" :doc "Typed AST printer: top forms and modules in the host dia...") (:m "asl-parser/balance" :doc "Pure AgentSlang delimiter balance and structural paren/b...")) :moduleCount 16 :sigs ("(enum TokenType (:c tokLparen [] \"Left parenthesis delimiter '('\") (:c tokRparen [] \"Right parenthesis delimiter ')'\") (:c tokLbracket [] \"L..." "(schema Token (:f kind TokenType) (:f rawText String) (:f line Int64) (:f col Int64))" "makeToken k: TokenType raw: String l: Int64 c: Int64 -> Token" "tokenKind atom: String -> TokenType" "isWhitespace ch: String -> Bool" "isDelimiter ch: String -> Bool" "tokenTypeName tt: TokenType -> String" "tokenize s: String -> (List Token)" "charAt s: String i: Int64 -> String" "isDigit c: String -> Bool") :more (moduleNode ModuleNode SchemaNode EnumNode DefunNode EnumCase Param AstField TopForm ParseError PosForm KidForm readForms parse parseLegacy parseForTypeCheck) :moreCount 147 :fails (readForms parse parseLegacy parseForTypeCheck parseForChecker readKidForms kidFormsFor sexprToTopForm) :example none)
(:sym "TokenType" :mod "asl-parser/lexer" :kind type :sig "(enum TokenType (:c tokLparen [] \"Left parenthesis delimiter '('\") (:c tokRparen [] \"Right parenthesis delimiter ')'\") (:c tokLbracket [] \"Left square bracket delimiter '['\") (:c tokRbracket [] \"Right square bracket delimiter ']'\") (:c tokSymbol [(name String)] \"Identifier or language symbol\") (:c t ...")
(:sym "Token" :mod "asl-parser/lexer" :kind type :sig "(schema Token (:f kind TokenType) (:f rawText String) (:f line Int64) (:f col Int64))" :pit (record))
(:sym "makeToken" :mod "asl-parser/lexer" :sig "makeToken k: TokenType raw: String l: Int64 c: Int64 -> Token" :doc "Constructs a token record with kind, text, and position.")
(:sym "tokenKind" :mod "asl-parser/lexer" :sig "tokenKind atom: String -> TokenType" :doc "Determines the token type for an atomic token string.")
(:sym "isWhitespace" :mod "asl-parser/lexer" :sig "isWhitespace ch: String -> Bool" :doc "Returns true when a character is whitespace.")
(:sym "isDelimiter" :mod "asl-parser/lexer" :sig "isDelimiter ch: String -> Bool" :doc "Returns true when a character is a delimiter token.")
(:sym "tokenTypeName" :mod "asl-parser/lexer" :sig "tokenTypeName tt: TokenType -> String" :doc "Returns the name string of a token type.")
(:sym "tokenize" :mod "asl-parser/lexer" :sig "tokenize s: String -> (List Token)" :doc "Tokenizes ASL source text into a list of lexical tokens.")
(:sym "charAt" :mod "asl-parser/lexer" :sig "charAt s: String i: Int64 -> String" :doc "Returns the single character string at index i or empty string.")
(:sym "isDigit" :mod "asl-parser/lexer" :sig "isDigit c: String -> Bool" :doc "Returns true when a character is an ASCII decimal digit.")
(:sym "moduleNode" :mod "asl-parser/ast" :sig "moduleNode m: rd/SExpr path: String defs: (List TopForm) -> ModuleNode" :doc "Builds the module node from its header form and definitions.")
(:sym "ModuleNode" :mod "asl-parser/ast" :kind type :sig "(schema ModuleNode (:f path String) (:f docstring String) (:f exported (List String)) (:f imports (List (Pair String String))) (:f defs (List TopForm)))" :pit (record))
(:sym "SchemaNode" :mod "asl-parser/ast" :kind type :sig "(schema SchemaNode (:f name String) (:f typeVars (List String)) (:f fields (List AstField)) (:f jsonCase (Option String)))" :pit (record))
(:sym "EnumNode" :mod "asl-parser/ast" :kind type :sig "(schema EnumNode (:f name String) (:f typeVars (List String)) (:f cases (List EnumCase)))" :pit (record))
(:sym "DefunNode" :mod "asl-parser/ast" :kind type :sig "(schema DefunNode (:f name String) (:f typeVars (List String)) (:f isExported Bool) (:f effect Bool) (:f params (List Param)) (:f retType String) (:f docstring String) (:f body (List rd/SExpr)) (:f bodyPos (List PosForm)))" :pit (record))
(:sym "EnumCase" :mod "asl-parser/ast" :kind type :sig "(schema EnumCase (:f name String) (:f fields (List Param)) (:f docstring String))" :pit (record))
(:sym "Param" :mod "asl-parser/ast" :kind type :sig "(schema Param (:f name String) (:f type String))" :pit (record))
(:sym "AstField" :mod "asl-parser/ast" :kind type :sig "(schema AstField (:f name String) (:f type String) (:f docstring String) (:f default (Option rd/SExpr)) (:f json (Option String)))" :pit (record))
(:sym "TopForm" :mod "asl-parser/ast" :kind type :sig "(enum TopForm (:c topModule [(node ModuleNode)] \"A module declaration\") (:c topSchema [(node SchemaNode)] \"A defschema declaration\") (:c topEnum [(node EnumNode)] \"A defenum declaration\") (:c topDefun [(node DefunNode)] \"A defun declaration\") (:c topExpr [(pos PosForm)] \"A bare top-level expression, ...")
(:sym "ParseError" :mod "asl-parser/ast" :kind type :sig "(schema ParseError (:f msg String) (:f line Int64) (:f col Int64))" :pit (record))
(:sym "PosForm" :mod "asl-parser/ast" :kind type :sig "(schema PosForm (:f expr rd/SExpr) (:f line Int64) (:f col Int64))" :pit (record))
(:sym "KidForm" :mod "asl-parser/ast" :kind type :sig "(schema KidForm (:f pf PosForm) (:f kids (List (Pair Int64 Int64))) (:f startOffset Int64) (:f endOffset Int64))" :pit (record))
(:sym "readForms" :mod "asl-parser/ast" :sig "readForms toks: (List lx/Token) -> (Result (List PosForm) ParseError)" :doc "Reads a token stream into positioned forms." :pit (result))
(:sym "parse" :mod "asl-parser/ast" :sig "parse src: String -> (Result (List TopForm) ParseError)" :doc "Parses source code text into typed AST top-level forms." :pit (result))
(:sym "parseLegacy" :mod "asl-parser/ast" :sig "parseLegacy src: String -> (Result (List TopForm) ParseError)" :doc "Parses source then desugars with-style param display for callers still expecting the legacy AST shape." :pit (result))
(:sym "parseForTypeCheck" :mod "asl-parser/ast" :sig "parseForTypeCheck src: String -> (Result (List TopForm) ParseError)" :doc "Parses source for the checker: rejects retired syntax first, then parses for the checker's own AST shape." :pit (result))
(:sym "retiredProse" :mod "asl-parser/ast" :sig "retiredProse src: String -> (Option ParseError)" :doc "Finds a free ; comment or (:m :why ...) form the reader rejects since docs moved to the package doc.asn." :pit (option))
(:sym "retiredSpelling" :mod "asl-parser/ast" :sig "retiredSpelling src: String -> (Option ParseError)" :doc "The first retired spelling, (mt ...), (== ...) or (not= ...) head, in a source; always on, no opt-out; none without tokenising when the source holds none of the three spellings as text." :pit (option))
(:sym "retiredSource" :mod "asl-parser/ast" :sig "retiredSource src: String -> (Option ParseError)" :doc "The first retired-prose or retired-spelling error; parse and parseForTypeCheck reject a source with it." :pit (option))
(:sym "spellingErrors" :mod "asl-parser/ast" :sig "spellingErrors src: String -> (List ParseError)" :doc "Every retired spelling in a source, in order: (mt ...), (== ...) and (not= ...) heads outside let and fn binders, each an ERR_READ_SPELLING naming the new spelling. fn ! name headers and bare effectful builtin calls are not flagged (SYN-ARM...")
(:sym "retiredFormErrors" :mod "asl-parser/ast" :sig "retiredFormErrors src: String -> (List ParseError)" :doc "Same scan as spellingErrors, in source order of discovery; used by tools/agentSurfaceAudit.asl, which measures retired-debt in surfaces that are not parsed.")
(:sym "bangedBuiltins" :mod "asl-parser/ast" :sig "bangedBuiltins -> (List String)" :doc "The effectful builtins that carry ! (println!, fileReadString!): strict spelling names the banged form for an unbanged call head the module does not define itself; equal to the :global list of tools/codemod/builtinBang.asn, which spellCodem...")
(:sym "parseForChecker" :mod "asl-parser/ast" :sig "parseForChecker src: String -> (Result (List TopForm) ParseError)" :doc "Parses source with the fallback grammar path the type checker consumes." :pit (result))
(:sym "renderNode" :mod "asl-parser/ast" :sig "renderNode t: TopForm -> String" :doc "Renders a top-level AST declaration back to source string.")
(:sym "AstLit" :mod "asl-parser/ast" :kind type :sig "(enum AstLit (:c litInt [(val Int64)]) (:c litFloat [(val Float64)]) (:c litString [(val String)]) (:c litBool [(val Bool)]) (:c litUnit []))")
(:sym "litInt" :mod "asl-parser/ast" :kind ctor :sig "(:c litInt [(val Int64)]) of AstLit" :pit (ctor))
(:sym "litFloat" :mod "asl-parser/ast" :kind ctor :sig "(:c litFloat [(val Float64)]) of AstLit" :pit (ctor))
(:sym "litString" :mod "asl-parser/ast" :kind ctor :sig "(:c litString [(val String)]) of AstLit" :pit (ctor))
(:sym "litBool" :mod "asl-parser/ast" :kind ctor :sig "(:c litBool [(val Bool)]) of AstLit" :pit (ctor))
(:sym "litUnit" :mod "asl-parser/ast" :kind ctor :sig "(:c litUnit [])) of AstLit" :pit (ctor))
(:sym "AstPattern" :mod "asl-parser/ast" :kind type :sig "(enum AstPattern (:c patWildcard [] \"Wildcard _\") (:c patVar [(name String)] \"Variable binding\") (:c patLit [(lit AstLit)] \"Literal pattern\") (:c patTuple [(elements (List AstPattern))] \"Tuple/list pattern\") (:c patRecord [(fields (List (Pair String AstPattern)))] \"Record pattern\") (:c patCtor [(nam ...")
(:sym "patWildcard" :mod "asl-parser/ast" :kind ctor :sig "(:c patWildcard [] \"Wildcard _\") of AstPattern" :pit (ctor))
(:sym "patVar" :mod "asl-parser/ast" :kind ctor :sig "(:c patVar [(name String)] \"Variable binding\") of AstPattern" :pit (ctor))
(:sym "patLit" :mod "asl-parser/ast" :kind ctor :sig "(:c patLit [(lit AstLit)] \"Literal pattern\") of AstPattern" :pit (ctor))
(:sym "patTuple" :mod "asl-parser/ast" :kind ctor :sig "(:c patTuple [(elements (List AstPattern))] \"Tuple/list pattern\") of AstPattern" :pit (ctor))
(:sym "patRecord" :mod "asl-parser/ast" :kind ctor :sig "(:c patRecord [(fields (List (Pair String AstPattern)))] \"Record pattern\") of AstPattern" :pit (ctor))
(:sym "patCtor" :mod "asl-parser/ast" :kind ctor :sig "(:c patCtor [(name String) (arg (Option AstPattern))] \"Constructor pattern\")) of AstPattern" :pit (ctor))
(:sym "AstMatchArm" :mod "asl-parser/ast" :kind type :sig "(schema AstMatchArm (:f pat AstPattern) (:f body AstExpr))" :pit (record))
(:sym "matchArm" :mod "asl-parser/ast" :sig "matchArm pat: AstPattern body: AstExpr -> AstMatchArm" :doc "Constructs an AST pattern match arm.")
(:sym "makeMatchArm" :mod "asl-parser/ast" :sig "makeMatchArm pat: AstPattern body: AstExpr -> AstMatchArm" :doc "Constructs an AST pattern match arm with pattern and body.")
(:sym "AstExpr" :mod "asl-parser/ast" :kind type :sig "(enum AstExpr (:c exprLit [(lit AstLit)] \"Literal constant\") (:c exprIdent [(name String)] \"Variable or symbol reference\") (:c exprMember [(target AstExpr) (field String)] \"Record/schema field access target.field\") (:c exprCall [(func AstExpr) (args (List AstExpr))] \"Function or constructor call\") ( ...")
(:sym "exprLit" :mod "asl-parser/ast" :kind ctor :sig "(:c exprLit [(lit AstLit)] \"Literal constant\") of AstExpr" :pit (ctor))
(:sym "exprIdent" :mod "asl-parser/ast" :kind ctor :sig "(:c exprIdent [(name String)] \"Variable or symbol reference\") of AstExpr" :pit (ctor))
(:sym "exprMember" :mod "asl-parser/ast" :kind ctor :sig "(:c exprMember [(target AstExpr) (field String)] \"Record/schema field access target.field\") of AstExpr" :pit (ctor))
(:sym "exprCall" :mod "asl-parser/ast" :kind ctor :sig "(:c exprCall [(func AstExpr) (args (List AstExpr))] \"Function or constructor call\") of AstExpr" :pit (ctor))
(:sym "exprLet" :mod "asl-parser/ast" :kind ctor :sig "(:c exprLet [(bindings (List (Pair AstPattern AstExpr))) (body (List AstExpr))] \"Let binding form\") of AstExpr" :pit (ctor))
(:sym "exprIf" :mod "asl-parser/ast" :kind ctor :sig "(:c exprIf [(cond AstExpr) (thenBranch AstExpr) (elseBranch AstExpr)] \"Conditional branch\") of AstExpr" :pit (ctor))
(:sym "exprMatch" :mod "asl-parser/ast" :kind ctor :sig "(:c exprMatch [(target AstExpr) (arms (List AstMatchArm))] \"Pattern match form\") of AstExpr" :pit (ctor))
(:sym "exprTry" :mod "asl-parser/ast" :kind ctor :sig "(:c exprTry [(inner AstExpr)] \"Error propagation try operator expr?\") of AstExpr" :pit (ctor))
(:sym "exprBlock" :mod "asl-parser/ast" :kind ctor :sig "(:c exprBlock [(exprs (List AstExpr))] \"Block of sequential expressions\") of AstExpr" :pit (ctor))
(:sym "exprRecord" :mod "asl-parser/ast" :kind ctor :sig "(:c exprRecord [(fields (List (Pair String AstExpr))) (rawTokens (List AstExpr))] \"Record literal constructor\") of AstExpr" :pit (ctor))
(:sym "exprCond" :mod "asl-parser/ast" :kind ctor :sig "(:c exprCond [(clauses (List (Pair AstExpr (List AstExpr))))] \"Conditional branch cond\") of AstExpr" :pit (ctor))
(:sym "exprLambda" :mod "asl-parser/ast" :kind ctor :sig "(:c exprLambda [(params (List Param)) (retType (Option String)) (body (List AstExpr)) (rawParams rd/SExpr)] \"Lambda anonymous function\") of AstExpr" :pit (ctor))
(:sym "exprInterpolation" :mod "asl-parser/ast" :kind ctor :sig "(:c exprInterpolation [(parts (List AstExpr))] \"String interpolation\")) of AstExpr" :pit (ctor))
(:sym "AstType" :mod "asl-parser/ast" :kind type :sig "(enum AstType (:c typeNamed [(name String)]) (:c typeTuple [(elements (List AstType))]) (:c typeRecord [(fields (List (Pair String AstType)))]) (:c typeFn [(paramTypes (List AstType)) (retType AstType)]))")
(:sym "typeNamed" :mod "asl-parser/ast" :kind ctor :sig "(:c typeNamed [(name String)]) of AstType" :pit (ctor))
(:sym "typeTuple" :mod "asl-parser/ast" :kind ctor :sig "(:c typeTuple [(elements (List AstType))]) of AstType" :pit (ctor))
(:sym "typeRecord" :mod "asl-parser/ast" :kind ctor :sig "(:c typeRecord [(fields (List (Pair String AstType)))]) of AstType" :pit (ctor))
(:sym "typeFn" :mod "asl-parser/ast" :kind ctor :sig "(:c typeFn [(paramTypes (List AstType)) (retType AstType)])) of AstType" :pit (ctor))
(:sym "charsWithin?" :mod "asl-parser/ast" :sig "charsWithin? allowed: String s: String -> Bool" :doc "Returns true when every character in string s is contained within allowed.")
(:sym "tailExprs" :mod "asl-parser/ast" :sig "tailExprs items: (List rd/SExpr) -> (List rd/SExpr)" :doc "Returns all expressions following the first, or empty if items has at most one element.")
(:sym "sexprItems" :mod "asl-parser/ast" :sig "sexprItems s: rd/SExpr -> (List rd/SExpr)" :doc "Extracts items from a list or vector S-expression, returning empty for atoms.")
(:sym "nthExpr" :mod "asl-parser/ast" :sig "nthExpr items: (List rd/SExpr) i: Int64 -> rd/SExpr" :doc "Returns the i-th expression from items, or an empty atom if index is out of bounds.")
(:sym "hasTailrec?" :mod "asl-parser/ast" :sig "hasTailrec? firstOpt: (Option rd/SExpr) -> Bool" :doc "True when the token right after the fn keyword is the tailrec modifier, written as either the bare atom tailrec or the keyword :tailrec.")
(:sym "isInlineBodyCandidate?" :mod "asl-parser/ast" :sig "isInlineBodyCandidate? node: rd/SExpr -> Bool" :doc "check if node holds inline return and body")
(:sym "typeNodeText" :mod "asl-parser/ast" :sig "typeNodeText node: rd/SExpr -> String" :doc "Canonical text of a type annotation node, reading a (list T ...) the indent reader made of [T ...] back as the vector.")
(:sym "joinFnHeader" :mod "asl-parser/ast" :sig "joinFnHeader text: String -> String" :doc "the arrow-scan/paramLine/headerJoin/tailrec-strip primitives moved to asl-parser/fnHeader so indentParser.asl can share them without a cycle (fnHeader imports neither ast nor indentParser); this is a thin re-export for layout.asl's a/joinFn...")
(:sym "readKidForms" :mod "asl-parser/ast" :sig "readKidForms toks: (List lx/Token) -> (Result (List KidForm) ParseError)" :doc "Reads a token list into kid forms, or the first read error." :pit (result))
(:sym "kidFormsFor" :mod "asl-parser/ast" :sig "kidFormsFor src: String -> (Result (List KidForm) ParseError)" :doc "same dialect fallback as parseWithFallback, so kids and tops always pair" :pit (result))
(:sym "findTokenPos" :mod "asl-parser/ast" :sig "findTokenPos src: String floorLine: Int64 floorCol: Int64 needle: String -> (Pair Int64 Int64)" :doc "Finds a token's real line:col by word-boundary search forward from a coarse floor position, falling back to the floor if not found.")
(:sym "findQualifiedTokenPos" :mod "asl-parser/ast" :sig "findQualifiedTokenPos src: String floorLine: Int64 floorCol: Int64 needle: String -> (Pair Int64 Int64)" :doc "Like findTokenPos, but lands on the alias in alias/member when the needle is qualified, and also searches backward from the floor as a fallback.")
(:sym "sexprToAst" :mod "asl-parser/astConverter" :sig "sexprToAst s: rd/SExpr -> a/AstExpr" :doc "Converts an S-expression into an AST expression.")
(:sym "astToSexpr" :mod "asl-parser/astConverter" :sig "astToSexpr expr: a/AstExpr -> rd/SExpr" :doc "Converts an AST expression into an S-expression.")
(:sym "liftExpr" :mod "asl-parser/astConverter" :sig "liftExpr s: rd/SExpr -> a/AstExpr" :doc "Lifts an S-expression into an AST expression.")
(:sym "lowerExpr" :mod "asl-parser/astConverter" :sig "lowerExpr expr: a/AstExpr -> rd/SExpr" :doc "Lowers an AST expression into an S-expression.")
(:sym "lift" :mod "asl-parser/astConverter" :sig "lift s: rd/SExpr -> a/AstExpr" :doc "Lifts an S-expression into an AST expression.")
(:sym "lower" :mod "asl-parser/astConverter" :sig "lower expr: a/AstExpr -> rd/SExpr" :doc "Lowers an AST expression into an S-expression.")
(:sym "liftPattern" :mod "asl-parser/astConverter" :sig "liftPattern s: rd/SExpr -> a/AstPattern" :doc "Lifts an S-expression into an AST pattern.")
(:sym "lowerPattern" :mod "asl-parser/astConverter" :sig "lowerPattern pat: a/AstPattern -> rd/SExpr" :doc "Lowers an AST pattern to its S-expression representation.")
(:sym "liftType" :mod "asl-parser/astConverter" :sig "liftType s: rd/SExpr -> a/AstType" :doc "Lifts an S-expression into an AST type annotation.")
(:sym "lowerType" :mod "asl-parser/astConverter" :sig "lowerType t: a/AstType -> rd/SExpr" :doc "Lowers an AST type annotation to an S-expression.")
(:sym "sexprToTopForm" :mod "asl-parser/astConverter" :sig "sexprToTopForm s: rd/SExpr -> (Result a/TopForm String)" :doc "Parses a declaration S-expression into a top-level AST form." :pit (result))
(:sym "topFormToSexpr" :mod "asl-parser/astConverter" :sig "topFormToSexpr tf: a/TopForm -> rd/SExpr" :doc "Converts a top-level AST form into an S-expression.")
(:sym "printAstModule" :mod "asl-parser/astPrinter" :sig "printAstModule mod: a/ModuleNode -> String" :doc "Formats a module node and its top-level declarations as host-dialect source.")
(:sym "printAstExpr" :mod "asl-parser/astPrinter" :sig "printAstExpr expr: a/AstExpr indent: Int64 -> String" :doc "Formats an AST expression with the given indentation level.")
(:sym "printAstPattern" :mod "asl-parser/astPrinter" :sig "printAstPattern pat: a/AstPattern -> String" :doc "Formats an AST pattern to its string representation.")
(:sym "printAstType" :mod "asl-parser/astPrinter" :sig "printAstType t: a/AstType -> String" :doc "Formats an AST type annotation to its string representation.")
(:sym "printTopForm" :mod "asl-parser/astPrinter" :sig "printTopForm tf: a/TopForm -> String" :doc "Formats a top-level AST declaration form to host-dialect source.")
(:sym "printAst" :mod "asl-parser/astPrinter" :sig "printAst expr: a/AstExpr -> String" :doc "Pretty prints an AST expression as formatted source code.")
(:sym "BalanceResult" :mod "asl-parser/balance" :kind type :sig "(schema BalanceResult (:f balanced Bool) (:f openParens I64) (:f openBrackets I64) (:f openBraces I64))" :pit (record))
(:sym "checkDelimiterBalance" :mod "asl-parser/balance" :sig "checkDelimiterBalance code: Str -> BalanceResult" :doc "Checks nested balance across parentheses and brackets, skipping ; comments.")
(:sym "checkDelimiterBalanceIn" :mod "asl-parser/balance" :sig "checkDelimiterBalanceIn aslComments: Bool code: Str -> BalanceResult" :doc "Checks nested balance; aslComments makes ; start a line comment.")
(:sym "isDelimiterBalanced?" :mod "asl-parser/balance" :sig "isDelimiterBalanced? code: Str -> Bool" :doc "Returns true when parentheses and brackets are balanced.")
(:sym "isPlainDelimiterBalanced?" :mod "asl-parser/balance" :sig "isPlainDelimiterBalanced? code: Str -> Bool" :doc "Balance for non-ASL code, where ; is not a comment.")
(:sym "countUnclosedParens" :mod "asl-parser/balance" :sig "countUnclosedParens code: Str -> I64" :doc "Returns the number of unclosed opening parentheses.")
(:sym "balanceDelimiters" :mod "asl-parser/balance" :sig "balanceDelimiters raw: Str -> Str" :doc "Appends missing closing delimiters to balance unclosed openers.")
(:sym "checkDyck1Balance" :mod "asl-parser/balance" :sig "checkDyck1Balance code: Str -> BalanceResult" :doc "Checks parentheses balance and computes depth and counts.")
(:sym "isDyck1Balanced?" :mod "asl-parser/balance" :sig "isDyck1Balanced? code: Str -> Bool" :doc "Returns true when parentheses in the code are balanced.")
(:sym "CachedAstEntry" :mod "asl-parser/cachedParser" :kind type :sig "(schema CachedAstEntry (:f hash String) (:f symbol String) (:f kind String) (:f ast rd/SExpr) (:f rawText String) (:f merkleParentHash String))" :pit (record))
(:sym "AstCache" :mod "asl-parser/cachedParser" :kind type :sig "(schema AstCache (:f entries (Map String CachedAstEntry)) (:f hits Int64) (:f misses Int64) (:f evictions Int64) (:f maxBytes Int64) (:f currentBytes Int64))" :pit (record))
(:sym "ParseTelemetry" :mod "asl-parser/cachedParser" :kind type :sig "(schema ParseTelemetry (:f totalForms Int64) (:f hits Int64) (:f misses Int64) (:f cacheHitRate Float64) (:f forms (List rd/SExpr)))" :pit (record))
(:sym "newAstCache" :mod "asl-parser/cachedParser" :sig "newAstCache -> AstCache" :doc "Creates a new empty AST cache with default memory limit.")
(:sym "newBoundedAstCache" :mod "asl-parser/cachedParser" :sig "newBoundedAstCache maxBytes: Int64 -> AstCache" :doc "Creates a new empty AST cache with a byte size limit.")
(:sym "computeFormHash" :mod "asl-parser/cachedParser" :sig "computeFormHash content: String -> String" :doc "Computes a content hash string for an individual form.")
(:sym "extractFormSymbol" :mod "asl-parser/cachedParser" :sig "extractFormSymbol formText: String -> (Pair String String)" :doc "Extracts the declaration symbol and kind from form text.")
(:sym "parseCachedForm" :mod "asl-parser/cachedParser" :sig "parseCachedForm formText: String cache: AstCache -> (Pair CachedAstEntry (Pair AstCache Bool))" :doc "PARSER-inferredUnitConsumers / INFERUNIT round 2: a cached AST handed back to a caller that renders it (e.g. for a cache-hit diff or re-emission) must not leak the :inferredUnit sentinel, so it is dropped before the node is cached. Delegate...")
(:sym "parseWithCache" :mod "asl-parser/cachedParser" :sig "parseWithCache cache: AstCache source: String -> (Pair (List rd/SExpr) AstCache)" :doc "Parses source text incrementally utilizing cached forms.")
(:sym "parseIncrementalWithTelemetry" :mod "asl-parser/cachedParser" :sig "parseIncrementalWithTelemetry cache: AstCache source: String -> (Pair ParseTelemetry AstCache)" :doc "Parses source incrementally with performance telemetry tracking.")
(:sym "getCacheStats" :mod "asl-parser/cachedParser" :sig "getCacheStats cache: AstCache -> String" :doc "Formats cache hit, miss, and size statistics into a string.")
(:sym "clearCache" :mod "asl-parser/cachedParser" :sig "clearCache cache: AstCache -> AstCache" :doc "Clears all cached entries while preserving eviction counters.")
(:sym "stripCrLine" :mod "asl-parser/fnHeader" :sig "stripCrLine line: String -> String" :doc "a line read from a CRLF file keeps its trailing \\r; stripping it before a header line is used as a join accumulator keeps that \\r from landing mid-token in the joined line")
(:sym "arrowScan" :mod "asl-parser/fnHeader" :sig "arrowScan bs: Bytes len: Int64 i: Int64 depth: Int64 inStr: Bool -> Bool" :doc "find a depth-0 arrow outside strings")
(:sym "headerArrow?" :mod "asl-parser/fnHeader" :sig "headerArrow? s: String -> Bool" :doc "Whether a fn header line already carries its depth-0 return arrow.")
(:sym "paramLine?" :mod "asl-parser/fnHeader" :sig "paramLine? line: String -> Bool" :doc "Whether an indented line continues a parameter list: it starts with name: or ->.")
(:sym "headerJoin" :mod "asl-parser/fnHeader" :sig "headerJoin header: String rest: (List String) taken: Int64 -> (Option (Pair String Int64))" :doc "join indented param lines until the arrow" :pit (option))
(:sym "stripTailrecPrefix" :mod "asl-parser/fnHeader" :sig "stripTailrecPrefix header: String -> String" :doc "The header with a tailrec or :tailrec modifier after fn removed.")
