(:card "asl-parser" :purpose "100% Self-Hosted Pure AgentSlang S-Expression Lexer, Reader & AST Parser" :import "(asl-parser/lexer :a x)" :modules ((:m "asl-parser/lexer" :doc "100% Self-Hosted AgentSlang S-Expression Lexer and Token...") (:m "asl-parser/asnValue") (:m "asl-parser/ast" :doc "Typed AST nodes for the four section-4 heads, parseable ...") (:m "asl-parser/astConverter" :doc "Bidirectional AST Converter and Roundtrip Equivalence be...") (:m "asl-parser/astPrinter" :doc "Typed AST printer: top forms and modules in the host dia...")) :moduleCount 17 :sigs ("(enum TokenType (:c tokLparen [] \"Left parenthesis delimiter '('\") (:c tokRparen [] \"Right parenthesis delimiter ')'\") (:c tokLbracket [] \"L..." "(schema Token (:f kind TokenType) (:f rawText String) (:f line Int64) (:f col Int64))" "makeToken k: TokenType raw: String l: Int64 c: Int64 -> Token" "tokenKind atom: String -> TokenType" "isWhitespace ch: String -> Bool" "isDelimiter ch: String -> Bool" "tokenTypeName tt: TokenType -> String" "tokenize s: String -> (List Token)" "charAt s: String i: Int64 -> String" "isDigit c: String -> Bool") :more (AsnValue asnParse asnGet asnText asnInt asnFloat asnItems moduleNode ModuleNode SchemaNode EnumNode DefunNode EnumCase Param AstField TopForm ParseError) :moreCount 159 :fails (asnParse readForms parse parseDisplayDesugared parseForTypeCheck parseForChecker readKidForms kidFormsFor) :example none)
