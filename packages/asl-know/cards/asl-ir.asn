(:card "asl-ir" :purpose "AgentSlang Typed Monomorphic ANF Core Intermediate Representation and AST Patch Engine" :import "(asl-ir/main :a x)" :deps (asl-parser asl-checker) :modules ((:m "asl-ir/main" :doc "Top-level API for AgentSlang Core IR lowering, verificat...") (:m "asl-ir/anf" :doc "Administrative Normal Form (ANF) conversion pass for Age...") (:m "asl-ir/blocks" :doc "Shared shape for source targets that emit a linked SSA m...") (:m "asl-ir/drops" :doc "Linear and affine ownership drop insertion pass for Agen...") (:m "asl-ir/link" :doc "Multi-module link (plan SH unit M1): from an entry file,...")) :moduleCount 11 :sigs ("lowerModule name: Str profileId: Str funcs: (List ty/IrFunction) -> ty/IrModule" "verifyIr m: ty/IrModule -> (Result Unit (List ty/IrDiag))" "printIr m: ty/IrModule -> Str" "compileToIr modName: Str profileId: Str funcs: (List ty/IrFunction) -> (Result Str (List ty/IrDiag))" "assignOptionRepr profileId: Str innerType: Str -> Str" "parsePatch patchText: Str -> (Result patch/AstPatch patch/PatchDiag)" "applyPatch p: patch/AstPatch sourceCode: Str -> patch/PatchResult" "invertPatch p: patch/AstPatch -> patch/AstPatch") :more (verifyPatch makeReplacePatch toAnf isTerminalAtom? makeFreshVar BlockCtx blockCtx labelIndex paramNames locals tailCall collect exportName mangle quoted) :moreCount 142 :effects (loadClosure! loadClosureWith! linkEntryWith! linkUnits linkWith! linkEntry! linkWithBare! linkEntryBare!) :fails (verifyIr compileToIr parsePatch verifyPatch collect loadClosure! loadClosureWith! linkEntryWith!) :example none)
(:sym "lowerModule" :mod "asl-ir/main" :sig "lowerModule name: Str profileId: Str funcs: (List ty/IrFunction) -> ty/IrModule" :doc "An IrModule of the functions, each body passed through toAnf and insertDrops.")
(:sym "verifyIr" :mod "asl-ir/main" :sig "verifyIr m: ty/IrModule -> (Result Unit (List ty/IrDiag))" :doc "Verify an IrModule with asl-ir/verify verifyIr." :pit (result))
(:sym "printIr" :mod "asl-ir/main" :sig "printIr m: ty/IrModule -> Str" :doc "Render an IrModule as text with asl-ir/printer printIr.")
(:sym "compileToIr" :mod "asl-ir/main" :sig "compileToIr modName: Str profileId: Str funcs: (List ty/IrFunction) -> (Result Str (List ty/IrDiag))" :doc "Build, verify and print an IrModule, or err with the verifier's diagnostics." :pit (result))
(:sym "assignOptionRepr" :mod "asl-ir/main" :sig "assignOptionRepr profileId: Str innerType: Str -> Str" :doc "The Option representation for the inner type under the profile, as asl-ir/lowering decides it.")
(:sym "parsePatch" :mod "asl-ir/main" :sig "parsePatch patchText: Str -> (Result patch/AstPatch patch/PatchDiag)" :doc "Parse an :astPatch form with asl-ir/patch parsePatch." :pit (result))
(:sym "applyPatch" :mod "asl-ir/main" :sig "applyPatch p: patch/AstPatch sourceCode: Str -> patch/PatchResult" :doc "Apply a patch to source text with asl-ir/patch applyPatch.")
(:sym "invertPatch" :mod "asl-ir/main" :sig "invertPatch p: patch/AstPatch -> patch/AstPatch" :doc "The inverse of a patch, from asl-ir/patch invertPatch.")
(:sym "verifyPatch" :mod "asl-ir/main" :sig "verifyPatch p: patch/AstPatch sourceCode: Str -> (Result Unit (List patch/PatchDiag))" :doc "Ok when the patch applies cleanly to the source, per asl-ir/patch verifyPatch." :pit (result))
(:sym "makeReplacePatch" :mod "asl-ir/main" :sig "makeReplacePatch id: Str targetModule: Str targetSymbol: Str anchor: Str oldNode: Str newNode: Str -> patch/AstPatch" :doc "A one-operation replace patch, from asl-ir/patch makeReplacePatch.")
(:sym "toAnf" :mod "asl-ir/anf" :sig "toAnf stmts: (List ty/IrStmt) -> (List ty/IrStmt)" :doc "Returns the statements unchanged; ANF conversion is not performed yet.")
(:sym "isTerminalAtom?" :mod "asl-ir/anf" :sig "isTerminalAtom? s: Str -> Bool" :doc "True when the operand text has neither a parenthesis nor a space, so it is a single atom.")
(:sym "makeFreshVar" :mod "asl-ir/anf" :sig "makeFreshVar prefix: Str index: I64 -> Str" :doc "The prefix followed by the decimal index, as a fresh variable name.")
(:sym "BlockCtx" :mod "asl-ir/blocks" :kind type :sig "(schema BlockCtx (:f self String) (:f params (List String)) (:f labels (Map String Int64)) (:f params0 (Map String (List String))) (:f returners (List String)))" :pit (record))
(:sym "blockCtx" :mod "asl-ir/blocks" :sig "blockCtx fn0: ty/SsaFunction -> BlockCtx" :doc "A function's BlockCtx: its own name, its parameter names, each block's label index, each block's own parameter names by label, and the labels of blocks that only forward a single value (returners), for recognizing a self tail call.")
(:sym "labelIndex" :mod "asl-ir/blocks" :sig "labelIndex ctx: BlockCtx label: String -> String" :doc "label's position among ctx's blocks, as a string; -1 when label is unknown.")
(:sym "paramNames" :mod "asl-ir/blocks" :sig "paramNames ps: (List ty/SsaParam) -> (List String)" :doc "The declared names of ps, in order.")
(:sym "locals" :mod "asl-ir/blocks" :sig "locals fn0: ty/SsaFunction -> (List String)" :doc "Every name fn0 binds: each block's own parameters followed by its instructions' destinations, in block order.")
(:sym "tailCall" :mod "asl-ir/blocks" :sig "tailCall ctx: BlockCtx b: ty/SsaBlock -> (Option (List String))" :doc "When b's last instruction calls ctx's own function with as many arguments as its parameters and the result is returned, directly or through a forwarding join (ctx.returners), the call's arguments; none otherwise." :pit (option))
(:sym "collect" :mod "asl-ir/blocks" :sig "collect results: (List (Result String String)) -> (Result (List String) (List String))" :doc "results with every err laid out in order as a list of messages, or every ok value in order when none failed." :pit (result))
(:sym "exportName" :mod "asl-ir/blocks" :sig "exportName moduleName: String fnName: String -> (Option String)" :doc "fnName with its 'moduleName.' prefix stripped, when it has that prefix and names no further '@' local; none for a name outside the module or a compiler-generated local." :pit (option))
(:sym "mangle" :mod "asl-ir/blocks" :sig "mangle prefix: String escape: String name: String -> String" :doc "prefix followed by name with every non-identifier byte escaped as escape plus its two lowercase hex digits, so a qualified or symbolic ASL name becomes one target-safe identifier.")
(:sym "quoted" :mod "asl-ir/blocks" :sig "quoted s: String -> String" :doc "s as a double-quoted string literal, escaping backslash, quote, newline, carriage return and tab.")
(:sym "insertDrops" :mod "asl-ir/drops" :sig "insertDrops stmts: (List ty/IrStmt) -> (List ty/IrStmt)" :doc "Returns the statements unchanged; drop insertion is not performed yet.")
(:sym "requiresDrop?" :mod "asl-ir/drops" :sig "requiresDrop? t: ty/IrType -> Bool" :doc "True for types that own memory: str, adt, closure, buf, and option with the tagged representation.")
(:sym "LinkUnit" :mod "asl-ir/link" :kind type :sig "(schema LinkUnit (:f path String) (:f name String) (:f forms (List ast/TopForm)) (:f positions (Map String String)) (:f imports (List (Pair String String))))" :pit (record))
(:sym "LinkAcc" :mod "asl-ir/link" :kind type :sig "(schema LinkAcc (:f strings (List String)) (:f modules (List ty/SsaModule)) (:f requested (List String)) (:f diags (List ty/IrDiag)))" :pit (record))
(:sym "loadClosure!" :mod "asl-ir/link" :kind fn! :sig "loadClosure! entryPath: String -> (Result (List LinkUnit) (List ty/IrDiag))" :doc "Load the entry file and its transitive imports, imports before their importers; err with every read, parse, resolve, duplicate-module and reserved-module-name diagnostic." :pit (result effect))
(:sym "loadClosureWith!" :mod "asl-ir/link" :kind fn! :sig "loadClosureWith! entryPath: String ix: r/ModIndex -> (Result (List LinkUnit) (List ty/IrDiag))" :doc "loadClosure! resolving imports against the module index ix, which is rebuilt only when its root differs from the workspace root an import needs." :pit (result effect))
(:sym "linkEntryWith!" :mod "asl-ir/link" :kind fn! :sig "linkEntryWith! entryPath: String ix: r/ModIndex -> (Result ty/SsaModule (List ty/IrDiag))" :doc "linkEntry! with the closure loaded by loadClosureWith! against the module index ix." :pit (result effect))
(:sym "linkUnits" :mod "asl-ir/link" :kind fn! :sig "linkUnits units: (List LinkUnit) preludeRes: (Result LinkUnit (List ty/IrDiag)) -> (Result ty/SsaModule (List ty/IrDiag))" :doc "linkUnitsWith against the native overlay directory nativeOverlayDir." :pit (result effect))
(:sym "linkWith!" :mod "asl-ir/link" :kind fn! :sig "linkWith! entryPath: String preludeFile: String -> (Result ty/SsaModule (List ty/IrDiag))" :doc "Load the closure of the entry file and link it against the given prelude file." :pit (result effect))
(:sym "linkEntry!" :mod "asl-ir/link" :kind fn! :sig "linkEntry! entryPath: String -> (Result ty/SsaModule (List ty/IrDiag))" :doc "Load the closure of the entry file and link it against the host prelude at preludePath." :pit (result effect))
(:sym "linkWithBare!" :mod "asl-ir/link" :kind fn! :sig "linkWithBare! entryPath: String preludeFile: String -> (Result ty/SsaModule (List ty/IrDiag))" :doc "linkUnitsWithBareEntry against the given entry file and prelude file." :pit (result effect))
(:sym "linkEntryBare!" :mod "asl-ir/link" :kind fn! :sig "linkEntryBare! entryPath: String -> (Result ty/SsaModule (List ty/IrDiag))" :doc "Load the closure of the entry file and link it against the host prelude at preludePath, as linkEntry! does, but the entry module's own declarations stay unqualified and its diagnostic positions stay bare (no source path prefix); used by emi..." :pit (result effect))
(:sym "lowerSourceWith" :mod "asl-ir/link" :sig "lowerSourceWith src: String preludeSrc: String -> (Result ty/SsaModule (List ty/IrDiag))" :doc "Lower one standalone module as lowerSource does, its symbols unqualified, and link the prelude functions it reaches, transitively, from preludeSrc as prelude.<name>, the way linkUnits does for a closure; unverified, as lowerSource. A prelud..." :pit (result))
(:sym "lowerSourceLinked!" :mod "asl-ir/link" :kind fn! :sig "lowerSourceLinked! src: String -> (Result ty/SsaModule (List ty/IrDiag))" :doc "lowerSourceWith against the host prelude at preludePath, read from the working directory." :pit (result effect))
(:sym "preludePath" :mod "asl-ir/link" :sig "preludePath -> String" :doc "Path of the prelude the host loader falls back to, relative to the repository root.")
(:sym "lowerPrelude" :mod "asl-ir/link" :sig "lowerPrelude prelude: LinkUnit acc: LinkAcc -> LinkAcc" :doc "Transitively lower unlowerable prelude references requested by accumulated modules until fixed point.")
(:sym "importForms" :mod "asl-ir/link" :sig "importForms units: (List LinkUnit) u: LinkUnit -> (Map String (List ast/TopForm))" :doc "Map each import alias of a unit to the parsed top forms of its resolved dependency.")
(:sym "firstByName" :mod "asl-ir/link" :sig "firstByName decls: (List ty/SsaTypeDecl) -> (List ty/SsaTypeDecl)" :doc "Deduplicate type declarations by name, keeping the first declaration encountered.")
(:sym "firstRecordByName" :mod "asl-ir/link" :sig "firstRecordByName decls: (List ty/SsaRecordDecl) -> (List ty/SsaRecordDecl)" :doc "Deduplicate record declarations by name, keeping the first declaration encountered.")
(:sym "allFunctions" :mod "asl-ir/link" :sig "allFunctions modules: (List ty/SsaModule) -> (List ty/SsaFunction)" :doc "Collect all function definitions across a list of modules in order.")
(:sym "emptyUnit" :mod "asl-ir/link" :sig "emptyUnit name: String -> LinkUnit" :doc "A LinkUnit with no forms, imports or positions, named name; the fallback used when a real unit (e.g. the prelude) fails to resolve.")
(:sym "nativeOverlayDir" :mod "asl-ir/link" :sig "nativeOverlayDir -> String" :doc "The native-only overlay directory (plan PRELUDEASL-0): each *.asl file in it is a module of top-level fns named after the C builtins they define; the VM never loads it, only linkUnits' opBuiltin rewrite does.")
(:sym "overlayUnit!" :mod "asl-ir/link" :kind fn! :sig "overlayUnit! -> (Result LinkUnit (List ty/IrDiag))" :doc "The native overlay directory as one synthetic LinkUnit named 'native': every overlay file's declarations concatenated under one module header, visible to each other unqualified as one module's own declarations are, and reaching the real pre..." :pit (result effect))
(:sym "overlayUnitAt!" :mod "asl-ir/link" :kind fn! :sig "overlayUnitAt! dir: String -> (Result LinkUnit (List ty/IrDiag))" :doc "dir's *.asl files as the 'native' LinkUnit; a missing dir is an overlay with no declarations, while a dir that exists but cannot be listed, or a file in it that cannot be read or parsed, is an error." :pit (result effect))
(:sym "linkUnitsWith" :mod "asl-ir/link" :sig "linkUnitsWith units: (List LinkUnit) preludeRes: (Result LinkUnit (List ty/IrDiag)) overlayRes: (Result LinkUnit (List ty/IrDiag)) -> (Result ty/SsaModule (List ty/IrDiag))" :doc "Lower every unit and the prelude functions they reach into one verified SsaModule named after the last unit, the entry; then PRELUDEASL-0's opBuiltin rewrite: the native overlay first, the real prelude's own opBuiltin-claimed names (floatNa..." :pit (result))
(:sym "linkUnitsWithBareEntry" :mod "asl-ir/link" :sig "linkUnitsWithBareEntry units: (List LinkUnit) preludeRes: (Result LinkUnit (List ty/IrDiag)) overlayRes: (Result LinkUnit (List ty/IrDiag)) -> (Result ty/SsaModule (List ty/IrDiag))" :doc "As linkUnitsWith, but the last unit (the entry) lowers through lowerLinkedAs with an empty prefix instead of its own module name, so its declarations stay unqualified and its diagnostic positions stay bare, matching lowerModule/lowerWithPre..." :pit (result))
(:sym "rewriteModuleBuiltins" :mod "asl-ir/link" :sig "rewriteModuleBuiltins resolved: (Map String String) m: ty/SsaModule -> ty/SsaModule" :doc "An identity transform when resolved is empty (no program here calls a name the overlay or the opBuiltin-driven prelude lowering claimed), else the post-pass PRELUDEASL-0 adds: every opBuiltin naming a resolved key becomes a call of its link...")
(:sym "rewriteModuleBuiltinsAgainst" :mod "asl-ir/link" :sig "rewriteModuleBuiltinsAgainst resolved: (Map String String) callees: (List ty/SsaFunction) m: ty/SsaModule -> ty/SsaModule" :doc "m with every builtin call that resolved maps to a function rewritten to call that function, looked up among m's own functions and callees; m itself when resolved is empty")
(:sym "definedNames" :mod "asl-ir/link" :sig "definedNames unit: LinkUnit -> (List String)" :doc "names of the unit's top-level fn definitions, in source order")
(:sym "functionBuiltinRefs" :mod "asl-ir/link" :sig "functionBuiltinRefs f: ty/SsaFunction -> (List String)" :doc "names of the builtins the instructions of f call, block by block, repeats kept")
(:sym "LinkScope" :mod "asl-ir/lower" :kind type :sig "(schema LinkScope (:f path String) (:f imports (Map String (List ast/TopForm))) (:f prelude (List ast/TopForm)) (:f strings (List String)) (:f only (Option (List String))))" :pit (record))
(:sym "lowerModule" :mod "asl-ir/lower" :sig "lowerModule forms: (List ast/TopForm) positions: (Map String String) -> (Result ty/SsaModule (List ty/IrDiag))" :doc "Lower the parsed forms of one standalone module, positions naming each declaration's line:col in diagnostics." :pit (result))
(:sym "lowerWithPrelude" :mod "asl-ir/lower" :sig "lowerWithPrelude forms: (List ast/TopForm) positions: (Map String String) prelude: (List ast/TopForm) -> (Result ty/SsaModule (List ty/IrDiag))" :doc "Lower one standalone module, its own symbols unqualified as lowerModule names them, with the prelude visible as in lowerLinked: a call of a prelude function that no module function or builtin of the subset shadows is a call of prelude.<name..." :pit (result))
(:sym "lowerLinked" :mod "asl-ir/lower" :sig "lowerLinked forms: (List ast/TopForm) positions: (Map String String) scope: LinkScope -> (Result ty/SsaModule (List ty/IrDiag))" :doc "Lower one module of a linked closure, qualifying its symbols by module name and resolving imports and the prelude through the scope." :pit (result))
(:sym "lowerLinkedAs" :mod "asl-ir/lower" :sig "lowerLinkedAs forms: (List ast/TopForm) positions: (Map String String) scope: LinkScope prefix: String -> (Result ty/SsaModule (List ty/IrDiag))" :doc "lowerLinked, taking the qualifying prefix explicitly instead of always reading it off moduleName forms. An empty prefix (locatedPositions, linkedInfoAs) keeps this module's own declarations unqualified and its diagnostic positions bare, as ..." :pit (result))
(:sym "lowerSource" :mod "asl-ir/lower" :sig "lowerSource src: String -> (Result ty/SsaModule (List ty/IrDiag))" :doc "Parse the source and lower it as a standalone module; a parse error is one ERR_LOWER_PARSE diagnostic." :pit (result))
(:sym "declPositions" :mod "asl-ir/lower" :sig "declPositions src: String -> (Map String String)" :doc "Map each declared name to the line:col of its first declaration line in the source. Walks srcLines with fold (one pass, carrying the running line index in the accumulator) rather than folding over (range 0 n) and calling listGet srcLines i ...")
(:sym "sitedPositions" :mod "asl-ir/lower" :sig "sitedPositions path: String positions: (Map String String) -> (Map String String)" :doc "Prefix every assert and refute site recorded by declPositions (the name@sites keys) with the unit path, so a failing assert or refute names path:line:col; the link step passes the root-relative path")
(:sym "builtinArity" :mod "asl-ir/lower" :sig "builtinArity name: String -> (Option Int64)" :doc "Operand count of a builtin the lowering emits as opBuiltin, -1 when variadic, none when the name is not one. Only builtins the host defines in C or lowers inline by name (& | ^ ~ << >>, NATIVE-INTRINSICS): a plain prelude function lowers fr..." :pit (option))
(:sym "builtinArityFor" :mod "asl-ir/lower" :sig "builtinArityFor name: String argc: Int64 -> (Option Int64)" :doc "The arity to lower a call of name with argc operands against: its primary arity, any count when that is variadic, else its alt arity when argc matches that instead, else none." :pit (option))
(:sym "genericConcrete" :mod "asl-ir/lower" :sig "genericConcrete name: String kind: String -> String" :doc "The concrete builtin name a generic receiver-dispatched op (length, empty?, get, set, slice, contains?, indexOf, reverse, append, sum, countEq) lowers to for one receiver kind, or, when kind is the \"*\" sentinel, the single-receiver alias lo...")
(:sym "genericAlias" :mod "asl-ir/lower" :sig "genericAlias name: String -> String" :doc "The concrete builtin name a single-receiver generic alias (head, tail, last, take, drop, all?, any?, sort, sortBy, startsWith?, endsWith?, split, join, replace, trim, chars, lines, upper, lower, repeat, countChar, keys, values, pairs, remov...")
(:sym "genericMulti?" :mod "asl-ir/lower" :sig "genericMulti? name: String -> Bool" :doc "True when name is one of the eleven multi-receiver generic op names dispatched by genericConcrete over a receiver kind rather than aliased to one fixed builtin. Delegates to asl-checker/types#genericMulti? (NAMES-FIX).")
(:sym "assignOptionRepr" :mod "asl-ir/lowering" :sig "assignOptionRepr profileId: Str innerType: Str -> Str" :doc "The representation, nullable or tagged, an Option of the inner type takes under the profile.")
(:sym "lowerMatchToSwitch" :mod "asl-ir/lowering" :sig "lowerMatchToSwitch scrutinee: Str cases: (List ty/IrSwitchCase) defaultBody: (List Any) -> ty/IrStmt" :doc "A switch statement over the scrutinee with the given cases and default body.")
(:sym "lowerTailRecursion" :mod "asl-ir/lowering" :sig "lowerTailRecursion f: ty/IrFunction -> ty/IrFunction" :doc "Returns the function unchanged; tail recursion is not rewritten yet.")
(:sym "AstPatchOp" :mod "asl-ir/patch" :kind type :sig "(enum AstPatchOp (:c patchOpReplace [(target Str) (anchor Str) (oldNode Str) (newNode Str)] \"Subtree substitution addressed strictly by module, symbol, and anchor\") (:c patchOpSplice [(target Str) (anchor Str) (index Int64) (deletedNodes (List Str)) (insertNodes (List Str))] \"Child sequence deletion ...")
(:sym "patchOpReplace" :mod "asl-ir/patch" :kind ctor :sig "(:c patchOpReplace [(target Str) (anchor Str) (oldNode Str) (newNode Str)] \"Subtree substitution addressed strictly by module, symbol, and anchor\") of AstPatchOp" :pit (ctor))
(:sym "patchOpSplice" :mod "asl-ir/patch" :kind ctor :sig "(:c patchOpSplice [(target Str) (anchor Str) (index Int64) (deletedNodes (List Str)) (insertNodes (List Str))] \"Child sequence deletion of the named nodes and i ... of AstPatchOp" :pit (ctor))
(:sym "patchOpRename" :mod "asl-ir/patch" :kind ctor :sig "(:c patchOpRename [(target Str) (oldName Str) (newName Str)] \"Identifier renaming across symbol scope\") of AstPatchOp" :pit (ctor))
(:sym "patchOpRetype" :mod "asl-ir/patch" :kind ctor :sig "(:c patchOpRetype [(target Str) (anchor Str) (oldType Str) (newType Str)] \"Type annotation modification for parameter, field, or return type\")) of AstPatchOp" :pit (ctor))
(:sym "AstPatch" :mod "asl-ir/patch" :kind type :sig "(schema AstPatch (:f id Str) (:f targetModule Str) (:f preRoot (Option Str)) (:f postRoot (Option Str)) (:f ops (List AstPatchOp)))" :pit (record))
(:sym "makeAstPatch" :mod "asl-ir/patch" :sig "makeAstPatch id: Str targetModule: Str preRoot: (Option Str) postRoot: (Option Str) ops: (List AstPatchOp) -> AstPatch" :doc "An AstPatch from its id, target module, optional pre and post digests and operations.")
(:sym "PatchDiag" :mod "asl-ir/patch" :kind type :sig "(schema PatchDiag (:f code Str) (:f target Str) (:f anchor Str) (:f message Str))" :pit (record))
(:sym "makePatchDiag" :mod "asl-ir/patch" :sig "makePatchDiag code: Str target: Str anchor: Str message: Str -> PatchDiag" :doc "A PatchDiag from its code, target, anchor and message.")
(:sym "PatchResult" :mod "asl-ir/patch" :kind type :sig "(schema PatchResult (:f success Bool) (:f patchedSource Str) (:f inversePatch (Option AstPatch)) (:f diagnostics (List PatchDiag)))" :pit (record))
(:sym "makePatchResult" :mod "asl-ir/patch" :sig "makePatchResult success: Bool patchedSource: Str inversePatch: (Option AstPatch) diagnostics: (List PatchDiag) -> PatchResult" :doc "A PatchResult from its success flag, patched source, optional inverse and diagnostics.")
(:sym "makePatchOpReplace" :mod "asl-ir/patch" :sig "makePatchOpReplace target: Str anchor: Str oldNode: Str newNode: Str -> AstPatchOp" :doc "A replace operation of oldNode by newNode at the anchor inside the target symbol.")
(:sym "makePatchOpSplice" :mod "asl-ir/patch" :sig "makePatchOpSplice target: Str anchor: Str index: Int64 deletedNodes: (List Str) insertNodes: (List Str) -> AstPatchOp" :doc "A splice operation deleting the deletedNodes found at index in the target body and inserting insertNodes there.")
(:sym "makePatchOpRename" :mod "asl-ir/patch" :sig "makePatchOpRename target: Str oldName: Str newName: Str -> AstPatchOp" :doc "A rename operation of oldName to newName across the target symbol.")
(:sym "makePatchOpRetype" :mod "asl-ir/patch" :sig "makePatchOpRetype target: Str anchor: Str oldType: Str newType: Str -> AstPatchOp" :doc "A retype operation of oldType to newType at the anchor inside the target symbol.")
(:sym "makeReplacePatch" :mod "asl-ir/patch" :sig "makeReplacePatch id: Str targetModule: Str targetSymbol: Str anchor: Str oldNode: Str newNode: Str -> AstPatch" :doc "A patch with one replace operation and no digests.")
(:sym "parsePatch" :mod "asl-ir/patch" :sig "parsePatch patchText: Str -> (Result AstPatch PatchDiag)" :doc "Read an :astPatch form into an AstPatch, or a PatchDiag naming the malformed part." :pit (result))
(:sym "applyPatch" :mod "asl-ir/patch" :sig "applyPatch patch: AstPatch sourceCode: Str -> PatchResult" :doc "Apply the operations in order after checking the pre digest, returning the patched source, its inverse and diagnostics.")
(:sym "invertPatch" :mod "asl-ir/patch" :sig "invertPatch patch: AstPatch -> AstPatch" :doc "The patch that undoes this one: inverted operations in reverse order, digests swapped.")
(:sym "verifyPatch" :mod "asl-ir/patch" :sig "verifyPatch patch: AstPatch sourceCode: Str -> (Result Unit (List PatchDiag))" :doc "Ok when applyPatch succeeds on the source, else its diagnostics." :pit (result))
(:sym "renderPatch" :mod "asl-ir/patch" :sig "renderPatch p: AstPatch -> Str" :doc "Render a patch as an (:astPatch ...) form that parsePatch reads back.")
(:sym "computeAstDigest" :mod "asl-ir/patch" :sig "computeAstDigest src: Str -> Str" :doc "A digest of the source text: its length and a rolling hash of its characters.")
(:sym "printIr" :mod "asl-ir/printer" :sig "printIr m: ty/IrModule -> Str" :doc "Render an IrModule as an (:ir-module ...) form, one function per paragraph.")
(:sym "printFunction" :mod "asl-ir/printer" :sig "printFunction f: ty/IrFunction -> Str" :doc "Render an IrFunction as an (ir/func ...) form with its parameters, return type and statements.")
(:sym "printStmt" :mod "asl-ir/printer" :sig "printStmt s: ty/IrStmt -> Str" :doc "Render one IrStmt as an indented ir/ form.")
(:sym "printExpr" :mod "asl-ir/printer" :sig "printExpr e: ty/IrExpr -> Str" :doc "Render one IrExpr as an ir/ form.")
(:sym "printType" :mod "asl-ir/printer" :sig "printType t: ty/IrType -> Str" :doc "Render an IrType as (ir/type :kind), adding :repr unless it is raw.")
(:sym "printSsa" :mod "asl-ir/printer" :sig "printSsa m: ty/SsaModule -> String" :doc "Render an SsaModule as an (ssa-module ...) form: string pool, types, records, externs, globals, then functions.")
(:sym "printSsaFunction" :mod "asl-ir/printer" :sig "printSsaFunction f: ty/SsaFunction -> (List String)" :doc "Render an SsaFunction as the lines of an (fn ...) form, one block per group of lines.")
(:sym "printSsaOp" :mod "asl-ir/printer" :sig "printSsaOp op: ty/SsaOp -> String" :doc "Render one SsaOp as its parenthesized form.")
(:sym "printSsaTerm" :mod "asl-ir/printer" :sig "printSsaTerm t: ty/SsaTerm -> String" :doc "Render one SsaTerm as its parenthesized form.")
(:sym "quoteString" :mod "asl-ir/printer" :sig "quoteString s: String -> String" :doc "The string in double quotes with backslash, quote, newline, return and tab escaped.")
(:sym "IrType" :mod "asl-ir/types" :kind type :sig "(schema IrType (:f kind Str) (:f repr Str) (:f isSecondClass Bool))" :pit (record))
(:sym "IrParam" :mod "asl-ir/types" :kind type :sig "(schema IrParam (:f name Str) (:f ty IrType))" :pit (record))
(:sym "IrExpr" :mod "asl-ir/types" :kind type :sig "(schema IrExpr (:f kind Str) (:f op Str) (:f left Str) (:f right Str) (:f args (List Str)) (:f ty IrType) (:f wrap Str) (:f shiftMask Bool) (:f divModFloor Bool) (:f codeLabel Str))" :pit (record))
(:sym "IrSwitchCase" :mod "asl-ir/types" :kind type :sig "(schema IrSwitchCase (:f tag Str) (:f bindings (List Str)) (:f body (List Any)))" :pit (record))
(:sym "IrStmt" :mod "asl-ir/types" :kind type :sig "(schema IrStmt (:f kind Str) (:f target Str) (:f field Str) (:f value Str) (:f ty IrType) (:f expr IrExpr) (:f label Str) (:f args (List Str)) (:f scrutinee Str) (:f cases (List IrSwitchCase)) (:f defaultBody (List Any)) (:f loopBody (List Any)))" :pit (record))
(:sym "IrFunction" :mod "asl-ir/types" :kind type :sig "(schema IrFunction (:f name Str) (:f params (List IrParam)) (:f retType IrType) (:f body (List IrStmt)))" :pit (record))
(:sym "IrModule" :mod "asl-ir/types" :kind type :sig "(schema IrModule (:f name Str) (:f profile Str) (:f funcs (List IrFunction)))" :pit (record))
(:sym "IrDiag" :mod "asl-ir/types" :kind type :sig "(schema IrDiag (:f code Str) (:f message Str) (:f locus Str))" :pit (record))
(:sym "makeIrType" :mod "asl-ir/types" :sig "makeIrType kind: Str repr: Str isSecondClass: Bool -> IrType" :doc "An IrType from its kind, representation and second-class flag.")
(:sym "makeIrParam" :mod "asl-ir/types" :sig "makeIrParam name: Str ty: IrType -> IrParam" :doc "An IrParam from its name and type.")
(:sym "makeIrLet" :mod "asl-ir/types" :sig "makeIrLet target: Str ty: IrType expr: IrExpr -> IrStmt" :doc "A let statement binding the target to the expression at the type.")
(:sym "makeIrDrop" :mod "asl-ir/types" :sig "makeIrDrop target: Str ty: IrType -> IrStmt" :doc "A drop statement releasing the target of the type.")
(:sym "makeIrReturn" :mod "asl-ir/types" :sig "makeIrReturn value: Str ty: IrType -> IrStmt" :doc "A return statement of the value at the type.")
(:sym "makeIrSwitch" :mod "asl-ir/types" :sig "makeIrSwitch scrutinee: Str cases: (List IrSwitchCase) defaultBody: (List Any) -> IrStmt" :doc "A switch statement over the scrutinee with the cases and default body.")
(:sym "makeIrFunction" :mod "asl-ir/types" :sig "makeIrFunction name: Str params: (List IrParam) retType: IrType body: (List IrStmt) -> IrFunction" :doc "An IrFunction from its name, parameters, return type and body.")
(:sym "makeIrModule" :mod "asl-ir/types" :sig "makeIrModule name: Str profile: Str funcs: (List IrFunction) -> IrModule" :doc "An IrModule from its name, profile and functions.")
(:sym "makeIrDiag" :mod "asl-ir/types" :sig "makeIrDiag code: Str message: Str locus: Str -> IrDiag" :doc "An IrDiag from its code, message and locus.")
(:sym "verifyAnfStmt" :mod "asl-ir/types" :sig "verifyAnfStmt stmt: IrStmt -> (Option IrDiag)" :doc "The first ANF violation of one statement: an empty let target, return value, drop target or switch scrutinee, or an unknown kind." :pit (option))
(:sym "verifyAnfFunction" :mod "asl-ir/types" :sig "verifyAnfFunction func: IrFunction -> (Option IrDiag)" :doc "The first ANF violation in a function: a missing name or the first failing statement." :pit (option))
(:sym "verifyAnfModule" :mod "asl-ir/types" :sig "verifyAnfModule moduleObj: IrModule -> (Option IrDiag)" :doc "The first ANF violation in a module: a missing name or the first failing function." :pit (option))
(:sym "SsaTy" :mod "asl-ir/types" :kind type :sig "(enum SsaTy (:c tyVal [] \"Uniform host Val, passed by value in the host ABI\") (:c tyRec [(schema String)] \"A Val known to be a record of schema\") (:c tyI64 [] \"Raw 64-bit integer\") (:c tyF64 [] \"Raw 64-bit float\") (:c tyI1 [] \"Raw boolean\") (:c tyPtr [] \"Raw native pointer, for a C ABI extern's stri ...")
(:sym "SsaConst" :mod "asl-ir/types" :kind type :sig "(enum SsaConst (:c constInt [(value Int64)] \"Integer literal, as Val or raw i64\") (:c constFloat [(value Float64)] \"Float literal, as Val or raw f64\") (:c constBool [(value Bool)] \"Boolean literal, as Val or raw i1\") (:c constStr [(index Int64)] \"String literal by index into the module string pool,  ...")
(:sym "SsaOp" :mod "asl-ir/types" :kind type :sig "(enum SsaOp (:c opConst [(value SsaConst)] \"Constant\") (:c opCall [(callee String) (args (List String))] \"Direct call of a module function without captures, typed by its signature, or of an extern, all Val; arity is checked\") (:c opBuiltin [(name String) (args (List String))] \"Call of a host builtin ...")
(:sym "SsaEdge" :mod "asl-ir/types" :kind type :sig "(schema SsaEdge (:f target String) (:f args (List String)))" :pit (record))
(:sym "SsaCase" :mod "asl-ir/types" :kind type :sig "(schema SsaCase (:f variant String) (:f edge SsaEdge))" :pit (record))
(:sym "SsaTerm" :mod "asl-ir/types" :kind type :sig "(enum SsaTerm (:c termReturn [(value String)] \"Return a value of the function's return type\") (:c termJump [(edge SsaEdge)] \"Unconditional jump\") (:c termBranch [(condition String) (thenEdge SsaEdge) (elseEdge SsaEdge)] \"Two-way branch on an i1 or a Val holding a Bool\") (:c termSwitch [(scrutinee St ...")
(:sym "SsaParam" :mod "asl-ir/types" :kind type :sig "(schema SsaParam (:f name String) (:f ty SsaTy))" :pit (record))
(:sym "SsaInstr" :mod "asl-ir/types" :kind type :sig "(schema SsaInstr (:f dest String) (:f ty SsaTy) (:f op SsaOp))" :pit (record))
(:sym "SsaBlock" :mod "asl-ir/types" :kind type :sig "(schema SsaBlock (:f label String) (:f params (List SsaParam)) (:f instrs (List SsaInstr)) (:f term SsaTerm))" :pit (record))
(:sym "SsaFunction" :mod "asl-ir/types" :kind type :sig "(schema SsaFunction (:f name String) (:f captures (List SsaParam)) (:f params (List SsaParam)) (:f retTy SsaTy) (:f blocks (List SsaBlock)))" :pit (record))
(:sym "SsaVariant" :mod "asl-ir/types" :kind type :sig "(schema SsaVariant (:f name String) (:f arity Int64))" :pit (record))
(:sym "SsaTypeDecl" :mod "asl-ir/types" :kind type :sig "(schema SsaTypeDecl (:f name String) (:f variants (List SsaVariant)))" :pit (record))
(:sym "SsaRecordDecl" :mod "asl-ir/types" :kind type :sig "(schema SsaRecordDecl (:f name String) (:f fields (List String)) (:f kinds (List Int64)))" :pit (record))
(:sym "SsaGlobal" :mod "asl-ir/types" :kind type :sig "(schema SsaGlobal (:f name String) (:f init String))" :pit (record))
(:sym "SsaExtern" :mod "asl-ir/types" :kind type :sig "(schema SsaExtern (:f name String) (:f arity Int64) (:f params (List SsaTy)) (:f ret SsaTy) (:f typed Bool) (:f variadic Bool) (:f native Bool))" :pit (record))
(:sym "SsaModule" :mod "asl-ir/types" :kind type :sig "(schema SsaModule (:f name String) (:f strings (List String)) (:f types (List SsaTypeDecl)) (:f records (List SsaRecordDecl)) (:f externs (List SsaExtern)) (:f globals (List SsaGlobal)) (:f functions (List SsaFunction)))" :pit (record))
(:sym "ssaParam" :mod "asl-ir/types" :sig "ssaParam name: String ty: SsaTy -> SsaParam" :doc "An SsaParam from its name and type.")
(:sym "ssaInstr" :mod "asl-ir/types" :sig "ssaInstr dest: String ty: SsaTy op: SsaOp -> SsaInstr" :doc "An SsaInstr assigning the operation's result to dest at the type.")
(:sym "ssaEdge" :mod "asl-ir/types" :sig "ssaEdge target: String args: (List String) -> SsaEdge" :doc "An SsaEdge to the target block passing the arguments to its parameters.")
(:sym "ssaCase" :mod "asl-ir/types" :sig "ssaCase variant: String edge: SsaEdge -> SsaCase" :doc "An SsaCase sending the variant to the edge.")
(:sym "ssaBlock" :mod "asl-ir/types" :sig "ssaBlock label: String params: (List SsaParam) instrs: (List SsaInstr) term: SsaTerm -> SsaBlock" :doc "An SsaBlock from its label, parameters, instructions and terminator.")
(:sym "ssaFunction" :mod "asl-ir/types" :sig "ssaFunction name: String captures: (List SsaParam) params: (List SsaParam) retTy: SsaTy blocks: (List SsaBlock) -> SsaFunction" :doc "An SsaFunction from its name, captures, parameters, return type and blocks, the entry first.")
(:sym "ssaVariant" :mod "asl-ir/types" :sig "ssaVariant name: String arity: Int64 -> SsaVariant" :doc "An SsaVariant from its name and payload field count.")
(:sym "ssaTypeDecl" :mod "asl-ir/types" :sig "ssaTypeDecl name: String variants: (List SsaVariant) -> SsaTypeDecl" :doc "An SsaTypeDecl from its name and variants.")
(:sym "ssaRecordDecl" :mod "asl-ir/types" :sig "ssaRecordDecl name: String fields: (List String) -> SsaRecordDecl" :doc "An SsaRecordDecl from its name and fields in declared order, every field boxed (kind 255).")
(:sym "ssaRecordDeclTyped" :mod "asl-ir/types" :sig "ssaRecordDeclTyped name: String fields: (List String) kinds: (List Int64) -> SsaRecordDecl" :doc "An SsaRecordDecl from its name, fields and per-field kinds in declared order.")
(:sym "ssaRecordRaw?" :mod "asl-ir/types" :sig "ssaRecordRaw? d: SsaRecordDecl -> Bool" :doc "True when any field kind of the decl is not boxed (not 255).")
(:sym "ssaGlobal" :mod "asl-ir/types" :sig "ssaGlobal name: String init: String -> SsaGlobal" :doc "An SsaGlobal from its name and the function that initializes it.")
(:sym "ssaExtern" :mod "asl-ir/types" :sig "ssaExtern name: String arity: Int64 -> SsaExtern" :doc "An untyped SsaExtern from its name and argument count.")
(:sym "ssaExternTyped" :mod "asl-ir/types" :sig "ssaExternTyped name: String params: (List SsaTy) ret: SsaTy -> SsaExtern" :doc "A typed SsaExtern from its name, parameter types and return type.")
(:sym "ssaExternVariadic" :mod "asl-ir/types" :sig "ssaExternVariadic name: String params: (List SsaTy) ret: SsaTy -> SsaExtern" :doc "A typed, variadic C ABI SsaExtern (libc's open, fcntl, ioctl...): params are the fixed arguments before ..., and a call may pass further arguments untyped and unchecked past them, as the real C declaration does.")
(:sym "ssaExternNative" :mod "asl-ir/types" :sig "ssaExternNative name: String params: (List SsaTy) ret: SsaTy -> SsaExtern" :doc "A typed, non-variadic C ABI SsaExtern for a C symbol (ffiRoute's foreign targets and helpers): native is true, so the LLVM target emits a plain ccc declare and call even when every type is i64 or f64.")
(:sym "ssaModule" :mod "asl-ir/types" :sig "ssaModule name: String strings: (List String) types: (List SsaTypeDecl) records: (List SsaRecordDecl) externs: (List SsaExtern) globals: (List SsaGlobal) functions: (List SsaFunction) -> SsaModule" :doc "An SsaModule from its name, string pool, types, records, externs, globals and functions.")
(:sym "ssaTyName" :mod "asl-ir/types" :sig "ssaTyName t: SsaTy -> String" :doc "The printed name of an SsaTy, including a schema-known record Val.")
(:sym "ssaAbiName" :mod "asl-ir/types" :sig "ssaAbiName t: SsaTy -> String" :doc "The name of the register class an SsaTy passes in: val for a record Val, which is a Val in every ABI, else ssaTyName.")
(:sym "ssaIsRec?" :mod "asl-ir/types" :sig "ssaIsRec? t: SsaTy -> Bool" :doc "True for a schema-known record Val.")
(:sym "ssaIsRaw?" :mod "asl-ir/types" :sig "ssaIsRaw? t: SsaTy -> Bool" :doc "True for the unboxed types i64, f64 and i1.")
(:sym "termEdges" :mod "asl-ir/types" :sig "termEdges t: SsaTerm -> (List SsaEdge)" :doc "The outgoing edges of a terminator, switch cases before the default.")
(:sym "opOperands" :mod "asl-ir/types" :sig "opOperands op: SsaOp -> (List String)" :doc "The value names an operation reads, in operand order.")
(:sym "SsaPrim" :mod "asl-ir/types" :kind type :sig "(schema SsaPrim (:f args (List SsaTy)) (:f result SsaTy))" :pit (record))
(:sym "primSignature" :mod "asl-ir/types" :sig "primSignature name: String -> (Option SsaPrim)" :doc "Operand and result types of a raw primitive, none when the name is not one. The raw<Op><Width> family (plan IR-rawPrims) gives native code, never the checked Int/Float path, non-trapping i32/i64 arithmetic, bitwise and native pointer access..." :pit (option))
(:sym "SsaBuiltin" :mod "asl-ir/types" :kind type :sig "(schema SsaBuiltin (:f name String) (:f symbol String) (:f args (List SsaTy)) (:f result SsaTy) (:f kind String))" :pit (record))
(:sym "builtinEntries" :mod "asl-ir/types" :sig "builtinEntries -> (List SsaBuiltin)" :doc "Builtins with a direct runtime entry, operand and result types as letters: v Val, i i64, f f64, b i1. Names starting with @, which source cannot spell, are entries the lowering fuses: @listHeadOr, @listTailOr, @listGetOr and @stringSliceOr ...")
(:sym "builtinEntry" :mod "asl-ir/types" :sig "builtinEntry name: String arity: Int64 -> (Option SsaBuiltin)" :doc "The direct runtime entry of a builtin called with arity operands, none when it has none and goes through asl_rt_builtin by name." :pit (option))
(:sym "verifyIr" :mod "asl-ir/verify" :sig "verifyIr m: ty/IrModule -> (Result Unit (List ty/IrDiag))" :doc "Ok when verifyModule finds nothing, else its diagnostics." :pit (result))
(:sym "verifyStmt" :mod "asl-ir/verify" :sig "verifyStmt s: ty/IrStmt env: (Map Str ty/IrType) -> (List ty/IrDiag)" :doc "Diagnostics for one statement in its scope: a switch without default, a rebound name, a non-ANF operand or a unit stored in a nullable Option.")
(:sym "verifyFunction" :mod "asl-ir/verify" :sig "verifyFunction f: ty/IrFunction -> (List ty/IrDiag)" :doc "Diagnostics for a function: an empty body, a last statement other than return or jump, and every statement's diagnostics.")
(:sym "verifyModule" :mod "asl-ir/verify" :sig "verifyModule m: ty/IrModule -> (List ty/IrDiag)" :doc "Diagnostics of every function in the module, in order.")
(:sym "verifySsa" :mod "asl-ir/verify" :sig "verifySsa m: ty/SsaModule -> (Result Unit (List ty/IrDiag))" :doc "Ok when verifySsaDiags finds nothing, else its diagnostics." :pit (result))
(:sym "verifySsaDiags" :mod "asl-ir/verify" :sig "verifySsaDiags m: ty/SsaModule -> (List ty/IrDiag)" :doc "Every violation of the SSA contract in the module, per function and block.")
(:sym "dominatorSets" :mod "asl-ir/verify" :sig "dominatorSets f: ty/SsaFunction -> (Map String (List String))" :doc "Each block's dominator labels, itself included; an unreachable block maps to every label, the same as the iterative definition.")
