(:sym "linkEntryBare!" :mod "asl-ir/link" :kind fn! :sig "linkEntryBare! entryPath: String -> (Result ty/SsaModule (List ty/IrDiag))" :pit (result effect))
(:sym "lowerSourceWith" :mod "asl-ir/link" :sig "lowerSourceWith src: String preludeSrc: String -> (Result ty/SsaModule (List ty/IrDiag))" :pit (result))
(:sym "lowerSourceLinked!" :mod "asl-ir/link" :kind fn! :sig "lowerSourceLinked! src: String -> (Result ty/SsaModule (List ty/IrDiag))" :pit (result effect))
(:sym "preludePath" :mod "asl-ir/link" :sig "preludePath -> String" :doc "Path of the prelude the host loader falls back to, relative to the repository root.")
