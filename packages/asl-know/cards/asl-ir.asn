(:card "asl-ir" :purpose "AgentSlang Typed Monomorphic ANF Core Intermediate Representation and AST Patch Engine" :import "(asl-ir/main :a x)" :deps (asl-parser asl-checker) :modules ((:m "asl-ir/main" :doc "Top-level API for AgentSlang Core IR lowering, verificat...") (:m "asl-ir/anf") (:m "asl-ir/blocks" :doc "Shared shape for source targets that emit a linked SSA m...") (:m "asl-ir/drops") (:m "asl-ir/link")) :moduleCount 12 :sigs ("lowerModule name: Str profileId: Str funcs: (List ty/IrFunction) -> ty/IrModule" "verifyIr m: ty/IrModule -> (Result Unit (List ty/IrDiag))" "printIr m: ty/IrModule -> Str" "compileToIr modName: Str profileId: Str funcs: (List ty/IrFunction) -> (Result Str (List ty/IrDiag))" "assignOptionRepr profileId: Str innerType: Str -> Str" "parsePatch patchText: Str -> (Result patch/AstPatch patch/PatchDiag)" "applyPatch p: patch/AstPatch sourceCode: Str -> patch/PatchResult" "invertPatch p: patch/AstPatch -> patch/AstPatch") :more (verifyPatch makeReplacePatch toAnf isTerminalAtom? makeFreshVar BlockCtx blockCtx labelIndex paramNames locals tailCall collect exportName mangle quoted) :moreCount 152 :effects (loadClosure! loadClosureWith! loadClosureOver! linkEntryOver! linkEntryWith! linkUnits linkWith! linkEntry!) :fails (verifyIr compileToIr parsePatch verifyPatch collect loadClosure! loadClosureWith! loadClosureOver!) :example none)
(:sym "lowerModule" :mod "asl-ir/main" :sig "lowerModule name: Str profileId: Str funcs: (List ty/IrFunction) -> ty/IrModule" :doc "An IrModule of the functions, each body passed through toAnf and insertDrops.")
(:sym "verifyIr" :mod "asl-ir/main" :sig "verifyIr m: ty/IrModule -> (Result Unit (List ty/IrDiag))" :doc "Verify an IrModule with asl-ir/verify verifyIr." :pit (result))
(:sym "printIr" :mod "asl-ir/main" :sig "printIr m: ty/IrModule -> Str" :doc "Render an IrModule as text with asl-ir/printer printIr.")
(:sym "compileToIr" :mod "asl-ir/main" :sig "compileToIr modName: Str profileId: Str funcs: (List ty/IrFunction) -> (Result Str (List ty/IrDiag))" :pit (result))
(:sym "assignOptionRepr" :mod "asl-ir/main" :sig "assignOptionRepr profileId: Str innerType: Str -> Str")
(:sym "parsePatch" :mod "asl-ir/main" :sig "parsePatch patchText: Str -> (Result patch/AstPatch patch/PatchDiag)" :pit (result))
(:sym "applyPatch" :mod "asl-ir/main" :sig "applyPatch p: patch/AstPatch sourceCode: Str -> patch/PatchResult")
(:sym "invertPatch" :mod "asl-ir/main" :sig "invertPatch p: patch/AstPatch -> patch/AstPatch")
(:sym "verifyPatch" :mod "asl-ir/main" :sig "verifyPatch p: patch/AstPatch sourceCode: Str -> (Result Unit (List patch/PatchDiag))" :pit (result))
(:sym "makeReplacePatch" :mod "asl-ir/main" :sig "makeReplacePatch id: Str targetModule: Str targetSymbol: Str anchor: Str oldNode: Str newNode: Str -> patch/AstPatch")
(:sym "toAnf" :mod "asl-ir/anf" :sig "toAnf stmts: (List ty/IrStmt) -> (List ty/IrStmt)")
(:sym "isTerminalAtom?" :mod "asl-ir/anf" :sig "isTerminalAtom? s: Str -> Bool")
(:sym "makeFreshVar" :mod "asl-ir/anf" :sig "makeFreshVar prefix: Str index: I64 -> Str")
(:sym "BlockCtx" :mod "asl-ir/blocks" :kind type :sig "(schema BlockCtx (:f self String) (:f params (List String)) (:f labels (Map String Int64)) (:f params0 (Map String (List String))) (:f returners (List String)))" :pit (record))
(:sym "blockCtx" :mod "asl-ir/blocks" :sig "blockCtx fn0: ty/SsaFunction -> BlockCtx")
(:sym "labelIndex" :mod "asl-ir/blocks" :sig "labelIndex ctx: BlockCtx label: String -> String" :doc "label's position among ctx's blocks, as a string; -1 when label is unknown.")
(:sym "paramNames" :mod "asl-ir/blocks" :sig "paramNames ps: (List ty/SsaParam) -> (List String)" :doc "The declared names of ps, in order.")
(:sym "locals" :mod "asl-ir/blocks" :sig "locals fn0: ty/SsaFunction -> (List String)" :doc "Every name fn0 binds: each block's own parameters followed by its instructions' destinations, in block order.")
(:sym "tailCall" :mod "asl-ir/blocks" :sig "tailCall ctx: BlockCtx b: ty/SsaBlock -> (Option (List String))" :pit (option))
(:sym "collect" :mod "asl-ir/blocks" :sig "collect results: (List (Result String String)) -> (Result (List String) (List String))" :doc "results with every err laid out in order as a list of messages, or every ok value in order when none failed." :pit (result))
(:sym "exportName" :mod "asl-ir/blocks" :sig "exportName moduleName: String fnName: String -> (Option String)" :doc "fnName with its 'moduleName.' prefix stripped, when it has that prefix and names no further '@' local; none for a name outside the module or a compiler-generated local." :pit (option))
(:sym "mangle" :mod "asl-ir/blocks" :sig "mangle prefix: String escape: String name: String -> String" :doc "prefix followed by name with every non-identifier byte escaped as escape plus its two lowercase hex digits, so a qualified or symbolic ASL name becomes one target-safe identifier.")
(:sym "quoted" :mod "asl-ir/blocks" :sig "quoted s: String -> String" :doc "s as a double-quoted string literal, escaping backslash, quote, newline, carriage return and tab.")
(:sym "insertDrops" :mod "asl-ir/drops" :sig "insertDrops stmts: (List ty/IrStmt) -> (List ty/IrStmt)")
(:sym "requiresDrop?" :mod "asl-ir/drops" :sig "requiresDrop? t: ty/IrType -> Bool")
