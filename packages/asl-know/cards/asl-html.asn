(:sym "curveTo" :mod "asl-html/svg" :kind ctor :sig "(:c curveTo [(x1 Float64) (y1 Float64) (x2 Float64) (y2 Float64) (x Float64) (y Float64)] \"C cubic Bezier\") of PathCmd" :pit (ctor))
