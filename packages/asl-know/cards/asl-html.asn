(:card "asl-html" :purpose "Typed HTML5 and CSS for AgentSlang: one constructor per HTML5 and SVG element, escaping by construction (text, attributes, script and style bodies), styles as data with every at-rule, a Markdown subset to nodes, typed SV..." :import "(asl-html/html :a x)" :deps (asl-parser) :modules ((:m "asl-html/html" :doc "Typed HTML: Node (element, text, fragment, raw-text scri...") (:m "asl-html/asn" :doc "Shared reading helpers for the ASN converters: unquote s...") (:m "asl-html/asnCss" :doc "ASN stylesheets to CSS: one (:css ...) form of (:rule se...") (:m "asl-html/asnHtml" :doc "ASN pages to HTML: elements by HTML5 keyword name, attri...") (:m "asl-html/asnSvg" :doc "ASN drawings to SVG for agents: one (:svg ...) form read...")) :moduleCount 9 :sigs ("(enum Node (:c elemNode [(tag String) (attrs (List Attr)) (kids (List Node))] \"element\") (:c textNode [(s String)] \"text, escaped on render\"..." "(enum Attr (:c attrPair [(k String) (v String)] \"name=value attribute, value escaped on render\") (:c attrFlag [(k String)] \"boolean attribut..." "el tag: String attrs: (List Attr) kids: (List Node) -> Node" "voidEl tag: String attrs: (List Attr) -> Node" "text s: String -> Node" "frag kids: (List Node) -> Node" "attr k: String v: String -> Attr" "flag k: String -> Attr" "cls v: String -> Attr" "classes names: (List String) -> Attr") :more (id href src alt typeAttr nameAttr valueAttr rel target titleAttr lang role aria data style script styleSheet document escapeText escapeAttr render) :moreCount 218 :fails (rulesOf asnToCss pageToNode asnToHtml drawingToNode asnToSvg convertSource) :example none)
(:sym "Node" :mod "asl-html/html" :kind type :sig "(enum Node (:c elemNode [(tag String) (attrs (List Attr)) (kids (List Node))] \"element\") (:c textNode [(s String)] \"text, escaped on render\") (:c fragNode [(kids (List Node))] \"children rendered in sequence with no element around them\") (:c rawTextNode [(tag String) (attrs (List Attr)) (body String) ...")
(:sym "Attr" :mod "asl-html/html" :kind type :sig "(enum Attr (:c attrPair [(k String) (v String)] \"name=value attribute, value escaped on render\") (:c attrFlag [(k String)] \"boolean attribute\"))")
