(:card "core/option" :purpose "Option, Result, Pair builtins, no import" :sigs ("some : T -> (Option T)" "none : () -> (Option T)" "ok : T -> (Result T E)" "err : E -> (Result T E)" "pair : A B -> (Pair A B)" "pairFirst : (Pair A B) -> A" "pairSecond : (Pair A B) -> B" "some? : (Option T) -> Bool" "none? : (Option T) -> Bool" "ok? : (Result T E) -> Bool" "err? : (Result T E) -> Bool" "optionOr : (Option T) T -> T" "resultOr : (Result T E) T -> T" "optionMap : (fn [A] -> B) (Option A) -> (Option B)" "resultMap : (Result A E) (fn [A] -> B) -> (Result B E)" "resultMapErr : (fn [E] -> F) (Result T E) -> (Result T F)" "optionToResult : (Option T) E -> (Result T E)") :more (resultToOption) :fails (ok err optionToResult) :example "(module asl-know/examples/coreOption :x [parsePort selfTest] :i [])\n\nfn parsePort s: String -> (Result Int64 String)\n  (mt (stringToInt64 s)\n    ((none) (err (str \"not a number: \" s)))\n    ((some n) (if (and (> n 0) (< n 65536)) (ok n) (err \"out of range\"))))")
(:sym "some" :sig "some : T -> (Option T)" :doc "A present value (constructor)." :pit (option))
(:sym "none" :sig "none : () -> (Option T)" :doc "An absent value (constructor)." :pit (option))
(:sym "ok" :sig "ok : T -> (Result T E)" :doc "A successful result (constructor)." :pit (result))
(:sym "err" :sig "err : E -> (Result T E)" :doc "A failed result (constructor)." :pit (result))
(:sym "pair" :sig "pair : A B -> (Pair A B)" :doc "Construct a pair, taken apart with (mt p ((pair a b) ...)); a pair has no .-first field.")
(:sym "pairFirst" :sig "pairFirst : (Pair A B) -> A" :doc "First component of a pair.")
(:sym "pairSecond" :sig "pairSecond : (Pair A B) -> B" :doc "Second component of a pair.")
(:sym "some?" :sig "some? : (Option T) -> Bool" :doc "True when a value is present.")
(:sym "none?" :sig "none? : (Option T) -> Bool" :doc "True when no value is present.")
(:sym "ok?" :sig "ok? : (Result T E) -> Bool" :doc "True when the result succeeded.")
(:sym "err?" :sig "err? : (Result T E) -> Bool" :doc "True when the result failed.")
(:sym "optionOr" :sig "optionOr : (Option T) T -> T" :doc "The value, or a fallback when absent.")
(:sym "resultOr" :sig "resultOr : (Result T E) T -> T" :doc "The value, or a fallback on failure.")
(:sym "optionMap" :sig "optionMap : (fn [A] -> B) (Option A) -> (Option B)" :doc "Transform a present value.")
(:sym "resultMap" :sig "resultMap : (Result A E) (fn [A] -> B) -> (Result B E)" :doc "Transform a successful value. The Result comes first, unlike optionMap and resultMapErr.")
(:sym "resultMapErr" :sig "resultMapErr : (fn [E] -> F) (Result T E) -> (Result T F)" :doc "Transform a failure value.")
(:sym "optionToResult" :sig "optionToResult : (Option T) E -> (Result T E)" :doc "Absent becomes the given failure." :pit (result))
(:sym "resultToOption" :sig "resultToOption : (Result T E) -> (Option T)" :doc "Failure becomes absence." :pit (option))
