(:sym "cacheText" :mod "asl-gates/vcsDirectAudit" :sig "cacheText used: (Map String String) -> String" :doc "used: the cache file text: one row per key in sorted order, key TAB row, each ending with the row end mark, joined by newlines")
(:sym "rowEnd" :mod "asl-gates/vcsDirectAudit" :sig "rowEnd -> String" :doc "the end mark of a cache row: TAB and dot")
(:sym "storeRootFrom" :mod "asl-gates/vcsDirectAudit" :sig "storeRootFrom home: (Option String) -> (Result String String)" :doc "home: Ok of home/.asl/run/vcsDirect, Err ERR_VCS_STORE_NO_HOME when home is none or blank" :pit (result))
(:sym "cacheDirWith!" :mod "asl-gates/vcsDirectAudit" :kind fn! :sig "cacheDirWith! root: String mode: String home: (Option String) -> Result String String" :doc "root mode home: the scan cache directory: empty for mode off, mode itself when non-empty, else the runner store under home keyed by the first 16 hex of the sha256 of the real git common dir; Err when home is unusable or the git common dir c..." :pit (effect))
(:sym "rowMac" :mod "asl-gates/vcsDirectAudit" :sig "rowMac secret: String key: String body: String -> String" :doc "secret key body: the keyed digest of a cache row, sha256 of secret and the sha256 of secret key and body")
(:sym "signRows" :mod "asl-gates/vcsDirectAudit" :sig "signRows secret: String rows: (Map String String) -> (Map String String)" :doc "secret rows: the rows with a TAB and rowMac digest appended to each body")
(:sym "verifiedRows" :mod "asl-gates/vcsDirectAudit" :sig "verifiedRows secret: String rows: (Map String String) -> (Map String String)" :doc "secret rows: the rows whose last TAB field equals rowMac of the rest, with the digest removed; rows with fewer than 3 fields or a wrong digest are dropped")
(:sym "keyFile" :mod "asl-gates/vcsDirectAudit" :sig "keyFile -> String" :doc "the file name of the store secret: vcsDirectAudit.key")
(:sym "writeAtomic!" :mod "asl-gates/vcsDirectAudit" :kind fn! :sig "writeAtomic! path: String text: String -> String" :doc "path text: writes text to a temp file path.tmpPID and renames it over path; the empty string on success, else the error text with the temp file removed" :pit (effect))
(:sym "cacheCap" :mod "asl-gates/vcsDirectAudit" :sig "cacheCap -> Int64" :doc "the row count, 20000, past which a cache store keeps only the rows this run used")
(:sym "mergeUsed" :mod "asl-gates/vcsDirectAudit" :sig "mergeUsed a: (Map String String) b: (Map String String) -> (Map String String)" :doc "a b: the map a with every key of b set to its value in b")
(:sym "scanFilesC" :mod "asl-gates/vcsDirectAudit" :sig "scanFilesC old: (Map String String) files: (List (Pair String String)) -> (Pair (List Site) (Map String String))" :doc "old files: the sites of a tree and the cache rows used, scanned through the cache map old, with the same sites as scanFiles")
(:sym "parseCache" :mod "asl-gates/vcsDirectAudit" :sig "parseCache text: String -> (Map String String)" :doc "text: the cache rows as a map from key to the row text after the key; only lines ending with TAB and dot and holding a key count, others are dropped")
(:sym "scanCached!" :mod "asl-gates/vcsDirectAudit" :kind fn! :sig "scanCached! dir: String files: (List (Pair String String)) -> (Pair (List Site) String)" :doc "dir files: the sites of the files and a note, scanned through the signed cache of dir, empty dir means no cache; the note is empty or why the cache could not be written, which happens only when a row was a miss" :pit (effect))
(:sym "auditWith!" :mod "asl-gates/vcsDirectAudit" :kind fn! :sig "auditWith! root: String allowPath: String base: String cache: String -> (Result String String)" :doc "root allowPath base cache: the audit receipt for the tree (violation or ok, with the base, grown rows and cache note) plus the run time :ms; cache is empty for the runner store, off for no cache, or a directory; Err when a tracked path sits..." :pit (result effect))
(:sym "cacheDirFor!" :mod "asl-gates/vcsDirectAudit" :kind fn! :sig "cacheDirFor! root: String mode: String -> Result String String" :doc "root mode: cacheDirWith! using the HOME environment value" :pit (effect))
(:sym "storeRoot" :mod "asl-gates/vcsDirectAudit" :kind fn! :sig "storeRoot -> (Result String String)" :doc "the runner cache store root from the HOME environment value, Err when HOME is unset or blank" :pit (result effect))
(:sym "viewKey" :mod "asl-gates/vcsDirectAudit" :sig "viewKey sha: String hd: String h: Helpers file: String -> String" :doc "sha hd h file: the cache key of one file: its content sha, the helper names digest hd, verbsTag, x or n for excluded, and the sorted helper names defined in that file")
(:sym "verbsTag" :mod "asl-gates/vcsDirectAudit" :sig "verbsTag -> String" :doc "the verbsTagOf value for the vcs verbs and worktree verbs")
(:sym "verbsTagOf" :mod "asl-gates/vcsDirectAudit" :sig "verbsTagOf verbs: (List String) wverbs: (List String) -> String" :doc "verbs wverbs: the first 12 hex of the sha256 of the verbs and the worktree-prefixed wverbs joined by blanks, part of every cache key")
(:sym "vcsVerbs" :mod "asl-gates/vcsDirectAudit" :sig "vcsVerbs -> (List String)" :doc "the git verbs the audit covers: commit add update-ref commit-tree push reset checkout restore apply clean stash rm")
(:sym "worktreeVerbs" :mod "asl-gates/vcsDirectAudit" :sig "worktreeVerbs -> (List String)" :doc "the worktree subcommands the audit covers: add remove prune move")
(:sym "headerVerbs" :mod "asl-gates/vcsDirectAudit" :sig "headerVerbs text: String -> (List String)" :doc "text: the verb set of a base allowlist: its declared :verbs, else the legacy verbs")
(:sym "verbsDrift" :mod "asl-gates/vcsDirectAudit" :sig "verbsDrift text: String -> (List String)" :doc "text: how the allowlist header differs from the covered verbs: header:absent when it declares none, missing:V for a covered verb it drops, extra:V for one it adds")
(:sym "coveredVerbs" :mod "asl-gates/vcsDirectAudit" :sig "coveredVerbs -> (List String)" :doc "the verbs the scanner covers: the vcs verbs plus worktree")
(:sym "declaredVerbs" :mod "asl-gates/vcsDirectAudit" :sig "declaredVerbs text: String -> (Option (List String))" :doc "text: some list of the verbs named by the :verbs value on the first line of an allowlist text, none when it declares none" :pit (option))
(:sym "namesDigest" :mod "asl-gates/vcsDirectAudit" :sig "namesDigest h: Helpers -> String" :doc "h: the sha256 hex of the sorted helper names joined by blanks")
(:sym "cap" :mod "asl-gates/vcsDirectAudit" :sig "cap args: (List String) -> String" :doc "args: the cache mode of the command line: off for --no-cache, else the value after --cache-dir, else empty")
(:sym "Site" :mod "asl-gates/vcsDirectAudit" :kind type :sig "(schema Site (:f file String) (:f symbol String) (:f verb String))" :doc "schema of a direct git site: file, symbol, verb" :pit (record))
(:sym "Verdict" :mod "asl-gates/vcsDirectAudit" :kind type :sig "(schema Verdict (:f found (List Site)) (:f newSites (List String)) (:f stale (List String)))" :doc "schema of an audit verdict: found (Site list), newSites and stale (key lists)" :pit (record))
(:sym "Helpers" :mod "asl-gates/vcsDirectAudit" :kind type :sig "(schema Helpers (:f local (List String)) (:f names (List String)))" :doc "schema of the git helper set: local (helper keys file|symbol), names (their unique bare names)" :pit (record))
(:sym "scanSource" :mod "asl-gates/vcsDirectAudit" :sig "scanSource file: String source: String -> (List Site)" :doc "file source: the sites of one source text in source order, empty under asl/tools/vcs")
(:sym "scanFiles" :mod "asl-gates/vcsDirectAudit" :sig "scanFiles files: (List (Pair String String)) -> (List Site)" :doc "files: the sites of a tree of path and text pairs, scanned with its helper set")
(:sym "helpersOf" :mod "asl-gates/vcsDirectAudit" :sig "helpersOf files: (List (Pair String String)) -> Helpers" :doc "files: the Helpers of a tree by data: files outside the vcs layer that contain git are tokenized and rescanned until no fn joins the set, at most 8 rounds")
(:sym "verdictOf" :mod "asl-gates/vcsDirectAudit" :sig "verdictOf sites: (List Site) allow: (List String) -> Verdict" :doc "sites allow: the Verdict of the sites against the allowlist keys: newSites are keys beyond the allowlist, stale are allowlist keys beyond the sites, counted by occurrence")
(:sym "allowKeys" :mod "asl-gates/vcsDirectAudit" :sig "allowKeys text: String -> (List String)" :doc "text: the site keys of an allowlist text, same as parseAllow")
(:sym "parseAllow" :mod "asl-gates/vcsDirectAudit" :sig "parseAllow text: String -> (List String)" :doc "text: the site keys of an allowlist text: each (:site S ... :argv A [:n N]) row gives S|A repeated N times (default 1)")
(:sym "siteKey" :mod "asl-gates/vcsDirectAudit" :sig "siteKey s: Site -> String" :doc "s: the key of a site: file#symbol|git verb")
(:sym "receiptOf" :mod "asl-gates/vcsDirectAudit" :sig "receiptOf v: Verdict allowed: Int64 -> String" :doc "v allowed: the receipt of a verdict with the allowed count, no grown rows and no extra fields")
(:sym "receiptWith" :mod "asl-gates/vcsDirectAudit" :sig "receiptWith v: Verdict allowed: Int64 grown: (List String) extra: String -> String" :doc "v allowed grown extra: the (:vcsDirectAudit :v 1 ...) receipt: :status :ok when there are no new, stale or grown entries, else :violation, with :sites, :allowed, :new, :stale and the extra text")
(:sym "grownOf" :mod "asl-gates/vcsDirectAudit" :sig "grownOf allow: (List String) baseAllow: (List String) baseVerbs: (List String) -> (Pair (List String) (List String))" :doc "allow baseAllow baseVerbs: the allowlist keys beyond their base count whose verb the base covered, as a pair of product keys and keys under a tests directory")
(:sym "audit!" :mod "asl-gates/vcsDirectAudit" :kind fn! :sig "audit! root: String allowPath: String -> (Result String String)" :doc "root allowPath: auditAt! with the default base; Ok receipt text or Err" :pit (result effect))
(:sym "auditAt!" :mod "asl-gates/vcsDirectAudit" :kind fn! :sig "auditAt! root: String allowPath: String base: String -> (Result String String)" :doc "root allowPath base: auditWith! using the runner store cache; Ok receipt text or Err" :pit (result effect))
(:sym "trackedAsl!" :mod "asl-gates/vcsDirectAudit" :kind fn! :sig "trackedAsl! root: String -> (Result (List String) String)" :doc "root: the tracked .asl paths of root from git ls-files, Err when the listing fails" :pit (result effect))
(:sym "emitRows" :mod "asl-gates/vcsDirectAudit" :sig "emitRows sites: (List Site) why: String -> String" :doc "sites why: allowlist (:site ...) rows, one per distinct site key with :n when it occurs more than once and :why set to why, joined by newlines")
(:sym "vcsVerbs" :mod "asl-gates/vcsDirectAudit" :sig "vcsVerbs -> (List String)" :doc "the git verbs the audit covers: commit add update-ref commit-tree push reset checkout restore apply clean stash rm")
(:sym "excluded?" :mod "asl-gates/vcsDirectAudit" :sig "excluded? path: String -> Bool" :doc "path: true when the path is under asl/tools/vcs/, which the audit never scans")
(:sym "decodeString" :mod "asl-gates/vcsDirectAudit" :sig "decodeString raw: String -> String" :doc "raw: the text of a string token: outer quotes dropped and the escapes n t r and backslash decoded")
(:sym "segmentsOf" :mod "asl-gates/vcsDirectAudit" :sig "segmentsOf text: String -> (List (List String))" :doc "text: the command segments of a shell text, split at && || ; & newlines, $( and backquotes and a pipe with a blank on either side, each as its words after leading shell keywords")
(:sym "verbState" :mod "asl-gates/vcsDirectAudit" :sig "verbState items: (List String) skipPh: Bool -> String" :doc "items skipPh: what the words after git name: v:VERB for a covered verb, word for any other verb, param when the verb comes from a value, none when nothing follows; values of valued global options are skipped")
