(:sym "suiteJobFor!" :mod "asl-gates/suiteRunner" :kind fn! :sig "suiteJobFor! snap: String suite: String baseS: Int64 skip: (Option String) -> Job" :doc "snap suite baseS skip: the Job that runs a suite: a no-op sh exit 0 with a 10 s timeout when skip is some, the script itself for a .sh suite, else the native runner test argv; the timeout is the slow-suite value or baseS in ms" :pit (effect))
(:sym "toResult!" :mod "asl-gates/suiteRunner" :kind fn! :sig "toResult! snap: String real: String suite: String d: Done skip: (Option String) -> SuiteResult" :doc "snap real suite d skip: the SuiteResult of a finished job: a SKIPPED result carrying the skip reason when skip is some, shellResult for a .sh suite, else aslResult! on the snapshot-stripped output" :pit (effect))
