(:sym "suiteGateChecks!" :mod "asl-gates/auditGates" :sig "suiteGateChecks! id: String results: (List sr/SuiteResult) ledger: (List rl/LedgerEntry) root: String -> (List Check)" :doc "id results ledger root: the gate checks of a suite run: one per ledger reconcile failure; fails ERR_NO_SUITES when results are empty, ERR_ALL_SKIPPED when every suite skipped, else one pass check counting the results" :pit (effect))
(:sym "vcsDirectCheck!" :mod "asl-gates/auditGates" :sig "vcsDirectCheck! root: String noCache: Bool -> Check" :doc "root noCache: the vcsDirect check, run with mode off when noCache is true and the runner store otherwise" :pit (effect))
(:sym "vcsDirectCheckIn!" :mod "asl-gates/auditGates" :sig "vcsDirectCheckIn! root: String mode: String -> Check" :doc "root mode: the vcsDirect check: allowlist absent goes to allowAbsentCheck!; else runs the audit with mode (empty runner store, off no cache, else a cache dir) and passes on a receipt with :status :ok, fails ERR_VCS_DIRECT on a violation rec..." :pit (effect))
(:sym "cacheMode" :mod "asl-gates/auditGates" :sig "cacheMode argv: (List String) -> String" :doc "argv: the cache mode of the command line: off for --no-cache, else the value after --cache-dir, else empty (the runner store)")
(:sym "vcsErrCode" :mod "asl-gates/auditGates" :sig "vcsErrCode e: String -> String" :doc "e: the ERR_VCS_NO_MAIN or ERR_VCS_CACHE_TRACKED code the error text contains, else ERR_VCS_DIRECT_AUDIT")
(:sym "allowAbsentCheck!" :mod "asl-gates/auditGates" :sig "allowAbsentCheck! root: String -> Check" :doc "root: the vcsDirect check for a tree whose .asl/mem/vcsDirectAllow.asn is absent: fails ERR_VCS_NO_MAIN when there is no merge base with main, fails ERR_VCS_ALLOW_DELETED when the file exists at HEAD or at the merge base, else a skipped che..." :pit (effect))
