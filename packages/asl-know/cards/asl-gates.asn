(:sym "collectDirectoryFiles" :mod "asl-gates/gates" :kind fn! :sig "collectDirectoryFiles dir: Str -> (Result (List Str) Str)" :doc "find exits non-zero when a root is missing or a subdirectory is unreadable, and its partial listing then hides files; that exit is an error naming the directory and find's stderr, never an empty or partial list" :pit (result effect))
