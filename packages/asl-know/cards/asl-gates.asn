(:card "asl-gates" :purpose "Pure AgentSlang Verification Gate Runners & Continuous Audit Engine" :import "(asl-gates/gates :a x)" :deps (asl-parser asl-checker asl-compiler asl-text asl-syntax) :modules ((:m "asl-gates/gates" :doc "Pure AgentSlang verification gate runners and continuous...") (:m "asl-gates/annotationLint" :doc "Enforces 2-token ceiling on memory ref annotations under...") (:m "asl-gates/auditForeign" :doc "Port of scripts/audit/audit.py foreign: allowlist presen...") (:m "asl-gates/auditGates" :doc "Port of scripts/audit/audit.py gates, closure, steps, ch...") (:m "asl-gates/auditLanded" :doc "audit landed: the main commits since a checkpoint that a...")) :moduleCount 26 :sigs ("verifySourceSyntax src: Str -> Bool" "verifyFileSemantic path: Str -> (Result Unit Str)" "verifyForeignExt ext: Str -> Bool" "verifyBalance src: Str -> Bool" "verifyManifestString content: Str -> Bool" "verifyManifests manifestPaths: (List Str) -> (Result I64 (List Str))" "collectDirectoryFiles dir: Str -> (Result (List Str) Str)" "findForeignFilesInPaths paths: (List Str) -> (List Str)" "allowlistedPaths allowlistPath: Str -> (Result (List Str) Str)" "isForeignFile? p: Str -> (Result Bool Str)" "auditPackageTreeZeroForeignAt roots: (List Str) allowlistPath: Str -> (Result I64 (List Str))") :more (auditPackageTreeZeroForeign runSuite AnnotationLintResult countKebabSegments isRefAnnotation extractAnnotationBody auditSingleAnnotation auditRefAnnotations) :moreCount 397 :effects (verifyFileSemantic verifyManifests collectDirectoryFiles allowlistedPaths isForeignFile? auditPackageTreeZeroForeignAt auditPackageTreeZeroForeign runSuite) :fails (verifyFileSemantic verifyManifests collectDirectoryFiles allowlistedPaths isForeignFile? auditPackageTreeZeroForeignAt auditPackageTreeZeroForeign runSuite) :example none)
(:sym "verifySourceSyntax" :mod "asl-gates/gates" :sig "verifySourceSyntax src: Str -> Bool")
(:sym "verifyFileSemantic" :mod "asl-gates/gates" :kind fn! :sig "verifyFileSemantic path: Str -> (Result Unit Str)" :pit (result effect))
(:sym "verifyForeignExt" :mod "asl-gates/gates" :sig "verifyForeignExt ext: Str -> Bool")
(:sym "verifyBalance" :mod "asl-gates/gates" :sig "verifyBalance src: Str -> Bool")
(:sym "verifyManifestString" :mod "asl-gates/gates" :sig "verifyManifestString content: Str -> Bool")
(:sym "verifyManifests" :mod "asl-gates/gates" :kind fn! :sig "verifyManifests manifestPaths: (List Str) -> (Result I64 (List Str))" :doc "a manifest that cannot be read is a named failure, not a false indistinguishable from an invalid id" :pit (result effect))
(:sym "collectDirectoryFiles" :mod "asl-gates/gates" :kind fn! :sig "collectDirectoryFiles dir: Str -> (Result (List Str) Str)" :doc "find exits non-zero when a root is missing or a subdirectory is unreadable, and its partial listing then hides files; that exit is an error naming the directory and find's stderr, never an empty or partial list" :pit (result effect))
(:sym "findForeignFilesInPaths" :mod "asl-gates/gates" :sig "findForeignFilesInPaths paths: (List Str) -> (List Str)")
(:sym "allowlistedPaths" :mod "asl-gates/gates" :kind fn! :sig "allowlistedPaths allowlistPath: Str -> (Result (List Str) Str)" :doc "foreign means audit.py's langFromHead: binary magic, then #! interpreter, then a recognized foreign-language extension; .sample, .txt, .json, .gz etc are data fixtures, not foreign code, and are never flagged; an exact tracked path that is ..." :pit (result effect))
(:sym "isForeignFile?" :mod "asl-gates/gates" :kind fn! :sig "isForeignFile? p: Str -> (Result Bool Str)" :doc "Whether a path is a foreign-language source file by its detected language; an error when the file cannot be read." :pit (result effect))
