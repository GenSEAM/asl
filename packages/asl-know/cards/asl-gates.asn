(:sym "renderTimes" :mod "asl-gates/suiteTimes" :sig "renderTimes times: (Map String Int64) -> String")
(:sym "readTimes!" :mod "asl-gates/suiteTimes" :kind fn! :sig "readTimes! path: String -> (Result (Map String Int64) String)" :pit (result effect))
(:sym "writeTimes!" :mod "asl-gates/suiteTimes" :kind fn! :sig "writeTimes! path: String rows: (List SuiteTime) -> (Result Unit String)" :doc "tmp then rename: readers never see half" :pit (result effect))
(:sym "writeTimesIn!" :mod "asl-gates/suiteTimes" :kind fn! :sig "writeTimesIn! path: String rows: (List SuiteTime) root: String -> (Result Unit String)" :doc "writeTimes! that drops rows whose suite file is gone under root" :pit (result effect))
(:sym "mergeTimes" :mod "asl-gates/suiteTimes" :sig "mergeTimes old: (Map String Int64) rows: (List SuiteTime) -> (Map String Int64)")
(:sym "startOrder" :mod "asl-gates/suiteTimes" :sig "startOrder suites: (List String) times: (Map String Int64) -> (List Int64)" :doc "job indices in start order")
(:sym "VacuityConfig" :mod "asl-gates/vacuity" :kind type :sig "(schema VacuityConfig (:f baseRef String) (:f failOnVacuous Bool) (:f testCmd String))" :pit (record))
(:sym "VacuityTally" :mod "asl-gates/vacuity" :kind type :sig "(schema VacuityTally (:f vacuous (List String)) (:f realGreen Int64) (:f stillRed Int64) (:f baseOnly Int64))" :pit (record))
(:sym "parseArgv" :mod "asl-gates/vacuity" :sig "parseArgv args: (List String) -> (Result VacuityConfig String)" :pit (result))
(:sym "parseAssertions" :mod "asl-gates/vacuity" :sig "parseAssertions stdout: String stderr: String -> (Result (Map String Bool) String)" :pit (result))
(:sym "classify" :mod "asl-gates/vacuity" :sig "classify base: (Map String Bool) work: (Map String Bool) -> VacuityTally")
(:sym "escapeStr" :mod "asl-gates/vacuity" :sig "escapeStr s: String -> String")
(:sym "isTapPlan" :mod "asl-gates/vacuity" :sig "isTapPlan line: String -> Bool")
(:sym "isTapVersion" :mod "asl-gates/vacuity" :sig "isTapVersion line: String -> Bool")
(:sym "isAllDigits" :mod "asl-gates/vacuity" :sig "isAllDigits s: String -> Bool")
(:sym "statusRecords" :mod "asl-gates/vacuity" :sig "statusRecords text: String -> (List String)" :doc "-z names stay unquoted; renames add origins")
(:sym "copyFilesLoop!" :mod "asl-gates/vacuity" :sig "copyFilesLoop! repoRoot: String wtDir: String lines: (List String) -> Unit" :pit (effect))
(:sym "copyUncommittedTestFiles!" :mod "asl-gates/vacuity" :sig "copyUncommittedTestFiles! repoRoot: String wtDir: String testCmd: String -> Unit" :pit (effect))
(:sym "copyFileTo!" :mod "asl-gates/vacuity" :sig "copyFileTo! src: String dst: String -> Bool" :pit (effect))
(:sym "runAt!" :mod "asl-gates/vacuity" :kind fn! :sig "runAt! argv: (List String) cwd: (Option String) -> VacuityProcessOutput" :pit (effect))
(:sym "VacuityProcessOutput" :mod "asl-gates/vacuity" :kind type :sig "(schema VacuityProcessOutput (:f exitCode Int64) (:f stdout String) (:f stderr String))" :pit (record))
