(:card "asl-gates" :purpose "Pure AgentSlang Verification Gate Runners & Continuous Audit Engine" :import "(asl-gates/gates :a x)" :deps (asl-parser asl-checker asl-compiler asl-text asl-syntax) :modules ((:m "asl-gates/gates") (:m "asl-gates/annotationLint") (:m "asl-gates/auditDeps") (:m "asl-gates/auditForeign" :doc "Port of scripts/audit/audit.py foreign: allowlist presen...") (:m "asl-gates/auditGates")) :moduleCount 29 :sigs ("verifySourceSyntax src: Str -> Bool" "verifyFileSemantic path: Str -> (Result Unit Str)" "verifyForeignExt ext: Str -> Bool" "verifyBalance src: Str -> Bool" "verifyManifestString content: Str -> Bool" "verifyManifests manifestPaths: (List Str) -> (Result I64 (List Str))" "collectDirectoryFiles dir: Str -> (Result (List Str) Str)" "findForeignFilesInPaths paths: (List Str) -> (List Str)" "allowlistedPaths allowlistPath: Str -> (Result (List Str) Str)" "isForeignFile? p: Str -> (Result Bool Str)" "auditPackageTreeZeroForeignAt roots: (List Str) allowlistPath: Str -> (Result I64 (List Str))") :more (auditPackageTreeZeroForeign runSuite AnnotationLintResult countKebabSegments isRefAnnotation extractAnnotationBody auditSingleAnnotation auditRefAnnotations) :moreCount 442 :effects (verifyFileSemantic verifyManifests collectDirectoryFiles allowlistedPaths isForeignFile? auditPackageTreeZeroForeignAt auditPackageTreeZeroForeign runSuite) :fails (verifyFileSemantic verifyManifests collectDirectoryFiles allowlistedPaths isForeignFile? auditPackageTreeZeroForeignAt auditPackageTreeZeroForeign runSuite) :example none)
