(:sym "settle" :mod "aslGateway/dispatch" :sig "settle w: Wiring slotId: String provider: String tokens: Int64 latencyMs: Int64 success: Bool nowMs: Int64 -> (Pair Wiring String)" :doc "fleet telemetry for configured endpoints, then a budget charge priced by the endpoint; the returned text is the charge row")
(:sym "carrySpend" :mod "aslGateway/dispatch" :sig "carrySpend old: Wiring next: Wiring -> Wiring" :doc "a config reload rebuilds the ledger from the new lines; spend already booked on a line id that survives the reload carries over, so editing the config never refills a cap")
(:sym "sendTimeout" :mod "aslGateway/dispatch" :sig "sendTimeout w: Wiring hint: RouteHint provider: String timeoutSec: Float64 -> Float64" :doc "a routed endpoint runs under its own row's timeout; the chat's timeout belongs to the chat's own endpoint")
(:sym "usageTokens" :mod "aslGateway/dispatch" :sig "usageTokens body: String -> Int64")
(:sym "decisionText" :mod "aslGateway/dispatch" :sig "decisionText row: DecisionRow -> String")
(:sym "retarget" :mod "aslGateway/dispatch" :sig "retarget w: Wiring s: Slot hint: RouteHint request: u/UpstreamRequest env: (Map String String) -> (Result u/UpstreamRequest String)" :doc "send: the chat-built request goes unchanged to its own endpoint; a routed endpoint gets its row's URL and key and the candidate model" :pit (result))
(:sym "startSlot!" :mod "aslGateway/dispatch" :kind fn! :sig "startSlot! w: Wiring slotId: String nowMs: Int64 deadlineMs: Int64 -> StartOutcome" :doc "the first request to a cold serverless endpoint starts it through the plugin's spend-gated start; an allowed start is charged its expected cost and the endpoint goes warming" :pit (effect))
