(:sym "applyPatchText" :mod "aslGateway/modelSync" :sig "applyPatchText cfg: String patch: String -> (Result (Pair String String) String)" :doc "pure step of models apply: splices a sync patch's :add model rows and :appendTail aliases into the config text, skipping rows and aliases already present; err when the patch names a missing profile, route or list; :leave rows are counted, n..." :pit (result))
(:sym "applySubPace" :mod "aslGateway/modelSync" :sig "applySubPace cfg: String patch: String -> (Result (Pair String (List String)) String)" :doc "applies a SUB-PACE patch (:spreads, :rpm, :models, :drops, :decisions; :budgets and :changes informational) to config text: replaces route spreads, sets model-row :rpm and fields, removes dropped aliases from every chain and spread, then th..." :pit (result))
(:sym "patchHost" :mod "aslGateway/modelSync" :sig "patchHost patch: String -> String" :doc "the :host (mac or vps) a SUB-PACE patch is written for; models apply refuses a patch whose host is not this machine's")
(:sym "modelsApplyCli!" :mod "aslGateway/modelSync" :kind fn! :sig "modelsApplyCli! args: (List String) -> (Result Int64 String)" :doc "asl gateway models apply PATCH [--config PATH]: writes the patched config to a tmp file beside it, runs configCheck on the tmp text, then backs the config up as config.bak-DATE-MS and renames the tmp over it; any configCheck error or misfit..." :pit (result effect))
