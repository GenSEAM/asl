(:sym "keyFileLookup!" :mod "aslGateway/config" :kind fn! :sig "keyFileLookup! paths: (List String) keyEnv: String -> (Option String)" :doc "listed files searched in order, first match wins; a missing, unreadable or name-less file is silently skipped, never an error" :pit (option effect))
