(:sym "CallRow" :mod "aslGateway/usageLedger" :kind type :sig "(schema CallRow (:f atMs Int64) (:f profile String) (:f intent String) (:f alias String) (:f provider String) (:f model String) (:f inTokens Int64) (:f cachedTokens Int64) (:f outTokens Int64) (:f reasoningTokens Int64) (:f ttftMs (Option Int64)) (:f ms (Option Int64)) (:f outcome String) (:f charge ..." :doc "at/profile/intent/alias/provider/model, in/cached/out tokens, ttftMs/ms latency, outcome, charge, an optional caller tag for joining a run's outcome to its calls (e.g. Leon's session id), and the effective request parameters actually sent: ..." :pit (record))
(:sym "CallParams" :mod "aslGateway/usageLedger" :kind type :sig "(schema CallParams (:f temperature (Option Float64)) (:f topP (Option Float64)) (:f maxTokens (Option Int64)) (:f effort (Option String)) (:f api String) (:f stream Bool) (:f toolCount Int64) (:f promptBytes Int64) (:f sysHash String))" :doc "the request parameters read back out of the outgoing request body after profile/model defaults are applied, not guessed from config; a parameter the provider ignored (e.g. top_p, stream: neither is ever actually sent today) is still recorde..." :pit (record))
(:sym "defaultCallParams" :mod "aslGateway/usageLedger" :sig "defaultCallParams -> CallParams" :doc "the fallback CallParams when the outgoing body never parsed as JSON, or no PendingCall exists at effUsageNote time (e.g. a breaker-skip path that never reached settled!)")
(:sym "Stat" :mod "aslGateway/usageLedger" :kind type :sig "(schema Stat (:f key String) (:f calls Int64) (:f ok Int64) (:f inTokens Int64) (:f cachedTokens Int64) (:f outTokens Int64) (:f reasoningTokens Int64) (:f meanMs (Option Float64)) (:f p50Ms (Option Int64)) (:f p90Ms (Option Int64)) (:f outputTps (Option Float64)) (:f tpsBasis String) (:f charge Int ..." :doc "one keyFor group's aggregate: call and ok counts, token totals, mean/p50/p90 latency (none when no row carried a latency), output tokens-per-second and the basis it was computed from, and total charge" :pit (record))
(:sym "maxLedgerBytes" :mod "aslGateway/usageLedger" :sig "maxLedgerBytes -> Int64" :doc "10485760 (10MB); the ledger rotates to a .1 predecessor once it reaches this size")
(:sym "defaultLedgerPath" :mod "aslGateway/usageLedger" :sig "defaultLedgerPath home: String -> String" :doc "home/.asl/run/gatewayCalls.asn, unless overridden by gatewayLedgerPathOverride")
(:sym "legacyLedgerPath" :mod "aslGateway/usageLedger" :sig "legacyLedgerPath home: String -> String" :doc "the old per-home stats ledger path, folded into the shared ledger once by subs ledgerMerge")
(:sym "defaultSharedUsagePath" :mod "aslGateway/usageLedger" :sig "defaultSharedUsagePath home: String -> String")
(:sym "callRowLine" :mod "aslGateway/usageLedger" :sig "callRowLine row: CallRow -> String" :doc "one CallRow serialized as a single ASN line, every field present so callRowParse can round-trip it without defaulting")
(:sym "callRowParse" :mod "aslGateway/usageLedger" :sig "callRowParse line: String -> (Result CallRow String)" :doc "the inverse of callRowLine; rejects a line missing any one field rather than defaulting it" :pit (result))
(:sym "rotateIfNeeded!" :mod "aslGateway/usageLedger" :kind fn! :sig "rotateIfNeeded! path: String -> (Result Bool String)" :doc "renames path to path.1 (overwriting any prior .1) when the file exists and is at or over maxLedgerBytes; a no-op otherwise" :pit (result effect))
(:sym "appendCallRow!" :mod "aslGateway/usageLedger" :kind fn! :sig "appendCallRow! path: String row: CallRow -> (Result Bool String)" :doc "creates the ledger's parent directory if absent, rotates the file first when it has grown past maxLedgerBytes, then appends one callRowLine" :pit (result effect))
(:sym "readRows!" :mod "aslGateway/usageLedger" :kind fn! :sig "readRows! path: String -> (Result (List CallRow) String)" :doc "every CallRow parsed from the live ledger file; empty list when it does not exist yet; a rotated .1 predecessor is never folded in, so a window wider than the time since the last rotation under-counts" :pit (result effect))
(:sym "rowsInWindow" :mod "aslGateway/usageLedger" :sig "rowsInWindow rows: (List CallRow) nowMs: Int64 windowMs: Int64 -> (List CallRow)" :doc "rows whose atMs falls within windowMs of nowMs")
(:sym "filterByTag" :mod "aslGateway/usageLedger" :sig "filterByTag rows: (List CallRow) tag: String -> (List CallRow)" :doc "--tag: an empty query returns every row unfiltered; a non-empty query keeps only rows whose caller tag matches exactly, so an untagged row never matches")
