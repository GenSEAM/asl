(:sym "sessBegin!" :mod "aslGateway/sessions" :kind fn! :sig "sessBegin! ctx: SessCtx name: String v: SessVendor cwd: String id: String extra: (List String) prompt: String -> (Result SessRun String)" :doc "spawns a vendor turn through fleet/run and writes its lease" :pit (result effect))
(:sym "sessAdvance!" :mod "aslGateway/sessions" :kind fn! :sig "sessAdvance! r: SessRun -> (Pair (Option (Result SessTurn String)) SessRun)" :doc "steps an in-flight vendor turn once without blocking" :pit (effect))
(:sym "sessRunFds" :mod "aslGateway/sessions" :sig "sessRunFds r: SessRun -> (List (Pair Int64 Int64))" :doc "pipe fds of a turn in flight")
(:sym "sessWait!" :mod "aslGateway/sessions" :kind fn! :sig "sessWait! r: SessRun -> (Result SessTurn String)" :doc "waits for a turn in flight" :pit (result effect))
(:sym "sessTurnOf" :mod "aslGateway/sessions" :sig "sessTurnOf r: SessRun o: fr/ProcOut -> (Result SessTurn String)" :doc "builds a SessTurn from a finished process output" :pit (result))
(:sym "PaceWin" :mod "aslGateway/subPace" :kind type :sig "(schema PaceWin (:f kind String) (:f lenMs Int64) (:f resetsMs Int64) (:f used Float64) (:f src String) (:f atMs Int64))" :doc "one window of a subscription: kind, length, reset time, used percent, source and the time the figure was taken" :pit (record))
(:sym "SubPace" :mod "aslGateway/subPace" :kind type :sig "(schema SubPace (:f id String) (:f window String) (:f used Float64) (:f known Bool) (:f allowance Float64) (:f pace Float64) (:f factor Float64) (:f src String) (:f atMs Int64) (:f stale Bool) (:f expired Bool) (:f over Bool) (:f hard Bool) (:f calls Int64) (:f tokens Int64))" :doc "the pacing verdict of one subscription: its most binding window, used percent against the even-pace allowance, the weight factor and the stale, expired, over and hard flags" :pit (record))
(:sym "parseStampMs" :mod "aslGateway/subPace" :sig "parseStampMs z: lt/Zone text: String -> Int64" :doc "epoch ms of a stamp: Z or a +hh:mm suffix is taken as written, a stamp with neither is hand-entered local time read in the given zone")
(:sym "noData" :mod "aslGateway/subPace" :sig "noData id: String calls: Int64 tokens: Int64 -> SubPace" :doc "the pacing verdict of a subscription with no window and no ledger estimate: factor 1, stale")
(:sym "kindOf" :mod "aslGateway/subPace" :sig "kindOf g: String -> String" :doc "the kind name of a window group text such as (:monthly ...)")
(:sym "tokAfter" :mod "aslGateway/subPace" :sig "tokAfter s: String key: String -> String" :doc "the token after a key in a text, up to a space or a closing paren; empty when the key is absent")
(:sym "quotedAfter" :mod "aslGateway/subPace" :sig "quotedAfter s: String key: String -> String" :doc "the quoted string after a key in a text; empty when absent")
(:sym "parseTimeMs" :mod "aslGateway/subPace" :sig "parseTimeMs text: String -> Int64" :doc "UTC epoch ms of 2026-11-13, 2026-11-22 18:00 or an ISO timestamp; 0 for a non-date")
(:sym "fixed1" :mod "aslGateway/subPace" :sig "fixed1 f: Float64 -> String" :doc "a number with one decimal")
(:sym "groupsOf" :mod "aslGateway/subPace" :sig "groupsOf s: String -> (List String)" :doc "the top-level parenthesised groups of a text, quotes honoured")
(:sym "windowsSegment" :mod "aslGateway/subPace" :sig "windowsSegment line: String -> String" :doc "the parenthesised text after :windows in a subscription line, or empty")
(:sym "subLines" :mod "aslGateway/subPace" :sig "subLines text: String -> (List String)" :doc "the (:sub :id ...) lines of a subscriptions text")
(:sym "subId" :mod "aslGateway/subPace" :sig "subId line: String -> String" :doc "the :id of a subscription line")
(:sym "windowsOf" :mod "aslGateway/subPace" :sig "windowsOf z: lt/Zone line: String fileAtMs: Int64 -> (List PaceWin)" :doc "the windows of a subscription line; a window without :src or :at inherits the sub src word and the file :updated date")
(:sym "ledgerUse" :mod "aslGateway/subPace" :sig "ledgerUse ledgerText: String id: String startMs: Int64 -> (Pair Int64 Int64)" :doc "calls and input plus output tokens the ledger text holds for the providers of a subscription since a start time, by line scan")
(:sym "subProviders" :mod "aslGateway/subPace" :sig "subProviders id: String -> (List String)" :doc "the gateway provider ids that draw on a subscription")
(:sym "rollReset" :mod "aslGateway/subPace" :sig "rollReset resetsMs: Int64 lenMs: Int64 nowMs: Int64 -> Int64" :doc "a reset time moved forward by whole windows until it is not in the past")
(:sym "providerSub" :mod "aslGateway/subPace" :sig "providerSub provider: String -> String" :doc "the subscription id a gateway provider draws on; a provider with no entry is its own subscription")
(:sym "subCapacity" :mod "aslGateway/subPace" :sig "subCapacity line: String id: String -> Float64" :doc "requests per month of a subscription without a usage endpoint: its :capacity, else 75000 for commandCode, else 0")
(:sym "paceSubs" :mod "aslGateway/subPace" :sig "paceSubs z: lt/Zone subsText: String ledgerText: String nowMs: Int64 -> (List SubPace)" :doc "one pacing verdict per subscription of a subscriptions text at a time, ledger estimate included")
(:sym "factorsFromPaces" :mod "aslGateway/subPace" :sig "factorsFromPaces paces: (List SubPace) nowMs: Int64 -> (Map String Int64)" :doc "the router cache: subscription id to factor permille, plus the time it was made under ~at")
(:sym "adjustSpread" :mod "aslGateway/subPace" :sig "adjustSpread factors: (Map String Int64) pools: (List (Pair String String)) spread: (List (Pair String Int64)) -> (List (Pair String Int64))" :doc "a route spread under pace: weights times 10 times the subscription factor, members at factor 0 removed so the rest of the chain puts them behind")
(:sym "statusLine" :mod "aslGateway/subPace" :sig "statusLine p: SubPace value: Float64 share: Float64 nowMs: Int64 -> String" :doc "one (:subStatus ...) row: used, allowance, pace, factor, value, share, source, age and the stale, expired, over and hard flags")
(:sym "providerOf" :mod "aslGateway/subPace" :sig "providerOf poolKey: String -> String" :doc "the provider part of a pool key such as commandCode:ccLingFlash")
(:sym "paceCacheKey" :mod "aslGateway/subPace" :sig "paceCacheKey -> String" :doc "the key under which the server keeps the factor cache in its spread state")
(:sym "paceCacheFresh?" :mod "aslGateway/subPace" :sig "paceCacheFresh? cache: (Map String Int64) nowMs: Int64 -> Bool" :doc "true while the factor cache is younger than paceCacheMs")
(:sym "paceCacheMs" :mod "aslGateway/subPace" :sig "paceCacheMs -> Int64" :doc "adopted: the factor cache lives one minute")
(:sym "winFactor" :mod "aslGateway/subPace" :sig "winFactor used: Float64 allowance: Float64 -> Float64" :doc "weight factor from used percent and allowance: 1 within softPoints over, linear to 0.2 at hardPoints, 0 beyond or at 95 percent used, up to 1.5 when well under pace")
(:sym "staleAfterMs" :mod "aslGateway/subPace" :sig "staleAfterMs src: String -> Int64" :doc "adopted: how old a figure of a source may be before it is stale; hand-entered 2 days, api and events 6 hours, ledger never")
(:sym "hardPoints" :mod "aslGateway/subPace" :sig "hardPoints -> Float64" :doc "adopted: percentage points over the even pace at which a subscription leaves the spread")
(:sym "softPoints" :mod "aslGateway/subPace" :sig "softPoints -> Float64" :doc "adopted: percentage points over the even pace before the weight starts to fall")
(:sym "monthCapWindows" :mod "aslGateway/subPace" :sig "monthCapWindows line: String -> Float64" :doc "capacity of the monthly window of a subscription line in rolling windows, 0.0 when absent or unparsable")
(:sym "perWindowAllowance" :mod "aslGateway/subPace" :sig "perWindowAllowance capWindows: Float64 monthUsed: Float64 monthEndMs: Int64 nowMs: Int64 rollingLenMs: Int64 -> Float64" :doc "percent of a rolling window allowed so the monthly remainder lasts to the month end, clamped to 1 to 80, and -1 without capacity, window length or time left")
(:sym "PaceSet" :mod "aslGateway/subPacing" :kind type :sig "(schema PaceSet (:f alias String) (:f key String) (:f value String))" :doc "one --set row of models pace: model alias, :key and its value as ASN text" :pit (record))
(:sym "RouteEdit" :mod "aslGateway/subPacing" :kind type :sig "(schema RouteEdit (:f alias String) (:f route String) (:f weight Int64))" :doc "one per-route lead decision of models pace: alias, PROFILE/INTENT route, weight (0 drops the alias from that chain, N fixes its spread weight)" :pit (record))
(:sym "fixed3" :mod "aslGateway/subPacing" :sig "fixed3 f: Float64 -> String" :doc "a number as text with exactly three decimals, rounded")
(:sym "entryToken" :mod "aslGateway/subPacing" :sig "entryToken text: String provider: String name: String key: String -> String" :doc "in a CAL text, the token after a key inside the (provider \"name\" ...) entry, reading newlines as spaces so wrapped rows match; none when absent")
(:sym "calOkRate" :mod "aslGateway/subPacing" :sig "calOkRate calText: String provider: String name: String -> Float64" :doc "the share of a model's FREE-PROBE :vps and :mac probes that answered 200; 0.5 with no probe")
(:sym "freeCalScore" :mod "aslGateway/subPacing" :sig "freeCalScore scoresText: String alias: String provider: String name: String intent: String -> (Option Float64)" :doc "FREE-CAL score of a gateway model row: its (:cell ...) for the intent by row id, else by provider and model name, else its (:modelScore ...) by row id; null or no row is none; empty intent asks for the overall score" :pit (option))
(:sym "saturatedQuality" :mod "aslGateway/subPacing" :sig "saturatedQuality scoresText: String alias: String provider: String name: String intent: String -> (Option Float64)" :doc "quality of a FREE-CAL cell on a saturated intent: score x n/(n+infra) x 1/(1+ms/10000); none without the cell or with no counted call" :pit (option))
(:sym "qualityOf" :mod "aslGateway/subPacing" :sig "qualityOf scoresText: String calText: String alias: String intent: String provider: String name: String -> Float64" :doc "quality 0..1 of a model row for an intent: on grade, plan, research and any the reliability-and-speed quality of its FREE-CAL cell; otherwise its FREE-CAL score (cell, else overall), clamped; else the probe ok rate")
(:sym "multiplierOf" :mod "aslGateway/subPacing" :sig "multiplierOf multText: String provider: String name: String -> String" :doc "the value multiplier CAL/subMultipliers records for a model: a number, free, or unknown")
(:sym "spreadWeight" :mod "aslGateway/subPacing" :sig "spreadWeight multText: String scoresText: String calText: String alias: String intent: String provider: String name: String -> Int64" :doc "spread weight of a model row on a route intent: max 1 of the rounded multiplier x quality; free models 8 x quality; unknown 1")
(:sym "daysLeft" :mod "aslGateway/subPacing" :sig "daysLeft today: String renews: String -> Int64" :doc "whole days from today to a renews date, at least 1")
(:sym "subRemaining" :mod "aslGateway/subPacing" :sig "subRemaining subsText: String provider: String -> (Option Float64)" :doc "100 minus the monthly :usedPercent of a subscription in the ledger, none when it has no figure" :pit (option))
