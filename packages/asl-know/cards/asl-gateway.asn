(:sym "gatewayDecidePoint" :mod "aslGateway/config" :sig "gatewayDecidePoint text: String point: String -> (Pair DecidePoint (List String))" :doc "the switch of one point from gateway.asn text: its own valid row, else static; errors in other rows are reported and never change this point")
(:sym "gatewayDecideLoad!" :mod "aslGateway/config" :kind fn! :sig "gatewayDecideLoad! path: String point: String -> (Pair DecidePoint (List String))" :doc "gatewayDecidePoint over the file at path; a missing file is the static default plus a reason" :pit (effect))
(:sym "CodeRoute" :mod "aslGateway/config" :kind type :sig "(schema CodeRoute (:f id String) (:f writer String) (:f retries Int64) (:f escalate String) (:f retryWriter String) (:f escalateTimeoutSec Float64) (:f escalateRetries Int64) (:f escalateRetryStatuses (List Int64)))" :doc "one declared code route: id, writer alias, retries, escalate alias, optional retryWriter alias, escalation timeout and retry count and the HTTP statuses retried on escalation" :pit (record))
(:sym "gatewayCodeRoute!" :mod "aslGateway/config" :kind fn! :sig "gatewayCodeRoute! text: String id: String registryPath: String -> (Result CodeRoute String)" :doc "the codeRoute row with the given id parsed from a whole gateway.asn text and its aliases checked against the same config's models; an unreadable config, a missing row or a malformed row is an error naming the cause" :pit (result effect))
