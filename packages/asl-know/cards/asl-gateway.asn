(:card "asl-gateway" :purpose "Sovereign L7 Cognitive Gateway & Omni-Protocol Nexus: LMK key management, pure Dyck-1 data synchronization, universal browser frames, and generative media accounting" :import "(aslGateway/server :a x)" :deps (asl-text asl-json asl-proc asl-http asl-cli) :modules ((:m "aslGateway/server" :doc "Sovereign L7 Cognitive Gateway server pipeline: stream d...") (:m "aslGateway/batchPool" :doc "Deterministic per-model request batching state machine.") (:m "aslGateway/binding" :doc "GW-SESSION-BIND: caller-session binding for CLI vendors....") (:m "aslGateway/breaker" :doc "Pure AgentSlang Circuit Breaker: Provider cooldowns, con...") (:m "aslGateway/browser" :doc "Universal Browser Automation Protocol: declarative actio...")) :moduleCount 32 :sigs ("(schema GatewayTurnVerdict (:f allowed Bool) (:f quarantinedThink Str) (:f cleanOutput Str) (:f toolCalls (List Str)) (:f rejectionReason St..." "(schema Launch (:f module String) (:f families (List dp/LifecycleFamily)))" "(schema GatewayLoop (:f listener Int64) (:f upstreamPort Int64) (:f env (Map String String)) (:f home String) (:f rootDir String) (:f regist..." "linkOpen! env: (Map String String) home: String rootDir: String families: (List dp/LifecycleFamily) -> (Result GatewayLoop String)") :more (linkSend! extractThinkBlocks detectEshViolation inspectCompletionTurn handleSyncIngest handleBrowserDispatch handleMediaDispatch gatewayHostPath!) :moreCount 1004 :effects (linkOpen! linkSend! gatewayHostPath! gatewayStatePath! mainWith drive! gatewayTurn! runEffect!) :fails (linkOpen! gatewayHostPath! mainWith boundTurn! boundTurnWith! parseBudgetConfig charge cliProviderHealth!) :example none)
(:sym "GatewayTurnVerdict" :mod "aslGateway/server" :kind type :sig "(schema GatewayTurnVerdict (:f allowed Bool) (:f quarantinedThink Str) (:f cleanOutput Str) (:f toolCalls (List Str)) (:f rejectionReason Str))" :pit (record))
(:sym "Launch" :mod "aslGateway/server" :kind type :sig "(schema Launch (:f module String) (:f families (List dp/LifecycleFamily)))" :doc "how a gateway process is launched: the module start/restart re-run and stop/status recognise, and the lifecycle families it serves with" :pit (record))
(:sym "GatewayLoop" :mod "aslGateway/server" :kind type :sig "(schema GatewayLoop (:f listener Int64) (:f upstreamPort Int64) (:f env (Map String String)) (:f home String) (:f rootDir String) (:f registryPath String) (:f promptMaxBytes Int64) (:f conns (List GatewayConn)) (:f pools pd/PoolRegistry) (:f replies (List pd/PoolReply)) (:f breaker b/BreakerState) ( ..." :pit (record))
(:sym "linkOpen!" :mod "aslGateway/server" :kind fn! :sig "linkOpen! env: (Map String String) home: String rootDir: String families: (List dp/LifecycleFamily) -> (Result GatewayLoop String)" :doc "the link loads config strictly: a missing or invalid config or wiring is an error, never the empty wiring the server falls back to --- in-process link: a library caller runs the same loop the HTTP server runs, with no socket on its side ---" :pit (result effect))
(:sym "linkSend!" :mod "aslGateway/server" :kind fn! :sig "linkSend! srv: GatewayLoop method: String path: String headers: (List (Pair String String)) body: String timeoutMs: Int64 -> (Pair GatewayLoop (Result String String))" :doc "one request through chat, route, admission, budget, plugin send and charge in this process; the result is the HTTP response bytes the server would write" :pit (effect))
