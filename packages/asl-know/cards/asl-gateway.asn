(:sym "secretsDefaultPath" :mod "aslGateway/secrets" :sig "secretsDefaultPath -> String" :doc "~/.asl/secrets.asn, one 0600 file per machine")
(:sym "secretsParse" :mod "aslGateway/secrets" :sig "secretsParse path: String text: String -> (Result SecretStore String)" :doc "parses rows (:secret :id ID :value V); a bad row or duplicate id is an ERR_SECRET_ROW or ERR_SECRET_DUPLICATE receipt naming line or id" :pit (result))
(:sym "secretsLoad!" :mod "aslGateway/secrets" :kind fn! :sig "secretsLoad! path: String -> (Result SecretStore String)" :doc "loads a secrets file; refuses a missing file, a symlink, any group or other permission bit, or a file whose size, mtime or mode changed while it was read; owner is not checked, fileStat has no uid (GW-SECRETS-OWNER-FFI)" :pit (result effect))
(:sym "secretsGet" :mod "aslGateway/secrets" :sig "secretsGet store: SecretStore id: String -> (Result String String)" :doc "value for an id, or ERR_SECRET_MISSING naming the id" :pit (result))
(:sym "secretsIds" :mod "aslGateway/secrets" :sig "secretsIds store: SecretStore -> (List String)" :doc "ids in file order")
(:sym "secretsEnvFor" :mod "aslGateway/secrets" :sig "secretsEnvFor store: SecretStore base: (Map String String) rows: (List (Pair String String)) -> (Result (Map String String) String)" :doc "base env plus exactly the listed (NAME ID) pairs, for a child CLI that reads env only" :pit (result))
(:sym "secretsRedact" :mod "aslGateway/secrets" :sig "secretsRedact store: SecretStore text: String -> String" :doc "replaces every secret value in a text by <secret:ID>")
(:sym "secretsEqual?" :mod "aslGateway/secrets" :sig "secretsEqual? a: String b: String -> Bool" :doc "compares two secret strings over the longer length with no early exit")
(:sym "secretsMissingReceipt" :mod "aslGateway/secrets" :sig "secretsMissingReceipt id: String -> String" :doc "the ERR_SECRET_MISSING receipt for an id")
(:sym "octalOf" :mod "aslGateway/secrets" :sig "octalOf n: Int64 -> String" :doc "octal digits of a non-negative integer, for mode receipts")
(:sym "secretEnvName" :mod "aslGateway/secrets" :sig "secretEnvName id: String -> String" :doc "name under which a secret id is injected into the gateway env: ASLSECRET_ plus the id; a provider with :secret reads its key from that name")
(:sym "SessVendor" :mod "aslGateway/sessions" :kind type :sig "(schema SessVendor (:f name String) (:f bin String) (:f env (List String)) (:f first (List String)) (:f resume (List String)) (:f idFrom String) (:f replyFrom String) (:f wrap String) (:f wrapResume String) (:f sep String) (:f modelArgs (List String)) (:f fork (List String)))" :doc "vendor row from gateway.asn :sessions" :pit (record))
(:sym "SessCtx" :mod "aslGateway/sessions" :kind type :sig "(schema SessCtx (:f secretsFile String) (:f dir String) (:f vendors (List SessVendor)) (:f env (List String)) (:f timeoutSec Int64) (:f ttlSec Int64) (:f ledger String))" :doc "sessions context: directory, vendor allowlist, env, timeout, TTL, ledger path" :pit (record))
(:sym "SessRow" :mod "aslGateway/sessions" :kind type :sig "(schema SessRow (:f name String) (:f vendor String) (:f cwd String) (:f args (List String)) (:f sessionId String) (:f startedAt Int64) (:f updatedAt Int64) (:f turns Int64) (:f key String) (:f model String) (:f digest String) (:f delivered Int64) (:f usageIn Int64) (:f usageOut Int64) (:f fork Bool) ..." :doc "stored row: vendor, cwd, vendor session id, counters, digest, kind named or binding, context digest" :pit (record))
(:sym "sessNameOk?" :mod "aslGateway/sessions" :sig "sessNameOk? n: String -> Bool" :doc "valid session name characters and length")
(:sym "sessCwdOk?" :mod "aslGateway/sessions" :sig "sessCwdOk? cwd: String -> Bool" :doc "absolute path without #")
(:sym "sessCtxFromText" :mod "aslGateway/sessions" :sig "sessCtxFromText text: String dir: String env: (List String) -> SessCtx" :doc "context parsed from gateway.asn text; empty allowlist when unreadable")
(:sym "sessCtxHome!" :mod "aslGateway/sessions" :kind fn! :sig "sessCtxHome! -> SessCtx" :doc "context for the current HOME" :pit (effect))
(:sym "sessCtxAt!" :mod "aslGateway/sessions" :kind fn! :sig "sessCtxAt! home: String env: (List String) -> SessCtx" :doc "context read from HOME/.asl/gateway.asn" :pit (effect))
(:sym "sessKeyValues" :mod "aslGateway/sessions" :sig "sessKeyValues text: String key: String -> (List String)" :doc "values of a key in vendor output in order: JSON \"key\": value and ASN :key value")
(:sym "sessReplyOf" :mod "aslGateway/sessions" :sig "sessReplyOf out: String key: String -> String" :doc "last value of the reply key in vendor output")
(:sym "sessSubst" :mod "aslGateway/sessions" :sig "sessSubst s: String id: String prompt: String -> String" :doc "substitutes id and prompt in a wrap template")
(:sym "sessArgv" :mod "aslGateway/sessions" :sig "sessArgv v: SessVendor id: String extra: (List String) prompt: String -> (List String)" :doc "vendor argv: bin, first or resume head, extra args, prompt (after :sep or -- when it starts with a dash)")
(:sym "sessVendorEnv" :mod "aslGateway/sessions" :sig "sessVendorEnv ctx: SessCtx v: SessVendor -> (List String)" :doc "env a vendor child sees: base names plus its :env")
(:sym "sessSecretRows" :mod "aslGateway/sessions" :sig "sessSecretRows v: SessVendor -> (List (Pair String String))" :doc "the NAME and secret id pairs a vendor row asks for with NAME@id env entries")
(:sym "sessVendorEnvFull!" :mod "aslGateway/sessions" :kind fn! :sig "sessVendorEnvFull! ctx: SessCtx v: SessVendor -> (Result (List String) String)" :doc "the vendor child env list with its secrets added from the default secrets file" :pit (result effect))
(:sym "sessVendorEnvAt!" :mod "aslGateway/sessions" :kind fn! :sig "sessVendorEnvAt! ctx: SessCtx v: SessVendor secretsPath: String -> (Result (List String) String)" :doc "the vendor child env list with its secrets added from the named secrets file" :pit (result effect))
(:sym "sessRowPath" :mod "aslGateway/sessions" :sig "sessRowPath ctx: SessCtx name: String -> String" :doc "path of a row file")
(:sym "sessRowFiles!" :mod "aslGateway/sessions" :kind fn! :sig "sessRowFiles! ctx: SessCtx -> (List String)" :doc "row file names in the store" :pit (effect))
(:sym "sessStart!" :mod "aslGateway/sessions" :kind fn! :sig "sessStart! ctx: SessCtx name: String vendor: String cwd: String args: (List String) text: String -> String" :doc "first turn of a named session" :pit (effect))
(:sym "sessSend!" :mod "aslGateway/sessions" :kind fn! :sig "sessSend! ctx: SessCtx name: String text: String extra: (List String) -> String" :doc "next turn of a named session; refuses a binding" :pit (effect))
(:sym "sessList!" :mod "aslGateway/sessions" :kind fn! :sig "sessList! ctx: SessCtx -> String" :doc "lists session and binding rows" :pit (effect))
(:sym "sessShow!" :mod "aslGateway/sessions" :kind fn! :sig "sessShow! ctx: SessCtx name: String -> String" :doc "shows a row" :pit (effect))
(:sym "sessStop!" :mod "aslGateway/sessions" :kind fn! :sig "sessStop! ctx: SessCtx name: String -> String" :doc "forget: kills only the leased vendor child, removes row, reply, lease and lock" :pit (effect))
(:sym "sessionsCli!" :mod "aslGateway/sessions" :kind fn! :sig "sessionsCli! args: (List String) -> (Result Int64 String)" :doc "CLI entry for session ops" :pit (result effect))
(:sym "sessKeyName" :mod "aslGateway/sessions" :sig "sessKeyName key: String -> String" :doc "b- plus the first 24 hex of sha256 of the caller key")
(:sym "sessFork!" :mod "aslGateway/sessions" :kind fn! :sig "sessFork! ctx: SessCtx name: String to: String -> String" :doc "copies a row to a new name; next turn runs the vendor fork args" :pit (effect))
(:sym "SessTurn" :mod "aslGateway/sessions" :kind type :sig "(schema SessTurn (:f id String) (:f reply String) (:f usage String) (:f inTok Int64) (:f outTok Int64))" :doc "result of a vendor turn" :pit (record))
(:sym "sessTurn!" :mod "aslGateway/sessions" :kind fn! :sig "sessTurn! ctx: SessCtx name: String v: SessVendor cwd: String id: String extra: (List String) prompt: String -> (Result SessTurn String)" :doc "blocking vendor turn" :pit (result effect))
(:sym "sessLock!" :mod "aslGateway/sessions" :kind fn! :sig "sessLock! ctx: SessCtx name: String -> Bool" :doc "symlink lock NAME.lock to OWNERPID:NONCE: creation is atomic so exactly one turn runs per session; the token proves ownership, a stale lock is taken over by renaming it to a unique name and re-reading it, and unlock/finish only act while th..." :pit (effect))
(:sym "sessUnlock!" :mod "aslGateway/sessions" :kind fn! :sig "sessUnlock! ctx: SessCtx name: String token: String -> Unit" :doc "releases the lock only while it holds the token" :pit (effect))
(:sym "sessReadRow!" :mod "aslGateway/sessions" :kind fn! :sig "sessReadRow! ctx: SessCtx name: String -> (Option SessRow)" :doc "reads a row by name" :pit (option effect))
(:sym "sessWriteRow!" :mod "aslGateway/sessions" :kind fn! :sig "sessWriteRow! ctx: SessCtx r: SessRow -> (Result Unit String)" :doc "writes a row" :pit (result effect))
(:sym "sessWriteFile!" :mod "aslGateway/sessions" :kind fn! :sig "sessWriteFile! ctx: SessCtx path: String text: String -> (Result Unit String)" :doc "writes a 0600 file atomically in the 0700 store" :pit (result effect))
(:sym "sessVendorNamed" :mod "aslGateway/sessions" :sig "sessVendorNamed ctx: SessCtx vendor: String -> (Option SessVendor)" :doc "vendor row by name" :pit (option))
(:sym "sessQuote" :mod "aslGateway/sessions" :sig "sessQuote s: String -> String" :doc "quotes a string for ASN")
(:sym "sessErr" :mod "aslGateway/sessions" :sig "sessErr code: String msg: String -> String" :doc "ASN error receipt")
(:sym "sessReplyPath" :mod "aslGateway/sessions" :sig "sessReplyPath ctx: SessCtx name: String -> String" :doc "path of the last reply file")
(:sym "sessRowText" :mod "aslGateway/sessions" :sig "sessRowText r: SessRow -> String" :doc "ASN text of a row")
(:sym "sessFirst" :mod "aslGateway/sessions" :sig "sessFirst xs: (List String) -> String" :doc "first element or empty")
(:sym "sessPropStr" :mod "aslGateway/sessions" :sig "sessPropStr g: (Map String rd/SExpr) key: String -> String" :doc "string property")
(:sym "sessPropList" :mod "aslGateway/sessions" :sig "sessPropList g: (Map String rd/SExpr) key: String -> (List String)" :doc "string list property")
(:sym "sessPropInt" :mod "aslGateway/sessions" :sig "sessPropInt g: (Map String rd/SExpr) key: String -> Int64" :doc "integer property of an ASN prop map")
(:sym "sessReceipt" :mod "aslGateway/sessions" :sig "sessReceipt op: String name: String extra: String -> String" :doc "ok receipt for an op")
(:sym "sessAlivePid?" :mod "aslGateway/sessions" :kind fn! :sig "sessAlivePid? pid: Int64 -> Bool" :doc "true when a pid is in the process table" :pit (effect))
(:sym "sessLockPath" :mod "aslGateway/sessions" :sig "sessLockPath ctx: SessCtx name: String -> String" :doc "path of the lock symlink")
(:sym "sessClip" :mod "aslGateway/sessions" :sig "sessClip s: String n: Int64 -> String" :doc "clips text to a length")
(:sym "sessUsageText" :mod "aslGateway/sessions" :sig "sessUsageText out: String -> String" :doc "usage text from vendor output")
(:sym "sessParseRows" :mod "aslGateway/sessions" :sig "sessParseRows text: String -> (List SessRow)" :doc "parses session rows")
(:sym "sessLockOwner!" :mod "aslGateway/sessions" :kind fn! :sig "sessLockOwner! ctx: SessCtx name: String -> Int64" :doc "pid of the lock owner" :pit (effect))
(:sym "sessUserNameOk?" :mod "aslGateway/sessions" :sig "sessUserNameOk? n: String -> Bool" :doc "valid name that is not in the b- binding namespace")
(:sym "sessLockTake!" :mod "aslGateway/sessions" :kind fn! :sig "sessLockTake! ctx: SessCtx name: String -> String" :doc "takes the per-session lock and returns its token, empty when busy" :pit (effect))
(:sym "sessLockHeld?" :mod "aslGateway/sessions" :kind fn! :sig "sessLockHeld? ctx: SessCtx name: String token: String -> Bool" :doc "true while the lock still holds the token" :pit (effect))
(:sym "sessLeasePath" :mod "aslGateway/sessions" :sig "sessLeasePath ctx: SessCtx name: String -> String" :doc "path of the lease file naming lock owner and vendor child")
(:sym "sessLeaseWrite!" :mod "aslGateway/sessions" :kind fn! :sig "sessLeaseWrite! ctx: SessCtx name: String child: Int64 -> Bool" :doc "writes the lease for a running child" :pit (effect))
(:sym "sessStopChild!" :mod "aslGateway/sessions" :kind fn! :sig "sessStopChild! ctx: SessCtx name: String -> Bool" :doc "kills the lease's vendor child when it is still the lock owner's child and group leader" :pit (effect))
