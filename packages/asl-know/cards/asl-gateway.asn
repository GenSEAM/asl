(:card "asl-gateway" :purpose "Sovereign L7 Cognitive Gateway & Omni-Protocol Nexus: LMK key management, pure Dyck-1 data synchronization, universal browser frames, and generative media accounting" :import "(aslGateway/server :a x)" :deps (asl-text asl-json asl-proc asl-http) :modules ((:m "aslGateway/server" :doc "Sovereign L7 Cognitive Gateway server pipeline: stream d...") (:m "aslGateway/admission") (:m "aslGateway/affinity") (:m "aslGateway/balancer") (:m "aslGateway/batchPool")) :moduleCount 51 :sigs ("paramsFromRequest sent: u/UpstreamRequest -> ul/CallParams" "gatewayCliMode? mode: String -> Bool" "hubStatusText! srv: GatewayLoop -> String" "staleHeaderName -> String" "staleHeaderLine err: String -> String" "staleMarked stale: String data: String -> String" "addConn srv: GatewayLoop fd: Int64 phase: ConnPhase -> GatewayLoop" "requeueWriting srv: GatewayLoop fd: Int64 rest: String -> GatewayLoop" "stepWriting! srv: GatewayLoop conn: GatewayConn data: String ready: (List (Pair Int64 Int64)) -> GatewayLoop" "failureReason f: u/UpstreamFailure -> String") :more (busyOutcome busyOutcomeIn planOutcome breakerEvent! GatewayTurnVerdict Launch GatewayLoop linkOpen! linkSend! extractThinkBlocks detectEshViolation) :moreCount 1522 :effects (hubStatusText! stepWriting! breakerEvent! linkOpen! linkSend! gatewayHostPath! gatewayStatePath! mainWith) :fails (linkOpen! gatewayHostPath! mainWith rampedWorldTable! concurrency429After! parseLane parseLeases admitShared!) :example none)
