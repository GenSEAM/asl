(:sym "Serverless" :mod "aslGateway/dispatch" :kind type :sig "(schema Serverless (:f coldStartMs Int64) (:f startCost Int64) (:f unit String))" :doc "a scale-to-zero endpoint: how long a start may take, what one start is expected to cost (microUSD) and the budget unit it is charged to" :pit (record))
(:sym "Wiring" :mod "aslGateway/dispatch" :kind type :sig "(schema Wiring (:f rows (List u/UpstreamProvider)) (:f plugins (List p/Plugin)) (:f profile (Option rt/Profile)) (:f slots (List Slot)) (:f ledger (Option bgt/Ledger)) (:f settings u/UpstreamSettings) ; (:m :ref GW-BALANCER-WIRE :do \"some when the gateway form carries a balancer section: plan routes ..." :pit (record))
(:sym "RouteHint" :mod "aslGateway/dispatch" :kind type :sig "(schema RouteHint (:f provider String) (:f model String) (:f intent String) (:f role String) (:f promptTokens Int64))" :pit (record))
(:sym "DecisionRow" :mod "aslGateway/dispatch" :kind type :sig "(schema DecisionRow (:f rule String) (:f candidates (List String)) (:f refused (List String)) (:f pick String) (:f admission String) (:f budget String) (:f model String) (:f why String))" :pit (record))
(:sym "Plan" :mod "aslGateway/dispatch" :kind type :sig "(enum Plan (:c planSend [(slot String) (plugin String) (request u/UpstreamRequest) (row DecisionRow)]) (:c planReject [(status Int64) (reason String) (row DecisionRow)]) (:c planWait [(slot String) (plugin String) (request u/UpstreamRequest) (row DecisionRow) (cold Bool) (deadlineMs Int64)]))" :doc "planWait parks a request on a serverless endpoint until it is warm or deadlineMs passes; cold means the endpoint still has to be started")
(:sym "planSend" :mod "aslGateway/dispatch" :kind ctor :sig "(:c planSend [(slot String) (plugin String) (request u/UpstreamRequest) (row DecisionRow)]) of Plan" :pit (ctor))
(:sym "planReject" :mod "aslGateway/dispatch" :kind ctor :sig "(:c planReject [(status Int64) (reason String) (row DecisionRow)]) of Plan" :pit (ctor))
