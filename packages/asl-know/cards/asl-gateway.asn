(:card "asl-gateway" :purpose "Sovereign L7 Cognitive Gateway & Omni-Protocol Nexus: LMK key management, pure Dyck-1 data synchronization, universal browser frames, and generative media accounting" :import "(aslGateway/server :a x)" :deps (asl-text asl-json asl-proc asl-http asl-cli) :modules ((:m "aslGateway/server" :doc "Sovereign L7 Cognitive Gateway server pipeline: stream d...") (:m "aslGateway/balancer" :doc "GW-BUDGET-BALANCER-20261027: pure model-pool balancer ov...") (:m "aslGateway/batchPool" :doc "Deterministic per-model request batching state machine.") (:m "aslGateway/binding" :doc "GW-SESSION-BIND: caller-session binding for CLI vendors....") (:m "aslGateway/breaker" :doc "Pure AgentSlang Circuit Breaker: Provider cooldowns, con...")) :moduleCount 40 :sigs ("gatewayCliMode? mode: String -> Bool" "breakerEvent! st: b/BreakerState event: String pool: String now: Int64 parkSec: Int64 -> b/BreakerState" "(schema GatewayTurnVerdict (:f allowed Bool) (:f quarantinedThink Str) (:f cleanOutput Str) (:f toolCalls (List Str)) (:f rejectionReason St..." "(schema Launch (:f module String) (:f families (List dp/LifecycleFamily)))" "(schema GatewayLoop (:f listener Int64) (:f upstreamPort Int64) (:f env (Map String String)) (:f home String) (:f rootDir String) (:f regist...") :more (linkOpen! linkSend! extractThinkBlocks detectEshViolation inspectCompletionTurn handleSyncIngest handleBrowserDispatch handleMediaDispatch gatewayHostPath!) :moreCount 1228 :effects (breakerEvent! linkOpen! linkSend! gatewayHostPath! gatewayStatePath! mainWith drive! gatewayTurn!) :fails (linkOpen! gatewayHostPath! mainWith parseTier parseMode windowMsOf parseBalancer poolObserveEndpoint) :example none)
(:sym "gatewayCliMode?" :mod "aslGateway/server" :sig "gatewayCliMode? mode: String -> Bool" :doc "true for the gateway subcommands handled by the CLI main (config, configCheck, convert, stats, session, models)")
(:sym "breakerEvent!" :mod "aslGateway/server" :sig "breakerEvent! st: b/BreakerState event: String pool: String now: Int64 parkSec: Int64 -> b/BreakerState" :doc "applies one chat breaker event to the breaker state; a markDown with parkSec above 0 parks the pool that long, else the fixed cooldown" :pit (effect))
(:sym "GatewayTurnVerdict" :mod "aslGateway/server" :kind type :sig "(schema GatewayTurnVerdict (:f allowed Bool) (:f quarantinedThink Str) (:f cleanOutput Str) (:f toolCalls (List Str)) (:f rejectionReason Str))" :pit (record))
(:sym "Launch" :mod "aslGateway/server" :kind type :sig "(schema Launch (:f module String) (:f families (List dp/LifecycleFamily)))" :doc "how a gateway process is launched: the module start/restart re-run and stop/status recognise, and the lifecycle families it serves with" :pit (record))
(:sym "GatewayLoop" :mod "aslGateway/server" :kind type :sig "(schema GatewayLoop (:f listener Int64) (:f upstreamPort Int64) (:f env (Map String String)) (:f home String) (:f rootDir String) (:f registryPath String) (:f promptMaxBytes Int64) (:f conns (List GatewayConn)) (:f pools pd/PoolRegistry) (:f replies (List pd/PoolReply)) (:f breaker b/BreakerState) ( ..." :pit (record))
(:sym "linkOpen!" :mod "aslGateway/server" :kind fn! :sig "linkOpen! env: (Map String String) home: String rootDir: String families: (List dp/LifecycleFamily) -> (Result GatewayLoop String)" :doc "the link loads config strictly: with no config file the secrets path stays the default and the missing config is the error; a config whose :secretsFile is unreadable, non-string or missing is refused; a missing or invalid config or wiring i..." :pit (result effect))
(:sym "linkSend!" :mod "aslGateway/server" :kind fn! :sig "linkSend! srv: GatewayLoop method: String path: String headers: (List (Pair String String)) body: String timeoutMs: Int64 -> (Pair GatewayLoop (Result String String))" :doc "one request through chat, route, admission, budget, plugin send and charge in this process; the result is the HTTP response bytes the server would write" :pit (effect))
(:sym "extractThinkBlocks" :mod "aslGateway/server" :sig "extractThinkBlocks text: Str -> (Pair Str Str)")
(:sym "detectEshViolation" :mod "aslGateway/server" :sig "detectEshViolation text: Str -> Bool")
(:sym "inspectCompletionTurn" :mod "aslGateway/server" :sig "inspectCompletionTurn rawText: Str hasVerifiedExec: Bool -> GatewayTurnVerdict")
(:sym "handleSyncIngest" :mod "aslGateway/server" :sig "handleSyncIngest rawPayload: Str -> (Pair Str Str)")
(:sym "handleBrowserDispatch" :mod "aslGateway/server" :sig "handleBrowserDispatch frame: browser/BrowserActionFrame -> browser/BrowserActionReceipt")
(:sym "handleMediaDispatch" :mod "aslGateway/server" :sig "handleMediaDispatch req: media/MediaGenRequest -> media/MediaGenReceipt")
(:sym "gatewayHostPath!" :mod "aslGateway/server" :sig "gatewayHostPath! hostResult: (Result String String) -> (Result String String)" :pit (result effect))
(:sym "gatewayStatePath!" :mod "aslGateway/server" :kind fn! :sig "gatewayStatePath! -> String" :doc "the run-state receipt path, under .asl/run so it never collides with the profiles config or the usage ledger, both of which also live under home/.asl; regression guard: serverTest.asl#testStatePathIsolation" :pit (effect))
(:sym "ensureSessionHeader" :mod "aslGateway/server" :sig "ensureSessionHeader headers: (List (Pair String String)) fd: Int64 nowMs: Int64 -> (List (Pair String String))" :doc "adds X-ASL-Session with a connection-derived fallback id when the caller sent none; an existing header is left untouched")
(:sym "main!" :mod "aslGateway/server" :sig none)
(:sym "mainWith" :mod "aslGateway/server" :kind fn! :sig "mainWith args: (List String) module: String families: (List dp/LifecycleFamily) -> (Result Int64 String)" :doc "the injection point: a launcher outside asl-gateway (it never imports a provider package) passes its module path and extra lifecycle families, served after the built-in ones" :pit (result effect))
(:sym "GatewayConn" :mod "aslGateway/server" :kind type :sig "(schema GatewayConn (:f fd Int64) (:f input String) (:f phase ConnPhase))" :pit (record))
(:sym "ConnPhase" :mod "aslGateway/server" :kind type :sig "(enum ConnPhase (:c connReading []) (:c connHttp [(call u/UpstreamCall) (k (fn [ch/ChatOutcome] -> ch/ChatStep)) (slot String) (provider String) (startMs Int64) (model String) (intent String) (tag String) (params ul/CallParams) (profile String)]) (:c connPool [(requestId Int64) (k (fn [ch/ChatOutcom ..." :doc "one connection's place in the event loop; a chat continuation waits on an upstream call or a pool reply")
(:sym "connReading" :mod "aslGateway/server" :kind ctor :sig "(:c connReading []) of ConnPhase" :pit (ctor))
(:sym "connTimer" :mod "aslGateway/server" :kind ctor :sig "(:c connTimer [(deadlineMs Int64) (k (fn [ch/ChatOutcome] -> ch/ChatStep)) (tag String)]) ; (:m :tags (retry) :do \"a token-bucket wait (effBucket) parks here in ... of ConnPhase" :pit (ctor))
(:sym "connBucketWait" :mod "aslGateway/server" :kind ctor :sig "(:c connBucketWait [(deadlineMs Int64) (k (fn [ch/ChatOutcome] -> ch/ChatStep)) (tag String)]) ; (:m :ref GW-SESSION-BIND :do \"a bound CLI turn parks here inste ... of ConnPhase" :doc "ConnPhase constructor: connection parked on a token-bucket deadline" :pit (ctor))
(:sym "connCli" :mod "aslGateway/server" :kind ctor :sig "(:c connCli [(p bd/BoundPend) (k (fn [ch/ChatOutcome] -> ch/ChatStep)) (tag String) (t0 Int64)]) of ConnPhase" :doc "ConnPhase constructor: connection parked on a bound CLI turn" :pit (ctor))
(:sym "connWriting" :mod "aslGateway/server" :kind ctor :sig "(:c connWriting [(data String)]) of ConnPhase" :pit (ctor))
(:sym "drive!" :mod "aslGateway/server" :kind fn! :sig "drive! srv: GatewayLoop fd: Int64 tag: String step: ch/ChatStep -> GatewayLoop" :doc "run the chat machine until it answers or parks on an upstream call or a pool slot" :pit (effect))
(:sym "gatewayTurn!" :mod "aslGateway/server" :kind fn! :sig "gatewayTurn! srv: GatewayLoop ready: (List (Pair Int64 Int64)) -> GatewayLoop" :doc "one reactor turn over all connections" :pit (effect))
(:sym "loopConns" :mod "aslGateway/server" :sig "loopConns srv: GatewayLoop conns: (List GatewayConn) -> GatewayLoop" :doc "replaces the connection list of a GatewayLoop")
(:sym "apiKindOf" :mod "aslGateway/server" :sig "apiKindOf url: String -> String")
(:sym "PendingCall" :mod "aslGateway/server" :kind type :sig "(schema PendingCall (:f intent String) (:f model String) (:f latencyMs Int64) (:f charge Int64) (:f tag String) (:f params ul/CallParams) (:f profile String))" :pit (record))
(:sym "packAttrib" :mod "aslGateway/server" :sig "packAttrib tag: String session: String turn: String consumer: String -> String" :doc "attribution string of tag, session, turn and consumer joined by newlines")
(:sym "runEffect!" :mod "aslGateway/server" :kind fn! :sig "runEffect! srv: GatewayLoop eff: ch/ChatEffect -> (Pair GatewayLoop ch/ChatOutcome)" :doc "effects that finish inside one loop turn; CLI clients are not served by the HTTP entry" :pit (effect))
(:sym "budgetRefusal!" :mod "aslGateway/server" :kind fn! :sig "budgetRefusal! srv: GatewayLoop profile: String -> (Option String)" :pit (option effect))
(:sym "cliAdmit!" :mod "aslGateway/server" :kind fn! :sig "cliAdmit! srv: GatewayLoop client: String args: (List (Pair String j/Json)) -> (Pair GatewayLoop Bool)" :doc "asks the balancer before a vendor CLI run: picks over the cli lane, refuses when its budgets are at the hard cap, else charges the picked alias with the prompt-size estimate; no pool or no cli lane admits" :pit (effect))
(:sym "keyFilesWorldEnv!" :mod "aslGateway/server" :kind fn! :sig "keyFilesWorldEnv! table: (Result c/GatewayTable String) env: (Map String String) -> (Map String String)" :doc "the env the chat effects read: the process env overlaid, per provider row with a keyEnv, by the value a key file of the config holds; the file wins; an unloadable table leaves the env as it was" :pit (effect))
(:sym "Tier" :mod "aslGateway/balancer" :kind type :sig "(enum Tier (:c tierFree []) (:c tierSub []) (:c tierPaid []))" :doc "free, sub or paid: which spend class a model draws on")
(:sym "Mode" :mod "aslGateway/balancer" :kind type :sig "(enum Mode (:c modeFree []) (:c modeSub []) (:c modePaid []) (:c modeBalanced []) (:c modeExplore []))" :doc "free, sub and paid admit only that tier; balanced (default) and explore admit every tier")
(:sym "Budget" :mod "aslGateway/balancer" :kind type :sig "(schema Budget (:f id String) (:f windowMs Int64) (:f anchorMs Int64) (:f unit String) (:f size Int64) (:f softPct Int64) (:f hardPct Int64) (:f useOrLose Bool) (:f source String) ; (:m :ref GW-BALANCER-HEADER-WINDOW :do \"the window the provider rate-limit headers count, 0 when the row names none; a ..." :doc "one quota window: id, window length and anchor in ms, unit req|tok|usd, size, soft and hard percent of size, useOrLose, and the source of the figure" :pit (record))
(:sym "PoolModel" :mod "aslGateway/balancer" :kind type :sig "(schema PoolModel (:f id String) (:f provider String) (:f tier Tier) (:f why String) (:f budgets (List String)) (:f costMicros Int64) (:f declaredQuality (Option Int64)))" :doc "a pool row: model id, provider, tier, why it is in the pool, the budget ids it draws on, expected microUSD per request and an optional declared quality" :pit (record))
(:sym "CalScore" :mod "aslGateway/balancer" :kind type :sig "(schema CalScore (:f model String) (:f intent String) (:f pass Int64) (:f total Int64) (:f source String))" :doc "a reused calibration result: model, intent, passes of total runs, and the CAL source id" :pit (record))
(:sym "Quality" :mod "aslGateway/balancer" :kind type :sig "(schema Quality (:f score Int64) (:f confidence Int64) (:f source String))" :doc "permille score and confidence of a model for an intent, with the source it came from (CAL ids, declared or prior)" :pit (record))
(:sym "Window" :mod "aslGateway/balancer" :kind type :sig "(schema Window (:f start Int64) (:f used Int64))" :doc "usage of one budget inside the window that starts at start" :pit (record))
(:sym "Policy" :mod "aslGateway/balancer" :kind type :sig "(schema Policy (:f mode Mode) (:f exploreEvery Int64) (:f softFactor Int64))" :doc "mode, exploreEvery (every n-th request goes to the least calibrated fitting model, 0 is off) and softFactor (permille scale applied past a soft line)" :pit (record))
(:sym "Balancer" :mod "aslGateway/balancer" :kind type :sig "(schema Balancer (:f models (List PoolModel)) (:f budgets (Map String Budget)) (:f cals (List CalScore)) (:f policy Policy) ; (:m :ref GW-BALANCER-CALAS :do \"per pool alias, the other names its calibration rows carry (worker model names in workerStats, CAL ids), from the model row calAs list\") (:f c ..." :doc "models, budgets by id, calibration rows and policy, and calAs: per alias the other names its calibration rows carry (model row :calAs list, e.g. worker model names in workerStats)" :pit (record))
(:sym "Request" :mod "aslGateway/balancer" :kind type :sig "(schema Request (:f seq Int64) (:f atMs Int64) (:f intent String) (:f tokens Int64))" :doc "one routing request: sequence number, time, intent and expected tokens" :pit (record))
(:sym "Pick" :mod "aslGateway/balancer" :kind type :sig "(enum Pick (:c picked [(model String) (score Int64) (quality Quality) (explore Bool)]) (:c refused [(reason String)]))" :doc "picked names the model, its score, quality and whether it was an exploration pick; refused names why")
(:sym "Replay" :mod "aslGateway/balancer" :kind type :sig "(schema Replay (:f use (Map String Window)) (:f picks (List Pick)) (:f overHard Int64))" :doc "usage after a replay, every pick in order, and how many budget-steps passed a hard cap (0 when the balancer holds)" :pit (record))
(:sym "BudgetRow" :mod "aslGateway/balancer" :kind type :sig "(schema BudgetRow (:f id String) (:f used Int64) (:f target Int64) (:f cap Int64) (:f projected Int64) (:f flag String))" :doc "report row per budget: used, pro-rata target, hard cap, projection to window end and flag under|ok|over" :pit (record))
(:sym "Scored" :mod "aslGateway/balancer" :kind type :sig "(schema Scored (:f model PoolModel) (:f score Int64) (:f quality Quality))" :doc "a fitting candidate with its score and quality" :pit (record))
(:sym "tierFree" :mod "aslGateway/balancer" :kind ctor :sig "(:c tierFree []) of Tier" :doc "free tier" :pit (ctor))
(:sym "tierSub" :mod "aslGateway/balancer" :kind ctor :sig "(:c tierSub []) of Tier" :doc "subscription tier" :pit (ctor))
(:sym "tierPaid" :mod "aslGateway/balancer" :kind ctor :sig "(:c tierPaid [])) of Tier" :doc "paid API tier" :pit (ctor))
(:sym "modeFree" :mod "aslGateway/balancer" :kind ctor :sig "(:c modeFree []) of Mode" :doc "free models only" :pit (ctor))
(:sym "modeSub" :mod "aslGateway/balancer" :kind ctor :sig "(:c modeSub []) of Mode" :doc "subscription models only" :pit (ctor))
(:sym "modePaid" :mod "aslGateway/balancer" :kind ctor :sig "(:c modePaid []) of Mode" :doc "paid models only" :pit (ctor))
(:sym "modeBalanced" :mod "aslGateway/balancer" :kind ctor :sig "(:c modeBalanced []) of Mode" :doc "every tier, score-based mix (default)" :pit (ctor))
(:sym "modeExplore" :mod "aslGateway/balancer" :kind ctor :sig "(:c modeExplore [])) of Mode" :doc "every tier, ranks by low confidence so calibration runs reach unmeasured models" :pit (ctor))
(:sym "picked" :mod "aslGateway/balancer" :kind ctor :sig "(:c picked [(model String) (score Int64) (quality Quality) (explore Bool)]) of Pick" :doc "the chosen model of a pick" :pit (ctor))
(:sym "refused" :mod "aslGateway/balancer" :kind ctor :sig "(:c refused [(reason String)])) of Pick" :doc "no admitted model fits under its hard caps, with the reason" :pit (ctor))
(:sym "parseTier" :mod "aslGateway/balancer" :sig "parseTier name: String -> (Result Tier String)" :doc "free|sub|paid to Tier, unknown is an error" :pit (result))
(:sym "parseMode" :mod "aslGateway/balancer" :sig "parseMode name: String -> (Result Mode String)" :doc "free|sub|paid|balanced|explore to Mode, unknown is an error" :pit (result))
(:sym "tierName" :mod "aslGateway/balancer" :sig "tierName tier: Tier -> String" :doc "tier as its config word")
(:sym "modeName" :mod "aslGateway/balancer" :sig "modeName mode: Mode -> String" :doc "mode as its config word")
(:sym "windowMsOf" :mod "aslGateway/balancer" :sig "windowMsOf name: String -> (Result Int64 String)" :doc "hour, 5h, day, week or month (30 days) in ms" :pit (result))
(:sym "tierAdmitted?" :mod "aslGateway/balancer" :sig "tierAdmitted? mode: Mode tier: Tier -> Bool" :doc "whether a mode admits a tier")
(:sym "defaultPolicy" :mod "aslGateway/balancer" :sig "defaultPolicy -> Policy" :doc "balanced, explore every 20th request, softFactor 100 permille")
(:sym "makeBalancer" :mod "aslGateway/balancer" :sig "makeBalancer models: (List PoolModel) budgets: (List Budget) cals: (List CalScore) policy: Policy -> Balancer" :doc "builds a Balancer, indexing budgets by id")
(:sym "windowStart" :mod "aslGateway/balancer" :sig "windowStart b: Budget nowMs: Int64 -> Int64" :doc "start of the window holding nowMs on the budget's anchor grid")
(:sym "budgetUsed" :mod "aslGateway/balancer" :sig "budgetUsed use: (Map String Window) b: Budget nowMs: Int64 -> Int64" :doc "usage of a budget in the current window, 0 when the stored window is older")
(:sym "hardCap" :mod "aslGateway/balancer" :sig "hardCap b: Budget -> Int64" :doc "size x hard percent: a pick that would pass it is refused")
(:sym "softCap" :mod "aslGateway/balancer" :sig "softCap b: Budget -> Int64" :doc "size x soft percent: past it load shifts away")
(:sym "pacingFactor" :mod "aslGateway/balancer" :sig "pacingFactor b: Budget used: Int64 nowMs: Int64 softFactor: Int64 -> Int64" :doc "permille pacing of one budget: squared ratio of pro-rata target to use, raised only for use-or-lose quotas, scaled by softFactor past the soft line (absolute soft cap or ahead of hard pro-rata) except late in a use-or-lose window, x1.5 for ...")
(:sym "modelPacing" :mod "aslGateway/balancer" :sig "modelPacing bal: Balancer use: (Map String Window) m: PoolModel nowMs: Int64 -> Int64" :doc "tightest pacing factor over a model's budgets, 1000 when it has none")
(:sym "qualityFor" :mod "aslGateway/balancer" :sig "qualityFor bal: Balancer m: PoolModel intent: String -> Quality" :doc "quality from intent CAL rows, else any-intent CAL rows (shrunk toward the tier prior by two pseudo-runs, confidence n/(n+4)), else declared (confidence 250), else tier prior (confidence 100)")
(:sym "tierPrior" :mod "aslGateway/balancer" :sig "tierPrior tier: Tier -> Int64" :doc "neutral prior score by tier: free 450, sub 600, paid 600 permille (adopted 2026-10-27, no measurement)")
(:sym "parseCalScores" :mod "aslGateway/balancer" :sig "parseCalScores text: String -> (List CalScore)" :doc "reads saved (:cal :id :intent :scores ((model pass total ...))) rows such as CAL/freeModels.asn into CalScore rows, skipping what it cannot read")
(:sym "parseBalancer" :mod "aslGateway/balancer" :sig "parseBalancer form: rd/SExpr cals: (List CalScore) -> (Result Balancer String)" :doc "reads the loaded (:gateway ...) form: model rows with optional why tier budgets costMicros quality, and an optional (:balancer :mode :exploreEvery :softFactor :budgets) section" :pit (result))
(:sym "emptyUse" :mod "aslGateway/balancer" :sig "emptyUse -> (Map String Window)" :doc "usage with no window recorded")
(:sym "chargeUse" :mod "aslGateway/balancer" :sig "chargeUse bal: Balancer use: (Map String Window) modelId: String atMs: Int64 tokens: Int64 -> (Map String Window)" :doc "charges one request of a model to each of its budgets")
(:sym "usageFromCalls" :mod "aslGateway/balancer" :sig "usageFromCalls bal: Balancer rows: (List ul/CallRow) -> (Map String Window)" :doc "rebuilds window usage from recorded gateway call rows by alias")
(:sym "scoreOf" :mod "aslGateway/balancer" :sig "scoreOf bal: Balancer use: (Map String Window) m: PoolModel req: Request -> Scored" :doc "pacing x tier weight x quality / (cost + 1000 microUSD floor); explore mode uses 1000 - confidence as quality")
(:sym "pick" :mod "aslGateway/balancer" :sig "pick bal: Balancer use: (Map String Window) req: Request -> Pick" :doc "routes one request: mode filter, hard-cap fit, then best score or the exploration pick")
(:sym "replay" :mod "aslGateway/balancer" :sig "replay bal: Balancer use: (Map String Window) reqs: (List Request) -> Replay" :doc "routes and charges a request list in order; deterministic for a fake clock")
(:sym "budgetRows" :mod "aslGateway/balancer" :sig "budgetRows bal: Balancer use: (Map String Window) nowMs: Int64 -> (List BudgetRow)" :doc "one report row per budget at nowMs")
(:sym "budgetRowLine" :mod "aslGateway/balancer" :sig "budgetRowLine r: BudgetRow -> String" :doc "a BudgetRow as one (:budgetRow ...) ASN line")
(:sym "blockingBudgets" :mod "aslGateway/balancer" :sig "blockingBudgets bal: Balancer use: (Map String Window) req: Request -> (List String)" :doc "ids of the budgets that keep the mode's admitted models from fitting a request, each once")
(:sym "Pool" :mod "aslGateway/balancer" :kind type :sig "(schema Pool (:f bal Balancer) (:f use (Map String Window)) (:f targets (Map String (Pair String String))) (:f seq Int64) ; (:m :ref GW-BALANCER-CASCADE :do \"a pool alias whose last call failed sits out until failedUntil, so the chat cascade retry after a failure reaches another model; when every mo ..." :doc "the balancer as dispatch holds it: balancer, window usage, alias to (provider, upstream model name), and the count of charged requests" :pit (record))
(:sym "loadPool!" :mod "aslGateway/balancer" :kind fn! :sig "loadPool! text: String table: (Option cfg/GatewayTable) home: String routable: (fn [String] -> Bool) -> (Result (Option Pool) String)" :doc "GW-BALANCER-WIRE: none without a (:balancer ...) section; else reads CAL files (:cal, default .asl/mem/work/CAL/freeModels.asn and .asl/mem/work/SH/workerStats.asn graded runs, a missing file is skipped), keeps only models whose provider di..." :pit (effect))
(:sym "poolFromParts" :mod "aslGateway/balancer" :sig "poolFromParts bal: Balancer use: (Map String Window) targets: (Map String (Pair String String)) -> Pool" :doc "builds a Pool from a balancer, usage and targets, dropping models without a target")
(:sym "poolRequest" :mod "aslGateway/balancer" :sig "poolRequest pool: Pool intent: String atMs: Int64 tokens: Int64 -> Request" :doc "the balancer Request for a dispatch: next sequence number, intent (any when empty), expected tokens")
(:sym "poolPick" :mod "aslGateway/balancer" :sig "poolPick pool: Pool req: Request -> Pick" :doc "the dispatch pick: bl/pick over the pool http lanes and current usage, never a cli or gateway lane")
(:sym "poolCharge" :mod "aslGateway/balancer" :sig "poolCharge pool: Pool alias: String atMs: Int64 tokens: Int64 -> Pool" :doc "charges one request of a pool alias to its windows and advances the sequence; other ids leave the pool unchanged")
(:sym "poolTarget" :mod "aslGateway/balancer" :sig "poolTarget pool: Pool alias: String -> (Option (Pair String String))" :doc "provider and upstream model name of a pool alias" :pit (option))
(:sym "pickWhy" :mod "aslGateway/balancer" :sig "pickWhy pool: Pool req: Request p: Pick -> String" :doc "the pick's score parts as one (:balancer ...) form for the route receipt")
(:sym "refusalText" :mod "aslGateway/balancer" :sig "refusalText pool: Pool req: Request reason: String -> String" :doc "the 429 reason: (:balancer :refused :mode M :budgets (ids) :reason text)")
(:sym "poolFailed" :mod "aslGateway/balancer" :sig "poolFailed pool: Pool alias: String nowMs: Int64 -> Pool" :doc "GW-BALANCER-CASCADE: rests a pool alias until nowMs + cooldownMs (balancer :failCooldownMs, default 60000) after a failed call, so poolPick skips it unless every model rests")
(:sym "Observed" :mod "aslGateway/balancer" :kind type :sig "(schema Observed (:f remaining Int64) (:f resetAtMs Int64) (:f atMs Int64) (:f exhausted Bool))" :doc "GW-BALANCER-LIVE-QUOTA: what a provider reported for one budget: remaining in the budget unit, reset time (0 unknown), when it was seen, and whether a 429 exhausted it" :pit (record))
(:sym "RateObs" :mod "aslGateway/balancer" :kind type :sig "(schema RateObs (:f unit String) (:f remaining Int64) (:f resetAtMs Int64))" :doc "one rate-limit header reading: unit req|tok, remaining, absolute reset ms (0 unknown)" :pit (record))
(:sym "parseDurationMs" :mod "aslGateway/balancer" :sig "parseDurationMs s: String -> (Option Int64)" :doc "reads OpenAI/Groq reset durations (1s, 6m0s, 2m59.56s, 120ms, 1h2m3s) and bare seconds into ms" :pit (option))
(:sym "parseRfc3339Ms" :mod "aslGateway/balancer" :sig "parseRfc3339Ms s: String -> (Option Int64)" :doc "reads a UTC RFC 3339 time (Z or +00:00, optional fraction) into epoch ms; other offsets are none" :pit (option))
(:sym "parseRateHeaders" :mod "aslGateway/balancer" :sig "parseRateHeaders headers: (List (Pair String String)) nowMs: Int64 -> (List RateObs)" :doc "rate-limit rows from x-ratelimit-remaining/reset-requests|tokens (OpenAI, Groq) or anthropic-ratelimit-requests|tokens-remaining/reset, header names case-insensitive")
(:sym "retryAfterMs" :mod "aslGateway/balancer" :sig "retryAfterMs headers: (List (Pair String String)) nowMs: Int64 -> (Option Int64)" :doc "the Retry-After delay in ms: delay-seconds, or an IMF-fixdate HTTP-date taken against nowMs, a past date being 0" :pit (option))
(:sym "poolObserve" :mod "aslGateway/balancer" :sig "poolObserve pool: Pool alias: String status: Int64 headers: (List (Pair String String)) nowMs: Int64 -> Pool" :doc "applies one upstream reply: a 429 exhausts every budget of the model until retry-after, the reported reset or the window end; otherwise header-sourced budgets take the remaining of their unit")
(:sym "poolObserveEndpoint" :mod "aslGateway/balancer" :sig "poolObserveEndpoint pool: Pool budgetId: String body: String nowMs: Int64 -> (Result Pool String)" :doc "applies an OpenRouter-shaped status body (/key limit_remaining or /credits total_credits - total_usage, USD) to an endpoint-sourced usd budget; other bodies or budgets are errors" :pit (result))
(:sym "effectiveUse" :mod "aslGateway/balancer" :sig "effectiveUse pool: Pool nowMs: Int64 -> (Map String Window)" :doc "ledger usage raised to what providers report (size - remaining, or hard cap while exhausted) for live observations of the current window; poolPick, pickWhy and refusalText route on it")
(:sym "poolPickLanes" :mod "aslGateway/balancer" :sig "poolPickLanes pool: Pool req: Request lanes: (List String) -> Pick" :doc "bl/pick over the pool models of the given lanes (http, cli, gateway); budgets are shared across lanes so a CLI and an HTTP call on one subscription pace each other")
(:sym "laneOf" :mod "aslGateway/balancer" :sig "laneOf pool: Pool alias: String -> String" :doc "the lane serving a pool alias: http, cli or gateway; an alias with no entry is http")
(:sym "laneFor" :mod "aslGateway/balancer" :sig "laneFor kind: String routable: Bool instance: String -> (Option String)" :doc "the lane of a provider kind on an instance: cli only on a local instance, gateway for a federation row, http when dispatch can send to it, else none" :pit (option))
(:sym "Poll" :mod "aslGateway/balancer" :kind type :sig "(schema Poll (:f budget String) (:f provider String) (:f url String) (:f everyMs Int64))" :doc "a status endpoint refreshing an endpoint usd budget: budget id, provider whose key the request carries, url (provider base plus :path) and everyMs, at least a minute" :pit (record))
(:sym "pollsDue" :mod "aslGateway/balancer" :sig "pollsDue pool: Pool nowMs: Int64 -> (List Poll)" :doc "the status polls to send now: budgets a pool model draws on whose last poll is at least everyMs ago")
(:sym "poolPolled" :mod "aslGateway/balancer" :sig "poolPolled pool: Pool budgetId: String nowMs: Int64 -> Pool" :doc "marks a status poll as sent at nowMs, before the request goes out, so a slow reply is never polled twice")
(:sym "poolPollReply" :mod "aslGateway/balancer" :sig "poolPollReply pool: Pool budgetId: String status: Int64 body: String nowMs: Int64 -> (Pair Pool String)" :doc "applies a status reply: 200 feeds poolObserveEndpoint, 429 backs off to four intervals, other statuses keep the last observation; the string is empty on success, else the reason")
(:sym "parseHttpDateMs" :mod "aslGateway/balancer" :sig "parseHttpDateMs s: String -> (Option Int64)" :doc "an IMF-fixdate (Wed, 21 Oct 2015 07:28:00 GMT) as epoch ms; RFC 850, asctime and non-GMT zones are none" :pit (option))
(:sym "urlHost" :mod "aslGateway/balancer" :sig "urlHost url: String -> String" :doc "the host of a url: scheme, userinfo, port and path dropped, an IPv6 literal unbracketed")
(:sym "deriveInstance" :mod "aslGateway/balancer" :sig "deriveInstance sec: (Map String rd/SExpr) table: (Option cfg/GatewayTable) home: String -> (Pair String String)" :doc "the balancer instance (local or remote) and a note naming the rule: explicit :instance wins, any :kind gateway row makes it a satellite (remote), no HOME is remote, otherwise local; loadPool! puts the note first in pool.notes")
(:sym "Hold" :mod "aslGateway/balancer" :kind type :sig "(schema Hold (:f alias String) (:f atMs Int64) (:f tokens Int64))" :doc "a planned, unsettled request holding its estimated charge on a pool alias since atMs" :pit (record))
(:sym "poolReserve" :mod "aslGateway/balancer" :sig "poolReserve pool: Pool alias: String atMs: Int64 tokens: Int64 -> Pool" :doc "adds a hold of the estimated charge for a pool alias at plan time; effectiveUse counts live holds, so concurrent picks cannot overrun a hard budget; a non-pool alias holds nothing")
(:sym "poolRelease" :mod "aslGateway/balancer" :sig "poolRelease pool: Pool alias: String -> Pool" :doc "drops the oldest hold of an alias; settle calls it before charging the actual, so a lower actual frees the difference; unreleased holds lapse after 10 minutes")
(:sym "poolAliasesFor" :mod "aslGateway/balancer" :sig "poolAliasesFor pool: Pool provider: String model: String -> (List String)" :doc "the http pool aliases serving one upstream provider and model name, the aliases a request already naming that model asks for")
(:sym "poolHonour" :mod "aslGateway/balancer" :sig "poolHonour pool: Pool req: Request ids: (List String) -> Pick" :doc "picks among the asked aliases only; refused, with the reason, when each one is exhausted by its provider, resting after a failure, outside the mode or at its hard cap")
(:sym "modelKey" :mod "aslGateway/balancer" :sig "modelKey name: String -> String" :doc "a model name without a trailing reasoning-effort suffix (:minimal :low :medium :high :xhigh); other suffixes such as :free stay part of the name")
(:sym "poolReleaseAt" :mod "aslGateway/balancer" :sig "poolReleaseAt pool: Pool alias: String nowMs: Int64 -> Pool" :doc "prunes holds lapsed at nowMs, then drops the oldest live hold of the alias; poolRelease is the same with the newest hold time as its clock")
(:sym "deriveInstanceWithRoles" :mod "aslGateway/balancer" :sig "deriveInstanceWithRoles sec: (Map String rd/SExpr) table: (Option cfg/GatewayTable) home: String roles: (Map String String) -> (Pair String String)" :doc "deriveInstance with the :role of each gateway provider row: :role outward rows (this host federating out) leave the instance local, :role satellite or unmarked gateway rows make it remote; loadPool! reads the roles from the raw gateway form")
(:sym "PoolConfig" :mod "aslGateway/batchPool" :kind type :sig "(schema PoolConfig (:f windowMs Int64) (:f peakCount Int64) (:f bypassWhileBusy Bool) (:f requestTimeoutMs Int64))" :pit (record))
(:sym "PoolRequest" :mod "aslGateway/batchPool" :kind type :sig "(schema PoolRequest (:f requestId Int64) (:f payload String) (:f arrivedAt Int64))" :pit (record))
(:sym "PoolBatch" :mod "aslGateway/batchPool" :kind type :sig "(schema PoolBatch (:f batchId Int64) (:f requests (List PoolRequest)))" :pit (record))
(:sym "PoolState" :mod "aslGateway/batchPool" :kind type :sig "(schema PoolState (:f config PoolConfig) (:f queued (List PoolRequest)) (:f inFlight (List PoolBatch)) (:f nextBatchId Int64) (:f scaleDownEmitted Bool))" :pit (record))
(:sym "PoolError" :mod "aslGateway/batchPool" :kind type :sig "(enum PoolError (:c requestTimedOut [(requestId Int64)]) (:c batchRejected [(reason String)]))")
(:sym "PoolEvent" :mod "aslGateway/batchPool" :kind type :sig "(enum PoolEvent (:c arrive [(request PoolRequest)]) (:c tick []) (:c batchDone [(batchId Int64) (response String)]) (:c batchFailed [(batchId Int64) (reason String)]))")
(:sym "PoolAction" :mod "aslGateway/batchPool" :kind type :sig "(enum PoolAction (:c dispatch [(batch PoolBatch)]) (:c reply [(requestId Int64) (result (Result String PoolError))]) (:c scaleDown []))")
(:sym "PoolStep" :mod "aslGateway/batchPool" :kind type :sig "(schema PoolStep (:f state PoolState) (:f actions (List PoolAction)))" :pit (record))
(:sym "defaultPoolConfig" :mod "aslGateway/batchPool" :sig "defaultPoolConfig -> PoolConfig")
(:sym "makePoolConfig" :mod "aslGateway/batchPool" :sig "makePoolConfig windowMs: Int64 peakCount: Int64 bypassWhileBusy: Bool requestTimeoutMs: Int64 -> PoolConfig")
(:sym "defaultPoolState" :mod "aslGateway/batchPool" :sig "defaultPoolState -> PoolState")
(:sym "poolStep" :mod "aslGateway/batchPool" :sig "poolStep state: PoolState event: PoolEvent nowMs: Int64 -> PoolStep")
(:sym "poolStateQueued" :mod "aslGateway/batchPool" :sig "poolStateQueued state: PoolState -> Int64")
(:sym "poolStateInFlightCount" :mod "aslGateway/batchPool" :sig "poolStateInFlightCount state: PoolState -> Int64")
(:sym "poolActionReplyCount" :mod "aslGateway/batchPool" :sig "poolActionReplyCount actions: (List PoolAction) -> Int64")
(:sym "poolActionDispatchCount" :mod "aslGateway/batchPool" :sig "poolActionDispatchCount actions: (List PoolAction) -> Int64")
(:sym "poolActionScaleDownCount" :mod "aslGateway/batchPool" :sig "poolActionScaleDownCount actions: (List PoolAction) -> Int64")
(:sym "BMsg" :mod "aslGateway/binding" :kind type :sig "(schema BMsg (:f role String) (:f text String))" :doc "a delivered message: role and text (tool_calls and tool_call_id included in text)" :pit (record))
(:sym "BindPlan" :mod "aslGateway/binding" :kind type :sig "(schema BindPlan (:f resume Bool) (:f why String) (:f id String) (:f prompt String))" :doc "decision result: resume flag, why, vendor session id to resume and the prompt to send" :pit (record))
(:sym "bindDigest" :mod "aslGateway/binding" :sig "bindDigest msgs: (List BMsg) -> String" :doc "sha256 of a message list, each role and text length-prefixed so no text can imitate a boundary")
(:sym "bindCtxDigest" :mod "aslGateway/binding" :sig "bindCtxDigest sysText: String cwd: String -> String" :doc "sha256 of the length-prefixed system prompt text and cwd a binding was started under; a different value forces a replay (contextChanged)")
(:sym "bindRender" :mod "aslGateway/binding" :sig "bindRender msgs: (List BMsg) -> String" :doc "renders messages as the vendor prompt: one user message bare, otherwise role-labelled blocks")
(:sym "bindDecide" :mod "aslGateway/binding" :sig "bindDecide row: (Option s/SessRow) vendor: String model: String ctxDigest: String msgs: (List BMsg) now: Int64 ttl: Int64 -> BindPlan" :doc "resume decision for a binding row: resume only when vendor, model, context digest, TTL and delivered-prefix digest all match, else a replay naming why")
(:sym "boundChat!" :mod "aslGateway/binding" :kind fn! :sig "boundChat! ctx: s/SessCtx key: String vendor: String model: String msgs: (List BMsg) -> String" :doc "blocking bound turn rendered as an ASN receipt" :pit (effect))
(:sym "boundChatBody!" :mod "aslGateway/binding" :kind fn! :sig "boundChatBody! ctx: s/SessCtx vendor: String headerKey: String body: String -> String" :doc "bound turn from a chat request body and header key; the key is header then body session, never body user" :pit (effect))
(:sym "boundTurn!" :mod "aslGateway/binding" :kind fn! :sig "boundTurn! ctx: s/SessCtx key: String vendor: String model: String msgs: (List BMsg) policy: (List String) cwdIn: String modelFlags: Bool -> (Result BoundOut String)" :doc "blocking bound turn with explicit policy args" :pit (result effect))
(:sym "boundTurnWith!" :mod "aslGateway/binding" :kind fn! :sig "boundTurnWith! ctx: s/SessCtx key: String vendor: String model: String msgs: (List BMsg) policy: (List String) cwdIn: String modelFlags: Bool sysText: String sanitize: Bool tmpDir: String -> (Result BoundOut String)" :doc "blocking bound turn with system text, sanitize flag and temp dir" :pit (result effect))
(:sym "boundBegin!" :mod "aslGateway/binding" :kind fn! :sig "boundBegin! ctx: s/SessCtx key: String vendor: String model: String msgs: (List BMsg) policy: (List String) cwdIn: String modelFlags: Bool sysText: String sanitize: Bool tmpDir: String -> BoundStart" :doc "starts a bound turn: takes the binding lock, decides resume or replay and spawns the vendor without waiting; failures return boundDone" :pit (effect))
(:sym "boundAdvance!" :mod "aslGateway/binding" :kind fn! :sig "boundAdvance! p: BoundPend -> (Pair (Option (Result BoundOut String)) BoundPend)" :doc "steps a parked bound turn once without blocking; returns the finished result when the vendor has ended, else the updated pending turn" :pit (effect))
(:sym "boundFds" :mod "aslGateway/binding" :sig "boundFds p: BoundPend -> (List (Pair Int64 Int64))" :doc "pipe fds a pending bound turn waits on")
(:sym "BoundPend" :mod "aslGateway/binding" :kind type :sig "(schema BoundPend (:f ctx s/SessCtx) (:f name String) (:f token String) (:f vendor String) (:f model String) (:f msgs (List BMsg)) (:f resume Bool) (:f why String) (:f row (Option s/SessRow)) (:f cwd String) (:f baseArgs (List String)) (:f ctxDigest String) (:f promptBytes Int64) (:f t0 Int64) (:f r ..." :doc "a bound turn in flight: lock token, plan, running vendor, temp dir" :pit (record))
(:sym "BoundStart" :mod "aslGateway/binding" :kind type :sig "(enum BoundStart (:c boundDone [(res (Result BoundOut String))]) (:c boundRunning [(p BoundPend)]))" :doc "start result of a bound turn: boundDone or boundRunning")
(:sym "boundDone" :mod "aslGateway/binding" :kind ctor :sig "(:c boundDone [(res (Result BoundOut String))]) of BoundStart" :doc "BoundStart constructor: finished or refused at once" :pit (ctor))
(:sym "boundRunning" :mod "aslGateway/binding" :kind ctor :sig "(:c boundRunning [(p BoundPend)])) of BoundStart" :doc "BoundStart constructor: vendor running" :pit (ctor))
(:sym "BoundOut" :mod "aslGateway/binding" :kind type :sig "(schema BoundOut (:f text String) (:f resumed Bool) (:f why String) (:f sessionId String) (:f turns Int64) (:f name String) (:f inTok Int64) (:f outTok Int64) (:f usage String) (:f totalIn Int64) (:f totalOut Int64))" :doc "finished bound turn: reply text, resumed, why, vendor session id, turns, usage" :pit (record))
(:sym "boundCliEligible?" :mod "aslGateway/binding" :sig "boundCliEligible? ctx: s/SessCtx client: String args: (List (Pair String j/Json)) -> Bool" :doc "true when the effect carries a caller key and the client is in the sessions allowlist")
(:sym "boundCliEffect!" :mod "aslGateway/binding" :kind fn! :sig "boundCliEffect! ctx: s/SessCtx client: String args: (List (Pair String j/Json)) -> (Option ch/CliReply)" :doc "live chat entry for bindings: chat.asl cliDispatch adds :session (caller key), :messages and :sanitize to the effCli arguments only when the request has a caller key; server.asl drive! serves such an effect when the client is in the session..." :pit (option effect))
(:sym "BoundCli" :mod "aslGateway/binding" :kind type :sig "(enum BoundCli (:c boundCliNow [(reply (Option ch/CliReply))]) (:c boundCliRunning [(p BoundPend)]))" :doc "start result of a bound CLI effect: boundCliNow with the reply or none, or boundCliRunning with the pending turn")
(:sym "boundCliNow" :mod "aslGateway/binding" :kind ctor :sig "(:c boundCliNow [(reply (Option ch/CliReply))]) of BoundCli" :doc "BoundCli constructor: finished immediately" :pit (ctor))
(:sym "boundCliRunning" :mod "aslGateway/binding" :kind ctor :sig "(:c boundCliRunning [(p BoundPend)])) of BoundCli" :doc "BoundCli constructor: vendor running, turn pending" :pit (ctor))
(:sym "boundCliBegin!" :mod "aslGateway/binding" :kind fn! :sig "boundCliBegin! ctx: s/SessCtx client: String args: (List (Pair String j/Json)) -> BoundCli" :doc "starts a bound CLI effect with the dispatch policy flags (cliBoundFlags!) without waiting" :pit (effect))
(:sym "boundCliFinish" :mod "aslGateway/binding" :sig "boundCliFinish r: (Result BoundOut String) ms: Int64 -> (Option ch/CliReply)" :doc "turns a finished bound result into the chat CliReply (none on failure)" :pit (option))
