(:sym "rowsFromTable" :mod "aslGateway/dispatch" :sig "rowsFromTable table: (Option c/GatewayTable) -> (List u/UpstreamProvider)" :doc "config.asl merges its built-in providers into every table from the process env, so built-in ids keep the settings-based default rows; config-only ids become rows ahead of them")
(:sym "pluginsFromRows" :mod "aslGateway/dispatch" :kind fn! :sig "pluginsFromRows rows: (List u/UpstreamProvider) st: u/UpstreamSettings redirects: (Map String Int64) -> (Result (List p/Plugin) String)" :doc "a provider row may declare :redirectAfterSec; its plugin then follows that provider's 303s (a row capability, no provider-name branch)" :pit (result effect))
