(:sym "resolveProviderCredential!" :mod "aslGateway/config" :kind fn! :sig "resolveProviderCredential! secretsPath: String keyFiles: (List String) secret: String keyEnv: String -> (Result (Option String) String)" :doc "credential of a provider: its :secret from the secrets file wins and never falls back to env; without :secret it is resolveProviderKey! (key files, then env); errors are ASN receipts naming ids" :pit (result effect))
