(:sym "wiringFromConfig" :mod "aslGateway/dispatch" :kind fn! :sig "wiringFromConfig table: (Option c/GatewayTable) text: String st: u/UpstreamSettings env: (Map String String) families: (List LifecycleFamily) -> (Result Wiring String)" :pit (result effect))
(:sym "parseWiring" :mod "aslGateway/dispatch" :sig "parseWiring text: String -> (Result WiringConfig String)" :doc "every wiring key is optional: absent keys mean passthrough routing, no fleet endpoints and no budget" :pit (result))
(:sym "httpFamily" :mod "aslGateway/dispatch" :kind fn! :sig "httpFamily -> LifecycleFamily" :pit (effect))
(:sym "builtinFamilies" :mod "aslGateway/dispatch" :kind fn! :sig "builtinFamilies -> (List LifecycleFamily)" :pit (effect))
