(:know :tier L0g :group "frontend" :cards 14 :tokensBy bytes36)
(:c "asl-checker" "Semantic Type Checker" (checkModule checkModuleIn))
(:c "asl-codegen" "Rust and ISO C99 Codegen..." (emitDefschema emitDefenum))
(:c "asl-compiler" "Compiler Toolchain" (compileSourceToC99 formatDiagnostic))
(:c "asl-conform" "Multi-Target Semantic..." (loadTargetSemantics runConformCase!))
(:c "asl-derive" "Schema, Codec, and..." (makeField makeRecordSchema))
(:c "asl-foreign" "Typed first-class inline..." (js py))
(:c "asl-forms" "Agent-plane forms kernel..." (runPayload! runPayloadText!))
(:c "asl-grammar" "The single ASL grammar..." (grammarParse grammarBuild))
(:c "asl-ir" "Typed Monomorphic ANF..." (lowerModule verifyIr))
(:c "asl-lint" "Quality, Smell, and..." (isError severityPenalty))
(:c "asl-parser" "S-Expression Lexer,..." (makeToken tokenKind))
(:c "asl-syntax" "Lossless syntax trees,..." (makeSource sourceFromBytes))
(:c "asl-tokenizer" "o200k_base BPE token..." (loadTokenizer! countTokens!))
(:c "asl-transpile" "Multi-Target AST..." (makeKv renderJson))
