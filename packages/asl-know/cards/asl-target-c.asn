(:card "asl-target-c" :purpose "Standalone C11 Backend consuming verified asl-ir with Address/Undefined Sanitizer support under ADR D93" :import "(asl-target-c :a x)" :deps (asl-ir) :modules ((:m "asl-target-c" :doc "Standalone C11 backend consuming verified asl-ir with Ad...") (:m "asl-target-c/emit" :doc "Clean C11 backend emitter consuming verified asl-ir unde...") (:m "asl-target-c/types" :doc "C11 backend type mapping, closure environment synthesis,...")) :sigs ("emitC11Module m: irTy/IrModule -> (Result Str (List irTy/IrDiag))" "emitC11Type t: irTy/IrType -> Str" "emitC11Block stmts: (List irTy/IrStmt) -> Str" "emitC11Closure name: Str envFields: (List Str) -> Str" "emitC11Panic code: Int64 msg: Str -> Str" "emitC11StandaloneCase caseId: Str -> Str" "emitC11Source src: Str path: Str -> (Result Str Str)" "emitC11SourceWith src: Str preludeSrc: Str path: Str -> (Result Str Str)" "emitC11Stmt stmt: irTy/IrStmt -> Str" "emitC11Expr expr: irTy/IrExpr -> Str" "c11SMainWrapper m: irTy/SsaModule f: irTy/SsaFunction -> Str") :more (emitC11Type) :fails (emitC11Module emitC11Source emitC11SourceWith) :example none)
(:sym "emitC11Module" :mod "asl-target-c" :sig "emitC11Module m: irTy/IrModule -> (Result Str (List irTy/IrDiag))" :doc "Emits C11 source code for a complete IR module." :pit (result))
(:sym "emitC11Type" :mod "asl-target-c" :sig "emitC11Type t: irTy/IrType -> Str" :doc "Emits the C11 type name corresponding to an IR type.")
(:sym "emitC11Block" :mod "asl-target-c" :sig "emitC11Block stmts: (List irTy/IrStmt) -> Str" :doc "Emits a sequential block of C11 statements.")
(:sym "emitC11Closure" :mod "asl-target-c" :sig "emitC11Closure name: Str envFields: (List Str) -> Str" :doc "Emits a C11 environment typedef struct for a closure.")
(:sym "emitC11Panic" :mod "asl-target-c" :sig "emitC11Panic code: Int64 msg: Str -> Str" :doc "Emits C11 code to print a panic error message and exit.")
(:sym "emitC11StandaloneCase" :mod "asl-target-c" :sig "emitC11StandaloneCase caseId: Str -> Str" :doc "Emits C11 standalone code for a specific runtime test case.")
(:sym "emitC11Source" :mod "asl-target-c" :sig "emitC11Source src: Str path: Str -> (Result Str Str)" :doc "Translates ASL source text into C11 source code." :pit (result))
(:sym "emitC11SourceWith" :mod "asl-target-c" :sig "emitC11SourceWith src: Str preludeSrc: Str path: Str -> (Result Str Str)" :doc "Translates ASL source text into C11 source code, linking the prelude functions it reaches from preludeSrc." :pit (result))
(:sym "emitC11Module" :mod "asl-target-c/emit" :sig "emitC11Module m: irTy/IrModule -> (Result Str (List irTy/IrDiag))" :doc "Verifies and emits C11 source code for a complete IR module." :pit (result))
(:sym "emitC11Block" :mod "asl-target-c/emit" :sig "emitC11Block stmts: (List irTy/IrStmt) -> Str" :doc "Emits a sequence of C11 statements from an IR statement list.")
(:sym "emitC11Stmt" :mod "asl-target-c/emit" :sig "emitC11Stmt stmt: irTy/IrStmt -> Str" :doc "Emits C11 source code for a single IR statement.")
(:sym "emitC11Expr" :mod "asl-target-c/emit" :sig "emitC11Expr expr: irTy/IrExpr -> Str" :doc "Emits C11 expression source code for an IR expression.")
(:sym "emitC11StandaloneCase" :mod "asl-target-c/emit" :sig "emitC11StandaloneCase caseId: Str -> Str" :doc "Emits a self-contained C11 test program for a specific runtime case.")
(:sym "emitC11Source" :mod "asl-target-c/emit" :sig "emitC11Source src: Str path: Str -> (Result Str Str)" :doc "Compiles ASL source to a standalone C11 program: lowers to the asl-ir SSA contract (asl-ir/lower lowerSource), verifies it (asl-ir/verify verifySsa), and emits C11 calling the same asl_rt_* runtime ABI asl-target-llvm/ssa targets, linkable ..." :pit (result))
(:sym "emitC11SourceWith" :mod "asl-target-c/emit" :sig "emitC11SourceWith src: Str preludeSrc: Str path: Str -> (Result Str Str)" :doc "emitC11Source over asl-ir/link lowerSourceWith: the prelude functions the module reaches, transitively, are lowered from preludeSrc into the program." :pit (result))
(:sym "c11SMainWrapper" :mod "asl-target-c/emit" :sig "c11SMainWrapper m: irTy/SsaModule f: irTy/SsaFunction -> Str" :doc "Emits the C int main(...) wrapper that inits the runtime, calls the module's entry function with or without argv, and converts its result to a process exit code.")
(:sym "emitC11Type" :mod "asl-target-c/types" :sig "emitC11Type ty: irTy/IrType -> Str" :doc "Maps an IR type to its C11 type name representation.")
(:sym "emitC11Closure" :mod "asl-target-c/types" :sig "emitC11Closure name: Str envFields: (List Str) -> Str" :doc "Emits a C11 environment struct definition for a closure.")
(:sym "emitC11Panic" :mod "asl-target-c/types" :sig "emitC11Panic code: Int64 msg: Str -> Str" :doc "Emits a C11 statement that prints a panic message to stderr and exits.")
