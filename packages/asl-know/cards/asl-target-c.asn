(:card "asl-target-c" :purpose "Standalone C11 Backend consuming verified asl-ir with Address/Undefined Sanitizer support under ADR D93" :import "(asl-target-c :a x)" :deps (asl-ir) :modules ((:m "asl-target-c" :doc "Standalone C11 backend consuming verified asl-ir with Ad...") (:m "asl-target-c/emit") (:m "asl-target-c/types")) :sigs ("emitC11Module m: irTy/IrModule -> (Result Str (List irTy/IrDiag))" "emitC11Type t: irTy/IrType -> Str" "emitC11Block stmts: (List irTy/IrStmt) -> Str" "emitC11Closure name: Str envFields: (List Str) -> Str" "emitC11Panic code: Int64 msg: Str -> Str" "emitC11StandaloneCase caseId: Str -> Str" "emitC11Source src: Str path: Str -> (Result Str Str)" "emitC11SourceWith src: Str preludeSrc: Str path: Str -> (Result Str Str)" "emitC11Stmt stmt: irTy/IrStmt -> Str" "emitC11Expr expr: irTy/IrExpr -> Str" "c11SMainWrapper m: irTy/SsaModule f: irTy/SsaFunction -> Str") :more (emitC11Type) :fails (emitC11Module emitC11Source emitC11SourceWith) :example none)
(:sym "emitC11Module" :mod "asl-target-c" :sig "emitC11Module m: irTy/IrModule -> (Result Str (List irTy/IrDiag))" :pit (result))
(:sym "emitC11Type" :mod "asl-target-c" :sig "emitC11Type t: irTy/IrType -> Str")
(:sym "emitC11Block" :mod "asl-target-c" :sig "emitC11Block stmts: (List irTy/IrStmt) -> Str")
(:sym "emitC11Closure" :mod "asl-target-c" :sig "emitC11Closure name: Str envFields: (List Str) -> Str")
(:sym "emitC11Panic" :mod "asl-target-c" :sig "emitC11Panic code: Int64 msg: Str -> Str")
(:sym "emitC11StandaloneCase" :mod "asl-target-c" :sig "emitC11StandaloneCase caseId: Str -> Str" :doc "Emits C11 standalone code for a specific runtime test case.")
(:sym "emitC11Source" :mod "asl-target-c" :sig "emitC11Source src: Str path: Str -> (Result Str Str)" :pit (result))
(:sym "emitC11SourceWith" :mod "asl-target-c" :sig "emitC11SourceWith src: Str preludeSrc: Str path: Str -> (Result Str Str)" :doc "Translates ASL source text into C11 source code, linking the prelude functions it reaches from preludeSrc." :pit (result))
(:sym "emitC11Module" :mod "asl-target-c/emit" :sig "emitC11Module m: irTy/IrModule -> (Result Str (List irTy/IrDiag))" :pit (result))
(:sym "emitC11Block" :mod "asl-target-c/emit" :sig "emitC11Block stmts: (List irTy/IrStmt) -> Str")
(:sym "emitC11Stmt" :mod "asl-target-c/emit" :sig "emitC11Stmt stmt: irTy/IrStmt -> Str")
(:sym "emitC11Expr" :mod "asl-target-c/emit" :sig "emitC11Expr expr: irTy/IrExpr -> Str")
(:sym "emitC11StandaloneCase" :mod "asl-target-c/emit" :sig "emitC11StandaloneCase caseId: Str -> Str")
(:sym "emitC11Source" :mod "asl-target-c/emit" :sig "emitC11Source src: Str path: Str -> (Result Str Str)" :pit (result))
(:sym "emitC11SourceWith" :mod "asl-target-c/emit" :sig "emitC11SourceWith src: Str preludeSrc: Str path: Str -> (Result Str Str)" :pit (result))
(:sym "c11SMainWrapper" :mod "asl-target-c/emit" :sig "c11SMainWrapper m: irTy/SsaModule f: irTy/SsaFunction -> Str")
(:sym "emitC11Type" :mod "asl-target-c/types" :sig "emitC11Type ty: irTy/IrType -> Str")
(:sym "emitC11Closure" :mod "asl-target-c/types" :sig "emitC11Closure name: Str envFields: (List Str) -> Str")
(:sym "emitC11Panic" :mod "asl-target-c/types" :sig "emitC11Panic code: Int64 msg: Str -> Str")
