(:card "asl-tz" :purpose "Pure ASL TZif and POSIX timezone support" :import "(asl-tz/tzif :a x)" :modules ((:m "asl-tz/tzif" :doc "TZif parser and zone file loader.") (:m "asl-tz/zone" :doc "UTC/local conversion over parsed TZif transition tables.")) :sigs ("tzifParse bytes: Bytes -> (Result TzifData String)" "loadZoneBytes bytes: Bytes -> (Result TzifData String)" "loadZone name: String -> (Result TzifData String)" "safeZoneName? name: String -> Bool" "tzifVersion data: TzifData -> String" "tzifFooter data: TzifData -> String" "tzifTransitionCount data: TzifData -> Int64" "enum TzifData (tzifData version: String transitions: (List Int64) typeIndexes: (List Int64) offsets: (List Int64) dstFlags: (List Bool) abbr..." "utcToLocal data: TzifData instantSeconds: Int64 -> ZoneResult") :more (localToUtc zoneOffset zoneAbbreviation zoneIsDst) :effects (loadZone) :fails (tzifParse loadZoneBytes loadZone localToUtc) :example none)
(:sym "tzifParse" :mod "asl-tz/tzif" :sig "tzifParse bytes: Bytes -> (Result TzifData String)" :doc "Parses a v1 or v2/v3/v4 TZif header and body (the v2+ 64-bit section), validating the POSIX footer on the final section" :pit (result))
(:sym "loadZoneBytes" :mod "asl-tz/tzif" :sig "loadZoneBytes bytes: Bytes -> (Result TzifData String)" :doc "tzifParse on already-read TZif bytes" :pit (result))
(:sym "loadZone" :mod "asl-tz/tzif" :kind fn! :sig "loadZone name: String -> (Result TzifData String)" :doc "Reads and parses /usr/share/zoneinfo/name; Err on an unsafe name or read failure" :pit (result effect))
(:sym "safeZoneName?" :mod "asl-tz/tzif" :sig "safeZoneName? name: String -> Bool" :doc "Rejects empty, absolute, .., backslash or colon zone names before they reach a filesystem path")
(:sym "tzifVersion" :mod "asl-tz/tzif" :sig "tzifVersion data: TzifData -> String" :doc "The parsed TZif version field")
(:sym "tzifFooter" :mod "asl-tz/tzif" :sig "tzifFooter data: TzifData -> String" :doc "The parsed POSIX TZ footer string, or empty")
(:sym "tzifTransitionCount" :mod "asl-tz/tzif" :sig "tzifTransitionCount data: TzifData -> Int64" :doc "Number of parsed transition times")
(:sym "TzifData" :mod "asl-tz/tzif" :kind type :sig "enum TzifData (tzifData version: String transitions: (List Int64) typeIndexes: (List Int64) offsets: (List Int64) dstFlags: (List Bool) abbreviations: (List String) footer: String)" :doc "Parsed TZif data: version, transition times/type indexes, offsets, DST flags, abbreviations and POSIX footer")
(:sym "tzifData" :mod "asl-tz/tzif" :kind ctor :sig "(tzifData version: String transitions: (List Int64) typeIndexes: (List Int64) offsets: (List Int64) dstFlags: (List Bool) abbreviations: (List String) footer: S ... of TzifData" :doc "TzifData constructor: version, transitions, typeIndexes, offsets, dstFlags, abbreviations, footer" :pit (ctor))
(:sym "utcToLocal" :mod "asl-tz/zone" :sig "utcToLocal data: TzifData instantSeconds: Int64 -> ZoneResult" :doc "The zone type (offset, DST, abbreviation) in force at instantSeconds, from the transition table or the POSIX footer past its end")
(:sym "localToUtc" :mod "asl-tz/zone" :sig "localToUtc data: TzifData localSeconds: Int64 policy: String -> (Result Int64 String)" :doc "Inverts utcToLocal for a wall-clock local time; policy (first/second/err/earlier/later) resolves a fold or a gap" :pit (result))
(:sym "zoneOffset" :mod "asl-tz/zone" :sig "zoneOffset data: TzifData instantSeconds: Int64 -> Int64" :doc "utcToLocal's offsetSeconds")
(:sym "zoneAbbreviation" :mod "asl-tz/zone" :sig "zoneAbbreviation data: TzifData instantSeconds: Int64 -> String" :doc "utcToLocal's abbreviation")
(:sym "zoneIsDst" :mod "asl-tz/zone" :sig "zoneIsDst data: TzifData instantSeconds: Int64 -> Bool" :doc "utcToLocal's isDst")
