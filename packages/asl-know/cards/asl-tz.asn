(:card "asl-tz" :purpose "Pure ASL TZif and POSIX timezone support" :import "(asl-tz/tzif :a x)" :modules ((:m "asl-tz/tzif") (:m "asl-tz/zone")) :sigs ("tzifParse bytes: Bytes -> (Result TzifData String)" "loadZoneBytes bytes: Bytes -> (Result TzifData String)" "loadZone name: String -> (Result TzifData String)" "safeZoneName? name: String -> Bool" "tzifVersion data: TzifData -> String" "tzifFooter data: TzifData -> String" "tzifTransitionCount data: TzifData -> Int64" "enum TzifData (tzifData version: String transitions: (List Int64) typeIndexes: (List Int64) offsets: (List Int64) dstFlags: (List Bool) abbr..." "utcToLocal data: TzifData instantSeconds: Int64 -> ZoneResult") :more (localToUtc zoneOffset zoneAbbreviation zoneIsDst) :effects (loadZone) :fails (tzifParse loadZoneBytes loadZone localToUtc) :example none)
(:sym "tzifParse" :mod "asl-tz/tzif" :sig "tzifParse bytes: Bytes -> (Result TzifData String)" :pit (result))
(:sym "loadZoneBytes" :mod "asl-tz/tzif" :sig "loadZoneBytes bytes: Bytes -> (Result TzifData String)" :pit (result))
(:sym "loadZone" :mod "asl-tz/tzif" :kind fn! :sig "loadZone name: String -> (Result TzifData String)" :pit (result effect))
(:sym "safeZoneName?" :mod "asl-tz/tzif" :sig "safeZoneName? name: String -> Bool")
(:sym "tzifVersion" :mod "asl-tz/tzif" :sig "tzifVersion data: TzifData -> String")
(:sym "tzifFooter" :mod "asl-tz/tzif" :sig "tzifFooter data: TzifData -> String")
(:sym "tzifTransitionCount" :mod "asl-tz/tzif" :sig "tzifTransitionCount data: TzifData -> Int64")
(:sym "TzifData" :mod "asl-tz/tzif" :kind type :sig "enum TzifData (tzifData version: String transitions: (List Int64) typeIndexes: (List Int64) offsets: (List Int64) dstFlags: (List Bool) abbreviations: (List String) footer: String)")
(:sym "tzifData" :mod "asl-tz/tzif" :kind ctor :sig "(tzifData version: String transitions: (List Int64) typeIndexes: (List Int64) offsets: (List Int64) dstFlags: (List Bool) abbreviations: (List String) footer: S ... of TzifData" :pit (ctor))
(:sym "utcToLocal" :mod "asl-tz/zone" :sig "utcToLocal data: TzifData instantSeconds: Int64 -> ZoneResult")
(:sym "localToUtc" :mod "asl-tz/zone" :sig "localToUtc data: TzifData localSeconds: Int64 policy: String -> (Result Int64 String)" :pit (result))
(:sym "zoneOffset" :mod "asl-tz/zone" :sig "zoneOffset data: TzifData instantSeconds: Int64 -> Int64")
(:sym "zoneAbbreviation" :mod "asl-tz/zone" :sig "zoneAbbreviation data: TzifData instantSeconds: Int64 -> String")
(:sym "zoneIsDst" :mod "asl-tz/zone" :sig "zoneIsDst data: TzifData instantSeconds: Int64 -> Bool")
