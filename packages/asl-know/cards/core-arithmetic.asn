(:card "core/arithmetic" :purpose "Arithmetic builtins, no import" :sigs ("+ : N N -> N" "- : N N -> N" "* : N N -> N" "/ : N N -> N" "mod : N N -> N" "checkedDiv : N N -> (Option N)" "checkedMod : N N -> (Option N)" "abs : N -> N" "min : N N -> N" "max : N N -> N" "trap : String String -> T" "floor : Float64 -> Float64" "ceil : Float64 -> Float64" "round : Float64 -> Float64" "clamp : Float64 Float64 Float64 -> Float64" "pow : Float64 Float64 -> Float64" "exp : Float64 -> Float64" "log : Float64 -> Float64" "log2 : Float64 -> Float64" "log10 : Float64 -> Float64" "sqrt : Float64 -> Float64" "sin : Float64 -> Float64" "cos : Float64 -> Float64") :more (tan atan2 isNan? isFinite? floatNan floatInf floatNegInf) :example none)
(:sym "+" :sig "+ : N N -> N" :doc "Sum of two Int or two Float; Int and Float never mix. Traps on Int64 overflow.")
(:sym "-" :sig "- : N N -> N" :doc "Difference, or negation with one operand. Traps on Int64 overflow.")
(:sym "*" :sig "* : N N -> N" :doc "Product. Traps on Int64 overflow.")
(:sym "/" :sig "/ : N N -> N" :doc "Division; Int division floors, so (/ -7 2) is -4. Traps on a zero Int divisor and on a quotient outside Int64.")
(:sym "mod" :sig "mod : N N -> N" :doc "Floored remainder, so the sign follows the divisor: (mod -7 3) is 2, (mod -7.0 3.0) is 2.0. Traps on a zero Int divisor; a Float gives C fmod moved to the divisor's sign, so a zero divisor, an infinite or NaN operand give nan as fmod does, ...")
(:sym "checkedDiv" :sig "checkedDiv : N N -> (Option N)" :doc "Division, or none on a zero divisor or a quotient outside Int64." :pit (option))
(:sym "checkedMod" :sig "checkedMod : N N -> (Option N)" :doc "Floored remainder, or none on a zero divisor." :pit (option))
(:sym "abs" :sig "abs : N -> N" :doc "Absolute value. Traps on the Int64 minimum.")
(:sym "min" :sig "min : N N -> N" :doc "Lesser of two Int or two Float. With a NaN the result depends on order: (min nan 1.0) is nan, (min 1.0 nan) is 1.0.")
(:sym "max" :sig "max : N N -> N" :doc "Greater of two Int or two Float. With a NaN the result depends on order: (max nan 1.0) is 1.0.")
(:sym "trap" :sig "trap : String String -> T" :doc "Aborts with a chosen error code and message, in the exact format and with the exact exit status a host-raised error of that code would have: \"<code>: <message>\" on stderr, exit 1. The code is checked against the host's own ERR_* vocabulary ...")
(:sym "floor" :sig "floor : Float64 -> Float64" :doc "Greatest integral value less than or equal to argument via libm floor.")
(:sym "ceil" :sig "ceil : Float64 -> Float64" :doc "Least integral value greater than or equal to argument via libm ceil.")
(:sym "round" :sig "round : Float64 -> Float64" :doc "Nearest integral value to argument, rounding halfway cases away from zero via libm round.")
(:sym "clamp" :sig "clamp : Float64 Float64 Float64 -> Float64" :doc "Clamp x between lo and hi: (clamp lo hi x). Requires lo <= hi, else traps with ERR_RANGE. If x is NaN, returns NaN.")
(:sym "pow" :sig "pow : Float64 Float64 -> Float64" :doc "Base raised to exponent power via libm pow; passes through NaN and inf per C99 pow.")
(:sym "exp" :sig "exp : Float64 -> Float64" :doc "Base-e exponential via libm exp; overflows to inf.")
(:sym "log" :sig "log : Float64 -> Float64" :doc "Natural logarithm via libm log; (log 0.0) is -inf, negative argument returns NaN.")
(:sym "log2" :sig "log2 : Float64 -> Float64" :doc "Base-2 logarithm via libm log2; (log2 0.0) is -inf, negative argument returns NaN.")
(:sym "log10" :sig "log10 : Float64 -> Float64" :doc "Base-10 logarithm via libm log10; (log10 0.0) is -inf, negative argument returns NaN.")
(:sym "sqrt" :sig "sqrt : Float64 -> Float64" :doc "Square root via libm sqrt; NaN for negative or NaN argument, inf for inf.")
(:sym "sin" :sig "sin : Float64 -> Float64" :doc "Sine in radians via libm sin.")
(:sym "cos" :sig "cos : Float64 -> Float64" :doc "Cosine in radians via libm cos.")
(:sym "tan" :sig "tan : Float64 -> Float64" :doc "Tangent in radians via libm tan.")
(:sym "atan2" :sig "atan2 : Float64 Float64 -> Float64" :doc "Arctangent of y / x using signs of both arguments via libm atan2.")
(:sym "isNan?" :sig "isNan? : Float64 -> Bool" :doc "True for NaN.")
(:sym "isFinite?" :sig "isFinite? : Float64 -> Bool" :doc "False for NaN, inf and -inf.")
(:sym "floatNan" :sig "floatNan : () -> Float64" :doc "The float NaN.")
(:sym "floatInf" :sig "floatInf : () -> Float64" :doc "Positive infinity.")
(:sym "floatNegInf" :sig "floatNegInf : () -> Float64" :doc "Negative infinity.")
