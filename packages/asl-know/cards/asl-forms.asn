(:card "asl-forms" :purpose "Agent-plane forms kernel in pure ASL" :import "(asl-forms/main :a x)" :deps (aslGateway asl-parser asl-checker asl-json asl-intel asl-proc asl-syntax asl-coord asl-gates asl-html asl-target-js asl-target-py asl-target-go asl-ir) :modules ((:m "asl-forms/main" :doc "asl-host run entry printing the receipts and exit code o...") (:m "asl-forms/check" :doc "Pure ASL foreign syntax checker and staged-edit validato...") (:m "asl-forms/delegate" :doc "Delegating forms of aslForms.py run_step: in-process sea...") (:m "asl-forms/docOp" :doc "Agent-plane (:doc) op: look up D150 ledgered doc text by...") (:m "asl-forms/edit" :doc "Staged edit steps of aslForms.py run_step: write edit di...")) :moduleCount 23 :sigs ("mainText! args: (List String) -> (Pair String Int64)" "runPayload! ws: w/Workspace raw: String -> Int64" "runPayloadText! ws: w/Workspace raw: String -> (Pair String Int64)" "workspaceFor! rootArg: String -> w/Workspace" "(schema Drive (:f lines (List String)) (:f failed (List Bool)) (:f heads (List String)) (:f errs Int64) (:f stop String))" "driveOutcome! root: String rest: (List (Pair String k/ParsedStep)) id: Int64 sequential: Bool d: Drive p: k/ParsedStep out: ops/StepOutcome -> Drive" "driveExitCode d: Drive -> Int64" "(schema CheckVerdict (:f status String) (:f message String))") :more (StagedVerdict LeftItem foreignSyntax validateStaged checkFileReceipt! checkSemantic! runNativeCheck! makeLeftItem leftItemLine leftItemCol leftItemExpected) :moreCount 310 :effects (mainText! runPayload! runPayloadText! workspaceFor! driveOutcome! checkFileReceipt! checkSemantic! runNativeCheck!) :fails (checkSemantic! runNativeCheck! engineExchangeWith researchGatewayEntry! researchGatewayRoutes! resolveResearchEntry! researchDispatch researchDispatchWith) :example none)
(:sym "mainText!" :mod "asl-forms/main" :kind fn! :sig "mainText! args: (List String) -> (Pair String Int64)" :doc "main without printing: --root, the ASL_SESSION check and the payload, as wire text and exit code for an in-process caller" :pit (effect))
