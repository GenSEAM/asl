(:card "asl-forms" :purpose "Agent-plane forms kernel in pure ASL" :import "(asl-forms/main :a x)" :deps (aslGateway asl-parser asl-checker asl-json asl-intel asl-proc asl-syntax asl-coord asl-gates asl-html asl-target-js asl-target-py asl-target-go asl-ir) :modules ((:m "asl-forms/main" :doc "asl-host run entry printing the receipts and exit code o...") (:m "asl-forms/check") (:m "asl-forms/delegate") (:m "asl-forms/docOp") (:m "asl-forms/edit")) :moduleCount 24 :sigs ("mainText! args: (List String) -> (Pair String Int64)" "runPayload! ws: w/Workspace raw: String -> Int64" "runPayloadText! ws: w/Workspace raw: String -> (Pair String Int64)" "workspaceFor! rootArg: String -> w/Workspace" "(schema Drive (:f lines (List String)) (:f failed (List Bool)) (:f heads (List String)) (:f errs Int64) (:f stop String))" "driveOutcome! root: String rest: (List (Pair String k/ParsedStep)) id: Int64 sequential: Bool d: Drive p: k/ParsedStep out: ops/StepOutcome -> Drive" "driveExitCode d: Drive -> Int64" "(schema CheckVerdict (:f status String) (:f message String))") :more (StagedVerdict LeftItem foreignSyntax validateStaged checkFileReceipt! checkSemantic! runNativeCheck! makeLeftItem leftItemLine leftItemCol leftItemExpected) :moreCount 342 :effects (mainText! runPayload! runPayloadText! workspaceFor! driveOutcome! checkFileReceipt! checkSemantic! runNativeCheck!) :fails (checkSemantic! runNativeCheck! researchModeAt! postBusEvent! engineExchangeWith poolForms researchGatewayEntry! researchGatewayRoutes!) :example none)
(:sym "mainText!" :mod "asl-forms/main" :kind fn! :sig "mainText! args: (List String) -> (Pair String Int64)" :doc "main without printing: --root, the ASL_SESSION check and the payload, as wire text and exit code for an in-process caller" :pit (effect))
