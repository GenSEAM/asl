(:card "core/low-level" :purpose "Low-level builtins, no import" :sigs ("addWrap : I I -> I" "subWrap : I I -> I" "mulWrap : I I -> I" "negWrap : I -> I" "addClamp : I I -> I" "subClamp : I I -> I" "mulClamp : I I -> I" "addChecked : I I -> (Option I)" "subChecked : I I -> (Option I)" "mulChecked : I I -> (Option I)" "divChecked : I I -> (Option I)" "modChecked : I I -> (Option I)" "rotateLeft : I J -> I" "rotateRight : I J -> I" "byteSwap : I -> I" "bitCount : I -> Int64" "leadingZeros : I -> Int64" "trailingZeros : I -> Int64") :example none)
(:sym "addWrap" :sig "addWrap : I I -> I" :doc "Sum modulo 2^width of the type.")
(:sym "subWrap" :sig "subWrap : I I -> I" :doc "Difference modulo 2^width of the type.")
(:sym "mulWrap" :sig "mulWrap : I I -> I" :doc "Product modulo 2^width of the type.")
(:sym "negWrap" :sig "negWrap : I -> I" :doc "Negation modulo 2^width of the type.")
(:sym "addClamp" :sig "addClamp : I I -> I" :doc "Sum saturated to the bounds of the type.")
(:sym "subClamp" :sig "subClamp : I I -> I" :doc "Difference saturated to the bounds of the type.")
(:sym "mulClamp" :sig "mulClamp : I I -> I" :doc "Product saturated to the bounds of the type.")
(:sym "addChecked" :sig "addChecked : I I -> (Option I)" :doc "Sum, or none where the plain + would trap." :pit (option))
(:sym "subChecked" :sig "subChecked : I I -> (Option I)" :doc "Difference, or none where the plain - would trap." :pit (option))
(:sym "mulChecked" :sig "mulChecked : I I -> (Option I)" :doc "Product, or none where the plain * would trap." :pit (option))
(:sym "divChecked" :sig "divChecked : I I -> (Option I)" :doc "Quotient, or none on a zero divisor or an out of range quotient." :pit (option))
(:sym "modChecked" :sig "modChecked : I I -> (Option I)" :doc "Floored remainder, or none on a zero divisor." :pit (option))
(:sym "rotateLeft" :sig "rotateLeft : I J -> I" :doc "Rotate left by an amount taken modulo the width.")
(:sym "rotateRight" :sig "rotateRight : I J -> I" :doc "Rotate right by an amount taken modulo the width.")
(:sym "byteSwap" :sig "byteSwap : I -> I" :doc "Reverse the bytes of the value.")
(:sym "bitCount" :sig "bitCount : I -> Int64" :doc "Number of set bits.")
(:sym "leadingZeros" :sig "leadingZeros : I -> Int64" :doc "Count of leading zero bits, the width for zero.")
(:sym "trailingZeros" :sig "trailingZeros : I -> Int64" :doc "Count of trailing zero bits, the width for zero.")
