(:card "asl-sql" :purpose "Cross-dialect SQL text from an AST: literals in value position are bound as parameters; identifiers, JSON paths, rawSql and UPDATE/DELETE clauses are not escaped yet (ROADMAP P0); nothing executes queries" :import "(asl-sql/core :a x)" :deps (asl-derive asl-text asl-parser) :modules ((:m "asl-sql/core" :doc "Native AgentSlang Cross-Dialect SQL AST Query Builder an...") (:m "asl-sql/ddl" :doc "Native AgentSlang SQL DDL (Schema & Migrations) and DML ...") (:m "duckdbAdapter" :doc "DuckDB analytical telemetry query engine adapter with ve...") (:m "asl-sql/schemaGen" :doc "SQL DDL Table Schema Generator from Record Schemas") (:m "asl-sql/semantic/expand" :doc "Semantic Query Expander, Virtual Field Inliner, and Cycl...")) :moduleCount 7 :sigs ("(enum SqlDialect (:c sqlite [] \"SQLite 3 embedded dialect with '?' positional placeholders\") (:c postgres [] \"PostgreSQL dialect with '$n' i..." "(enum BinaryOp (:c eq [] \"Equal (=)\") (:c neq [] \"Not equal (<>)\") (:c gt [] \"Greater than (>)\") (:c gte [] \"Greater than or equal (>=)\") (:..." "(enum OrderDir (:c asc [] \"Ascending order\") (:c desc [] \"Descending order\"))" "(enum JoinType (:c innerJoin [] \"INNER JOIN\") (:c leftJoin [] \"LEFT OUTER JOIN\") (:c rightJoin [] \"RIGHT OUTER JOIN\") (:c fullJoin [] \"FULL ...") :more (SqlExpr SqlJoin SelectQuery RenderedQuery WhenClause defaultDialect dialectQuoteChar dialectParamPrefix isParameterized isLiteralParam colExpr strExpr intExpr) :moreCount 85 :fails (ingestTelemetryBatch queryTelemetryVectorized expandQuery expandExpr lowerQuery) :example none)
(:sym "SqlDialect" :mod "asl-sql/core" :kind type :sig "(enum SqlDialect (:c sqlite [] \"SQLite 3 embedded dialect with '?' positional placeholders\") (:c postgres [] \"PostgreSQL dialect with '$n' indexed placeholders\") (:c mysql [] \"MySQL/MariaDB dialect with backtick quotes\") (:c clickhouse [] \"ClickHouse OLAP dialect with backtick quotes\"))")
(:sym "BinaryOp" :mod "asl-sql/core" :kind type :sig "(enum BinaryOp (:c eq [] \"Equal (=)\") (:c neq [] \"Not equal (<>)\") (:c gt [] \"Greater than (>)\") (:c gte [] \"Greater than or equal (>=)\") (:c lt [] \"Less than (<)\") (:c lte [] \"Less than or equal (<=)\") (:c like [] \"Pattern match (LIKE)\") (:c inOp [] \"In set membership (IN)\"))")
(:sym "OrderDir" :mod "asl-sql/core" :kind type :sig "(enum OrderDir (:c asc [] \"Ascending order\") (:c desc [] \"Descending order\"))")
(:sym "JoinType" :mod "asl-sql/core" :kind type :sig "(enum JoinType (:c innerJoin [] \"INNER JOIN\") (:c leftJoin [] \"LEFT OUTER JOIN\") (:c rightJoin [] \"RIGHT OUTER JOIN\") (:c fullJoin [] \"FULL OUTER JOIN\"))")
