(:know :tier L0g :group "data" :cards 11 :tokensBy bytes36)
(:c "asl-crypto" "cryptographic..." (hmacSha256 hmacSha256Hex))
(:c "asl-csv" "RFC 4180 CSV row reader..." (csvParseRows csvParseColumns))
(:c "asl-http" "Streaming HTTP/1.1 and..." (makeHeaders getHeader))
(:c "asl-json" "RFC 8259 JSON parser,..." (jsonParse jsonEmit))
(:c "asl-parquet" "Parquet writer, footer..." (parquetNumRowGroups parquetNumRows))
(:c "asl-regex" "regular-expression..." (regex-compile! regex-compile-flags!))
(:c "asl-s3" "AWS S3 request..." (uriEncode canonicalUri))
(:c "asl-sql" "Cross-dialect SQL text..." (defaultDialect dialectQuoteChar))
(:c "asl-stats" "Descriptive statistics,..." (sumKahan finiteValue?))
(:c "asl-text" "text extraction, HTML..." (decodeHtmlEntities stripEnclosed))
(:c "asl-zip" "RFC 1951 DEFLATE and RFC..." (gunzip! gunzipWithLimit!))
