(:card "asl-sched" :purpose "Pure cron, interval and persisted slot scheduling primitives" :import "(asl-sched/cron :a x)" :modules ((:m "asl-sched/cron" :doc "Pure UTC five-field cron parsing and bounded next-fire s...") (:m "asl-sched/interval" :doc "Anchored, pure interval scheduling.") (:m "asl-sched/slots" :doc "Pure persisted-slot claim state transitions.")) :sigs ("enum Cron (cron minutes: (List Int64) hours: (List Int64) days: (List Int64) months: (List Int64) weekdays: (List Int64) dayWildcard: Bool w..." "parseCron expression: String -> (Result Cron String)" "nextFire value: Cron afterSeconds: Int64 -> (Result Int64 String)" "enum Interval (intervalValue everySeconds: Int64 startSeconds: Int64)" "interval everySeconds: Int64 startSeconds: Int64 -> (Result Interval String)" "intervalNextFire schedule: Interval afterSeconds: Int64 -> (Result Int64 String)") :more (Slot ClaimResult Schedule slotClaim slotComplete slotExpire recoverSlots serializeSlot parseSlot) :fails (parseCron nextFire interval intervalNextFire slotComplete parseSlot) :example none)
(:sym "Cron" :mod "asl-sched/cron" :kind type :sig "enum Cron (cron minutes: (List Int64) hours: (List Int64) days: (List Int64) months: (List Int64) weekdays: (List Int64) dayWildcard: Bool weekdayWildcard: Bool)" :doc "A parsed five-field expression: minute/hour/day/month/weekday sets plus each day field's wildcard flag")
(:sym "parseCron" :mod "asl-sched/cron" :sig "parseCron expression: String -> (Result Cron String)" :doc "Parses a five-field UTC cron expression; Err on an out-of-range or malformed field" :pit (result))
(:sym "nextFire" :mod "asl-sched/cron" :sig "nextFire value: Cron afterSeconds: Int64 -> (Result Int64 String)" :doc "The next UTC second value strictly after afterSeconds that the expression fires on" :pit (result))
(:sym "Interval" :mod "asl-sched/interval" :kind type :sig "enum Interval (intervalValue everySeconds: Int64 startSeconds: Int64)" :doc "A fixed-period schedule: everySeconds apart, anchored at startSeconds")
(:sym "intervalValue" :mod "asl-sched/interval" :kind ctor :sig "(intervalValue everySeconds: Int64 startSeconds: Int64) of Interval" :doc "Interval's one constructor: everySeconds apart, anchored at startSeconds" :pit (ctor))
(:sym "interval" :mod "asl-sched/interval" :sig "interval everySeconds: Int64 startSeconds: Int64 -> (Result Interval String)" :doc "Builds an Interval; Err when everySeconds is not positive" :pit (result))
(:sym "intervalNextFire" :mod "asl-sched/interval" :sig "intervalNextFire schedule: Interval afterSeconds: Int64 -> (Result Int64 String)" :doc "The next UTC second value strictly after afterSeconds that the interval fires on" :pit (result))
(:sym "Slot" :mod "asl-sched/slots" :kind type :sig "enum Slot (slot job: String dueSeconds: Int64 claimedBy: String claimExpiresSeconds: Int64 attempt: Int64)" :doc "A due job slot: name, due time, current claim owner/expiry and attempt count")
(:sym "ClaimResult" :mod "asl-sched/slots" :kind type :sig "enum ClaimResult (claimed slot: Slot) (alreadyClaimed) (notDue) (invalidLease)" :doc "Outcome of slotClaim: claimed, alreadyClaimed, notDue or invalidLease")
(:sym "Schedule" :mod "asl-sched/slots" :kind type :sig "enum Schedule (intervalSchedule interval: iv/Interval) (cronSchedule cron: cr/Cron)" :doc "A slot's recurrence, either an Interval or a Cron expression")
(:sym "intervalSchedule" :mod "asl-sched/slots" :kind ctor :sig "(intervalSchedule interval: iv/Interval) of Schedule" :doc "Schedule's Interval-recurrence constructor" :pit (ctor))
(:sym "cronSchedule" :mod "asl-sched/slots" :kind ctor :sig "(cronSchedule cron: cr/Cron) of Schedule" :doc "Schedule's Cron-recurrence constructor" :pit (ctor))
(:sym "slotClaim" :mod "asl-sched/slots" :sig "slotClaim value: Slot worker: String now: Int64 leaseSeconds: Int64 -> ClaimResult" :doc "Claims a due, unclaimed slot for worker at now with leaseSeconds; invalidLease/notDue/alreadyClaimed otherwise")
(:sym "slotComplete" :mod "asl-sched/slots" :sig "slotComplete value: Slot schedule: Schedule completedSeconds: Int64 -> (Result Slot String)" :doc "Reschedules a completed slot's next due time from schedule as of completedSeconds" :pit (result))
(:sym "slotExpire" :mod "asl-sched/slots" :sig "slotExpire value: Slot now: Int64 -> Slot" :doc "Releases value's claim if its lease has expired by now, else returns it unchanged")
(:sym "recoverSlots" :mod "asl-sched/slots" :sig "recoverSlots values: (List Slot) now: Int64 -> (List Slot)" :doc "Releases claims whose lease has expired by now, leaving unexpired slots unchanged")
(:sym "serializeSlot" :mod "asl-sched/slots" :sig "serializeSlot value: Slot -> String" :doc "Renders a Slot as a quoted (:slot ...) ASN string")
(:sym "parseSlot" :mod "asl-sched/slots" :sig "parseSlot text: String -> (Result Slot String)" :doc "Parses the (:slot ...) ASN string back into a Slot; Err on malformed input" :pit (result))
