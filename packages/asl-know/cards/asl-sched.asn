(:card "asl-sched" :purpose "Pure cron, interval and persisted slot scheduling primitives" :import "(asl-sched/cron :a x)" :deps (asl-utils) :modules ((:m "asl-sched/cron") (:m "asl-sched/interval") (:m "asl-sched/slots")) :sigs ("enum Cron (cron minutes: (List Int64) hours: (List Int64) days: (List Int64) months: (List Int64) weekdays: (List Int64) dayWildcard: Bool w..." "parseCron expression: String -> (Result Cron String)" "nextFire value: Cron afterSeconds: Int64 -> (Result Int64 String)" "enum Interval (intervalValue everySeconds: Int64 startSeconds: Int64)" "interval everySeconds: Int64 startSeconds: Int64 -> (Result Interval String)" "intervalNextFire schedule: Interval afterSeconds: Int64 -> (Result Int64 String)") :more (Slot ClaimResult Schedule slotClaim slotComplete slotExpire recoverSlots serializeSlot parseSlot) :fails (parseCron nextFire interval intervalNextFire slotComplete parseSlot) :example none)
(:sym "Cron" :mod "asl-sched/cron" :kind type :sig "enum Cron (cron minutes: (List Int64) hours: (List Int64) days: (List Int64) months: (List Int64) weekdays: (List Int64) dayWildcard: Bool weekdayWildcard: Bool)")
(:sym "parseCron" :mod "asl-sched/cron" :sig "parseCron expression: String -> (Result Cron String)" :pit (result))
(:sym "nextFire" :mod "asl-sched/cron" :sig "nextFire value: Cron afterSeconds: Int64 -> (Result Int64 String)" :pit (result))
(:sym "Interval" :mod "asl-sched/interval" :kind type :sig "enum Interval (intervalValue everySeconds: Int64 startSeconds: Int64)")
(:sym "intervalValue" :mod "asl-sched/interval" :kind ctor :sig "(intervalValue everySeconds: Int64 startSeconds: Int64) of Interval" :pit (ctor))
(:sym "interval" :mod "asl-sched/interval" :sig "interval everySeconds: Int64 startSeconds: Int64 -> (Result Interval String)" :pit (result))
(:sym "intervalNextFire" :mod "asl-sched/interval" :sig "intervalNextFire schedule: Interval afterSeconds: Int64 -> (Result Int64 String)" :pit (result))
(:sym "Slot" :mod "asl-sched/slots" :kind type :sig "enum Slot (slot job: String dueSeconds: Int64 claimedBy: String claimExpiresSeconds: Int64 attempt: Int64)")
(:sym "ClaimResult" :mod "asl-sched/slots" :kind type :sig "enum ClaimResult (claimed slot: Slot) (alreadyClaimed) (notDue) (invalidLease)")
(:sym "Schedule" :mod "asl-sched/slots" :kind type :sig "enum Schedule (intervalSchedule interval: iv/Interval) (cronSchedule cron: cr/Cron)")
(:sym "intervalSchedule" :mod "asl-sched/slots" :kind ctor :sig "(intervalSchedule interval: iv/Interval) of Schedule" :pit (ctor))
(:sym "cronSchedule" :mod "asl-sched/slots" :kind ctor :sig "(cronSchedule cron: cr/Cron) of Schedule" :pit (ctor))
(:sym "slotClaim" :mod "asl-sched/slots" :sig "slotClaim value: Slot worker: String now: Int64 leaseSeconds: Int64 -> ClaimResult")
(:sym "slotComplete" :mod "asl-sched/slots" :sig "slotComplete value: Slot schedule: Schedule completedSeconds: Int64 -> (Result Slot String)" :pit (result))
(:sym "slotExpire" :mod "asl-sched/slots" :sig "slotExpire value: Slot now: Int64 -> Slot")
(:sym "recoverSlots" :mod "asl-sched/slots" :sig "recoverSlots values: (List Slot) now: Int64 -> (List Slot)")
(:sym "serializeSlot" :mod "asl-sched/slots" :sig "serializeSlot value: Slot -> String")
(:sym "parseSlot" :mod "asl-sched/slots" :sig "parseSlot text: String -> (Result Slot String)" :pit (result))
