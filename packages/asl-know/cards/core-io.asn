(:card "core/io" :purpose "I/O builtins, no import" :sigs ("notFound : () -> IoError" "permissionDenied : () -> IoError" "alreadyExists : () -> IoError" "invalidPath : () -> IoError" "interrupted : () -> IoError" "other : () -> IoError" "fileExists? : String -> Bool" "print : A... -> Unit" "println : A... -> Unit" "eprintln : A... -> Unit" "fileReadString : String -> (Result String String)" "fileReadBytes : String -> (Result Bytes String)" "fileReadRange : String Int64 Int64 -> (Result Bytes String)" "fileSize : String -> (Result Int64 String)" "fileWrite : String X -> (Result Unit String)" "fileAppend : String X -> (Result Unit String)") :more (dirList fileStat fileLstat fileChmod fileFsync fileReadlink fileUtime pathSymlink processRun cpuCount procRusage platformInfo localDate procAlive? nowNs) :moreCount 11 :fails (fileReadString fileReadBytes fileReadRange fileSize fileWrite fileAppend dirList fileStat) :example "(module asl-know/examples/coreIo :x [lineCount! selfTest] :i [])\n\nfn ! lineCount! path: String -> Int64\n  (mt (fileReadString path)\n    ((err _) -1)\n    ((ok text) (listCount (fn [(l String)] -> Bool (not (stringEmpty? l))) (stringLines text))))")
(:sym "notFound" :sig "notFound : () -> IoError" :doc "The not found failure (constructor).")
(:sym "permissionDenied" :sig "permissionDenied : () -> IoError" :doc "The permission denied failure (constructor).")
(:sym "alreadyExists" :sig "alreadyExists : () -> IoError" :doc "The already exists failure (constructor).")
(:sym "invalidPath" :sig "invalidPath : () -> IoError" :doc "The invalid path failure (constructor).")
(:sym "interrupted" :sig "interrupted : () -> IoError" :doc "The interrupted failure (constructor).")
(:sym "other" :sig "other : () -> IoError" :doc "The other failure (constructor).")
(:sym "fileExists?" :sig "fileExists? : String -> Bool" :doc "True when fileStat succeeds on the path (a file or a directory).")
(:sym "print" :sig "print : A... -> Unit" :doc "Write the arguments to standard output, separated by spaces, with no trailing newline." :pit (variadic))
(:sym "println" :sig "println : A... -> Unit" :doc "Write the arguments to standard output, separated by spaces, then a newline." :pit (variadic))
(:sym "eprintln" :sig "eprintln : A... -> Unit" :doc "Write the arguments to standard error, separated by spaces, then a newline." :pit (variadic))
(:sym "fileReadString" :sig "fileReadString : String -> (Result String String)" :doc "Read a whole file as text. Every host IO failure is the message \"KIND: PATH: reason\", KIND an IoError case from errno, as in \"notFound: /x: No such file or directory\"." :pit (result))
(:sym "fileReadBytes" :sig "fileReadBytes : String -> (Result Bytes String)" :doc "Read a whole file as bytes; the failure is a \"KIND: PATH: reason\" message." :pit (result))
(:sym "fileReadRange" :sig "fileReadRange : String Int64 Int64 -> (Result Bytes String)" :doc "Read length bytes starting at offset from path via pread (or read for non-regular files); window past the end returns bytes up to the end; negative offset or length returns err. Length is capped at 1 GiB (returning err lengthLimitExceeded)...." :pit (result))
(:sym "fileSize" :sig "fileSize : String -> (Result Int64 String)" :doc "File size in bytes via stat; the failure is a \"KIND: PATH: reason\" message." :pit (result))
(:sym "fileWrite" :sig "fileWrite : String X -> (Result Unit String)" :doc "Create or truncate a file and write the text or bytes; the failure is a \"KIND: PATH: reason\" message." :pit (result))
(:sym "fileAppend" :sig "fileAppend : String X -> (Result Unit String)" :doc "Append content (String or Bytes) to path, creating it if absent, opened with O_APPEND; the failure is a \"KIND: PATH: reason\" message." :pit (result))
(:sym "dirList" :sig "dirList : String -> (Result (List String) String)" :doc "Entry names of a directory without . and .., sorted bytewise; the failure is a \"KIND: PATH: reason\" message." :pit (result))
(:sym "fileStat" :sig "fileStat : String -> (Result FileStat String)" :doc "stat of a path as {:isFile Bool :isDir Bool :size Int64 :mtime Int64 :mode Int64 :mtimeNs Int64}, :mtime in whole seconds and :mtimeNs in nanoseconds since the epoch; the failure is a \"KIND: PATH: reason\" message." :pit (result))
(:sym "fileLstat" :sig "fileLstat : String -> (Result LinkStat String)" :doc "lstat of a path, not following a final symlink: {:isFile Bool :isDir Bool :isSymlink Bool :size Int64 :mtime Int64 :mode Int64 :mtimeNs Int64}; a dangling link is ok with :isSymlink true while fileStat fails." :pit (result))
(:sym "fileChmod" :sig "fileChmod : String Int64 -> (Result Unit String)" :doc "chmod a path to mode 0..07777 (e.g. 420 = 0644); a mode outside that range or a failure is a \"KIND: PATH: reason\" message." :pit (result))
(:sym "fileFsync" :sig "fileFsync : String -> (Result Unit String)" :doc "Open a file or directory read-only and fsync it; the failure is a \"KIND: PATH: reason\" message." :pit (result))
(:sym "fileReadlink" :sig "fileReadlink : String -> (Result String String)" :doc "The target text of a symlink, verbatim and unresolved; a path that is not a link is invalidPath." :pit (result))
(:sym "fileUtime" :sig "fileUtime : String Int64 -> (Result Unit String)" :doc "utimensat: set atime and mtime of a path, following a final symlink, to mtimeNs nanoseconds since the epoch (negative before 1970); the failure is a \"KIND: PATH: reason\" message." :pit (result))
(:sym "pathSymlink" :sig "pathSymlink : String String -> (Result Unit String)" :doc "symlink target linkPath: create linkPath pointing at target (which need not exist); an existing linkPath is alreadyExists." :pit (result))
(:sym "processRun" :sig "processRun : String -> ProcessOutput" :doc "Run a command with /bin/sh -c and wait: {:exitCode Int64 :stdout String :stderr String}; retains shell convention where a child killed by signal N exits 128+N (unlike direct process waiters procWaitPid/procWaitAny which return -N). Failing ...")
(:sym "cpuCount" :sig "cpuCount : () -> (Result Int64 String)" :doc "Online CPUs from sysconf(_SC_NPROCESSORS_ONLN)." :pit (result))
(:sym "procRusage" :sig "procRusage : () -> (Result Rusage String)" :doc "getrusage of self and of reaped children: {:selfMaxRssKb :selfUserUs :selfSysUs :childrenMaxRssKb :childrenUserUs :childrenSysUs}, peak RSS in KB on macOS and Linux." :pit (result))
(:sym "platformInfo" :sig "platformInfo : () -> (Result PlatformInfo String)" :doc "uname as {:os String :release String :machine String}, e.g. \"Linux\" \"6.8.0\" \"x86_64\"." :pit (result))
(:sym "localDate" :sig "localDate : () -> (Result String String)" :doc "Today in the local time zone as YYYY-MM-DD (localtime_r, strftime)." :pit (result))
(:sym "procAlive?" :sig "procAlive? : Int64 -> (Result Bool String)" :doc "kill(pid, 0): ok true when the process exists (EPERM counts as alive), ok false on ESRCH; pid outside 1..INT_MAX is err io:22." :pit (result))
(:sym "nowNs" :sig "nowNs : () -> Int64" :doc "Nanoseconds since the Unix epoch (CLOCK_REALTIME).")
(:sym "monotonicNs" :sig "monotonicNs : () -> Int64" :doc "Nanoseconds of monotonic time since an unspecified starting point (CLOCK_MONOTONIC).")
(:sym "sleepMs" :sig "sleepMs : Int64 -> Unit" :doc "Sleep for ms milliseconds (nanosleep, resumed after EINTR). A negative ms traps with ERR_RANGE.")
(:sym "envGet" :sig "envGet : String -> (Option String)" :doc "Read an environment variable by name: (some val) or (none)." :pit (option))
(:sym "getHomeDir" :sig "getHomeDir : () -> (Result String String)" :doc "User's home directory: $HOME when set and non-empty, else getpwuid(getuid())->pw_dir; the failure is a \"KIND: PATH: reason\" message." :pit (result))
(:sym "processSpawn" :sig "processSpawn : String -> (Result Int64 String)" :doc "Start /bin/sh -c cmd with stdout and stderr redirected, returning a handle id." :pit (result))
(:sym "processWait" :sig "processWait : Int64 Int64 -> (Result ProcessOutput String)" :doc "Wait up to timeoutMs (0 = no limit) for handle: (ok {:exitCode ... :stdout ... :stderr ...}); returns 128+n for a signal death; on timeout kills process group and returns exitCode 124." :pit (result))
(:sym "fileCreateExclusive" :sig "fileCreateExclusive : String String -> (Result Unit String)" :doc "Create a file exclusively (O_CREAT|O_EXCL) and write content; returns err \"exists\" if file already exists." :pit (result))
(:sym "dirCreate" :sig "dirCreate : String -> (Result Unit String)" :doc "Create directory and any missing parents (mkdir -p semantics); ok if dir exists, err if a file exists there." :pit (result))
(:sym "pathRemove" :sig "pathRemove : String -> (Result Unit String)" :doc "Remove a file or directory tree recursively without following symlinks out of it." :pit (result))
(:sym "pathRename" :sig "pathRename : String String -> (Result Unit String)" :doc "Rename from to (rename(2))." :pit (result))
(:sym "realPath" :sig "realPath : String -> (Result String String)" :doc "Resolve a path with realpath; the failure is a \"KIND: PATH: reason\" message." :pit (result))
