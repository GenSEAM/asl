(:card "asl-text" :purpose "Pure AgentSlang high-performance text extraction, HTML parsing, entity decoding, chunking, and ASN structuring engine" :import "(asl-text/text :a x)" :modules ((:m "asl-text/text" :doc "Pure AgentSlang text engine: HTML parsing, entity decodi...") (:m "asl-text/distance") (:m "asl-text/dotenv") (:m "asl-text/emojiGuard") (:m "asl-text/escape" :doc "Canonical Pure AgentSlang String Escaping and Wire Seria...")) :moduleCount 17 :sigs ("schema ExtractedDoc { title: Str content: Str format: Str source: Str charCount: I64 }" "schema ContextChunk { id: Str content: Str index: I64 charCount: I64 source: Str }" "schema ContextualClause { id: Str docTitle: Str sectionPath: (List Str) clauseText: Str charCount: I64 source: Str }" "schema TableData { id: Str cols: (List Str) rows: (List (List Str)) }" "schema CodeBlockData { id: Str lang: Str code: Str }" "schema DistilledSection { id: Str level: I64 title: Str content: Str }") :more (DistilledDoc SourceIndexResult InternResult decodeHtmlEntities stripEnclosed cleanHtml extractHtml extractMarkdown extractPlaintext extractJsonKv) :moreCount 98 :effects (say! sayErr!) :fails (parseIni parseTable parseAligns percentDecode parse splitWords parseLine classify) :example none)
