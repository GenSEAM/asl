(:card "asl-text" :purpose "Pure AgentSlang high-performance text extraction, HTML parsing, entity decoding, chunking, and ASN structuring engine" :import "(asl-text/text :a x)" :modules ((:m "asl-text/text" :doc "Pure AgentSlang text engine: HTML parsing, entity decodi...") (:m "asl-text/emojiGuard" :doc "Pure AgentSlang Unicode Emoji Invariant Guard and Zero-E...") (:m "asl-text/escape" :doc "Canonical Pure AgentSlang String Escaping and Wire Seria...") (:m "asl-text/string" :doc "Pure AgentSlang high-performance modular string primitiv...")) :sigs ("schema ExtractedDoc { title: Str content: Str format: Str source: Str charCount: I64 }" "schema ContextChunk { id: Str content: Str index: I64 charCount: I64 source: Str }" "schema ContextualClause { id: Str docTitle: Str sectionPath: (List Str) clauseText: Str charCount: I64 source: Str }" "schema TableData { id: Str cols: (List Str) rows: (List (List Str)) }" "schema CodeBlockData { id: Str lang: Str code: Str }" "schema DistilledSection { id: Str level: I64 title: Str content: Str }") :more (DistilledDoc SourceIndexResult InternResult decodeHtmlEntities stripEnclosed cleanHtml extractHtml extractMarkdown extractPlaintext extractJsonKv) :moreCount 57 :example none)
(:sym "ExtractedDoc" :mod "asl-text/text" :kind type :sig "schema ExtractedDoc { title: Str content: Str format: Str source: Str charCount: I64 }")
(:sym "ContextChunk" :mod "asl-text/text" :kind type :sig "schema ContextChunk { id: Str content: Str index: I64 charCount: I64 source: Str }")
(:sym "ContextualClause" :mod "asl-text/text" :kind type :sig "schema ContextualClause { id: Str docTitle: Str sectionPath: (List Str) clauseText: Str charCount: I64 source: Str }")
(:sym "TableData" :mod "asl-text/text" :kind type :sig "schema TableData { id: Str cols: (List Str) rows: (List (List Str)) }")
(:sym "CodeBlockData" :mod "asl-text/text" :kind type :sig "schema CodeBlockData { id: Str lang: Str code: Str }")
(:sym "DistilledSection" :mod "asl-text/text" :kind type :sig "schema DistilledSection { id: Str level: I64 title: Str content: Str }")
(:sym "DistilledDoc" :mod "asl-text/text" :kind type :sig "schema DistilledDoc { title: Str sources: (List Str) sections: (List DistilledSection) tables: (List TableData) codeBlocks: (List CodeBlockData) needsRendering: Bool rawChars: I64 distilledChars: I64 }")
(:sym "SourceIndexResult" :mod "asl-text/text" :kind type :sig "schema SourceIndexResult { sources: (List Str) index: I64 }")
(:sym "InternResult" :mod "asl-text/text" :kind type :sig "schema InternResult { text: Str sources: (List Str) }")
(:sym "decodeHtmlEntities" :mod "asl-text/text" :sig "decodeHtmlEntities text: Str -> Str")
(:sym "stripEnclosed" :mod "asl-text/text" :sig "stripEnclosed src: Str openDelim: Str closeDelim: Str -> Str")
(:sym "cleanHtml" :mod "asl-text/text" :sig "cleanHtml htmlSrc: Str -> Str")
(:sym "extractHtml" :mod "asl-text/text" :sig "extractHtml rawHtml: Str source: Str -> ExtractedDoc")
(:sym "extractMarkdown" :mod "asl-text/text" :sig "extractMarkdown rawMd: Str source: Str -> ExtractedDoc")
(:sym "extractPlaintext" :mod "asl-text/text" :sig "extractPlaintext rawTxt: Str source: Str -> ExtractedDoc")
(:sym "extractJsonKv" :mod "asl-text/text" :sig "extractJsonKv rawJson: Str source: Str -> ExtractedDoc")
(:sym "extractXmlAtom" :mod "asl-text/text" :sig "extractXmlAtom rawXml: Str source: Str -> ExtractedDoc")
(:sym "extractContext" :mod "asl-text/text" :sig "extractContext rawContent: Str format: Str source: Str -> ExtractedDoc")
(:sym "chunkText" :mod "asl-text/text" :sig "chunkText text: Str maxChars: I64 overlapChars: I64 source: Str -> (List ContextChunk)")
(:sym "chunkDoc" :mod "asl-text/text" :sig "chunkDoc doc: ExtractedDoc maxChars: I64 overlapChars: I64 -> (List ContextChunk)")
(:sym "formatChunkMarkdown" :mod "asl-text/text" :sig "formatChunkMarkdown chunk: ContextChunk -> Str")
(:sym "formatContextRag" :mod "asl-text/text" :sig "formatContextRag query: Str chunks: (List ContextChunk) -> Str")
(:sym "formatDocsRag" :mod "asl-text/text" :sig "formatDocsRag query: Str docs: (List ExtractedDoc) -> Str")
(:sym "formatClauseBreadcrumb" :mod "asl-text/text" :sig "formatClauseBreadcrumb clause: ContextualClause -> Str")
(:sym "formatContextualClause" :mod "asl-text/text" :sig "formatContextualClause clause: ContextualClause -> Str")
(:sym "extractClauses" :mod "asl-text/text" :sig "extractClauses doc: ExtractedDoc minChars: I64 maxChars: I64 -> (List ContextualClause)")
(:sym "extractContextualClauses" :mod "asl-text/text" :sig "extractContextualClauses doc: ExtractedDoc minChars: I64 maxChars: I64 -> (List ContextualClause)")
(:sym "docToAsn" :mod "asl-text/text" :sig "docToAsn doc: ExtractedDoc -> Str")
(:sym "chunkToAsn" :mod "asl-text/text" :sig "chunkToAsn chunk: ContextChunk -> Str")
(:sym "clauseToAsn" :mod "asl-text/text" :sig "clauseToAsn clause: ContextualClause -> Str")
(:sym "stripQuotes" :mod "asl-text/text" :sig "stripQuotes val: Str -> Str")
(:sym "stripColon" :mod "asl-text/text" :sig "stripColon val: Str -> Str")
(:sym "estimateTokens" :mod "asl-text/text" :sig "estimateTokens text: Str -> I64")
(:sym "calcSavings" :mod "asl-text/text" :sig "calcSavings orig: I64 asn: I64 -> F64")
(:sym "extractBetween" :mod "asl-text/text" :sig "extractBetween text: Str prefix: Str suffix: Str -> (Option Str)" :pit (option))
(:sym "isNumeric" :mod "asl-text/text" :sig "isNumeric s: Str -> Bool")
(:sym "stripComment" :mod "asl-text/text" :sig "stripComment line: Str commentChar: Str -> Str")
(:sym "extractTagContents" :mod "asl-text/text" :sig "extractTagContents html: Str tagName: Str -> (List Str)")
(:sym "extractTables" :mod "asl-text/text" :sig "extractTables html: Str -> (List TableData)")
(:sym "tableToAsn" :mod "asl-text/text" :sig "tableToAsn table: TableData -> Str")
(:sym "extractCodeBlocks" :mod "asl-text/text" :sig "extractCodeBlocks html: Str -> (List CodeBlockData)")
(:sym "codeBlockToAsn" :mod "asl-text/text" :sig "codeBlockToAsn cb: CodeBlockData -> Str")
(:sym "internUrls" :mod "asl-text/text" :sig "internUrls html: Str -> InternResult")
(:sym "detectSpaEmptyDom" :mod "asl-text/text" :sig "detectSpaEmptyDom html: Str -> Bool")
(:sym "distillHtml" :mod "asl-text/text" :sig "distillHtml rawHtml: Str sourceUrl: Str -> DistilledDoc")
(:sym "distilledDocToAsn" :mod "asl-text/text" :sig "distilledDocToAsn doc: DistilledDoc -> Str")
(:sym "sanitizeUrlTracking" :mod "asl-text/text" :sig "sanitizeUrlTracking url: Str -> Str")
(:sym "extractTitleFromHtml" :mod "asl-text/text" :sig "extractTitleFromHtml html: Str -> Str")
(:sym "normalizeWhitespace" :mod "asl-text/text" :sig "normalizeWhitespace text: Str -> Str")
(:sym "EmojiViolation" :mod "asl-text/emojiGuard" :kind type :sig "(schema EmojiViolation (:f file Str) (:f lineNum Int64) (:f text Str))" :pit (record))
(:sym "EmojiScanResult" :mod "asl-text/emojiGuard" :kind type :sig "(schema EmojiScanResult (:f clean Bool) (:f violations (List EmojiViolation)))" :pit (record))
(:sym "hasRawEmoji?" :mod "asl-text/emojiGuard" :sig "hasRawEmoji? line: Str -> Bool")
(:sym "scanLineEmoji" :mod "asl-text/emojiGuard" :sig "scanLineEmoji file: Str lineNum: Int64 content: Str -> (Option EmojiViolation)" :pit (option))
(:sym "scanFileEmoji" :mod "asl-text/emojiGuard" :sig "scanFileEmoji file: Str lines: (List Str) -> EmojiScanResult")
(:sym "auditAsnEmojis" :mod "asl-text/emojiGuard" :sig "auditAsnEmojis entries: (List Str) -> Bool")
(:sym "UnescapeState" :mod "asl-text/escape" :kind type :sig "(schema UnescapeState (:f out Str) (:f esc Bool))" :pit (record))
(:sym "escapeAsnStr" :mod "asl-text/escape" :sig "escapeAsnStr s: Str -> Str")
(:sym "unescapeAsnStr" :mod "asl-text/escape" :sig "unescapeAsnStr s: Str -> Str")
(:sym "escapeJsonStr" :mod "asl-text/escape" :sig "escapeJsonStr s: Str -> Str")
(:sym "unescapeJsonStr" :mod "asl-text/escape" :sig "unescapeJsonStr s: Str -> Str")
(:sym "escapeShArg" :mod "asl-text/escape" :sig "escapeShArg arg: Str -> Str")
(:sym "isShSafeArg" :mod "asl-text/escape" :sig "isShSafeArg arg: Str -> Bool")
(:sym "escapeShCompact" :mod "asl-text/escape" :sig "escapeShCompact arg: Str -> Str")
(:sym "starts?" :mod "asl-text/string" :sig "starts? s: Str prefix: Str -> Bool")
(:sym "ends?" :mod "asl-text/string" :sig "ends? s: Str suffix: Str -> Bool")
(:sym "has?" :mod "asl-text/string" :sig "has? s: Str sub: Str -> Bool")
(:sym "split" :mod "asl-text/string" :sig "split s: Str delim: Str -> (List Str)")
(:sym "concat" :mod "asl-text/string" :sig "concat a: Str b: Str -> Str")
(:sym "join" :mod "asl-text/string" :sig "join parts: (List Str) sep: Str -> Str")
(:sym "txtStarts?" :mod "asl-text/string" :sig "txtStarts? s: Str prefix: Str -> Bool")
(:sym "txtEnds?" :mod "asl-text/string" :sig "txtEnds? s: Str suffix: Str -> Bool")
(:sym "txtHas?" :mod "asl-text/string" :sig "txtHas? s: Str sub: Str -> Bool")
(:sym "txtSplit" :mod "asl-text/string" :sig "txtSplit s: Str delim: Str -> (List Str)")
