(:card "asl-store-fs" :purpose "Filesystem adapter of the asl-store contract: one row file per key written by tmp and rename under a per-collection flock, log segments of checksummed frames with torn-tail recovery" :import "(asl-store-fs/fs :a x)" :deps (asl-store asl-text asl-transpile) :modules ((:m "asl-store-fs/fs") (:m "asl-store-fs/log") (:m "asl-store-fs/wal")) :sigs ("(schema FsStore (:f root String) (:f cfg lg/LogCfg))" "fsOpen! root: String segmentMax: Int64 -> (Result FsStore String)" "fsOpenWith! root: String segmentMax: Int64 recover: (fn [String Int64] -> lg/Recovered) -> (Result FsStore String)" "fsCall! st: FsStore op: ty/Op -> ty/Reply" "fsFault! st: FsStore name: String arg: String -> Bool" "(schema Recovered (:f rows (List ty/LogRow)) (:f keep String) (:f torn Bool) (:f err String))" "(schema LogCfg (:f root String) (:f segmentMax Int64) (:f lockWaitMs Int64) (:f recover (fn [String Int64] -> Recovered)))") :more (recoverSegment defaultRecover logAppend! logRead! logCommit! logCursor! ensureTree! lockUntil! dirName replaceFile! segBases! segPath WalOpType WalEntry) :moreCount 18 :effects (fsOpen! fsOpenWith! fsCall! fsFault! logAppend! logRead! logCommit! logCursor!) :fails (fsOpen! ensureTree! lockUntil! replaceFile!) :example none)
(:sym "FsStore" :mod "asl-store-fs/fs" :kind type :sig "(schema FsStore (:f root String) (:f cfg lg/LogCfg))" :pit (record))
(:sym "fsOpen!" :mod "asl-store-fs/fs" :kind fn! :sig "fsOpen! root: String segmentMax: Int64 -> (Result FsStore String)" :pit (result effect))
(:sym "fsOpenWith!" :mod "asl-store-fs/fs" :kind fn! :sig "fsOpenWith! root: String segmentMax: Int64 recover: (fn [String Int64] -> lg/Recovered) -> (Result FsStore String)" :pit (effect))
(:sym "fsCall!" :mod "asl-store-fs/fs" :kind fn! :sig "fsCall! st: FsStore op: ty/Op -> ty/Reply" :pit (effect))
(:sym "fsFault!" :mod "asl-store-fs/fs" :kind fn! :sig "fsFault! st: FsStore name: String arg: String -> Bool" :pit (effect))
(:sym "Recovered" :mod "asl-store-fs/log" :kind type :sig "(schema Recovered (:f rows (List ty/LogRow)) (:f keep String) (:f torn Bool) (:f err String))" :pit (record))
(:sym "LogCfg" :mod "asl-store-fs/log" :kind type :sig "(schema LogCfg (:f root String) (:f segmentMax Int64) (:f lockWaitMs Int64) (:f recover (fn [String Int64] -> Recovered)))" :pit (record))
(:sym "recoverSegment" :mod "asl-store-fs/log" :sig "recoverSegment text: String base: Int64 -> Recovered")
(:sym "defaultRecover" :mod "asl-store-fs/log" :sig "defaultRecover -> (fn [String Int64] -> Recovered)")
(:sym "logAppend!" :mod "asl-store-fs/log" :kind fn! :sig "logAppend! cfg: LogCfg stream: String value: String now: Int64 -> ty/Reply" :pit (effect))
(:sym "logRead!" :mod "asl-store-fs/log" :kind fn! :sig "logRead! cfg: LogCfg stream: String from: Int64 limit: Int64 -> ty/Reply" :pit (effect))
(:sym "logCommit!" :mod "asl-store-fs/log" :kind fn! :sig "logCommit! cfg: LogCfg stream: String consumer: String offset: Int64 -> ty/Reply" :pit (effect))
(:sym "logCursor!" :mod "asl-store-fs/log" :kind fn! :sig "logCursor! cfg: LogCfg stream: String consumer: String -> ty/Reply" :pit (effect))
(:sym "ensureTree!" :mod "asl-store-fs/log" :kind fn! :sig "ensureTree! p: String -> (Result Unit String)" :pit (result effect))
(:sym "lockUntil!" :mod "asl-store-fs/log" :kind fn! :sig "lockUntil! path: String untilNs: Int64 -> (Result Int64 String)" :pit (result effect))
(:sym "dirName" :mod "asl-store-fs/log" :sig "dirName p: String -> String")
(:sym "replaceFile!" :mod "asl-store-fs/log" :kind fn! :sig "replaceFile! path: String text: String -> (Result Unit String)" :pit (result effect))
(:sym "segBases!" :mod "asl-store-fs/log" :kind fn! :sig "segBases! cfg: LogCfg stream: String -> (List Int64)" :pit (effect))
(:sym "segPath" :mod "asl-store-fs/log" :sig "segPath cfg: LogCfg stream: String base: Int64 -> String")
(:sym "WalOpType" :mod "asl-store-fs/wal" :kind type :sig "(enum WalOpType (:c opPutVector [] \"Vector embedding insertion\") (:c opPutNode [] \"Knowledge graph node addition\") (:c opPutEdge [] \"Knowledge graph edge addition\") (:c opDelNode [] \"Knowledge graph node deletion\") (:c opCheckpoint [] \"Compaction checkpoint snapshot marker\") (:c opLogAppend [] \"Log  ...")
(:sym "WalEntry" :mod "asl-store-fs/wal" :kind type :sig "(schema WalEntry (:f seqNum I64) (:f timestampEpoch I64) (:f opType WalOpType) (:f key Str) (:f payload Str) (:f checksum I64))" :pit (record))
(:sym "WalState" :mod "asl-store-fs/wal" :kind type :sig "(schema WalState (:f logPath Str) (:f currentSeq I64) (:f unflushed (List WalEntry)) (:f totalCommitted I64))" :pit (record))
(:sym "WalStreamResult" :mod "asl-store-fs/wal" :kind type :sig "(enum WalStreamResult (:c walSuccess [(entries (List WalEntry))]) (:c walGap [(expectedSeq I64) (actualSeq I64)]) (:c walCorrupt [(lineIndex I64) (reason Str)]))")
(:sym "makeWalEntry" :mod "asl-store-fs/wal" :sig "makeWalEntry seq: I64 epoch: I64 op: WalOpType key: Str payload: Str -> WalEntry")
(:sym "computeWalChecksum" :mod "asl-store-fs/wal" :sig "computeWalChecksum seq: I64 epoch: I64 opStr: Str key: Str payload: Str -> I64")
(:sym "makeWalState" :mod "asl-store-fs/wal" :sig "makeWalState path: Str -> WalState")
(:sym "appendWalEntry" :mod "asl-store-fs/wal" :sig "appendWalEntry st: WalState op: WalOpType key: Str payload: Str epoch: I64 -> (Pair WalState WalEntry)")
(:sym "formatWalFrame" :mod "asl-store-fs/wal" :sig "formatWalFrame e: WalEntry -> Str")
(:sym "parseWalFrame" :mod "asl-store-fs/wal" :sig "parseWalFrame raw: Str -> (Option WalEntry)" :pit (option))
(:sym "parseWalStream" :mod "asl-store-fs/wal" :sig "parseWalStream rawLog: Str -> (List WalEntry)")
(:sym "parseWalStreamStrict" :mod "asl-store-fs/wal" :sig "parseWalStreamStrict rawLog: Str startSeq: I64 -> WalStreamResult")
(:sym "isWalSuccess?" :mod "asl-store-fs/wal" :sig "isWalSuccess? res: WalStreamResult -> Bool")
(:sym "isWalGap?" :mod "asl-store-fs/wal" :sig "isWalGap? res: WalStreamResult -> Bool")
(:sym "isWalCorrupt?" :mod "asl-store-fs/wal" :sig "isWalCorrupt? res: WalStreamResult -> Bool")
(:sym "walDrainUnflushed" :mod "asl-store-fs/wal" :sig "walDrainUnflushed st: WalState -> (Pair WalState (List WalEntry))")
(:sym "walRollbackUnflushed" :mod "asl-store-fs/wal" :sig "walRollbackUnflushed st: WalState -> WalState")
(:sym "walCheckpointMarker" :mod "asl-store-fs/wal" :sig "walCheckpointMarker st: WalState epoch: I64 snapshotHash: Str -> (Pair WalState WalEntry)")
(:sym "opTypeToString" :mod "asl-store-fs/wal" :sig "opTypeToString op: WalOpType -> Str")
(:sym "stringToOpType" :mod "asl-store-fs/wal" :sig "stringToOpType s: Str -> (Option WalOpType)" :pit (option))
