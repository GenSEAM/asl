(:card "asl-cas" :purpose "Content-addressed blob store: sha256 put/get with re-hash on read, atomic writes, owner pins with reference counts, grace-period gc with a typed receipt, pure AgentSlang" :import "(asl-cas/cas :a x)" :modules ((:m "asl-cas/cas")) :sigs ("(schema Cas (:f root String) (:f graceMs Int64) (:f lockWaitMs Int64))" "(schema BlobStat (:f hash String) (:f size Int64) (:f pins Int64))" "(schema GcReceipt (:f removed (List String)) (:f pinned Int64) (:f young Int64) (:f tmpRemoved Int64) (:f errors (List String)))" "casOpen! root: String graceMs: Int64 -> (Result Cas String)" "validHash? h: String -> Bool" "validOwner? o: String -> Bool" "blobPath cas: Cas h: String -> (Option String)" "put! cas: Cas data: Bytes -> (Result String String)") :more (putWith! putFile! get! has? stat! pin! unpin! pinsOf! gc! gcWith!) :effects (casOpen! put! putWith! putFile! get! has? stat! pin!) :fails (casOpen! put! putFile! get! pin! unpin! pinsOf!) :example none)
(:sym "Cas" :mod "asl-cas/cas" :kind type :sig "(schema Cas (:f root String) (:f graceMs Int64) (:f lockWaitMs Int64))" :pit (record))
(:sym "BlobStat" :mod "asl-cas/cas" :kind type :sig "(schema BlobStat (:f hash String) (:f size Int64) (:f pins Int64))" :pit (record))
(:sym "GcReceipt" :mod "asl-cas/cas" :kind type :sig "(schema GcReceipt (:f removed (List String)) (:f pinned Int64) (:f young Int64) (:f tmpRemoved Int64) (:f errors (List String)))" :pit (record))
(:sym "casOpen!" :mod "asl-cas/cas" :kind fn! :sig "casOpen! root: String graceMs: Int64 -> (Result Cas String)" :pit (result effect))
(:sym "validHash?" :mod "asl-cas/cas" :sig "validHash? h: String -> Bool")
(:sym "validOwner?" :mod "asl-cas/cas" :sig "validOwner? o: String -> Bool")
(:sym "blobPath" :mod "asl-cas/cas" :sig "blobPath cas: Cas h: String -> (Option String)" :pit (option))
(:sym "put!" :mod "asl-cas/cas" :kind fn! :sig "put! cas: Cas data: Bytes -> (Result String String)" :pit (result effect))
(:sym "putWith!" :mod "asl-cas/cas" :kind fn! :sig "putWith! cas: Cas data: Bytes between: (fn ! [] -> Unit) staged: (fn ! [] -> Unit) -> (Result String String)" :pit (effect))
(:sym "putFile!" :mod "asl-cas/cas" :kind fn! :sig "putFile! cas: Cas path: String -> (Result String String)" :pit (result effect))
(:sym "get!" :mod "asl-cas/cas" :kind fn! :sig "get! cas: Cas h: String -> (Result (Option Bytes) String)" :pit (result effect))
(:sym "has?" :mod "asl-cas/cas" :kind fn! :sig "has? cas: Cas h: String -> Bool" :pit (effect))
(:sym "stat!" :mod "asl-cas/cas" :kind fn! :sig "stat! cas: Cas h: String -> (Option BlobStat)" :pit (option effect))
(:sym "pin!" :mod "asl-cas/cas" :kind fn! :sig "pin! cas: Cas h: String owner: String -> (Result Int64 String)" :pit (result effect))
(:sym "unpin!" :mod "asl-cas/cas" :kind fn! :sig "unpin! cas: Cas h: String owner: String -> (Result Int64 String)" :pit (result effect))
(:sym "pinsOf!" :mod "asl-cas/cas" :kind fn! :sig "pinsOf! cas: Cas h: String -> (Result (List String) String)" :pit (result effect))
(:sym "gc!" :mod "asl-cas/cas" :kind fn! :sig "gc! cas: Cas nowNs: Int64 -> GcReceipt" :pit (effect))
(:sym "gcWith!" :mod "asl-cas/cas" :kind fn! :sig "gcWith! cas: Cas nowNs: Int64 between: (fn ! [] -> Unit) -> GcReceipt" :pit (effect))
