(:card "asl-cas" :purpose "Content-addressed blob store: sha256 put/get with re-hash on read, atomic writes, owner pins with reference counts, grace-period gc with a typed receipt, pure AgentSlang" :import "(asl-cas/cas :a x)" :modules ((:m "asl-cas/cas" :doc "Content-addressed blob store: blobs named by sha256 unde...")) :sigs ("(schema Cas (:f root String) (:f graceMs Int64) (:f lockWaitMs Int64))" "(schema BlobStat (:f hash String) (:f size Int64) (:f pins Int64))" "(schema GcReceipt (:f removed (List String)) (:f pinned Int64) (:f young Int64) (:f tmpRemoved Int64) (:f errors (List String)))" "casOpen! root: String graceMs: Int64 -> (Result Cas String)" "validHash? h: String -> Bool" "validOwner? o: String -> Bool" "blobPath cas: Cas h: String -> (Option String)" "put! cas: Cas data: Bytes -> (Result String String)" "putFile! cas: Cas path: String -> (Result String String)") :more (get! has? stat! pin! unpin! pinsOf! gc! gcWith!) :effects (casOpen! put! putFile! get! has? stat! pin! unpin!) :fails (casOpen! put! putFile! get! pin! unpin! pinsOf!) :example none)
(:sym "Cas" :mod "asl-cas/cas" :kind type :sig "(schema Cas (:f root String) (:f graceMs Int64) (:f lockWaitMs Int64))" :doc "A store: its root directory, the grace period in ms an unpinned blob or a leftover tmp file survives gc, and how long in ms pin!, a dedup put! and gc wait for the store lock root/lock" :pit (record))
(:sym "BlobStat" :mod "asl-cas/cas" :kind type :sig "(schema BlobStat (:f hash String) (:f size Int64) (:f pins Int64))" :doc "Hash, size in bytes and pin count of one stored blob" :pit (record))
(:sym "GcReceipt" :mod "asl-cas/cas" :kind type :sig "(schema GcReceipt (:f removed (List String)) (:f pinned Int64) (:f young Int64) (:f tmpRemoved Int64) (:f errors (List String)))" :doc "What one gc did: hashes removed, pinned blobs, unpinned blobs kept for age (young), tmp files removed, and listing, pin-read and removal errors" :pit (record))
(:sym "casOpen!" :mod "asl-cas/cas" :kind fn! :sig "casOpen! root: String graceMs: Int64 -> (Result Cas String)" :doc "Creates or opens a store at root with blobs, tmp and pins directories; a negative grace is an err" :pit (result effect))
(:sym "validHash?" :mod "asl-cas/cas" :sig "validHash? h: String -> Bool" :doc "True for 64 lowercase hex characters, the only names get, pin and stat accept")
(:sym "validOwner?" :mod "asl-cas/cas" :sig "validOwner? o: String -> Bool" :doc "True for a pin owner id of 1 to 128 letters, digits, dot, underscore or dash, not . or ..")
(:sym "blobPath" :mod "asl-cas/cas" :sig "blobPath cas: Cas h: String -> (Option String)" :doc "The file path root/blobs/<first two hex>/<hash> of a well-formed hash, none for a malformed one" :pit (option))
(:sym "put!" :mod "asl-cas/cas" :kind fn! :sig "put! cas: Cas data: Bytes -> (Result String String)" :doc "Stores bytes and returns their sha256; an intact copy is kept and its mtime refreshed under the store lock, a corrupt one replaced; new bytes go through tmp, fsync, rename and a directory fsync" :pit (result effect))
(:sym "putFile!" :mod "asl-cas/cas" :kind fn! :sig "putFile! cas: Cas path: String -> (Result String String)" :doc "put! of a file's bytes" :pit (result effect))
(:sym "get!" :mod "asl-cas/cas" :kind fn! :sig "get! cas: Cas h: String -> (Result (Option Bytes) String)" :doc "Reads a blob and re-hashes it: none when absent, a corrupt err when the bytes no longer match the name, an err for a malformed hash" :pit (result effect))
(:sym "has?" :mod "asl-cas/cas" :kind fn! :sig "has? cas: Cas h: String -> Bool" :doc "True when a well-formed hash names a stored blob" :pit (effect))
(:sym "stat!" :mod "asl-cas/cas" :kind fn! :sig "stat! cas: Cas h: String -> (Option BlobStat)" :doc "Size and pin count of a stored blob (-1 pins when they cannot be listed), none when absent" :pit (option effect))
(:sym "pin!" :mod "asl-cas/cas" :kind fn! :sig "pin! cas: Cas h: String owner: String -> (Result Int64 String)" :doc "Adds an owner's pin marker to a stored blob and returns the reference count after it; pinning twice by one owner counts once; the check and the marker run under the store lock, a lock still busy after lockWaitMs is an err" :pit (result effect))
(:sym "unpin!" :mod "asl-cas/cas" :kind fn! :sig "unpin! cas: Cas h: String owner: String -> (Result Int64 String)" :doc "Removes an owner's pin marker under the store lock and returns the reference count left" :pit (result effect))
(:sym "pinsOf!" :mod "asl-cas/cas" :kind fn! :sig "pinsOf! cas: Cas h: String -> (Result (List String) String)" :doc "The owner ids pinning a blob: no pin directory is an empty list, a pin directory that cannot be listed is an err" :pit (result effect))
(:sym "gc!" :mod "asl-cas/cas" :kind fn! :sig "gc! cas: Cas nowNs: Int64 -> GcReceipt" :doc "Removes unpinned blobs and tmp files whose mtime is older than the grace period before nowNs; never a pinned blob nor one whose pins cannot be read (reported in :errors); rechecks pins and age before each removal; with pins/ unreadable it r..." :pit (effect))
(:sym "gcWith!" :mod "asl-cas/cas" :kind fn! :sig "gcWith! cas: Cas nowNs: Int64 between: (fn ! [] -> Unit) -> GcReceipt" :doc "gc! with a hook run between the plan and the removals, where a concurrent pin! or put! may land; the recheck and the removals run under the store lock pin! and a dedup put! also take, and a lock still busy after lockWaitMs removes no blob a..." :pit (effect))
