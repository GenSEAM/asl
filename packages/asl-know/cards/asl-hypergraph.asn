(:card "asl-hypergraph" :purpose "Pure ASL Codebase Hypergraph Indexer and Sub-80-Token Blast Radius Analysis under ADR D94" :import "(asl-hypergraph :a x)" :deps (asl-parser) :modules ((:m "asl-hypergraph" :doc "Root module for pure ASL Codebase Hypergraph Indexer and...") (:m "asl-hypergraph/digest" :doc "High-SNR Perceptual Agent Digest Generator strictly boun...") (:m "asl-hypergraph/index" :doc "Pure ASL Codebase Hypergraph index extraction, AST analy...") (:m "asl-hypergraph/model" :doc "Pure ASL Codebase Hypergraph data models and constructor...") (:m "asl-hypergraph/query" :doc "Sub-80-token blast radius impact query engine and receip...")) :sigs ("makeHyperNode id: Str kind: Str module: Str symbol: Str doc: Str -> model/HyperNode" "makeHyperEdge source: Str relation: Str target: Str anchor: Str -> model/HyperEdge" "makeHyperIndex version: Int64 nodes: (List model/HyperNode) edges: (List model/HyperEdge) timestamp: Int64 -> model/HyperIndex" "makeImpactReceipt symbol: Str callers: (List Str) callersCount: Int64 tests: (List Str) testsCount: Int64 types: (List Str) status: Str -> model/ImpactReceipt" "findEdgesByTarget edges: (List model/HyperEdge) targetStr: Str relationFilter: (Option Str) -> (List model/HyperEdge)") :more (findEdgesBySource findNodeById extractSymbolsFromSexpr extractNodesAndEdgesFromModule buildHypergraphFromModules serializeHyperIndex deserializeHyperIndex) :moreCount 20 :effects (loadOrBuildHyperIndex!) :fails (deserializeHyperIndex) :example none)
