(:card "asl-store" :purpose "Storage contract of the shared vault: Key, Op and Reply rows for kv and log, pure decision rules, the memStep adapter, the single-line wire form and the conformance runner, pure AgentSlang" :import "(asl-store/types :a x)" :modules ((:m "asl-store/types") (:m "asl-store/conform") (:m "asl-store/kv") (:m "asl-store/mem") (:m "asl-store/purity")) :moduleCount 6 :sigs ("(schema Key (:f collection String) (:f id String))" "(schema ScanRow (:f id String) (:f rev Int64) (:f value String) (:f expiresAt Int64))" "(schema LogRow (:f offset Int64) (:f value String) (:f at Int64))" "(enum Op (:c opGet [(key Key) (now Int64)]) (:c opPut [(key Key) (value String) (ttlMs Int64) (now Int64)]) (:c opCas [(key Key) (expectRev ..." "(enum Reply (:c rValue [(rev Int64) (value String) (expiresAt Int64)]) (:c rAbsent []) (:c rWritten [(rev Int64)]) (:c rConflict [(currentRe..." "maxValueBytes -> Int64" "maxScanLimit -> Int64" "nameOk? s: String -> Bool") :more (keyOk? checkOp capLimit errReply Step Script ScriptRun parseScript runPure runEff failureOf Entry Outcome liveAt? expiryOf decide scanPage readPage commitCheck) :moreCount 16 :effects (runEff) :fails (parseScript sxRead opParse) :example none)
(:sym "Key" :mod "asl-store/types" :kind type :sig "(schema Key (:f collection String) (:f id String))" :pit (record))
(:sym "ScanRow" :mod "asl-store/types" :kind type :sig "(schema ScanRow (:f id String) (:f rev Int64) (:f value String) (:f expiresAt Int64))" :pit (record))
(:sym "LogRow" :mod "asl-store/types" :kind type :sig "(schema LogRow (:f offset Int64) (:f value String) (:f at Int64))" :pit (record))
(:sym "Op" :mod "asl-store/types" :kind type :sig "(enum Op (:c opGet [(key Key) (now Int64)]) (:c opPut [(key Key) (value String) (ttlMs Int64) (now Int64)]) (:c opCas [(key Key) (expectRev Int64) (value String) (ttlMs Int64) (now Int64)]) (:c opDel [(key Key) (expectRev Int64) (now Int64)]) (:c opScan [(collection String) (prefix String) (after St ...")
(:sym "Reply" :mod "asl-store/types" :kind type :sig "(enum Reply (:c rValue [(rev Int64) (value String) (expiresAt Int64)]) (:c rAbsent []) (:c rWritten [(rev Int64)]) (:c rConflict [(currentRev Int64)]) (:c rDeleted []) (:c rPage [(rows (List ScanRow)) (next String)]) (:c rErr [(code String) (text String)]) (:c rAppended [(offset Int64)]) (:c rRecord ...")
(:sym "maxValueBytes" :mod "asl-store/types" :sig "maxValueBytes -> Int64")
(:sym "maxScanLimit" :mod "asl-store/types" :sig "maxScanLimit -> Int64")
(:sym "nameOk?" :mod "asl-store/types" :sig "nameOk? s: String -> Bool")
(:sym "keyOk?" :mod "asl-store/types" :sig "keyOk? k: Key -> Bool")
(:sym "checkOp" :mod "asl-store/types" :sig "checkOp op: Op -> (Option Reply)" :pit (option))
(:sym "capLimit" :mod "asl-store/types" :sig "capLimit l: Int64 -> Int64")
(:sym "errReply" :mod "asl-store/types" :sig "errReply code: String text: String -> Reply")
(:sym "opGet" :mod "asl-store/types" :kind ctor :sig "(:c opGet [(key Key) (now Int64)]) of Op" :pit (ctor))
(:sym "opPut" :mod "asl-store/types" :kind ctor :sig "(:c opPut [(key Key) (value String) (ttlMs Int64) (now Int64)]) of Op" :pit (ctor))
(:sym "opCas" :mod "asl-store/types" :kind ctor :sig "(:c opCas [(key Key) (expectRev Int64) (value String) (ttlMs Int64) (now Int64)]) of Op" :pit (ctor))
(:sym "opDel" :mod "asl-store/types" :kind ctor :sig "(:c opDel [(key Key) (expectRev Int64) (now Int64)]) of Op" :pit (ctor))
(:sym "opScan" :mod "asl-store/types" :kind ctor :sig "(:c opScan [(collection String) (prefix String) (after String) (limit Int64) (now Int64)]) of Op" :pit (ctor))
(:sym "opAppend" :mod "asl-store/types" :kind ctor :sig "(:c opAppend [(stream String) (value String) (now Int64)]) of Op" :pit (ctor))
(:sym "opRead" :mod "asl-store/types" :kind ctor :sig "(:c opRead [(stream String) (fromOffset Int64) (limit Int64)]) of Op" :pit (ctor))
(:sym "opCommit" :mod "asl-store/types" :kind ctor :sig "(:c opCommit [(stream String) (consumer String) (offset Int64)]) of Op" :pit (ctor))
(:sym "opCursor" :mod "asl-store/types" :kind ctor :sig "(:c opCursor [(stream String) (consumer String)])) of Op" :pit (ctor))
(:sym "rValue" :mod "asl-store/types" :kind ctor :sig "(:c rValue [(rev Int64) (value String) (expiresAt Int64)]) of Reply" :pit (ctor))
(:sym "rAbsent" :mod "asl-store/types" :kind ctor :sig "(:c rAbsent []) of Reply" :pit (ctor))
(:sym "rWritten" :mod "asl-store/types" :kind ctor :sig "(:c rWritten [(rev Int64)]) of Reply" :pit (ctor))
(:sym "rConflict" :mod "asl-store/types" :kind ctor :sig "(:c rConflict [(currentRev Int64)]) of Reply" :pit (ctor))
(:sym "rDeleted" :mod "asl-store/types" :kind ctor :sig "(:c rDeleted []) of Reply" :pit (ctor))
(:sym "rPage" :mod "asl-store/types" :kind ctor :sig "(:c rPage [(rows (List ScanRow)) (next String)]) of Reply" :pit (ctor))
(:sym "rErr" :mod "asl-store/types" :kind ctor :sig "(:c rErr [(code String) (text String)]) of Reply" :pit (ctor))
(:sym "rAppended" :mod "asl-store/types" :kind ctor :sig "(:c rAppended [(offset Int64)]) of Reply" :pit (ctor))
(:sym "rRecords" :mod "asl-store/types" :kind ctor :sig "(:c rRecords [(rows (List LogRow)) (next Int64)]) of Reply" :pit (ctor))
(:sym "rCommitted" :mod "asl-store/types" :kind ctor :sig "(:c rCommitted [(offset Int64)]) of Reply" :pit (ctor))
(:sym "rOffset" :mod "asl-store/types" :kind ctor :sig "(:c rOffset [(n Int64)])) of Reply" :pit (ctor))
(:sym "Step" :mod "asl-store/conform" :kind type :sig "(enum Step (:c stepOp [(op ty/Op) (expect w/Sx) (src String)]) (:c stepFault [(name String) (arg String)]))")
(:sym "Script" :mod "asl-store/conform" :kind type :sig "(schema Script (:f id String) (:f declared Int64) (:f steps (List Step)))" :pit (record))
(:sym "ScriptRun" :mod "asl-store/conform" :kind type :sig "(schema ScriptRun (:f id String) (:f declared Int64) (:f executed Int64) (:f failures (List String)))" :pit (record))
(:sym "stepOp" :mod "asl-store/conform" :kind ctor :sig "(:c stepOp [(op ty/Op) (expect w/Sx) (src String)]) of Step" :pit (ctor))
(:sym "stepFault" :mod "asl-store/conform" :kind ctor :sig "(:c stepFault [(name String) (arg String)])) of Step" :pit (ctor))
(:sym "parseScript" :mod "asl-store/conform" :sig "parseScript text: String -> (Result Script String)" :pit (result))
(:sym "runPure" :mod "asl-store/conform" :sig "runPure script: Script step: (fn [mem/MemState ty/Op] -> (Pair mem/MemState ty/Reply)) -> ScriptRun")
(:sym "runEff" :mod "asl-store/conform" :kind fn! :sig "runEff script: Script call: (fn ! [ty/Op] -> ty/Reply) fault: (fn ! [String String] -> Bool) -> ScriptRun" :pit (effect))
(:sym "failureOf" :mod "asl-store/conform" :sig "failureOf id: String n: Int64 src: String expect: w/Sx reply: ty/Reply -> (Option String)" :pit (option))
(:sym "Entry" :mod "asl-store/kv" :kind type :sig "(schema Entry (:f rev Int64) (:f value String) (:f expiresAt Int64))" :pit (record))
(:sym "Outcome" :mod "asl-store/kv" :kind type :sig "(schema Outcome (:f write (Option Entry)) (:f remove Bool) (:f reply ty/Reply))" :pit (record))
(:sym "liveAt?" :mod "asl-store/kv" :sig "liveAt? e: Entry now: Int64 -> Bool")
(:sym "expiryOf" :mod "asl-store/kv" :sig "expiryOf ttlMs: Int64 now: Int64 -> Int64")
(:sym "decide" :mod "asl-store/kv" :sig "decide cur: (Option Entry) op: ty/Op -> Outcome")
(:sym "scanPage" :mod "asl-store/kv" :sig "scanPage rows: (List ty/ScanRow) prefix: String after: String limit: Int64 -> ty/Reply")
(:sym "readPage" :mod "asl-store/kv" :sig "readPage rows: (List ty/LogRow) from: Int64 limit: Int64 -> ty/Reply")
(:sym "commitCheck" :mod "asl-store/kv" :sig "commitCheck length: Int64 current: Int64 offset: Int64 -> (Option ty/Reply)" :pit (option))
(:sym "keyOfOp" :mod "asl-store/kv" :sig "keyOfOp op: ty/Op -> ty/Key")
(:sym "MemState" :mod "asl-store/mem" :kind type :sig "(schema MemState (:f rows (Map String kv/Entry)) (:f logs (Map String (List ty/LogRow))) (:f cursors (Map String Int64)))" :pit (record))
(:sym "memEmpty" :mod "asl-store/mem" :sig "memEmpty -> MemState")
(:sym "memStep" :mod "asl-store/mem" :sig "memStep st: MemState op: ty/Op -> (Pair MemState ty/Reply)")
(:sym "stripText" :mod "asl-store/purity" :sig "stripText s: String -> String")
(:sym "impureHits" :mod "asl-store/purity" :sig "impureHits text: String -> (List String)")
(:sym "Sx" :mod "asl-store/wire" :kind type :sig "(enum Sx (:c sxAtom [(text String)]) (:c sxStr [(text String)]) (:c sxList [(items (List Sx))]))")
(:sym "ReadAt" :mod "asl-store/wire" :kind type :sig "(schema ReadAt (:f next Int64) (:f sx Sx))" :pit (record))
(:sym "sxAtom" :mod "asl-store/wire" :kind ctor :sig "(:c sxAtom [(text String)]) of Sx" :pit (ctor))
(:sym "sxStr" :mod "asl-store/wire" :kind ctor :sig "(:c sxStr [(text String)]) of Sx" :pit (ctor))
(:sym "sxList" :mod "asl-store/wire" :kind ctor :sig "(:c sxList [(items (List Sx))])) of Sx" :pit (ctor))
(:sym "sxRead" :mod "asl-store/wire" :sig "sxRead src: String -> (Result (List Sx) String)" :pit (result))
(:sym "sxShow" :mod "asl-store/wire" :sig "sxShow x: Sx -> String")
(:sym "sxMatch" :mod "asl-store/wire" :sig "sxMatch expect: Sx actual: Sx -> Bool")
(:sym "opParse" :mod "asl-store/wire" :sig "opParse x: Sx -> (Result ty/Op String)" :pit (result))
(:sym "replyShow" :mod "asl-store/wire" :sig "replyShow r: ty/Reply -> Sx")
(:sym "leafText" :mod "asl-store/wire" :sig "leafText x: Sx -> String")
(:sym "headOr" :mod "asl-store/wire" :sig "headOr xs: (List Sx) -> Sx")
(:sym "tailOr" :mod "asl-store/wire" :sig "tailOr xs: (List Sx) -> (List Sx)")
