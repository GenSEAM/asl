(:card "asl-replay" :purpose "Pure AgentSlang Deterministic Execution Replay Engine and Canonical Event Streamer" :import "(asl-replay :a x)" :modules ((:m "asl-replay" :doc "Pure AgentSlang Deterministic Execution Replay and Canon...") (:m "asl-replay/record" :doc "Deterministic Agent Event Streaming Recorder and Volatil...") (:m "asl-replay/replay" :doc "Deterministic Replay Execution Engine, Step-Level State ...")) :sigs ("(schema ReplayEvent (:f step Int64) (:f kind String) (:f payload String) (:f stateDigest String) (:f volatileMetadata String))" "(schema ReplaySession (:f sessionId String) (:f events (List ReplayEvent)) (:f initialDigest String))" "makeReplayEvent step: Int64 kind: String payload: String stateDigest: String volatileMetadata: String -> ReplayEvent" "recordAgentEvent step: Int64 kind: String payload: String stateDigest: String -> ReplayEvent" "normalizeVolatileFields event: ReplayEvent -> String" "calculateEventDigest event: ReplayEvent -> String") :more (createReplaySession DivergenceReport makeDivergenceReport verifyStateDigest detectDivergence getDivergenceReport replayEventStream) :fails (detectDivergence replayEventStream) :example none)
(:sym "ReplayEvent" :mod "asl-replay" :sig none)
(:sym "ReplaySession" :mod "asl-replay" :sig none)
(:sym "DivergenceReport" :mod "asl-replay" :sig none)
(:sym "ReplayEvent" :mod "asl-replay/record" :kind type :sig "(schema ReplayEvent (:f step Int64) (:f kind String) (:f payload String) (:f stateDigest String) (:f volatileMetadata String))" :pit (record))
(:sym "ReplaySession" :mod "asl-replay/record" :kind type :sig "(schema ReplaySession (:f sessionId String) (:f events (List ReplayEvent)) (:f initialDigest String))" :pit (record))
(:sym "makeReplayEvent" :mod "asl-replay/record" :sig "makeReplayEvent step: Int64 kind: String payload: String stateDigest: String volatileMetadata: String -> ReplayEvent")
(:sym "recordAgentEvent" :mod "asl-replay/record" :sig "recordAgentEvent step: Int64 kind: String payload: String stateDigest: String -> ReplayEvent")
(:sym "normalizeVolatileFields" :mod "asl-replay/record" :sig "normalizeVolatileFields event: ReplayEvent -> String")
(:sym "calculateEventDigest" :mod "asl-replay/record" :sig "calculateEventDigest event: ReplayEvent -> String")
(:sym "createReplaySession" :mod "asl-replay/record" :sig "createReplaySession sessionId: String events: (List ReplayEvent) initialDigest: String -> ReplaySession")
(:sym "DivergenceReport" :mod "asl-replay/replay" :kind type :sig "(schema DivergenceReport (:f diverged Bool) (:f step Int64) (:f expectedDigest String) (:f actualDigest String) (:f reason String))" :pit (record))
(:sym "makeDivergenceReport" :mod "asl-replay/replay" :sig "makeDivergenceReport diverged: Bool step: Int64 expectedDigest: String actualDigest: String reason: String -> DivergenceReport")
(:sym "verifyStateDigest" :mod "asl-replay/replay" :sig "verifyStateDigest expectedDigest: String actualDigest: String -> Bool")
(:sym "detectDivergence" :mod "asl-replay/replay" :sig "detectDivergence session: record/ReplaySession actualStates: (List String) -> (Result Bool DivergenceReport)" :pit (result))
(:sym "getDivergenceReport" :mod "asl-replay/replay" :sig "getDivergenceReport res: (Result Bool DivergenceReport) -> DivergenceReport")
(:sym "replayEventStream" :mod "asl-replay/replay" :sig "replayEventStream session: record/ReplaySession -> (Result String DivergenceReport)" :pit (result))
