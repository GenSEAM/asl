(:card "asl-stats" :purpose "Descriptive statistics, F64Array sort and type 7 quantile and quickselect, checked normal and Student quantiles, independent rng streams by xoshiro jump, effect sizes, Wilson and Clopper-Pearson and t and bootstrap inter..." :import "(asl-stats/describe :a x)" :deps (asl-linalg) :modules ((:m "asl-stats/describe" :doc "Descriptive statistics and effect sizes returning (Resul...") (:m "asl-stats/agree" :doc "Rank correlation and rater agreement: average ranks, Pea...") (:m "asl-stats/interval" :doc "Confidence intervals and a sample-size formula: Wilson, ...") (:m "asl-stats/order" :doc "F64Array order statistics: merge sort, type 7 quantile, ...") (:m "asl-stats/regress" :doc "Regression models on a row-major n x k F64Array design w...")) :moduleCount 7 :sigs ("sumKahan xs: (List Float64) -> Float64" "finiteValue? x: Float64 -> Bool" "mean xs: (List Float64) -> (Result Float64 String)" "variance xs: (List Float64) -> (Result Float64 String)" "popVariance xs: (List Float64) -> (Result Float64 String)" "stddev xs: (List Float64) -> (Result Float64 String)" "median xs: (List Float64) -> (Result Float64 String)" "percentile xs: (List Float64) p: Float64 -> (Result Float64 String)" "percentileSorted sorted: (List Float64) p: Float64 -> (Result Float64 String)" "percentileOf xs: (List Float64) v: Float64 -> (Result Float64 String)") :more (mad robustZ cohenD hedgesG statsEmpty statsTooFew ranks spearman pearson cohenKappa weightedKappa BootResult wilson clopperPearson meanCi bootstrapPercentile) :moreCount 41 :effects (ranks spearman bootstrapPercentile sortF64 selectF64 ols olsClassical logit) :fails (mean variance popVariance stddev median percentile percentileSorted percentileOf) :example none)
(:sym "sumKahan" :mod "asl-stats/describe" :sig "sumKahan xs: (List Float64) -> Float64" :doc "Neumaier compensated sum; an infinity in the input gives that infinity, inf minus inf gives NaN")
(:sym "finiteValue?" :mod "asl-stats/describe" :sig "finiteValue? x: Float64 -> Bool" :doc "true for a Float64 that is neither NaN nor infinite; mean and everything built on it refuse anything else as statsRange")
(:sym "mean" :mod "asl-stats/describe" :sig "mean xs: (List Float64) -> (Result Float64 String)" :doc "arithmetic mean; err statsEmpty on no values" :pit (result))
(:sym "variance" :mod "asl-stats/describe" :sig "variance xs: (List Float64) -> (Result Float64 String)" :doc "sample variance with n-1; err statsEmpty on no values, statsTooFew on one" :pit (result))
(:sym "popVariance" :mod "asl-stats/describe" :sig "popVariance xs: (List Float64) -> (Result Float64 String)" :doc "population variance with n; err statsEmpty on no values" :pit (result))
(:sym "stddev" :mod "asl-stats/describe" :sig "stddev xs: (List Float64) -> (Result Float64 String)" :doc "square root of the sample variance" :pit (result))
(:sym "median" :mod "asl-stats/describe" :sig "median xs: (List Float64) -> (Result Float64 String)" :doc "50th percentile" :pit (result))
(:sym "percentile" :mod "asl-stats/describe" :sig "percentile xs: (List Float64) p: Float64 -> (Result Float64 String)" :doc "linear interpolation between order statistics (R type 7), p in 0..100; err statsRange outside, statsEmpty on no values" :pit (result))
(:sym "percentileSorted" :mod "asl-stats/describe" :sig "percentileSorted sorted: (List Float64) p: Float64 -> (Result Float64 String)" :doc "percentile of an already ascending list; err statsRange for p outside 0..100 or NaN" :pit (result))
(:sym "percentileOf" :mod "asl-stats/describe" :sig "percentileOf xs: (List Float64) v: Float64 -> (Result Float64 String)" :doc "percentile rank of a value: (count below + half the ties) / n * 100" :pit (result))
(:sym "mad" :mod "asl-stats/describe" :sig "mad xs: (List Float64) -> (Result Float64 String)" :doc "median absolute deviation, unscaled" :pit (result))
(:sym "robustZ" :mod "asl-stats/describe" :sig "robustZ x: Float64 xs: (List Float64) -> (Result Float64 String)" :doc "(x - median) / (1.4826 * MAD); err statsConstant when MAD is 0" :pit (result))
(:sym "cohenD" :mod "asl-stats/describe" :sig "cohenD a: (List Float64) b: (List Float64) -> (Result Float64 String)" :doc "(mean a - mean b) / pooled sample standard deviation; errs statsTooFew and statsConstant" :pit (result))
(:sym "hedgesG" :mod "asl-stats/describe" :sig "hedgesG a: (List Float64) b: (List Float64) -> (Result Float64 String)" :doc "Cohen d times 1 - 3/(4(n1+n2)-9)" :pit (result))
(:sym "statsEmpty" :mod "asl-stats/describe" :sig "statsEmpty -> String" :doc "label of the empty-input err")
(:sym "statsTooFew" :mod "asl-stats/describe" :sig "statsTooFew -> String" :doc "label of the fewer-than-two-values err")
(:sym "ranks" :mod "asl-stats/agree" :kind fn! :sig "ranks xs: (List Float64) -> (Result (List Float64) String)" :doc "(Result (List Float64) String): 1-based average ranks, ties share the mean of the ranks they span; err statsRange for a NaN or infinite value" :pit (result effect))
(:sym "spearman" :mod "asl-stats/agree" :kind fn! :sig "spearman xs: (List Float64) ys: (List Float64) -> (Result Float64 String)" :doc "Pearson correlation of the average ranks; errs statsEmpty, statsTooFew, statsRange on unequal lengths or a NaN or infinite value, statsConstant on a constant series" :pit (result effect))
(:sym "pearson" :mod "asl-stats/agree" :sig "pearson xs: (List Float64) ys: (List Float64) -> (Result Float64 String)" :doc "Pearson correlation; same errs as spearman, including statsRange for NaN or infinite values" :pit (result))
(:sym "cohenKappa" :mod "asl-stats/agree" :sig "cohenKappa t: (List (List Int64)) -> (Result Float64 String)" :doc "Cohen kappa of a square count table, rows rater A, columns rater B" :pit (result))
(:sym "weightedKappa" :mod "asl-stats/agree" :sig "weightedKappa t: (List (List Int64)) kind: String -> (Result Float64 String)" :doc "kappa with none, linear or quadratic weights; errs statsRange, statsEmpty, statsConstant" :pit (result))
(:sym "BootResult" :mod "asl-stats/interval" :kind type :sig "schema BootResult (:f lo Float64) (:f hi Float64) (:f estimate Float64) (:f rng rg/Rng)" :doc "bootstrap lo, hi, the statistic on the original sample, and the advanced Rng" :pit (record))
(:sym "wilson" :mod "asl-stats/interval" :sig "wilson x: Int64 n: Int64 conf: Float64 -> (Result (Pair Float64 Float64) String)" :doc "Wilson score interval for x of n at confidence conf as (lo hi); errs statsRange for bad counts or conf" :pit (result))
(:sym "clopperPearson" :mod "asl-stats/interval" :sig "clopperPearson x: Int64 n: Int64 conf: Float64 -> (Result (Pair Float64 Float64) String)" :doc "exact binomial interval from beta quantiles; lower bound 0 at x=0 and upper 1 at x=n" :pit (result))
(:sym "meanCi" :mod "asl-stats/interval" :sig "meanCi xs: (List Float64) conf: Float64 -> (Result (Pair Float64 Float64) String)" :doc "Student t interval of the mean; errs statsEmpty, statsTooFew, statsRange" :pit (result))
(:sym "bootstrapPercentile" :mod "asl-stats/interval" :kind fn! :sig "bootstrapPercentile xs: (List Float64) stat: (fn [(List Float64)] -> Float64) resamples: Int64 conf: Float64 r: rg/Rng -> (Result BootResult String)" :doc "resample with replacement from a seeded Rng, apply the statistic, return the percentile interval, the estimate and the new state; at least 10 and at most 1000000 resamples" :pit (effect))
(:sym "twoProportionSampleSize" :mod "asl-stats/interval" :sig "twoProportionSampleSize p1: Float64 p2: Float64 alpha: Float64 power: Float64 -> (Result Int64 String)" :doc "per-group n to detect p1 vs p2 two-sided at alpha with the given power, rounded up; err statsRange for equal, out-of-range or NaN arguments and for a size that does not fit in Int64" :pit (result))
(:sym "sortF64" :mod "asl-stats/order" :kind fn! :sig "sortF64 a: F64Array -> F64Array" :doc "stable ascending sort, NaN last, input unchanged; 100000 elements take 15 ms native" :pit (effect))
(:sym "quantileF64" :mod "asl-stats/order" :sig "quantileF64 a: F64Array p: Float64 -> (Result Float64 String)" :doc "sort then quantileSortedF64; NaN in the data is err statsNaN" :pit (result))
(:sym "quantileSortedF64" :mod "asl-stats/order" :sig "quantileSortedF64 s: F64Array p: Float64 -> (Result Float64 String)" :doc "R type 7 quantile of a sorted array: h=(n-1)p, linear interpolation, the order statistic itself when h is an integer (infinities at p 0 or 1 stay infinite); err statsEmpty, statsRange (p outside [0,1] or NaN), statsNaN" :pit (result))
(:sym "quantilesF64" :mod "asl-stats/order" :sig "quantilesF64 a: F64Array ps: (List Float64) -> (Result (List Float64) String)" :doc "several quantiles from one sort" :pit (result))
(:sym "selectF64" :mod "asl-stats/order" :kind fn! :sig "selectF64 a: F64Array k: Int64 -> (Result Float64 String)" :doc "kth smallest, 0-based, expected O(n), 100000 elements take 2 ms native; err statsEmpty, statsRange, statsNaN" :pit (result effect))
(:sym "hasNanF64" :mod "asl-stats/order" :sig "hasNanF64 a: F64Array -> Bool" :doc "true when any element is NaN")
(:sym "Ols" :mod "asl-stats/regress" :kind type :sig "schema Ols (:f coef F64Array) (:f residuals F64Array) (:f rss Float64) (:f rSquared Float64) (:f n Int64) (:f k Int64) (:f df Float64) (:f cov F64Array) (:f se F64Array) (:f tStat F64Array) (:f pValue F64Array) (:f covKind String) (:f clusters Int64) (:f warning String)" :doc "OLS result: coef, residuals, rss, rSquared, n, k, df (t degrees of freedom: n-k for classical and hc1, G-1 for cr1), cov (k x k row-major), se, tStat, pValue (two-sided Student t), covKind, clusters (G, 0 unless cr1), warning (empty, or sem..." :pit (record))
(:sym "Logit" :mod "asl-stats/regress" :kind type :sig "schema Logit (:f coef F64Array) (:f cov F64Array) (:f se F64Array) (:f zStat F64Array) (:f pValue F64Array) (:f logLik Float64) (:f iterations Int64) (:f converged Bool) (:f n Int64) (:f k Int64) (:f covKind String) (:f clusters Int64) (:f warning String)" :doc "logistic result: coef, cov (inverse Fisher information, or the CR1 sandwich), se, zStat, pValue (two-sided normal), logLik, iterations, converged (false when maxIter ran out), n, k, covKind, clusters, warning (notConverged, illConditioned, ..." :pit (record))
(:sym "ols" :mod "asl-stats/regress" :kind fn! :sig "ols n: Int64 k: Int64 x: F64Array y: F64Array kind: String cl: I64Array -> (Result Ols String)" :doc "ols n k x y kind cl: columns are scaled to unit norm first (rank decision, fit and inverse, then scaled back), so 1e-8 and 1e8 columns mix; the constant is detected as the ones vector lying in the column space of X; beta by Householder QR w..." :pit (result effect))
(:sym "olsClassical" :mod "asl-stats/regress" :kind fn! :sig "olsClassical n: Int64 k: Int64 x: F64Array y: F64Array -> (Result Ols String)" :doc "ols with kind classical and no clusters" :pit (result effect))
(:sym "logit" :mod "asl-stats/regress" :kind fn! :sig "logit n: Int64 k: Int64 x: F64Array y: F64Array -> (Result Logit String)" :doc "logitWith from a zero start, classical covariance, maxIter 100, maxHalve 30" :pit (result effect))
(:sym "logitCluster" :mod "asl-stats/regress" :kind fn! :sig "logitCluster n: Int64 k: Int64 x: F64Array y: F64Array cl: I64Array -> (Result Logit String)" :doc "logitWith from a zero start with cr1 cluster-robust covariance (factor G/(G-1) (n-1)/(n-k), scores x_i (y_i - p_i)), normal p-values; Stata logit vce(cluster) uses G/(G-1) only: multiply cov by (n-k)/(n-1) to match it" :pit (result effect))
(:sym "logitWith" :mod "asl-stats/regress" :kind fn! :sig "logitWith n: Int64 k: Int64 x: F64Array y: F64Array kind: String cl: I64Array beta0: F64Array maxIter: Int64 maxHalve: Int64 -> (Result Logit String)" :doc "logistic IRLS with start vector beta0, maxIter and maxHalve; y must be 0 or 1 (logitResponse); the step is halved while the log-likelihood falls; logitSeparation is returned when some |eta| > 10, the log-likelihood gain is below 1e-9 relati..." :pit (result effect))
(:sym "Rng" :mod "asl-stats/rng" :kind type :sig "schema Rng (:f s0 Int64) (:f s1 Int64) (:f s2 Int64) (:f s3 Int64)" :doc "four Int64 state words s0..s3" :pit (record))
(:sym "rngFromState" :mod "asl-stats/rng" :sig "rngFromState a: Int64 b: Int64 c: Int64 d: Int64 -> Rng" :doc "generator from four explicit words, for published test vectors")
(:sym "rngSeed" :mod "asl-stats/rng" :sig "rngSeed seed: Int64 -> Rng" :doc "expand one Int64 into four state words with splitmix64")
(:sym "rngNext" :mod "asl-stats/rng" :sig "rngNext r: Rng -> (Pair Int64 Rng)" :doc "next 64-bit output and the new state")
(:sym "rngFloat" :mod "asl-stats/rng" :sig "rngFloat r: Rng -> (Pair Float64 Rng)" :doc "uniform in [0,1) from the top 53 bits and the new state")
(:sym "rngNormal" :mod "asl-stats/rng" :sig "rngNormal r: Rng -> (Pair Float64 Rng)" :doc "standard normal by Box-Muller, two uniforms per draw")
(:sym "gammaDraw" :mod "asl-stats/rng" :kind fn! :sig "gammaDraw alpha: Float64 r: Rng -> (Result (Pair Float64 Rng) String)" :doc "Gamma(alpha,1) by Marsaglia-Tsang, shape below 1 boosted through shape+1; err statsRange for a shape not above 0" :pit (result effect))
(:sym "logGammaDraw" :mod "asl-stats/rng" :kind fn! :sig "logGammaDraw alpha: Float64 r: Rng -> (Result (Pair Float64 Rng) String)" :doc "log of a Gamma(alpha,1) draw; for a shape below 1 log g + log(u)/alpha with u clamped to 1e-300, finite where the draw underflows" :pit (result effect))
(:sym "betaDraw" :mod "asl-stats/rng" :kind fn! :sig "betaDraw a: Float64 b: Float64 r: Rng -> (Result (Pair Float64 Rng) String)" :doc "Beta(a,b) as 1/(1+exp(log y - log x)) of two log gamma draws, never NaN for tiny shapes; the logistic form can differ from x/(x+y) in the last bit, which moves no value pinned to 1e-9 and no seed-pinned side or count" :pit (result effect))
(:sym "lsr" :mod "asl-stats/rng" :sig "lsr x: Int64 n: Int64 -> Int64" :doc "logical right shift of an Int64")
(:sym "rngJump" :mod "asl-stats/rng" :kind fn! :sig "rngJump r: Rng -> Rng" :doc "the reference xoshiro256** jump, 2^128 steps ahead" :pit (effect))
(:sym "rngStream" :mod "asl-stats/rng" :kind fn! :sig "rngStream seed: Int64 k: Int64 -> (Result Rng String)" :doc "rngStream seed k: the seed's generator jumped k times, an independent stream; k < 0 is err statsRange" :pit (result effect))
(:sym "rngFloats" :mod "asl-stats/rng" :kind fn! :sig "rngFloats n: Int64 r: Rng -> (Result (Pair F64Array Rng) String)" :doc "n uniform draws in [0,1) as an F64Array and the new state" :pit (result effect))
(:sym "rngNormals" :mod "asl-stats/rng" :kind fn! :sig "rngNormals n: Int64 r: Rng -> (Result (Pair F64Array Rng) String)" :doc "n standard normal draws as an F64Array and the new state" :pit (result effect))
(:sym "lgamma" :mod "asl-stats/special" :sig "lgamma x: Float64 -> Float64" :doc "natural log of the gamma function, Lanczos g 7 with 9 terms and reflection below 0.5; about 1e-14 relative")
(:sym "betaInc" :mod "asl-stats/special" :sig "betaInc x: Float64 a: Float64 b: Float64 -> Float64" :doc "regularized incomplete beta I_x(a,b) by continued fraction, 0 at x<=0 and 1 at x>=1")
(:sym "gammaIncP" :mod "asl-stats/special" :sig "gammaIncP a: Float64 x: Float64 -> Float64" :doc "regularized lower incomplete gamma P(a,x) by series below a+1 and continued fraction above")
(:sym "gammaIncQ" :mod "asl-stats/special" :sig "gammaIncQ a: Float64 x: Float64 -> Float64" :doc "upper regularized incomplete gamma, direct from the continued fraction when x >= a+1")
(:sym "normalCdf" :mod "asl-stats/special" :sig "normalCdf z: Float64 -> Float64" :doc "standard normal cdf through P(1/2, z^2/2)")
(:sym "normalSurvival" :mod "asl-stats/special" :sig "normalSurvival z: Float64 -> Float64" :doc "1 - Phi(z) with full tail accuracy")
(:sym "normalPdf" :mod "asl-stats/special" :sig "normalPdf z: Float64 -> Float64" :doc "standard normal density")
(:sym "normalQuantile" :mod "asl-stats/special" :sig "normalQuantile p: Float64 -> Float64" :doc "inverse normal cdf by 120 bisection steps on [-40,40], upper half by symmetry from 1-p")
(:sym "normalQuantileChecked" :mod "asl-stats/special" :sig "normalQuantileChecked p: Float64 -> (Result Float64 String)" :doc "normal quantile for p strictly in (0,1), else err statsRange; upper half by symmetry from the exact 1-p; within 1e-12 absolute of scipy ndtri for p in [1e-300, 1-1e-14]" :pit (result))
(:sym "studentCdf" :mod "asl-stats/special" :sig "studentCdf t: Float64 df: Float64 -> Float64" :doc "Student t cdf: tail 0.5*I_x(df/2,1/2) by continued fraction when t^2 is above about 3 (no subtraction, tails to 1e-75 and below stay relative), 0.5 - I_y(1/2,df/2) near the centre; prefactor by asymptotic Gamma ratio and log1p, no lgamma di...")
(:sym "studentQuantile" :mod "asl-stats/special" :sig "studentQuantile p: Float64 df: Float64 -> Float64" :doc "unchecked Student quantile; upper half by symmetry, df >= 1e5 by series, else cdf bisection on [-1e7,1e7]")
(:sym "studentQuantileChecked" :mod "asl-stats/special" :sig "studentQuantileChecked p: Float64 df: Float64 -> (Result Float64 String)" :doc "Student t quantile; err statsRange for p outside (0,1), df not positive and finite, or an answer past 1e7; df >= 1e5 by the A&S 26.7.5 series within 1e-14 relative, df < 1e5 by bisection of the cdf, asserted within 1e-10 relative of scipy (..." :pit (result))
(:sym "betaQuantile" :mod "asl-stats/special" :sig "betaQuantile p: Float64 a: Float64 b: Float64 -> Float64" :doc "inverse regularized incomplete beta by 200 bisection steps on [0,1]")
