(:card "asl-stats" :purpose "Descriptive statistics, F64Array sort and type 7 quantile and quickselect, checked normal and Student quantiles, independent rng streams by xoshiro jump, effect sizes, Wilson and Clopper-Pearson and t and bootstrap inter..." :import "(asl-stats/describe :a x)" :deps (asl-linalg) :modules ((:m "asl-stats/describe") (:m "asl-stats/agree") (:m "asl-stats/interval") (:m "asl-stats/order") (:m "asl-stats/regress")) :moduleCount 7 :sigs ("sumKahan xs: (List Float64) -> Float64" "finiteValue? x: Float64 -> Bool" "mean xs: (List Float64) -> (Result Float64 String)" "variance xs: (List Float64) -> (Result Float64 String)" "popVariance xs: (List Float64) -> (Result Float64 String)" "stddev xs: (List Float64) -> (Result Float64 String)" "median xs: (List Float64) -> (Result Float64 String)" "percentile xs: (List Float64) p: Float64 -> (Result Float64 String)" "percentileSorted sorted: (List Float64) p: Float64 -> (Result Float64 String)" "percentileOf xs: (List Float64) v: Float64 -> (Result Float64 String)") :more (mad robustZ cohenD hedgesG statsEmpty statsTooFew ranks spearman pearson cohenKappa weightedKappa BootResult wilson clopperPearson meanCi bootstrapPercentile) :moreCount 41 :effects (ranks spearman bootstrapPercentile sortF64 selectF64 ols olsClassical logit) :fails (mean variance popVariance stddev median percentile percentileSorted percentileOf) :example none)
(:sym "sumKahan" :mod "asl-stats/describe" :sig "sumKahan xs: (List Float64) -> Float64")
(:sym "finiteValue?" :mod "asl-stats/describe" :sig "finiteValue? x: Float64 -> Bool")
