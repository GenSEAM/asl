(:card "asl-target-py" :purpose "Python 3 backend: lowers a linked, verified asl-ir SSA module to one self-contained Python file with a small runtime; Int traps on int64 overflow, strings keep ASL's UTF-8 byte semantics, main's result is the exit code" :import "(asl-target-py :a x)" :deps (asl-ir) :modules ((:m "asl-target-py" :doc "Python target entry: compileEntry! links an entry module...") (:m "asl-target-py/emit" :doc "SSA to Python: each function is a while loop over its bl...") (:m "asl-target-py/runtime" :doc "The Python runtime embedded in every emitted file, gener...")) :sigs ("compileEntry! entryPath: String -> (Result String (List ty/IrDiag))" "diagText ds: (List ty/IrDiag) -> String" "pyIdent prefix: String name: String -> String" "emitPyModule m: ty/SsaModule -> (Result String (List ty/IrDiag))" "supportedBuiltins -> (List String)" "runtimeText -> String" "builtinNames -> (List String)" "entryNames -> (List String)") :effects (compileEntry!) :fails (compileEntry! emitPyModule) :example none)
(:sym "compileEntry!" :mod "asl-target-py" :sig "compileEntry! entryPath: String -> (Result String (List ty/IrDiag))" :doc "Link the entry module and emit Python; err lists ERR_CAPABILITY_ABSENT for every builtin the runtime lacks." :pit (result effect))
(:sym "diagText" :mod "asl-target-py" :sig "diagText ds: (List ty/IrDiag) -> String")
(:sym "pyIdent" :mod "asl-target-py/emit" :sig "pyIdent prefix: String name: String -> String")
(:sym "emitPyModule" :mod "asl-target-py/emit" :sig "emitPyModule m: ty/SsaModule -> (Result String (List ty/IrDiag))" :pit (result))
(:sym "supportedBuiltins" :mod "asl-target-py/emit" :sig "supportedBuiltins -> (List String)")
(:sym "runtimeText" :mod "asl-target-py/runtime" :sig "runtimeText -> String")
(:sym "builtinNames" :mod "asl-target-py/runtime" :sig "builtinNames -> (List String)")
(:sym "entryNames" :mod "asl-target-py/runtime" :sig "entryNames -> (List String)")
