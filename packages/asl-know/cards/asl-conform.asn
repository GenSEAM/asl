(:card "asl-conform" :purpose "AgentSlang Multi-Target Semantic Conformance and Mutation Verification Harness" :import "(aslConform/main :a x)" :deps (asl-target-c asl-target-py) :modules ((:m "aslConform/main" :doc "Top-level API for AgentSlang cross-platform target confo...") (:m "aslConform/compare" :doc "Output and exit code comparison utilities for multi-targ...") (:m "asl-conform/hypergraph" :doc "Pure AgentSlang Multi-Dimensional Audit Hypergraph under...") (:m "aslConform/mutant" :doc "Production code mutant application and verification unde...") (:m "aslConform/runner" :doc "Test case execution engine across multi-target profiles")) :moduleCount 7 :sigs ("loadTargetSemantics -> ty/TargetSemanticsContract" "runConformCase! casePath: Str profileId: Str invert: Bool -> ty/ConformanceResult" "applyMutant m: ty/SemanticsMutant code: Str -> Str" "runIsolatedMutantTrial! m: ty/SemanticsMutant casePath: Str -> ty/ConformanceResult" "conformReceipt receipt: ty/ConformReceipt -> Str" "invertComparison actOut: Str actExit: I64 expOut: Str expExit: I64 -> Bool" "runConform! profileId: Str ruleFilter: Str invert: Bool -> (Result Str Str)" "validateRuleMutants contract: ty/TargetSemanticsContract -> Bool") :more (compareOutput invertComparison AuditNode makeAuditNode AuditEdge makeAuditEdge AuditHypergraph makeAuditHypergraph PatchReceipt makePatchReceipt) :moreCount 40 :effects (runConformCase! runIsolatedMutantTrial! runConform! runConformProfile!) :fails (runConform!) :example none)
(:sym "loadTargetSemantics" :mod "aslConform/main" :sig "loadTargetSemantics -> ty/TargetSemanticsContract")
(:sym "runConformCase!" :mod "aslConform/main" :sig "runConformCase! casePath: Str profileId: Str invert: Bool -> ty/ConformanceResult" :pit (effect))
(:sym "applyMutant" :mod "aslConform/main" :sig "applyMutant m: ty/SemanticsMutant code: Str -> Str")
(:sym "runIsolatedMutantTrial!" :mod "aslConform/main" :sig "runIsolatedMutantTrial! m: ty/SemanticsMutant casePath: Str -> ty/ConformanceResult" :pit (effect))
(:sym "conformReceipt" :mod "aslConform/main" :sig "conformReceipt receipt: ty/ConformReceipt -> Str")
(:sym "invertComparison" :mod "aslConform/main" :sig "invertComparison actOut: Str actExit: I64 expOut: Str expExit: I64 -> Bool")
(:sym "runConform!" :mod "aslConform/main" :sig "runConform! profileId: Str ruleFilter: Str invert: Bool -> (Result Str Str)" :pit (result effect))
(:sym "validateRuleMutants" :mod "aslConform/main" :sig "validateRuleMutants contract: ty/TargetSemanticsContract -> Bool")
(:sym "compareOutput" :mod "aslConform/compare" :sig "compareOutput actualStdout: Str actualExit: I64 expectStdout: Str expectExit: I64 -> Bool")
(:sym "invertComparison" :mod "aslConform/compare" :sig "invertComparison actualStdout: Str actualExit: I64 expectStdout: Str expectExit: I64 -> Bool")
(:sym "AuditNode" :mod "asl-conform/hypergraph" :kind type :sig "(schema AuditNode (:f id Str) (:f lens Str) (:f severity Str) (:f anchor Str) (:f evidence Str) (:f remedy Str) (:f provenance Str))" :pit (record))
(:sym "makeAuditNode" :mod "asl-conform/hypergraph" :sig "makeAuditNode id: Str lens: Str severity: Str anchor: Str evidence: Str remedy: Str provenance: Str -> AuditNode")
(:sym "AuditEdge" :mod "asl-conform/hypergraph" :kind type :sig "(schema AuditEdge (:f from Str) (:f to Str) (:f kind Str))" :pit (record))
(:sym "makeAuditEdge" :mod "asl-conform/hypergraph" :sig "makeAuditEdge from: Str to: Str kind: Str -> AuditEdge")
(:sym "AuditHypergraph" :mod "asl-conform/hypergraph" :kind type :sig "(schema AuditHypergraph (:f version Str) (:f timestamp Int64) (:f nodes (List AuditNode)) (:f edges (List AuditEdge)) (:f score Int64))" :pit (record))
(:sym "makeAuditHypergraph" :mod "asl-conform/hypergraph" :sig "makeAuditHypergraph version: Str timestamp: Int64 nodes: (List AuditNode) edges: (List AuditEdge) score: Int64 -> AuditHypergraph")
(:sym "PatchReceipt" :mod "asl-conform/hypergraph" :kind type :sig "(schema PatchReceipt (:f id Str) (:f target Str) (:f status Str) (:f diffStr Str) (:f tokenCount Int64))" :pit (record))
(:sym "makePatchReceipt" :mod "asl-conform/hypergraph" :sig "makePatchReceipt id: Str target: Str status: Str diffStr: Str tokenCount: Int64 -> PatchReceipt")
(:sym "buildAuditHypergraph" :mod "asl-conform/hypergraph" :sig "buildAuditHypergraph nodes: (List AuditNode) edges: (List AuditEdge) -> AuditHypergraph")
(:sym "queryAuditGraph" :mod "asl-conform/hypergraph" :sig "queryAuditGraph graph: AuditHypergraph lensFilter: (Option Str) severityFilter: (Option Str) anchorPrefix: (Option Str) -> (List AuditNode)")
(:sym "findEdgesFrom" :mod "asl-conform/hypergraph" :sig "findEdgesFrom edges: (List AuditEdge) fromNode: Str -> (List AuditEdge)")
(:sym "findEdgesTo" :mod "asl-conform/hypergraph" :sig "findEdgesTo edges: (List AuditEdge) toNode: Str -> (List AuditEdge)")
(:sym "calculateBlastRadius" :mod "asl-conform/hypergraph" :sig "calculateBlastRadius graph: AuditHypergraph targetAnchor: Str -> (List Str)")
(:sym "pathExists?" :mod "asl-conform/hypergraph" :sig "pathExists? edges: (List AuditEdge) src: Str dst: Str visited: (List Str) -> Bool")
(:sym "detectCycles" :mod "asl-conform/hypergraph" :sig "detectCycles edges: (List AuditEdge) -> (List (List Str))")
(:sym "calculateLensScore" :mod "asl-conform/hypergraph" :sig "calculateLensScore nodes: (List AuditNode) targetLens: Str -> Int64")
(:sym "emitPatchReceipt" :mod "asl-conform/hypergraph" :sig "emitPatchReceipt node: AuditNode -> PatchReceipt")
(:sym "formatAuditAsn" :mod "asl-conform/hypergraph" :sig "formatAuditAsn graph: AuditHypergraph -> Str")
(:sym "formatReceiptAsn" :mod "asl-conform/hypergraph" :sig "formatReceiptAsn rc: PatchReceipt -> Str")
(:sym "canonicalLenses" :mod "asl-conform/hypergraph" :sig "canonicalLenses -> (List Str)")
(:sym "applyMutant" :mod "aslConform/mutant" :sig "applyMutant m: ty/SemanticsMutant originalCode: Str -> Str")
(:sym "verifyMutantKilled" :mod "aslConform/mutant" :sig "verifyMutantKilled m: ty/SemanticsMutant mutatedStdout: Str expectedStdout: Str -> Bool")
(:sym "getMutantTarget" :mod "aslConform/mutant" :sig "getMutantTarget m: ty/SemanticsMutant -> Str")
(:sym "getMutantKilledCase" :mod "aslConform/mutant" :sig "getMutantKilledCase m: ty/SemanticsMutant -> Str")
(:sym "runIsolatedMutantTrial!" :mod "aslConform/mutant" :sig "runIsolatedMutantTrial! m: ty/SemanticsMutant casePath: Str -> ty/ConformanceResult" :pit (effect))
(:sym "runConformCase!" :mod "aslConform/runner" :sig "runConformCase! casePath: Str profileId: Str invert: Bool -> ty/ConformanceResult" :pit (effect))
(:sym "runConformProfile!" :mod "aslConform/runner" :sig "runConformProfile! profileId: Str ruleFilter: Str invert: Bool -> ty/ConformReceipt" :pit (effect))
(:sym "formatReceipt" :mod "aslConform/runner" :sig "formatReceipt r: ty/ConformReceipt -> Str")
(:sym "loadTargetSemantics" :mod "aslConform/semantics" :sig "loadTargetSemantics -> ty/TargetSemanticsContract")
(:sym "findRule" :mod "aslConform/semantics" :sig "findRule contract: ty/TargetSemanticsContract ruleId: Str -> (Option ty/SemanticsRule)" :pit (option))
(:sym "findProfile" :mod "aslConform/semantics" :sig "findProfile contract: ty/TargetSemanticsContract profileId: Str -> (Option ty/TargetProfile)" :pit (option))
(:sym "ruleHasMutants?" :mod "aslConform/semantics" :sig "ruleHasMutants? r: ty/SemanticsRule -> Bool")
(:sym "getRuleCases" :mod "aslConform/semantics" :sig "getRuleCases r: ty/SemanticsRule -> (List Str)")
(:sym "getAllRules" :mod "aslConform/semantics" :sig "getAllRules contract: ty/TargetSemanticsContract -> (List ty/SemanticsRule)")
(:sym "getAllProfiles" :mod "aslConform/semantics" :sig "getAllProfiles contract: ty/TargetSemanticsContract -> (List ty/TargetProfile)")
(:sym "getProfiles" :mod "aslConform/semantics" :sig "getProfiles contract: ty/TargetSemanticsContract -> (List ty/TargetProfile)")
(:sym "getTiers" :mod "aslConform/semantics" :sig "getTiers contract: ty/TargetSemanticsContract -> (List Str)")
(:sym "TargetProfile" :mod "aslConform/types" :kind type :sig "(schema TargetProfile (:f id Str) (:f name Str) (:f compiler Str) (:f tier Str))" :pit (record))
(:sym "SemanticsMutant" :mod "aslConform/types" :kind type :sig "(schema SemanticsMutant (:f id Str) (:f target Str) (:f desc Str) (:f kills Str))" :pit (record))
(:sym "SemanticsRule" :mod "aslConform/types" :kind type :sig "(schema SemanticsRule (:f id Str) (:f tier Str) (:f name Str) (:f summary Str) (:f cases (List Str)) (:f mutants (List SemanticsMutant)))" :pit (record))
(:sym "TargetSemanticsContract" :mod "aslConform/types" :kind type :sig "(schema TargetSemanticsContract (:f version I64) (:f profiles (List TargetProfile)) (:f tiers (List Str)) (:f rules (List SemanticsRule)))" :pit (record))
(:sym "ConformanceCase" :mod "aslConform/types" :kind type :sig "(schema ConformanceCase (:f id Str) (:f rule Str) (:f tier Str) (:f oracle Str) (:f srcPath Str) (:f expectStdout Str) (:f expectExit I64))" :pit (record))
(:sym "ConformanceResult" :mod "aslConform/types" :kind type :sig "(schema ConformanceResult (:f caseId Str) (:f profile Str) (:f passed Bool) (:f actualStdout Str) (:f actualExit I64) (:f reason Str))" :pit (record))
(:sym "ConformReceipt" :mod "aslConform/types" :kind type :sig "(schema ConformReceipt (:f profile Str) (:f totalCases I64) (:f passedCases I64) (:f failedCases I64) (:f results (List ConformanceResult)) (:f mutantsChecked (List Str)) (:f invertedReachable Bool))" :pit (record))
(:sym "makeProfile" :mod "aslConform/types" :sig "makeProfile id: Str name: Str compiler: Str tier: Str -> TargetProfile")
(:sym "makeMutant" :mod "aslConform/types" :sig "makeMutant id: Str target: Str desc: Str kills: Str -> SemanticsMutant")
(:sym "makeRule" :mod "aslConform/types" :sig "makeRule id: Str tier: Str name: Str summary: Str cases: (List Str) mutants: (List SemanticsMutant) -> SemanticsRule")
(:sym "makeContract" :mod "aslConform/types" :sig "makeContract version: I64 profiles: (List TargetProfile) tiers: (List Str) rules: (List SemanticsRule) -> TargetSemanticsContract")
(:sym "makeCase" :mod "aslConform/types" :sig "makeCase id: Str rule: Str tier: Str oracle: Str srcPath: Str expectStdout: Str expectExit: I64 -> ConformanceCase")
(:sym "makeResult" :mod "aslConform/types" :sig "makeResult caseId: Str profile: Str passed: Bool actualStdout: Str actualExit: I64 reason: Str -> ConformanceResult")
(:sym "makeReceipt" :mod "aslConform/types" :sig "makeReceipt profile: Str totalCases: I64 passedCases: I64 failedCases: I64 results: (List ConformanceResult) mutantsChecked: (List Str) invertedReachable: Bool -> ConformReceipt")
