(:sym "sysFsyncFn" :mod "asl-target-llvm/sys" :sig "sysFsyncFn -> ty/SsaFunction" :doc "sysFsync(fd) -> Result Int64 Int64: fsync via the 0/-1 convention, no cleanup on either path.")
(:sym "sysFlockFn" :mod "asl-target-llvm/sys" :sig "sysFlockFn -> ty/SsaFunction" :doc "sysFlock(fd, op) -> Result Int64 Int64: flock via the 0/-1 convention, no cleanup on either path.")
