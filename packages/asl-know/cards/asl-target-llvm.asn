(:card "asl-target-llvm" :purpose "Standalone LLVM IR Backend consuming verified asl-ir and emitting typed SSA LLVM IR (.ll) under ADR D93 and D112" :import "(asl-target-llvm :a x)" :deps (asl-ir asl-checker) :modules ((:m "asl-target-llvm") (:m "asl-target-llvm/arrayRoute") (:m "asl-target-llvm/arrays") (:m "asl-target-llvm/closureSpec") (:m "asl-target-llvm/emit")) :moduleCount 39 :sigs ("emitLlvmModule m: irTy/SsaModule -> (Result String (List irTy/IrDiag))" "emitLlvmProgram m: irTy/SsaModule entry: String -> (Result String (List irTy/IrDiag))" "routeFor facts: libc/TripleFacts m: irTy/SsaModule -> (Result rt/Routed (List irTy/IrDiag))" "routeForWith fs: (List llr/Feature) facts: libc/TripleFacts m: irTy/SsaModule -> (Result rt/Routed (List irTy/IrDiag))" "emitLlvmModuleFor facts: libc/TripleFacts m: irTy/SsaModule -> (Result String (List irTy/IrDiag))" "emitLlvmProgramFor facts: libc/TripleFacts m: irTy/SsaModule entry: String -> (Result String (List irTy/IrDiag))") :more (emitLlvmModuleForTarget emitLlvmProgramForTarget emitLlvmRuntimeForTarget emitLlvmSupportForTarget emitLlvmProgramNative! emitLlvmProgramNativeWith!) :moreCount 356 :effects (emitLlvmProgramNative! emitLlvmProgramNativeWith! emitLlvmProgramNativeFor! emitLlvmSource targetArgs! routeHost! routeHostLinked! routeTargetLinked!) :fails (emitLlvmModule emitLlvmProgram routeFor routeForWith emitLlvmModuleFor emitLlvmProgramFor emitLlvmModuleForTarget emitLlvmProgramForTarget) :example none)
