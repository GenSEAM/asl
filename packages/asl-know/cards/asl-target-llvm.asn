(:sym "sysErrnoValueFn" :mod "asl-target-llvm/sys" :sig "sysErrnoValueFn facts: libc/TripleFacts -> ty/SsaFunction" :doc "The current thread's errno as a raw i64, read through the triple's accessor and decoded from its 4 raw bytes (a C int).")
