(:card "asl-target-llvm" :purpose "Standalone LLVM IR Backend consuming verified asl-ir and emitting typed SSA LLVM IR (.ll) under ADR D93 and D112" :import "(asl-target-llvm :a x)" :deps (asl-ir) :modules ((:m "asl-target-llvm" :doc "LLVM IR backend. emitLlvmModule and emitLlvmProgram lowe...") (:m "asl-target-llvm/arrayRoute" :doc "Routes a verified SsaModule's unboxed array and kernel b...") (:m "asl-target-llvm/arrays" :doc "Native unboxed array builtins (plan unit ARRLOWER): SSA ...") (:m "asl-target-llvm/emit" :doc "LLVM IR backend emitter consuming verified asl-ir and em...") (:m "asl-target-llvm/gcAsl" :doc "The collector of native programs written in ASL (plan un...")) :moduleCount 30 :sigs ("emitLlvmModule m: irTy/SsaModule -> (Result String (List irTy/IrDiag))" "emitLlvmProgram m: irTy/SsaModule entry: String -> (Result String (List irTy/IrDiag))" "emitLlvmModuleFor facts: libc/TripleFacts m: irTy/SsaModule -> (Result String (List irTy/IrDiag))" "emitLlvmProgramFor facts: libc/TripleFacts m: irTy/SsaModule entry: String -> (Result String (List irTy/IrDiag))" "emitLlvmModuleForTarget facts: libc/TripleFacts targetFacts: target/TargetFacts m: irTy/SsaModule -> (Result String (List irTy/IrDiag))") :more (emitLlvmProgramForTarget emitLlvmRuntimeForTarget emitLlvmSupportForTarget emitLlvmProgramNative! emitLlvmProgramNativeWith! runtimeDecls emitLlvmType) :moreCount 288 :effects (emitLlvmProgramNative! emitLlvmProgramNativeWith! emitLlvmSource routeHost! routeHostLinked! linkWasm32 wasmImports) :fails (emitLlvmModule emitLlvmProgram emitLlvmModuleFor emitLlvmProgramFor emitLlvmModuleForTarget emitLlvmProgramForTarget emitLlvmRuntimeForTarget emitLlvmSupportForTarget) :example none)
(:sym "emitLlvmModule" :mod "asl-target-llvm" :sig "emitLlvmModule m: irTy/SsaModule -> (Result String (List irTy/IrDiag))" :doc "Emits LLVM IR declarations and functions from an SSA module, its array and kernel builtin calls routed." :pit (result))
(:sym "emitLlvmProgram" :mod "asl-target-llvm" :sig "emitLlvmProgram m: irTy/SsaModule entry: String -> (Result String (List irTy/IrDiag))" :doc "Emits a complete LLVM IR program with an entry wrapper, its array and kernel builtin calls routed." :pit (result))
(:sym "emitLlvmModuleFor" :mod "asl-target-llvm" :sig "emitLlvmModuleFor facts: libc/TripleFacts m: irTy/SsaModule -> (Result String (List irTy/IrDiag))" :doc "emitLlvmModule with the socket, parMap and parFold builtin calls routed for the triple of facts, then the array and kernel calls." :pit (result))
(:sym "emitLlvmProgramFor" :mod "asl-target-llvm" :sig "emitLlvmProgramFor facts: libc/TripleFacts m: irTy/SsaModule entry: String -> (Result String (List irTy/IrDiag))" :doc "emitLlvmProgram with the socket, parMap and parFold builtin calls routed for the triple of facts, then the array and kernel calls." :pit (result))
(:sym "emitLlvmModuleForTarget" :mod "asl-target-llvm" :sig "emitLlvmModuleForTarget facts: libc/TripleFacts targetFacts: target/TargetFacts m: irTy/SsaModule -> (Result String (List irTy/IrDiag))" :doc "emitLlvmModuleFor with target calling conventions lowered; wasm trap facts rewrite rterr.raise to the asl.trap import. A wasm32 target, whose collector cannot scan the native stack, gets ssa's precise shadow-root frames (ssa/emitLlvmModuleW..." :pit (result))
(:sym "emitLlvmProgramForTarget" :mod "asl-target-llvm" :sig "emitLlvmProgramForTarget facts: libc/TripleFacts targetFacts: target/TargetFacts m: irTy/SsaModule entry: String -> (Result String (List irTy/IrDiag))" :doc "emitLlvmProgramFor with target calling conventions lowered; wasm trap facts rewrite rterr.raise to the asl.trap import. A wasm32 target gets ssa's precise shadow-root frames (ssa/emitLlvmProgramWasm32)." :pit (result))
(:sym "emitLlvmRuntimeForTarget" :mod "asl-target-llvm" :sig "emitLlvmRuntimeForTarget facts: libc/TripleFacts targetFacts: target/TargetFacts -> (Result String (List irTy/IrDiag))" :doc "The collector module a program for targetFacts links (asl-target-llvm/gcRoute collectorTextForTarget), for wasm32 its separate object beside the program and emitLlvmSupportForTarget's." :pit (result))
(:sym "emitLlvmSupportForTarget" :mod "asl-target-llvm" :sig "emitLlvmSupportForTarget facts: libc/TripleFacts targetFacts: target/TargetFacts -> (Result String (List irTy/IrDiag))" :doc "asl-target-llvm/wasmRuntime's support module for a wasm32 target whose libc row has a runtimeAbi: the linear-memory allocator, the C-ABI services the program and collector call and number formatting, importing only runtimeAbi's host service..." :pit (result))
(:sym "emitLlvmProgramNative!" :mod "asl-target-llvm" :kind fn! :sig "emitLlvmProgramNative! m: irTy/SsaModule entry: String -> (Result String (List irTy/IrDiag))" :doc "emitLlvmProgram with the socket, parMap and parFold builtin calls routed for this host's triple when libc.asl verifies it, else unrouted, then the array and kernel calls on any host." :pit (result effect))
(:sym "emitLlvmProgramNativeWith!" :mod "asl-target-llvm" :kind fn! :sig "emitLlvmProgramNativeWith! m: irTy/SsaModule entry: String mode: String -> (Result String (List irTy/IrDiag))" :doc "Lowers an SSA module through the host/sys/array routing passes, then emits LLVM IR text, optionally with the Perceus-style refcounting pass: mode 0 traces, 1 counts, asan counts under ASan, notrace counts with no tracing collector; asl1 bui..." :pit (result effect))
(:sym "runtimeDecls" :mod "asl-target-llvm" :sig "runtimeDecls -> (List String)" :doc "Returns standard external runtime function declarations for LLVM.")
(:sym "emitLlvmType" :mod "asl-target-llvm" :sig "emitLlvmType t: irTy/IrType -> Str" :doc "Delegates to types module to emit LLVM type name.")
(:sym "emitLlvmBlock" :mod "asl-target-llvm" :sig "emitLlvmBlock stmts: (List irTy/IrStmt) -> Str" :doc "Delegates to emit module to emit a block of LLVM statements.")
(:sym "emitLlvmStmt" :mod "asl-target-llvm" :sig "emitLlvmStmt stmt: irTy/IrStmt -> Str" :doc "Delegates to emit module to emit an LLVM statement.")
(:sym "emitLlvmExpr" :mod "asl-target-llvm" :sig "emitLlvmExpr expr: irTy/IrExpr target: Str ty: irTy/IrType -> Str" :doc "Delegates to emit module to emit an LLVM expression.")
(:sym "emitLlvmClosure" :mod "asl-target-llvm" :sig "emitLlvmClosure name: Str envFields: (List Str) -> Str" :doc "Delegates to types module to emit closure environment struct.")
(:sym "emitLlvmPanic" :mod "asl-target-llvm" :sig "emitLlvmPanic code: Int64 msg: Str -> Str" :doc "Delegates to types module to emit panic sequence.")
(:sym "emitLlvmSource" :mod "asl-target-llvm" :kind fn! :sig "emitLlvmSource src: String entry: String -> (Result String (List irTy/IrDiag))" :doc "Lowers ASL source code to SSA and emits an LLVM program. Writes src to a scratch file under asl/host/out/.emitLlvmSource (removed again before returning) and links it via asl-ir/link linkEntryBare! (LOWERPQ), so a prelude function (optionOr..." :pit (result effect))
(:sym "emitLlvmSourceWith" :mod "asl-target-llvm" :sig "emitLlvmSourceWith src: String preludeSrc: String entry: String -> (Result String (List irTy/IrDiag))" :doc "emitLlvmSource over asl-ir/link lowerSourceWith: the prelude functions the module reaches, transitively, are lowered from preludeSrc into the program." :pit (result))
(:sym "emitLlvmTargetTriple" :mod "asl-target-llvm" :sig "emitLlvmTargetTriple target: Str -> Str" :doc "Delegates to types module to emit target triple directive.")
(:sym "llvmPreamble" :mod "asl-target-llvm" :sig "llvmPreamble target: Str -> Str" :doc "Delegates to emit module to emit LLVM target and layout preamble.")
(:sym "emitLlvmFunction" :mod "asl-target-llvm" :sig "emitLlvmFunction f: irTy/IrFunction -> Str" :doc "Delegates to emit module to emit an LLVM function.")
(:sym "arrayCalls" :mod "asl-target-llvm/arrayRoute" :sig "arrayCalls m: ty/SsaModule -> (List (Pair String Int64))" :doc "Each distinct (builtin, operand count) of m's opBuiltin calls of the array and kernel builtins, in first-seen order.")
(:sym "routes?" :mod "asl-target-llvm/arrayRoute" :sig "routes? m: ty/SsaModule -> Bool" :doc "True when m calls an array or kernel builtin.")
(:sym "routeModule" :mod "asl-target-llvm/arrayRoute" :sig "routeModule m: ty/SsaModule -> (Result rt/Routed (List ty/IrDiag))" :doc "m routed: unchanged, with no internal names, when it calls no array or kernel builtin; else verified first (its own diagnostics when it does not verify), its calls' operand counts checked, and rewritten as this module's :d describes." :pit (result))
(:sym "routeLinked" :mod "asl-target-llvm/arrayRoute" :sig "routeLinked m: ty/SsaModule -> (Result rt/Routed (List ty/IrDiag))" :doc "routeModule for a linked module the link already verified: the same routing and arity checks without verifying the input again; the native entry uses it, and the emit verifies the routed module." :pit (result))
(:sym "routedNames?" :mod "asl-target-llvm/arrayRoute" :sig "routedNames? internal: (List String) -> Bool" :doc "True when internal, the names a routing made internal, holds a function asl-target-llvm/arrays added: the module routeModule rewrote.")
(:sym "finishText" :mod "asl-target-llvm/arrayRoute" :sig "finishText routed: Bool res: (Result String (List ty/IrDiag)) -> (Result String (List ty/IrDiag))" :doc "res with arrays' helper declarations, whole lines the emitter wrote, replaced by their definitions when routed (routedNames? of the routing's internal names), else res unchanged whatever its text holds." :pit (result))
(:sym "ArrCtx" :mod "asl-target-llvm/arrays" :kind type :sig "schema ArrCtx pool: (Map String Int64)")
(:sym "arrayBuiltinNames" :mod "asl-target-llvm/arrays" :sig "arrayBuiltinNames -> (List String)" :doc "The 30 builtins this module implements: arrays.c's 27 rows, then kernels.c's 3.")
(:sym "functionName" :mod "asl-target-llvm/arrays" :sig "functionName builtin: String -> String" :doc "The function a routed call of builtin calls.")
(:sym "arrStrings" :mod "asl-target-llvm/arrays" :sig "arrStrings -> (List String)" :doc "The pool strings the arrays functions read: error codes, formats, builtin names, type and tag names.")
(:sym "arrExterns" :mod "asl-target-llvm/arrays" :sig "arrExterns -> (List ty/SsaExtern)" :doc "The externs the arrays functions call; those parallel.asl also declares carry its signatures (gcWillAllocate's void return read as an unused i64).")
(:sym "arrFunctions" :mod "asl-target-llvm/arrays" :sig "arrFunctions pool: (Map String Int64) -> (List ty/SsaFunction)" :doc "Every arrays function, pool mapping each of arrStrings to its pool index: tagName, new<kind> for each kind, the 27 array builtins and the 3 kernels.")
(:sym "helperDefinitions" :mod "asl-target-llvm/arrays" :sig "helperDefinitions -> (List (Pair String String))" :doc "Each helper declaration the emitter writes for helperExterns, with the definition that replaces it: aslArrWord0 and aslArrWord1 extractvalue a %Val's words, aslArrMakeVal builds one, aslArrAlloc calls asl_alloc, aslArrLoadF64 and aslArrStor...")
(:sym "emitLlvmModule" :mod "asl-target-llvm/emit" :sig "emitLlvmModule m: irTy/IrModule -> (Result Str (List irTy/IrDiag))" :doc "Verifies an IR module and emits full LLVM IR textual assembly." :pit (result))
(:sym "emitLlvmBlock" :mod "asl-target-llvm/emit" :sig "emitLlvmBlock stmts: (List irTy/IrStmt) -> Str" :doc "Emits LLVM instructions for a sequence of IR statements.")
(:sym "emitLlvmStmt" :mod "asl-target-llvm/emit" :sig "emitLlvmStmt stmt: irTy/IrStmt -> Str" :doc "Emits LLVM instructions for an IR statement.")
(:sym "emitLlvmExpr" :mod "asl-target-llvm/emit" :sig "emitLlvmExpr expr: irTy/IrExpr target: Str ty: irTy/IrType -> Str" :doc "Emits LLVM instructions for evaluating an IR expression.")
(:sym "llvmPreamble" :mod "asl-target-llvm/emit" :sig "llvmPreamble target: Str -> Str" :doc "Emits target triple, runtime struct types, and string constants for LLVM IR.")
(:sym "emitLlvmFunction" :mod "asl-target-llvm/emit" :sig "emitLlvmFunction f: irTy/IrFunction -> Str" :doc "Emits an LLVM function definition from an IR function.")
(:sym "emitLlvmOperand" :mod "asl-target-llvm/emit" :sig "emitLlvmOperand operand: Str ty: Str -> Str" :doc "Formats an operand identifier or literal for LLVM instruction arguments.")
(:sym "GcCtx" :mod "asl-target-llvm/gcAsl" :kind type :sig "schema GcCtx k: (Map String Int64) errno: String target: target/TargetFacts notrace: Bool")
(:sym "untracedCtx" :mod "asl-target-llvm/gcAsl" :sig "untracedCtx c: GcCtx -> GcCtx" :doc "The same collector context with notrace set: gcFunctions then leaves out the tracing functions and every collect call, so a reference-counted build links an allocator with no mark-sweep.")
(:sym "tracingFunctionNames" :mod "asl-target-llvm/gcAsl" :sig "tracingFunctionNames -> (List String)" :doc "The collector functions that mark, verify or sweep (markObj ... sweepPhase); a notrace context drops exactly these.")
(:sym "defaultMinMib" :mod "asl-target-llvm/gcAsl" :sig "defaultMinMib -> Int64" :doc "defaultMinMib is the native collector's floor on new bytes between collections when ASL_GC_MIN_MIB is unset, adopted in .asl/mem/bench/perfBaseline.asn (:gcPolicy)")
(:sym "wasmDefaultMinMib" :mod "asl-target-llvm/gcAsl" :sig "wasmDefaultMinMib -> Int64" :doc "wasm32 has no environment (ASL_GC_MIN_MIB can never be read), so its floor stays the pre-GC-POLICY 8 MiB measured for wasm's small linear memory rather than the native-only 32 MiB adopted in perfBaseline.asn.")
(:sym "defaultMinMibFor" :mod "asl-target-llvm/gcAsl" :sig "defaultMinMibFor target: target/TargetFacts -> Int64" :doc "Default GC heap floor in MiB for the given target: wasm32's own floor, or the native one.")
(:sym "gcFactNames" :mod "asl-target-llvm/gcAsl" :sig "gcFactNames -> (List String)" :doc "The libc facts the collector reads.")
(:sym "gcFacts" :mod "asl-target-llvm/gcAsl" :sig "gcFacts facts: libc/TripleFacts -> (Result GcCtx String)" :doc "gcFactNames resolved for the triple, or an err naming the first one libc.asl lacks; also an err when struct timespec does not fit the four scratch words or the triple names no errno accessor." :pit (result))
(:sym "gcFactsFor" :mod "asl-target-llvm/gcAsl" :sig "gcFactsFor facts: libc/TripleFacts target: target/TargetFacts -> (Result GcCtx String)" :doc "gcFactNames resolved for the triple, or an err naming the first one libc.asl lacks; also an err when struct timespec does not fit the four scratch words or the triple names no errno accessor. A wasm32 target needs no libc fact: its collecto..." :pit (result))
(:sym "gcStrings" :mod "asl-target-llvm/gcAsl" :sig "gcStrings -> (List String)" :doc "The module's string pool, NUL-terminated C strings the collector passes as ptr: error codes and gc.c's texts, the environment variable names and the object type names of the cycle report.")
(:sym "gcExterns" :mod "asl-target-llvm/gcAsl" :sig "gcExterns c: GcCtx -> (List ty/SsaExtern)" :doc "The externs the collector functions call: its helpers, libc (void functions read as an unused i64) and strFloor.c's gcFloorFail. On wasm32 the same C-ABI services come from IR (asl-target-llvm/wasmAlloc, wasmRuntime and wasmFormat): calloc,...")
(:sym "gcFunctions" :mod "asl-target-llvm/gcAsl" :sig "gcFunctions c: GcCtx -> (List ty/SsaFunction)" :doc "Every collector function, c holding the triple's facts; unmap only under the mmap page source, the only one that calls it.")
(:sym "helperDefinitions" :mod "asl-target-llvm/gcAsl" :sig "helperDefinitions -> (List (Pair String String))" :doc "Each helper declaration the emitter writes for helperExterns, with the definition that replaces it: gcAslState is the state block's address; gcAslCollect calls asl_gc_collect; gcAslMutatorRoots and gcAslExternalRoots call gcMutatorRoots and...")
(:sym "helperDefinitionsFor" :mod "asl-target-llvm/gcAsl" :sig "helperDefinitionsFor target: target/TargetFacts -> (List (Pair String String))" :doc "helperDefinitions for target. On wasm32 gcAslState has external linkage so the end-to-end probe can export it and verify actual collections; gcAslShadowTop reads @asl_gc_shadow_top (gcRoute), the head of the program's shadow-root frames; gc...")
(:sym "functionName" :mod "asl-target-llvm/gcAsl" :sig "functionName name: String -> String" :doc "The SSA function name of the collector function name (alloc, allocCons, markRoot, markPhase, sweepPhase, ...), which gcRoute's C entry points call.")
(:sym "stateWords" :mod "asl-target-llvm/gcAsl" :sig "stateWords -> Int64" :doc "Words in the state block.")
(:sym "stateBlockText" :mod "asl-target-llvm/gcAsl" :sig "stateBlockText target: target/TargetFacts -> String" :doc "The LLVM definition of the state block for a target: threshold and gcMinBytes set to defaultMinMibFor that target (native 32 MiB, wasm32 8 MiB since wasm32 can never override via ASL_GC_MIN_MIB), gcGrowth 2.0 as its bit pattern, the large i...")
(:sym "statePtrText" :mod "asl-target-llvm/gcAsl" :sig "statePtrText -> String" :doc "The weak @asl_gc_state_ptr global, null until gcInit publishes @gcAsl.state through it; the fast-path allocators read it, so a gc.o-linked or uninitialised state always misses.")
(:sym "fastAllocClass" :mod "asl-target-llvm/gcAsl" :sig "fastAllocClass type: Int64 bytes: Int64 -> (Option Int64)" :doc "The small size class an inline fast path serves for an object of type and bytes, none for objects above the largest small class and for types 6 and 7." :pit (option))
(:sym "fastAllocCall" :mod "asl-target-llvm/gcAsl" :sig "fastAllocCall type: Int64 bytes: Int64 -> String" :doc "The call text for an allocation of type and bytes: its size class's @gcAsl.allocFast helper when fastAllocClass has one, else @asl_alloc_raw.")
(:sym "fastConsCall" :mod "asl-target-llvm/gcAsl" :sig "fastConsCall -> String" :doc "The call text of a 40-byte cons allocation through @gcAsl.allocFastCons, whose miss goes to asl_alloc_cons so a gc.o link pulls no new symbol.")
(:sym "fastAllocDefinitions" :mod "asl-target-llvm/gcAsl" :sig "fastAllocDefinitions keys: (Map String Bool) inline: Bool -> (List String)" :doc "ALLOC-INLINE: one linkonce_odr alwaysinline helper per size class (and the cons helper) whose call text appears in keys, plus statePtrText when inline; inline helpers bump-allocate from the class's active page after the published-state, thr...")
(:sym "collectorModule" :mod "asl-target-llvm/gcRoute" :sig "collectorModule facts: libc/TripleFacts -> (Result ty/SsaModule (List ty/IrDiag))" :doc "gcAsl's functions, externs and strings as one SsaModule for the triple of facts." :pit (result))
(:sym "collectorModuleForTarget" :mod "asl-target-llvm/gcRoute" :sig "collectorModuleForTarget facts: libc/TripleFacts target: target/TargetFacts -> (Result ty/SsaModule (List ty/IrDiag))" :doc "gcAsl's functions, externs and strings for explicit target properties and libc facts." :pit (result))
(:sym "collectorModuleWith" :mod "asl-target-llvm/gcRoute" :sig "collectorModuleWith facts: libc/TripleFacts target: target/TargetFacts notrace: Bool -> (Result ty/SsaModule (List ty/IrDiag))" :doc "The collector SSA module for the triple and target, untraced when notrace is true; collectorModule is the traced case." :pit (result))
(:sym "collectorText" :mod "asl-target-llvm/gcRoute" :sig "collectorText facts: libc/TripleFacts -> (Result String (List ty/IrDiag))" :doc "The collector module's LLVM text for the triple of facts, as this module's :d describes." :pit (result))
(:sym "collectorTextForTarget" :mod "asl-target-llvm/gcRoute" :sig "collectorTextForTarget facts: libc/TripleFacts target: target/TargetFacts -> (Result String (List ty/IrDiag))" :doc "The collector module's LLVM text for explicit target properties." :pit (result))
(:sym "collectorTextWith" :mod "asl-target-llvm/gcRoute" :sig "collectorTextWith facts: libc/TripleFacts target: target/TargetFacts notrace: Bool -> (Result String (List ty/IrDiag))" :doc "The LLVM text of collectorModuleWith; collectorText is the traced case." :pit (result))
(:sym "entryNames" :mod "asl-target-llvm/gcRoute" :sig "entryNames -> (List String)" :doc "The symbols the collector module defines with external linkage: gc.c's whole C ABI.")
(:sym "hostTriple" :mod "asl-target-llvm/gcRoute" :sig "hostTriple uname: String -> String" :doc "The libc.asl triple of a host whose uname -s -m printed uname, empty for one libc.asl does not cover.")
(:sym "StructFacts" :mod "asl-target-llvm/libc" :kind type :sig "schema StructFacts size: Int64 fields: (List (Pair String Int64))")
(:sym "TripleFacts" :mod "asl-target-llvm/libc" :kind type :sig "schema TripleFacts triple: String verified: Bool errnoAccessor: String consts: (List (Pair String Int64)) variadic: (List (Pair String Bool)) structs: (List (Pair String StructFacts))")
(:sym "RuntimeAbi" :mod "asl-target-llvm/libc" :kind type :sig "schema RuntimeAbi triple: String memory: String output: String clock: String exit: String trap: String")
(:sym "libcTriples" :mod "asl-target-llvm/libc" :sig "libcTriples -> (List String)" :doc "The target triples this table covers, in table order")
(:sym "libcFacts" :mod "asl-target-llvm/libc" :sig "libcFacts triple: String -> (Option TripleFacts)" :doc "The facts row for a triple named by libcTriples, none for any other triple" :pit (option))
(:sym "libcVerified" :mod "asl-target-llvm/libc" :sig "libcVerified triple: String -> Bool" :doc "The triple's row's :verified: true for a row measured on a host of that triple (darwin-arm64 by libcTableTest on this host, linux-x86_64 and linux-aarch64 by linuxLayoutGateTest under glibc 2.36), false for a triple the table lacks")
(:sym "darwinArm64Facts" :mod "asl-target-llvm/libc" :sig "darwinArm64Facts -> TripleFacts" :doc "Measured on this macOS arm64 host: /usr/bin/clang with the Xcode 17 SDK via tests/fixtures/libcProbe.c")
(:sym "linuxX8664Facts" :mod "asl-target-llvm/libc" :sig "linuxX8664Facts -> TripleFacts" :doc "glibc on x86_64: the shared linux constants and structs, asm-generic's O_DIRECTORY and O_NOFOLLOW and x86_64's stat layout; measured on glibc 2.36 (linuxLayoutGateTest), so :verified.")
(:sym "linuxAarch64Facts" :mod "asl-target-llvm/libc" :sig "linuxAarch64Facts -> TripleFacts" :doc "glibc on aarch64: the shared linux constants and structs, arch/arm64's O_DIRECTORY and O_NOFOLLOW and the asm-generic stat layout, which differs from x86_64 in field order; measured on glibc 2.36 (linuxLayoutGateTest), so :verified.")
(:sym "wasm32Facts" :mod "asl-target-llvm/libc" :sig "wasm32Facts -> TripleFacts" :doc "wasm32-unknown-unknown has no libc: no errno accessor, no POSIX constants, variadic table or struct layouts, and :verified false since there is no host libc to measure. Its runtime services are runtimeAbi's host imports and the IR asl-targe...")
(:sym "runtimeAbi" :mod "asl-target-llvm/libc" :sig "runtimeAbi triple: String -> (Option RuntimeAbi)" :doc "The runtime services a libc-free target takes from its host, each a module.name host import, or memory.grow for linear-memory pages: wasm32 writes bytes to a file descriptor with asl.write (fd i32, ptr, length i64 -> written i64), exits wit..." :pit (option))
(:sym "hostImport" :mod "asl-target-llvm/libc" :sig "hostImport service: String -> (Pair String String)" :doc "A runtimeAbi service name module.name split into its wasm import module and name; a name with no module is (pair \"\" service).")
(:sym "pairFind" :mod "asl-target-llvm/libc" :sig "pairFind xs: (List (Pair String V)) key: String -> (Option V)" :doc "The value paired with key in xs; the last pair wins when a key repeats, none when it is absent" :pit (option))
(:sym "structFieldOffset" :mod "asl-target-llvm/libc" :sig "structFieldOffset sf: StructFacts field: String -> (Option Int64)" :doc "Byte offset of field within the struct, none when the table has no such field" :pit (option))
(:sym "structSize" :mod "asl-target-llvm/libc" :sig "structSize facts: TripleFacts structName: String -> (Option Int64)" :doc "sizeof the named struct on this triple, none when the table has no such struct" :pit (option))
(:sym "libcConst" :mod "asl-target-llvm/libc" :sig "libcConst facts: TripleFacts name: String -> (Option Int64)" :doc "Value of the named O_*, F_*, LOCK_*, errno or _SC_* constant on this triple, none when absent" :pit (option))
(:sym "emptyTripleFacts" :mod "asl-target-llvm/libc" :sig "emptyTripleFacts -> TripleFacts" :doc "A TripleFacts with no triple, no rows and :verified false")
(:sym "rusageMaxRssUnit" :mod "asl-target-llvm/libc" :sig "rusageMaxRssUnit triple: String -> Int64" :doc "struct rusage's ru_maxrss unit for this triple, man-page-documented rather than a libc constant and so kept out of :consts (which libcTableTest validates against the probe row by row): bytes on Darwin/BSD (1024), kilobytes on Linux (1) -- s...")
(:sym "exePathSource" :mod "asl-target-llvm/libc" :sig "exePathSource triple: String -> String" :doc "How this triple names the running executable, an OS interface choice rather than a header constant and so kept out of :consts like rusageMaxRssUnit: nsGetExecutablePath on darwin (dyld's _NSGetExecutablePath(buf, &size), as asl/host/src/loa...")
(:sym "parCalls" :mod "asl-target-llvm/parRoute" :sig "parCalls m: ty/SsaModule -> (List (Pair String Int64))" :doc "Each distinct (builtin, operand count) of m's opBuiltin calls of parMap and parFold, in first-seen order.")
(:sym "routes?" :mod "asl-target-llvm/parRoute" :sig "routes? m: ty/SsaModule -> Bool" :doc "True when m calls parMap or parFold.")
(:sym "routeModule" :mod "asl-target-llvm/parRoute" :sig "routeModule facts: libc/TripleFacts m: ty/SsaModule -> (Result rt/Routed (List ty/IrDiag))" :doc "m routed for the triple of facts: unchanged, with no internal names, when it calls neither parMap nor parFold; else verified first (its own diagnostics when it does not verify) and rewritten as this module's :d describes." :pit (result))
(:sym "routeHost!" :mod "asl-target-llvm/parRoute" :kind fn! :sig "routeHost! m: ty/SsaModule -> (Result rt/Routed (List ty/IrDiag))" :doc "m routed for the host this runs on, as sysRoute routeHost! decides it: routeModule at sysRoute routeFactsFor of uname -s -m's triple, m unchanged when that triple has no verified libc.asl row; a failing uname is ERR_LLVM_PARROUTE_HOST. unam..." :pit (result effect))
(:sym "routeHostLinked!" :mod "asl-target-llvm/parRoute" :kind fn! :sig "routeHostLinked! m: ty/SsaModule -> (Result rt/Routed (List ty/IrDiag))" :doc "routeHost! for a linked module the link already verified: the same routing without verifying the input again; the native entry uses it, and the emit verifies the routed module." :pit (result effect))
(:sym "routedNames?" :mod "asl-target-llvm/parRoute" :sig "routedNames? internal: (List String) -> Bool" :doc "True when internal, the names a routing made internal, holds a function asl-target-llvm/parallel added: the module routeModule rewrote.")
(:sym "finishText" :mod "asl-target-llvm/parRoute" :sig "finishText routed: Bool res: (Result String (List ty/IrDiag)) -> (Result String (List ty/IrDiag))" :doc "res with parallel's helper declarations, whole lines the emitter wrote, replaced by their definitions when routed (routedNames? of the routing's internal names), else res unchanged whatever its text holds." :pit (result))
(:sym "helperDefinitions" :mod "asl-target-llvm/parRoute" :sig "helperDefinitions -> (List (Pair String String))" :doc "Each helper declaration the emitter writes for asl-target-llvm/parallel's helperExterns, with the text that replaces it.")
(:sym "ParCtx" :mod "asl-target-llvm/parallel" :kind type :sig "schema ParCtx k: (Map String Int64) pool: (Map String Int64) errno: String")
(:sym "parFactNames" :mod "asl-target-llvm/parallel" :sig "parFactNames -> (List String)" :doc "The libc facts the parallel functions read, constants by name and struct facts as struct.field (struct.size for its size).")
(:sym "parFacts" :mod "asl-target-llvm/parallel" :sig "parFacts facts: libc/TripleFacts -> (Result (Map String Int64) String)" :doc "parFactNames resolved for the triple, or a build-time err naming the first one libc.asl lacks; also an err when pollfd's revents does not follow events by 2 bytes (collect reads both with one 32-bit load) or the triple names no errno access..." :pit (result))
(:sym "parStrings" :mod "asl-target-llvm/parallel" :sig "parStrings -> (List String)" :doc "The pool strings the parallel functions read: error codes, aslError formats, the fallback variable and its value.")
(:sym "parExterns" :mod "asl-target-llvm/parallel" :sig "parExterns facts: libc/TripleFacts -> (List ty/SsaExtern)" :doc "The externs the parallel functions call; those sys.asl and sysProc.asl also declare carry the same signatures (void functions return i64, unused). setjmp is declared returns_twice by parRoute.")
(:sym "parGlobals" :mod "asl-target-llvm/parallel" :sig "parGlobals -> (List ty/SsaGlobal)" :doc "keyTable: the address, as an Int, of an 8-byte cell holding the head of the module's interned key-array list (parallel.c's keyEntryHead), set once by keyTableInit.")
(:sym "parFunctions" :mod "asl-target-llvm/parallel" :sig "parFunctions facts: libc/TripleFacts pool: (Map String Int64) calls: (List (Pair String Int64)) -> (Result (List ty/SsaFunction) String)" :doc "The parallel functions for the triple of facts, pool mapping each of parStrings to its pool index, with one wrapper per (builtin, argc) of calls; or parFacts' build-time err." :pit (result))
(:sym "wrapperName" :mod "asl-target-llvm/parallel" :sig "wrapperName builtin: String argc: Int64 -> String" :doc "The function a routed call of builtin (parMap or parFold) with argc operands calls.")
(:sym "serMax" :mod "asl-target-llvm/parallel" :sig "serMax -> Int64" :doc "parallel.c SER_MAX_BYTES: a worker frame is at most 64 MiB.")
(:sym "helperExterns" :mod "asl-target-llvm/parallel" :sig "helperExterns -> (List ty/SsaExtern)" :doc "The helpers asl-target-llvm/parRoute defines in the emitted text in place of their declarations: a Val's words, a Val from two words, asl_alloc, and value.c's aslErrorMsg buffer.")
(:sym "rcModule" :mod "asl-target-llvm/rc" :sig "rcModule m: ty/SsaModule user: (Map String Bool) -> ty/SsaModule" :doc "Rewrites every function in an SSA module for Perceus-style refcounting, adding wrapper functions for closures captured as values and the runtime externs they need.")
(:sym "rcFinishText" :mod "asl-target-llvm/rc" :sig "rcFinishText text: String asan: Bool -> String" :doc "Finishes a module's emitted LLVM text for the refcounting target: strips the stub dup/drop/pin declarations, routes small-object allocation per size class, and appends the runtime text.")
(:sym "rcFinishTextWith" :mod "asl-target-llvm/rc" :sig "rcFinishTextWith text: String asan: Bool notrace: Bool -> String" :doc "rcFinishText with the runtime chosen by notrace: allocation calls routed to the reference-counted allocators, and the appended collector runtime untraced when notrace is true.")
(:sym "sanitized" :mod "asl-target-llvm/rc" :sig "sanitized text: String asan: Bool -> String" :doc "Every function definition in the text gets the sanitize_address attribute when asan is true; otherwise the text is unchanged.")
(:sym "routeArrayAlloc" :mod "asl-target-llvm/rc" :sig "routeArrayAlloc text: String -> String" :doc "When the module defines @aslRc.alloc, the array allocator @aslArrAlloc calls it instead of @asl_alloc; any other text is unchanged.")
(:sym "dupName" :mod "asl-target-llvm/rc" :sig "dupName -> String" :doc "LLVM runtime symbol name for the refcount dup (retain) call.")
(:sym "dropName" :mod "asl-target-llvm/rc" :sig "dropName -> String" :doc "LLVM runtime symbol name for the refcount drop (release) call.")
(:sym "pinName" :mod "asl-target-llvm/rc" :sig "pinName -> String" :doc "LLVM runtime symbol name for the refcount pin call.")
(:sym "wrapperName" :mod "asl-target-llvm/rc" :sig "wrapperName name: String -> String" :doc "Boxed-closure wrapper symbol name for a refcounted function.")
(:sym "runtimeText" :mod "asl-target-llvm/rc" :sig "runtimeText text: String asan: Bool -> String" :doc "Assembles the LLVM IR text for the refcounting runtime: free-list globals, stats, and every helper function (dup, drop, release, push, recycle, pin, defer).")
(:sym "gcConsCall" :mod "asl-target-llvm/rc" :sig "gcConsCall -> String" :doc "The text of a call to the collector's cons-cell allocator gcAsl.allocFastCons, built at run time so the rewrite of module text never matches this compiler's own constant; rcFinishTextWith routes these calls to the reference-counted Cons all...")
(:sym "arenaCallText" :mod "asl-target-llvm/rc" :sig "arenaCallText -> String" :doc "The text of a tailcc call to prelude.arenaRun as emitted by ssa; rcFinishTextWith replaces it with the call into the region runtime when a module uses it.")
(:sym "appendCallText" :mod "asl-target-llvm/rc" :sig "appendCallText -> String" :doc "The text of a tailcc call to prelude.listAppend as emitted by ssa; in notrace mode rcFinishTextWith replaces it with aslRc.appendOwned, which relinks the unique cells of the first list in place and copies from the first shared cell.")
(:sym "scalarizeRecords" :mod "asl-target-llvm/recordScalar" :sig "scalarizeRecords m: ty/SsaModule -> ty/SsaModule" :doc "The module with every function passed through scalarizeFunction; a module with no record declarations is returned unchanged.")
(:sym "scalarizeFunction" :mod "asl-target-llvm/recordScalar" :sig "scalarizeFunction records: (List ty/SsaRecordDecl) taken: (Map String Bool) depth: Int64 f: ty/SsaFunction -> (List ty/SsaFunction)" :doc "Rewrite one function whose record parameter is only read by field into a wrapper that reads the fields and calls a worker taking the fields as parameters; the worker is scalarized again up to a depth bound, and a name already taken is never...")
(:sym "workerName" :mod "asl-target-llvm/recordScalar" :sig "workerName name: String -> String" :doc "The name of the scalarized worker of a function: the original name with the suffix $sr.")
(:sym "abiText" :mod "asl-target-llvm/rtAbi" :sig "abiText facts: libc/TripleFacts asan: Bool -> (Result String String)" :doc "Assembles the full LLVM IR text for the per-host runtime ABI module: data, init, main trampoline, GC roots and the host locate/decl text." :pit (result))
(:sym "entryNames" :mod "asl-target-llvm/rtAbi" :sig "entryNames -> (List String)" :doc "Symbol names the runtime ABI module exports, used by callers to detect which externs are in scope.")
(:sym "spillSlots" :mod "asl-target-llvm/rtAbi" :sig "spillSlots -> Int64" :doc "Number of spill slots reserved per stack frame in the generated runtime ABI text.")
(:sym "rtErrorDecls" :mod "asl-target-llvm/rtError" :sig "rtErrorDecls -> (List String)" :doc "External functions the helpers call; the caller adds each one its module does not already declare. longjmp delivers a raise to an installed handler.")
(:sym "rtErrorDefinitions" :mod "asl-target-llvm/rtError" :sig "rtErrorDefinitions text: String -> (List String)" :doc "The helpers text reaches, directly or through other helpers, rtValue's among them, in their declaration order, each a blank-line-led definition: a program carries only the raises, value runtime pieces and constants it can use.")
(:sym "rtErrorDefinitionsWith" :mod "asl-target-llvm/rtError" :sig "rtErrorDefinitionsWith pieces: (List RefPiece) text: String -> (List String)" :doc "Selects, from the given runtime-error pieces, only those whose bodies the given text actually refers to, closing over transitive references.")
(:sym "rtErrorDefinitionsJoin" :mod "asl-target-llvm/rtError" :sig "rtErrorDefinitionsJoin pieces: (List RefPiece) chunks: (List String) -> (List String)" :doc "rtErrorDefinitionsJoin is rtErrorDefinitionsWith pieces (stringJoin chunks \\n) without the joined text")
(:sym "refCloseJoin" :mod "asl-target-llvm/rtError" :sig "refCloseJoin chunks: (List String) pieces: (List RefPiece) -> (Map String Bool)" :doc "refCloseJoin is refClose (stringJoin chunks \\n) (mapEmpty) pieces; the joined text is built only when a piece name is not plain")
(:sym "refKeysJoin" :mod "asl-target-llvm/rtError" :sig "refKeysJoin acc: (Map String Bool) chunks: (List String) -> (Map String Bool)" :doc "refKeysJoin adds refKeys (stringJoin chunks \\n) to acc without building the joined text: a newline ends every symbol, so each chunk but the last is scanned as if followed by one")
(:sym "rtErrorPieces" :mod "asl-target-llvm/rtError" :sig "rtErrorPieces -> (List RefPiece)" :doc "rtErrorPieces parses the error and value runtime once; emit passes it to every rtErrorDefinitionsWith of one module")
(:sym "RefPiece" :mod "asl-target-llvm/rtError" :kind type :sig "(schema RefPiece (:f name String) (:f body String) (:f keys (List String)) (:f plain Bool))" :doc "RefPiece is a runtime piece with the keys (name + delimiter) whose occurrence makes a text refer to it; plain names (an @ head, no further @, no delimiter byte) are decided by refKeys membership, others by substring search" :pit (record))
(:sym "refPieces" :mod "asl-target-llvm/rtError" :sig "refPieces delims: (List String) pieces: (List (Pair String String)) -> (List RefPiece)" :doc "Wraps each (keys, body) pair as a RefPiece, matched against the module's own transitive-reference delimiters.")
(:sym "refClose" :mod "asl-target-llvm/rtError" :sig "refClose text: String chosen: (Map String Bool) pieces: (List RefPiece) -> (Map String Bool)" :doc "refClose adds every piece the text refers to, then rescans the last 256 bytes of the text joined to the fresh bodies, until nothing is fresh; chosen maps piece names")
(:sym "refKeys" :mod "asl-target-llvm/rtError" :sig "refKeys text: String -> (Map String Bool)" :doc "refKeys is the set of every @symbol in text joined to the delimiter byte that ends it; for a plain name N and delimiter d, N+d occurs in text exactly when N+d is in refKeys text")
(:sym "refFirstKey" :mod "asl-target-llvm/rtError" :sig "refFirstKey text: String -> (Option String)" :doc "refFirstKey is the first refKeys key of text; when text occurs inside a larger text T, that key is in refKeys T" :pit (option))
(:sym "refPlain?" :mod "asl-target-llvm/rtError" :sig "refPlain? name: String -> Bool" :doc "refPlain? holds for @NAME where NAME has no @ and no stop byte, so its occurrences are exactly refKeys entries")
(:sym "rtErrorTrapCodes" :mod "asl-target-llvm/rtError" :sig "rtErrorTrapCodes -> (List String)" :doc "The codes (trap code msg) accepts: prelude.c knownErrCodes less trapBlockedCode's ERR_PROBE, ERR_OOM and ERR_INTERNAL.")
(:sym "wasmTrapImport" :mod "asl-target-llvm/rtError" :sig "wasmTrapImport -> String" :doc "The wasm32 host trap import: message lengths use the target's i32 size_t.")
(:sym "wasmRaiseFunction" :mod "asl-target-llvm/rtError" :sig "wasmRaiseFunction -> String" :doc "The wasm raise endpoint forwards the error code and message bytes to the host trap, which does not return.")
(:sym "tailOf" :mod "asl-target-llvm/rtError" :sig "tailOf text: String -> String" :doc "text's last 256 bytes, so a name the scanned text ends with still meets the delimiter the next round's join adds.")
(:sym "floorText" :mod "asl-target-llvm/rtFloor" :sig "floorText facts: libc/TripleFacts -> (Result String String)" :doc "The rtFloor module text for the target facts, or ERR_LLVM_RTFLOOR when libc.asl has no EINTR or no errno accessor for the triple." :pit (result))
(:sym "entryNames" :mod "asl-target-llvm/rtFloor" :sig "entryNames -> (List String)" :doc "The symbols rtFloor.o defines: gcFloorFail, gcFloorGuard and gcFloorRaise.")
(:sym "rtFormatDecls" :mod "asl-target-llvm/rtFormat" :sig "rtFormatDecls -> (List String)" :doc "External functions the formatter helpers call. The caller adds each one its module does not already declare, since a module's own externs (libc, sys) may declare the same C symbol.")
(:sym "rtFormatLlvm" :mod "asl-target-llvm/rtFormat" :sig "rtFormatLlvm -> (List String)" :doc "Generic native helpers for integer and float formatting/parsing. The caller appends these once per emitted module, with rtFormatDecls.")
(:sym "rtFormatNameCall" :mod "asl-target-llvm/rtFormat" :sig "rtFormatNameCall id: String -> String" :doc "One indirection for runtime interned symbol/keyword names: asl-target-llvm/rtValue's native table (ABIVAL-5).")
(:sym "rtFormatValueLlvm" :mod "asl-target-llvm/rtFormat" :sig "rtFormatValueLlvm -> (List String)" :doc "A recursive native renderer over the public Val layout. Object fields are read with byte offsets matching value.h; no value.c printer is called.")
(:sym "rtFormatValLlvm" :mod "asl-target-llvm/rtFormat" :sig "rtFormatValLlvm -> (List String)" :doc "Exports the one private recursive value-rendering entry point used for str and output builtins.")
(:sym "rtFormatManyLlvm" :mod "asl-target-llvm/rtFormat" :sig "rtFormatManyLlvm -> (List String)" :doc "Formats the argument vector used by str/print/println/eprintln. Mode 0 is str, 1 is print, 2 println and 3 eprintln; stdout/stderr routing remains the caller's responsibility.")
(:sym "rtFormatTerminalLlvm" :mod "asl-target-llvm/rtFormat" :sig "rtFormatTerminalLlvm -> (List String)" :doc "Val-facing parse and output adapters for the generic raw helpers. Construction of Option uses the existing runtime constructor allocator; output uses a complete low-level write loop.")
(:sym "rtObjectPieces" :mod "asl-target-llvm/rtObject" :sig "rtObjectPieces -> (List (Pair String String))" :doc "Constants then helpers, each by the symbol it defines, for the caller's reference closure (asl-target-llvm/ssa mathDefinitions).")
(:sym "rtObjectDecls" :mod "asl-target-llvm/rtObject" :sig "rtObjectDecls -> (List String)" :doc "The LLVM function the helpers call beyond rtError's and runtimeDecls' (asl_alloc, asl_rt_global_root): llvm.memcpy; the caller keeps one declaration per symbol. Names intern through asl-target-llvm/rtValue's table, which rtError's closure c...")
(:sym "rtOpsPieces" :mod "asl-target-llvm/rtOps" :sig "rtOpsPieces -> (List (Pair String String))" :doc "Constants then helpers, each by the symbol it defines, for the caller's reference closure (asl-target-llvm/ssa mathDefinitions).")
(:sym "rtOpsDecls" :mod "asl-target-llvm/rtOps" :sig "rtOpsDecls -> (List String)" :doc "The libc, runtime and LLVM functions the helpers call beyond rtError's: memcmp for Strings and Bytes, strcmp over asl-target-llvm/rtValue symName for Keyword order, llvm.copysign.f64 for Float mod and the overflow intrinsics; the caller kee...")
(:sym "opsEntry?" :mod "asl-target-llvm/rtOps" :sig "opsEntry? name: String -> Bool" :doc "Builtin entries (asl-ir/types builtinEntries) whose opEntry is one call of an @opsrt helper: the eleven binary operators and not.")
(:sym "opsEntrySym" :mod "asl-target-llvm/rtOps" :sig "opsEntrySym name: String -> String" :doc "The helper an opsEntry? operator calls, @opsrt.<suffix>; empty for any other name.")
(:sym "opsBuiltin?" :mod "asl-target-llvm/rtOps" :sig "opsBuiltin? name: String n: Int64 -> Bool" :doc "An opBuiltin of an operator or not, any operand count, which runs natively (opsBuiltinCall) where abi.c's asl_rt_builtin K_OP and K_NOT arms ran it: the lowering leaves only unary minus to a by-name call (asl-ir/lower folds + and * over mor...")
(:sym "opsBuiltinCall" :mod "asl-target-llvm/rtOps" :sig "opsBuiltinCall lhs: String p: String name: String args: (List String) -> String" :doc "The IR of an opsBuiltin? call binding lhs ('  %d = '), with p ('%d') prefixing its temporaries and args the formatted operand Vals, as asl_rt_builtin's K_OP and K_NOT arms ran it: unary minus is @opsrt.neg; not of one operand is @opsrt.not;...")
(:sym "rtValueLlvm" :mod "asl-target-llvm/rtValue" :sig "rtValueLlvm -> (List String)" :doc "Every global and function above as definition lines, for rtError's piece closure: a module carries only those its text reaches.")
(:sym "rtValueDecls" :mod "asl-target-llvm/rtValue" :sig "rtValueDecls -> (List String)" :doc "The libc and LLVM functions the pieces call beyond rtError's and rtFormat's; asl_alloc comes from ssa runtimeDecls.")
(:sym "rtValueDefines?" :mod "asl-target-llvm/rtValue" :sig "rtValueDefines? text: String name: String -> Bool" :doc "True when text holds this module's definition of the value.c function name, so the module declares no extern of that name.")
(:sym "rtValueDefinedNames" :mod "asl-target-llvm/rtValue" :sig "rtValueDefinedNames text: String keys: (Map String Bool) -> (List String)" :doc "The shim names whose header line is in the module text, found once per module; keys is the set of names mentioned as calls, so a name never mentioned skips the scan.")
(:sym "rtValueExportRoots" :mod "asl-target-llvm/rtValue" :sig "rtValueExportRoots -> String" :doc "Text naming the C definitions the C floor in libaslrt.a calls (strFloor.c bStringSlice and the string primitives' messages, abi.c asl_rt_init): an entry module that links the runtime closes over it so the link finds them.")
(:sym "valueShimNames" :mod "asl-target-llvm/rtValue" :sig "valueShimNames -> (List String)" :doc "The value.c function names this module defines in IR.")
(:sym "emitLlvmModule" :mod "asl-target-llvm/ssa" :sig "emitLlvmModule m: ty/SsaModule -> (Result String (List ty/IrDiag))" :doc "Verifies an SSA module and emits its definitions as LLVM IR assembly." :pit (result))
(:sym "emitLlvmProgram" :mod "asl-target-llvm/ssa" :sig "emitLlvmProgram m: ty/SsaModule entry: String -> (Result String (List ty/IrDiag))" :doc "Verifies an SSA module and emits an executable LLVM IR program with main entry." :pit (result))
(:sym "ownedEntryName" :mod "asl-target-llvm/ssa" :sig "ownedEntryName name: String -> String" :doc "The name of the owned entry of a function, its name with o appended: the RC pass defines it for functions whose arguments it may consume, and a closure target whose module defines it gets a prototype with the owned trampoline.")
(:sym "emitLlvmModuleWasm32" :mod "asl-target-llvm/ssa" :sig "emitLlvmModuleWasm32 m: ty/SsaModule -> (Result String (List ty/IrDiag))" :doc "emitLlvmModule for wasm32: closure Protos keep their 64-bit field offsets (emitProto), and, since the wasm32 collector cannot scan the native stack, precise shadow-root frames: each module function with a Val that may point into the heap li..." :pit (result))
(:sym "emitLlvmProgramWasm32" :mod "asl-target-llvm/ssa" :sig "emitLlvmProgramWasm32 m: ty/SsaModule entry: String -> (Result String (List ty/IrDiag))" :doc "emitLlvmProgram for wasm32, as emitLlvmModuleWasm32 emits a module." :pit (result))
(:sym "trapLowering" :mod "asl-target-llvm/ssa" :sig "trapLowering text: String facts: target/TargetFacts -> String" :doc "For wasm trap facts, routes the central runtime raise to the imported asl.trap and removes the native longjmp declaration; all fixed, formatted, assertion and arithmetic raises funnel through this endpoint. Other target facts preserve LLVM ...")
(:sym "llvmName" :mod "asl-target-llvm/ssa" :sig "llvmName s: String -> String" :doc "Encodes an arbitrary identifier as an LLVM-safe identifier with hex escapes.")
(:sym "llvmBytes" :mod "asl-target-llvm/ssa" :sig "llvmBytes s: String -> String" :doc "Escapes special characters in a string for LLVM string constant literals.")
(:sym "llvmFloat" :mod "asl-target-llvm/ssa" :sig "llvmFloat x: Float64 -> String" :doc "Formats a float64 value into its exact hex representation for LLVM IR.")
(:sym "runtimeDecls" :mod "asl-target-llvm/ssa" :sig "runtimeDecls -> (List String)" :doc "Returns declarations of external runtime support functions needed by emitted LLVM IR.")
(:sym "cDeclFits?" :mod "asl-target-llvm/ssa" :sig "cDeclFits? decl: String -> Bool" :doc "A C declaration's arguments all travel in registers: at most 6 integer words (a %Val takes 2) and 8 doubles. LLVM may split an IR {i64, i64} between the last register and the stack where C passes the struct whole on the stack, so a C signat...")
(:sym "overwideCDecls" :mod "asl-target-llvm/ssa" :sig "overwideCDecls -> (List String)" :doc "Runtime C declarations (runtimeDecls, builtin entries included) that cDeclFits? rejects; emitLlvmModule refuses to emit while any exists.")
(:sym "cRuntimeModule" :mod "asl-target-llvm/ssa" :sig "cRuntimeModule -> String" :doc "A standalone LLVM module for a native program whose main is C (test fixtures that build values in C as a host builtin would): C-callable intern and mkStr over asl-target-llvm/rtValue's table and allocator, the C definitions libaslrt.a's flo...")
(:sym "ModEnv" :mod "asl-target-llvm/ssa" :kind type :sig "(schema ModEnv (:f name String) (:f functions NameIndex) (:f externs NameIndex) (:f types NameIndex) (:f strings NameIndex) (:f records NameIndex) (:f boxed NameIndex))" :pit (record))
(:sym "FnEnv" :mod "asl-target-llvm/ssa" :kind type :sig "(schema FnEnv (:f mod ModEnv) (:f defs NameIndex) (:f blocks NameIndex) (:f order (List ty/SsaBlock)) (:f retTy ty/SsaTy) (:f name String) (:f fused NameIndex) (:f records NameIndex) (:f wants NameIndex) (:f preds NameIndex) (:f size Int64))" :pit (record))
(:sym "NameIndex" :mod "asl-target-llvm/ssa" :kind type :sig "(enum NameIndex (:c nameIndexEmpty []) (:c nameIndexNode [(key String) (value V) (left NameIndex) (right NameIndex) (height Int64)]))")
(:sym "nameIndexSet" :mod "asl-target-llvm/ssa" :sig "nameIndexSet tree: NameIndex key: String value: V -> NameIndex" :doc "Inserts or replaces a key/value pair in a balanced NameIndex tree, rebalancing on the path back up.")
(:sym "tailCall?" :mod "asl-target-llvm/ssa" :sig "tailCall? env: FnEnv b: ty/SsaBlock -> Bool" :doc "The block ends in a call whose result is returned at once, itself or through a chain of joins that only forward their one parameter to a return (returnsDest?). A direct call qualifies when its callee is a module function or a typed tailcc e...")
(:sym "pinMusttailCallees" :mod "asl-target-llvm/ssa" :sig "pinMusttailCallees text: String -> String" :doc "Appends one @llvm.compiler.used global naming every internal define that is the direct callee of a musttail call, in definition order; text with no such callee comes back unchanged. The use makes the function address-taken, so Apple clang 1...")
(:sym "linkInits" :mod "asl-target-llvm/ssa" :sig "linkInits text: String moduleNames: (List String) -> (Result String String)" :doc "Links every linked module's @init call into the single @main report anchor, erroring if the anchor isn't unique." :pit (result))
(:sym "definesInit?" :mod "asl-target-llvm/ssa" :sig "definesInit? text: String moduleName: String -> Bool" :doc "True when the emitted LLVM text already defines the given module's @init function.")
(:sym "ensureInit" :mod "asl-target-llvm/ssa" :sig "ensureInit text: String moduleName: String -> String" :doc "Appends a trivial no-op @init definition for a module whose text doesn't already define one.")
(:sym "listBuilder?" :mod "asl-target-llvm/ssa" :sig "listBuilder? f: ty/SsaFunction -> Bool" :doc "True when f is one of the known list-builder helper functions with the (val,val)->val two-param shape they all share.")
(:sym "hoistConstants" :mod "asl-target-llvm/ssaOpt" :sig "hoistConstants m: ty/SsaModule -> ty/SsaModule" :doc "m unchanged when its user functions (those not already named under m's own singletonPrefix) hold no hoistable constant; otherwise m with one SsaGlobal and one init function added per distinct constant collect found, those globals prepended ...")
(:sym "nativePrelude" :mod "asl-target-llvm/ssaOpt" :sig "nativePrelude m: ty/SsaModule -> ty/SsaModule" :doc "m with the bodies of prelude.preludeKeyOrder (two Val params, i64 result) replaced by one keyCompare builtin unboxed to i64 and of prelude.preludeRankByte (two i64 params, i64 result) by an FNV-1a step (xor, multiply by 16777619, mask to 31...")
(:sym "constantKey" :mod "asl-target-llvm/ssaOpt" :sig "constantKey ins: ty/SsaInstr -> (Option String)" :doc "A text key identifying ins's value when it is a val-typed opConstruct with no fields or opMakeClosure with no captures (distinct keys for the two forms so a constructor and a closure never collide), none for every other instruction, includi..." :pit (option))
(:sym "singletonPrefix" :mod "asl-target-llvm/ssaOpt" :sig "singletonPrefix moduleName: String -> String" :doc "The per-module prefix (moduleName + \".@ssaOpt$\") this pass's own init functions are named under, so hoistConstants can tell them apart from the module's user functions and never hoist or rewrite its own output.")
(:sym "singleton?" :mod "asl-target-llvm/ssaOpt" :sig "singleton? name: String -> Bool" :doc "Whether name is a global or init function hoistConstants made, in any module: it carries the \".@ssaOpt$\" marker singletonPrefix puts after the module name; ssa.asl asks it to emit such a global as lazily filled.")
(:sym "resultTypeDecl" :mod "asl-target-llvm/sys" :sig "resultTypeDecl -> ty/SsaTypeDecl" :doc "The ok/err ADT exactly as asl-ir/lower declares it for ASL source using Result, so a caller's module can both run these functions and pattern-match their results as ordinary ASL Result values.")
