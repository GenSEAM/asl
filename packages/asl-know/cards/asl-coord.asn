(:card "asl-coord" :purpose "Shared scope claim leases, needs and presence as rows of the machine's asl-store vault: pure rules over a Ctx of plain functions, asl-coord/locate the only host module" :import "(asl-coord/claims :a x)" :deps (asl-store asl-store-fs) :modules ((:m "asl-coord/claims" :doc "Shared cross-worktree scope leases in the git common dir...") (:m "asl-coord/core") (:m "asl-coord/lease") (:m "asl-coord/locate") (:m "asl-coord/needs")) :moduleCount 7 :sigs ("(schema Lease (:f unit String) (:f owns (List String)) (:f branch String) (:f worktree String) (:f agent String) (:f host String) (:f pid In..." "leaseContent lease: Lease -> String" "parseLease raw: String -> Lease" "parseOwns raw: String -> (List String)" "pathsOverlap? left: String right: String -> Bool" "pathWithin? path: String root: String -> Bool" "claims! workspace: String -> (Result String String)" "claim! workspace: String unit: String owns: (List String) -> (Result String String)" "release! workspace: String unit: String -> (Result String String)") :more (pathAllowed! Ctx Held receipt claimsOf claimLease releaseLease heartbeatLease pathAllowedIn importLegacy legacyDone? sweepHeld sweepAll retireStale staleAt?) :moreCount 25 :effects (claims! claim! release! pathAllowed! contextAt! context! identity! callerUnit!) :fails (claims! claim! release! pathAllowed! claimsOf claimLease releaseLease heartbeatLease) :example none)
(:sym "Lease" :mod "asl-coord/claims" :kind type :sig "(schema Lease (:f unit String) (:f owns (List String)) (:f branch String) (:f worktree String) (:f agent String) (:f host String) (:f pid Int64) (:f at Int64) (:f ttl Int64))" :pit (record))
(:sym "leaseContent" :mod "asl-coord/claims" :sig "leaseContent lease: Lease -> String")
(:sym "parseLease" :mod "asl-coord/claims" :sig "parseLease raw: String -> Lease")
(:sym "parseOwns" :mod "asl-coord/claims" :sig "parseOwns raw: String -> (List String)")
(:sym "pathsOverlap?" :mod "asl-coord/claims" :sig "pathsOverlap? left: String right: String -> Bool")
(:sym "pathWithin?" :mod "asl-coord/claims" :sig "pathWithin? path: String root: String -> Bool")
(:sym "claims!" :mod "asl-coord/claims" :sig "claims! workspace: String -> (Result String String)" :pit (result effect))
(:sym "claim!" :mod "asl-coord/claims" :sig "claim! workspace: String unit: String owns: (List String) -> (Result String String)" :pit (result effect))
(:sym "release!" :mod "asl-coord/claims" :sig "release! workspace: String unit: String -> (Result String String)" :pit (result effect))
(:sym "pathAllowed!" :mod "asl-coord/claims" :sig "pathAllowed! workspace: String unit: String rel: String -> (Result String String)" :pit (result effect))
(:sym "Ctx" :mod "asl-coord/core" :kind type :sig "(schema Ctx (:f call (fn [ty/Op] -> ty/Reply)) (:f scope String) (:f now Int64) (:f gone (fn [ls/Lease] -> Bool)) (:f alive (fn [ls/Lease] -> Bool)) (:f legacy (List ls/Lease)) (:f retireLegacy (fn [String] -> Unit)))" :pit (record))
(:sym "Held" :mod "asl-coord/core" :kind type :sig "(schema Held (:f lease ls/Lease) (:f epoch Int64) (:f rev Int64) (:f raw String))" :pit (record))
(:sym "receipt" :mod "asl-coord/core" :sig "receipt unit: String by: String path: String -> String")
(:sym "claimsOf" :mod "asl-coord/core" :sig "claimsOf ctx: Ctx -> (Result (List Held) String)" :pit (result))
(:sym "claimLease" :mod "asl-coord/core" :sig "claimLease ctx: Ctx self: ls/Lease -> (Result String String)" :pit (result))
(:sym "releaseLease" :mod "asl-coord/core" :sig "releaseLease ctx: Ctx unit: String caller: String self: ls/Lease -> (Result String String)" :pit (result))
(:sym "heartbeatLease" :mod "asl-coord/core" :sig "heartbeatLease ctx: Ctx unit: String epoch: Int64 rev: Int64 -> (Result Int64 String)" :pit (result))
(:sym "pathAllowedIn" :mod "asl-coord/core" :sig "pathAllowedIn ctx: Ctx caller: String rel: String -> (Result String String)" :pit (result))
(:sym "importLegacy" :mod "asl-coord/core" :sig "importLegacy ctx: Ctx rows: (List (Pair String Int64)) -> (Result Int64 String)" :pit (result))
(:sym "legacyDone?" :mod "asl-coord/core" :sig "legacyDone? ctx: Ctx -> Bool")
(:sym "sweepHeld" :mod "asl-coord/core" :sig "sweepHeld ctx: Ctx -> (Result (List Held) String)" :pit (result))
(:sym "sweepAll" :mod "asl-coord/core" :sig "sweepAll ctx: Ctx -> (Result (List Held) String)" :pit (result))
(:sym "retireStale" :mod "asl-coord/core" :sig "retireStale ctx: Ctx held: (List Held) -> (Result Unit String)" :pit (result))
(:sym "staleAt?" :mod "asl-coord/core" :sig "staleAt? ctx: Ctx lease: ls/Lease -> Bool")
(:sym "leaseKey" :mod "asl-coord/core" :sig "leaseKey ctx: Ctx unit: String -> ty/Key")
(:sym "epochIn" :mod "asl-coord/core" :sig "epochIn raw: String -> Int64")
(:sym "Lease" :mod "asl-coord/lease" :kind type :sig "(schema Lease (:f unit String) (:f owns (List String)) (:f branch String) (:f worktree String) (:f agent String) (:f host String) (:f pid Int64) (:f at Int64) (:f ttl Int64))" :pit (record))
(:sym "q" :mod "asl-coord/lease" :sig "q s: String -> String")
(:sym "leaseContent" :mod "asl-coord/lease" :sig "leaseContent lease: Lease -> String")
(:sym "parseLease" :mod "asl-coord/lease" :sig "parseLease raw: String -> Lease")
(:sym "parseOwns" :mod "asl-coord/lease" :sig "parseOwns raw: String -> (List String)")
(:sym "quotedField" :mod "asl-coord/lease" :sig "quotedField text: String key: String -> String")
(:sym "atomField" :mod "asl-coord/lease" :sig "atomField text: String key: String -> String")
(:sym "contextAt!" :mod "asl-coord/locate" :kind fn! :sig "contextAt! workspace: String home: String forWrite: Bool -> (Result (Option co/Ctx) String)" :pit (result effect))
(:sym "context!" :mod "asl-coord/locate" :kind fn! :sig "context! workspace: String forWrite: Bool -> (Result (Option co/Ctx) String)" :pit (result effect))
(:sym "identity!" :mod "asl-coord/locate" :kind fn! :sig "identity! workspace: String unit: String owns: (List String) -> ls/Lease" :pit (effect))
(:sym "callerUnit!" :mod "asl-coord/locate" :kind fn! :sig "callerUnit! workspace: String given: String -> String" :pit (effect))
(:sym "repoScope" :mod "asl-coord/locate" :sig "repoScope common: String -> String")
(:sym "scopeOfCommon" :mod "asl-coord/locate" :sig "scopeOfCommon common: String -> String")
(:sym "vaultRootAt!" :mod "asl-coord/locate" :kind fn! :sig "vaultRootAt! home: String -> String" :pit (effect))
(:sym "needPost" :mod "asl-coord/needs" :sig "needPost ctx: co/Ctx project: String agent: String pkg: String want: String repro: String prio: String -> (Result String String)" :pit (result))
(:sym "needList" :mod "asl-coord/needs" :sig "needList ctx: co/Ctx state: String pkg: String -> (Result (List String) String)" :pit (result))
(:sym "needTake" :mod "asl-coord/needs" :sig "needTake ctx: co/Ctx id: String unit: String -> (Result String String)" :pit (result))
(:sym "needClose" :mod "asl-coord/needs" :sig "needClose ctx: co/Ctx id: String unit: String state: String -> (Result String String)" :pit (result))
(:sym "needText" :mod "asl-coord/needs" :sig "needText id: String project: String agent: String pkg: String want: String repro: String prio: String state: String unit: String at: Int64 -> String")
(:sym "trimPath" :mod "asl-coord/paths" :sig "trimPath path: String -> String")
(:sym "entryFile" :mod "asl-coord/paths" :sig "entryFile e: String -> String")
(:sym "pathsOverlap?" :mod "asl-coord/paths" :sig "pathsOverlap? left: String right: String -> Bool")
(:sym "pathWithin?" :mod "asl-coord/paths" :sig "pathWithin? path: String root: String -> Bool")
(:sym "pathUnderOwns?" :mod "asl-coord/paths" :sig "pathUnderOwns? path: String owns: (List String) -> Bool")
(:sym "exemptPath?" :mod "asl-coord/paths" :sig "exemptPath? path: String -> Bool")
(:sym "listOverlapPath" :mod "asl-coord/paths" :sig "listOverlapPath items: (List String) path: String -> String")
(:sym "overlapBetween" :mod "asl-coord/paths" :sig "overlapBetween left: (List String) right: (List String) -> String")
(:sym "beat" :mod "asl-coord/presence" :sig "beat ctx: co/Ctx agent: String project: String unit: String ttlMs: Int64 -> (Result Int64 String)" :pit (result))
(:sym "agentsList" :mod "asl-coord/presence" :sig "agentsList ctx: co/Ctx -> (Result (List String) String)" :pit (result))
