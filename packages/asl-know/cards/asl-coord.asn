(:card "asl-coord" :purpose "Shared worktree scope claim leases" :import "(asl-coord/claims :a x)" :modules ((:m "asl-coord/claims" :doc "Shared cross-worktree scope leases in the git common dir...")) :sigs ("(schema ClaimsStore (:f workspace String) (:f root String) (:f retired String) (:f lock String))" "(schema Lease (:f unit String) (:f owns (List String)) (:f branch String) (:f worktree String) (:f agent String) (:f host String) (:f pid In..." "claimsStore! workspace: String -> (Result ClaimsStore String)" "claimsAt store: ClaimsStore unit: String -> String" "leaseContent lease: Lease -> String" "parseLease raw: String -> Lease" "parseOwns raw: String -> (List String)" "pathsOverlap? left: String right: String -> Bool" "claims! workspace: String -> (Result String String)") :more (claim! release! pathAllowed!) :effects (claimsStore! claims! claim! release! pathAllowed!) :fails (claimsStore! claims! claim! release! pathAllowed!) :example none)
(:sym "ClaimsStore" :mod "asl-coord/claims" :kind type :sig "(schema ClaimsStore (:f workspace String) (:f root String) (:f retired String) (:f lock String))" :pit (record))
(:sym "Lease" :mod "asl-coord/claims" :kind type :sig "(schema Lease (:f unit String) (:f owns (List String)) (:f branch String) (:f worktree String) (:f agent String) (:f host String) (:f pid Int64) (:f at Int64) (:f ttl Int64))" :pit (record))
(:sym "claimsStore!" :mod "asl-coord/claims" :sig "claimsStore! workspace: String -> (Result ClaimsStore String)" :doc "only a claim creates the store; checks and listings on a repo without leases leave the git dir untouched" :pit (result effect))
(:sym "claimsAt" :mod "asl-coord/claims" :sig "claimsAt store: ClaimsStore unit: String -> String")
(:sym "leaseContent" :mod "asl-coord/claims" :sig "leaseContent lease: Lease -> String")
(:sym "parseLease" :mod "asl-coord/claims" :sig "parseLease raw: String -> Lease")
(:sym "parseOwns" :mod "asl-coord/claims" :sig "parseOwns raw: String -> (List String)")
(:sym "pathsOverlap?" :mod "asl-coord/claims" :sig "pathsOverlap? left: String right: String -> Bool")
(:sym "claims!" :mod "asl-coord/claims" :sig "claims! workspace: String -> (Result String String)" :pit (result effect))
(:sym "claim!" :mod "asl-coord/claims" :sig "claim! workspace: String unit: String owns: (List String) -> (Result String String)" :pit (result effect))
(:sym "release!" :mod "asl-coord/claims" :sig "release! workspace: String unit: String -> (Result String String)" :pit (result effect))
(:sym "pathAllowed!" :mod "asl-coord/claims" :sig "pathAllowed! workspace: String unit: String rel: String -> (Result String String)" :pit (result effect))
