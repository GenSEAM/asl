(:card "asl-mem" :purpose "High-performance vector memory store and tiered context engine" :import "(aslMem/engine :a x)" :deps (asl-compiler asl-parser asl-text asl-codec) :modules ((:m "aslMem/engine" :doc "Unified ASL Storage Engine: orchestrating Ephemeral In-M...") (:m "aslMem/amnesia" :doc "Amnesia memory chunk DAG, millisecond timestamps, and co...") (:m "aslMem/asnBoxart") (:m "aslMem/astFilter" :doc "Structural AST pattern matching and S-expression filter ...") (:m "aslMem/astMerge")) :moduleCount 61 :sigs ("(enum StorageMode (:c modeEphemeral [] \"100% in-memory ring buffer, zero disk I/O\") (:c modeSnapshot [] \"In-memory with periodic or manual a..." "(schema StorageConfig (:f mode StorageMode) (:f ringCapacity I64) (:f walPath Str) (:f snapshotPath Str))" "(schema MemoryEngine (:f config StorageConfig) (:f ring r/RingBuffer) (:f vectors s/VectorStore) (:f graph g/KnowledgeGraph) (:f wal w/WalSt..." "(schema EngineStats (:f modeName Str) (:f ringUtilization I64) (:f vectorCount I64) (:f nodeCount I64) (:f edgeCount I64) (:f walEntriesComm...") :more (makeEngine enginePutVector enginePutNode enginePutEdge engineDelNode engineCheckpoint engineApplyWalEntry engineRecover engineStats Chunk ChunkDAG RetiredChunk) :moreCount 611 :effects (bytesFromListF64! rehydratePointer! stmWrite! commitBranch!) :fails (chunkDagAdd restoreVfsCheckpoint opfsWriteRecord opfsReadRecord opfsFlush opfsListRecords opfsDeleteRecord sqliteWriteRecord) :example none)
