(:card "asl-lint" :purpose "AgentSlang Native Quality, Smell, and Anti-Pattern Analysis Engine (the anchorGuard/incongruity/rules/clone/tokens modules and 4 of this package's own 5 tests were deleted in DEAD-PACKAGES/e6dcc002b as dead; the core sme..." :import "(asl-lint/core :a x)" :deps (asl-parser) :modules ((:m "asl-lint/core" :doc "AgentSlang native quality inspection, anti-pattern smell...")) :sigs ("(enum SmellSeverity (:c error [] \"Fatal defect that blocks compilation or pre-commit gate\") (:c warning [] \"Code smell that degrades readabi..." "(enum SmellCode (:c duplicateMatchArm [] \"Multiple pattern match arms share identical bodies\") (:c deadBranch [] \"Pattern branch unreachable..." "(schema Smell (:f code SmellCode) (:f severity SmellSeverity) (:f file Str) (:f line I64) (:f col I64) (:f message Str) (:f canAutofix Bool)..." "(schema QualityMetrics (:f totalNodes I64) (:f maxNesting I64) (:f errorCount I64) (:f warningCount I64) (:f score I64))" "isError sev: SmellSeverity -> Bool") :more (severityPenalty calculateQualityScore isNestingExcessive shouldBlockGate canAutofix checkC1Balance) :example none)
(:sym "SmellSeverity" :mod "asl-lint/core" :kind type :sig "(enum SmellSeverity (:c error [] \"Fatal defect that blocks compilation or pre-commit gate\") (:c warning [] \"Code smell that degrades readability or maintainability\") (:c info [] \"Minor stylistic recommendation\"))")
(:sym "SmellCode" :mod "asl-lint/core" :kind type :sig "(enum SmellCode (:c duplicateMatchArm [] \"Multiple pattern match arms share identical bodies\") (:c deadBranch [] \"Pattern branch unreachable due to prior wildcard\") (:c excessiveNesting [] \"Expression nesting exceeds maximum cognitive depth threshold\") (:c unusedBinding [] \"Local variable binding de ...")
(:sym "Smell" :mod "asl-lint/core" :kind type :sig "(schema Smell (:f code SmellCode) (:f severity SmellSeverity) (:f file Str) (:f line I64) (:f col I64) (:f message Str) (:f canAutofix Bool))" :pit (record))
(:sym "QualityMetrics" :mod "asl-lint/core" :kind type :sig "(schema QualityMetrics (:f totalNodes I64) (:f maxNesting I64) (:f errorCount I64) (:f warningCount I64) (:f score I64))" :pit (record))
(:sym "isError" :mod "asl-lint/core" :sig "isError sev: SmellSeverity -> Bool")
(:sym "severityPenalty" :mod "asl-lint/core" :sig "severityPenalty sev: SmellSeverity -> I64")
(:sym "calculateQualityScore" :mod "asl-lint/core" :sig "calculateQualityScore errorCount: I64 warningCount: I64 -> I64")
(:sym "isNestingExcessive" :mod "asl-lint/core" :sig "isNestingExcessive depth: I64 maxAllowed: I64 -> Bool")
(:sym "shouldBlockGate" :mod "asl-lint/core" :sig "shouldBlockGate metrics: QualityMetrics -> Bool")
(:sym "canAutofix" :mod "asl-lint/core" :sig "canAutofix code: SmellCode -> Bool")
(:sym "checkC1Balance" :mod "asl-lint/core" :sig "checkC1Balance code: Str -> bal/BalanceResult")
