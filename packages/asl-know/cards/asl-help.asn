(:card "asl-help" :purpose "Self-Contained Machine-Readable ASN Help System and Autonomous Toolbelt Introspection Engine (the helpNode/registry/situations modules and both of this package's own tests were deleted in DEAD-PACKAGES/eef761e17 as dead;..." :import "(asl-help/toolRegistry :a x)" :deps (asl-text) :modules ((:m "asl-help/toolRegistry" :doc "Canonical 20-Tool Inventory Registry, Two-Tier Catalog &...") (:m "asl-help/toolDescriptor" :doc "Canonical ToolDescriptor Schema, Parameter Typing & Seri...")) :sigs ("canonicalTools -> (List td/ToolDescriptor)" "catalogSize -> I64" "catalogDigest -> Str" "lookupTool name: Str -> (Option td/ToolDescriptor)" "formatCatalogSummary -> Str" "formatToolDeepByName name: Str -> Str" "helpTool! name: Str -> Str" "schema ToolParameter name: Str ptype: Str required: Bool desc: Str" "schema ToolDescriptor name: Str contract: Str signature: Str summary: Str situations: (List Str) parameters: (List ToolParameter) returns: S..." "makeToolParameter name: Str ptype: Str required: Bool desc: Str -> ToolParameter") :more (makeToolDescriptor formatToolCompact formatToolDeep compactTokenCost deepTokenCost) :effects (helpTool!) :example none)
(:sym "canonicalTools" :mod "asl-help/toolRegistry" :sig "canonicalTools -> (List td/ToolDescriptor)")
(:sym "catalogSize" :mod "asl-help/toolRegistry" :sig "catalogSize -> I64")
(:sym "catalogDigest" :mod "asl-help/toolRegistry" :sig "catalogDigest -> Str")
(:sym "lookupTool" :mod "asl-help/toolRegistry" :sig "lookupTool name: Str -> (Option td/ToolDescriptor)" :pit (option))
(:sym "formatCatalogSummary" :mod "asl-help/toolRegistry" :sig "formatCatalogSummary -> Str")
(:sym "formatToolDeepByName" :mod "asl-help/toolRegistry" :sig "formatToolDeepByName name: Str -> Str")
(:sym "helpTool!" :mod "asl-help/toolRegistry" :sig "helpTool! name: Str -> Str" :pit (effect))
(:sym "ToolParameter" :mod "asl-help/toolDescriptor" :kind type :sig "schema ToolParameter name: Str ptype: Str required: Bool desc: Str")
(:sym "ToolDescriptor" :mod "asl-help/toolDescriptor" :kind type :sig "schema ToolDescriptor name: Str contract: Str signature: Str summary: Str situations: (List Str) parameters: (List ToolParameter) returns: Str whenToUse: Str whenNotToUse: Str failureModes: (List Str) example: Str")
(:sym "makeToolParameter" :mod "asl-help/toolDescriptor" :sig "makeToolParameter name: Str ptype: Str required: Bool desc: Str -> ToolParameter")
(:sym "makeToolDescriptor" :mod "asl-help/toolDescriptor" :sig "makeToolDescriptor name: Str contract: Str signature: Str summary: Str situations: (List Str) parameters: (List ToolParameter) returns: Str whenToUse: Str whenNotToUse: Str failureModes: (List Str) example: Str -> ToolDescriptor")
(:sym "formatToolCompact" :mod "asl-help/toolDescriptor" :sig "formatToolCompact td: ToolDescriptor -> Str")
(:sym "formatToolDeep" :mod "asl-help/toolDescriptor" :sig "formatToolDeep td: ToolDescriptor -> Str")
(:sym "compactTokenCost" :mod "asl-help/toolDescriptor" :sig "compactTokenCost td: ToolDescriptor -> I64")
(:sym "deepTokenCost" :mod "asl-help/toolDescriptor" :sig "deepTokenCost td: ToolDescriptor -> I64")
