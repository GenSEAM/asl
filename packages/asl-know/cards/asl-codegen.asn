(:sym "emitCHeaderFile" :mod "asl-codegen/emitC" :sig "emitCHeaderFile mod: a/ModuleNode -> Str" :doc "Emits a C header file from a module node.")
(:sym "emitCSourceFile" :mod "asl-codegen/emitC" :sig "emitCSourceFile mod: a/ModuleNode -> Str" :doc "Emits a C source file from a module node.")
(:sym "c99TypeStr" :mod "asl-codegen/emitC" :sig "c99TypeStr ty: Str -> Str" :doc "Converts an ASL type string to its C99 type name.")
(:sym "emitExpr" :mod "asl-codegen/expr" :sig "emitExpr e: rd/SExpr aliases: (Map String String) -> String" :doc "Emits Rust source code for an S-expression expression.")
(:sym "emitAtom" :mod "asl-codegen/expr" :sig "emitAtom s: String aliases: (Map String String) -> String" :doc "Emits Rust source code for an atomic literal or symbol.")
(:sym "emitPattern" :mod "asl-codegen/expr" :sig "emitPattern p: rd/SExpr aliases: (Map String String) -> String" :doc "Emits a Rust pattern expression from an S-expression pattern.")
(:sym "emitBodySeq" :mod "asl-codegen/expr" :sig "emitBodySeq body: (List rd/SExpr) aliases: (Map String String) -> String" :doc "Emits a sequence of S-expression body statements as Rust expressions.")
(:sym "isIdent?" :mod "asl-codegen/expr" :sig "isIdent? s: String -> Bool" :doc "Returns true when a string is a valid identifier name.")
(:sym "cloneIfIdent" :mod "asl-codegen/expr" :sig "cloneIfIdent s: String -> String" :doc "Appends .clone() call when a string is an identifier.")
(:sym "resolveQualifiedCase" :mod "asl-codegen/expr" :sig "resolveQualifiedCase head: String aliases: (Map String String) -> String" :doc "Resolves a qualified enum constructor name using alias mappings.")
