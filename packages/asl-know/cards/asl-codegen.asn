(:sym "emitArduinoHeader" :mod "asl-codegen/emitC" :sig "emitArduinoHeader -> Str" :doc "Returns Arduino library include header lines.")
(:sym "emitCType" :mod "asl-codegen/emitC" :sig "emitCType ty: Str -> Str" :doc "Maps an ASL type string to an Arduino C type.")
(:sym "emitCFn" :mod "asl-codegen/emitC" :sig "emitCFn name: Str retTy: Str body: Str -> Str" :doc "Emits a simple C function definition from name, return type, and body.")
