(:sym "mangleIdent" :mod "asl-codegen/mangle" :sig "mangleIdent s: String -> String" :doc "Mangles an ASL identifier into a valid Rust snake_case identifier.")
(:sym "pascalIdent" :mod "asl-codegen/mangle" :sig "pascalIdent s: String -> String" :doc "Converts a kebab-case identifier into PascalCase.")
