(:card "asl-codegen" :purpose "Pure AgentSlang Native Rust and ISO C99 Codegen Pipeline" :import "(asl-codegen/emit :a x)" :deps (asl-parser asl-checker) :modules ((:m "asl-codegen/emit" :doc "Top-level form emission, module linking, and Rust progra...") (:m "asl-codegen/builtins" :doc "Builtin lowering templates and rendering for the 107 Cor...") (:m "asl-codegen/c99Emit" :doc "Translation unit assembly, multi-lens projection, and du...") (:m "asl-codegen/c99Expr" :doc "Pure ISO C99 expression lowering, control flow, and stat...") (:m "asl-codegen/c99Mangle" :doc "ISO C99 identifier hygiene, keyword collision avoidance,...")) :moduleCount 10 :sigs ("emitDefschema s: a/SchemaNode -> String" "emitDefenum e: a/EnumNode -> String" "emitDefun d: a/DefunNode aliases: (Map String String) -> String" "emitTopForms defs: (List a/TopForm) aliases: (Map String String) allEnums: (Map String String) -> String" "emitRustProgram rootForms: (List a/TopForm) deps: (List a/TopForm) -> String" "mergeMaps m1: (Map String String) m2: (Map String String) -> (Map String String)" "hasMainFn? defs: (List a/TopForm) -> Bool" "builtinTemplate name: String -> (Option String)" "renderTemplate tmpl: String args: (List String) -> String") :more (renderBuiltin emitCHeaderGuards emitCStandardIncludes emitCFunctionPrototype emitCExternCWrapper emitCFreestandingPreamble emitCHostedPreamble emitCHeaderFile) :moreCount 98 :example none)
(:sym "emitDefschema" :mod "asl-codegen/emit" :sig "emitDefschema s: a/SchemaNode -> String" :doc "Emits a Rust struct definition for a schema declaration.")
(:sym "emitDefenum" :mod "asl-codegen/emit" :sig "emitDefenum e: a/EnumNode -> String" :doc "Emits a Rust enum definition for an enum declaration.")
(:sym "emitDefun" :mod "asl-codegen/emit" :sig "emitDefun d: a/DefunNode aliases: (Map String String) -> String" :doc "Emits a Rust function definition from an ASL function AST node.")
(:sym "emitTopForms" :mod "asl-codegen/emit" :sig "emitTopForms defs: (List a/TopForm) aliases: (Map String String) allEnums: (Map String String) -> String" :doc "Emits Rust code for a list of top-level schema, enum, and function forms.")
(:sym "emitRustProgram" :mod "asl-codegen/emit" :sig "emitRustProgram rootForms: (List a/TopForm) deps: (List a/TopForm) -> String" :doc "Emits a complete Rust source program with runtime imports and declarations.")
(:sym "mergeMaps" :mod "asl-codegen/emit" :sig "mergeMaps m1: (Map String String) m2: (Map String String) -> (Map String String)" :doc "Merges two string maps into a combined map.")
(:sym "hasMainFn?" :mod "asl-codegen/emit" :sig "hasMainFn? defs: (List a/TopForm) -> Bool" :doc "Returns true when a list of top-level forms contains a main function.")
(:sym "builtinTemplate" :mod "asl-codegen/builtins" :sig "builtinTemplate name: String -> (Option String)" :doc "Returns the code generation template string for a builtin function name." :pit (option))
(:sym "renderTemplate" :mod "asl-codegen/builtins" :sig "renderTemplate tmpl: String args: (List String) -> String" :doc "Substitutes positional argument expressions into a template string.")
(:sym "renderBuiltin" :mod "asl-codegen/builtins" :sig "renderBuiltin bname: String args: (List String) -> (Option String)" :doc "Renders lowered source code for a builtin call with argument expressions." :pit (option))
(:sym "emitCHeaderGuards" :mod "asl-codegen/c99Emit" :sig "emitCHeaderGuards modName: String content: String -> String" :doc "Wraps header content with C preprocessor include guards.")
(:sym "emitCStandardIncludes" :mod "asl-codegen/c99Emit" :sig "emitCStandardIncludes isFreestanding: Bool -> String" :doc "Emits standard C header includes based on freestanding mode.")
(:sym "emitCFunctionPrototype" :mod "asl-codegen/c99Emit" :sig "emitCFunctionPrototype fn: a/DefunNode -> String" :doc "Emits a C function prototype declaration from a function AST node.")
(:sym "emitCExternCWrapper" :mod "asl-codegen/c99Emit" :sig "emitCExternCWrapper content: String -> String" :doc "Wraps C header declarations in extern C guards for C++ compatibility.")
(:sym "emitCFreestandingPreamble" :mod "asl-codegen/c99Emit" :sig "emitCFreestandingPreamble -> String" :doc "Emits the C standard preamble for freestanding environments.")
(:sym "emitCHostedPreamble" :mod "asl-codegen/c99Emit" :sig "emitCHostedPreamble -> String" :doc "Emits the C standard preamble for hosted environments.")
(:sym "emitCHeaderFile" :mod "asl-codegen/c99Emit" :sig "emitCHeaderFile mod: a/ModuleNode -> String" :doc "Emits the complete C header file for an ASL module.")
(:sym "emitCSourceFile" :mod "asl-codegen/c99Emit" :sig "emitCSourceFile mod: a/ModuleNode -> String" :doc "Emits the complete C source implementation file for an ASL module.")
(:sym "emitCStandalone" :mod "asl-codegen/c99Emit" :sig "emitCStandalone forms: (List a/TopForm) entryFn: String isFreestanding: Bool -> String" :doc "Emits a complete self-contained standalone C source file from AST forms.")
(:sym "emitCMainEntry" :mod "asl-codegen/c99Emit" :sig "emitCMainEntry entryFn: String isFreestanding: Bool -> String" :doc "Emits a standard C main entry function delegating to an entry function.")
(:sym "emitCMainEntryWithArgs" :mod "asl-codegen/c99Emit" :sig "emitCMainEntryWithArgs entryFn: String isFreestanding: Bool hasArgs: Bool -> String" :doc "Emits the C main function entry point with command-line arguments handling.")
(:sym "collectUniqueDefuns" :mod "asl-codegen/c99Emit" :sig "collectUniqueDefuns defuns: (List a/DefunNode) -> (List a/DefunNode)" :doc "Filters a list of function AST nodes to remove duplicate definitions.")
(:sym "assembleCModule" :mod "asl-codegen/c99Emit" :sig "assembleCModule mod: a/ModuleNode isFreestanding: Bool -> String" :doc "Assembles declarations and definitions into a standalone C module source.")
(:sym "emitCFunctionDef" :mod "asl-codegen/c99Emit" :sig "emitCFunctionDef fn: a/DefunNode fnTypes: (Map String String) -> String" :doc "Emits a C function definition with lowered body from an AST node.")
(:sym "emitSchemaForwardDecl" :mod "asl-codegen/c99Emit" :sig "emitSchemaForwardDecl s: a/SchemaNode -> String" :doc "Emits a C forward struct declaration for a schema type.")
(:sym "emitEnumForwardDecl" :mod "asl-codegen/c99Emit" :sig "emitEnumForwardDecl e: a/EnumNode -> String" :doc "Emits a C forward struct declaration for an enum type.")
(:sym "collectFormsSchemas" :mod "asl-codegen/c99Emit" :sig "collectFormsSchemas forms: (List a/TopForm) idx: Int64 len: Int64 acc: (List a/SchemaNode) -> (List a/SchemaNode)" :doc "Collects all schema declaration nodes from top-level AST forms.")
(:sym "collectFormsEnums" :mod "asl-codegen/c99Emit" :sig "collectFormsEnums forms: (List a/TopForm) idx: Int64 len: Int64 acc: (List a/EnumNode) -> (List a/EnumNode)" :doc "Collects all enum declaration nodes from top-level AST forms.")
(:sym "collectFormsDefuns" :mod "asl-codegen/c99Emit" :sig "collectFormsDefuns forms: (List a/TopForm) idx: Int64 len: Int64 acc: (List a/DefunNode) -> (List a/DefunNode)" :doc "Collects all function declaration nodes from top-level AST forms.")
(:sym "LowerCtx" :mod "asl-codegen/c99Expr" :kind type :sig "(schema LowerCtx (:f vars (List (Pair String String))) (:f substs (List (Pair String String))) (:f fns (List (Pair String String))) (:f retTy String))" :pit (record))
(:sym "emptyLowerCtx" :mod "asl-codegen/c99Expr" :sig "emptyLowerCtx -> LowerCtx" :doc "Creates an empty C lowering context.")
(:sym "ctxWithVar" :mod "asl-codegen/c99Expr" :sig "ctxWithVar ctx: LowerCtx name: String cType: String -> LowerCtx" :doc "Returns a lowering context augmented with a local variable binding.")
(:sym "ctxVarType" :mod "asl-codegen/c99Expr" :sig "ctxVarType ctx: LowerCtx name: String -> (Option String)" :doc "Looks up the C type of a variable in the lowering context." :pit (option))
(:sym "lowerCExpr" :mod "asl-codegen/c99Expr" :sig "lowerCExpr ctx: LowerCtx e: rd/SExpr -> String" :doc "Lowers an ASL S-expression into a C expression string.")
(:sym "lowerCAtom" :mod "asl-codegen/c99Expr" :sig "lowerCAtom s: String -> String" :doc "Lowers an atomic ASL literal or symbol to C syntax.")
(:sym "lowerCLet" :mod "asl-codegen/c99Expr" :sig "lowerCLet ctx: LowerCtx items: (List rd/SExpr) -> String" :doc "Lowers a let binding expression to C statement blocks.")
(:sym "lowerCIf" :mod "asl-codegen/c99Expr" :sig "lowerCIf ctx: LowerCtx items: (List rd/SExpr) -> String" :doc "Lowers an if expression to a C ternary or conditional statement.")
(:sym "lowerCCond" :mod "asl-codegen/c99Expr" :sig "lowerCCond ctx: LowerCtx items: (List rd/SExpr) -> String" :doc "Lowers a cond form to a nested C ternary or if-else chain.")
(:sym "lowerCMatch" :mod "asl-codegen/c99Expr" :sig "lowerCMatch ctx: LowerCtx items: (List rd/SExpr) -> String" :doc "Lowers a pattern match form to C switch or conditional blocks.")
(:sym "lowerCCall" :mod "asl-codegen/c99Expr" :sig "lowerCCall ctx: LowerCtx items: (List rd/SExpr) -> String" :doc "Lowers a function or constructor call S-expression to C syntax.")
(:sym "lowerCFieldAccess" :mod "asl-codegen/c99Expr" :sig "lowerCFieldAccess target: String field: String -> String" :doc "Lowers record field access into C arrow or dot member expression.")
(:sym "lowerCRecordInit" :mod "asl-codegen/c99Expr" :sig "lowerCRecordInit ctx: LowerCtx items: (List rd/SExpr) -> String" :doc "Lowers a record constructor form to a C struct initializer.")
(:sym "lowerCDo" :mod "asl-codegen/c99Expr" :sig "lowerCDo ctx: LowerCtx items: (List rd/SExpr) -> String" :doc "Lowers a do block of sequential expressions into C statements.")
(:sym "wrapBlockWithReturn" :mod "asl-codegen/c99Expr" :sig "wrapBlockWithReturn s: String -> String" :doc "Wraps a block expression in statement-expression syntax with return.")
(:sym "isC99Keyword?" :mod "asl-codegen/c99Expr" :sig "isC99Keyword? s: String -> Bool" :doc "Returns true when a string is a reserved C99 keyword.")
(:sym "mangleCIdent" :mod "asl-codegen/c99Expr" :sig "mangleCIdent s: String -> String" :doc "Mangles an ASL identifier into a valid C identifier.")
(:sym "mangleCTypeName" :mod "asl-codegen/c99Expr" :sig "mangleCTypeName s: String -> String" :doc "Mangles an ASL type name into a valid C identifier.")
(:sym "c99TypeStr" :mod "asl-codegen/c99Expr" :sig "c99TypeStr s: String -> String" :doc "Converts an ASL type annotation string into its C99 type name.")
(:sym "isIntegerLiteral?" :mod "asl-codegen/c99Expr" :sig "isIntegerLiteral? s: String -> Bool" :doc "Returns true when a string represents a valid integer literal.")
(:sym "isFloatLiteral?" :mod "asl-codegen/c99Expr" :sig "isFloatLiteral? s: String -> Bool" :doc "Returns true when a string represents a valid floating-point literal.")
(:sym "inferCType" :mod "asl-codegen/c99Expr" :sig "inferCType ctx: LowerCtx e: rd/SExpr valExpr: String -> String" :doc "The C type of an expression: declared, literal-derived, else __auto_type.")
(:sym "mangleCIdent" :mod "asl-codegen/c99Mangle" :sig "mangleCIdent s: String -> String" :doc "Mangles an ASL identifier into a valid C identifier.")
(:sym "isC99Keyword?" :mod "asl-codegen/c99Mangle" :sig "isC99Keyword? m: String -> Bool" :doc "Returns true when a string matches a reserved C99 keyword.")
(:sym "mangleCTypeName" :mod "asl-codegen/c99Mangle" :sig "mangleCTypeName s: String -> String" :doc "Mangles an ASL type name into a sanitized C type identifier.")
(:sym "mangleCModulePrefix" :mod "asl-codegen/c99Mangle" :sig "mangleCModulePrefix modPath: String -> String" :doc "Converts a module path into a C identifier prefix.")
(:sym "pascalIdent" :mod "asl-codegen/c99Mangle" :sig "pascalIdent s: String -> String" :doc "Converts a kebab-case identifier into PascalCase for C types.")
(:sym "capitalizeSeg" :mod "asl-codegen/c99Mangle" :sig "capitalizeSeg seg: String -> String" :doc "Capitalizes the first character of an identifier segment.")
(:sym "sliceOr" :mod "asl-codegen/c99Mangle" :sig "sliceOr s: String start: Int64 end: Int64 fallback: String -> String" :doc "Returns a substring slice or fallback string when out of bounds.")
(:sym "isDigitLeading?" :mod "asl-codegen/c99Mangle" :sig "isDigitLeading? s: String -> Bool" :doc "Returns true when the first character of a string is a digit.")
(:sym "c99PrimitiveType" :mod "asl-codegen/c99Type" :sig "c99PrimitiveType name: String -> (Option String)" :doc "Resolves primitive ASL type names to their standard C99 type names." :pit (option))
(:sym "c99TypeStr" :mod "asl-codegen/c99Type" :sig "c99TypeStr s: String -> String" :doc "Converts an ASL type annotation string into its C99 type representation.")
(:sym "emitCDefschema" :mod "asl-codegen/c99Type" :sig "emitCDefschema s: a/SchemaNode -> String" :doc "Emits a C struct definition and constructor for a schema declaration.")
(:sym "emitCDefenum" :mod "asl-codegen/c99Type" :sig "emitCDefenum e: a/EnumNode -> String" :doc "Emits a C tagged union struct definition for an enum declaration.")
(:sym "emitCStringType" :mod "asl-codegen/c99Type" :sig "emitCStringType -> String" :doc "Emits the C struct typedef and functions for ASL string values.")
(:sym "emitCOptionType" :mod "asl-codegen/c99Type" :sig "emitCOptionType innerType: String -> String" :doc "Emits C struct typedef and helper functions for an Option type.")
(:sym "emitCSliceType" :mod "asl-codegen/c99Type" :sig "emitCSliceType elemType: String -> String" :doc "Emits C struct typedef and helper functions for a Slice type.")
(:sym "emitCPairType" :mod "asl-codegen/c99Type" :sig "emitCPairType firstType: String secondType: String -> String" :doc "Emits C struct typedef and helper functions for a Pair type.")
(:sym "emitCMapType" :mod "asl-codegen/c99Type" :sig "emitCMapType keyType: String valType: String -> String" :doc "Emits C struct typedef and helper functions for a Map type.")
(:sym "emitCResultType" :mod "asl-codegen/c99Type" :sig "emitCResultType okType: String errType: String -> String" :doc "Emits C struct typedef and helper functions for a Result type.")
(:sym "emitResultConstructors" :mod "asl-codegen/c99Type" :sig "emitResultConstructors okType: String errType: String -> String" :doc "Emits C constructor helper functions for ok and err Result variants.")
(:sym "collectInsts" :mod "asl-codegen/c99Type" :sig "collectInsts t: ty/Type acc: (List ty/Type) -> (List ty/Type)" :doc "Collects generic type instances recursively from a type structure.")
(:sym "collectInstsFromAnnotation" :mod "asl-codegen/c99Type" :sig "collectInstsFromAnnotation annotation: String acc: (List ty/Type) -> (List ty/Type)" :doc "Parses and collects generic type instances from an annotation string.")
(:sym "emitInstTypedef" :mod "asl-codegen/c99Type" :sig "emitInstTypedef t: ty/Type -> String" :doc "Emits the C typedef definition for a generic type instance.")
(:sym "emitInstTypedefs" :mod "asl-codegen/c99Type" :sig "emitInstTypedefs forms: (List a/TopForm) wantSlices: Bool -> String" :doc "Emits C struct typedefs for all generic types in AST forms.")
(:sym "emitInstTypedefsFromUniq" :mod "asl-codegen/c99Type" :sig "emitInstTypedefsFromUniq uniq: (List ty/Type) wantSlices: Bool -> String" :doc "Emits C struct typedefs for unique generic type instances.")
(:sym "emitInstForwardDecls" :mod "asl-codegen/c99Type" :sig "emitInstForwardDecls forms: (List a/TopForm) -> String" :doc "Emits C forward declarations for all generic types in AST forms.")
(:sym "emitInstForwardDeclsFromUniq" :mod "asl-codegen/c99Type" :sig "emitInstForwardDeclsFromUniq uniq: (List ty/Type) -> String" :doc "Emits C forward declarations for unique generic type instances.")
(:sym "emitInstAccessors" :mod "asl-codegen/c99Type" :sig "emitInstAccessors forms: (List a/TopForm) -> String" :doc "Emits C accessor functions for all generic types in AST forms.")
(:sym "emitInstAccessorsFromUniq" :mod "asl-codegen/c99Type" :sig "emitInstAccessorsFromUniq uniq: (List ty/Type) -> String" :doc "Emits C accessor functions for unique generic type instances.")
(:sym "collectAllInsts" :mod "asl-codegen/c99Type" :sig "collectAllInsts forms: (List a/TopForm) -> (List ty/Type)" :doc "Collects all instantiated generic types across top-level AST forms.")
(:sym "dedupeInsts" :mod "asl-codegen/c99Type" :sig "dedupeInsts insts: (List ty/Type) -> (List ty/Type)" :doc "Removes duplicate generic type instances preserving unique types.")
(:sym "c99FromType" :mod "asl-codegen/c99Type" :sig "c99FromType t: ty/Type -> String" :doc "Converts an AST type structure into its C99 type declaration string.")
(:sym "c99TypeName" :mod "asl-codegen/c99Type" :sig "c99TypeName s: String -> String" :doc "Maps an ASL primitive or standard type name to its C99 equivalent.")
(:sym "c99FieldIdent" :mod "asl-codegen/c99Type" :sig "c99FieldIdent s: String -> String" :doc "Mangles an ASL record field name into a valid C struct member name.")
(:sym "c99UpperIdent" :mod "asl-codegen/c99Type" :sig "c99UpperIdent s: String -> String" :doc "Converts an identifier into uppercase notation for C enum constants.")
(:sym "isC99Keyword?" :mod "asl-codegen/c99Type" :sig "isC99Keyword? id: String -> Bool" :doc "Returns true when an identifier is a reserved C99 keyword.")
(:sym "isC99NativeType?" :mod "asl-codegen/c99Type" :sig "isC99NativeType? s: String -> Bool" :doc "Returns true when a type name is a standard C integer or primitive type.")
