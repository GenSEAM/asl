(:card "asl-codegen" :purpose "Pure AgentSlang Native Rust and ISO C99 Codegen Pipeline" :import "(asl-codegen/emit :a x)" :deps (asl-parser asl-checker) :modules ((:m "asl-codegen/emit") (:m "asl-codegen/builtins") (:m "asl-codegen/c99Emit" :doc "Translation unit assembly, multi-lens projection, and du...") (:m "asl-codegen/c99Expr") (:m "asl-codegen/c99Mangle" :doc "ISO C99 identifier hygiene, keyword collision avoidance,...")) :moduleCount 10 :sigs ("emitDefschema s: a/SchemaNode -> String" "emitDefenum e: a/EnumNode -> String" "emitDefun d: a/DefunNode aliases: (Map String String) -> String" "emitTopForms defs: (List a/TopForm) aliases: (Map String String) allEnums: (Map String String) -> String" "emitRustProgram rootForms: (List a/TopForm) deps: (List a/TopForm) -> String" "mergeMaps m1: (Map String String) m2: (Map String String) -> (Map String String)" "hasMainFn? defs: (List a/TopForm) -> Bool" "builtinTemplate name: String -> (Option String)" "renderTemplate tmpl: String args: (List String) -> String") :more (renderBuiltin emitCHeaderGuards emitCStandardIncludes emitCFunctionPrototype emitCExternCWrapper emitCFreestandingPreamble emitCHostedPreamble emitCHeaderFile) :moreCount 98 :example none)
