(:sym "resolveLang" :mod "asl-syntax/core/format" :sig "resolveLang lang: String -> (Result String String)" :doc "the language comes only from the caller: an explicit asl or asn, or a path whose extension decides it" :pit (result))
(:sym "langForPath" :mod "asl-syntax/core/format" :sig "langForPath path: String -> (Result String String)" :doc "map a file extension to its language; any other extension is an error, never a guess" :pit (result))
(:sym "checkRepairedLines" :mod "asl-syntax/core/format" :sig "checkRepairedLines origLines: (List String) repLines: (List String) touched: (List Int64) idx: Int64 -> (Result Bool String)" :doc "delimiter edits never add or remove a newline except a closer appended after a final newline, so every line the repaired text changes must be one an item names; anything else means text and items disagree" :pit (result))
(:sym "touchedLinesFromRepaired" :mod "asl-syntax/core/format" :sig "touchedLinesFromRepaired items: (List rep/RepairedItem) -> (List Int64)" :doc "touched lines are the distinct lines the items name; delimiter edits never add or remove a newline, so these numbers hold in the repaired text")
(:sym "formatText" :mod "asl-syntax/core/format" :sig "formatText origText: String res: rep/RepairResult lang: String -> (Result String String)" :doc "one code path for clean and repaired input: the caller's repair result supplies the repaired text and the items that name the touched lines; the language is validated here and chose the repair; repair is never re-run here" :pit (result))
(:sym "formatBytes" :mod "asl-syntax/core/format" :sig "formatBytes origBytes: Bytes res: rep/RepairResult lang: String -> (Result Bytes String)" :doc "byte form of formatText" :pit (result))
(:sym "formatRepair" :mod "asl-syntax/core/format" :sig "formatRepair origText: String lang: String -> (Result String String)" :doc "formatter applies each fault's at-site edit, as G2" :pit (result))
(:sym "formatFile!" :mod "asl-syntax/core/format" :sig "formatFile! path: String -> (Result String String)" :doc "repair and format a file in the language its extension names" :pit (result effect))
(:sym "formatSingleLine" :mod "asl-syntax/core/format" :sig "formatSingleLine line: String -> String" :doc "a line keeps its own terminator: a trailing carriage return is set aside before re-spacing and restored after")
(:sym "shouldSeparate" :mod "asl-syntax/core/format" :sig "shouldSeparate line: String prevTok: tr/Token nextTok: tr/Token -> Bool" :doc "re-spacing never moves a token boundary: tokens written together stay together, a run of blanks becomes one space, and blanks after an opener or before a closer or comma go away")
(:sym "isOpenDelim?" :mod "asl-syntax/core/format" :sig "isOpenDelim? kind: String -> Bool" :doc "check if token kind is opening delimiter")
(:sym "isCloseDelim?" :mod "asl-syntax/core/format" :sig "isCloseDelim? kind: String -> Bool" :doc "check if token kind is closing delimiter")
(:sym "isOnlyClosingDelims?" :mod "asl-syntax/core/format" :sig "isOnlyClosingDelims? s: String -> Bool" :doc "check if string has only closing delimiters")
(:sym "lineEndsWithComment?" :mod "asl-syntax/core/format" :sig "lineEndsWithComment? line: String -> Bool" :doc "check if line ends with a comment token")
