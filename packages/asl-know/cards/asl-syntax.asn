(:card "asl-syntax" :purpose "Lossless syntax trees, source mapping, and foreign language models" :import "(asl-syntax/core/source :a x)" :modules ((:m "asl-syntax/core/source" :doc "Pure AgentSlang Source mapping, line indexing, and binar...") (:m "asl-syntax/asl/asn" :doc "Lossless ASN data view over CST preserving lexemes and N...") (:m "asl-syntax/asl/astSchema" :doc "Pure ASL generator and JSON Schema validator for ASL AST...") (:m "asl-syntax/asl/fromJson" :doc "Pure ASL JSON AST deserializer and canonical ASL seriali...") (:m "asl-syntax/asl/layout" :doc "Lossless indented ASL syntax tree with layout nodes and ...")) :moduleCount 46 :sigs ("(schema Source (:f path String) (:f bytes Bytes) (:f lineStarts I64Array) (:f hasBom Bool))" "(schema SourcePos (:f line Int64) (:f byteCol Int64) (:f charCol Int64))" "makeSource path: String bytes: Bytes lineStarts: I64Array hasBom: Bool -> Source" "sourceFromBytes path: String bs: Bytes -> Source" "sourceFromString path: String text: String -> Source" "sourcePath s: Source -> String" "sourceBytes s: Source -> Bytes" "sourceLineStarts s: Source -> I64Array" "sourceHasBom s: Source -> Bool" "sourceLength s: Source -> Int64" "sourceLineCount s: Source -> Int64") :more (sourceLineStart sourceLineEnd sourcePosAt sourceLineAt sourceByteColAt sourceCharColAt sourceOffsetAt sourceCharOffsetAt binaryKind binaryKindBytes) :moreCount 787 :effects (binaryKindFile! generateAstSchemaFromAstFile! lowerTopForm! tokenSliceBytes! benchRun! benchMedian5! copyBytes! cloneBytes!) :fails (binaryKindFile! asnRead asnReadForms parseStep cstToAsnValue nodeToAsnValue nodeToStep asnUnescape) :example none)
