(:card "asl-target-go" :purpose "Go backend: lowers a linked, verified asl-ir SSA module to one self-contained Go file (package main with func main, or a named library package with exported wrappers) and a small runtime; Int is int64 with overflow traps..." :import "(asl-target-go :a x)" :deps (asl-ir) :modules ((:m "asl-target-go" :doc "Go target entry: compileEntry! emits package main, compi...") (:m "asl-target-go/emit" :doc "SSA to Go: values are any, each function is a for loop o...") (:m "asl-target-go/runtime" :doc "The Go runtime embedded in every emitted file, generated...")) :sigs ("compileEntry! entryPath: String -> (Result String (List ty/IrDiag))" "compilePackage! pkg: String entryPath: String -> (Result String (List ty/IrDiag))" "diagText ds: (List ty/IrDiag) -> String" "goIdent prefix: String name: String -> String" "emitGoModule pkg: String m: ty/SsaModule -> (Result String (List ty/IrDiag))" "supportedBuiltins -> (List String)" "runtimeText -> String" "builtinNames -> (List String)" "entryNames -> (List String)") :effects (compileEntry! compilePackage!) :fails (compileEntry! compilePackage! emitGoModule) :example none)
(:sym "compileEntry!" :mod "asl-target-go" :sig "compileEntry! entryPath: String -> (Result String (List ty/IrDiag))" :pit (result effect))
(:sym "compilePackage!" :mod "asl-target-go" :sig "compilePackage! pkg: String entryPath: String -> (Result String (List ty/IrDiag))" :doc "Link the entry module and emit Go in the named package; exported fns get capitalised wrappers; err lists ERR_CAPABILITY_ABSENT for every builtin the runtime lacks." :pit (result effect))
(:sym "diagText" :mod "asl-target-go" :sig "diagText ds: (List ty/IrDiag) -> String")
(:sym "goIdent" :mod "asl-target-go/emit" :sig "goIdent prefix: String name: String -> String")
(:sym "emitGoModule" :mod "asl-target-go/emit" :sig "emitGoModule pkg: String m: ty/SsaModule -> (Result String (List ty/IrDiag))" :pit (result))
(:sym "supportedBuiltins" :mod "asl-target-go/emit" :sig "supportedBuiltins -> (List String)")
(:sym "runtimeText" :mod "asl-target-go/runtime" :sig "runtimeText -> String")
(:sym "builtinNames" :mod "asl-target-go/runtime" :sig "builtinNames -> (List String)")
(:sym "entryNames" :mod "asl-target-go/runtime" :sig "entryNames -> (List String)")
