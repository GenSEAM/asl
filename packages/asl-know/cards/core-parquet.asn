(:card "core/parquet" :purpose "Parquet builtins, no import" :sigs ("parquetOpen : String -> (Result ParquetHandle String)" "parquetNumRowGroups : ParquetHandle -> Int64" "parquetNumRows : ParquetHandle -> Int64" "parquetColumnType : ParquetHandle String -> String" "parquetReadF64 : ParquetHandle String Int64 -> F64Array" "parquetReadI64 : ParquetHandle String Int64 -> I64Array" "parquetReadI8 : ParquetHandle String Int64 -> I8Array" "parquetKvMetadata : ParquetHandle String -> (Result String String)") :fails (parquetOpen parquetKvMetadata) :example none)
(:sym "parquetOpen" :sig "parquetOpen : String -> (Result ParquetHandle String)" :doc "Open a Parquet file; the failure is a message." :pit (result))
(:sym "parquetNumRowGroups" :sig "parquetNumRowGroups : ParquetHandle -> Int64" :doc "Row group count.")
(:sym "parquetNumRows" :sig "parquetNumRows : ParquetHandle -> Int64" :doc "Row count.")
(:sym "parquetColumnType" :sig "parquetColumnType : ParquetHandle String -> String" :doc "The column's physical type: int64, double, int8, int32 or other. An unknown column traps.")
(:sym "parquetReadF64" :sig "parquetReadF64 : ParquetHandle String Int64 -> F64Array" :doc "A double column of one row group; a wrong type or row group traps.")
(:sym "parquetReadI64" :sig "parquetReadI64 : ParquetHandle String Int64 -> I64Array" :doc "An int64 column of one row group; a wrong type or row group traps.")
(:sym "parquetReadI8" :sig "parquetReadI8 : ParquetHandle String Int64 -> I8Array" :doc "An int8 column of one row group; a wrong type or row group traps.")
(:sym "parquetKvMetadata" :sig "parquetKvMetadata : ParquetHandle String -> (Result String String)" :doc "Look up a key in the file key-value metadata; err if absent." :pit (result))
