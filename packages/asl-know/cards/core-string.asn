(:card "core/string" :purpose "String builtins, no import" :sigs ("str : A... -> String" "stringConcat : String String -> String" "stringLength : String -> Int64" "stringLines : String -> (List String)" "stringRepeat : String Int64 -> String" "stringCountChar : String String -> Int64" "fnv1a64 : String -> Int64" "stringEmpty? : String -> Bool" "stringSlice : String Int64 Int64 -> (Option String)" "stringSliceUtf8 : String Int64 Int64 -> (Option String)" "stringIndexOf : String String -> (Option Int64)" "stringContains? : String String -> Bool" "stringStartsWith? : String String -> Bool" "stringEndsWith? : String String -> Bool") :more (stringSplit stringJoin stringUpper stringLower stringTrim stringReverse stringReplace stringChars stringFromInt64 stringFromFloat64 stringToInt64) :moreCount 1 :example "(module asl-know/examples/coreString :x [shout selfTest] :i [])\n\nfn shout s: String -> String\n  (let [(words (stringSplit (stringTrim s) \" \"))\n        (n (optionOr (stringToInt64 \"12\") 0))]\n    (str (stringUpper (stringJoin (listReverse words) \"-\")) \"!\" n (stringLength \"ab\")))")
(:sym "str" :sig "str : A... -> String" :doc "Concatenate the arguments; an Int or Float argument is rendered as text." :pit (variadic))
(:sym "stringConcat" :sig "stringConcat : String String -> String" :doc "Concatenate two strings.")
(:sym "stringLength" :sig "stringLength : String -> Int64" :doc "Length in UTF-8 bytes, so (stringLength \"héllo\") is 6.")
(:sym "stringLines" :sig "stringLines : String -> (List String)" :doc "Split on \"\\n\"; a trailing newline gives a last empty line.")
(:sym "stringRepeat" :sig "stringRepeat : String Int64 -> String" :doc "The string n times; n <= 0 gives \"\".")
(:sym "stringCountChar" :sig "stringCountChar : String String -> Int64" :doc "How many characters of the string equal the one-character second argument.")
(:sym "fnv1a64" :sig "fnv1a64 : String -> Int64" :doc "FNV-1a 64-bit hash of the string's UTF-8 bytes, as a signed Int64.")
(:sym "stringEmpty?" :sig "stringEmpty? : String -> Bool" :doc "True when the string has no bytes.")
(:sym "stringSlice" :sig "stringSlice : String Int64 Int64 -> (Option String)" :doc "Half-open byte slice, or none when out of range; a cut inside a multi-byte character splits it." :pit (option))
(:sym "stringSliceUtf8" :sig "stringSliceUtf8 : String Int64 Int64 -> (Option String)" :doc "Half-open byte slice like stringSlice, but none when out of range or when either cut point lands inside a multi-byte character; a cut on a codepoint boundary always succeeds." :pit (option))
(:sym "stringIndexOf" :sig "stringIndexOf : String String -> (Option Int64)" :doc "Byte index of the first occurrence, or none." :pit (option))
(:sym "stringContains?" :sig "stringContains? : String String -> Bool" :doc "True when the substring occurs; the empty string always occurs.")
(:sym "stringStartsWith?" :sig "stringStartsWith? : String String -> Bool" :doc "True when the string begins with the prefix.")
(:sym "stringEndsWith?" :sig "stringEndsWith? : String String -> Bool" :doc "True when the string ends with the suffix.")
(:sym "stringSplit" :sig "stringSplit : String String -> (List String)" :doc "Split on a separator. An empty separator traps.")
(:sym "stringJoin" :sig "stringJoin : (List String) String -> String" :doc "Join with a separator.")
(:sym "stringUpper" :sig "stringUpper : String -> String" :doc "Upper case for ASCII letters; other characters are unchanged.")
(:sym "stringLower" :sig "stringLower : String -> String" :doc "Lower case for ASCII letters; other characters are unchanged.")
(:sym "stringTrim" :sig "stringTrim : String -> String" :doc "Remove leading and trailing spaces, tabs, carriage returns and newlines.")
(:sym "stringReverse" :sig "stringReverse : String -> String" :doc "Reverse the UTF-8 character sequence.")
(:sym "stringReplace" :sig "stringReplace : String String String -> String" :doc "Replace every occurrence. An empty search string traps.")
(:sym "stringChars" :sig "stringChars : String -> (List String)" :doc "UTF-8 characters as one-character strings.")
(:sym "stringFromInt64" :sig "stringFromInt64 : Int64 -> String" :doc "Decimal rendering of an integer.")
(:sym "stringFromFloat64" :sig "stringFromFloat64 : Float64 -> String" :doc "Decimal rendering of a float.")
(:sym "stringToInt64" :sig "stringToInt64 : String -> (Option Int64)" :doc "Parse an optionally signed integer, or none when it is malformed or outside Int64." :pit (option))
(:sym "stringToFloat64" :sig "stringToFloat64 : String -> (Option Float64)" :doc "Parse a float (nan, inf and -inf included), or none when it is malformed." :pit (option))
