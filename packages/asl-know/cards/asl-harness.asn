(:card "asl-harness" :purpose "asl launch in ASL: harness prompt render, per-client argv and exec (port of scripts/harness/launch.py)" :import "(asl-harness/launch :a x)" :modules ((:m "asl-harness/launch" :doc "asl launch: render the harness system prompt from asl/gr...") (:m "asl-harness/collect" :doc "Session collector: finds the transcript one asl launch r...")) :sigs ("enum Asn (asnForm items: (List Asn)) (asnKw name: String) (asnSym name: String) (asnStr s: String) (asnInt text: String) (asnFloat text: Str..." "readAll text: String -> (Result (List Asn) String)" "readOne text: String -> (Result Asn String)" "asnGet v: Asn key: String -> (Option Asn)" "asnForms v: Asn head: (Option String) -> (List Asn)" "asnDump v: Asn -> String" "textOf v: Asn -> (Option String)" "pyStr o: (Option Asn) -> String" "pyStrRepr s: String -> String" "truthy v: Asn -> Bool" "formsOf o: (Option Asn) head: String what: String -> (Result (List Asn) String)") :more (formOr Paths pathsFor runnerDisplay! Layer Attractor Harness Client Loaded loadSources Probe factsOf gitState migrateOn RenderOpts render hostPaths fillText) :moreCount 29 :effects (runnerDisplay! writePrompt! freeze mainWith! runCapture! whichIn! probe! platform!) :fails (readAll readOne formsOf formOr render buildArgv writePrompt! freeze) :example none)
(:sym "Asn" :mod "asl-harness/launch" :kind type :sig "enum Asn (asnForm items: (List Asn)) (asnKw name: String) (asnSym name: String) (asnStr s: String) (asnInt text: String) (asnFloat text: String)")
(:sym "asnForm" :mod "asl-harness/launch" :kind ctor :sig "(asnForm items: (List Asn)) of Asn" :pit (ctor))
(:sym "asnKw" :mod "asl-harness/launch" :kind ctor :sig "(asnKw name: String) of Asn" :pit (ctor))
(:sym "asnSym" :mod "asl-harness/launch" :kind ctor :sig "(asnSym name: String) of Asn" :pit (ctor))
(:sym "asnStr" :mod "asl-harness/launch" :kind ctor :sig "(asnStr s: String) of Asn" :pit (ctor))
(:sym "asnInt" :mod "asl-harness/launch" :kind ctor :sig "(asnInt text: String) of Asn" :pit (ctor))
(:sym "asnFloat" :mod "asl-harness/launch" :kind ctor :sig "(asnFloat text: String) of Asn" :pit (ctor))
(:sym "readAll" :mod "asl-harness/launch" :sig "readAll text: String -> (Result (List Asn) String)" :doc "asn.read_all: every top-level value" :pit (result))
(:sym "readOne" :mod "asl-harness/launch" :sig "readOne text: String -> (Result Asn String)" :doc "asn.read_one: exactly one form" :pit (result))
(:sym "asnGet" :mod "asl-harness/launch" :sig "asnGet v: Asn key: String -> (Option Asn)" :doc "Form.get: the last :key wins" :pit (option))
(:sym "asnForms" :mod "asl-harness/launch" :sig "asnForms v: Asn head: (Option String) -> (List Asn)" :doc "Form.forms: child forms by head")
(:sym "asnDump" :mod "asl-harness/launch" :sig "asnDump v: Asn -> String")
(:sym "textOf" :mod "asl-harness/launch" :sig "textOf v: Asn -> (Option String)" :doc "str content, as isinstance(x, str) sees it" :pit (option))
(:sym "pyStr" :mod "asl-harness/launch" :sig "pyStr o: (Option Asn) -> String" :doc "str(value), None when absent")
(:sym "pyStrRepr" :mod "asl-harness/launch" :sig "pyStrRepr s: String -> String" :doc "repr(str) for error messages")
(:sym "truthy" :mod "asl-harness/launch" :sig "truthy v: Asn -> Bool")
(:sym "formsOf" :mod "asl-harness/launch" :sig "formsOf o: (Option Asn) head: String what: String -> (Result (List Asn) String)" :doc "x or Form(), then .forms(head)" :pit (result))
(:sym "formOr" :mod "asl-harness/launch" :sig "formOr o: (Option Asn) what: String -> (Result Asn String)" :pit (result))
(:sym "Paths" :mod "asl-harness/launch" :kind type :sig "(schema Paths (:f harness String) (:f clients String) (:f tools String) (:f host String))" :pit (record))
(:sym "pathsFor" :mod "asl-harness/launch" :sig "pathsFor root: String host: String -> Paths")
(:sym "runnerDisplay!" :mod "asl-harness/launch" :kind fn! :sig "runnerDisplay! root: String -> String" :pit (effect))
(:sym "Layer" :mod "asl-harness/launch" :kind type :sig "(schema Layer (:f id String) (:f cond (Option (List String))) (:f text (Option String)) (:f src (Option String)))" :pit (record))
(:sym "Attractor" :mod "asl-harness/launch" :kind type :sig "(schema Attractor (:f goal String) (:f shadow String))" :pit (record))
(:sym "Harness" :mod "asl-harness/launch" :kind type :sig "(schema Harness (:f layers (List Layer)) (:f intro (Result String String)) (:f items (List (Pair String Attractor))) (:f modes (List (Pair String (List String)))))" :pit (record))
(:sym "Client" :mod "asl-harness/launch" :kind type :sig "(schema Client (:f id String) (:f fields (List (Pair String Asn))))" :pit (record))
(:sym "Loaded" :mod "asl-harness/launch" :kind type :sig "(schema Loaded (:f paths Paths) (:f harness (Result Harness String)) (:f clients (Result (List Client) String)) (:f tools (Result Asn String)))" :pit (record))
(:sym "loadSources" :mod "asl-harness/launch" :sig "loadSources paths: Paths harness: String clients: String tools: String -> Loaded")
(:sym "Probe" :mod "asl-harness/launch" :kind type :sig "(schema Probe (:f root String) (:f branch String) (:f rules Bool) (:f aslSrc Bool) (:f migrate Bool) (:f asl (Option String)) (:f session Bool))" :pit (record))
(:sym "factsOf" :mod "asl-harness/launch" :sig "factsOf clients: (List Client) client: String mode: String once: Bool p: Probe -> (List (Pair String Bool))")
(:sym "gitState" :mod "asl-harness/launch" :sig "gitState p: Probe -> String")
(:sym "migrateOn" :mod "asl-harness/launch" :sig "migrateOn text: String -> Bool" :doc "re.search(r':migrate\\s+true\\b')")
(:sym "RenderOpts" :mod "asl-harness/launch" :kind type :sig "(schema RenderOpts (:f cwd String) (:f client String) (:f mode String) (:f core Bool) (:f promptDir (Option String)) (:f drop (List String)) (:f only (List String)) (:f fills (List (Pair String String))) (:f once Bool) (:f platform String) (:f date String))" :pit (record))
(:sym "render" :mod "asl-harness/launch" :sig "render loaded: Loaded p: Probe o: RenderOpts -> (Result String String)" :doc "launch.render: the prompt for one client" :pit (result))
(:sym "hostPaths" :mod "asl-harness/launch" :sig "hostPaths text: String host: String -> String" :doc "asl-host is off PATH outside the repo")
(:sym "fillText" :mod "asl-harness/launch" :sig "fillText text: String fill: (List (Pair String String)) -> String" :doc "re.sub(r'\\{(\\w+)\\}') over the fill table")
(:sym "buildArgv" :mod "asl-harness/launch" :sig "buildArgv clients: (List Client) cpath: String client: String exe: (Option String) promptPath: String extraDir: String lean: Bool extra: (List String) coord: Bool cwd: String base: String ask: Bool shellOnly: Bool -> (Result (List String) S ..." :doc "launch.build_argv per client and flags" :pit (result))
(:sym "jsonStr" :mod "asl-harness/launch" :sig "jsonStr s: String -> String" :doc "json.dumps of a string, ensure_ascii")
(:sym "absPath" :mod "asl-harness/launch" :sig "absPath p: String base: String -> String" :doc "os.path.abspath against a given cwd")
(:sym "pathJoin" :mod "asl-harness/launch" :sig "pathJoin a: String b: String -> String" :doc "posixpath.join of two parts")
(:sym "writePrompt!" :mod "asl-harness/launch" :kind fn! :sig "writePrompt! loaded: Loaded client: String prompt: String runDir: String bare: Bool shellOnly: Bool -> (Result (Pair String String) String)" :doc "launch.write_prompt; extra dir empty for claude and codex" :pit (result effect))
(:sym "Outcome" :mod "asl-harness/launch" :kind type :sig "(schema Outcome (:f exit Int64) (:f out String) (:f errText String) (:f action String) (:f argv (List String)) (:f launched String))" :pit (record))
(:sym "Ctx" :mod "asl-harness/launch" :kind type :sig "(schema Ctx (:f cwd String) (:f runDir String) (:f probe Probe) (:f exes (List (Pair String String))) (:f platform String) (:f date String) (:f fills (List (Pair String String))))" :pit (record))
(:sym "freeze" :mod "asl-harness/launch" :kind fn! :sig "freeze loaded: Loaded -> (Result String String)" :pit (result effect))
(:sym "mainWith!" :mod "asl-harness/launch" :kind fn! :sig "mainWith! loaded: Loaded ctx: Ctx args: (List String) -> Outcome" :doc "launch.main with gathered context" :pit (effect))
(:sym "usageText" :mod "asl-harness/launch" :sig "usageText -> String")
(:sym "Captured" :mod "asl-harness/launch" :kind type :sig "(schema Captured (:f code Int64) (:f out String) (:f errText String))" :pit (record))
(:sym "runCapture!" :mod "asl-harness/launch" :kind fn! :sig "runCapture! argv: (List String) cwd: (Option String) env: (Option (List String)) -> (Result Captured String)" :doc "argv child captured; a missing tool errs" :pit (result effect))
(:sym "whichIn!" :mod "asl-harness/launch" :kind fn! :sig "whichIn! pathVar: (Option String) name: String -> (Option String)" :doc "shutil.which over a PATH value" :pit (option effect))
(:sym "probe!" :mod "asl-harness/launch" :kind fn! :sig "probe! cwd: String -> (Result Probe String)" :doc "workspace facts read from git and files" :pit (result effect))
(:sym "platform!" :mod "asl-harness/launch" :kind fn! :sig "platform! -> (Result String String)" :doc "platform.system release machine" :pit (result effect))
(:sym "today!" :mod "asl-harness/launch" :kind fn! :sig "today! -> (Result String String)" :doc "datetime.date.today in local time" :pit (result effect))
(:sym "pruneRunDirs!" :mod "asl-harness/launch" :kind fn! :sig "pruneRunDirs! runRoot: String -> (Result Unit String)" :doc "a dead launch leaves its prompt dir" :pit (result effect))
(:sym "runChild!" :mod "asl-harness/launch" :kind fn! :sig "runChild! argv: (List String) env: (List String) -> Int64" :doc "agy exits 0 on a run without output" :pit (effect))
(:sym "mainIn!" :mod "asl-harness/launch" :kind fn! :sig "mainIn! root: String args: (List String) -> (Result Int64 String)" :doc "mainIn! takes the repository root as an argument, for a caller (the native asl binary) that cannot export ASL_ROOT into its own environment" :pit (result effect))
(:sym "Scan" :mod "asl-harness/collect" :kind type :sig "(schema Scan (:f turns Int64) (:f tokIn Int64) (:f tokOut Int64) (:f tokCached Int64) (:f tools (Map String Int64)) (:f errors (Map String Int64)))" :doc "counts of one transcript: turns, tokIn (uncached input), tokOut, tokCached, tools and errors by name" :pit (record))
(:sym "scanClaude" :mod "asl-harness/collect" :sig "scanClaude text: String -> Scan" :doc "claude jsonl: turns = distinct assistant message ids, usage kept per id (last record wins), in = input + cache creation, tool_use by name, is_error tool_results and isApiErrorMessage as errors")
(:sym "scanCodex" :mod "asl-harness/collect" :sig "scanCodex text: String -> Scan" :doc "codex rollout jsonl: turns = token_usage_record lines (token_count lines if none), tokens from the last token_count total (input minus cached), function_call and custom_tool_call by name, error events")
(:sym "scanAgy" :mod "asl-harness/collect" :sig "scanAgy text: String -> Scan" :doc "agy transcript.jsonl: PLANNER_RESPONSE steps are turns and carry input, cache_read and output tokens and tool_calls; a status other than DONE counts as step<STATUS>")
(:sym "isoEpoch" :mod "asl-harness/collect" :sig "isoEpoch s: String -> Int64" :doc "UTC epoch seconds of a YYYY-MM-DDTHH:MM:SS prefix, 0 when malformed")
(:sym "epochDays" :mod "asl-harness/collect" :sig "epochDays secs: Int64 -> String" :doc "UTC date of epoch seconds as YYYY/MM/DD, the codex sessions subdirectory")
(:sym "slugOf" :mod "asl-harness/collect" :sig "slugOf cwd: String -> String" :doc "claude project directory name of a cwd: every non-alphanumeric character becomes a dash")
(:sym "receiptText" :mod "asl-harness/collect" :sig "receiptText client: String runDir: String digest: String startedAt: Int64 exit: Int64 path: String sc: Scan -> String" :doc "the (:launchRun ...) receipt line for a matched transcript; counts and paths only, no message text")
(:sym "pickTranscript!" :mod "asl-harness/collect" :kind fn! :sig "pickTranscript! client: String home: String startedAt: Int64 cwd: String -> (Result String String)" :doc "the single transcript of a client written since startedAt whose first event is not earlier than startedAt - 5s; err with the reason when none or several match" :pit (result effect))
(:sym "collect!" :mod "asl-harness/collect" :kind fn! :sig "collect! client: String home: String runDir: String startedAt: Int64 cwd: String exit: Int64 digest: String -> (Result String String)" :doc "pick, scan and write <runDir>/run.asn, returns its path; no or ambiguous transcript writes (:transcript :none :why ...)" :pit (result effect))
