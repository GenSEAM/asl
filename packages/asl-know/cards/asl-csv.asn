(:card "asl-csv" :purpose "Pure AgentSlang RFC 4180 CSV row reader and typed numeric column parser" :import "(asl-csv/csv :a x)" :modules ((:m "asl-csv/csv" :doc "Pure ASL RFC 4180 CSV row reader and typed numeric colum...") (:m "asl-csv/csvWrite")) :sigs ("(schema CsvTable (:f rows I64) (:f types (List Str)) (:f rawRows (List (List Str))))" "csvParseRows text: String -> (Result (List (List String)) String)" "csvParseColumns typeSpec: String text: String -> (Result CsvTable String)" "csvNumRows table: CsvTable -> Int64" "csvColumnF64 table: CsvTable col: Int64 -> (Result F64Array String)" "csvColumnI64 table: CsvTable col: Int64 -> (Result I64Array String)" "csvColumnI8 table: CsvTable col: Int64 -> (Result I8Array String)" "csvField s: String -> String" "csvRow fields: (List String) -> String" "csvFormat rows: (List (List String)) -> String") :fails (csvParseRows csvParseColumns csvColumnF64 csvColumnI64 csvColumnI8) :example "(module asl-know/examples/aslCsv :x [cell selfTest] :i [(asl-csv/csv :a csv)])\n\nfn cell text: String row: Int64 col: Int64 -> String\n  (match (csv/csvParseRows text)\n    ((err _) \"\")\n    ((ok rows) (optionOr (listGet (optionOr (listGet rows row) []) col) \"\")))")
(:sym "CsvTable" :mod "asl-csv/csv" :kind type :sig "(schema CsvTable (:f rows I64) (:f types (List Str)) (:f rawRows (List (List Str))))" :pit (record))
(:sym "csvParseRows" :mod "asl-csv/csv" :sig "csvParseRows text: String -> (Result (List (List String)) String)" :pit (result))
(:sym "csvParseColumns" :mod "asl-csv/csv" :sig "csvParseColumns typeSpec: String text: String -> (Result CsvTable String)" :pit (result))
(:sym "csvNumRows" :mod "asl-csv/csv" :sig "csvNumRows table: CsvTable -> Int64")
(:sym "csvColumnF64" :mod "asl-csv/csv" :sig "csvColumnF64 table: CsvTable col: Int64 -> (Result F64Array String)" :pit (result))
(:sym "csvColumnI64" :mod "asl-csv/csv" :sig "csvColumnI64 table: CsvTable col: Int64 -> (Result I64Array String)" :pit (result))
(:sym "csvColumnI8" :mod "asl-csv/csv" :sig "csvColumnI8 table: CsvTable col: Int64 -> (Result I8Array String)" :pit (result))
(:sym "csvField" :mod "asl-csv/csvWrite" :sig "csvField s: String -> String" :doc "Quote a single CSV field per RFC 4180: wraps in double quotes when the field contains comma, quote, CR, LF or leading/trailing space, doubling embedded quotes.")
(:sym "csvRow" :mod "asl-csv/csvWrite" :sig "csvRow fields: (List String) -> String" :doc "Join a list of field strings into one comma-separated CSV row, quoting each field via csvField.")
(:sym "csvFormat" :mod "asl-csv/csvWrite" :sig "csvFormat rows: (List (List String)) -> String" :doc "Render a list of rows into a CSV document with LF line endings and a trailing LF; returns empty string for no rows.")
