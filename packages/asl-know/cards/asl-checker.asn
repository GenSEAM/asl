(:card "asl-checker" :purpose "100% Self-Hosted Pure AgentSlang Semantic Type Checker" :import "(asl-checker/check :a x)" :deps (asl-parser asl-proc) :modules ((:m "asl-checker/check" :doc "Pass 3 Hindley-Milner Type Inference and Unified Checker...") (:m "asl-checker/checkCached") (:m "asl-checker/claims" :doc "Pure AgentSlang automated claim grounder, citation linke...") (:m "asl-checker/constAssert") (:m "asl-checker/exhaustive" :doc "Pure AgentSlang Compile-Time Exhaustive Pattern Matching...")) :moduleCount 10 :sigs ("(schema InferState (:f subst (Map Int64 ty/Type)) (:f nextVar Int64) (:f intSites (List (pair String Int64))) (:f mapSites (List (pair ty/Ty..." "(schema Deferred (:f name String) (:f recv ty/Type) (:f args (List ty/Type)) (:f result ty/Type))" "checkModule forms: (List a/TopForm) deps: (Map String r/ModuleSummary) path: String -> (List ty/Diagnostic)" "checkModuleIn forms: (List a/TopForm) deps: r/DepIndex path: String -> (List ty/Diagnostic)" "checkModuleSource forms: (List a/TopForm) deps: (Map String r/ModuleSummary) path: String src: String -> (List ty/Diagnostic)") :more (checkSource checkFile! schemaOfCtor Cache emptyCache Verdict checkFileCached! ClaimCitation GroundedReceipt makeCitation makeReceipt extractClaimsFromRegistry) :moreCount 107 :effects (checkFile! checkFileCached! groundClaims! loadModuleDeps! loadModuleDepsFrom! loadModuleClosure! resolveImport!) :fails (checkFile! verifyClaimsGrounding groundClaims! loadModuleDeps! resolveDepTarget resolveDepIn) :example none)
(:sym "InferState" :mod "asl-checker/check" :kind type :sig "(schema InferState (:f subst (Map Int64 ty/Type)) (:f nextVar Int64) (:f intSites (List (pair String Int64))) (:f mapSites (List (pair ty/Type String))) (:f diags (List ty/Diagnostic)) (:f deferred (List Deferred)))" :pit (record))
(:sym "Deferred" :mod "asl-checker/check" :kind type :sig "(schema Deferred (:f name String) (:f recv ty/Type) (:f args (List ty/Type)) (:f result ty/Type))" :pit (record))
(:sym "checkModule" :mod "asl-checker/check" :sig "checkModule forms: (List a/TopForm) deps: (Map String r/ModuleSummary) path: String -> (List ty/Diagnostic)" :doc "Raw checker diagnostics for parsed forms, retaining resolver rule codes and documentation/type-name diagnostics. CHECKER-A: one DepIndex per check; every dep lookup in this module reads its bucket instead of rescanning the deps map")
(:sym "checkModuleIn" :mod "asl-checker/check" :sig "checkModuleIn forms: (List a/TopForm) deps: r/DepIndex path: String -> (List ty/Diagnostic)" :doc "checkModule over a DepIndex the caller built (r/depIndexOf): every former resolveDepTarget site reads its bucket through r/resolveDepIn instead of rescanning the deps map; exported so a caller checking many modules against one deps map buil...")
(:sym "checkModuleSource" :mod "asl-checker/check" :sig "checkModuleSource forms: (List a/TopForm) deps: (Map String r/ModuleSummary) path: String src: String -> (List ty/Diagnostic)" :doc "Host-facing file-check diagnostics: normalized codes and lint filtering. Untyped parameters come from parsed function nodes.")
(:sym "checkSource" :mod "asl-checker/check" :sig "checkSource src: String deps: (Map String r/ModuleSummary) path: String -> (List ty/Diagnostic)" :doc "Parse source and return raw checker rule diagnostics against dependencies; checkFile! exposes normalized host-check diagnostics.")
(:sym "checkFile!" :mod "asl-checker/check" :kind fn! :sig "checkFile! path: String roots: (List String) -> (Result (List ty/Diagnostic) String)" :doc "Read, parse and check a file, loading its imports from the roots." :pit (result effect))
(:sym "schemaOfCtor" :mod "asl-checker/check" :sig "schemaOfCtor head: String mod: r/ModuleSummary deps: (Map String r/ModuleSummary) -> (Option (Pair r/SchemaSummary r/ModuleSummary))" :doc "The schema and defining module of constructor head, none if unexported or undefined." :pit (option))
(:sym "Cache" :mod "asl-checker/checkCached" :kind type :sig "(schema Cache (:f index r/ModIndex))" :pit (record))
(:sym "emptyCache" :mod "asl-checker/checkCached" :sig "emptyCache -> Cache")
(:sym "Verdict" :mod "asl-checker/checkCached" :kind type :sig "(schema Verdict (:f diags (List ty/Diagnostic)) (:f moduleCount Int64))" :pit (record))
(:sym "checkFileCached!" :mod "asl-checker/checkCached" :kind fn! :sig "checkFileCached! path: String roots: (List String) cache: Cache -> (Pair (Result Verdict String) Cache)" :pit (effect))
(:sym "ClaimCitation" :mod "asl-checker/claims" :kind type :sig "(schema ClaimCitation (:f metric Str) (:f category Str) (:f source Str) (:f citation Str) (:f isGrounded Bool))" :pit (record))
(:sym "GroundedReceipt" :mod "asl-checker/claims" :kind type :sig "(schema GroundedReceipt (:f claimId Str) (:f metric Str) (:f receiptSource Str) (:f executedAsserts Int64) (:f verifiedDate Str))" :pit (record))
(:sym "makeCitation" :mod "asl-checker/claims" :sig "makeCitation metric: Str category: Str source: Str citation: Str isGrounded: Bool -> ClaimCitation")
(:sym "makeReceipt" :mod "asl-checker/claims" :sig "makeReceipt claimId: Str metric: Str receiptSource: Str executedAsserts: Int64 verifiedDate: Str -> GroundedReceipt")
(:sym "extractClaimsFromRegistry" :mod "asl-checker/claims" :sig "extractClaimsFromRegistry registryContent: Str -> (List ClaimCitation)")
(:sym "extractField" :mod "asl-checker/claims" :sig "extractField text: Str fieldKey: Str -> Str")
(:sym "matchClaimToReceipt" :mod "asl-checker/claims" :sig "matchClaimToReceipt claim: ClaimCitation receipts: (List GroundedReceipt) -> Bool")
(:sym "refuteUnbackedClaims" :mod "asl-checker/claims" :sig "refuteUnbackedClaims claims: (List ClaimCitation) receipts: (List GroundedReceipt) -> (List ClaimCitation)")
(:sym "verifyClaimsGrounding" :mod "asl-checker/claims" :sig "verifyClaimsGrounding claims: (List ClaimCitation) receipts: (List GroundedReceipt) -> (Result Int64 Str)" :pit (result))
(:sym "groundClaims!" :mod "asl-checker/claims" :sig "groundClaims! registryPath: Str -> (Result (List ClaimCitation) Str)" :pit (result effect))
(:sym "constantAssertDiags" :mod "asl-checker/constAssert" :sig "constantAssertDiags forms: (List a/TopForm) src: String path: String -> (List ty/Diagnostic)")
(:sym "foldsToConstant?" :mod "asl-checker/constAssert" :sig "foldsToConstant? e: rd/SExpr env: (Map String Bool) funs: (List String) -> Bool")
(:sym "hostSubjectFns" :mod "asl-checker/constAssert" :sig "hostSubjectFns src: String -> (List String)")
(:sym "ExhaustiveReport" :mod "asl-checker/exhaustive" :kind type :sig "(schema ExhaustiveReport (:f isExhaustive Bool) (:f missingVariants (List String)) (:f hasWildcard Bool) (:f diagnostic String))" :pit (record))
(:sym "makeExhaustiveReport" :mod "asl-checker/exhaustive" :sig "makeExhaustiveReport isExhaustive: Bool missing: (List String) hasWildcard: Bool diag: String -> ExhaustiveReport" :doc "Build an ExhaustiveReport.")
(:sym "checkMatchExhaustiveness" :mod "asl-checker/exhaustive" :sig "checkMatchExhaustiveness allVariants: (List String) coveredArms: (List String) hasWildcard: Bool -> ExhaustiveReport" :doc "Report the variants no arm covers; a wildcard arm covers all.")
(:sym "isArmCovered?" :mod "asl-checker/exhaustive" :sig "isArmCovered? covered: (List String) variant: String -> Bool" :doc "True if an arm already covers the variant.")
(:sym "LintHit" :mod "asl-checker/lint" :kind type :sig "(schema LintHit (:f code String) (:f fnName String) (:f message String) (:f line Int64) (:f col Int64) (:f path String))" :doc "One lint finding: a stable code, the offending fn name, a human message with a suggested rewrite, and a position (the fn's first body form, like untypedParamDiags)." :pit (record))
(:sym "lintModule" :mod "asl-checker/lint" :sig "lintModule forms: (List a/TopForm) path: String -> (List LintHit)" :doc "Every LINT_QUADRATIC_LISTGET hit across a module's top-level defuns, in source order.")
(:sym "quadraticListGetHit?" :mod "asl-checker/lint" :sig "quadraticListGetHit? d: a/DefunNode -> Bool" :doc "QUAD-LISTGET idiom: a defun with an Int-typed parameter, a self-recursive call anywhere in its body (the loop step) and a (listGet list counter) call indexed by that same parameter anywhere in its body; matches the qualifyTypesStep-shaped p...")
(:sym "FunSummary" :mod "asl-checker/resolve" :kind type :sig "(schema FunSummary (:f name String) (:f params (List (pair String String))) (:f ret String) (:f typevars (List String)) (:f hasDoc Bool) (:f effect Bool) (:f calls (List String)) (:f witness String))" :pit (record))
(:sym "SchemaSummary" :mod "asl-checker/resolve" :kind type :sig "(schema SchemaSummary (:f name String) (:f typevars (List String)) (:f fields (List FieldSummary)))" :pit (record))
(:sym "EnumSummary" :mod "asl-checker/resolve" :kind type :sig "(schema EnumSummary (:f name String) (:f typevars (List String)) (:f cases (List CaseSummary)))" :pit (record))
(:sym "CaseSummary" :mod "asl-checker/resolve" :kind type :sig "(schema CaseSummary (:f name String) (:f params (List (pair String String))))" :pit (record))
(:sym "FieldSummary" :mod "asl-checker/resolve" :kind type :sig "(schema FieldSummary (:f name String) (:f type String) (:f hasDefault Bool))" :pit (record))
(:sym "ModuleSummary" :mod "asl-checker/resolve" :kind type :sig "(schema ModuleSummary (:f name String) (:f path String) (:f hasHeader Bool) (:f hasDoc Bool) (:f exports (List String)) (:f exportedTypes (List String)) (:f imports (Map String String)) (:f funs (Map String FunSummary)) (:f schemas (Map String SchemaSummary)) (:f enums (Map String EnumSummary)) (:f  ..." :pit (record))
(:sym "emptyModuleSummary" :mod "asl-checker/resolve" :sig "emptyModuleSummary -> ModuleSummary" :doc "A ModuleSummary with no name, exports or declarations.")
(:sym "bodyPosAt" :mod "asl-checker/resolve" :sig "bodyPosAt d: a/DefunNode idx: Int64 -> (Pair Int64 Int64)" :doc "Line and column of body form idx of a function, 1:1 when the parser gave none.")
(:sym "placeDiags" :mod "asl-checker/resolve" :sig "placeDiags ds: (List ty/Diagnostic) pos: (Pair Int64 Int64) -> (List ty/Diagnostic)" :doc "The diagnostics moved to a source position.")
(:sym "cleanNumSign" :mod "asl-checker/resolve" :sig "cleanNumSign v: String -> String" :doc "A numeric token without its leading sign.")
(:sym "collectSummary" :mod "asl-checker/resolve" :sig "collectSummary forms: (List a/TopForm) path: String -> ModuleSummary" :doc "The module summary of parsed forms: header, exports, imports, functions, schemas and enums.")
(:sym "checkTypeTree" :mod "asl-checker/resolve" :sig "checkTypeTree t: ty/Type bound: (Map String Bool) mod: ModuleSummary deps: (Map String ModuleSummary) where: String path: String acc: (List ty/Diagnostic) -> (List ty/Diagnostic)" :doc "Validate unqualified imported schema and enum names before falling back to local and builtin type checks.")
(:sym "dottedTypeTree" :mod "asl-checker/resolve" :sig "dottedTypeTree t: ty/Type where: String path: String acc: (List ty/Diagnostic) -> (List ty/Diagnostic)")
(:sym "listToSet" :mod "asl-checker/resolve" :sig "listToSet xs: (List String) -> (Map String Bool)" :doc "A list of names as a presence-only set, the shape checkTypeTree's bound parameter wants.")
(:sym "firstCharStr" :mod "asl-checker/resolve" :sig "firstCharStr s: String -> String" :doc "The first byte of a string, empty for an empty string.")
(:sym "firstExprEmpty" :mod "asl-checker/resolve" :sig "firstExprEmpty l: (List rd/SExpr) -> rd/SExpr" :doc "The first expression, or an empty atom.")
(:sym "firstExprUnit" :mod "asl-checker/resolve" :sig "firstExprUnit l: (List rd/SExpr) -> rd/SExpr" :doc "The first expression, or the unit atom ().")
(:sym "firstExprVect" :mod "asl-checker/resolve" :sig "firstExprVect l: (List rd/SExpr) -> rd/SExpr" :doc "The first expression, or an empty vector.")
(:sym "firstHeadIdent" :mod "asl-checker/resolve" :sig "firstHeadIdent l: (List rd/SExpr) -> String" :doc "The head identifier of the first expression.")
(:sym "firstVectItems" :mod "asl-checker/resolve" :sig "firstVectItems l: (List rd/SExpr) -> (List rd/SExpr)" :doc "Items of the leading binding vector, whether written [ ] or as the (list ...) the fn-dialect parser produces.")
(:sym "isLiteralAtom?" :mod "asl-checker/resolve" :sig "isLiteralAtom? v: String -> Bool" :doc "True for string, boolean, unit and numeric atoms. CHECK-PARITY-B: nil is no literal in the host, which reports it as an unknown symbol (Task54706)")
(:sym "listAppendOne" :mod "asl-checker/resolve" :sig "listAppendOne xs: (List T) x: T -> (List T)" :doc "xs with x appended.")
(:sym "loadModuleDeps!" :mod "asl-checker/resolve" :kind fn! :sig "loadModuleDeps! roots: (List String) imports: (List String) -> (Result (Map String ModuleSummary) String)" :doc "the caller knows no importer, so each root in turn stands in for the entry's directory: pass that directory first Summaries of the given imports and their closure, keyed by real path and by import path; err, after the lines on stderr, when ..." :pit (result effect))
(:sym "loadModuleDepsFrom!" :mod "asl-checker/resolve" :kind fn! :sig "loadModuleDepsFrom! roots: (List String) imports: (List String) seedDeps: (Map String ModuleSummary) seedIndex: ModIndex -> ModuleClosure" :pit (effect))
(:sym "loadModuleClosure!" :mod "asl-checker/resolve" :kind fn! :sig "loadModuleClosure! entry: String parseBodies: Bool -> ModuleClosure" :doc "Load the entry file and every module it imports, transitively." :pit (effect))
(:sym "parentDirOf" :mod "asl-checker/resolve" :sig "parentDirOf p: String -> String" :doc "The directory part of a path, / for a top-level path, . for a slashless one.")
(:sym "resolveImport!" :mod "asl-checker/resolve" :kind fn! :sig "resolveImport! importer: String imp: String ix: ModIndex -> Resolution" :doc "Resolve one import path from an importing file, the way the host loader does." :pit (effect))
(:sym "emptyModIndex" :mod "asl-checker/resolve" :sig "emptyModIndex -> ModIndex" :doc "A module index not yet built for any root.")
(:sym "ModIndex" :mod "asl-checker/resolve" :kind type :sig "(schema ModIndex (:f root String) (:f mods (List IdxMod)) (:f pkgs (List IdxPkg)) (:f skipped Int64) (:f skippedAt String) (:f workspaces (Map String String)))" :pit (record))
(:sym "Resolution" :mod "asl-checker/resolve" :kind type :sig "(schema Resolution (:f status ResStatus) (:f path String) (:f note String) (:f index ModIndex))" :pit (record))
(:sym "ResStatus" :mod "asl-checker/resolve" :kind type :sig "(enum ResStatus (:c resOk [] \"Exactly one candidate module\") (:c resAmbiguous [] \"Several candidate modules\") (:c resMissing [] \"No candidate module\"))")
(:sym "ModuleClosure" :mod "asl-checker/resolve" :kind type :sig "(schema ModuleClosure (:f deps (Map String ModuleSummary)) (:f paths (List String)) (:f unresolved (List String)) (:f errors (List String)) (:f index ModIndex))" :pit (record))
(:sym "mapValuesList" :mod "asl-checker/resolve" :sig "mapValuesList m: (Map String String) -> (List String)" :doc "The values of a string map.")
(:sym "modEnum" :mod "asl-checker/resolve" :sig "modEnum m: ModuleSummary name: String -> (Option EnumSummary)" :doc "The enum summary named name in m." :pit (option))
(:sym "modFun" :mod "asl-checker/resolve" :sig "modFun m: ModuleSummary name: String -> (Option FunSummary)" :doc "The function summary named name in m." :pit (option))
(:sym "modImport" :mod "asl-checker/resolve" :sig "modImport m: ModuleSummary alias: String -> (Option String)" :doc "The import path bound to alias in m." :pit (option))
(:sym "matchFamily" :mod "asl-checker/resolve" :sig "matchFamily arms: (List rd/SExpr) mod: ModuleSummary deps: (Map String ModuleSummary) -> String" :doc "The union an mt tests: its first (case ...) pattern's, else its first bare case name's; empty when no arm names a case. The host's matchFamily (compile.c) decides the same way.")
(:sym "ctorPatternAtom?" :mod "asl-checker/resolve" :sig "ctorPatternAtom? pat: rd/SExpr family: String mod: ModuleSummary deps: (Map String ModuleSummary) -> Bool" :doc "A bare pattern name tests the tag only when it names a case of the match's union; any other name, a case of another union included, binds the subject.")
(:sym "unreachableArmDiags" :mod "asl-checker/resolve" :sig "unreachableArmDiags arms: (List rd/SExpr) family: String mod: ModuleSummary deps: (Map String ModuleSummary) path: String seenCatchall: Bool -> (List ty/Diagnostic)" :doc "Every arm after a catch-all binder arm, or _/else, can never run (compile.c's matchForm and types.c's matchT both stop compiling/checking there): a diagnostic per unreachable arm, where base silently dropped them with no diagnostic at all (...")
(:sym "modSchema" :mod "asl-checker/resolve" :sig "modSchema m: ModuleSummary name: String -> (Option SchemaSummary)" :doc "The schema summary named name in m." :pit (option))
(:sym "builtinSchemaFieldTypes" :mod "asl-checker/resolve" :sig "builtinSchemaFieldTypes name: String -> (Option (List (Pair String String)))" :pit (option))
(:sym "builtinRecordNames" :mod "asl-checker/resolve" :sig "builtinRecordNames -> (List String)")
(:sym "builtinFieldNameList" :mod "asl-checker/resolve" :sig "builtinFieldNameList -> (List String)")
(:sym "resolveDepTarget" :mod "asl-checker/resolve" :sig "resolveDepTarget mpath: String deps: (Map String ModuleSummary) -> (Result ModuleSummary String)" :doc "Find a dependency ModuleSummary in deps by real path, declared module name, or import suffix. Ambiguous matches are rejected with ERR_AMBIGUOUS_MODULE." :pit (result))
(:sym "resolveDepIn" :mod "asl-checker/resolve" :sig "resolveDepIn mpath: String ix: DepIndex -> (Result ModuleSummary String)" :doc "Resolves mpath to one dep through the index (deduplicated bucket, then the scan's pick), ERR_NOT_FOUND for an empty path; an unindexed DepIndex falls back to resolveDepTarget's scan." :pit (result))
(:sym "depCandidates" :mod "asl-checker/resolve" :sig "depCandidates mpath: String ix: DepIndex -> (List ModuleSummary)" :doc "DEP-INDEX: an indexed lookup reads one bucket instead of scanning every dep; an unindexed one (depScanOf, for callers passing a bare deps map) is the scan")
(:sym "depIndexOf" :mod "asl-checker/resolve" :sig "depIndexOf deps: (Map String ModuleSummary) -> DepIndex" :doc "buckets keep the order of mapValues deps, so a bucket is exactly the sublist the scan filters and deduplicateSummaries returns the same list")
(:sym "depScanOf" :mod "asl-checker/resolve" :sig "depScanOf deps: (Map String ModuleSummary) -> DepIndex" :doc "An unindexed DepIndex over deps, for callers that pass a bare deps map; resolveModuleIn rejects it.")
(:sym "DepIndex" :mod "asl-checker/resolve" :kind type :sig "(schema DepIndex (:f deps (Map String ModuleSummary)) (:f byKey (Map String (List ModuleSummary))) (:f indexed Bool))" :doc "DEP-INDEX: a module's deps map with, when indexed, a bucket per lookup key (each dep under its name, path, name tails and path tails) so a resolver lookup reads one bucket; unindexed it is the bare map, scanned." :pit (record))
(:sym "resolveModule" :mod "asl-checker/resolve" :sig "resolveModule mod: ModuleSummary forms: (List a/TopForm) deps: (Map String ModuleSummary) -> (List ty/Diagnostic)" :doc "Pass 1 and 2 diagnostics: reserved names, module rules, imports and cycles, export closure, type annotations and body resolution.")
(:sym "resolveModuleIn" :mod "asl-checker/resolve" :sig "resolveModuleIn mod: ModuleSummary forms: (List a/TopForm) deps: DepIndex -> (List ty/Diagnostic)" :doc "DEP-INDEX-GATE: a whole module makes Q lookups, so an unindexed DepIndex would cost Q x D; it is rejected rather than silently scanned")
(:sym "safeTail" :mod "asl-checker/resolve" :sig "safeTail l: (List T) -> (List T)" :doc "All but the first element, empty for an empty list.")
(:sym "secondExprEmpty" :mod "asl-checker/resolve" :sig "secondExprEmpty l: (List rd/SExpr) -> rd/SExpr" :doc "The second expression, or an empty atom.")
(:sym "sexprToList" :mod "asl-checker/resolve" :sig "sexprToList e: rd/SExpr -> (List rd/SExpr)" :doc "The items of a list or vector, empty for an atom.")
(:sym "sliceFrom" :mod "asl-checker/resolve" :sig "sliceFrom s: String start: Int64 -> String" :doc "The suffix of s from byte start, s itself when out of range.")
(:sym "withImports" :mod "asl-checker/resolve" :sig "withImports s: ModuleSummary imports: (Map String String) -> ModuleSummary")
(:sym "unexportedCaseModule" :mod "asl-checker/resolve" :sig "unexportedCaseModule head: String mod: ModuleSummary deps: DepIndex -> (Option String)" :pit (option))
(:sym "letrecDiags" :mod "asl-checker/resolve" :sig "letrecDiags forms: (List a/TopForm) path: String src: String -> (List ty/Diagnostic)" :doc "Scans each let for a binding that calls itself or a later sibling before either exists yet, reporting ERR_LETREC (MM2 D153: let is not recursive).")
(:sym "tailrecNames" :mod "asl-checker/tailPos" :sig "tailrecNames src: String -> (List String)")
(:sym "notTailCount" :mod "asl-checker/tailPos" :sig "notTailCount d: a/DefunNode ctors: (List String) -> Int64")
(:sym "notTailDiags" :mod "asl-checker/tailPos" :sig "notTailDiags forms: (List a/TopForm) src: String path: String -> (List ty/Diagnostic)")
(:sym "Type" :mod "asl-checker/types" :kind type :sig "(enum Type (:c tyCon [(name String) (args (List Type)) (mod (Option String)) (shown (Option String))] \"A nominal or constructed type\") (:c tyVar [(id Int64) (kind String)] \"A type variable metavariable: any, num, or int\") (:c tyFun [(params (List Type)) (ret Type)] \"A function type\"))")
(:sym "Diagnostic" :mod "asl-checker/types" :kind type :sig "(schema Diagnostic (:f code String) (:f message String) (:f msg String) (:f line Int64) (:f col Int64) (:f path String))" :pit (record))
(:sym "genericMulti?" :mod "asl-checker/types" :sig "genericMulti? name: String -> Bool" :doc "True for a D159 name with more than one receiver type; its first argument picks the row.")
(:sym "genericAlias" :mod "asl-checker/types" :sig "genericAlias name: String -> String" :doc "The concrete builtin of a one-type D159 name, empty for any other name.")
(:sym "genericConcrete" :mod "asl-checker/types" :sig "genericConcrete name: String over: String -> String" :doc "The concrete builtin a multi-type D159 name has over a receiver type name, empty outside its rows.")
(:sym "genericCandidates" :mod "asl-checker/types" :sig "genericCandidates name: String -> String" :doc "The receiver type names of a multi-type D159 name, comma separated, for diagnostics.")
(:sym "genericRenamed" :mod "asl-checker/types" :sig "genericRenamed name: String -> String" :doc "The D159 generic name an old type-prefixed builtin name became, empty for any other name; the hint of a retired name.")
(:sym "renamedHint" :mod "asl-checker/types" :sig "renamedHint name: String -> String" :doc "The suffix of an unbound-symbol message for a D159 retired name: \"; renamed to NEW (D159)\", empty for any other name. It shows once the old names leave the builtins.")
(:sym "genericName?" :mod "asl-checker/types" :sig "genericName? name: String -> Bool" :doc "True for a D159 generic builtin name, multi-type or one-type.")
(:sym "genericSigName" :mod "asl-checker/types" :sig "genericSigName name: String -> String" :doc "The name whose builtin signature a call of name has: a one-type generic name's concrete builtin, else name itself.")
(:sym "receiverOver" :mod "asl-checker/types" :sig "receiverOver t: Type -> String" :doc "The receiver type name a D159 row is keyed by: empty for a type variable, the name for a type of the closed set, ? for any other type.")
(:sym "isTyVar?" :mod "asl-checker/types" :sig "isTyVar? t: Type -> Bool" :doc "True when t is a type variable.")
(:sym "resolveTypeAlias" :mod "asl-checker/types" :sig "resolveTypeAlias name: String -> String" :doc "Canonical name of a builtin type spelling: Int to Int64, Str to String, F64 to Float64; other names unchanged.")
(:sym "unorderedType?" :mod "asl-checker/types" :sig "unorderedType? name: String -> Bool" :doc "True for types with no total order, which cannot key a Map.")
(:sym "intRangeBounds" :mod "asl-checker/types" :sig "intRangeBounds name: String -> (Option (Pair Int64 Int64))" :doc "Inclusive bounds of a fixed-width integer type, none for other types." :pit (option))
(:sym "preludeUnionCases" :mod "asl-checker/types" :sig "preludeUnionCases caseName: String -> (Option String)" :doc "The prelude union a case name belongs to: Option, Result, List or IoError." :pit (option))
(:sym "isNumericType?" :mod "asl-checker/types" :sig "isNumericType? name: String -> Bool" :doc "True for Int32, Int64 and Float64.")
(:sym "isIntegralType?" :mod "asl-checker/types" :sig "isIntegralType? name: String -> Bool" :doc "True for Int32 and Int64.")
(:sym "builtinSig" :mod "asl-checker/types" :sig "builtinSig name: String -> (Option (Pair (List String) (Pair Bool String)))" :doc "Signature of a prelude builtin as parameter and return type strings, with a flag for variadic ones." :pit (option))
(:sym "parseTypeStr" :mod "asl-checker/types" :sig "parseTypeStr s: String typevars: (List String) -> Type" :doc "Parse type text into a Type; names in typevars become type variables.")
(:sym "showTypes" :mod "asl-checker/types" :sig "showTypes ts: (List Type) -> (List String)" :doc "showType over a list.")
(:sym "showType" :mod "asl-checker/types" :sig "showType t: Type -> String" :doc "A type as source text; unresolved variables show as _ or by kind.")
(:sym "collectTvars" :mod "asl-checker/types" :sig "collectTvars params: (List String) ret: String -> (List String)" :doc "Extract single-uppercase-letter type variable names from parameter and return type strings.")
(:sym "UnifyOutcome" :mod "asl-checker/unify" :kind type :sig "(enum UnifyOutcome (:c uOk [(subst (Map Int64 ty/Type))] \"Unification succeeded with updated substitution\") (:c uErr [(msg String) (numeric Bool)] \"Unification failed with message and numeric mismatch flag\"))")
(:sym "applySubst" :mod "asl-checker/unify" :sig "applySubst subst: (Map Int64 ty/Type) t: ty/Type -> ty/Type" :doc "A type with every bound variable replaced through the substitution.")
(:sym "occursIn?" :mod "asl-checker/unify" :sig "occursIn? id: Int64 t: ty/Type subst: (Map Int64 ty/Type) -> Bool" :doc "True if variable id occurs in the type, the check that keeps substitutions acyclic.")
(:sym "kindNarrow" :mod "asl-checker/unify" :sig "kindNarrow k1: String k2: String -> (Option String)" :doc "The narrower of two variable kinds (any, num, int), none when they conflict." :pit (option))
(:sym "typeEqual?" :mod "asl-checker/unify" :sig "typeEqual? t1: ty/Type t2: ty/Type -> Bool" :doc "Structural type equality; an absent module on either side matches any module.")
(:sym "unify" :mod "asl-checker/unify" :sig "unify t1: ty/Type t2: ty/Type subst: (Map Int64 ty/Type) modName: String -> UnifyOutcome" :doc "Unify two types under a substitution: the extended substitution, or the mismatch.")
(:sym "resolveVarSubst" :mod "asl-checker/unify" :sig "resolveVarSubst subst: (Map Int64 ty/Type) cur: ty/Type -> ty/Type" :doc "The type a variable is bound to after following its chain of bindings.")
(:sym "resolveVarSubstRec" :mod "asl-checker/unify" :sig "resolveVarSubstRec subst: (Map Int64 ty/Type) cur: ty/Type fuel: Int64 -> ty/Type" :doc "Follow variable bindings in a substitution for at most fuel steps.")
