(:sym "verifyClaimsGrounding" :mod "asl-checker/claims" :sig "verifyClaimsGrounding claims: (List ClaimCitation) receipts: (List GroundedReceipt) -> (Result Int64 Str)" :pit (result))
(:sym "groundClaims!" :mod "asl-checker/claims" :sig "groundClaims! registryPath: Str -> (Result (List ClaimCitation) Str)" :pit (result effect))
(:sym "constantAssertDiags" :mod "asl-checker/constAssert" :sig "constantAssertDiags forms: (List a/TopForm) src: String path: String -> (List ty/Diagnostic)" :doc "Diagnostics for assertions whose condition is a constant, skipping functions tagged hostSubject in the source.")
(:sym "foldsToConstant?" :mod "asl-checker/constAssert" :sig "foldsToConstant? e: rd/SExpr env: (Map String Bool) funs: (List String) -> Bool")
(:sym "hostSubjectFns" :mod "asl-checker/constAssert" :sig "hostSubjectFns src: String -> (List String)")
(:sym "ExhaustiveReport" :mod "asl-checker/exhaustive" :kind type :sig "(schema ExhaustiveReport (:f isExhaustive Bool) (:f missingVariants (List String)) (:f hasWildcard Bool) (:f diagnostic String))" :pit (record))
(:sym "makeExhaustiveReport" :mod "asl-checker/exhaustive" :sig "makeExhaustiveReport isExhaustive: Bool missing: (List String) hasWildcard: Bool diag: String -> ExhaustiveReport")
(:sym "checkMatchExhaustiveness" :mod "asl-checker/exhaustive" :sig "checkMatchExhaustiveness allVariants: (List String) coveredArms: (List String) hasWildcard: Bool -> ExhaustiveReport")
(:sym "isArmCovered?" :mod "asl-checker/exhaustive" :sig "isArmCovered? covered: (List String) variant: String -> Bool")
(:sym "ForeignSig" :mod "asl-checker/foreign" :kind type :sig "(schema ForeignSig (:f args (List String)) (:f ret String) (:f check String :default \"\"))" :doc "A parsed C signature: the C kind of each ASL parameter in order, the C result kind and its failure convention check (\"\", \"neg\" or \"null\")." :pit (record))
(:sym "ForeignSpec" :mod "asl-checker/foreign" :kind type :sig "(schema ForeignSpec (:f lib String) (:f symbol String) (:f sig ForeignSig))" :doc "A foreign declaration's three literals: library, C symbol and parsed signature." :pit (record))
