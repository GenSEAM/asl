(:card "asl-checker" :purpose "100% Self-Hosted Pure AgentSlang Semantic Type Checker" :import "(asl-checker/check :a x)" :deps (asl-parser asl-proc) :modules ((:m "asl-checker/check" :doc "Pass 3 Hindley-Milner Type Inference and Unified Checker...") (:m "asl-checker/checkCached") (:m "asl-checker/claims") (:m "asl-checker/constAssert") (:m "asl-checker/exhaustive")) :moduleCount 15 :sigs ("(schema InferState (:f subst (Map Int64 ty/Type)) (:f nextVar Int64) (:f intSites (List (Pair String Int64))) (:f mapSites (List (Pair ty/Ty..." "(schema Deferred (:f name String) (:f recv ty/Type) (:f args (List ty/Type)) (:f result ty/Type))" "checkModule forms: (List a/TopForm) deps: (Map String r/ModuleSummary) path: String -> (List ty/Diagnostic)" "checkModuleIn forms: (List a/TopForm) deps: r/DepIndex path: String -> (List ty/Diagnostic)" "checkModuleSource forms: (List a/TopForm) deps: (Map String r/ModuleSummary) path: String src: String -> (List ty/Diagnostic)") :more (checkSource checkFile! schemaOfCtor elaborateScript elaborateMatches needsElaboration? Cache emptyCache overrideCache stampCacheAt stampedCache! stampKeyIn!) :moreCount 182 :effects (checkFile! stampedCache! stampKeyIn! checkFileCached! checkFileCachedIn! checkSourceCachedIn! groundClaims! exportersOf!) :fails (checkFile! verifyClaimsGrounding groundClaims! parseSig specOfTexts specOfCall layoutOf loadModuleDeps!) :example none)
(:sym "InferState" :mod "asl-checker/check" :kind type :sig "(schema InferState (:f subst (Map Int64 ty/Type)) (:f nextVar Int64) (:f intSites (List (Pair String Int64))) (:f mapSites (List (Pair ty/Type String))) (:f diags (List ty/Diagnostic)) (:f deferred (List Deferred)))" :pit (record))
(:sym "Deferred" :mod "asl-checker/check" :kind type :sig "(schema Deferred (:f name String) (:f recv ty/Type) (:f args (List ty/Type)) (:f result ty/Type))" :pit (record))
(:sym "checkModule" :mod "asl-checker/check" :sig "checkModule forms: (List a/TopForm) deps: (Map String r/ModuleSummary) path: String -> (List ty/Diagnostic)" :doc "Raw checker diagnostics for parsed forms, retaining resolver rule codes and documentation/type-name diagnostics.")
(:sym "checkModuleIn" :mod "asl-checker/check" :sig "checkModuleIn forms: (List a/TopForm) deps: r/DepIndex path: String -> (List ty/Diagnostic)")
(:sym "checkModuleSource" :mod "asl-checker/check" :sig "checkModuleSource forms: (List a/TopForm) deps: (Map String r/ModuleSummary) path: String src: String -> (List ty/Diagnostic)" :doc "Host-facing file-check diagnostics: normalized codes and lint filtering.")
(:sym "checkSource" :mod "asl-checker/check" :sig "checkSource src: String deps: (Map String r/ModuleSummary) path: String -> (List ty/Diagnostic)" :doc "Parse source and return raw checker rule diagnostics against dependencies; checkFile! exposes normalized host-check diagnostics.")
(:sym "checkFile!" :mod "asl-checker/check" :kind fn! :sig "checkFile! path: String roots: (List String) -> (Result (List ty/Diagnostic) String)" :doc "Read, parse and check a file, loading its imports from the roots." :pit (result effect))
(:sym "schemaOfCtor" :mod "asl-checker/check" :sig "schemaOfCtor head: String mod: r/ModuleSummary deps: (Map String r/ModuleSummary) -> (Option (Pair r/SchemaSummary r/ModuleSummary))" :pit (option))
(:sym "elaborateScript" :mod "asl-checker/check" :sig "elaborateScript forms: (List a/TopForm) deps: (Map String r/ModuleSummary) path: String -> (List a/TopForm)")
(:sym "elaborateMatches" :mod "asl-checker/check" :sig "elaborateMatches forms: (List a/TopForm) deps: (Map String r/ModuleSummary) path: String -> (List a/TopForm)")
(:sym "needsElaboration?" :mod "asl-checker/check" :sig "needsElaboration? forms: (List a/TopForm) -> Bool")
(:sym "Cache" :mod "asl-checker/checkCached" :kind type :sig "(schema Cache (:f index r/ModIndex) (:f bodies (Map String (List ty/Diagnostic))) (:f stampDir String) (:f checkerId String))" :pit (record))
(:sym "emptyCache" :mod "asl-checker/checkCached" :sig "emptyCache -> Cache" :doc "The checker cache with an empty module index, the starting point of an incremental check session.")
(:sym "overrideCache" :mod "asl-checker/checkCached" :sig "overrideCache overrides: (Map String String) -> Cache")
(:sym "stampCacheAt" :mod "asl-checker/checkCached" :sig "stampCacheAt dir: String checkerId: String -> Cache")
(:sym "stampedCache!" :mod "asl-checker/checkCached" :kind fn! :sig "stampedCache! -> Cache" :doc "a stamped Cache when ASL_NATIVE_CLI_DIR ends in a cli- digest name of 68 characters, keyed under ASL_CHECK_CACHE or ~/.asl/cache/check, else an empty cache with stamps off" :pit (effect))
(:sym "stampKeyIn!" :mod "asl-checker/checkCached" :kind fn! :sig "stampKeyIn! base: String checkerId: String paths: (List String) -> (Option String)" :pit (option effect))
(:sym "Verdict" :mod "asl-checker/checkCached" :kind type :sig "(schema Verdict (:f diags (List ty/Diagnostic)) (:f checked Int64) (:f summarised Int64))" :pit (record))
(:sym "countsText" :mod "asl-checker/checkCached" :sig "countsText v: Verdict -> String" :doc "a verdict as a (:checked N :summarised M) text")
(:sym "checkFileCached!" :mod "asl-checker/checkCached" :kind fn! :sig "checkFileCached! path: String roots: (List String) cache: Cache -> (Pair (Result Verdict String) Cache)" :doc "Checks a file through the incremental cache, reusing the module index of earlier calls, and returns the verdict with the updated cache." :pit (effect))
(:sym "checkFileCachedIn!" :mod "asl-checker/checkCached" :kind fn! :sig "checkFileCachedIn! base: String path: String roots: (List String) cache: Cache -> (Pair (Result Verdict String) Cache)" :pit (effect))
(:sym "checkSourceCachedIn!" :mod "asl-checker/checkCached" :kind fn! :sig "checkSourceCachedIn! base: String path: String src: String roots: (List String) cache: Cache -> (Pair (Result Verdict String) Cache)" :doc "checks an in-memory source string for path against the workspace dependency closure and stamp cache without copying the workspace" :pit (effect))
(:sym "ClaimCitation" :mod "asl-checker/claims" :kind type :sig "(schema ClaimCitation (:f metric Str) (:f category Str) (:f source Str) (:f citation Str) (:f isGrounded Bool))" :pit (record))
