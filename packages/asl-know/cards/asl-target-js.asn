(:card "asl-target-js" :purpose "JavaScript (ES2020 module) backend: lowers a linked, verified asl-ir SSA module to one self-contained ES module with a small runtime; Int is BigInt and traps on int64 overflow, strings keep ASL's UTF-8 byte semantics; Ty..." :import "(asl-target-js :a x)" :deps (asl-ir asl-parser) :modules ((:m "asl-target-js" :doc "JavaScript backend entry: compileEntry! links an entry m...") (:m "asl-target-js/dts" :doc "TypeScript declarations for an entry module, from its pa...") (:m "asl-target-js/emit" :doc "SsaModule to JavaScript: one function per SSA function, ...") (:m "asl-target-js/runtime" :doc "The JavaScript runtime as text: values (Variant, Rec, Co...")) :sigs ("compileEntry! entryPath: String -> (Result String (List ty/IrDiag))" "compileWithTypes! entryPath: String -> (Result (Pair String String) (List ty/IrDiag))" "diagText ds: (List ty/IrDiag) -> String" "tsType e: rd/SExpr locals: (List String) known: (List String) -> String" "emitDts source: String -> (Result String String)" "jsIdent prefix: String name: String -> String" "jsString s: String -> String" "emitJsModule m: ty/SsaModule -> (Result String (List ty/IrDiag))" "supportedBuiltins -> (List String)" "runtimeText -> String" "builtinNames -> (List String)" "entryNames -> (List String)") :effects (compileEntry! compileWithTypes!) :fails (compileEntry! compileWithTypes! emitDts emitJsModule) :example none)
(:sym "compileEntry!" :mod "asl-target-js" :sig "compileEntry! entryPath: String -> (Result String (List ty/IrDiag))" :doc "Links the program at entryPath (prelude included) and returns the ES module text, or the link diagnostics, or ERR_CAPABILITY_ABSENT naming each host builtin the js runtime does not provide." :pit (result effect))
(:sym "compileWithTypes!" :mod "asl-target-js" :sig "compileWithTypes! entryPath: String -> (Result (Pair String String) (List ty/IrDiag))" :doc "compileEntry! plus the TypeScript declarations of the entry module, as (pair js dts)." :pit (result effect))
(:sym "diagText" :mod "asl-target-js" :sig "diagText ds: (List ty/IrDiag) -> String")
(:sym "tsType" :mod "asl-target-js/dts" :sig "tsType e: rd/SExpr locals: (List String) known: (List String) -> String")
(:sym "emitDts" :mod "asl-target-js/dts" :sig "emitDts source: String -> (Result String String)" :pit (result))
(:sym "jsIdent" :mod "asl-target-js/emit" :sig "jsIdent prefix: String name: String -> String")
(:sym "jsString" :mod "asl-target-js/emit" :sig "jsString s: String -> String")
(:sym "emitJsModule" :mod "asl-target-js/emit" :sig "emitJsModule m: ty/SsaModule -> (Result String (List ty/IrDiag))" :doc "The module text: the runtime, the string pool, every function, and an export per function of the entry module under its ASL name (export { f as \"name?\" }), plus setOutput and AslTrap." :pit (result))
(:sym "supportedBuiltins" :mod "asl-target-js/emit" :sig "supportedBuiltins -> (List String)")
(:sym "runtimeText" :mod "asl-target-js/runtime" :sig "runtimeText -> String")
(:sym "builtinNames" :mod "asl-target-js/runtime" :sig "builtinNames -> (List String)")
(:sym "entryNames" :mod "asl-target-js/runtime" :sig "entryNames -> (List String)")
