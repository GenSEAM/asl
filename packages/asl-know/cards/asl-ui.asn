(:card "asl-ui" :purpose "Pure AgentSlang Universal Declarative UI, Elm Architecture, and Double-Buffered Frame Arena" :import "(asl-ui :a x)" :deps (asl-conform) :modules ((:m "asl-ui" :doc "Pure AgentSlang Universal Declarative UI, Elm Runtime & ...") (:m "asl-ui/arena" :doc "Pure AgentSlang Double-Buffered Frame Arena Allocator an...") (:m "asl-ui/auditDashboard" :doc "Pure AgentSlang Declarative VDOM and SVG Audit Hypergrap...") (:m "asl-ui/ax" :doc "Pure AgentSlang Semantic Accessibility Projection and AR...") (:m "asl-ui/bento" :doc "Pure AgentSlang Modular 12-Column Bento Grid Container L...")) :moduleCount 20 :sigs ("(schema MutationRecord (:f kind String) (:f targetKey String) (:f node ui/VNode) (:f attrs (Map String String)) (:f index Int64))" "makeMutationRecord kind: String targetKey: String node: ui/VNode attrs: (Map String String) index: Int64 -> MutationRecord" "makeMutationRecordOfType kind: String targetKey: String nodeType: String -> MutationRecord" "(schema FrameArena (:f capacityBytes Int64) (:f activeIdx Int64) (:f offset0 Int64) (:f offset1 Int64) (:f nodesCount0 Int64) (:f nodesCount..." "makeFrameArena capacityBytes: Int64 -> FrameArena") :more (FrameArenaPair makeFrameArenaPair allocFrameNode tryAllocFrameNode swapArenas swapFrameArena resetInactiveArena getArenaAllocatedBytes diffVNodes) :moreCount 151 :fails (allocFrameNode tryAllocFrameNode registerPlugin unregisterPlugin initNativeSurface presentNativeFrame resizeNativeSurface pollNativeEvents) :example none)
