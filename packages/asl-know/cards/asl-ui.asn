(:sym "stepStatusBlocked" :mod "asl-ui/workflowDag" :kind ctor :sig "(:c stepStatusBlocked [] \"Step blocked by human sovereignty 2PC gate\")) of WorkflowStepStatus" :pit (ctor))
(:sym "WorkflowDagNode" :mod "asl-ui/workflowDag" :kind type :sig "(schema WorkflowDagNode (:f stepId String) (:f title String) (:f role String) (:f status String) (:f dependenciesCount Int64) (:f durationMs Int64) (:f assertionsCount Int64))" :pit (record))
(:sym "makeWorkflowDagNode" :mod "asl-ui/workflowDag" :sig "makeWorkflowDagNode id: String title: String role: String status: String depsCount: Int64 dur: Int64 asserts: Int64 -> WorkflowDagNode")
(:sym "layoutWorkflowDagNodes" :mod "asl-ui/workflowDag" :sig "layoutWorkflowDagNodes nodes: List -> List")
(:sym "formatDagStepStatus" :mod "asl-ui/workflowDag" :sig "formatDagStepStatus status: String -> String")
(:sym "renderWorkflowDagNode" :mod "asl-ui/workflowDag" :sig "renderWorkflowDagNode dagNode: WorkflowDagNode -> ui/VNode")
(:sym "renderWorkflowDag" :mod "asl-ui/workflowDag" :sig "renderWorkflowDag dagId: String nodes: List -> ui/VNode")
