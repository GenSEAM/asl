(:card "asl-parquet" :purpose "ASL Parquet writer, footer metadata reader and pure-ASL reader" :import "(asl-parquet/writer :a x)" :deps (asl-syntax) :modules ((:m "asl-parquet/writer" :doc "Parquet file writer using typed arrays, compact Thrift a...") (:m "asl-parquet/footer" :doc "Read compact-Thrift Parquet footer metadata directly fro...") (:m "asl-parquet/reader" :doc "Pure-ASL Parquet reader for compact-Thrift footers, row-...")) :sigs ("(enum ParquetColumn (:c i64Column [(name String) (values I64Array) (encoding String)] \"I64 column\") (:c f64Column [(name String) (values F64..." "parquetWrite path: String columns: (List ParquetColumn) options: (List (List String)) kv: (List (List String)) -> (Result Unit String)" "parquetColumnEncodings path: String columnName: String rowGroup: Int64 -> (Result (List String) String)" "parquetColumnCompression path: String columnName: String rowGroup: Int64 -> (Result String String)" "parquetColumnHasDictionary path: String columnName: String rowGroup: Int64 -> (Result Bool String)") :more (parquetKvMetadata parquetColumnStatsInt64 parquetColumnStatsFloat64 parquetOpen parquetNumRowGroups parquetNumRows parquetColumnType parquetReadF64) :moreCount 8 :effects (parquetWrite parquetColumnEncodings parquetColumnCompression parquetColumnHasDictionary parquetKvMetadata parquetColumnStatsInt64 parquetColumnStatsFloat64 parquetOpen) :fails (parquetWrite parquetColumnEncodings parquetColumnCompression parquetColumnHasDictionary parquetKvMetadata parquetColumnStatsInt64 parquetColumnStatsFloat64 parquetOpen) :example "(module asl-know/examples/aslParquet :x [rowCount! selfTest] :i [])\n\nfn ! rowCount! path: String -> Int64\n  (match (parquetOpen path)\n    ((err _) -1)\n    ((ok h) (parquetNumRows h)))")
(:sym "ParquetColumn" :mod "asl-parquet/writer" :kind type :sig "(enum ParquetColumn (:c i64Column [(name String) (values I64Array) (encoding String)] \"I64 column\") (:c f64Column [(name String) (values F64Array) (encoding String)] \"F64 column\") (:c i8Column [(name String) (values I8Array) (encoding String)] \"I8 column\"))")
(:sym "i64Column" :mod "asl-parquet/writer" :kind ctor :sig "(:c i64Column [(name String) (values I64Array) (encoding String)] \"I64 column\") of ParquetColumn" :pit (ctor))
(:sym "f64Column" :mod "asl-parquet/writer" :kind ctor :sig "(:c f64Column [(name String) (values F64Array) (encoding String)] \"F64 column\") of ParquetColumn" :pit (ctor))
(:sym "i8Column" :mod "asl-parquet/writer" :kind ctor :sig "(:c i8Column [(name String) (values I8Array) (encoding String)] \"I8 column\")) of ParquetColumn" :pit (ctor))
(:sym "parquetWrite" :mod "asl-parquet/writer" :kind fn! :sig "parquetWrite path: String columns: (List ParquetColumn) options: (List (List String)) kv: (List (List String)) -> (Result Unit String)" :pit (result effect))
(:sym "parquetColumnEncodings" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnEncodings path: String columnName: String rowGroup: Int64 -> (Result (List String) String)" :pit (result effect))
(:sym "parquetColumnCompression" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnCompression path: String columnName: String rowGroup: Int64 -> (Result String String)" :pit (result effect))
(:sym "parquetColumnHasDictionary" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnHasDictionary path: String columnName: String rowGroup: Int64 -> (Result Bool String)" :pit (result effect))
(:sym "parquetKvMetadata" :mod "asl-parquet/footer" :kind fn! :sig "parquetKvMetadata path: String key: String -> (Result String String)" :pit (result effect))
(:sym "parquetColumnStatsInt64" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnStatsInt64 path: String columnName: String rowGroup: Int64 -> (Result Int64Stats String)" :doc "Min, max and null count of an Int64 column in one row group, read from the file footer; an error when the column or its statistics are missing." :pit (result effect))
(:sym "parquetColumnStatsFloat64" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnStatsFloat64 path: String columnName: String rowGroup: Int64 -> (Result Float64Stats String)" :doc "Min, max and null count of a Float64 column in one row group, read from the file footer; an error when the column or its statistics are missing." :pit (result effect))
(:sym "parquetOpen" :mod "asl-parquet/reader" :kind fn! :sig "parquetOpen path: String -> (Result PqFile String)" :pit (result effect))
(:sym "parquetNumRowGroups" :mod "asl-parquet/reader" :sig "parquetNumRowGroups h: PqFile -> Int64")
(:sym "parquetNumRows" :mod "asl-parquet/reader" :sig "parquetNumRows h: PqFile -> Int64")
(:sym "parquetColumnType" :mod "asl-parquet/reader" :sig "parquetColumnType h: PqFile name: String -> String")
(:sym "parquetReadF64" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadF64 h: PqFile name: String rg: Int64 -> F64Array" :pit (effect))
(:sym "parquetReadI64" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadI64 h: PqFile name: String rg: Int64 -> I64Array" :pit (effect))
(:sym "parquetReadI8" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadI8 h: PqFile name: String rg: Int64 -> I8Array" :pit (effect))
(:sym "parquetKvMetadata" :mod "asl-parquet/reader" :sig "parquetKvMetadata h: PqFile key: String -> (Result String String)" :pit (result))
(:sym "pqLoadUAt" :mod "asl-parquet/reader" :sig "pqLoadUAt bs: Bytes at: Int64 n: Int64 acc: Int64 -> Int64")
(:sym "pqLoad64" :mod "asl-parquet/reader" :sig "pqLoad64 bs: Bytes i: Int64 -> Int64")
(:sym "parquetColumnRange" :mod "asl-parquet/reader" :sig "parquetColumnRange h: PqFile name: String rg: Int64 -> (Option (Pair Int64 Int64))" :doc "The footer min and max of an Int64 column in one row group; none when the file has no statistics for it or the column is not Int64." :pit (option))
(:sym "parquetWindowGroups" :mod "asl-parquet/reader" :sig "parquetWindowGroups h: PqFile name: String lo: Int64 hi: Int64 -> (List Int64)" :doc "The row groups that can hold a value in [lo, hi); keeps every group whose range is unknown, so pruning never drops a row.")
(:sym "parquetLowerBound" :mod "asl-parquet/reader" :sig "parquetLowerBound values: I64Array target: Int64 -> Int64" :doc "First index of an ascending array whose value is at least the target.")
