(:card "asl-parquet" :purpose "ASL Parquet writer, footer metadata reader and pure-ASL reader" :import "(asl-parquet/writer :a x)" :deps (asl-syntax) :modules ((:m "asl-parquet/writer" :doc "Parquet file writer using typed arrays, compact Thrift a...") (:m "asl-parquet/footer" :doc "Read compact-Thrift Parquet footer metadata directly fro...") (:m "asl-parquet/merge" :doc "Bounded-memory k-way merge reader over several parquet f...") (:m "asl-parquet/reader" :doc "Pure-ASL Parquet reader for compact-Thrift footers, row-...")) :sigs ("(enum ParquetColumn (:c i64Column [(name String) (values I64Array) (encoding String)] \"I64 column\") (:c f64Column [(name String) (values F64..." "parquetWrite path: String columns: (List ParquetColumn) options: (List (List String)) kv: (List (List String)) -> (Result Unit String)" "parquetColumnEncodings path: String columnName: String rowGroup: Int64 -> (Result (List String) String)" "parquetColumnCompression path: String columnName: String rowGroup: Int64 -> (Result String String)" "parquetColumnHasDictionary path: String columnName: String rowGroup: Int64 -> (Result Bool String)") :more (parquetKvMetadata parquetColumnStatsInt64 parquetColumnStatsFloat64 parquetMergeDecodes MergeRow parquetMergeOpen parquetMergeNext parquetMergeTake) :moreCount 28 :effects (parquetWrite parquetColumnEncodings parquetColumnCompression parquetColumnHasDictionary parquetKvMetadata parquetColumnStatsInt64 parquetColumnStatsFloat64 parquetMergeOpen) :fails (parquetWrite parquetColumnEncodings parquetColumnCompression parquetColumnHasDictionary parquetKvMetadata parquetColumnStatsInt64 parquetColumnStatsFloat64 parquetMergeOpen) :example "(module asl-know/examples/aslParquet :x [rowCount! selfTest] :i [])\n\nfn ! rowCount! path: String -> Int64\n  (match (parquetOpen path)\n    ((err _) -1)\n    ((ok h) (parquetNumRows h)))")
(:sym "ParquetColumn" :mod "asl-parquet/writer" :kind type :sig "(enum ParquetColumn (:c i64Column [(name String) (values I64Array) (encoding String)] \"I64 column\") (:c f64Column [(name String) (values F64Array) (encoding String)] \"F64 column\") (:c i8Column [(name String) (values I8Array) (encoding String)] \"I8 column\"))")
(:sym "i64Column" :mod "asl-parquet/writer" :kind ctor :sig "(:c i64Column [(name String) (values I64Array) (encoding String)] \"I64 column\") of ParquetColumn" :pit (ctor))
(:sym "f64Column" :mod "asl-parquet/writer" :kind ctor :sig "(:c f64Column [(name String) (values F64Array) (encoding String)] \"F64 column\") of ParquetColumn" :pit (ctor))
(:sym "i8Column" :mod "asl-parquet/writer" :kind ctor :sig "(:c i8Column [(name String) (values I8Array) (encoding String)] \"I8 column\")) of ParquetColumn" :pit (ctor))
(:sym "parquetWrite" :mod "asl-parquet/writer" :kind fn! :sig "parquetWrite path: String columns: (List ParquetColumn) options: (List (List String)) kv: (List (List String)) -> (Result Unit String)" :doc "Write F64, I64 and I8 columns to one parquet file as row groups of rowGroupRows rows (default 1000000); option pageRows splits each column chunk into data pages of that many rows, default 8192 (about 64 KB per column), 0 is one page per gro..." :pit (result effect))
(:sym "parquetColumnEncodings" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnEncodings path: String columnName: String rowGroup: Int64 -> (Result (List String) String)" :pit (result effect))
(:sym "parquetColumnCompression" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnCompression path: String columnName: String rowGroup: Int64 -> (Result String String)" :pit (result effect))
(:sym "parquetColumnHasDictionary" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnHasDictionary path: String columnName: String rowGroup: Int64 -> (Result Bool String)" :pit (result effect))
(:sym "parquetKvMetadata" :mod "asl-parquet/footer" :kind fn! :sig "parquetKvMetadata path: String key: String -> (Result String String)" :pit (result effect))
(:sym "parquetColumnStatsInt64" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnStatsInt64 path: String columnName: String rowGroup: Int64 -> (Result Int64Stats String)" :doc "Min, max and null count of an Int64 column in one row group, read from the file footer; an error when the column or its statistics are missing." :pit (result effect))
(:sym "parquetColumnStatsFloat64" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnStatsFloat64 path: String columnName: String rowGroup: Int64 -> (Result Float64Stats String)" :doc "Min, max and null count of a Float64 column in one row group, read from the file footer; an error when the column or its statistics are missing." :pit (result effect))
(:sym "parquetMergeDecodes" :mod "asl-parquet/merge" :sig "parquetMergeDecodes m: Merge -> Int64" :doc "Total page decodes so far across sources and columns; one per page and column of each group however small chunkRows is.")
(:sym "MergeRow" :mod "asl-parquet/merge" :kind type :sig "(schema MergeRow (:f source Int64) (:f ts Int64) (:f row Int64) (:f ints (List Int64)) (:f floats (List Float64)))" :doc "One merged row: source index (position in the paths list), ts, row index inside its source file, int columns (int64 or int8) and double columns in the order named at open." :pit (record))
(:sym "parquetMergeOpen" :mod "asl-parquet/merge" :kind fn! :sig "parquetMergeOpen paths: (List String) tsName: String intNames: (List String) floatNames: (List String) chunkRows: Int64 -> (Result Merge String)" :doc "Open parquet files for a k-way merge by an Int64 timestamp column with chunkRows rows per window; a Result; checks every file has the columns with the right types; each source must be ascending in ts, a decrease is an error; equal timestamp..." :pit (result effect))
(:sym "parquetMergeNext" :mod "asl-parquet/merge" :kind fn! :sig "parquetMergeNext m: Merge -> (Result (Option (Pair MergeRow Merge)) String)" :doc "The next merged row and the merge advanced past it, none when every source is exhausted; a Result; the merge value is immutable." :pit (result effect))
(:sym "parquetMergeTake" :mod "asl-parquet/merge" :kind fn! :sig "parquetMergeTake m: Merge n: Int64 -> (Result (Pair (List MergeRow) Merge) String)" :doc "Up to n next merged rows and the advanced merge; a Result." :pit (result effect))
(:sym "parquetMergeSourceCount" :mod "asl-parquet/merge" :sig "parquetMergeSourceCount m: Merge -> Int64" :doc "Number of sources in a merge.")
(:sym "parquetMergeWindowRows" :mod "asl-parquet/merge" :sig "parquetMergeWindowRows m: Merge -> Int64" :doc "Largest window any source holds now in rows; never above chunkRows, the memory bound by construction.")
(:sym "PqCursor" :mod "asl-parquet/reader" :kind type :sig "(schema PqCursor (:f q PqFile) (:f col Int64) (:f rg Int64) (:f kind Int64) (:f pos Int64) (:f rowAt Int64) (:f dict Bytes) (:f ndict Int64) (:f pageAt Int64) (:f pageRows Int64) (:f cells Bytes) (:f decodes Int64))" :doc "Forward cursor over the data pages of one column chunk: keeps the byte position of the next page, the decoded dictionary and the last decoded page; opening reads every page header once and requires the page value counts to sum to the group ..." :pit (record))
(:sym "parquetCursorI64" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorI64 h: PqFile name: String rg: Int64 -> (Result PqCursor String)" :doc "Cursor over an Int64 column of one row group, a Result; an unknown column, wrong type, group outside the file or inconsistent page headers is an error." :pit (result effect))
(:sym "parquetCursorF64" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorF64 h: PqFile name: String rg: Int64 -> (Result PqCursor String)" :doc "Cursor over a Float64 column of one row group, a Result." :pit (result effect))
(:sym "parquetCursorI8" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorI8 h: PqFile name: String rg: Int64 -> (Result PqCursor String)" :doc "Cursor over an Int8 column of one row group, a Result." :pit (result effect))
(:sym "parquetCursorDecodes" :mod "asl-parquet/reader" :sig "parquetCursorDecodes cur: PqCursor -> Int64" :doc "Pages and dictionaries a cursor has decoded so far; reads inside an already decoded page add none, so a group of one page costs one decode however many small reads follow.")
(:sym "parquetCursorReadI64" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorReadI64 cur: PqCursor start: Int64 count: Int64 -> (Result (Pair I64Array PqCursor) String)" :doc "Rows start .. start+count from a cursor as an Int64 array and the advanced cursor; reads move forward (start not before the last decoded page); memory is one decoded page, which is a whole group for a file with one page per group." :pit (result effect))
(:sym "parquetCursorReadF64" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorReadF64 cur: PqCursor start: Int64 count: Int64 -> (Result (Pair F64Array PqCursor) String)" :doc "Rows start .. start+count from a Float64 cursor and the advanced cursor; forward only like parquetCursorReadI64." :pit (result effect))
(:sym "parquetCursorReadI8" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorReadI8 cur: PqCursor start: Int64 count: Int64 -> (Result (Pair I8Array PqCursor) String)" :doc "Rows start .. start+count from an Int8 cursor and the advanced cursor; forward only like parquetCursorReadI64." :pit (result effect))
(:sym "parquetHasColumn" :mod "asl-parquet/reader" :sig "parquetHasColumn h: PqFile name: String -> Bool" :doc "True when the file's schema has a column of that name.")
(:sym "parquetGroupRows" :mod "asl-parquet/reader" :sig "parquetGroupRows h: PqFile rg: Int64 -> Int64" :doc "Row count of one row group; -1 when the group index is outside the file.")
(:sym "parquetReadRangeF64" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadRangeF64 h: PqFile name: String rg: Int64 start: Int64 count: Int64 -> (Result F64Array String)" :doc "Rows start .. start+count of a Float64 column inside one row group as a Result; page-bounded like parquetReadRangeI64." :pit (result effect))
(:sym "parquetReadRangeI64" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadRangeI64 h: PqFile name: String rg: Int64 start: Int64 count: Int64 -> (Result I64Array String)" :doc "Rows start .. start+count of an Int64 column inside one row group as a Result; reads page headers, skips pages that end before the range, decodes only overlapping pages and stops after the last one, so memory is one page plus the range (a f..." :pit (result effect))
(:sym "parquetReadRangeI8" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadRangeI8 h: PqFile name: String rg: Int64 start: Int64 count: Int64 -> (Result I8Array String)" :doc "Rows start .. start+count of an Int8 column inside one row group as a Result; page-bounded like parquetReadRangeI64." :pit (result effect))
(:sym "parquetOpen" :mod "asl-parquet/reader" :kind fn! :sig "parquetOpen path: String -> (Result PqFile String)" :pit (result effect))
(:sym "parquetNumRowGroups" :mod "asl-parquet/reader" :sig "parquetNumRowGroups h: PqFile -> Int64")
(:sym "parquetNumRows" :mod "asl-parquet/reader" :sig "parquetNumRows h: PqFile -> Int64")
(:sym "parquetColumnType" :mod "asl-parquet/reader" :sig "parquetColumnType h: PqFile name: String -> String")
(:sym "parquetReadF64" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadF64 h: PqFile name: String rg: Int64 -> F64Array" :pit (effect))
(:sym "parquetReadI64" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadI64 h: PqFile name: String rg: Int64 -> I64Array" :pit (effect))
(:sym "parquetReadI8" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadI8 h: PqFile name: String rg: Int64 -> I8Array" :pit (effect))
(:sym "parquetKvMetadata" :mod "asl-parquet/reader" :sig "parquetKvMetadata h: PqFile key: String -> (Result String String)" :pit (result))
(:sym "pqLoadUAt" :mod "asl-parquet/reader" :sig "pqLoadUAt bs: Bytes at: Int64 n: Int64 acc: Int64 -> Int64")
(:sym "pqLoad64" :mod "asl-parquet/reader" :sig "pqLoad64 bs: Bytes i: Int64 -> Int64")
(:sym "parquetColumnRange" :mod "asl-parquet/reader" :sig "parquetColumnRange h: PqFile name: String rg: Int64 -> (Option (Pair Int64 Int64))" :doc "The footer min and max of an Int64 column in one row group; none when the file has no statistics for it or the column is not Int64." :pit (option))
(:sym "parquetWindowGroups" :mod "asl-parquet/reader" :sig "parquetWindowGroups h: PqFile name: String lo: Int64 hi: Int64 -> (List Int64)" :doc "The row groups that can hold a value in [lo, hi); keeps every group whose range is unknown, so pruning never drops a row.")
(:sym "parquetLowerBound" :mod "asl-parquet/reader" :sig "parquetLowerBound values: I64Array target: Int64 -> Int64" :doc "First index of an ascending array whose value is at least the target.")
