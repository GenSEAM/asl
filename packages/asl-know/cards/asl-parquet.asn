(:card "asl-parquet" :purpose "ASL Parquet writer, footer metadata reader and pure-ASL reader" :import "(asl-parquet/writer :a x)" :deps (asl-syntax) :modules ((:m "asl-parquet/writer") (:m "asl-parquet/footer") (:m "asl-parquet/merge") (:m "asl-parquet/reader")) :sigs ("(enum ParquetColumn (:c i64Column [(name String) (values I64Array) (encoding String)] \"I64 column\") (:c f64Column [(name String) (values F64..." "parquetWrite path: String columns: (List ParquetColumn) options: (List (List String)) kv: (List (List String)) -> (Result Unit String)" "(schema PqWriter (:f path String) (:f temp String) (:f names (List String)) (:f kinds (List String)) (:f compression String) (:f level Int64..." "parquetWriterOpen! path: String names: (List String) kinds: (List String) options: (List (List String)) kv: (List (List String)) -> (Result PqWriter String)") :more (parquetWriterAppend! parquetWriterClose! parquetColumnEncodings parquetColumnCompression parquetColumnHasDictionary parquetKvMetadata parquetColumnStatsInt64) :moreCount 36 :effects (parquetWrite parquetWriterOpen! parquetWriterAppend! parquetWriterClose! parquetColumnEncodings parquetColumnCompression parquetColumnHasDictionary parquetKvMetadata) :fails (parquetWrite parquetWriterOpen! parquetWriterAppend! parquetWriterClose! parquetColumnEncodings parquetColumnCompression parquetColumnHasDictionary parquetKvMetadata) :example "(module asl-know/examples/aslParquet :x [rowCount! selfTest] :i [])\n\nfn ! rowCount! path: String -> Int64\n  (match (parquetOpen path)\n    ((err _) -1)\n    ((ok h) (parquetNumRows h)))")
(:sym "ParquetColumn" :mod "asl-parquet/writer" :kind type :sig "(enum ParquetColumn (:c i64Column [(name String) (values I64Array) (encoding String)] \"I64 column\") (:c f64Column [(name String) (values F64Array) (encoding String)] \"F64 column\") (:c i8Column [(name String) (values I8Array) (encoding String)] \"I8 column\"))")
(:sym "i64Column" :mod "asl-parquet/writer" :kind ctor :sig "(:c i64Column [(name String) (values I64Array) (encoding String)] \"I64 column\") of ParquetColumn" :pit (ctor))
(:sym "f64Column" :mod "asl-parquet/writer" :kind ctor :sig "(:c f64Column [(name String) (values F64Array) (encoding String)] \"F64 column\") of ParquetColumn" :pit (ctor))
(:sym "i8Column" :mod "asl-parquet/writer" :kind ctor :sig "(:c i8Column [(name String) (values I8Array) (encoding String)] \"I8 column\")) of ParquetColumn" :pit (ctor))
(:sym "parquetWrite" :mod "asl-parquet/writer" :kind fn! :sig "parquetWrite path: String columns: (List ParquetColumn) options: (List (List String)) kv: (List (List String)) -> (Result Unit String)" :pit (result effect))
(:sym "PqWriter" :mod "asl-parquet/writer" :kind type :sig "(schema PqWriter (:f path String) (:f temp String) (:f names (List String)) (:f kinds (List String)) (:f compression String) (:f level Int64) (:f pageRows Int64) (:f kv (List (List String))) (:f groups (List GroupMeta)) (:f offset Int64) (:f rows Int64))" :pit (record))
(:sym "parquetWriterOpen!" :mod "asl-parquet/writer" :kind fn! :sig "parquetWriterOpen! path: String names: (List String) kinds: (List String) options: (List (List String)) kv: (List (List String)) -> (Result PqWriter String)" :pit (result effect))
(:sym "parquetWriterAppend!" :mod "asl-parquet/writer" :kind fn! :sig "parquetWriterAppend! w: PqWriter columns: (List ParquetColumn) -> (Result PqWriter String)" :pit (result effect))
(:sym "parquetWriterClose!" :mod "asl-parquet/writer" :kind fn! :sig "parquetWriterClose! w: PqWriter -> (Result Unit String)" :pit (result effect))
(:sym "parquetColumnEncodings" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnEncodings path: String columnName: String rowGroup: Int64 -> (Result (List String) String)" :pit (result effect))
(:sym "parquetColumnCompression" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnCompression path: String columnName: String rowGroup: Int64 -> (Result String String)" :pit (result effect))
(:sym "parquetColumnHasDictionary" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnHasDictionary path: String columnName: String rowGroup: Int64 -> (Result Bool String)" :pit (result effect))
(:sym "parquetKvMetadata" :mod "asl-parquet/footer" :kind fn! :sig "parquetKvMetadata path: String key: String -> (Result String String)" :pit (result effect))
(:sym "parquetColumnStatsInt64" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnStatsInt64 path: String columnName: String rowGroup: Int64 -> (Result Int64Stats String)" :pit (result effect))
(:sym "parquetColumnStatsFloat64" :mod "asl-parquet/footer" :kind fn! :sig "parquetColumnStatsFloat64 path: String columnName: String rowGroup: Int64 -> (Result Float64Stats String)" :pit (result effect))
(:sym "parquetMergeDecodes" :mod "asl-parquet/merge" :sig "parquetMergeDecodes m: Merge -> Int64")
(:sym "MergeRow" :mod "asl-parquet/merge" :kind type :sig "(schema MergeRow (:f source Int64) (:f ts Int64) (:f row Int64) (:f ints (List Int64)) (:f floats (List Float64)))" :pit (record))
(:sym "parquetMergeOpen" :mod "asl-parquet/merge" :kind fn! :sig "parquetMergeOpen paths: (List String) tsName: String intNames: (List String) floatNames: (List String) chunkRows: Int64 -> (Result Merge String)" :pit (result effect))
(:sym "parquetMergeNext" :mod "asl-parquet/merge" :kind fn! :sig "parquetMergeNext m: Merge -> (Result (Option (Pair MergeRow Merge)) String)" :pit (result effect))
(:sym "parquetMergeTake" :mod "asl-parquet/merge" :kind fn! :sig "parquetMergeTake m: Merge n: Int64 -> (Result (Pair (List MergeRow) Merge) String)" :pit (result effect))
(:sym "parquetMergeSourceCount" :mod "asl-parquet/merge" :sig "parquetMergeSourceCount m: Merge -> Int64")
(:sym "parquetMergeWindowRows" :mod "asl-parquet/merge" :sig "parquetMergeWindowRows m: Merge -> Int64")
(:sym "PqFile" :mod "asl-parquet/reader" :kind type :sig "(schema PqFile (:f path String) (:f size Int64) (:f rows Int64) (:f cols (List PqCol)) (:f groupRows (List Int64)) (:f chunks (List PqChunk)) (:f kv (List (Pair String String))))" :pit (record))
(:sym "PqCol" :mod "asl-parquet/reader" :kind type :sig "(schema PqCol (:f name String) (:f ptype Int64) (:f maxDef Int64) (:f int8 Bool))" :pit (record))
(:sym "PqCursor" :mod "asl-parquet/reader" :kind type :sig "(schema PqCursor (:f q PqFile) (:f col Int64) (:f rg Int64) (:f kind Int64) (:f pos Int64) (:f rowAt Int64) (:f dict Bytes) (:f ndict Int64) (:f pageAt Int64) (:f pageRows Int64) (:f cells Bytes) (:f decodes Int64))" :pit (record))
(:sym "parquetCursorI64" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorI64 h: PqFile name: String rg: Int64 -> (Result PqCursor String)" :pit (result effect))
(:sym "parquetCursorF64" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorF64 h: PqFile name: String rg: Int64 -> (Result PqCursor String)" :pit (result effect))
(:sym "parquetCursorI8" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorI8 h: PqFile name: String rg: Int64 -> (Result PqCursor String)" :pit (result effect))
(:sym "parquetCursorDecodes" :mod "asl-parquet/reader" :sig "parquetCursorDecodes cur: PqCursor -> Int64")
(:sym "parquetCursorReadI64" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorReadI64 cur: PqCursor start: Int64 count: Int64 -> (Result (Pair I64Array PqCursor) String)" :pit (result effect))
(:sym "parquetCursorReadF64" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorReadF64 cur: PqCursor start: Int64 count: Int64 -> (Result (Pair F64Array PqCursor) String)" :pit (result effect))
(:sym "parquetCursorReadI8" :mod "asl-parquet/reader" :kind fn! :sig "parquetCursorReadI8 cur: PqCursor start: Int64 count: Int64 -> (Result (Pair I8Array PqCursor) String)" :pit (result effect))
(:sym "parquetHasColumn" :mod "asl-parquet/reader" :sig "parquetHasColumn h: PqFile name: String -> Bool")
(:sym "parquetGroupRows" :mod "asl-parquet/reader" :sig "parquetGroupRows h: PqFile rg: Int64 -> Int64")
(:sym "parquetReadRangeF64" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadRangeF64 h: PqFile name: String rg: Int64 start: Int64 count: Int64 -> (Result F64Array String)" :pit (result effect))
(:sym "parquetReadRangeI64" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadRangeI64 h: PqFile name: String rg: Int64 start: Int64 count: Int64 -> (Result I64Array String)" :pit (result effect))
(:sym "parquetReadRangeI8" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadRangeI8 h: PqFile name: String rg: Int64 start: Int64 count: Int64 -> (Result I8Array String)" :pit (result effect))
(:sym "parquetOpen" :mod "asl-parquet/reader" :kind fn! :sig "parquetOpen path: String -> (Result PqFile String)" :pit (result effect))
(:sym "parquetNumRowGroups" :mod "asl-parquet/reader" :sig "parquetNumRowGroups h: PqFile -> Int64")
(:sym "parquetNumRows" :mod "asl-parquet/reader" :sig "parquetNumRows h: PqFile -> Int64")
(:sym "parquetColumnType" :mod "asl-parquet/reader" :sig "parquetColumnType h: PqFile name: String -> String")
(:sym "parquetReadF64" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadF64 h: PqFile name: String rg: Int64 -> F64Array" :pit (effect))
(:sym "parquetReadI64" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadI64 h: PqFile name: String rg: Int64 -> I64Array" :pit (effect))
(:sym "parquetReadI8" :mod "asl-parquet/reader" :kind fn! :sig "parquetReadI8 h: PqFile name: String rg: Int64 -> I8Array" :pit (effect))
(:sym "parquetKvMetadata" :mod "asl-parquet/reader" :sig "parquetKvMetadata h: PqFile key: String -> (Result String String)" :pit (result))
(:sym "pqLoadUAt" :mod "asl-parquet/reader" :sig "pqLoadUAt bs: Bytes at: Int64 n: Int64 acc: Int64 -> Int64")
(:sym "pqLoad64" :mod "asl-parquet/reader" :sig "pqLoad64 bs: Bytes i: Int64 -> Int64")
(:sym "parquetColumnRange" :mod "asl-parquet/reader" :sig "parquetColumnRange h: PqFile name: String rg: Int64 -> (Option (Pair Int64 Int64))" :pit (option))
(:sym "parquetWindowGroups" :mod "asl-parquet/reader" :sig "parquetWindowGroups h: PqFile name: String lo: Int64 hi: Int64 -> (List Int64)")
(:sym "parquetLowerBound" :mod "asl-parquet/reader" :sig "parquetLowerBound values: I64Array target: Int64 -> Int64")
