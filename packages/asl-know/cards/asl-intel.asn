(:card "asl-intel" :purpose "" :import "(asl-intel :a x)" :deps (asl-mem asl-text asl-runtime) :modules ((:m "asl-intel") (:m "aslIntel/codec" :doc "Token-Dense ASN S-Expression Codec for Code Intelligence") (:m "asl-intel/complexity") (:m "asl-intel/coupling") (:m "asl-intel/deadcode")) :moduleCount 33 :sigs ("runIntel! ctx: h/Ctx args: (List String) -> h/Outcome" "dispatchIntel! op: String target: String -> String" "makeCtx! -> h/Ctx" "makeCtxFor! workspaceRoot: String -> h/Ctx" "encodeSymbolAsn name: Str kind: Str loc: Str sig: Str exported: Bool -> Str" "encodeEdgeAsn src: Str dst: Str kind: Str -> Str" "encodeImpactAsn name: Str file: Str depth: I64 -> Str" "encodeAsnResponse tag: Str frames: (List Str) -> Str" "(schema ComplexityMetrics (:f low Int64) (:f moderate Int64) (:f high Int64) (:f extreme Int64))") :more (ModuleComplexity analyzeComplexity! runComplexity! ModInfo PkgInfo Scan CouplingResult scanCodebase! analyzeCoupling formatCouplingAsn formatCouplingSummary) :moreCount 363 :effects (runIntel! dispatchIntel! makeCtx! makeCtxFor! analyzeComplexity! runComplexity! scanCodebase! runCoupling!) :fails (analyzeComplexity! scanCodebase! analyzeDeadcode! walkIgnoring! trackedAsl! readAsn kwStr kwInt) :example none)
(:sym "runIntel!" :mod "asl-intel" :sig "runIntel! ctx: h/Ctx args: (List String) -> h/Outcome" :doc "IDIOMLINT: added the 'lint' subcommand alongside outline/deadcode/stubs/etc, dispatching to lintOp.asl#runLint!; a bare positional (non-flag) argument is its optional target file, parsed the same way as complexity's target." :pit (effect))
(:sym "dispatchIntel!" :mod "asl-intel" :sig "dispatchIntel! op: String target: String -> String" :doc "stdout of one subcommand run for callers" :pit (effect))
(:sym "makeCtx!" :mod "asl-intel" :sig "makeCtx! -> h/Ctx" :doc "context from ASL_INTEL_HOME, ASL_ROOT and cwd" :pit (effect))
(:sym "makeCtxFor!" :mod "asl-intel" :sig "makeCtxFor! workspaceRoot: String -> h/Ctx" :doc "CLI fallback when its invocation cwd has no intel workspace; an explicit ASL_INTEL_HOME is kept" :pit (effect))
