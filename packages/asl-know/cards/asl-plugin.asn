(:card "asl-plugin" :purpose "Dynamic target dispatch registry for AgentSlang pluggable backends (restored live slice of the modular plugin architecture)" :import "(asl-plugin/targetRegistry :a x)" :deps (asl-parser) :modules ((:m "asl-plugin/targetRegistry" :doc "Dynamic target dispatch and capability integration regis...")) :sigs ("(schema TargetRegistry (:field targets (Map Str (fn [(List a/TopForm) (Map Str Str)] -> (Result Str Str)))) (:field docstrings (Map Str Str)..." "emptyTargetRegistry -> TargetRegistry" "registerTarget reg: TargetRegistry name: Str doc: Str emitter: (fn [(List a/TopForm) (Map Str Str)] -> (Result Str Str)) -> TargetRegistry" "registerCodegenTarget reg: TargetRegistry name: Str emitter: (fn [(List a/TopForm) (Map Str Str)] -> (Result Str Str)) -> TargetRegistry" "hasTarget? reg: TargetRegistry name: Str -> Bool") :more (lookupTarget dispatchTargetCodegen listRegisteredTargets) :fails (TargetRegistry registerTarget registerCodegenTarget dispatchTargetCodegen) :example none)
(:sym "TargetRegistry" :mod "asl-plugin/targetRegistry" :kind type :sig "(schema TargetRegistry (:field targets (Map Str (fn [(List a/TopForm) (Map Str Str)] -> (Result Str Str)))) (:field docstrings (Map Str Str)))" :pit (result))
(:sym "emptyTargetRegistry" :mod "asl-plugin/targetRegistry" :sig "emptyTargetRegistry -> TargetRegistry")
(:sym "registerTarget" :mod "asl-plugin/targetRegistry" :sig "registerTarget reg: TargetRegistry name: Str doc: Str emitter: (fn [(List a/TopForm) (Map Str Str)] -> (Result Str Str)) -> TargetRegistry" :pit (result))
(:sym "registerCodegenTarget" :mod "asl-plugin/targetRegistry" :sig "registerCodegenTarget reg: TargetRegistry name: Str emitter: (fn [(List a/TopForm) (Map Str Str)] -> (Result Str Str)) -> TargetRegistry" :pit (result))
(:sym "hasTarget?" :mod "asl-plugin/targetRegistry" :sig "hasTarget? reg: TargetRegistry name: Str -> Bool")
(:sym "lookupTarget" :mod "asl-plugin/targetRegistry" :sig "lookupTarget reg: TargetRegistry name: Str -> (Option (fn [(List a/TopForm) (Map Str Str)] -> (Result Str Str)))" :pit (option))
(:sym "dispatchTargetCodegen" :mod "asl-plugin/targetRegistry" :sig "dispatchTargetCodegen reg: TargetRegistry target: Str forms: (List a/TopForm) options: (Map Str Str) -> (Result Str Str)" :pit (result))
(:sym "listRegisteredTargets" :mod "asl-plugin/targetRegistry" :sig "listRegisteredTargets reg: TargetRegistry -> (List Str)")
