(:card "asl-contracts" :purpose "AgentSlang Verifiable Smart Contracts Engine: pure state transitions, SMT formal safety proofs, and Wasm Stylus ABI" :import "(aslContracts/spec :a x)" :modules ((:m "aslContracts/spec" :doc "AgentSlang Verifiable Smart Contract Specification: pure...") (:m "aslContracts/stage" :doc "AgentSlang Pipeline Stage Contract Specification for det...") (:m "aslContracts/toolPlane" :doc "AgentSlang Tool Control Plane Contract Specification: mu...")) :sigs ("(schema BlockContext (:f sender Str) (:f value I64) (:f timestamp I64) (:f height I64))" "(schema ContractEvent (:f name Str) (:f data Str))" "(schema TransitionResult (:f success Bool) (:f events (List ContractEvent)) (:f errorMsg Str))" "isValidAddress addr: Str -> Bool" "makeBlockContext sender: Str value: I64 timestamp: I64 height: I64 -> BlockContext" "transitionSuccess events: (List ContractEvent) -> TransitionResult" "transitionRevert reason: Str -> TransitionResult" "validateNonNegativeBalance amount: I64 -> Bool") :more (PipelineStage StageStatus StageContract makeStageContract stageTransition stageSetOutput stageSetError isStageTerminal? isStageSuccessful?) :moreCount 24 :example none)
(:sym "BlockContext" :mod "aslContracts/spec" :kind type :sig "(schema BlockContext (:f sender Str) (:f value I64) (:f timestamp I64) (:f height I64))" :pit (record))
(:sym "ContractEvent" :mod "aslContracts/spec" :kind type :sig "(schema ContractEvent (:f name Str) (:f data Str))" :pit (record))
(:sym "TransitionResult" :mod "aslContracts/spec" :kind type :sig "(schema TransitionResult (:f success Bool) (:f events (List ContractEvent)) (:f errorMsg Str))" :pit (record))
(:sym "isValidAddress" :mod "aslContracts/spec" :sig "isValidAddress addr: Str -> Bool")
(:sym "makeBlockContext" :mod "aslContracts/spec" :sig "makeBlockContext sender: Str value: I64 timestamp: I64 height: I64 -> BlockContext")
(:sym "transitionSuccess" :mod "aslContracts/spec" :sig "transitionSuccess events: (List ContractEvent) -> TransitionResult")
(:sym "transitionRevert" :mod "aslContracts/spec" :sig "transitionRevert reason: Str -> TransitionResult")
(:sym "validateNonNegativeBalance" :mod "aslContracts/spec" :sig "validateNonNegativeBalance amount: I64 -> Bool")
(:sym "PipelineStage" :mod "aslContracts/stage" :kind type :sig "(enum PipelineStage (:c stageScript [] \"Script generation and topic breakdown stage\") (:c stageAudio [] \"Voiceover synthesis and audio alignment stage\") (:c stageVisuals [] \"Asset sourcing, image generation and captioning stage\") (:c stageRender [] \"Video composition and rendering stage\") (:c stageP ...")
(:sym "StageStatus" :mod "aslContracts/stage" :kind type :sig "(enum StageStatus (:c statusPending [] \"Stage is queued awaiting preconditions\") (:c statusRunning [] \"Stage is currently executing\") (:c statusCompleted [] \"Stage completed successfully\") (:c statusFailed [] \"Stage execution failed with an error\"))")
(:sym "StageContract" :mod "aslContracts/stage" :kind type :sig "(schema StageContract (:f id Str) (:f stage PipelineStage) (:f status StageStatus) (:f inputs (Map Str Str)) (:f outputs (Map Str Str)) (:f errorMsg Str))" :pit (record))
(:sym "makeStageContract" :mod "aslContracts/stage" :sig "makeStageContract id: Str stage: PipelineStage -> StageContract")
(:sym "stageTransition" :mod "aslContracts/stage" :sig "stageTransition contract: StageContract newStatus: StageStatus -> StageContract")
(:sym "stageSetOutput" :mod "aslContracts/stage" :sig "stageSetOutput contract: StageContract key: Str val: Str -> StageContract")
(:sym "stageSetError" :mod "aslContracts/stage" :sig "stageSetError contract: StageContract err: Str -> StageContract")
(:sym "isStageTerminal?" :mod "aslContracts/stage" :sig "isStageTerminal? status: StageStatus -> Bool")
(:sym "isStageSuccessful?" :mod "aslContracts/stage" :sig "isStageSuccessful? contract: StageContract -> Bool")
(:sym "validateStageContract" :mod "aslContracts/stage" :sig "validateStageContract contract: StageContract -> Bool")
(:sym "ToolSafety" :mod "aslContracts/toolPlane" :kind type :sig "(enum ToolSafety (:c safetySafe [] \"Auto-run tool with zero mutation risk or isolated read-only sandbox\") (:c safetyGuarded [] \"Tool requires workspace sandbox boundary enforcement\") (:c safetyDangerous [] \"Destructive or privileged tool requiring operator confirmation\"))")
(:sym "ToolDescriptor" :mod "aslContracts/toolPlane" :kind type :sig "(schema ToolDescriptor (:f id Str) (:f name Str) (:f doc Str) (:f guidance Str) (:f scope (List Str)) (:f agents (List Str)) (:f safety ToolSafety) (:f cmd Str) (:f args (List Str)) (:f env (Map Str Str)) (:f secrets (List SecretRef)) (:f redacted Bool))" :pit (record))
(:sym "SecretRef" :mod "aslContracts/toolPlane" :kind type :sig "(schema SecretRef (:f key Str) (:f source Str) (:f ref Str) (:f fallback Str))" :pit (record))
(:sym "ToolRunbook" :mod "aslContracts/toolPlane" :kind type :sig "(schema ToolRunbook (:f id Str) (:f title Str) (:f steps (List Str)))" :pit (record))
(:sym "ToolScopeContext" :mod "aslContracts/toolPlane" :kind type :sig "(schema ToolScopeContext (:f activeRepo Str) (:f agentRole Str) (:f safetyCeiling ToolSafety))" :pit (record))
(:sym "safetySafe" :mod "aslContracts/toolPlane" :kind ctor :sig "(:c safetySafe [] \"Auto-run tool with zero mutation risk or isolated read-only sandbox\") of ToolSafety" :pit (ctor))
(:sym "safetyGuarded" :mod "aslContracts/toolPlane" :kind ctor :sig "(:c safetyGuarded [] \"Tool requires workspace sandbox boundary enforcement\") of ToolSafety" :pit (ctor))
(:sym "safetyDangerous" :mod "aslContracts/toolPlane" :kind ctor :sig "(:c safetyDangerous [] \"Destructive or privileged tool requiring operator confirmation\")) of ToolSafety" :pit (ctor))
(:sym "makeSecretRef" :mod "aslContracts/toolPlane" :sig "makeSecretRef key: Str source: Str ref: Str fallback: Str -> SecretRef")
(:sym "makeToolDescriptor" :mod "aslContracts/toolPlane" :sig "makeToolDescriptor id: Str name: Str doc: Str guidance: Str scope: (List Str) agents: (List Str) safety: ToolSafety cmd: Str args: (List Str) env: (Map Str Str) secrets: (List SecretRef) -> ToolDescriptor")
(:sym "makeRunbook" :mod "aslContracts/toolPlane" :sig "makeRunbook id: Str title: Str steps: (List Str) -> ToolRunbook")
(:sym "makeScopeContext" :mod "aslContracts/toolPlane" :sig "makeScopeContext activeRepo: Str agentRole: Str safetyCeiling: ToolSafety -> ToolScopeContext")
(:sym "isToolInScope?" :mod "aslContracts/toolPlane" :sig "isToolInScope? tool: ToolDescriptor repo: Str -> Bool")
(:sym "isAgentAuthorized?" :mod "aslContracts/toolPlane" :sig "isAgentAuthorized? tool: ToolDescriptor role: Str -> Bool")
(:sym "isSafetyPermitted?" :mod "aslContracts/toolPlane" :sig "isSafetyPermitted? tool: ToolDescriptor ceiling: ToolSafety -> Bool")
(:sym "maskToolSecrets" :mod "aslContracts/toolPlane" :sig "maskToolSecrets tool: ToolDescriptor -> ToolDescriptor")
(:sym "validateToolDescriptor" :mod "aslContracts/toolPlane" :sig "validateToolDescriptor tool: ToolDescriptor -> Bool")
(:sym "toolMemQuery" :mod "aslContracts/toolPlane" :sig "toolMemQuery -> ToolDescriptor")
(:sym "toolMemEdit" :mod "aslContracts/toolPlane" :sig "toolMemEdit -> ToolDescriptor")
(:sym "toolMemDiff" :mod "aslContracts/toolPlane" :sig "toolMemDiff -> ToolDescriptor")
(:sym "toolMemFlush" :mod "aslContracts/toolPlane" :sig "toolMemFlush -> ToolDescriptor")
(:sym "toolMemDiscard" :mod "aslContracts/toolPlane" :sig "toolMemDiscard -> ToolDescriptor")
(:sym "toolMemWrite" :mod "aslContracts/toolPlane" :sig "toolMemWrite -> ToolDescriptor")
(:sym "toolMemDoc" :mod "aslContracts/toolPlane" :sig "toolMemDoc -> ToolDescriptor")
(:sym "toolMemTree" :mod "aslContracts/toolPlane" :sig "toolMemTree -> ToolDescriptor")
(:sym "canonicalMemToolDescriptors" :mod "aslContracts/toolPlane" :sig "canonicalMemToolDescriptors -> (List ToolDescriptor)")
