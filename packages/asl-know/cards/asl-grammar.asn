(:card "asl-grammar" :purpose "The single ASL grammar (asl/grammar/aslGrammar.asn): loader, grammar-driven recognizer and GBNF generator" :import "(asl-grammar/peg :a x)" :modules ((:m "asl-grammar/peg" :doc "Loads a grammar written as ASN rules (asl/grammar/aslGra...") (:m "asl-grammar/asn" :doc "Bootstrap reader for the ASN subset that grammar and cor...") (:m "asl-grammar/asnData" :doc "ASN data text as typed values for config readers: reads ...") (:m "asl-grammar/gbnf" :doc "Generates a GBNF grammar (llama.cpp grammars/README.md, ...") (:m "asl-grammar/sample" :doc "Random texts derived from a grammar read as a context-fr...")) :sigs ("(enum Pe (:c peCat [(first Pe) (rest Pe)] \"first, then rest from where it stopped.\") (:c peOr [(first Pe) (rest Pe)] \"first, or rest from th..." "(enum RuleTree (:c ruleLeaf [] \"No rule.\") (:c ruleNode [(left RuleTree) (index Int64) (body Pe) (right RuleTree)] \"A search tree of compile..." "(schema GrammarRule (:f name String) (:f expr asn/Sx) (:f doc String))" "(schema Grammar (:f name String) (:f start String) (:f boundary String) (:f rules (List GrammarRule)) (:f table RuleTree) (:f entry Pe))" "grammarParse text: String -> (Result Grammar String)") :more (grammarLoad! grammarBuild grammarRecognize grammarAccepts? grammarRuleNames grammarDisable grammarRemove grammarWithStart grammarReachable grammarSalvage) :moreCount 24 :effects (grammarLoad!) :fails (grammarParse grammarLoad! grammarBuild grammarRecognize grammarDisable grammarRemove grammarWithStart asnReadAll) :example none)
(:sym "Pe" :mod "asl-grammar/peg" :kind type :sig "(enum Pe (:c peCat [(first Pe) (rest Pe)] \"first, then rest from where it stopped.\") (:c peOr [(first Pe) (rest Pe)] \"first, or rest from the same place when first fails.\") (:c peEmpty [] \"Matches nothing and succeeds.\") (:c peFail [] \"Always fails.\") (:c peStar [(body Pe)] \"Zero or more, greedy.\")  ...")
(:sym "RuleTree" :mod "asl-grammar/peg" :kind type :sig "(enum RuleTree (:c ruleLeaf [] \"No rule.\") (:c ruleNode [(left RuleTree) (index Int64) (body Pe) (right RuleTree)] \"A search tree of compiled recursive rules by index.\"))")
(:sym "GrammarRule" :mod "asl-grammar/peg" :kind type :sig "(schema GrammarRule (:f name String) (:f expr asn/Sx) (:f doc String))" :pit (record))
(:sym "Grammar" :mod "asl-grammar/peg" :kind type :sig "(schema Grammar (:f name String) (:f start String) (:f boundary String) (:f rules (List GrammarRule)) (:f table RuleTree) (:f entry Pe))" :pit (record))
(:sym "grammarParse" :mod "asl-grammar/peg" :sig "grammarParse text: String -> (Result Grammar String)" :doc "A grammar from the text of a (:grammar :name n :start rule :wordBoundary rule :rules [(:rule ...) ...]) file." :pit (result))
(:sym "grammarLoad!" :mod "asl-grammar/peg" :kind fn! :sig "grammarLoad! path: String -> (Result Grammar String)" :doc "The grammar in the file at path." :pit (result effect))
(:sym "grammarBuild" :mod "asl-grammar/peg" :sig "grammarBuild name: String start: String boundary: String rules: (List GrammarRule) -> (Result Grammar String)" :doc "Compiles rules into a recognizer: rules that reach themselves stay references, all others are inlined; an unknown rule name, a duplicate or a malformed form is an error." :pit (result))
(:sym "grammarRecognize" :mod "asl-grammar/peg" :sig "grammarRecognize g: Grammar text: String -> (Result Int64 String)" :doc "ok with the text's byte length when the start rule matches all of it; err line:col of the furthest failure otherwise." :pit (result))
(:sym "grammarAccepts?" :mod "asl-grammar/peg" :sig "grammarAccepts? g: Grammar text: String -> Bool" :doc "Whether the grammar's start rule matches the whole text.")
(:sym "grammarRuleNames" :mod "asl-grammar/peg" :sig "grammarRuleNames g: Grammar -> (List String)" :doc "Rule names in file order.")
(:sym "grammarDisable" :mod "asl-grammar/peg" :sig "grammarDisable g: Grammar name: String -> (Result Grammar String)" :doc "The grammar with one rule's body replaced by a choice of nothing, so the rule never matches: a mutant for coverage tests." :pit (result))
(:sym "grammarRemove" :mod "asl-grammar/peg" :sig "grammarRemove g: Grammar name: String -> (Result Grammar String)" :doc "The grammar without one rule; compiling fails when another rule still names it." :pit (result))
(:sym "grammarWithStart" :mod "asl-grammar/peg" :sig "grammarWithStart g: Grammar start: String -> (Result Grammar String)" :doc "The same rules recognizing from another start rule." :pit (result))
(:sym "grammarReachable" :mod "asl-grammar/peg" :sig "grammarReachable g: Grammar start: String -> (List String)" :doc "The rules start reaches, start first, then in file order.")
(:sym "grammarSalvage" :mod "asl-grammar/peg" :sig "grammarSalvage g: Grammar text: String -> (Option String)" :doc "text when the start rule accepts it, else its longest prefix that ends at a line break before a column-0 line and is accepted: the contract for a generation cut at max_tokens, which drops the unfinished item instead of guessing closers." :pit (option))
(:sym "exprRefs" :mod "asl-grammar/peg" :sig "exprRefs e: asn/Sx -> (List String)")
(:sym "classRanges" :mod "asl-grammar/peg" :sig "classRanges spec: String -> (List (Pair Int64 Int64))" :doc "The byte ranges a class spec names: a-z is a range, any other byte stands for itself.")
(:sym "classTable" :mod "asl-grammar/peg" :sig "classTable spec: String negate: Bool -> Bytes")
(:sym "Sx" :mod "asl-grammar/asn" :kind type :sig "(enum Sx (:c sxList [(items (List Sx))] \"A parenthesised form.\") (:c sxVec [(items (List Sx))] \"A bracketed vector.\") (:c sxKw [(name String)] \"A keyword, without its colon.\") (:c sxSym [(name String)] \"A symbol.\") (:c sxStr [(text String)] \"A string with its escapes resolved.\") (:c sxInt [(value In ...")
(:sym "asnReadAll" :mod "asl-grammar/asn" :sig "asnReadAll text: String -> (Result (List Sx) String)" :doc "Every top-level datum of the text, or the first read error with its byte offset." :pit (result))
(:sym "asnKeyValue" :mod "asl-grammar/asn" :sig "asnKeyValue items: (List Sx) key: String -> (Option Sx)" :doc "The element after the keyword :key in a form's items, none when the key is absent or last." :pit (option))
(:sym "asnKeyString" :mod "asl-grammar/asn" :sig "asnKeyString items: (List Sx) key: String -> (Option String)" :doc "The string or symbol after :key, none otherwise." :pit (option))
(:sym "AsnValue" :mod "asl-grammar/asnData" :kind type :sig "(enum AsnValue (:c asnKw [(name String)] \"A keyword, without its colon.\") (:c asnSym [(name String)] \"A symbol.\") (:c asnStr [(text String)] \"A string with its escapes resolved.\") (:c asnI64 [(value Int64)] \"A decimal integer.\") (:c asnF64 [(value Float64)] \"A decimal with a point or an exponent.\")  ..." :doc "A typed ASN value: keyword, symbol, string, Int64, Float64, Bool, list or vector.")
(:sym "asnParse" :mod "asl-grammar/asnData" :sig "asnParse text: String -> (Result AsnValue String)" :doc "Exactly one value from the text; a read error is ERR_ASN_READ with its byte offset, no value ERR_ASN_EMPTY, more than one ERR_ASN_TRAILING." :pit (result))
(:sym "asnParseAll" :mod "asl-grammar/asnData" :sig "asnParseAll text: String -> (Result (List AsnValue) String)" :doc "Every top-level value of the text, or ERR_ASN_READ with the reader's message and byte offset." :pit (result))
(:sym "asnField" :mod "asl-grammar/asnData" :sig "asnField v: AsnValue key: String -> (Option AsnValue)" :doc "The value after :key at the top level of a list or vector, found by walking the form: a keyword takes the next item as its value when it is a non-keyword, or a keyword followed by a keyword or the end ((:status :open :do x) gives :open); ot..." :pit (option))
(:sym "asnFieldRaw" :mod "asl-grammar/asnData" :sig "asnFieldRaw v: AsnValue key: String -> (Option AsnValue)" :doc "The raw item right after :key at its key position in the asnField walk, none when the key is absent or ends the form." :pit (option))
(:sym "asnItems" :mod "asl-grammar/asnData" :sig "asnItems v: AsnValue -> (List AsnValue)" :doc "The items of a list or vector, empty for any other value.")
(:sym "asnString" :mod "asl-grammar/asnData" :sig "asnString v: AsnValue -> (Option String)" :doc "The text of a string or symbol, none otherwise." :pit (option))
(:sym "asnInt" :mod "asl-grammar/asnData" :sig "asnInt v: AsnValue -> (Option Int64)" :doc "The Int64 of an integer, none otherwise." :pit (option))
(:sym "asnFloat" :mod "asl-grammar/asnData" :sig "asnFloat v: AsnValue -> (Option Float64)" :doc "The Float64 of a decimal, or of an integer widened, none otherwise." :pit (option))
(:sym "asnBool" :mod "asl-grammar/asnData" :sig "asnBool v: AsnValue -> (Option Bool)" :doc "The Bool of true or false, none otherwise." :pit (option))
(:sym "asnKeyword" :mod "asl-grammar/asnData" :sig "asnKeyword v: AsnValue -> (Option String)" :doc "The name of a keyword without its colon, none otherwise." :pit (option))
(:sym "asnRender" :mod "asl-grammar/asnData" :sig "asnRender v: AsnValue -> String" :doc "Canonical ASN text of a value: single spaces, strings quoted with their escapes; asnParse of it gives the same value.")
(:sym "grammarGbnf" :mod "asl-grammar/gbnf" :sig "grammarGbnf g: peg/Grammar -> (Result String String)" :doc "GBNF for the grammar's start rule." :pit (result))
(:sym "grammarGbnfFrom" :mod "asl-grammar/gbnf" :sig "grammarGbnfFrom g: peg/Grammar start: String -> (Result String String)" :doc "GBNF for the rules start reaches: root names start, one line per rule, and an except rule as a trie of the names it leaves out." :pit (result))
(:sym "gbnfRuleName" :mod "asl-grammar/gbnf" :sig "gbnfRuleName name: String -> String" :doc "A rule name as GBNF wants it, a dashed lowercase word: atomChar becomes atom-char.")
(:sym "grammarSample" :mod "asl-grammar/sample" :sig "grammarSample g: peg/Grammar start: String seed: Int64 count: Int64 budget: Int64 -> (List String)" :doc "count texts derived from start with the given seed; budget is the rule-reference depth after which choices go shallowest.")
(:sym "ruleHeights" :mod "asl-grammar/sample" :sig "ruleHeights g: peg/Grammar -> (List (Pair String Int64))" :doc "Each rule's shallowest derivation depth in rule references, by fixed-point iteration.")
