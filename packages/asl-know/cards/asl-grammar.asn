(:card "asl-grammar" :purpose "The single ASL grammar (asl/grammar/aslGrammar.asn): loader, grammar-driven recognizer and GBNF generator" :import "(asl-grammar/peg :a x)" :modules ((:m "asl-grammar/peg") (:m "asl-grammar/asn") (:m "asl-grammar/asnData") (:m "asl-grammar/gbnf") (:m "asl-grammar/sample")) :sigs ("(enum Pe (:c peCat [(first Pe) (rest Pe)] \"first, then rest from where it stopped.\") (:c peOr [(first Pe) (rest Pe)] \"first, or rest from th..." "(enum RuleTree (:c ruleLeaf [] \"No rule.\") (:c ruleNode [(left RuleTree) (index Int64) (body Pe) (right RuleTree)] \"A search tree of compile..." "(schema GrammarRule (:f name String) (:f expr asn/Sx) (:f doc String))" "(schema Grammar (:f name String) (:f start String) (:f boundary String) (:f rules (List GrammarRule)) (:f table RuleTree) (:f entry Pe))" "grammarParse text: String -> (Result Grammar String)") :more (grammarLoad! grammarBuild grammarRecognize grammarAccepts? grammarRuleNames grammarDisable grammarRemove grammarWithStart grammarReachable grammarSalvage) :moreCount 24 :effects (grammarLoad!) :fails (grammarParse grammarLoad! grammarBuild grammarRecognize grammarDisable grammarRemove grammarWithStart asnReadAll) :example none)
(:sym "Pe" :mod "asl-grammar/peg" :kind type :sig "(enum Pe (:c peCat [(first Pe) (rest Pe)] \"first, then rest from where it stopped.\") (:c peOr [(first Pe) (rest Pe)] \"first, or rest from the same place when first fails.\") (:c peEmpty [] \"Matches nothing and succeeds.\") (:c peFail [] \"Always fails.\") (:c peStar [(body Pe)] \"Zero or more, greedy.\")  ...")
(:sym "RuleTree" :mod "asl-grammar/peg" :kind type :sig "(enum RuleTree (:c ruleLeaf [] \"No rule.\") (:c ruleNode [(left RuleTree) (index Int64) (body Pe) (right RuleTree)] \"A search tree of compiled recursive rules by index.\"))")
(:sym "GrammarRule" :mod "asl-grammar/peg" :kind type :sig "(schema GrammarRule (:f name String) (:f expr asn/Sx) (:f doc String))" :pit (record))
(:sym "Grammar" :mod "asl-grammar/peg" :kind type :sig "(schema Grammar (:f name String) (:f start String) (:f boundary String) (:f rules (List GrammarRule)) (:f table RuleTree) (:f entry Pe))" :pit (record))
(:sym "grammarParse" :mod "asl-grammar/peg" :sig "grammarParse text: String -> (Result Grammar String)" :pit (result))
(:sym "grammarLoad!" :mod "asl-grammar/peg" :kind fn! :sig "grammarLoad! path: String -> (Result Grammar String)" :pit (result effect))
(:sym "grammarBuild" :mod "asl-grammar/peg" :sig "grammarBuild name: String start: String boundary: String rules: (List GrammarRule) -> (Result Grammar String)" :pit (result))
(:sym "grammarRecognize" :mod "asl-grammar/peg" :sig "grammarRecognize g: Grammar text: String -> (Result Int64 String)" :pit (result))
(:sym "grammarAccepts?" :mod "asl-grammar/peg" :sig "grammarAccepts? g: Grammar text: String -> Bool")
(:sym "grammarRuleNames" :mod "asl-grammar/peg" :sig "grammarRuleNames g: Grammar -> (List String)")
(:sym "grammarDisable" :mod "asl-grammar/peg" :sig "grammarDisable g: Grammar name: String -> (Result Grammar String)" :pit (result))
(:sym "grammarRemove" :mod "asl-grammar/peg" :sig "grammarRemove g: Grammar name: String -> (Result Grammar String)" :pit (result))
(:sym "grammarWithStart" :mod "asl-grammar/peg" :sig "grammarWithStart g: Grammar start: String -> (Result Grammar String)" :pit (result))
(:sym "grammarReachable" :mod "asl-grammar/peg" :sig "grammarReachable g: Grammar start: String -> (List String)")
(:sym "grammarSalvage" :mod "asl-grammar/peg" :sig "grammarSalvage g: Grammar text: String -> (Option String)" :pit (option))
(:sym "exprRefs" :mod "asl-grammar/peg" :sig "exprRefs e: asn/Sx -> (List String)")
(:sym "classRanges" :mod "asl-grammar/peg" :sig "classRanges spec: String -> (List (Pair Int64 Int64))")
(:sym "classTable" :mod "asl-grammar/peg" :sig "classTable spec: String negate: Bool -> Bytes")
(:sym "Sx" :mod "asl-grammar/asn" :kind type :sig "(enum Sx (:c sxList [(items (List Sx))] \"A parenthesised form.\") (:c sxVec [(items (List Sx))] \"A bracketed vector.\") (:c sxKw [(name String)] \"A keyword, without its colon.\") (:c sxSym [(name String)] \"A symbol.\") (:c sxStr [(text String)] \"A string with its escapes resolved.\") (:c sxInt [(value In ...")
(:sym "asnReadAll" :mod "asl-grammar/asn" :sig "asnReadAll text: String -> (Result (List Sx) String)" :pit (result))
(:sym "asnKeyValue" :mod "asl-grammar/asn" :sig "asnKeyValue items: (List Sx) key: String -> (Option Sx)" :pit (option))
(:sym "asnKeyString" :mod "asl-grammar/asn" :sig "asnKeyString items: (List Sx) key: String -> (Option String)" :pit (option))
(:sym "AsnValue" :mod "asl-grammar/asnData" :kind type :sig "(enum AsnValue (:c asnKw [(name String)] \"A keyword, without its colon.\") (:c asnSym [(name String)] \"A symbol.\") (:c asnStr [(text String)] \"A string with its escapes resolved.\") (:c asnI64 [(value Int64)] \"A decimal integer.\") (:c asnF64 [(value Float64)] \"A decimal with a point or an exponent.\")  ...")
(:sym "asnParse" :mod "asl-grammar/asnData" :sig "asnParse text: String -> (Result AsnValue String)" :pit (result))
(:sym "asnParseAll" :mod "asl-grammar/asnData" :sig "asnParseAll text: String -> (Result (List AsnValue) String)" :pit (result))
(:sym "asnField" :mod "asl-grammar/asnData" :sig "asnField v: AsnValue key: String -> (Option AsnValue)" :pit (option))
(:sym "asnFieldRaw" :mod "asl-grammar/asnData" :sig "asnFieldRaw v: AsnValue key: String -> (Option AsnValue)" :pit (option))
(:sym "asnItems" :mod "asl-grammar/asnData" :sig "asnItems v: AsnValue -> (List AsnValue)")
(:sym "asnString" :mod "asl-grammar/asnData" :sig "asnString v: AsnValue -> (Option String)" :pit (option))
(:sym "asnInt" :mod "asl-grammar/asnData" :sig "asnInt v: AsnValue -> (Option Int64)" :pit (option))
(:sym "asnFloat" :mod "asl-grammar/asnData" :sig "asnFloat v: AsnValue -> (Option Float64)" :pit (option))
(:sym "asnBool" :mod "asl-grammar/asnData" :sig "asnBool v: AsnValue -> (Option Bool)" :pit (option))
(:sym "asnKeyword" :mod "asl-grammar/asnData" :sig "asnKeyword v: AsnValue -> (Option String)" :pit (option))
(:sym "asnRender" :mod "asl-grammar/asnData" :sig "asnRender v: AsnValue -> String")
(:sym "grammarGbnf" :mod "asl-grammar/gbnf" :sig "grammarGbnf g: peg/Grammar -> (Result String String)" :pit (result))
(:sym "grammarGbnfFrom" :mod "asl-grammar/gbnf" :sig "grammarGbnfFrom g: peg/Grammar start: String -> (Result String String)" :pit (result))
(:sym "gbnfRuleName" :mod "asl-grammar/gbnf" :sig "gbnfRuleName name: String -> String")
(:sym "grammarSample" :mod "asl-grammar/sample" :sig "grammarSample g: peg/Grammar start: String seed: Int64 count: Int64 budget: Int64 -> (List String)")
(:sym "ruleHeights" :mod "asl-grammar/sample" :sig "ruleHeights g: peg/Grammar -> (List (Pair String Int64))")
