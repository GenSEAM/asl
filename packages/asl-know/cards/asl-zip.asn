(:card "asl-zip" :purpose "Pure AgentSlang RFC 1951 DEFLATE and RFC 1952 gzip readers and writers, plus ZIP writing" :import "(asl-zip/gzip :a x)" :modules ((:m "asl-zip/gzip" :doc "RFC 1952 pure-ASL gzip decoder and CRC-32") (:m "asl-zip/deflate" :doc "Pure AgentScript RFC 1951 encoder") (:m "asl-zip/gzipWriter" :doc "RFC 1952 gzip member encoder") (:m "asl-zip/inflate" :doc "Pure AgentSlang RFC 1951 DEFLATE decoder") (:m "asl-zip/zipWriter" :doc "Pure-ASL ZIP archive writer for stored and DEFLATE entri...")) :sigs ("gunzip! data: Bytes -> (Result Bytes String)" "gunzipWithLimit! data: Bytes limit: Int64 -> (Result Bytes String)" "crc32 data: Bytes -> Int64" "inflate! data: Bytes -> (Result Bytes String)" "deflate! data: Bytes -> (Result Bytes String)" "deflateWithLevel! data: Bytes level: Int64 -> (Result Bytes String)" "deflateBitWrite! out: Bytes pos: Int64 bit: Int64 -> (Result Int64 String)" "gzip! data: Bytes level: Int64 -> (Result Bytes String)" "crc32! data: Bytes -> Int64" "inflateInternal! data: Bytes startOffset: Int64 -> (Result InflateResult String)") :more (inflateAppend! ZipEntry zipArchive!) :effects (gunzip! gunzipWithLimit! crc32 inflate! deflate! deflateWithLevel! deflateBitWrite! gzip!) :fails (gunzip! gunzipWithLimit! inflate! deflate! deflateWithLevel! deflateBitWrite! gzip! inflateInternal!) :example "(module asl-know/examples/aslZip :x [gunzipText! selfTest] :i [(asl-zip/gzip :a z) (asl-syntax/core/bytesText :a bt)])\n\nfn ! gunzipText! data: Bytes -> String\n  (match (z/gunzip! data)\n    ((err e) (str \"error: \" e))\n    ((ok out) (stringTrim (bt/bytesToString out))))")
(:sym "gunzip!" :mod "asl-zip/gzip" :sig "gunzip! data: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "gunzipWithLimit!" :mod "asl-zip/gzip" :sig "gunzipWithLimit! data: Bytes limit: Int64 -> (Result Bytes String)" :doc "output above limit bytes is an Err" :pit (result effect))
(:sym "crc32" :mod "asl-zip/gzip" :kind fn! :sig "crc32 data: Bytes -> Int64" :pit (effect))
(:sym "inflate!" :mod "asl-zip/gzip" :sig "inflate! data: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "deflate!" :mod "asl-zip/deflate" :sig "deflate! data: Bytes -> (Result Bytes String)" :doc "deflateWithLevel! at level 6" :pit (result effect))
(:sym "deflateWithLevel!" :mod "asl-zip/deflate" :sig "deflateWithLevel! data: Bytes level: Int64 -> (Result Bytes String)" :doc "Encodes at level 0 (stored), 1 (fast) or 6 (dynamic Huffman with LZ77); an Err for any other level" :pit (result effect))
(:sym "deflateBitWrite!" :mod "asl-zip/deflate" :sig "deflateBitWrite! out: Bytes pos: Int64 bit: Int64 -> (Result Int64 String)" :doc "Appends one bit at pos, growing out's backing capacity as needed" :pit (result effect))
(:sym "gzip!" :mod "asl-zip/gzipWriter" :sig "gzip! data: Bytes level: Int64 -> (Result Bytes String)" :doc "Wraps deflateWithLevel! in a gzip member: header, CRC-32 trailer and ISIZE" :pit (result effect))
(:sym "crc32!" :mod "asl-zip/gzipWriter" :sig "crc32! data: Bytes -> Int64" :doc "Builds its own 256-entry table, then the CRC-32 of data" :pit (effect))
(:sym "inflate!" :mod "asl-zip/inflate" :sig "inflate! data: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "inflateInternal!" :mod "asl-zip/inflate" :sig "inflateInternal! data: Bytes startOffset: Int64 -> (Result InflateResult String)" :pit (result effect))
(:sym "inflateAppend!" :mod "asl-zip/inflate" :sig "inflateAppend! data: Bytes start: Int64 out: Bytes op: Int64 limit: Int64 -> (Result InflateState String)" :doc "decode into out from op, capped at limit" :pit (result effect))
(:sym "ZipEntry" :mod "asl-zip/zipWriter" :kind type :sig "(schema ZipEntry (:f name String) (:f data Bytes) (:f method Int64))" :doc "One archive entry to write: name, uncompressed data and method" :pit (record))
(:sym "zipArchive!" :mod "asl-zip/zipWriter" :sig "zipArchive! entries: (List ZipEntry) level: Int64 -> (Result Bytes String)" :doc "Encodes entries at level into a ZIP archive's bytes; Err on invalid level or over the zip64Required limits" :pit (result effect))
