(:card "asl-zip" :purpose "Pure AgentSlang RFC 1951 DEFLATE and RFC 1952 gzip decoder" :import "(asl-zip/gzip :a x)" :modules ((:m "asl-zip/gzip" :doc "RFC 1952 pure-ASL gzip decoder and CRC-32") (:m "asl-zip/inflate" :doc "Pure AgentSlang RFC 1951 DEFLATE decoder")) :sigs ("gunzip! data: Bytes -> (Result Bytes String)" "gunzipWithLimit! data: Bytes limit: Int64 -> (Result Bytes String)" "crc32 data: Bytes -> Int64" "inflate! data: Bytes -> (Result Bytes String)" "inflateInternal! data: Bytes startOffset: Int64 -> (Result InflateResult String)" "inflateAppend! data: Bytes start: Int64 out: Bytes op: Int64 limit: Int64 -> (Result InflateState String)") :effects (gunzip! gunzipWithLimit! crc32 inflate! inflateInternal! inflateAppend!) :fails (gunzip! gunzipWithLimit! inflate! inflateInternal! inflateAppend!) :example "(module asl-know/examples/aslZip :x [gunzipText! selfTest] :i [(asl-zip/gzip :a z) (asl-syntax/core/bytesText :a bt)])\n\nfn ! gunzipText! data: Bytes -> String\n  (mt (z/gunzip! data)\n    ((err e) (str \"error: \" e))\n    ((ok out) (stringTrim (bt/bytesToString out))))")
(:sym "gunzip!" :mod "asl-zip/gzip" :sig "gunzip! data: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "gunzipWithLimit!" :mod "asl-zip/gzip" :sig "gunzipWithLimit! data: Bytes limit: Int64 -> (Result Bytes String)" :doc "output above limit bytes is an Err" :pit (result effect))
(:sym "crc32" :mod "asl-zip/gzip" :kind fn! :sig "crc32 data: Bytes -> Int64" :pit (effect))
(:sym "inflate!" :mod "asl-zip/gzip" :sig "inflate! data: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "inflate!" :mod "asl-zip/inflate" :sig "inflate! data: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "inflateInternal!" :mod "asl-zip/inflate" :sig "inflateInternal! data: Bytes startOffset: Int64 -> (Result InflateResult String)" :pit (result effect))
(:sym "inflateAppend!" :mod "asl-zip/inflate" :sig "inflateAppend! data: Bytes start: Int64 out: Bytes op: Int64 limit: Int64 -> (Result InflateState String)" :doc "decode into out from op, capped at limit" :pit (result effect))
