(:card "asl-remote" :purpose "Remote target routing: the workspace .asl/target.asn profile and the asl --on NODE:UNIT routing decision, a leaf both asl-cli and asl-harness import" :import "(asl-remote/target :a x)" :modules ((:m "asl-remote/target" :doc "A workspace .asl/target.asn, or asl --on NODE:UNIT for o...")) :sigs ("(schema Target (:f node String) (:f unit String))" "(schema Route (:f node String) (:f unit String) (:f verb String) (:f args (List String)))" "profileRel -> String" "parseOn spec: String -> (Result Target String)" "parseProfile text: String -> (Result (Option Target) String)" "loadProfile! root: String -> (Result (Option Target) String)" "findProfile! dir: String -> (Result (Option Target) String)" "localArgs args: (List String) -> (List String)" "routeOf args: (List String) profile: (Option Target) -> (Result (Option Route) String)" "remoteArgv r: Route -> (List String)") :more (timeoutOf onArgv promptLine) :effects (loadProfile! findProfile!) :fails (parseOn parseProfile loadProfile! findProfile! routeOf) :example none)
(:sym "Target" :mod "asl-remote/target" :kind type :sig "(schema Target (:f node String) (:f unit String))" :pit (record))
(:sym "Route" :mod "asl-remote/target" :kind type :sig "(schema Route (:f node String) (:f unit String) (:f verb String) (:f args (List String)))" :doc "one routed call: node, unit, verb (forms, test or check) and its arguments; a forms route holds the whole batch as one argument" :pit (record))
(:sym "profileRel" :mod "asl-remote/target" :sig "profileRel -> String")
(:sym "parseOn" :mod "asl-remote/target" :sig "parseOn spec: String -> (Result Target String)" :doc "NODE:UNIT or UNIT to a Target; default as NODE is the default node; names outside [A-Za-z0-9-] are refused" :pit (result))
(:sym "parseProfile" :mod "asl-remote/target" :sig "parseProfile text: String -> (Result (Option Target) String)" :pit (result))
(:sym "loadProfile!" :mod "asl-remote/target" :kind fn! :sig "loadProfile! root: String -> (Result (Option Target) String)" :pit (result effect))
(:sym "findProfile!" :mod "asl-remote/target" :kind fn! :sig "findProfile! dir: String -> (Result (Option Target) String)" :pit (result effect))
(:sym "localArgs" :mod "asl-remote/target" :sig "localArgs args: (List String) -> (List String)")
(:sym "routeOf" :mod "asl-remote/target" :sig "routeOf args: (List String) profile: (Option Target) -> (Result (Option Route) String)" :pit (result))
(:sym "remoteArgv" :mod "asl-remote/target" :sig "remoteArgv r: Route -> (List String)")
(:sym "timeoutOf" :mod "asl-remote/target" :sig "timeoutOf r: Route -> Int64" :doc "the remote bound in seconds: 1800 for test, 600 for forms and check, as tools/remote/vps.asl uses")
(:sym "onArgv" :mod "asl-remote/target" :sig "onArgv root: String r: Route -> (List String)")
(:sym "promptLine" :mod "asl-remote/target" :sig "promptLine t: Target -> String")
