(:card "asl-remote" :purpose "Remote target routing: the workspace .asl/target.asn profile and the asl --on NODE:UNIT routing decision, a leaf both asl-cli and asl-harness import" :import "(asl-remote/target :a x)" :modules ((:m "asl-remote/target" :doc "Remote target routing: a workspace .asl/target.asn (:tar...")) :sigs ("(schema Target (:f node String) (:f unit String))" "(schema Route (:f node String) (:f unit String) (:f verb String) (:f args (List String)))" "profileRel -> String" "parseOn spec: String -> (Result Target String)" "parseProfile text: String -> (Result (Option Target) String)" "loadProfile! root: String -> (Result (Option Target) String)" "findProfile! dir: String -> (Result (Option Target) String)" "localArgs args: (List String) -> (List String)" "routeOf args: (List String) profile: (Option Target) -> (Result (Option Route) String)" "remoteArgv r: Route -> (List String)") :more (timeoutOf onArgv promptLine) :effects (loadProfile! findProfile!) :fails (parseOn parseProfile loadProfile! findProfile! routeOf) :example none)
(:sym "Target" :mod "asl-remote/target" :kind type :sig "(schema Target (:f node String) (:f unit String))" :doc "a remote worktree: node id (empty for the default node of ~/.asl/remote.asn) and worktree unit" :pit (record))
(:sym "Route" :mod "asl-remote/target" :kind type :sig "(schema Route (:f node String) (:f unit String) (:f verb String) (:f args (List String)))" :doc "one routed call: node, unit, verb (forms, test or check) and its arguments; a forms route holds the whole batch as one argument" :pit (record))
(:sym "profileRel" :mod "asl-remote/target" :sig "profileRel -> String" :doc "the workspace-relative path of the target profile, .asl/target.asn")
(:sym "parseOn" :mod "asl-remote/target" :sig "parseOn spec: String -> (Result Target String)" :doc "NODE:UNIT or UNIT to a Target; default as NODE is the default node; names outside [A-Za-z0-9-] are refused" :pit (result))
(:sym "parseProfile" :mod "asl-remote/target" :sig "parseProfile text: String -> (Result (Option Target) String)" :doc "a target.asn text to some Target for :exec remote, none for :exec local, err for anything else" :pit (result))
(:sym "loadProfile!" :mod "asl-remote/target" :kind fn! :sig "loadProfile! root: String -> (Result (Option Target) String)" :doc "parseProfile of ROOT/.asl/target.asn; an absent file is none" :pit (result effect))
(:sym "findProfile!" :mod "asl-remote/target" :kind fn! :sig "findProfile! dir: String -> (Result (Option Target) String)" :doc "the profile of the nearest enclosing directory that has .asl/target.asn, searched no higher than the first directory holding .asl.config.asn or .git" :pit (result effect))
(:sym "localArgs" :mod "asl-remote/target" :sig "localArgs args: (List String) -> (List String)" :doc "the argv for local dispatch: a leading --local dropped, anything else unchanged")
(:sym "routeOf" :mod "asl-remote/target" :sig "routeOf args: (List String) profile: (Option Target) -> (Result (Option Route) String)" :doc "the routing decision for a CLI argv under a profile: --local is local, --on SPEC routes forms, test and check and refuses other verbs, a remote profile routes forms and test or check with files, everything else stays local" :pit (result))
(:sym "remoteArgv" :mod "asl-remote/target" :sig "remoteArgv r: Route -> (List String)" :doc "the argv run inside the remote worktree: env -u ASL_ROOT -u ASL_PRELUDE ./bin/asl BATCH for forms, niced ./bin/asl test|check FILES otherwise")
(:sym "timeoutOf" :mod "asl-remote/target" :sig "timeoutOf r: Route -> Int64" :doc "the remote bound in seconds: 1800 for test, 600 for forms and check, as tools/remote/vps.asl uses")
(:sym "onArgv" :mod "asl-remote/target" :sig "onArgv root: String r: Route -> (List String)" :doc "the local asl run argv of tools/remote/on.asl for a route, the default node spelled default")
(:sym "promptLine" :mod "asl-remote/target" :sig "promptLine t: Target -> String" :doc "the one launcher prompt line telling an agent its code lives in NODE:wt/UNIT and is reached only through asl forms, test and check")
