(:card "asl-vault" :purpose "Shared vault over the asl-store contract: provenance units, entries with scope maps, layers and statuses, supersede chains, bitemporal validity, edges, contradictions and resolutions, bodies keyed by sha256; talks to the..." :import "(asl-vault/vault :a x)" :deps (asl-store) :modules ((:m "asl-vault/vault") (:m "asl-vault/codec") (:m "asl-vault/curate") (:m "asl-vault/graph") (:m "asl-vault/model")) :moduleCount 7 :sigs ("(schema IngestSpec (:f entryId String) (:f kind String) (:f layer String) (:f role String) (:f scope (Map String String)) (:f status String)..." "(schema IngestResult (:f entry m/Entry) (:f unitHash String) (:f passageCount Int64))" "(schema VaultStats (:f totalEntries Int64) (:f activeEntries Int64) (:f pinnedCount Int64) (:f disputedCount Int64) (:f supersededCount Int6..." "(schema EntryRow (:f rev Int64) (:f entry m/Entry))" "ingest st: S step: (fn [S ty/Op] -> (Pair S ty/Reply)) now: Int64 spec: IngestSpec -> (Pair S (Result IngestResult String))") :more (completePending getEntry loadEntries loadEdges loadResolutions linkEntries setEntryStatus supersedeEntry resolveContradiction openContradictionsOf) :moreCount 77 :fails (andThen mapResult formItems checkShape parseEntry parseEdge parseResolution parseUnit) :example none)
(:sym "IngestSpec" :mod "asl-vault/vault" :kind type :sig "(schema IngestSpec (:f entryId String) (:f kind String) (:f layer String) (:f role String) (:f scope (Map String String)) (:f status String) (:f provenance String) (:f sourceHashes (List String)) (:f title String) (:f summary String) (:f bodyText String) (:f source String) (:f licence String) (:f co ..." :pit (record))
(:sym "IngestResult" :mod "asl-vault/vault" :kind type :sig "(schema IngestResult (:f entry m/Entry) (:f unitHash String) (:f passageCount Int64))" :pit (record))
(:sym "VaultStats" :mod "asl-vault/vault" :kind type :sig "(schema VaultStats (:f totalEntries Int64) (:f activeEntries Int64) (:f pinnedCount Int64) (:f disputedCount Int64) (:f supersededCount Int64) (:f quarantinedCount Int64) (:f staleCount Int64) (:f edgeCount Int64) (:f openContradictions Int64))" :pit (record))
(:sym "EntryRow" :mod "asl-vault/vault" :kind type :sig "(schema EntryRow (:f rev Int64) (:f entry m/Entry))" :pit (record))
