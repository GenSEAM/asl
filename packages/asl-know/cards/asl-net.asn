(:card "asl-net" :purpose "AgentSlang loopback TCP and Unix domain sockets and a poll-driven HTTP reactor over the host socket and fd builtins" :import "(asl-net/socket :a x)" :deps (asl-http) :modules ((:m "asl-net/socket" :doc "AgentSlang loopback TCP sockets over the host socket bui...") (:m "asl-net/handoff" :doc "Hands a listening Unix socket to another process over an...") (:m "asl-net/reactor" :doc "Non-blocking event-driven reactor owning socket fds and ...") (:m "asl-net/unix" :doc "AgentSlang Unix domain socket server and client over the...")) :sigs ("(schema SocketConfig (:f host String) (:f port Int64) (:f nonBlocking Bool))" "(schema ServerSocket (:f fd Int64) (:f host String) (:f port Int64) (:f status String))" "makeSocketConfig host: String port: Int64 nonBlocking: Bool -> SocketConfig" "openServerSocket cfg: SocketConfig -> (Result ServerSocket String)" "connectSocket port: Int64 -> (Result Int64 String)" "acceptSocketConnection serverFd: Int64 -> (Result Int64 String)" "readSocketBytes fd: Int64 maxBytes: Int64 -> (Result String String)" "writeSocketBytes fd: Int64 payload: String -> (Result Int64 String)") :more (closeSocket pollSocket HandoffChannel openHandoffChannel handoffListeningSocket receiveListeningSocket closeHandoffEnd Reactor ReactorRegistration ReactorEvent) :moreCount 40 :effects (openServerSocket connectSocket acceptSocketConnection readSocketBytes writeSocketBytes closeSocket pollSocket openHandoffChannel) :fails (openServerSocket connectSocket acceptSocketConnection readSocketBytes writeSocketBytes closeSocket pollSocket openHandoffChannel) :example none)
(:sym "SocketConfig" :mod "asl-net/socket" :kind type :sig "(schema SocketConfig (:f host String) (:f port Int64) (:f nonBlocking Bool))" :pit (record))
(:sym "ServerSocket" :mod "asl-net/socket" :kind type :sig "(schema ServerSocket (:f fd Int64) (:f host String) (:f port Int64) (:f status String))" :pit (record))
(:sym "makeSocketConfig" :mod "asl-net/socket" :sig "makeSocketConfig host: String port: Int64 nonBlocking: Bool -> SocketConfig")
(:sym "openServerSocket" :mod "asl-net/socket" :kind fn! :sig "openServerSocket cfg: SocketConfig -> (Result ServerSocket String)" :pit (result effect))
(:sym "connectSocket" :mod "asl-net/socket" :kind fn! :sig "connectSocket port: Int64 -> (Result Int64 String)" :pit (result effect))
(:sym "acceptSocketConnection" :mod "asl-net/socket" :kind fn! :sig "acceptSocketConnection serverFd: Int64 -> (Result Int64 String)" :pit (result effect))
(:sym "readSocketBytes" :mod "asl-net/socket" :kind fn! :sig "readSocketBytes fd: Int64 maxBytes: Int64 -> (Result String String)" :doc "one read of at most maxBytes; (ok \"\") is end of stream, a non-blocking socket with nothing buffered gives the host's would-block error" :pit (result effect))
(:sym "writeSocketBytes" :mod "asl-net/socket" :kind fn! :sig "writeSocketBytes fd: Int64 payload: String -> (Result Int64 String)" :doc "one write; the count is what the kernel accepted, which can be less than the payload on a full send buffer" :pit (result effect))
(:sym "closeSocket" :mod "asl-net/socket" :kind fn! :sig "closeSocket fd: Int64 -> (Result Bool String)" :pit (result effect))
(:sym "pollSocket" :mod "asl-net/socket" :kind fn! :sig "pollSocket fd: Int64 timeoutMs: Int64 -> (Result String String)" :doc "fdPoll reports 1 for readable, 4 for hangup, error or an invalid descriptor; a listener is readable when a connection is pending" :pit (result effect))
(:sym "HandoffChannel" :mod "asl-net/handoff" :kind type :sig "(schema HandoffChannel (:f sender Int64) (:f receiver Int64))" :pit (record))
(:sym "openHandoffChannel" :mod "asl-net/handoff" :kind fn! :sig "openHandoffChannel -> (Result HandoffChannel String)" :pit (result effect))
(:sym "handoffListeningSocket" :mod "asl-net/handoff" :kind fn! :sig "handoffListeningSocket server: unix/UnixServerSocket channel: Int64 -> (Result Int64 String)" :doc "the listener stays open here: the receiver gets its own descriptor for the same socket, and the caller closes this one with closeUnixSocket or fdClose" :pit (result effect))
(:sym "receiveListeningSocket" :mod "asl-net/handoff" :kind fn! :sig "receiveListeningSocket channel: Int64 path: String -> (Result unix/UnixServerSocket String)" :doc "path names the socket file the sender bound; its lstat proves the file is still a socket and gives the permissions, so the adopted server equals the sender's but for fd" :pit (result effect))
(:sym "closeHandoffEnd" :mod "asl-net/handoff" :kind fn! :sig "closeHandoffEnd fd: Int64 -> (Result Bool String)" :pit (result effect))
(:sym "Reactor" :mod "asl-net/reactor" :kind type :sig "(schema Reactor (:f registrations (List ReactorRegistration)) (:f eventQueue (List ReactorEvent)) (:f maxEvents Int64) (:f activeCount Int64))" :pit (record))
(:sym "ReactorRegistration" :mod "asl-net/reactor" :kind type :sig "(schema ReactorRegistration (:f fd Int64) (:f interestMask Int64) (:f tag String))" :doc "--- Registration reactor over fdPoll (NET1 API) ---" :pit (record))
(:sym "ReactorEvent" :mod "asl-net/reactor" :kind type :sig "(schema ReactorEvent (:f fd Int64) (:f readyMask Int64) (:f tag String))" :pit (record))
(:sym "makeReactor" :mod "asl-net/reactor" :sig "makeReactor maxEvents: Int64 -> Reactor")
(:sym "reactorRegister" :mod "asl-net/reactor" :sig "reactorRegister reactor: Reactor fd: Int64 interestMask: Int64 tag: String -> (Result Reactor String)" :pit (result))
(:sym "reactorUnregister" :mod "asl-net/reactor" :sig "reactorUnregister reactor: Reactor targetFd: Int64 -> (Result Reactor String)" :pit (result))
(:sym "reactorPoll" :mod "asl-net/reactor" :kind fn! :sig "reactorPoll reactor: Reactor timeoutMs: Int64 -> (Result (Pair Reactor (List ReactorEvent)) String)" :doc "one fdPoll over every registration; an event carries the revents the kernel reported (EVENT_READ, EVENT_WRITE, EVENT_ERROR bits), in registration order" :pit (result effect))
(:sym "reactorNextEvent!" :mod "asl-net/reactor" :kind fn! :sig "reactorNextEvent! reactor: Reactor -> (Result (Pair Reactor (Option ReactorEvent)) String)" :doc "the next queued event; an empty queue is refilled by a non-blocking reactorPoll" :pit (result effect))
(:sym "reactorActiveCount" :mod "asl-net/reactor" :sig "reactorActiveCount reactor: Reactor -> Int64")
(:sym "EVENT_READ" :mod "asl-net/reactor" :sig "EVENT_READ -> Int64" :doc "--- Constants ---")
(:sym "EVENT_WRITE" :mod "asl-net/reactor" :sig "EVENT_WRITE -> Int64")
(:sym "EVENT_ERROR" :mod "asl-net/reactor" :sig "EVENT_ERROR -> Int64")
(:sym "isRegistered?" :mod "asl-net/reactor" :sig "isRegistered? regs: (List ReactorRegistration) targetFd: Int64 -> Bool")
(:sym "Server" :mod "asl-net/reactor" :kind type :sig "(schema Server (:f listenerFd Int64) (:f nextConnId Int64) (:f connections (List Connection)) (:f procs (List ProcEntry)) (:f config ServerConfig))" :pit (record))
(:sym "Connection" :mod "asl-net/reactor" :kind type :sig "(schema Connection (:f fd Int64) (:f connId Int64) (:f buffer String) (:f lastActivityNs Int64) (:f chunkedMode Bool))" :pit (record))
(:sym "HttpEvent" :mod "asl-net/reactor" :kind type :sig "(schema HttpEvent (:f kind String) (:f connId Int64) (:f method String) (:f path String) (:f headers (List (Pair String String))) (:f body String) (:f statusCode Int64) (:f handle Int64) (:f exitCode Int64) (:f stdout String) (:f stderr String) (:f reason String))" :doc "HttpEvent uses string kind tag for maximum host compatibility" :pit (record))
(:sym "ServerConfig" :mod "asl-net/reactor" :kind type :sig "(schema ServerConfig (:f maxHeaderBytes Int64) (:f clientTimeoutMs Int64) (:f maxConnections Int64))" :doc "--- NET2: I/O reactor owning real fds ---" :pit (record))
(:sym "ProcEntry" :mod "asl-net/reactor" :kind type :sig "(schema ProcEntry (:f handle Int64) (:f stdoutFd Int64) (:f stderrFd Int64) (:f stdout String) (:f stderr String) (:f deadlineNs Int64))" :pit (record))
(:sym "httpListen!" :mod "asl-net/reactor" :sig "httpListen! port: Int64 config: ServerConfig -> (Result Server String)" :pit (result effect))
(:sym "reactorStep!" :mod "asl-net/reactor" :sig "reactorStep! server: Server timeoutMs: Int64 -> (Result (Pair Server (List HttpEvent)) String)" :pit (result effect))
(:sym "httpRespond!" :mod "asl-net/reactor" :sig "httpRespond! server: Server connId: Int64 statusCode: Int64 headers: (List (Pair String String)) body: String -> (Result Server String)" :pit (result effect))
(:sym "httpClose!" :mod "asl-net/reactor" :sig "httpClose! server: Server connId: Int64 -> (Result Server String)" :pit (result effect))
(:sym "httpStreamChunk!" :mod "asl-net/reactor" :sig "httpStreamChunk! server: Server connId: Int64 chunk: String -> (Result Server String)" :pit (result effect))
(:sym "reactorAddProc!" :mod "asl-net/reactor" :sig "reactorAddProc! server: Server pid: Int64 stdoutFd: Int64 stderrFd: Int64 timeoutMs: Int64 -> (Result Server String)" :doc "takes a child from procSpawnv whose stdin the caller has closed; its pipes become non-blocking and are read on every step" :pit (result effect))
(:sym "tryParseRequests" :mod "asl-net/reactor" :sig "tryParseRequests conn: Connection maxHeaderBytes: Int64 -> (Pair Connection (List HttpEvent))")
(:sym "int64ToHex" :mod "asl-net/reactor" :sig "int64ToHex value: Int64 -> String")
(:sym "serverConnCount" :mod "asl-net/reactor" :sig "serverConnCount server: Server -> Int64")
(:sym "makeServerConfig" :mod "asl-net/reactor" :sig "makeServerConfig -> ServerConfig")
(:sym "mkRequestEvent" :mod "asl-net/reactor" :sig "mkRequestEvent cid: Int64 m: String p: String hdrs: (List (Pair String String)) b: String -> HttpEvent")
(:sym "mkClosedEvent" :mod "asl-net/reactor" :sig "mkClosedEvent cid: Int64 -> HttpEvent")
(:sym "mkErrorEvent" :mod "asl-net/reactor" :sig "mkErrorEvent cid: Int64 code: Int64 r: String -> HttpEvent")
(:sym "mkProcDoneEvent" :mod "asl-net/reactor" :sig "mkProcDoneEvent h: Int64 ec: Int64 sout: String serr: String -> HttpEvent")
(:sym "mkProcTimeoutEvent" :mod "asl-net/reactor" :sig "mkProcTimeoutEvent h: Int64 sout: String serr: String r: String -> HttpEvent")
(:sym "mkProcErrorEvent" :mod "asl-net/reactor" :sig "mkProcErrorEvent h: Int64 r: String -> HttpEvent")
(:sym "reactorPollTimeoutMs" :mod "asl-net/reactor" :sig "reactorPollTimeoutMs procs: (List ProcEntry) nowNs: Int64 requestedMs: Int64 -> Int64" :doc "a proc deadline bounds the poll so its timeout fires on time; -1 (no limit) stays -1 only when no proc has a deadline")
(:sym "responseHeaders" :mod "asl-net/reactor" :sig "responseHeaders headers: (List (Pair String String)) body: String -> (List (Pair String String))" :doc "chunked responses carry no Content-Length; a caller's own Content-Length is not duplicated")
(:sym "writeAll!" :mod "asl-net/reactor" :sig "writeAll! fd: Int64 data: String offset: Int64 deadlineNs: Int64 -> (Result Unit String)" :doc "client sockets are non-blocking: a full send buffer waits for POLLOUT until the deadline instead of failing the response" :pit (result effect))
(:sym "UnixSocketConfig" :mod "asl-net/unix" :kind type :sig "(schema UnixSocketConfig (:f path String) (:f unlinkStale Bool) (:f permissions Int64))" :pit (record))
(:sym "UnixServerSocket" :mod "asl-net/unix" :kind type :sig "(schema UnixServerSocket (:f fd Int64) (:f path String) (:f status String) (:f permissions Int64))" :pit (record))
(:sym "makeUnixSocketConfig" :mod "asl-net/unix" :sig "makeUnixSocketConfig path: String unlinkStale: Bool permissions: Int64 -> UnixSocketConfig")
(:sym "openUnixServerSocket" :mod "asl-net/unix" :kind fn! :sig "openUnixServerSocket cfg: UnixSocketConfig -> (Result UnixServerSocket String)" :pit (result effect))
(:sym "connectUnixSocket" :mod "asl-net/unix" :kind fn! :sig "connectUnixSocket path: String -> (Result Int64 String)" :pit (result effect))
(:sym "closeUnixSocket" :mod "asl-net/unix" :kind fn! :sig "closeUnixSocket server: UnixServerSocket -> (Result Bool String)" :doc "closes the listener and unlinks its path, so the next bind needs no unlinkStale" :pit (result effect))
