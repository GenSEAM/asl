(:card "asl-audio" :purpose "Ear-budgeted auditory digests, voice intent two-phase-commit tiering, and AST Cyrillic sound-folding (the VAD/dictation/speaker-biometrics modules this package once also held were deleted in DEAD-PACKAGES/bd4dd4fa3 as de..." :import "(asl-audio/aloud :a x)" :modules ((:m "asl-audio/aloud" :doc "Ear-Budgeted Auditory Digests with strict <=8s (112 char...") (:m "asl-audio/heardname" :doc "Cyrillic-to-Latin transliteration with Subword CamelCase...") (:m "asl-audio/voiceIntent" :doc "Ergonomic Teleology Gate, Voice Intent Parser, and V0 Tw...")) :sigs ("formatAloudDigest text: String maxChars: Int64 -> String" "formatAuditDigestAloud passed: Int64 failed: Int64 mutantsKilled: Int64 -> String" "formatAttentionDigestAloud actionName: String targetSymbol: String -> String" "isWithinEarBudget? text: String maxChars: Int64 -> Bool" "latinizeCyrillic text: String -> String" "foldStemPhonemes s: String -> String" "splitCamelCaseStems name: String -> String" "levenshteinDistance s1: String s2: String -> Int64" "scoreStringMatch query: String target: String -> Float64") :more (matchVoiceQueryToAstSymbol AstSymbolCandidate makeAstSymbolCandidate AstMatchResult VoiceIntent TwoPhaseCommitState classifyIntentTeleologyTier) :moreCount 7 :example none)
