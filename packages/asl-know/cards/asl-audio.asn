(:sym "VoiceIntent" :mod "asl-audio/voiceIntent" :kind type :sig "(schema VoiceIntent (:f rawUtterance String) (:f action String) (:f targetSymbol String) (:f targetPath String) (:f tier String) (:f requires2Pc Bool))" :pit (record))
