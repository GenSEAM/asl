(:card "asl-agent-bus" :purpose "High-frequency in-memory agent-to-agent communication mesh" :import "(aslAgentBus/bus :a x)" :deps (asl-contracts asl-text asl-agent-core) :modules ((:m "aslAgentBus/bus" :doc "Inter-Agent Swarm Bus Protocol in ASL") (:m "aslAgentBus/ambient" :doc "Ambient Status Broadcast Frame and Lightweight Swarm Per...") (:m "aslAgentBus/asnlRing" :doc "Bounded Line-Delimited ASNL Ring Buffer with Zero-Copy P...") (:m "aslAgentBus/bridge" :doc "Minimal Single-Tool Swarm Bridge for External Agents (Cl...") (:m "aslAgentBus/browserBridge" :doc "Pure ASL Local Bridge Server: routes commands from deskt...")) :moduleCount 18 :sigs ("(schema AgentMessage (:f sender Str) (:f target Str) (:f payload Str) (:f timestamp I64))" "(schema BusEnvelope (:f id Str) (:f sender Str) (:f target Str) (:f payload Str) (:f timestamp I64) (:f correlationId Str) (:f epoch I64) (:..." "makeBusEnvelope id: Str sender: Str target: Str payload: Str ts: I64 corrId: Str -> BusEnvelope" "makeSequencedBusEnvelope id: Str sender: Str target: Str payload: Str ts: I64 corrId: Str epoch: I64 seq: I64 -> BusEnvelope" "validateBusCasEpoch env: BusEnvelope currentEpoch: I64 expectedMinSeq: I64 -> Bool") :more (BusEvent formatSseEvent isBroadcast BusChannel TaskLifecycleState BusReceipt ConditionWake dispatchBusEvent queryBusEvents pullBusEvents makeConditionWake) :moreCount 289 :fails (relayClaimLease relayReleaseLease relayVerifyWrite validateRelayWritePermission ndAsnEvalPayload ndAsnDeserializeSingle bridgeRegisterPeer bridgeSendRemote) :example none)
