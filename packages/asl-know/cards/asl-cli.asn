(:card "asl-cli" :purpose "Pure AgentSlang Native CLI Toolchain" :import "(asl-cli/cli :a x)" :deps (asl-parser asl-checker asl-compiler asl-ir asl-hypergraph asl-conform asl-ui asl-intel) :modules ((:m "asl-cli/cli" :doc "Pure AgentSlang native command-line interface toolchain.") (:m "asl-cli/asl1Cache" :doc "Build and validate the native stage-1 compiler cache. Th...") (:m "asl-cli/auditCmd" :doc "Pure AgentSlang CLI audit command handler and query engi...") (:m "asl-cli/batch" :doc "Pure AgentSlang native batch evaluator engine and RPC wi...") (:m "asl-cli/build" :doc "asl build FILE [-o OUT]: asl-host checks FILE, cached na...")) :moduleCount 32 :sigs ("formatVersion -> Str" "formatHelp -> Str" "checkGateFiles files: (List Str) -> (Result Str Str)" "dispatchRpc args: (List Str) -> (Result Str Str)" "dispatchCmd cmd: Str args: (List Str) -> (Result Str Str)" "executeCli args: (List Str) -> (Result Unit Str)" "baseHashesIn stamps: String compiler: String lib: String clangVersion: String -> (Result String String)" "memoSha! stampDir: String path: String facts: String -> (Result (Pair String Bool) String)" "memoShaIn! stampDir: String path: String facts: String window: Int64 -> (Result (Pair String Bool) String)") :more (statFacts! notraceLib! nativeAsl1! singleFlight! bootstrap! buildNative! buildNativeTransaction! closure! runAuditCommand formatAuditHelp executeAuditRun) :moreCount 270 :effects (checkGateFiles dispatchRpc dispatchCmd executeCli baseHashesIn memoSha! memoShaIn! statFacts!) :fails (checkGateFiles dispatchRpc dispatchCmd executeCli baseHashesIn memoSha! memoShaIn! notraceLib!) :example none)
(:sym "formatVersion" :mod "asl-cli/cli" :sig "formatVersion -> Str")
(:sym "formatHelp" :mod "asl-cli/cli" :sig "formatHelp -> Str")
