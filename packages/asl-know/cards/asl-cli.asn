(:sym "suiteWorkersValue" :mod "asl-cli/nativeBuild" :sig "suiteWorkersValue word: String -> (Option Int64)" :doc "a :suiteWorkers row value as a count 1 to 64, else none" :pit (option))
(:sym "defaultSuiteWorkers" :mod "asl-cli/nativeBuild" :sig "defaultSuiteWorkers -> Int64" :doc "the suite worker count when no config row names one: 4")
(:sym "storeCapFor!" :mod "asl-cli/nativeBuild" :kind fn! :sig "storeCapFor! dir: String -> Int64" :doc "the byte cap of the build store for the workspace at dir: the :native :storeCap row of the nearest config, else defaultStoreCap when absent or unreadable" :pit (effect))
(:sym "claimWaitFor!" :mod "asl-cli/nativeBuild" :kind fn! :sig "claimWaitFor! dir: String -> Int64" :doc "the compile-claim wait in nanoseconds for the workspace at dir: the :native :claimWaitS row of the nearest config, else defaultClaimWaitS when absent, unreadable or out of range" :pit (effect))
(:sym "lockGraceFor!" :mod "asl-cli/nativeBuild" :kind fn! :sig "lockGraceFor! dir: String -> Int64" :doc "the idle time in nanoseconds after which a nativeTest lock file holding no pid is broken: the :native :lockGraceS row of the nearest config, 10 s when absent, unreadable or out of range" :pit (effect))
(:sym "buildPoolFor!" :mod "asl-cli/nativeBuild" :kind fn! :sig "buildPoolFor! dir: String -> String" :doc "the jobserver root of the node build pool for the workspace at dir: the :native :buildPool row of the nearest config, else ~/.asl/run/jobserver/build; creates it and keeps its config.asn :tokens at the :native :buildTokens row" :pit (effect))
(:sym "buildTokensValue" :mod "asl-cli/nativeBuild" :sig "buildTokensValue word: String -> (Option Int64)" :doc "parses a :buildTokens word, 1 to 64, to some count; none when empty, non-numeric or out of range" :pit (option))
(:sym "defaultBuildTokens" :mod "asl-cli/nativeBuild" :sig "defaultBuildTokens -> Int64" :doc "the build pool size when :buildTokens is absent or out of range: 2")
(:sym "claimWaitValue" :mod "asl-cli/nativeBuild" :sig "claimWaitValue word: String -> (Option Int64)" :doc "parses a :claimWaitS word, whole seconds 1 to 86400, to some seconds; none when empty, non-numeric or out of range" :pit (option))
(:sym "defaultClaimWaitS" :mod "asl-cli/nativeBuild" :sig "defaultClaimWaitS -> Int64" :doc "the seconds a nativeTest process waits on another process compiling the same key when no :native :claimWaitS row is set: 900")
(:sym "capValue" :mod "asl-cli/nativeBuild" :sig "capValue word: String -> (Option Int64)" :doc "parses a :storeCap word, a positive byte count with an optional K, M or G suffix (powers of 1024), to some bytes; none when empty, non-numeric, zero or overflowing" :pit (option))
(:sym "defaultStoreCap" :mod "asl-cli/nativeBuild" :sig "defaultStoreCap -> Int64" :doc "the build store byte cap when no :native :storeCap row is set: 2 GiB")
(:sym "sweepOn?" :mod "asl-cli/nativeBuild" :kind fn! :sig "sweepOn? dir: String -> Bool" :doc "true unless the :native :sweep row of the nearest config at dir is false" :pit (effect))
(:sym "storeMinAgeNs!" :mod "asl-cli/nativeBuild" :kind fn! :sig "storeMinAgeNs! dir: String -> Int64" :doc "the nanoseconds a store entry stays unswept after its last use for the workspace at dir: the :native :storeMinAge row, else 60 minutes" :pit (effect))
(:sym "ageValue" :mod "asl-cli/nativeBuild" :sig "ageValue word: String -> (Option Int64)" :doc "parses a :storeMinAge word, a positive count of minutes or with an m or h suffix, to some nanoseconds; none when empty, non-numeric, zero or overflowing" :pit (option))
(:sym "link!" :mod "asl-cli/nativeBuild" :kind fn! :sig "link! b: Build ll: String out: String -> (Result String String)" :doc "each clang -O2 link splits the IR into ASL_NATIVE_LINK_JOBS (8) parts with irSplit, compiles them in parallel through run/runPoolLimited and links the objects; ASL_NATIVE_LINK_JOBS=1 or IR that does not split links the whole module, and the..." :pit (result effect))
(:sym "linkParts!" :mod "asl-cli/nativeBuild" :kind fn! :sig "linkParts! b: Build clang: String flags: (List String) ll: String out: String n: Int64 -> (Result (Pair Int64 String) String)" :doc "Links a whole-program .ll to out with clang: for n above 1 the IR is split into parts, compiled through the bounded job pool and linked; one part, or a split or part compile that cannot be used, links the whole .ll in one clang call. Return..." :pit (result effect))
(:sym "inlineFor" :mod "asl-cli/nativeBuild" :sig "inlineFor flags: (List String) -> Int64" :doc "The small-body copy limit for a link flag list: 0 when it holds -O1 (dev builds skip the copies), else irSplit inlineLimit.")
(:sym "partsWith" :mod "asl-cli/nativeBuild" :kind fn! :sig "partsWith ll: String n: Int64 limit: Int64 -> (Result (List String) String)" :doc "Splits the .ll file at ll into up to n part files (ll.partN.ll) with the given small-body inline limit and returns their paths; an unreadable file or a failed split is an err." :pit (result effect))
(:sym "minPartBytes" :mod "asl-cli/nativeBuild" :sig "minPartBytes -> Int64" :doc "Smallest IR size per link part (4000000 bytes), so a module under 8 MB links whole: splitting a 270 KB module cost 41% more instructions and gained no link time.")
(:sym "partsForSize" :mod "asl-cli/nativeBuild" :sig "partsForSize n: Int64 bytes: Int64 -> Int64" :doc "Part count for an IR of the given byte size: n capped so every part keeps at least minPartBytes, and at least 1.")
(:sym "linkPartsFor!" :mod "asl-cli/nativeBuild" :kind fn! :sig "linkPartsFor! dir: String -> (Result Int64 String)" :doc "The upper bound on link parts for a build directory: the :native :parts value (1..64) of the nearest .asl.config.asn, else the home config; unset gives min(online cores, 8); an invalid value is an ERR_CONFIG err." :pit (result effect))
(:sym "linkLevelFor!" :mod "asl-cli/nativeBuild" :kind fn! :sig "linkLevelFor! dir: String -> (Result String String)" :doc "The clang level flag for a build directory: the :native :level value of the nearest .asl.config.asn, else the home config, mapped through levelFlag; -O2 when unset." :pit (result effect))
(:sym "levelFlag" :mod "asl-cli/nativeBuild" :sig "levelFlag word: String -> (Result String String)" :doc "Maps an optimisation level word, with or without the colon, to a clang flag: release gives -O2, dev gives -O1; any other word is an ERR_CONFIG err." :pit (result))
(:sym "partsValue" :mod "asl-cli/nativeBuild" :sig "partsValue word: String -> (Result Int64 String)" :doc "Parses a :native :parts config word as an integer in 1..64; anything else is an ERR_CONFIG err." :pit (result))
(:sym "nativeKey" :mod "asl-cli/nativeBuild" :sig "nativeKey text: String key: String -> (Option String)" :doc "Reads key (for example :parts or :level) from the :native form of a config text; none when the text has no :native form or the key is absent. A list value is rendered back to text." :pit (option))
(:sym "compile!" :mod "asl-cli/nativeBuild" :kind fn! :sig "compile! b: Build name: String compiler: String tag: String entry: String dir: String deps: (List String) key: String -> (Result String String)" :doc "a compile or link that exits non-zero marks the key failed (name-key.failed), so the same sources are not rebuilt on every call; a timeout or a killed child marks nothing" :pit (result effect))
(:sym "stage!" :mod "asl-cli/nativeBuild" :kind fn! :sig "stage! b: Build name: String compiler: String tag: String entry: String extra: (List String) -> (Result String String)" :doc "returns the cached stage dir when its bin is executable; a name-key.failed marker replays its stored failure, except a marker whose text is transient, which is removed and the stage rebuilt" :pit (result effect))
(:sym "partsOf" :mod "asl-cli/nativeBuild" :kind fn! :sig "partsOf ll: String n: Int64 -> (Result (List String) String)" :pit (result effect))
(:sym "sanitizeFlags" :mod "asl-cli/nativeBuild" :kind fn! :sig "sanitizeFlags -> (List String)" :pit (effect))
(:sym "linkSanitized!" :mod "asl-cli/nativeBuild" :kind fn! :sig "linkSanitized! b: Build ll: String lib: String out: String sanitize: Bool -> (Result String String)" :pit (result effect))
(:sym "asanRuntime!" :mod "asl-cli/nativeBuild" :kind fn! :sig "asanRuntime! b: Build asl1: String packagesDir: String -> (Result String String)" :pit (result effect))
(:sym "notraceRuntime!" :mod "asl-cli/nativeBuild" :kind fn! :sig "notraceRuntime! b: Build asl1: String packagesDir: String -> (Result String String)" :pit (result effect))
(:sym "countedRuntime!" :mod "asl-cli/nativeBuild" :kind fn! :sig "countedRuntime! b: Build asl1: String packagesDir: String -> (Result String String)" :doc "the traced (counted-mode) runtime built as a variant like asan and notrace, keyed by the source closure of gcRoute, rtAbi and rtFloor, so a gcAsl or rc edit is linked without rerunning asl/host/build.sh" :pit (result effect))
(:sym "transientFailure?" :mod "asl-cli/nativeBuild" :sig "transientFailure? why: String -> Bool" :doc "true for a killed or not-run child (timeout, runaway, spawn failure, owner gone, deadline): an infrastructure cause, never cached; only an exited-N compiler failure gets a .failed marker")
(:sym "kwPrev?" :mod "asl-cli/nativeCli" :sig "kwPrev? prev: String -> Bool" :doc "true when a :word right after this character starts a keyword: a blank, a paren, bracket or brace of either direction, or a closing quote")
(:sym "plainArg?" :mod "asl-cli/nativeCli" :sig "plainArg? a: String -> Bool" :doc "true for a trailing intel outline argument that is a plain path: not empty, no leading ( : or -, no quote")
(:sym "cacheDir!" :mod "asl-cli/nativeCli" :kind fn! :sig "cacheDir! -> String" :pit (effect))
(:sym "headPath" :mod "asl-cli/nativeCli" :sig "headPath cache: String root: String -> String")
(:sym "toolchainRootPaths" :mod "asl-cli/nativeCli" :sig "toolchainRootPaths -> (List String)" :doc "The sources whose bytes key the native compile cache; each CLI directory records them as its roots file.")
(:sym "rootsText" :mod "asl-cli/nativeCli" :sig "rootsText entry: String -> String" :doc "Text of a CLI directory roots file for an entry: the toolchain roots with the entry package.")
(:sym "pinned?" :mod "asl-cli/nativeCli" :kind fn! :sig "pinned? root: String dir: String stampPath: String cmd: (List String) -> Bool" :doc "True when a run tools/remote/vps.asl command keeps the current CLI dir: the dir has non-empty roots and deps lists, and every dep file still exists and is either not newer than the stamp file or not under a toolchain root." :pit (effect))
(:sym "relayPinned?" :mod "asl-cli/nativeCli" :kind fn! :sig "relayPinned? root: String dir: String stampPath: String cmd: (List String) -> Bool" :doc "run tools/remote/vps.asl keeps the current CLI when no source under .asl.config.asn :nativeCli :relayPaths (tests directories skipped) is newer than the head file, even if a toolchain root moved: the relay client is read from the tree at ru..." :pit (effect))
(:sym "formsPinned?" :mod "asl-cli/nativeCli" :kind fn! :sig "formsPinned? root: String dir: String cmd: (List String) -> Bool" :doc "an argv that is only ASN forms of the edit family (formsAllowed, or intel outline) runs on the CLI the head names without a staleness rebuild only when .asl.config.asn :nativeCli :formsPin is true (absent or any other word is off); every ke..." :pit (effect))
(:sym "formsOnly?" :mod "asl-cli/nativeCli" :sig "formsOnly? cmd: (List String) -> Bool" :doc "true when every argv element is a sequence of top-level forms whose op is in formsAllowed; text outside a form, an unbalanced form, a quoted paren that would end a form early or any other op makes it false")
(:sym "formsPinOn?" :mod "asl-cli/nativeCli" :sig "formsPinOn? text: String -> Bool" :doc "true only when the workspace config text holds :formsPin true; a typo, another word or an absent key is off")
(:sym "underRoot" :mod "asl-cli/nativeCli" :sig "underRoot root: String path: String -> String")
(:sym "clangFacts!" :mod "asl-cli/nativeCli" :kind fn! :sig "clangFacts! -> (List String)" :pit (effect))
(:sym "clangCommand!" :mod "asl-cli/nativeCli" :kind fn! :sig "clangCommand! -> String" :doc "the clang a native step spawns, resolved by clangFor! from the cwd; the bare name clang when nothing resolves." :pit (effect))
(:sym "clangFor!" :mod "asl-cli/nativeCli" :kind fn! :sig "clangFor! dir: String -> (Result String String)" :doc "the shared clang resolver: the :native :clang row of the nearest .asl.config.asn above dir, else of ~/.asl/config.asn, else CLANG, else the first of clangCandidates on PATH; an error naming all three sources when none gives one." :pit (result effect))
(:sym "clangCandidates" :mod "asl-cli/nativeCli" :sig "clangCandidates -> (List String)" :doc "clang, clang-19, clang-18, clang-17, clang-16, clang-15: build.sh's PATH probe order.")
(:sym "clangPick" :mod "asl-cli/nativeCli" :sig "clangPick row: (Option String) envClang: (Option String) found: (List String) -> (Result String String)" :doc "the first of the config row, the CLANG value and the clangs found on PATH; err names what was tried." :pit (result))
(:sym "configClang" :mod "asl-cli/nativeCli" :sig "configClang text: String -> (Option String)" :doc "the :clang value of the :native row in a config text, none when there is no such row." :pit (option))
(:sym "configNative" :mod "asl-cli/nativeCli" :sig "configNative text: String key: String -> (Option String)" :doc "Value of a key in the :native row of config text, for any tool key such as :clang :llc :opt :wasmLd :llvmNm or :node; none when absent." :pit (option))
(:sym "nearestConfigText!" :mod "asl-cli/nativeCli" :kind fn! :sig "nearestConfigText! dir: String -> String" :pit (effect))
(:sym "clangOnPathIn!" :mod "asl-cli/nativeCli" :kind fn! :sig "clangOnPathIn! pathVar: String -> (List String)" :doc "the clangCandidates present as executable files in the directories of a PATH value, in candidate order." :pit (effect))
(:sym "fresh?" :mod "asl-cli/nativeCli" :kind fn! :sig "fresh? root: String dir: String -> Bool" :doc "a cached binary may run only while every file its build read (its deps list: the native.asl closure, the asl1 closure that compiled it, the prelude, libaslrt.a and asl/seed/seed.asn) is byte-equal to the snapshot copy under its src/; byte c..." :pit (effect))
(:sym "probe?" :mod "asl-cli/nativeCli" :kind fn! :sig "probe? root: String dir: String -> Bool" :doc "True when the native CLI of a root runs the probe test passTest.asl with 1 assertion executed and no asl-host fallback; otherwise the reason goes to stderr." :pit (effect))
(:sym "alive?" :mod "asl-cli/nativeCli" :kind fn! :sig "alive? pid: Int64 -> Bool" :doc "True when the pid is above 1 and names a live process." :pit (effect))
(:sym "verbKind" :mod "asl-cli/nativeCli" :sig "verbKind args: (List String) -> String")
(:sym "nativeGate!" :mod "asl-cli/nativeCli" :kind fn! :sig "nativeGate! ctx: sys/Context args: (List String) -> (Option Int64)" :doc "in the native binary: a verb that is not native (run test parse eval launch and *.asl are) execs command.asl on asl-host at once; a native verb whose binary is stale execs asl-host with ASL_NATIVE_CLI_STALE naming it, so no stale code serve..." :pit (option effect))
(:sym "hostEntry!" :mod "asl-cli/nativeCli" :kind fn! :sig "hostEntry! ctx: sys/Context args: (List String) -> Unit" :doc "in command.asl on asl-host, unless ASL_HOST forces the host: a host verb gets the one-line note that it is not native yet (forms stay silent); a native verb execs a fresh binary when the head names one, else starts the rebuild and runs on a..." :pit (effect))
(:sym "pruneEntries!" :mod "asl-cli/nativeCli" :kind fn! :sig "pruneEntries! dir: String prefix: String keep: Int64 minAgeNs: Int64 protected: (List String) -> Int64" :doc "Removes the oldest entries of dir whose names start with prefix beyond the newest keep, skipping protected names and entries younger than minAgeNs; returns how many it removed." :pit (effect))
(:sym "pruneNativeCache!" :mod "asl-cli/nativeCli" :kind fn! :sig "pruneNativeCache! cache: String keep: Int64 minAgeNs: Int64 -> Int64" :doc "Prunes the native CLI cache: the cli- and asl1- build directories beyond keep and older than minAgeNs, never one a head pointer names; returns the count removed." :pit (effect))
(:sym "StoreEntry" :mod "asl-cli/nativeCli" :kind type :sig "(schema StoreEntry (:f paths (List String)) (:f stamp Int64) (:f bytes Int64) (:f pinned Bool))" :doc "one sweepable build store entry: its paths, last-use stamp in ns, size in bytes and whether it is pinned (a pinned entry is never swept)" :pit (record))
(:sym "storeEntry!" :mod "asl-cli/nativeCli" :kind fn! :sig "storeEntry! paths: (List String) pinned: Bool -> StoreEntry" :doc "builds a StoreEntry for paths: last use is the newest mtime inside any path, size the summed tree bytes, pinned as given" :pit (effect))
(:sym "sweepEntries!" :mod "asl-cli/nativeCli" :kind fn! :sig "sweepEntries! entries: (List StoreEntry) capBytes: Int64 minAgeNs: Int64 -> (Pair Int64 Int64)" :doc "removes the oldest unpinned entries older than minAgeNs until the store fits capBytes, re-stamping each right before removal so one used since the scan stays; returns (removed count, bytes freed)" :pit (effect))
(:sym "treeBytes!" :mod "asl-cli/nativeCli" :kind fn! :sig "treeBytes! path: String -> Int64" :doc "the summed size in bytes of a file or directory tree, symlinks counted by themselves and not followed; 0 when missing" :pit (effect))
(:sym "headRoot!" :mod "asl-cli/nativeCli" :kind fn! :sig "headRoot! name: String -> (Option String)" :doc "the workspace root a head_ file name encodes (path segments joined by _, resolved against the filesystem), none for a name without the head_ prefix or a root that does not resolve" :pit (option effect))
(:sym "sweepNativeCache!" :mod "asl-cli/nativeCli" :kind fn! :sig "sweepNativeCache! cache: String capBytes: Int64 minAgeNs: Int64 -> Int64" :doc "after a native CLI build under the build lock: removes heads whose root is gone and tmp dirs of dead builders, then holds cli, asl1, seed and rt entries under capBytes above the age floor with live heads and leased entries pinned; returns t..." :pit (effect))
(:sym "entryStamp!" :mod "asl-cli/nativeCli" :kind fn! :sig "entryStamp! path: String -> Int64" :doc "the last use of a cache entry: the newer of its mtime and its .used file's mtime, 0 when it cannot be stat'ed" :pit (effect))
(:sym "treeStamp!" :mod "asl-cli/nativeCli" :kind fn! :sig "treeStamp! path: String -> Int64" :doc "the newest mtime in ns of anything inside a path, symlinks not followed; 0 when missing" :pit (effect))
(:sym "leaseEntry!" :mod "asl-cli/nativeCli" :kind fn! :sig "leaseEntry! cache: String name: String startNs: Int64 -> Bool" :doc "records that this process uses the store entry name since startNs by writing a name@pid lease file; true when written, a leased entry is pinned against sweeping" :pit (effect))
(:sym "dropLeases!" :mod "asl-cli/nativeCli" :kind fn! :sig "dropLeases! cache: String -> Int64" :doc "removes the lease files of this process (name@pid) from the cache lease directory and returns how many went" :pit (effect))
(:sym "sharedFloorNs" :mod "asl-cli/nativeCli" :sig "sharedFloorNs -> Int64" :doc "the age floor of the shared native CLI store: 6 hours in ns, nothing younger is swept whatever the cap")
(:sym "refresh!" :mod "asl-cli/nativeRefresh" :kind fn! :sig "refresh! root: String cache: String cmd: (List String) build: (fn [String String] -> Int64) -> Int64" :doc "under a build lock, rechecks the native CLI head and rebuilds it with the given build function when its sources moved, installing the new head; returns 0 or the stale failure code" :pit (effect))
(:sym "guard!" :mod "asl-cli/nativeRefresh" :kind fn! :sig "guard! root: String -> Int64" :doc "the refusal half of a native rebuild: 0 when the build may start (an explicit ASL_NATIVE_CLI_CACHE, the tree under the caller's HOME, or the caller's cwd inside the tree), else prints one (:err :code rebuildRefused :tree :home) receipt and ..." :pit (effect))
(:sym "under?" :mod "asl-cli/nativeRefresh" :sig "under? path: String dir: String -> Bool" :doc "true when PATH is DIR or inside it by a whole path segment (a sibling sharing a name prefix is not inside); false for an empty DIR")
(:sym "rebuildAllowed?" :mod "asl-cli/nativeRefresh" :sig "rebuildAllowed? root: String home: String cwd: String explicitCache: Bool -> Bool" :doc "the pure rebuild decision on real paths: explicit cache, or the tree under HOME, or cwd inside the tree")
(:sym "refusalReceipt" :mod "asl-cli/nativeRefresh" :sig "refusalReceipt root: String home: String -> String" :doc "the one-line (:err :code rebuildRefused :tree \"T\" :home \"H\") receipt, quotes in T and H escaped")
(:sym "suspect?" :mod "asl-cli/nativeRefresh" :kind fn! :sig "suspect? root: String dir: String stampPath: String -> Bool" :doc "true when the deps file of a native CLI dir is unreadable or some listed source is newer than the stamp" :pit (effect))
(:sym "staleFail" :mod "asl-cli/nativeRefresh" :kind fn! :sig "staleFail cache: String dir: String why: String -> Int64" :doc "prints the (:asl :status :failed :error ERR_NATIVE_STALE ...) row naming the dir, the reason and the build log, and returns exit 2" :pit (effect))
(:sym "packCommand!" :mod "asl-cli/pack" :kind fn! :sig "packCommand! ctx: sys/Context args: (List String) -> Int64" :pit (effect))
(:sym "cliScripts" :mod "asl-cli/pack" :sig "cliScripts -> (List String)" :doc "the python scripts the dispatcher execs")
(:sym "RollbackEntry" :mod "asl-cli/patch" :kind type :sig "(schema RollbackEntry (:f patchId Str) (:f targetFile Str) (:f targetModule Str) (:f preRoot Str) (:f postRoot Str) (:f inversePatch patch/AstPatch) (:f timestamp Int64))" :pit (record))
(:sym "makeRollbackEntry" :mod "asl-cli/patch" :sig "makeRollbackEntry patchId: Str targetFile: Str targetModule: Str preRoot: Str postRoot: Str inv: patch/AstPatch timestamp: Int64 -> RollbackEntry")
(:sym "runPatchCommand!" :mod "asl-cli/patch" :sig "runPatchCommand! args: (List Str) -> (Result Str Str)" :pit (result effect))
(:sym "validateMerkleRoot" :mod "asl-cli/patch" :sig "validateMerkleRoot expected: Str actual: Str -> Bool")
(:sym "pushRollbackStack!" :mod "asl-cli/patch" :sig "pushRollbackStack! entry: RollbackEntry -> (Result Unit Str)" :pit (result effect))
(:sym "popRollbackStack!" :mod "asl-cli/patch" :sig "popRollbackStack! count: Int64 -> (Result (List RollbackEntry) Str)" :pit (result effect))
(:sym "checkDisjointCommutativity" :mod "asl-cli/patch" :sig "checkDisjointCommutativity p1: patch/AstPatch p2: patch/AstPatch -> Bool")
(:sym "executePatchApply!" :mod "asl-cli/patch" :sig "executePatchApply! patchPath: Str targetFilePath: (Option Str) -> (Result Str Str)" :pit (result effect))
(:sym "executePatchCheck!" :mod "asl-cli/patch" :sig "executePatchCheck! patchPath: Str targetFilePath: (Option Str) -> (Result Str Str)" :pit (result effect))
(:sym "executePatchRollback!" :mod "asl-cli/patch" :sig "executePatchRollback! countOpt: (Option Int64) -> (Result Str Str)" :pit (result effect))
(:sym "parsePatchStackFile" :mod "asl-cli/patch" :sig "parsePatchStackFile content: Str -> (List RollbackEntry)")
(:sym "renderPatchStackFile" :mod "asl-cli/patch" :sig "renderPatchStackFile entries: (List RollbackEntry) -> Str")
(:sym "rcModeOf" :mod "asl-cli/rcConfig" :sig "rcModeOf text: String fallback: String -> (Result String String)" :doc "the mode named by a config text, the fallback when it names none; ERR_CONFIG for an unknown :rc value" :pit (result))
(:sym "rcModeIn!" :mod "asl-cli/rcConfig" :kind fn! :sig "rcModeIn! dir: String fallback: String -> (Result String String)" :doc "rcModeOf of the nearest .asl.config.asn at or above dir; the fallback when none exists" :pit (result effect))
(:sym "rcModes" :mod "asl-cli/rcConfig" :sig "rcModes -> (List (Pair String String))" :doc "config keyword to asl1 build --rc mode string")
(:sym "Pin" :mod "asl-cli/release" :kind type :sig "(schema Pin (:f pin String) (:f min String) (:f mode String) (:f file String))" :doc "the workspace release setting read from .asl.config.asn: pin (exact version), min (oldest accepted), mode (warn or refuse) and the config file it came from" :pit (record))
(:sym "releaseRow" :mod "asl-cli/release" :sig "releaseRow form: rd/SExpr -> (Option (List rd/SExpr))" :doc "the items of the list that follows the atom :release as a key anywhere in a parsed config, none when there is none" :pit (option))
(:sym "releaseAmong" :mod "asl-cli/release" :sig "releaseAmong items: (List rd/SExpr) -> (Option (List rd/SExpr))" :doc "the items of the list that follows the atom :release as a key among a list of items, searching nested lists; none when no list follows it" :pit (option))
(:sym "valueAfter" :mod "asl-cli/release" :sig "valueAfter items: (List rd/SExpr) key: String -> String" :doc "the unquoted atom that follows KEY in a list of config items; empty when KEY or its value is absent")
(:sym "quotedAfter" :mod "asl-cli/release" :sig "quotedAfter text: String key: String -> String" :doc "the quoted string right after KEY in TEXT; empty when KEY or its string is absent")
(:sym "tagOfPath" :mod "asl-cli/release" :sig "tagOfPath root: String -> String" :doc "the release tag of a root that sits under a releases/ directory with a v-prefixed name; empty for any other path")
(:sym "tagCmp" :mod "asl-cli/release" :sig "tagCmp a: String b: String -> Int64" :doc "compares two release tags numerically part by part, ignoring a leading v and treating - and . alike; -1, 0 or 1")
(:sym "pinOf" :mod "asl-cli/release" :sig "pinOf text: String file: String -> (Option Pin)" :doc "the (:release ...) setting of config text as a Pin, none when the text has none; mode is refuse only for the word refuse, with or without a colon" :pit (option))
(:sym "pinProblem" :mod "asl-cli/release" :sig "pinProblem p: Pin running: String -> String" :doc "empty when the running tag satisfies the pin and the minimum or is unknown, else one sentence naming the wanted and the running release")
(:sym "releaseTag!" :mod "asl-cli/release" :kind fn! :sig "releaseTag! root: String -> String" :doc "the tag of the running release from its .release/version.asn stamp, else from its directory name under releases/; empty for a plain checkout" :pit (effect))
(:sym "versionLine!" :mod "asl-cli/release" :kind fn! :sig "versionLine! root: String cwd: String -> String" :doc "the --version text: the banner, release tag and commit, and a (:release ...) status line when the workspace pins" :pit (effect))
(:sym "pinCheck!" :mod "asl-cli/release" :kind fn! :sig "pinCheck! root: String cwd: String -> Bool" :doc "checks the workspace pin before a command: a mismatch writes one ERR_RELEASE_PIN line to stderr and returns true only in mode refuse" :pit (effect))
(:sym "Done" :mod "asl-cli/sweep" :kind type :sig "(schema Done (:f index Int64) (:f path String) (:f code Int64) (:f last String) (:f out String))" :doc "A finished sweep run: its index in the plan, suite path, exit code, last output line and full output." :pit (record))
(:sym "negative?" :mod "asl-cli/sweep" :sig "negative? path: String -> Bool" :doc "negative fixtures and corpora fail by design: the negativeFixtures list, bench hidden tests under tests/harnessBench/cases/*/hidden/, asl/grammar/corpus/ and invalid, fixtures, node_modules segments")
(:sym "negativeFixtures" :mod "asl-cli/sweep" :sig "negativeFixtures -> (List String)" :doc "the explicit list of files that hold deliberate errors for a Test.asl beside them (the three tests/conformance/check fixtures); the sweep skips them")
(:sym "workspace!" :mod "asl-cli/sweep" :kind fn! :sig "workspace! -> (Result String String)" :doc "The sweep root: ASL_ROOT resolved when set, else git's top level, else the current directory." :pit (result effect))
(:sym "timeoutWanted!" :mod "asl-cli/sweep" :kind fn! :sig "timeoutWanted! -> (Result Int64 String)" :doc "Per-suite timeout in seconds from ASL_SWEEP_TIMEOUT_S, 300 by default, an error when it is not an integer." :pit (result effect))
(:sym "jobsWanted!" :mod "asl-cli/sweep" :kind fn! :sig "jobsWanted! -> (Result Int64 String)" :doc "Parallel job count from ASL_JOBS, the CPU count when unset, an error when it is not an integer." :pit (result effect))
(:sym "plan!" :mod "asl-cli/sweep" :kind fn! :sig "plan! verb: String ws: String -> (Result (Pair (List String) (List (Pair String (Pair Int64 String)))) String)" :doc "the suites a sweep runs: for test the discovered suites, for check the tracked .asl files whose delimiters balance, with the unbalanced ones (path, byte, evidence) beside them" :pit (result effect))
(:sym "report!" :mod "asl-cli/sweep" :kind fn! :sig "report! verb: String runnerName: String files: (List String) bad: (List (Pair String (Pair Int64 String))) done: (List Done) frozen: Int64 -> Int64" :doc "prints the unbalanced files, then each failed run, then the summary; the runner names who ran the suites" :pit (effect))
(:sym "frozenCountFor!" :mod "asl-cli/sweep" :kind fn! :sig "frozenCountFor! verb: String ws: String -> Int64" :pit (effect))
(:sym "changedPlan!" :mod "asl-cli/sweep" :kind fn! :sig "changedPlan! base: String -> (Result (Pair (List String) (Pair (List String) Int64)) String)" :doc "changed files against BASE (from git in the current directory) and the tracked suites they select" :pit (result effect))
(:sym "changedReport!" :mod "asl-cli/sweep" :kind fn! :sig "changedReport! base: String changed: (List String) selected: (List String) done: (List Done) frozen: Int64 -> Int64" :doc "Prints each selected run in plan order as (:pass ...) or (:fail ...) with its exit and last line, then the (:changed ...) summary; exits 1 when any run failed." :pit (effect))
(:sym "changedDry!" :mod "asl-cli/sweep" :kind fn! :sig "changedDry! base: String changed: (List String) selected: (List String) frozen: Int64 -> Int64" :doc "Prints the suites a changed run would select and a (:changed ...) summary with nothing run; exits 0." :pit (effect))
(:sym "lastLine" :mod "asl-cli/sweep" :sig "lastLine text: String -> String" :doc "The last line of text after trimming, CRLF read as LF.")
(:sym "nativeCheckSweep!" :mod "asl-cli/sweep" :kind fn! :sig "nativeCheckSweep! -> (Result Int64 String)" :pit (result effect))
(:sym "Context" :mod "asl-cli/system" :kind type :sig "(schema Context (:f root String) (:f scriptDir String) (:f argv0 String) (:f hostBin String))" :pit (record))
(:sym "Captured" :mod "asl-cli/system" :kind type :sig "(schema Captured (:f exitCode Int64) (:f stdout String) (:f stderr String))" :pit (record))
(:sym "context!" :mod "asl-cli/system" :kind fn! :sig "context! -> (Result Context String)" :doc "bin/asl exports the paths bash resolved; without it, discover the root from cwd or the exe" :pit (result effect))
(:sym "childEnv!" :mod "asl-cli/system" :sig "childEnv! extra: (List String) -> (List String)" :doc "children see the environment bash would pass" :pit (effect))
(:sym "execv!" :mod "asl-cli/system" :kind fn! :sig "execv! argv: (List String) extra: (List String) -> Int64" :pit (effect))
(:sym "run!" :mod "asl-cli/system" :kind fn! :sig "run! argv: (List String) -> Int64" :doc "a child whose output passes through, as bash runs it" :pit (effect))
(:sym "runWith!" :mod "asl-cli/system" :kind fn! :sig "runWith! argv: (List String) extra: (List String) -> Int64" :pit (effect))
(:sym "runMerged!" :mod "asl-cli/system" :kind fn! :sig "runMerged! argv: (List String) -> Int64" :doc "2>&1: child stderr joins our stdout" :pit (effect))
(:sym "runAt!" :mod "asl-cli/system" :kind fn! :sig "runAt! dir: String argv: (List String) -> Int64" :doc "runWith! with the child started in dir: a seed compiler reads asl/prelude/prelude.asl relative to its cwd. Returns the exit code, 127 when the spawn fails." :pit (effect))
(:sym "capture!" :mod "asl-cli/system" :kind fn! :sig "capture! argv: (List String) cwd: (Option String) -> (Result Captured String)" :pit (result effect))
(:sym "captureWith!" :mod "asl-cli/system" :kind fn! :sig "captureWith! argv: (List String) cwd: (Option String) extra: (List String) -> (Result Captured String)" :doc "capture! with extra child env, for probes that need a name childEnv! would otherwise strip or inherit" :pit (result effect))
(:sym "findCommand!" :mod "asl-cli/system" :sig "findCommand! ctx: Context name: String -> (Option String)" :pit (option effect))
(:sym "onPath!" :mod "asl-cli/system" :sig "onPath! name: String -> (Option String)" :doc "command -v for a name without a slash" :pit (option effect))
(:sym "executable?" :mod "asl-cli/system" :kind fn! :sig "executable? path: String -> Bool" :doc "test -x: any execute bit, dirs included" :pit (effect))
(:sym "isFile?" :mod "asl-cli/system" :kind fn! :sig "isFile? path: String -> Bool" :doc "True when the path exists and is a regular file; false when it cannot be stat-ed." :pit (effect))
(:sym "isDir?" :mod "asl-cli/system" :kind fn! :sig "isDir? path: String -> Bool" :doc "True when the path exists and is a directory; false when it cannot be stat-ed." :pit (effect))
(:sym "trimLeft" :mod "asl-cli/system" :sig "trimLeft s: String -> String" :doc "bash [:space:] trim at the start")
(:sym "stripTrailingNewlines" :mod "asl-cli/system" :sig "stripTrailingNewlines s: String -> String" :doc "command substitution drops trailing newlines")
(:sym "hostAbsent" :mod "asl-cli/system" :sig "hostAbsent cmd: String -> String")
(:sym "say!" :mod "asl-cli/system" :sig "say! text: String -> Bool" :pit (effect))
(:sym "sayErr!" :mod "asl-cli/system" :sig "sayErr! text: String -> Bool" :pit (effect))
(:sym "parentOf" :mod "asl-cli/system" :sig "parentOf path: String -> String")
(:sym "baseName" :mod "asl-cli/system" :sig "baseName path: String -> String")
(:sym "targetCommand!" :mod "asl-cli/target" :kind fn! :sig "targetCommand! ctx: sys/Context args: (List String) -> Int64" :pit (effect))
(:sym "checkFiles!" :mod "asl-cli/verify" :kind fn! :sig "checkFiles! ctx: sys/Context given: (List String) -> Int64" :doc "files first by kind, as bin/asl did" :pit (effect))
(:sym "checkRoots" :mod "asl-cli/verify" :sig "checkRoots -> (List String)")
(:sym "nativeCheckPaths!" :mod "asl-cli/verify" :kind fn! :sig "nativeCheckPaths! paths: (List String) -> Int64" :pit (effect))
(:sym "nativeCheckStaged!" :mod "asl-cli/verify" :kind fn! :sig "nativeCheckStaged! staged: (List Staged) -> Int64" :doc "checks each Staged: its actual path through the same cached checker as nativeCheckPaths!, every diagnostic line rewritten to the shown path and the package prefixes; returns 0 iff all pass. asl check of a file outside the toolchain root use..." :pit (effect))
(:sym "checkStaged!" :mod "asl-cli/verify" :kind fn! :sig "checkStaged! staged: (List Staged) other: (List String) -> Int64" :doc "staged other: prints one (:audit :sub check ...) receipt with the balance check over the staged files and the other paths and the native check of the staged files; returns the native exit code when non-zero, else the balance code" :pit (effect))
(:sym "Staged" :mod "asl-cli/verify" :kind type :sig "(schema Staged (:f actual String) (:f shown String) (:f maps (List (Pair String String))))" :doc "one staged check: the file checked in the staged mirror (actual), the path the caller gave (shown) and the other mirror prefixes mapped back to the package's own (maps)" :pit (record))
(:sym "normalisePaths" :mod "asl-cli/verify" :sig "normalisePaths maps: (List (Pair String String)) line: String -> String" :doc "rewrites one report line through each (staged prefix, own prefix) pair in order, so absolute and root-relative staged forms of the file and of its imports name the package's own path")
(:sym "formatDiag" :mod "asl-cli/verify" :sig "formatDiag d: ty/Diagnostic -> String")
(:sym "formatDiags" :mod "asl-cli/verify" :sig "formatDiags diags: (List ty/Diagnostic) -> String")
(:sym "formatDiagsHinted!" :mod "asl-cli/verify" :kind fn! :sig "formatDiagsHinted! diags: (List ty/Diagnostic) -> String" :doc "Diagnostics rendered as text with their hint lines appended." :pit (effect))
(:sym "diagHints!" :mod "asl-cli/verify" :kind fn! :sig "diagHints! diags: (List ty/Diagnostic) -> (List String)" :doc "One indentation fix hint line for each file that has an unbalanced-read diagnostic, one per path." :pit (effect))
(:sym "indentFields!" :mod "asl-cli/verify" :sig "indentFields! path: String -> String" :doc "Receipt fields for an unbalanced file: the closer edits its indentation implies, each naming its opener and deciding line, and the (:fix) form that stages them; empty when no edit is implied." :pit (effect))
(:sym "balanceReceipt!" :mod "asl-cli/verify" :sig "balanceReceipt! path: String -> String" :doc "Balance receipt line of one file, with the indentation fix fields of indentFields! added when it is unbalanced; empty when it balances." :pit (effect))
(:sym "WatchState" :mod "asl-cli/watch" :kind type :sig "(schema WatchState (:f database salsa/SalsaDatabase) (:f watchPath Str) (:f activeEpoch Int))" :pit (record))
(:sym "WatchReceipt" :mod "asl-cli/watch" :kind type :sig "(schema WatchReceipt (:f status Str) (:f mutatedSymbol Str) (:f recomputedCount Int) (:f recomputedQueries (List Str)) (:f latencyMicros Int))" :pit (record))
(:sym "watchInit" :mod "asl-cli/watch" :sig "watchInit db: salsa/SalsaDatabase watchPath: Str -> WatchState")
(:sym "watchStep!" :mod "asl-cli/watch" :sig "watchStep! ws: WatchState changedFile: Str changedSymbol: Str newSource: Str -> (Pair WatchState WatchReceipt)" :pit (effect))
(:sym "watchLoop!" :mod "asl-cli/watch" :sig "watchLoop! ws: WatchState cycles: Int -> WatchReceipt" :pit (effect))
(:sym "formatWatchHelp" :mod "asl-cli/watch" :sig "formatWatchHelp -> Str")
(:sym "runWatchCommand!" :mod "asl-cli/watch" :sig "runWatchCommand! args: (List Str) -> (Result Str Str)" :pit (result effect))
