(:card "asl-cli" :purpose "Pure AgentSlang Native CLI Toolchain" :import "(asl-cli/cli :a x)" :deps (asl-parser asl-checker asl-compiler asl-ir asl-hypergraph asl-conform asl-ui asl-intel asl-remote asl-text asl-syntax) :modules ((:m "asl-cli/cli") (:m "asl-cli/asl1Cache") (:m "asl-cli/auditCmd") (:m "asl-cli/batch") (:m "asl-cli/build")) :moduleCount 37 :sigs ("formatVersion -> Str" "formatHelp -> Str" "checkGateFiles files: (List Str) -> (Result Str Str)" "dispatchRpc args: (List Str) -> (Result Str Str)" "dispatchCmd cmd: Str args: (List Str) -> (Result Str Str)" "executeCli args: (List Str) -> (Result Unit Str)" "baseHashesIn stamps: String compiler: String lib: String clangVersion: String -> (Result String String)" "headNameOf base: String -> String" "headName! compiler: String lib: String clang: String -> (Result String String)" "memoSha! stampDir: String path: String facts: String -> (Result (Pair String Bool) String)") :more (memoShaIn! statFacts! notraceLib! nativeAsl1! singleFlight! bootstrap! buildNative! buildNativeTransaction! closure! runAuditCommand formatAuditHelp) :moreCount 363 :effects (checkGateFiles dispatchRpc dispatchCmd executeCli baseHashesIn headName! memoSha! memoShaIn!) :fails (checkGateFiles dispatchRpc dispatchCmd executeCli baseHashesIn headName! memoSha! memoShaIn!) :example none)
