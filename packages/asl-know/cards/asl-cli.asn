(:sym "testFiles!" :mod "asl-cli/command" :kind fn! :sig "testFiles! args: (List String) acc: (List String) -> (Result (List String) Int64)" :doc "err is the exit code after its receipt Resolves bin/asl test's path arguments to the suite files they name, walking directories; err carries the exit code after its receipt." :pit (result effect))
