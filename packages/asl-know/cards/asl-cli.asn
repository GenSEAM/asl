(:sym "reroot!" :mod "asl-cli/cacheFallback" :kind fn! :sig "reroot! ctx: sys/Context args: (List String) -> (Option Int64)" :doc "Runs the command against a cache overlay when the toolchain root cache is not writable, some exit code when it re-ran the command there, none when the cache is writable and the normal path applies." :pit (option effect))
(:sym "writable?" :mod "asl-cli/cacheFallback" :kind fn! :sig "writable? dir: String -> Bool" :doc "True when a probe file can be created and removed in dir, the test that decides whether the toolchain root cache is usable or the overlay applies." :pit (effect))
(:sym "gitRootOf" :mod "asl-cli/cacheFallback" :kind fn! :sig "gitRootOf dir: String -> (Option String)" :doc "The git root above dir, none when dir is not inside a work tree; the foreign project root the cache fallback keys on." :pit (option effect))
(:sym "overlayDirs" :mod "asl-cli/cacheFallback" :kind fn! :sig "overlayDirs root: String -> (List String)" :doc "The candidate overlay directories for root in fallback order, only a per-user temp directory keyed by a hash of root; the foreign project tree is never written." :pit (effect))
(:sym "overlayFor!" :mod "asl-cli/cacheFallback" :kind fn! :sig "overlayFor! root: String dir: String -> Bool" :doc "Builds the cache overlay of root under dir: every entry of the real root and of its .asl except cache is a symlink and .asl/cache is a real directory; true when the overlay is in place." :pit (effect))
