(:sym "split" :mod "asl-cli/irSplit" :sig "split text: String n: Int64 -> (Result (List String) String)" :doc "one whole-program IR module becomes n modules that link to the same program: each body lands in one part by size, internal symbols become hidden there and are declared elsewhere, internal alwaysinline bodies travel as available_externally c..." :pit (result))
(:sym "splitWith" :mod "asl-cli/irSplit" :sig "splitWith text: String n: Int64 limit: Int64 -> (Result (List String) String)" :doc "split with an explicit inline limit: the IR text becomes up to n parts (never more than the body count), each owning its bodies and carrying the shared declarations and globals; a limit of 0 gives no small-body copies. An unparsable module ..." :pit (result))
(:sym "inlineLimit" :mod "asl-cli/irSplit" :sig "inlineLimit -> Int64" :doc "Byte limit (2000) under which an internal or default-linkage body is also handed to every other part as available_externally, so small helpers still inline across a part boundary; main and weak or linkonce bodies never qualify.")
