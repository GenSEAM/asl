(:sym "route!" :mod "asl-cli/command" :kind fn! :sig "route! ctx: sys/Context args: (List String) -> (Pair String (List String))" :doc "The verb and arguments entry! dispatches for args: a leading form or keyword with leading space trimmed, test for an existing .asl file (or any file under asl-eval), else the first argument as the verb; the native binary routes with it too." :pit (effect))
