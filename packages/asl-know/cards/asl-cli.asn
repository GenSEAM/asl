(:card "asl-cli" :purpose "Pure AgentSlang Native CLI Toolchain" :import "(asl-cli/cli :a x)" :deps (asl-parser asl-checker asl-compiler asl-ir asl-hypergraph asl-conform asl-ui asl-intel) :modules ((:m "asl-cli/cli" :doc "Pure AgentSlang native command-line interface toolchain.") (:m "asl-cli/asl1Cache" :doc "Build and validate the native stage-1 compiler cache. Th...") (:m "asl-cli/auditCmd" :doc "Pure AgentSlang CLI audit command handler and query engi...") (:m "asl-cli/batch" :doc "Pure AgentSlang native batch evaluator engine and RPC wi...") (:m "asl-cli/build" :doc "asl build FILE [-o OUT]: asl-host checks FILE, cached na...")) :moduleCount 28 :sigs ("formatVersion -> Str" "formatHelp -> Str" "checkGateFiles files: (List Str) -> (Result Str Str)" "dispatchRpc args: (List Str) -> (Result Str Str)" "dispatchCmd cmd: Str args: (List Str) -> (Result Str Str)" "executeCli args: (List Str) -> (Result Unit Str)" "memoSha! stampDir: String path: String facts: String -> (Result (Pair String Bool) String)" "memoShaIn! stampDir: String path: String facts: String window: Int64 -> (Result (Pair String Bool) String)" "statFacts! paths: (List String) -> (List String)") :more (notraceLib! nativeAsl1! singleFlight! bootstrap! buildNative! buildNativeTransaction! closure! runAuditCommand formatAuditHelp executeAuditRun) :moreCount 205 :effects (checkGateFiles dispatchRpc dispatchCmd executeCli memoSha! memoShaIn! statFacts! notraceLib!) :fails (checkGateFiles dispatchRpc dispatchCmd executeCli memoSha! memoShaIn! notraceLib! nativeAsl1!) :example none)
