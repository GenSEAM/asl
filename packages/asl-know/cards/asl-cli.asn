(:sym "countDyck1Balance" :mod "asl-cli/batch" :sig "countDyck1Balance text: Str -> Int64")
(:sym "buildCommand!" :mod "asl-cli/build" :kind fn! :sig "buildCommand! ctx: sys/Context args: (List String) -> Int64" :pit (effect))
(:sym "reroot!" :mod "asl-cli/cacheFallback" :kind fn! :sig "reroot! ctx: sys/Context args: (List String) -> (Option Int64)" :doc "Runs the command against a cache overlay when the toolchain root cache is not writable, some exit code when it re-ran the command there, none when the cache is writable and the normal path applies." :pit (option effect))
(:sym "writable?" :mod "asl-cli/cacheFallback" :kind fn! :sig "writable? dir: String -> Bool" :doc "True when a probe file can be created and removed in dir, the test that decides whether the toolchain root cache is usable or the overlay applies." :pit (effect))
(:sym "gitRootOf" :mod "asl-cli/cacheFallback" :kind fn! :sig "gitRootOf dir: String -> (Option String)" :doc "The git root above dir, none when dir is not inside a work tree; the foreign project root the cache fallback keys on." :pit (option effect))
(:sym "overlayDirs" :mod "asl-cli/cacheFallback" :kind fn! :sig "overlayDirs root: String -> (List String)" :doc "The candidate overlay directories for root in fallback order, only a per-user temp directory keyed by a hash of root; the foreign project tree is never written." :pit (effect))
(:sym "overlayFor!" :mod "asl-cli/cacheFallback" :kind fn! :sig "overlayFor! root: String dir: String -> Bool" :doc "Builds the cache overlay of root under dir: every entry of the real root and of its .asl except cache is a symlink and .asl/cache is a real directory; true when the overlay is in place." :pit (effect))
(:sym "runCheckCommand!" :mod "asl-cli/check" :sig "runCheckCommand! args: (List Str) -> (Result Str Str)" :pit (result effect))
(:sym "formatCheckHelp" :mod "asl-cli/check" :sig "formatCheckHelp -> Str")
(:sym "checkSourceWithFix" :mod "asl-cli/check" :sig "checkSourceWithFix filePath: Str src: Str isFix: Bool -> (Result Str Str)" :pit (result))
(:sym "dispatch!" :mod "asl-cli/command" :kind fn! :sig "dispatch! ctx: sys/Context cmd: String args: (List String) -> Int64" :doc "one arm per bin/asl case, in its order Runs the bin/asl arm named by cmd on args; the Int is the exit code." :pit (effect))
(:sym "route!" :mod "asl-cli/command" :kind fn! :sig "route! ctx: sys/Context args: (List String) -> (Pair String (List String))" :doc "The verb and arguments entry! dispatches for args: a leading form or keyword with leading space trimmed, test for an existing .asl file (or any file under asl-eval), else the first argument as the verb; the native binary routes with it too." :pit (effect))
(:sym "asnEcho" :mod "asl-cli/command" :sig "asnEcho text: String -> (Pair String Int64)" :doc "a keyword-headed form is ASN data, printed back A keyword-headed form printed back with exit 0, or an ERR_ASN_SYNTAX receipt with exit 2.")
(:sym "testFiles!" :mod "asl-cli/command" :kind fn! :sig "testFiles! args: (List String) acc: (List String) -> (Result (List String) Int64)" :doc "err is the exit code after its receipt Resolves bin/asl test's path arguments to the suite files they name, walking directories; err carries the exit code after its receipt." :pit (result effect))
(:sym "readStdin!" :mod "asl-cli/command" :kind fn! :sig "readStdin! acc: (List String) -> (Result String String)" :doc "All of standard input as one string, read in 64 KiB chunks until end of file." :pit (result effect))
(:sym "Rule" :mod "asl-cli/configSchema" :kind type :sig "(schema Rule (:f grp String) (:f name String) (:f kind String) (:f lo Int64) (:f hi Int64) (:f choices (List String)) (:f dflt String))" :pit (record))
(:sym "Issue" :mod "asl-cli/configSchema" :kind type :sig "(schema Issue (:f level String) (:f path String) (:f code String) (:f msg String))" :pit (record))
(:sym "Checked" :mod "asl-cli/configSchema" :kind type :sig "(schema Checked (:f issues (List Issue)) (:f checked Int64))" :pit (record))
(:sym "rulesOf" :mod "asl-cli/configSchema" :sig "rulesOf schemaText: String -> (List Rule)" :doc "the Rule list of the (:cfgKey ...) rows of a schema text")
(:sym "checkText" :mod "asl-cli/configSchema" :sig "checkText text: String rules: (List Rule) -> Checked" :doc "Checked of a config text against rules: the issues (level, path, code unknownKey badType outOfRange duplicateKey unbalanced empty, message) and how many keys were validated; whole-line ; comments are ignored")
(:sym "checkFile!" :mod "asl-cli/configSchema" :kind fn! :sig "checkFile! file: String schemaPath: String -> (Result Checked String)" :doc "checkText of a config file against a schema file; an err names the unreadable file" :pit (result effect))
(:sym "receipt" :mod "asl-cli/configSchema" :sig "receipt file: String c: Checked -> String" :doc "the (:workspaceConfigCheck :file :status :checked :errors :warnings) receipt of a Checked")
(:sym "cli!" :mod "asl-cli/configSchema" :kind fn! :sig "cli! args: (List String) -> (Result Int64 String)" :doc "check FILE [SCHEMA]: prints the receipt, ok 0 for a clean file, ok 1 with errors, err for a missing file or schema" :pit (result effect))
(:sym "warnText!" :mod "asl-cli/configSchema" :kind fn! :sig "warnText! root: String file: String text: String -> Unit" :doc "the runtime side: with the root holding asl/grammar/workspaceConfig.asn, one stderr line per error of checkText on already loaded config text; the caller keeps its documented default; a root without the schema says nothing" :pit (effect))
(:sym "warnLines!" :mod "asl-cli/configSchema" :kind fn! :sig "warnLines! root: String file: String text: String -> (List String)" :doc "Runtime side of the config check: for config text read under a root that holds the schema, one stderr line per error; a root without the schema says nothing." :pit (effect))
(:sym "warnIn!" :mod "asl-cli/configSchema" :kind fn! :sig "warnIn! root: String dir: String -> Unit" :doc "Check the nearest .asl.config.asn above dir and the home config, writing each error to stderr; the caller keeps its own defaults." :pit (effect))
(:sym "defaultOf" :mod "asl-cli/configSchema" :sig "defaultOf rules: (List Rule) grp: String name: String -> (Option String)" :doc "the documented default text of a group and key row, none for an unknown key" :pit (option))
(:sym "keyCount" :mod "asl-cli/configSchema" :sig "keyCount rules: (List Rule) -> Int64" :doc "Number of key rows in a loaded config schema.")
(:sym "groupsOf" :mod "asl-cli/configSchema" :sig "groupsOf rules: (List Rule) -> (List String)" :doc "The config groups a loaded schema names, in order of first appearance.")
