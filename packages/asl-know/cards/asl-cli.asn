(:sym "dispatchCmd" :mod "asl-cli/cli" :kind fn! :sig "dispatchCmd cmd: Str args: (List Str) -> (Result Str Str)" :pit (result effect))
(:sym "executeCli" :mod "asl-cli/cli" :kind fn! :sig "executeCli args: (List Str) -> (Result Unit Str)" :pit (result effect))
(:sym "baseHashesIn" :mod "asl-cli/asl1Cache" :kind fn! :sig "baseHashesIn stamps: String compiler: String lib: String clangVersion: String -> (Result String String)" :doc "the base names the compiler and runtime by role and content, not by absolute path, so a fresh worktree whose sources match an earlier one reuses its cached asl1-native" :pit (result effect))
(:sym "memoSha!" :mod "asl-cli/asl1Cache" :kind fn! :sig "memoSha! stampDir: String path: String facts: String -> (Result (Pair String Bool) String)" :doc "sha256 of path reused from its stamp while dev, ino, ctime, mtime and size all match; files younger than the racy window are hashed and not stamped. Returns the digest and whether it was a stamp hit." :pit (result effect))
(:sym "memoShaIn!" :mod "asl-cli/asl1Cache" :kind fn! :sig "memoShaIn! stampDir: String path: String facts: String window: Int64 -> (Result (Pair String Bool) String)" :doc "memoSha! with an explicit racy window in nanoseconds (tests use a short one)." :pit (result effect))
(:sym "statFacts!" :mod "asl-cli/asl1Cache" :kind fn! :sig "statFacts! paths: (List String) -> (List String)" :doc "One batched stat(1) call (GNU -c, then BSD -f) giving 'dev ino ctime mtime size' per path; an empty list when the spawn or line count fails, so callers hash instead of trusting a stamp." :pit (effect))
(:sym "notraceLib!" :mod "asl-cli/asl1Cache" :kind fn! :sig "notraceLib! compiler: String root: String lib: String clang: String -> (Result String String)" :doc "The untraced runtime archive for the given compiler, root, host library and clang: built once per clang and runtime sources by the stage binary itself and cached under the asl1 cache's rt directory; an error when clang's version line, the r..." :pit (result effect))
(:sym "nativeAsl1!" :mod "asl-cli/asl1Cache" :kind fn! :sig "nativeAsl1! ctx: sys/Context lib: String clang: String -> (Result String String)" :pit (result effect))
(:sym "singleFlight!" :mod "asl-cli/asl1Cache" :sig "singleFlight! lockPath: String artifactPath: String timeoutMs: Int64 readyFn: Any builder: Any -> (Result String String)" :doc "separate flock guard serializes stale-owner inspection/removal and creation. The requested lock file is created with O_EXCL and stores its owner PID. A" :pit (result effect))
(:sym "bootstrap!" :mod "asl-cli/asl1Cache" :sig "bootstrap! previous: (Option String) seed: (Result String String) stage: Any install: Any -> (Result String String)" :pit (result effect))
(:sym "buildNative!" :mod "asl-cli/asl1Cache" :sig "buildNative! previousFn: Any seedFn: Any stage: Any install: Any -> (Result String String)" :doc "a cached compiler bootstraps first; when it fails, the seed is the one retry, and both failures are reported" :pit (result effect))
(:sym "buildNativeTransaction!" :mod "asl-cli/asl1Cache" :sig "buildNativeTransaction! root: String key: String closure: String previousFn: Any seedFn: Any stage: Any -> (Result String String)" :pit (result effect))
(:sym "closure!" :mod "asl-cli/asl1Cache" :kind fn! :sig "closure! ctx: sys/Context compiler: String lib: String clang: String -> (Result String String)" :doc "the asl1 import closure comes from a native asl1: only an already-cached compiler is asked for it (asl-host runs asl1.asl deps instead when none is cached yet, quietly, since a seed that has never bootstrapped is not spent on a deps probe b..." :pit (result effect))
