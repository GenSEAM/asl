(:card "asl-runtime" :purpose "Standard Pure ASL Runtime: Refcounting, Containers, Sorting, Float Formatting, and Panic Handling" :import "(asl-runtime :a x)" :modules ((:m "asl-runtime" :doc "Pure AgentSlang runtime: refcounting, shortest float rou...") (:m "asl-runtime/collections" :doc "Pure AgentSlang Standard Library Collection Utilities, L...") (:m "asl-runtime/float" :doc "Shortest round-trip IEEE 754 float formatting and parsin...") (:m "asl-runtime/math" :doc "Pure AgentSlang Numerically Stable Online Streaming Math...") (:m "asl-runtime/panic" :doc "AgentSlang runtime panic handling and process abort rout...")) :moduleCount 10 :sigs ("rtRetain hdr: ref/RefHeader -> ref/RefHeader" "rtRelease hdr: ref/RefHeader -> ref/RefHeader" "makeRefHeader ptr: String -> ref/RefHeader" "rtFormatF64 val: Float64 -> String" "rtParseF64 s: String -> (Option Float64)" "rtStableSort items: (List Str) -> (List Str)" "rtStableSortBy items: (List Str) cmp: (fn [(Str) (Str)] -> Bool) -> (List Str)" "rtPanic msg: Str -> Unit" "rtPanicCode code: Int64 msg: Str -> Unit" "listTake n: Int64 xs: (List Str) -> (List Str)" "listDrop n: Int64 xs: (List Str) -> (List Str)" "listZip xs: (List Str) ys: (List Str) -> (List (Pair Str Str))") :more (listFlatten listChunk listAny? listAll? listFind alistGet makeSet setContains? setAdd setRemove setUnion setIntersection setDifference setToList setSize) :moreCount 103 :effects (rtPanic rtPanicCode) :example none)
