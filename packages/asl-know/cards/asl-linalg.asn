(:card "asl-linalg" :purpose "Dense linear algebra on row-major F64Array: Cholesky factor and solve, Householder QR least squares with column pivoting and rank, symmetric eigen by cyclic Jacobi; every kernel returns (err msg) on shape, rank or defini..." :import "(asl-linalg/dense :a x)" :modules ((:m "asl-linalg/dense" :doc "Row-major F64Array helpers for the factorisations: Bytes...") (:m "asl-linalg/cholesky" :doc "Cholesky factorisation and solve for symmetric positive ...") (:m "asl-linalg/eigen" :doc "Symmetric eigenproblem by cyclic Jacobi for small matric...") (:m "asl-linalg/qr" :doc "Least squares by Householder QR with column pivoting; ra...")) :sigs ("pow2Exponent m: Float64 e: Int64 -> Int64" "mul2 x: Float64 e: Int64 -> Float64" "scaleArray a: F64Array e: Int64 -> F64Array" "maxAbs a: F64Array -> Float64" "asymmetric! a: Bytes n: Int64 i: Int64 j: Int64 -> Bool" "toBuf a: F64Array -> Bytes" "fromBuf b: Bytes n: Int64 -> F64Array" "getAt! b: Bytes cols: Int64 i: Int64 j: Int64 -> Float64" "setAt! b: Bytes cols: Int64 i: Int64 j: Int64 v: Float64 -> Unit" "allFinite a: F64Array -> Bool" "identity n: Int64 -> F64Array" "transpose m: Int64 n: Int64 a: F64Array -> (Result F64Array String)") :more (matVec choleskyFactor choleskySolve choleskySolveSpd choleskyRcond Eigen eigenSym Lstsq lstsq lstsqTol defaultRankTol) :effects (asymmetric! toBuf fromBuf getAt! setAt! choleskyFactor choleskySolve choleskySolveSpd) :fails (transpose matVec choleskyFactor choleskySolve choleskySolveSpd choleskyRcond eigenSym lstsq) :example none)
(:sym "pow2Exponent" :mod "asl-linalg/dense" :sig "pow2Exponent m: Float64 e: Int64 -> Int64" :doc "e with m/2^e in [1,2), 0 for m = 0")
(:sym "mul2" :mod "asl-linalg/dense" :sig "mul2 x: Float64 e: Int64 -> Float64" :doc "x times 2^e in steps of 2^500, exact, no intermediate overflow")
(:sym "scaleArray" :mod "asl-linalg/dense" :sig "scaleArray a: F64Array e: Int64 -> F64Array" :doc "every element times 2^e, the array itself when e = 0")
(:sym "maxAbs" :mod "asl-linalg/dense" :sig "maxAbs a: F64Array -> Float64" :doc "largest absolute value, 0 for an empty array")
(:sym "asymmetric!" :mod "asl-linalg/dense" :kind fn! :sig "asymmetric! a: Bytes n: Int64 i: Int64 j: Int64 -> Bool" :doc "true when some a_ij and a_ji differ by more than 1e-9 relative" :pit (effect))
(:sym "toBuf" :mod "asl-linalg/dense" :kind fn! :sig "toBuf a: F64Array -> Bytes" :doc "new Bytes scratch buffer holding the array, 8 bytes per element" :pit (effect))
(:sym "fromBuf" :mod "asl-linalg/dense" :kind fn! :sig "fromBuf b: Bytes n: Int64 -> F64Array" :doc "copy n Float64 slots of a buffer out into a new F64Array" :pit (effect))
(:sym "getAt!" :mod "asl-linalg/dense" :kind fn! :sig "getAt! b: Bytes cols: Int64 i: Int64 j: Int64 -> Float64" :doc "element i,j of a row-major buffer with cols columns" :pit (effect))
(:sym "setAt!" :mod "asl-linalg/dense" :kind fn! :sig "setAt! b: Bytes cols: Int64 i: Int64 j: Int64 v: Float64 -> Unit" :doc "overwrite element i,j of a row-major buffer" :pit (effect))
(:sym "allFinite" :mod "asl-linalg/dense" :sig "allFinite a: F64Array -> Bool" :doc "true when no element is NaN or infinite")
(:sym "identity" :mod "asl-linalg/dense" :sig "identity n: Int64 -> F64Array" :doc "n x n identity, row-major")
(:sym "transpose" :mod "asl-linalg/dense" :sig "transpose m: Int64 n: Int64 a: F64Array -> (Result F64Array String)" :doc "transpose of an m x n row-major matrix; (err linalgShape ...) on a length that is not m*n" :pit (result))
(:sym "matVec" :mod "asl-linalg/dense" :sig "matVec m: Int64 n: Int64 a: F64Array x: F64Array -> (Result F64Array String)" :doc "A x for m x n A and a length n vector through gemm; (err linalgShape ...) on mismatch" :pit (result))
(:sym "choleskyFactor" :mod "asl-linalg/cholesky" :kind fn! :sig "choleskyFactor n: Int64 a: F64Array -> (Result F64Array String)" :doc "choleskyFactor n a: lower L with A = L L^T; err linalgShape, linalgNonFinite, linalgNotSymmetric or linalgNotPositiveDefinite; 500x500 takes 68 ms native" :pit (result effect))
(:sym "choleskySolve" :mod "asl-linalg/cholesky" :kind fn! :sig "choleskySolve n: Int64 l: F64Array b: F64Array -> (Result F64Array String)" :doc "choleskySolve n l b: solve L L^T x = b from a factor; err linalgShape, linalgNonFinite or linalgNotPositiveDefinite on a non-positive diagonal" :pit (result effect))
(:sym "choleskySolveSpd" :mod "asl-linalg/cholesky" :kind fn! :sig "choleskySolveSpd n: Int64 a: F64Array b: F64Array -> (Result F64Array String)" :doc "factor A then solve A x = b; any error of choleskyFactor or choleskySolve" :pit (result effect))
(:sym "choleskyRcond" :mod "asl-linalg/cholesky" :kind fn! :sig "choleskyRcond n: Int64 a: F64Array l: F64Array -> (Result Float64 String)" :doc "choleskyRcond n a l: reciprocal 1-norm condition estimate (Hager-Higham) from the factor; about 1e-16 means no correct digits, the caller decides whether to refuse; Hilbert 6 and 12 estimate within a factor 3 of numpy 3.4e-8 and 2.6e-17" :pit (result effect))
(:sym "Eigen" :mod "asl-linalg/eigen" :kind type :sig "schema Eigen (:f values F64Array) (:f vectors F64Array) (:f sweeps Int64)" :doc "values ascending, vectors row-major with column k the unit eigenvector of values[k], sweeps used" :pit (record))
(:sym "eigenSym" :mod "asl-linalg/eigen" :kind fn! :sig "eigenSym n: Int64 a: F64Array -> (Result Eigen String)" :doc "eigenSym n a: eigenvalues and vectors of a symmetric matrix accurate to about 1e-14 times its norm; err linalgShape, linalgNonFinite, linalgNotSymmetric or linalgNoConvergence; 100x100 takes 54 ms native" :pit (result effect))
(:sym "Lstsq" :mod "asl-linalg/qr" :kind type :sig "schema Lstsq (:f coef F64Array) (:f rank Int64) (:f residualNorm Float64) (:f tol Float64)" :doc "least squares result: coef (n coefficients), rank, residualNorm = |b - A coef|_2, tol used" :pit (record))
(:sym "lstsq" :mod "asl-linalg/qr" :kind fn! :sig "lstsq m: Int64 n: Int64 a: F64Array b: F64Array -> (Result Lstsq String)" :doc "lstsqTol with the default tolerance max(m,n)*2.2e-16, relative to the largest pivot; near-dependence of about 1e-14 relative is borderline, pass lstsqTol with an explicit tol and read rank; any scale from 1e-300 to 1e300 is handled" :pit (result effect))
(:sym "lstsqTol" :mod "asl-linalg/qr" :kind fn! :sig "lstsqTol m: Int64 n: Int64 a: F64Array b: F64Array tol: Float64 -> (Result Lstsq String)" :doc "lstsqTol m n a b tol: min |A x - b|_2 for m x n row-major A; rank-deficient input is ok with rank < n and the basic solution; err linalgShape, linalgNonFinite or linalgTolerance (tol outside [0,1))" :pit (result effect))
(:sym "defaultRankTol" :mod "asl-linalg/qr" :sig "defaultRankTol m: Int64 n: Int64 -> Float64" :doc "max(m,n) * 2.22e-16")
