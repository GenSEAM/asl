(:card "asl-linalg" :purpose "Dense linear algebra on row-major F64Array: Cholesky factor and solve, Householder QR least squares with column pivoting and rank, symmetric eigen by cyclic Jacobi; every kernel returns (err msg) on shape, rank or defini..." :import "(asl-linalg/dense :a x)" :modules ((:m "asl-linalg/dense" :doc "Row-major F64Array helpers for the factorisations: Bytes...") (:m "asl-linalg/cholesky" :doc "Cholesky factorisation and solve for symmetric positive ...") (:m "asl-linalg/eigen") (:m "asl-linalg/qr" :doc "Least squares by Householder QR with column pivoting; ra...")) :sigs ("pow2Exponent m: Float64 e: Int64 -> Int64" "mul2 x: Float64 e: Int64 -> Float64" "scaleArray a: F64Array e: Int64 -> F64Array" "maxAbs a: F64Array -> Float64" "asymmetric! a: Bytes n: Int64 i: Int64 j: Int64 -> Bool" "toBuf a: F64Array -> Bytes" "fromBuf b: Bytes n: Int64 -> F64Array" "getAt! b: Bytes cols: Int64 i: Int64 j: Int64 -> Float64" "setAt! b: Bytes cols: Int64 i: Int64 j: Int64 v: Float64 -> Unit" "allFinite a: F64Array -> Bool" "identity n: Int64 -> F64Array" "transpose m: Int64 n: Int64 a: F64Array -> (Result F64Array String)") :more (matVec choleskyFactor choleskySolve choleskySolveSpd choleskyRcond Eigen eigenSym Lstsq lstsq lstsqTol defaultRankTol) :effects (asymmetric! toBuf fromBuf getAt! setAt! choleskyFactor choleskySolve choleskySolveSpd) :fails (transpose matVec choleskyFactor choleskySolve choleskySolveSpd choleskyRcond eigenSym lstsq) :example none)
(:sym "pow2Exponent" :mod "asl-linalg/dense" :sig "pow2Exponent m: Float64 e: Int64 -> Int64")
(:sym "mul2" :mod "asl-linalg/dense" :sig "mul2 x: Float64 e: Int64 -> Float64")
(:sym "scaleArray" :mod "asl-linalg/dense" :sig "scaleArray a: F64Array e: Int64 -> F64Array")
(:sym "maxAbs" :mod "asl-linalg/dense" :sig "maxAbs a: F64Array -> Float64" :doc "largest absolute value, 0 for an empty array")
(:sym "asymmetric!" :mod "asl-linalg/dense" :kind fn! :sig "asymmetric! a: Bytes n: Int64 i: Int64 j: Int64 -> Bool" :pit (effect))
(:sym "toBuf" :mod "asl-linalg/dense" :kind fn! :sig "toBuf a: F64Array -> Bytes" :pit (effect))
(:sym "fromBuf" :mod "asl-linalg/dense" :kind fn! :sig "fromBuf b: Bytes n: Int64 -> F64Array" :doc "copy n Float64 slots of a buffer out into a new F64Array" :pit (effect))
(:sym "getAt!" :mod "asl-linalg/dense" :kind fn! :sig "getAt! b: Bytes cols: Int64 i: Int64 j: Int64 -> Float64" :pit (effect))
(:sym "setAt!" :mod "asl-linalg/dense" :kind fn! :sig "setAt! b: Bytes cols: Int64 i: Int64 j: Int64 v: Float64 -> Unit" :pit (effect))
(:sym "allFinite" :mod "asl-linalg/dense" :sig "allFinite a: F64Array -> Bool")
(:sym "identity" :mod "asl-linalg/dense" :sig "identity n: Int64 -> F64Array")
(:sym "transpose" :mod "asl-linalg/dense" :sig "transpose m: Int64 n: Int64 a: F64Array -> (Result F64Array String)" :pit (result))
(:sym "matVec" :mod "asl-linalg/dense" :sig "matVec m: Int64 n: Int64 a: F64Array x: F64Array -> (Result F64Array String)" :pit (result))
(:sym "choleskyFactor" :mod "asl-linalg/cholesky" :kind fn! :sig "choleskyFactor n: Int64 a: F64Array -> (Result F64Array String)" :doc "Refuses non-symmetric or not positive definite input with linalgNotSymmetric or linalgNotPositiveDefinite; 500x500 takes 68 ms native." :pit (result effect))
(:sym "choleskySolve" :mod "asl-linalg/cholesky" :kind fn! :sig "choleskySolve n: Int64 l: F64Array b: F64Array -> (Result F64Array String)" :pit (result effect))
(:sym "choleskySolveSpd" :mod "asl-linalg/cholesky" :kind fn! :sig "choleskySolveSpd n: Int64 a: F64Array b: F64Array -> (Result F64Array String)" :pit (result effect))
(:sym "choleskyRcond" :mod "asl-linalg/cholesky" :kind fn! :sig "choleskyRcond n: Int64 a: F64Array l: F64Array -> (Result Float64 String)" :doc "A Hager-Higham estimate where about 1e-16 means no correct digit is left; refusing is the caller's choice, and Hilbert 6 and 12 land within a factor 3 of numpy." :pit (result effect))
(:sym "Eigen" :mod "asl-linalg/eigen" :kind type :sig "schema Eigen (:f values F64Array) (:f vectors F64Array) (:f sweeps Int64)" :pit (record))
(:sym "eigenSym" :mod "asl-linalg/eigen" :kind fn! :sig "eigenSym n: Int64 a: F64Array -> (Result Eigen String)" :pit (result effect))
(:sym "Lstsq" :mod "asl-linalg/qr" :kind type :sig "schema Lstsq (:f coef F64Array) (:f rank Int64) (:f residualNorm Float64) (:f tol Float64)" :pit (record))
(:sym "lstsq" :mod "asl-linalg/qr" :kind fn! :sig "lstsq m: Int64 n: Int64 a: F64Array b: F64Array -> (Result Lstsq String)" :pit (result effect))
(:sym "lstsqTol" :mod "asl-linalg/qr" :kind fn! :sig "lstsqTol m: Int64 n: Int64 a: F64Array b: F64Array tol: Float64 -> (Result Lstsq String)" :pit (result effect))
(:sym "defaultRankTol" :mod "asl-linalg/qr" :sig "defaultRankTol m: Int64 n: Int64 -> Float64")
