(:card "asl-media" :purpose "Typed ffprobe and ffmpeg runner, PNG codec, WAV codec with signal metrics, SRT and VTT captions and word error rate with ASR time alignment, pure AgentSlang" :import "(asl-media/probe :a x)" :deps (asl-json asl-zip) :modules ((:m "asl-media/probe") (:m "asl-media/align") (:m "asl-media/captions") (:m "asl-media/image") (:m "asl-media/imageHash")) :moduleCount 9 :sigs ("schema ProbeStream (:f index Int64) (:f kind String) (:f codec String) (:f pixFmt String) (:f width Int64) (:f height Int64) (:f fpsNum Int6..." "schema ProbeInfo (:f container String) (:f durationS Float64) (:f bitRate Int64) (:f size Int64) (:f streams (List ProbeStream)) (:f tags (L..." "parseProbe text: String -> (Result ProbeInfo String)" "probeArgv bin: String path: String -> (List String)" "ffmpegArgv bin: String args: (List String) -> (List String)" "pathAllowed? path: String roots: (List String) -> Bool" "inputAllowed! p: String roots: (List String) -> Bool") :more (outputAllowed! argBad? whichBin! ffprobeBin! ffmpegBin! probe! runFfmpeg! defaultFfprobe defaultFfmpeg parseRational AlignOp WerResult AsrWord TimedWord) :moreCount 72 :effects (inputAllowed! outputAllowed! whichBin! ffprobeBin! ffmpegBin! probe! runFfmpeg! alignWords) :fails (parseProbe probe! runFfmpeg! werOf werText cerText parseSrt parseVtt) :example none)
(:sym "ProbeStream" :mod "asl-media/probe" :kind type :sig "schema ProbeStream (:f index Int64) (:f kind String) (:f codec String) (:f pixFmt String) (:f width Int64) (:f height Int64) (:f fpsNum Int64) (:f fpsDen Int64) (:f sampleRate Int64) (:f channels Int64) (:f bitRate Int64) (:f durationS Float64) (:f tags (List (Pair String String)))" :pit (record))
(:sym "ProbeInfo" :mod "asl-media/probe" :kind type :sig "schema ProbeInfo (:f container String) (:f durationS Float64) (:f bitRate Int64) (:f size Int64) (:f streams (List ProbeStream)) (:f tags (List (Pair String String)))" :pit (record))
