(:card "asl-media" :purpose "Typed ffprobe and ffmpeg runner, PNG codec, WAV codec with signal metrics, SRT and VTT captions and word error rate with ASR time alignment, pure AgentSlang" :import "(asl-media/probe :a x)" :deps (asl-json asl-zip) :modules ((:m "asl-media/probe" :doc "Typed ffprobe and ffmpeg runner: parse ffprobe JSON into...") (:m "asl-media/align" :doc "Word error rate by unit-cost Levenshtein alignment and A...") (:m "asl-media/captions" :doc "SRT and WebVTT cues: parse, write with escapes, time for...") (:m "asl-media/image" :doc "RGBA8 image primitives over Bytes: build, crop, pad, fli...") (:m "asl-media/imageHash" :doc "64-bit perceptual hashes of an Image in an Int64: dHash,...")) :moduleCount 9 :sigs ("schema ProbeStream (:f index Int64) (:f kind String) (:f codec String) (:f pixFmt String) (:f width Int64) (:f height Int64) (:f fpsNum Int6..." "schema ProbeInfo (:f container String) (:f durationS Float64) (:f bitRate Int64) (:f size Int64) (:f streams (List ProbeStream)) (:f tags (L..." "parseProbe text: String -> (Result ProbeInfo String)" "probeArgv bin: String path: String -> (List String)" "ffmpegArgv bin: String args: (List String) -> (List String)" "pathAllowed? path: String roots: (List String) -> Bool" "inputAllowed! p: String roots: (List String) -> Bool") :more (outputAllowed! argBad? whichBin! ffprobeBin! ffmpegBin! probe! runFfmpeg! defaultFfprobe defaultFfmpeg parseRational AlignOp WerResult AsrWord TimedWord) :moreCount 72 :effects (inputAllowed! outputAllowed! whichBin! ffprobeBin! ffmpegBin! probe! runFfmpeg! alignWords) :fails (parseProbe probe! runFfmpeg! werOf werText cerText parseSrt parseVtt) :example none)
(:sym "ProbeStream" :mod "asl-media/probe" :kind type :sig "schema ProbeStream (:f index Int64) (:f kind String) (:f codec String) (:f pixFmt String) (:f width Int64) (:f height Int64) (:f fpsNum Int64) (:f fpsDen Int64) (:f sampleRate Int64) (:f channels Int64) (:f bitRate Int64) (:f durationS Float64) (:f tags (List (Pair String String)))" :doc "One stream of a probed file; fps is the rational fpsNum/fpsDen, fpsDen 0 means unknown" :pit (record))
(:sym "ProbeInfo" :mod "asl-media/probe" :kind type :sig "schema ProbeInfo (:f container String) (:f durationS Float64) (:f bitRate Int64) (:f size Int64) (:f streams (List ProbeStream)) (:f tags (List (Pair String String)))" :doc "Container name, duration seconds, bit rate, size, streams and format tags of a probed file" :pit (record))
(:sym "parseProbe" :mod "asl-media/probe" :sig "parseProbe text: String -> (Result ProbeInfo String)" :doc "ffprobe -print_format json text to (Result ProbeInfo String); err is labelled mediaParse" :pit (result))
(:sym "probeArgv" :mod "asl-media/probe" :sig "probeArgv bin: String path: String -> (List String)" :doc "argv for ffprobe with json format and streams output")
(:sym "ffmpegArgv" :mod "asl-media/probe" :sig "ffmpegArgv bin: String args: (List String) -> (List String)" :doc "ffmpeg argv with -nostdin and -hide_banner before the caller args")
(:sym "pathAllowed?" :mod "asl-media/probe" :sig "pathAllowed? path: String roots: (List String) -> Bool" :doc "absolute path under one of the roots, no .. segment, no NUL")
(:sym "inputAllowed!" :mod "asl-media/probe" :kind fn! :sig "inputAllowed! p: String roots: (List String) -> Bool" :doc "pathAllowed? plus the real path of an existing input under a real root, so a symlink out of the root is refused" :pit (effect))
(:sym "outputAllowed!" :mod "asl-media/probe" :kind fn! :sig "outputAllowed! p: String roots: (List String) -> Bool" :doc "pathAllowed? plus the real parent directory under a root and, for an existing symlink output, its real target; a dangling symlink is refused" :pit (effect))
(:sym "argBad?" :mod "asl-media/probe" :sig "argBad? tok: String inputs: (List String) outputs: (List String) -> Bool" :doc "true when an ffmpeg args token is not one of the checked inputs or outputs and looks like a path, protocol, file-reading filter, overwrite or input flag, or bare file name")
(:sym "whichBin!" :mod "asl-media/probe" :kind fn! :sig "whichBin! name: String fallback: String -> String" :doc "first PATH entry holding a file with the name, else the fallback" :pit (effect))
(:sym "ffprobeBin!" :mod "asl-media/probe" :kind fn! :sig "ffprobeBin! -> String" :doc "ffprobe from PATH, else defaultFfprobe" :pit (effect))
(:sym "ffmpegBin!" :mod "asl-media/probe" :kind fn! :sig "ffmpegBin! -> String" :doc "ffmpeg from PATH, else defaultFfmpeg" :pit (effect))
(:sym "probe!" :mod "asl-media/probe" :kind fn! :sig "probe! bin: String path: String roots: (List String) timeoutS: Int64 -> (Result ProbeInfo String)" :doc "probe a file under the allowlist with a timeout; errs are mediaPathNotAllowed, mediaTimeout, mediaExit or mediaParse" :pit (result effect))
(:sym "runFfmpeg!" :mod "asl-media/probe" :kind fn! :sig "runFfmpeg! bin: String inputs: (List String) outputs: (List String) args: (List String) roots: (List String) timeoutS: Int64 -> (Result String String)" :doc "run ffmpeg after every input and every declared output passes the allowlist (symlinks resolved, outputs by parent directory); returns stdout or a labelled err; args are options only: inputs become -i pairs and outputs trail, and a path, pro..." :pit (result effect))
(:sym "defaultFfprobe" :mod "asl-media/probe" :sig "defaultFfprobe -> String" :doc "/opt/homebrew/bin/ffprobe")
(:sym "defaultFfmpeg" :mod "asl-media/probe" :sig "defaultFfmpeg -> String" :doc "/opt/homebrew/bin/ffmpeg")
(:sym "parseRational" :mod "asl-media/probe" :sig "parseRational s: String -> (Pair Int64 Int64)" :doc "num/den text to a pair; anything else, or a zero denominator, is 0/0")
(:sym "AlignOp" :mod "asl-media/align" :kind type :sig "schema AlignOp (:f kind String) (:f refIdx Int64) (:f hypIdx Int64)" :doc "one alignment step: kind match sub del or ins and the reference and hypothesis indexes, -1 when absent" :pit (record))
(:sym "WerResult" :mod "asl-media/align" :kind type :sig "schema WerResult (:f subs Int64) (:f dels Int64) (:f ins Int64) (:f matches Int64) (:f refLen Int64) (:f hypLen Int64) (:f errors Int64) (:f wer Float64)" :doc "subs, dels, ins, matches, lengths, errors and wer = errors / refLen" :pit (record))
(:sym "AsrWord" :mod "asl-media/align" :kind type :sig "schema AsrWord (:f text String) (:f startMs Int64) (:f endMs Int64)" :doc "one ASR word with start and end ms" :pit (record))
(:sym "TimedWord" :mod "asl-media/align" :kind type :sig "schema TimedWord (:f word String) (:f startMs Int64) (:f endMs Int64) (:f status String)" :doc "a script word with ms times and a status: match, sub or interp" :pit (record))
(:sym "AlignResult" :mod "asl-media/align" :kind type :sig "schema AlignResult (:f words (List TimedWord)) (:f coverage Float64)" :doc "timed script words and the share of them that got an ASR time" :pit (record))
(:sym "normaliseWords" :mod "asl-media/align" :sig "normaliseWords text: String numerals: (List (Pair String String)) -> (List String)" :doc "text to lower-case words with apostrophes dropped, punctuation split and a numerals map applied")
(:sym "alignWords" :mod "asl-media/align" :kind fn! :sig "alignWords ref: (List String) hyp: (List String) same: (fn [String String] -> Bool) -> (Result (List AlignOp) String)" :doc "minimum edit alignment of two word lists with a caller same? predicate; err alignLimit above 25M cells" :pit (effect))
(:sym "werOf" :mod "asl-media/align" :kind fn! :sig "werOf ref: (List String) hyp: (List String) -> (Result WerResult String)" :doc "WerResult of two word lists with exact equality" :pit (result effect))
(:sym "werText" :mod "asl-media/align" :kind fn! :sig "werText refText: String hypText: String numerals: (List (Pair String String)) -> (Result WerResult String)" :doc "WerResult of two texts after normaliseWords" :pit (result effect))
(:sym "cerText" :mod "asl-media/align" :kind fn! :sig "cerText refText: String hypText: String numerals: (List (Pair String String)) -> (Result WerResult String)" :doc "character error rate of two texts after normalisation, over characters" :pit (result effect))
(:sym "mapAsrTimes" :mod "asl-media/align" :kind fn! :sig "mapAsrTimes script: (List String) asr: (List AsrWord) numerals: (List (Pair String String)) same: (fn [String String] -> Bool) -> (Result AlignResult String)" :doc "script words to TimedWord through the alignment: matched or substituted words take ASR times, deleted words are interpolated, monotone; err alignNoAnchor without any ASR anchor" :pit (effect))
(:sym "exactSame" :mod "asl-media/align" :sig "exactSame a: String b: String -> Bool" :doc "string equality, the default word comparison")
(:sym "Cue" :mod "asl-media/captions" :kind type :sig "schema Cue (:f startMs Int64) (:f endMs Int64) (:f text String) (:f settings String)" :doc "one caption cue: start and end ms, text with newlines, and the VTT cue settings kept verbatim" :pit (record))
(:sym "Word" :mod "asl-media/captions" :kind type :sig "schema Word (:f text String) (:f startMs Int64) (:f endMs Int64)" :doc "one timed word for groupWords" :pit (record))
(:sym "GroupLimits" :mod "asl-media/captions" :kind type :sig "schema GroupLimits (:f maxChars Int64) (:f maxLines Int64) (:f minMs Int64) (:f maxMs Int64) (:f maxCps Int64) (:f pauseMs Int64)" :doc "groupWords limits: characters per line, lines, minimum and maximum duration ms, characters per second, pause ms that forces a break" :pit (record))
(:sym "parseSrt" :mod "asl-media/captions" :sig "parseSrt raw: String -> (Result (List Cue) String)" :doc "SRT text to cues; BOM and CRLF accepted, index lines dropped, an err names the block" :pit (result))
(:sym "parseVtt" :mod "asl-media/captions" :sig "parseVtt raw: String -> (Result (List Cue) String)" :doc "WebVTT text to cues; header, NOTE, STYLE and REGION blocks dropped, cue ids dropped, settings kept, entities unescaped" :pit (result))
(:sym "writeSrt" :mod "asl-media/captions" :sig "writeSrt cues: (List Cue) -> (Result String String)" :doc "cues to SRT text with 1-based indexes; an err captionText when a cue text holds the --> arrow" :pit (result))
(:sym "writeVtt" :mod "asl-media/captions" :sig "writeVtt cues: (List Cue) -> (Result String String)" :doc "(Result String String): cues to WebVTT text with the WEBVTT header, escaped payloads and settings after the timing; a negative cue time is an err labelled captionTime" :pit (result))
(:sym "groupWords" :mod "asl-media/captions" :kind fn! :sig "groupWords words: (List Word) lim: GroupLimits -> (List Cue)" :doc "timed words to cues by a greedy grouping under the limits" :pit (effect))
(:sym "cueOverlaps" :mod "asl-media/captions" :sig "cueOverlaps cues: (List Cue) -> (List Int64)" :doc "indexes of cues that start before the previous cue ends")
(:sym "cueViolations" :mod "asl-media/captions" :sig "cueViolations cues: (List Cue) lim: GroupLimits -> (List Int64)" :doc "indexes of cues that break a limit")
(:sym "formatTime" :mod "asl-media/captions" :sig "formatTime ms: Int64 sep: String -> (Result String String)" :doc "(Result String String): ms to HH:MM:SS then the separator then mmm, comma for SRT and dot for VTT; a negative ms is an err labelled captionTime" :pit (result))
(:sym "parseTime" :mod "asl-media/captions" :sig "parseTime t: String -> (Result Int64 String)" :doc "HH:MM:SS,mmm or MM:SS.mmm to ms; every field must be plain digits (no sign), minutes and seconds below 60, hours uncapped; anything else is an err labelled captionTime" :pit (result))
(:sym "msFromSeconds" :mod "asl-media/captions" :sig "msFromSeconds s: Float64 -> Int64" :doc "seconds to ms, half up")
(:sym "escapeVtt" :mod "asl-media/captions" :sig "escapeVtt s: String -> String" :doc "escape & < > for a VTT payload after dropping blank and whitespace-only lines; the cue tags i b u and their closers stay as markup, every other angle bracket is escaped")
(:sym "unescapeVtt" :mod "asl-media/captions" :sig "unescapeVtt s: String -> String" :doc "inverse of escapeVtt")
(:sym "Image" :mod "asl-media/image" :kind type :sig "schema Image (:f width Int64) (:f height Int64) (:f rgba Bytes)" :doc "width, height and straight-alpha RGBA8 Bytes of exactly width*height*4, row-major, top row first" :pit (record))
(:sym "imageNew" :mod "asl-media/image" :sig "imageNew w: Int64 h: Int64 rgba: Bytes -> (Result Image String)" :doc "validate size and byte count into an Image; err imageSize" :pit (result))
(:sym "imageSolid" :mod "asl-media/image" :sig "imageSolid w: Int64 h: Int64 r: Int64 g: Int64 b: Int64 a: Int64 -> (Result Image String)" :doc "a w by h image of one RGBA colour; errs imageSize and imageChannel" :pit (result))
(:sym "imageCrop" :mod "asl-media/image" :sig "imageCrop img: Image x: Int64 y: Int64 w: Int64 h: Int64 -> (Result Image String)" :doc "the w by h window at x,y; err imageBounds when it is empty, negative-origin or leaves the image" :pit (result))
(:sym "imagePad" :mod "asl-media/image" :sig "imagePad img: Image top: Int64 right: Int64 bottom: Int64 left: Int64 r: Int64 g: Int64 b: Int64 a: Int64 -> (Result Image String)" :doc "add top right bottom left pixels of one fill colour around the image; err imageBounds on a negative size, imageChannel on a bad colour" :pit (result))
(:sym "imageFlipH" :mod "asl-media/image" :sig "imageFlipH img: Image -> Image" :doc "mirror each row")
(:sym "imageFlipV" :mod "asl-media/image" :sig "imageFlipV img: Image -> Image" :doc "swap rows top to bottom")
(:sym "imagePremultiply" :mod "asl-media/image" :sig "imagePremultiply img: Image -> Image" :doc "colour = (c*a+127)/255 integer, alpha unchanged")
(:sym "imageUnpremultiply" :mod "asl-media/image" :sig "imageUnpremultiply img: Image -> Image" :doc "colour = (c*255+a/2)/a clamped to 255, alpha 0 gives colour 0")
(:sym "imageComposite" :mod "asl-media/image" :sig "imageComposite dst: Image src: Image ox0: Int64 oy0: Int64 -> Image" :doc "source-over of src onto dst with src top-left at ox,oy; offsets are clamped by clampOffset; the part of src outside dst is clipped and a src fully outside changes nothing; returns a new image of the destination size")
(:sym "imageAlpha" :mod "asl-media/image" :sig "imageAlpha img: Image -> Bytes" :doc "width*height alpha bytes")
(:sym "imageHistogram" :mod "asl-media/image" :sig "imageHistogram img: Image ch: Int64 -> (Result (List Int64) String)" :doc "256 counts of channel 0..3; err imageChannel otherwise" :pit (result))
(:sym "imageMean" :mod "asl-media/image" :sig "imageMean img: Image ch: Int64 -> (Result Float64 String)" :doc "mean of channel 0..3 as Float64; err imageChannel otherwise" :pit (result))
(:sym "imageGray" :mod "asl-media/image" :sig "imageGray img: Image -> Image" :doc "BT.601 integer gray (299r+587g+114b+500)/1000 into r g b with alpha 255")
(:sym "maxImagePixels" :mod "asl-media/image" :sig "maxImagePixels -> Int64" :doc "67108864, the largest width*height any op accepts")
(:sym "dimOk?" :mod "asl-media/image" :sig "dimOk? w: Int64 h: Int64 -> Bool" :doc "true when width and height are positive, each at most maxImagePixels and the product too (no overflow)")
(:sym "fillBytes!" :mod "asl-media/image" :kind fn! :sig "fillBytes! out: Bytes f: (fn [Int64] -> Int64) j: Int64 n: Int64 -> Unit" :doc "set out[j] = f(j) for j from j to n, the shared per-byte loop" :pit (effect))
(:sym "gatherBytes!" :mod "asl-media/image" :kind fn! :sig "gatherBytes! out: Bytes src: Bytes f: (fn [Int64] -> Int64) j: Int64 n: Int64 -> Unit" :doc "set out[j] = src[f(j)] for j from j to n, the shared copy loop" :pit (effect))
(:sym "roundHalfUp" :mod "asl-media/image" :sig "roundHalfUp f: Float64 -> Int64" :doc "Float64 to Int64 by floor(f+0.5)")
(:sym "clampByte" :mod "asl-media/image" :sig "clampByte v: Int64 -> Int64" :doc "clamp an Int64 to 0..255")
(:sym "imageDHash" :mod "asl-media/imageHash" :sig "imageDHash img: im/Image -> (Result Int64 String)" :doc "(Result Int64 String): gray, area to 9x8, bit = left greater than right, row-major, first bit most significant; a resize err is returned" :pit (result))
(:sym "imagePHash" :mod "asl-media/imageHash" :kind fn! :sig "imagePHash img: im/Image -> (Result Int64 String)" :doc "(Result Int64 String): gray, area to 32x32, DCT-II of the 8x8 lowest frequencies, bit = coefficient greater than the median of the 63 AC coefficients (DC is compared but not part of the median); defined here, not bit-compatible with other l..." :pit (result effect))
(:sym "hashHex" :mod "asl-media/imageHash" :sig "hashHex h: Int64 -> String" :doc "16 lower-case hex digits of a hash")
(:sym "hammingDistance" :mod "asl-media/imageHash" :sig "hammingDistance a: Int64 b: Int64 -> Int64" :doc "number of differing bits of two hashes")
(:sym "imageResize" :mod "asl-media/imageResize" :sig "imageResize img: im/Image method: String w: Int64 h: Int64 -> (Result im/Image String)" :doc "resize to w by h by a method name; errs imageSize for a bad target and imageMethod for an unknown name; area is the exact box overlap, bilinear and lanczos3 widen by the scale on downscale, nearest samples the centre" :pit (result))
(:sym "resizeMethods" :mod "asl-media/imageResize" :sig "resizeMethods -> (List String)" :doc "nearest bilinear area lanczos3")
(:sym "weightRange" :mod "asl-media/imageResize" :sig "weightRange kind: String o: Int64 s: Int64 scale: Float64 -> (Pair Int64 Int64)" :doc "first tap and last tap source index of an output index, clamped to the image")
(:sym "kernelWeight" :mod "asl-media/imageResize" :sig "kernelWeight kind: String i: Int64 o: Int64 scale: Float64 -> Float64" :doc "unnormalised weight of source pixel i for output pixel o")
(:sym "Biquad" :mod "asl-media/loudness" :kind type :sig "schema Biquad (:f b0 Float64) (:f b1 Float64) (:f b2 Float64) (:f a1 Float64) (:f a2 Float64)" :doc "direct-form biquad coefficients, a0 normalised to 1" :pit (record))
(:sym "shelfCoeffs" :mod "asl-media/loudness" :sig "shelfCoeffs fs: Int64 -> Biquad" :doc "K-weighting high-shelf stage for a sample rate")
(:sym "highpassCoeffs" :mod "asl-media/loudness" :sig "highpassCoeffs fs: Int64 -> Biquad" :doc "K-weighting RLB high-pass stage for a sample rate")
(:sym "integratedLufs!" :mod "asl-media/loudness" :kind fn! :sig "integratedLufs! w: wav/WavAudio -> (Result Float64 String)" :doc "WavAudio to integrated LUFS; err loudnessRate under 3400 Hz, loudnessShort under one block, loudnessSilent when nothing passes the gates; channels 3 to 5 weigh 1.0 and per-block energies use a double prefix sum, whose rounding is not bounde..." :pit (result effect))
(:sym "blockEnergies!" :mod "asl-media/loudness" :kind fn! :sig "blockEnergies! w: wav/WavAudio -> (Pair Bytes Int64)" :doc "per-block mean square of the K-weighted, channel-weighted signal as (Bytes of Float64, block count)" :pit (effect))
(:sym "PngImage" :mod "asl-media/png" :kind type :sig "schema PngImage (:f width Int64) (:f height Int64) (:f bitDepth Int64) (:f colorType Int64) (:f gamma Int64) (:f srgb Int64) (:f hasIccp Bool) (:f hasTrns Bool) (:f rgba Bytes)" :doc "decoded image: size, source bit depth and colour type, gAMA*100000 or -1, sRGB intent or -1, iCCP and tRNS flags, RGBA8 bytes" :pit (record))
(:sym "pngDecode!" :mod "asl-media/png" :kind fn! :sig "pngDecode! data: Bytes maxPixels: Int64 -> (Result PngImage String)" :doc "bytes and a pixel budget to a PngImage; colour types 0 2 3 4 6 at 1 to 16 bits, all filters, tRNS applied as alpha, chunk CRC and adler32 checked; Adam7 is a labelled pngUnsupported; Adam7 is a labelled pngUnsupported; inflate output is cap..." :pit (result effect))
(:sym "pngEncode!" :mod "asl-media/png" :kind fn! :sig "pngEncode! w: Int64 h: Int64 rgba: Bytes -> (Result Bytes String)" :doc "width height RGBA8 bytes to PNG bytes: colour type 6, per-row minimum-sum filter, one IDAT, deterministic" :pit (result effect))
(:sym "adler32" :mod "asl-media/png" :sig "adler32 bs: Bytes -> Int64" :doc "RFC 1950 adler32 of the whole bytes")
(:sym "zlibWrap!" :mod "asl-media/png" :sig "zlibWrap! raw: Bytes -> (Result Bytes String)" :doc "raw bytes to a zlib stream: header 78 9c, deflate level 6, adler32 trailer" :pit (result effect))
(:sym "WavAudio" :mod "asl-media/wav" :kind type :sig "schema WavAudio (:f channels Int64) (:f sampleRate Int64) (:f bitsPerSample Int64) (:f isFloat Bool) (:f frames Int64) (:f samples Bytes)" :doc "decoded audio: channels, rate, source bit depth, float flag, frames, interleaved Float64 samples in a Bytes" :pit (record))
(:sym "WavStats" :mod "asl-media/wav" :kind type :sig "schema WavStats (:f peak Float64) (:f rms Float64) (:f clipCount Int64) (:f silenceRatio Float64) (:f dcOffset Float64)" :doc "peak, rms, clipCount, silenceRatio and dcOffset of a WavAudio" :pit (record))
(:sym "wavDecode!" :mod "asl-media/wav" :kind fn! :sig "wavDecode! bs: Bytes maxFrames: Int64 -> (Result WavAudio String)" :doc "bytes and a frame budget to WavAudio; walks chunks tolerating LIST and odd padding, extensible format by subformat tag; errs are labelled wavTruncated wavFormat wavStructure wavUnsupported wavLimit wavFloat" :pit (result effect))
(:sym "wavEncode!" :mod "asl-media/wav" :kind fn! :sig "wavEncode! w: WavAudio -> (Result Bytes String)" :doc "WavAudio to canonical 44-byte-header WAV bytes at 16 24 32 bit PCM or float32; PCM scales by 2^(bits-1) with clamping so decode inverts it" :pit (result effect))
(:sym "wavStats" :mod "asl-media/wav" :kind fn! :sig "wavStats w: WavAudio clipAt: Float64 silenceBelow: Float64 -> WavStats" :doc "stats with a clip threshold and a silence threshold, both linear magnitudes; empty audio gives zeros" :pit (effect))
(:sym "wavSampleAt" :mod "asl-media/wav" :sig "wavSampleAt w: WavAudio i: Int64 -> Float64" :doc "sample at interleaved index i")
(:sym "wavFrames" :mod "asl-media/wav" :sig "wavFrames w: WavAudio -> Int64" :doc "frame count")
(:sym "wavSilentFrames" :mod "asl-media/wav" :kind fn! :sig "wavSilentFrames w: WavAudio thr: Float64 -> Int64" :doc "frames whose every channel magnitude is below the threshold" :pit (effect))
(:sym "pow2f" :mod "asl-media/wav" :sig "pow2f n: Int64 -> Float64" :doc "2 to the integer power as Float64")
(:sym "float32FromBits" :mod "asl-media/wav" :sig "float32FromBits bits: Int64 -> (Result Float64 String)" :doc "IEEE-754 binary32 bits to Float64; infinity and NaN are an err" :pit (result))
(:sym "float32ToBits" :mod "asl-media/wav" :sig "float32ToBits x: Float64 -> Int64" :doc "Float64 to nearest binary32 bits (half away from zero, not to even), denormals handled, NaN is 0x7FC00000, -0.0 encodes as +0.0, overflow clamps to the largest finite")
