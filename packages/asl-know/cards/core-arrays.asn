(:card "core/arrays" :purpose "Arrays builtins, no import" :sigs ("f64ArrayLen : F64Array -> Int64" "f64ArrayGet : F64Array Int64 -> Float64" "f64ArraySlice : F64Array Int64 Int64 -> F64Array" "f64ArrayConcat : (List F64Array) -> F64Array" "f64ArrayGenerate : Int64 (fn [Int64] -> Float64) -> F64Array" "f64ArraySum : F64Array -> Float64" "f64ArrayCountEq : F64Array Float64 -> Int64" "f64ArrayFold : (fn [B Float64] -> B) B F64Array -> B" "f64ArrayScan : (fn [Float64 Float64] -> Float64) Float64 F64Array -> F64Array" "dot : F64Array F64Array -> Float64" "axpy : Float64 F64Array F64Array -> F64Array" "gemm : Int64 Int64 Int64 F64Array F64Array -> F64Array") :more (i64ArrayLen i64ArrayGet i64ArraySlice i64ArrayConcat i64ArrayGenerate i64ArraySum i64ArrayCountEq i64ArrayFold i64ArrayScan i8ArrayLen i8ArrayGet i8ArraySlice) :moreCount 6 :example none)
(:sym "f64ArrayLen" :sig "f64ArrayLen : F64Array -> Int64" :doc "Element count.")
(:sym "f64ArrayGet" :sig "f64ArrayGet : F64Array Int64 -> Float64" :doc "Element at an index; an index outside the array traps with ERR_RANGE.")
(:sym "f64ArraySlice" :sig "f64ArraySlice : F64Array Int64 Int64 -> F64Array" :doc "Half-open copy; bounds outside the array trap with ERR_RANGE.")
(:sym "f64ArrayConcat" :sig "f64ArrayConcat : (List F64Array) -> F64Array" :doc "Concatenate a list of arrays.")
(:sym "f64ArrayGenerate" :sig "f64ArrayGenerate : Int64 (fn [Int64] -> Float64) -> F64Array" :doc "Array of n elements, element i from the function applied to i.")
(:sym "f64ArraySum" :sig "f64ArraySum : F64Array -> Float64" :doc "Neumaier-compensated sum.")
(:sym "f64ArrayCountEq" :sig "f64ArrayCountEq : F64Array Float64 -> Int64" :doc "Number of elements equal to the value.")
(:sym "f64ArrayFold" :sig "f64ArrayFold : (fn [B Float64] -> B) B F64Array -> B" :doc "Left fold.")
(:sym "f64ArrayScan" :sig "f64ArrayScan : (fn [Float64 Float64] -> Float64) Float64 F64Array -> F64Array" :doc "Every intermediate accumulator of a left fold, as an array.")
(:sym "dot" :sig "dot : F64Array F64Array -> Float64" :doc "Dot product of two Float64 arrays; traps on shape mismatch with ERR_SHAPE.")
(:sym "axpy" :sig "axpy : Float64 F64Array F64Array -> F64Array" :doc "Scaled vector add: y := a*x + y, returning a new Float64 array; traps on shape mismatch with ERR_SHAPE.")
(:sym "gemm" :sig "gemm : Int64 Int64 Int64 F64Array F64Array -> F64Array" :doc "Row-major matrix multiplication: C := A * B for m x k matrix A and k x n matrix B, returning a new Float64 array of shape m x n; traps on shape mismatch with ERR_SHAPE or negative dimensions with ERR_RANGE.")
(:sym "i64ArrayLen" :sig "i64ArrayLen : I64Array -> Int64" :doc "Element count.")
(:sym "i64ArrayGet" :sig "i64ArrayGet : I64Array Int64 -> Int64" :doc "Element at an index; an index outside the array traps with ERR_RANGE.")
(:sym "i64ArraySlice" :sig "i64ArraySlice : I64Array Int64 Int64 -> I64Array" :doc "Half-open copy; bounds outside the array trap with ERR_RANGE.")
(:sym "i64ArrayConcat" :sig "i64ArrayConcat : (List I64Array) -> I64Array" :doc "Concatenate a list of arrays.")
(:sym "i64ArrayGenerate" :sig "i64ArrayGenerate : Int64 (fn [Int64] -> Int64) -> I64Array" :doc "Array of n elements, element i from the function applied to i.")
(:sym "i64ArraySum" :sig "i64ArraySum : I64Array -> Int64" :doc "Sum; traps on Int64 overflow.")
(:sym "i64ArrayCountEq" :sig "i64ArrayCountEq : I64Array Int64 -> Int64" :doc "Number of elements equal to the value.")
(:sym "i64ArrayFold" :sig "i64ArrayFold : (fn [Int64 Int64] -> Int64) Int64 I64Array -> Int64" :doc "Left fold. The accumulator must end as an Int.")
(:sym "i64ArrayScan" :sig "i64ArrayScan : (fn [Int64 Int64] -> Int64) Int64 I64Array -> I64Array" :doc "Every intermediate accumulator of a left fold, as an array.")
(:sym "i8ArrayLen" :sig "i8ArrayLen : I8Array -> Int64" :doc "Element count.")
(:sym "i8ArrayGet" :sig "i8ArrayGet : I8Array Int64 -> Int64" :doc "Element at an index; an index outside the array traps with ERR_RANGE.")
(:sym "i8ArraySlice" :sig "i8ArraySlice : I8Array Int64 Int64 -> I8Array" :doc "Half-open copy; bounds outside the array trap with ERR_RANGE.")
(:sym "i8ArrayConcat" :sig "i8ArrayConcat : (List I8Array) -> I8Array" :doc "Concatenate a list of arrays.")
(:sym "i8ArrayGenerate" :sig "i8ArrayGenerate : Int64 (fn [Int64] -> Int64) -> I8Array" :doc "Array of n elements, element i from the function applied to i. An element outside -128..127 traps.")
(:sym "i8ArraySum" :sig "i8ArraySum : I8Array -> Int64" :doc "Sum; traps on Int64 overflow.")
(:sym "i8ArrayCountEq" :sig "i8ArrayCountEq : I8Array Int64 -> Int64" :doc "Number of elements equal to the value.")
(:sym "i8ArrayFold" :sig "i8ArrayFold : (fn [Int64 Int64] -> Int64) Int64 I8Array -> Int64" :doc "Left fold. The accumulator must end as an Int.")
(:sym "i8ArrayScan" :sig "i8ArrayScan : (fn [Int64 Int64] -> Int64) Int64 I8Array -> I8Array" :doc "Every intermediate accumulator of a left fold, as an array.")
