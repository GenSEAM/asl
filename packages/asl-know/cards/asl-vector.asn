(:card "asl-vector" :purpose "Pure AgentSlang Native Image-to-SVG Vector Synthesizer and Gestalt Semiotics Engine" :import "(asl-vector/vectorizer :a x)" :modules ((:m "asl-vector/vectorizer" :doc "Pure AgentSlang end-to-end Image-to-SVG vector synthesiz...") (:m "asl-vector/color" :doc "Perceptually uniform color quantization, CIELAB conversi...") (:m "asl-vector/emitter" :doc "Minimal-token SVG and pure-ASN vector generator with coo...") (:m "asl-vector/marching" :doc "Marching squares 2D contour tracer and polyline extracti...") (:m "asl-vector/primitives" :doc "Geometric primitive fitting and substitution: rect, circ...")) :moduleCount 6 :sigs ("vectorizeBitmap grid: (List (List Int)) width: Int height: Int palette: (List (List Int)) -> String" "vectorizeLayer mask: (List (List Int)) width: Int height: Int rgb: (List Int) -> (List String)" "extractColorLayers grid: (List (List Int)) width: Int height: Int palette: (List (List Int)) -> (List (List Any))" "rgbToLab r: Int g: Int b: Int -> (List F64)" "labDeltaE lab1: (List F64) lab2: (List F64) -> F64" "quantizeColor colorRgb: (List Int) palette: (List (List Int)) -> (List Int)" "formatHexColor rgb: (List Int) -> String" "parseHexColor hex: String -> (List Int)") :more (emitSvgHeader emitSvgFooter emitPathElement emitRectElement emitCircleElement emitVectorAsset quantizeCoord traceMaskContours polygonBBox polygonArea) :moreCount 10 :example none)
