(:card "asl-crawler" :purpose "Sovereign Web Crawler, In-Browser Automation, Human Kinetics, and Multi-Tier Parsing Nexus" :import "(aslCrawler/crawler :a x)" :deps (asl-text asl-json aslAgentBus) :modules ((:m "aslCrawler/crawler" :doc "Parallel stealth web crawler pipeline, HTTP fetch genera...") (:m "aslCrawler/automation" :doc "Pure ASL Action DAG engine for browser automation: navig...") (:m "aslCrawler/browserDetector" :doc "System browser detection and headless automation launche...") (:m "aslCrawler/inBrowserAgent" :doc "Pure ASL In-Browser Resident Agent generator: produces z...") (:m "aslCrawler/kinetics" :doc "Pure ASL mathematical human motor kinetics: cubic Bezier...")) :moduleCount 7 :sigs ("(schema CrawlJob (:f url Str) (:f profile st/StealthProfile) (:f timeoutMs I64) (:f followRedirects Bool) (:f maxRetries I64))" "(schema CrawlResult (:f url Str) (:f statusCode I64) (:f rawHtml Str) (:f charCount I64) (:f isSuccess Bool) (:f errorMsg Str))" "(schema CrawlPool (:f concurrency I64) (:f timeoutMs I64) (:f profile st/StealthProfile))" "crawlJob url: Str profile: st/StealthProfile -> CrawlJob" "makeCrawlJob url: Str profile: st/StealthProfile -> CrawlJob" "makePool concurrency: I64 profile: st/StealthProfile -> CrawlPool") :more (poolJobs crawlOk crawlErr statusOk? curlArgs crawlDoc crawlAsn crawlDistilledAsn isSpaShell? makeSuccessResult makeFailureResult isSuccessfulStatus) :moreCount 101 :effects (fetchCurl! fetchStealthBrowser! findStealthBrowser! runArgv!) :fails (fetchCurl! fetchStealthBrowser! runArgv!) :example none)
