(:card "asl-target-sh" :purpose "Universal Shell, PowerShell, and Distribution Target Transpiler under ADR D133 / SSOT" :import "(asl-target-sh/emitSh :a x)" :modules ((:m "asl-target-sh/emitSh" :doc "Deterministic POSIX /bin/sh pretty printer with single-q...") (:m "asl-target-sh/ast" :doc "Pure ShAst schema hierarchy and node constructors for tr...") (:m "asl-target-sh/distrib" :doc "Pure ASL Single-Source-of-Truth (SSOT) Distribution Gene...") (:m "asl-target-sh/emitCmd" :doc "Deterministic Windows CMD batch (.cmd / .bat) code gener...") (:m "asl-target-sh/emitPs1" :doc "Deterministic Windows PowerShell (.ps1) code generator a...")) :moduleCount 7 :sigs ("formatShScript script: ast/ShScript -> String" "formatShStmt stmt: ast/ShStmt indent: Int64 -> String" "formatShExpr expr: ast/ShExpr -> String" "formatRedirect red: ast/ShRedirect -> String" "formatTestExpr expr: ast/ShExpr -> String" "escapeDoubleQuotes s: String -> String" "escapeSingleQuotes s: String -> String" "mangleIdent name: String -> String" "(schema ShScript (:f shebang String) (:f comments (List String)) (:f functions (List ShFunction)) (:f body (List ShStmt)))" "(schema ShFunction (:f name String) (:f body (List ShStmt)))") :more (ShRedirect ShStmt ShExpr makeShScript makeShFunction makeShRedirect makeShAssign makeShIf makeShCall makeShReturn makeShExit makeShLitStr makeShLitInt) :moreCount 87 :effects (installMain! runArgv! chmodTo! writeOut! writeErr! readText! isRegular! isDir!) :fails (runArgv! chmodTo! readText! copyTree!) :example none)
