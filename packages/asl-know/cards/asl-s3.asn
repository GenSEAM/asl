(:card "asl-s3" :purpose "Pure ASL AWS S3 request construction and Signature Version 4 signing" :import "(asl-s3/sigv4 :a x)" :deps (asl-crypto asl-syntax) :modules ((:m "asl-s3/sigv4" :doc "Pure AWS Signature Version 4 canonicalization and signin...") (:m "asl-s3/s3Request" :doc "Pure S3 request records and bounded response extraction.")) :sigs ("(schema QueryParam (:f name String) (:f value String))" "(schema Header (:f name String) (:f value String))" "(schema PresignError (:f actual Int64))" "uriEncode value: String -> String" "canonicalUri path: String -> String" "canonicalQuery query: (List QueryParam) -> String" "canonicalHeaders headers: (List Header) -> String" "signedHeaderNames headers: (List Header) -> String" "canonicalRequest method: String path: String query: (List QueryParam) headers: (List Header) bodyHash: String -> String" "stringToSign amzDate: String scope: String request: String -> String") :more (deriveSigningKey signature authorization presign payloadHash Request request putObject getObject listObjectsV2 deleteObject createMultipartUpload uploadPart) :moreCount 4 :fails (presign parseListResponse parseMultipartResponse parseErrorDocument) :example none)
(:sym "QueryParam" :mod "asl-s3/sigv4" :kind type :sig "(schema QueryParam (:f name String) (:f value String))" :doc "One query-string name/value pair to canonicalize and sign" :pit (record))
(:sym "Header" :mod "asl-s3/sigv4" :kind type :sig "(schema Header (:f name String) (:f value String))" :doc "One HTTP header name/value pair to canonicalize and sign" :pit (record))
(:sym "PresignError" :mod "asl-s3/sigv4" :kind type :sig "(schema PresignError (:f actual Int64))" :doc "presign's failure: actual holds the offending field's value" :pit (record))
(:sym "uriEncode" :mod "asl-s3/sigv4" :sig "uriEncode value: String -> String" :doc "RFC 3986 percent-encodes value, leaving unreserved characters as-is")
(:sym "canonicalUri" :mod "asl-s3/sigv4" :sig "canonicalUri path: String -> String" :doc "SigV4 canonical URI: path, percent-encoded per segment, with a leading /")
(:sym "canonicalQuery" :mod "asl-s3/sigv4" :sig "canonicalQuery query: (List QueryParam) -> String" :doc "SigV4 canonical query string: each param URI-encoded and sorted")
(:sym "canonicalHeaders" :mod "asl-s3/sigv4" :sig "canonicalHeaders headers: (List Header) -> String" :doc "SigV4 canonical headers block: lower-cased names, trimmed/collapsed values, sorted and merged by name")
(:sym "signedHeaderNames" :mod "asl-s3/sigv4" :sig "signedHeaderNames headers: (List Header) -> String" :doc "Semicolon-joined, sorted, lower-cased header names for the SignedHeaders field")
(:sym "canonicalRequest" :mod "asl-s3/sigv4" :sig "canonicalRequest method: String path: String query: (List QueryParam) headers: (List Header) bodyHash: String -> String" :doc "The full SigV4 canonical request: method, canonical URI/query/headers, signed headers and bodyHash")
(:sym "stringToSign" :mod "asl-s3/sigv4" :sig "stringToSign amzDate: String scope: String request: String -> String" :doc "The SigV4 string to sign: algorithm, amzDate, credential scope and the canonical request's hash")
(:sym "deriveSigningKey" :mod "asl-s3/sigv4" :sig "deriveSigningKey secret: String date: String region: String service: String -> Bytes" :doc "Derives the SigV4 signing key by HMAC-chaining secret through date, region and service")
(:sym "signature" :mod "asl-s3/sigv4" :sig "signature secret: String date: String region: String service: String amzDate: String request: String -> String" :doc "The hex HMAC-SHA256 signature of request's string-to-sign under the derived signing key")
(:sym "authorization" :mod "asl-s3/sigv4" :sig "authorization accessKey: String secret: String date: String region: String service: String amzDate: String method: String path: String query: (List QueryParam) headers: (List Header) bodyHash: String -> String" :doc "Builds the SigV4 Authorization header value for the given request")
(:sym "presign" :mod "asl-s3/sigv4" :sig "presign accessKey: String secret: String date: String region: String service: String amzDate: String expiry: Int64 method: String path: String query: (List QueryParam) headers: (List Header) bodyHash: String -> (Result String PresignError)" :doc "Builds a presigned-URL query string valid for expiry seconds; Err(PresignError) when expiry is out of range" :pit (result))
(:sym "payloadHash" :mod "asl-s3/sigv4" :sig "payloadHash body: Bytes -> String" :doc "Hex SHA-256 of body, for the canonical request's bodyHash")
(:sym "Request" :mod "asl-s3/s3Request" :kind type :sig "(schema Request (:f method String) (:f host String) (:f path String) (:f query (List s/QueryParam)) (:f headers (List s/Header)) (:f body String))" :doc "An unsigned S3 HTTP request: method, host, path, query, headers and body" :pit (record))
(:sym "request" :mod "asl-s3/s3Request" :sig "request method: String endpoint: String bucket: String key: String virtualHosted: Bool queryParams: (List s/QueryParam) headers: (List s/Header) body: String -> Request" :doc "Builds a Request for key under bucket at endpoint, virtual-hosted or path-style, with the given query/headers/body")
(:sym "putObject" :mod "asl-s3/s3Request" :sig "putObject endpoint: String bucket: String key: String virtualHosted: Bool contentType: String body: String -> Request" :doc "A PUT Request that stores body as key with contentType")
(:sym "getObject" :mod "asl-s3/s3Request" :sig "getObject endpoint: String bucket: String key: String virtualHosted: Bool -> Request" :doc "A GET Request for key")
(:sym "listObjectsV2" :mod "asl-s3/s3Request" :sig "listObjectsV2 endpoint: String bucket: String virtualHosted: Bool prefix: String continuationToken: String maxKeys: Int64 -> Request" :doc "A GET Request for the ListObjectsV2 bucket listing, filtered by prefix/continuationToken/maxKeys")
(:sym "deleteObject" :mod "asl-s3/s3Request" :sig "deleteObject endpoint: String bucket: String key: String virtualHosted: Bool -> Request" :doc "A DELETE Request for key")
(:sym "createMultipartUpload" :mod "asl-s3/s3Request" :sig "createMultipartUpload endpoint: String bucket: String key: String virtualHosted: Bool contentType: String -> Request" :doc "A POST Request that starts a multipart upload for key with contentType")
(:sym "uploadPart" :mod "asl-s3/s3Request" :sig "uploadPart endpoint: String bucket: String key: String virtualHosted: Bool uploadId: String partNumber: Int64 body: String -> Request" :doc "A PUT Request that uploads partNumber of body to the uploadId multipart upload")
(:sym "completeMultipartUpload" :mod "asl-s3/s3Request" :sig "completeMultipartUpload endpoint: String bucket: String key: String virtualHosted: Bool uploadId: String body: String -> Request" :doc "A POST Request that completes the uploadId multipart upload with body's part list XML")
(:sym "parseListResponse" :mod "asl-s3/s3Request" :sig "parseListResponse xmlText: String -> (Result (List XmlField) String)" :doc "Extracts the Key/IsTruncated/NextContinuationToken fields from a ListObjectsV2 response body" :pit (result))
(:sym "parseMultipartResponse" :mod "asl-s3/s3Request" :sig "parseMultipartResponse xmlText: String -> (Result (List XmlField) String)" :doc "Extracts the UploadId/ETag fields from a multipart-upload response body" :pit (result))
(:sym "parseErrorDocument" :mod "asl-s3/s3Request" :sig "parseErrorDocument xmlText: String -> (Result S3Error S3Error)" :doc "Parses an S3 <Error> response body; always returns Err(S3Error), the parsed code/message or a MalformedXML/MalformedError S3Error" :pit (result))
