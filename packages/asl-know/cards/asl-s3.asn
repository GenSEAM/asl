(:card "asl-s3" :purpose "Pure ASL AWS S3 request construction and Signature Version 4 signing" :import "(asl-s3/sigv4 :a x)" :deps (asl-crypto asl-syntax) :modules ((:m "asl-s3/sigv4") (:m "asl-s3/s3Request")) :sigs ("(schema QueryParam (:f name String) (:f value String))" "(schema Header (:f name String) (:f value String))" "(schema PresignError (:f actual Int64))" "uriEncode value: String -> String" "canonicalUri path: String -> String" "canonicalQuery query: (List QueryParam) -> String" "canonicalHeaders headers: (List Header) -> String" "signedHeaderNames headers: (List Header) -> String" "canonicalRequest method: String path: String query: (List QueryParam) headers: (List Header) bodyHash: String -> String" "stringToSign amzDate: String scope: String request: String -> String") :more (deriveSigningKey signature authorization presign payloadHash Request request putObject getObject listObjectsV2 deleteObject createMultipartUpload uploadPart) :moreCount 4 :fails (presign parseListResponse parseMultipartResponse parseErrorDocument) :example none)
(:sym "QueryParam" :mod "asl-s3/sigv4" :kind type :sig "(schema QueryParam (:f name String) (:f value String))" :pit (record))
(:sym "Header" :mod "asl-s3/sigv4" :kind type :sig "(schema Header (:f name String) (:f value String))" :pit (record))
(:sym "PresignError" :mod "asl-s3/sigv4" :kind type :sig "(schema PresignError (:f actual Int64))" :pit (record))
(:sym "uriEncode" :mod "asl-s3/sigv4" :sig "uriEncode value: String -> String")
(:sym "canonicalUri" :mod "asl-s3/sigv4" :sig "canonicalUri path: String -> String")
(:sym "canonicalQuery" :mod "asl-s3/sigv4" :sig "canonicalQuery query: (List QueryParam) -> String")
(:sym "canonicalHeaders" :mod "asl-s3/sigv4" :sig "canonicalHeaders headers: (List Header) -> String")
(:sym "signedHeaderNames" :mod "asl-s3/sigv4" :sig "signedHeaderNames headers: (List Header) -> String")
(:sym "canonicalRequest" :mod "asl-s3/sigv4" :sig "canonicalRequest method: String path: String query: (List QueryParam) headers: (List Header) bodyHash: String -> String")
(:sym "stringToSign" :mod "asl-s3/sigv4" :sig "stringToSign amzDate: String scope: String request: String -> String")
(:sym "deriveSigningKey" :mod "asl-s3/sigv4" :sig "deriveSigningKey secret: String date: String region: String service: String -> Bytes")
(:sym "signature" :mod "asl-s3/sigv4" :sig "signature secret: String date: String region: String service: String amzDate: String request: String -> String")
(:sym "authorization" :mod "asl-s3/sigv4" :sig "authorization accessKey: String secret: String date: String region: String service: String amzDate: String method: String path: String query: (List QueryParam) headers: (List Header) bodyHash: String -> String")
(:sym "presign" :mod "asl-s3/sigv4" :sig "presign accessKey: String secret: String date: String region: String service: String amzDate: String expiry: Int64 method: String path: String query: (List QueryParam) headers: (List Header) bodyHash: String -> (Result String PresignError)" :pit (result))
(:sym "payloadHash" :mod "asl-s3/sigv4" :sig "payloadHash body: Bytes -> String")
(:sym "Request" :mod "asl-s3/s3Request" :kind type :sig "(schema Request (:f method String) (:f host String) (:f path String) (:f query (List s/QueryParam)) (:f headers (List s/Header)) (:f body String))" :pit (record))
(:sym "request" :mod "asl-s3/s3Request" :sig "request method: String endpoint: String bucket: String key: String virtualHosted: Bool queryParams: (List s/QueryParam) headers: (List s/Header) body: String -> Request")
(:sym "putObject" :mod "asl-s3/s3Request" :sig "putObject endpoint: String bucket: String key: String virtualHosted: Bool contentType: String body: String -> Request")
(:sym "getObject" :mod "asl-s3/s3Request" :sig "getObject endpoint: String bucket: String key: String virtualHosted: Bool -> Request")
(:sym "listObjectsV2" :mod "asl-s3/s3Request" :sig "listObjectsV2 endpoint: String bucket: String virtualHosted: Bool prefix: String continuationToken: String maxKeys: Int64 -> Request")
(:sym "deleteObject" :mod "asl-s3/s3Request" :sig "deleteObject endpoint: String bucket: String key: String virtualHosted: Bool -> Request")
(:sym "createMultipartUpload" :mod "asl-s3/s3Request" :sig "createMultipartUpload endpoint: String bucket: String key: String virtualHosted: Bool contentType: String -> Request")
(:sym "uploadPart" :mod "asl-s3/s3Request" :sig "uploadPart endpoint: String bucket: String key: String virtualHosted: Bool uploadId: String partNumber: Int64 body: String -> Request")
(:sym "completeMultipartUpload" :mod "asl-s3/s3Request" :sig "completeMultipartUpload endpoint: String bucket: String key: String virtualHosted: Bool uploadId: String body: String -> Request")
(:sym "parseListResponse" :mod "asl-s3/s3Request" :sig "parseListResponse xmlText: String -> (Result (List XmlField) String)" :pit (result))
(:sym "parseMultipartResponse" :mod "asl-s3/s3Request" :sig "parseMultipartResponse xmlText: String -> (Result (List XmlField) String)" :pit (result))
(:sym "parseErrorDocument" :mod "asl-s3/s3Request" :sig "parseErrorDocument xmlText: String -> (Result S3Error S3Error)" :pit (result))
