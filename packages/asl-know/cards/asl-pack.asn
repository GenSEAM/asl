(:card "asl-pack" :purpose "Universal cross-platform packager and runtime runner for AgentSlang (the build-graph, package-manifest, OS-packaging and target-adapter modules this package once also held were deleted in DEAD-PACKAGES/ba298292c as dead;..." :import "(aslPack/pack :a x)" :deps (asl-transpile asl-proc) :modules ((:m "aslPack/pack" :doc "Universal cross-platform packaging orchestrator for stan...") (:m "aslPack/dist" :doc "Multi-channel distribution orchestrator: installers, bin...") (:m "aslPack/ffiLinker" :doc "Native foreign function interface (FFI) and platform lib...") (:m "aslPack/installer" :doc "Pure AgentSlang multi-agent skills installer, toolbelt d...") (:m "aslPack/intermediatePolicy" :doc "Intermediate artifact lifecycle management, ephemeral co...")) :moduleCount 13 :sigs ("(schema BuildSpec (:f appName Str) (:f version Str) (:f entryModule Str) (:f targetPlatform plat/PlatformDescriptor) (:f environment rt/Targ..." "(schema PackageArtifact (:f binaryName Str) (:f targetTriple Str) (:f runtimeName Str) (:f executionMode Str) (:f outputPath Str))" "(schema CapabilityReport (:f valid Bool) (:f unauthorized (List Str)) (:f allowed (List Str)))" "(schema DceResult (:f prunedCode Str) (:f eliminated (List Str)) (:f retained (List Str)))" "planPackage spec: BuildSpec -> PackageArtifact" "generatePackagingManifest artifact: PackageArtifact -> Str") :more (verifyPackageCapabilities eliminateDeadCapabilities validateManifestHash! DistConfig makeDistConfig emitInstallSh emitInstallPs1 emitBuildFromSourceSh) :moreCount 94 :effects (validateManifestHash! cleanIntermediateFile! executeReleaseStep! runVerificationGate! prepareDistDirectory! bundleTargetPlatform! generateChecksumManifest! preparePublishMetadata!) :fails (cleanIntermediateFile!) :example none)
