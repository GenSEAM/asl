(:card "asl-voice" :purpose "150ms pre-roll circular audio buffer with VAD-driven utterance chunking, and conversational turn history with barge-in tracking (the larger conceptual-schema voice package this once was got deleted in DEADPKG-LEFT/744ac0..." :import "(aslVoice/voiceBuffer :a x)" :modules ((:m "aslVoice/voiceBuffer" :doc "150ms circular audio frame pre-roll buffer, VAD hysteres...") (:m "aslVoice/conversationalContext" :doc "Conversational turn history, anaphora tracking, and inst...")) :sigs ("(schema VoiceBufferConfig (:f sampleRate I64) (:f preRollFrames I64) (:f speechActivationFrames I64) (:f silenceHangoverFrames I64))" "(schema VoiceBufferState (:f isUtteranceActive Bool) (:f preRollBuffer (List F64)) (:f accumulatedSamples (List F64)) (:f speechConsecutiveF..." "(schema VoiceBufferResult (:f isUtteranceActive Bool) (:f actionKind Str) (:f settledSamples (List F64)))" "voiceBufferCreate cfg: VoiceBufferConfig -> VoiceBufferState") :more (voiceBufferStepFrame isUtteranceSettled? SpeakerTurn ConversationalContext conversationalContextCreate recordTurn checkBargeInInterrupt) :example none)
(:sym "VoiceBufferConfig" :mod "aslVoice/voiceBuffer" :kind type :sig "(schema VoiceBufferConfig (:f sampleRate I64) (:f preRollFrames I64) (:f speechActivationFrames I64) (:f silenceHangoverFrames I64))" :pit (record))
(:sym "VoiceBufferState" :mod "aslVoice/voiceBuffer" :kind type :sig "(schema VoiceBufferState (:f isUtteranceActive Bool) (:f preRollBuffer (List F64)) (:f accumulatedSamples (List F64)) (:f speechConsecutiveFrames I64) (:f silenceConsecutiveFrames I64) (:f totalFramesStreamed I64))" :pit (record))
(:sym "VoiceBufferResult" :mod "aslVoice/voiceBuffer" :kind type :sig "(schema VoiceBufferResult (:f isUtteranceActive Bool) (:f actionKind Str) (:f settledSamples (List F64)))" :pit (record))
(:sym "voiceBufferCreate" :mod "aslVoice/voiceBuffer" :sig "voiceBufferCreate cfg: VoiceBufferConfig -> VoiceBufferState")
(:sym "voiceBufferStepFrame" :mod "aslVoice/voiceBuffer" :sig "voiceBufferStepFrame cfg: VoiceBufferConfig st: VoiceBufferState frameSamples: (List F64) isSpeech: Bool -> (Pair VoiceBufferState VoiceBufferResult)")
(:sym "isUtteranceSettled?" :mod "aslVoice/voiceBuffer" :sig "isUtteranceSettled? res: VoiceBufferResult -> Bool")
(:sym "SpeakerTurn" :mod "aslVoice/conversationalContext" :kind type :sig "(schema SpeakerTurn (:f turnId Str) (:f speakerId Str) (:f transcript Str) (:f resolvedDomain Str) (:f executedReceipt Str) (:f timestamp I64))" :pit (record))
(:sym "ConversationalContext" :mod "aslVoice/conversationalContext" :kind type :sig "(schema ConversationalContext (:f turns (List SpeakerTurn)) (:f activeSpeaker Str) (:f isSpeaking Bool) (:f bargeInDetected Bool))" :pit (record))
(:sym "conversationalContextCreate" :mod "aslVoice/conversationalContext" :sig "conversationalContextCreate activeSpeaker: Str -> ConversationalContext")
(:sym "recordTurn" :mod "aslVoice/conversationalContext" :sig "recordTurn ctx: ConversationalContext turn: SpeakerTurn -> ConversationalContext")
(:sym "checkBargeInInterrupt" :mod "aslVoice/conversationalContext" :sig "checkBargeInInterrupt ctx: ConversationalContext isSystemAudioPlaying: Bool isUserVoicing: Bool -> (Pair ConversationalContext Bool)")
