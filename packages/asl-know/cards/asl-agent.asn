(:sym "asnForm?" :mod "aslAgent/poolChannel" :sig "asnForm? s: String -> Bool" :doc "true when s is exactly one single-line parenthesised form, parentheses inside strings ignored")
(:sym "inboxDir" :mod "aslAgent/poolChannel" :sig "inboxDir dir: String idx: Int64 -> String" :doc "the inbox of task idx under the pool dir")
(:sym "outboxDir" :mod "aslAgent/poolChannel" :sig "outboxDir dir: String -> String" :doc "the outbox all tasks write to")
(:sym "openChannel!" :mod "aslAgent/poolChannel" :kind fn! :sig "openChannel! dir: String idxs: (List Int64) -> Bool" :doc "create the outbox and one inbox per task index" :pit (effect))
(:sym "msgLine" :mod "aslAgent/poolChannel" :sig "msgLine m: PoolMsg -> String" :doc "a PoolMsg as its one wire line (:ask|:answer :id :from :to [:error] :body)")
(:sym "parseMsg" :mod "aslAgent/poolChannel" :sig "parseMsg line: String -> (Option PoolMsg)" :doc "a wire line back into a PoolMsg; the header ends at the first :body, so a body may hold any text" :pit (option))
(:sym "ask!" :mod "aslAgent/poolChannel" :kind fn! :sig "ask! dir: String from: Int64 to: Int64 body: String waitMs: Int64 -> (Result String String)" :doc "send body to task to and block this task until the answer body comes back, or an ERR_ code" :pit (result effect))
(:sym "asks!" :mod "aslAgent/poolChannel" :kind fn! :sig "asks! dir: String idx: Int64 -> (List PoolMsg)" :doc "take the asks waiting in task idx's inbox, oldest first" :pit (effect))
(:sym "answer!" :mod "aslAgent/poolChannel" :kind fn! :sig "answer! dir: String idx: Int64 q: PoolMsg body: String -> (Result Bool String)" :doc "send body as the answer to ask q" :pit (result effect))
