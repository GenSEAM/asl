(:sym "liveProviderWait!" :mod "aslAgent/main" :kind fn! :sig "liveProviderWait! provider: pv/Provider call: (fn [pv/Provider Int64] -> pv/Turn) wallBudget: (Option Int64) sleep: (fn [Int64] -> Bool) now: (fn [] -> Float64) rootDir: String -> (Pair pv/Turn Int64)" :doc "the live turn retry with all-down waits configured by the run root" :pit (effect))
(:sym "liveBody!" :mod "aslAgent/main" :kind fn! :sig "liveBody! ra: RunArgs repoRoot: String rootDir: String path: String system: String env: ls/LoopEnv" :pit (effect))
(:sym "attractorProvider" :mod "aslAgent/main" :sig "attractorProvider p: pv/Provider prefill: String left: (Option Int64) -> pv/Provider" :doc "the provider with the wall cap applied and, when the prefill is not empty, the prefill set")
(:sym "validPrefix?" :mod "aslAgent/main" :sig "validPrefix? v: String -> Bool" :doc "true when every token of a :prefix list is a known prefix token")
(:sym "prefixDrop" :mod "aslAgent/main" :sig "prefixDrop v: String -> (List String)" :doc "the prefix tokens to drop from the system prompt, the list without focus")
(:sym "focusTail" :mod "aslAgent/main" :sig "focusTail v: String task: String gates: (List String) wroteSinceGate: Bool -> String" :doc "the per-turn (:focus :goal :gate :next) tail when the prefix list includes focus: the goal cut to 400 characters, the first gate and the suggested next step; empty otherwise")
(:sym "parentWatch!" :mod "aslAgent/main" :kind fn! :sig "parentWatch! parent: (Option Int64) path: String turn: Int64 spanS: Int64 -> (Option fr/Forked)" :doc "starts a forked watcher that ends the run when the parent pid is gone, or none when no parent is set" :pit (option effect))
(:sym "parentUnwatch!" :mod "aslAgent/main" :kind fn! :sig "parentUnwatch! watcher: (Option fr/Forked) -> Bool" :doc "stops a watcher started by parentWatch!, true when none was running" :pit (effect))
(:sym "loopResultOf" :mod "aslAgent/main" :sig "loopResultOf ra: RunArgs rootDir: String result: ls/RunResult usage: (Option Usage) lastStep: (Option String) -> LoopResult")
(:sym "toolRootOr" :mod "aslAgent/main" :sig "toolRootOr ra: RunArgs repoRoot: String -> String" :doc "the repo root a run's tool ops use: its :toolRoot (a built tree, the base build) when given, else the checkout it runs in; check, test and forms then run <toolRoot>/bin/asl with the run root as cwd, so a unit that edits CLI sources is not r...")
(:sym "resumed" :mod "aslAgent/main" :sig "resumed ra: RunArgs st: ResumeState -> RunArgs" :doc "ra st: the RunArgs of ra with task, mode hint, owns, gates, base and, when ra has none, the intent taken from the resume state")
(:sym "runArgsOf" :mod "aslAgent/main" :kind fn! :sig "runArgsOf ps: (List (Pair String j/Json)) timeout: Int64 queueTimeout: Int64 plan: Bool -> RunArgs" :doc "the RunArgs of an invocation's parameters, as dispatch builds them, so a pool driver starts a run from the same parameters" :pit (effect))
(:sym "toolRootUsable?" :mod "aslAgent/main" :kind fn! :sig "toolRootUsable? ra: RunArgs -> Bool" :doc "true when the run has no :toolRoot or its <toolRoot>/bin/asl is a file with the owner execute bit; execute refuses a run otherwise with ERR_TOOLROOT before any step" :pit (effect))
(:sym "nextReadStreakOf" :mod "aslAgent/main" :sig "nextReadStreakOf wrote: Bool stalledTurn: Bool stalledStreak: Int64 readStreak: Int64 -> Int64" :doc "the next readStreak: a persisted write resets it, a turn that persisted nothing but attempted a write or edit (refused) or read a missing file extends it at most notFoundStreakCap turns in a row, any other turn extends it (LEON-YIELD-F2)")
(:sym "opKey" :mod "aslAgent/main" :sig "opKey op: (List (Pair String c/KvVal)) -> String" :doc "op: a key string of an op's fields other than form and id, each name and value prefixed by its length and a colon")
(:sym "stalledTurnCapIn" :mod "aslAgent/main" :sig "stalledTurnCapIn cfgText: String -> Int64" :doc "consecutive stalled turns (nothing persisted; a missing-file read or an attempted write or edit) after which the run stops as readStreak with cause refusedWrites or notFound; :agentLoop :stalledTurnCap, default 12 adopted (LEON-YIELD-F2B)")
(:sym "readOnlyTurnCapIn" :mod "aslAgent/main" :sig "readOnlyTurnCapIn cfgText: String -> Int64" :doc "cfgText: the readOnlyTurnCap of the agentLoop block in cfgText when it is a positive integer, else the default of 16")
(:sym "readOnlyOps" :mod "aslAgent/main" :sig "readOnlyOps -> (List String)" :doc "no args: the op names that count as read-only: read query q check outline tree diff tools help gitDiff gitLog gitShow note observe search research crawl intent intel")
(:sym "worktreeDigest!" :mod "aslAgent/main" :kind fn! :sig "worktreeDigest! owns: (List String) root: String -> String" :doc "owns root: the sha256 of the git diff against HEAD plus the paths and contents of untracked files under owns" :pit (effect))
(:sym "reuseGateDigest?" :mod "aslAgent/main" :sig "reuseGateDigest? previous: (Option String) current: String -> Bool" :doc "previous current: true when a previous digest exists and equals current")
(:sym "readOnlyEntry?" :mod "aslAgent/main" :sig "readOnlyEntry? entry: j/Json -> Bool" :doc "a history turn is non-progress for the readOnly cap when it persisted no write (history :wrote 0) and every step is a read-only op or a write, edit or delete; refused writes count, a persisted write or any other step resets the run (LEON-OP...")
(:sym "readOnlyTail" :mod "aslAgent/main" :sig "readOnlyTail history: (List j/Json) -> Int64" :doc "how many turns at the end of the history sent only read-only steps; at readOnlyTurnCapIn (adopted 16, :agentLoop :readOnlyTurnCap) the run stops as readStreak with cause readOnly, with no exemption before the first write (LEON-READLOOP)")
(:sym "opRowText" :mod "aslAgent/main" :sig "opRowText turn: Int64 name: String file: String status: String error: String -> String" :doc "the (:op :turn N :name OP :file F :status ok|err [:error CODE]) journal row of one applied step, written by liveOpRow! in liveExecOps!; steps without a name (done, escalate) and pool ops write none (TRIAL-LEON-OPROWS)")
(:sym "dedupeReadOps" :mod "aslAgent/main" :sig "dedupeReadOps ops: (List (List (Pair String c/KvVal))) seen: (List String) kept: (List (List (Pair String c/KvVal))) dropped: Int64 -> (Pair (List (List (Pair String c/KvVal))) Int64)" :doc "drops a read-only step that repeats an earlier one of the same reply ignoring :id, when no mutating step lies between them; returns the kept steps and how many were dropped, which the reply reports as (:duplicateOps :dropped n) together wit...")
(:sym "modelEscalationReason" :mod "aslAgent/main" :sig "modelEscalationReason ops: (List (List (Pair String c/KvVal))) -> (Option String)" :doc "the reason text of a model's own escalate op, from either the (:escalate ...) form or a (:step :op escalate) step" :pit (option))
(:sym "modelEscalationReceipt" :mod "aslAgent/main" :sig "modelEscalationReceipt ops: (List (List (Pair String c/KvVal))) -> (Option String)" :doc "the (:escalate :reason :seen :tried) receipt of a model's own escalate op, none when the reply held none; the run stops at once with signal modelEscalated instead of running on to a readStreak stop (LEON-YIELD-F3)" :pit (option))
(:sym "writeAttempt?" :mod "aslAgent/main" :sig "writeAttempt? ops: (List (List (Pair String c/KvVal))) -> Bool" :doc "true when a reply held a write or edit step, whatever became of it")
(:sym "servedAlias" :mod "aslAgent/main" :sig "servedAlias meta: pv/TurnMeta -> (Option String)" :doc "the gateway alias that answered a turn, from the alias of its served fields" :pit (option))
(:sym "servedLine" :mod "aslAgent/main" :sig "servedLine turn: Int64 meta: pv/TurnMeta -> (Option String)" :doc "the journal row (:served :turn N :model M :alias A) of a turn, none when the reply names neither" :pit (option))
(:sym "servedIn" :mod "aslAgent/main" :sig "servedIn text: String -> (Pair (Option String) (Option String))" :doc "the alias and model of the last served row of a journal text")
(:sym "Checked" :mod "aslAgent/main" :kind type :sig "schema Checked (:f ps (List (Pair String j/Json))) (:f repoRoot String) (:f rootDir String) (:f timeout Int64) (:f queueTimeout Int64) (:f plan Bool)" :doc "what the CLI check chain accepted: parameters, repo root, root dir, timeout, queue timeout and the plan flag" :pit (record))
(:sym "Valid" :mod "aslAgent/main" :kind type :sig "enum Valid (valid Checked) (invalid MainResult)" :doc "the check chain's decision: valid with the Checked values, or invalid with the rejection MainResult")
(:sym "valid" :mod "aslAgent/main" :kind ctor :sig "(valid Checked) of Valid" :doc "a Valid carrying the checked parameters, roots and wall" :pit (ctor))
(:sym "invalid" :mod "aslAgent/main" :kind ctor :sig "(invalid MainResult) of Valid" :doc "a Valid carrying the rejection receipt" :pit (ctor))
(:sym "checkInvocation" :mod "aslAgent/main" :kind fn! :sig "checkInvocation inv: Invocation repoRoot: String rootDir: String -> Valid" :doc "runs the check chain on an invocation, in order: syntax error, deprecated role, unknown op, context file error, missing task or resume, then the root and wall checks; returns the first rejection or the Checked values" :pit (effect))
(:sym "liveTurn!" :mod "aslAgent/main" :kind fn! :sig "liveTurn! ra: RunArgs repoRoot: String rootDir: String path: String system: String env: ls/LoopEnv" :doc "one live turn: liveAsk!, the blocking provider call, then liveApply!, with a parent watcher and the wall left passed to the call" :pit (effect))
(:sym "appendRetryLines!" :mod "aslAgent/main" :kind fn! :sig "appendRetryLines! path: String turn: Int64 retries: Int64 -> Bool" :doc "appends one (:retry :turn :attempt) journal row per retry, from the retry count down to 1" :pit (effect))
(:sym "paramHas" :mod "aslAgent/main" :sig "paramHas ps: (List (Pair String j/Json)) key: String -> Bool" :doc "true when an invocation's parameters hold the key")
(:sym "LiveAsk" :mod "aslAgent/main" :kind type :sig "(schema LiveAsk (:f sysA String) (:f user String) (:f prefill String) (:f turnOwnSent String) (:f cardNames (List String)) (:f advisorOk Bool))" :doc "what the first half of a turn hands the second: the system and user text and prefill for the model call, the sent text for history, the attractor card names for the journal and whether the advisor hook was acceptable" :pit (record))
(:sym "LiveSession" :mod "aslAgent/main" :kind type :sig "schema LiveSession (:f ra RunArgs) (:f repoRoot String) (:f rootDir String) (:f path String) (:f system String) (:f env ls/LoopEnv) (:f turnProvider pv/Provider) (:f providerCall (fn [pv/Provider String String] -> pv/Turn))" :doc "everything a live run needs once set up: run args, roots, journal path, system prompt, loop env, turn provider and provider call" :pit (record))
(:sym "LivePrep" :mod "aslAgent/main" :kind type :sig "enum LivePrep (prepared LiveSession) (prepRejected MainResult)" :doc "the result of liveSetup!: prepared with a LiveSession, or prepRejected with a MainResult")
(:sym "prepared" :mod "aslAgent/main" :kind ctor :sig "(prepared LiveSession) of LivePrep" :doc "a LivePrep carrying a ready LiveSession" :pit (ctor))
(:sym "prepRejected" :mod "aslAgent/main" :kind ctor :sig "(prepRejected MainResult) of LivePrep" :doc "a LivePrep carrying the rejection receipt" :pit (ctor))
(:sym "liveSetup!" :mod "aslAgent/main" :kind fn! :sig "liveSetup! ra0: RunArgs repoRoot0: String rootDir: String env: pv/ProviderEnv -> LivePrep" :doc "builds a live run: code routing, journal, provider (made with the journal's session id so gateway calls carry it), system prompt and loop env; a journal, backend or harness error is returned as a rejection" :pit (effect))
(:sym "liveResult" :mod "aslAgent/main" :kind fn! :sig "liveResult ls: LiveSession result: ls/RunResult -> MainResult" :doc "the MainResult of a finished live run: the formatted receipt with the journal usage and last step, and its exit code" :pit (effect))
(:sym "liveAsk!" :mod "aslAgent/main" :kind fn! :sig "liveAsk! ra: RunArgs repoRoot: String rootDir: String path: String system: String env: ls/LoopEnv wrapped: rl/ProviderRun -> LiveAsk" :doc "the first half of a live turn: renders the bounded transcript and builds the LiveAsk" :pit (effect))
(:sym "liveApply!" :mod "aslAgent/main" :kind fn! :sig "liveApply! ra: RunArgs repoRoot: String rootDir: String path: String env: ls/LoopEnv wrapped: rl/ProviderRun ask: LiveAsk response: pv/Turn retries: Int64 turnStartNs: Int64 modelMs: Int64 poolRow: Bool -> (Pair rl/ProviderRun ls/Step)" :doc "the second half of a live turn: applies the model's response and retries to the run and returns the next provider run and step" :pit (effect))
(:sym "liveGone!" :mod "aslAgent/main" :kind fn! :sig "liveGone! ra: RunArgs path: String wrapped: rl/ProviderRun -> (Pair rl/ProviderRun ls/Step)" :doc "the orphan stop of one turn: journals the signal and escalates with reason parentGone, apart from the turn body so a pool driver stops its sessions the same way" :pit (effect))
(:sym "parentGone?" :mod "aslAgent/main" :kind fn! :sig "parentGone? parent: (Option Int64) -> Bool" :doc "true when the parent pid the CLI passed is no longer alive; none means no parent to watch" :pit (effect))
(:sym "wallLeft" :mod "aslAgent/main" :sig "wallLeft wallBudget: (Option Int64) elapsed: Float64 -> (Option Int64)" :doc "the seconds left of the wall budget, at least 1, none when no positive budget is set, so a model call or gate never outlasts the run" :pit (option))
(:sym "runArgsOf" :mod "aslAgent/main" :kind fn! :sig "runArgsOf ps: (List (Pair String j/Json)) timeout: Int64 queueTimeout: Int64 plan: Bool -> RunArgs" :doc "the RunArgs of an invocation's parameters, as dispatch builds them, so a pool driver starts a run from the same parameters" :pit (effect))
(:sym "mainCli" :mod "aslAgent/main" :kind fn! :sig "mainCli argv: (List String) -> Int64" :doc "the checkout the host runs in is the repo; ASL_ROOT_DIR, when set, is the workspace" :pit (effect))
(:sym "mainWithRoots" :mod "aslAgent/main" :kind fn! :sig "mainWithRoots argv: (List String) repoRoot: String rootDir: String -> MainResult" :pit (effect))
(:sym "agentLoopBlock" :mod "aslAgent/agentConfig" :sig "agentLoopBlock text: String -> (Option String)" :doc "args: the text of a .asl.config.asn; returns (some block) with the text of the first top-level :agentLoop group, delimiters included, or none when the group is absent; pure, reads no file" :pit (option))
(:sym "agentLoopValue" :mod "aslAgent/agentConfig" :sig "agentLoopValue text: String key: String -> (Option String)" :doc "args: config text and a key such as :baseline; returns (some value) with the value token of that top-level key of the :agentLoop group, quotes removed, or none when the group or the key is absent; a key in a doc string, a nested group or an..." :pit (option))
(:sym "positiveInt" :mod "aslAgent/agentConfig" :sig "positiveInt v: String -> (Option Int64)" :doc "args: a string; returns (some n) when it is non-empty, all ASCII digits and n is greater than zero, else none (empty, signed, decimal, zero or not an Int64); pure" :pit (option))
(:sym "configProblems" :mod "aslAgent/agentConfig" :sig "configProblems text: String -> (List String)" :doc "args: config text; returns one message per invalid :agentLoop value: a trailing key with no value, a non-positive-integer :readOutlineBytes :wallReserveSec :wallGateMinSec :gateVacuousRounds or :gateMaxDescendants, a :baseline or :specCheck...")
(:sym "configText!" :mod "aslAgent/agentConfig" :kind fn! :sig "configText! root: String -> String" :doc "args: a root directory; returns the content of <root>/.asl.config.asn, or the empty string when it cannot be read; effect: one file read, never an error" :pit (effect))
(:sym "RVal" :mod "aslAgent/aslOps" :kind type :sig "enum RVal (rStr text: String) (rInt n: Int64) (rBool b: Bool) (rList xs: (List String)) (rPair first: Int64 second: Int64) (rNone)")
(:sym "Bounded" :mod "aslAgent/aslOps" :kind type :sig "(schema Bounded (:f code (Option Int64)) (:f out String) (:f errText String) (:f timedOut Bool))" :pit (record))
(:sym "PumpEnd" :mod "aslAgent/aslOps" :kind type :sig "enum PumpEnd (pumpDone out: String errText: String) (pumpLate outOpen: Bool errOpen: Bool out: String errText: String) (pumpFailed msg: String)")
(:sym "RunAslResult" :mod "aslAgent/aslOps" :kind type :sig "(schema RunAslResult (:f exit Int64) (:f stdout String) (:f stderr String) (:f timedOut Bool) (:f seconds Int64) (:f fellBack String))" :pit (record))
(:sym "MemoEntry" :mod "aslAgent/aslOps" :kind type :sig "(schema MemoEntry (:f run t/AslRun) (:f rid String) (:f age Int64))" :doc "schema of a memoized asl run: the run, its run id rid and its age" :pit (record))
(:sym "budgetLeft" :mod "aslAgent/aslOps" :sig "budgetLeft deadlineAt: (Option Float64) nowMono: Float64 -> (Option Float64)" :doc "wall budget left from monotonic deadline" :pit (option))
(:sym "stepTimeout" :mod "aslAgent/aslOps" :sig "stepTimeout runTimeout: Int64 deadlineAt: (Option Float64) nowMono: Float64 -> Int64" :doc "step timeout bounded by wall budget; a left outside Int64 saturates, where Python int() raises only on inf and nan")
