(:sym "Sess" :mod "aslAgent/sessionPool" :kind type :sig "(schema Sess (:f id String) (:f state String) (:f request String) (:f fd Int64) (:f buf String) (:f lastMs Int64) (:f tries Int64) (:f holdMs Int64) (:f busyN Int64 :default 0) (:f out String :default \"\") (:f guard (Option fr/Guarded)) (:f spill String))" :doc "one session: id, state string, the request its next turn sends, hub fd and read buffer, last activity, tries, hold-until time, busy count, an optional guarded local process and the spill file when parked on disk" :pit (record))
(:sym "Pool" :mod "aslAgent/sessionPool" :kind type :sig "(schema Pool (:f sock String) (:f slots Int64) (:f memCap Int64) (:f ttlMs Int64) (:f spillDir String) (:f active (List Sess)) (:f execs (List Sess)) (:f waiting (List Sess)) (:f done (List (Pair String String))) (:f peakMem Int64) (:f peakSpilled Int64))" :doc "the session pool: hub socket, slots in flight, memory cap, idle ttl, spill directory, the active, exec and waiting sessions, finished results and the peak counts of in-memory and spilled sessions" :pit (record))
(:sym "Turn" :mod "aslAgent/sessionPool" :kind type :sig "(schema Turn (:f state String) (:f request (Option String)) (:f exec (Option Exec)) (:f result (Option String)) (:f headers (List (Pair String String)) :default (list)) (:f busy Bool :default false) (:f holdMs Int64 :default 0))" :doc "what a turn function returns for a (state, reply): the next state and either the next request body, a local exec, or the final result, plus headers, a busy flag and a hold time" :pit (record))
(:sym "Exec" :mod "aslAgent/sessionPool" :kind type :sig "(schema Exec (:f argv (List String)) (:f cwd String) (:f env (List String)) (:f timeoutS Int64) (:f maxDesc Int64))" :doc "a local process a turn asks for in place of a hub request: argv, working directory, env, timeout in seconds and descendant limit" :pit (record))
(:sym "asnQuote" :mod "aslAgent/sessionPool" :sig "asnQuote text: String -> String" :doc "text as a quoted ASN string with backslash, quote and newline escaped")
(:sym "newPool" :mod "aslAgent/sessionPool" :sig "newPool sock: String slots: Int64 memCap: Int64 ttlMs: Int64 spillDir: String -> Pool" :doc "an empty pool for a hub socket with at least one slot and non-negative memory cap and ttl")
(:sym "poolSubmit!" :mod "aslAgent/sessionPool" :kind fn! :sig "poolSubmit! p: Pool id: String state: String now: Int64 -> Pool" :doc "adds a session in the waiting list with an empty request; its first turn call with an empty reply makes its first request when it is admitted" :pit (effect))
(:sym "poolStep!" :mod "aslAgent/sessionPool" :kind fn! :sig "poolStep! p: Pool ready: (List (Pair Int64 Int64)) turn: (fn [String String] -> Turn) now: Int64 -> Pool" :doc "one non-blocking step of the pool: reads ready replies, advances local execs and admits waiting sessions up to the slots; the turn function maps (state, reply) to a Turn" :pit (effect))
(:sym "poolStepG!" :mod "aslAgent/sessionPool" :kind fn! :sig "poolStepG! p: Pool ready: (List (Pair Int64 Int64)) turn: (fn [T String String] -> (Pair T Turn)) d: T now: Int64 -> (Pair Pool T)" :doc "poolStep! with a threaded value: the turn function also takes and returns a value d, so the caller can accumulate results; returns the pool and the final value" :pit (effect))
(:sym "poolWatch" :mod "aslAgent/sessionPool" :sig "poolWatch p: Pool -> (List (Pair Int64 Int64))" :doc "the (fd, 1) pairs to poll: each active session's hub fd and the fds of guarded local processes")
(:sym "poolIdle?" :mod "aslAgent/sessionPool" :sig "poolIdle? p: Pool -> Bool" :doc "true when no session is active, executing or waiting")
(:sym "poolDone" :mod "aslAgent/sessionPool" :sig "poolDone p: Pool -> (List (Pair String String))" :doc "the finished (id, result) pairs held in the pool")
(:sym "poolTakeDone" :mod "aslAgent/sessionPool" :sig "poolTakeDone p: Pool -> (Pair Pool (List (Pair String String)))" :doc "returns the finished results and a pool with them cleared")
(:sym "poolKnown?" :mod "aslAgent/sessionPool" :sig "poolKnown? p: Pool id: String -> Bool" :doc "true when a session id is active, executing or waiting in the pool")
(:sym "pickNext" :mod "aslAgent/sessionPool" :sig "pickNext all: (List Sess) now: Int64 ttlMs: Int64 -> (Option Sess)" :doc "the next waiting session to start: among those whose hold time has passed, a warm one if any, and the oldest of them" :pit (option))
(:sym "poolMemCount" :mod "aslAgent/sessionPool" :sig "poolMemCount p: Pool -> Int64" :doc "how many waiting sessions are held in memory rather than spilled")
(:sym "spilledCount" :mod "aslAgent/sessionPool" :sig "spilledCount p: Pool -> Int64" :doc "how many waiting sessions are spilled to a file")
