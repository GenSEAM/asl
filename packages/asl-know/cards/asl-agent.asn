(:sym "serveStepG!" :mod "aslAgent/poolServe" :kind fn! :sig "serveStepG! s: Serve ready: (List (Pair Int64 Int64)) turn: (fn [T String String] -> (Pair T sp/Turn)) d: T open: (fn [T String String String String] -> (Pair T (Option (Pair Int64 String)))) exitOf: (fn [T String] -> Int64) now: Int64 -> ( ..." :doc "serveStep! with a driver value: the turn function, the open hook for (:run ...) and the exit lookup for receipts take and return it; one step accepts, reads, steps the pool and writes receipts" :pit (effect))
(:sym "receiptRow" :mod "aslAgent/poolServe" :sig "receiptRow id: String exit: Int64 text: String -> String" :doc "the (:receipt :unit :state done :exit :result) row for a finished unit, newline-terminated")
(:sym "serveWatch" :mod "aslAgent/poolServe" :sig "serveWatch s: Serve -> (List (Pair Int64 Int64))" :doc "the (fd, 1) pairs to poll: the listener, each connection and the pool's fds")
(:sym "handleLine!" :mod "aslAgent/poolServe" :kind fn! :sig "handleLine! s: Serve line: String d: T open: (fn [T String String String String] -> (Pair T (Option (Pair Int64 String)))) -> (Pair (Pair Serve T) String)" :doc "answers one control line: submit queues a session (queued, or refused for no unit, bad id or duplicate), receipt answers running, done with the file, or unknown, status gives the counters, stop ends the serve" :pit (effect))
(:sym "validId?" :mod "aslAgent/poolServe" :sig "validId? id: String -> Bool" :doc "true when a unit id is 1 to 96 bytes of letters, digits, dot, dash and underscore with no leading dot, since it becomes a file name")
(:sym "quotedAfter" :mod "aslAgent/poolServe" :sig "quotedAfter line: String key: String -> (Option String)" :doc "the quoted string after a key in a line, none when the key is absent" :pit (option))
(:sym "asnQuote" :mod "aslAgent/poolServe" :sig "asnQuote text: String -> String" :doc "asnQuote of the session pool, re-exported for control replies")
(:sym "receiptPath" :mod "aslAgent/poolServe" :sig "receiptPath dir: String id: String -> String" :doc "path of a unit's receipt file, its id under the receipt directory")
