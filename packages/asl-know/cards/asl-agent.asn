(:sym "poolExit" :mod "aslAgent/pool" :sig "poolExit slots: (List PoolSlot) refused: (List Refusal) -> Int64" :doc "2 when any task was refused, 1 when any task did not end ok (failed, trapped or timed out), else 0")
