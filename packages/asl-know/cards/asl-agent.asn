(:card "asl-agent" :purpose "Leon, the agent loop (core, loop, turn, txn, gates, journal, providers, pool, main CLI and the rest of the loop modules), plus omni-channel intent classification, front-agent directive dispatch, unbiased-context sanitati..." :import "(aslAgent/main :a x)" :deps (asl-text asl-json asl-proc asl-forms asl-gateway asl-harness asl-engine asl-checker asl-gates) :modules ((:m "aslAgent/main") (:m "aslAgent/agentConfig") (:m "aslAgent/aslOps") (:m "aslAgent/attractor") (:m "aslAgent/card")) :moduleCount 47 :sigs ("withRemote op: (List (Pair String c/KvVal)) unit: String -> (List (Pair String c/KvVal))" "knownParams -> (List String)" "acceptedKeys -> (List String)" "nearestKey! unknown: String -> String" "liveTxnTargets op: (List (Pair String c/KvVal)) -> (List String)" "tokenizeAsn text: String -> (Result (List String) String)" "(schema Invocation (:f params (List (Pair String j/Json))) (:f unknownOps (List String)) (:f syntaxError (Option String)) (:f contextFileErr..." "paramGet ps: (List (Pair String j/Json)) key: String -> (Option j/Json)") :more (parseInvocation ResumeTurn ResumeState RunArgs resumeReport journalResume journalModeHint NeedsConfirm OwnsRejection Usage Batching LoopResult formatReceipt) :moreCount 1197 :effects (nearestKey! parseInvocation resumeReport journalResume receiptFieldNames liveAdvisor liveReviewer liveHooks!) :fails (tokenizeAsn journalResume receiptFieldsIn receiptFieldNames liveAdvisor liveReviewer engineRequest runAslSocket) :example none)
