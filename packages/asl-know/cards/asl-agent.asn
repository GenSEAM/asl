(:sym "formatReceipt" :mod "aslAgent/main" :sig "formatReceipt r: LoopResult -> String" :doc "format_receipt; receiptFieldsIn reads its keys from the string literals below, in order, as card.py reads main.format_receipt")
(:sym "stopCause" :mod "aslAgent/main" :sig "stopCause status: String signal: (Option String) error: (Option String) vacuous: (List String) -> String" :doc "why the run stopped, for a receipt: the loop signal that ended it, else error for a failed run, gateVacuous for a failed run whose declared gates were green before any write, done for ok, otherwise the status")
