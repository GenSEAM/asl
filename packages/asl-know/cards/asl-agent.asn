(:sym "runGatesIn!" :mod "aslAgent/gitOps" :sig "runGatesIn! gates: (List (Pair String String)) root: String timeoutSec: Int64 env: (Option (List String)) watch: (Option Int64) timesPath: String -> (List (List (Pair String RVal)))" :doc "gates root timeoutSec env watch timesPath: runs the id and command gates in order under root and returns one record each; after a failed build.sh gate the rest are skipped afterBuildFail, and a gate whose recorded time times 1.5 would not f..." :pit (effect))
(:sym "runGatesPar!" :mod "aslAgent/gitOps" :sig "runGatesPar! gates: (List (Pair String String)) root: String timeoutSec: Int64 env: (Option (List String)) watch: (Option Int64) limit: Int64 -> (List (List (Pair String RVal)))" :doc "gates root timeoutSec env watch limit: runs the gates with at most limit at once, using the recorded gate times, and returns one record list per gate in gate order" :pit (effect))
