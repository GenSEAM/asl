(:sym "cardSigNames" :mod "aslAgent/grounding" :sig "cardSigNames -> (List String)" :doc "builtins whose checker signatures the card lists (card R3): the string builtins stringSplit, stringSlice, stringUpper, then the Option-returning ones and fold, chosen for their Option and Result returns and fold's argument order")
(:sym "cardExamples" :mod "aslAgent/grounding" :sig "cardExamples -> (List (Pair String String))" :doc "one expression per type rule with the type it checks at, now led by the Option and Result match pair (card R3); groundingTest type-checks each one")
