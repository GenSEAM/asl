(:sym "Book" :mod "aslAgent/leonPool" :sig none :doc "the book of live runs: a list of (session id, Live) pairs")
(:sym "leonOpen!" :mod "aslAgent/leonPool" :kind fn! :sig "leonOpen! book: (List (Pair String Live)) id: String form: String repoRoot: String rootDir: String env: pv/ProviderEnv -> (Pair (List (Pair String Live)) (Option m/MainResult))" :doc "starts a run: the invocation form goes through the CLI check chain, then journal, provider, system prompt, loop env and baseline are set up as the blocking path does; a rejected or early-finished run comes back as its result, a ready one is..." :pit (effect))
(:sym "leonTurn!" :mod "aslAgent/leonPool" :kind fn! :sig "leonTurn! book: (List (Pair String Live)) id: String raw: String -> (Pair (List (Pair String Live)) sp/Turn)" :doc "the pool's turn function: the state is the session id; an empty reply starts or continues the run, any other text is the raw hub answer to the ask the run left outstanding, and a 503 keeps the ask and waits" :pit (effect))
(:sym "leonExit" :mod "aslAgent/leonPool" :sig "leonExit book: (List (Pair String Live)) id: String -> Int64" :doc "the exit code recorded for a session id in the book, -1 when it is not there")
(:sym "leonRouted?" :mod "aslAgent/leonPool" :sig "leonRouted? book: (List (Pair String Live)) id: String -> Bool" :doc "true when the unit's session has a code route declared for its intent; false for an unknown unit")
(:sym "leonViaHub?" :mod "aslAgent/leonPool" :kind fn! :sig "leonViaHub? book: (List (Pair String Live)) id: String -> Bool" :doc "true when the unit's provider sends its model calls to the hub socket (providers hubAsk?); false for an unknown unit" :pit (effect))
(:sym "leonDrop" :mod "aslAgent/leonPool" :sig "leonDrop book: (List (Pair String Live)) id: String -> (List (Pair String Live))" :doc "the book without the entry for a unit id")
(:sym "openRun!" :mod "aslAgent/leonServe" :kind fn! :sig "openRun! book: (List (Pair String lp/Live)) id: String form: String repo: String root: String -> (Pair (List (Pair String lp/Live)) (Option (Pair Int64 String)))" :doc "the pool's open hook for a (:run ...): opens the Leon run; a routed run or one whose provider is not the hub ask path is dropped and answered exit 125 with a declined row so the conductor spawns it, otherwise the run joins the pool or its e..." :pit (effect))
(:sym "serveLoop!" :mod "aslAgent/leonServe" :kind fn! :sig "serveLoop! s: ps/Serve book: (List (Pair String lp/Live)) deadlineMs: Int64 -> (Pair ps/Serve (List (Pair String lp/Live)))" :doc "the serve loop: poll the control socket, the pool's hub sockets and exec children, step the server with the Leon driver, until :stop or the deadline; returns the final server and book" :pit (effect))
(:sym "hubSockOf" :mod "aslAgent/leonServe" :sig "hubSockOf text: String -> String" :doc "the :sock value quoted in a hub.asn text, empty when there is none")
(:sym "freeCtl!" :mod "aslAgent/leonServe" :kind fn! :sig "freeCtl! ctl: String tries: Int64 delayMs: Int64 -> (Result Unit String)" :doc "makes the control socket path free for a new listener: absent is fine; anything but a socket is refused as ctlNotSocket and left; a live peer or a busy one is refused; a refused connect (no listener) removes the socket and its owner record ..." :pit (result effect))
(:sym "cfgInt" :mod "aslAgent/leonServe" :sig "cfgInt text: String key: String fallback: Int64 -> Int64" :doc "integer value of the key in a config text, the fallback when absent or not a number; read the :leonPool group only, through groupText")
(:sym "groupText" :mod "aslAgent/leonServe" :sig "groupText text: String group: String -> String" :doc "the text of the first group named group of a config text, parens included, empty when absent; parens inside quoted strings do not count, so a key of another group with the same name is never read through it")
(:sym "lockCtl!" :mod "aslAgent/leonServe" :kind fn! :sig "lockCtl! ctl: String -> (Result String String)" :doc "takes ctl.sock.lock by exclusive create with the starter's pid; a live holder refuses the start; a dead holder's lock is removed only if it still holds the text just read and then created once more" :pit (result effect))
(:sym "bindCtl!" :mod "aslAgent/leonServe" :kind fn! :sig "bindCtl! ctl: String tries: Int64 delayMs: Int64 -> (Result Int64 String)" :doc "under the starter lock: frees the control path (freeCtl!), listens, writes the owner record, releases the lock; a failing owner record write is an error (ctlOwnerRecord) that closes and removes the socket just bound; a live listener's socke..." :pit (result effect))
(:sym "probeCtl!" :mod "aslAgent/leonServe" :kind fn! :sig "probeCtl! ctl: String tries: Int64 delayMs: Int64 os: String -> String" :doc "connects to the control socket: live when it answers, stale on the platform's refusal or a missing file, busy after the given tries a delay apart on any other error (EAGAIN, EINTR, EMFILE)" :pit (effect))
(:sym "ctlStaleError?" :mod "aslAgent/leonServe" :sig "ctlStaleError? os: String e: String -> Bool" :doc "true when a connect error proves a socket file stale on the given platform: ECONNREFUSED named per platform (io:111 on Linux, io:61 on Darwin where 61 is not ENODATA) or ENOENT")
(:sym "startOf!" :mod "aslAgent/leonServe" :kind fn! :sig "startOf! pid: Int64 -> String" :doc "the start time text of a process from ps -o lstart= (same on Linux and macOS, whitespace normalised), empty when ps does not answer; run through fleet/run with a 5 s limit" :pit (effect))
(:sym "ownerState!" :mod "aslAgent/leonServe" :kind fn! :sig "ownerState! ctl: String -> String" :doc "alive when the recorded pid runs with the recorded start time (or ps does not answer), gone when no such process runs or its start time differs (a reused pid), unknown when the record is absent or unreadable; a refused socket is removed by ..." :pit (effect))
(:sym "ownerPath" :mod "aslAgent/leonServe" :sig "ownerPath ctl: String -> String" :doc "path of the owner record beside the control socket, ctl.sock.pid, written by the pool after it binds: (:owner :pid N :start S)")
