(:sym "languageText!" :mod "aslAgent/grounding" :kind fn! :sig "languageText! repoRoot: String -> (Result String String)" :doc "the unescaped :text of the tools.asn :language topic, or err when absent" :pit (result effect))
(:sym "languageRules" :mod "aslAgent/grounding" :sig "languageRules text: String -> (List String)" :doc "each anchored sentence of the language text, cut at its sentence end; missing anchors are left out")
(:sym "typeRules" :mod "aslAgent/grounding" :sig "typeRules text: String -> (List String)" :doc "each type-anchored sentence of the language text, cut at its sentence end")
(:sym "libExample" :mod "aslAgent/grounding" :sig "libExample text: String names: (List String) -> String" :doc "a module header exporting the named items plus each item's schema line or fn block, cut by name from a source file")
