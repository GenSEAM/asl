(:sym "admit" :mod "aslAgent/pool" :sig "admit ts: (List PoolTask) -> Admission" :doc "split tasks into admitted and refused; both members of an overlapping pair are refused, so no file of either is touched")
(:sym "admitWith" :mod "aslAgent/pool" :sig "admitWith ts: (List PoolTask) mode: String -> Admission" :doc "admission by onOverlap mode: refuse splits tasks into admitted and refused like admit; wait admits every task and records the earlier overlapping tasks in its waitsFor, lanesOf then puts overlapping tasks into one lane so they run in argv o...")
(:sym "lanesOf" :mod "aslAgent/pool" :sig "lanesOf ts: (List PoolTask) -> (List (List PoolTask))" :doc "group admitted tasks into lanes: tasks whose roots are equal or nest share one lane, ordered by argv position; lanes are ordered by their first task")
