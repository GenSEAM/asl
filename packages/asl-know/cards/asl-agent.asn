(:sym "PoolSelf" :mod "aslAgent/poolOps" :kind type :sig "(schema PoolSelf (:f chan String) (:f idx Int64))" :doc "the pool channel dir and task index a Leon run belongs to" :pit (record))
(:sym "poolSelf" :mod "aslAgent/poolOps" :sig "poolSelf chan: String idx: Int64 -> (Option PoolSelf)" :doc "a PoolSelf, or none when chan is empty or idx is negative" :pit (option))
(:sym "poolSelfOf" :mod "aslAgent/poolOps" :sig "poolSelfOf agentForm: String -> (Option PoolSelf)" :doc "the PoolSelf named by an (:agent) form's :poolChan and :poolIdx, none outside a pool" :pit (option))
(:sym "formField" :mod "aslAgent/poolOps" :sig "formField form: String key: String -> String" :doc "the word after :key in an op form's header, before :body; empty when absent")
(:sym "formBody" :mod "aslAgent/poolOps" :sig "formBody form: String -> (Option String)" :doc "the balanced form after :body in an op form, parentheses inside strings ignored" :pit (option))
(:sym "askReceipt!" :mod "aslAgent/poolOps" :kind fn! :sig "askReceipt! self: (Option PoolSelf) form: String -> String" :doc "run an (:ask) op form: send its body to the peer and return the answer, or the refusal, as one ASN receipt" :pit (effect))
(:sym "servePending!" :mod "aslAgent/poolOps" :kind fn! :sig "servePending! self: (Option PoolSelf) -> String" :doc "the between-turn hook: move asks waiting in this task's inbox to its served dir and return them as one (:poolAsks ...) observation, empty when there are none" :pit (effect))
(:sym "answerReceipt!" :mod "aslAgent/poolOps" :kind fn! :sig "answerReceipt! self: (Option PoolSelf) form: String -> String" :doc "run an (:answer) op form: answer the served ask named by :id, or the oldest from task :to, and return the receipt" :pit (effect))
(:sym "askWaitMs" :mod "aslAgent/poolOps" :sig "askWaitMs -> Int64" :doc "60000, how long an (:ask) op waits when it names no :waitMs")
