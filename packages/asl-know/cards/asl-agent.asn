(:card "asl-agent" :purpose "Leon, the agent loop (core, loop, turn, txn, gates, journal, providers, pool, main CLI and the rest of the loop modules), plus omni-channel intent classification, front-agent directive dispatch, unbiased-context sanitati..." :import "(aslAgent/main :a x)" :deps (asl-text asl-json asl-proc asl-forms asl-gateway asl-harness asl-engine asl-checker) :modules ((:m "aslAgent/main" :doc "Leon's CLI entry, ported from scripts/agentLoop/main.py:...") (:m "aslAgent/agentConfig") (:m "aslAgent/aslOps" :doc "U5: Leon asl ops and transport ported from scripts/agent...") (:m "aslAgent/attractor") (:m "aslAgent/card" :doc "Agent Card generator: loop and provider facts come from ...")) :moduleCount 45 :sigs ("withRemote op: (List (Pair String c/KvVal)) unit: String -> (List (Pair String c/KvVal))" "knownParams -> (List String)" "acceptedKeys -> (List String)" "nearestKey! unknown: String -> String" "liveTxnTargets op: (List (Pair String c/KvVal)) -> (List String)" "tokenizeAsn text: String -> (Result (List String) String)" "(schema Invocation (:f params (List (Pair String j/Json))) (:f unknownOps (List String)) (:f syntaxError (Option String)) (:f contextFileErr..." "paramGet ps: (List (Pair String j/Json)) key: String -> (Option j/Json)") :more (parseInvocation ResumeTurn ResumeState RunArgs resumeReport journalResume journalModeHint NeedsConfirm OwnsRejection Usage Batching LoopResult formatReceipt) :moreCount 1084 :effects (nearestKey! parseInvocation resumeReport journalResume receiptFieldNames liveAdvisor liveReviewer liveHooks!) :fails (tokenizeAsn journalResume receiptFieldsIn receiptFieldNames liveAdvisor liveReviewer engineRequest runAslSocket) :example none)
(:sym "withRemote" :mod "aslAgent/main" :sig "withRemote op: (List (Pair String c/KvVal)) unit: String -> (List (Pair String c/KvVal))" :doc "adds the unit the remote param names to an op's params")
