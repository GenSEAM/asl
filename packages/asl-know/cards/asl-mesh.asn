(:card "asl-mesh" :purpose "Unified Autonomous Agent Mesh Orchestrator, Raft Distributed Consensus, Vector Clocks, Merkle OCC, and Parallel Partition Scheduler" :import "(asl-mesh/scheduler :a x)" :modules ((:m "asl-mesh/scheduler" :doc "Autonomous multi-model mesh partition scheduler and work...") (:m "asl-mesh/coord" :doc "Autonomous Agent Swarm Coordinator, Task Claim Managemen...") (:m "asl-mesh/descriptor" :doc "Pure ASL Executable DSL Descriptors for Mesh Configurati...") (:m "asl-mesh/emitter" :doc "Automated gap ledger emitter and record persistence engi...") (:m "asl-mesh" :doc "Autonomous Agent Swarm Coordination and Merkle Optimisti...")) :moduleCount 12 :sigs ("schedulePartitions packages: Any workerSpecs: Any -> List" "allocateWorkerWorktree workerId: Any baseRoot: Any -> Str" "partitionMap packages: Any workers: Any -> Map" "worktreePool baseDir: String count: Int64 -> (List String)" "(schema SwarmClaim (:f taskId String) (:f workerId String) (:f leaseTimestamp Int64) (:f leaseDuration Int64) (:f claimEpoch Int64) (:f writ..." "(schema WorkerPartition (:f workerId String) (:f taskIds (List String)) (:f combinedWriteSet (List String)))" "(schema StealResult (:f victim WorkerPartition) (:f thief WorkerPartition) (:f success Bool))") :more (makeSwarmClaim makeSwarmClaimWithEpoch makeWorkerPartition makeStealResult areClaimsDisjoint areClaimsFullyDisjoint isClaimExpired? isClaimSafeToCommit?) :moreCount 117 :effects (walAppendEntry! walTruncateSuffix!) :fails (validateMerkleCommit dispatchFrame) :example none)
