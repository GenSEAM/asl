(:card "asl-crypto" :purpose "Pure ASL cryptographic primitives: HMAC-SHA256, AES and Fernet" :import "(asl-crypto/hmac :a x)" :modules ((:m "asl-crypto/hmac" :doc "RFC 2104 HMAC-SHA256 and constant-time byte equality.") (:m "asl-crypto/aes" :doc "FIPS-197 AES block cipher for 128, 192, and 256 bit keys...") (:m "asl-crypto/fernet" :doc "Fernet token verification and AES-CBC message recovery.")) :sigs ("hmacSha256 key: Bytes msg: Bytes -> Bytes" "hmacSha256Hex key: Bytes msg: Bytes -> String" "constantTimeEqual a: Bytes b: Bytes -> Bool" "bytesToHex bytes: Bytes -> String" "hexToBytes text: String -> (Result Bytes String)" "aesExpandKey key: Bytes -> (Result Bytes String)" "aesEncryptBlock key: Bytes block: Bytes -> (Result Bytes String)" "aesDecryptBlock key: Bytes block: Bytes -> (Result Bytes String)" "aesCbcDecrypt key: Bytes iv: Bytes ciphertext: Bytes -> (Result Bytes String)" "aesCbcEncrypt key: Bytes iv: Bytes plaintext: Bytes -> (Result Bytes String)") :more (aesCtrCrypt aesGcmEncrypt aesGcmDecrypt fernetVerify) :effects (aesExpandKey aesEncryptBlock aesDecryptBlock aesCbcDecrypt aesCbcEncrypt aesCtrCrypt aesGcmEncrypt aesGcmDecrypt) :fails (hexToBytes aesExpandKey aesEncryptBlock aesDecryptBlock aesCbcDecrypt aesCbcEncrypt aesCtrCrypt aesGcmEncrypt) :example "(module asl-know/examples/aslCrypto :x [signHex selfTest] :i [(asl-crypto/hmac :a h)])\n\nfn signHex key: String msg: String -> String\n  (h/hmacSha256Hex (stringToBytes key) (stringToBytes msg))")
(:sym "hmacSha256" :mod "asl-crypto/hmac" :sig "hmacSha256 key: Bytes msg: Bytes -> Bytes")
(:sym "hmacSha256Hex" :mod "asl-crypto/hmac" :sig "hmacSha256Hex key: Bytes msg: Bytes -> String")
(:sym "constantTimeEqual" :mod "asl-crypto/hmac" :sig "constantTimeEqual a: Bytes b: Bytes -> Bool")
(:sym "bytesToHex" :mod "asl-crypto/hmac" :sig "bytesToHex bytes: Bytes -> String")
(:sym "hexToBytes" :mod "asl-crypto/hmac" :sig "hexToBytes text: String -> (Result Bytes String)" :pit (result))
(:sym "aesExpandKey" :mod "asl-crypto/aes" :kind fn! :sig "aesExpandKey key: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesEncryptBlock" :mod "asl-crypto/aes" :kind fn! :sig "aesEncryptBlock key: Bytes block: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesDecryptBlock" :mod "asl-crypto/aes" :kind fn! :sig "aesDecryptBlock key: Bytes block: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesCbcDecrypt" :mod "asl-crypto/aes" :kind fn! :sig "aesCbcDecrypt key: Bytes iv: Bytes ciphertext: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesCbcEncrypt" :mod "asl-crypto/aes" :kind fn! :sig "aesCbcEncrypt key: Bytes iv: Bytes plaintext: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesCtrCrypt" :mod "asl-crypto/aes" :kind fn! :sig "aesCtrCrypt key: Bytes counterBlock: Bytes input: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesGcmEncrypt" :mod "asl-crypto/aes" :kind fn! :sig "aesGcmEncrypt key: Bytes iv: Bytes aad: Bytes plaintext: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesGcmDecrypt" :mod "asl-crypto/aes" :kind fn! :sig "aesGcmDecrypt key: Bytes iv: Bytes aad: Bytes ciphertextAndTag: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "fernetVerify" :mod "asl-crypto/fernet" :kind fn! :sig "fernetVerify key: String token: String nowSeconds: Int64 ttlSeconds: Int64 -> (Result Bytes String)" :pit (result effect))
