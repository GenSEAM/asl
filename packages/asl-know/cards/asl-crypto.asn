(:card "asl-crypto" :purpose "Pure ASL cryptographic primitives: SHA-1/SHA-512, HMAC-SHA256/512, AES, Fernet and OS randomness" :import "(asl-crypto/hmac :a x)" :modules ((:m "asl-crypto/hmac" :doc "RFC 2104 HMAC-SHA256 and constant-time byte equality.") (:m "asl-crypto/aes" :doc "FIPS-197 AES block cipher for 128, 192, and 256 bit keys...") (:m "asl-crypto/fernet" :doc "Fernet token verification and AES-CBC message recovery.") (:m "asl-crypto/random" :doc "OS entropy from /dev/urandom: randomBytes (0 to 1048576 ...") (:m "asl-crypto/sha" :doc "FIPS 180-4 SHA-1 and SHA-512 on Bytes, plus RFC 2104 HMA...")) :sigs ("hmacSha256 key: Bytes msg: Bytes -> Bytes" "hmacSha256Hex key: Bytes msg: Bytes -> String" "constantTimeEqual a: Bytes b: Bytes -> Bool" "bytesToHex bytes: Bytes -> String" "hexToBytes text: String -> (Result Bytes String)" "aesExpandKey key: Bytes -> (Result Bytes String)" "aesEncryptBlock key: Bytes block: Bytes -> (Result Bytes String)" "aesDecryptBlock key: Bytes block: Bytes -> (Result Bytes String)" "aesCbcDecrypt key: Bytes iv: Bytes ciphertext: Bytes -> (Result Bytes String)" "aesCbcEncrypt key: Bytes iv: Bytes plaintext: Bytes -> (Result Bytes String)") :more (aesCtrCrypt aesGcmEncrypt aesGcmDecrypt fernetVerify randomBytes uuidV4 sha1 sha512 hmacSha512) :effects (aesExpandKey aesEncryptBlock aesDecryptBlock aesCbcDecrypt aesCbcEncrypt aesCtrCrypt aesGcmEncrypt aesGcmDecrypt) :fails (hexToBytes aesExpandKey aesEncryptBlock aesDecryptBlock aesCbcDecrypt aesCbcEncrypt aesCtrCrypt aesGcmEncrypt) :example "(module asl-know/examples/aslCrypto :x [signHex selfTest] :i [(asl-crypto/hmac :a h)])\n\nfn signHex key: String msg: String -> String\n  (h/hmacSha256Hex (stringToBytes key) (stringToBytes msg))")
(:sym "hmacSha256" :mod "asl-crypto/hmac" :sig "hmacSha256 key: Bytes msg: Bytes -> Bytes")
(:sym "hmacSha256Hex" :mod "asl-crypto/hmac" :sig "hmacSha256Hex key: Bytes msg: Bytes -> String")
(:sym "constantTimeEqual" :mod "asl-crypto/hmac" :sig "constantTimeEqual a: Bytes b: Bytes -> Bool")
(:sym "bytesToHex" :mod "asl-crypto/hmac" :sig "bytesToHex bytes: Bytes -> String")
(:sym "hexToBytes" :mod "asl-crypto/hmac" :sig "hexToBytes text: String -> (Result Bytes String)" :pit (result))
(:sym "aesExpandKey" :mod "asl-crypto/aes" :kind fn! :sig "aesExpandKey key: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesEncryptBlock" :mod "asl-crypto/aes" :kind fn! :sig "aesEncryptBlock key: Bytes block: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesDecryptBlock" :mod "asl-crypto/aes" :kind fn! :sig "aesDecryptBlock key: Bytes block: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesCbcDecrypt" :mod "asl-crypto/aes" :kind fn! :sig "aesCbcDecrypt key: Bytes iv: Bytes ciphertext: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesCbcEncrypt" :mod "asl-crypto/aes" :kind fn! :sig "aesCbcEncrypt key: Bytes iv: Bytes plaintext: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesCtrCrypt" :mod "asl-crypto/aes" :kind fn! :sig "aesCtrCrypt key: Bytes counterBlock: Bytes input: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesGcmEncrypt" :mod "asl-crypto/aes" :kind fn! :sig "aesGcmEncrypt key: Bytes iv: Bytes aad: Bytes plaintext: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "aesGcmDecrypt" :mod "asl-crypto/aes" :kind fn! :sig "aesGcmDecrypt key: Bytes iv: Bytes aad: Bytes ciphertextAndTag: Bytes -> (Result Bytes String)" :pit (result effect))
(:sym "fernetVerify" :mod "asl-crypto/fernet" :kind fn! :sig "fernetVerify key: String token: String nowSeconds: Int64 ttlSeconds: Int64 -> (Result Bytes String)" :pit (result effect))
(:sym "randomBytes" :mod "asl-crypto/random" :kind fn! :sig "randomBytes n: Int64 -> (Result Bytes String)" :doc "Returns n random bytes read from /dev/urandom; errs when n is below 0 or above 1048576 or the read fails." :pit (result effect))
(:sym "uuidV4" :mod "asl-crypto/random" :kind fn! :sig "uuidV4 -> (Result String String)" :doc "Returns a lowercase 8-4-4-4-12 RFC 4122 version-4 UUID with variant 10 bits set; errs when the underlying randomBytes read fails." :pit (result effect))
(:sym "sha1" :mod "asl-crypto/sha" :sig "sha1 msg: Bytes -> Bytes" :doc "Returns the 20-byte FIPS 180-4 SHA-1 digest of the input Bytes; never fails.")
(:sym "sha512" :mod "asl-crypto/sha" :sig "sha512 msg: Bytes -> Bytes" :doc "Returns the 64-byte FIPS 180-4 SHA-512 digest of the input Bytes; never fails.")
(:sym "hmacSha512" :mod "asl-crypto/sha" :sig "hmacSha512 key: Bytes msg: Bytes -> Bytes" :doc "Returns the 64-byte RFC 2104 HMAC-SHA512 of msg under key with a 128-byte block, hashing keys longer than the block; never fails.")
