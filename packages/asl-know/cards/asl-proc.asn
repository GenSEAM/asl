(:sym "Job" :mod "asl-proc/jobPool" :kind type :sig "(schema Job (:f argv (List String)) (:f cwd String) (:f env (List String)))" :doc "one child invocation: argv, working directory, extra environment rows" :pit (record))
(:sym "Done" :mod "asl-proc/jobPool" :kind type :sig "(schema Done (:f idx Int64) (:f exit Int64) (:f out String) (:f ms Int64) (:f verdict String))" :doc "one finished job: its index, exit code, combined stdout+stderr, wall ms, and verdict (exit, timeout, runaway, spawnFailed)" :pit (record))
(:sym "Limits" :mod "asl-proc/jobPool" :kind type :sig "(schema Limits (:f timeoutMs Int64) (:f maxDesc Int64))" :doc "a job's watchdog budget: wall-clock timeoutMs and the maxDesc descendant-process count before it is judged runaway" :pit (record))
(:sym "Proc" :mod "asl-proc/jobPool" :kind type :sig "(schema Proc (:f pid Int64) (:f ppid Int64) (:f pgid Int64))" :doc "one ps snapshot row: pid, parent pid, process group id" :pit (record))
(:sym "job" :mod "asl-proc/jobPool" :sig "job argv: (List String) cwd: String env: (List String) -> Job" :doc "Job constructor")
(:sym "limits" :mod "asl-proc/jobPool" :sig "limits timeoutS: Int64 maxDesc: Int64 -> Limits" :doc "Limits constructor from a timeout in whole seconds and a max descendant count")
(:sym "defaultLimits" :mod "asl-proc/jobPool" :sig "defaultLimits -> Limits" :doc "1800s timeout, 64 max descendants")
(:sym "runPool" :mod "asl-proc/jobPool" :kind fn! :sig "runPool jobs: (List Job) slots: Int64 -> (List Done)" :doc "run jobs over slots concurrent slots under defaultLimits, returning Done rows in job order" :pit (effect))
(:sym "runPoolLimited" :mod "asl-proc/jobPool" :kind fn! :sig "runPoolLimited jobs: (List Job) slots: Int64 lim: Limits -> (List Done)" :doc "runPool with explicit Limits" :pit (effect))
(:sym "runPoolEach" :mod "asl-proc/jobPool" :kind fn! :sig "runPoolEach jobs: (List Job) slots: Int64 lim: Limits admit: (fn [Int64] -> Bool) onDone: (fn [S Done] -> S) state: S -> (Pair (List Done) S)" :doc "runPoolLimited with a per-job admit gate and a folded onDone callback state, for a caller that reacts to each completion as it happens" :pit (effect))
(:sym "runOne" :mod "asl-proc/jobPool" :kind fn! :sig "runOne j: Job -> Done" :doc "run a single Job under defaultLimits" :pit (effect))
(:sym "runOneLimited" :mod "asl-proc/jobPool" :kind fn! :sig "runOneLimited j: Job lim: Limits -> Done" :doc "run a single Job under explicit Limits" :pit (effect))
(:sym "psPairs" :mod "asl-proc/jobPool" :sig "psPairs text: String -> (List (Pair Int64 Int64))" :doc "parse ps text into (pid, ppid) pairs, skipping zombies and unparsable rows")
(:sym "descendantsOf" :mod "asl-proc/jobPool" :sig "descendantsOf pairs: (List (Pair Int64 Int64)) root: Int64 -> (List Int64)" :doc "every pid reachable from root by following child links in a (pid, ppid) pair list")
(:sym "psSnapshot" :mod "asl-proc/jobPool" :kind fn! :sig "psSnapshot -> (List (Pair Int64 Int64))" :doc "procSnapshot reduced to (pid, ppid) pairs" :pit (effect))
(:sym "procsOf" :mod "asl-proc/jobPool" :sig "procsOf text: String -> (List Proc)" :doc "parse ps -o pid,ppid,pgid,stat text into Proc rows, skipping zombies and malformed lines")
(:sym "procSnapshot" :mod "asl-proc/jobPool" :kind fn! :sig "procSnapshot -> (List Proc)" :doc "a live Proc snapshot via ps -A" :pit (effect))
(:sym "treeOf" :mod "asl-proc/jobPool" :sig "treeOf procs: (List Proc) root: Int64 groups: (List Int64) known: (List Int64) own: Int64 -> (Pair (List Int64) (List Int64))" :doc "root's live process tree: descendant pids plus every process group they or their known anchors still hold, growing outward until stable or 10000 rounds")
(:sym "killTree!" :mod "asl-proc/jobPool" :kind fn! :sig "killTree! root: Int64 -> Int64" :doc "SIGSTOP then SIGKILL every process and group in root's tree, retrying until nothing is left or 5 rounds pass; returns the count still alive" :pit (effect))
(:sym "shellOut" :mod "asl-proc/jobPool" :kind fn! :sig "shellOut cmd: String timeoutMs: Int64 -> (Result String String)" :doc "run cmd via processSpawn/processWait under a timeout; ok only on exit 0, otherwise the exit code and stderr" :pit (result effect))
(:sym "childEnv" :mod "asl-proc/jobPool" :kind fn! :sig "childEnv overrides: (List String) -> (List String)" :doc "overrides, plus every inherited env row whose name is not already in overrides and does not look like a secret" :pit (effect))
(:sym "secretName?" :mod "asl-proc/jobPool" :sig "secretName? name: String -> Bool" :doc "true when an env var name looks like a credential (ends _API_KEY, contains TOKEN or SECRET); childEnv never forwards one")
(:sym "executedOf" :mod "asl-proc/jobPool" :sig "executedOf text: String -> (Option Int64)" :doc "the assertion count parsed from a test run's trailing 'N assertion(s) executed' or '(... asserts)' line; 0 on an unparsed FAIL, none when neither pattern is found" :pit (option))
(:sym "errorLinesOf" :mod "asl-proc/jobPool" :sig "errorLinesOf text: String -> (List String)" :doc "every ERR_... tail from a non-FAIL line, for summarizing a run's distinct error codes")
