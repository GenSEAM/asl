(:card "asl-proc" :purpose "Native AgentSlang OS Child Process Management, Stream Redirection, Pipes, APM, and Resource Guards" :import "(asl-proc/process :a x)" :deps (asl-text) :modules ((:m "asl-proc/process" :doc "Pure AgentSlang process supervision modular aliases and ...") (:m "asl-proc/ansi" :doc "Pure ASL terminal emulation helpers: ANSI escape sequenc...") (:m "asl-proc/apm" :doc "APM Daemon, Supervisor, Singleton Advisory Lock, and Mul...") (:m "asl-proc/batchDag" :doc "Batch RPC execution DAG engine, dependency topological o...") (:m "asl-proc/log" :doc "Structured Administrative Logging & Error Streams for Ag...")) :moduleCount 20 :sigs ("status elapsedMs: I64 deadlineMs: I64 opName: Str -> apm/SupervisorVerdict" "list entries: (List apm/DaemonEntry) -> Str" "procStatus elapsedMs: I64 deadlineMs: I64 opName: Str -> apm/SupervisorVerdict" "procList entries: (List apm/DaemonEntry) -> Str" "proc/status elapsedMs: I64 deadlineMs: I64 opName: Str -> apm/SupervisorVerdict" "proc/list entries: (List apm/DaemonEntry) -> Str" "cmd bin: String args: (List String) -> cp/ProcessCmd" "withCwd c: cp/ProcessCmd dir: String -> cp/ProcessCmd" "withTimeout c: cp/ProcessCmd ms: Int64 -> cp/ProcessCmd") :more (withStdin withEnv buildShellCmd exec! execRaw! runSimple! sessionSpawn! sessionSpawnWithPid! sessionSendInput! sessionInput! sessionPollTail! sessionTail!) :moreCount 235 :effects (exec! execRaw! runSimple! sessionSpawn! sessionSpawnWithPid! sessionSendInput! sessionInput! sessionPollTail!) :fails (exec! execRaw! runSimple! oobDemuxFinish pipe! gitSafe! gitWrite! verifyContained!) :example none)
