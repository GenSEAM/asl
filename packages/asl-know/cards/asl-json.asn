(:card "asl-json" :purpose "Pure AgentSlang RFC 8259 JSON parser, emitter, and inspector" :import "(asl-json/json :a x)" :modules ((:m "asl-json/json" :doc "Pure AgentSlang RFC 8259 JSON parser, emitter, and inspe...")) :sigs ("enum Json (jnull) (jbool b: Bool) (jint i: Int64) (jfloat f: Float64) (jnum n: Float64) (jstr s: String) (jarr xs: (List Json)) (jobj kvs: (..." "jsonParse src: String -> (Result Json String)" "jsonEmit val: Json -> String" "jsonGet obj: Json key: String -> (Option Json)") :fails (jsonParse) :example "(module asl-know/examples/aslJson :x [intField emitPair selfTest] :i [(asl-json/json :a j)])\n\nfn intField src: String key: String -> Int64\n  (mt (j/jsonParse src)\n    ((err _) -1)\n    ((ok v)\n      (mt (j/jsonGet v key)\n        ((none) -2)\n        ((some x) (mt x ((j/jint n) n) (_ -3))))))\n\nfn emitPair k: String v: String -> String\n  (j/jsonEmit (j/jobj [(pair k (j/jstr v))]))")
(:sym "Json" :mod "asl-json/json" :kind type :sig "enum Json (jnull) (jbool b: Bool) (jint i: Int64) (jfloat f: Float64) (jnum n: Float64) (jstr s: String) (jarr xs: (List Json)) (jobj kvs: (List (Pair String Json)))")
(:sym "jnull" :mod "asl-json/json" :kind ctor :sig "(jnull) of Json" :pit (ctor))
(:sym "jbool" :mod "asl-json/json" :kind ctor :sig "(jbool b: Bool) of Json" :pit (ctor))
(:sym "jint" :mod "asl-json/json" :kind ctor :sig "(jint i: Int64) of Json" :pit (ctor))
(:sym "jfloat" :mod "asl-json/json" :kind ctor :sig "(jfloat f: Float64) of Json" :pit (ctor))
(:sym "jnum" :mod "asl-json/json" :kind ctor :sig "(jnum n: Float64) of Json" :pit (ctor))
(:sym "jstr" :mod "asl-json/json" :kind ctor :sig "(jstr s: String) of Json" :pit (ctor))
(:sym "jarr" :mod "asl-json/json" :kind ctor :sig "(jarr xs: (List Json)) of Json" :pit (ctor))
(:sym "jobj" :mod "asl-json/json" :kind ctor :sig "(jobj kvs: (List (Pair String Json))) of Json" :pit (ctor))
(:sym "jsonParse" :mod "asl-json/json" :sig "jsonParse src: String -> (Result Json String)" :pit (result))
(:sym "jsonEmit" :mod "asl-json/json" :sig "jsonEmit val: Json -> String")
(:sym "jsonGet" :mod "asl-json/json" :sig "jsonGet obj: Json key: String -> (Option Json)" :pit (option))
