(:card "core/comparison" :purpose "Comparison and logic builtins, no import" :sigs ("= : T T -> Bool" "!= : T T -> Bool" "< : T T -> Bool" "<= : T T -> Bool" "> : T T -> Bool" ">= : T T -> Bool" "and : Bool... -> Bool" "or : Bool... -> Bool" "not : Bool -> Bool") :example none)
(:sym "=" :sig "= : T T -> Bool" :doc "Structural equality over lists and records; comparing values of different kinds is a type error.")
(:sym "!=" :sig "!= : T T -> Bool" :doc "Structural inequality.")
(:sym "<" :sig "< : T T -> Bool" :doc "Ordered comparison of two values of the same type: Int, Float, String (bytewise) or Keyword (by name); any other pair is ERR_TYPE.")
(:sym "<=" :sig "<= : T T -> Bool" :doc "Ordered comparison of two values of the same type: Int, Float, String (bytewise) or Keyword (by name); any other pair is ERR_TYPE.")
(:sym ">" :sig "> : T T -> Bool" :doc "Ordered comparison of two values of the same type: Int, Float, String (bytewise) or Keyword (by name); any other pair is ERR_TYPE.")
(:sym ">=" :sig ">= : T T -> Bool" :doc "Ordered comparison of two values of the same type: Int, Float, String (bytewise) or Keyword (by name); any other pair is ERR_TYPE.")
(:sym "and" :sig "and : Bool... -> Bool" :doc "Conjunction; short-circuits; takes one or more Bool operands. Any other value is a type error." :pit (variadic))
(:sym "or" :sig "or : Bool... -> Bool" :doc "Disjunction; short-circuits; takes one or more Bool operands." :pit (variadic))
(:sym "not" :sig "not : Bool -> Bool" :doc "Negation of a Bool.")
