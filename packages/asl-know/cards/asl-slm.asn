(:card "asl-slm" :purpose "AgentSlang Small Language Model EBNF Grammar PDA and Token Mask Bitset Engine" :import "(asl-slm :a x)" :modules ((:m "asl-slm" :doc "Top-level facade for asl-slm package") (:m "asl-slm/masker" :doc "Pure ASL EBNF Grammar Automaton, Pushdown State Tracker,...")) :sigs ("compileGrammarToDfa grammarStr: Str -> msk/GrammarPda" "maskerInit pda: msk/GrammarPda eosTokenId: Int -> msk/MaskerState" "advanceMaskerState pda: msk/GrammarPda st: msk/MaskerState tokenText: Str -> msk/MaskerState" "advanceMaskerSubword pda: msk/GrammarPda st: msk/MaskerState subword: Str -> msk/MaskerState" "resetMaskerBuffer st: msk/MaskerState -> msk/MaskerState" "computeTokenMaskBitset pda: msk/GrammarPda st: msk/MaskerState vocab: (List (Pair Int Str)) -> msk/TokenMaskBitset" "isTokenAllowed mask: msk/TokenMaskBitset tokenId: Int -> Bool") :more (isTokenValidAtState isSubwordPrefixValid isGrammarTerminalAllowed GrammarPda MaskerState TokenMaskBitset compileGrammarToDfa maskerInit advanceMaskerState) :moreCount 7 :example none)
(:sym "GrammarPda" :mod "asl-slm" :sig none)
(:sym "MaskerState" :mod "asl-slm" :sig none)
(:sym "TokenMaskBitset" :mod "asl-slm" :sig none)
(:sym "compileGrammarToDfa" :mod "asl-slm" :sig "compileGrammarToDfa grammarStr: Str -> msk/GrammarPda")
(:sym "maskerInit" :mod "asl-slm" :sig "maskerInit pda: msk/GrammarPda eosTokenId: Int -> msk/MaskerState")
(:sym "advanceMaskerState" :mod "asl-slm" :sig "advanceMaskerState pda: msk/GrammarPda st: msk/MaskerState tokenText: Str -> msk/MaskerState")
(:sym "advanceMaskerSubword" :mod "asl-slm" :sig "advanceMaskerSubword pda: msk/GrammarPda st: msk/MaskerState subword: Str -> msk/MaskerState")
(:sym "resetMaskerBuffer" :mod "asl-slm" :sig "resetMaskerBuffer st: msk/MaskerState -> msk/MaskerState")
(:sym "computeTokenMaskBitset" :mod "asl-slm" :sig "computeTokenMaskBitset pda: msk/GrammarPda st: msk/MaskerState vocab: (List (Pair Int Str)) -> msk/TokenMaskBitset")
(:sym "isTokenAllowed" :mod "asl-slm" :sig "isTokenAllowed mask: msk/TokenMaskBitset tokenId: Int -> Bool")
(:sym "isTokenValidAtState" :mod "asl-slm" :sig "isTokenValidAtState pda: msk/GrammarPda st: msk/MaskerState tokenId: Int tokenText: Str -> Bool")
(:sym "isSubwordPrefixValid" :mod "asl-slm" :sig "isSubwordPrefixValid pda: msk/GrammarPda prefix: Str -> Bool")
(:sym "isGrammarTerminalAllowed" :mod "asl-slm" :sig "isGrammarTerminalAllowed pda: msk/GrammarPda tok: Str -> Bool")
(:sym "GrammarPda" :mod "asl-slm/masker" :kind type :sig "(schema GrammarPda (:f status Str) (:f diagnosticCode Str) (:f stateCount Int) (:f startState Int) (:f acceptState Int) (:f rootRequiresDelimiter Bool) (:f ruleNames (List Str)) (:f terminals (List Str)) (:f delimiters (List Str)))" :pit (record))
(:sym "MaskerState" :mod "asl-slm/masker" :kind type :sig "(schema MaskerState (:f currentState Int) (:f stackDepth Int) (:f isEosAllowed Bool) (:f isPrefixValid Bool) (:f buffer Str))" :pit (record))
(:sym "TokenMaskBitset" :mod "asl-slm/masker" :kind type :sig "(schema TokenMaskBitset (:f allowedTokenIds (List Int)) (:f totalVocabSize Int))" :pit (record))
(:sym "compileGrammarToDfa" :mod "asl-slm/masker" :sig "compileGrammarToDfa grammarStr: Str -> GrammarPda")
(:sym "maskerInit" :mod "asl-slm/masker" :sig "maskerInit pda: GrammarPda eosTokenId: Int -> MaskerState")
(:sym "advanceMaskerState" :mod "asl-slm/masker" :sig "advanceMaskerState pda: GrammarPda st: MaskerState tokenText: Str -> MaskerState")
(:sym "advanceMaskerSubword" :mod "asl-slm/masker" :sig "advanceMaskerSubword pda: GrammarPda st: MaskerState subword: Str -> MaskerState")
(:sym "resetMaskerBuffer" :mod "asl-slm/masker" :sig "resetMaskerBuffer st: MaskerState -> MaskerState")
(:sym "computeTokenMaskBitset" :mod "asl-slm/masker" :sig "computeTokenMaskBitset pda: GrammarPda st: MaskerState vocab: (List (Pair Int Str)) -> TokenMaskBitset")
(:sym "isTokenAllowed" :mod "asl-slm/masker" :sig "isTokenAllowed mask: TokenMaskBitset tokenId: Int -> Bool")
(:sym "isTokenValidAtState" :mod "asl-slm/masker" :sig "isTokenValidAtState pda: GrammarPda st: MaskerState tokenId: Int tokenText: Str -> Bool")
(:sym "isSubwordPrefixValid" :mod "asl-slm/masker" :sig "isSubwordPrefixValid pda: GrammarPda prefix: Str -> Bool")
(:sym "isGrammarTerminalAllowed" :mod "asl-slm/masker" :sig "isGrammarTerminalAllowed pda: GrammarPda tok: Str -> Bool")
