(:card "asl-browser-plugin" :purpose "Aslany Browser Plugin: Voice-In Action-Out, In-Tab WebGPU, AudioWorklet 16kHz & AXTree Perception" :import "(aslBrowserPlugin/plugin :a x)" :deps (aslContracts aslAgentBus aslVdom) :modules ((:m "aslBrowserPlugin/plugin" :doc "Main package entrypoint for Aslany Browser Plugin & Audi...") (:m "aslBrowserPlugin/background" :doc "Browser WebExtension background service worker in pure A...") (:m "aslBrowserPlugin/content" :doc "In-tab DOM extraction and perception content script in p...") (:m "aslBrowserPlugin/domCompiler" :doc "In-page DOM interaction compiler: synthesizes atomic JS/...") (:m "aslBrowserPlugin/localSlm" :doc "Dual-inference controller: On-device WebGPU SLM vs Gatew...")) :moduleCount 9 :sigs ("startPlugin -> Str" "getPluginVersion -> Str" "getAslanyBrand -> Str" "initServiceWorker -> Str" "routeActionMessage msg: Str -> Str" "handleMessage msg: Str -> Str" "(schema PageContext (:f url Str) (:f title Str) (:f axNodes (List Str)) (:f isSecure Bool))" "makePageContext url: Str title: Str axNodes: (List Str) isSecure: Bool -> PageContext" "formatPageContext ctx: PageContext -> Str" "extractPageContext url: Str title: Str domTree: Str -> Str" "isValidActionType? actionType: Str -> Bool" "isValidSelector? selector: Str -> Bool" "dispatchAction actionType: Str selector: Str -> Bool") :more (executeContentAction execInPageAgent compileProbeJs compileTableExtractor compileTextSelector InferenceRoute InferenceTarget selectInferenceRoute) :moreCount 47 :example none)
