(:card "asl-tokenizer" :purpose "Pure AgentSlang o200k_base BPE token counter" :import "(asl-tokenizer/tokenizer :a x)" :modules ((:m "asl-tokenizer/tokenizer" :doc "Pure AgentSlang o200k_base BPE token counter")) :sigs ("schema Tokenizer tokenBytes: Bytes table: Bytes mask: Int64 asciiTable: Bytes unicodeTable: Bytes nUnicodeRanges: Int64 scratchOff: Bytes sc..." "loadTokenizer! dataDir: String -> (Result Tokenizer String)" "countTokens! tok: Tokenizer text: String -> Int64" "countTokensBytes! tok: Tokenizer bs: Bytes -> Int64") :effects (loadTokenizer! countTokens! countTokensBytes!) :fails (loadTokenizer!) :example none)
(:sym "Tokenizer" :mod "asl-tokenizer/tokenizer" :kind type :sig "schema Tokenizer tokenBytes: Bytes table: Bytes mask: Int64 asciiTable: Bytes unicodeTable: Bytes nUnicodeRanges: Int64 scratchOff: Bytes scratchLen: Bytes")
(:sym "loadTokenizer!" :mod "asl-tokenizer/tokenizer" :sig "loadTokenizer! dataDir: String -> (Result Tokenizer String)" :pit (result effect))
