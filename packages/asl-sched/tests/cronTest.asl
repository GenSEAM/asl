(module asl-sched/tests/cronTest
  :x [runTests]
  :i [(asl-sched/cron :a c)])

fn runTests -> Bool
  (let [(everyMinute (c/parseCron "* * * * *"))
        (hourly (c/parseCron "@hourly"))
        (daily (c/parseCron "@daily"))
        (weekly (c/parseCron "@weekly"))
        (monthly (c/parseCron "@monthly"))
        (yearly (c/parseCron "@yearly"))
        (leap (c/parseCron "0 0 29 FEB *"))
        (named (c/parseCron "0 0 * JAN MON"))
        (orDays (c/parseCron "0 0 13 * MON"))
        (eom (c/parseCron "0 0 31 * *"))
        (rollover (c/parseCron "0 0 1 JAN *"))
        (stepped (c/parseCron "*/15 * * * *"))
        (listed (c/parseCron "0,30 * * * *"))
        (sundayZero (c/parseCron "0 0 * * 0"))
        (sundaySeven (c/parseCron "0 0 * * 7"))
        (sundayRange (c/parseCron "0 0 * * 5-7"))
        (offsetStep (c/parseCron "5/15 * * * *"))
        (monthRange (c/parseCron "0 0 * JAN-MAR *"))
        (weekdayNameRange (c/parseCron "0 0 * * MON-FRI"))]
    (assert (match everyMinute ((ok _) true) ((err _) false)) "five-field wildcard parses")
    (assert (match hourly ((ok _) true) ((err _) false)) "hourly alias parses")
    (assert (match daily ((ok _) true) ((err _) false)) "daily alias parses")
    (assert (match weekly ((ok _) true) ((err _) false)) "weekly alias parses")
    (assert (match monthly ((ok _) true) ((err _) false)) "monthly alias parses")
    (assert (match yearly ((ok _) true) ((err _) false)) "yearly alias parses")
    (assert (match hourly ((ok schedule) (= (c/nextFire schedule 0) (ok 3600))) ((err _) false)) "hourly next time")
    (assert (match daily ((ok schedule) (= (c/nextFire schedule 0) (ok 86400))) ((err _) false)) "daily next time")
    (assert (match weekly ((ok schedule) (= (c/nextFire schedule 0) (ok 259200))) ((err _) false)) "weekly next time")
    (assert (match monthly ((ok schedule) (= (c/nextFire schedule 0) (ok 2678400))) ((err _) false)) "monthly next time")
    (assert (match yearly ((ok schedule) (= (c/nextFire schedule 0) (ok 31536000))) ((err _) false)) "yearly next time")
    (assert (match named ((ok schedule) (= (c/nextFire schedule 0) (ok 345600))) ((err _) false)) "month and weekday names")
    (assert (match orDays ((ok schedule) (= (c/nextFire schedule 0) (ok 345600))) ((err _) false)) "restricted day fields use OR")
    (assert (match eom ((ok schedule) (= (c/nextFire schedule 0) (ok 2592000))) ((err _) false)) "end of month skips short month")
    (assert (match rollover ((ok schedule) (= (c/nextFire schedule 0) (ok 31536000))) ((err _) false)) "year rollover")
    (assert (match everyMinute ((ok schedule) (= (c/nextFire schedule 59) (ok 60))) ((err _) false)) "next fire is strictly after")
    (assert (match stepped ((ok schedule) (= (c/nextFire schedule 0) (ok 900))) ((err _) false)) "step field")
    (assert (match offsetStep ((ok schedule) (= (c/nextFire schedule 0) (ok 300))) ((err _) false)) "step from field value through maximum")
    (assert (match listed ((ok schedule) (= (c/nextFire schedule 0) (ok 1800))) ((err _) false)) "list field")
    (assert (match sundayZero ((ok schedule) (= (c/nextFire schedule 0) (ok 259200))) ((err _) false)) "Sunday zero")
    (assert (match sundaySeven ((ok schedule) (= (c/nextFire schedule 0) (ok 259200))) ((err _) false)) "Sunday seven")
    (assert (match sundayRange ((ok schedule) (= (c/nextFire schedule 0) (ok 86400))) ((err _) false)) "Sunday seven in range")
    (assert (match monthRange ((ok schedule) (= (c/nextFire schedule 0) (ok 86400))) ((err _) false)) "month name range")
    (assert (match weekdayNameRange ((ok schedule) (= (c/nextFire schedule 0) (ok 86400))) ((err _) false)) "weekday name range")
    (assert (match leap ((ok schedule) (= (c/nextFire schedule 0) (ok 68169600))) ((err _) false)) "February 29 first leap year")
    (assert (match leap ((ok schedule) (= (c/nextFire schedule 68169600) (ok 194400000))) ((err _) false)) "February 29 only in leap years")
    (assert (match (c/parseCron "0 0 32 * *") ((err e) (stringContains? e "day-of-month")) ((ok _) false)) "bad day field reports field")
    (assert (match (c/parseCron "0 0 0 * *") ((err _) true) ((ok _) false)) "day-of-month zero is rejected")
    (assert (match (c/parseCron "0 0 * 0 *") ((err _) true) ((ok _) false)) "month zero is rejected")
    (assert (match (c/parseCron "0 0 30 FEB *") ((ok schedule) (match (c/nextFire schedule 0) ((err _) true) ((ok _) false))) ((err _) false)) "30 February has no fire in five years")
    (assert (match (c/parseCron "0 99 * * *") ((err e) (and (stringContains? e "hour") (stringContains? e "position"))) ((ok _) false)) "bad hour reports field and position")
    (assert (match (c/parseCron "60 * * * *") ((err _) true) ((ok _) false)) "bad minute is rejected")
    (assert (match (c/parseCron "0 0 * SMARCH *") ((err e) (stringContains? e "month")) ((ok _) false)) "bad month name reports field")
    (assert (match (c/parseCron "0 0 * * FUNDAY") ((err e) (stringContains? e "day-of-week")) ((ok _) false)) "bad weekday name reports field")
    (assert (match (c/parseCron "0 0 * * 1/0") ((err e) (stringContains? e "position")) ((ok _) false)) "bad step reports position")
    (assert (match (c/parseCron "0,61 * * * *") ((err e) (stringContains? e "position 2")) ((ok _) false)) "bad later list item reports its position")
    (assert (match (c/parseCron "0 0 * *") ((err _) true) ((ok _) false)) "wrong field count is rejected")
    (assert (match everyMinute ((ok schedule) (match (c/nextFire schedule 0) ((ok n) (> n 0)) ((err _) false))) ((err _) false)) "list and field parsing")
    true)
