(:doc :symbol "asl/packages/asl-sched/src/cron.asl#" :text "Pure UTC five-field cron parsing and bounded next-fire search.")
(:doc :symbol "asl/packages/asl-sched/src/cron.asl#Cron" :text "A parsed five-field expression: minute/hour/day/month/weekday sets plus each day field's wildcard flag")
(:doc :symbol "asl/packages/asl-sched/src/cron.asl#parseCron" :text "Parses a five-field UTC cron expression; Err on an out-of-range or malformed field")
(:doc :symbol "asl/packages/asl-sched/src/cron.asl#nextFire" :text "The next UTC second value strictly after afterSeconds that the expression fires on")
(:doc :symbol "asl/packages/asl-sched/src/interval.asl#" :text "Anchored, pure interval scheduling.")
(:doc :symbol "asl/packages/asl-sched/src/interval.asl#Interval" :text "A fixed-period schedule: everySeconds apart, anchored at startSeconds")
(:doc :symbol "asl/packages/asl-sched/src/interval.asl#interval" :text "Builds an Interval; Err when everySeconds is not positive")
(:doc :symbol "asl/packages/asl-sched/src/interval.asl#intervalValue" :text "Interval's one constructor: everySeconds apart, anchored at startSeconds")
(:doc :symbol "asl/packages/asl-sched/src/interval.asl#intervalNextFire" :text "The next UTC second value strictly after afterSeconds that the interval fires on")
(:doc :symbol "asl/packages/asl-sched/tests/cronTest.asl#" :text "Behaviour checks for cron parsing and UTC next-fire search.")
(:doc :symbol "asl/packages/asl-sched/tests/slotsTest.asl#" :text "Behaviour checks for intervals and persisted claim slots.")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#" :text "Pure persisted-slot claim state transitions.")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#Slot" :text "A due job slot: name, due time, current claim owner/expiry and attempt count")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#ClaimResult" :text "Outcome of slotClaim: claimed, alreadyClaimed, notDue or invalidLease")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#Schedule" :text "A slot's recurrence, either an Interval or a Cron expression")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#intervalSchedule" :text "Schedule's Interval-recurrence constructor")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#cronSchedule" :text "Schedule's Cron-recurrence constructor")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#recoverSlots" :text "Releases claims whose lease has expired by now, leaving unexpired slots unchanged")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#serializeSlot" :text "Renders a Slot as a quoted (:slot ...) ASN string")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#parseSlot" :text "Parses the (:slot ...) ASN string back into a Slot; Err on malformed input")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#slotClaim" :text "Claims a due, unclaimed slot for worker at now with leaseSeconds; invalidLease/notDue/alreadyClaimed otherwise")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#slotComplete" :text "Reschedules a completed slot's next due time from schedule as of completedSeconds")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#slotExpire" :text "Releases value's claim if its lease has expired by now, else returns it unchanged")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#SlotToken.text" :text "Decoded slot token")
(:doc :symbol "asl/packages/asl-sched/src/slots.asl#SlotToken.quoted" :text "Whether the token was ASN quoted")
