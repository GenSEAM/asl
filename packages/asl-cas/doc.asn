(:doc :symbol "asl/packages/asl-cas/src/cas.asl#" :text "Content-addressed blob store: blobs named by sha256 under a two-hex fan-out, atomic writes through tmp and rename, re-hash on read, owner pins with reference counts, grace-period gc")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#Cas" :text "A store: its root directory and the grace period in ms an unpinned blob or a leftover tmp file survives gc")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#BlobStat" :text "Hash, size in bytes and pin count of one stored blob")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#GcReceipt" :text "What one gc did: hashes removed, pinned blobs, unpinned blobs kept for age (young), tmp files removed, and listing, pin-read and removal errors")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#casOpen!" :text "Creates or opens a store at root with blobs, tmp and pins directories; a negative grace is an err")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#validHash?" :text "True for 64 lowercase hex characters, the only names get, pin and stat accept")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#validOwner?" :text "True for a pin owner id of 1 to 128 letters, digits, dot, underscore or dash, not . or ..")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#blobPath" :text "The file path root/blobs/<first two hex>/<hash> of a well-formed hash, none for a malformed one")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#put!" :text "Stores bytes and returns their sha256; an intact copy is kept and its mtime refreshed, a corrupt one replaced; new bytes go through tmp, fsync, rename and a directory fsync")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#putFile!" :text "put! of a file's bytes")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#get!" :text "Reads a blob and re-hashes it: none when absent, a corrupt err when the bytes no longer match the name, an err for a malformed hash")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#has?" :text "True when a well-formed hash names a stored blob")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#stat!" :text "Size and pin count of a stored blob (-1 pins when they cannot be listed), none when absent")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#pin!" :text "Adds an owner's pin marker to a stored blob and returns the reference count after it; pinning twice by one owner counts once")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#unpin!" :text "Removes an owner's pin marker and returns the reference count left")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#pinsOf!" :text "The owner ids pinning a blob: no pin directory is an empty list, a pin directory that cannot be listed is an err")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#gc!" :text "Removes unpinned blobs and tmp files whose mtime is older than the grace period before nowNs; never a pinned blob nor one whose pins cannot be read (reported in :errors); rechecks pins and age before each removal; with pins/ unreadable it removes nothing; returns a GcReceipt")
(:doc :symbol "asl/packages/asl-cas/src/cas.asl#gcWith!" :text "gc! with a hook run between the plan and the removals, where a concurrent pin! or put! may land; a pin! between the final recheck and the removal is not covered (no lock)")
(:doc :symbol "asl/packages/asl-cas/tests/casTest.asl#runTests" :text "put/get by sha256, dedup, corrupt read, atomic write through tmp, pins and grace-period gc, and a 200-step pin/unpin property against a model")
