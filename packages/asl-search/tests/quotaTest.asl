(module aslWebApiSearch/quotaTest :x [testConfigResolution testTransportStrategy testQuotaTelemetry testOpenFirstRouter testHybridMerger runTests] :i [(config :a cfg) (transport :a tr) (quota :a q) (router :a rt) (hybrid :a hyb) (engine :a eng)])

fn testConfigResolution -> Bool
  (let [(defCfg (cfg/makeDefaultSearchConfig))] (assert (= defCfg.openFirstDefault true) "default open-first should be true") (assert (= defCfg.braveKey (none)) "default brave key should be none") (assert (= (cfg/isEngineConfigured? defCfg "brave") false) "default brave should not be configured") (let [(resolved (cfg/resolveSearchConfig (some "brave-xyz") (none) (some "serper-abc") (some "http://localhost:8888") false))] (assert (= resolved.openFirstDefault false) "resolved open-first mismatch") (assert (= (cfg/getEngineKey resolved "brave") (some "brave-xyz")) "brave key retrieval mismatch") (assert (= (cfg/getEngineKey resolved "serper") (some "serper-abc")) "serper key retrieval mismatch") (assert (= (cfg/getEngineKey resolved "tavily") (none)) "tavily key should be none") (assert (= (cfg/getEngineKey resolved "searxng") (some "http://localhost:8888")) "searxng url mismatch") (assert (= (cfg/isEngineConfigured? resolved "brave") true) "resolved brave should be configured") (assert (= (cfg/isEngineConfigured? resolved "tavily") false) "resolved tavily should not be configured") (assert (= (cfg/isEngineConfigured? resolved "serper") true) "resolved serper should be configured") true))

fn testTransportStrategy -> Bool
  (do (assert (= (tr/isCorsRestricted? (tr/browserWebpage)) true) "webpage is cors restricted") (assert (= (tr/isCorsRestricted? (tr/airgapSandbox)) true) "airgap is cors restricted") (assert (= (tr/isCorsRestricted? (tr/desktopHost)) false) "host is not cors restricted") (assert (= (tr/isCorsRestricted? (tr/browserExtension)) false) "extension is not cors restricted") (assert (= (tr/isOfflineTransport? (tr/memoryCacheOnly)) true) "memory-cache-only must be offline") (assert (= (tr/isOfflineTransport? (tr/directCurl)) false) "direct-curl must not be offline") (assert (= (tr/isOfflineTransport? (tr/extensionRelay)) false) "extension-relay must not be offline") (assert (= (tr/resolveRuntimeStrategy (tr/airgapSandbox) false false) (tr/memoryCacheOnly)) "airgap must use memory cache") (assert (= (tr/resolveRuntimeStrategy (tr/desktopHost) false false) (tr/directCurl)) "desktop must use direct curl") (assert (= (tr/resolveRuntimeStrategy (tr/browserExtension) true false) (tr/extensionRelay)) "extension must use relay") (assert (= (tr/resolveRuntimeStrategy (tr/browserWebpage) true false) (tr/extensionRelay)) "webpage with extension must use relay") (assert (= (tr/resolveRuntimeStrategy (tr/browserWebpage) false true) (tr/corsSafeDirect)) "webpage cors-safe must use cors-safe-direct") (assert (= (tr/resolveRuntimeStrategy (tr/browserWebpage) false false) (tr/localDaemonBridge)) "webpage without extension must use daemon bridge") (let [(cmd (tr/buildTransportFetchCmd (tr/directCurl) "https://example.com" (list "Authorization: Bearer test")))] (assert (> (listLength cmd) 3) "curl command vector too short") (assert (= (optionOr (listHead cmd) "") "curl") "curl binary missing")) true)

fn testQuotaTelemetry -> Bool
  (let [(wikiQ (q/inspectEngineQuota "wikipedia" false 0)) (braveOk (q/inspectEngineQuota "brave" true 50)) (braveDepleted (q/inspectEngineQuota "brave" true 0)) (braveNokey (q/inspectEngineQuota "brave" false 100))] (assert (= (q/isQuotaAvailable? wikiQ) true) "open engine wikipedia must be available") (assert (= wikiQ.tier (q/alwaysAvailable)) "wikipedia should be always-available tier") (assert (= (q/isQuotaAvailable? braveOk) true) "brave with quota must be available") (assert (= braveOk.tier (q/keyedFree)) "brave should be keyed-free tier") (assert (= (q/isQuotaAvailable? braveDepleted) false) "depleted brave quota must not be available") (assert (= (q/isQuotaAvailable? braveNokey) false) "keyless brave must not be available") (let [(headers (list "Date: Tue, 08 Sep 2026 00:00:00 GMT" "X-RateLimit-Remaining: 84" "Content-Type: application/json")) (rem (q/parseQuotaHeaders headers))] (assert (= rem 84) "parsed quota remaining mismatch")) (let [(badHeaders (list "Server: nginx" "Content-Type: text/html")) (rem2 (q/parseQuotaHeaders badHeaders))] (assert (= rem2 -1) "missing quota header should return -1")) (let [(directTracker (q/QuotaTracker :quotas (list braveOk wikiQ) :defaultTier (q/alwaysAvailable) :totalRequests 0 :lastUpdated 0))] (assert (= directTracker.totalRequests 0) "direct QuotaTracker record construction should have 0 requests") (assert (= (listLength directTracker.quotas) 2) "direct QuotaTracker should hold registered quotas")) (let [(tracker (q/makeQuotaTracker (list braveOk wikiQ))) (tracked1 (q/trackRequest tracker "brave" 100))] (assert (= tracked1.totalRequests 1) "total requests after 1 track should be 1") (let [(bQuota (optionOr (listHead tracked1.quotas) braveOk))] (assert (= bQuota.remainingQuota 49) "remaining quota should decrement to 49") (assert (= bQuota.isExhausted false) "brave should not be exhausted at 49 requests"))) (let [(trackerDepleting (q/makeQuotaTracker (list (q/inspectEngineQuota "serper" true 1)))) (trackedDep (q/trackRequest trackerDepleting "serper" 200))] (let [(sQuota (optionOr (listHead trackedDep.quotas) (q/inspectEngineQuota "serper" false 0)))] (assert (= sQuota.remainingQuota 0) "remaining quota should reach 0") (assert (= sQuota.isExhausted true) "serper should be exhausted when quota hits 0"))) true)

fn testOpenFirstRouter -> Bool
  (do (assert (= (rt/isOpenEngine? "ddg") true) "ddg is open") (assert (= (rt/isOpenEngine? "wikipedia") true) "wikipedia is open") (assert (= (rt/isOpenEngine? "github") true) "github is open") (assert (= (rt/isOpenEngine? "brave") false) "brave is keyed") (assert (= (rt/isOpenEngine? "tavily") false) "tavily is keyed") (let [(openCascade (rt/selectEngineCascade false true))] (assert (= (optionOr (listHead openCascade) "") "ddg") "standard cascade must start with ddg")) (let [(deepCascade (rt/selectEngineCascade true true))] (assert (= (optionOr (listHead deepCascade) "") "brave") "deep research cascade must start with brave")) (let [(tracker (q/makeQuotaTracker (list (q/inspectEngineQuota "brave" true 100) (q/inspectEngineQuota "ddg" true -1)))) (decOpen (rt/routeSearchQuery "asl agents" (tr/desktopHost) false false tracker))] (assert (= decOpen.selectedEngine "ddg") "open-first should select ddg") (assert (= decOpen.isDeepResearch false) "deep-research should be false")) (let [(tracker2 (q/makeQuotaTracker (list (q/inspectEngineQuota "brave" true 100) (q/inspectEngineQuota "ddg" true -1)))) (decDeep (rt/routeSearchQuery "sub-millisecond wasm sandboxes" (tr/desktopHost) false true tracker2))] (assert (= decDeep.selectedEngine "brave") "deep research with key should select brave") (assert (= decDeep.isDeepResearch true) "deep-research should be true")) (let [(decAirgap (rt/routeSearchQuery "test query" (tr/airgapSandbox) false false (q/makeQuotaTracker (list))))] (assert (= decAirgap.selectedEngine "memory") "airgap must route to memory") (assert (= decAirgap.transport (tr/memoryCacheOnly)) "airgap transport mismatch")) (let [(emptyTracker (q/makeQuotaTracker (list))) (decEmpty (rt/routeSearchQuery "empty tracker query" (tr/desktopHost) false false emptyTracker))] (assert (= decEmpty.selectedEngine "ddg") "empty tracker should default to ddg") (assert (= decEmpty.isDeepResearch false) "empty tracker should have deep-research false")) (let [(exhaustedTracker (q/makeQuotaTracker (list (q/inspectEngineQuota "brave" true 0) (q/inspectEngineQuota "ddg" true -1)))) (decFallback (rt/routeSearchQuery "exhausted query" (tr/desktopHost) false true exhaustedTracker))] (assert (= decFallback.selectedEngine "ddg") "exhausted keyed quota should degrade to ddg") (assert (= decFallback.isDeepResearch false) "deep-research should degrade to false when keyed quotas exhausted")) true)

fn testHybridMerger -> Bool
  (let [(score1 (hyb/calculateRrfScore 1 60)) (score2 (hyb/calculateRrfScore 2 60))] (assert (> score1 0.015) "rrf score 1 too low") (assert (< score1 0.017) "rrf score 1 too high") (assert (> score1 score2) "rrf rank 1 score must exceed rank 2") (let [(res1 (eng/SearchResult :title "ASL 1" :url "https://agentslang.org/docs?utm_source=test" :snippet "docs" :engine "ddg" :score 0.9)) (res2 (eng/SearchResult :title "ASL 1 Dup" :url "https://agentslang.org/docs" :snippet "docs longer" :engine "brave" :score 0.85)) (res3 (eng/SearchResult :title "ASL 2" :url "https://agentslang.org/blog" :snippet "blog" :engine "wikipedia" :score 0.7)) (deduped (hyb/deduplicateSerpResults (list res1 res2 res3)))] (assert (= (listLength deduped) 2) "deduplicated list must contain 2 items")) (let [(streamA (list (eng/SearchResult :title "Title A" :url "https://example.com/a" :snippet "snip a" :engine "ddg" :score 1.0))) (streamB (list (eng/SearchResult :title "Title A Dup" :url "https://example.com/a?ref=test" :snippet "snip a extended" :engine "brave" :score 0.95) (eng/SearchResult :title "Title B" :url "https://example.com/b" :snippet "snip b" :engine "brave" :score 0.8))) (merged (hyb/mergeSerpStreams streamA streamB))] (assert (= (listLength merged) 2) "merged stream must have 2 unique URLs")) (let [(itemLow (eng/SearchResult :title "Low" :url "https://example.com/low" :snippet "low" :engine "ddg" :score 0.01)) (itemHigh (eng/SearchResult :title "High" :url "https://example.com/high" :snippet "high" :engine "brave" :score 0.99)) (itemMid (eng/SearchResult :title "Mid" :url "https://example.com/mid" :snippet "mid" :engine "searxng" :score 0.50)) (ranked (hyb/rankSerpResults (list itemLow itemHigh itemMid))) (firstItem (optionOr (listHead ranked) itemLow)) (lastItem (optionOr (listHead (listDrop ranked 2)) itemHigh))] (assert (= (listLength ranked) 3) "ranked results count should be 3") (assert (= firstItem.title "High") "highest scoring item must be first") (assert (= lastItem.title "Low") "lowest scoring item must be last")) true)

fn runTests -> Bool
  (and (testConfigResolution) (testTransportStrategy) (testQuotaTelemetry) (testOpenFirstRouter) (testHybridMerger))
