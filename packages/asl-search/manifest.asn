(:package aslSearch
 :version "0.1.0"
 :entry "src/engine.asl"
 :description "AgentSlang Multi-Engine Web Search, Quota Router, and Ecosystem Provider Aggregator"
 :aslFirst true
 :modules [
   "aslWebApiSearch/config"
   "aslWebApiSearch/ecosystems"
   "aslWebApiSearch/engine"
   "aslWebApiSearch/hybrid"
   "aslWebApiSearch/quota"
   "aslWebApiSearch/router"
   "aslWebApiSearch/transport"
   "aslWebApiSearch/research"
   "aslWebApiSearch/commonCrawl"
   "aslWebApiSearch/commonCrawlCli"
 ]
 :dependencies ["asl-zip"])
