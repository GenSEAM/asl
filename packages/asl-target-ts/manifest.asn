(:package asl-target-ts
 :version "0.1.0"
 :entry "src/emitTs.asl"
 :description "Superseded: AST-level TypeScript emitter kept for its tests; TypeScript support is asl-target-js (JavaScript from asl-ir) with generated .d.mts declarations"
 :layer 0
 :aslFirst true
 :modules [
   "asl-target-ts/types"
   "asl-target-ts/tsAst"
   "asl-target-ts/emitTs"
   "asl-target-ts/runTs"
 ]
 :dependencies ["asl-parser"]
 :capabilities ["codegen/target"]
 :owner "principal")
