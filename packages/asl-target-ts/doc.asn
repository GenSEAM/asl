(:doc :symbol "asl/packages/asl-target-ts/src/emitTs.asl#" :text "Pure ASL TypeScript source emitter and AST lowering engine.")
(:doc :symbol "asl/packages/asl-target-ts/src/emitTs.asl#emitTsDefun" :text "Public single-argument entry point kept for callers with no enum context to bind against.")
(:doc :symbol "asl/packages/asl-target-ts/src/emitTs.asl#lookupCaseFields" :text "a match arm's constructor pattern names its own local bindings; the real order comes from the enum case's declared fields")
(:doc :symbol "asl/packages/asl-target-ts/src/emitTs.asl#emitTsMtArms" :text "a match with no arm left has type never, not undefined, so it never widens a fully-covered enum's return type")
(:doc :symbol "asl/packages/asl-target-ts/src/emitTs.asl#vectItems" :text "the reader lowers a [ ] vector into a list headed by the atom list; strip that marker before reading params")
(:doc :symbol "asl/packages/asl-target-ts/src/emitTs.asl#buildCaseFieldCtx" :text "one pass over the module's typed enum declarations builds the tag-to-field-name table match binding needs")
(:doc :symbol "asl/packages/asl-target-ts/src/emitTs.asl#mainEntrySnippet" :text "a Result-returning main sets the process exit code from ok/err; the corpus oracle is asl-host run, which does the same")
(:doc :symbol "asl/packages/asl-target-ts/src/runTs.asl#" :text "TypeScript target compilation and execution runner")
(:doc :symbol "asl/packages/asl-target-ts/src/runTs.asl#runTsCode" :text "Type-check and run emitted TypeScript code via node")
(:doc :symbol "asl/packages/asl-target-ts/src/runTs.asl#compileAndRunTs" :text "Parse ASL source, emit TypeScript module, and execute")
(:doc :symbol "asl/packages/asl-target-ts/src/tsAst.asl#" :text "Pure in-memory TsAst hierarchy ensuring tree-to-tree lowering for TypeScript emission.")
(:doc :symbol "asl/packages/asl-target-ts/src/types.asl#" :text "Pure ASL TypeScript type lowering, keyword mangling, and runtime helpers.")
(:doc :symbol "asl/packages/asl-target-ts/src/types.asl#isDigitChar?" :text "Int64 literals must render as bigint, the only numeric form used for Int64, or tsc rejects mixing them with plain number literals")
