(module aslPack/targets/swift :x [SwiftPackageSpec SwiftAppSpec generatePackageSwift generateCBridgeHeader generateXcframeworkScript generateSwiftuiEntrypoint generateSwiftObservableStore] :i [])

(schema SwiftPackageSpec (:f pkgName Str) (:f iosMinVersion Str) (:f macosMinVersion Str) (:f cBridgeHeader Str))

(schema SwiftAppSpec (:f appName Str) (:f bundleId Str) (:f iosMinVersion Str) (:f packageName Str))

fn generateCBridgeHeader pkgName: Str -> Str
  (str "// Auto-generated by asl-pack for " pkgName "\n" "#ifndef ASL_BRIDGE_H\n" "#define ASL_BRIDGE_H\n\n" "#include <stdint.h>\n" "#include <stddef.h>\n\n" "#ifdef __cplusplus\n" "extern \"C\" {\n" "#endif\n\n" "typedef struct {\n" "    const uint8_t *data;\n" "    size_t length;\n" "} ASLByteBuffer;\n\n" "int32_t asl_init(void);\n" "ASLByteBuffer asl_eval(const char *module_name, const uint8_t *input_asn, size_t input_len);\n" "void asl_free_buffer(ASLByteBuffer buf);\n\n" "#ifdef __cplusplus\n" "}\n" "#endif\n\n" "#endif // ASL_BRIDGE_H\n")

fn generatePackageSwift spec: SwiftPackageSpec -> Str
  (let [(name spec.pkgName) (hdr spec.cBridgeHeader)] (str "// swift-tools-version: 5.9\n" "import PackageDescription\n\n" "let package = Package(\n" "    name: \"" name "\",\n" "    platforms: [.iOS(." spec.iosMinVersion "), .macOS(." spec.macosMinVersion ")],\n" "    products: [\n" "        .library(name: \"" name "\", targets: [\"" name "\"])\n" "    ],\n" "    targets: [\n" "        .target(\n" "            name: \"" name "\",\n" "            publicHeadersPath: \"include\",\n" "            cSettings: [.headerSearchPath(\"include\")]\n" "        )\n" "    ]\n" ")\n"))

fn generateXcframeworkScript pkgName: Str outDir: Str -> Str
  (str "#!/usr/bin/env bash\n" "set -euo pipefail\n" "echo \"Building " pkgName " multi-arch XCFramework in " outDir "...\"\n" "xcodebuild archive -scheme " pkgName " -destination \"generic/platform=iOS\" -archivePath \"" outDir "/ios.xcarchive\" SKIP_INSTALL=NO BUILD_LIBRARY_FOR_DISTRIBUTION=YES\n" "xcodebuild archive -scheme " pkgName " -destination \"generic/platform=iOS Simulator\" -archivePath \"" outDir "/ios-sim.xcarchive\" SKIP_INSTALL=NO BUILD_LIBRARY_FOR_DISTRIBUTION=YES\n" "xcodebuild -create-xcframework \\\n" "    -framework \"" outDir "/ios.xcarchive/Products/Library/Frameworks/" pkgName ".framework\" \\\n" "    -framework \"" outDir "/ios-sim.xcarchive/Products/Library/Frameworks/" pkgName ".framework\" \\\n" "    -output \"" outDir "/" pkgName ".xcframework\"\n" "echo \"XCFramework created successfully at " outDir "/" pkgName ".xcframework\"\n")

fn generateSwiftuiEntrypoint appName: Str -> Str
  (str "// Auto-generated by asl-pack for " appName "\n" "import SwiftUI\n\n" "@main\n" "struct " appName "App: App {\n" "    @State private var store = ASLStateStore()\n\n" "    var body: some Scene {\n" "        WindowGroup {\n" "            ContentView()\n" "                .environment(store)\n" "        }\n" "    }\n" "}\n")

fn generateSwiftObservableStore storeName: Str -> Str
  (str "// Auto-generated by asl-pack for " storeName "\n" "import SwiftUI\n" "import Observation\n\n" "@Observable\n" "public final class " storeName " {\n" "    public var statePayload: String = \"{}\"\n" "    public var isEvaluating: Bool = false\n\n" "    public init() {}\n\n" "    public func dispatchAction(moduleName: String, actionPayload: String) {\n" "        self.isEvaluating = true\n" "        let rawBytes = [UInt8](actionPayload.utf8)\n" "        let resultBuf = asl_eval(moduleName, rawBytes, rawBytes.count)\n" "        if let data = resultBuf.data {\n" "            self.statePayload = String(decoding: UnsafeBufferPointer(start: data, count: resultBuf.length), as: UTF8.self)\n" "            asl_free_buffer(resultBuf)\n" "        }\n" "        self.isEvaluating = false\n" "    }\n" "}\n")
