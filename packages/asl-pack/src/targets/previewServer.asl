(module aslPack/targets/previewServer :x [PreviewServerSpec makePreviewServerSpec formatHotReloadPatchFrame generatePreviewServerScript] :i [(asl-transpile/asn :a asn)])

fn int-to-string n: Int64 -> Str
  (stringFromInt64 n)

(schema PreviewServerSpec (:f port Int64) (:f heartbeatMs Int64) (:f watchDir Str))

fn makePreviewServerSpec port: Int64 watchDir: Str -> PreviewServerSpec
  (PreviewServerSpec :port port :heartbeatMs 30000 :watchDir watchDir)

fn formatHotReloadPatchFrame targetScreen: Str htmlPayload: Str -> Str
  (str "{\"type\":\"patch\",\"screen\":" (asn/asnWrite (asn/asnStr targetScreen)) ",\"html\":" (asn/asnWrite (asn/asnStr htmlPayload)) "}")

fn generatePreviewServerScript spec: PreviewServerSpec -> Str
  (let [(pStr (int-to-string spec.port)) (wDir spec.watchDir)] (str "// Auto-generated by asl-pack mobile preview server\n" "const http = require('http');\n" "const fs = require('fs');\n" "const path = require('path');\n" "const PORT = " pStr ";\n" "const server = http.createServer((req, res) => {\n" "  const urlPath = req.url.split('?')[0].split('#')[0];\n" "  const file = urlPath === '/' ? 'mobile_preview.html' : urlPath.slice(1);\n" "  const scratchDir = path.resolve(process.cwd(), 'scratch');\n" "  const filePath = path.resolve(scratchDir, file);\n" "  if (!filePath.startsWith(scratchDir + path.sep) && filePath !== scratchDir) {\n" "    res.writeHead(403);\n" "    res.end('Forbidden');\n" "    return;\n" "  }\n" "  if (fs.existsSync(filePath)) {\n" "    res.writeHead(200, { 'Content-Type': file.endsWith('.html') ? 'text/html' : 'text/plain' });\n" "    fs.createReadStream(filePath).pipe(res);\n" "  } else {\n" "    res.writeHead(404);\n" "    res.end('Not Found');\n" "  }\n" "});\n" "server.listen(PORT, () => console.log(`ASL Mobile Preview Server active at http://localhost:${PORT}`));\n"))
