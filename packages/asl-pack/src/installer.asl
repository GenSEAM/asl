(module aslPack/installer :x [SlashCommandSpec AgentPlatform InstallerConfig InstallationPlan formatToolbeltDirective formatSlashAsl formatSlashAslBuild makeAgentPlatform defaultAgentPlatforms makeInstallerConfig sanitizeInstructionText injectInstructionDirective planAgentInstallation emitStandaloneInstallerScript generateFullInstallScript] :i [(platform :a plat)])

(schema SlashCommandSpec (:f name Str) (:f commandTrigger Str) (:f description Str) (:f content Str))

(schema AgentPlatform (:f id Str) (:f name Str) (:f detected Bool) (:f skillsDirs (List Str)) (:f rulesFiles (List Str)) (:f commandsDirs (List Str)))

(schema InstallerConfig (:f isGlobal Bool) (:f force Bool) (:f injectInstructions Bool) (:f agentFilter Str))

(schema InstallationPlan (:f detectedAgents (List AgentPlatform)) (:f targetRuleFiles (List Str)) (:f targetSkillsDirs (List Str)) (:f slashCommands (List SlashCommandSpec)))

fn formatToolbeltDirective -> Str
  (str "<!-- ASL_TOOLBELT_START -->\n" "# AgentScript (ASL) Universal Toolbelt\n\n" "When `asl` is available on the host system, agents can execute high-speed, token-efficient workspace operations via `asl '(<form1> <form2> ...)'`:\n\n" "- **Introspect Tool Schemas**: `asl '(:tools)'` — returns the authoritative machine-readable catalog of operational Pure-ASN S-expressions.\n" "- **Fast Semantic & Symbol Search**: `asl '(:query \"symbolName\")'` — sub-15ms BM25 and symbol index search across the codebase.\n" "- **Targeted Reading**: `asl '(:read :file \"path/to/file.ext\" :symbol \"funcName\")'` — bounded AST slice retrieval without whole-file dumping.\n" "- **Safe Staged Editing**:\n" "  - `asl '(:edit :file \"path/to/file.ext\" :old \"exactOldString\" :new \"exactNewString\")'` — stage changes in RAM VFS buffer.\n" "  - `asl '(:diff)'` — inspect dirty RAM buffer diffs prior to disk commit.\n" "  - `asl '(:flush)'` — atomically persist staged modifications to disk with fsync and rename.\n" "  - `asl '(:discard)'` — clear all pending staged modifications without disk side effects.\n" "- **Daemon & Process Supervision**: `asl '(:manage :action <:spawn|:poll|:tail|:kill|:list> :id \"taskId\" ...)'` (or alias `(:proc ...)`).\n" "- **Multi-Lens Code Audit**: `asl '(:lens :file \"path\" :lenses (\"invariants\" \"architecture\"))'`\n" "- **Web Distillation & Research**:\n" "  - `asl '(:crawl :url \"https://...\" :distill :asn)'` — crawl and distill web DOM directly to dense ASN.\n" "  - `asl '(:search :query \"query\" :limit 5)'` — cognitive web search.\n" "  - `asl '(:research :topic \"topic\" :depth 2)'` — multi-depth research inquiry.\n" "- **Compound Batching**: Multiple forms execute concurrently in one roundtrip: `asl '(:query \"foo\") (:read :file \"bar.ts\")'`.\n\n" "<!-- ASL_TOOLBELT_END -->")

fn formatSlashAsl -> Str
  (str "---\n" "description: Activate AgentScript (ASL) toolchain\n" "---\n\n" "# /asl: Activate Native ASL Toolchain\n\n" "Execute all searches, inspections, edits, and verifications via `asl '<form1> <form2> ...'`:\n" "- **Implicit Parallel Batches**: Multiple top-level forms execute concurrently in RAM VFS buffers by default without `:batch` wrappers.\n" "- **Query & Bounded Read**: `(:query \"text\")`, `(:read :file \"path\" :symbol \"name\")`, `(:doc :file \"f\" :section \"s\")`.\n" "- **Memory Staging & Edit**: `(:edit :file \"f\" :old \"o\" :new \"n\")`, `(:diff)`, `(:flush)`, `(:discard)`.\n" "- **Verification & Gate**: `(:check)`, `(:test)`, `(:doctor)`, `(:gate :id \"g\")`, `(:audit :subcmd :consistency)`.\n" "- **Daemon Supervision**: `(:manage :action :spawn ...)` / `(:manage :action :poll ...)`.\n" "- **Web & Epistemic Research**: `(:search :query \"...\")`, `(:crawl :url \"...\")`, `(:research :topic \"...\")`.\n")

fn formatSlashAslBuild -> Str
  (str "---\n" "description: Activate ASL build, polyglot tooling, and verification mode (/asl build)\n" "---\n\n" "# /asl build: Activate ASL Native Build & Toolbelt Mode\n\n" "Full activation of the native AgentScript (ASL) toolchain:\n\n" "## 1. Direct ASN Form Execution & Implicit Batching\n" "All code exploration, reading, text search, editing, diffing, and verification runs directly through pure ASN forms:\n" "```bash\n" "asl '(:query \"handleRequest\")'\n" "asl '(:read :file \"src/server.ts\" :symbol \"handleRequest\")'\n" "asl '(:check)'\n" "```\n\n" "## 2. Polyglot Language Support\n" "Supported source extensions: `.asl`, `.asn`, `.ts`, `.tsx`, `.js`, `.jsx`, `.py`, `.go`, `.rs`, `.php`, `.md`.\n" "- Never call whole-file View/cat on files exceeding 50 lines. Use targeted `(:read :file ... :symbol ...)` first.\n" "- Always check callers and impact radius before changing functions or interfaces.\n\n" "## 3. Fast Text & Vector Search\n" "- Exact symbol & BM25 query: `(:query \"pattern\")` (in-memory, <15ms, zero disk thrashing).\n" "- Web distillation & research: `(:crawl :url \"...\")` or `(:search :query \"...\")`.\n\n" "## 4. Build, Compilation & Verification\n" "- Compile: `asl build <file.asl> --target <wasm|c>`\n" "- Verify syntax & balance: `asl check <file>`\n" "- AST quality & token lint: `asl lint <file>`\n" "- 3-tier audit: `asl audit <file>` (Micro AST, Meso keywords, Macro module)\n" "- Native tests: `asl test [file]`\n" "- Full 7 gates: `asl gate` or `asl '(:check)'`\n")

fn makeAgentPlatform id: Str name: Str detected: Bool skills: (List Str) rules: (List Str) cmds: (List Str) -> AgentPlatform
  (AgentPlatform :id id :name name :detected detected :skillsDirs skills :rulesFiles rules :commandsDirs cmds)

fn defaultAgentPlatforms home: Str -> (List AgentPlatform)
  (list (makeAgentPlatform "claude" "Claude Code" true (list (str home "/.claude/skills")) (list (str home "/.claude/CLAUDE.md")) (list (str home "/.claude/commands"))) (makeAgentPlatform "cursor" "Cursor" true (list (str home "/.cursor/skills")) (list (str home "/.cursorrules") (str home "/.cursor/rules/asl-toolbelt.mdc")) (list)) (makeAgentPlatform "windsurf" "Windsurf" true (list (str home "/.codeium/windsurf/skills")) (list (str home "/.codeium/windsurf/rules/asl-toolbelt.md")) (list)) (makeAgentPlatform "agy" "agy (Antigravity CLI)" true (list (str home "/.gemini/config/skills") (str home "/.gemini/skills")) (list (str home "/.gemini/config/rules/asl-toolbelt.md")) (list)) (makeAgentPlatform "factory" "Factory Droid" true (list (str home "/.factory/skills")) (list (str home "/.factory/AGENTS.md")) (list)) (makeAgentPlatform "agents" "Universal Agents Standard (~/.agents)" true (list (str home "/.agents/skills")) (list (str home "/.agents/rules/asl-toolbelt.md")) (list)) (makeAgentPlatform "codex" "Codex / OpenAI" true (list (str home "/.codex/skills")) (list (str home "/.codex/AGENTS.md")) (list)))

fn makeInstallerConfig isGlobal: Bool force: Bool injectInstructions: Bool agentFilter: Str -> InstallerConfig
  (InstallerConfig :isGlobal isGlobal :force force :injectInstructions injectInstructions :agentFilter agentFilter)

fn sanitizeInstructionText content: Str -> Str
  (formatToolbeltDirective)

fn injectInstructionDirective content: Str -> Str
  (str (formatToolbeltDirective) "\n")

fn planAgentInstallation cfg: InstallerConfig platforms: (List AgentPlatform) -> InstallationPlan
  (let [(cmdAsl (SlashCommandSpec :name "asl.md" :commandTrigger "/asl" :description "Activate AgentScript (ASL) toolchain" :content (formatSlashAsl))) (cmdBuild (SlashCommandSpec :name "asl-build.md" :commandTrigger "/asl build" :description "Activate ASL build and toolbelt mode" :content (formatSlashAslBuild))) (cmds (list cmdAsl cmdBuild)) (ruleFiles (fold (fn [(acc (List Str)) (p AgentPlatform)] -> (List Str) (if cfg.injectInstructions (listAppend acc p.rulesFiles) acc)) (list) platforms)) (skillsDirs (fold (fn [(acc (List Str)) (p AgentPlatform)] -> (List Str) (listAppend acc p.skillsDirs)) (list) platforms))] (InstallationPlan :detectedAgents platforms :targetRuleFiles ruleFiles :targetSkillsDirs skillsDirs :slashCommands cmds))

fn emitStandaloneInstallerScript cfg: InstallerConfig -> Str
  (str "#!/bin/bash\n" "# AgentScript (ASL) Multi-Agent Skills & Toolbelt Installer\n" "# Generated from pure AgentScript module: asl/packages/asl-pack/src/installer.asl\n" "set -eo pipefail\n\n" "echo \"[INSTALL] Running pure AgentScript Multi-Agent Skills Setup...\";\n" "WORKSPACE_ROOT=\"$(pwd)\"\n" "HOME_DIR=\"${HOME}\"\n\n" "TOOLBELT_DIRECTIVE=\"" (formatToolbeltDirective) "\"\n\n" "# Local instructions injection\n" "for F in \"$WORKSPACE_ROOT/AGENTS.md\" \"$WORKSPACE_ROOT/.cursorrules\"; do\n" "  if [ ! -f \"$F\" ]; then\n" "    cat << 'EOF' > \"$F\"\n" (formatToolbeltDirective) "\n" "EOF\n" "    echo \"[OK] Created $F\"\n" "  else\n" "    echo \"[SKIP] $F already exists\"\n" "  fi\n" "done\n\n" "# Purge leaked workflow stubs from agent homes\n" "for D in \"$HOME_DIR/.claude/skills\" \"$HOME_DIR/.cursor/skills\" \"$HOME_DIR/.codex/skills\" \"$HOME_DIR/.codeium/windsurf/skills\"; do\n" "  for S in impl imple steps steps-implement steps-plan steps-review plan-verifier orchestration watch; do\n" "    rm -rf \"$D/$S\" 2>/dev/null || true\n" "  done\n" "done\n\n" "echo \"[OK] Setup complete via pure ASL installer.\";\n")

fn generateFullInstallScript -> Str
  (let [(shebang "#!/bin/bash\n# AgentScript Universal Installer (Pre-built Binaries + Source Fallback + Agent Toolbelt Setup)\n# Canonical URL: https://aslang.dev/install.sh\n# Usage: curl -fsSL https://aslang.dev/install.sh | bash\nset -eo pipefail\n\n")
        (rulesHeader "RULES_ROOT=\"$(cd -P \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n\n# ---- rules single source of truth: asl/grammar/rules.asn -> every exported surface ----\nrules_main() {\n  local MODE=\"$1\"\n  local RULES_SRC=\"$RULES_ROOT/asl/grammar/rules.asn\"\n}\n")
        (toolbeltDir (formatToolbeltDirective))
        (agentsConf "# Multi-Agent Toolbelt Setup\n")]
    (str shebang rulesHeader "# Toolbelt Directive\nTOOLBELT_DIRECTIVE=\"" toolbeltDir "\"\n\n" agentsConf))
