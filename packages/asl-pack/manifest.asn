(:package asl-pack
 :version "0.1.0"
 :entry "src/pack.asl"
 :description "Universal cross-platform packager and runtime runner for AgentScript"
 :aslFirst true
 :modules [
   "asl-pack/dist"
   "asl-pack/ffi-linker"
   "asl-pack/installer"
   "asl-pack/pack"
   "asl-pack/platform"
   "asl-pack/release"
   "asl-pack/runtime"
   "asl-pack/standalone"
   "asl-pack/targets/kotlin"
   "asl-pack/targets/preview"
   "asl-pack/targets/preview-server"
   "asl-pack/targets/swift"
 ]
 :dependencies ["asl-codec" "asl-sh"])
