(:package asl-pack
 :version "0.1.0"
 :entry "src/pack.asl"
 :description "Universal cross-platform packager and runtime runner for AgentScript"
 :aslFirst true
 :modules [
   "aslPack/buildGraph"
   "aslPack/packageAsl"
   "aslPack/targetAdapter"
   "aslPack/packaging"
   "aslPack/distributionProfiles"
   "aslPack/dist"
   "aslPack/ffiLinker"
   "aslPack/installer"
   "aslPack/pack"
   "aslPack/platform"
   "aslPack/release"
   "aslPack/runtime"
   "aslPack/standalone"
   "aslPack/targets/kotlin"
   "aslPack/targets/preview"
   "aslPack/targets/previewServer"
   "aslPack/targets/swift"
   "aslPack/intermediatePolicy"
 ]
 :dependencies ["asl-transpile" "asl-proc"])
