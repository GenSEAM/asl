(:package asl-pack
 :version "0.1.0"
 :entry "src/pack.asl"
 :description "Universal cross-platform packager and runtime runner for AgentSlang (the build-graph, package-manifest, OS-packaging and target-adapter modules this package once also held were deleted in DEAD-PACKAGES/ba298292c as dead; these nine src modules and four mobile targets remain live, imported by tests/acceptance/d81/Task51003.asl, tests/acceptance/d81/Task51004.asl, tests/acceptance/d81/Task58801IntermediatePolicyTest.asl, tests/conformance/audit/multiLensRemediationTest.asl, asl/packages/asl-target-llvm/tests/nativeRtGapsTest.asl and asl/packages/asl-pack/tests/*)"
 :aslFirst true
 :modules [
   "aslPack/dist"
   "aslPack/ffiLinker"
   "aslPack/installer"
   "aslPack/intermediatePolicy"
   "aslPack/pack"
   "aslPack/pkgCli"
   "aslPack/pkgIndex"
   "aslPack/pkgStore"
   "aslPack/platform"
   "aslPack/release"
   "aslPack/runtime"
   "aslPack/standalone"
   "aslPack/targets/kotlin"
   "aslPack/targets/preview"
   "aslPack/targets/previewServer"
   "aslPack/targets/swift"
 ]
 :dependencies ["asl-transpile" "asl-proc" "asl-parser"])
