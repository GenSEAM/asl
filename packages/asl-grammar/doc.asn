(:doc :symbol "asl/packages/asl-grammar/src/asn.asl#" :text "Bootstrap reader for the ASN subset that grammar and corpus files use: lists, vectors, keywords, symbols, strings and integers; ; comments and commas are whitespace.")
(:doc :symbol "asl/packages/asl-grammar/src/asn.asl#asnReadAll" :text "Every top-level datum of the text, or the first read error with its byte offset.")
(:doc :symbol "asl/packages/asl-grammar/src/asn.asl#asnKeyValue" :text "The element after the keyword :key in a form's items, none when the key is absent or last.")
(:doc :symbol "asl/packages/asl-grammar/src/asn.asl#asnKeyString" :text "The string or symbol after :key, none otherwise.")
(:doc :symbol "asl/packages/asl-grammar/src/gbnf.asl#" :text "Generates a GBNF grammar (llama.cpp grammars/README.md, read 2026-10-08) from a loaded grammar. GBNF has no lookahead, so not and and drop out and ordered choice becomes union: the result accepts every text the recognizer accepts.")
(:doc :symbol "asl/packages/asl-grammar/src/gbnf.asl#gbnfRuleName" :text "A rule name as GBNF wants it, a dashed lowercase word: atomChar becomes atom-char.")
(:doc :symbol "asl/packages/asl-grammar/src/gbnf.asl#grammarGbnfFrom" :text "GBNF for the rules start reaches: root names start, one line per rule, and an except rule as a trie of the names it leaves out.")
(:doc :symbol "asl/packages/asl-grammar/src/gbnf.asl#grammarGbnf" :text "GBNF for the grammar's start rule.")
(:doc :symbol "asl/packages/asl-grammar/src/gbnf.asl#main" :text "Writes hostExact.gbnf (start file) and generation.gbnf (start genFile) for the grammar file (first argument, default asl/grammar/aslGrammar.asn) into the directory given second, default ~/.asl/run/grammar; generated, never tracked.")
(:doc :symbol "asl/packages/asl-grammar/src/gbnf.asl#wordShape" :text "trie needs a first-class, rest-class name rule")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#" :text "Loads a grammar written as ASN rules (asl/grammar/aslGrammar.asn) and recognizes text with it: rule bodies compile to a PEG over bytes, and one generic matcher runs every rule, so no rule is hand-coded here.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#GrammarRule.name" :text "Rule name")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#GrammarRule.expr" :text "Rule body as written in the grammar file")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#GrammarRule.doc" :text "The rule's :d text")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#Grammar.name" :text "Grammar name")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#Grammar.start" :text "Start rule")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#Grammar.boundary" :text "Rule a (word s) literal must not be followed by")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#Grammar.rules" :text "Rules in file order")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#Grammar.table" :text "Compiled recursive rules")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#Grammar.entry" :text "Compiled start rule")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#Ctx.rules" :text "Rules in file order")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#Ctx.names" :text "Rule names in file order")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#Ctx.recursive" :text "Whether each rule reaches itself")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#Ctx.boundary" :text "Word boundary rule")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#classRanges" :text "The byte ranges a class spec names: a-z is a range, any other byte stands for itself.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#grammarBuild" :text "Compiles rules into a recognizer: rules that reach themselves stay references, all others are inlined; an unknown rule name, a duplicate or a malformed form is an error.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#grammarParse" :text "A grammar from the text of a (:grammar :name n :start rule :wordBoundary rule :rules [(:rule ...) ...]) file.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#grammarLoad!" :text "The grammar in the file at path.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#grammarRecognize" :text "ok with the text's byte length when the start rule matches all of it; err line:col of the furthest failure otherwise.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#grammarAccepts?" :text "Whether the grammar's start rule matches the whole text.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#grammarRuleNames" :text "Rule names in file order.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#grammarDisable" :text "The grammar with one rule's body replaced by a choice of nothing, so the rule never matches: a mutant for coverage tests.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#grammarRemove" :text "The grammar without one rule; compiling fails when another rule still names it.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#grammarWithStart" :text "The same rules recognizing from another start rule.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#grammarReachable" :text "The rules start reaches, start first, then in file order.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#grammarSalvage" :text "text when the start rule accepts it, else its longest prefix that ends at a line break before a column-0 line and is accepted: the contract for a generation cut at max_tokens, which drops the unfinished item instead of guessing closers.")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#starAt" :text "greedy loop; far tracks the furthest failure")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#repAt" :text "greedy up to most; fewer than least fails")
(:doc :symbol "asl/packages/asl-grammar/src/peg.asl#pm" :text "end and furthest failure packed in one Int64")
(:doc :symbol "asl/packages/asl-grammar/src/salvage.asl#" :text "Closing contract for a constrained generation cut at max_tokens: keep the longest prefix of whole column-0 items the generation start rule accepts, never guessed closers.")
(:doc :symbol "asl/packages/asl-grammar/src/salvage.asl#main" :text "Reads the text at the first argument and writes its salvage to the second, under start genFile of the grammar file given third (default asl/grammar/aslGrammar.asn); err when no prefix is accepted.")
(:doc :symbol "asl/packages/asl-grammar/src/sample.asl#" :text "Random texts derived from a grammar read as a context-free grammar, as GBNF reads it: not, and and end derive nothing, every alt branch is open. Past a depth budget each choice takes its shallowest branch, so derivation ends. Used to check that a start rule only derives texts asl-host check accepts.")
(:doc :symbol "asl/packages/asl-grammar/src/sample.asl#Gen.text" :text "Text derived so far, in reverse pieces joined at the end")
(:doc :symbol "asl/packages/asl-grammar/src/sample.asl#Gen.seed" :text "Random state")
(:doc :symbol "asl/packages/asl-grammar/src/sample.asl#ruleHeights" :text "Each rule's shallowest derivation depth in rule references, by fixed-point iteration.")
(:doc :symbol "asl/packages/asl-grammar/src/sample.asl#grammarSample" :text "count texts derived from start with the given seed; budget is the rule-reference depth after which choices go shallowest.")
(:doc :symbol "asl/packages/asl-grammar/src/sample.asl#derive" :text "past budget, every choice takes its shallowest branch")
