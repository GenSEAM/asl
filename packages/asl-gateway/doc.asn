(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#tierName" :text "tier as its config word")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modeName" :text "mode as its config word")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#windowMsOf" :text "hour, 5h, day, week or month (30 days) in ms")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#tierAdmitted?" :text "whether a mode admits a tier")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#defaultPolicy" :text "balanced, explore every 20th request, softFactor 100 permille")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#makeBalancer" :text "builds a Balancer, indexing budgets by id")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#windowStart" :text "start of the window holding nowMs on the budget's anchor grid")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#budgetUsed" :text "usage of a budget in the current window, 0 when the stored window is older")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#hardCap" :text "size x hard percent: a pick that would pass it is refused")
