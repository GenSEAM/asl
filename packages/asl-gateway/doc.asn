(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#telemetryLogPath" :text "TELEMETRY_LOG_PATH from env, cwd and argv0")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#appendFile!" :text "appends text under a flock on path through fileAppend's O_APPEND open, never reading the file; a busy lock is retried tries times 5 ms apart")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#logTelemetryEvent!" :text "log_telemetry_event; failures returned, not dropped")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#urlPrep" :text "urlsplit prep: lstrip C0, drop tabs, newlines")
