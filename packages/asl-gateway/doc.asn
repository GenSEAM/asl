(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewaySecretsFileChoice" :text "strict form of gatewaySecretsFileOverride for serve: ok none when the key is absent or the text empty, ok some path when set, err ERR_SECRETS_CONFIG when the text does not parse or :secretsFile is not a non-empty string")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#keyFilesEnvOverlay!" :text "sets each provider keyEnv to the value the config's :keyFiles files hold, the file winning over the env; never prints a value")
