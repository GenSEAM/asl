(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#replay" :text "routes and charges a request list in order; deterministic for a fake clock")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#budgetRows" :text "one report row per budget at nowMs")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#budgetRowLine" :text "a BudgetRow as one (:budgetRow ...) ASN line")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#blockingBudgets" :text "ids of the budgets that keep the mode's admitted models from fitting a request, each once")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#Pool" :text "the balancer as dispatch holds it: balancer, window usage, alias to (provider, upstream model name), and the count of charged requests")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#loadPool!" :text "GW-BALANCER-WIRE: none without a (:balancer ...) section; else reads CAL files (:cal, default .asl/mem/work/CAL/freeModels.asn and .asl/mem/work/SH/workerStats.asn graded runs, a missing file is skipped), keeps only models whose provider dispatch can send to, and rebuilds usage from the shared call ledger (:ledger, else the config override, else HOME's); a read error of an existing CAL file or the ledger is an error")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolFromParts" :text "builds a Pool from a balancer, usage and targets, dropping models without a target")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolRequest" :text "the balancer Request for a dispatch: next sequence number, intent (any when empty), expected tokens")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolPick" :text "the dispatch pick: bl/pick over the pool http lanes and current usage, never a cli or gateway lane")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolTarget" :text "provider and upstream model name of a pool alias")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolCharge" :text "charges one request of a pool alias to its windows and advances the sequence; other ids leave the pool unchanged")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#pickWhy" :text "the pick's score parts as one (:balancer ...) form for the route receipt")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#refusalText" :text "the 429 reason: (:balancer :refused :mode M :budgets (ids) :reason text)")
(:doc :symbol "asl/packages/asl-gateway/src/dispatch.asl#settledConsumed" :text "clears the pool alias the last settle recorded, once the usage row has been written")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolFailed" :text "GW-BALANCER-CASCADE: rests a pool alias until nowMs + cooldownMs (balancer :failCooldownMs, default 60000) after a failed call, so poolPick skips it unless every model rests")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#Observed" :text "GW-BALANCER-LIVE-QUOTA: what a provider reported for one budget: remaining in the budget unit, reset time (0 unknown), when it was seen, and whether a 429 exhausted it")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#RateObs" :text "one rate-limit header reading: unit req|tok, remaining, absolute reset ms (0 unknown)")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseDurationMs" :text "reads OpenAI/Groq reset durations (1s, 6m0s, 2m59.56s, 120ms, 1h2m3s) and bare seconds into ms")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseRfc3339Ms" :text "reads a UTC RFC 3339 time (Z or +00:00, optional fraction) into epoch ms; other offsets are none")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseRateHeaders" :text "rate-limit rows from x-ratelimit-remaining/reset-requests|tokens (OpenAI, Groq) or anthropic-ratelimit-requests|tokens-remaining/reset, header names case-insensitive")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#retryAfterMs" :text "the Retry-After delay in ms: delay-seconds, or an IMF-fixdate HTTP-date taken against nowMs, a past date being 0")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseHttpDateMs" :text "an IMF-fixdate (Wed, 21 Oct 2015 07:28:00 GMT) as epoch ms; RFC 850, asctime and non-GMT zones are none")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#urlHost" :text "the host of a url: scheme, userinfo, port and path dropped, an IPv6 literal unbracketed")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#deriveInstance" :text "the balancer instance (local or remote) and a note naming the rule: explicit :instance wins, any :kind gateway row makes it a satellite (remote), no HOME is remote, otherwise local; loadPool! puts the note first in pool.notes")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#Hold" :text "a planned, unsettled request holding its estimated charge on a pool alias since atMs")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolReserve" :text "adds a hold of the estimated charge for a pool alias at plan time; effectiveUse counts live holds, so concurrent picks cannot overrun a hard budget; a non-pool alias holds nothing")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolRelease" :text "drops the oldest hold of an alias; settle calls it before charging the actual, so a lower actual frees the difference; unreleased holds lapse after 10 minutes")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolAliasesFor" :text "the http pool aliases serving one upstream provider and model name, the aliases a request already naming that model asks for")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolHonour" :text "picks among the asked aliases only; refused, with the reason, when each one is exhausted by its provider, resting after a failure, outside the mode or at its hard cap")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modelKey" :text "a model name without a trailing reasoning-effort suffix (:minimal :low :medium :high :xhigh); other suffixes such as :free stay part of the name")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolReleaseAt" :text "prunes holds lapsed at nowMs, then drops the oldest live hold of the alias; poolRelease is the same with the newest hold time as its clock")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#deriveInstanceWithRoles" :text "deriveInstance with the :role of each gateway provider row: :role outward rows (this host federating out) leave the instance local, :role satellite or unmarked gateway rows make it remote; loadPool! reads the roles from the raw gateway form")
(:doc :symbol "asl/packages/asl-gateway/src/dispatch.asl#planReserving" :text "plan plus the wiring to keep: a balancer planSend holds its estimate (2x prompt tokens) in the pool until settle releases it")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolObserve" :text "applies one upstream reply: a 429 exhausts every budget of the model until retry-after, the reported reset or the window end; otherwise header-sourced budgets take the remaining of their unit")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolObserveEndpoint" :text "applies an OpenRouter-shaped status body (/key limit_remaining or /credits total_credits - total_usage, USD) to an endpoint-sourced usd budget; other bodies or budgets are errors")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#effectiveUse" :text "ledger usage raised to what providers report (size - remaining, or hard cap while exhausted) for live observations of the current window; poolPick, pickWhy and refusalText route on it")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolPickLanes" :text "bl/pick over the pool models of the given lanes (http, cli, gateway); budgets are shared across lanes so a CLI and an HTTP call on one subscription pace each other")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#laneOf" :text "the lane serving a pool alias: http, cli or gateway; an alias with no entry is http")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#laneFor" :text "the lane of a provider kind on an instance: cli only on a local instance, gateway for a federation row, http when dispatch can send to it, else none")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#ledgerSinceMs" :text "the earliest call a budget of bal can still count at nowMs: the minimum over budgets of the current window start (a lifetime budget's anchor), nowMs with no budgets; loadPool! reads the ledger from here with nowMs the newest call (ul/windowReadNewest!)")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#Poll" :text "a status endpoint refreshing an endpoint usd budget: budget id, provider whose key the request carries, url (provider base plus :path) and everyMs, at least a minute")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#pollsDue" :text "the status polls to send now: budgets a pool model draws on whose last poll is at least everyMs ago")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolPolled" :text "marks a status poll as sent at nowMs, before the request goes out, so a slow reply is never polled twice")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolPollReply" :text "applies a status reply: 200 feeds poolObserveEndpoint, 429 backs off to four intervals, other statuses keep the last observation; the string is empty on success, else the reason")
(:doc :symbol "asl/packages/asl-gateway/src/dispatch.asl#observeReply" :text "hands an upstream reply status and headers to the pool for a pool alias slot")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#cacheHints" :text "adds the provider cache hint to a converted upstream body: cache_control for anthropic, cachedContent for gemini, prompt_cache_key for declared providers")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#anthropicCacheHints" :text "marks the last tool, the system prompt and the message before the last as cache breakpoints")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#promptCacheKeyProviders" :text "providers declared to accept prompt_cache_key")
(:doc :symbol "asl/packages/asl-gateway/src/secrets.asl#secretEnvName" :text "name under which a secret id is injected into the gateway env: ASLSECRET_ plus the id; a provider with :secret reads its key from that name")
(:doc :symbol "asl/packages/asl-gateway/src/federation.asl#serveTokenId" :text "secrets id of the bearer token a serving gateway demands; absent from the file means no auth")
(:doc :symbol "asl/packages/asl-gateway/src/federation.asl#secretsEnvOverlay!" :text "adds every secret of the file at path to env as ASLSECRET_id; a missing file leaves env as is, a file that fails the loader checks is an error")
(:doc :symbol "asl/packages/asl-gateway/src/federation.asl#serveAuthError" :text "Some 401 ASN error when the env holds a serve token and the request bearer does not match, else None")
(:doc :symbol "asl/packages/asl-gateway/src/federation.asl#serveAuthOn?" :text "true when a gatewayServeToken is loaded into the env")
(:doc :symbol "asl/packages/asl-gateway/src/federation.asl#withoutAuthorization" :text "a raw HTTP request with its Authorization header lines removed; body and other headers untouched")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#credentialKey" :text "picks a provider key: its secret, read from the env under secrets secretEnvName (ASLSECRET_id, put there by federation secretsEnvOverlay!), wins over keyEnv; an unresolved secret gives an empty key; a cli entry has none")
(:doc :symbol "asl/packages/asl-gateway/src/sessions.asl#sessSecretRows" :text "the NAME and secret id pairs a vendor row asks for with NAME@id env entries")
(:doc :symbol "asl/packages/asl-gateway/src/sessions.asl#sessVendorEnvFull!" :text "the vendor child env list with its secrets added from the default secrets file")
(:doc :symbol "asl/packages/asl-gateway/src/sessions.asl#sessVendorEnvAt!" :text "the vendor child env list with its secrets added from the named secrets file")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#cliEnvAssignments" :text "the env string of a vendor CLI child, with a missing key variable taken from the secrets store")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#buildEnvStringAt!" :text "the env string of a vendor CLI child using the named secrets file")
(:doc :symbol "asl/packages/asl-gateway/src/secrets.asl#secretsEqual?" :text "compares two secret strings over the longer length with no early exit")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#runSpawnChecked!" :text "spawns a vendor CLI only when its env string was built, else fails with the env receipt")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#secretValueOk?" :text "true when a secret value can ride in the child env string unchanged: no newline, no carriage return, not wrapped in quotes")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#missingKeyWhy" :text "the ERR_KEY_MISSING reason for a non-cli provider that declares a keyEnv or secret but has an empty key, else none")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#missingKey" :text "missingKeyWhy for an attempt, looked up from the provider row")
(:doc :symbol "asl/packages/asl-gateway/src/secrets.asl#jsonFull" :text "the JSON string escape of a value as asl-json and the Python encoder write it, with options for ensure_ascii, the escaped slash and upper-hex unicode escapes")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#unclaimedModel?" :text "true when a loaded config claims a model name, bare or vendor/slug, in no alias, route or provider row (the dispatch rule); false with no table")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#dailyCapKind" :text "which free-tier daily cap a 429 body is (openrouter, gemini or groq), empty for an ordinary per-minute 429")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#dailyCapParkSec" :text "seconds to park a model after a daily-cap 429: the provider's reset header or the wait its body names, else the next reset boundary, clamped to 60 s through a day and an hour")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#breakerMarkDownFor" :text "marks a pool down for parkSec seconds, at most the state's parkMaxSec, or the fixed cooldown when parkSec is 0")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#withParkMax" :text "sets the longest park a markDown may hold, from the (:gateway :parkMaxSec N) row; a non-positive value keeps defaultParkMaxSec")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#defaultParkMaxSec" :text "the park ceiling when no :parkMaxSec row is set: 2764800 s, 32 days")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#overContextBudget" :text "the reason a loop member is skipped because the prompt estimate exceeds its contextBudget, none when it fits or no budget is set")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#belowReasoningFloor?" :text "true when a body's max_tokens is absent or under the 4096 floor a reasoning entry needs")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#emptyTools?" :text "true when a body carries tools as an empty array")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#breakerEvent!" :text "applies one chat breaker event to the breaker state; a markDown with parkSec above 0 parks the pool that long, else the fixed cooldown")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#gatewayCliMode?" :text "true for the gateway subcommands handled by the CLI main (config, configCheck, convert, stats, session, models)")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#SyncDiff" :text "one provider's sync result: listed count, free ids, free ids no config row names (added), rows whose model left /models (removed), and free-profile rows whose model is listed but no longer free (changed)")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#SyncProbe" :text "one probe outcome for a new free model: provider, model name, HTTP status or timeout/failed/unprobed")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#modelFilterFor" :text "how a provider marks free models: zeroPrice for openrouter, togetherZero, vercelFree, otherwise chatOnly (every chat model of a subscription)")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#nonChatId?" :text "true for ids naming embedding, rerank, speech, image, moderation and similar non-chat models")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#listedModels" :text "parses one /models body into every listed id and the free ids under the provider's filter; a body that is not JSON is ERR_MODELS_JSON")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#syncDiff" :text "compares a provider's listed and free ids with the config's model rows for it")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#chainsWith" :text "every (profile intent) route whose chain or spread names an alias, in profile order")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#proposeAlias" :text "a new alias from provider prefix and the model name in camel words, a :free suffix kept as Free, unique against taken aliases")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#syncProposals" :text "(provider name alias status) for every added free model: the probe status, skipped when probing was turned off, or known<status> when CAL saw it refused for good")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#syncPatchText" :text "the proposed config patch: model rows to add for probe-ok models, their aliases at the tails of the pool profile's code and any routes, and aliases that leave their chains as gone or no longer free")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#syncCalText" :text "the FREE-SYNC calibration row: per-provider counts, added with probe status, removed, changed and skipped providers")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#syncListText" :text "the current free-model list per provider")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#modelsSyncCli!" :text "asl gateway models sync (or asl run asl/packages/asl-gateway/src/cliDispatch.asl models sync): reads the config and CAL/freeModels.asn (--cal), fetches /models (or --fixtures), probes new and transiently failing free models once, writes the list, the calibration row and the patch under --out (default ~/.asl/run/gwsync); never writes the config")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#calStatus" :text "the status the last FREE-PROBE row recorded for a provider model, read from its (provider \"name\" :vps S ...) entry, or none")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#toProbe" :text "the added models worth probing: unseen ones and those CAL last saw fail with 429, 503 or a timeout; 400-404 and 413 are not probed again")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#fixed3" :text "a number as text with exactly three decimals, rounded")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#entryToken" :text "in a CAL text, the token after a key inside the (provider \"name\" ...) entry, reading newlines as spaces so wrapped rows match; none when absent")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#calOkRate" :text "the share of a model's FREE-PROBE :vps and :mac probes that answered 200; 0.5 with no probe")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#freeCalScore" :text "FREE-CAL score of a gateway model row: its (:cell ...) for the intent by row id, else by provider and model name, else its (:modelScore ...) by row id; null or no row is none; empty intent asks for the overall score")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#RouteEdit" :text "one per-route lead decision of models pace: alias, PROFILE/INTENT route, weight (0 drops the alias from that chain, N fixes its spread weight)")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#PaceSet" :text "one --set row of models pace: model alias, :key and its value as ASN text")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#saturatedQuality" :text "quality of a FREE-CAL cell on a saturated intent: score x n/(n+infra) x 1/(1+ms/10000); none without the cell or with no counted call")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#qualityOf" :text "quality 0..1 of a model row for an intent: on grade, plan, research and any the reliability-and-speed quality of its FREE-CAL cell; otherwise its FREE-CAL score (cell, else overall), clamped; else the probe ok rate")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#multiplierOf" :text "the value multiplier CAL/subMultipliers records for a model: a number, free, or unknown")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#spreadWeight" :text "spread weight of a model row on a route intent: max 1 of the rounded multiplier x quality; free models 8 x quality; unknown 1")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#daysLeft" :text "whole days from today to a renews date, at least 1")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#subRemaining" :text "100 minus the monthly :usedPercent of a subscription in the ledger, none when it has no figure")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#subRenews" :text "a subscription's quoted :renews date from the ledger, empty when absent")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#paceRpm" :text "requests per minute spending the remaining share of a monthly allowance evenly over the days left; with no remaining figure the full allowance over 30 days")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#emptySystemMessage?" :text "true for a system message whose content is empty, whitespace only or null")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#dropEmptySystem" :text "removes empty system messages from a body's messages array, leaving every other message as is")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#GatewayRoute.temperatureOverride" :text "a route's sampling temperature that wins over the model row's :temperature for every entry the route contributes; a client-sent temperature still wins; none keeps the model row default")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#applyPatchText" :text "pure step of models apply: splices a sync patch's :add model rows and :appendTail aliases into the config text, skipping rows and aliases already present; err when the patch names a missing profile, route or list; :leave rows are counted, never applied")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#modelsApplyCli!" :text "asl gateway models apply PATCH [--config PATH]: writes the patched config to a tmp file beside it, runs configCheck on the tmp text, then backs the config up as config.bak-DATE-MS and renames the tmp over it; any configCheck error or misfit patch refuses and leaves the config untouched; an already-applied patch is a no-op; only a lead runs it, nothing calls it automatically")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#GateVerdict" :text "the caller gate's verdict on an answer: passed, and the raw error when not")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#RouteReply" :text "one provider reply to a route step: HTTP status and text")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#RouteResult" :text "the outcome of a code route: passed, the stage that passed (writer or escalation, none for a failure), the answer text, the last error verbatim, the number of model calls and one alias:outcome trail entry per call")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#RouteStep" :text "the pure step machine of a code route: ask a model alias, gate an answer, or done with a RouteResult")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#routeAsk" :text "step: ask the alias with the prompt within timeoutSec, continuing with the reply")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#routeGate" :text "step: run the caller's gate on the text, continuing with its verdict")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#routeDone" :text "step: the route is finished with this result")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#codeRouteStart" :text "the first step of a code route: ask the writer alias with the task")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#codeRouteDrive!" :text "drives a code route to its result with the caller's ask and gate functions: writer retries, optional retryWriter, one escalation, then stop")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#retryPrompt" :text "the retry prompt: the task, the previous answer and the checker error verbatim, then an instruction to fix it")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#CodeRoute" :text "one declared code route: id, writer alias, retries, escalate alias, optional retryWriter alias, escalation timeout and retry count and the HTTP statuses retried on escalation")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayCodeRoute!" :text "the codeRoute row with the given id parsed from a whole gateway.asn text and its aliases checked against the same config's models; an unreadable config, a missing row or a malformed row is an error naming the cause")
(:doc :symbol "asl/packages/asl-gateway/src/router.asl#spreadSeedState" :text "the spread state of a member list after seed placements, so a gateway restart continues the rotation instead of restarting it")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#applySubPace" :text "applies a SUB-PACE patch (:spreads, :rpm, :models, :drops, :decisions; :budgets and :changes informational) to config text: replaces route spreads, sets model-row :rpm and fields, removes dropped aliases from every chain and spread, then the lead's dropRoute and weight decisions; returns the new text and the change list, or the first misfit (missing route, model row or weight target); an edit that already holds is not a change")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#patchHost" :text "the :host (mac or vps) a SUB-PACE patch is written for; models apply refuses a patch whose host is not this machine's")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin" :text "one window of a subscription: kind, length, reset time, used percent, source and the time the figure was taken")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.atMs" :text "epoch ms the figure was taken at, 0 when unknown")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.kind" :text "window kind: rolling, weekly, monthly, daily, primary or secondary")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.lenMs" :text "window length in milliseconds")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.resetsMs" :text "epoch ms of the window reset, 0 when unknown")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.src" :text "where the figure came from: opencodeApi, codexEvent, ledger or principal")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.used" :text "used percent of the window")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace" :text "the pacing verdict of one subscription: its most binding window, used percent against the even-pace allowance, the weight factor and the stale, expired, over and hard flags")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.allowance" :text "percent an even pace to the reset allows by now")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.atMs" :text "epoch ms of the binding figure")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.calls" :text "ledger calls since the monthly window start")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.expired" :text "true when the window reset has passed and the window is counted as fresh and unused")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.factor" :text "weight factor in 0 to 1.5: 0 drops the subscription out of a spread")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.hard" :text "true when the factor is 0")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.id" :text "subscription id")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.over" :text "true when used exceeds the allowance by more than softPoints")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.pace" :text "used divided by allowance")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.src" :text "source of the binding figure")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.stale" :text "true when the figure is older than staleAfterMs of its source")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.tokens" :text "ledger input plus output tokens since the monthly window start")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.used" :text "used percent of that window")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.window" :text "kind of the most binding window, none or exhaust")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#adjustSpread" :text "a route spread under pace: weights times 10 times the subscription factor, members at factor 0 removed so the rest of the chain puts them behind")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#factorsFromPaces" :text "the router cache: subscription id to factor permille, plus the time it was made under ~at")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#fixed1" :text "a number with one decimal")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#groupsOf" :text "the top-level parenthesised groups of a text, quotes honoured")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#hardPoints" :text "adopted: percentage points over the even pace at which a subscription leaves the spread")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#kindOf" :text "the kind name of a window group text such as (:monthly ...)")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#ledgerUse" :text "calls and input plus output tokens the ledger text holds for the providers of a subscription since a start time, by line scan")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#noData" :text "the pacing verdict of a subscription with no window and no ledger estimate: factor 1, stale")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#paceCacheFresh?" :text "true while the factor cache is younger than paceCacheMs")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#paceCacheKey" :text "the key under which the server keeps the factor cache in its spread state")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#paceCacheMs" :text "adopted: the factor cache lives one minute")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#paceSubs" :text "one pacing verdict per subscription of a subscriptions text at a time, ledger estimate included")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#parseTimeMs" :text "UTC epoch ms of 2026-11-13, 2026-11-22 18:00 or an ISO timestamp; 0 for a non-date")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#providerOf" :text "the provider part of a pool key such as commandCode:ccLingFlash")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#providerSub" :text "the subscription id a gateway provider draws on; a provider with no entry is its own subscription")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#quotedAfter" :text "the quoted string after a key in a text; empty when absent")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#rollReset" :text "a reset time moved forward by whole windows until it is not in the past")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#softPoints" :text "adopted: percentage points over the even pace before the weight starts to fall")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#staleAfterMs" :text "adopted: how old a figure of a source may be before it is stale; hand-entered 2 days, api and events 6 hours, ledger never")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#statusLine" :text "one (:subStatus ...) row: used, allowance, pace, factor, value, share, source, age and the stale, expired, over and hard flags")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#subCapacity" :text "requests per month of a subscription without a usage endpoint: its :capacity, else 75000 for commandCode, else 0")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#subId" :text "the :id of a subscription line")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#subLines" :text "the (:sub :id ...) lines of a subscriptions text")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#" :text "pure pacing core: from a subscriptions text, a ledger text and the clock, the used percent of each subscription window against an even pace to its reset, with a soft and a hard limit, and the spread adjustment the router applies")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#subProviders" :text "the gateway provider ids that draw on a subscription")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#tokAfter" :text "the token after a key in a text, up to a space or a closing paren; empty when the key is absent")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#winFactor" :text "weight factor from used percent and allowance: 1 within softPoints over, linear to 0.2 at hardPoints, 0 beyond or at 95 percent used, up to 1.5 when well under pace")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#windowsOf" :text "the windows of a subscription line; a window without :src or :at inherits the sub src word and the file :updated date")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#windowsSegment" :text "the parenthesised text after :windows in a subscription line, or empty")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#codexWindow" :text "the codex window of the latest rate_limits event whose primary window is not null in a session file text")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#ledgerMergeCli!" :text "asl gateway subs ledgerMerge: folds the old per-home stats ledger into the shared one via tmp and rename, shared kept as .bak, legacy renamed .merged")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#ledgerWindows" :text "ledger estimate windows for subscriptions with a capacity and no other fresh source")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#mergeWindows" :text "old windows with those of the same kind replaced by fresh ones, new kinds appended")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#mergedLedgerText" :text "the legacy ledger rows older than the first shared row followed by the shared rows")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#newestSessionFiles!" :text "the newest codex session files under a sessions dir laid out YYYY/MM/DD")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#numText" :text "a JSON number as ASN text")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#opencodeWindows" :text "windows from an opencodeGo usage body, one per rolling, weekly and monthly present, stamped src opencodeApi")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#paceFactors!" :text "the router factor cache read from HOME/.asl/subscriptions.asn and the ledger; empty when the subscriptions file is absent")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#refreshSubsText" :text "a subscriptions text with fresh windows merged into the named subs, every other byte kept")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#" :text "subs refresh, status and ledgerMerge: sources of subscription windows and the status view")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#subsRefreshCli!" :text "asl gateway subs refresh: merges opencodeGo usage, codex rate_limits and ledger estimates into subscriptions.asn via tmp and rename with a .bak")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#subsStatusCli!" :text "asl gateway subs status: one (:subStatus ...) row per subscription from the same pacing core the router uses")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#legacyLedgerPath" :text "the old per-home stats ledger path, folded into the shared ledger once by subs ledgerMerge")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#parseStampMs" :text "epoch ms of a stamp: Z or a +hh:mm suffix is taken as written, a stamp with neither is hand-entered local time read in the given zone")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.known" :text "false when the used percent is unknown (no figure and no declared capacity); such a subscription keeps factor 1 on its time pace")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#pacePatchText" :text "the proposed patch: per-route spreads for freePool and paidCheap without dropped aliases, per-model rpm rows (opencodeGo by :reqMonth, commandCode plan models by weight share of the pool), --set model fields, drops, per-route lead decisions (--dropRoute, --weight), per-provider budget rows and (alias field old new) change rows")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#modelsPaceCli!" :text "asl gateway models pace --date D [--set ALIAS :key VALUE]... [--drop ALIAS]... [--dropRoute ALIAS PROFILE/INTENT]... [--weight ALIAS PROFILE/INTENT N]...: reads config, multipliers, FREE-CAL scores, FREE-PROBE rows and the subscriptions ledger, writes the patch under ~/.asl/run/gwsync, exits 2 on an unknown alias, a route edit outside its chain or a weight below 1 and never edits the config")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#packAttrib" :text "attribution string of tag, session, turn and consumer joined by newlines")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#monthCapWindows" :text "capacity of the monthly window of a subscription line in rolling windows, 0.0 when absent or unparsable")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#perWindowAllowance" :text "percent of a rolling window allowed so the monthly remainder lasts to the month end, clamped to 1 to 80, and -1 without capacity, window length or time left")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#kimiWindows" :text "rolling 5h and monthly window rows parsed from a Kimi usage response body, empty list when it does not parse or has no usages")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#usageCacheWrite" :text "cache creation token count of a usage object from cache_creation_tokens or cache_creation_input_tokens, none when neither is present")
(:doc :symbol "asl/packages/asl-gateway/src/affinity.asl#affinityDefault" :text "affinity defaults: on, a session sticks to its member for 1800 s, records are forgotten after 86400 s, a switch drops prior reasoning")
(:doc :symbol "asl/packages/asl-gateway/src/affinity.asl#affinityConfigFromText" :text "affinity rows from a gateway config text (:affinity :affinityStickSec :affinityForgetSec :affinitySwitch), each absent or unparseable row keeping its default")
(:doc :symbol "asl/packages/asl-gateway/src/affinity.asl#affinityAnswer" :text "a session's affinity answer: empty when off, keyless or forgotten, else (alias stick drop) with stick and drop as 1 or 0")
(:doc :symbol "asl/packages/asl-gateway/src/affinity.asl#affinityNote" :text "the affinity table with the session's answering member recorded at now and every record past the forget age removed")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayTopScalarOverride" :text "an optional top-level (:gateway ... :KEY V) value as a scalar, none when absent or the text does not parse")
(:doc :symbol "asl/packages/asl-gateway/tests/sessionAffinityTest.asl#runTests" :text "turns of one X-ASL-Session through the real chat cascade and server effects under a 1:1 spread: the session sticks to its first member, a breaker-forced switch drops the previous reasoning, :affinity false alternates, :affinitySwitch keep forwards reasoning, bad affinity rows fail config check")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#judgeDefault" :text "judge rules a judge-mode profile starts from: empty and truncated checks on, no step-form intents, step head (:step")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayProfileMode" :text "the :mode of a named profile (pin, route or judge), route for an unknown profile")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayProfileJudge" :text "the judge rules of a named profile, the defaults for an unknown profile")
(:doc :symbol "asl/packages/asl-gateway/tests/modesTest.asl#runTests" :text "pin, route and judge profiles through the real chat cascade and server effects with stubbed upstream replies: pin relays the first member's failure without a reroute, judge moves on empty, truncated and step-less replies that route returns, rows switch checks off, bad rows fail config check")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#decideIn" :text "the verdict for a call by provider and alias over a LimitScope: among the windowed limit rows whose scope contains the call, the spent one used up the furthest wins (limit:WINDOW), else the calendar window furthest ahead of an even spread plus a tenth paces (pace:WINDOW); none when nothing binds")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#coversIn" :text "whether a limit row's scope contains a call: account every alias of the provider, model one alias, group the aliases of the named group row for that provider, endpoint every provider whose base is the row's endpoint")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#covers?" :text "coversIn over an empty LimitScope: only account and model rows can match")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#usedCallsIn" :text "sent calls inside a limit row's window and scope")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#usedTokensIn" :text "input plus output tokens of the sent calls inside a limit row's window and scope")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#usedUsdIn" :text "cost in dollars of the sent calls inside a limit row's window and scope, input and output tokens at the models' per-million prices, an unpriced model costing 0")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#spentRatioIn" :text "how far a limit row is used up: the largest of calls, tokens, tokensIn, tokensOut, tokensCached and usd over their caps, 0 for a row without a window")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#Lease" :text "one concurrency slot held by a call in flight: provider, alias, the keys of the limits it counts against, and when it was taken")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#concurrencyOf" :text "the concurrency limits whose scope contains a call")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#liveLeases" :text "the leases younger than the lease time; older ones are treated as lost")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#full?" :text "true when any of the given concurrency limits already has as many leases under its key as its cap")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#admit" :text "takes a lease for a call under the keys of every covering concurrency limit")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#release" :text "frees the oldest lease of a provider and alias, once, and none when it holds none")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#limitKey" :text "the identity of a limit's scope used to count leases: scope, provider, model, group and endpoint")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayLimitErrors" :text "limit and group problems config check reports as errors: a malformed limit row, a group that is declared twice or names a model its provider lacks, a limit naming an undeclared group, :concurrencyLeaseSec outside 10..86400, :concurrencyPollMs outside 10..5000")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#GatewayGroup" :text "a (:group :id G :provider P :models (ALIAS ...)) row: the aliases of one provider that share every limit row naming the group")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#LimitScope" :text "the groups, provider bases and model prices a limit row needs to decide whether a call is in scope and what it cost")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#emptyLimitScope" :text "a LimitScope with no groups, bases or prices")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayLimitScopeFromText" :text "the LimitScope of a gateway config text: its groups, each provider's base and each model's price per million tokens; empty for text that does not parse")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#defaultConcurrencyLeaseSec" :text "600 s adopted: how long a call may hold a concurrency slot before it is treated as lost")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#defaultConcurrencyPollMs" :text "250 ms adopted: how often a call parked behind a full concurrency limit asks again")
(:doc :symbol "asl/packages/asl-gateway/tests/limitScopeTest.asl#runTests" :text "limit rows over group, endpoint, model and account scopes and the units calls, tokensIn, tokensOut, tokensCached, usd and concurrency: shared group budgets, the tightest limit binds, separate model budgets, lease take and release, config check rejections, a parked call sleeping and asking again until its queue budget, and the server freeing a slot on the sent usage row")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#JudgeRules" :text "the checks a judge-mode profile applies to a 200 reply: empty content with no tool calls, finish_reason length, and step intents whose answer must hold one of stepHeads")
