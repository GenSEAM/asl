(:doc :symbol "asl/packages/asl-gateway/src/pyText.asl#pyStrip" :text "str.strip() with no argument")
(:doc :symbol "asl/packages/asl-gateway/src/pyText.asl#jset" :text "dict insert keeps first position, last value")
(:doc :symbol "asl/packages/asl-gateway/src/pyText.asl#pyStr" :text "str(v) of a JSON-decoded Python value")
(:doc :symbol "asl/packages/asl-gateway/src/pyText.asl#jget" :text "dict.get(k) on a decoded dict")
