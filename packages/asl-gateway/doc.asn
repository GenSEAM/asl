(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L47" :text "seq06: single 503 does not trip")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L57" :text "seq07: two 503s do not trip")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L68" :text "seq08: three 503s trip the breaker")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L80" :text "seq09: multi-provider isolation (agy trips, codex stays untripped with count 2)")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L96" :text "seq10: reset_503 resets counter so subsequent 503 does not trip")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L107" :text "seq11: 4th 503 after trip increments count to 1 and does not re-trip")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L122" :text "seq12: single timeout does not trip")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L130" :text "seq13: two timeouts do not trip")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L139" :text "seq14: three timeouts trip the breaker")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L151" :text "seq15: reset_timeout resets counter")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L162" :text "seq16: timeouts and 503s are isolated counters")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L176" :text "seq17: clear resets tripped breaker immediately")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L183" :text "seq18: clear resets both 503 and timeout counters")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L194" :text "seq19: markdown resets failure counters")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L207" :text "seq20: success (clear) between timeouts prevents trip")
