(:doc :symbol "asl/packages/asl-gateway/src/config.asl#asn_name" :text "--- Core ASN parsing functions ---")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#checkTemperature" :text "--- Parameter parsing ---")
