(:doc :symbol "asl/packages/asl-gateway/src/server.asl#mainWith" :text "the injection point: a launcher outside asl-gateway (it never imports a provider package) passes its module path and extra lifecycle families, served after the built-in ones")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#gatewaySelfHost!" :text "the executable start respawns itself through, as \"HOST run MODULE_PATH ARGS\": prefers ASL_GATEWAY_ROOT/bin/asl, a generic run-FILE dispatcher like the retired asl-host, over procExePath(), which under a native run names a specific per-file binary that cannot re-parse a leading run/MODULE_PATH pair")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#ConnPhase" :text "one connection's place in the event loop; a chat continuation waits on an upstream call or a pool reply")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#addConn" :text "an in-process client has a negative fd: its response lands in the outbox instead of a socket")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#renderResponse" :text "status line, chat head fields, Content-Length when absent, Connection close")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#parseRequest" :text "none until the head and Content-Length body bytes have arrived")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#settledFailure!" :text "settled! for a failed attempt: its status, headers and a reason built from the upstream failure ride on the pending call into the ledger row")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#runEffect!" :text "effects that finish inside one loop turn; CLI clients are not served by the HTTP entry")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#cliAdmit!" :text "asks the balancer before a vendor CLI run: picks over the cli lane, refuses when its budgets are at the hard cap, else charges the picked alias with the prompt-size estimate; no pool or no cli lane admits")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#keyFilesWorldEnv!" :text "the env the chat effects read: the process env overlaid, per provider row with a keyEnv, by the value a key file of the config holds; the file wins; an unloadable table leaves the env as it was")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#drive!" :text "run the chat machine until it answers or parks on an upstream call or a pool slot")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#errorOutcome" :text "a refusal the gateway itself makes (budget, spend gate, cold-start timeout) is marked so chat never counts it against the provider's breaker")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#dispatchHttp!" :text "route -> endpoints -> pick -> admission -> budget gate run in dp/plan; send goes through the chosen endpoint's plugin; every request logs its decision row")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#stepWarm!" :text "a request parked on a serverless start sends when the endpoint admits it, or fails at its coldStartMs deadline")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#settled!" :text "charge: fleet telemetry and the budget charge for a finished call; passthrough slots without a ledger only log")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#wired!" :text "provider rows, plugins, router profile, endpoints and budget follow the config file; a new text rebuilds them and resets fleet and ledger state")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#dispatch!" :text "chat completions run the gateway chat handler; every other request is proxied to --upstream")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#deliverReplies!" :text "resume each parked chat whose pool reply arrived; resumed chats may queue further replies")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#gatewayEventLoop!" :text "single-threaded poll loop: clients, upstream calls and pool lanes progress together; active lanes tick every 10 ms")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#linkOpen!" :text "the link loads config strictly: with no config file the secrets path stays the default and the missing config is the error; a config whose :secretsFile is unreadable, non-string or missing is refused; a missing or invalid config or wiring is an error, never the empty wiring the server falls back to\n--- in-process link: a library caller runs the same loop the HTTP server runs, with no socket on its side ---")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#linkPump!" :text "pump the loop until the link's response is in the outbox; the same steps the server runs, minus accept")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#linkSend!" :text "one request through chat, route, admission, budget, plugin send and charge in this process; the result is the HTTP response bytes the server would write")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#gatewayStatePath!" :text "the run-state receipt path, under .asl/run so it never collides with the profiles config or the usage ledger, both of which also live under home/.asl; regression guard: serverTest.asl#testStatePathIsolation")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#ensureSessionHeader" :text "adds X-ASL-Session with a connection-derived fallback id when the caller sent none; an existing header is left untouched")
