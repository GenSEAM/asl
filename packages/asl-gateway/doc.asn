(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#writeLearned!" :text "replaces the learned file with the rows through a temp file and a rename")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#readCaps!" :text "the stored ramped caps; a missing file is none, a corrupt line is an error")
