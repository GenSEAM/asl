(:doc :symbol "asl/packages/asl-gateway/src/getRoutes.asl#qsGet" :text "dict(parse_qsl(q)): the last value of a key wins")
(:doc :symbol "asl/packages/asl-gateway/src/getRoutes.asl#paramJson" :text "invert asn_value(v) of a parameter: the text keeps the Python type, int 1 apart from float 1.0")
(:doc :symbol "asl/packages/asl-gateway/src/getRoutes.asl#popAction" :text "Queue.get_nowait on the named queue: the head item and the queues without it")
(:doc :symbol "asl/packages/asl-gateway/src/getRoutes.asl#searchResponse" :text "the answer to a getSearch outcome once the hub returned res")
(:doc :symbol "asl/packages/asl-gateway/src/getRoutes.asl#requestPath" :text "BaseHTTPRequestHandler.parse_request collapses a leading // to one / before do_GET sees self.path")
(:doc :symbol "asl/packages/asl-gateway/src/getRoutes.asl#gatewayGet" :text "Handler.do_GET on the raw request target; checks run in its order")
(:doc :symbol "asl/packages/asl-gateway/src/getRoutes.asl#gatewayGetRequest" :text "http11 splits the target at its first ?; a target ending in a bare ? arrives without it")
