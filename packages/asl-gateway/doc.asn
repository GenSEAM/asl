(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#getUpstreamForModelIn" :text "provider, URL and key for a model name from a provider table, so a configured provider routes without a code change")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#tokenBucketBegin" :text "TokenBucket.acquire up to its sleep")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#tokenBucketFinish" :text "TokenBucket.acquire after its sleep")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#geminiBucket" :text "setdefault keyed by (model, rpm)")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#replyCeiling" :text "X1 mode reply ceilings, adopted values")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#roleTokenPolicy" :text "role base keyword to token policy")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#isReasoningModel?" :text "true only if the request body's own :reasoning or the caller-resolved model's config :reasoning says so (OR of the two); no model-name pattern of any kind, per LEON-ROLE/gateway-config-in-home")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#objSet" :text "dict assignment: in place, else appended")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#objDel" :text "dict key removal, used to strip the request's own :reasoning control field before dispatch")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#prepareRequestPayload" :text "reasoning floor from isReasoningModel? (request :reasoning or config-resolved GatewayParams.reasoning, threaded in by chat.asl#identify! for a literal model id) and role hard cap on max_tokens")
