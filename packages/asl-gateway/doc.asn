(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L285" :text "seq25: custom cooldown")
(:doc :symbol "asl/packages/asl-gateway/tests/breakerTest.asl#L293" :text "seq26: edge cases: empty provider and dynamic new provider")
