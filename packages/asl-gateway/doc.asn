(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#lineWord" :text "line, IGNORECASE: i also matches U+0130 U+0131")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#lineNumberScan" :text "re.search of the line-number pattern, IGNORECASE")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#lowerForSearch" :text "str.lower where only ASCII results matter")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#analyzeTelemetry" :text "analyze_telemetry record, or none for empty content")
