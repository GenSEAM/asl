(:doc :symbol "asl/packages/asl-gateway/src/server.asl#errorOutcome" :text "a refusal the gateway itself makes (budget, spend gate, cold-start timeout) is marked so chat never counts it against the provider's breaker")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#LearnedRow" :text "what the ledger shows a provider (alias empty) or one alias reached in one window: peak sent calls and tokens in a span with no upstream 429, the fewest calls and tokens at a 429, the 429 count and the newest row seen")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#CapRow" :text "a ramped call cap for the configured account or model limit row of provider and alias in a window, only ever above the configured value")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#Refusals" :text "per provider, rows that sent nothing (own refusals) against ok, 429 and other failures the provider answered")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#defaultLearnWindows" :text "minute hour fiveHour day week, the windows a learn pass tracks when :learnWindows is absent")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#defaultLearnRampPct" :text "25, the percent a ramp step raises a cap by when :learnRampPct is absent or out of range")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#learnWindowMs" :text "the length of a learn window in milliseconds, 0 for a name that is not one")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#learnRows" :text "learned rows from ledger rows: one per provider and window and one per provider alias and window, none for a group with no sent call; spans are resolved to a quarter of the window")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#mergeLearned" :text "stored rows folded with fresh ones: peaks and the 429 count the larger, the count at a 429 the smaller, so a repeated pass changes nothing and a fresh lower peak never erases a stored one")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#rampPass" :text "one ramp step: a configured account or model call cap driven up to with no upstream 429 ever seen rises by pct percent, at least 1, and never falls")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#rampedLimits" :text "the limit rows with each matching ramped call cap swapped in; a cap under the configured value is ignored")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#learnedLine" :text "a learned row as one (:learned ...) line, an absent count at a 429 left out")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#learnedParse" :text "a learned line back to its row; a line missing provider, window or peak is an error")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#capLine" :text "a cap row as one (:cap ...) line")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#capParse" :text "a cap line back to its row; a line missing provider, window or calls is an error")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#refusalsOf" :text "own refusals against provider answers per provider from ledger rows")
