(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#upstreamRequest" :text "the urllib Request that do_POST builds")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#childEnv" :text "explicit allowlist; keys never reach the child")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#headerNameOk?" :text "RFC 7230 token: no leading @ file reads")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#checkRequest" :text "http.client rejects these; values never echoed")
