(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#curlConfigFollowing" :text "maxRedirects > 0 follows Location up to that many hops; curl turns a POST into a GET on 303, and -L without --request keeps that switch, so the method line is dropped when following")
