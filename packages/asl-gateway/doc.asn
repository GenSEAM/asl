(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#tierSub" :text "subscription tier")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#tierPaid" :text "paid API tier")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modeFree" :text "free models only")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modeSub" :text "subscription models only")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modePaid" :text "paid models only")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modeBalanced" :text "every tier, score-based mix (default)")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modeExplore" :text "every tier, ranks by low confidence so calibration runs reach unmeasured models")
