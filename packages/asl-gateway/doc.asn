(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#urlSplit" :text "urlsplit: scheme, netloc, path, query, fragment")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#unquotePlus" :text "unquote_plus, UTF-8 replace per ASCII run")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#cleanQuery" :text "parse_qsl, drop tracking keys, urlencode")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#urlUnparse" :text "urlunparse")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#cleanUrl" :text "clean_url; a parse error returns the input")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#universalLines" :text "text-mode line iteration, universal newlines")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#loadZshEnvText" :text "one rc file: decode ignore, then parse lines")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#loadZshEnv!" :text "load_zsh_env: existing variables win")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#gatewayFileVersion!" :text "sha256 prefix, or absent when unreadable")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#gatewayUpdateStatus" :text "gateway_update_status; diskValid only for a present file")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#posixDirname" :text "everything before the last /, slashes stripped; empty or all-slash input returns unchanged")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#posixJoin" :text "a + \"/\" + b, unless a is empty or already ends in /")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#" :text "one append-only ASN row per upstream call attempt, success or failure, written from server.asl's settled!/effUsageNote path; plus stats aggregation windowed by time and grouped by provider, model, alias or request parameter; gatewayStatePath! deliberately never shares a path with this ledger")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#CallRow" :text "at/profile/intent/alias/provider/model, in/cached/out tokens, ttftMs/ms latency, outcome, charge, an optional caller tag for joining a run's outcome to its calls (e.g. Leon's session id), and the effective request parameters actually sent: temperature, topP, maxTokens, effort, api kind (chat|responses|messages|generateContent), stream, tool count, prompt bytes, a short hash of the system prefix for prefix-cache reuse; callRowLine/callRowParse round-trip every field and callRowParse rejects a row missing any one of them rather than defaulting it")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#CallParams" :text "the request parameters read back out of the outgoing request body after profile/model defaults are applied, not guessed from config; a parameter the provider ignored (e.g. top_p, stream: neither is ever actually sent today) is still recorded honestly as sent")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#defaultCallParams" :text "the fallback CallParams when the outgoing body never parsed as JSON, or no PendingCall exists at effUsageNote time (e.g. a breaker-skip path that never reached settled!)")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#filterByTag" :text "--tag: an empty query returns every row unfiltered; a non-empty query keeps only rows whose caller tag matches exactly, so an untagged row never matches")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#keyFor" :text "--by: provider, model or alias group by that CallRow field; param:NAME groups by one of paramNames (e.g. param:temperature, param:effort), and an unrecognized name is a real error rather than a silent wrong grouping")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#Stat" :text "one keyFor group's aggregate: call and ok counts, token totals, mean/p50/p90 latency (none when no row carried a latency), output tokens-per-second and the basis it was computed from, and total charge")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#appendCallRow!" :text "creates the ledger's parent directory if absent, rotates the file first when it has grown past maxLedgerBytes, then appends one callRowLine")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#maxLedgerBytes" :text "10485760 (10MB); the ledger rotates to a .1 predecessor once it reaches this size")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#defaultLedgerPath" :text "home/.asl/run/gatewayCalls.asn, unless overridden by gatewayLedgerPathOverride")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#callRowLine" :text "one CallRow serialized as a single ASN line, every field present so callRowParse can round-trip it without defaulting")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#callRowParse" :text "the inverse of callRowLine; rejects a line missing any one field rather than defaulting it")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#rotateIfNeeded!" :text "rotateWith! at maxLedgerBytes and defaultLedgerKeep")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#readRows!" :text "every CallRow from every kept generation and the live file, oldest first; empty list when none exists yet")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#defaultLedgerKeep" :text "rotated generations kept beside the live ledger when the (:gateway :ledgerKeep N) row is absent: 8")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#generations!" :text "the generation numbers kept beside path, ascending; generation N is the file path.N with N rising per shift, so a shift never renames an older generation")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#rotateWith!" :text "under the path.rotate lock, re-stats path and, when it is at or over maxBytes, renames it to the next generation and removes the oldest beyond keep; a busy lock leaves rotation to its holder")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#appendCallRowWith!" :text "creates the parent directory, rotates with maxBytes and keep, then appends one callRowLine")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#readRowsSince!" :text "windowRead! rows at or after sinceMs")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#windowReadNewest!" :text "(Pair files rows) for a window whose start sinceOf derives from the newest call: reads the live file (or the newest generation holding rows), then older generations newest first until one reaches back to that start; rows before it are dropped; an empty ledger reads everything kept")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#windowRead!" :text "(Pair files rows): reads the live file, then older generations newest first only until one reaches back to sinceMs (a negative sinceMs reads all); a half-written last line is skipped and a generation list that changes during the read restarts it, so a concurrent shift neither drops nor repeats a row")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#redactReason" :text "a failure reason on one line, at most 200 chars, with key-shaped runs, the run after Bearer and the value after a key, token, secret, authorization or password label replaced by [redacted]")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#windowMsOf" :text "1h/24h/7d parsed to milliseconds; any other text is an error naming the three accepted values")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#rowsInWindow" :text "rows whose atMs falls within windowMs of nowMs")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#keyByProvider" :text "groups by CallRow.provider")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#keyByModel" :text "groups by CallRow.model")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#keyByAlias" :text "groups by CallRow.alias")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#paramNames" :text "the request-parameter names keyByParam accepts: temperature, topP, maxTokens, effort, api, stream, toolCount, promptBytes, sysHash, tag")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#keyByParam" :text "groups by one named CallRow request parameter; the parameter name is one of paramNames")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#keyByParamNamed" :text "keyByParam partially applied to one name, for passing as a keyFor grouping function")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#computeStats" :text "rowsInWindow then grouped by keyFn into one Stat per group, sorted by call count descending")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#statLine" :text "one Stat serialized as an ASN (:stats ...) line, with ok% and cached-token-share computed from the raw counts")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#statsAsn" :text "every Stat's statLine, newline-joined")
