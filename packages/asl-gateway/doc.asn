(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#Budget" :text "one quota window: id, window length and anchor in ms, unit req|tok|usd, size, soft and hard percent of size, useOrLose, and the source of the figure")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#PoolModel" :text "a pool row: model id, provider, tier, why it is in the pool, the budget ids it draws on, expected microUSD per request and an optional declared quality")
