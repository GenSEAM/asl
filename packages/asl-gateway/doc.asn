(:doc :symbol "asl/packages/asl-gateway/src/config.asl#" :text "Pure AgentSlang Gateway Configuration Parser, Calibration Index Ingestion, and Intent Router ported from bin/asl-gateway")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayProfilesPath" :text "expanduser strips trailing slashes; empty home is root")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayRouteEntries!" :text "returned table carries the undeclared-intent count")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#keyFileLookup!" :text "listed files searched in order, first match wins; a missing, unreadable or name-less file is silently skipped, never an error")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#resolveProviderKey!" :text "key files, then the process environment; empty :keyEnv is none, same as before this unit")
(:doc :symbol "asl/packages/asl-gateway/src/localTime.asl#" :text "Local wall-clock time of Unix seconds as libc localtime computes it: TZif zoneinfo files and POSIX TZ rules, strftime %Y-%m-%d %H:%M[:%S]")
(:doc :symbol "asl/packages/asl-gateway/src/localTime.asl#zoneLoad!" :text "Tries the libc zoneinfo file, then POSIX TZ rules, and falls back to UTC.")
