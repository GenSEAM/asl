(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#applyRows" :text "mutate rows in order; stop at first raise")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#usageNote" :text "usage_note: counts, tokens, error buckets")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#usageException" :text "curl exit 28 is the timeout class")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#usageAgyFallback" :text "agy fallback behind the agy breaker")
