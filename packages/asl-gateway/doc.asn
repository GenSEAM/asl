(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#tierPaid" :text "paid API tier")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modeFree" :text "free models only")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modeSub" :text "subscription models only")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modePaid" :text "paid models only")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modeBalanced" :text "every tier, score-based mix (default)")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modeExplore" :text "every tier, ranks by low confidence so calibration runs reach unmeasured models")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#picked" :text "the chosen model of a pick")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#refused" :text "no admitted model fits under its hard caps, with the reason")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseTier" :text "free|sub|paid to Tier, unknown is an error")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseMode" :text "free|sub|paid|balanced|explore to Mode, unknown is an error")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#tierName" :text "tier as its config word")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modeName" :text "mode as its config word")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#windowMsOf" :text "hour, 5h, day, week or month (30 days) in ms")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#tierAdmitted?" :text "whether a mode admits a tier")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#defaultPolicy" :text "balanced, explore every 20th request, softFactor 100 permille")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#makeBalancer" :text "builds a Balancer, indexing budgets by id")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#windowStart" :text "start of the window holding nowMs on the budget's anchor grid")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#budgetUsed" :text "usage of a budget in the current window, 0 when the stored window is older")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#hardCap" :text "size x hard percent: a pick that would pass it is refused")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#softCap" :text "size x soft percent: past it load shifts away")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#pacingFactor" :text "permille pacing of one budget: squared ratio of pro-rata target to use, raised only for use-or-lose quotas, scaled by softFactor past the soft line (absolute soft cap or ahead of hard pro-rata) except late in a use-or-lose window, x1.5 for a use-or-lose quota under 90% in its last quarter")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modelPacing" :text "tightest pacing factor over a model's budgets, 1000 when it has none")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#qualityFor" :text "quality from intent CAL rows, else any-intent CAL rows (shrunk toward the tier prior by two pseudo-runs, confidence n/(n+4)), else declared (confidence 250), else tier prior (confidence 100)")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#tierPrior" :text "neutral prior score by tier: free 450, sub 600, paid 600 permille (adopted 2026-10-27, no measurement)")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseCalScores" :text "reads saved (:cal :id :intent :scores ((model pass total ...))) rows such as CAL/freeModels.asn into CalScore rows, skipping what it cannot read")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseBalancer" :text "reads the loaded (:gateway ...) form: model rows with optional why tier budgets costMicros quality, and an optional (:balancer :mode :exploreEvery :softFactor :budgets) section")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#emptyUse" :text "usage with no window recorded")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#chargeUse" :text "charges one request of a model to each of its budgets")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#usageFromCalls" :text "rebuilds window usage from recorded gateway call rows by alias")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#scoreOf" :text "pacing x tier weight x quality / (cost + 1000 microUSD floor); explore mode uses 1000 - confidence as quality")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#pick" :text "routes one request: mode filter, hard-cap fit, then best score or the exploration pick")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#replay" :text "routes and charges a request list in order; deterministic for a fake clock")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#budgetRows" :text "one report row per budget at nowMs")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#budgetRowLine" :text "a BudgetRow as one (:budgetRow ...) ASN line")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#blockingBudgets" :text "ids of the budgets that keep the mode's admitted models from fitting a request, each once")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#Pool" :text "the balancer as dispatch holds it: balancer, window usage, alias to (provider, upstream model name), and the count of charged requests")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#loadPool!" :text "GW-BALANCER-WIRE: none without a (:balancer ...) section; else reads CAL files (:cal, default .asl/mem/work/CAL/freeModels.asn and .asl/mem/work/SH/workerStats.asn graded runs, a missing file is skipped), keeps only models whose provider dispatch can send to, and rebuilds usage from the shared call ledger (:ledger, else the config override, else HOME's); a read error of an existing CAL file or the ledger is an error")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolFromParts" :text "builds a Pool from a balancer, usage and targets, dropping models without a target")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolRequest" :text "the balancer Request for a dispatch: next sequence number, intent (any when empty), expected tokens")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolPick" :text "the dispatch pick: bl/pick over the pool http lanes and current usage, never a cli or gateway lane")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolTarget" :text "provider and upstream model name of a pool alias")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolCharge" :text "charges one request of a pool alias to its windows and advances the sequence; other ids leave the pool unchanged")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#pickWhy" :text "the pick's score parts as one (:balancer ...) form for the route receipt")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#refusalText" :text "the 429 reason: (:balancer :refused :mode M :budgets (ids) :reason text)")
(:doc :symbol "asl/packages/asl-gateway/src/dispatch.asl#settledConsumed" :text "clears the pool alias the last settle recorded, once the usage row has been written")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolFailed" :text "GW-BALANCER-CASCADE: rests a pool alias until nowMs + cooldownMs (balancer :failCooldownMs, default 60000) after a failed call, so poolPick skips it unless every model rests")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#Observed" :text "GW-BALANCER-LIVE-QUOTA: what a provider reported for one budget: remaining in the budget unit, reset time (0 unknown), when it was seen, and whether a 429 exhausted it")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#RateObs" :text "one rate-limit header reading: unit req|tok, remaining, absolute reset ms (0 unknown)")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseDurationMs" :text "reads OpenAI/Groq reset durations (1s, 6m0s, 2m59.56s, 120ms, 1h2m3s) and bare seconds into ms")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseRfc3339Ms" :text "reads a UTC RFC 3339 time (Z or +00:00, optional fraction) into epoch ms; other offsets are none")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseRateHeaders" :text "rate-limit rows from x-ratelimit-remaining/reset-requests|tokens (OpenAI, Groq) or anthropic-ratelimit-requests|tokens-remaining/reset, header names case-insensitive")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#retryAfterMs" :text "the Retry-After delay in ms: delay-seconds, or an IMF-fixdate HTTP-date taken against nowMs, a past date being 0")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#parseHttpDateMs" :text "an IMF-fixdate (Wed, 21 Oct 2015 07:28:00 GMT) as epoch ms; RFC 850, asctime and non-GMT zones are none")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#urlHost" :text "the host of a url: scheme, userinfo, port and path dropped, an IPv6 literal unbracketed")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#deriveInstance" :text "the balancer instance (local or remote) and a note naming the rule: explicit :instance wins, any :kind gateway row makes it a satellite (remote), no HOME is remote, otherwise local; loadPool! puts the note first in pool.notes")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#Hold" :text "a planned, unsettled request holding its estimated charge on a pool alias since atMs")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolReserve" :text "adds a hold of the estimated charge for a pool alias at plan time; effectiveUse counts live holds, so concurrent picks cannot overrun a hard budget; a non-pool alias holds nothing")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolRelease" :text "drops the oldest hold of an alias; settle calls it before charging the actual, so a lower actual frees the difference; unreleased holds lapse after 10 minutes")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolAliasesFor" :text "the http pool aliases serving one upstream provider and model name, the aliases a request already naming that model asks for")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolHonour" :text "picks among the asked aliases only; refused, with the reason, when each one is exhausted by its provider, resting after a failure, outside the mode or at its hard cap")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#modelKey" :text "a model name without a trailing reasoning-effort suffix (:minimal :low :medium :high :xhigh); other suffixes such as :free stay part of the name")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolReleaseAt" :text "prunes holds lapsed at nowMs, then drops the oldest live hold of the alias; poolRelease is the same with the newest hold time as its clock")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#deriveInstanceWithRoles" :text "deriveInstance with the :role of each gateway provider row: :role outward rows (this host federating out) leave the instance local, :role satellite or unmarked gateway rows make it remote; loadPool! reads the roles from the raw gateway form")
(:doc :symbol "asl/packages/asl-gateway/src/dispatch.asl#planReserving" :text "plan plus the wiring to keep: a balancer planSend holds its estimate (2x prompt tokens) in the pool until settle releases it")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolObserve" :text "applies one upstream reply: a 429 exhausts every budget of the model until retry-after, the reported reset or the window end; otherwise header-sourced budgets take the remaining of their unit")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolObserveEndpoint" :text "applies an OpenRouter-shaped status body (/key limit_remaining or /credits total_credits - total_usage, USD) to an endpoint-sourced usd budget; other bodies or budgets are errors")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#effectiveUse" :text "ledger usage raised to what providers report (size - remaining, or hard cap while exhausted) for live observations of the current window; poolPick, pickWhy and refusalText route on it")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolPickLanes" :text "bl/pick over the pool models of the given lanes (http, cli, gateway); budgets are shared across lanes so a CLI and an HTTP call on one subscription pace each other")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#laneOf" :text "the lane serving a pool alias: http, cli or gateway; an alias with no entry is http")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#laneFor" :text "the lane of a provider kind on an instance: cli only on a local instance, gateway for a federation row, http when dispatch can send to it, else none")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#ledgerSinceMs" :text "the earliest call a budget of bal can still count at nowMs: the minimum over budgets of the current window start (a lifetime budget's anchor), nowMs with no budgets; loadPool! reads the ledger from here with nowMs the newest call (ul/windowReadNewest!)")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#Poll" :text "a status endpoint refreshing an endpoint usd budget: budget id, provider whose key the request carries, url (provider base plus :path) and everyMs, at least a minute")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#pollsDue" :text "the status polls to send now: budgets a pool model draws on whose last poll is at least everyMs ago")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolPolled" :text "marks a status poll as sent at nowMs, before the request goes out, so a slow reply is never polled twice")
(:doc :symbol "asl/packages/asl-gateway/src/balancer.asl#poolPollReply" :text "applies a status reply: 200 feeds poolObserveEndpoint, 429 backs off to four intervals, other statuses keep the last observation; the string is empty on success, else the reason")
(:doc :symbol "asl/packages/asl-gateway/src/dispatch.asl#observeReply" :text "hands an upstream reply status and headers to the pool for a pool alias slot")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#cacheHints" :text "adds the provider cache hint to a converted upstream body: cache_control for anthropic, cachedContent for gemini, prompt_cache_key for declared providers")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#anthropicCacheHints" :text "marks the last tool, the system prompt and the message before the last as cache breakpoints")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#promptCacheKeyProviders" :text "providers declared to accept prompt_cache_key")
(:doc :symbol "asl/packages/asl-gateway/src/secrets.asl#secretEnvName" :text "name under which a secret id is injected into the gateway env: ASLSECRET_ plus the id; a provider with :secret reads its key from that name")
(:doc :symbol "asl/packages/asl-gateway/src/federation.asl#serveTokenId" :text "secrets id of the bearer token a serving gateway demands; absent from the file means no auth")
(:doc :symbol "asl/packages/asl-gateway/src/federation.asl#secretsEnvOverlay!" :text "adds every secret of the file at path to env as ASLSECRET_id; a missing file leaves env as is, a file that fails the loader checks is an error")
(:doc :symbol "asl/packages/asl-gateway/src/federation.asl#serveAuthError" :text "Some 401 ASN error when the env holds a serve token and the request bearer does not match, else None")
(:doc :symbol "asl/packages/asl-gateway/src/federation.asl#serveAuthOn?" :text "true when a gatewayServeToken is loaded into the env")
(:doc :symbol "asl/packages/asl-gateway/src/federation.asl#withoutAuthorization" :text "a raw HTTP request with its Authorization header lines removed; body and other headers untouched")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#credentialKey" :text "picks a provider key: its secret, read from the env under secrets secretEnvName (ASLSECRET_id, put there by federation secretsEnvOverlay!), wins over keyEnv; an unresolved secret gives an empty key; a cli entry has none")
(:doc :symbol "asl/packages/asl-gateway/src/sessions.asl#sessSecretRows" :text "the NAME and secret id pairs a vendor row asks for with NAME@id env entries")
(:doc :symbol "asl/packages/asl-gateway/src/sessions.asl#sessVendorEnvFull!" :text "the vendor child env list with its secrets added from the default secrets file")
(:doc :symbol "asl/packages/asl-gateway/src/sessions.asl#sessVendorEnvAt!" :text "the vendor child env list with its secrets added from the named secrets file")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#cliEnvAssignments" :text "the env string of a vendor CLI child, with a missing key variable taken from the secrets store")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#buildEnvStringAt!" :text "the env string of a vendor CLI child using the named secrets file")
(:doc :symbol "asl/packages/asl-gateway/src/secrets.asl#secretsEqual?" :text "compares two secret strings over the longer length with no early exit")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#runSpawnChecked!" :text "spawns a vendor CLI only when its env string was built, else fails with the env receipt")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#secretValueOk?" :text "true when a secret value can ride in the child env string unchanged: no newline, no carriage return, not wrapped in quotes")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#missingKeyWhy" :text "the ERR_KEY_MISSING reason for a non-cli provider that declares a keyEnv or secret but has an empty key, else none")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#missingKey" :text "missingKeyWhy for an attempt, looked up from the provider row")
(:doc :symbol "asl/packages/asl-gateway/src/secrets.asl#jsonFull" :text "the JSON string escape of a value as asl-json and the Python encoder write it, with options for ensure_ascii, the escaped slash and upper-hex unicode escapes")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#unclaimedModel?" :text "true when a loaded config claims a model name, bare or vendor/slug, in no alias, route or provider row (the dispatch rule); false with no table")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#dailyCapKind" :text "which free-tier daily cap a 429 body is (openrouter, gemini or groq), empty for an ordinary per-minute 429")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#dailyCapParkSec" :text "seconds to park a model after a daily-cap 429: the provider's reset header or the wait its body names, else the next reset boundary, clamped to 60 s through a day and an hour")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#breakerMarkDownFor" :text "marks a pool down for parkSec seconds, at most the state's parkMaxSec, or the fixed cooldown when parkSec is 0")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#withParkMax" :text "sets the longest park a markDown may hold, from the (:gateway :parkMaxSec N) row; a non-positive value keeps defaultParkMaxSec")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#defaultParkMaxSec" :text "the park ceiling when no :parkMaxSec row is set: 2764800 s, 32 days")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#overContextBudget" :text "the reason a loop member is skipped because the prompt estimate exceeds its contextBudget, none when it fits or no budget is set")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#belowReasoningFloor?" :text "true when a body's max_tokens is absent or under the 4096 floor a reasoning entry needs")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#emptyTools?" :text "true when a body carries tools as an empty array")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#breakerEvent!" :text "applies one chat breaker event to the breaker state; a markDown with parkSec above 0 parks the pool that long, else the fixed cooldown")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#gatewayCliMode?" :text "true for the gateway subcommands handled by the CLI main (config, configCheck, convert, stats, session, models)")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#SyncDiff" :text "one provider's sync result: listed count, free ids, free ids no config row names (added), rows whose model left /models (removed), and free-profile rows whose model is listed but no longer free (changed)")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#SyncProbe" :text "one probe outcome for a new free model: provider, model name, HTTP status or timeout/failed/unprobed")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#modelFilterFor" :text "how a provider marks free models: zeroPrice for openrouter, togetherZero, vercelFree, otherwise chatOnly (every chat model of a subscription)")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#nonChatId?" :text "true for ids naming embedding, rerank, speech, image, moderation and similar non-chat models")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#listedModels" :text "parses one /models body into every listed id and the free ids under the provider's filter; a body that is not JSON is ERR_MODELS_JSON")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#syncDiff" :text "compares a provider's listed and free ids with the config's model rows for it")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#chainsWith" :text "every (profile intent) route whose chain or spread names an alias, in profile order")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#proposeAlias" :text "a new alias from provider prefix and the model name in camel words, a :free suffix kept as Free, unique against taken aliases")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#syncProposals" :text "(provider name alias status) for every added free model: the probe status, skipped when probing was turned off, or known<status> when CAL saw it refused for good")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#syncPatchText" :text "the proposed config patch: model rows to add for probe-ok models, their aliases at the tails of the pool profile's code and any routes, and aliases that leave their chains as gone or no longer free")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#syncCalText" :text "the FREE-SYNC calibration row: per-provider counts, added with probe status, removed, changed and skipped providers")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#syncListText" :text "the current free-model list per provider")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#modelsSyncCli!" :text "asl gateway models sync (or asl run asl/packages/asl-gateway/src/cliDispatch.asl models sync): reads the config and CAL/freeModels.asn (--cal), fetches /models (or --fixtures), probes new and transiently failing free models once, writes the list, the calibration row and the patch under --out (default ~/.asl/run/gwsync); never writes the config")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#calStatus" :text "the status the last FREE-PROBE row recorded for a provider model, read from its (provider \"name\" :vps S ...) entry, or none")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#toProbe" :text "the added models worth probing: unseen ones and those CAL last saw fail with 429, 503 or a timeout; 400-404 and 413 are not probed again")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#fixed3" :text "a number as text with exactly three decimals, rounded")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#entryToken" :text "in a CAL text, the token after a key inside the (provider \"name\" ...) entry, reading newlines as spaces so wrapped rows match; none when absent")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#calOkRate" :text "the share of a model's FREE-PROBE :vps and :mac probes that answered 200; 0.5 with no probe")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#freeCalScore" :text "FREE-CAL score of a gateway model row: its (:cell ...) for the intent by row id, else by provider and model name, else its (:modelScore ...) by row id; null or no row is none; empty intent asks for the overall score")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#RouteEdit" :text "one per-route lead decision of models pace: alias, PROFILE/INTENT route, weight (0 drops the alias from that chain, N fixes its spread weight)")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#PaceSet" :text "one --set row of models pace: model alias, :key and its value as ASN text")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#saturatedQuality" :text "quality of a FREE-CAL cell on a saturated intent: score x n/(n+infra) x 1/(1+ms/10000); none without the cell or with no counted call")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#qualityOf" :text "quality 0..1 of a model row for an intent: on grade, plan, research and any the reliability-and-speed quality of its FREE-CAL cell; otherwise its FREE-CAL score (cell, else overall), clamped; else the probe ok rate")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#multiplierOf" :text "the value multiplier CAL/subMultipliers records for a model: a number, free, or unknown")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#spreadWeight" :text "spread weight of a model row on a route intent: max 1 of the rounded multiplier x quality; free models 8 x quality; unknown 1")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#daysLeft" :text "whole days from today to a renews date, at least 1")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#subRemaining" :text "100 minus the monthly :usedPercent of a subscription in the ledger, none when it has no figure")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#subRenews" :text "a subscription's quoted :renews date from the ledger, empty when absent")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#paceRpm" :text "requests per minute spending the remaining share of a monthly allowance evenly over the days left; with no remaining figure the full allowance over 30 days")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#emptySystemMessage?" :text "true for a system message whose content is empty, whitespace only or null")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#dropEmptySystem" :text "removes empty system messages from a body's messages array, leaving every other message as is")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#GatewayRoute.temperatureOverride" :text "a route's sampling temperature that wins over the model row's :temperature for every entry the route contributes; a client-sent temperature still wins; none keeps the model row default")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#applyPatchText" :text "pure step of models apply: splices a sync patch's :add model rows and :appendTail aliases into the config text, skipping rows and aliases already present; err when the patch names a missing profile, route or list; :leave rows are counted, never applied")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#modelsApplyCli!" :text "asl gateway models apply PATCH [--config PATH]: writes the patched config to a tmp file beside it, runs configCheck on the tmp text, then backs the config up as config.bak-DATE-MS and renames the tmp over it; any configCheck error or misfit patch refuses and leaves the config untouched; an already-applied patch is a no-op; only a lead runs it, nothing calls it automatically")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#GateVerdict" :text "the caller gate's verdict on an answer: passed, and the raw error when not")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#RouteReply" :text "one provider reply to a route step: HTTP status and text")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#RouteResult" :text "the outcome of a code route: passed, the stage that passed (writer or escalation, none for a failure), the answer text, the last error verbatim, the number of model calls and one alias:outcome trail entry per call")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#RouteStep" :text "the pure step machine of a code route: ask a model alias, gate an answer, or done with a RouteResult")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#routeAsk" :text "step: ask the alias with the prompt within timeoutSec, continuing with the reply")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#routeGate" :text "step: run the caller's gate on the text, continuing with its verdict")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#routeDone" :text "step: the route is finished with this result")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#codeRouteStart" :text "the first step of a code route: ask the writer alias with the task")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#codeRouteDrive!" :text "drives a code route to its result with the caller's ask and gate functions: writer retries, optional retryWriter, one escalation, then stop")
(:doc :symbol "asl/packages/asl-gateway/src/codeRoute.asl#retryPrompt" :text "the retry prompt: the task, the previous answer and the checker error verbatim, then an instruction to fix it")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#CodeRoute" :text "one declared code route: id, writer alias, retries, escalate alias, optional retryWriter alias, escalation timeout and retry count and the HTTP statuses retried on escalation")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayCodeRoute!" :text "the codeRoute row with the given id parsed from a whole gateway.asn text and its aliases checked against the same config's models; an unreadable config, a missing row or a malformed row is an error naming the cause")
(:doc :symbol "asl/packages/asl-gateway/src/router.asl#spreadSeedState" :text "the spread state of a member list after seed placements, so a gateway restart continues the rotation instead of restarting it")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#applySubPace" :text "applies a SUB-PACE patch (:spreads, :rpm, :models, :drops, :decisions; :budgets and :changes informational) to config text: replaces route spreads, sets model-row :rpm and fields, removes dropped aliases from every chain and spread, then the lead's dropRoute and weight decisions; returns the new text and the change list, or the first misfit (missing route, model row or weight target); an edit that already holds is not a change")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#patchHost" :text "the :host (mac or vps) a SUB-PACE patch is written for; models apply refuses a patch whose host is not this machine's")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin" :text "one window of a subscription: kind, length, reset time, used percent, source and the time the figure was taken")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.atMs" :text "epoch ms the figure was taken at, 0 when unknown")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.kind" :text "window kind: rolling, weekly, monthly, daily, primary or secondary")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.lenMs" :text "window length in milliseconds")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.resetsMs" :text "epoch ms of the window reset, 0 when unknown")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.src" :text "where the figure came from: opencodeApi, codexEvent, ledger or principal")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#PaceWin.used" :text "used percent of the window")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace" :text "the pacing verdict of one subscription: its most binding window, used percent against the even-pace allowance, the weight factor and the stale, expired, over and hard flags")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.allowance" :text "percent an even pace to the reset allows by now")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.atMs" :text "epoch ms of the binding figure")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.calls" :text "ledger calls since the monthly window start")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.expired" :text "true when the window reset has passed and the window is counted as fresh and unused")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.factor" :text "weight factor in 0 to 1.5: 0 drops the subscription out of a spread")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.hard" :text "true when the factor is 0")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.id" :text "subscription id")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.over" :text "true when used exceeds the allowance by more than softPoints")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.pace" :text "used divided by allowance")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.src" :text "source of the binding figure")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.stale" :text "true when the figure is older than staleAfterMs of its source")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.tokens" :text "ledger input plus output tokens since the monthly window start")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.used" :text "used percent of that window")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.window" :text "kind of the most binding window, none or exhaust")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#adjustSpread" :text "a route spread under pace: weights times 10 times the subscription factor, members at factor 0 removed so the rest of the chain puts them behind")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#factorsFromPaces" :text "the router cache: subscription id to factor permille, plus the time it was made under ~at")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#fixed1" :text "a number with one decimal")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#groupsOf" :text "the top-level parenthesised groups of a text, quotes honoured")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#hardPoints" :text "adopted: percentage points over the even pace at which a subscription leaves the spread")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#kindOf" :text "the kind name of a window group text such as (:monthly ...)")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#ledgerUse" :text "calls and input plus output tokens the ledger text holds for the providers of a subscription since a start time, by line scan")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#noData" :text "the pacing verdict of a subscription with no window and no ledger estimate: factor 1, stale")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#paceCacheFresh?" :text "true while the factor cache is younger than paceCacheMs")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#paceCacheKey" :text "the key under which the server keeps the factor cache in its spread state")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#paceCacheMs" :text "adopted: the factor cache lives one minute")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#paceSubs" :text "one pacing verdict per subscription of a subscriptions text at a time, ledger estimate included")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#parseTimeMs" :text "UTC epoch ms of 2026-11-13, 2026-11-22 18:00 or an ISO timestamp; 0 for a non-date")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#providerOf" :text "the provider part of a pool key such as commandCode:ccLingFlash")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#providerSub" :text "the subscription id a gateway provider draws on; a provider with no entry is its own subscription")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#quotedAfter" :text "the quoted string after a key in a text; empty when absent")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#rollReset" :text "a reset time moved forward by whole windows until it is not in the past")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#softPoints" :text "adopted: percentage points over the even pace before the weight starts to fall")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#staleAfterMs" :text "adopted: how old a figure of a source may be before it is stale; hand-entered 2 days, api and events 6 hours, ledger never")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#statusLine" :text "one (:subStatus ...) row: used, allowance, pace, factor, value, share, source, age and the stale, expired, over and hard flags")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#subCapacity" :text "requests per month of a subscription without a usage endpoint: its :capacity, else 75000 for commandCode, else 0")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#subId" :text "the :id of a subscription line")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#subLines" :text "the (:sub :id ...) lines of a subscriptions text")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#" :text "pure pacing core: from a subscriptions text, a ledger text and the clock, the used percent of each subscription window against an even pace to its reset, with a soft and a hard limit, and the spread adjustment the router applies")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#subProviders" :text "the gateway provider ids that draw on a subscription")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#tokAfter" :text "the token after a key in a text, up to a space or a closing paren; empty when the key is absent")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#winFactor" :text "weight factor from used percent and allowance: 1 within softPoints over, linear to 0.2 at hardPoints, 0 beyond or at 95 percent used, up to 1.5 when well under pace")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#windowsOf" :text "the windows of a subscription line; a window without :src or :at inherits the sub src word and the file :updated date")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#windowsSegment" :text "the parenthesised text after :windows in a subscription line, or empty")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#codexWindow" :text "the codex window of the latest rate_limits event whose primary window is not null in a session file text")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#ledgerMergeCli!" :text "asl gateway subs ledgerMerge: folds the old per-home stats ledger into the shared one via tmp and rename, shared kept as .bak, legacy renamed .merged")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#ledgerWindows" :text "ledger estimate windows for subscriptions with a capacity and no other fresh source")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#mergeWindows" :text "old windows with those of the same kind replaced by fresh ones, new kinds appended")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#mergedLedgerText" :text "the legacy ledger rows older than the first shared row followed by the shared rows")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#newestSessionFiles!" :text "the newest codex session files under a sessions dir laid out YYYY/MM/DD")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#numText" :text "a JSON number as ASN text")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#opencodeWindows" :text "windows from an opencodeGo usage body, one per rolling, weekly and monthly present, stamped src opencodeApi")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#paceFactors!" :text "the router factor cache read from HOME/.asl/subscriptions.asn and the ledger; empty when the subscriptions file is absent")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#refreshSubsText" :text "a subscriptions text with fresh windows merged into the named subs, every other byte kept")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#" :text "subs refresh, status and ledgerMerge: sources of subscription windows and the status view")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#subsRefreshCli!" :text "asl gateway subs refresh: merges opencodeGo usage, codex rate_limits and ledger estimates into subscriptions.asn via tmp and rename with a .bak")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#subsStatusCli!" :text "asl gateway subs status: one (:subStatus ...) row per subscription from the same pacing core the router uses")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#legacyLedgerPath" :text "the old per-home stats ledger path, folded into the shared ledger once by subs ledgerMerge")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#parseStampMs" :text "epoch ms of a stamp: Z or a +hh:mm suffix is taken as written, a stamp with neither is hand-entered local time read in the given zone")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#SubPace.known" :text "false when the used percent is unknown (no figure and no declared capacity); such a subscription keeps factor 1 on its time pace")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#pacePatchText" :text "the proposed patch: per-route spreads for freePool and paidCheap without dropped aliases, per-model rpm rows (opencodeGo by :reqMonth, commandCode plan models by weight share of the pool), --set model fields, drops, per-route lead decisions (--dropRoute, --weight), per-provider budget rows and (alias field old new) change rows")
(:doc :symbol "asl/packages/asl-gateway/src/subPacing.asl#modelsPaceCli!" :text "asl gateway models pace --date D [--set ALIAS :key VALUE]... [--drop ALIAS]... [--dropRoute ALIAS PROFILE/INTENT]... [--weight ALIAS PROFILE/INTENT N]...: reads config, multipliers, FREE-CAL scores, FREE-PROBE rows and the subscriptions ledger, writes the patch under ~/.asl/run/gwsync, exits 2 on an unknown alias, a route edit outside its chain or a weight below 1 and never edits the config")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#packAttrib" :text "attribution string of tag, session, turn and consumer joined by newlines")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#monthCapWindows" :text "capacity of the monthly window of a subscription line in rolling windows, 0.0 when absent or unparsable")
(:doc :symbol "asl/packages/asl-gateway/src/subPace.asl#perWindowAllowance" :text "percent of a rolling window allowed so the monthly remainder lasts to the month end, clamped to 1 to 80, and -1 without capacity, window length or time left")
(:doc :symbol "asl/packages/asl-gateway/src/subsRefresh.asl#kimiWindows" :text "rolling 5h and monthly window rows parsed from a Kimi usage response body, empty list when it does not parse or has no usages")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#usageCacheWrite" :text "cache creation token count of a usage object from cache_creation_tokens or cache_creation_input_tokens, none when neither is present")
(:doc :symbol "asl/packages/asl-gateway/src/affinity.asl#affinityDefault" :text "affinity defaults: on, a session sticks to its member for 1800 s, records are forgotten after 86400 s, a switch drops prior reasoning, a sticking member waits no longer than any other for its rpm token (affinityWaitSec 0)")
(:doc :symbol "asl/packages/asl-gateway/src/affinity.asl#affinityConfigFromText" :text "affinity rows from a gateway config text (:affinity :affinityStickSec :affinityForgetSec :affinitySwitch :affinityWaitSec), each absent or unparseable row keeping its default")
(:doc :symbol "asl/packages/asl-gateway/src/affinity.asl#affinityAnswer" :text "a session's affinity answer: empty when off, keyless or forgotten, else (alias stick drop wait) with stick and drop as 1 or 0 and wait the seconds a sticking member waits for its rpm token")
(:doc :symbol "asl/packages/asl-gateway/src/affinity.asl#affinityNote" :text "the affinity table with the session's answering member recorded at now and every record past the forget age removed")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayTopScalarOverride" :text "an optional top-level (:gateway ... :KEY V) value as a scalar, none when absent or the text does not parse")
(:doc :symbol "asl/packages/asl-gateway/tests/sessionAffinityTest.asl#runTests" :text "turns of one X-ASL-Session through the real chat cascade and server effects under a 1:1 spread: the session sticks to its first member, a breaker-forced switch drops the previous reasoning, :affinity false alternates, :affinitySwitch keep forwards reasoning, bad affinity rows fail config check")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#judgeDefault" :text "judge rules a judge-mode profile starts from: empty and truncated checks on, no step-form intents, step head (:step")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayProfileMode" :text "the :mode of a named profile (pin, route or judge), route for an unknown profile")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayProfileJudge" :text "the judge rules of a named profile, the defaults for an unknown profile")
(:doc :symbol "asl/packages/asl-gateway/tests/modesTest.asl#runTests" :text "pin, route and judge profiles through the real chat cascade and server effects with stubbed upstream replies: pin relays the first member's failure without a reroute, judge moves on empty, truncated and step-less replies that route returns, rows switch checks off, bad rows fail config check")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#decideIn" :text "the verdict for a call by provider and alias over a LimitScope: among the windowed limit rows whose scope contains the call, the spent one used up the furthest wins (limit:WINDOW), else the calendar window furthest ahead of an even spread plus a tenth paces (pace:WINDOW); none when nothing binds")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#coversIn" :text "whether a limit row's scope contains a call: account every alias of the provider, model one alias, group the aliases of the named group row for that provider, endpoint every provider whose base is the row's endpoint")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#covers?" :text "coversIn over an empty LimitScope: only account and model rows can match")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#usedCallsIn" :text "sent calls inside a limit row's window and scope")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#usedTokensIn" :text "input plus output tokens of the sent calls inside a limit row's window and scope")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#usedUsdIn" :text "cost in dollars of the sent calls inside a limit row's window and scope, input and output tokens at the models' per-million prices, an unpriced model costing 0")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#spentRatioIn" :text "how far a limit row is used up: the largest of calls, tokens, tokensIn, tokensOut, tokensCached and usd over their caps, 0 for a row without a window")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#Lease" :text "one concurrency slot held by a call in flight: provider, alias, the keys of the limits it counts against, and when it was taken")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#concurrencyOf" :text "the concurrency limits whose scope contains a call")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#liveLeases" :text "the leases younger than the lease time; older ones are treated as lost")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#full?" :text "true when any of the given concurrency limits already has as many leases under its key as its cap")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#admit" :text "takes a lease for a call under the keys of every covering concurrency limit")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#release" :text "frees the oldest lease of a provider and alias, once, and none when it holds none")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#limitKey" :text "the identity of a limit's scope used to count leases: scope, provider, model, group and endpoint")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayLimitErrors" :text "limit and group problems config check reports as errors: a malformed limit row, a group that is declared twice or names a model its provider lacks, a limit naming an undeclared group, :concurrencyLeaseSec outside 10..86400, :concurrencyPollMs outside 10..5000")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#GatewayGroup" :text "a (:group :id G :provider P :models (ALIAS ...)) row: the aliases of one provider that share every limit row naming the group")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#LimitScope" :text "the groups, provider bases and model prices a limit row needs to decide whether a call is in scope and what it cost")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#emptyLimitScope" :text "a LimitScope with no groups, bases or prices")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayLimitScopeFromText" :text "the LimitScope of a gateway config text: its groups, each provider's base and each model's price per million tokens; empty for text that does not parse")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#defaultConcurrencyLeaseSec" :text "600 s adopted: how long a call may hold a concurrency slot before it is treated as lost")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#defaultConcurrencyPollMs" :text "250 ms adopted: how often a call parked behind a full concurrency limit asks again")
(:doc :symbol "asl/packages/asl-gateway/tests/limitScopeTest.asl#runTests" :text "limit rows over group, endpoint, model and account scopes and the units calls, tokensIn, tokensOut, tokensCached, usd and concurrency: shared group budgets, the tightest limit binds, separate model budgets, lease take and release, config check rejections, a parked call sleeping and asking again until its queue budget, and the server freeing a slot on the sent usage row")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#JudgeRules" :text "the checks a judge-mode profile applies to a 200 reply: empty content with no tool calls, finish_reason length, and step intents whose answer must hold one of stepHeads")
(:doc :symbol "asl/packages/asl-gateway/tests/limitScopeFnsTest.asl#runTests" :text "direct cases for the scope-aware limit functions: limitKey names a row, covers? and coversIn decide whether a call is inside an account, model, group or endpoint row (an empty scope resolves no group or endpoint), usedCallsIn usedTokensIn usedUsdIn count only sent rows inside the window and scope, spentRatioIn is the most spent unit")
(:doc :symbol "asl/packages/asl-gateway/tests/affinityFnsTest.asl#runTests" :text "direct cases for the session-affinity functions: the default row, config text over the four affinity keys, the answer as the stick and forget windows pass, the note that records a member and drops stale sessions, and the ask and note effects as wire ops")
(:doc :symbol "asl/packages/asl-gateway/tests/configFnsTest.asl#runTests" :text "direct cases for config functions: the concurrency defaults, the empty and text-built limit scope (groups, bases, prices), limit and group errors of a parsed gateway row, top-level scalar overrides, and the mode and judge rules of a named profile")
(:doc :symbol "asl/packages/asl-gateway/tests/ledgerFnsTest.asl#runTests" :text "direct cases for ledger rotation and windows: the default keep, rotateWith! below, at and past the limit with rising generations, pruning and a held rotate lock, windowReadNewest! naming its window by the newest call, and ledgerSinceMs as the earliest budget window start")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#RpmRow" :text "a ramped per-model :rpm bucket rate for the model id alias, only ever above the configured :rpm")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#learnedRpmPath" :text "the learnedRpm.asn file under .asl/run/usage of a home that holds the ramped per-model rpm rates")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#rpmLine" :text "one rpm row as the ASN line written to learnedRpm.asn")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#rpmParse" :text "one learnedRpm.asn line back to its row; a line without alias or a numeric rate is an error, not a guess")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#readRpm!" :text "the ramped rpm rows of a file; a file that does not exist reads as no rows")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#writeRpm!" :text "the ramped rpm rows written through a temp file and a rename")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#rpmPass" :text "one ramp step for the per-model :rpm buckets: a model with its own :rpm (not a provider shared bucket) that our bucket refused and that no learned window ever saw answered 429 rises :learnRampPct percent of its current rate up to 8 times the configured one; stored rates are kept and never lowered")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#rampedModels" :text "the models with each matching ramped rpm swapped in where the model has an rpm of its own; a rate below the configured one is ignored")
(:doc :symbol "asl/packages/asl-gateway/src/learn.asl#rampedTableFor!" :text "the table a chat is judged against: as loaded, or with :learnRamp true the models ramped rpm buckets from learnedRpm.asn swapped in; an unreadable file leaves the table as loaded")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#rampedWorldTable!" :text "the loaded table with the ramped per-model rpm buckets swapped in when :learnRamp is on, an error table passed through")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#quotaPolicy" :text "Quota policy from base, max and slack seconds; a non-positive base becomes 15, a non-positive max 600 and never below the base, a negative slack 1.")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#defaultQuotaPolicy" :text "The quota policy 15, 600, 1 used when the config names none.")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#makeBreakerStateWith" :text "A breaker state with the cooldown (600 when not positive) and the quota policy, with the agy, codex and claude providers already marked seen.")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#breakerScope" :text "The key a failure counts under: a 401, 402, provider-wide quota or monthly cap is account-wide and counts on the provider pool, any other failure on the member own pool key.")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#quotaCooldownSec" :text "Cooldown after a 429: the provider hint when it names one, else the end of the member aligned window plus slack, else the base doubled per 429 in a row up to the max.")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#quotaHintSec" :text "Seconds a provider asks to wait, from its response headers (retry-after first) at the given time; 0 when none.")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#breakerNote429" :text "Record a 429 for a member: open it for quotaCooldownSec and count it toward the streak; a success clears the streak.")
(:doc :symbol "asl/packages/asl-gateway/src/browser.asl#isActionTerminal?" :text "True when a browser action receipt status ends the action: ok, timeout, auth_expired and the other final statuses.")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#parkedHoldMs" :text "the lane hold in ms for a concurrency 429 Retry-After in seconds: 0 when absent, the seconds clamped to 300 before conversion, 300000 when the value cannot be converted.")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#upstreamTools" :text "The upstream body with tools handled: tools and tool_choice removed when nativeTools is off, an empty tools array removed when dropEmpty is set.")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#effortDialectFor" :text "Dialect of a model effort for a provider: a row override wins, else a built-in per provider id, else reasoningEffort for any other openai-kind provider.")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#applyEffort" :text "Write the effort into the upstream body in the dialect; returns the body and the effort actually forwarded, none when nothing was written.")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#defaultBucketWaitSec" :text "Seconds a chain member before the last waits for its rpm bucket before the cascade moves on; default 5, adopted.")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayBucketWaitSecFromProps" :text "The bucket wait from the gateway properties, default when absent or not positive.")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#defaultQueueBudgetSec" :text "Seconds the last chain member waits for its rpm bucket when the caller gave no queue budget; default 30, adopted.")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayQueueBudgetSecFromProps" :text "The queue budget from the gateway properties; a non-positive value or one above the maximum keeps the default.")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayLimitWindows" :text "The window names a limit row may use: minute, hour, fiveHour, day, week, month.")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayLimitsFromProps" :text "The limit rows of the gateway properties, malformed rows dropped.")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayLimitsFromText" :text "The limit rows of config text.")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayLimitWarnings" :text "Warning lines for malformed limit rows, each named, never silent.")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayTopIntOverride" :text "An optional top-level gateway integer key read from config text; none when absent, unparseable or not an integer.")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#configKeyEqual?" :text "True when two config keys are equal: both builtin, or both file keys with equal parts.")
(:doc :symbol "asl/packages/asl-gateway/src/dispatch.asl#anyWarming?" :text "True when any slot of the wiring is still warming.")
(:doc :symbol "asl/packages/asl-gateway/src/getRoutes.asl#cockpitPath?" :text "True when the request path is one of the cockpit page or cockpit api paths.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#windowStartMs" :text "Start in ms of a limit window at now: a trailing window starts its length before now, a calendar window at its calendar start.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#windowEndMs" :text "End in ms of a limit window at now: now for a trailing window, the end of the calendar window otherwise.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#sentRow?" :text "True when a usage row counts as a sent call: its outcome is not a breaker, skipped, daily, limit, pace or throttled outcome.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#hasLimitFor?" :text "True when a group or endpoint limit exists, or a limit covers the provider and alias.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#usedCalls" :text "Calls counted against a limit in its window from the rows, under the empty limit scope.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#usedTokens" :text "Tokens counted against a limit in its window from the rows, under the empty limit scope.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#decide" :text "Verdict for a call on provider and alias against every limit and the held rows under the empty limit scope; none when no limit blocks it.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#seedTtlMs" :text "Milliseconds after which the held rows are reseeded from the shared ledger to pick up other writers; adopted 300 s.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#needsSeed?" :text "True when the rows were never seeded or the seed is older than seedTtlMs.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#longestStartMs" :text "The oldest instant any configured window can still count; rows before it are dropped at seeding.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#keepRows" :text "The rows at or after fromMs.")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#withOwnRow" :text "Add a row this server just wrote to the held rows, only once they were seeded.")
(:doc :symbol "asl/packages/asl-gateway/src/media.asl#isMediaTerminal?" :text "True when a media generation receipt status ends the job: ok, rejected, quota_exceeded and the other final statuses.")
(:doc :symbol "asl/packages/asl-gateway/src/omniApi.asl#dyckBalanced?" :text "True when the text has balanced delimiters.")
(:doc :symbol "asl/packages/asl-gateway/src/poolDispatch.asl#poolActive?" :text "True when the registry has calls, or a lane has queued or in-flight work.")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#stepShare" :text "Additive step of the learner as a share of the start rate, 0.2; adopted.")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#backoffFactor" :text "Multiplicative back-off the learner applies after a limit hit, 0.7; adopted.")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#hiShare" :text "The 429 share of an alias calls above which a window counts as a limit hit, 0.02; adopted.")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#countsOf" :text "Counts of one alias calls with fromMs <= at < toMs: all sent, those our bucket throttled and those the provider answered 429.")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#nextRpm" :text "Next rpm for an alias from the current rate and one window counts: a 429 share above hiShare decreases, throttled rows with no 429 increase, else hold; always within start/4 and max, max 0.0 meaning none.")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#clampTotal" :text "Scale the learned rates of a provider aliases down together when their sum exceeds its rpmTotal, each keeping its start/4 floor; total 0.0 means none.")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#learnAll" :text "One learning step over every spec from stored rates and the call lines of a window; returns the new rate per alias.")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#storeText" :text "The learned rates as store text.")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#parseStore" :text "The learned rates from store text.")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#readStore!" :text "The learned rates read from a store file; empty when it is absent.")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#writeStore!" :text "Write the learned rates to a store file.")
(:doc :symbol "asl/packages/asl-gateway/src/router.asl#spreadAvailable?" :text "True when an alias is free to take spread traffic: its breaker is not open and its last 429 is past the cooldown.")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#hubLearnedFrom" :text "Rate a bucket takes from the learner file: the lower of learned and configured when the incoming rate is already below its config, the learned rate at config, the incoming rate for a model with no row or a non-positive rate.")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#breakerStateFromConfig" :text "The breaker a loaded config text gets: cooldown, the 429 cooldown rows and the park ceiling, each absent row keeping its default.")
(:doc :symbol "asl/packages/asl-gateway/src/sync.asl#isProjectComplete?" :text "True when the project sync has reached the complete stage.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#inRanges?" :text "True when a code point lies in one of the range pairs.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#isPySpace?" :text "True when a code point is in the Unicode space ranges, whitespace the way Python str.isspace counts it.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#isEmptyContent?" :text "True when upstream message content is null, empty or only whitespace.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#looksProviderWideQuota?" :text "True when a response body reads as an account-wide quota failure: insufficient quota, or quota wording not scoped to one model.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#looksTransientText?" :text "True when a response body reads as a transient failure worth retrying.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#retryableHttpStatus?" :text "True when a status and body are worth a retry: a 429 that is not provider-wide quota or a daily cap, or a 502, 503 or 504.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#retryableTransportCode?" :text "True when a curl exit code is worth a retry: 7, 52 or 56.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#retryableRaised?" :text "True when a raised error, by its timeout flag and text, is worth a retry.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#firstByteDeadlineText" :text "The text no response bytes within the first-byte deadline, which chat.asl matches to note an attempt as firstByteTimeout.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#firstByteDeadlineAt" :text "Wall-clock ms of the first-byte deadline: startMs plus sec rounded up; 0 (no deadline) when sec is not positive.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#firstByteExpired?" :text "True when a deadline is set, no byte arrived and now is at or past it.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#firstByteWaitMs" :text "Milliseconds left until the first-byte deadline, not below 0; none when no deadline is set or bytes arrived.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#upstreamCallWithFirstByte" :text "The call with a first-byte deadline of sec from startMs.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#upstreamCallFirstByteExpired?" :text "True when the call has a deadline, no output yet and now is past it.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#upstreamCallFirstByteWaitMs" :text "Milliseconds the call may still wait for its first byte; none when no deadline applies or output arrived.")
(:doc :symbol "asl/packages/asl-gateway/src/upstream.asl#upstreamCallOpen?" :text "True when any of the call pipe ends (stdin, stdout, stderr) is still open.")
(:doc :symbol "asl/packages/asl-gateway/src/usage.asl#pyTruthy?" :text "Python truthiness of a JSON value: null, false, zero, empty string, array and object are false.")
(:doc :symbol "asl/packages/asl-gateway/src/wire.asl#isToolCall?" :text "True when a reply text starts with a tool call form, (:call :tool or (call :tool.")
(:doc :symbol "asl/packages/asl-gateway/src/wire.asl#isDeclarativeAsn?" :text "True when a text starts with a declarative form such as (:struct or (:ast.")
(:doc :symbol "asl/packages/asl-gateway/src/wire.asl#wantsAsnPairs?" :text "True when the accept header is application/asn+sexpr or the x-asl-wire header is asn.")
(:doc :symbol "asl/packages/asl-gateway/src/wire.asl#fallbackErrorText" :text "the trimmed upstream error text, cut to 500 bytes at a UTF-8 character start, or fallbackErr when empty")
(:doc :symbol "asl/packages/asl-gateway/tests/limitSeededTest.asl#runTests" :text "end-to-end cases for the ledger seeding of the window counts through runEffect! and effLimit on a real ledger file: the first ask seeds the held rows, an ask within the seed ttl does not see a call appended meanwhile, a fresh loop does, and rows outside the window or of another provider do not count")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#ReqRow" :text "one row of gatewayRequests.asn: the request id, its phase accepted or done, the time, and for a done row the outcome, status and milliseconds")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#ReqInfo" :text "an accepted request the server still holds: connection fd, id, start time and, once its reply is rendered, the outcome and status its done row carries")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#defaultRequestDeadlineSec" :text "900 seconds, the age after which an unfinished request counts as stuck")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#reqPath" :text "the gatewayRequests.asn file under .asl/run/usage of a home")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#reqAcceptLine" :text "the ASN line of an accepted row")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#reqDoneLine" :text "the ASN line of a done row with its outcome, status and milliseconds")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#reqParse" :text "one request-log line back to its row; a line without id, phase or time is an error")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#readReqs!" :text "the rows of a request log; a missing file reads as no rows")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#noteAccept!" :text "appends the accepted row of a request")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#noteDone!" :text "appends the done row of a request")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#unresolvedRows" :text "the accepted rows that have no done row")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#recoverLost!" :text "at server start turns every accepted row with no done row into a done row with outcome lost, drops resolved accepted rows and done rows older than the retention; returns how many were lost")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#completeLines" :text "the non-empty lines of a request log text up to its last newline; a final row without a newline is half written and not counted")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#tornTail!" :text "true when the request log ends in text without a newline, a half written row that recovery drops")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#quarantineCorrupt!" :text "when the request log has a corrupt row it cannot read, renames it to gatewayRequests.asn.corrupt-<nowMs> so the log starts fresh; returns the new name, none when the log reads clean")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#statusOfWire" :text "the HTTP status of a rendered reply, 0 when the text is not a reply head")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#outcomeOfWire" :text "the outcome of a rendered reply: 2xx ok; from the gateway 429 limit, 503 noRoute, 504 timeout, other gatewayError; from an upstream 504 or 408 timeout, other upstreamError")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#stuckRows" :text "the unresolved rows older than the deadline")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#lostSince" :text "how many requests ended lost at or after a time")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#requestDeadlineFromText" :text "(:gateway ... :requestDeadlineSec N) with N in 1..86400, else 900")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#defaultRequestKeepRows" :text "how many done rows recovery keeps by default: 100000")
(:doc :symbol "asl/packages/asl-gateway/src/requestLog.asl#requestKeepRowsFromText" :text "(:gateway ... :requestKeepRows N) of the config text: how many done rows recovery at server start keeps, newest first, on top of the 7 day retention; default 100000, only 100..10000000 is taken")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#dispatch!" :text "routes one parsed request: GET /hub/status, GET /health, else the authenticated path where the request gets its id and accepted row; exported for the request accounting test")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#HttpRequest" :text "a parsed request: method, path, headers and body")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#sharedRollup" :text "the day rollup of the shared ledger from the config text and the ledger path: :ledgerRollupPath or the ledger path with .days, :ledgerRollupKeepDays only when it is 62..3660, else 62; exported for limitLongWindowTest")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#seedSinceMs" :text "where a ledger seed starts reading: the later of the longest window start and the rollup's :last, never later than 24 h before now; exported for limitLongWindowTest")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#acceptReq!" :text "an authenticated request is accepted: it gets an id, an accepted row in gatewayRequests.asn and an entry in the loop's open requests")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#finishReq!" :text "the one done row of an open request, written where its connection closes: clientGone when the write to the client failed, else the outcome of the reply")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#failureReason" :text "a failed attempt ledger reason: status and reason plus the first 400 bytes of the body cut at a UTF-8 character start, the curl exit and text, or the tool or protocol detail")
(:doc :symbol "asl/packages/asl-gateway/tests/requestLogTest.asl#runTests" :text "every accepted request ends in exactly one done row: seven replies of different outcomes through the real stepWriting! on loopback sockets including a dropped client, a restart losing the unfinished request once, the stuck listing and the row lines")
(:doc :symbol "asl/packages/asl-gateway/tests/dailyShorthandTest.asl#runTests" :text "direct cases for the provider :dailyCalls shorthand: the account day row in the parsed table and the text read, the fifth call spending a limit of five, no row for a missing, zero or negative number (zero and negative warn), and an explicit :limits row staying beside it")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#HealthRow" :text "what the usage ledger shows of one provider and alias (or a whole provider with an empty alias) over a window: sent calls, ok calls, upstream 429s, own refusals, other failures, p50 and p95 latency of ok calls and the tokens in, out and cached")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#healthRows" :text "one row per provider and alias seen in the rows, busiest first")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#providerRows" :text "one row per provider summing its aliases, busiest first")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#pruneCandidates" :text "the rows with an ok share under 20 percent over at least 30 sent calls")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#neverServed" :text "the configured aliases that have no ok call in the rows")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#attemptsPerTurnX100" :text "average sent attempts per session and turn times 100, over the rows that carry both; 0 when none do")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#requestsText" :text "the request accounting of the window as ASN: accepted, done, lost, stuck now and the done rows per outcome")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#healthRowText" :text "one health row as an ASN line")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#healthReport" :text "the ASN health report of the ledger rows and request rows of the last hours: providers, models, request accounting, prune candidates, aliases that never served and attempts per turn")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#defaultHealthHours" :text "24, the default window of gateway health")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#pruneMinCalls" :text "30, the least sent calls before a low ok share makes a prune candidate")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#pruneOkPercent" :text "20, the ok share under which a model with enough calls is a prune candidate")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#healthDir" :text "the directory under .asl/run/usage where gateway health --write puts its reports")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#healthFileName" :text "the file name of a report written at a time")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#defaultHealthKeep" :text "how many health report files --write keeps by default: 60")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#healthKeepFromText" :text "(:gateway ... :healthKeep N) of the config text: how many health report files --write keeps, newest first; default 60, only 1..10000 is taken")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#staleHealthFiles" :text "the health-<ms>.asn names among the given names that are older than the newest keep, oldest first; other names are never listed")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#pruneHealthFiles!" :text "removes the stale health report files of a directory and returns how many it removed")
(:doc :symbol "asl/packages/asl-gateway/src/health.asl#hoursOfArgs" :text "--hours of gateway health: absent is 24, a whole number 1..720 is taken, a missing, non-numeric or out of range value is an error")
(:doc :symbol "asl/packages/asl-gateway/tests/healthTest.asl#runTests" :text "a fixture ledger with known counts gives the exact health report: model and provider counts, ok share, 429 against own refusals, p50 and p95, tokens, prune candidates, never served, attempts per turn, the request accounting and the window cut")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#sentOutcome?" :text "true when a call row's outcome reached the provider: not a breaker, skipped, daily, limit or pace answer and not throttled; the rule limits sentRow? and the day rollup share")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#DayRow" :text "one UTC day of sent calls for a provider and alias folded from pruned ledger generations: calls, input, output and cached tokens, and :lastMs, the newest call folded in")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#Rollup" :text "where a ledger's day rows live (:path, empty for none) and how many days before the newest one they keep (:keepDays)")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#noRollup" :text "the Rollup that writes no day rows; rotateWith! and appendCallRowWith! use it")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#defaultRollupKeepDays" :text "62: two months of day rows, enough for any month window")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#defaultRollupPath" :text "the day-row file of a ledger: its path with .days, a name generations! never takes for a generation")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#dayRowLine" :text "one (:day :day D :provider P :alias A :calls N :in N :out N :cached N :last MS) line")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#dayRowParse" :text "a day row from one line, none for a line that is not a (:day ...) form with a day and a provider")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#foldCalls" :text "adds every sent call row to the day row of its UTC day, provider and alias, creating it when absent")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#keptDays" :text "the day rows within keepDays of the newest day row, anchored on the data rather than the clock")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#daysThrough" :text "the newest :lastMs of the day rows, 0 for none: live rows at or before it are already counted in them")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#readDays!" :text "the day rows of a rollup file; an empty path or a missing file is none, a read error is an error and a line that does not parse is left out")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#writeDays!" :text "replaces a rollup file with the given day rows through a .tmp file and a rename, so a reader sees the old or the new file whole")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#rotateRolled!" :text "rotateWith! that folds each generation it prunes into the Rollup's day rows first; a generation that cannot be rolled up is kept and the error returned")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#appendCallRowRolled!" :text "appendCallRowWith! over rotateRolled!; a rotation or rollup error still appends the row and is returned for the caller to log")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#windowStartFor" :text "the start of a limit row's window at nowMs: windowStartMs, except a month window with :resetDay above 1, which starts on that day of the month clamped to its last day")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#windowEndFor" :text "the end of a limit row's window at nowMs, the next start for a month window with :resetDay")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#spentRatioWith" :text "how spent a limit row is at nowMs over live rows and day rows, in its most spent unit; usd of a day row comes from its tokens at the model's price")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#paceRatioWith" :text "how far a calendar row is ahead of its pace: an even spread of the cap plus a tenth, or with :pace remaining what was spent before today plus what is left over the days left times today's share plus a tenth; 0 for a trailing window (minute, hour, fiveHour, rollingDay) or :pace off")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#decideWith" :text "decideIn over live rows and the shared ledger's day rows, so a week or month row counts calls of pruned generations; the server decides with it")
(:doc :symbol "asl/packages/asl-gateway/tests/limitLongWindowTest.asl#runTests" :text "GW-LIMIT-LONG-WINDOW cases: month and week windows count day rows of pruned generations once, trailing windows do not, :resetDay starts and clamps the month, :pace remaining spreads what is left over the days left, rotation folds sent calls into day rows, the server seeds them, and config check bounds the new rows")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#dayRowsOf" :text "the day rows of a rollup text and the count of non-empty lines that are not day rows; readDays! prints one (:gwLedger :status :dayRowsDropped :path P :count N) row when that count is above 0")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#generationThrough" :text "the newest :at of a generation's sent calls, 0 when it has none; a generation whose mark is at or before the day rows' :last was folded already and is not folded again")
(:doc :symbol "asl/packages/asl-gateway/src/usageLedger.asl#pruneGenerations!" :text "rolls each generation beyond keep into the day rows, then removes it; a generation that cannot be rolled up or removed stays and the error is returned; a retry after a failed removal skips the fold by the generationThrough mark, so no call is counted twice")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#" :text "Capability-ordered chains (GW-CAP-ORDER): a pure ranking of a route chain from measured per-alias stats, no model call; refreshed and written back by `gateway order`, never per request, and off unless a route row says :order measured.")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#AliasStat" :text "measured stats of one alias: journal attempts and green units, ledger calls, ok calls and limit hits, free cap in permille (-1 unknown) and the newest evidence time")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#OrderOpts" :text "per route options from :order measured: explore percent, refreshS, minSamples, staleS, the aliases turned off by :orderOff and the last write-back time :orderAt")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#Ranked" :text "the ranking of one route: chain best first with explored aliases last, a non-negative integer weight per chain alias, the explored aliases and the excluded ones")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#defaultOrderOpts" :text "the options a route without explicit numbers gets: explore 12, refreshS 86400, minSamples 5, staleS 604800, nothing off")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#untestedStat" :text "the stat of an alias with no evidence at all, which is always explored")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#aliasScore" :text "permille score: unit yield (or call success rate when no attempts, 500 with neither) times call success times the cap left after limit hits, integer arithmetic only")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#exploring?" :text "true while an alias has fewer samples than minSamples or evidence older than staleS")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#rankChain" :text "orders a chain by score with chain position breaking ties, gives the exploration share to untested or stale aliases, keeps every alias (turned off ones are listed as excluded)")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#spreadWeights" :text "the positive weights of a ranking as :spread pairs; a zero weight stays in the chain only")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#refreshDue?" :text "true when the last write-back is at least refreshS old or never happened")
(:doc :symbol "asl/packages/asl-gateway/src/capOrder.asl#orderOptsOfProps" :text "reads :order measured and its options from a route property map: none without :order, an error text for a bad value or an out of range number")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#" :text "Readers and write-back for capability ordering: ledger call rows and conductor journal rows into alias stats, the config rewrite of due :order routes, and the gateway order command.")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#JournalRow" :text "one conductor journal transition row: unit, target state, stage, model, verdict and time; the journal carries the writer model, not a profile or lane")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#journalRowOf" :text "one journal line as a row, none for any other row kind or an unreadable line")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#journalStats" :text "per model write attempts and green units from journal text since a time; a merged unit credits the model of its last write row, provider failures, rebases and stall requeues are no attempts")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#ledgerStats" :text "per alias calls that reached the provider, ok calls, limit hits and free cap from gateway call rows since a time")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#measuredStats" :text "ledger stats and journal stats unioned by alias")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#orderConfigText" :text "rewrites :chain, :spread and :orderAt of every due route carrying :order measured, one receipt row per such route; a config without :order comes back byte for byte")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#orderCli!" :text "asl gateway order [--config P] [--ledger P] [--journal P] [--now MS] [--windowH H] [--apply]: ranks, prints receipts, and with --apply writes the config through a backup after config check passes")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#routeSpan" :text "source span of one profile route in a config text, or -1 -1")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#setField" :text "sets a key inside a form span: replaced, appended when absent, untouched when equal")
(:doc :symbol "asl/packages/asl-gateway/src/modelSync.asl#todayUtc!" :text "the UTC date used in backup file names")
(:doc :symbol "asl/packages/asl-gateway/tests/capOrderTest.asl#runTests" :text "capability ordering: score order, exploration share, stale and untested aliases, turned off aliases, none dropped, stable ties, refresh gate, ledger and journal readers on fixture rows, config check of :order rows, and the write-back with its default-off pass through")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#modelNames" :text "(alias upstream-name) for every model row of a gateway config text")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#aliasesOf" :text "every alias whose upstream name matches a journal model string ignoring case and a provider/ prefix; unknown and empty never match")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#configUnchanged!" :text "true when a file still holds exactly the text it was read as; checked before the rename so a concurrent config writer is not overwritten (ERR_CONFIG_CHANGED)")
(:doc :symbol "asl/packages/asl-gateway/src/capOrderStats.asl#commitOrdered!" :text "the write step of gateway order: backup, tmp file, a between hook, a config unchanged check and the rename; ERR_CONFIG_CHANGED refuses and writes nothing")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#" :text "Context window and max output read from a provider /models payload (MODELS-CTX-SYNC): field names in two tables, rows next to the configured :contextBudget and :maxTokens, a report, and a models apply patch.")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#Window" :text "listed context window and max output in tokens, 0 when the payload has no field for it")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#WindowRow" :text "one config alias against its provider list: listed window and max output, configured budget and max tokens (-1 none), the values apply would write (-1 no change) and a status ok, same, unlisted or nofield")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#contextFields" :text "the context window field paths in first-match order, one per payload shape (context_length, context_window, max_model_len, inputTokenLimit, top_provider.context_length)")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#maxOutFields" :text "the max output field paths in first-match order (top_provider.max_completion_tokens, max_output_tokens, max_completion_tokens, max_tokens, outputTokenLimit)")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#itemWindow" :text "the window of one listed item: first positive number among the field paths, from a JSON int, float or numeric string")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#listedWindows" :text "(id window) for every item of one /models body with an id, a models/ prefix dropped; an item without fields has window 0 0; a body that is not JSON is ERR_MODELS_JSON")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#windowRows" :text "one row per config alias of the provider: contextBudget = min(listed window, cap), maxTokens lowered only when above the listed max output, unlisted and field-less rows unchanged")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#defaultContextCap" :text "the context cap when no flag and no :contextCap config row says otherwise: 200000, adopted until the context-overflow hop lands")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#capOfConfigText" :text "the top-level :contextCap number of a config text, the default when absent or not positive")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#windowsReportText" :text "the windows report of a sync run: the cap and every row")
(:doc :symbol "asl/packages/asl-gateway/src/modelWindows.asl#windowsPatchText" :text "a models apply patch in the SUB-PACE shape with one (:set :model ALIAS FIELD VALUE) per change")
(:doc :symbol "asl/packages/asl-gateway/tests/modelWindowsTest.asl#runTests" :text "fixture /models payloads of every shape incl a missing field, window rows and the cap, the patch applied by models apply's text step, and the sync CLI writing the windows report and patch without touching the config")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#promptEstimate" :text "the gateway's prompt token estimate: a quarter of the serialized messages")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#contextOverflowError?" :text "true for a 400, 413 or 422 provider reply whose body names a context length, context window or a too long prompt")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#maxBudgetOf" :text "the largest declared contextBudget among the loop members, 0 when none declares one")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#byBudget" :text "members ordered by declared contextBudget, largest first, ties in chain order, members without a budget last")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayProfileBudgetFirst" :text "a named profile's :budgetFirstAbove token threshold, 0 for an unknown profile or none set")
(:doc :symbol "asl/packages/asl-gateway/tests/ctxRouteTest.asl#runTests" :text "context routing on the chat state machine with scripted replies: overflow hops to a larger window, no fit answers typed contextTooLarge 413 with X-ASL-Max-Context, an overflow keeps its breaker event, pin relays the upstream overflow unchanged, replies carry maxContextTokens, :budgetFirstAbove orders a large prompt largest window first")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#gatewayContextCap" :text "the top-level :contextCap ceiling for model :contextBudget rows written by models sync and apply, 200000 when absent")
(:doc :symbol "asl/packages/asl-gateway/tests/affinitySpreadTest.asl#runTests" :text "a session sticks across a spread profile with shared busy rpm buckets: the stuck member goes first past the spread order, yields at once when paced by default (opt-in :affinityWaitSec waits), a switch records a skippedSwitch note and the reply names switchedFrom in JSON and ASN, no session keeps the spread order")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#admissionDir" :text "home: the shared admission state directory, home/.asl/run/gwAdmission, holding leases.tsv, the lock file and one lane file per provider and alias")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#admitShared!" :text "home lims provider alias now leaseMs: under the home lock loads leases and the lane, tries tryAdmit and saves both; ok true when admitted, ok false when full, err when the lock, state read or write fails")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#baseOf" :text "lims: the limit row whose count the lane cap replaces, the first model-scope row else the first row, none for an empty list")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#concurrency429!" :text "home lims provider alias now: after an upstream 429 naming concurrency, frees the lane's oldest lease and lowers the lane cap by dropOnConcurrency429, returning the new cap; ok 0 when lims has no base row, err when the lock or state fails")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#dropOnConcurrency429" :text "lane base inFlight now: the lane after a concurrency 429, cap max(1, min(current cap, inFlight) - 1), ok count reset to 0 and last429 set to now")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#effectiveLimits" :text "lims lane: lims with the base row's concurrency replaced by the lane cap, other rows unchanged; lims itself when there is no base row")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#growQuietMs" :text "the quiet period without a concurrency 429 before a lane cap may rise, 600000 ms")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#growStreak" :text "the successes in a row needed before a lane cap may rise, 20")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#Lane" :text "learned admission state of one provider and alias: cap Int64 (0 means not yet learned), ok Int64 (successes since the last change), last429 Int64 (ms time of the last concurrency 429)")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#laneCap" :text "lane base: the lane cap clamped to maxCapOf base when above 0, else the base row's concurrency")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#laneInit" :text "a fresh Lane with cap 0, ok 0 and last429 0")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#maxCapOf" :text "base: the highest cap a lane may reach, max(base.max, base.concurrency) when base.max is above 0, else twice base.concurrency")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#parseLane" :text "text: reads a lane file, tab separated gwAdmission1 cap ok last429, into ok Lane; err on a wrong header or field count, a non-integer field or a negative field")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#parseLeases" :text "text: reads the lease registry, a gwAdmission1 header line then one tab separated provider alias atMs keys row per line, into ok leases; err on a malformed header or any malformed row")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#raiseOnSuccess" :text "lane base now: counts one success; at growStreak successes with at least growQuietMs since last429 and the cap below maxCapOf the cap rises by 1 and ok resets to 0, otherwise the cap holds and ok grows")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#releaseShared!" :text "home lims provider alias now ended: under the home lock frees the lane's oldest lease, and when ended is true also counts a success through raiseOnSuccess; ok true, err when the lock or state fails")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#renderLane" :text "l: the lane file text, tab separated gwAdmission1 cap ok last429 and a newline")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#renderLeases" :text "ls: the lease registry text, a gwAdmission1 header line then one tab separated provider alias atMs keys row per lease")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#tryAdmit" :text "leases lane lims provider alias now leaseMs: prunes expired leases, then admits only when every applicable limit under effectiveLimits has room; returns (true, leases plus the new lease) or (false, the live leases)")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#breakerIsConcurrency429" :text "status body: true when status is 429 and the lowercased body contains concurrent, a provider concurrency cap rather than a spent quota")
(:doc :symbol "asl/packages/asl-gateway/src/affinity.asl#AffinityConfig" :text "Session affinity settings: on, stickSec, forgetSec, dropOnSwitch and waitSec")
(:doc :symbol "asl/packages/asl-gateway/src/affinity.asl#AffinityRecord" :text "A session's last answering member: alias and the time it answered")
(:doc :symbol "asl/packages/asl-gateway/src/breaker.asl#QuotaPolicy" :text "Breaker quota timing: baseSec, maxSec, slackSec and parkMaxSec")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#effAffinity" :text "session: effect asking the server for a session's last answering member as alias stick drop, or none")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#effAffinityNote" :text "session alias: effect recording that alias answered the session")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#effLimit" :text "provider alias: effect asking the reactor whether a provider limit window is spent for this member; empty to go ahead, else (outcome reason)")
(:doc :symbol "asl/packages/asl-gateway/src/config.asl#GatewayLimit" :text "One provider limit row: provider, scope, model, window, call and token caps, groups, endpoint, token splits, usd, concurrency, max and pace")
(:doc :symbol "asl/packages/asl-gateway/src/limits.asl#Verdict" :text "A limit decision: outcome and reason")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#Counts" :text "Calls of one alias in a window: all sent, throttled by our bucket, and real 429s")
(:doc :symbol "asl/packages/asl-gateway/src/rateLearn.asl#Spec" :text "A learned rate spec: alias, provider, start and max rpm")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#effConcurrency429" :text "provider alias: effect telling the server an upstream 429 named concurrency, so it frees this call's lease and lowers the lane cap before chat parks and asks admission again")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#sseToChat" :text "body: folds an OpenAI SSE reply into one chat.completion JSON string, joining content and reasoning deltas and tool call deltas, the last finish_reason and the usage chunk; none when no event parses, a payload is not a JSON object or has an error key, an event: error arrives, or no finish_reason came")
(:doc :symbol "asl/packages/asl-gateway/src/chat.asl#streamBody" :text "on api body: when on is true, api is chat and body is an object, sets stream true and stream_options include_usage true; otherwise body unchanged")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#arxivParse" :text "r: arXiv Atom reply into a response with one row per entry (engine arxiv, score 0.8, snippet the summary); an error object on a transport failure or non-2xx status")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#arxivReq" :text "query limit: GET export.arxiv.org/api/query with search_query=all:query and max_results=limit, Accept atom+xml, timeout 15 s")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#braveParse" :text "r: Brave web search reply into a response with one row per web.results entry (engine brave, score 0.88, snippet the description); an error object on failure")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#braveReq" :text "query limit key: GET api.search.brave.com/res/v1/web/search with q and count=limit, X-Subscription-Token key, timeout 10 s")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#cdxParse" :text "r: Wayback CDX JSON array reply into a response with one row per record (engine cdx, score 0.75, snippet Archived at stamp with status code), skipping the header row and rows with no original url; an error object on failure")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#cdxReq" :text "url limit: GET web.archive.org/cdx/search/cdx for url with output=json, limit and fields timestamp,original,statuscode, timeout 15 s")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#engineOrder" :text "the tier 1 engine names in preference order, synthetic then brave")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#enginePlan" :text "st query limit: the (name, request) pairs of the tier 1 engines in engineOrder whose request can be built, an engine with no API key in st.env left out")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#engineReq" :text "st name query limit: the request for the named engine (synthetic, tavily, brave, wiki, serper, arxiv, wayback, cdx, iasearch); none when the engine needs an API key that is absent or empty in st.env or the name is unknown")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#iasearchParse" :text "r: Internet Archive advancedsearch reply into a response with one row per response.docs entry (engine iasearch, score 0.75, url archive.org/details/identifier, title falling back to the identifier), skipping docs with no identifier; an error object on failure")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#iasearchReq" :text "query limit: GET archive.org/advancedsearch.php with q, fl identifier and title, rows=limit and output=json, timeout 15 s")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#parseEngine" :text "name r limit: dispatches the reply to the named engine's parser (synthetic, tavily, brave, wiki, serper, arxiv, wayback, cdx, iasearch); json null for an unknown name")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#selectEngine" :text "datas: from (name, response) pairs returns (the first pair whose response is good, the error rows of every response carrying an error); good means non-empty, no error and some results")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#syntheticParse" :text "r: Synthetic search reply into a response with one row per results entry (engine synthetic, score 0.95, snippet the joined highlights else the first 300 chars of text, text capped at 20000); an error object on failure")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#syntheticReq" :text "query limit key: POST api.synthetic.new/v2/search with a JSON body holding only query (limit is unused), Bearer key, timeout 10 s")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#tier1Search!" :text "st query limit: runs every planned tier 1 engine request in one curl batch, parses each reply and merges them with tier1Select; returns (result, st) with st unchanged")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#tier1Select" :text "datas limit: merges the good engine responses in engineOrder with duplicates dropped up to limit; answer from the first good response that has one; returns an object with answer, results and errors")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#tier2Order" :text "the tier 2 fallback engine names in order, tavily then serper")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#tier2Select" :text "datas limit errs: takes the first good response of datas and merges its rows up to limit, accumulating error rows of the rejected ones; with none good returns an empty answer and results plus all errors")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#waybackParse" :text "r: Wayback availability reply into a response with at most one row for the closest snapshot (engine wayback, score 0.8, url the raw id_ page, snippet Closest snapshot url at stamp); no rows when stamp or original url is missing; an error object on failure")
(:doc :symbol "asl/packages/asl-gateway/src/search.asl#waybackReq" :text "url: GET archive.org/wayback/available for url, Accept json, timeout 10 s")
(:doc :symbol "asl/packages/asl-gateway/tests/adaptiveAdmissionTest.asl#runTests" :text "adaptive admission: a concurrency 429 halves the lane cap to max(1, inFlight/2) once per burst, 20 successes after 600 s quiet raise it by 1 within the row max, lane and lease files round-trip and malformed ones are errors, a multi-scope admit is all or nothing through the shared registry, and chat absorbs a concurrency 429 without opening a breaker")
(:doc :symbol "asl/packages/asl-gateway/tests/archiveEnginesTest.asl#runTests" :text "the arxiv, wayback, cdx and iasearch engines: request urls and parameters from engineReq, and each parser turns a canned reply into rows with the expected title, url, snippet and engine, with headers and missing snapshots giving no row")
(:doc :symbol "asl/packages/asl-gateway/tests/emptyLengthTest.asl#runTests" :text "an empty reply with finish_reason length through the chat cascade is not retried on the same model, answers 502 ERR_EMPTY_LENGTH, and a cascade moves to the next member; an empty reply with another finish_reason keeps its same-model retry")
(:doc :symbol "asl/packages/asl-gateway/tests/gwErrFixTest.asl#runTests" :text "research fetchResult on a transport failure and on a decode failure: neither is reported as a crawled page and the error text and reason prefix are carried into the note")
(:doc :symbol "asl/packages/asl-gateway/tests/noThinkRetryTest.asl#runTests" :text "a reasoning row whose reply was cut empty is retried once on the same model: the first request sends reasoning_effort low and the retry none, while a normal reply sends one request")
(:doc :symbol "asl/packages/asl-gateway/tests/searchFallthroughTest.asl#runTests" :text "search engine order and fallthrough: tier 1 is synthetic then brave and tier 2 tavily then serper, enginePlan skips engines without keys, an error or empty engine falls through to the next, and synthetic rows map title, url, snippet, text and score")
(:doc :symbol "asl/packages/asl-gateway/tests/searchResearchParityTest.asl#caseOf" :text "line: parses one (:case ...) fixture line into a Case with id, kind, input JSON and expected output; none when the line or its input does not parse")
(:doc :symbol "asl/packages/asl-gateway/tests/searchResearchParityTest.asl#fixturePath" :text "the repo path of the recorded fixture, asl/packages/asl-gateway/tests/searchResearchFixture.asn")
(:doc :symbol "asl/packages/asl-gateway/tests/searchResearchParityTest.asl#replay!" :text "cases base: runs each Case, pure ones directly and network ones against a stand-in under base/id, and compares the output text with the recorded one; returns a Run of verdicts and wires, printing a MISMATCH line for each difference")
(:doc :symbol "asl/packages/asl-gateway/tests/searchResearchParityTest.asl#Run" :text "result of replaying a fixture: verdicts (List Verdict) and wires (List Wire)")
(:doc :symbol "asl/packages/asl-gateway/tests/sseStreamTest.asl#runTests" :text "SSE streaming: a model row with stream true sends stream and include_usage and its SSE reply is folded into one completion with content, reasoning and usage, a plain row sends neither, broken or truncated or error streams are unreadable, and a real curl round trip against a stand-in SSE upstream works")
(:doc :symbol "asl/packages/asl-gateway/tests/topPRowTest.asl#runTests" :text "a model row with topP sends top_p when the request has none, an explicit request top_p wins, a row without topP sends none, and config check rejects a topP outside 0..1 or a non-number")
(:doc :symbol "asl/packages/asl-gateway/tests/clipUtf8Test.asl#runTests" :text "fallbackErrorText, sanitizeAsnContent, failureReason and redactReason cut a CJK tail back to its character start instead of mid-character")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#concurrency429After!" :text "home lims provider alias now retryAfterMs: concurrency429! that also holds the lane for min(retryAfterMs, 300000) ms from now, never shortening a longer hold; 0 holds nothing; ok is the new cap")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#holdUntil!" :text "home provider alias: the epoch ms before which the lane admits nothing (a Retry-After hold), 0 when none is set or the file is unreadable")
(:doc :symbol "asl/packages/asl-gateway/src/admission.asl#dropGuardMs" :text "ms after a cap cut within which further concurrency 429s leave the cap alone, so one overload burst halves once; adopted 2000")
(:doc :symbol "asl/packages/asl-gateway/tests/admissionAimdTest.asl#runTests" :text "a fake upstream answering 429 above 2 in flight, driven through the real shared admission state: one halving per burst, regrowth by 1 per streak up to the static limit, Retry-After holds the lane and is clipped to 300 s")
(:doc :symbol "asl/packages/asl-gateway/tests/admissionWireTest.asl#runTests" :text "end to end through chat.asl and the server's real effect handler on a scratch HOME: a 429 naming concurrency with Retry-After 1 writes the lane hold file, the parked attempt writes one limit:concurrency429 ledger note and the resent call answers 200 and releases its lease")
(:doc :symbol "asl/packages/asl-gateway/src/bus.asl#" :text "The shared inbox of terminal Leon runs: one single-line ASN row per run in home/.asl/bus/events.asn, appended under a lock, read back whole, awaited with bounded sleeps instead of polling a process.")
(:doc :symbol "asl/packages/asl-gateway/src/bus.asl#BusEvent" :text "unit stop head gates exit asserts receiptPath at: one terminal run, at in epoch ms")
(:doc :symbol "asl/packages/asl-gateway/src/bus.asl#busPath" :text "home: home/.asl/bus/events.asn")
(:doc :symbol "asl/packages/asl-gateway/src/bus.asl#eventLine" :text "event: the single-line (:event :unit .. :stop .. :head .. :gates .. :exit N :asserts N :receiptPath .. :at N) text, strings escaped so it holds no newline")
(:doc :symbol "asl/packages/asl-gateway/src/bus.asl#parseEvent" :text "line: some event when every field is present with its type, none for a torn, empty or malformed row")
(:doc :symbol "asl/packages/asl-gateway/src/bus.asl#emitTerminal!" :text "path event: creates the directory and appends one whole row under the lock beside the file; err when the unit is empty, the lock stays busy past 400 tries of 5 ms, or the write fails")
(:doc :symbol "asl/packages/asl-gateway/src/bus.asl#readEvents!" :text "path: every complete parsable row in file order; a missing file is no events and a last line without its newline is left for the next read")
(:doc :symbol "asl/packages/asl-gateway/src/bus.asl#findEvent" :text "events unit sinceMs: the latest row of the unit with at >= sinceMs")
(:doc :symbol "asl/packages/asl-gateway/src/bus.asl#waitFor!" :text "path unit sinceMs deadlineMs: blocks until a row for the unit with at >= sinceMs appears or the clock reaches deadlineMs (epoch ms), sleeping at most pollMs between reads; none on the deadline")
(:doc :symbol "asl/packages/asl-gateway/src/bus.asl#pollMs" :text "the longest sleep between two reads in waitFor!, 200 ms")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#hubStatusStale?" :text "true when a hub status text carries :configStale")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#tokenSafe?" :text "false for a bearer token holding a double quote, backslash or a control byte (below 0x20, or 0x7f), which could break out of the curl config line")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#curlArgv" :text "the curl argv of the hub status fetch: --proto =http,https, config on stdin, url last")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#hubStatusFetch!" :text "GET url with the bearer on stdin via curl -K -; a token tokenSafe? refuses returns an err before curl starts")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#gatewayHubStatusCli!" :text "gateway hubStatus [--file F | --url URL] [--token-env NAME] [--strict]: prints the hub status, --strict exits 1 on :configStale, 0 clean, 2 unreadable; a stale config keeps serving the last good table, and a read error of gateway.asn counts as a bad edit")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#hubStatusText!" :text "the GET /hub/status (:hub ...) form; :configStale (:error ...) appears while the last good config shadows a file that does not load")
(:doc :symbol "asl/packages/asl-gateway/tests/hubStatusStaleTest.asl#runTests" :text "hubStatusText! renders :configStale for a stale cache; the strict hubStatus probe exits 1 stale, 0 clean, 2 unreadable; a read error of gateway.asn is held as :stale")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#staleHeaderName" :text "name of the response header a stale hub adds to every reply: X-Asl-Config-Stale")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#staleHeaderLine" :text "the header line for a stale error: line breaks folded, value capped at 300 characters, ends CRLF")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#staleMarked" :text "inserts the stale header after the HTTP status line of a first write; empty stale, a continuation chunk and an already marked reply come back unchanged")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#addConn" :text "queues a connection phase or a link write; a reply on a stale hub is marked with X-Asl-Config-Stale before it is queued")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#hubStaleWarning" :text "the one warning line a status client prints per call when the hub reports :configStale, naming the loader error; empty for a clean status")
(:doc :symbol "asl/packages/asl-gateway/src/cliDispatch.asl#configCheckFailLine" :text "the stderr line configCheck prints when the file fails: the file and that a running hub keeps its last good config")
(:doc :symbol "asl/packages/asl-gateway/tests/staleLoudTest.asl#runTests" :text "stale marker header, addConn write path, status warning line and configCheck failure line")
(:doc :symbol "asl/packages/asl-gateway/src/server.asl#requeueWriting" :text "puts the unwritten rest of a reply back on the socket unchanged; only a reply's first write is marked with the stale header")
