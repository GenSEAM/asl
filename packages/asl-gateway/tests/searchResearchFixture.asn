(:case :id "n342" :kind "net" :in "{\"routes\": [{\"status\": 200, \"reason\": \"OK\", \"headers\": [[\"Content-Type\", \"application/json\"]], \"body\": \"{\\\"choices\\\": [{\\\"message\\\": {\\\"role\\\": \\\"assistant\\\", \\\"content\\\": \\\"prefix (:researchReport :topic \\\\\\\"t\\\\\\\" :summary \\\\\\\"S\\\\\\\" :positiveSynthesis \\\\\\\"P\\\\\\\" :falsificationCritique \\\\\\\"F\\\\\\\" :facts ((:fact :id \\\\\\\"f1\\\\\\\" :predicate (:relation \\\\\\\"uses\\\\\\\" :subject \\\\\\\"Rust\\\\\\\" :object \\\\\\\"ownership\\\\\\\") :claim \\\\\\\"Rust uses ownership\\\\\\\" :evidence \\\\\\\"Rust uses ownership to manage memory\\\\\\\" :source \\\\\\\"https://s/1\\\\\\\" :verificationStatus :corroborated :isFalsifying false)(:fact :id \\\\\\\"f2\\\\\\\" :predicate (:relation \\\\\\\"hurt\\\\\\\" :subject \\\\\\\"GC pauses\\\\\\\" :object \\\\\\\"latency\\\\\\\") :claim \\\\\\\"GC hurts latency\\\\\\\" :evidence \\\\\\\"GC pauses hurt tail latency\\\\\\\" :source \\\\\\\"https://s/2\\\\\\\" :verificationStatus :unfalsified :isFalsifying true)) :sources (\\\\\\\"https://s/1\\\\\\\")) suffix\\\"}}]}\", \"url\": \"https://up2.example/v1/chat/completions\"}], \"breaker\": {\"groq\": 1300000}, \"calls\": [{\"fn\": \"research_extract\", \"args\": [\"t\", \"bipolar\", [{\"id\": \"item-1\", \"title\": \"T\", \"snippet\": \"Rust uses ownership to manage memory safely.\", \"url\": \"https://s/1\", \"crawled\": true}, {\"id\": \"item-2\", \"title\": \"T2\", \"snippet\": \"GC pauses hurt tail latency.\", \"url\": \"https://s/2\", \"crawled\": false}], [{\"alias\": \"A\", \"dispatch\": \"m-a\", \"upstream\": {\"provider\": \"groq\", \"url\": \"https://up.example/v1\", \"key\": \"\"}, \"params\": {}}, {\"alias\": \"B\", \"dispatch\": \"m-b\", \"upstream\": {\"provider\": \"openrouter\", \"url\": \"https://up2.example/v1\", \"key\": \"\"}, \"params\": {}}], false], \"clockMs\": 1000000}], \"upstreams\": {}}" :out "{\"results\": [{\"value\": {\"alias\": \"B\", \"model\": \"m-b\", \"props\": {\"topic\": \"t\", \"summary\": \"S\", \"positiveSynthesis\": \"P\", \"falsificationCritique\": \"F\", \"facts\": [[{\"atom\": \":fact\"}, {\"atom\": \":id\"}, \"f1\", {\"atom\": \":predicate\"}, [{\"atom\": \":relation\"}, \"uses\", {\"atom\": \":subject\"}, \"Rust\", {\"atom\": \":object\"}, \"ownership\"], {\"atom\": \":claim\"}, \"Rust uses ownership\", {\"atom\": \":evidence\"}, \"Rust uses ownership to manage memory\", {\"atom\": \":source\"}, \"https://s/1\", {\"atom\": \":verificationStatus\"}, {\"atom\": \":corroborated\"}, {\"atom\": \":isFalsifying\"}, {\"atom\": \"false\"}], [{\"atom\": \":fact\"}, {\"atom\": \":id\"}, \"f2\", {\"atom\": \":predicate\"}, [{\"atom\": \":relation\"}, \"hurt\", {\"atom\": \":subject\"}, \"GC pauses\", {\"atom\": \":object\"}, \"latency\"], {\"atom\": \":claim\"}, \"GC hurts latency\", {\"atom\": \":evidence\"}, \"GC pauses hurt tail latency\", {\"atom\": \":source\"}, \"https://s/2\", {\"atom\": \":verificationStatus\"}, {\"atom\": \":unfalsified\"}, {\"atom\": \":isFalsifying\"}, {\"atom\": \"true\"}]], \"sources\": [\"https://s/1\"]}, \"facts\": [[{\"atom\": \":fact\"}, {\"atom\": \":id\"}, \"f1\", {\"atom\": \":predicate\"}, [{\"atom\": \":relation\"}, \"uses\", {\"atom\": \":subject\"}, \"Rust\", {\"atom\": \":object\"}, \"ownership\"], {\"atom\": \":claim\"}, \"Rust uses ownership\", {\"atom\": \":evidence\"}, \"Rust uses ownership to manage memory\", {\"atom\": \":source\"}, \"https://s/1\", {\"atom\": \":verificationStatus\"}, {\"atom\": \":corroborated\"}, {\"atom\": \":isFalsifying\"}, {\"atom\": \"false\"}], [{\"atom\": \":fact\"}, {\"atom\": \":id\"}, \"f2\", {\"atom\": \":predicate\"}, [{\"atom\": \":relation\"}, \"hurt\", {\"atom\": \":subject\"}, \"GC pauses\", {\"atom\": \":object\"}, \"latency\"], {\"atom\": \":claim\"}, \"GC hurts latency\", {\"atom\": \":evidence\"}, \"GC pauses hurt tail latency\", {\"atom\": \":source\"}, \"https://s/2\", {\"atom\": \":verificationStatus\"}, {\"atom\": \":unfalsified\"}, {\"atom\": \":isFalsifying\"}, {\"atom\": \"true\"}]], \"tried\": [{\"alias\": \"A\", \"model\": \"m-a\", \"error\": \"breaker (300s left)\"}]}, \"sleeps\": []}], \"requests\": [\"{\\\"data\\\": \\\"{\\\\\\\"model\\\\\\\": \\\\\\\"m-b\\\\\\\", \\\\\\\"messages\\\\\\\": [{\\\\\\\"role\\\\\\\": \\\\\\\"user\\\\\\\", \\\\\\\"content\\\\\\\": \\\\\\\"Research report: the raw evidence below distils into one ASN S-expression, the (:researchReport ...) form specified at the end.\\\\\\\\nA fact carries the verbatim figures, benchmarks or architectural predicates of its source, and the evidence against a claim (failure modes, boundaries, negative tradeoffs, disconfirming sources) counts as much as the evidence for it; a report that only agrees is one-sided.\\\\\\\\nThe reply is read by an ASN parser: parentheses only; markdown code fences, JSON, brackets and backticks make it unreadable.\\\\\\\\n\\\\\\\\nTopic: t\\\\\\\\nDepth: bipolar\\\\\\\\n\\\\\\\\nSchema:\\\\\\\\n1. A fact is one atomic claim the source text states, with verbatim evidence, a metric or a definition from the distilled sources; a page title is not a fact.\\\\\\\\n2. Every fact has a predicate (:relation \\\\\\\\\\\\\\\"verb\\\\\\\\\\\\\\\" :subject \\\\\\\\\\\\\\\"noun\\\\\\\\\\\\\\\" :object \\\\\\\\\\\\\\\"noun\\\\\\\\\\\\\\\") whose subject is a specific thing the source states something about, never the whole topic.\\\\\\\\n3. Every fact has :source, the url of the Raw Evidence item it came from.\\\\\\\\n4. Epistemic classification:\\\\\\\\n   - verificationStatus: one of [:corroborated, :unfalsified, :disputed, :refuted].\\\\\\\\n     :empiricallyVerified is reserved for runner-executed test assertions; web text never carries it.\\\\\\\\n   - sourceKind: one of [:primaryArtifact, :peerReviewed, :crowdsourced, :secondaryReport, :unverifiedWeb].\\\\\\\\n5. Polarity:\\\\\\\\n   - isFalsifying: boolean (true or false).\\\\\\\\n   - At depth 'bipolar' or 'matrix' the facts hold at least one affirmative fact (:isFalsifying false) and at least one adversarial fact or limitation (:isFalsifying true).\\\\\\\\n6. A fact from a crawled web source ('crawled': true in Raw Evidence) carries :crawled true in its (:fact ...) form.\\\\\\\\n7. positiveSynthesis: 1-2 sentences summarizing what the facts support.\\\\\\\\n8. falsificationCritique: 1-2 sentences summarizing limitations, failure modes, counter-evidence, or edge cases the facts show.\\\\\\\\n9. summary: 2-3 sentence executive synthesis.\\\\\\\\n\\\\\\\\nFormat specification:\\\\\\\\n(:researchReport\\\\\\\\n  :topic \\\\\\\\\\\\\\\"t\\\\\\\\\\\\\\\"\\\\\\\\n  :summary \\\\\\\\\\\\\\\"...\\\\\\\\\\\\\\\"\\\\\\\\n  :positiveSynthesis \\\\\\\\\\\\\\\"...\\\\\\\\\\\\\\\"\\\\\\\\n  :falsificationCritique \\\\\\\\\\\\\\\"...\\\\\\\\\\\\\\\"\\\\\\\\n  :facts (\\\\\\\\n    (:fact :id \\\\\\\\\\\\\\\"fact-1\\\\\\\\\\\\\\\" :predicate (:relation \\\\\\\\\\\\\\\"verb\\\\\\\\\\\\\\\" :subject \\\\\\\\\\\\\\\"noun\\\\\\\\\\\\\\\" :object \\\\\\\\\\\\\\\"noun\\\\\\\\\\\\\\\") :claim \\\\\\\\\\\\\\\"...\\\\\\\\\\\\\\\" :evidence \\\\\\\\\\\\\\\"...\\\\\\\\\\\\\\\" :source \\\\\\\\\\\\\\\"https://...\\\\\\\\\\\\\\\" :sourceKind :primaryArtifact :verificationStatus :corroborated :crawled true :isFalsifying false)\\\\\\\\n    ...)\\\\\\\\n  :sources (\\\\\\\\\\\\\\\"https://...\\\\\\\\\\\\\\\" ...))\\\\\\\\n\\\\\\\\nRaw Evidence:\\\\\\\\n[\\\\\\\\n  {\\\\\\\\n    \\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"item-1\\\\\\\\\\\\\\\",\\\\\\\\n    \\\\\\\\\\\\\\\"title\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"T\\\\\\\\\\\\\\\",\\\\\\\\n    \\\\\\\\\\\\\\\"snippet\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"Rust uses ownership to manage memory safely.\\\\\\\\\\\\\\\",\\\\\\\\n    \\\\\\\\\\\\\\\"url\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"https://s/1\\\\\\\\\\\\\\\",\\\\\\\\n    \\\\\\\\\\\\\\\"crawled\\\\\\\\\\\\\\\": true\\\\\\\\n  },\\\\\\\\n  {\\\\\\\\n    \\\\\\\\\\\\\\\"id\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"item-2\\\\\\\\\\\\\\\",\\\\\\\\n    \\\\\\\\\\\\\\\"title\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"T2\\\\\\\\\\\\\\\",\\\\\\\\n    \\\\\\\\\\\\\\\"snippet\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"GC pauses hurt tail latency.\\\\\\\\\\\\\\\",\\\\\\\\n    \\\\\\\\\\\\\\\"url\\\\\\\\\\\\\\\": \\\\\\\\\\\\\\\"https://s/2\\\\\\\\\\\\\\\",\\\\\\\\n    \\\\\\\\\\\\\\\"crawled\\\\\\\\\\\\\\\": false\\\\\\\\n  }\\\\\\\\n]\\\\\\\"}], \\\\\\\"temperature\\\\\\\": 0.2}\\\", \\\"headers\\\": [[\\\"content-type\\\", \\\"application/json\\\"], [\\\"user-agent\\\", \\\"ASL-Gateway/1.0 (Darwin; macOS)\\\"]], \\\"method\\\": \\\"POST\\\", \\\"timeout\\\": 45, \\\"url\\\": \\\"https://up2.example/v1/chat/completions\\\"}\"], \"usage\": [[\"groq\", \"A\", \"breaker 300s\", null], [\"openrouter\", \"B\", \"ok\", null]], \"cliCalls\": [], \"stderr\": \"[Gateway Breaker] skip groq for 300s\\n\", \"lastDdgMs\": 0, \"breaker\": {\"groq\": 1300000}, \"count503\": {}, \"cacheKeys\": []}")
