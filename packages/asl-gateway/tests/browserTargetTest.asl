(module aslGateway/tests/browserTargetTest :x [testTargetKindAndConversion testTargetDescriptorFormatting testPreferredTargetResolution runAllTargetTests runTests] :i [(browserGateway :a bgw)])

fn testTargetKindAndConversion -> Bool
  (let [(kSteel (bgw/targetStealthSteel))
        (kChrome (bgw/targetExtensionChrome))
        (kSafari (bgw/targetExtensionSafari))
        (kCdp (bgw/targetCdpDirect))
        (sSteel (bgw/browserTargetKindToString kSteel))
        (sChrome (bgw/browserTargetKindToString kChrome))
        (sSafari (bgw/browserTargetKindToString kSafari))
        (sCdp (bgw/browserTargetKindToString kCdp))
        (pSteel (bgw/parseBrowserTargetKind "steel"))
        (pChrome (bgw/parseBrowserTargetKind "chrome"))
        (pSafari (bgw/parseBrowserTargetKind "safari"))
        (pSteelLong (bgw/parseBrowserTargetKind "stealthSteel"))
        (pChromeLong (bgw/parseBrowserTargetKind "extensionChrome"))
        (pSafariLong (bgw/parseBrowserTargetKind "extensionSafari"))
        (pCdp (bgw/parseBrowserTargetKind "cdpDirect"))
        (pDefault (bgw/parseBrowserTargetKind "unknown-variant"))]
    (do
      (assert (= sSteel "stealthSteel") "Steel converts to stealthSteel")
      (assert (= sChrome "extensionChrome") "Chrome converts to extensionChrome")
      (assert (= sSafari "extensionSafari") "Safari converts to extensionSafari")
      (assert (= sCdp "cdpDirect") "CDP converts to cdpDirect")
      (assert (= (bgw/browserTargetKindToString pSteel) "stealthSteel") "Parsed steel matches")
      (assert (= (bgw/browserTargetKindToString pChrome) "extensionChrome") "Parsed chrome matches")
      (assert (= (bgw/browserTargetKindToString pSafari) "extensionSafari") "Parsed safari matches")
      (assert (= (bgw/browserTargetKindToString pSteelLong) "stealthSteel") "Parsed stealthSteel matches")
      (assert (= (bgw/browserTargetKindToString pChromeLong) "extensionChrome") "Parsed extensionChrome matches")
      (assert (= (bgw/browserTargetKindToString pSafariLong) "extensionSafari") "Parsed extensionSafari matches")
      (assert (= (bgw/browserTargetKindToString pCdp) "cdpDirect") "Parsed cdpDirect matches")
      (assert (= (bgw/browserTargetKindToString pDefault) "cdpDirect") "Parsed default routes to cdpDirect")
      (refute (= sSteel "extensionChrome") "Steel must not equal Chrome")
      (refute (= sSafari "cdpDirect") "Safari must not equal CDP")
      true))

fn testTargetDescriptorFormatting -> Bool
  (let [(tab1 (bgw/makeBrowserTabSummary "tab-101" "Google Cloud Console" "https://console.cloud.google.com" true))
        (tab2 (bgw/makeBrowserTabSummary "tab-102" "GitHub Pull Requests" "https://github.com/asex" false))
        (capsChrome (list "domQuery" "scriptExec" "activeTabControl"))
        (descChrome (bgw/makeBrowserTargetDescriptor "target-chrome-user" (bgw/targetExtensionChrome) "chrome" true capsChrome (list tab1 tab2) 1758400000))
        (asnChrome (bgw/formatBrowserTargetAsn descChrome))
        (capsSteel (list "stealthNavigate" "pageEvaluate"))
        (descSteel (bgw/makeBrowserTargetDescriptor "target-steel-worker" (bgw/targetStealthSteel) "steel" false capsSteel (list) 1758400050))
        (asnSteel (bgw/formatBrowserTargetAsn descSteel))]
    (do
      (assert (= descChrome.targetId "target-chrome-user") "TargetId is target-chrome-user")
      (assert (= descChrome.browserFamily "chrome") "Browser family is chrome")
      (assert descChrome.isAuthenticatedContext "Chrome target has auth context")
      (assert (= descChrome.lastHeartbeatSec 1758400000) "Heartbeat timestamp matches")
      (assert (= (listLength descChrome.activeTabs) 2) "Active tabs count is 2")
      (assert (= tab1.tabId "tab-101") "Tab 1 id matches")
      (assert (= tab1.title "Google Cloud Console") "Tab 1 title matches")
      (assert (= tab1.url "https://console.cloud.google.com") "Tab 1 url matches")
      (assert tab1.isActive "Tab 1 is active")
      (assert (not tab2.isActive) "Tab 2 is inactive")
      (assert (stringContains? asnChrome ":id \"target-chrome-user\"") "ASN contains targetId")
      (assert (stringContains? asnChrome ":kind :extensionChrome") "ASN contains kind")
      (assert (stringContains? asnChrome ":family \"chrome\"") "ASN contains family")
      (assert (stringContains? asnChrome ":authenticated true") "ASN contains auth flag true")
      (assert (stringContains? asnChrome ":tabsCount 2") "ASN contains tabsCount 2")
      (assert (stringContains? asnChrome ":lastHeartbeat 1758400000") "ASN contains lastHeartbeat")
      (refute (stringContains? asnChrome ":authenticated false") "Authenticated must not be false")
      (assert (= descSteel.targetId "target-steel-worker") "Steel targetId matches")
      (assert (= descSteel.browserFamily "steel") "Steel browser family matches")
      (assert (not descSteel.isAuthenticatedContext) "Steel target has no auth context")
      (assert (= descSteel.lastHeartbeatSec 1758400050) "Steel heartbeat timestamp matches")
      (assert (= (listLength descSteel.activeTabs) 0) "Steel active tabs count is 0")
      (assert (stringContains? asnSteel ":id \"target-steel-worker\"") "Steel ASN contains targetId")
      (assert (stringContains? asnSteel ":kind :stealthSteel") "Steel ASN contains kind")
      (assert (stringContains? asnSteel ":family \"steel\"") "Steel ASN contains family")
      (assert (stringContains? asnSteel ":authenticated false") "Steel ASN contains auth flag false")
      (assert (stringContains? asnSteel ":tabsCount 0") "Steel ASN contains tabsCount 0")
      (assert (stringContains? asnSteel ":lastHeartbeat 1758400050") "Steel ASN contains lastHeartbeat")
      (refute (stringContains? asnSteel ":authenticated true") "Steel authenticated must not be true")
      true))

fn testPreferredTargetResolution -> Bool
  (let [(resScrape (bgw/resolvePreferredTarget "scrape documentation table" true))
        (resCrawl (bgw/resolvePreferredTarget "crawl api endpoints" false))
        (resResearch (bgw/resolvePreferredTarget "research competitive landscape" false))
        (resSaaS (bgw/resolvePreferredTarget "inspect logged-in dashboard" true))
        (resSafari (bgw/resolvePreferredTarget "open in safari browser" true))
        (resSafariNoAuth (bgw/resolvePreferredTarget "open in safari browser" false))
        (resNoAuth (bgw/resolvePreferredTarget "inspect general settings" false))]
    (do
      (assert (= (bgw/browserTargetKindToString resScrape) "stealthSteel") "Scrape routes to stealthSteel")
      (assert (= (bgw/browserTargetKindToString resCrawl) "stealthSteel") "Crawl routes to stealthSteel")
      (assert (= (bgw/browserTargetKindToString resResearch) "stealthSteel") "Research routes to stealthSteel")
      (assert (= (bgw/browserTargetKindToString resSaaS) "extensionChrome") "Logged in SaaS routes to extensionChrome")
      (assert (= (bgw/browserTargetKindToString resSafari) "extensionSafari") "Safari request routes to extensionSafari")
      (assert (= (bgw/browserTargetKindToString resSafariNoAuth) "stealthSteel") "Safari without auth session routes to stealthSteel")
      (assert (= (bgw/browserTargetKindToString resNoAuth) "stealthSteel") "Unauthenticated intent routes to stealthSteel")
      (refute (= (bgw/browserTargetKindToString resScrape) "extensionChrome") "Scrape must never route to user Chrome")
      (refute (= (bgw/browserTargetKindToString resSafariNoAuth) "extensionSafari") "Unauthenticated safari must not route to safari extension")
      true))

fn runAllTargetTests -> Bool
  (let [(okKind (testTargetKindAndConversion))
        (okDesc (testTargetDescriptorFormatting))
        (okPref (testPreferredTargetResolution))]
    (and (and okKind okDesc) okPref))

fn runTests -> Bool
  (runAllTargetTests)
