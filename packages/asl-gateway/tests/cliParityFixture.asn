;; CLI dispatch parity test fixtures generated from bin/asl-gateway Python implementation
;; Pinned commit: 7a51dc4f0a9d82c4c510fa79a2230323507311a6:bin/asl-gateway
(:fixtureCorpus :name "cliParity" :cases 41)
(:case :id "msg_list_empty" :fn "cli_message_text" :want "")
(:case :id "msg_list_texts" :fn "cli_message_text" :want "hello\nworld")
(:case :id "msg_list_mixed" :fn "cli_message_text" :want "first\nsecond")
(:case :id "msg_list_non_dicts" :fn "cli_message_text" :want "part1\npart2")
(:case :id "msg_none" :fn "cli_message_text" :want "")
(:case :id "msg_str" :fn "cli_message_text" :want "hello plain text")
(:case :id "msg_int" :fn "cli_message_text" :want "42")
(:case :id "msg_bool_true" :fn "cli_message_text" :want "True")
(:case :id "msg_bool_false" :fn "cli_message_text" :want "False")
(:case :id "agy_tools" :fn "cli_agy_tools" :want ["run_command" "invoke_subagent" "send_message" "manage_subagents" "wait"])
(:case :id "prompt_dir_agy_default_md" :fn "cli_write_prompt_dir" :client "agy" :noTools false :want "---\nname: aslGateway\ndescription: asl gateway\nmainAgent: true\nsubagent: false\ntools:\n  - run_command\n  - invoke_subagent\n  - send_message\n  - manage_subagents\n  - wait\ninheritMcp: false\ninheritCustomizations: false\n---\n\nSystem prompt for agy")
(:case :id "prompt_dir_agy_plugin_json" :fn "cli_write_prompt_dir" :client "agy" :want "{\"name\": \"aslGateway\"}\n")
(:case :id "prompt_dir_agy_no_tools_md" :fn "cli_write_prompt_dir" :client "agy" :noTools true :want "---\nname: aslGateway\ndescription: asl gateway\nmainAgent: true\nsubagent: false\ntools: []\ninheritMcp: false\ninheritCustomizations: false\nexcludeDefaultComponents: true\n---\n\nSystem prompt no tools")
(:case :id "prompt_dir_claude" :fn "cli_write_prompt_dir" :client "claude" :want "Claude system prompt")
(:case :id "prompt_dir_codex" :fn "cli_write_prompt_dir" :client "codex" :want "Codex system prompt")
(:case :id "json_obj_simple" :fn "cli_json_object" :status :ok :want "{\"code\": 200, \"status\": \"ok\"}")
(:case :id "json_obj_nested" :fn "cli_json_object" :status :ok :want "{\"details\": {\"input\": 1, \"output\": 2}, \"model\": \"test\"}")
(:case :id "json_obj_surrounded" :fn "cli_json_object" :status :ok :want "{\"valid\": true}")
(:case :id "json_obj_escaped" :fn "cli_json_object" :status :ok :want "{\"text\": \"line1\\nline2 \\\"quoted\\\"\"}")
(:case :id "json_obj_empty" :fn "cli_json_object" :status :ok :want "{}")
(:case :id "json_obj_no_json" :fn "cli_json_object" :status :err :want "no JSON object in output")
(:case :id "json_obj_array_only" :fn "cli_json_object" :status :err :want "no JSON object in output")
(:case :id "json_obj_malformed" :fn "cli_json_object" :status :err :want "Expecting ',' delimiter: line 1 column 15 (char 14)")
(:case :id "parse_claude_model_usage" :fn "cli_parse_result" :client "claude" :text "Answer from Claude MU" :usage (:usage :input 130 :cached 10 :output 50) :dedup false)
(:case :id "parse_claude_usage" :fn "cli_parse_result" :client "claude" :text "Answer from Claude standard" :usage (:usage :input 100 :cached 5 :output 30) :dedup false)
(:case :id "parse_claude_no_usage" :fn "cli_parse_result" :client "claude" :text "Answer no usage" :usage :none :dedup false)
(:case :id "parse_claude_extra_logs" :fn "cli_parse_result" :client "claude" :text "Clean answer" :usage (:usage :input 5 :cached 0 :output 5) :dedup false)
(:case :id "parse_claude_invalid" :fn "cli_parse_result" :client "claude" :text "Error: server disconnected" :usage :none :dedup false)
(:case :id "parse_codex_standard" :fn "cli_parse_result" :client "codex" :text "Codex answer 1" :usage (:usage :input 200 :cached 50 :output 75) :dedup false)
(:case :id "parse_codex_multi_turn" :fn "cli_parse_result" :client "codex" :text "Multi turn answer" :usage (:usage :input 150 :cached 30 :output 60) :dedup false)
(:case :id "parse_codex_no_msg" :fn "cli_parse_result" :client "codex" :text "" :usage (:usage :input 10 :cached 0 :output 5) :dedup false)
(:case :id "parse_codex_no_usage" :fn "cli_parse_result" :client "codex" :text "Only message" :usage :none :dedup false)
(:case :id "parse_codex_other_events" :fn "cli_parse_result" :client "codex" :text "After noise" :usage :none :dedup false)
(:case :id "parse_codex_invalid" :fn "cli_parse_result" :client "codex" :text "Codex error: internal failure" :usage :none :dedup false)
(:case :id "parse_agy_standard" :fn "cli_parse_result" :client "agy" :text "Agy answer 1" :usage (:usage :input 300 :cached 40 :output 120) :dedup false)
(:case :id "parse_agy_dedup" :fn "cli_parse_result" :client "agy" :text "Repeated response" :usage (:usage :input 50 :cached 0 :output 20) :dedup true)
(:case :id "parse_agy_no_dedup_even" :fn "cli_parse_result" :client "agy" :text "Even length text! Even length text!" :usage (:usage :input 10 :cached 0 :output 10) :dedup false)
(:case :id "parse_agy_no_usage" :fn "cli_parse_result" :client "agy" :text "Agy no usage" :usage :none :dedup false)
(:case :id "parse_agy_invalid" :fn "cli_parse_result" :client "agy" :text "Agy crashed with signal 11" :usage :none :dedup false)
(:case :id "resolve_env_override" :fn "resolve_cli_bin" :want "/bin/sh")
(:case :id "resolve_legacy_fallback" :fn "resolve_cli_bin" :want "/tmp/fallback/bin")
