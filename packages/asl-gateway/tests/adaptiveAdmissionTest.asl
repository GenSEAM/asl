(module aslGateway/tests/adaptiveAdmissionTest
  :x [runTests]
  :i [(admission :a adm)
      (breaker :a b)
      (config :a c)
      (limits :a lim)
      (chat :a ch)
      (upstream :a u)
      (asl-tools/fleet/run :a fr)])

; (:m :ref GW-ADAPTIVE-ADMISSION :do "the lane cap drops to max(1, inFlight-1) on a concurrency 429, rises one step after 20 successes with 600 s of quiet, stays within 1 and the row's max, a multi-scope admission is all or nothing through the shared registry, and malformed shared state parks instead of admitting")
fn modelRow alias: String n: Int64 mx: Int64 -> c/GatewayLimit
  (c/GatewayLimit :provider "syn" :scope "model" :model alias :window "" :calls 0 :tokens 0 :concurrency n :max mx)

fn acctRow n: Int64 -> c/GatewayLimit
  (c/GatewayLimit :provider "syn" :scope "account" :model "" :window "" :calls 0 :tokens 0 :concurrency n)

fn times n: Int64 lane: adm/Lane base: c/GatewayLimit at: Int64 -> adm/Lane
  (if (<= n 0) lane (times (- n 1) (adm/raiseOnSuccess lane base at) base at))

fn takeN! n: Int64 home: String lims: (List c/GatewayLimit) alias: String -> Int64
  (if (<= n 0) 0
    (+ (match (adm/admitShared! home lims "syn" alias 1000 600000) ((ok t) (if t 1 0)) ((err _) 0))
       (takeN! (- n 1) home lims alias)))

fn cfgOne extra: String -> String
  (str "(:gateway :v 2 :providers ((:provider :id fp :kind openai :base \"http://127.0.0.1:1\" :keyEnv FP_KEY)) :models ((:model :id m1 :provider fp :name \"n1\")) :profiles ((:profile :id default :routes ((:intent any :chain (m1))))) :uses ((:use :for default :profile default))" extra ")")

fn ! drive! step: ch/ChatStep labels: String hits: Int64 errBody: String fuel: Int64 -> String
  (if (<= fuel 0)
    (str labels "|outOfFuel")
    (match step
      ((ch/stepDone _) labels)
      ((ch/stepRaised kind msg) (str labels "|raised " kind))
      ((ch/stepEffect eff k)
       (match eff
         ((ch/effRealpath _) (drive! (k (ch/outPath "/tmp")) labels hits errBody (- fuel 1)))
         ((ch/effIsDir _) (drive! (k (ch/outBool true)) labels hits errBody (- fuel 1)))
         ((ch/effClock) (drive! (k (ch/outFloat 1.0)) labels hits errBody (- fuel 1)))
         ((ch/effBreakerDown _) (drive! (k (ch/outFloat 0.0)) labels hits errBody (- fuel 1)))
         ((ch/effBreakerDownAll _) (drive! (k (ch/outFloats (list 0.0))) labels hits errBody (- fuel 1)))
         ((ch/effBucket _ _ _) (drive! (k (ch/outBool true)) labels hits errBody (- fuel 1)))
         ((ch/effCli _ _) (drive! (k (ch/outCli none)) labels hits errBody (- fuel 1)))
         ((ch/effSleepMs ms) (drive! (k ch/outDone) (str labels "|sleep:" (stringFromInt64 ms)) hits errBody (- fuel 1)))
         ((ch/effLimit _ _) (drive! (k (ch/outStrings (list))) (str labels "|limit") hits errBody (- fuel 1)))
         ((ch/effConcurrency429 _ alias ra) (drive! (k ch/outDone) (str labels "|c429:" alias "@" (stringFromInt64 ra)) hits errBody (- fuel 1)))
         ((ch/effBreakerEvent ev _ _) (drive! (k ch/outDone) (str labels "|brk:" ev) hits errBody (- fuel 1)))
         ((ch/effUsageNote _ _ outcome _) (drive! (k ch/outDone) (str labels "|note:" outcome) hits errBody (- fuel 1)))
         ((ch/effHttp _ _ _ _ _ _ _ _)
          (drive! (k (ch/outHttp (if (< hits 1)
                                   (if (stringStartsWith? errBody "S400|") (ch/httpError 400 "Bad Request" (list) errBody) (ch/httpError 429 "Too Many Requests" (list) errBody))
                                   (ch/httpOk 200 (list (pair "Content-Type" "application/json")) "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"fine\"},\"finish_reason\":\"stop\"}]}"))))
                  (str labels "|http") (+ hits 1) errBody (- fuel 1)))
         (_ (drive! (k ch/outDone) labels hits errBody (- fuel 1)))))))

fn ! chatRun! errBody: String -> String
  (match (c/gatewayConfigParse! (cfgOne " :limits ((:limit :provider fp :scope model :model m1 :concurrency 2))") "default" ".asl/mem/calibration/index.asn")
    ((err e) (str "config: " e))
    ((ok table)
      (match (u/upstreamSettings (mapEmpty))
        ((err _) "no settings")
        ((ok st)
          (drive! (ch/chatStart! (ch/ChatRequest :path "/v1/chat/completions" :headers (list (pair "X-ASL-Queue-Ms" "5000")) :body "{\"model\":\"default\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}")
                    (ch/ChatWorld :env (mapFromPairs (list (pair "FP_KEY" "k-ADM-1"))) :rootDir "/tmp" :settings st :agyPromptMaxBytes 10000 :table (ok table)))
                  "" 0 errBody 200)))))

fn ! runTests -> Bool
  (let [(base (modelRow "f" 6 0))
        (l0 (adm/laneInit))
        (d1 (adm/dropOnConcurrency429 l0 base 6 5000))
        (d2 (adm/dropOnConcurrency429 d1 base 5 9000))
        (dLow (adm/dropOnConcurrency429 (adm/Lane :cap 1 :ok 3 :last429 0) base 1 70000))
        (dTop (adm/dropOnConcurrency429 (adm/Lane :cap 11 :ok 3 :last429 0) base 20 70000))
        (shortStreak (times 19 d1 base 700000))
        (streak (times 20 d1 base 700000))
        (noQuiet (times 20 (adm/Lane :cap 3 :ok 0 :last429 650000) base 700000))
        (atMax (times 40 (adm/Lane :cap 12 :ok 0 :last429 0) base 9000000))
        (withMax (modelRow "f" 6 8))
        (atRowMax (times 60 (adm/Lane :cap 8 :ok 0 :last429 0) withMax 9000000))
        (eff (adm/effectiveLimits (list (acctRow 4) base) d1))
        (rt (adm/parseLane (adm/renderLane d1)))
        (badLane (adm/parseLane "gwAdmission1\tx\t0\t0"))
        (badLeases (adm/parseLeases "nonsense"))
        (ls (list (lim/Lease :provider "syn" :alias "f" :keys (list "model|syn|f||" "account|syn|||") :atMs 99)))
        (rtLeases (adm/parseLeases (adm/renderLeases ls)))
        (home (stringTrim (resultOr (fr/shellOut "/usr/bin/mktemp -d /tmp/adaptiveAdmissionTest.XXXXXX" 5000) "")))
        (tight (list (modelRow "f" 3 0)))
        (took (takeN! 5 home tight "f"))
        (cutDone (adm/concurrency429! home tight "syn" "f" 2000))
        (afterCut (takeN! 5 home tight "f"))
        (multi (list (acctRow 2) (modelRow "g" 5 0)))
        (home2 (stringTrim (resultOr (fr/shellOut "/usr/bin/mktemp -d /tmp/adaptiveAdmissionTest.XXXXXX" 5000) "")))
        (m1 (takeN! 1 home2 (list (acctRow 2)) "other"))
        (m2 (takeN! 1 home2 (list (acctRow 2)) "other2"))
        (m3 (adm/admitShared! home2 multi "syn" "g" 1000 600000))
        (leasesAfter (resultOr (fileReadString (str home2 "/.asl/run/gwAdmission/leases.tsv")) ""))
        (home3 (stringTrim (resultOr (fr/shellOut "/usr/bin/mktemp -d /tmp/adaptiveAdmissionTest.XXXXXX" 5000) "")))
        (mk (dirCreate (str home3 "/.asl/run/gwAdmission")))
        (wr (fileWrite (str home3 "/.asl/run/gwAdmission/leases.tsv") "garbage\n"))
        (parked (adm/admitShared! home3 tight "syn" "f" 1000 600000))
        (conc (chatRun! "{\"error\":\"Rate limit: too many concurrent requests\"}"))
        (plain (chatRun! "{\"error\":\"slow down\"}"))
        (bad (chatRun! "S400|{\"error\":\"bad request\"}"))
        (cleaned (fr/shellOut (str "/bin/rm -rf " home " " home2 " " home3) 5000))]
    (do
      (assert (and (= d1.cap 3) (= d1.last429 5000) (= d1.ok 0)) (str "a concurrency 429 with 6 in flight halves the cap to 3: " d1.cap))
      (assert (= d2.cap 1) (str "a second 429 with 5 in flight halves the cap to 1 (min of cap and in-flight, halved): " d2.cap))
      (assert (= dLow.cap 1) (str "the cap never drops below 1: " dLow.cap))
      (assert (= dTop.cap 5) (str "from cap 11 with 20 in flight the halved cap is 5: " dTop.cap))
      (assert (= shortStreak.cap 3) (str "19 successes do not raise the cap: " shortStreak.cap))
      (assert (= streak.cap 4) (str "20 successes after 600 s quiet raise the cap by 1: " streak.cap))
      (assert (= noQuiet.cap 3) (str "no raise inside the quiet period: " noQuiet.cap))
      (assert (= atMax.cap 12) (str "the cap never passes twice the row (12) by default: " atMax.cap))
      (assert (= atRowMax.cap 8) (str "the cap never passes the row's :max: " atRowMax.cap))
      (assert (and (= (listLength eff) 2) (= (optionOr (match (listGet eff 1) ((some l) (some l.concurrency)) ((none) none)) 0) 3) (= (optionOr (match (listGet eff 0) ((some l) (some l.concurrency)) ((none) none)) 0) 4)) "the learned cap replaces only the model row; the account row keeps its own count")
      (assert (and (ok? rt) (= (match rt ((ok x) x.cap) ((err _) 0)) 3)) "lane state round-trips")
      (assert (err? badLane) "a malformed lane file is an error")
      (assert (err? badLeases) "a malformed lease registry is an error")
      (assert (and (ok? rtLeases) (= (match rtLeases ((ok x) (listLength x)) ((err _) 0)) 1) (= (match rtLeases ((ok x) (optionOr (match (listHead x) ((some y) (some y.atMs)) ((none) none)) 0)) ((err _) 0)) 99)) "leases round-trip")
      (assert (= took 3) (str "five asks against a cap of 3 take exactly 3 slots: " (stringFromInt64 took)))
      (assert (ok? cutDone) "the concurrency 429 is recorded")
      (assert (= afterCut 0) (str "with 3 in flight, a 429 lowers the cap to 2 so no further slot is taken: " (stringFromInt64 afterCut)))
      (assert (and (= m1 1) (= m2 1)) "two aliases fill an account cap of 2")
      (assert (match m3 ((ok t) (not t)) ((err _) false)) "a call whose account scope is full takes nothing though its model scope has room")
      (assert (not (stringContains? leasesAfter "\tg\t")) (str "the refused multi-scope call left no partial lease: " leasesAfter))
      (assert (err? parked) "malformed shared state parks the call (an error), never admits")
      (assert (and (stringContains? conc "|limit|http|c429:m1@0|note:limit:concurrency429|sleep:250|limit|http") (not (stringContains? conc "brk:note")) (not (stringContains? conc "markDown")) (not (stringContains? conc "raised")) (not (stringContains? conc "outOfFuel"))) (str "a concurrency 429 is absorbed: cap lowered, park, ask admission again, resend, no breaker and no error to the caller: " conc))
      (assert (and (stringContains? plain "brk:note429") (not (stringContains? plain "c429"))) (str "a 429 that does not name concurrency still opens the breaker: " plain))
      (assert (stringContains? bad "|note:4xx") (str "GW-LEDGER-FAILS-UNRECORDED: a scripted 400 upstream emits one ledger note (outcome 4xx) for the failed attempt: " bad))
      (assert (ok? cleaned) "temp dirs removed")
      true))
