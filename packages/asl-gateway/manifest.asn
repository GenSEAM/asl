(:package aslGateway
  :version "1.1.0"
  :entry "src/server.asl"
  :description "Sovereign L7 Cognitive Gateway & Omni-Protocol Nexus: LMK key management, pure Dyck-1 data synchronization, universal browser frames, and generative media accounting"
  :aslFirst true
  :dependencies ("asl-text" "asl-json" "asl-proc" "asl-http" "asl-cli")
  :modules (
    "aslGateway/server"
    "aslGateway/wire"
    "aslGateway/lmk"
    "aslGateway/gateway"
    "aslGateway/browserGateway"
    "aslGateway/sync"
    "aslGateway/browser"
    "aslGateway/media"
    "aslGateway/pyText"
    "aslGateway/htmlEntities"
    "aslGateway/search"
    "aslGateway/research"
    "aslGateway/cockpit"
    "aslGateway/localTime"
    "aslGateway/omniApi"
    "aslGateway/getRoutes"
    "aslGateway/batchPool"
    "aslGateway/poolDispatch"
    "aslGateway/breaker"
    "aslGateway/budget"
    "aslGateway/chat"
    "aslGateway/cliDispatch"
    "aslGateway/config"
    "aslGateway/dispatch"
    "aslGateway/fleet"
    "aslGateway/plugin"
    "aslGateway/router"
    "aslGateway/upstream"
    "aslGateway/usage"))
