(module aslVdom/stateBridgeTest :x [runTests testBridgeInitializationAndSync testNativeEventJsonParsing testEventToActionAndStoreDispatch testPatchSerialization testBusEventFraming testD77NegativeControls] :i [(stateBridge :a sb) (state :a s)])

fn testBridgeInitializationAndSync -> Bool
  (let [(bridge (sb/initBridge "vdom/mobile" "agent-alpha")) (synced (sb/updateBridgeSync bridge 1726400000))] (assert (= bridge.channel "vdom/mobile") "Bridge channel must match initialized channel") (assert (= bridge.agentId "agent-alpha") "Bridge agentId must match initialized agentId") (assert (= bridge.lastSyncEpoch 0) "Bridge lastSyncEpoch baseline must be 0") (refute (= bridge.channel "invalid") "Refute invalid bridge channel") (assert (= synced.channel "vdom/mobile") "Synced bridge channel must remain intact") (assert (= synced.agentId "agent-alpha") "Synced bridge agentId must remain intact") (assert (= synced.lastSyncEpoch 1726400000) "Synced bridge lastSyncEpoch must match updated epoch") (refute (= synced.lastSyncEpoch 0) "Refute synced bridge epoch is 0") true)

fn testNativeEventJsonParsing -> Bool
  (let [(jsonPayload "{\"componentId\": \"loginBtn\", \"action\": \"submit\", \"value\": \"creds\"}") (evJson (sb/parseNativeEvent jsonPayload)) (emptyValPayload "{\"componentId\": \"toggleTheme\", \"action\": \"click\", \"value\": \"\"}") (evEmptyVal (sb/parseNativeEvent emptyValPayload)) (asnPayload "(:ui/event :componentId \"menuItem\" :action \"select\" :value \"settings\")") (evAsn (sb/parseNativeEvent asnPayload))] (assert (= evJson.componentId "loginBtn") "JSON componentId must parse loginBtn") (assert (= evJson.action "submit") "JSON action must parse submit") (assert (= evJson.value "creds") "JSON value must parse creds") (refute (sb/isFallbackEvent? evJson) "Refute valid JSON event triggers fallback") (assert (= evEmptyVal.componentId "toggleTheme") "Empty value componentId must parse toggleTheme") (assert (= evEmptyVal.action "click") "Empty value action must parse click") (assert (= evEmptyVal.value "") "Empty value value must parse empty string") (assert (= evAsn.componentId "menuItem") "ASN componentId must parse menuItem") (assert (= evAsn.action "select") "ASN action must parse select") (assert (= evAsn.value "settings") "ASN value must parse settings") (refute (sb/isFallbackEvent? evAsn) "Refute valid ASN event triggers fallback") true)

fn bridgeTestReducer st: (Map String String) act: s/Action -> (Map String String)
  (if (= act.name "setValue") (let [(k (mt (mapGet act.payload "componentId") ((some comp) comp) ((none) "default"))) (v (mt (mapGet act.payload "value") ((some val) val) ((none) "")))] (mapSet st k v)) st)

fn testEventToActionAndStoreDispatch -> Bool
  (let [(uiEv (sb/UIEvent :componentId "emailField" :action "setValue" :value "alice@example.com")) (act (sb/eventToAction uiEv)) (bridge (sb/initBridge "vdom/mobile" "agent-1")) (store0 (s/createStore (mapEmpty))) (jsonPayload "{\"componentId\": \"emailField\", \"action\": \"setValue\", \"value\": \"alice@example.com\"}") (store1 (sb/dispatchBridgeEvent bridge store0 jsonPayload bridgeTestReducer))] (assert (= act.name "setValue") "Action name must match UIEvent action") (assert (= (s/getStateValue (s/createStore act.payload) "componentId" "") "emailField") "Payload componentId must match") (assert (= (s/getStateValue (s/createStore act.payload) "value" "") "alice@example.com") "Payload value must match") (assert (= store1.version 1) "Store version must increment to 1 after bridge dispatch") (assert (= (s/getStateValue store1 "emailField" "") "alice@example.com") "State must update with dispatched value") (refute (= (s/getStateValue store1 "emailField" "") "") "Refute empty emailField after dispatch") true)

fn testPatchSerialization -> Bool
  (let [(p1 (s/StatePatch :path "theme" :op "set" :value "dark")) (p2 (s/StatePatch :path "counter" :op "set" :value "42")) (p3 (s/StatePatch :path "oldKey" :op "remove" :value "")) (itemStr (sb/serializePatchItem p1)) (deltaStr (sb/serializePatches 5 (list p1 p2 p3)))] (assert (stringContains? itemStr "\"path\": \"theme\"") "serializePatchItem must contain path") (assert (stringContains? itemStr "\"op\": \"set\"") "serializePatchItem must contain op") (assert (stringContains? itemStr "\"value\": \"dark\"") "serializePatchItem must contain value") (assert (stringStartsWith? deltaStr "{\"version\": 5, \"patches\": [") "serializePatches must start with version frame") (assert (stringContains? deltaStr "\"path\": \"counter\"") "serializePatches must contain second patch") (assert (stringContains? deltaStr "\"path\": \"oldKey\"") "serializePatches must contain third patch") (refute (stringContains? deltaStr "\"version\": 999") "Refute invalid version in serialized patches") true)

fn testBusEventFraming -> Bool
  (let [(bridge (sb/initBridge "vdom/sync" "agent-perceiver")) (synced (sb/updateBridgeSync bridge 1726500000)) (payload "{\"version\": 2, \"patches\": []}") (eventFrame (sb/formatBridgeBusEvent synced payload))] (assert (stringStartsWith? eventFrame "(! bus/event") "Event frame must start with (! bus/event") (assert (stringContains? eventFrame ":channel \"vdom/sync\"") "Event frame must contain target channel") (assert (stringContains? eventFrame ":sender \"agent-perceiver\"") "Event frame must contain sender agent") (assert (stringContains? eventFrame ":epoch 1726500000") "Event frame must contain sync epoch") (assert (stringContains? eventFrame ":payload {\"version\": 2") "Event frame must encapsulate delta payload") (refute (stringContains? eventFrame ":channel \"wrong/channel\"") "Refute invalid channel in event frame") true)

fn testD77NegativeControls -> Bool
  (let [(malformed1 "{ broken json not valid }") (evBad1 (sb/parseNativeEvent malformed1)) (emptyPayload "") (evBad2 (sb/parseNativeEvent emptyPayload)) (unrelatedPayload "{\"randomKey\": 9999}") (evBad3 (sb/parseNativeEvent unrelatedPayload)) (bridge (sb/initBridge "vdom/mobile" "agent-1")) (store0 (s/createStore (mapSet (mapEmpty) "theme" "light"))) (storeUnchanged (sb/dispatchBridgeEvent bridge store0 malformed1 bridgeTestReducer))] (assert (sb/isFallbackEvent? evBad1) "Malformed JSON string must resolve to fallback UIEvent") (assert (= evBad1.componentId "fallback") "Malformed JSON componentId must be fallback") (assert (= evBad1.action "fallback") "Malformed JSON action must be fallback") (refute (= evBad1.action "submit") "Refute malformed JSON parsed as submit action") (assert (sb/isFallbackEvent? evBad2) "Empty payload must resolve to fallback UIEvent") (assert (sb/isFallbackEvent? evBad3) "Unrelated JSON object without target keys must resolve to fallback UIEvent") (assert (= storeUnchanged.version 0) "Malformed payload dispatch must not advance store version") (assert (= (s/getStateValue storeUnchanged "theme" "") "light") "Malformed payload dispatch must not mutate store state") (refute (= storeUnchanged.version 1) "Refute store version incremented on malformed dispatch") true)

fn runTests -> Bool
  (and (testBridgeInitializationAndSync) (and (testNativeEventJsonParsing) (and (testEventToActionAndStoreDispatch) (and (testPatchSerialization) (and (testBusEventFraming) (testD77NegativeControls))))))
