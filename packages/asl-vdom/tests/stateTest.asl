(module aslVdom/stateTest :x [runTests testStoreCreationAndGetters testActionDispatchAndReducer testStatePatching testComputeStateDiffAndRoundtrip testSubscriptionLifecycle testD77NegativeControls] :i [(state :a s)])

fn testStoreCreationAndGetters -> Bool
  (let [(initMap (mapSet (mapSet (mapEmpty) "theme" "dark") "lang" "en")) (store (s/createStore initMap))] (assert (= store.version 0) "Initial store version must be 0") (assert (= (listLength store.subscribers) 0) "Initial store must have no subscribers") (assert (= (s/getStateValue store "theme" "light") "dark") "getStateValue must return existing key") (assert (= (s/getStateValue store "lang" "es") "en") "getStateValue must return lang key") (assert (= (s/getStateValue store "missing" "fallback") "fallback") "getStateValue must return default for missing key") (assert (= (mapSize (s/getState store)) 2) "getState map must contain 2 entries") (assert (mapHas? (s/getState store) "theme") "Store state must contain theme key") (refute (mapHas? (s/getState store) "missing") "Store state must not have missing key") true)

fn sampleReducer st: (Map String String) act: s/Action -> (Map String String)
  (let [(name act.name) (payload act.payload)] (if (= name "SET_THEME") (mt (mapGet payload "theme") ((some val) (mapSet st "theme" val)) ((none) st)) (if (= name "INCREMENT") (let [(curr (mt (mapGet st "counter") ((some c) (optionOr (stringToInt64 c) 0)) ((none) 0))) (next (stringFromInt64 (+ curr 1)))] (mapSet st "counter" next)) st)))

fn testActionDispatchAndReducer -> Bool
  (let [(initMap (mapSet (mapEmpty) "theme" "dark")) (s0 (s/createStore initMap)) (actTheme (s/Action :name "SET_THEME" :payload (mapSet (mapEmpty) "theme" "light"))) (s1 (s/dispatchAction s0 actTheme sampleReducer)) (actInc (s/Action :name "INCREMENT" :payload (mapEmpty))) (s2 (s/dispatchAction s1 actInc sampleReducer)) (s3 (s/dispatchAction s2 actInc sampleReducer))] (assert (= s0.version 0) "Original store s0 must remain at version 0") (assert (= (s/getStateValue s0 "theme" "") "dark") "Original store s0 theme must remain dark") (assert (= s1.version 1) "Store s1 version must be 1") (assert (= (s/getStateValue s1 "theme" "") "light") "Store s1 theme must be updated to light") (refute (= (s/getStateValue s1 "theme" "") "dark") "Refute s1 theme equals dark") (assert (= s2.version 2) "Store s2 version must be 2") (assert (= (s/getStateValue s2 "counter" "0") "1") "Counter must increment to 1") (assert (= s3.version 3) "Store s3 version must be 3") (assert (= (s/getStateValue s3 "counter" "0") "2") "Counter must increment to 2") true)

fn testStatePatching -> Bool
  (let [(store0 (s/createStore (mapSet (mapEmpty) "role" "guest"))) (patchSet (s/StatePatch :path "user" :op "set" :value "alice")) (store1 (s/applyPatch store0 patchSet)) (patchUpdate (s/StatePatch :path "role" :op "set" :value "admin")) (store2 (s/applyPatch store1 patchUpdate)) (patchRemove (s/StatePatch :path "role" :op "remove" :value "")) (store3 (s/applyPatch store2 patchRemove)) (emptyPatch (s/StatePatch :path "" :op "set" :value "ignored")) (store4 (s/applyPatch store3 emptyPatch))] (assert (= store1.version 1) "store1 version must increment to 1") (assert (= (s/getStateValue store1 "user" "") "alice") "user must be alice in store1") (assert (= (s/getStateValue store2 "role" "") "admin") "role must be updated to admin in store2") (assert (= store3.version 3) "store3 version must increment to 3") (refute (mapHas? (s/getState store3) "role") "Refute role key exists after removal") (assert (= (s/getStateValue store3 "role" "absent") "absent") "role must return fallback default") (assert (= store4.version 3) "Empty path patch must not advance version") true)

fn testComputeStateDiffAndRoundtrip -> Bool
  (let [(oldMap (mapSet (mapSet (mapSet (mapEmpty) "k1" "v1") "k2" "v2") "k3" "v3")) (newMap (mapSet (mapSet (mapSet (mapEmpty) "k1" "v1") "k2" "v2-modified") "k4" "v4-new")) (diff (s/computeStateDiff oldMap newMap)) (baseStore (s/createStore oldMap)) (reconciledStore (s/applyPatches baseStore diff))] (assert (= (listLength diff) 3) "State diff must detect 1 modification, 1 addition, and 1 deletion") (assert (= (s/getStateValue reconciledStore "k1" "") "v1") "k1 must remain unchanged") (assert (= (s/getStateValue reconciledStore "k2" "") "v2-modified") "k2 must match modified value") (assert (= (s/getStateValue reconciledStore "k4" "") "v4-new") "k4 must match new value") (refute (mapHas? (s/getState reconciledStore) "k3") "Refute k3 exists after reconciliation") (assert (= (mapSize (s/getState reconciledStore)) 3) "Reconciled state must contain exactly 3 keys") true)

fn testSubscriptionLifecycle -> Bool
  (let [(store0 (s/createStore (mapEmpty))) (store1 (s/subscribeStore store0 "view-alpha")) (store2 (s/subscribeStore store1 "view-beta")) (store3 (s/unsubscribeStore store2 "view-alpha")) (store4 (s/unsubscribeStore store3 "view-gamma"))] (assert (= (listLength store1.subscribers) 1) "store1 must have 1 subscriber") (assert (s/hasSubscriber? store1 "view-alpha") "store1 must contain view-alpha") (assert (= (listLength store2.subscribers) 2) "store2 must have 2 subscribers") (assert (s/hasSubscriber? store2 "view-beta") "store2 must contain view-beta") (assert (= (listLength store3.subscribers) 1) "store3 must have 1 subscriber after unsubscription") (refute (s/hasSubscriber? store3 "view-alpha") "Refute view-alpha is subscribed in store3") (assert (= (listLength store4.subscribers) 1) "Unsubscribing nonexistent token must not alter subscribers") true)

fn testD77NegativeControls -> Bool
  (let [(store (s/createStore (mapEmpty))) (sSub1 (s/subscribeStore store "sub-primary")) (sSubDup (s/subscribeStore sSub1 "sub-primary")) (sSubEmpty (s/subscribeStore store "")) (invalidNegativeVer (s/StateStore :state (mapEmpty) :version -1 :subscribers (list))) (invalidDupSubs (s/StateStore :state (mapEmpty) :version 0 :subscribers (list "same" "same")))] (assert (= (listLength sSubDup.subscribers) 1) "Duplicate subscriber ID must be rejected idempotently") (refute (= (listLength sSubDup.subscribers) 2) "Refute that duplicate subscription increased subscriber count") (assert (= (listLength sSubEmpty.subscribers) 0) "Empty subscriber token must be rejected") (refute (s/hasSubscriber? sSubEmpty "") "Refute empty token is registered as subscriber") (assert (s/isValidState? store) "Standard store must satisfy isValidState?") (assert (not (s/isValidState? invalidNegativeVer)) "Store with negative version must fail isValidState?") (refute (s/isValidState? invalidNegativeVer) "Refute validity of store with negative version") (assert (not (s/isValidState? invalidDupSubs)) "Store with duplicate subscribers must fail isValidState?") (refute (s/isValidState? invalidDupSubs) "Refute validity of store with duplicate subscribers") true)

fn runTests -> Bool
  (and (testStoreCreationAndGetters) (and (testActionDispatchAndReducer) (and (testStatePatching) (and (testComputeStateDiffAndRoundtrip) (and (testSubscriptionLifecycle) (testD77NegativeControls))))))
