(module aslVdom/themeTest :x [runTests testDefaultThemeMetrics testDarkThemeMetrics testTokenResolvers testCssVariablesEmission testD77NegativeControls] :i [(theme :a t)])

fn testDefaultThemeMetrics -> Bool
  (let [(th (t/defaultTheme)) (c th.colors) (s th.spacing) (typ th.typography) (r th.radii)] (assert (= th.name "light") "Default theme name must be light") (assert (= c.primary "#2563eb") "Default primary color must be #2563eb") (assert (= c.background "#ffffff") "Default background color must be #ffffff") (assert (= c.surface "#f8fafc") "Default surface color must be #f8fafc") (assert (= c.text "#0f172a") "Default text color must be #0f172a") (assert (= c.border "#e2e8f0") "Default border color must be #e2e8f0") (assert (= s.xs 4) "Default xs spacing must be 4") (assert (= s.sm 8) "Default sm spacing must be 8") (assert (= s.md 16) "Default md spacing must be 16") (assert (= s.lg 24) "Default lg spacing must be 24") (assert (= s.xl 32) "Default xl spacing must be 32") (assert (= typ.fontSizeSm "14px") "Default fontSizeSm must be 14px") (assert (= typ.fontSizeBase "16px") "Default fontSizeBase must be 16px") (assert (= typ.fontSizeLg "18px") "Default fontSizeLg must be 18px") (assert (= r.sm 2) "Default sm radius must be 2") (assert (= r.md 4) "Default md radius must be 4") (assert (= r.lg 8) "Default lg radius must be 8") (assert (t/isValidTheme? th) "Default theme must satisfy isValidTheme?") true)

fn testDarkThemeMetrics -> Bool
  (let [(th (t/darkTheme)) (c th.colors) (s th.spacing) (typ th.typography) (r th.radii)] (assert (= th.name "dark") "Dark theme name must be dark") (assert (= c.primary "#2563eb") "Dark primary color must be #2563eb") (assert (= c.background "#090d16") "Dark background color must be #090d16") (assert (= c.surface "#111827") "Dark surface color must be #111827") (assert (= c.text "#f9fafb") "Dark text color must be #f9fafb") (assert (= c.border "#1f2937") "Dark border color must be #1f2937") (assert (= s.md 16) "Dark md spacing must match standard 16") (assert (= typ.fontSizeBase "16px") "Dark fontSizeBase must match standard 16px") (assert (= r.md 4) "Dark md radius must match standard 4") (assert (t/isValidTheme? th) "Dark theme must satisfy isValidTheme?") true)

fn testTokenResolvers -> Bool
  (let [(th (t/defaultTheme))] (assert (= (t/resolveColor th "primary") "#2563eb") "resolveColor primary") (assert (= (t/resolveColor th "background") "#ffffff") "resolveColor background") (assert (= (t/resolveColor th "surface") "#f8fafc") "resolveColor surface") (assert (= (t/resolveColor th "text") "#0f172a") "resolveColor text") (assert (= (t/resolveColor th "border") "#e2e8f0") "resolveColor border") (assert (= (t/resolveSpacing th "xs") 4) "resolveSpacing xs") (assert (= (t/resolveSpacing th "sm") 8) "resolveSpacing sm") (assert (= (t/resolveSpacing th "md") 16) "resolveSpacing md") (assert (= (t/resolveSpacing th "lg") 24) "resolveSpacing lg") (assert (= (t/resolveSpacing th "xl") 32) "resolveSpacing xl") (assert (= (t/resolveRadius th "sm") 2) "resolveRadius sm") (assert (= (t/resolveRadius th "md") 4) "resolveRadius md") (assert (= (t/resolveRadius th "lg") 8) "resolveRadius lg") (assert (= (t/resolveTypography th "sm") "14px") "resolveTypography sm") (assert (= (t/resolveTypography th "fontSizeSm") "14px") "resolveTypography fontSizeSm") (assert (= (t/resolveTypography th "base") "16px") "resolveTypography base") (assert (= (t/resolveTypography th "fontSizeBase") "16px") "resolveTypography fontSizeBase") (assert (= (t/resolveTypography th "lg") "18px") "resolveTypography lg") (assert (= (t/resolveTypography th "fontSizeLg") "18px") "resolveTypography fontSizeLg") true)

fn testCssVariablesEmission -> Bool
  (let [(th (t/defaultTheme)) (css (t/emitCssThemeVariables th)) (darkTh (t/darkTheme)) (darkCss (t/emitCssThemeSelector darkTh "[data-theme=\"dark\"]"))] (assert (stringStartsWith? css ":root {\n") "CSS variables must open with root selector") (assert (stringEndsWith? css "}") "CSS variables must close with brace") (assert (stringContains? css "  --color-primary: #2563eb;\n") "CSS must contain color primary") (assert (stringContains? css "  --color-background: #ffffff;\n") "CSS must contain color background") (assert (stringContains? css "  --color-surface: #f8fafc;\n") "CSS must contain color surface") (assert (stringContains? css "  --color-text: #0f172a;\n") "CSS must contain color text") (assert (stringContains? css "  --color-border: #e2e8f0;\n") "CSS must contain color border") (assert (stringContains? css "  --spacing-xs: 4px;\n") "CSS must contain spacing xs") (assert (stringContains? css "  --spacing-md: 16px;\n") "CSS must contain spacing md") (assert (stringContains? css "  --font-size-base: 16px;\n") "CSS must contain font size base") (assert (stringContains? css "  --radius-md: 4px;\n") "CSS must contain radius md") (assert (stringStartsWith? darkCss "[data-theme=\"dark\"] {\n") "Dark CSS selector targeting") (assert (stringContains? darkCss "  --color-background: #090d16;\n") "Dark CSS background override") true)

fn testD77NegativeControls -> Bool
  (let [(th (t/defaultTheme)) (colorFallback (t/resolveColor th "unknown-token-key")) (spacingFallback (t/resolveSpacing th "unknown-token-key")) (radiusFallback (t/resolveRadius th "unknown-token-key")) (typFallback (t/resolveTypography th "unknown-token-key")) (css (t/emitCssThemeVariables th)) (badColors (t/ThemeColors :primary "" :background "#ffffff" :surface "#f8fafc" :text "#0f172a" :border "#e2e8f0")) (badThemeEmptyColor (t/createTheme "bad" badColors (t/defaultSpacing) (t/defaultTypography) (t/defaultRadii))) (badSpacing (t/ThemeSpacing :xs -4 :sm 8 :md 16 :lg 24 :xl 32)) (badThemeNegSpacing (t/createTheme "bad" (t/defaultColors) badSpacing (t/defaultTypography) (t/defaultRadii))) (badRadii (t/ThemeRadii :sm -2 :md 4 :lg 8)) (badThemeNegRadius (t/createTheme "bad" (t/defaultColors) (t/defaultSpacing) (t/defaultTypography) badRadii))] (refute (stringEmpty? colorFallback) "Refute that unknown color token yields empty string") (assert (= colorFallback th.colors.text) "Deterministic color fallback must be theme text color") (refute (< spacingFallback 0) "Refute that unknown spacing token yields negative metric") (assert (= spacingFallback th.spacing.md) "Deterministic spacing fallback must be md spacing") (refute (< radiusFallback 0) "Refute that unknown radius token yields negative metric") (assert (= radiusFallback th.radii.md) "Deterministic radius fallback must be md radius") (refute (stringEmpty? typFallback) "Refute that unknown typography token yields empty string") (assert (= typFallback th.typography.fontSizeBase) "Deterministic typography fallback must be base size") (refute (t/isValidHexColor? "") "Refute empty hex string") (refute (t/isValidHexColor? "2563eb") "Refute hex string without leading hash") (refute (t/isValidHexColor? "#1") "Refute 1-char hex string") (refute (t/isValidHexColor? "#12345") "Refute 5-char hex string") (assert (t/isValidHexColor? "#fff") "Assert valid 3-digit hex") (assert (t/isValidHexColor? "#2563eb") "Assert valid 6-digit hex") (assert (t/isValidHexColor? "#2563ebff") "Assert valid 8-digit hex with alpha") (refute (t/isValidTheme? badThemeEmptyColor) "Refute theme with empty color token") (refute (t/isValidTheme? badThemeNegSpacing) "Refute theme with negative spacing token") (refute (t/isValidTheme? badThemeNegRadius) "Refute theme with negative radius token") (refute (not (stringEndsWith? css "}")) "Refute CSS output missing closing brace") (refute (stringContains? css "<") "Refute HTML opening bracket in CSS output") (refute (stringContains? css ">") "Refute HTML closing bracket in CSS output") (refute (stringContains? css "undefined") "Refute undefined in CSS output") (refute (stringContains? css "null") "Refute null in CSS output") (refute (stringContains? css "NaN") "Refute NaN in CSS output") true)

fn runTests -> Bool
  (and (testDefaultThemeMetrics) (and (testDarkThemeMetrics) (and (testTokenResolvers) (and (testCssVariablesEmission) (testD77NegativeControls)))))
