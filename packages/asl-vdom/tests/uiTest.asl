(module aslVdom/uiTest :x [runTests testUiButton testUiCard testUiList testUiModal testD77NegativeControls] :i [(aslVdom/ui :a ui) (aslVdom/vdom :a v) (aslVdom/theme :a t)])

fn testUiButton -> Bool
  (let [(pPrimary (ui/ButtonProps :label "Submit" :variant "primary" :size "md" :action "onSubmit" :disabled false)) (btnPrimary (ui/uiButton pPrimary)) (attrsPrimary (v/vnodeAttrs btnPrimary)) (pDisabled (ui/ButtonProps :label "Cancel" :variant "secondary" :size "sm" :action "onCancel" :disabled true)) (btnDisabled (ui/uiButton pDisabled)) (attrsDisabled (v/vnodeAttrs btnDisabled)) (pOutline (ui/ButtonProps :label "Outline" :variant "outline" :size "lg" :action "onOutline" :disabled false)) (btnOutline (ui/uiButton pOutline)) (attrsOutline (v/vnodeAttrs btnOutline)) (pGhost (ui/ButtonProps :label "Ghost" :variant "ghost" :size "md" :action "" :disabled false)) (btnGhost (ui/uiButton pGhost)) (attrsGhost (v/vnodeAttrs btnGhost))] (assert (v/isValidNode btnPrimary) "Primary button must be valid node") (assert (= (v/vnodeTag btnPrimary) "button") "Primary button tag must be button") (assert (= (mt (mapGet attrsPrimary "role") ((some r) r) ((none) "")) "button") "Button role must be button") (assert (= (mt (mapGet attrsPrimary "type") ((some t) t) ((none) "")) "button") "Button type must be button") (assert (= (mt (mapGet attrsPrimary "class") ((some c) c) ((none) "")) "ui-button ui-button-primary ui-button-md") "Button class hierarchy") (assert (= (mt (mapGet attrsPrimary "token-bg") ((some b) b) ((none) "")) "var(--color-primary)") "Primary button background token") (assert (= (mt (mapGet attrsPrimary "token-color") ((some c) c) ((none) "")) "var(--color-background)") "Primary button text color token") (assert (= (mt (mapGet attrsPrimary "token-padding") ((some p) p) ((none) "")) "var(--spacing-md)") "Medium button padding token") (assert (= (mt (mapGet attrsPrimary "token-radius") ((some r) r) ((none) "")) "var(--radius-md)") "Medium button radius token") (assert (= (mt (mapGet attrsPrimary "onclick") ((some a) a) ((none) "")) "onSubmit") "Button click action dispatch") (assert (= (listLength (v/vnodeChildren btnPrimary)) 1) "Button has exactly one child text node") (assert (= (v/vnodeText (optionOr (listGet (v/vnodeChildren btnPrimary) 0) (v/t ""))) "Submit") "Button label matches") (assert (= (mt (mapGet attrsDisabled "token-bg") ((some b) b) ((none) "")) "var(--color-surface)") "Secondary button background token") (assert (= (mt (mapGet attrsDisabled "token-color") ((some c) c) ((none) "")) "var(--color-text)") "Secondary button text color token") (assert (= (mt (mapGet attrsDisabled "token-padding") ((some p) p) ((none) "")) "var(--spacing-sm)") "Small button padding token") (assert (= (mt (mapGet attrsDisabled "disabled") ((some d) d) ((none) "")) "true") "Disabled attribute must be true") (assert (= (mt (mapGet attrsDisabled "aria-disabled") ((some d) d) ((none) "")) "true") "aria-disabled attribute must be true") (assert (= (mt (mapGet attrsOutline "token-bg") ((some b) b) ((none) "")) "transparent") "Outline button background transparent") (assert (= (mt (mapGet attrsOutline "token-color") ((some c) c) ((none) "")) "var(--color-primary)") "Outline button text color primary") (assert (= (mt (mapGet attrsOutline "token-padding") ((some p) p) ((none) "")) "var(--spacing-lg)") "Large button padding token") (assert (= (mt (mapGet attrsGhost "token-bg") ((some b) b) ((none) "")) "transparent") "Ghost button background transparent") (assert (= (mt (mapGet attrsGhost "token-color") ((some c) c) ((none) "")) "var(--color-text)") "Ghost button text color text") (assert (= (mt (mapGet attrsGhost "onclick") ((some a) a) ((none) "")) "") "Empty action leaves onclick unassigned") true)

fn testUiCard -> Bool
  (let [(bodyContent (v/elem "p" (mapEmpty) (list (v/text "Card body information")))) (footerContent (v/elem "span" (mapEmpty) (list (v/text "Status: Active")))) (cardFullProps (ui/CardProps :title "Overview" :subtitle "System metrics summary" :content bodyContent :footer (some footerContent))) (cardFull (ui/uiCard cardFullProps)) (attrsFull (v/vnodeAttrs cardFull)) (chFull (v/vnodeChildren cardFull)) (cardNoFooterProps (ui/CardProps :title "Simple Card" :subtitle "" :content bodyContent :footer (none))) (cardNoFooter (ui/uiCard cardNoFooterProps)) (chNoFooter (v/vnodeChildren cardNoFooter))] (assert (v/isValidNode cardFull) "Card must be valid node") (assert (= (v/vnodeTag cardFull) "div") "Card root container must be div") (assert (= (mt (mapGet attrsFull "class") ((some c) c) ((none) "")) "ui-card") "Card class must be ui-card") (assert (= (mt (mapGet attrsFull "role") ((some r) r) ((none) "")) "region") "Card role must be region") (assert (= (mt (mapGet attrsFull "token-bg") ((some b) b) ((none) "")) "var(--color-surface)") "Card surface token") (assert (= (mt (mapGet attrsFull "token-color") ((some c) c) ((none) "")) "var(--color-text)") "Card text token") (assert (= (mt (mapGet attrsFull "token-radius") ((some r) r) ((none) "")) "var(--radius-md)") "Card radius token") (assert (= (mt (mapGet attrsFull "token-padding") ((some p) p) ((none) "")) "var(--spacing-md)") "Card padding token") (assert (= (mt (mapGet attrsFull "token-border") ((some b) b) ((none) "")) "var(--color-border)") "Card border token") (assert (= (listLength chFull) 3) "Card with footer must have exactly 3 child containers (header, content, footer)") (let [(hdr (optionOr (listGet chFull 0) (v/t ""))) (cnt (optionOr (listGet chFull 1) (v/t ""))) (ftr (optionOr (listGet chFull 2) (v/t "")))] (assert (= (mt (mapGet (v/vnodeAttrs hdr) "class") ((some c) c) ((none) "")) "ui-card-header") "Header container class") (assert (= (listLength (v/vnodeChildren hdr)) 2) "Header with title and subtitle has 2 children") (assert (= (mt (mapGet (v/vnodeAttrs cnt) "class") ((some c) c) ((none) "")) "ui-card-content") "Content container class") (assert (= (mt (mapGet (v/vnodeAttrs ftr) "class") ((some c) c) ((none) "")) "ui-card-footer") "Footer container class")) (assert (= (listLength chNoFooter) 2) "Card without footer must have exactly 2 child containers (header, content)") (let [(hdr (optionOr (listGet chNoFooter 0) (v/t "")))] (assert (= (listLength (v/vnodeChildren hdr)) 1) "Header without subtitle has only title child")) true)

fn testUiList -> Bool
  (let [(item1 (v/elem "span" (mapEmpty) (list (v/text "Item One")))) (item2 (v/elem "span" (mapEmpty) (list (v/text "Item Two")))) (item3 (v/elem "span" (mapEmpty) (list (v/text "Item Three")))) (items (list item1 item2 item3)) (listUndividedProps (ui/ListProps :items items :direction "vertical" :spacing "md" :divided false)) (listUndivided (ui/uiList listUndividedProps)) (attrsUndivided (v/vnodeAttrs listUndivided)) (chUndivided (v/vnodeChildren listUndivided)) (listDividedProps (ui/ListProps :items items :direction "horizontal" :spacing "lg" :divided true)) (listDivided (ui/uiList listDividedProps)) (attrsDivided (v/vnodeAttrs listDivided)) (chDivided (v/vnodeChildren listDivided))] (assert (v/isValidNode listUndivided) "Undivided list is valid node") (assert (= (v/vnodeTag listUndivided) "div") "List container tag is div") (assert (= (mt (mapGet attrsUndivided "class") ((some c) c) ((none) "")) "ui-list ui-list-vertical") "Vertical list class") (assert (= (mt (mapGet attrsUndivided "role") ((some r) r) ((none) "")) "list") "List role must be list") (assert (= (mt (mapGet attrsUndivided "token-spacing") ((some s) s) ((none) "")) "var(--spacing-md)") "List spacing md") (assert (= (listLength chUndivided) 3) "Undivided list preserves exact item count") (assert (= (v/vnodeText (optionOr (listGet (v/vnodeChildren (optionOr (listGet chUndivided 0) (v/t ""))) 0) (v/t ""))) "Item One") "First item preserved") (assert (= (v/vnodeText (optionOr (listGet (v/vnodeChildren (optionOr (listGet chUndivided 1) (v/t ""))) 0) (v/t ""))) "Item Two") "Second item preserved") (assert (= (v/vnodeText (optionOr (listGet (v/vnodeChildren (optionOr (listGet chUndivided 2) (v/t ""))) 0) (v/t ""))) "Item Three") "Third item preserved") (assert (= (mt (mapGet attrsDivided "class") ((some c) c) ((none) "")) "ui-list ui-list-horizontal") "Horizontal list class") (assert (= (mt (mapGet attrsDivided "token-spacing") ((some s) s) ((none) "")) "var(--spacing-lg)") "List spacing lg") (assert (= (listLength chDivided) 5) "Divided list with 3 items interleaves 2 dividers yielding 5 children") (assert (= (v/vnodeTag (optionOr (listGet chDivided 1) (v/t ""))) "hr") "Index 1 is divider hr") (assert (= (v/vnodeTag (optionOr (listGet chDivided 3) (v/t ""))) "hr") "Index 3 is divider hr") (assert (= (mt (mapGet (v/vnodeAttrs (optionOr (listGet chDivided 1) (v/t ""))) "token-color") ((some c) c) ((none) "")) "var(--color-border)") "Divider token border color") true)

fn testUiModal -> Bool
  (let [(body (v/elem "p" (mapEmpty) (list (v/text "Modal dialogue message")))) (openProps (ui/ModalProps :title "Confirm Deletion" :isOpen true :content body :onCloseAction "onCancelModal" :confirmAction "onConfirmDelete")) (openModal (ui/uiModal openProps)) (attrsModal (v/vnodeAttrs openModal)) (chModal (v/vnodeChildren openModal))] (assert (v/isValidNode openModal) "Open modal is valid node") (assert (= (v/vnodeTag openModal) "div") "Modal backdrop is div") (assert (= (mt (mapGet attrsModal "class") ((some c) c) ((none) "")) "ui-modal-backdrop") "Modal backdrop class") (assert (= (mt (mapGet attrsModal "role") ((some r) r) ((none) "")) "dialog") "Modal backdrop role is dialog") (assert (= (mt (mapGet attrsModal "aria-modal") ((some a) a) ((none) "")) "true") "Modal aria-modal is true") (assert (ui/isAccessibleModal? openModal) "Open modal satisfies isAccessibleModal?") (assert (= (listLength chModal) 1) "Backdrop contains exactly one dialog card") (let [(dialog (optionOr (listGet chModal 0) (v/t ""))) (dialogAttrs (v/vnodeAttrs dialog)) (dialogCh (v/vnodeChildren dialog))] (assert (= (mt (mapGet dialogAttrs "class") ((some c) c) ((none) "")) "ui-modal-dialog") "Dialog card class") (assert (= (mt (mapGet dialogAttrs "role") ((some r) r) ((none) "")) "dialog") "Dialog card role is dialog") (assert (= (mt (mapGet dialogAttrs "aria-modal") ((some a) a) ((none) "")) "true") "Dialog card aria-modal is true") (assert (= (mt (mapGet dialogAttrs "token-bg") ((some b) b) ((none) "")) "var(--color-surface)") "Dialog surface color token") (assert (= (listLength dialogCh) 3) "Dialog card has header, content, and footer") (let [(hdr (optionOr (listGet dialogCh 0) (v/t ""))) (hdrCh (v/vnodeChildren hdr)) (closeBtn (optionOr (listGet hdrCh 1) (v/t ""))) (closeAttrs (v/vnodeAttrs closeBtn))] (assert (= (mt (mapGet closeAttrs "onclick") ((some a) a) ((none) "")) "onCancelModal") "Close button dispatches onCloseAction") (assert (= (mt (mapGet closeAttrs "aria-label") ((some l) l) ((none) "")) "Close") "Close button has accessible aria-label")) (let [(ftr (optionOr (listGet dialogCh 2) (v/t ""))) (ftrCh (v/vnodeChildren ftr)) (cancelBtn (optionOr (listGet ftrCh 0) (v/t ""))) (confirmBtn (optionOr (listGet ftrCh 1) (v/t "")))] (assert (= (listLength ftrCh) 2) "Footer contains cancel and confirm action buttons") (assert (= (mt (mapGet (v/vnodeAttrs cancelBtn) "onclick") ((some a) a) ((none) "")) "onCancelModal") "Cancel button dispatches onCloseAction") (assert (= (mt (mapGet (v/vnodeAttrs confirmBtn) "onclick") ((some a) a) ((none) "")) "onConfirmDelete") "Confirm button dispatches confirmAction"))) true)

fn testD77NegativeControls -> Bool
  (let [(badBtnEmpty (ui/ButtonProps :label "" :variant "primary" :size "md" :action "act" :disabled false)) (btnEmptyNode (ui/uiButton badBtnEmpty)) (badBtnVariant (ui/ButtonProps :label "Save" :variant "super-custom" :size "md" :action "act" :disabled false)) (btnVariantNode (ui/uiButton badBtnVariant)) (badBtnSize (ui/ButtonProps :label "Save" :variant "primary" :size "colossal" :action "act" :disabled false)) (btnSizeNode (ui/uiButton badBtnSize)) (closedModalProps (ui/ModalProps :title "Hidden" :isOpen false :content (v/elem "p" (mapEmpty) (list (v/text "Hidden Body"))) :onCloseAction "close" :confirmAction "confirm")) (closedModalNode (ui/uiModal closedModalProps)) (plainDiv (v/elem "div" (mapEmpty) (list))) (alertDiv (v/elem "div" (mapSet (mapEmpty) "role" "alert") (list))) (missingAriaModal (v/elem "div" (mapSet (mapEmpty) "role" "dialog") (list))) (openModalProps (ui/ModalProps :title "Active" :isOpen true :content (v/elem "p" (mapEmpty) (list (v/text "Body"))) :onCloseAction "close" :confirmAction "confirm")) (openModalNode (ui/uiModal openModalProps)) (openModalAttrs (v/vnodeAttrs openModalNode)) (n1 (v/t "Alpha")) (n2 (v/t "Beta")) (n3 (v/t "Gamma")) (testItems (list n1 n2 n3)) (undivided (ui/uiList (ui/ListProps :items testItems :direction "vertical" :spacing "md" :divided false))) (divided (ui/uiList (ui/ListProps :items testItems :direction "vertical" :spacing "md" :divided true))) (chUndivided (v/vnodeChildren undivided)) (chDivided (v/vnodeChildren divided)) (cardNoFtr (ui/uiCard (ui/CardProps :title "T" :subtitle "S" :content (v/t "C") :footer (none)))) (chCardNoFtr (v/vnodeChildren cardNoFtr))] (refute (ui/isValidButtonProps? badBtnEmpty) "Refute button with empty label satisfying validation") (refute (= (v/vnodeTag btnEmptyNode) "button") "Refute button with empty label rendering button element") (refute (v/isValidNode btnEmptyNode) "Refute button with empty label rendering valid node") (refute (ui/isValidButtonProps? badBtnVariant) "Refute button with invalid variant satisfying validation") (refute (= (v/vnodeTag btnVariantNode) "button") "Refute button with invalid variant rendering button element") (refute (v/isValidNode btnVariantNode) "Refute button with invalid variant rendering valid node") (refute (ui/isValidButtonProps? badBtnSize) "Refute button with invalid size metric satisfying validation") (refute (= (v/vnodeTag btnSizeNode) "button") "Refute button with invalid size rendering button element") (refute (ui/isValidButtonVariant? "") "Refute empty variant") (refute (ui/isValidButtonVariant? "unknown") "Refute unknown variant") (refute (ui/isValidButtonSize? "") "Refute empty size") (refute (ui/isValidButtonSize? "mega") "Refute mega size") (refute (v/isValidNode closedModalNode) "Refute closed modal emitting valid visible VNode") (refute (= (v/vnodeTag closedModalNode) "div") "Refute closed modal emitting div tag") (refute (= (v/vnodeTag closedModalNode) "dialog") "Refute closed modal emitting dialog tag") (refute (> (listLength (v/vnodeChildren closedModalNode)) 0) "Refute closed modal emitting any children") (assert (= (v/vnodeText closedModalNode) "") "Closed modal must evaluate to empty text node") (refute (not (= (mt (mapGet openModalAttrs "role") ((some r) r) ((none) "")) "dialog")) "Refute modal omitting role dialog") (refute (stringEmpty? (mt (mapGet openModalAttrs "role") ((some r) r) ((none) ""))) "Refute modal role being empty") (refute (not (= (mt (mapGet openModalAttrs "aria-modal") ((some a) a) ((none) "")) "true")) "Refute modal omitting aria-modal true") (refute (ui/isAccessibleModal? plainDiv) "Refute plain div satisfying isAccessibleModal?") (refute (ui/isAccessibleModal? alertDiv) "Refute non-dialog role satisfying isAccessibleModal?") (refute (ui/isAccessibleModal? missingAriaModal) "Refute missing aria-modal satisfying isAccessibleModal?") (refute (< (listLength chUndivided) 3) "Refute dropping child nodes in undivided list") (refute (> (listLength chUndivided) 3) "Refute duplicating child nodes in undivided list") (refute (< (listLength chDivided) 5) "Refute dropping child nodes in divided list") (refute (> (listLength chDivided) 5) "Refute duplicating child nodes in divided list") (refute (not (= (v/vnodeText (optionOr (listGet chDivided 0) (v/t ""))) "Alpha")) "Refute corruption of first list item") (refute (not (= (v/vnodeText (optionOr (listGet chDivided 2) (v/t ""))) "Beta")) "Refute corruption of second list item") (refute (not (= (v/vnodeText (optionOr (listGet chDivided 4) (v/t ""))) "Gamma")) "Refute corruption of third list item") (refute (not (= (v/vnodeTag (optionOr (listGet chDivided 1) (v/t ""))) "hr")) "Refute missing first divider") (refute (not (= (v/vnodeTag (optionOr (listGet chDivided 3) (v/t ""))) "hr")) "Refute missing second divider") (refute (> (listLength chCardNoFtr) 2) "Refute card without footer emitting more than 2 child containers") (refute (= (listLength chCardNoFtr) 3) "Refute card without footer emitting 3 child containers") true)

fn runTests -> Bool
  (and (testUiButton) (and (testUiCard) (and (testUiList) (and (testUiModal) (testD77NegativeControls)))))
