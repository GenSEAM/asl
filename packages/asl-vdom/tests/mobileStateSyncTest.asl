(module aslVdom/mobileStateSyncTest :x [runTests testSwiftuiViewModelEmission testComposeViewModelEmission testWebStateHookEmission testSwiftuiViewWithViewModelBinding testComposeComposableWithViewModelBinding testD77StructuralRefutations] :i [(aslVdom/vdom :a v) (aslVdom/polyglot :a poly)])

fn testSwiftuiViewModelEmission -> Bool
  (let [(bindings (list (pair "email" "") (pair "password" "") (pair "rememberMe" "true"))) (code (poly/emitSwiftuiViewModel "Auth" bindings))] (assert (stringContains? code "public class AuthViewModel: ObservableObject") "SwiftUI ViewModel must inherit ObservableObject") (assert (stringContains? code "@Observable") "SwiftUI ViewModel must be annotated with @Observable") (assert (stringContains? code "import SwiftUI") "SwiftUI ViewModel must import SwiftUI") (assert (stringContains? code "import Combine") "SwiftUI ViewModel must import Combine") (assert (stringContains? code "@Published public var email: String = \"\"") "Email property must be @Published") (assert (stringContains? code "@Published public var password: String = \"\"") "Password property must be @Published") (assert (stringContains? code "@Published public var rememberMe: String = \"true\"") "RememberMe property must be initialized to true") (assert (stringContains? code "public func dispatchEvent(_ action: String, _ value: String = \"\")") "Must declare dispatchEvent bridge method") (refute (stringContains? code "@Published public var nonexistent") "Refute nonexistent published property") (refute (stringContains? code "class LoginViewModel") "Refute mismatched ViewModel name") true)

fn testComposeViewModelEmission -> Bool
  (let [(bindings (list (pair "email" "") (pair "token" "xyz"))) (code (poly/emitComposeViewModel "Auth" bindings))] (assert (stringContains? code "class AuthViewModel : ViewModel()") "Compose ViewModel must inherit ViewModel") (assert (stringContains? code "import androidx.lifecycle.ViewModel") "Compose ViewModel must import AndroidX ViewModel") (assert (stringContains? code "var email by mutableStateOf(\"\")") "Email property must use mutableStateOf") (assert (stringContains? code "var token by mutableStateOf(\"xyz\")") "Token property must be initialized with xyz") (assert (stringContains? code "fun dispatchEvent(action: String, value: String = \"\")") "Must declare dispatchEvent bridge method") (refute (stringContains? code "var missing by mutableStateOf") "Refute missing property in Compose ViewModel") (refute (stringContains? code "class OtherViewModel") "Refute incorrect class name") true)

fn testWebStateHookEmission -> Bool
  (let [(bindings (list (pair "email" "") (pair "active" "false"))) (code (poly/emitWebStateHook "Auth" bindings))] (assert (stringContains? code "export const useAuthState = () =>") "Web hook must export useAuthState") (assert (stringContains? code "const [email, setEmail] = useState(\"\");") "Must declare useState for email") (assert (stringContains? code "const [active, setActive] = useState(\"false\");") "Must declare useState for active") (assert (stringContains? code "email,") "Hook return must include email") (assert (stringContains? code "setEmail,") "Hook return must include setEmail") (assert (stringContains? code "dispatchEvent,") "Hook return must include dispatchEvent") (refute (stringContains? code "const [missing, setMissing]") "Refute nonexistent state in web hook") (refute (stringContains? code "export const useOtherState") "Refute incorrect hook name") true)

fn testSwiftuiViewWithViewModelBinding -> Bool
  (let [(inputAttrs (mapSet (mapSet (mapEmpty) "placeholder" "Enter Email") "bind" "email")) (inputNode (v/elem "input" inputAttrs (list))) (btnAttrs (mapSet (mapSet (mapEmpty) "onclick" "submitAuth") "value" "loginPayload")) (btnNode (v/elem "button" btnAttrs (list (v/text "Log In")))) (root (v/elemPlain "vstack" (list inputNode btnNode))) (code (poly/emitSwiftuiView "Login" root))] (assert (stringContains? code "public struct LoginView: View {") "SwiftUI View must declare struct") (assert (stringContains? code "@StateObject private var viewModel = LoginViewModel()") "SwiftUI View must observe ViewModel via @StateObject") (assert (stringContains? code "TextField(\"Enter Email\", text: $viewModel.email)") "TextField must bind two-way to $viewModel.email") (assert (stringContains? code "Button(action: { viewModel.dispatchEvent(\"submitAuth\", \"loginPayload\") })") "Button must dispatch event via viewModel") (refute (stringContains? code "text: $email") "Refute unbound $email textfield binding") (refute (stringContains? code "action: { dispatchEvent(\"submitAuth\") }") "Refute unbound dispatchEvent call without viewModel") true)

fn testComposeComposableWithViewModelBinding -> Bool
  (let [(inputAttrs (mapSet (mapSet (mapEmpty) "placeholder" "Enter Email") "bind" "email")) (inputNode (v/elem "input" inputAttrs (list))) (btnAttrs (mapSet (mapSet (mapEmpty) "onclick" "submitAuth") "value" "loginPayload")) (btnNode (v/elem "button" btnAttrs (list (v/text "Log In")))) (root (v/elemPlain "vstack" (list inputNode btnNode))) (code (poly/emitComposeComposable "Login" root))] (assert (stringContains? code "fun Login(viewModel: LoginViewModel = viewModel()) {") "Composable must receive default viewModel") (assert (stringContains? code "TextField(value = viewModel.email, onValueChange = { viewModel.email = it }") "TextField must bind two-way to viewModel.email") (assert (stringContains? code "Button(onClick = { viewModel.dispatchEvent(\"submitAuth\", \"loginPayload\") }") "Button must dispatch event via viewModel") (refute (stringContains? code "fun Login() {") "Refute parameterless Compose function") (refute (stringContains? code "value = state.email") "Refute legacy state.email binding") (refute (stringContains? code "onClick = { dispatchEvent(\"submitAuth\") }") "Refute unbound dispatchEvent call without viewModel") true)

fn testD77StructuralRefutations -> Bool
  (let [(emptyBindings (list)) (swiftVm (poly/emitSwiftuiViewModel "Empty" emptyBindings)) (composeVm (poly/emitComposeViewModel "Empty" emptyBindings)) (webHook (poly/emitWebStateHook "Empty" emptyBindings)) (plainNode (v/elemPlain "div" (list (v/text "Hello")))) (swiftView (poly/emitSwiftuiView "Empty" plainNode)) (composeView (poly/emitComposeComposable "Empty" plainNode))] (assert (stringContains? swiftVm "public class EmptyViewModel: ObservableObject") "Empty SwiftUI ViewModel must still be valid ObservableObject") (refute (stringContains? swiftVm "@Published") "Empty SwiftUI ViewModel must not contain @Published properties") (assert (stringContains? composeVm "class EmptyViewModel : ViewModel()") "Empty Compose ViewModel must still be valid ViewModel") (refute (stringContains? composeVm "by mutableStateOf") "Empty Compose ViewModel must not declare state properties") (assert (stringContains? webHook "export const useEmptyState = () =>") "Empty web hook must still export useEmptyState") (refute (stringContains? webHook "const [") "Empty web hook must not declare state variables") (assert (stringContains? swiftView "@StateObject private var viewModel = EmptyViewModel()") "SwiftUI View must always observe ViewModel") (refute (stringContains? swiftView "TextField") "Plain node must not emit TextField") (assert (stringContains? composeView "viewModel: EmptyViewModel = viewModel()") "Compose View must always accept ViewModel") (refute (stringContains? composeView "TextField") "Plain node must not emit TextField in Compose") (refute (= (stringLength swiftVm) 0) "Refute empty string emission for Swift ViewModel") (refute (= (stringLength composeVm) 0) "Refute empty string emission for Compose ViewModel") true)

fn runTests -> Bool
  (and (testSwiftuiViewModelEmission) (and (testComposeViewModelEmission) (and (testWebStateHookEmission) (and (testSwiftuiViewWithViewModelBinding) (and (testComposeComposableWithViewModelBinding) (testD77StructuralRefutations))))))
