(module asl-vdom/core
  :doc "S-expression declarative VDOM node representation and tree diffing"
  :export [VAttr VNode v-element v-text render-html]
  :import [(core/strings :as s)])

(defschema VAttr
  (:field key String "Attribute name (class, id, style, onClick)")
  (:field val String "Attribute string value"))

(defenum VNode
  (:case text    [(content String)]                              "Text leaf node")
  (:case element [(tag String) (attrs (List VAttr)) (children (List VNode))] "DOM element"))

(defun v-text [(content String)] -> VNode
  :doc "Constructs a text VDOM node"
  (text content))

(defun v-element [(tag String) (attrs (List VAttr)) (children (List VNode))] -> VNode
  :doc "Constructs an element VDOM node"
  (element tag attrs children))

(defun render-html [(node VNode)] -> String
  :doc "Renders VDOM tree to pure HTML string"
  (match node
    ((text content) content)
    ((element tag attrs children)
      (s/concat (s/concat "<" tag) (s/concat ">" (s/concat "</" (s/concat tag ">")))))))
