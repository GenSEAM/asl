(module aslVdom/polyglot :x [emitReactTsx emitVueSfc emitSvelteComponent emitSsrHtml emitSwiftuiView emitComposeComposable emitSwiftuiViewModel emitComposeViewModel emitWebStateHook compileComponent emitSwiftuiModifiers emitComposeModifierArg vueAttrKey svelteAttrKey htmlAttrKey isSelfClosing? indentSpaces] :i [(aslVdom/vdom :a v)])

fn indentSpaces level: Int64 -> String
  (if (<= level 0) "" (str "  " (indentSpaces (- level 1))))

fn capitalize s: String -> String
  (if (stringEmpty? s) "" (let [(head (stringUpper (optionOr (stringSlice s 0 1) ""))) (tail (if (> (stringLength s) 1) (optionOr (stringSlice s 1 (stringLength s)) "") ""))] (str head tail)))

fn isSelfClosing? tag: String -> Bool
  (or (= tag "input") (or (= tag "img") (or (= tag "br") (or (= tag "hr") (or (= tag "meta") (= tag "link"))))))

fn vueAttrKey k: String -> String
  (cond ((= k "onclick") "@click") ((= k "oninput") "@input") ((= k "onchange") "@change") ((= k "onsubmit") "@submit.prevent") (else k))

fn svelteAttrKey k: String -> String
  (cond ((= k "onclick") "onclick") ((= k "oninput") "oninput") ((= k "onchange") "onchange") (else k))

fn htmlAttrKey k: String -> String
  k

fn resolveSpacingMetric val: String -> String
  (if (stringEmpty? val) "" (cond ((= val "xs") "4") ((= val "sm") "8") ((= val "md") "16") ((= val "lg") "24") ((= val "xl") "32") (else val)))

fn resolveRadiusMetric val: String -> String
  (if (stringEmpty? val) "" (cond ((= val "sm") "2") ((= val "md") "4") ((= val "lg") "8") (else val)))

fn swiftuiColorExpr c: String -> String
  (if (stringEmpty? c) "" (cond ((stringStartsWith? c "Color.") c) ((stringStartsWith? c ".") c) (else (str "Color." c))))

fn composeColorExpr c: String -> String
  (if (stringEmpty? c) "" (cond ((stringStartsWith? c "Color.") c) (else (str "Color." (capitalize c)))))

fn resolveColorCssVar v: String -> String
  (if (stringEmpty? v) "" (if (or (stringStartsWith? v "var(") (stringStartsWith? v "#")) v (str "var(--color-" v ")")))

fn resolveSpacingCssVar v: String -> String
  (if (stringEmpty? v) "" (cond ((stringStartsWith? v "var(") v) ((or (= v "xs") (or (= v "sm") (or (= v "md") (or (= v "lg") (= v "xl"))))) (str "var(--spacing-" v ")")) ((stringEndsWith? v "px") v) (else (str v "px"))))

fn resolveRadiusCssVar v: String -> String
  (if (stringEmpty? v) "" (cond ((stringStartsWith? v "var(") v) ((or (= v "sm") (or (= v "md") (= v "lg"))) (str "var(--radius-" v ")")) ((stringEndsWith? v "px") v) (else (str v "px"))))

fn isTokenAttr? k: String -> Bool
  (or (= k "token-bg") (or (= k "token-background") (or (= k "token-color") (or (= k "token-text") (or (= k "token-spacing") (or (= k "token-padding") (or (= k "token-radius") (= k "token-border"))))))))

fn tokenToCssDecl k: String v: String -> String
  (if (stringEmpty? v) "" (cond ((or (= k "token-bg") (= k "token-background")) (str "background-color: " (resolveColorCssVar v) ";")) ((or (= k "token-color") (= k "token-text")) (str "color: " (resolveColorCssVar v) ";")) ((or (= k "token-spacing") (= k "token-padding")) (str "padding: " (resolveSpacingCssVar v) ";")) ((= k "token-radius") (str "border-radius: " (resolveRadiusCssVar v) ";")) ((= k "token-border") (str "border-color: " (resolveColorCssVar v) ";")) (else "")))

fn tokenToReactStyleProp k: String v: String -> String
  (if (stringEmpty? v) "" (cond ((or (= k "token-bg") (= k "token-background")) (str "backgroundColor: \"" (resolveColorCssVar v) "\"")) ((or (= k "token-color") (= k "token-text")) (str "color: \"" (resolveColorCssVar v) "\"")) ((or (= k "token-spacing") (= k "token-padding")) (str "padding: \"" (resolveSpacingCssVar v) "\"")) ((= k "token-radius") (str "borderRadius: \"" (resolveRadiusCssVar v) "\"")) ((= k "token-border") (str "borderColor: \"" (resolveColorCssVar v) "\"")) (else "")))

fn emitAttrs attrs: (Map String String) target: String -> String
  (let [(keys (mapKeys attrs)) (pairs (map (fn [(k String)] -> (Pair String String) (pair k (optionOr (mapGet attrs k) ""))) keys))] (if (= (listLength pairs) 0) "" (let [(normalPairs (filter (fn [(p (pair String String))] -> Bool (let [(k (pairFirst p))] (and (not (isTokenAttr? k)) (!= k "style")))) pairs)) (tokenPairs (filter (fn [(p (pair String String))] -> Bool (let [(k (pairFirst p)) (v (pairSecond p))] (and (isTokenAttr? k) (not (stringEmpty? v))))) pairs)) (existingStyle (mt (mapGet attrs "style") ((some s) s) ((none) ""))) (renderedNormal (map (fn [(p (pair String String))] -> String (let [(rawK (pairFirst p)) (v (pairSecond p)) (k (cond ((= target "vue") (vueAttrKey rawK)) ((= target "svelte") (svelteAttrKey rawK)) ((= target "react") (if (= rawK "class") "className" rawK)) (else (htmlAttrKey rawK))))] (str " " k "=\"" v "\""))) normalPairs)) (normalStr (stringJoin renderedNormal "")) (styleStr (if (= (listLength tokenPairs) 0) (if (= existingStyle "") "" (str " style=\"" existingStyle "\"")) (if (= target "react") (let [(reactProps (map (fn [(p (pair String String))] -> String (tokenToReactStyleProp (pairFirst p) (pairSecond p))) tokenPairs)) (reactNonEmpty (filter (fn [(s String)] -> Bool (not (stringEmpty? s))) reactProps)) (joinedProps (stringJoin reactNonEmpty ", "))] (if (= joinedProps "") (if (= existingStyle "") "" (str " style=\"" existingStyle "\"")) (str " style={{ " joinedProps " }}"))) (let [(cssDecls (map (fn [(p (pair String String))] -> String (tokenToCssDecl (pairFirst p) (pairSecond p))) tokenPairs)) (cssNonEmpty (filter (fn [(s String)] -> Bool (not (stringEmpty? s))) cssDecls)) (joinedDecls (stringJoin cssNonEmpty " ")) (combined (if (= existingStyle "") joinedDecls (let [(sep (if (stringEndsWith? existingStyle ";") " " "; "))] (str existingStyle sep joinedDecls))))] (if (= combined "") "" (str " style=\"" combined "\""))))))] (str normalStr styleStr))))

fn emitVnode target: String node: v/VNode indent: Int64 -> String
  (let [(pad (indentSpaces indent))] (mt node ((v/textNode content) (str pad content)) ((v/elementNode tag attrs children) (let [(attrStr (emitAttrs attrs target)) (chLen (listLength children))] (if (= chLen 0) (if (isSelfClosing? tag) (str pad "<" tag attrStr " />") (str pad "<" tag attrStr "></" tag ">")) (if (= chLen 1) (let [(firstCh (mt (listHead children) ((some c) c) ((none) (v/textNode ""))))] (mt firstCh ((v/textNode txt) (str pad "<" tag attrStr ">" txt "</" tag ">")) ((v/elementNode _ _ _) (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitVnode target ch (+ indent 1))) children)) (chJoined (stringJoin chStrs "\n"))] (str pad "<" tag attrStr ">\n" chJoined "\n" pad "</" tag ">"))))) (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitVnode target ch (+ indent 1))) children)) (chJoined (stringJoin chStrs "\n"))] (str pad "<" tag attrStr ">\n" chJoined "\n" pad "</" tag ">"))))))))

fn emitReactTsx name: String propsType: String node: v/VNode -> String
  (let [(jsx (emitVnode "react" node 2))] (str "// React 19 TSX Component\n" "import React from \"react\";\n\n" "export interface " propsType " {\n" "  className?: string;\n" "  children?: React.ReactNode;\n" "}\n\n" "export const " name " = (props: " propsType ") => {\n" "  return (\n" jsx "\n" "  );\n" "};\n" "export default " name ";\n"))

fn emitVueSfc name: String propsType: String node: v/VNode -> String
  (let [(tmpl (emitVnode "vue" node 1))] (str "<script setup lang=\"ts\">\n" "export interface " propsType " {\n" "  className?: string;\n" "}\n" "const props = withDefaults(defineProps<" propsType ">(), {\n" "  className: \"\",\n" "});\n" "</script>\n\n" "<template>\n" tmpl "\n" "</template>\n"))

fn emitSvelteComponent name: String propsType: String node: v/VNode -> String
  (let [(body (emitVnode "svelte" node 0))] (str "<script lang=\"ts\">\n" "  let { className = \"\", children }: { className?: string; children?: any } = $props();\n" "</script>\n\n" body "\n"))

fn emitSsrHtml node: v/VNode -> String
  (emitVnode "html" node 0)

fn emitSwiftuiModifiers attrs: (Map String String) -> String
  (let [(keys (mapKeys attrs))] (if (= (listLength keys) 0) "" (let [(rendered (map (fn [(k String)] -> String (let [(v (mt (mapGet attrs k) ((some val) val) ((none) "")))] (if (stringEmpty? v) "" (cond ((= k "padding") (str ".padding(" v ")")) ((or (= k "token-padding") (= k "token-spacing")) (str ".padding(" (resolveSpacingMetric v) ")")) ((or (= k "token-bg") (= k "token-background")) (str ".background(" (swiftuiColorExpr v) ")")) ((or (= k "token-color") (= k "token-text")) (str ".foregroundColor(" (swiftuiColorExpr v) ")")) ((= k "foreground") (str ".foregroundColor(." v ")")) ((= k "token-radius") (str ".cornerRadius(" (resolveRadiusMetric v) ")")) ((or (= k "radius") (= k "cornerRadius")) (str ".cornerRadius(" v ")")) ((= k "token-border") (str ".border(" (swiftuiColorExpr v) ")")) ((= k "disabled") (if (= v "true") ".disabled(true)" "")) (else ""))))) keys))] (stringJoin rendered ""))))

fn emitSwiftuiNode node: v/VNode indent: Int64 -> String
  (let [(pad (indentSpaces indent))] (mt node ((v/textNode content) (str pad "Text(\"" content "\")")) ((v/elementNode tag attrs children) (let [(mods (emitSwiftuiModifiers attrs))] (cond ((= tag "platform-android") "") ((= tag "platform-ios") (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitSwiftuiNode ch indent)) children))] (stringJoin chStrs "\n"))) ((or (or (= tag "vstack") (= tag "stack")) (= tag "div")) (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitSwiftuiNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n"))] (str pad "VStack(spacing: 8) {\n" body "\n" pad "}" mods))) ((= tag "hstack") (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitSwiftuiNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n"))] (str pad "HStack(spacing: 8) {\n" body "\n" pad "}" mods))) ((= tag "zstack") (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitSwiftuiNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n"))] (str pad "ZStack {\n" body "\n" pad "}" mods))) ((= tag "scroll") (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitSwiftuiNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n"))] (str pad "ScrollView {\n" body "\n" pad "}" mods))) ((= tag "button") (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitSwiftuiNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n")) (onClick (mt (mapGet attrs "onclick") ((some v) v) ((none) ""))) (onVal (mt (mapGet attrs "value") ((some v) v) ((none) ""))) (actionStr (if (= onClick "") "{}" (str "{ viewModel.dispatchEvent(\"" onClick "\", \"" onVal "\") }")))] (str pad "Button(action: " actionStr ") {\n" body "\n" pad "}" mods))) ((= tag "input") (let [(ph (mt (mapGet attrs "placeholder") ((some v) v) ((none) ""))) (rawBind (mt (mapGet attrs "bind") ((some v) v) ((none) "text"))) (bindProp (if (stringStartsWith? rawBind "$viewModel.") (optionOr (stringSlice rawBind 11 (stringLength rawBind)) "text") (if (stringStartsWith? rawBind "viewModel.") (optionOr (stringSlice rawBind 10 (stringLength rawBind)) "text") (if (stringStartsWith? rawBind "$") (optionOr (stringSlice rawBind 1 (stringLength rawBind)) "text") rawBind))))] (str pad "TextField(\"" ph "\", text: $viewModel." bindProp ")" mods))) ((= tag "image") (let [(src (mt (mapGet attrs "src") ((some v) v) ((none) "")))] (str pad "AsyncImage(url: URL(string: \"" src "\"))" mods))) ((= tag "spacer") (str pad "Spacer()" mods)) ((or (= tag "divider") (= tag "hr")) (str pad "Divider()" mods)) ((or (or (= tag "text") (= tag "p")) (= tag "span")) (if (= (listLength children) 0) (str pad "Text(\"\")" mods) (let [(firstCh (mt (listHead children) ((some c) c) ((none) (v/text ""))))] (mt firstCh ((v/textNode txt) (str pad "Text(\"" txt "\")" mods)) ((v/elementNode _ _ _) (str (emitSwiftuiNode firstCh indent) mods)))))) (else (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitSwiftuiNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n"))] (str pad "VStack {\n" body "\n" pad "}" mods))))))))

fn emitSwiftuiView name: String node: v/VNode -> String
  (let [(viewBody (emitSwiftuiNode node 2))] (str "// SwiftUI 6 Component\n" "import SwiftUI\n\n" "public struct " name "View: View {\n" "    @StateObject private var viewModel = " name "ViewModel()\n\n" "    public init() {}\n\n" "    public var body: some View {\n" viewBody "\n" "    }\n" "}\n"))

fn emitComposeModifierArg attrs: (Map String String) -> String
  (let [(keys (mapKeys attrs)) (rendered (map (fn [(k String)] -> String (let [(v (mt (mapGet attrs k) ((some val) val) ((none) "")))] (if (stringEmpty? v) "" (cond ((= k "padding") (str ".padding(" v ".dp)")) ((or (= k "token-padding") (= k "token-spacing")) (str ".padding(" (resolveSpacingMetric v) ".dp)")) ((or (= k "token-bg") (= k "token-background")) (str ".background(" (composeColorExpr v) ")")) ((= k "token-radius") (str ".clip(RoundedCornerShape(" (resolveRadiusMetric v) ".dp))")) ((or (= k "radius") (= k "cornerRadius")) (str ".clip(RoundedCornerShape(" v ".dp))")) (else ""))))) keys)) (joined (stringJoin rendered ""))] (if (= joined "") "" (str "modifier = Modifier" joined)))

fn emitComposeNode node: v/VNode indent: Int64 -> String
  (let [(pad (indentSpaces indent))] (mt node ((v/textNode content) (str pad "Text(text = \"" content "\")")) ((v/elementNode tag attrs children) (let [(modArg (emitComposeModifierArg attrs)) (comma (if (= modArg "") "" ", ")) (parenMod (if (= modArg "") "" (str "(" modArg ")")))] (cond ((= tag "platform-ios") "") ((= tag "platform-android") (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitComposeNode ch indent)) children))] (stringJoin chStrs "\n"))) ((or (or (= tag "vstack") (= tag "stack")) (= tag "div")) (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitComposeNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n"))] (str pad "Column" parenMod " {\n" body "\n" pad "}"))) ((= tag "hstack") (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitComposeNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n"))] (str pad "Row" parenMod " {\n" body "\n" pad "}"))) ((= tag "zstack") (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitComposeNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n"))] (str pad "Box" parenMod " {\n" body "\n" pad "}"))) ((= tag "scroll") (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitComposeNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n")) (sMod (if (= modArg "") "modifier = Modifier.verticalScroll(rememberScrollState())" (str modArg ".verticalScroll(rememberScrollState())")))] (str pad "Column(" sMod ") {\n" body "\n" pad "}"))) ((= tag "button") (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitComposeNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n")) (onClick (mt (mapGet attrs "onclick") ((some v) v) ((none) ""))) (onVal (mt (mapGet attrs "value") ((some v) v) ((none) ""))) (actionStr (if (= onClick "") "{}" (str "{ viewModel.dispatchEvent(\"" onClick "\", \"" onVal "\") }")))] (str pad "Button(onClick = " actionStr comma modArg ") {\n" body "\n" pad "}"))) ((= tag "input") (let [(ph (mt (mapGet attrs "placeholder") ((some v) v) ((none) ""))) (rawBind (mt (mapGet attrs "bind") ((some v) v) ((none) "text"))) (bindProp (if (stringStartsWith? rawBind "viewModel.") (optionOr (stringSlice rawBind 10 (stringLength rawBind)) "text") (if (stringStartsWith? rawBind "state.") (optionOr (stringSlice rawBind 6 (stringLength rawBind)) "text") (if (stringStartsWith? rawBind "$") (optionOr (stringSlice rawBind 1 (stringLength rawBind)) "text") rawBind))))] (str pad "TextField(value = viewModel." bindProp ", onValueChange = { viewModel." bindProp " = it }" comma modArg ")"))) ((= tag "image") (let [(src (mt (mapGet attrs "src") ((some v) v) ((none) "")))] (str pad "AsyncImage(model = \"" src "\", contentDescription = null" comma modArg ")"))) ((= tag "spacer") (let [(sMod (if (= modArg "") "modifier = Modifier.weight(1f)" (str modArg ".weight(1f)")))] (str pad "Spacer(" sMod ")"))) ((or (= tag "divider") (= tag "hr")) (str pad "HorizontalDivider()" parenMod)) ((or (or (= tag "text") (= tag "p")) (= tag "span")) (if (= (listLength children) 0) (str pad "Text(text = \"\"" comma modArg ")") (let [(firstCh (mt (listHead children) ((some c) c) ((none) (v/text ""))))] (mt firstCh ((v/textNode txt) (str pad "Text(text = \"" txt "\"" comma modArg ")")) ((v/elementNode _ _ _) (str (emitComposeNode firstCh indent) parenMod)))))) (else (let [(chStrs (map (fn [(ch v/VNode)] -> String (emitComposeNode ch (+ indent 1))) children)) (body (stringJoin chStrs "\n"))] (str pad "Column" parenMod " {\n" body "\n" pad "}"))))))))

fn emitComposeComposable name: String node: v/VNode -> String
  (let [(viewBody (emitComposeNode node 1))] (str "// Jetpack Compose Component\n" "import androidx.compose.runtime.Composable\n" "import androidx.compose.foundation.layout.*\n" "import androidx.compose.material3.*\n\n" "@Composable\n" "fun " name "(viewModel: " name "ViewModel = viewModel()) {\n" viewBody "\n" "}\n"))

fn emitSwiftuiViewModel name: String bindings: (List (Pair String String)) -> String
  (let [(propLines (map (fn [(p (pair String String))] -> String (str "    @Published public var " (pairFirst p) ": String = \"" (pairSecond p) "\"\n")) bindings)) (propsStr (stringJoin propLines ""))] (str "// SwiftUI 6 ViewModel\n" "import SwiftUI\n" "import Combine\n\n" "@Observable\n" "public class " name "ViewModel: ObservableObject {\n" propsStr (if (= propsStr "") "" "\n") "    public init() {}\n\n" "    public func dispatchEvent(_ action: String, _ value: String = \"\") {\n" "        // Bridged to agent-bus FFI\n" "    }\n" "}\n"))

fn emitComposeViewModel name: String bindings: (List (Pair String String)) -> String
  (let [(propLines (map (fn [(p (pair String String))] -> String (str "    var " (pairFirst p) " by mutableStateOf(\"" (pairSecond p) "\")\n")) bindings)) (propsStr (stringJoin propLines ""))] (str "// Jetpack Compose ViewModel\n" "import androidx.lifecycle.ViewModel\n" "import androidx.compose.runtime.mutableStateOf\n" "import androidx.compose.runtime.getValue\n" "import androidx.compose.runtime.setValue\n\n" "class " name "ViewModel : ViewModel() {\n" propsStr (if (= propsStr "") "" "\n") "    fun dispatchEvent(action: String, value: String = \"\") {\n" "        // Bridged to agent-bus FFI\n" "    }\n" "}\n"))

fn emitWebStateHook name: String bindings: (List (Pair String String)) -> String
  (let [(stateDecls (map (fn [(p (pair String String))] -> String (let [(k (pairFirst p)) (v (pairSecond p)) (cap (capitalize k))] (str "  const [" k ", set" cap "] = useState(\"" v "\");\n"))) bindings)) (stateStr (stringJoin stateDecls "")) (retProps (map (fn [(p (pair String String))] -> String (let [(k (pairFirst p)) (cap (capitalize k))] (str "    " k ",\n    set" cap ",\n"))) bindings)) (retPropsStr (stringJoin retProps ""))] (str "// React 19 TSX State Hook\n" "import { useState, useCallback } from \"react\";\n\n" "export const use" name "State = () => {\n" stateStr (if (= stateStr "") "" "\n") "  const dispatchEvent = useCallback((action: string, value: string = \"\") => {\n" "    // Bridged to agent-bus FFI\n" "  }, []);\n\n" "  return {\n" retPropsStr "    dispatchEvent,\n" "  };\n" "};\n" "export default use" name "State;\n"))

fn compileComponent target: String name: String propsType: String node: v/VNode -> String
  (cond ((= target "react") (emitReactTsx name propsType node)) ((= target "vue") (emitVueSfc name propsType node)) ((= target "svelte") (emitSvelteComponent name propsType node)) ((= target "html") (emitSsrHtml node)) ((= target "swiftui") (emitSwiftuiView name node)) ((= target "compose") (emitComposeComposable name node)) (else (emitSsrHtml node)))
