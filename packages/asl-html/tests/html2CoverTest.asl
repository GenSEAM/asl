(module asl-html/tests/html2CoverTest
  :x [runTests]
  :i [(asl-html/html :a h)])

fn runTests -> Bool
  (do
    (let [(maxAttrs (map (fn [(k String)] -> Attr (h/attr k "v")) ["id" "class" "name" "title" "lang" "role" "data-x" "aria-label"]))
          (maxKids (map (fn [(s String)] -> Node (h/text s)) ["a" "b" "c" "d" "e" "f" "g" "h" "i" "j"]))]
      (do
        (assert (= (h/render (h/textarea [(h/attr "name" "comment")] [(h/text "Hello <world>")])) "<textarea name=\"comment\">Hello &lt;world&gt;</textarea>") "textarea normal case")
        (assert (= (h/render (h/textarea [] [])) "<textarea></textarea>") "textarea empty")
        (assert (= (h/render (h/textarea [(h/id "c")] [])) "<textarea id=\"c\"></textarea>") "textarea zero kids with attrs")
        (assert (= (h/render (h/textarea [] [(h/text "x")])) "<textarea>x</textarea>") "textarea zero attrs with kids")
        (assert (= (h/render (h/textarea [] [(h/text "")])) "<textarea></textarea>") "textarea none empty text kid")
        (assert (= (h/render (h/textarea maxAttrs maxKids)) "<textarea id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\">abcdefghij</textarea>") "textarea max attrs and kids")
        (assert (= (h/render (h/textarea [(h/flag "required")] [])) "<textarea required></textarea>") "textarea flag attr")
        (assert (= (h/render (h/textarea [(h/attr "title" "a\"b")] [(h/text "a&b<c>d")])) "<textarea title=\"a&quot;b\">a&amp;b&lt;c&gt;d</textarea>") "textarea escaping")
        (assert (not (h/voidTag? "textarea")) "textarea is not void")

        (assert (= (h/render (h/tfoot [] [(h/tr [] [(h/td [] [(h/text "Total")])])])) "<tfoot><tr><td>Total</td></tr></tfoot>") "tfoot normal case")
        (assert (= (h/render (h/tfoot [] [])) "<tfoot></tfoot>") "tfoot empty")
        (assert (= (h/render (h/tfoot [(h/id "tf")] [])) "<tfoot id=\"tf\"></tfoot>") "tfoot zero kids with attrs")
        (assert (= (h/render (h/tfoot [] [(h/text "x")])) "<tfoot>x</tfoot>") "tfoot zero attrs with kids")
        (assert (= (h/render (h/tfoot [] [(h/text "")])) "<tfoot></tfoot>") "tfoot none empty text kid")
        (assert (= (h/render (h/tfoot maxAttrs maxKids)) "<tfoot id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\">abcdefghij</tfoot>") "tfoot max attrs and kids")
        (assert (= (h/render (h/tfoot [(h/flag "hidden")] [])) "<tfoot hidden></tfoot>") "tfoot flag attr")
        (assert (not (h/voidTag? "tfoot")) "tfoot is not void")

        (assert (= (h/render (h/varEl [(h/id "v")] [(h/text "x")])) "<var id=\"v\">x</var>") "varEl normal case")
        (assert (= (h/render (h/varEl [] [])) "<var></var>") "varEl empty")
        (assert (= (h/render (h/varEl [(h/id "v")] [])) "<var id=\"v\"></var>") "varEl zero kids with attrs")
        (assert (= (h/render (h/varEl [] [(h/text "x")])) "<var>x</var>") "varEl zero attrs with kids")
        (assert (= (h/render (h/varEl [] [(h/text "")])) "<var></var>") "varEl none empty text kid")
        (assert (= (h/render (h/varEl maxAttrs maxKids)) "<var id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\">abcdefghij</var>") "varEl max attrs and kids")
        (assert (= (h/render (h/varEl [(h/flag "x")] [])) "<var x></var>") "varEl flag attr")
        (assert (not (h/voidTag? "var")) "varEl is not void")

        (assert (= (h/render (h/svgSymbol [(h/id "sym")] [(h/path [(h/attr "d" "M0 0")])])) "<symbol id=\"sym\"><path d=\"M0 0\"/></symbol>") "svgSymbol normal case")
        (assert (= (h/render (h/svgSymbol [] [])) "<symbol></symbol>") "svgSymbol empty")
        (assert (= (h/render (h/svgSymbol [(h/id "s")] [])) "<symbol id=\"s\"></symbol>") "svgSymbol zero kids with attrs")
        (assert (= (h/render (h/svgSymbol [] [(h/text "x")])) "<symbol>x</symbol>") "svgSymbol zero attrs with kids")
        (assert (= (h/render (h/svgSymbol [] [(h/text "")])) "<symbol></symbol>") "svgSymbol none empty text kid")
        (assert (= (h/render (h/svgSymbol maxAttrs maxKids)) "<symbol id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\">abcdefghij</symbol>") "svgSymbol max attrs and kids")
        (assert (= (h/render (h/svgSymbol [(h/flag "x")] [])) "<symbol x></symbol>") "svgSymbol flag attr")
        (assert (not (h/voidTag? "symbol")) "svgSymbol is not void")

        (assert (= (h/render (h/svgUse [(h/attr "href" "#sym")] [])) "<use href=\"#sym\"/>") "svgUse normal case")
        (assert (= (h/render (h/svgUse [] [])) "<use/>") "svgUse empty")
        (assert (= (h/render (h/svgUse [(h/attr "href" "")] [])) "<use href=\"\"/>") "svgUse none empty attr value")
        (assert (= (h/render (h/svgUse [] [(h/text "x")])) "<use>x</use>") "svgUse zero attrs with kids renders as non-void")
        (assert (= (h/render (h/svgUse maxAttrs [])) "<use id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\"/>") "svgUse max attrs")
        (assert (= (h/render (h/svgUse [(h/flag "x")] [])) "<use x/>") "svgUse flag attr")
        (assert (h/voidTag? "use") "svgUse is void")

        (assert (= (h/render (h/svgMask [(h/id "mask")] [(h/rect [(h/attr "x" "0")])])) "<mask id=\"mask\"><rect x=\"0\"/></mask>") "svgMask normal case")
        (assert (= (h/render (h/svgMask [] [])) "<mask></mask>") "svgMask empty")
        (assert (= (h/render (h/svgMask [(h/id "m")] [])) "<mask id=\"m\"></mask>") "svgMask zero kids with attrs")
        (assert (= (h/render (h/svgMask [] [(h/text "x")])) "<mask>x</mask>") "svgMask zero attrs with kids")
        (assert (= (h/render (h/svgMask [] [(h/text "")])) "<mask></mask>") "svgMask none empty text kid")
        (assert (= (h/render (h/svgMask maxAttrs maxKids)) "<mask id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\">abcdefghij</mask>") "svgMask max attrs and kids")
        (assert (= (h/render (h/svgMask [(h/flag "x")] [])) "<mask x></mask>") "svgMask flag attr")
        (assert (not (h/voidTag? "mask")) "svgMask is not void")

        (assert (= (h/render (h/svgPattern [(h/id "pat")] [(h/circle [(h/attr "r" "5")])])) "<pattern id=\"pat\"><circle r=\"5\"/></pattern>") "svgPattern normal case")
        (assert (= (h/render (h/svgPattern [] [])) "<pattern></pattern>") "svgPattern empty")
        (assert (= (h/render (h/svgPattern [(h/id "p")] [])) "<pattern id=\"p\"></pattern>") "svgPattern zero kids with attrs")
        (assert (= (h/render (h/svgPattern [] [(h/text "x")])) "<pattern>x</pattern>") "svgPattern zero attrs with kids")
        (assert (= (h/render (h/svgPattern [] [(h/text "")])) "<pattern></pattern>") "svgPattern none empty text kid")
        (assert (= (h/render (h/svgPattern maxAttrs maxKids)) "<pattern id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\">abcdefghij</pattern>") "svgPattern max attrs and kids")
        (assert (= (h/render (h/svgPattern [(h/flag "x")] [])) "<pattern x></pattern>") "svgPattern flag attr")
        (assert (not (h/voidTag? "pattern")) "svgPattern is not void")

        (assert (= (h/render (h/svgMarker [(h/id "marker")] [(h/path [(h/attr "d" "M0 0")])])) "<marker id=\"marker\"><path d=\"M0 0\"/></marker>") "svgMarker normal case")
        (assert (= (h/render (h/svgMarker [] [])) "<marker></marker>") "svgMarker empty")
        (assert (= (h/render (h/svgMarker [(h/id "m")] [])) "<marker id=\"m\"></marker>") "svgMarker zero kids with attrs")
        (assert (= (h/render (h/svgMarker [] [(h/text "x")])) "<marker>x</marker>") "svgMarker zero attrs with kids")
        (assert (= (h/render (h/svgMarker [] [(h/text "")])) "<marker></marker>") "svgMarker none empty text kid")
        (assert (= (h/render (h/svgMarker maxAttrs maxKids)) "<marker id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\">abcdefghij</marker>") "svgMarker max attrs and kids")
        (assert (= (h/render (h/svgMarker [(h/flag "x")] [])) "<marker x></marker>") "svgMarker flag attr")
        (assert (not (h/voidTag? "marker")) "svgMarker is not void")

        (assert (= (h/render (h/svgFilter [(h/id "filter")] [(h/rect [(h/attr "x" "0")])])) "<filter id=\"filter\"><rect x=\"0\"/></filter>") "svgFilter normal case")
        (assert (= (h/render (h/svgFilter [] [])) "<filter></filter>") "svgFilter empty")
        (assert (= (h/render (h/svgFilter [(h/id "f")] [])) "<filter id=\"f\"></filter>") "svgFilter zero kids with attrs")
        (assert (= (h/render (h/svgFilter [] [(h/text "x")])) "<filter>x</filter>") "svgFilter zero attrs with kids")
        (assert (= (h/render (h/svgFilter [] [(h/text "")])) "<filter></filter>") "svgFilter none empty text kid")
        (assert (= (h/render (h/svgFilter maxAttrs maxKids)) "<filter id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\">abcdefghij</filter>") "svgFilter max attrs and kids")
        (assert (= (h/render (h/svgFilter [(h/flag "x")] [])) "<filter x></filter>") "svgFilter flag attr")
        (assert (not (h/voidTag? "filter")) "svgFilter is not void")

        (assert (= (h/render (h/foreignObject [(h/attr "width" "100")] [(h/div [] [(h/text "HTML")])])) "<foreignObject width=\"100\"><div>HTML</div></foreignObject>") "foreignObject normal case")
        (assert (= (h/render (h/foreignObject [] [])) "<foreignObject></foreignObject>") "foreignObject empty")
        (assert (= (h/render (h/foreignObject [(h/attr "width" "10")] [])) "<foreignObject width=\"10\"></foreignObject>") "foreignObject zero kids with attrs")
        (assert (= (h/render (h/foreignObject [] [(h/text "x")])) "<foreignObject>x</foreignObject>") "foreignObject zero attrs with kids")
        (assert (= (h/render (h/foreignObject [] [(h/text "")])) "<foreignObject></foreignObject>") "foreignObject none empty text kid")
        (assert (= (h/render (h/foreignObject maxAttrs maxKids)) "<foreignObject id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\">abcdefghij</foreignObject>") "foreignObject max attrs and kids")
        (assert (= (h/render (h/foreignObject [(h/flag "x")] [])) "<foreignObject x></foreignObject>") "foreignObject flag attr")
        (assert (not (h/voidTag? "foreignObject")) "foreignObject is not void")

        (assert (= (h/render (h/svgDesc [] [(h/text "A description")])) "<desc>A description</desc>") "svgDesc normal case")
        (assert (= (h/render (h/svgDesc [] [])) "<desc></desc>") "svgDesc empty")
        (assert (= (h/render (h/svgDesc [(h/id "d")] [])) "<desc id=\"d\"></desc>") "svgDesc zero kids with attrs")
        (assert (= (h/render (h/svgDesc [] [(h/text "x")])) "<desc>x</desc>") "svgDesc zero attrs with kids")
        (assert (= (h/render (h/svgDesc [] [(h/text "")])) "<desc></desc>") "svgDesc none empty text kid")
        (assert (= (h/render (h/svgDesc maxAttrs maxKids)) "<desc id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\">abcdefghij</desc>") "svgDesc max attrs and kids")
        (assert (= (h/render (h/svgDesc [(h/flag "x")] [])) "<desc x></desc>") "svgDesc flag attr")
        (assert (not (h/voidTag? "desc")) "svgDesc is not void")

        (assert (= (h/render (h/svgImage [(h/attr "href" "img.png")])) "<image href=\"img.png\"/>") "svgImage normal case")
        (assert (= (h/render (h/svgImage [])) "<image/>") "svgImage empty")
        (assert (= (h/render (h/svgImage [(h/attr "href" "")])) "<image href=\"\"/>") "svgImage none empty attr value")
        (assert (= (h/render (h/svgImage maxAttrs)) "<image id=\"v\" class=\"v\" name=\"v\" title=\"v\" lang=\"v\" role=\"v\" data-x=\"v\" aria-label=\"v\"/>") "svgImage max attrs")
        (assert (= (h/render (h/svgImage [(h/flag "x")])) "<image x/>") "svgImage flag attr")
        (assert (= (h/render (h/svgImage [(h/attr "href" "a\"b")])) "<image href=\"a&quot;b\"/>") "svgImage escaping")
        (assert (h/voidTag? "image") "svgImage is void")

        true)))
