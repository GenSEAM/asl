(:package asl-html
 :version "0.1.0"
 :entry "src/html.asl"
 :description "Typed HTML5 and CSS for AgentSlang: one constructor per HTML5 and SVG element, escaping by construction (text, attributes, script and style bodies), styles as data with every at-rule, a Markdown subset to nodes, typed SVG drawing and an ASN-to-SVG converter with a command line"
 :aslFirst true
 :modules [
   "asl-html/html"
   "asl-html/css"
   "asl-html/markdown"
   "asl-html/svg"
   "asl-html/asnSvg"
   "asl-html/svgCli"
 ]
 :dependencies ["asl-parser"])
