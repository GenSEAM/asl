(:doc :symbol "asl/packages/asl-parquet/src/footer.asl#" :text "Read compact-Thrift Parquet footer metadata directly from file bytes")
(:doc :symbol "asl/packages/asl-parquet/src/writer.asl#" :text "Parquet file writer using typed arrays, compact Thrift and level-configured Zstandard compression")
(:doc :symbol "asl/packages/asl-parquet/tests/writerTest.asl#" :text "G17 ASL Parquet writer and compact-footer round trips")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#" :text "Pure-ASL Parquet reader for compact-Thrift footers, row-group pages, levels and typed values")
(:doc :symbol "asl/packages/asl-parquet/tests/readerNativeTest.asl#compileNative" :text "Links with the same nice -n 15, -O2 and -Wno-override-module flags as asl/packages/asl-cli/src/build.asl's link!, so the reported native build and run timings reflect what asl build ships")
(:doc :symbol "asl/packages/asl-parquet/src/footer.asl#parquetColumnStatsInt64" :text "Min, max and null count of an Int64 column in one row group, read from the file footer; an error when the column or its statistics are missing.")
(:doc :symbol "asl/packages/asl-parquet/src/footer.asl#parquetColumnStatsFloat64" :text "Min, max and null count of a Float64 column in one row group, read from the file footer; an error when the column or its statistics are missing.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetColumnRange" :text "The footer min and max of an Int64 column in one row group; none when the file has no statistics for it or the column is not Int64.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetWindowGroups" :text "The row groups that can hold a value in [lo, hi); keeps every group whose range is unknown, so pruning never drops a row.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetLowerBound" :text "First index of an ascending array whose value is at least the target.")
(:doc :symbol "asl/packages/asl-parquet/src/writer.asl#parquetWrite" :text "Write F64, I64 and I8 columns to one parquet file as row groups of rowGroupRows rows (default 1000000); option pageRows splits each column chunk into data pages of that many rows, default 8192 (about 64 KB per column), 0 is one page per group; a range read or merge decodes one page at a time; zero rows give a valid file with no row group; key-value metadata is kept; DELTA_BINARY_PACKED is checked on exactly the page the encoder emits and an overflowing delta is an error, never a trap; the file is written under a temporary name and renamed, an error leaves no file.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetGroupRows" :text "Row count of one row group; -1 when the group index is outside the file.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetHasColumn" :text "True when the file's schema has a column of that name.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetReadRangeI64" :text "Rows start .. start+count of an Int64 column inside one row group as a Result; reads page headers, skips pages that end before the range, decodes only overlapping pages and stops after the last one, so memory is one page plus the range (a file with one page per group costs a whole group); a range outside the group, a wrong column type or a corrupt page is an error, never a trap.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetReadRangeF64" :text "Rows start .. start+count of a Float64 column inside one row group as a Result; page-bounded like parquetReadRangeI64.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetReadRangeI8" :text "Rows start .. start+count of an Int8 column inside one row group as a Result; page-bounded like parquetReadRangeI64.")
(:doc :symbol "asl/packages/asl-parquet/src/merge.asl#MergeRow" :text "One merged row: source index (position in the paths list), ts, row index inside its source file, int columns (int64 or int8) and double columns in the order named at open.")
(:doc :symbol "asl/packages/asl-parquet/src/merge.asl#parquetMergeOpen" :text "Open parquet files for a k-way merge by an Int64 timestamp column with chunkRows rows per window; a Result; checks every file has the columns with the right types; each source must be ascending in ts, a decrease is an error; equal timestamps go to the lower source index, then file order; memory per source is chunkRows * (1 + columns) * 8 bytes of window plus one decoded page per column held by its cursor (a whole group for a file with one page per group, bounded by pageRows for files this writer produces); a group is decoded once.")
(:doc :symbol "asl/packages/asl-parquet/src/merge.asl#parquetMergeNext" :text "The next merged row and the merge advanced past it, none when every source is exhausted; a Result; the merge value is immutable.")
(:doc :symbol "asl/packages/asl-parquet/src/merge.asl#parquetMergeTake" :text "Up to n next merged rows and the advanced merge; a Result.")
(:doc :symbol "asl/packages/asl-parquet/src/merge.asl#parquetMergeSourceCount" :text "Number of sources in a merge.")
(:doc :symbol "asl/packages/asl-parquet/src/merge.asl#parquetMergeWindowRows" :text "Largest window any source holds now in rows; never above chunkRows, the memory bound by construction.")
(:doc :symbol "asl/packages/asl-parquet/tests/roundTripTest.asl#" :text "Writer and reader round trips per type: empty file, one row, several row groups with pages, metadata, row ranges at page and group boundaries, truncated and corrupted files as errors.")
(:doc :symbol "asl/packages/asl-parquet/tests/roundTripTest.asl#runTests" :text "parquet round-trip gate on files written into a temp dir it creates and removes: empty, one-row, multi-group and single-page files read back their ranges, and truncated files, a delta overflow, an understated header and the cursor are checked")
(:doc :symbol "asl/packages/asl-parquet/tests/mergeTest.asl#" :text "Merge of three files with interleaved and equal timestamps and one empty source, window bound, take, and error cases.")
(:doc :symbol "asl/packages/asl-parquet/tests/mergeTest.asl#runTests" :text "PQ-MERGE gate on fixtures in a temp dir it creates and removes: the merged rows follow the order of sorted (ts, source, row) keys with every column following its row, the window never exceeds chunkRows, take, error and decode cases hold")
(:doc :symbol "asl/packages/asl-parquet/src/merge.asl#" :text "Bounded-memory k-way merge reader over several parquet files ordered by an Int64 timestamp column.")

(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#PqCursor" :text "Forward cursor over the data pages of one column chunk: keeps the byte position of the next page, the decoded dictionary and the last decoded page; opening reads every page header once and requires the page value counts to sum to the group row count.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetCursorI64" :text "Cursor over an Int64 column of one row group, a Result; an unknown column, wrong type, group outside the file or inconsistent page headers is an error.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetCursorF64" :text "Cursor over a Float64 column of one row group, a Result.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetCursorI8" :text "Cursor over an Int8 column of one row group, a Result.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetCursorDecodes" :text "Pages and dictionaries a cursor has decoded so far; reads inside an already decoded page add none, so a group of one page costs one decode however many small reads follow.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetCursorReadI64" :text "Rows start .. start+count from a cursor as an Int64 array and the advanced cursor; reads move forward (start not before the last decoded page); memory is one decoded page, which is a whole group for a file with one page per group.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetCursorReadF64" :text "Rows start .. start+count from a Float64 cursor and the advanced cursor; forward only like parquetCursorReadI64.")
(:doc :symbol "asl/packages/asl-parquet/src/reader.asl#parquetCursorReadI8" :text "Rows start .. start+count from an Int8 cursor and the advanced cursor; forward only like parquetCursorReadI64.")
(:doc :symbol "asl/packages/asl-parquet/src/merge.asl#parquetMergeDecodes" :text "Total page decodes so far across sources and columns; one per page and column of each group however small chunkRows is.")
