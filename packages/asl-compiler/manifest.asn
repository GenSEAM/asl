(:package asl-compiler
 :version "0.1.0"
 :entry "src/compiler.asl"
 :description "Pure AgentScript 100% Self-Hosted Compiler Toolchain"
 :aslFirst true
 :modules ["asl-compiler/compiler"
           "asl-compiler/wasm"
           "asl-compiler/wasi"
           "asl-compiler/vfsGit"
           "asl-compiler/evaluator"
           "asl-compiler/compactRewrite"
           "asl-compiler/elf"
           "asl-compiler/macho"
           "asl-compiler/parser"]
 :dependencies ["asl-parser"
                "asl-checker"
                "asl-codegen"])
