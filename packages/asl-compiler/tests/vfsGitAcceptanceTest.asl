(module asl-compiler/tests/vfsGitAcceptanceTest :x [testGitVfsDynamicExecution! testGitVfsInvariants! testGitVfsDualPolarityRefutations! runTests] :i [(asl-compiler/vfsGit :a vfs) (asl-tools/fleet/run :a run)])

fn testGitVfsDynamicExecution! -> Bool
  (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-compiler/tests/vfsGitTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit) (stdout res.out)] (assert (= code 0) (str "vfsGitTest must exit 0, stderr: " "")) (refute (!= code 0) "vfsGitTest must not fail") (assert (stringContains? stdout "assertion(s) executed") "vfsGitTest must report executed assertions") (assert (stringContains? stdout "refutation(s) executed") "vfsGitTest must report executed refutations") (refute (stringContains? stdout "ASL_ASSERTION_FAILURE") "vfsGitTest must not fail assertions") true)

fn testGitVfsInvariants! -> Bool
  (let [(headRes (vfs/gitReadHead! "")) (branchRes (vfs/gitCurrentBranch! "")) (commitRes (vfs/gitHeadCommit! ""))] (assert (ok? headRes) "gitReadHead must succeed on active repo") (match headRes ((ok headText) (do (assert (if (stringStartsWith? headText "ref: ") (stringStartsWith? headText "ref: refs/heads/") (= (stringLength (stringTrim headText)) 40)) "HEAD must reference a heads ref or hold a detached 40-char sha") (refute (stringEmpty? headText) "HEAD must not be empty") (if (stringStartsWith? headText "ref: ") (do (assert (ok? branchRes) "gitCurrentBranch must succeed on an attached HEAD") (match branchRes ((ok branch) (do (assert (> (stringLength branch) 0) "Branch name must not be empty") (refute (stringEmpty? branch) "Branch must have length > 0") true)) ((err _) false))) true))) ((err _) false)) (assert (ok? commitRes) "gitHeadCommit must succeed") (match commitRes ((ok sha) (do (assert (= (stringLength sha) 40) "Commit SHA must be exactly 40 characters") (refute (!= (stringLength sha) 40) "Commit SHA must not deviate from 40 chars") true)) ((err _) false)))

fn testGitVfsDualPolarityRefutations! -> Bool
  (let [(missingHead (vfs/gitReadHead! "/non_existent_repo_dir_12345")) (missingBranch (vfs/gitCurrentBranch! "/non_existent_repo_dir_12345")) (missingCommit (vfs/gitHeadCommit! "/non_existent_repo_dir_12345"))] (assert (err? missingHead) "Missing repo HEAD must return err") (refute (ok? missingHead) "Missing repo HEAD must not return ok") (assert (err? missingBranch) "Missing repo branch must return err") (refute (ok? missingBranch) "Missing repo branch must not return ok") (assert (err? missingCommit) "Missing repo commit must return err") (refute (ok? missingCommit) "Missing repo commit must not return ok") (let [(commitRes (vfs/gitHeadCommit! ""))] (match commitRes ((ok sha) (do (refute (stringEmpty? sha) "HEAD commit SHA must not be empty string") (refute (< (stringLength sha) 40) "Commit SHA must not be truncated") true)) ((err _) false))))

fn ! runTests -> Bool
  (do (assert (testGitVfsDynamicExecution!) "testGitVfsDynamicExecution must pass") (assert (testGitVfsInvariants!) "testGitVfsInvariants must pass") (assert (testGitVfsDualPolarityRefutations!) "testGitVfsDualPolarityRefutations must pass") true)
