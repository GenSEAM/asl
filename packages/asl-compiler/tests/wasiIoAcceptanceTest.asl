(module asl-compiler/tests/wasiIoAcceptanceTest :x [testWasiIoDynamicExecution! testWasiIoInvariants! testWasiIoDualPolarityRefutations! runTests] :i [(asl-compiler/wasi :a wasi) (asl-tools/fleet/run :a run)])

fn testWasiIoDynamicExecution! -> Bool
  (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-compiler/tests/wasiIoTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit) (stdout res.out)] (assert (= code 0) (str "wasiIoTest must exit 0, stderr: " "")) (refute (!= code 0) "wasiIoTest must not fail") (assert (stringContains? stdout "assertion(s) executed") "wasiIoTest must report executed assertions") (assert (stringContains? stdout "refutation(s) executed") "wasiIoTest must report executed refutations") (refute (stringContains? stdout "ASL_ASSERTION_FAILURE") "wasiIoTest must not fail assertions") true)

fn testWasiIoInvariants! -> Bool
  (let [(vec (wasi/encodeCiovec 65536 10)) (path "tmp/test_task50702_roundtrip.txt") (content "Sovereign WASI File I/O Content 12345\n") (writeRes (wasi/wasiFileWrite! path content))] (assert (= (listLength vec) 8) "encodeCiovec must produce strictly 8 bytes") (refute (!= (listLength vec) 8) "Vector length must be 8") (assert (ok? writeRes) "wasiFileWrite must succeed") (let [(readRes (wasi/wasiFileRead! path))] (match readRes ((ok text) (do (assert (= text content) "wasiFileRead text must match written content") (refute (!= text content) "Roundtrip content must not differ") true)) ((err _) false))))

fn testWasiIoDualPolarityRefutations! -> Bool
  (let [(missingPath "tmp/non_existent_file_acceptance_50702.txt") (openRes (wasi/wasiPathOpen! 3 missingPath 0)) (fdWriteNeg (wasi/wasiFdWrite! -1 "hello")) (fdWriteClosed (wasi/wasiFdWrite! 99 "hello"))] (assert (not (wasi/wasiFileExists? missingPath)) "Missing file must not exist") (refute (wasi/wasiFileExists? missingPath) "wasiFileExists? must return false for missing path") (assert (err? openRes) "Opening non-existent path without O_CREAT must return error") (refute (ok? openRes) "Opening non-existent path without O_CREAT must not succeed") (match openRes ((ok _) (assert false "openRes must not succeed")) ((err code) (assert (= code "ENOENT") "Open error code must be ENOENT"))) (assert (err? fdWriteNeg) "Writing to negative fd must return error") (refute (ok? fdWriteNeg) "Negative fd must not succeed") (assert (err? fdWriteClosed) "Writing to closed fd 99 must return error") (refute (ok? fdWriteClosed) "Closed fd must not succeed") true)

fn ! runTests -> Bool
  (do (assert (testWasiIoDynamicExecution!) "testWasiIoDynamicExecution must pass") (assert (testWasiIoInvariants!) "testWasiIoInvariants must pass") (assert (testWasiIoDualPolarityRefutations!) "testWasiIoDualPolarityRefutations must pass") true)
