(module asl/packages/asl-compiler/tests/hostAdapterTest :x [runTests] :i [(asl-compiler/macho :a macho) (asl-compiler/elf :a elf)])

fn testHostShimsSourceFiles! -> Bool
  (let [(rDarwin (fileRead "asl/tools/platform/host_darwin.c")) (rLinux (fileRead "asl/tools/platform/host_linux.c")) (rWin (fileRead "asl/tools/platform/host_windows.c")) (rWasi (fileRead "asl/tools/platform/host_wasi.c")) (rAdapter (fileRead "asl/tools/platform/platformAdapter.asn"))] (assert (not (ok? rDarwin)) "host_darwin.c eradicated under ADR D104") (assert (not (ok? rLinux)) "host_linux.c eradicated under ADR D104") (assert (not (ok? rWin)) "host_windows.c eradicated under ADR D104") (assert (not (ok? rWasi)) "host_wasi.c eradicated under ADR D104") (assert (ok? rAdapter) "platformAdapter.asn must exist and be readable") (let [(cAdapter (mt rAdapter ((ok s) s) ((err _) "")))] (assert (stringContains? cAdapter ":llvm-ir") "platformAdapter targets llvm-ir") (assert (stringContains? cAdapter ":wasm-bytecode") "platformAdapter targets wasm-bytecode") (assert (stringContains? cAdapter "fsWatch") "platformAdapter retains fsWatch") (assert (stringContains? cAdapter "timeMonotonic") "platformAdapter retains timeMonotonic") (assert (stringContains? cAdapter "netSocket") "platformAdapter retains netSocket") (assert (stringContains? cAdapter "memAllocPage") "platformAdapter retains memAllocPage") (refute (stringContains? cAdapter "host_darwin.c") "refutation: no host_darwin.c in platformAdapter") (refute (stringContains? cAdapter "host_linux.c") "refutation: no host_linux.c in platformAdapter") (refute (stringContains? cAdapter "host_windows.c") "refutation: no host_windows.c in platformAdapter") (refute (stringContains? cAdapter "host_wasi.c") "refutation: no host_wasi.c in platformAdapter")) true)

fn testHostAdaptersDescriptors -> Bool
  (let [(dDarwin (macho/hostDarwinAdapter)) (dLinux (elf/hostLinuxAdapter)) (dWin (elf/hostWindowsAdapter)) (dWasi (elf/hostWasiAdapter))] (assert (= dDarwin.os "darwin") "Darwin adapter os is darwin") (assert (= dDarwin.format "Mach-O") "Darwin adapter format is Mach-O") (assert (= dDarwin.eventLoop "kqueue") "Darwin adapter event loop is kqueue") (assert (= dLinux.os "linux") "Linux adapter os is linux") (assert (= dLinux.format "ELF") "Linux adapter format is ELF") (assert (= dLinux.eventLoop "epoll") "Linux adapter event loop is epoll") (assert (= dWin.os "windows") "Windows adapter os is windows") (assert (= dWin.format "PE") "Windows adapter format is PE") (assert (= dWin.eventLoop "iocp-ring") "Windows adapter event loop is iocp-ring") (assert (== dWin.ringCapacity 1024) "Windows adapter ring capacity is 1024") (assert (= dWasi.os "wasi") "WASI adapter os is wasi") (assert (= dWasi.format "WASM") "WASI adapter format is WASM") (let [(capsDarwin dDarwin.capabilities) (capsWin dWin.capabilities)] (assert (listContains? capsDarwin "timeMonotonic") "Darwin supports timeMonotonic") (assert (listContains? capsDarwin "fsWatch") "Darwin supports fsWatch") (assert (listContains? capsWin "timeMonotonic") "Windows supports timeMonotonic") (assert (listContains? capsWin "memAllocPage") "Windows supports memAllocPage") (refute (= dDarwin.os "windows") "refutation: Darwin os is not windows") (refute (= dLinux.os "darwin") "refutation: Linux os is not darwin") (refute (= dWin.format "ELF") "refutation: Windows format is not ELF") (refute (== dWin.ringCapacity 512) "refutation: Windows ring capacity is not 512")) true)

fn testWin32PathNormalization -> Bool
  (let [(p1 (elf/normalizeWin32Path "C:\\projects\\asex\\engine\\asl.c")) (p2 (elf/normalizeWin32Path "D:/workspace/file.asl")) (p3 (elf/normalizeWin32Path "relative\\path\\file.txt")) (p4 (elf/normalizeWin32Path "\\\\server\\share\\dir\\item")) (p5 (elf/normalizeWin32Path ""))] (assert (= p1 "/c/projects/asex/engine/asl.c") "C:\\ drive normalized to /c/ forward slash path") (assert (= p2 "/d/workspace/file.asl") "D:/ drive normalized to /d/ forward slash path") (assert (= p3 "relative/path/file.txt") "Relative backslashes normalized to forward slashes") (assert (= p4 "//server/share/dir/item") "UNC backslashes normalized to // forward slash path") (assert (= p5 "/") "Empty path normalizes to /") (refute (stringContains? p1 "\\") "refutation: normalized p1 contains no backslashes") (refute (stringContains? p2 "\\") "refutation: normalized p2 contains no backslashes") (refute (stringContains? p3 "\\") "refutation: normalized p3 contains no backslashes") (refute (stringContains? p1 "C:") "refutation: normalized p1 contains no C: drive prefix") (refute (stringContains? p2 "D:") "refutation: normalized p2 contains no D: drive prefix") true)

fn testMonotonicClockNanosecondMath -> Bool
  (let [(qpc1 (elf/qpcToNanoseconds 10000000 10000000)) (qpc2 (elf/qpcToNanoseconds 5000000 10000000)) (qpcZero (elf/qpcToNanoseconds 0 10000000)) (qpcBadFreq (elf/qpcToNanoseconds 10000000 0)) (mach1 (macho/machTimeToNanoseconds 1000 1 1)) (mach2 (macho/machTimeToNanoseconds 2000 1 2)) (machZero (macho/machTimeToNanoseconds 1000 1 0))] (assert (== qpc1 1000000000) "10M ticks at 10MHz equals exactly 1 second (1,000,000,000 ns)") (assert (== qpc2 500000000) "5M ticks at 10MHz equals exactly 0.5 second (500,000,000 ns)") (assert (== qpcZero 0) "0 ticks produces 0 ns") (assert (== qpcBadFreq 0) "0 frequency produces 0 ns safely") (assert (== mach1 1000) "1000 mach ticks with 1/1 ratio produces 1000 ns") (assert (== mach2 1000) "2000 mach ticks with 1/2 ratio produces 1000 ns") (assert (== machZero 0) "0 denominator produces 0 ns safely") (refute (== qpc1 0) "refutation: valid QPC calculation must not return 0") (refute (< qpc2 0) "refutation: valid QPC calculation must not return negative") (refute (== mach1 0) "refutation: valid Mach calculation must not return 0") true)

fn testIocpReadinessRingBuffer -> Bool
  (let [(ring0 (elf/iocpRingInit 1024))] (assert (== ring0.capacity 1024) "Ring capacity is 1024") (assert (== ring0.count 0) "Initial ring count is 0") (assert (== ring0.overflowCount 0) "Initial overflow count is 0") (let [(evt1 {:handle 100 :bytes 64 :status 0 :flags 1}) (ring1 (elf/iocpRingPush ring0 evt1))] (assert (== ring1.count 1) "Ring count is 1 after single push") (let [(popRes (elf/iocpRingPop ring1))] (assert (== popRes.count 0) "Ring count is 0 after pop") (assert (== popRes.event.handle 100) "Popped event handle matches pushed handle") (let [(popEmpty (elf/iocpRingPop ring0))] (assert (!= popEmpty.error "") "Popping empty ring returns error") (assert (= popEmpty.error "errPlatformEof") "Popping empty ring returns errPlatformEof") (refute (!= popEmpty.error "errPlatformEof") "refutation: empty pop error must be errPlatformEof")))) (let [(smallRing (elf/iocpRingInit 2)) (s1 (elf/iocpRingPush smallRing {:handle 1})) (s2 (elf/iocpRingPush s1 {:handle 2})) (s3 (elf/iocpRingPush s2 {:handle 3}))] (assert (== s2.count 2) "Small ring full at capacity 2") (assert (!= s3.error "") "Overflow push on small ring returns error") (assert (= s3.error "errPlatformBusy") "Overflow push error is errPlatformBusy") (assert (== s3.overflowCount 1) "Overflow count incremented on push beyond capacity") (refute (= s3.error "") "refutation: overflow push must not succeed")) true)

fn testZeroLineNumberInvariantInAdapters! -> Bool
  (let [(rAdapter (fileRead "asl/tools/platform/platformAdapter.asn"))] (assert (ok? rAdapter) "platformAdapter.asn readable") (let [(cAdapter (mt rAdapter ((ok s) s) ((err _) "")))] (refute (stringContains? cAdapter ":line") "no :line in platformAdapter.asn") (refute (stringContains? cAdapter "#L") "no #L in platformAdapter.asn") (refute (stringContains? cAdapter ".c\"") "no .c references in platformAdapter.asn") (refute (stringContains? cAdapter ".h\"") "no .h references in platformAdapter.asn")) true)

fn ! runTests -> Bool
  (and (testHostShimsSourceFiles!) (and (testHostAdaptersDescriptors) (and (testWin32PathNormalization) (and (testMonotonicClockNanosecondMath) (and (testIocpReadinessRingBuffer) (testZeroLineNumberInvariantInAdapters!))))))
