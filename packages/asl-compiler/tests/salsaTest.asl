(module asl/packages/asl-compiler/tests/salsaTest :x [RunTests! runTests] :i [(asl-compiler/salsa :a salsa) (asl-cli/watch :a watch)])

fn testDemandDrivenQueryCaching -> Bool
  (let [(db0 (salsa/makeSalsaDatabase 5)) (key (salsa/makeQueryKey "Math:add" "typecheck")) (res1 (salsa/executeQuery db0 key (fn [(k salsa/QueryKey)] "Int -> Int -> Int") (list))) (db1 (pairFirst res1)) (qr1 (pairSecond res1)) (res2 (salsa/executeQuery db1 key (fn [(k salsa/QueryKey)] "Int -> Int -> Int") (list))) (db2 (pairFirst res2)) (qr2 (pairSecond res2))] (assert (= qr1.status "ok") "First query execution must succeed") (assert qr1.wasRecomputed "First query execution must recompute") (assert (= qr1.value "Int -> Int -> Int") "First query returns computed value") (assert (= db1.totalRecomputations 1) "Initial execution increments recomputation counter to 1") (assert (= db1.totalCacheHits 0) "Initial execution has 0 cache hits") (assert (= qr2.status "ok") "Second query execution must succeed") (assert (not qr2.wasRecomputed) "Second query execution must be served from cache without recomputing") (assert (= qr2.value "Int -> Int -> Int") "Second query returns identical cached value") (assert (= db2.totalRecomputations 1) "Second query must not increment recomputation counter") (assert (= db2.totalCacheHits 1) "Second query must increment cache hit counter to 1") (refute (not qr1.wasRecomputed) "Refutation: Cold query cannot be served as cache hit") (refute qr2.wasRecomputed "Refutation: Warm query cannot be recomputed on identical inputs") (refute (= db2.totalCacheHits 0) "Refutation: Warm query must record cache hit") (refute (not (= qr2.value qr1.value)) "Refutation: Cached query value cannot diverge from initial") (refute (> db2.totalRecomputations 1) "Refutation: Recomputation count cannot increase on cache hit") true)

fn testRedGreenIncrementalInvalidation -> Bool
  (let [(db0 (salsa/makeSalsaDatabase 5)) (keyB (salsa/makeQueryKey "ModuleB:helper" "typecheck")) (keyA (salsa/makeQueryKey "ModuleA:main" "codegen")) (resB1 (salsa/executeQuery db0 keyB (fn [(k salsa/QueryKey)] "helper_v1") (list))) (db1 (pairFirst resB1)) (resA1 (salsa/executeQuery db1 keyA (fn [(k salsa/QueryKey)] "main_uses_helper_v1") (list keyB))) (db2 (pairFirst resA1)) (qrA1 (pairSecond resA1)) (invDb (salsa/invalidateQuery db2 keyB)) (resB2 (salsa/executeQuery invDb keyB (fn [(k salsa/QueryKey)] "helper_v2_mutated") (list))) (db3 (pairFirst resB2)) (resA2 (salsa/executeQuery db3 keyA (fn [(k salsa/QueryKey)] "main_uses_helper_v2_mutated") (list keyB))) (db4 (pairFirst resA2)) (qrA2 (pairSecond resA2))] (assert qrA1.wasRecomputed "Initial query A must be computed") (assert (> invDb.currentEpoch db2.currentEpoch) "Invalidation must advance global compiler epoch") (assert qrA2.wasRecomputed "Query A must be recomputed after dependency B value mutation") (assert (= qrA2.value "main_uses_helper_v2_mutated") "Query A must reflect mutated dependency output") (assert (> qrA2.changedEpoch qrA1.changedEpoch) "Recomputed query A must carry updated changedEpoch") (refute (not qrA2.wasRecomputed) "Refutation: Query with mutated dependency cannot stay uncomputed") (refute (= qrA2.value qrA1.value) "Refutation: Mutated dependency must produce updated downstream value") (refute (<= invDb.currentEpoch db2.currentEpoch) "Refutation: Invalidation cannot decrease global epoch") (refute (<= qrA2.changedEpoch qrA1.changedEpoch) "Refutation: Recomputed query A must advance changedEpoch") true)

fn testBackdatingPreservesDownstreamGreen -> Bool
  (let [(db0 (salsa/makeSalsaDatabase 5)) (keyB (salsa/makeQueryKey "Dep:parser" "parse")) (keyA (salsa/makeQueryKey "Root:analyzer" "typecheck")) (resB1 (salsa/executeQuery db0 keyB (fn [(k salsa/QueryKey)] "ast_canonical_signature") (list))) (db1 (pairFirst resB1)) (qrB1 (pairSecond resB1)) (resA1 (salsa/executeQuery db1 keyA (fn [(k salsa/QueryKey)] "typechecked_against_ast") (list keyB))) (db2 (pairFirst resA1)) (qrA1 (pairSecond resA1)) (initialAChangedEpoch qrA1.changedEpoch) (invDb (salsa/invalidateQuery db2 keyB)) (resB2 (salsa/executeQuery invDb keyB (fn [(k salsa/QueryKey)] "ast_canonical_signature") (list))) (db3 (pairFirst resB2)) (qrB2 (pairSecond resB2)) (resA2 (salsa/executeQuery db3 keyA (fn [(k salsa/QueryKey)] "typechecked_against_ast") (list keyB))) (db4 (pairFirst resA2)) (qrA2 (pairSecond resA2))] (assert (not qrB2.wasRecomputed) "Backdating: query B output hash unchanged, marked uncomputed") (assert (= qrB2.changedEpoch qrB1.changedEpoch) "Backdating: query B preserves earlier changedEpoch") (assert (not qrA2.wasRecomputed) "Backdating: query A was not recomputed because dependency changedEpoch was unchanged") (assert (= qrA2.changedEpoch initialAChangedEpoch) "Backdating: query A changedEpoch preserved") (assert (= qrA2.value "typechecked_against_ast") "Query A value preserved") (refute qrA2.wasRecomputed "Refutation: Downstream query cannot recompute when dependency output was backdated") (refute (> qrB2.changedEpoch qrB1.changedEpoch) "Refutation: Backdated query cannot advance changedEpoch") (refute (not (= qrA2.changedEpoch initialAChangedEpoch)) "Refutation: Downstream query changedEpoch cannot drift when backdated") (refute (not (= qrA2.value "typechecked_against_ast")) "Refutation: Downstream query value cannot mutate when backdated") true)

fn testDiamondDependencyRecomputation -> Bool
  (let [(db0 (salsa/makeSalsaDatabase 5)) (keyRoot (salsa/makeQueryKey "Graph:root" "parse")) (keyLeft (salsa/makeQueryKey "Graph:left" "typecheck")) (keyRight (salsa/makeQueryKey "Graph:right" "lint")) (keyTop (salsa/makeQueryKey "Graph:top" "codegen")) (dbProv0 (salsa/registerQuery db0 keyRoot (list) (fn [(d salsa/SalsaDatabase) (k salsa/QueryKey)] (pair d "root_v1")))) (dbProv1 (salsa/registerQuery dbProv0 keyLeft (list keyRoot) (fn [(d salsa/SalsaDatabase) (k salsa/QueryKey)] (let [(rootEntry (optionOr (salsa/findQuery d keyRoot) (salsa/makeDummyEntry keyRoot)))] (pair d (str "left_derived_from_" rootEntry.value)))))) (dbProv2 (salsa/registerQuery dbProv1 keyRight (list keyRoot) (fn [(d salsa/SalsaDatabase) (k salsa/QueryKey)] (pair d "right_constant")))) (dbProv3 (salsa/registerQuery dbProv2 keyTop (list keyLeft keyRight) (fn [(d salsa/SalsaDatabase) (k salsa/QueryKey)] (let [(lEntry (optionOr (salsa/findQuery d keyLeft) (salsa/makeDummyEntry keyLeft))) (rEntry (optionOr (salsa/findQuery d keyRight) (salsa/makeDummyEntry keyRight)))] (pair d (str "top_" lEntry.value "_" rEntry.value)))))) (resTop1 (salsa/demandQuery dbProv3 keyTop)) (db1 (pairFirst resTop1)) (qrTop1 (pairSecond resTop1)) (dbMutRoot (salsa/registerQuery db1 keyRoot (list) (fn [(d salsa/SalsaDatabase) (k salsa/QueryKey)] (pair d "root_v2")))) (invDb (salsa/invalidateQuery dbMutRoot keyRoot)) (resTop2 (salsa/demandQuery invDb keyTop)) (db2 (pairFirst resTop2)) (qrTop2 (pairSecond resTop2)) (rootEntry2 (optionOr (salsa/findQuery db2 keyRoot) (salsa/makeDummyEntry keyRoot))) (leftEntry2 (optionOr (salsa/findQuery db2 keyLeft) (salsa/makeDummyEntry keyLeft))) (rightEntry2 (optionOr (salsa/findQuery db2 keyRight) (salsa/makeDummyEntry keyRight)))] (assert qrTop1.wasRecomputed "Initial query Top execution must be computed") (assert (= qrTop1.value "top_left_derived_from_root_v1_right_constant") "Initial Top query evaluates full diamond graph") (assert qrTop2.wasRecomputed "Top query must recompute on mutated root dependency") (assert (= qrTop2.value "top_left_derived_from_root_v2_right_constant") "Top query reflects mutated root via left branch") (assert (= rootEntry2.value "root_v2") "Root query was recomputed to v2 on demand") (assert (= leftEntry2.value "left_derived_from_root_v2") "Left query was recomputed to v2 on demand") (assert (= rightEntry2.value "right_constant") "Right query preserved constant value via backdating") (refute (not qrTop2.wasRecomputed) "Refutation: Top query must recompute if upstream branch mutated") (refute (= qrTop2.value qrTop1.value) "Refutation: Mutated root dependency must alter Top output") (refute (not (= rootEntry2.value "root_v2")) "Refutation: Root entry must reflect new value") (refute (not (= leftEntry2.value "left_derived_from_root_v2")) "Refutation: Left entry must reflect new root") true)

fn testTransitiveGraphInvalidationChain -> Bool
  (let [(db0 (salsa/makeSalsaDatabase 10)) (keyA (salsa/makeQueryKey "Chain:A" "source")) (keyB (salsa/makeQueryKey "Chain:B" "tokens")) (keyC (salsa/makeQueryKey "Chain:C" "ast")) (keyD (salsa/makeQueryKey "Chain:D" "types")) (dbA (salsa/registerQuery db0 keyA (list) (fn [(d salsa/SalsaDatabase) (k salsa/QueryKey)] (pair d "src_1")))) (dbB (salsa/registerQuery dbA keyB (list keyA) (fn [(d salsa/SalsaDatabase) (k salsa/QueryKey)] (let [(eA (optionOr (salsa/findQuery d keyA) (salsa/makeDummyEntry keyA)))] (pair d (str "tok_" eA.value)))))) (dbC (salsa/registerQuery dbB keyC (list keyB) (fn [(d salsa/SalsaDatabase) (k salsa/QueryKey)] (let [(eB (optionOr (salsa/findQuery d keyB) (salsa/makeDummyEntry keyB)))] (pair d (str "ast_" eB.value)))))) (dbD (salsa/registerQuery dbC keyD (list keyC) (fn [(d salsa/SalsaDatabase) (k salsa/QueryKey)] (let [(eC (optionOr (salsa/findQuery d keyC) (salsa/makeDummyEntry keyC)))] (pair d (str "typ_" eC.value)))))) (resD1 (salsa/demandQuery dbD keyD)) (db1 (pairFirst resD1)) (qrD1 (pairSecond resD1)) (entryA1 (optionOr (salsa/findQuery db1 keyA) (salsa/makeDummyEntry keyA))) (entryB1 (optionOr (salsa/findQuery db1 keyB) (salsa/makeDummyEntry keyB))) (entryC1 (optionOr (salsa/findQuery db1 keyC) (salsa/makeDummyEntry keyC))) (entryD1 (optionOr (salsa/findQuery db1 keyD) (salsa/makeDummyEntry keyD))) (invDb (salsa/invalidateQuery db1 keyA)) (entryA_red (optionOr (salsa/findQuery invDb keyA) (salsa/makeDummyEntry keyA))) (entryB_red (optionOr (salsa/findQuery invDb keyB) (salsa/makeDummyEntry keyB))) (entryC_red (optionOr (salsa/findQuery invDb keyC) (salsa/makeDummyEntry keyC))) (entryD_red (optionOr (salsa/findQuery invDb keyD) (salsa/makeDummyEntry keyD))) (dbMutA (salsa/registerQuery invDb keyA (list) (fn [(d salsa/SalsaDatabase) (k salsa/QueryKey)] (pair d "src_2")))) (resD2 (salsa/demandQuery dbMutA keyD)) (db2 (pairFirst resD2)) (qrD2 (pairSecond resD2))] (assert (= qrD1.value "typ_ast_tok_src_1") "Initial chain evaluation produces full transitive value") (assert (= entryA1.state "green") "Node A initial state is green") (assert (= entryB1.state "green") "Node B initial state is green") (assert (= entryC1.state "green") "Node C initial state is green") (assert (= entryD1.state "green") "Node D initial state is green") (assert (= entryA_red.state "red") "Transitive invalidation marks leaf A as red") (assert (= entryB_red.state "red") "Transitive invalidation marks hop 1 B as red") (assert (= entryC_red.state "red") "Transitive invalidation marks hop 2 C as red") (assert (= entryD_red.state "red") "Transitive invalidation marks hop 3 D as red") (assert qrD2.wasRecomputed "Node D was recomputed after multi-hop transitive mutation") (assert (= qrD2.value "typ_ast_tok_src_2") "Recomputed D reflects mutated A through B and C") (refute (not (= entryB_red.state "red")) "Refutation: Hop 1 B cannot remain green after leaf A invalidated") (refute (not (= entryC_red.state "red")) "Refutation: Hop 2 C cannot remain green after leaf A invalidated") (refute (not (= entryD_red.state "red")) "Refutation: Hop 3 D cannot remain green after leaf A invalidated") (refute (not qrD2.wasRecomputed) "Refutation: Chain root D must recompute when leaf mutated") (refute (= qrD2.value qrD1.value) "Refutation: Mutated leaf must produce new chain root output") true)

fn testGenerationalEpochEvictionAndBoundedMemory -> Bool
  (let [(retentionWindow 5) (db0 (salsa/makeSalsaDatabase retentionWindow)) (simulatedDb (salsa/simulateEditCycles db0 100 "CoreSymbol")) (totalActiveQueries (listLength simulatedDb.queries)) (maxAllowedQueries (+ (* retentionWindow 2) 2))] (assert (> simulatedDb.currentEpoch 100) "Simulated edit loop must advance past epoch 100") (assert (<= totalActiveQueries maxAllowedQueries) "Generational eviction must keep active queries strictly bounded") (assert (> totalActiveQueries 0) "Active query table must not be prematurely emptied") (refute (> totalActiveQueries maxAllowedQueries) "Refutation: Active query table cannot leak linearly with 100 cycles") (refute (= totalActiveQueries 0) "Refutation: Active query table must retain recent generations") (refute (<= simulatedDb.currentEpoch 100) "Refutation: Multi-cycle loop must advance epoch") true)

fn testWatchEngineSub5msDeltaLatency! -> Bool
  (let [(db0 (salsa/makeSalsaDatabase 5)) (ws0 (watch/watchInit db0 "asl/packages/asl-compiler/src/compiler.asl")) (stepRes (watch/watchStep! ws0 "src/compiler.asl" "compileSource" "(df compileSource [] -> Str \"ok\")")) (nextWs (pairFirst stepRes)) (receipt (pairSecond stepRes)) (simLoop (watch/watchLoop! nextWs 10))] (assert (= receipt.status "ok") "Watch step status must be ok") (assert (= receipt.mutatedSymbol "compileSource") "Watch step mutatedSymbol must match target") (assert (= receipt.recomputedCount 1) "Watch step must only recompute mutated symbol query") (assert (> receipt.latencyMicros 0) "Watch step recomputation latency must be dynamic and non-zero (> 0)") (assert (< receipt.latencyMicros 5000) "Watch step recomputation latency must be strictly sub-5ms (< 5000 micros)") (assert (= simLoop.status "ok") "Continuous watch simulation loop must exit cleanly") (assert (> simLoop.latencyMicros 0) "Simulation loop latency must be dynamic and non-zero") (refute (>= receipt.latencyMicros 5000) "Refutation: Localized AST delta latency cannot exceed 5000 microseconds") (refute (<= receipt.latencyMicros 0) "Refutation: Dynamic latency cannot be zero or negative") (refute (not (= receipt.status "ok")) "Refutation: Watch step cannot fail on valid delta") (refute (= receipt.recomputedCount 0) "Refutation: Mutated symbol must trigger exactly 1 recomputation") (refute (not (= receipt.mutatedSymbol "compileSource")) "Refutation: Mutated symbol receipt must not misidentify target") (refute (not (= simLoop.status "ok")) "Refutation: Simulation loop must not abort") true)

fn ! runTests -> Bool
  (let [(okCache (testDemandDrivenQueryCaching)) (okRg (testRedGreenIncrementalInvalidation)) (okBackdate (testBackdatingPreservesDownstreamGreen)) (okDiamond (testDiamondDependencyRecomputation)) (okChain (testTransitiveGraphInvalidationChain)) (okEvict (testGenerationalEpochEvictionAndBoundedMemory)) (okWatch (testWatchEngineSub5msDeltaLatency!))] (and (and okCache okRg) (and okBackdate (and okDiamond (and okChain (and okEvict okWatch))))))

fn RunTests! -> Bool
  (runTests)
