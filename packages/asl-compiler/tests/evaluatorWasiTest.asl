(module asl/packages/asl-compiler/tests/evaluatorWasiTest :x [testEvaluatorIoBuiltins! testEvaluatorSysExecSandboxedRefusal! testEvaluatorDualPolarityRefutations! runTests] :i [(reader :a rd) (../src/evaluator :a ev)])

fn testEvaluatorIoBuiltins! -> Bool
  (let [(env (ev/makeRootEnv)) (readExpr (rd/makeList (list (rd/makeAtom "fileRead") (rd/makeAtom "\"asl/packages/asl-compiler/src/wasi.asl\"")))) (existsExpr (rd/makeList (list (rd/makeAtom "fileExists?") (rd/makeAtom "\"asl/packages/asl-compiler/src/wasi.asl\"")))) (dirExpr (rd/makeList (list (rd/makeAtom "dirList") (rd/makeAtom "\"asl/packages/asl-compiler/src\"")))) (vRead (ev/evalSexpr! readExpr env)) (vExists (ev/evalSexpr! existsExpr env)) (vDir (ev/evalSexpr! dirExpr env))] (mt vRead ((ev/valStr text) (do (assert (> (stringLength text) 0) "Evaluated fileRead must produce non-empty string") (refute (stringEmpty? text) "Evaluated fileRead must not be empty") true)) ((ev/valError msg) (assert false (str "fileRead failed with error: " msg))) (_ false)) (mt vExists ((ev/valBool b) (do (assert b "fileExists? must evaluate to true for wasi.asl") true)) (_ false)) (mt vDir ((ev/valList items) (do (assert (not (listEmpty? items)) "dirList must return entries") (refute (listEmpty? items) "dirList must not be empty") true)) (_ false)) true)

fn testEvaluatorSysExecSandboxedRefusal! -> Bool
  (let [(env (ev/makeRootEnv)) (execExpr (rd/makeList (list (rd/makeAtom "sys-exec") (rd/makeAtom "\"echo forbidden\"")))) (vExec (ev/evalSexpr! execExpr env))] (mt vExec ((ev/valMap m) (let [(statusVal (optionOr (mapGet m "status") (ev/valStr ""))) (codeVal (optionOr (mapGet m "code") (ev/valInt -1))) (errVal (optionOr (mapGet m "stderr") (ev/valStr "")))] (mt statusVal ((ev/valStr s) (do (assert (= s "refused") "Refusal status must be refused") (refute (= s "ok") "Subprocess status must not be ok") true)) (_ false)) (mt codeVal ((ev/valInt c) (do (assert (= c 126) "Refusal code must be 126") (refute (!= c 126) "Code must not deviate from 126") true)) (_ false)) (mt errVal ((ev/valStr msg) (do (assert (stringContains? msg "ERR_CAPABILITY_DENIED") "Stderr must contain ERR_CAPABILITY_DENIED") (refute (stringEmpty? msg) "Stderr must not be empty") true)) (_ false)) true)) ((ev/valError err) (assert false (str "sys-exec must not produce unhandled valError: " err))) (_ false)))

fn testEvaluatorDualPolarityRefutations! -> Bool
  (let [(env (ev/makeRootEnv)) (unknownExpr (rd/makeList (list (rd/makeAtom "unknown-nonexistent-procedure-12345") (rd/makeAtom "1")))) (vUnknown (ev/evalSexpr! unknownExpr env))] (mt vUnknown ((ev/valError msg) (do (assert (stringContains? msg "ERR_UNKNOWN_PROCEDURE") "Unknown procedure must produce ERR_UNKNOWN_PROCEDURE") (refute (stringEmpty? msg) "Error message must not be empty") true)) (_ false)) (let [(ioExpr (rd/makeList (list (rd/makeAtom "fileRead") (rd/makeAtom "\"asl/packages/asl-compiler/src/wasi.asl\"")))) (vIo (ev/evalSexpr! ioExpr env))] (refute (mt vIo ((ev/valError err) (stringContains? err "ERR_UNKNOWN_PROCEDURE")) (_ false)) "fileRead must not trigger ERR_UNKNOWN_PROCEDURE")) true)

fn ! runTests -> Bool
  (do (assert (testEvaluatorIoBuiltins!) "testEvaluatorIoBuiltins must pass") (assert (testEvaluatorSysExecSandboxedRefusal!) "testEvaluatorSysExecSandboxedRefusal must pass") (assert (testEvaluatorDualPolarityRefutations!) "testEvaluatorDualPolarityRefutations must pass") true)
