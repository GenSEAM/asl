(module asl-compiler/tests/wasiPlatformErrorTest :x [runTests] :i [(asl-compiler/wasi :a wasi)])

fn testWasiPlatformErrorCodes -> Bool
  (let [(eof (wasi/errPlatformEof)) (timeout (wasi/errPlatformTimeout)) (denied (wasi/errPlatformDenied)) (badHandle (wasi/errPlatformBadHandle)) (notFound (wasi/errPlatformNotFound)) (busy (wasi/errPlatformBusy))] (assert (= eof 1) "errPlatformEof is 1") (assert (= timeout 2) "errPlatformTimeout is 2") (assert (= denied 3) "errPlatformDenied is 3") (assert (= badHandle 4) "errPlatformBadHandle is 4") (assert (= notFound 5) "errPlatformNotFound is 5") (assert (= busy 6) "errPlatformBusy is 6") (assert (= (wasi/platformErrorName eof) "ERR_PLATFORM_EOF") "name of eof matches") (assert (= (wasi/platformErrorName timeout) "ERR_PLATFORM_TIMEOUT") "name of timeout matches") (assert (= (wasi/platformErrorName denied) "ERR_PLATFORM_DENIED") "name of denied matches") (assert (= (wasi/platformErrorName badHandle) "ERR_PLATFORM_BAD_HANDLE") "name of badHandle matches") (assert (= (wasi/platformErrorName notFound) "ERR_PLATFORM_NOT_FOUND") "name of notFound matches") (assert (= (wasi/platformErrorName busy) "ERR_PLATFORM_BUSY") "name of busy matches") (refute (= eof timeout) "refutation: eof and timeout distinct") (refute (= denied badHandle) "refutation: denied and badHandle distinct") (refute (= notFound busy) "refutation: notFound and busy distinct") (refute (= (wasi/platformErrorName 999) "ERR_PLATFORM_EOF") "refutation: unknown error is not EOF") (refute (= (wasi/platformErrorName -1) "ERR_PLATFORM_DENIED") "refutation: negative error is not denied") true)

fn testMemoryAndSyscallDispatch -> Bool
  (let [(alloc1 (wasi/aslMemAllocPage 1)) (alloc0 (wasi/aslMemAllocPage 0)) (allocNeg (wasi/aslMemAllocPage -2)) (freeOk (wasi/aslMemFreePage alloc1 1)) (freeZero (wasi/aslMemFreePage 0 1))] (assert (= alloc1 65536) "1 WebAssembly page allocates 64KB (65536 bytes)") (assert (= alloc0 0) "0 pages returns 0") (assert (= allocNeg 0) "negative pages returns 0") (assert freeOk "valid page free succeeds") (refute freeZero "refutation: freeing null pointer returns false") (let [(dTime (wasi/aslSyscallDispatch "timeMonotonic" 0 0 0)) (dAlloc (wasi/aslSyscallDispatch "memAllocPage" 2 0 0)) (dBad (wasi/aslSyscallDispatch "procWait" -1 0 0)) (dUnknown (wasi/aslSyscallDispatch "unknownSyscallX" 0 0 0))] (assert (> dTime 0) "monotonic time syscall returns positive timestamp") (assert (= dAlloc 131072) "memAllocPage 2 pages returns 128KB (131072 bytes)") (assert (< dBad 0) "invalid procWait returns negative error code") (assert (< dUnknown 0) "unknown syscall returns negative denial error code") (refute (= dBad 0) "refutation: bad handle procWait must not succeed") (refute (= dUnknown 0) "refutation: unknown syscall must not succeed")) true)

fn ! runTests -> Bool
  (and (testWasiPlatformErrorCodes) (testMemoryAndSyscallDispatch))
