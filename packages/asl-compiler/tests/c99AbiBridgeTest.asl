(module asl/packages/asl-compiler/tests/c99AbiBridgeTest :x [testLiveC99Emission testClangStrictCompilation! testC99DualPolarityRefutations runTests] :i [(../src/compiler :a comp)])

fn bridgeSource -> Str
  (str "(module plugin/bridge :x [PluginBuffer DispatchReceipt dispatchCall main] :i [])\n\n" "(defschema PluginBuffer\n" "  (:field ptr Int64 \"Buffer memory pointer\")\n" "  (:field size Int64 \"Buffer size in bytes\"))\n\n" "(defschema DispatchReceipt\n" "  (:field invocationCount Int64 \"Updated invocation sequence counter\")\n" "  (:field memoryHandle Int64 \"Opaque native memory handle\"))\n\n" "(df dispatchCall [(ptr Int64) (count Int64)] -> Int64\n" "  (+ ptr (+ count 1)))\n\n" "(df main [] -> Int64\n" "  (dispatchCall 4096 0))\n")

fn testLiveC99Emission -> Bool
  (let [(src (bridgeSource)) (cRes (comp/compileSourceTarget src "c99" {} "plugin/bridge.asl"))] (assert cRes.ok (str "compileSourceTarget must succeed: " (stringJoin cRes.diagnostics ", "))) (refute (not cRes.ok) "compilation to c99 target must succeed") (let [(cCode cRes.code)] (assert (stringContains? cCode "#include <stdint.h>") "emitted C contains stdint.h include") (assert (stringContains? cCode "#include <stdio.h>") "emitted C contains stdio.h include") (assert (stringContains? cCode "typedef struct AslPluginBuffer_s") "emitted C contains PluginBuffer typedef") (assert (stringContains? cCode "typedef struct AslDispatchReceipt_s") "emitted C contains DispatchReceipt typedef") (assert (stringContains? cCode "int64_t dispatchCall(int64_t ptr, int64_t count);") "emitted C contains ANSI C dispatchCall prototype") (assert (stringContains? cCode "int main(int argc, char** argv)") "emitted C contains main entrypoint") (refute (stringContains? cCode "#include <Arduino.h>") "hosted C99 omits Arduino.h") (refute (stringContains? cCode "malloc") "hosted C99 emits zero dynamic allocations") (refute (stringContains? cCode "dispatch-call") "emitted C mangles kebab-case identifiers") true))

fn testClangStrictCompilation! -> Bool
  (let [(src (bridgeSource)) (cRes (comp/compileSourceTarget src "c99" {} "plugin/bridge.asl")) (cCode cRes.code) (cPath "tmp/c99AbiBridgeTest/c99_plugin_bridge.c") (oPath "tmp/c99AbiBridgeTest/c99_plugin_bridge.o") (binPath "tmp/c99AbiBridgeTest/c99_plugin_bridge_bin") (wRes (fileWrite cPath cCode)) (clangObjCmd (str "clang -std=c99 -Wall -Wextra -Werror -pedantic -O3 -c " cPath " -o " oPath)) (objRes (processRun clangObjCmd)) (objCode objRes.exitCode) (objErr objRes.stderr)] (assert (= objCode 0) (str "Clang object compilation must exit 0: " objErr)) (refute (!= objCode 0) "Clang object compilation must not produce errors or warnings") (let [(clangBinCmd (str "clang -std=c99 -Wall -Wextra -Werror -pedantic -O3 " cPath " -o " binPath)) (binRes (processRun clangBinCmd)) (binCode binRes.exitCode) (binErr binRes.stderr)] (assert (= binCode 0) (str "Clang binary linking must exit 0: " binErr)) (refute (!= binCode 0) "Clang binary linking must succeed") (let [(runRes (processRun binPath)) (runExit runRes.exitCode) (cleanRes (processRun (str "rm -f " cPath " " oPath " " binPath)))] (refute (!= cleanRes.exitCode 0) "Temporary compilation artifacts cleaned cleanly") true)))

fn testC99DualPolarityRefutations -> Bool
  (let [(src (bridgeSource)) (cRes (comp/compileSourceTarget src "c99" {} "plugin/bridge.asl")) (cCode cRes.code)] (refute (stringEmpty? cCode) "Emitted C99 code must not be empty") (refute (stringContains? cCode "goto") "Emitted C99 code must not use goto") (refute (stringContains? cCode "long double") "Emitted C99 code must not use non-portable long double") (refute (not (stringContains? cCode "AslDispatchReceipt")) "Emitted C99 must contain AslDispatchReceipt") (refute (not (stringContains? cCode "AslPluginBuffer")) "Emitted C99 must contain AslPluginBuffer") true)

fn cleanupC99AbiBridgeScratch! hadTmp: Bool -> Bool
  (let [(rmScratch (pathRemove "tmp/c99AbiBridgeTest"))] (assert (ok? rmScratch) "pathRemove must remove the tmp/c99AbiBridgeTest scratch directory") (refute (fileExists? "tmp/c99AbiBridgeTest") "Scratch directory must not exist after removal") (if hadTmp true (let [(rmTmp (pathRemove "tmp"))] (assert (ok? rmTmp) "pathRemove must remove the tmp directory this test created") (refute (fileExists? "tmp") "tmp must not exist after removal") true)))

fn ! runTests -> Bool
  (let [(hadTmp (fileExists? "tmp")) (scratchRes (dirCreate "tmp/c99AbiBridgeTest"))] (assert (ok? scratchRes) "dirCreate must create the tmp/c99AbiBridgeTest scratch directory") (assert (testLiveC99Emission) "testLiveC99Emission must pass") (assert (testClangStrictCompilation!) "testClangStrictCompilation must pass") (assert (testC99DualPolarityRefutations) "testC99DualPolarityRefutations must pass") (assert (cleanupC99AbiBridgeScratch! hadTmp) "Scratch cleanup must pass") true)
