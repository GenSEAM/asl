(module asl/packages/asl-compiler/tests/comptimeTest :x [RunTests! runTests] :i [(asl-compiler/comptime :a ct)])

fn testComptimeConstantFolding -> Bool
  (let [(rAdd (ct/evalComptime "(+ 10 20)" 1000)) (rMul (ct/evalComptime "(* 6 7)" 1000)) (rSub (ct/evalComptime "(- 50 8)" 1000)) (rDiv (ct/evalComptime "(/ 100 4)" 1000)) (rMod (ct/evalComptime "(% 17 5)" 1000)) (rStr (ct/evalComptime "(stringConcat \"agent\" \"script\")" 1000)) (rBoolAnd (ct/evalComptime "(and true false)" 1000)) (rBoolOr (ct/evalComptime "(or true false)" 1000)) (rBoolNot (ct/evalComptime "(not false)" 1000)) (rNested (ct/evalComptime "(+ (* 3 4) (- 20 10))" 1000)) (rGen1 (ct/evalComptime "(+ 1 2)" 1000)) (rGen2 (ct/evalComptime "(* 9 9)" 1000)) (rGen3 (ct/evalComptime "(- 100 35)" 1000))] (assert (= rAdd.status "ok") "Addition expression must succeed cleanly") (assert (= rAdd.outputValue "30") "Addition result must evaluate to 30") (assert (= rMul.status "ok") "Multiplication expression must succeed cleanly") (assert (= rMul.outputValue "42") "Multiplication result must evaluate to 42") (assert (= rSub.status "ok") "Subtraction expression must succeed cleanly") (assert (= rSub.outputValue "42") "Subtraction result must evaluate to 42") (assert (= rDiv.status "ok") "Division expression must succeed cleanly") (assert (= rDiv.outputValue "25") "Division result must evaluate to 25") (assert (= rMod.status "ok") "Modulo expression must succeed cleanly") (assert (= rMod.outputValue "2") "Modulo result must evaluate to 2") (assert (= rStr.status "ok") "String concatenation must succeed cleanly") (assert (= rStr.outputValue "\"agentscript\"") "String result must match concatenated value") (assert (= rBoolAnd.status "ok") "Boolean AND must succeed cleanly") (assert (= rBoolAnd.outputValue "false") "Boolean AND must evaluate to false") (assert (= rBoolOr.status "ok") "Boolean OR must succeed cleanly") (assert (= rBoolOr.outputValue "true") "Boolean OR must evaluate to true") (assert (= rBoolNot.status "ok") "Boolean NOT must succeed cleanly") (assert (= rBoolNot.outputValue "true") "Boolean NOT must evaluate to true") (assert (= rNested.status "ok") "Nested folded expression must succeed cleanly") (assert (= rNested.outputValue "22") "Nested expression (+ (* 3 4) (- 20 10)) must evaluate to 22") (assert (> rNested.fuelRemaining 0) "Nested expression must consume fuel while leaving remaining steps") (assert (= rGen1.status "ok") "Generalized (+ 1 2) must succeed cleanly") (assert (= rGen1.outputValue "3") "Generalized (+ 1 2) must evaluate to 3") (assert (= rGen2.status "ok") "Generalized (* 9 9) must succeed cleanly") (assert (= rGen2.outputValue "81") "Generalized (* 9 9) must evaluate to 81") (assert (= rGen3.status "ok") "Generalized (- 100 35) must succeed cleanly") (assert (= rGen3.outputValue "65") "Generalized (- 100 35) must evaluate to 65") (refute (= rAdd.outputValue "0") "Refutation: (+ 10 20) cannot evaluate to 0") (refute (= rMul.outputValue "40") "Refutation: (* 6 7) cannot evaluate to 40") (refute (= rSub.outputValue "58") "Refutation: (- 50 8) cannot evaluate to 58") (refute (= rStr.outputValue "\"\"") "Refutation: String concat cannot evaluate to empty") (refute (= rBoolAnd.outputValue "true") "Refutation: (and true false) cannot evaluate to true") (refute (= rBoolNot.outputValue "false") "Refutation: (not false) cannot evaluate to false") (refute (= rNested.outputValue "12") "Refutation: Nested arithmetic cannot ignore inner subexpressions") (refute (= rNested.status "error") "Refutation: Valid pure expression must not return error") (refute (= rGen1.outputValue "(+ 1 2)") "Refutation: Generalized (+ 1 2) cannot remain unreduced") (refute (= rGen2.outputValue "0") "Refutation: Generalized (* 9 9) cannot evaluate to 0") (refute (= rGen3.outputValue "0") "Refutation: Generalized (- 100 35) cannot evaluate to 0") true)

fn testComptimeFuelExhaustion -> Bool
  (let [(cost (ct/consumeFuel 100 35)) (rShort (ct/evalComptime "(+ (* 2 3) (* 4 5))" 1)) (rLoop (ct/evalComptime "(recurseInf 99)" 10)) (rZeroFuel (ct/evalComptime "(+ 1 2)" 0))] (assert (= cost 65) "Fuel deduction 100 - 35 must yield 65") (assert (= rShort.status "error") "Expression with insufficient fuel budget must fail") (assert (= rShort.diagnosticCode "ERR_COMPTIME_FUEL_EXHAUSTED") "Diagnostic must indicate fuel exhaustion") (assert (= rLoop.status "error") "Infinite recursion simulation must fail with fuel exhaustion") (assert (= rLoop.diagnosticCode "ERR_COMPTIME_FUEL_EXHAUSTED") "Infinite recursion diagnostic must be fuel exhaustion") (assert (<= rLoop.fuelRemaining 0) "Fuel remaining on exhaustion must be 0") (assert (= rZeroFuel.status "error") "Evaluation with zero fuel budget must halt immediately") (assert (= rZeroFuel.diagnosticCode "ERR_COMPTIME_FUEL_EXHAUSTED") "Zero fuel must return ERR_COMPTIME_FUEL_EXHAUSTED") (refute (= rShort.status "ok") "Refutation: Insufficient fuel must not return status ok") (refute (= rLoop.status "ok") "Refutation: Infinite recursion must not evaluate to ok") (refute (= rLoop.diagnosticCode "") "Refutation: Fuel exhaustion must provide non-empty diagnostic code") (refute (= rZeroFuel.status "ok") "Refutation: Zero fuel cannot evaluate to ok") (refute (= cost 100) "Refutation: Consuming fuel must decrease balance") true)

fn testComptimeImpureEffectRejection -> Bool
  (let [(pPure1 (ct/checkPurity "(+ 1 2)")) (pPure2 (ct/checkPurity "(stringConcat \"a\" \"b\")")) (pImpure1 (ct/checkPurity "(sys-exec \"cat /etc/passwd\")")) (pImpure2 (ct/checkPurity "(fs-write \"/tmp/test.txt\" \"bad\")")) (pImpure3 (ct/checkPurity "(ambient-clock)")) (pImpure4 (ct/checkPurity "(net-fetch \"https://example.com\")")) (rExec (ct/evalComptime "(sys-exec \"ls\")" 1000)) (rFs (ct/evalComptime "(fs-write \"bad.txt\" \"data\")" 1000))] (assert pPure1 "Pure arithmetic must pass purity check") (assert pPure2 "Pure string concat must pass purity check") (assert (not pImpure1) "Shell execution must fail purity check") (assert (not pImpure2) "Filesystem write must fail purity check") (assert (not pImpure3) "Ambient clock access must fail purity check") (assert (not pImpure4) "Network fetch must fail purity check") (assert (= rExec.status "error") "Evaluation of sys-exec must fail at compile time") (assert (= rExec.diagnosticCode "ERR_COMPTIME_IMPURE_EFFECT") "Diagnostic must indicate impure effect") (assert (= rFs.status "error") "Evaluation of fs-write must fail at compile time") (assert (= rFs.diagnosticCode "ERR_COMPTIME_IMPURE_EFFECT") "Diagnostic must indicate impure effect on filesystem access") (refute pImpure1 "Refutation: Shell execution cannot be pure") (refute pImpure2 "Refutation: Filesystem write cannot be pure") (refute pImpure3 "Refutation: Ambient clock cannot be pure") (refute pImpure4 "Refutation: Network fetch cannot be pure") (refute (= rExec.status "ok") "Refutation: Impure sys-exec cannot return ok") (refute (= rFs.status "ok") "Refutation: Impure fs-write cannot return ok") (refute (not pPure1) "Refutation: Valid pure expression cannot be rejected as impure") true)

fn testComptimeQuasiquotationAndHygiene! -> Bool
  (let [(qStr (ct/expandQuasiquote "(quote (defun helper [x] (* x 2)))")) (sStr (ct/expandQuasiquote "(splice (quote (itemA itemB)))")) (nestedSplice (ct/expandQuasiquote "(quote (first (splice (quote (midA midB))) last))")) (sym1 (ct/gensym "item")) (sym2 (ct/gensym "item")) (symFilePresent (fileExists? "tmp/comptime_gensym.seq")) (rCeil (ct/evalComptime "(expandLargeAst 20000)" 50000))] (assert (stringContains? qStr "defun helper") "Quasiquote must retain inner AST terms unevaluated") (assert (stringContains? sStr "itemA itemB") "Splice must unpack sequence into enclosing form") (assert (stringContains? nestedSplice "midA midB") "Nested splice inside quote must unpack spliced elements") (assert (not symFilePresent) "Gensym must operate in RAM without host filesystem seq file") (assert (not (= sym1 sym2)) "Gensym must produce distinct hygienic symbols on sequential calls") (assert (stringStartsWith? sym1 "item_") "Gensym identifier must preserve prefix") (assert (= rCeil.status "error") "AST expansion exceeding node ceiling must fail") (assert (= rCeil.diagnosticCode "ERR_COMPTIME_NODE_CEILING_EXCEEDED") "Diagnostic must indicate AST node ceiling exceeded") (refute (= sym1 sym2) "Refutation: Identical hygienic symbols violate macro hygiene") (refute symFilePresent "Refutation: Gensym must not create filesystem files") (refute (stringContains? nestedSplice "splice") "Refutation: Expanded quasiquote must not retain splice keyword") (refute (= rCeil.status "ok") "Refutation: AST expansion beyond node ceiling cannot succeed") (refute (= rCeil.diagnosticCode "") "Refutation: Node ceiling error must provide diagnostic code") true)

fn ! testMonotonicAfterWaitsPastPrevious! -> Bool
  (let [(ahead (+ (monotonicNs) 2000000)) (reading (ct/monotonicAfter ahead))] (assert (> reading ahead) "monotonicAfter must wait until the clock passes a reading 2ms ahead") true)

fn ! runTests -> Bool
  (let [(okFold (testComptimeConstantFolding)) (okFuel (testComptimeFuelExhaustion)) (okPure (testComptimeImpureEffectRejection)) (okHygiene (testComptimeQuasiquotationAndHygiene!)) (okMonotonic (testMonotonicAfterWaitsPastPrevious!))] (and (and okFold okFuel) (and okPure (and okHygiene okMonotonic))))

fn RunTests! -> Bool
  (runTests)
