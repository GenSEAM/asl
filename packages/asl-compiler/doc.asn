(:doc :symbol "asl/packages/asl-compiler/src/asl1.asl#" :text "Stage-1 compiler driver. asl1 build ENTRY -o OUT.ll compiles ENTRY and its import closure with compilePackageToLlvm! and writes the LLVM IR to OUT.ll; asl1 check ENTRY runs chk/checkFile! on ENTRY with the roots checkRoots (. asl/packages asl), the same checker and diagnostic normalisation tests/conformance/bootstrap/checkParity measures against asl-host check (host codes such as ERR_UNKNOWN_SYMBOL, lint rows dropped); asl1 deps ENTRY prints the real path of every module in the import closure of ENTRY, one per line, sorted, without checking or compiling (a native build cache keys on their contents). Diagnostics go to standard error, one per line, and exit 1; a usage error exits 2; success exits 0. Imports resolve from the entry's directory, then the workspace root .")
(:doc :symbol "asl/packages/asl-compiler/src/asl1.asl#usage" :text "The command-line synopsis printed on a usage error.")
(:doc :symbol "asl/packages/asl-compiler/src/asl1.asl#checkRoots" :text "Import roots asl1 check hands chk/checkFile! after the entry's own directory: the workspace root, asl/packages and asl, as checkParity checkerDsFor! does.")
(:doc :symbol "asl/packages/asl-compiler/src/asl1.asl#distinctSorted" :text "xs sorted with repeats removed.")
(:doc :symbol "asl/packages/asl-compiler/src/asl1.asl#deps" :text "Prints the real path of each module of the entry's import closure (not the entry itself), sorted and distinct; exit 1 with a diagnostic when the entry does not read or parse or an import does not load.")
(:doc :symbol "asl/packages/asl-compiler/src/asl1.asl#main" :text "Runs asl1 build or asl1 check on the command-line arguments; the Int is the process exit code.")
(:doc :symbol "asl/packages/asl-compiler/src/checkCache.asl#" :text "Verdict cache for asl1 check (CHECK-SPEED). The key is the sha256 of the entry's real path, the bytes of every file in the entry's header closure (resolved as r/loadModuleDeps! resolves it) and the bytes of the checker's own source closure (./asl/packages/asl-compiler/src/asl1.asl and its imports); an entry is one file <key>.verdict under ASL_CHECK_CACHE or ~/.asl/cache/check holding the exit code and the diagnostics, replayed byte for byte on a hit. No key (unresolved import, unreadable file, no checker source under the working directory) means the cold path runs and nothing is stored.")
(:doc :symbol "asl/packages/asl-compiler/src/checkCache.asl#Verdict" :text "A stored check result: the exit code and the exact standard-error text.")
(:doc :symbol "asl/packages/asl-compiler/src/checkCache.asl#cacheDir!" :text "ASL_CHECK_CACHE when set and non-empty, else ~/.asl/cache/check.")
(:doc :symbol "asl/packages/asl-compiler/src/checkCache.asl#verdictKey!" :text "The cache key of entry, or none when the entry or a file of either closure cannot be resolved or read.")
(:doc :symbol "asl/packages/asl-compiler/src/checkCache.asl#keyText" :text "The text hashed into a key: magic line, entry path, path=sha lines of the entry closure, then of the checker closure.")
(:doc :symbol "asl/packages/asl-compiler/src/checkCache.asl#encodeVerdict" :text "Serialises a verdict: magic line, key, exit code, sha256 of the body, then the body.")
(:doc :symbol "asl/packages/asl-compiler/src/checkCache.asl#decodeVerdict" :text "Parses a stored verdict; a wrong magic or key, a non-integer exit code, a truncated text or a body not matching its digest is none, a miss, never an error.")
(:doc :symbol "asl/packages/asl-compiler/src/checkCache.asl#lookup!" :text "The stored verdict for key, or none when it is absent or does not decode.")
(:doc :symbol "asl/packages/asl-compiler/src/checkCache.asl#store!" :text "Writes the verdict to a temporary file beside its entry and renames it into place, so readers see a whole entry or none; removes the temporary file on failure.")
(:doc :symbol "asl/packages/asl-compiler/src/checkCache.asl#replay!" :text "Prints the stored body to standard error exactly as the cold run did and returns its exit code.")
