          :rationale "Distinguishes root evaluation environment with empty frames from nested child scopes")
    (:sym :name "makeChildEnv" :kind :fn :tokens 3
          :rationale "Distinguishes child nested evaluation frame creation from unparented root scope initialization")
    (:sym :name "evalBuiltinArithmetic" :kind :fn :tokens 3
          :rationale "Isolates binary arithmetic evaluation dispatcher from logic, string, and comparison evaluators")
    (:sym :name "evalBuiltinComparison" :kind :fn :tokens 3
          :rationale "Isolates structural and relational comparison evaluator from arithmetic and logic operations")
    (:sym :name "evalBuiltinLogic" :kind :fn :tokens 3
          :rationale "Isolates boolean logic evaluator from arithmetic, comparison, and string operation dispatchers")
    (:sym :name "evalBuiltinString" :kind :fn :tokens 3
          :rationale "Isolates string operations (concatenation, length, containment) from list and arithmetic operations")
    (:sym :name "evalBuiltinList" :kind :fn :tokens 3
          :rationale "Isolates list operations (cons, head, tail, emptiness) from string and arithmetic dispatchers")
    (:sym :name "evalSpecialForm" :kind :fn :tokens 3
          :rationale "Distinguishes non-strict special form evaluation (if, assert, do) from standard eager argument evaluation")
    (:sym :name "evalResultIsOk?" :kind :fn :tokens 4
          :rationale "Verifies whether an EvalValue is a successful evaluated outcome versus an explicit val-error")
    (:sym :name "testCompileCleanFunction" :kind :fn :tokens 4
