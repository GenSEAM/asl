fn formatValsStep items: (List EvalValue) idx: Int64 len: Int64 acc: (List String) -> (List String)
  (if (>= idx len) acc (let [(it (optionOr (listGet items idx) (valNull)))] (formatValsStep items (+ idx 1) len (listAppend acc (list (formatVal it))))))

