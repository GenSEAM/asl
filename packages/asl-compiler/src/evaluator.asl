  (mt p ((rd/sexprAtom name) name) ((rd/sexprList items) (mt (listHead items) ((some node) (mt node ((rd/sexprAtom name) name) (else ""))) ((none) ""))) ((rd/sexprVect items) (mt (listHead items) ((some node) (mt node ((rd/sexprAtom name) name) (else ""))) ((none) ""))))

