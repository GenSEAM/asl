(module asl-compiler/evaluator :x [EvalValue EvalEnv makeRootEnv makeChildEnv envLookup envBind evalAtom evalBuiltinArithmetic evalBuiltinComparison evalBuiltinLogic evalBuiltinString evalBuiltinList evalBuiltinIo! evalBuiltinSys! evalSpecialForm! evalSexpr! evalAssert truthy? evalResultIsOk? formatVal applyClosure! evalValuesEqual?] :i [(reader :a rd) (wasi :a wasi)])

(enum EvalValue (:c valInt [(v Int64)] "64-bit signed integer value") (:c valFloat [(v Float64)] "64-bit floating point value") (:c valStr [(v String)] "String value") (:c valBool [(v Bool)] "Boolean truth value") (:c valNull [] "Unit / Null value") (:c valList [(items (List EvalValue))] "List of values") (:c valVect [(items (List EvalValue))] "Vector of values") (:c valMap [(entries (Map String EvalValue))] "Key-value map table") (:c valError [(msg String)] "Error value") (:c valClosure [(name String) (params (List String)) (body rd/SExpr) (env EvalEnv)] "Lexical closure function value"))

(schema EvalEnv (:f bindings (Map String EvalValue)) (:f parentFrames (List (Map String EvalValue))))

fn makeRootEnv -> EvalEnv
  (EvalEnv :bindings (mapEmpty) :parentFrames (list))

fn makeChildEnv parent: EvalEnv -> EvalEnv
  (EvalEnv :bindings (mapEmpty) :parentFrames (cons parent.bindings parent.parentFrames))

fn framesLookup frames: (List (Map String EvalValue)) name: String -> (Option EvalValue)
  (mt (listHead frames) ((some frame) (mt (mapGet frame name) ((some v) (some v)) ((none) (mt (listTail frames) ((some restFrames) (framesLookup restFrames name)) ((none) (none)))))) ((none) (none)))

fn envLookup env: EvalEnv name: String -> (Option EvalValue)
  (mt (mapGet env.bindings name) ((some v) (some v)) ((none) (framesLookup env.parentFrames name)))

fn envBind env: EvalEnv name: String val: EvalValue -> EvalEnv
  (with env :bindings (mapSet env.bindings name val))

fn truthy? v: EvalValue -> Bool
  (mt v ((valBool b) b) ((valNull) false) ((valError _) false) ((valInt _) false) ((valFloat _) false) ((valStr _) false) ((valList _) false) ((valVect _) false) ((valMap _) false) ((valClosure _ _ _ _) false))

fn evalResultIsOk? v: EvalValue -> Bool
  (mt v ((valError _) false) ((valInt _) true) ((valFloat _) true) ((valStr _) true) ((valBool _) true) ((valNull) true) ((valList _) true) ((valVect _) true) ((valMap _) true) ((valClosure _ _ _ _) true))

fn evalAssert condVal: EvalValue msgStr: String -> EvalValue
  (if (truthy? condVal) (valBool true) (valError msgStr))

fn evalReject condVal: EvalValue msgStr: String -> EvalValue
  (if (truthy? condVal) (valError msgStr) (valBool true))

fn evalAtom atomStr: String env: EvalEnv -> EvalValue
  (cond ((= atomStr "true") (valBool true)) ((= atomStr "false") (valBool false)) ((or (= atomStr "null") (= atomStr "nil")) (valNull)) ((and (stringStartsWith? atomStr "\"") (stringEndsWith? atomStr "\"")) (let [(len (stringLength atomStr))] (if (>= len 2) (mt (stringSlice atomStr 1 (- len 1)) ((some unquoted) (valStr unquoted)) ((none) (valStr ""))) (valStr "")))) (else (mt (stringToInt64 atomStr) ((some i) (valInt i)) ((none) (mt (stringToFloat64 atomStr) ((some f) (valFloat f)) ((none) (mt (envLookup env atomStr) ((some v) v) ((none) (valError (str "ERR_UNBOUND_SYMBOL: " atomStr))))))))))

fn evalBuiltinArithmetic op: String a: Int64 b: Int64 -> EvalValue
  (cond ((= op "+") (valInt (+ a b))) ((= op "-") (valInt (- a b))) ((= op "*") (valInt (* a b))) ((= op "/") (if (= b 0) (valError "ERR_DIVISION_BY_ZERO") (valInt (/ a b)))) ((= op "mod") (if (= b 0) (valError "ERR_MODULO_BY_ZERO") (valInt (mod a b)))) (else (valError (str "ERR_UNKNOWN_ARITHMETIC_OP: " op))))

