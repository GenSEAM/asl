(:doc :symbol "asl/packages/asl-net/src/handoff.asl#" :text "Hands a listening Unix socket to another process over an explicit peer channel, a connected AF_UNIX stream socket, with SCM_RIGHTS: openHandoffChannel makes a channel pair (one end per process, for example across a fork), handoffListeningSocket sends the listener over one end and receiveListeningSocket adopts it from the other. Native only: unixSocketPair, sockSendFd and sockRecvFd are routed by asl-target-llvm/sysRoute to asl-target-llvm/sysNet and asl-host has no builtin for them, so asl-host cannot load this module; asl-net/unix stays loadable there.")
(:doc :symbol "asl/packages/asl-net/src/handoff.asl#HandoffChannel.sender" :text "the end handoffListeningSocket sends on")
(:doc :symbol "asl/packages/asl-net/src/handoff.asl#HandoffChannel.receiver" :text "the end receiveListeningSocket reads from")
(:doc :symbol "asl/packages/asl-net/src/handoff.asl#handoffListeningSocket" :text "the listener stays open here: the receiver gets its own descriptor for the same socket, and the caller closes this one with closeUnixSocket or fdClose")
(:doc :symbol "asl/packages/asl-net/src/handoff.asl#receiveListeningSocket" :text "path names the socket file the sender bound; its lstat proves the file is still a socket and gives the permissions, so the adopted server equals the sender's but for fd")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#" :text "Non-blocking event-driven reactor owning socket fds and child process pipes")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#ProcEntry.handle" :text "child pid from procSpawnv, also its process group")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#EVENT_READ" :text "--- Constants ---")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#ReactorRegistration" :text "--- Registration reactor over fdPoll (NET1 API) ---")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#readyMaskFor" :text "the revents fdPoll reported for fd, none when it was not ready")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#reactorPoll" :text "one fdPoll over every registration; an event carries the revents the kernel reported (EVENT_READ, EVENT_WRITE, EVENT_ERROR bits), in registration order")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#reactorNextEvent!" :text "the next queued event; an empty queue is refilled by a non-blocking reactorPoll")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#ServerConfig" :text "--- NET2: I/O reactor owning real fds ---")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#HttpEvent" :text "HttpEvent uses string kind tag for maximum host compatibility")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#chunkedBodyEnd" :text "byte length of a complete chunked body starting at pos, none while more bytes are needed")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#requestLength" :text "total byte length of the request at the head of buf (headers plus Content-Length or chunked body), none while incomplete")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#drainFd!" :text "reads a non-blocking pipe until it would block or reaches EOF; the Bool is true at EOF")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#stepProc!" :text "one step for one child: collect its output, then report it done, timed out (group killed and reaped) or failed; none keeps it running")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#reactorPollTimeoutMs" :text "a proc deadline bounds the poll so its timeout fires on time; -1 (no limit) stays -1 only when no proc has a deadline")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#writeAll!" :text "client sockets are non-blocking: a full send buffer waits for POLLOUT until the deadline instead of failing the response")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#responseHeaders" :text "chunked responses carry no Content-Length; a caller's own Content-Length is not duplicated")
(:doc :symbol "asl/packages/asl-net/src/reactor.asl#reactorAddProc!" :text "takes a child from procSpawnv whose stdin the caller has closed; its pipes become non-blocking and are read on every step")
(:doc :symbol "asl/packages/asl-net/src/socket.asl#" :text "AgentSlang loopback TCP sockets over the host socket builtins tcpListen, tcpConnect, sockAccept, sockLocalPort, fdRead, fdWrite, fdClose, fdPoll and fdNonBlocking; host errors pass through unchanged")
(:doc :symbol "asl/packages/asl-net/src/socket.asl#SocketConfig.port" :text "0 asks the kernel for a free port")
(:doc :symbol "asl/packages/asl-net/src/socket.asl#SocketConfig.nonBlocking" :text "the listener fails accept with the host's would-block error instead of waiting")
(:doc :symbol "asl/packages/asl-net/src/socket.asl#ServerSocket.port" :text "the bound port, the kernel's choice when the config asked for 0")
(:doc :symbol "asl/packages/asl-net/src/socket.asl#loopbackHost?" :text "tcpListen and tcpConnect bind and dial 127.0.0.1 only, so any other host is refused rather than silently served on loopback")
(:doc :symbol "asl/packages/asl-net/src/socket.asl#readSocketBytes" :text "one read of at most maxBytes; (ok \"\") is end of stream, a non-blocking socket with nothing buffered gives the host's would-block error")
(:doc :symbol "asl/packages/asl-net/src/socket.asl#writeSocketBytes" :text "one write; the count is what the kernel accepted, which can be less than the payload on a full send buffer")
(:doc :symbol "asl/packages/asl-net/src/socket.asl#pollSocket" :text "fdPoll reports 1 for readable, 4 for hangup, error or an invalid descriptor; a listener is readable when a connection is pending")
(:doc :symbol "asl/packages/asl-net/src/unix.asl#" :text "AgentSlang Unix domain socket server and client over the host builtins unixListen, unixConnect, fileChmod, fileLstat, pathRemove and fdClose; accept, read and write go through asl-net/socket")
(:doc :symbol "asl/packages/asl-net/src/unix.asl#UnixSocketConfig.unlinkStale" :text "remove a leftover socket file at path before binding; a non-socket file is never removed")
(:doc :symbol "asl/packages/asl-net/src/unix.asl#UnixSocketConfig.permissions" :text "mode bits applied to the socket file, 0 to 0777")
(:doc :symbol "asl/packages/asl-net/src/unix.asl#socketMode?" :text "S_IFMT is the mode above the low 12 bits; 12 there (0140000) is a socket")
(:doc :symbol "asl/packages/asl-net/src/unix.asl#closeUnixSocket" :text "closes the listener and unlinks its path, so the next bind needs no unlinkStale")
(:doc :symbol "asl/packages/asl-net/tests/loopHttpTest.asl#" :text "NET2 gate: loopback HTTP server reactor covering pipelining, 431 oversized headers, slow-client timeout, chunked transfer, SSE, procDone, procTimeout killing the child group, procError and Content-Length and chunked request bodies")
(:doc :symbol "asl/packages/asl-net/tests/loopHttpTest.asl#testProcTimeout!" :text "the child forks a grandchild into its own process group and prints its pid; a timeout must kill both without blocking the step")
(:doc :symbol "asl/packages/asl-net/tests/loopHttpTest.asl#testProcError!" :text "a pid that is not our child cannot be waited on; it is reported once and dropped, never signalled")
(:doc :symbol "asl/packages/asl-net/tests/loopHttpTest.asl#testRequestBodies!" :text "--- Test: request bodies (Content-Length split across reads, chunked, then a pipelined GET) ---")
(:doc :symbol "asl/packages/asl-net/tests/loopHttpTest.asl#testPeerDisconnectClosesServerFd!" :text "--- Test: peer disconnect closes the server-side fd ---")
(:doc :symbol "asl/packages/asl-net/tests/loopHttpTest.asl#testPeerDisconnectClosesServerFd!" :text "fdClose on the server-side fd fails with EBADF only if the reactor already closed it; nothing opens an fd in between, so the number cannot be reused")
(:doc :symbol "asl/packages/asl-net/tests/loopHttpTest.asl#runTests" :text "--- Main ---")
(:doc :symbol "asl/packages/asl-net/tests/reactorFramingTest.asl#" :text "Framing regression gates for reactor wire bytes: response headers, poll failure, writes to a full non-blocking pipe")
(:doc :symbol "asl/packages/asl-net/tests/reactorFramingTest.asl#slowReaderWrite!" :text "a reader that starts after the pipe buffer is full: the write must wait for it, not fail on wouldBlock")
(:doc :symbol "asl/packages/asl-net/tests/reactorParserTest.asl#" :text "NET2 request framing and chunk-size edge cases on buffers, independent of loopback sockets")
(:doc :symbol "asl/packages/asl-net/tests/reactorTest.asl#" :text "Popperian verification suite for asl-net non-blocking Reactor event loop")
(:doc :symbol "asl/packages/asl-net/tests/reactorTest.asl#testReactorPollingAndDispatch!" :text "a real listener: no event while nothing is pending, one EVENT_READ event once a client connects")
(:doc :symbol "asl/packages/asl-net/tests/reactorTest.asl#testReactorReportsKernelMask!" :text "two registrations, only the second ready, and its kernel mask (EVENT_WRITE) differs from its interest (EVENT_READ|EVENT_WRITE): an event per ready fd only, carrying what the kernel reported")
(:doc :symbol "asl/packages/asl-net/tests/socketTest.asl#" :text "asl-net TCP and Unix socket API over real loopback descriptors: echo and end of stream, poll readiness, non-blocking accept, closed-descriptor errors, config validation, Unix socket mode, stale-path unlink and close cleanup")
(:doc :symbol "asl/packages/asl-net/tests/socketTest.asl#readExactly!" :text "polls before each read so a peer that never sends fails the test in 5 s instead of blocking it")
(:doc :symbol "asl/packages/asl-net/tests/socketTest.asl#testLoopbackEcho!" :text "the NETSIM gate: bytes cross a real loopback TCP connection both ways through the asl-net API, and a closed peer reads as end of stream")
(:doc :symbol "asl/packages/asl-net/tests/socketTest.asl#testReadBound!" :text "a read returns at most maxBytes even when more is buffered; the rest stays for the next read")
