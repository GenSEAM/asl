(module asl-target-swift/emitSwift :x [emitSwiftStruct emitSwiftStructWithPairs emitSwiftEnum emitSwiftSimpleEnum emitSwiftFn emitSwiftLet emitSwiftIf emitSwiftExpr emitSwiftSource emitSwiftInterpolation emitSwiftTopSchema emitSwiftTopEnum emitSwiftTopDefun emitSwiftTopForm emitSwiftSourceFromForms] :i [(asl-target-swift/types :a t) (asl-parser/ast :a a) (asl-parser/reader :a rd)])

fn emitSwiftStruct name: Str fieldsStr: Str -> Str
  (let [(cleanName (t/swiftMangleIdent name))
        (body (if (stringEmpty? fieldsStr) "    // No stored fields\n" fieldsStr))]
    (str "public struct " cleanName ": Codable, Equatable, Hashable, Sendable {\n" body "}\n"))

fn emitSwiftStructWithPairs name: Str fields: (List (Pair Str Str)) -> Str
  (let [(cleanName (t/swiftMangleIdent name))]
    (if (= (listLength fields) 0)
      (emitSwiftStruct name "")
      (let [(varDecls (map (fn [(p (pair Str Str))] -> Str
                             (str "    public var " (t/swiftMangleIdent (pairFirst p)) ": " (t/emitSwiftType (pairSecond p)) "\n"))
                           fields))
            (params (map (fn [(p (pair Str Str))] -> Str
                           (str (t/swiftMangleIdent (pairFirst p)) ": " (t/emitSwiftType (pairSecond p))))
                         fields))
            (assigns (map (fn [(p (pair Str Str))] -> Str
                            (str "        self." (t/swiftMangleIdent (pairFirst p)) " = " (t/swiftMangleIdent (pairFirst p)) "\n"))
                          fields))
            (initBlock (str "\n    public init(" (stringJoin params ", ") ") {\n" (stringJoin assigns "") "    }\n"))]
        (str "public struct " cleanName ": Codable, Equatable, Hashable, Sendable {\n"
             (stringJoin varDecls "")
             initBlock
             "}\n"))))

fn emitSwiftSimpleEnum name: Str cases: (List Str) -> Str
  (let [(cleanName (t/swiftMangleIdent name))
        (caseDecls (map (fn [(c Str)] -> Str
                          (let [(cClean (t/swiftMangleIdent c))]
                            (str "    case " cClean " = \"" cClean "\"\n")))
                        cases))]
    (str "public enum " cleanName ": String, Codable, CaseIterable, Sendable {\n"
         (stringJoin caseDecls "")
         "}\n"))

fn hasPayloadCases? cases: (List (Pair Str Str)) -> Bool
  (fold (fn [(acc Bool) (p (pair Str Str))] -> Bool
          (or acc (not (stringEmpty? (stringTrim (pairSecond p))))))
        false
        cases)

fn emitSwiftEnum name: Str cases: (List (Pair Str Str)) -> Str
  (let [(cleanName (t/swiftMangleIdent name))
        (hasPayloads (hasPayloadCases? cases))]
    (if hasPayloads
      (let [(caseLines (map (fn [(p (pair Str Str))] -> Str
                              (let [(cName (t/swiftMangleIdent (pairFirst p)))
                                    (payload (stringTrim (pairSecond p)))]
                                (if (stringEmpty? payload)
                                  (str "    case " cName "\n")
                                  (str "    case " cName "(" (t/emitSwiftType payload) ")\n"))))
                            cases))]
        (str "public enum " cleanName ": Codable, Equatable, Hashable, Sendable {\n"
             (stringJoin caseLines "")
             "}\n"))
      (let [(simpleCases (map (fn [(p (pair Str Str))] -> Str (pairFirst p)) cases))]
        (emitSwiftSimpleEnum name simpleCases))))

fn emitSwiftFn name: Str params: Str retTy: Str body: Str isExported: Bool -> Str
  (let [(vis (if isExported "public " ""))
        (cleanName (t/swiftMangleIdent name))
        (cleanRet (t/emitSwiftType retTy))
        (retClause (if (or (= cleanRet "Void") (= cleanRet "")) "" (str " -> " cleanRet)))]
    (str vis "func " cleanName "(" params ")" retClause " {\n"
         body "\n}\n"))

fn emitSwiftLet varName: Str expr: Str -> Str
  (str "let " (t/swiftMangleIdent varName) " = " expr)

fn emitSwiftIf condExpr: Str thenExpr: Str elseExpr: Str -> Str
  (str "(" condExpr " ? " thenExpr " : " elseExpr ")")

fn emitSwiftExpr expr: Str -> Str
  (t/emitSwiftAtom expr)

fn emitSwiftInterpolation parts: (List Str) -> Str
  (let [(joined (stringJoin parts ""))]
    (str "\"" joined "\""))

fn emitSwiftSource moduleName: Str includesUi: Bool decls: (List Str) -> Str
  (let [(hdr (t/emitSwiftHeader includesUi))
        (body (stringJoin decls "\n\n"))]
    (str "//\n// Generated by AgentSlang Swift Backend (asl-target-swift)\n// Module: "
         moduleName "\n//\n\n"
         hdr
         body
         "\n"))

fn emitSwiftTopSchema s: a/SchemaNode -> Str
  (let [(pairs (map (fn [(f a/AstField)] -> (Pair Str Str)
                      (pair f.name f.type))
                    s.fields))]
    (emitSwiftStructWithPairs s.name pairs))

fn emitSwiftTopEnum e: a/EnumNode -> Str
  (let [(pairs (map (fn [(c a/EnumCase)] -> (Pair Str Str)
                      (let [(fList c.fields)
                            (payload (if (= (listLength fList) 0)
                                       ""
                                       (let [(p0 (optionOr (listHead fList) (a/Param :name "" :type "")))]
                                         p0.type)))]
                        (pair c.name payload)))
                    e.cases))]
    (emitSwiftEnum e.name pairs))

fn emitSwiftTopDefun d: a/DefunNode -> Str
  (let [(paramsList (map (fn [(p a/Param)] -> Str
                           (str (t/swiftMangleIdent p.name) ": " (t/emitSwiftType p.type)))
                         d.params))
        (paramsStr (stringJoin paramsList ", "))
        (bodyExprs (map (fn [(b rd/SExpr)] -> Str (rd/renderSexpr b)) d.body))
        (bodyStr (if (= (listLength bodyExprs) 0) "    return" (str "    return " (stringJoin bodyExprs " "))))]
    (emitSwiftFn d.name paramsStr d.retType bodyStr d.isExported))


fn emitSwiftTopForm tf: a/TopForm -> Str
  (mt tf
    ((a/topSchema s) (emitSwiftTopSchema s))
    ((a/topEnum e) (emitSwiftTopEnum e))
    ((a/topDefun d) (emitSwiftTopDefun d))
    ((a/topModule _) "")
    ((a/topExpr p) (rd/renderSexpr p.expr)))

fn unpackForms forms: (List a/TopForm) -> (List a/TopForm)
  (if (= (listLength forms) 1)
    (mt (listHead forms)
      ((some it) (mt it ((a/topModule m) m.defs) (_ forms)))
      ((none) forms))
    forms)

fn extractModuleName forms: (List a/TopForm) defaultPath: Str -> Str
  (if (> (listLength forms) 0)
    (mt (listHead forms)
      ((some it) (mt it ((a/topModule m) m.path) (_ defaultPath)))
      ((none) defaultPath))
    defaultPath)

fn emitSwiftSourceFromForms forms: (List a/TopForm) path: Str -> Str
  (let [(modName (extractModuleName forms path))
        (effForms (unpackForms forms))
        (rendered (filter (fn [(s Str)] -> Bool (not (stringEmpty? s)))
                          (map emitSwiftTopForm effForms)))]
    (emitSwiftSource modName false rendered))
