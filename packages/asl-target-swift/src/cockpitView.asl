(module asl-target-swift/cockpitView :x [emitSwiftVoiceBarView emitSwiftAttentionRailView emitSwiftCockpitAudioViews] :i [(asl-target-swift/types :a t)])

fn emitSwiftVoiceBarView -> Str
  (str "//\n"
       "// Sovereign Cockpit Voice Bar View\n"
       "// Generated by AgentSlang Swift Backend (asl-target-swift)\n"
       "// Target: macOS 14+ / Swift 6 / SwiftUI\n"
       "// Reference: ADR D126, D130, D139\n"
       "//\n\n"
       "import SwiftUI\n\n"
       "public struct VoiceBarView: View {\n"
       "    @ObservedObject public var ingress: AudioIngressController\n"
       "    public var speakerVerified: Bool\n"
       "    public var lastTranscript: String\n"
       "    public var onToggleMode: () -> Void\n\n"
       "    public init(\n"
       "        ingress: AudioIngressController,\n"
       "        speakerVerified: Bool = true,\n"
       "        lastTranscript: String = \"\",\n"
       "        onToggleMode: @escaping () -> Void = {}\n"
       "    ) {\n"
       "        self.ingress = ingress\n"
       "        self.speakerVerified = speakerVerified\n"
       "        self.lastTranscript = lastTranscript\n"
       "        self.onToggleMode = onToggleMode\n"
       "    }\n\n"
       "    private var normalizedLevel: CGFloat {\n"
       "        let clamped = max(-90.0, min(0.0, ingress.currentDbfs))\n"
       "        return CGFloat((clamped + 90.0) / 90.0)\n"
       "    }\n\n"
       "    public var body: some View {\n"
       "        HStack(spacing: 12) {\n"
       "            // Mode badge (PTT vs Always-Listening)\n"
       "            Button(action: onToggleMode) {\n"
       "                HStack(spacing: 4) {\n"
       "                    Image(systemName: ingress.mode == .pushToTalk ? \"mic.fill\" : \"waveform\")\n"
       "                    Text(ingress.mode == .pushToTalk ? \"PTT\" : \"ALWAYS\")\n"
       "                        .font(.system(size: 11, weight: .bold, design: .monospaced))\n"
       "                }\n"
       "                .padding(.horizontal, 8)\n"
       "                .padding(.vertical, 4)\n"
       "                .background(ingress.mode == .pushToTalk ? Color.blue.opacity(0.2) : Color.green.opacity(0.2))\n"
       "                .cornerRadius(4)\n"
       "            }\n"
       "            .buttonStyle(.plain)\n\n"
       "            // Live dBFS Meter Bar\n"
       "            GeometryReader { geo in\n"
       "                ZStack(alignment: .leading) {\n"
       "                    RoundedRectangle(cornerRadius: 3)\n"
       "                        .fill(Color.gray.opacity(0.3))\n"
       "                    RoundedRectangle(cornerRadius: 3)\n"
       "                        .fill(ingress.isDucked ? Color.orange : (normalizedLevel > 0.5 ? Color.green : Color.blue))\n"
       "                        .frame(width: geo.size.width * normalizedLevel)\n"
       "                }\n"
       "            }\n"
       "            .frame(height: 8)\n\n"
       "            // dBFS Numeric Readout\n"
       "            Text(String(format: \"%.1f dB\", ingress.currentDbfs))\n"
       "                .font(.system(size: 10, design: .monospaced))\n"
       "                .foregroundColor(.secondary)\n"
       "                .frame(width: 55, alignment: .trailing)\n\n"
       "            // Biometric Verification Badge\n"
       "            HStack(spacing: 4) {\n"
       "                Circle()\n"
       "                    .fill(speakerVerified ? Color.green : Color.red)\n"
       "                    .frame(width: 8, height: 8)\n"
       "                Text(speakerVerified ? \"Verified\" : \"Unknown\")\n"
       "                    .font(.system(size: 10, weight: .medium))\n"
       "            }\n"
       "            .padding(.horizontal, 6)\n"
       "            .padding(.vertical, 2)\n"
       "            .background(Color.secondary.opacity(0.1))\n"
       "            .cornerRadius(4)\n\n"
       "            // Speech Language Badge (Auto vs Pinned)\n"
       "            HStack(spacing: 4) {\n"
       "                Image(systemName: \"globe\")\n"
       "                    .font(.system(size: 9))\n"
       "                Text(ingress.speechLanguage == .autoDetect ? \"AUTO (\\(ingress.detectedLanguageTag.uppercased()))\" : ingress.speechLanguage.rawValue.uppercased())\n"
       "                    .font(.system(size: 10, weight: .bold, design: .monospaced))\n"
       "                    .foregroundColor(ingress.speechLanguage == .autoDetect ? .green : .purple)\n"
       "            }\n"
       "            .padding(.horizontal, 6)\n"
       "            .padding(.vertical, 2)\n"
       "            .background(Color.secondary.opacity(0.1))\n"
       "            .cornerRadius(4)\n"
       "        }\n"
       "        .padding(8)\n"
       "        .background(Color(NSColor.windowBackgroundColor))\n"
       "        .cornerRadius(6)\n"
       "    }\n"
       "}\n\n")

fn emitSwiftAttentionRailView -> Str
  (str "//\n"
       "// Sovereign Cockpit Attention Rail (Two-Phase Commit Drawer)\n"
       "// Generated by AgentSlang Swift Backend (asl-target-swift)\n"
       "// Target: macOS 14+ / Swift 6 / SwiftUI\n"
       "// Reference: ADR D130, D139 (V0 Human Sovereignty)\n"
       "//\n\n"
       "import SwiftUI\n\n"
       "public struct AttentionRailView: View {\n"
       "    public var pendingAction: String\n"
       "    public var targetResource: String\n"
       "    public var isDestructive: Bool\n"
       "    public var onConfirm: () -> Void\n"
       "    public var onCancel: () -> Void\n\n"
       "    public init(\n"
       "        pendingAction: String,\n"
       "        targetResource: String,\n"
       "        isDestructive: Bool = true,\n"
       "        onConfirm: @escaping () -> Void,\n"
       "        onCancel: @escaping () -> Void\n"
       "    ) {\n"
       "        self.pendingAction = pendingAction\n"
       "        self.targetResource = targetResource\n"
       "        self.isDestructive = isDestructive\n"
       "        self.onConfirm = onConfirm\n"
       "        self.onCancel = onCancel\n"
       "    }\n\n"
       "    public var body: some View {\n"
       "        VStack(alignment: .leading, spacing: 10) {\n"
       "            HStack {\n"
       "                Image(systemName: isDestructive ? \"exclamationmark.shield.fill\" : \"info.circle.fill\")\n"
       "                    .foregroundColor(isDestructive ? .red : .blue)\n"
       "                Text(\"Attention Rail: Two-Phase Commit Required\")\n"
       "                    .font(.system(size: 12, weight: .bold))\n"
       "                Spacer()\n"
       "                Text(isDestructive ? \"Tier-2 Destructive\" : \"Tier-1 Safe\")\n"
       "                    .font(.system(size: 10, weight: .semibold, design: .monospaced))\n"
       "                    .padding(.horizontal, 6)\n"
       "                    .padding(.vertical, 2)\n"
       "                    .background(isDestructive ? Color.red.opacity(0.2) : Color.blue.opacity(0.2))\n"
       "                    .cornerRadius(4)\n"
       "            }\n\n"
       "            HStack {\n"
       "                Text(\"Action: \").bold() + Text(pendingAction)\n"
       "                Spacer()\n"
       "                Text(\"Target: \").bold() + Text(targetResource)\n"
       "            }\n"
       "            .font(.system(size: 11, design: .monospaced))\n"
       "            .foregroundColor(.secondary)\n\n"
       "            Text(\"Say 'confirm' or press [Enter] to commit. Say 'cancel' or press [Esc] to cancel.\")\n"
       "                .font(.system(size: 10))\n"
       "                .foregroundColor(.secondary)\n\n"
       "            HStack(spacing: 12) {\n"
       "                Button(action: onConfirm) {\n"
       "                    HStack {\n"
       "                        Image(systemName: \"checkmark.circle.fill\")\n"
       "                        Text(\"Commit (Enter)\")\n"
       "                    }\n"
       "                    .frame(maxWidth: .infinity)\n"
       "                    .padding(.vertical, 6)\n"
       "                }\n"
       "                .buttonStyle(.borderedProminent)\n"
       "                .tint(isDestructive ? .red : .blue)\n"
       "                .keyboardShortcut(.defaultAction)\n\n"
       "                Button(action: onCancel) {\n"
       "                    HStack {\n"
       "                        Image(systemName: \"xmark.circle\")\n"
       "                        Text(\"Cancel (Escape)\")\n"
       "                    }\n"
       "                    .frame(maxWidth: .infinity)\n"
       "                    .padding(.vertical, 6)\n"
       "                }\n"
       "                .buttonStyle(.bordered)\n"
       "                .keyboardShortcut(.cancelAction)\n"
       "            }\n"
       "        }\n"
       "        .padding(12)\n"
       "        .background(Color(NSColor.controlBackgroundColor))\n"
       "        .overlay(\n"
       "            RoundedRectangle(cornerRadius: 8)\n"
       "                .stroke(isDestructive ? Color.red.opacity(0.4) : Color.blue.opacity(0.4), lineWidth: 1)\n"
       "        )\n"
       "        .cornerRadius(8)\n"
       "        .shadow(radius: 4)\n"
       "    }\n"
       "}\n\n")

fn emitSwiftCockpitAudioViews -> Str
  (let [(vb (emitSwiftVoiceBarView))
        (ar (emitSwiftAttentionRailView))]
    (str vb ar))
