(module asl-target-swift/audio :x [emitSwiftAudioIngress emitSwiftAudioHeader emitSwiftAudioModeEnum] :i [(asl-target-swift/types :a t)])

fn emitSwiftAudioHeader -> Str
  (str "import Foundation\n"
       "import AVFoundation\n"
       "import CoreAudio\n"
       "import Combine\n\n")

fn emitSwiftAudioModeEnum -> Str
  (str "public enum AudioIngressMode: String, CaseIterable, Sendable {\n"
       "    case pushToTalk = \"ptt\"\n"
       "    case alwaysListening = \"always\"\n"
       "}\n\n"
       "public enum AudioIngressStatus: String, Sendable {\n"
       "    case idle = \"idle\"\n"
       "    case listening = \"listening\"\n"
       "    case transmitting = \"transmitting\"\n"
       "    case error = \"error\"\n"
       "}\n\n"
       "public enum SpeechLanguageMode: String, CaseIterable, Sendable {\n"
       "    case autoDetect = \"auto\"\n"
       "    case enUS = \"en-US\"\n"
       "    case ruRU = \"ru-RU\"\n"
       "    case esES = \"es-ES\"\n"
       "    case deDE = \"de-DE\"\n"
       "}\n\n")

fn emitSwiftAudioIngress gatewayHost: Str gatewayPort: Str -> Str
  (let [(hdr (emitSwiftAudioHeader))
        (enums (emitSwiftAudioModeEnum))]
    (str "//\n"
         "// Native macOS CoreAudio AUVoiceProcessingIO Audio Ingress Controller\n"
         "// Generated by AgentSlang Swift Backend (asl-target-swift)\n"
         "// Target: macOS 14+ / Swift 6 / AVFoundation / CoreAudio\n"
         "// Reference: ADR D139\n"
         "//\n\n"
         hdr
         enums
         "@MainActor\n"
         "public final class AudioIngressController: NSObject, ObservableObject {\n"
         "    @Published public private(set) var status: AudioIngressStatus = .idle\n"
         "    @Published public var mode: AudioIngressMode = .alwaysListening\n"
         "    @Published public var speechLanguage: SpeechLanguageMode = .autoDetect\n"
         "    @Published public var detectedLanguageTag: String = \"auto\"\n"
         "    @Published public private(set) var currentDbfs: Float = -120.0\n"
         "    @Published public private(set) var isDucked: Bool = false\n"
         "    @Published public private(set) var lastTransmittedBytes: Int = 0\n\n"
         "    private var audioEngine: AVAudioEngine?\n"
         "    private var inputNode: AVAudioInputNode?\n"
         "    private let targetSampleRate: Double = 16000.0\n"
         "    private let targetChannels: AVAudioChannelCount = 1\n"
         "    private let vadEnergyThresholdDbfs: Float = -42.0\n"
         "    private let duckingVolumeDeltaDb: Float = -12.0\n"
         "    private let gatewayStreamUrl: URL\n\n"
         "    public init(gatewayHost: String = \"" gatewayHost "\", gatewayPort: Int = " gatewayPort ") {\n"
         "        self.gatewayStreamUrl = URL(string: \"http://\\(gatewayHost):\\(gatewayPort)/api/asl/voice/stream\")!\n"
         "        super.init()\n"
         "    }\n\n"
         "    public func start() throws {\n"
         "        guard status == .idle else { return }\n\n"
         "        let engine = AVAudioEngine()\n"
         "        let input = engine.inputNode\n\n"
         "        // Enable macOS Hardware Acoustic Echo Cancellation via AUVoiceProcessingIO\n"
         "        do {\n"
         "            try input.setVoiceProcessingEnabled(true)\n"
         "        } catch {\n"
         "            print(\"[AudioIngress] Warning: setVoiceProcessingEnabled failed: \\(error)\")\n"
         "        }\n\n"
         "        let inputFormat = input.inputFormat(forBus: 0)\n"
         "        let processingFormat = AVAudioFormat(\n"
         "            commonFormat: .pcmFormatInt16,\n"
         "            sampleRate: targetSampleRate,\n"
         "            channels: targetChannels,\n"
         "            interleaved: true\n"
         "        )!\n\n"
         "        guard let converter = AVAudioConverter(from: inputFormat, to: processingFormat) else {\n"
         "            throw NSError(domain: \"asl.audio\", code: 1, userInfo: [NSLocalizedDescriptionKey: \"Failed to create audio converter for 16kHz PCM\"])\n"
         "        }\n\n"
         "        input.installTap(onBus: 0, bufferSize: 1024, format: inputFormat) { [weak self] (buffer, time) in\n"
         "            guard let self = self else { return }\n"
         "            self.processInputBuffer(buffer, converter: converter, targetFormat: processingFormat)\n"
         "        }\n\n"
         "        try engine.start()\n"
         "        self.audioEngine = engine\n"
         "        self.inputNode = input\n"
         "        self.status = .listening\n"
         "    }\n\n"
         "    public func stop() {\n"
         "        guard status != .idle else { return }\n"
         "        inputNode?.removeTap(onBus: 0)\n"
         "        audioEngine?.stop()\n"
         "        audioEngine = nil\n"
         "        inputNode = nil\n"
         "        status = .idle\n"
         "        currentDbfs = -120.0\n"
         "    }\n\n"
         "    public func setPushToTalkActive(_ active: Bool) {\n"
         "        guard mode == .pushToTalk else { return }\n"
         "        if active {\n"
         "            status = .transmitting\n"
         "            duckAudio(true)\n"
         "        } else {\n"
         "            status = .listening\n"
         "            duckAudio(false)\n"
         "        }\n"
         "    }\n\n"
         "    public func duckAudio(_ duck: Bool) {\n"
         "        isDucked = duck\n"
         "        // Hardware AEC ducking: -12dB when active speech or barge-in detected\n"
         "    }\n\n"
         "    private func processInputBuffer(_ buffer: AVAudioPCMBuffer, converter: AVAudioConverter, targetFormat: AVAudioFormat) {\n"
         "        guard let channelData = buffer.floatChannelData?[0] else { return }\n"
         "        let frameLength = Int(buffer.frameLength)\n"
         "        guard frameLength > 0 else { return }\n\n"
         "        var sumSquare: Float = 0.0\n"
         "        for i in 0..<frameLength {\n"
         "            let sample = channelData[i]\n"
         "            sumSquare += sample * sample\n"
         "        }\n"
         "        let rms = sqrt(sumSquare / Float(frameLength))\n"
         "        let dbfs = rms > 0.000001 ? 20.0 * log10(rms) : -120.0\n\n"
         "        Task { @MainActor in\n"
         "            self.currentDbfs = dbfs\n"
         "            let shouldTransmit: Bool\n"
         "            switch self.mode {\n"
         "            case .pushToTalk:\n"
         "                shouldTransmit = (self.status == .transmitting)\n"
         "            case .alwaysListening:\n"
         "                shouldTransmit = (dbfs >= self.vadEnergyThresholdDbfs)\n"
         "                if shouldTransmit && !self.isDucked {\n"
         "                    self.duckAudio(true)\n"
         "                } else if !shouldTransmit && self.isDucked {\n"
         "                    self.duckAudio(false)\n"
         "                }\n"
         "            }\n\n"
         "            if shouldTransmit {\n"
         "                self.streamPcmBuffer(buffer, converter: converter, targetFormat: targetFormat)\n"
         "            }\n"
         "        }\n"
         "    }\n\n"
         "    private func streamPcmBuffer(_ buffer: AVAudioPCMBuffer, converter: AVAudioConverter, targetFormat: AVAudioFormat) {\n"
         "        let outputFrameCapacity = AVAudioFrameCount(Double(buffer.frameLength) * (targetSampleRate / buffer.format.sampleRate)) + 128\n"
         "        guard let outputBuffer = AVAudioPCMBuffer(pcmFormat: targetFormat, frameCapacity: outputFrameCapacity) else { return }\n\n"
         "        var error: NSError? = nil\n"
         "        var haveData = true\n"
         "        converter.convert(to: outputBuffer, error: &error) { inNumPackets, outStatus in\n"
         "            if haveData {\n"
         "                haveData = false\n"
         "                outStatus.pointee = .haveData\n"
         "                return buffer\n"
         "            } else {\n"
         "                outStatus.pointee = .noDataNow\n"
         "                return nil\n"
         "            }\n"
         "        }\n\n"
         "        if let error = error {\n"
         "            print(\"[AudioIngress] Conversion error: \\(error)\")\n"
         "            return\n"
         "        }\n\n"
         "        let audioData = Data(bytes: outputBuffer.int16ChannelData![0], count: Int(outputBuffer.frameLength) * 2)\n"
         "        guard audioData.count > 0 else { return }\n\n"
         "        var request = URLRequest(url: gatewayStreamUrl)\n"
         "        request.httpMethod = \"POST\"\n"
         "        request.setValue(\"application/octet-stream\", forHTTPHeaderField: \"Content-Type\")\n"
         "        request.httpBody = audioData\n\n"
         "        URLSession.shared.dataTask(with: request) { [weak self] _, _, _ in\n"
         "            Task { @MainActor in\n"
         "                self?.lastTransmittedBytes = audioData.count\n"
         "            }\n"
         "        }.resume()\n"
         "    }\n"
         "}\n"))
