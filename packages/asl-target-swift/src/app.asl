(module asl-target-swift/app :x [emitSwiftApp emitSwiftMacOsBundle] :i [(asl-target-swift/types :a t) (asl-target-swift/emitSwift :a sw)])

fn emitSwiftApp appName: Str rootViewName: Str -> Str
  (let [(cleanApp (t/swiftMangleIdent appName))
        (cleanView (t/swiftMangleIdent rootViewName))]
    (str "@main\n"
         "public struct " cleanApp "App: App {\n"
         "    public init() {}\n\n"
         "    public var body: some Scene {\n"
         "        WindowGroup {\n"
         "            " cleanView "()\n"
         "        }\n"
         "        .windowStyle(.hiddenTitleBar)\n"
         "        .defaultSize(width: 1024, height: 768)\n"
         "    }\n"
         "}\n"))

fn emitSwiftMacOsBundle appName: Str rootViewName: Str modelsCode: Str viewCode: Str -> Str
  (let [(hdr (t/emitSwiftHeader true))
        (appCode (emitSwiftApp appName rootViewName))]
    (str "//\n"
         "// Native macOS Desktop Application Bundle\n"
         "// Generated by AgentScript Swift Backend (asl-target-swift)\n"
         "// Target: macOS 14+ / Swift 6 / SwiftUI\n"
         "//\n\n"
         hdr
         modelsCode "\n\n"
         viewCode "\n\n"
         appCode))
