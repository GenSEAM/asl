(:doc :symbol "asl/packages/asl-intel/src/fixture.asl#kwInt" :text "integer value of a keyword, or err")
(:doc :symbol "asl/packages/asl-intel/src/fixture.asl#kwItems" :text "sequence value of a keyword, or err")
(:doc :symbol "asl/packages/asl-intel/src/main.asl#" :text "asl-intel command line: the subcommands, flags, output formats and exit codes of bin/asl-intel over the ported analyzers.")
