(module aslIntel/xrefTest :x [TestParseRefUriTask TestParseRefUriAdrAndC TestParseRefUriSymAndChunk TestParseRefUriFileAndFormat TestExtractDocstringRefs TestXrefGraphBidirectionalAndProvenance TestHealthIntegrityAndCycleDetection runTests] :i [(xref :a xr) (health :a h) (aslMem/xref :a mxr)])

fn TestParseRefUriTask -> Bool
  (let [(t1 (xr/parseRefUri "task:task-325-1")) (t2 (xr/parseRefUri "ref:task:task-325-1"))] (assert (= t1.kind "task") "Task URI kind must equal 'task'") (assert (= t1.id "task-325-1") "Task URI id must equal 'task-325-1'") (assert (= t1.line 0) "Task URI line must be 0") (assert (= t2.kind "task") "ref: prefixed task kind must equal 'task'") (assert (= t2.id "task-325-1") "ref: prefixed task id must equal 'task-325-1'") true)

fn TestParseRefUriAdrAndC -> Bool
  (let [(tAdr (xr/parseRefUri "adr:D0012")) (tD (xr/parseRefUri "d:D0012")) (tC (xr/parseRefUri "c:C0001"))] (assert (= tAdr.kind "adr") "ADR URI kind must equal 'adr'") (assert (= tAdr.id "D0012") "ADR URI id must equal 'D0012'") (assert (= tD.kind "adr") "d: shortcode URI kind must equal 'adr'") (assert (= tD.id "D0012") "d: shortcode URI id must equal 'D0012'") (assert (= tC.kind "c") "c: constraint URI kind must equal 'c'") (assert (= tC.id "C0001") "c: constraint URI id must equal 'C0001'") true)

fn TestParseRefUriSymAndChunk -> Bool
  (let [(tSym (xr/parseRefUri "sym:asl-harness/ModelOptions")) (tChunk (xr/parseRefUri "chunk:chk-001"))] (assert (= tSym.kind "sym") "Symbol URI kind must equal 'sym'") (assert (= tSym.id "asl-harness/ModelOptions") "Symbol URI id must match package/symbol") (assert (= tChunk.kind "chunk") "Chunk URI kind must equal 'chunk'") (assert (= tChunk.id "chk-001") "Chunk URI id must equal 'chk-001'") true)

fn TestParseRefUriFileAndFormat -> Bool
  (let [(tFile (xr/parseRefUri "file:intel/src/xref.asl:L42")) (fmtFile (xr/formatRefUri tFile)) (tTask (xr/parseRefUri "task:task-325-1")) (fmtTask (xr/formatRefUri tTask)) (tTaskCopy (xr/parseRefUri "task:task-325-1")) (tTaskOther (xr/parseRefUri "task:task-325-2"))] (assert (= tFile.kind "file") "File URI kind must equal 'file'") (assert (= tFile.id "intel/src/xref.asl") "File URI id must match file path") (assert (= tFile.line 42) "File URI line anchor must equal 42") (assert (= fmtFile "file:intel/src/xref.asl:L42") "Formatted file URI must preserve line anchor") (assert (= fmtTask "task:task-325-1") "Formatted task URI must match canonical string") (assert (xr/refTargetEq? tTask tTaskCopy) "Identical RefTarget records must compare equal") (assert (not (xr/refTargetEq? tTask tTaskOther)) "Distinct RefTarget records must not compare equal") true)

fn TestExtractDocstringRefs -> Bool
  (let [(doc "Formats model request payload. ref:task:task-325-1 ref:adr:D0012 ref:c:C0001") (refs (xr/extractDocstringRefs "sym:asl-harness/format-request" doc)) (r1 (preludeHead refs)) (r2 (preludeHead (preludeTail refs))) (r3 (preludeHead (preludeTail (preludeTail refs))))] (assert (= (listLength refs) 3) "Docstring must extract exactly 3 reference records") (assert (= r1.raw "ref:task:task-325-1") "First ref raw token must match ref:task:task-325-1") (assert (= r1.target.kind "task") "First ref target kind must equal 'task'") (assert (= r1.target.id "task-325-1") "First ref target id must equal 'task-325-1'") (assert (= r2.target.kind "adr") "Second ref target kind must equal 'adr'") (assert (= r2.target.id "D0012") "Second ref target id must equal 'D0012'") (assert (= r3.target.kind "c") "Third ref target kind must equal 'c'") (assert (= r3.target.id "C0001") "Third ref target id must equal 'C0001'") true)

fn TestXrefGraphBidirectionalAndProvenance -> Bool
  (let [(g0 (mxr/makeXrefGraph)) (g1 (mxr/xrefAddEdge g0 "task:task-325-2" "sym:asl-harness/ModelOptions" "depends-on")) (g2 (mxr/xrefAddEdge g1 "task:task-325-3" "sym:asl-harness/ModelOptions" "depends-on")) (g3 (mxr/xrefAddEdge g2 "file:harness/src/trace_recorder.asl" "sym:asl-harness/ModelOptions" "depends-on")) (g4 (mxr/xrefAddEdge g3 "task:task-325-3" "task:task-325-1" "prerequisite")) (g5 (mxr/xrefAddEdge g4 "task:task-325-3" "task:task-325-2" "prerequisite")) (g6 (mxr/xrefAddEdge g5 "sym:asl-harness/ModelOptions" "task:task-325-1" "provenance")) (g7 (mxr/xrefAddEdge g6 "sym:asl-harness/ModelOptions" "adr:D0012" "provenance")) (g8 (mxr/xrefAddEdge g7 "sym:asl-harness/ModelOptions" "c:C0001" "provenance")) (deps (mxr/findDependents g8 "sym:asl-harness/ModelOptions")) (prereqs (mxr/findPrerequisites g8 "task:task-325-3")) (prov (mxr/findProvenance g8 "sym:asl-harness/ModelOptions"))] (assert (= (listLength deps) 3) "ModelOptions must have exactly 3 downstream dependents") (assert (listContains? deps "task:task-325-2") "Dependents must include task:task-325-2") (assert (listContains? deps "task:task-325-3") "Dependents must include task:task-325-3") (assert (listContains? deps "file:harness/src/trace_recorder.asl") "Dependents must include trace recorder") (assert (= (listLength prereqs) 2) "task-325-3 must have exactly 2 prerequisites") (assert (listContains? prereqs "task:task-325-1") "Prerequisites must include task:task-325-1") (assert (listContains? prereqs "task:task-325-2") "Prerequisites must include task:task-325-2") (assert (= (listLength prov) 3) "ModelOptions must have exactly 3 provenance records") (assert (listContains? prov "task:task-325-1") "Provenance must include task:task-325-1") (assert (listContains? prov "adr:D0012") "Provenance must include adr:D0012") (assert (listContains? prov "c:C0001") "Provenance must include c:C0001") true)

fn TestHealthIntegrityAndCycleDetection -> Bool
  (let [(docBroken "ref:task:task-ghost-999") (refsBroken (xr/extractDocstringRefs "sym:test-func" docBroken)) (validTargets (list "task:task-325-1" "task:task-325-2" "adr:D0012")) (brokenAnoms (h/detectBrokenReferences refsBroken validTargets)) (ptrs (list "chk-valid-01" "chk-dangling-99")) (validBufs (list "chk-valid-01")) (ptrAnoms (h/detectDanglingPointers ptrs validBufs)) (edgesCyclic (list (h/RefEdge :source "task:task-A" :target "task:task-B") (h/RefEdge :source "task:task-B" :target "task:task-A"))) (cycleAnoms (h/detectCyclicReferences edgesCyclic)) (docClean "ref:task:task-325-1") (refsClean (xr/extractDocstringRefs "sym:clean-func" docClean)) (cleanAnoms (h/auditReferenceIntegrity refsClean validTargets))] (assert (= (listLength brokenAnoms) 1) "Broken reference must produce exactly 1 anomaly") (assert (= (preludeHead brokenAnoms).severity "error") "Broken reference severity must be error") (assert (= (preludeHead brokenAnoms).symbol "task:task-ghost-999") "Broken anomaly symbol must match target") (assert (= (listLength ptrAnoms) 1) "Dangling pointer must produce exactly 1 anomaly") (assert (= (preludeHead ptrAnoms).symbol "chk-dangling-99") "Dangling pointer symbol must match target") (assert (> (listLength cycleAnoms) 0) "Cyclic cross-references must produce cycle anomaly") (assert (= (preludeHead cycleAnoms).severity "blocker") "Cyclic dependency must be blocker severity") (assert (= (listLength cleanAnoms) 0) "Clean reference audit must produce zero anomalies") true)

fn runTests -> Bool
  (let [(t1 (TestParseRefUriTask)) (t2 (TestParseRefUriAdrAndC)) (t3 (TestParseRefUriSymAndChunk)) (t4 (TestParseRefUriFileAndFormat)) (t5 (TestExtractDocstringRefs)) (t6 (TestXrefGraphBidirectionalAndProvenance)) (t7 (TestHealthIntegrityAndCycleDetection))] (and t1 (and t2 (and t3 (and t4 (and t5 (and t6 t7)))))))
