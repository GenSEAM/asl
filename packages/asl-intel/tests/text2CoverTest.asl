(module asl-intel/tests/text2CoverTest
  :x [runTests]
  :i [(asl-intel/text :a text)])

fn runTests -> Bool
  (let [(r (text/absPath "/foo" "/work/dir"))]
    (assert (= r "/foo") "absPath: absolute unchanged")
    (assert (= (text/absPath "bar" "/work/dir") "/work/dir/bar") "absPath: relative joined")
    (assert (= (text/absPath "" "/work/dir") "/work/dir") "absPath: empty path")
    (assert (= (text/absPath "." "/work/dir") "/work/dir") "absPath: dot")
    (assert (= (text/absPath ".." "/work/dir") "/work") "absPath: dotdot")
    (assert (= (text/absPath "a/../b" "/work/dir") "/work/dir/b") "absPath: normalizes ..")
    (assert (= (text/absPath "//server/share" "/work/dir") "//server/share") "absPath: UNC preserved")
    (assert (= (text/absPath "///a" "/work/dir") "/a") "absPath: triple slash collapses")

    (assert (= (text/bytesIndexOf (stringToBytes "hello") 5 (stringToBytes "ll") 2 0) 2) "bytesIndexOf: found")
    (assert (= (text/bytesIndexOf (stringToBytes "hello") 5 (stringToBytes "xx") 2 0) -1) "bytesIndexOf: not found")
    (assert (= (text/bytesIndexOf (stringToBytes "hello") 5 (stringToBytes "") 0 0) 0) "bytesIndexOf: empty needle at 0")
    (assert (= (text/bytesIndexOf (stringToBytes "hello") 5 (stringToBytes "") 0 2) 2) "bytesIndexOf: empty needle at 2")
    (assert (= (text/bytesIndexOf (stringToBytes "") 0 (stringToBytes "a") 1 0) -1) "bytesIndexOf: empty haystack")
    (assert (= (text/bytesIndexOf (stringToBytes "a") 1 (stringToBytes "aa") 2 0) -1) "bytesIndexOf: needle longer")
    (assert (= (text/bytesIndexOf (stringToBytes "aaaa") 4 (stringToBytes "aa") 2 0) 0) "bytesIndexOf: overlapping first")
    (assert (= (text/bytesIndexOf (stringToBytes "aaaa") 4 (stringToBytes "aa") 2 1) 1) "bytesIndexOf: overlapping second")

    (assert (= (text/containsAt? (stringToBytes "hello") 5 2 (stringToBytes "ll") 2 0) true) "containsAt?: match")
    (assert (= (text/containsAt? (stringToBytes "hello") 5 2 (stringToBytes "xx") 2 0) false) "containsAt?: mismatch")
    (assert (= (text/containsAt? (stringToBytes "hello") 5 4 (stringToBytes "o") 1 0) true) "containsAt?: at end")
    (assert (= (text/containsAt? (stringToBytes "hello") 5 5 (stringToBytes "") 0 0) true) "containsAt?: empty needle")
    (assert (= (text/containsAt? (stringToBytes "hello") 5 5 (stringToBytes "x") 1 0) false) "containsAt?: past end")
    (assert (= (text/containsAt? (stringToBytes "") 0 0 (stringToBytes "") 0 0) true) "containsAt?: both empty")

    (assert (= (text/hasSub? "hello" "ell") true) "hasSub?: found")
    (assert (= (text/hasSub? "hello" "xyz") false) "hasSub?: not found")
    (assert (= (text/hasSub? "hello" "") true) "hasSub?: empty needle")
    (assert (= (text/hasSub? "" "a") false) "hasSub?: empty haystack")
    (assert (= (text/hasSub? "" "") true) "hasSub?: both empty")
    (assert (= (text/hasSub? "a" "aa") false) "hasSub?: needle longer")

    (assert (= (text/countSub "hello" "l") 2) "countSub: two occurrences")
    (assert (= (text/countSub "hello" "ll") 1) "countSub: overlapping not counted")
    (assert (= (text/countSub "aaaa" "aa") 2) "countSub: non-overlapping")
    (assert (= (text/countSub "hello" "") 6) "countSub: empty needle = cpLength+1")
    (assert (= (text/countSub "" "a") 0) "countSub: empty haystack")
    (assert (= (text/countSub "" "") 1) "countSub: both empty")
    (assert (= (text/countSub "a" "aa") 0) "countSub: needle longer")

    (assert (= (listLength (text/takeN (list 1 2 3 4 5) 3)) 3) "takeN: normal length")
    (assert (= (listLength (text/takeN (list 1 2 3) 5)) 3) "takeN: k > length")
    (assert (= (listLength (text/takeN (list 1 2 3) 0)) 0) "takeN: zero")
    (assert (= (listLength (text/takeN (list 1 2 3) -1)) 0) "takeN: negative")
    (assert (= (listLength (text/takeN (list) 3)) 0) "takeN: empty list")

    (assert (= (text/foldIndexOf (stringToBytes "Hello") 5 (stringToBytes "hello") 5 0) 0) "foldIndexOf: case-insensitive match")
    (assert (= (text/foldIndexOf (stringToBytes "HELLO") 5 (stringToBytes "hello") 5 0) 0) "foldIndexOf: upper haystack")
    (assert (= (text/foldIndexOf (stringToBytes "Hello") 5 (stringToBytes "world") 5 0) -1) "foldIndexOf: no match")
    (assert (= (text/foldIndexOf (stringToBytes "Hello") 5 (stringToBytes "") 0 0) 0) "foldIndexOf: empty needle")
    (assert (= (text/foldIndexOf (stringToBytes "") 0 (stringToBytes "a") 1 0) -1) "foldIndexOf: empty haystack")
    (assert (= (text/foldIndexOf (stringToBytes "a") 1 (stringToBytes "A") 1 0) 0) "foldIndexOf: single char")
    (assert (= (text/foldIndexOf (stringToBytes "ß") 2 (stringToBytes "SS") 2 0) -1) "foldIndexOf: non-ascii no fold")

    (assert (= (text/wordHits (stringToBytes "hello world hello") 17 (stringToBytes "hello") 5 0 10 0) 2) "wordHits: two whole words")
    (assert (= (text/wordHits (stringToBytes "hellohello") 10 (stringToBytes "hello") 5 0 10 0) 0) "wordHits: not whole word")
    (assert (= (text/wordHits (stringToBytes "hello world") 11 (stringToBytes "world") 5 0 10 0) 1) "wordHits: at end")
    (assert (= (text/wordHits (stringToBytes "world hello") 11 (stringToBytes "world") 5 0 10 0) 1) "wordHits: at start")
    (assert (= (text/wordHits (stringToBytes "") 0 (stringToBytes "hello") 5 0 10 0) 0) "wordHits: empty haystack")
    (assert (= (text/wordHits (stringToBytes "hello") 5 (stringToBytes "") 0 0 10 0) 2) "wordHits: empty needle")
    (assert (= (text/wordHits (stringToBytes "hello world hello") 17 (stringToBytes "hello") 5 0 1 0) 1) "wordHits: limit 1")
    (assert (= (text/wordHits (stringToBytes "hello_world") 11 (stringToBytes "hello") 5 0 10 0) 0) "wordHits: underscore boundary")

    (assert (= (text/wordHas? "hello world" "hello") true) "wordHas?: found")
    (assert (= (text/wordHas? "hello world" "world") true) "wordHas?: found at end")
    (assert (= (text/wordHas? "hello world" "xyz") false) "wordHas?: not found")
    (assert (= (text/wordHas? "hello" "hello") true) "wordHas?: exact")
    (assert (= (text/wordHas? "" "hello") false) "wordHas?: empty haystack")
    (assert (= (text/wordHas? "hello" "") true) "wordHas?: empty needle")
    (assert (= (text/wordHas? "hello_world" "hello") false) "wordHas?: underscore boundary")

    (assert (= (text/skipSpace (stringToBytes "  hello") 7 0) 2) "skipSpace: leading spaces")
    (assert (= (text/skipSpace (stringToBytes "hello") 5 0) 0) "skipSpace: no leading")
    (assert (= (text/skipSpace (stringToBytes "") 0 0) 0) "skipSpace: empty")
    (assert (= (text/skipSpace (stringToBytes "   ") 3 0) 3) "skipSpace: all spaces")
    (assert (= (text/skipSpace (stringToBytes "\t\n hello") 8 0) 3) "skipSpace: tabs newlines")
    (assert (= (text/skipSpace (stringToBytes "  hello") 7 2) 2) "skipSpace: start at non-space")

    (assert (= (text/trimSpaceBack (stringToBytes "hello  ") 6 0 6) 5) "trimSpaceBack: trailing spaces")
    (assert (= (text/trimSpaceBack (stringToBytes "hello") 5 0 5) 5) "trimSpaceBack: no trailing")
    (assert (= (text/trimSpaceBack (stringToBytes "") 0 0 0) 0) "trimSpaceBack: empty")
    (assert (= (text/trimSpaceBack (stringToBytes "   ") 3 0 3) 0) "trimSpaceBack: all spaces")
    (assert (= (text/trimSpaceBack (stringToBytes "hello \t\n") 8 0 8) 5) "trimSpaceBack: tabs newlines")
    (assert (= (text/trimSpaceBack (stringToBytes "  hello  ") 8 2 8) 7) "trimSpaceBack: with leading offset")

    (assert (= (text/cpOffset (stringToBytes "hello") 5 0 2) 2) "cpOffset: ascii forward")
    (assert (= (text/cpOffset (stringToBytes "hello") 5 0 10) 5) "cpOffset: beyond end clamps")
    (assert (= (text/cpOffset (stringToBytes "hello") 5 0 0) 0) "cpOffset: zero")
    (assert (= (text/cpOffset (stringToBytes "hello") 5 0 -1) 0) "cpOffset: negative clamps")
    (assert (= (text/cpOffset (stringToBytes "héllo") 6 0 2) 3) "cpOffset: multi-byte char")
    (assert (= (text/cpOffset (stringToBytes "héllo") 6 0 10) 6) "cpOffset: multi-byte beyond")
    (assert (= (text/cpOffset (stringToBytes "") 0 0 5) 0) "cpOffset: empty")
    (assert (= (text/cpOffset (stringToBytes "hello") 5 3 2) 5) "cpOffset: start near end")

    true)
