(module asl-intel/tests/preloadAcceptanceTest :x [runTests] :i [(asl-text/string :a s) (aslIntel/preload :a pr) (aslIntel/symbolGraph :a g)])

fn testIntelSourceAndSyntaxIntegrity! -> Bool
  (let [(resPre (fileReadString "asl/packages/asl-intel/src/preload.asl")) (codePre (resultOr resPre "")) (resHot (fileReadString "asl/packages/asl-intel/tests/hotspotCoverageTest.asl")) (codeHot (resultOr resHot ""))] (assert (ok? resPre) "preload.asl must exist and be readable") (refute (err? resPre) "preload.asl refutes read failure") (assert (stringContains? codePre "fn stubCreate") "preload.asl affirms modern fn stubCreate") (assert (stringContains? codePre "fn intelPreload") "preload.asl affirms modern fn intelPreload") (assert (stringContains? codePre "fn findTargetNode") "preload.asl affirms modern fn findTargetNode") (refute (stringContains? codePre "(df ") "preload.asl refutes legacy df definitions") (refute (stringContains? codePre "(defun ") "preload.asl refutes legacy defun") (assert (ok? resHot) "hotspotCoverageTest.asl must exist and be readable") (refute (err? resHot) "hotspotCoverageTest.asl refutes read failure") (refute (stringContains? codeHot "asl-checker/core/test") "hotspotCoverageTest refutes unresolvable asl-checker/core/test") (assert (stringContains? codeHot "runTests") "hotspotCoverageTest affirms runTests export") true)

fn testPreloadHydrationAndKebabLookup! -> Bool
  (let [(hKebab (pr/intelPreload! "stub-create" 1 10000)) (lenKebab (listLength hKebab.stubs)) (hCamel (pr/intelPreload! "stubCreate" 1 10000)) (lenCamel (listLength hCamel.stubs)) (hPreload (pr/intelPreload! "intelPreload" 1 10000)) (lenPreload (listLength hPreload.stubs)) (hPreloadKebab (pr/intelPreload! "intel-preload" 1 10000)) (lenPreloadKebab (listLength hPreloadKebab.stubs))] (assert (> lenKebab 0) "preload must return stubs for stub-create (kebab-case)") (refute (= lenKebab 0) "preload refutes 0 stubs for stub-create") (assert (not hKebab.truncated) "hKebab must not be truncated under 10000 tokens") (refute hKebab.truncated "hKebab refutes truncated flag") (assert (> lenCamel 0) "preload must return stubs for stubCreate (CamelCase)") (refute (= lenCamel 0) "preload refutes 0 stubs for stubCreate") (assert (> lenPreload 0) "preload must return stubs for intelPreload") (refute (= lenPreload 0) "preload refutes 0 stubs for intelPreload") (assert (> lenPreloadKebab 0) "preload must return stubs for intel-preload") (refute (= lenPreloadKebab 0) "preload refutes 0 stubs for intel-preload") (assert (> hKebab.totalTokens 0) "hKebab totalTokens must exceed 0") (assert (> hCamel.totalTokens 0) "hCamel totalTokens must exceed 0") true)

fn testPreloadMissingAndBoundaryScoping! -> Bool
  (let [(hMissing (pr/intelPreload! "nonexistent-phantom-symbol-xyz" 1 10000)) (hEmpty (pr/intelPreload! "" 1 10000)) (hDepth0 (pr/intelPreload! "stub-create" 0 10000))] (assert (= (listLength hMissing.stubs) 0) "Missing target stubs must be 0") (refute (!= (listLength hMissing.stubs) 0) "Missing target refutes non-zero stubs") (refute hMissing.truncated "Missing target refutes truncation") (assert (= (listLength hEmpty.stubs) 0) "Empty target stubs must be 0") (refute (!= (listLength hEmpty.stubs) 0) "Empty target refutes non-zero stubs") (assert (= (listLength hDepth0.stubs) 1) "Depth 0 returns exactly 1 stub") (refute (= (listLength hDepth0.stubs) 0) "Depth 0 refutes 0 stubs") (refute (> (listLength hDepth0.stubs) 1) "Depth 0 refutes > 1 stubs") (assert (> hDepth0.totalTokens 0) "Depth 0 totalTokens must exceed 0") true)

fn testPreloadContextFormatting! -> Bool
  (let [(h (pr/intelPreload! "stub-create" 1 10000)) (ctx (pr/formatPreloadContext h))] (assert (stringContains? ctx ":horizon") "Context contains :horizon header") (refute (stringEmpty? ctx) "Context refutes empty string") (assert (stringContains? ctx ":tokens") "Context contains :tokens field") (assert (stringContains? ctx ":stub") "Context contains :stub record") (assert (stringContains? ctx ":budget 10000") "Context contains budget 10000") (assert (stringContains? ctx "stubCreate") "Context contains stubCreate identifier") (refute (stringContains? ctx ":truncated true") "Context refutes unexpected truncation") true)

fn ! runTests -> Bool
  (and (testIntelSourceAndSyntaxIntegrity!) (and (testPreloadHydrationAndKebabLookup!) (and (testPreloadMissingAndBoundaryScoping!) (testPreloadContextFormatting!))))
