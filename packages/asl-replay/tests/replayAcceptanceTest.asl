(module asl-replay/tests/replayAcceptanceTest :x [RunTests runTests] :i [(asl-replay/record :a record) (asl-replay/replay :a replay)])

fn testAgentEventStreamRecordingAndNormalization -> Bool
  (let [(e1 (record/recordAgentEvent 1 "input" "User prompt: refactor parser" "digest-001")) (e2 (record/recordAgentEvent 2 "toolCall" "(:query :pattern \"parser\")" "digest-002")) (e3 (record/recordAgentEvent 3 "toolResult" "(:match :file \"parser.asl\")" "digest-003")) (events (list e1 e2 e3)) (session (record/createReplaySession "sess-01" events "digest-init")) (norm1 (record/normalizeVolatileFields e1)) (d1 (record/calculateEventDigest e1))] (assert (= e1.step 1) "Event 1 step index is 1") (assert (= e1.kind "input") "Event 1 kind matches input") (assert (= e1.payload "User prompt: refactor parser") "Event 1 payload matches input string") (assert (= session.sessionId "sess-01") "Session identifier matches sess-01") (assert (= (listLength session.events) 3) "Session contains exactly 3 events") (assert (> (stringLength norm1) 0) "Normalized representation is non-empty") (assert (> (stringLength d1) 0) "Calculated event digest is non-empty") (refute (= e1.step 2) "Refutation: Event 1 step must not be 2") (refute (= e2.kind "input") "Refutation: Event 2 kind must not be input") (refute (= (listLength session.events) 0) "Refutation: Session events must not be empty") (refute (= d1 "") "Refutation: Digest calculation must not return empty string") true)

fn testDeterministicReplayAndDivergenceDetection -> Bool
  (let [(e1 (record/recordAgentEvent 1 "input" "step1" "hash-1")) (e2 (record/recordAgentEvent 2 "toolCall" "step2" "hash-2")) (events (list e1 e2)) (session (record/createReplaySession "sess-02" events "hash-init")) (statesClean (list "hash-1" "hash-2")) (statesDiverged (list "hash-1" "hash-corrupted")) (resMatch (replay/detectDivergence session statesClean)) (resMismatch (replay/detectDivergence session statesDiverged)) (reportClean (replay/getDivergenceReport resMatch)) (reportMismatch (replay/getDivergenceReport resMismatch))] (assert (ok? resMatch) "Replay matches clean state sequence cleanly") (assert (err? resMismatch) "Replay detects diverged state hash") (assert (not reportClean.diverged) "Clean report indicates zero divergence") (assert reportMismatch.diverged "Mismatch report flags divergence") (assert (= reportMismatch.step 2) "Divergence is pinpointed at exact step 2") (assert (= reportMismatch.expectedDigest "hash-2") "Report records expected hash") (assert (= reportMismatch.actualDigest "hash-corrupted") "Report records actual diverged hash") (refute (err? resMatch) "Refutation: Clean sequence must not return error") (refute (ok? resMismatch) "Refutation: Diverged sequence must not succeed") (refute reportClean.diverged "Refutation: Clean sequence must not be flagged diverged") (refute (= reportMismatch.step 1) "Refutation: Divergence must not point to step 1") true)

fn testReplayIntegrityAndTamperDefense -> Bool
  (let [(hashA "state-hash-a") (hashB "state-hash-b") (matchSame (replay/verifyStateDigest hashA hashA)) (matchDiff (replay/verifyStateDigest hashA hashB)) (e1 (record/recordAgentEvent 1 "toolCall" "call" hashA)) (tamperedEvent (record/recordAgentEvent 1 "toolCall" "tampered-call" hashA)) (d1 (record/calculateEventDigest e1)) (dTampered (record/calculateEventDigest tamperedEvent)) (hashesDiffer (not (= d1 dTampered)))] (assert matchSame "Matching digests verify successfully") (assert (not matchDiff) "Mismatched digests fail verification") (assert hashesDiffer "Payload tampering produces distinct event digest") (refute (not matchSame) "Refutation: Identical state digests must verify true") (refute matchDiff "Refutation: Different state digests must verify false") (refute (not hashesDiffer) "Refutation: Altered payload must alter event digest") true)

fn testProductionMutantFaultDetection -> Bool
  (let [(resBypass (replay/verifyStateDigest "expected" "diverged")) (e (record/recordAgentEvent 99 "input" "test" "digest")) (session (record/createReplaySession "sess-mut" (list e) "init")) (divRes (replay/detectDivergence session (list "tampered"))) (rep (replay/getDivergenceReport divRes))] (assert (not resBypass) "Fault detection: Digest mismatch cannot bypass check") (assert (= rep.step 99) "Fault detection: Divergence preserves step index 99") (assert (= rep.reason "ERR_REPLAY_DESYNC") "Fault detection: Divergence reports canonical ERR_REPLAY_DESYNC") (refute resBypass "Refutation: State digest bypass mutation must fail") (refute (= rep.step 0) "Refutation: Step index must not be reset to 0") (refute (not rep.diverged) "Refutation: Diverged state must not be flagged as non-diverged") (refute (= rep.reason "SUCCESS") "Refutation: Error report must not claim SUCCESS") true)

fn runTests -> Bool
  (let [(okRec (testAgentEventStreamRecordingAndNormalization)) (okRep (testDeterministicReplayAndDivergenceDetection)) (okTamp (testReplayIntegrityAndTamperDefense)) (okMut (testProductionMutantFaultDetection))] (and (and (and okRec okRep) okTamp) okMut))

fn RunTests -> Bool
  (runTests)
