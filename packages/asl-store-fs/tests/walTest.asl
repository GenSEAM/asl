(module asl-store-fs/tests/walTest :x [runTests] :i [(asl-store-fs/wal :a w)])

fn ! runTests -> Bool
  (let [(entry (w/makeWalEntry 1 100 (w/opPutVector) "k" "p"))
        (frame (w/formatWalFrame entry))
        (logEntry (w/makeWalEntry 7 55 (w/opLogAppend) "stream" "line1\nline \"two\""))
        (logFrame (w/formatWalFrame logEntry))
        (nested "{\"user\": \"alice\", \"quote\": \"he said \\\"hello\\\"\"}")
        (nestedFrame (w/formatWalFrame (w/makeWalEntry 1 1726500000 (w/opPutNode) "entity-101" nested)))
        (parsed (w/parseWalFrame frame))
        (parsedLog (w/parseWalFrame logFrame))
        (parsedNested (w/parseWalFrame nestedFrame))
        (corrupt (w/parseWalFrame (stringReplace frame ":crc " ":crc 9999999")))
        (badOp (w/parseWalFrame (stringReplace (w/formatWalFrame (w/makeWalEntry 1 1000 (w/opPutNode) "k" "payload")) ":op \"n+\"" ":op \"unknown_op\"")))
        (f1 (w/formatWalFrame (w/makeWalEntry 1 1000 (w/opPutNode) "k1" "p1")))
        (f2 (w/formatWalFrame (w/makeWalEntry 2 1001 (w/opPutNode) "k2" "p2")))
        (f4 (w/formatWalFrame (w/makeWalEntry 4 1003 (w/opPutNode) "k4" "p4")))
        (ok4 (w/parseWalStreamStrict (str f1 "\n" f2) 1))
        (gap (w/parseWalStreamStrict (str f1 "\n" f2 "\n" f4) 1))
        (bad (w/parseWalStreamStrict (str f1 "\n" "invalid-corrupted-wal-frame\n") 1))]
    (do (assert (stringContains? frame "(WalEntry") "frame has tag")
        (assert (stringContains? frame ":seq 1") "frame has seq")
        (assert (match parsed ((some p) (and (= p.seqNum 1) (and (= p.timestampEpoch 100) (and (= p.key "k") (= p.payload "p"))))) ((none) false)) "a formatted frame parses back field for field")
        (assert (not (stringContains? logFrame "\n")) "a frame is a single line even when the payload holds newlines")
        (assert (match parsedLog ((some p) (and (= p.payload "line1\nline \"two\"") (= (w/opTypeToString p.opType) "a+"))) ((none) false)) "the log append op and a payload with newline and quotes round trip")
        (assert (match parsedNested ((some p) (= p.payload nested)) ((none) false)) "nested quotes round trip bit for bit")
        (assert (none? corrupt) "a tampered checksum is refused")
        (assert (none? badOp) "an unknown op code is refused")
        (assert (match ok4 ((w/walSuccess es) (= (listLength es) 2)) (_ false)) "a sequential stream parses")
        (assert (match gap ((w/walGap exp act) (and (= exp 3) (= act 4))) (_ false)) "a missing sequence is a gap naming both numbers")
        (assert (w/isWalCorrupt? bad) "a malformed line is corrupt")
        true))
