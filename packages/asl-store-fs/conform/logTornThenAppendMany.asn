(:script :id logTornThenAppendMany :checks 9)
(:step (:append s "a" 1) (:appended 0))
(:fault tearLogTail s)
(:step (:append s "b" 2) (:appended 1))
(:step (:append s "c" 3) (:appended 2))
(:fault tearLogTail s)
(:step (:append s "d" 4) (:appended 3))
(:step (:read s 0 10) (:records ((0 "a" 1) (1 "b" 2) (2 "c" 3) (3 "d" 4)) 4))
(:step (:read s 2 1) (:records ((2 "c" 3)) 3))
(:step (:commit s k 4) (:committed 4))
