(module asl/packages/asl-slm/tests/maskerTest :x [RunTests runTests] :i [(asl-slm/masker :a msk)])

fn sampleSexprGrammar -> Str
  (str "root ::= '(' expr* ')' ;\n" "expr ::= symbol | number | string | root ;\n" "symbol ::= [a-zA-Z_][a-zA-Z0-9_-]* ;\n" "number ::= [0-9]+ ;\n" "string ::= '\"' [^\"]* '\"' ;")

fn sampleArithmeticGrammar -> Str
  (str "root ::= expr ;\n" "expr ::= term (('+' | '-') term)* ;\n" "term ::= factor (('*' | '/') factor)* ;\n" "factor ::= number | '(' expr ')' ;\n" "number ::= [0-9]+ ;")

fn makeExpandedVocab -> (List (Pair Int Str))
  (list (pair 0 "<eos>") (pair 1 "(") (pair 2 ")") (pair 3 "defun") (pair 4 "foo") (pair 5 "42") (pair 6 "\"hello\"") (pair 7 "bad!@#") (pair 8 ";") (pair 9 "++") (pair 10 "123foo"))

fn testGrammarCompilationToPda -> Bool
  (let [(g1 (sampleSexprGrammar)) (pda1 (msk/compileGrammarToDfa g1)) (g2 (sampleArithmeticGrammar)) (pda2 (msk/compileGrammarToDfa g2)) (badEmpty "") (pdaEmpty (msk/compileGrammarToDfa badEmpty)) (badNoArrow "root expr ;\nexpr ::= number ;") (pdaNoArrow (msk/compileGrammarToDfa badNoArrow)) (badEmptyRhs "root ::= ;\nexpr ::= number ;") (pdaEmptyRhs (msk/compileGrammarToDfa badEmptyRhs))] (assert (= pda1.status "ok") "PDA compilation must succeed for valid S-expression EBNF grammar") (assert (> pda1.stateCount 0) "PDA1 must contain non-zero state count") (assert (= pda1.startState 0) "PDA1 start state must be 0") (assert (> pda1.acceptState 0) "PDA1 accept state must be greater than 0") (assert pda1.rootRequiresDelimiter "S-expression grammar root must require opening delimiter") (assert (listAny? (fn [(r Str)] (= r "root")) pda1.ruleNames) "PDA1 ruleNames must contain root") (assert (listAny? (fn [(r Str)] (= r "symbol")) pda1.ruleNames) "PDA1 ruleNames must contain symbol") (assert (listAny? (fn [(d Str)] (= d "(")) pda1.delimiters) "PDA1 delimiters must contain '('") (assert (listAny? (fn [(t Str)] (= t "number")) pda1.terminals) "PDA1 terminals must contain number") (assert (= pda2.status "ok") "PDA compilation must succeed for valid arithmetic grammar") (assert (> pda2.stateCount 0) "PDA2 must contain non-zero state count") (assert (not pda2.rootRequiresDelimiter) "Arithmetic grammar root must allow top-level atom without delimiter") (assert (listAny? (fn [(t Str)] (= t "+")) pda2.terminals) "PDA2 terminals must contain '+'") (assert (listAny? (fn [(t Str)] (= t "*")) pda2.terminals) "PDA2 terminals must contain '*'") (assert (= pdaEmpty.status "error") "Empty grammar must fail cleanly") (assert (= pdaEmpty.diagnosticCode "ERR_GRAMMAR_EMPTY") "Empty grammar must return ERR_GRAMMAR_EMPTY") (assert (= pdaNoArrow.status "error") "Grammar with missing '::=' arrow must fail cleanly") (assert (= pdaNoArrow.diagnosticCode "ERR_GRAMMAR_MALFORMED_RULE") "Missing arrow must return ERR_GRAMMAR_MALFORMED_RULE") (assert (= pdaEmptyRhs.status "error") "Grammar with empty production RHS must fail cleanly") (assert (= pdaEmptyRhs.diagnosticCode "ERR_GRAMMAR_PARSE_FAILURE") "Empty RHS must return ERR_GRAMMAR_PARSE_FAILURE") (refute (= pda1.stateCount 0) "Refutation: Valid S-expression grammar cannot produce empty state machine") (refute (= pda2.stateCount 0) "Refutation: Valid arithmetic grammar cannot produce empty state machine") (refute (= pdaEmpty.status "ok") "Refutation: Empty grammar cannot return ok status") (refute (= pdaNoArrow.status "ok") "Refutation: Malformed grammar cannot return ok status") (refute (= pdaEmptyRhs.status "ok") "Refutation: Empty RHS grammar cannot return ok status") (refute (= pda1.startState -1) "Refutation: Start state must not be uninitialized") (refute (= pda1.acceptState pda1.startState) "Refutation: Start state cannot equal accept state before input") (refute pda2.rootRequiresDelimiter "Refutation: Arithmetic grammar root must not require delimiter") true)

fn testMaskerStateTransitionsAndDelimiterStack -> Bool
  (let [(pda1 (msk/compileGrammarToDfa (sampleSexprGrammar))) (eosId 0) (st0 (msk/maskerInit pda1 eosId)) (st1 (msk/advanceMaskerState pda1 st0 "(")) (st2 (msk/advanceMaskerState pda1 st1 "defun")) (st3 (msk/advanceMaskerState pda1 st2 "foo")) (st4 (msk/advanceMaskerState pda1 st3 ")")) (pda2 (msk/compileGrammarToDfa (sampleArithmeticGrammar))) (stArith0 (msk/maskerInit pda2 eosId)) (stArith1 (msk/advanceMaskerState pda2 stArith0 "42"))] (assert (= st0.stackDepth 0) "Initial delimiter stack depth must be 0") (assert (not st0.isEosAllowed) "EOS must be prohibited at initial state before opening form") (assert (= st1.stackDepth 1) "Opening paren must increase delimiter stack depth to 1") (assert (not st1.isEosAllowed) "EOS must be strictly prohibited inside unclosed delimiter stack") (assert (= st2.stackDepth 1) "Inside expression stack depth must remain 1") (assert (not st2.isEosAllowed) "EOS must be prohibited after symbol inside open list") (assert (= st3.stackDepth 1) "Stack depth must remain 1 after second symbol") (assert (not st3.isEosAllowed) "EOS must remain prohibited before closing paren") (assert (= st4.stackDepth 0) "Closing paren must balance delimiter stack to 0") (assert st4.isEosAllowed "EOS must be permitted once delimiter stack is balanced to 0") (assert (= st4.currentState pda1.acceptState) "Balanced state must reach PDA accept state") (assert (= stArith0.stackDepth 0) "Arithmetic grammar initial stack depth must be 0") (assert (not stArith0.isEosAllowed) "Arithmetic grammar initial state must not allow EOS before term") (assert (= stArith1.stackDepth 0) "Top-level number in arithmetic grammar keeps stack depth 0") (assert stArith1.isEosAllowed "Top-level number in arithmetic grammar permits EOS on completed atom") (refute st1.isEosAllowed "Refutation: EOS must not be allowed when stackDepth is 1") (refute st2.isEosAllowed "Refutation: EOS must not be allowed when stackDepth is 1") (refute st3.isEosAllowed "Refutation: EOS must not be allowed when stackDepth is 1") (refute (not st4.isEosAllowed) "Refutation: EOS must be allowed when stackDepth is 0 at accept state") (refute (= st1.stackDepth 0) "Refutation: Open paren must change stack depth") (refute (= st4.stackDepth 1) "Refutation: Close paren must decrement stack depth") (refute (not stArith1.isEosAllowed) "Refutation: Top-level atom in arithmetic grammar must allow EOS") true)

fn testTokenMaskBitsetComputation -> Bool
  (let [(pda (msk/compileGrammarToDfa (sampleSexprGrammar))) (eosId 0) (vocab (makeExpandedVocab)) (st0 (msk/maskerInit pda eosId)) (st1 (msk/advanceMaskerState pda st0 "(")) (st4 (msk/advanceMaskerState pda (msk/advanceMaskerState pda st1 "foo") ")")) (mask0 (msk/computeTokenMaskBitset pda st0 vocab)) (mask1 (msk/computeTokenMaskBitset pda st1 vocab)) (mask4 (msk/computeTokenMaskBitset pda st4 vocab)) (stSub (msk/advanceMaskerSubword pda st1 "my")) (maskSub (msk/computeTokenMaskBitset pda stSub vocab))] (assert (= (msk/isTokenAllowed mask0 0) false) "EOS token (ID 0) must be masked out at st0") (assert (= (msk/isTokenAllowed mask0 1) true) "Opening paren (ID 1) must be allowed at st0") (assert (= (msk/isTokenAllowed mask0 2) false) "Closing paren (ID 2) must be masked out at st0") (assert (= (msk/isTokenAllowed mask0 3) false) "Symbol defun (ID 3) must be masked out at st0 for S-expr root") (assert (= (msk/isTokenAllowed mask0 7) false) "Illegal token 'bad!@#' (ID 7) must be masked out at st0") (assert (= (msk/isTokenAllowed mask0 8) false) "Semicolon ';' (ID 8) must be masked out at st0") (assert (= (msk/isTokenAllowed mask0 9) false) "Operator '++' (ID 9) must be masked out at st0") (assert (= (msk/isTokenAllowed mask0 10) false) "Identifier '123foo' (ID 10) must be masked out at st0") (assert (= (msk/isTokenAllowed mask1 0) false) "EOS token (ID 0) must be strictly masked out inside open form st1") (assert (= (msk/isTokenAllowed mask1 1) true) "Nested opening paren (ID 1) must be allowed at st1") (assert (= (msk/isTokenAllowed mask1 2) true) "Closing paren (ID 2) must be allowed at st1") (assert (= (msk/isTokenAllowed mask1 3) true) "Symbol 'defun' (ID 3) must be allowed at st1") (assert (= (msk/isTokenAllowed mask1 4) true) "Symbol 'foo' (ID 4) must be allowed at st1") (assert (= (msk/isTokenAllowed mask1 5) true) "Number '42' (ID 5) must be allowed at st1") (assert (= (msk/isTokenAllowed mask1 6) true) "String '\"hello\"' (ID 6) must be allowed at st1") (assert (= (msk/isTokenAllowed mask1 7) false) "Illegal syntax token (ID 7) must be masked out at st1") (assert (= (msk/isTokenAllowed mask1 8) false) "Semicolon (ID 8) must be masked out at st1") (assert (= (msk/isTokenAllowed mask1 9) false) "Operator '++' (ID 9) must be masked out at st1") (assert (= (msk/isTokenAllowed mask1 10) false) "Identifier '123foo' (ID 10) must be masked out at st1") (assert (= (msk/isTokenAllowed mask4 0) true) "EOS token (ID 0) must be allowed once balanced at st4") (assert (= (msk/isTokenAllowed mask4 2) false) "Closing paren (ID 2) must be masked out at st4 with stackDepth 0") (assert (= (msk/isTokenAllowed mask4 7) false) "Illegal token must remain masked out at st4") (assert (= (msk/isTokenAllowed mask4 10) false) "Malformed identifier must remain masked out at st4") (assert (= (msk/isTokenAllowed maskSub 4) true) "Continuation 'foo' must be allowed for buffer 'my' (forming myfoo)") (assert (= (msk/isTokenAllowed maskSub 5) true) "Continuation '42' must be allowed for buffer 'my' (forming my42)") (assert (= (msk/isTokenAllowed maskSub 7) false) "Continuation 'bad!@#' must be masked out for buffer 'my'") (assert (= (msk/isTokenAllowed maskSub 8) false) "Continuation ';' must be masked out for buffer 'my'") (refute (msk/isTokenAllowed mask1 0) "Refutation: EOS token cannot be allowed inside unbalanced delimiter stack") (refute (msk/isTokenAllowed mask0 2) "Refutation: Close paren cannot precede open paren") (refute (msk/isTokenAllowed mask1 7) "Refutation: Illegal token cannot be allowed in open form") (refute (msk/isTokenAllowed mask4 7) "Refutation: Illegal token cannot be allowed in balanced form") (refute (msk/isTokenAllowed mask1 8) "Refutation: Semicolon cannot be allowed in S-expression") (refute (msk/isTokenAllowed mask1 9) "Refutation: Invalid operator ++ cannot be allowed in S-expression") (refute (msk/isTokenAllowed mask1 10) "Refutation: Digit-prefixed identifier cannot be allowed in S-expression") (refute (msk/isTokenAllowed maskSub 7) "Refutation: Invalid subword continuation cannot be allowed") (refute (= (msk/isTokenAllowed mask0 1) false) "Refutation: Open paren must be allowed at start") true)

fn testBpeSubwordPrefixMatching -> Bool
  (let [(pda (msk/compileGrammarToDfa (sampleSexprGrammar))) (eosId 0) (st0 (msk/maskerInit pda eosId)) (stOpen (msk/advanceMaskerState pda st0 "(")) (stSub1 (msk/advanceMaskerSubword pda stOpen "my")) (stSub2 (msk/advanceMaskerSubword pda stSub1 "Var")) (stCommit1 (msk/advanceMaskerState pda stSub2 "myVar")) (stNum1 (msk/advanceMaskerSubword pda stCommit1 "12")) (stNum2 (msk/advanceMaskerSubword pda stNum1 "34")) (stCommit2 (msk/advanceMaskerState pda stNum2 "1234")) (stStr1 (msk/advanceMaskerSubword pda stCommit2 "\"hel")) (stStr2 (msk/advanceMaskerSubword pda stStr1 "lo\"")) (stReset (msk/resetMaskerBuffer stStr2)) (stBad1 (msk/advanceMaskerSubword pda stOpen "my!@#")) (stBad2 (msk/advanceMaskerSubword pda stOpen "12abc")) (stBad3 (msk/advanceMaskerSubword pda stOpen "bad!@#")) (stBad4 (msk/advanceMaskerSubword pda stOpen ";")) (stBad5 (msk/advanceMaskerSubword pda stOpen "++")) (stClose (msk/advanceMaskerState pda stReset ")"))] (assert (= stSub1.stackDepth 1) "Subword 'my' must maintain open delimiter stack depth 1") (assert stSub1.isPrefixValid "Subword 'my' must be recognized as valid identifier prefix") (assert stSub2.isPrefixValid "Subword 'myVar' must be recognized as valid identifier prefix") (assert (= stCommit1.buffer "") "Committing token 'myVar' must clear subword buffer") (assert stNum1.isPrefixValid "Subword '12' in fresh buffer must be recognized as valid numeric prefix") (assert stNum2.isPrefixValid "Subword '1234' in fresh buffer must be recognized as valid numeric token") (assert (= stCommit2.buffer "") "Committing token '1234' must clear subword buffer") (assert stStr1.isPrefixValid "Subword '\"hel' must be recognized as valid string prefix") (assert stStr2.isPrefixValid "Subword '\"hello\"' must be recognized as completed string token") (assert (= stReset.buffer "") "resetMaskerBuffer must reset buffer to empty") (assert (not stBad1.isPrefixValid) "Subword 'my!@#' with illegal characters must be marked invalid across all chars") (assert (not stBad2.isPrefixValid) "Subword '12abc' mixing digits and letters must be marked invalid") (assert (not stBad3.isPrefixValid) "Subword 'bad!@#' must be marked invalid") (assert (not stBad4.isPrefixValid) "Subword ';' must be marked invalid") (assert (not stBad5.isPrefixValid) "Subword '++' must be marked invalid") (assert stClose.isEosAllowed "Closing paren after subword composition must balance stack and allow EOS") (refute (not stSub1.isPrefixValid) "Refutation: Valid prefix 'my' must not be flagged invalid") (refute (not stSub2.isPrefixValid) "Refutation: Valid combined identifier 'myVar' must not be flagged invalid") (refute (not stNum1.isPrefixValid) "Refutation: Valid numeric prefix '12' must not be flagged invalid") (refute (not stNum2.isPrefixValid) "Refutation: Valid numeric token '1234' must not be flagged invalid") (refute (not stStr1.isPrefixValid) "Refutation: Valid string prefix must not be flagged invalid") (refute stBad1.isPrefixValid "Refutation: Subword 'my!@#' must never be accepted as valid prefix") (refute stBad2.isPrefixValid "Refutation: Subword '12abc' must never be accepted as valid prefix") (refute stBad3.isPrefixValid "Refutation: Subword 'bad!@#' must never be accepted as valid prefix") (refute stBad4.isPrefixValid "Refutation: Subword ';' must never be accepted as valid prefix") (refute stBad5.isPrefixValid "Refutation: Subword '++' must never be accepted as valid prefix") (refute stSub1.isEosAllowed "Refutation: Partial subword cannot allow EOS") (refute stNum1.isEosAllowed "Refutation: Partial numeric prefix cannot allow EOS") true)

fn runTests -> Bool
  (let [(okPda (testGrammarCompilationToPda)) (okStack (testMaskerStateTransitionsAndDelimiterStack)) (okMask (testTokenMaskBitsetComputation)) (okBpe (testBpeSubwordPrefixMatching))] (and (and okPda okStack) (and okMask okBpe)))

fn RunTests -> Bool
  (runTests)
