(module asl-cli/binEntryTest :x [runTests] :i [(asl-tools/fleet/run :a run) (asl/packages/asl-cli/src/nativeCli :a nc) (asl/packages/asl-cli/src/nativeRefresh :a nr)])

; (:m :ref BIN-ASL-ASL :do "the slow half of bin/asl is ASL: aslNativeBuild refresh takes the build lock, clears a dead holder, fails loud with ERR_NATIVE_STALE when a live holder outlasts ASL_NATIVE_BUILD_WAIT, verifies the head and rewrites it; suspect? reads the deps list; the shell entry keeps no lock logic. Fixtures live in a private cache dir, every child is bounded, nothing outside the dir is touched")
fn ! envFor extra: (List String) -> (List String)
  (listAppend extra (filter (fn [(row String)] -> Bool (not (or (stringStartsWith? row "ASL_NATIVE_BUILD_WAIT=") (or (stringStartsWith? row "ASL_NATIVE_WAIT_REPORT_S=") (stringStartsWith? row "ASL_NATIVE_CLI_CACHE="))))) (run/childEnv (list))))

fn ! refresh! root: String cache: String extra: (List String) -> run/Done
  (run/runOneLimited (run/job (list (str root "/asl/host/out/aslNativeBuild") "refresh" root cache) root (envFor extra)) (run/limits 600 16))

fn ! headDirOf root: String -> String
  (stringTrim (resultOr (fileReadString (nc/headPath (nc/cacheDir!) root)) ""))

; (:m :ref BIN-ASL-ASL :do "two stubs racing on a stale builder never run build.sh at the same time: a scratch root has a copy of bin/asl, a fake build.sh that takes the --cold CACHE lock dir the way the real one does (the stub must pass --cold and the cache: the lock lives in build.sh since COLDSTART-WAIT-LIVE-HOLDER), logs s, sleeps and logs e, a suspect head and no builder; the log must alternate s e s e, children are bounded by the pool limits and the scratch dir is removed")
fn ! put! path: String text: String -> Bool
  (ok? (fileWrite path text))

fn ! exe! path: String text: String -> Bool
  (and (put! path text) (ok? (fileChmod path 493)))

fn ! raceBuilds! root: String -> (Pair (List String) (List String))
  (let [(base (str root "/.asl/cache/binEntryRace/" (stringFromInt64 (procSelf))))
        (cache (str base "/cache"))
        (ndir (str base "/native"))
        (r (str base "/root"))
        (log (str base "/build.log"))
        (made (listAll? (fn [(d String)] -> Bool (ok? (dirCreate d))) (list (str root "/.asl/cache/binEntryRace") base cache ndir r (str r "/bin") (str r "/asl") (str r "/asl/host") (str r "/asl/host/out"))))
        (stub (exe! (str r "/bin/asl") (resultOr (fileReadString (str root "/bin/asl")) "")))
        (build (exe! (str r "/asl/host/build.sh") (str "[ \"$1\" = --cold ] && [ \"$2\" = " cache " ] || exit 64; n=0; while ! mkdir \"$2/build.lockd\" 2>/dev/null; do n=$((n+1)); [ $n -le 250 ] || exit 75; sleep 0.2; done; trap 'rmdir \"$2/build.lockd\"' EXIT; echo s >> " log "; sleep 2; mkdir -p " r "/asl/host/out/aslNativeBuild-fresh; printf '#!/bin/sh\nexit 0\n' > " r "/asl/host/out/aslNativeBuild; chmod +x " r "/asl/host/out/aslNativeBuild; echo e >> " log "\n")))
        (served (exe! (str ndir "/bin") "#!/bin/sh\necho served\n"))
        (deps (put! (str ndir "/deps") "no/such/source\n"))
        (pointed (put! (str cache "/head" (stringReplace (resultOr (realPath r) r) "/" "_")) (str ndir "\n")))
        (env (cons (str "ASL_NATIVE_CLI_CACHE=" cache) (filter (fn [(row String)] -> Bool (not (stringStartsWith? row "ASL_NATIVE_CLI_CACHE="))) (run/childEnv (list)))))
        (jobs (list (run/job (list (str r "/bin/asl") "x") r env) (run/job (list (str r "/bin/asl") "y") r env)))
        (done (run/runPoolLimited jobs 2 (run/limits 60 32)))
        (events (filter (fn [(l String)] -> Bool (not (stringEmpty? l))) (stringLines (resultOr (fileReadString log) ""))))
        (outs (map (fn [(d run/Done)] -> String (str (stringFromInt64 d.exit) ":" (stringTrim d.out))) done))
        (cleaned (pathRemove base))]
    (pair (if (and made stub build served deps pointed) events (list "setupFailed")) outs))

fn ! alternates? events: (List String) -> Bool
  (match (listHead events)
    ((none) true)
    ((some e) (match (listHead (optionOr (listTail events) (list)))
                ((none) (= e "e"))
                ((some n) (and (!= e n) (alternates? (optionOr (listTail events) (list))))))))

fn ! runTests -> Bool -> Bool
  (let [(root (resultOr (realPath ".") "."))
        (built (headDirOf root))
        (cache (str root "/.asl/cache/binEntry/" (stringFromInt64 (procSelf))))
        (head (nc/headPath cache root))
        (madeCache (dirCreate cache))
        (pointed (put! head (str built "\n")))
        (heldLock (str cache "/lock"))
        (heldMade (dirCreate heldLock))
        (heldPid (put! (str heldLock "/pid") (str (stringFromInt64 (procSelf)) "\n")))
        (held (refresh! root cache (list "ASL_NATIVE_BUILD_WAIT=2" "ASL_NATIVE_WAIT_REPORT_S=1")))
        (stillHeld (stringTrim (resultOr (fileReadString (str heldLock "/pid")) "")))
        (cleared (pathRemove heldLock))
        (deadMade (dirCreate heldLock))
        (deadPid (put! (str heldLock "/pid") "99999999\n"))
        (dead (refresh! root cache (list "ASL_NATIVE_BUILD_WAIT=20")))
        (lockGone (not (fileExists? heldLock)))
        (headAfter (stringTrim (resultOr (fileReadString head) "")))
        (depsDir (str cache "/depsDir"))
        (depsMade (dirCreate depsDir))
        (stamp (str cache "/stamp"))
        (stampMade (put! stamp "x\n"))
        (missingDeps (put! (str depsDir "/deps") "asl/packages/asl-cli/src/noSuchFileAnywhere.asl\n"))
        (missing (nr/suspect? root depsDir stamp))
        (okDeps (put! (str depsDir "/deps") "asl/packages/asl-cli/src/nativeRefresh.asl\n"))
        (okAfterStamp (nr/suspect? root depsDir stamp))
        (emptyDeps (put! (str depsDir "/deps") "\n"))
        (empty (nr/suspect? root depsDir stamp))
        (noDeps (pathRemove (str depsDir "/deps")))
        (absent (nr/suspect? root depsDir stamp))
        (entry (resultOr (fileReadString (str root "/bin/asl")) ""))
        (entryLines (listLength (stringLines entry)))
        (race (raceBuilds! root))
        (cleaned (pathRemove cache))]
    (do (assert (and (ok? madeCache) pointed (ok? heldMade) heldPid) "the private cache, its head and a live lock holder were made")
        (assert (= held.exit 2) (str "a live lock holder that outlasts ASL_NATIVE_BUILD_WAIT fails the refresh: " held.out))
        (assert (stringContains? held.out "ERR_NATIVE_STALE") (str "the held-lock failure is ERR_NATIVE_STALE on stdout: " held.out))
        (assert (stringContains? held.out (str "the build lock stayed held by pid " (stringFromInt64 (procSelf)))) (str "the failure names the holder: " held.out))
        (assert (stringContains? held.out "(:wait :nativeCli :lockPid") (str "waiting on the lock reports progress on stderr: " held.out))
        (assert (= stillHeld (stringFromInt64 (procSelf))) "a refresh that never got the lock leaves the holder's pid file alone")
        (assert (and (ok? cleared) (ok? deadMade) deadPid) "the live lock was replaced by one held by a dead pid")
        (assert (= dead.exit 0) (str "a dead holder is cleared and a fresh head verifies: " dead.out dead.out))
        (assert lockGone "a finished refresh removes the lock")
        (assert (= headAfter built) (str "the verified head is rewritten to the same binary dir: " headAfter))
        (assert (and (ok? depsMade) stampMade missingDeps) "a deps fixture naming a missing source was made")
        (assert missing "a deps list naming a missing source makes the binary suspect")
        (assert (and okDeps (not okAfterStamp)) "a source older than the stamp does not")
        (assert (and emptyDeps empty) "an empty deps list is suspect")
        (assert (and (ok? noDeps) absent) "a missing deps file is suspect")
        (assert (and (<= entryLines 31) (not (stringContains? entry "lock/pid")) (not (stringContains? entry "native_refresh")) (stringContains? entry "aslNativeBuild\" refresh")) (str "bin/asl is a stub that calls the ASL refresh and holds no lock logic (cap 31: 29 plus the 2-line no-builder guard, bootstrap debt WT-MAIN-HOME-REBUILD-SH): " (stringFromInt64 entryLines) " lines"))
        (assert (ok? cleaned) "the private cache was removed")
        (assert (and (listContains? (pairFirst race) "s") (alternates? (pairFirst race)) (listAll? (fn [(o String)] -> Bool (= o "0:served")) (pairSecond race))) (str "two stubs racing on a stale builder build one at a time and both serve: " (stringJoin (pairFirst race) ",") " " (stringJoin (pairSecond race) ",")))
        true))
