(module asl-cli/tests/releaseTest
  :x [runTests]
  :i [(asl/packages/asl-cli/src/release :a rel)])

; (:m :ref INBOX-RELEASE-PIN :do "two release directories print different version lines, a workspace pin or minimum that the running release does not meet is reported with both tags and refuses in mode refuse, and tags compare numerically")
fn ! mk! dir: String -> Bool
  (ok? (dirCreate dir))

fn ! stamp! root: String tag: String commit: String -> Bool
  (let [(a (mk! (str root "/.release")))
        (b (fileWrite (str root "/.release/version.asn") (str "(:release :tag \"" tag "\" :commit \"" commit "\")\n")))]
    (and a (ok? b)))

fn ! runTests -> Bool
  (let [(tmp (resultOr (realPath "/tmp") "/tmp"))
        (base (str tmp "/aslReleaseTest." (stringFromInt64 (procSelf))))
        (made (mk! base))
        (r8 (str base "/releases"))
        (_ (mk! r8))
        (v8 (str r8 "/v0.0.8"))
        (v9 (str r8 "/v0.0.9"))
        (_ (mk! v8))
        (_ (mk! v9))
        (_ (stamp! v9 "v0.0.9" "abc123def456"))
        (ws (str base "/ws"))
        (_ (mk! ws))
        (line8 (rel/versionLine! v8 ws))
        (line9 (rel/versionLine! v9 ws))
        (_ (fileWrite (str ws "/.asl.config.asn") "(:config :release (:pin \"v0.0.1\") :native (:rc :notrace))\n"))
        (pinned (rel/versionLine! v9 ws))
        (_ (fileWrite (str ws "/.asl.config.asn") "(:config :release (:pin \"v0.0.9\"))\n"))
        (pinnedOk (rel/versionLine! v9 ws))
        (_ (fileWrite (str ws "/.asl.config.asn") "(:config :release (:min \"v0.0.10\" :mode refuse))\n"))
        (refused (rel/pinCheck! v9 ws))
        (_ (fileWrite (str ws "/.asl.config.asn") "(:config :release (:pin \"v0.0.1\"))\n"))
        (warned (rel/pinCheck! v9 ws))
        (_ (fileWrite (str ws "/.asl.config.asn") "(:config :release (:pin \"v0.0.9\" :mode refuse))\n"))
        (satisfied (rel/pinCheck! v9 ws))
        (_ (fileWrite (str ws "/.asl.config.asn") "(:config :release (:pin \"0.0.9\" :min \"0.0.1\" :mode :refuse))\n"))
        (bareOk (rel/pinCheck! v9 ws))
        (_ (fileWrite (str ws "/.asl.config.asn") "(:config :release (:pin \"0.0.8\" :mode :refuse))\n"))
        (bareRefused (rel/pinCheck! v9 ws))
        (removed (ok? (pathRemove base)))
        (p (rel/Pin :pin "v0.0.2" :min "" :mode "warn" :file "cfg"))
        (q (rel/Pin :pin "" :min "v0.0.2" :mode "warn" :file "cfg"))]
    (do (assert made "scratch dir made")
        (assert (and (stringContains? line8 "release v0.0.8") (stringContains? line9 "release v0.0.9 abc123def456") (!= line8 line9)) (str "two release dirs print their own tag, the stamp's commit too: " line8 " | " line9))
        (assert (stringStartsWith? line9 "asl 0.1.0 (bin/asl) release") "the banner stays the first part of the line")
        (assert (not (stringContains? line9 "(:release ")) "no pin in the workspace: no pin line")
        (assert (and (stringContains? pinned ":pin \"v0.0.1\"") (stringContains? pinned ":running \"v0.0.9\"") (stringContains? pinned ":status :mismatch")) (str "a pin the running release does not meet shows as a mismatch: " pinned))
        (assert (stringContains? pinnedOk ":status :ok") (str "a pin that matches shows ok: " pinnedOk))
        (assert refused "mode refuse with an unmet minimum refuses")
        (assert (not warned) "mode warn warns and lets the command run")
        (assert (not satisfied) "a satisfied pin refuses nothing even in mode refuse")
        (assert (and (= (rel/tagOfPath "/h/.asl/releases/v0.0.2") "v0.0.2") (= (rel/tagOfPath "/h/proj") "") (= (rel/tagOfPath "/h/releases/main") "")) "the tag comes from a directory under releases/ and nowhere else")
        (assert (and (= (rel/tagCmp "v0.0.2-1" "v0.0.2") 1) (and (= (rel/tagCmp "v0.0.10" "v0.0.9") 1) (and (= (rel/tagCmp "v0.0.1" "v0.0.2") -1) (= (rel/tagCmp "v0.0.2" "v0.0.2") 0)))) "tags compare numerically, a patch suffix is later")
        (assert (and (stringContains? (rel/pinProblem p "v0.0.1") "pins release v0.0.2") (stringContains? (rel/pinProblem p "v0.0.1") "v0.0.1 is running") (stringEmpty? (rel/pinProblem p "v0.0.2")) (stringEmpty? (rel/pinProblem p ""))) "a mismatch names both tags, a match and an unknown release say nothing")
        (assert (and (stringContains? (rel/pinProblem q "v0.0.1") "needs release v0.0.2 or later") (stringEmpty? (rel/pinProblem q "v0.0.2")) (stringEmpty? (rel/pinProblem q "v0.0.3"))) "a minimum accepts that tag or a later one")
        (assert (and (not bareOk) bareRefused) "a pin and a minimum without the v and a :refuse mode word: a matching pin runs, another pin refuses")
        (assert (and (= (rel/tagCmp "v0.0.2-rc1" "v0.0.2") -1) (and (= (rel/tagCmp "v0.0.2" "v0.0.2-rc1") 1) (and (= (rel/tagCmp "v0.0.2-rc1" "v0.0.2-rc2") -1) (and (= (rel/tagCmp "v0.0.2-rc1" "0.0.2-rc1") 0) (= (rel/tagCmp "v0.0.2-1" "v0.0.2-rc9") 1))))) "a pre-release suffix is earlier than its release and never equal to it")
        (assert (stringContains? (rel/pinProblem (rel/Pin :pin "0.0.2" :min "" :mode "warn" :file "cfg") "v0.0.2-rc1") "is running") "a pre-release does not satisfy the pin of its release")
        (assert (and (some? (rel/pinOf "(:config :native (:note \"x :release (:pin 1)\" :level :release) :release (:pin \"0.0.3\"))" "c")) (= (optionOr (match (rel/pinOf "(:config :native (:note \"x :release (:pin 1)\" :level :release) :release (:pin \"0.0.3\"))" "c") ((some p) (some p.pin)) ((none) (none))) "") "0.0.3")) "the row is found by the reader: :release inside a string or as a value is not a pin row")
        (assert (none? (rel/pinOf "(:config :native (:level :release :note \"(:release (:pin 1))\"))" "c")) "no :release row, only the word as value and in a string: no pin")
        (assert removed "scratch dir removed")
        true))
