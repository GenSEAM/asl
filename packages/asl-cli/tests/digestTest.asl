(module asl/packages/asl-cli/tests/digestTest :x [runTests] :i [(asl-cli/digest :a cliDigest) (asl-hypergraph/digest :a hyperDigest) (asl-hypergraph/model :a model)])

fn sampleModuleSource -> Str
  (str "(module pkg/math\n" "  :x [add multiply calculateDistance]\n" "  :i [])\n\n" "(fn add [(a Int64) (b Int64)] -> Int64\n" "  (:d \"Adds two integers\")\n" "  (+ a b))\n\n" "(fn multiply [(x Int64) (y Int64)] -> Int64\n" "  (:d \"Multiplies two integers\")\n" "  (* x y))\n\n" "(schema Point\n" "  (:f x Int64)\n" "  (:f y Int64))\n\n" "(fn calculateDistance [(p1 Point) (p2 Point)] -> Float64\n" "  (:d \"Euclidean distance computation\")\n" "  (let [(dx (- p2.x p1.x))\n" "        (dy (- p2.y p1.y))\n" "        (sum (+ (* dx dx) (* dy dy)))]\n" "    (sqrt (float sum))))\n")

fn testOutlineExtractsSignaturesWithoutBodies -> Bool
  (let [(src (sampleModuleSource)) (outlineRes (cliDigest/generateAstOutline src "pkg/math.asl"))] (assert (ok? outlineRes) "outline generation succeeds") (let [(outStr (mt outlineRes ((ok s) s) ((err _) "")))] (assert (stringContains? outStr ":outline") "outline contains :outline header") (assert (stringContains? outStr "pkg/math") "outline names module") (assert (stringContains? outStr "add") "outline contains add symbol") (assert (stringContains? outStr "multiply") "outline contains multiply symbol") (assert (stringContains? outStr "calculateDistance") "outline contains calculateDistance symbol") (assert (stringContains? outStr "Point") "outline contains Point struct") (refute (stringContains? outStr "(sqrt (float sum))") "refutation: internal sqrt body eliminated") (refute (stringContains? outStr "(+ (* dx dx)") "refutation: internal math body eliminated") (refute (stringContains? outStr "(* x y)") "refutation: multiply internal body eliminated") (refute (stringContains? outStr "(+ a b)") "refutation: add internal body eliminated")) true)

fn testOutlineZeroLineNumbers -> Bool
  (let [(src (sampleModuleSource)) (outlineRes (cliDigest/generateAstOutline src "pkg/math.asl")) (outStr (mt outlineRes ((ok s) s) ((err _) "")))] (refute (stringContains? outStr ":line") "no :line field in outline") (refute (stringContains? outStr ":col") "no :col field in outline") (refute (stringContains? outStr "#L") "no line anchor in outline") true)

fn testImpactDigestStrictTokenBound -> Bool
  (let [(nodes (list (model/makeHyperNode "Core:eval" "fn" "src/core.asl" "x" ""))) (edges (list (model/makeHyperEdge "Client1:call" "calls" "Core:eval" "body") (model/makeHyperEdge "Client2:call" "calls" "Core:eval" "body") (model/makeHyperEdge "Client3:call" "calls" "Core:eval" "body") (model/makeHyperEdge "Client4:call" "calls" "Core:eval" "body") (model/makeHyperEdge "Client5:call" "calls" "Core:eval" "body") (model/makeHyperEdge "Client6:call" "calls" "Core:eval" "body") (model/makeHyperEdge "Client7:call" "calls" "Core:eval" "body") (model/makeHyperEdge "Client8:call" "calls" "Core:eval" "body") (model/makeHyperEdge "Test1:run" "tests" "Core:eval" "body") (model/makeHyperEdge "Test2:run" "tests" "Core:eval" "body") (model/makeHyperEdge "Test3:run" "tests" "Core:eval" "body") (model/makeHyperEdge "Test4:run" "tests" "Core:eval" "body") (model/makeHyperEdge "Test5:run" "tests" "Core:eval" "body"))) (idx (model/makeHyperIndex 1 nodes edges 13)) (digest (hyperDigest/generateImpactDigest idx "Core:eval" 80))] (assert digest.isBounded "digest is bounded") (assert (<= digest.estimatedTokens 80) "estimated tokens strictly <= 80 tokens") (assert (> digest.estimatedTokens 5) "estimated tokens > 5") (assert (== digest.totalCallers 8) "total callers is 8") (assert (== digest.totalTests 5) "total tests is 5") (assert (stringContains? digest.receiptStr ":impact-digest") "receipt has :impact-digest header") (assert (stringContains? digest.receiptStr "Core:eval") "receipt names target symbol") (assert (stringContains? digest.receiptStr "+3 more callers") "high fan-in callers compacted with +N overflow") (assert (stringContains? digest.receiptStr "+2 more tests") "high fan-in tests compacted with +N overflow") (refute (> digest.estimatedTokens 80) "refutation: tokens must not exceed 80") (refute (== digest.receiptStr "") "refutation: receipt must not be empty") (refute (stringContains? digest.receiptStr "Client8:call") "refutation: overflow caller 8 truncated from list") (refute (stringContains? digest.receiptStr "Test5:run") "refutation: overflow test 5 truncated from list") true)

fn testImpactDigestZeroLineNumbers -> Bool
  (let [(nodes (list (model/makeHyperNode "Sym:foo" "fn" "src/foo.asl" "" ""))) (edges (list (model/makeHyperEdge "Caller:bar" "calls" "Sym:foo" "body"))) (idx (model/makeHyperIndex 1 nodes edges 1)) (digest (hyperDigest/generateImpactDigest idx "Sym:foo" 80)) (receipt digest.receiptStr)] (refute (stringContains? receipt ":line") "no :line field in impact receipt") (refute (stringContains? receipt ":col") "no :col field in impact receipt") (refute (stringContains? receipt "#L") "no line anchor in impact receipt") (assert (stringContains? receipt "Sym:foo") "symbol name present") true)

fn testCompactPerceptionReceipt -> Bool
  (let [(rawReceipt (str "(:impact-digest\n" "  :target \"Module:func\"\n" "  :callers [\"A\" \"B\"]\n" "  :tests [\"T1\"])\n")) (compacted (hyperDigest/compactPerceptionReceipt rawReceipt 80)) (tokens (hyperDigest/estimateTokenCount compacted))] (assert (<= tokens 80) "compacted receipt within 80 tokens") (assert (> (stringLength compacted) 0) "compacted receipt non-empty") (assert (stringContains? compacted ":impact-digest") "preserves semantic structure") (refute (> tokens 80) "refutation: token count must not exceed 80") (refute (stringContains? compacted "  ") "refutation: consecutive whitespace compressed") true)

fn testCliOutlineAndImpactHelp -> Bool
  (let [(outlineHelp (cliDigest/formatOutlineHelp)) (impactHelp (cliDigest/formatImpactHelp))] (assert (stringContains? outlineHelp "Usage: asl outline") "outline help usage") (assert (stringContains? outlineHelp "sub-80") "outline help SNR SLA") (assert (stringContains? impactHelp "Usage: asl impact") "impact help usage") (assert (stringContains? impactHelp "<symbol>") "impact help symbol arg") (refute (stringContains? outlineHelp ":line") "no line numbers in outline help") (refute (stringContains? impactHelp ":line") "no line numbers in impact help") true)

fn runTests -> Bool
  (and (testOutlineExtractsSignaturesWithoutBodies) (and (testOutlineZeroLineNumbers) (and (testImpactDigestStrictTokenBound) (and (testImpactDigestZeroLineNumbers) (and (testCompactPerceptionReceipt) (testCliOutlineAndImpactHelp))))))
