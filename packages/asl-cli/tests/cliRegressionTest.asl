(module asl-cli/tests/cliRegressionTest :x [testCliTestSuiteRegression! testCliHyphenSuiteRegression! testSubcommandRegressions! testMultiStepStatusAggregation! runTests] :i [(asl-cli/batch :a b) (asl-tools/fleet/run :a run)])

fn testCliTestSuiteRegression! -> Bool
  (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-cli/tests/cliTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit) (out res.out)] (assert (= code 0) "cliTest.asl must pass cleanly") (refute (!= code 0) "cliTest.asl must not fail") (assert (stringContains? out "assertion(s) executed") "cliTest.asl ran assertions") (refute (stringContains? out "0 assertion(s) executed") "cliTest.asl is non-vacuous") true)

fn testCliHyphenSuiteRegression! -> Bool
  (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-cli/tests/batchTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit) (out res.out)] (assert (= code 0) "batchTest.asl must pass cleanly") (refute (!= code 0) "batchTest.asl must not fail") (assert (stringContains? out "assertion(s) executed") "batchTest.asl ran assertions") (refute (stringContains? out "0 assertion(s) executed") "batchTest.asl is non-vacuous") true)

fn testSubcommandRegressions! -> Bool
  (do (let [(vRes (run/runOneLimited (run/job (list "bin/asl" "version") "." (run/childEnv (list))) (run/limits 180 8)))] (assert (= vRes.exit 0) "bin/asl version exits 0") (refute (!= vRes.exit 0) "bin/asl version must not fail") (assert (stringContains? vRes.out "asl") "version string valid") (refute (stringContains? vRes.out "error") "version has no error")) (let [(hRes (run/runOneLimited (run/job (list "bin/asl" "help") "." (run/childEnv (list))) (run/limits 180 8)))] (assert (= hRes.exit 0) "bin/asl help exits 0") (refute (!= hRes.exit 0) "bin/asl help must not fail") (assert (stringContains? hRes.out "Human CLI Usage:") "help contains usage") (refute (stringContains? hRes.out "error") "help has no error")) (let [(cRes (run/runOneLimited (run/job (list "bin/asl" "check" "asl/packages/asl-cli/src/cli.asl") "." (run/childEnv (list))) (run/limits 180 8)))] (assert (= cRes.exit 0) "bin/asl check cli.asl exits 0") (refute (!= cRes.exit 0) "bin/asl check must not fail") (assert (stringContains? cRes.out ":checked ") "syntax check passed")) (let [(eRes (run/runOneLimited (run/job (list "bin/asl" "eval" "(+ 21 21)") "." (run/childEnv (list))) (run/limits 180 8)))] (assert (= eRes.exit 0) "bin/asl eval exits 0") (refute (!= eRes.exit 0) "bin/asl eval must not fail") (assert (stringContains? eRes.out "42") "eval evaluates (+ 21 21) = 42")) true)

fn testMultiStepStatusAggregation! -> Bool
  (do (let [(allPassRes (b/evalBatch! "(:batch (:echo :message \"a\") (:echo :message \"b\"))"))] (assert (ok? allPassRes) "all pass exits ok") (let [(out (resultOr allPassRes ""))] (assert (stringContains? out ":status \"completed\"") "all pass completed") (assert (stringContains? out ":itemsCount 2") "itemsCount 2") (refute (stringContains? out ":failed-count") "no failed count on success"))) (let [(partFailRes (b/evalBatch! "(:batch (:echo :message \"ok\") (:unimplementedOp))"))] (assert (ok? partFailRes) "part fail exits ok") (let [(out (resultOr partFailRes ""))] (assert (stringContains? out ":status \"completed-with-errors\"") "partial failure completed-with-errors") (assert (stringContains? out ":failed-count 1") "failed-count 1") (refute (stringContains? out ":status \"completed\" :itemsCount 2") "not fully completed"))) (let [(allFailRes (b/evalBatch! "(:batch (:unimplementedOp1) (:unimplementedOp2))"))] (assert (ok? allFailRes) "all fail exits ok") (let [(out (resultOr allFailRes ""))] (assert (stringContains? out ":status \"failed\"") "all fail marked failed") (assert (stringContains? out ":failed-count 2") "failed-count 2") (refute (stringContains? out ":status \"completed\"") "not completed"))) true)

fn ! runTests -> Bool
  (do (assert (testCliTestSuiteRegression!) "testCliTestSuiteRegression passed") (assert (testCliHyphenSuiteRegression!) "testCliHyphenSuiteRegression passed") (assert (testSubcommandRegressions!) "testSubcommandRegressions passed") (assert (testMultiStepStatusAggregation!) "testMultiStepStatusAggregation passed") true)
