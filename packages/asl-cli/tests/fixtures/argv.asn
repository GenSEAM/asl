(:nativeCli :v 1 :recordedFrom "asl-host run asl/packages/asl-cli/src/command.asl ARGV, cwd the workspace root, NATIVE- telemetry lines dropped, root shown as $ROOT" :cases [
  (:case :id "runMarker" :argv ["run" "asl/packages/asl-cli/tests/fixtures/runMe.asl" "a" "b"] :stdout "RUN_OUTPUT_MARKER\n" :stderr "" :exit 0)
  (:case :id "runAbsolute" :argv ["run" "$ROOT/asl/packages/asl-cli/tests/fixtures/runMe.asl"] :stdout "RUN_OUTPUT_MARKER\n" :stderr "" :exit 0)
  (:case :id "runNoEntry" :argv ["run" "asl/packages/asl-cli/tests/fixtures/noEntry.asl"] :stdout "" :stderr "FAIL asl/packages/asl-cli/tests/fixtures/noEntry.asl: ERR_NATIVE_UNSUPPORTED: asl/packages/asl-cli/tests/fixtures/noEntry.asl exports neither runTests nor main\n" :exit 1)
  (:case :id "runUsage" :argv ["run"] :stdout "usage: asl run FILE [ARGS]   load FILE and call its main; exit 0 iff main returns (ok ...)\n" :stderr "" :exit 2)
  (:case :id "testOk" :argv ["test" "asl/packages/asl-cli/tests/fixtures/testOk.asl"] :stdout "asl/packages/asl-cli/tests/fixtures/testOk.asl: 1 assertion(s) executed (1 passed)\n" :stderr "" :exit 0)
  (:case :id "testTwo" :argv ["test" "asl/packages/asl-cli/tests/fixtures/testOk.asl" "asl/packages/asl-cli/tests/fixtures/testNoDoc.asl"] :stdout "asl/packages/asl-cli/tests/fixtures/testOk.asl: 1 assertion(s) executed (1 passed)\nasl/packages/asl-cli/tests/fixtures/testNoDoc.asl: 1 assertion(s) executed (1 passed)\n" :stderr "" :exit 0)
  (:case :id "testAbsolute" :argv ["test" "$ROOT/asl/packages/asl-cli/tests/fixtures/testOk.asl"] :stdout "$ROOT/asl/packages/asl-cli/tests/fixtures/testOk.asl: 1 assertion(s) executed (1 passed)\n" :stderr "" :exit 0)
  (:case :id "testNoAsserts" :argv ["test" "asl/packages/asl-cli/tests/fixtures/noAsserts.asl"] :stdout "" :stderr "FAIL asl/packages/asl-cli/tests/fixtures/noAsserts.asl: ERR_TEST_FAILED: zero assertions executed (after 0 asserts)\n" :exit 1)
  (:case :id "testDirectory" :argv ["test" "asl/packages/asl-cli/tests/fixtures/testChanged"] :stdout "(:test :frozen 0)\nasl/packages/asl-cli/tests/fixtures/testChanged/alphaTest.asl: 1 assertion(s) executed (1 passed)\nasl/packages/asl-cli/tests/fixtures/testChanged/betaTest.asl: 1 assertion(s) executed (1 passed)\n" :stderr "" :exit 0)
  (:case :id "testFileAsVerb" :argv ["asl/packages/asl-cli/tests/fixtures/testOk.asl"] :stdout "asl/packages/asl-cli/tests/fixtures/testOk.asl: 1 assertion(s) executed (1 passed)\n" :stderr "" :exit 0)
  (:case :id "testNativeFlag" :argv ["test" "--native" "asl/packages/asl-cli/tests/fixtures/testOk.asl"] :stdout "asl/packages/asl-cli/tests/fixtures/testOk.asl: 1 assertion(s) executed (1 passed)\n" :stderr "" :exit 0)
  (:case :id "testUnknownOption" :argv ["test" "--bogus"] :stdout "(:test :status :failed :error ERR_UNKNOWN_ARG :message \"asl test takes files and directories; unknown option --bogus\")\n" :stderr "" :exit 2)
  (:case :id "parseRunMe" :argv ["parse" "asl/packages/asl-cli/tests/fixtures/runMe.asl"] :stdout "2 top-level form(s)\n" :stderr "" :exit 0)
  (:case :id "parseNativeTest" :argv ["parse" "asl/packages/asl-cli/tests/fixtures/sweep/passTest.asl"] :stdout "2 top-level form(s)\n" :stderr "" :exit 0)
  (:case :id "parsePrelude" :argv ["parse" "asl/prelude/prelude.asl"] :stdout "252 top-level form(s)\n" :stderr "" :exit 0)
  (:case :id "parseAsn" :argv ["parse" "asl/packages/asl-cli/tests/fixtures/argv.asn"] :stdout "1 top-level form(s)\n" :stderr "" :exit 0)
  (:case :id "parseMissing" :argv ["parse" "asl/packages/asl-cli/tests/fixtures/none.asl"] :stdout "" :stderr "asl/packages/asl-cli/tests/fixtures/none.asl: ERR_IO cannot read file\n" :exit 1)
  (:case :id "parseUnclosed" :argv ["parse" "asl/grammar/corpus/invalid/unbalanced.asl"] :stdout "" :stderr "asl/grammar/corpus/invalid/unbalanced.asl:2:3: ERR_READ_UNBALANCED unclosed '(' at end of file\n" :exit 1)
  (:case :id "parseUnmatched" :argv ["parse" "tests/acceptance/vtbotDataPlane/fixtures/invalid/unbalancedTest.asl"] :stdout "" :stderr "tests/acceptance/vtbotDataPlane/fixtures/invalid/unbalancedTest.asl:6:14: ERR_READ_UNBALANCED unmatched ')'\n" :exit 1)
  (:case :id "parseBareDecimal" :argv ["parse" "asl/grammar/corpus/invalid/bareDecimalPoint.asl"] :stdout "2 top-level form(s)\n" :stderr "" :exit 0)
  (:case :id "parseTypeparams" :argv ["parse" "asl/grammar/corpus/invalid/fnTypeparams.asl"] :stdout "1 top-level form(s)\n" :stderr "" :exit 0)
  (:case :id "parseMissingArrow" :argv ["parse" "asl/grammar/corpus/invalid/missingArrow.asl"] :stdout "1 top-level form(s)\n" :stderr "" :exit 0)
  (:case :id "parsePascal" :argv ["parse" "asl/grammar/corpus/invalid/pascalFunction.asl"] :stdout "1 top-level form(s)\n" :stderr "" :exit 0)
  (:case :id "evalInt" :argv ["eval" "(+ 1 2)"] :stdout "3\n" :stderr "" :exit 0)
  (:case :id "evalSplitArgs" :argv ["eval" "(*" "6" "7)"] :stdout "42\n" :stderr "" :exit 0)
  (:case :id "evalString" :argv ["eval" "(str \"a\" \"b\")"] :stdout "\"ab\"\n" :stderr "" :exit 0)
  (:case :id "evalEscapes" :argv ["eval" "(str \"q\\\"t\" \"\\n\")"] :stdout "\"q\\\"t\\n\"\n" :stderr "" :exit 0)
  (:case :id "evalList" :argv ["eval" "(list 1 2 3)"] :stdout "(1 2 3)\n" :stderr "" :exit 0)
  (:case :id "evalStringList" :argv ["eval" "(list \"x\" \"y\")"] :stdout "(\"x\" \"y\")\n" :stderr "" :exit 0)
  (:case :id "evalBool" :argv ["eval" "(> 3 2)"] :stdout "true\n" :stderr "" :exit 0)
  (:case :id "evalSome" :argv ["eval" "(some 4)"] :stdout "(some 4)\n" :stderr "" :exit 0)
  (:case :id "evalNone" :argv ["eval" "(listHead (list))"] :stdout "(none)\n" :stderr "" :exit 0)
  (:case :id "evalOk" :argv ["eval" "(ok \"v\")"] :stdout "(ok \"v\")\n" :stderr "" :exit 0)
  (:case :id "evalPair" :argv ["eval" "(pair 1 \"b\")"] :stdout "(pair 1 \"b\")\n" :stderr "" :exit 0)
  (:case :id "evalUnitPrint" :argv ["eval" "(println \"hi\")"] :stdout "hi\n()\n" :stderr "" :exit 0)
  (:case :id "evalNested" :argv ["eval" "(map (fn [(x Int64)] -> (List Int64) (list x x)) (list 1 2))"] :stdout "((1 1) (2 2))\n" :stderr "" :exit 0)
  (:case :id "evalFloat" :argv ["eval" "(/ 7.0 2.0)"] :stdout "3.5\n" :stderr "" :exit 0)
  (:case :id "evalEmpty" :argv ["eval"] :stdout "()\n" :stderr "" :exit 0)
  (:case :id "evalAsn" :argv ["eval" "(:k 1 :s \"x\")"] :stdout "(:k 1 :s \"x\")\n" :stderr "" :exit 0)
  (:case :id "evalNativeFlag" :argv ["eval" "--native" "(+ 40 2)"] :stdout "42\n" :stderr "" :exit 0)
  (:case :id "launchBare" :argv ["launch"] :stdout "" :stderr "asl launch: start claude, codex or agy with the asl harness as the system prompt.\n\nThe prompt is rendered from asl/grammar/harness.asn: its layers in order, each layer with :when only\nwhere its facts hold for this client and workspace, and the attractors of the mode, so the client\nneeds no toolbelt skill. Usage:\n  launch.py <claude|codex|agy> [--lean [--coord]] [--mode scout|implement|grade|distill] [--core]\n            [--bare] [--shell-only] [--ask] [--dry-run] [--print-prompt] [--prompt-only] [-- client args...]\n--lean (claude only) also narrows the tool set to the :lean list, drops MCP servers and skills;\n--coord adds the :coord tools (see and message peer sessions, about 2.4k tokens);\n--core renders only the layers without :when (no asl knowledge, no conditional layers);\n--ask keeps the client's permission prompts instead of its :auto mode (clients.asn);\n--bare (agy only) drops agy's default components too (workspace map, injected context);\n--shell-only (claude, agy) leaves the client its shell tool alone, so reads and edits go through the shell or asl;\n--prompt-only writes the rendered prompt and returns its path, freeze digest and requested client argv without launching;\nASL_LAUNCH_DROP removes one harness layer, ASL_LAUNCH_FILL_ASL substitutes the asl command path,\nASL_LAUNCH_ONCE omits the memory layer, and ASL_LAUNCH_PROMPT_DIR selects the prompt output directory.\n" :exit 2)
  (:case :id "launchHelp" :argv ["launch" "--help"] :stdout "" :stderr "asl launch: start claude, codex or agy with the asl harness as the system prompt.\n\nThe prompt is rendered from asl/grammar/harness.asn: its layers in order, each layer with :when only\nwhere its facts hold for this client and workspace, and the attractors of the mode, so the client\nneeds no toolbelt skill. Usage:\n  launch.py <claude|codex|agy> [--lean [--coord]] [--mode scout|implement|grade|distill] [--core]\n            [--bare] [--shell-only] [--ask] [--dry-run] [--print-prompt] [--prompt-only] [-- client args...]\n--lean (claude only) also narrows the tool set to the :lean list, drops MCP servers and skills;\n--coord adds the :coord tools (see and message peer sessions, about 2.4k tokens);\n--core renders only the layers without :when (no asl knowledge, no conditional layers);\n--ask keeps the client's permission prompts instead of its :auto mode (clients.asn);\n--bare (agy only) drops agy's default components too (workspace map, injected context);\n--shell-only (claude, agy) leaves the client its shell tool alone, so reads and edits go through the shell or asl;\n--prompt-only writes the rendered prompt and returns its path, freeze digest and requested client argv without launching;\nASL_LAUNCH_DROP removes one harness layer, ASL_LAUNCH_FILL_ASL substitutes the asl command path,\nASL_LAUNCH_ONCE omits the memory layer, and ASL_LAUNCH_PROMPT_DIR selects the prompt output directory.\n" :exit 2)
  (:case :id "launchUnknownClient" :argv ["launch" "emacs"] :stdout "" :stderr "asl launch: start claude, codex or agy with the asl harness as the system prompt.\n\nThe prompt is rendered from asl/grammar/harness.asn: its layers in order, each layer with :when only\nwhere its facts hold for this client and workspace, and the attractors of the mode, so the client\nneeds no toolbelt skill. Usage:\n  launch.py <claude|codex|agy> [--lean [--coord]] [--mode scout|implement|grade|distill] [--core]\n            [--bare] [--shell-only] [--ask] [--dry-run] [--print-prompt] [--prompt-only] [-- client args...]\n--lean (claude only) also narrows the tool set to the :lean list, drops MCP servers and skills;\n--coord adds the :coord tools (see and message peer sessions, about 2.4k tokens);\n--core renders only the layers without :when (no asl knowledge, no conditional layers);\n--ask keeps the client's permission prompts instead of its :auto mode (clients.asn);\n--bare (agy only) drops agy's default components too (workspace map, injected context);\n--shell-only (claude, agy) leaves the client its shell tool alone, so reads and edits go through the shell or asl;\n--prompt-only writes the rendered prompt and returns its path, freeze digest and requested client argv without launching;\nASL_LAUNCH_DROP removes one harness layer, ASL_LAUNCH_FILL_ASL substitutes the asl command path,\nASL_LAUNCH_ONCE omits the memory layer, and ASL_LAUNCH_PROMPT_DIR selects the prompt output directory.\n" :exit 2)
  (:case :id "launchBadMode" :argv ["launch" "claude" "--mode" "nonsense"] :stdout "" :stderr "launch: --mode takes one of distill, grade, implement, scout (the :modes of harness.asn)\n" :exit 2)
  (:case :id "launchBadOption" :argv ["launch" "claude" "--bogus"] :stdout "" :stderr "launch: claude not found on PATH\n" :exit 1)
  (:case :id "helpBare" :argv [] :stdout "AgentScript (ASL) Unified Toolchain & Runtime\n\nHuman CLI Usage:\n  asl <command> [args...]\n\nCommands:\n  check <file>        Balance, then asl-host check for .asl (names, arity, enums); bare: every tracked file\n  test <file|dir>     Run suites; --changed [BASE] selects impacts (default main), --dry-run lists without execution\n  parse <file>        Count top-level forms on asl-host\n  eval [--native] <expr> Host evaluates expressions and echoes (:keyword ...) as ASN data; --native evaluates a single Int64 expression only\n  build <file>        Not implemented until R1 (ERR_UNIMPLEMENTED)\n  pack [options]      Assemble, package and compile target distribution bundles\n  intel <subcmd>      Unified Code Intelligence: coupling, impact, outline, query, deadcode, vacuity, graph, complexity\n  graph [opts]        Alias to 'intel graph' (whole-repo call graph, connectivity, architectural hotspots)\n  complexity [target] Alias to 'intel complexity' (cyclomatic complexity, expressions, purity)\n  coupling [opts]     Alias to 'intel coupling' (short-range cohesion, inter-package DAG, fictions)\n  audit <subcmd>      Run workspace audit (gates, consistency, coupling, foreign, steps, naming, closure)\n  engine [cmd]        Resident ASL engine runtime, supervisor, and process management (start, stop, status, ping)\n  version             Display toolchain version\n  help                Display this usage guide\n\nAgent Plane Usage:\n  Agents interact exclusively via pure Dyck-1 ASN S-expressions:\n    asl '(:tools)'                      Introspect machine-readable tool schema\n    asl '(:intel :op <op> ...)'         Unified Code Intelligence query (:coupling :impact :outline :query)\n    asl '(:op ...)'                     Execute single pure-ASN operation\n    asl '(:op1 ...) (:op2 ...)'         Compound multi-operation batch\n    asl -f FILE                         Run the forms in FILE, as asl '<forms>' would\n    asl - <<'ASN'                       Run forms from stdin; a quoted heredoc keeps single quotes\n" :stderr "" :exit 0)
  (:case :id "helpShort" :argv ["-h"] :stdout "AgentScript (ASL) Unified Toolchain & Runtime\n\nHuman CLI Usage:\n  asl <command> [args...]\n\nCommands:\n  check <file>        Balance, then asl-host check for .asl (names, arity, enums); bare: every tracked file\n  test <file|dir>     Run suites; --changed [BASE] selects impacts (default main), --dry-run lists without execution\n  parse <file>        Count top-level forms on asl-host\n  eval [--native] <expr> Host evaluates expressions and echoes (:keyword ...) as ASN data; --native evaluates a single Int64 expression only\n  build <file>        Not implemented until R1 (ERR_UNIMPLEMENTED)\n  pack [options]      Assemble, package and compile target distribution bundles\n  intel <subcmd>      Unified Code Intelligence: coupling, impact, outline, query, deadcode, vacuity, graph, complexity\n  graph [opts]        Alias to 'intel graph' (whole-repo call graph, connectivity, architectural hotspots)\n  complexity [target] Alias to 'intel complexity' (cyclomatic complexity, expressions, purity)\n  coupling [opts]     Alias to 'intel coupling' (short-range cohesion, inter-package DAG, fictions)\n  audit <subcmd>      Run workspace audit (gates, consistency, coupling, foreign, steps, naming, closure)\n  engine [cmd]        Resident ASL engine runtime, supervisor, and process management (start, stop, status, ping)\n  version             Display toolchain version\n  help                Display this usage guide\n\nAgent Plane Usage:\n  Agents interact exclusively via pure Dyck-1 ASN S-expressions:\n    asl '(:tools)'                      Introspect machine-readable tool schema\n    asl '(:intel :op <op> ...)'         Unified Code Intelligence query (:coupling :impact :outline :query)\n    asl '(:op ...)'                     Execute single pure-ASN operation\n    asl '(:op1 ...) (:op2 ...)'         Compound multi-operation batch\n    asl -f FILE                         Run the forms in FILE, as asl '<forms>' would\n    asl - <<'ASN'                       Run forms from stdin; a quoted heredoc keeps single quotes\n" :stderr "" :exit 0)
  (:case :id "helpLong" :argv ["--help"] :stdout "AgentScript (ASL) Unified Toolchain & Runtime\n\nHuman CLI Usage:\n  asl <command> [args...]\n\nCommands:\n  check <file>        Balance, then asl-host check for .asl (names, arity, enums); bare: every tracked file\n  test <file|dir>     Run suites; --changed [BASE] selects impacts (default main), --dry-run lists without execution\n  parse <file>        Count top-level forms on asl-host\n  eval [--native] <expr> Host evaluates expressions and echoes (:keyword ...) as ASN data; --native evaluates a single Int64 expression only\n  build <file>        Not implemented until R1 (ERR_UNIMPLEMENTED)\n  pack [options]      Assemble, package and compile target distribution bundles\n  intel <subcmd>      Unified Code Intelligence: coupling, impact, outline, query, deadcode, vacuity, graph, complexity\n  graph [opts]        Alias to 'intel graph' (whole-repo call graph, connectivity, architectural hotspots)\n  complexity [target] Alias to 'intel complexity' (cyclomatic complexity, expressions, purity)\n  coupling [opts]     Alias to 'intel coupling' (short-range cohesion, inter-package DAG, fictions)\n  audit <subcmd>      Run workspace audit (gates, consistency, coupling, foreign, steps, naming, closure)\n  engine [cmd]        Resident ASL engine runtime, supervisor, and process management (start, stop, status, ping)\n  version             Display toolchain version\n  help                Display this usage guide\n\nAgent Plane Usage:\n  Agents interact exclusively via pure Dyck-1 ASN S-expressions:\n    asl '(:tools)'                      Introspect machine-readable tool schema\n    asl '(:intel :op <op> ...)'         Unified Code Intelligence query (:coupling :impact :outline :query)\n    asl '(:op ...)'                     Execute single pure-ASN operation\n    asl '(:op1 ...) (:op2 ...)'         Compound multi-operation batch\n    asl -f FILE                         Run the forms in FILE, as asl '<forms>' would\n    asl - <<'ASN'                       Run forms from stdin; a quoted heredoc keeps single quotes\n" :stderr "" :exit 0)
  (:case :id "helpWord" :argv ["help"] :stdout "AgentScript (ASL) Unified Toolchain & Runtime\n\nHuman CLI Usage:\n  asl <command> [args...]\n\nCommands:\n  check <file>        Balance, then asl-host check for .asl (names, arity, enums); bare: every tracked file\n  test <file|dir>     Run suites; --changed [BASE] selects impacts (default main), --dry-run lists without execution\n  parse <file>        Count top-level forms on asl-host\n  eval [--native] <expr> Host evaluates expressions and echoes (:keyword ...) as ASN data; --native evaluates a single Int64 expression only\n  build <file>        Not implemented until R1 (ERR_UNIMPLEMENTED)\n  pack [options]      Assemble, package and compile target distribution bundles\n  intel <subcmd>      Unified Code Intelligence: coupling, impact, outline, query, deadcode, vacuity, graph, complexity\n  graph [opts]        Alias to 'intel graph' (whole-repo call graph, connectivity, architectural hotspots)\n  complexity [target] Alias to 'intel complexity' (cyclomatic complexity, expressions, purity)\n  coupling [opts]     Alias to 'intel coupling' (short-range cohesion, inter-package DAG, fictions)\n  audit <subcmd>      Run workspace audit (gates, consistency, coupling, foreign, steps, naming, closure)\n  engine [cmd]        Resident ASL engine runtime, supervisor, and process management (start, stop, status, ping)\n  version             Display toolchain version\n  help                Display this usage guide\n\nAgent Plane Usage:\n  Agents interact exclusively via pure Dyck-1 ASN S-expressions:\n    asl '(:tools)'                      Introspect machine-readable tool schema\n    asl '(:intel :op <op> ...)'         Unified Code Intelligence query (:coupling :impact :outline :query)\n    asl '(:op ...)'                     Execute single pure-ASN operation\n    asl '(:op1 ...) (:op2 ...)'         Compound multi-operation batch\n    asl -f FILE                         Run the forms in FILE, as asl '<forms>' would\n    asl - <<'ASN'                       Run forms from stdin; a quoted heredoc keeps single quotes\n" :stderr "" :exit 0)
  (:case :id "versionHostAbsent" :argv ["version"] :env ["ASL_CLI_HOST_BIN=/nonexistent/asl-host" "ASL_HOST=/nonexistent/asl-host"] :stdout "asl 0.1.0 (bin/asl)\nasl-host absent: build it with sh asl/host/build.sh or set ASL_HOST\n" :stderr "" :exit 0)
  (:case :id "aslFileMissing" :argv ["tests/noneTest.asl"] :stdout "(:asl :status :failed :error ERR_UNKNOWN_COMMAND :message \"unknown command tests/noneTest.asl; see asl help\")\n" :stderr "" :exit 2)
  (:case :id "toolTrace" :argv ["trace" "t"] :env ["ASL_CLI_HOST_BIN=/nonexistent/asl-host" "ASL_HOST=/nonexistent/asl-host"] :stdout "================================================================================\n     ASL RUNTIME HOT-PATH EXECUTION TRACE & BRANCH COVERAGE (ADR D135)          \n================================================================================\nTarget Scope:            t\nTotal Invocations:       0 calls\nUnique Functions Hit:    0 functions\nBranches Evaluated:      0 branch points\nBranch Coverage:         100.0%\nExecuted Assertions:     0 assertions\n\n--- Hot Functions Heatmap (Top Executed) ---\n" :stderr "" :exit 0)
  (:case :id "auditIntelTrace" :argv ["audit" "trace" "x"] :env ["ASL_CLI_HOST_BIN=/nonexistent/asl-host" "ASL_HOST=/nonexistent/asl-host"] :stdout "" :stderr "Error: ASL host or intel package entry not found\n" :exit 1)
  (:case :id "intelOutline" :argv ["intel" "outline" "asl/packages/asl-cli/src/main.asl"] :env ["ASL_CLI_HOST_BIN=/nonexistent/asl-host" "ASL_HOST=/nonexistent/asl-host"] :stdout "(:outline\n  :status :ok\n  :file \"asl/packages/asl-cli/src/main.asl\"\n  :module \"asl-cli/main\"\n  :itemsCount 2\n  :items [\n    (:item :name \"! dispatch\" :kind \"fn\" :signature \"args: (List Str\" :exported false)\n    (:item :name \"! main\" :kind \"fn\" :signature \"args: (List Str\" :exported false)\n  ])\n" :stderr "" :exit 0)
  (:case :id "buildHelp" :argv ["build" "--help"] :stdout "usage: asl build FILE [-o OUT]\n" :stderr "" :exit 0)
  (:case :id "buildHelpShort" :argv ["build" "-h"] :stdout "usage: asl build FILE [-o OUT]\n" :stderr "" :exit 0)
  (:case :id "buildHostAbsent" :argv ["build" "asl/packages/asl-cli/tests/fixtures/runMe.asl"] :env ["ASL_CLI_HOST_BIN=/nonexistent/asl-host" "ASL_HOST=/nonexistent/asl-host"] :stdout "" :stderr "(:build :status :failed :error ERR_HOST_ABSENT :message \"asl build needs stage-0 host at asl/host/out/asl-host; build it with sh asl/host/build.sh or set ASL_HOST\")\n" :exit 2)
  (:case :id "runHelp" :argv ["run" "--help"] :stdout "usage: asl run FILE [ARGS]   load FILE and call its main; exit 0 iff main returns (ok ...)\n" :stderr "" :exit 0)
  (:case :id "runHelpShort" :argv ["run" "-h"] :stdout "usage: asl run FILE [ARGS]   load FILE and call its main; exit 0 iff main returns (ok ...)\n" :stderr "" :exit 0)
  (:case :id "packHelp" :argv ["pack" "--help"] :stdout "usage: asl pack [--plan|--check|--stage DIR] [--quick] [--install] [--skip-gates] [--target PLATFORM] [--version V] [--all] [--keep-intermediates] [PLATFORM]\n  --plan   print the stages and inputs a build would use; builds nothing, runs no gates\n  --check  verify prerequisites (stage-0 host, static gate checks); builds nothing\n  --stage DIR  lay out the darwin-arm64 tree in DIR from the files as they are; builds nothing\n" :stderr "" :exit 0)
  (:case :id "packHelpShort" :argv ["pack" "-h"] :stdout "usage: asl pack [--plan|--check|--stage DIR] [--quick] [--install] [--skip-gates] [--target PLATFORM] [--version V] [--all] [--keep-intermediates] [PLATFORM]\n  --plan   print the stages and inputs a build would use; builds nothing, runs no gates\n  --check  verify prerequisites (stage-0 host, static gate checks); builds nothing\n  --stage DIR  lay out the darwin-arm64 tree in DIR from the files as they are; builds nothing\n" :stderr "" :exit 0)
  (:case :id "packQuickHelp" :argv ["pack" "--quick" "--help"] :stdout "usage: asl pack [--plan|--check|--stage DIR] [--quick] [--install] [--skip-gates] [--target PLATFORM] [--version V] [--all] [--keep-intermediates] [PLATFORM]\n  --plan   print the stages and inputs a build would use; builds nothing, runs no gates\n  --check  verify prerequisites (stage-0 host, static gate checks); builds nothing\n  --stage DIR  lay out the darwin-arm64 tree in DIR from the files as they are; builds nothing\n" :stderr "" :exit 0)
  (:case :id "packUnknownFlag" :argv ["pack" "--zzz"] :stdout "" :stderr "asl pack: unknown flag --zzz (see asl pack --help)\n" :exit 2)
  (:case :id "packPlan" :argv ["pack" "--plan"] :stdout "(:packPlan :target \"all\" :version \"0.1.0\" :stages (\n  (:stage 1 :do \"asl audit gates --static; asl check .asl.config.asn; asl audit consistency\" :skipped false)\n  (:stage 2 :do \"dist/v0.1.0: wasm32 via tools/compileWasm.asl, darwin-arm64 and linux-x64 tarballs\" :quick false)))\n" :stderr "" :exit 0)
  (:case :id "packPlanFlags" :argv ["pack" "--plan" "--skip-gates" "--quick" "--version" "2.0" "linux-x64"] :stdout "(:packPlan :target \"linux-x64\" :version \"2.0\" :stages (\n  (:stage 1 :do \"asl audit gates --static; asl check .asl.config.asn; asl audit consistency\" :skipped true)\n  (:stage 2 :do \"dist/v2.0: wasm32 via tools/compileWasm.asl, darwin-arm64 and linux-x64 tarballs\" :quick true)))\n" :stderr "" :exit 0)
