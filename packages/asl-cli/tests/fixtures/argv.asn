  (:case :id "packPlanAll" :argv ["pack" "linux-x64" "--all" "--plan"] :stdout "(:packPlan :target \"all\" :version \"0.1.0\" :stages (\n  (:stage 1 :do \"asl audit gates --static; asl check .asl.config.asn; asl audit consistency\" :skipped false)\n  (:stage 2 :do \"dist/v0.1.0: wasm32 via tools/compileWasm.asl, darwin-arm64 and linux-x64 tarballs\" :quick false)))\n" :stderr "" :exit 0)
  (:case :id "packPlanDist" :argv ["pack" "--dist" "--plan" "-q"] :stdout "(:packPlan :target \"all\" :version \"0.1.0\" :stages (\n  (:stage 1 :do \"asl audit gates --static; asl check .asl.config.asn; asl audit consistency\" :skipped false)\n  (:stage 2 :do \"dist/v0.1.0: wasm32 via tools/compileWasm.asl, darwin-arm64 and linux-x64 tarballs\" :quick true)))\n" :stderr "" :exit 0)
  (:case :id "packStageNoDir" :argv ["pack" "--stage"] :stdout "" :stderr "" :exit 1)
  (:case :id "packTargetLast" :argv ["pack" "--target"] :stdout "" :stderr "" :exit 1)
  (:case :id "testBareTraceHostAbsent" :argv ["test" "--trace"] :env ["ASL_CLI_HOST_BIN=/nonexistent/asl-host" "ASL_HOST=/nonexistent/asl-host"] :stdout "(:test :status :failed :error ERR_HOST_ABSENT :message \"asl test needs the stage-0 host at asl/host/out/asl-host; build it with sh asl/host/build.sh or set ASL_HOST\")\n" :stderr "" :exit 2)
  (:case :id "checkBareHostAbsent" :argv ["check"] :env ["ASL_CLI_HOST_BIN=/nonexistent/asl-host" "ASL_HOST=/nonexistent/asl-host"] :stdout "(:check :status :failed :error ERR_HOST_ABSENT :message \"asl check needs the stage-0 host at asl/host/out/asl-host; build it with sh asl/host/build.sh or set ASL_HOST\")\n" :stderr "" :exit 2)
  (:case :id "testUnknownOptionAfterFile" :argv ["test" "asl/packages/asl-cli/tests/fixtures/testOk.asl" "-x"] :stdout "(:test :status :failed :error ERR_UNKNOWN_ARG :message \"asl test takes files and directories; unknown option -x\")\n" :stderr "" :exit 2)
  (:case :id "testMissingFile" :argv ["test" "nofile.asl"] :stdout "" :stderr "nofile.asl:0:0: ERR_IO cannot open file\nFAIL nofile.asl: 1 load error(s) (after 0 asserts)\n" :exit 1)
  (:case :id "launchBadModeOtherRoot" :argv ["launch" "claude" "--mode" "nonsense"] :env ["ASL_ROOT=/nonexistent/root"] :stdout "" :stderr "launch: --mode takes one of distill, grade, implement, scout (the :modes of harness.asn)\n" :exit 2)
  (:case :id "launchBadOptionOtherRoot" :argv ["launch" "codex" "--bogus"] :env ["ASL_ROOT=/nonexistent/root"] :stdout "" :stderr "launch: codex not found on PATH\n" :exit 1)
  (:case :id "sweepBare" :argv ["test"] :env ["ASL_ROOT=$SWEEP" "ASL_JOBS=2"] :stdout "(:fail :file \"tests/failTest.asl\" :exit 1 :ev \"FAIL tests/failTest.asl: ERR_ASSERT: assertion failed: four letters make five (after 2 asserts)\")\n(:fail :file \"tests/zeroTest.asl\" :exit 1 :ev \"FAIL tests/zeroTest.asl: ERR_TEST_FAILED: zero assertions executed (after 0 asserts)\")\n(:sweep :verb test :runner \"asl-host\" :status :failed :files 3 :passed 1 :failed 2 :executedAsserts 1 :executedRefutes 1 :frozen 0)\n" :stderr "" :exit 1)
  (:case :id "sweepBareOneJob" :argv ["test"] :env ["ASL_ROOT=$SWEEP" "ASL_JOBS=1"] :stdout "(:fail :file \"tests/failTest.asl\" :exit 1 :ev \"FAIL tests/failTest.asl: ERR_ASSERT: assertion failed: four letters make five (after 2 asserts)\")\n(:fail :file \"tests/zeroTest.asl\" :exit 1 :ev \"FAIL tests/zeroTest.asl: ERR_TEST_FAILED: zero assertions executed (after 0 asserts)\")\n(:sweep :verb test :runner \"asl-host\" :status :failed :files 3 :passed 1 :failed 2 :executedAsserts 1 :executedRefutes 1 :frozen 0)\n" :stderr "" :exit 1)
  (:case :id "sweepBadJobs" :argv ["test"] :env ["ASL_ROOT=$SWEEP" "ASL_JOBS=many"] :stdout "" :stderr "(:sweep :status :failed :error ERR_NOT_A_WORKSPACE :message \"ASL_JOBS is not an integer: many\")\n" :exit 1)
  (:case :id "changedUsage" :argv ["test" "--changed" "a" "b"] :stdout "(:changed :status :failed :error ERR_USAGE :message \"asl test --changed [BASE] [--dry-run]\")\n" :stderr "" :exit 2)
])
