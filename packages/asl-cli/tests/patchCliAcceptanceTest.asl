(module asl-cli/tests/patchCliAcceptanceTest :x [RunTests runTests] :i [(asl-cli/patch :a cliPatch) (asl-ir/patch :a irPatch) (asl-tools/fleet/run :a run)])

fn isOk? r: (Result T E) -> Bool
  (match r ((ok _) true) ((err _) false))

fn isErr? r: (Result T E) -> Bool
  (match r ((ok _) false) ((err _) true))

fn sampleSourceModule -> Str
  (str "(module sample/mathEngine\n" "  :x [addNumbers multiplyNumbers])\n\n" "(df addNumbers [(a Int64) (b Int64)] -> Int64\n" "  (+ a b))\n\n" "(df multiplyNumbers [(a Int64) (b Int64)] -> Int64\n" "  (* a b))\n")

fn samplePatchAsnText patchId: Str preRoot: Str -> Str
  (let [(preRootField (if (stringEmpty? preRoot) "" (str "  :preRoot \"" preRoot "\"\n")))] (str "(:astPatch\n" "  :id \"" patchId "\"\n" "  :targetModule \"sample/mathEngine\"\n" preRootField "  :ops [\n" "    (:replace\n" "      :target \"sample/mathEngine:addNumbers\"\n" "      :anchor \"body\"\n" "      :oldNode \"(+ a b)\"\n" "      :newNode \"(- a b)\")\n" "  ])\n"))

fn sampleSecondPatchAsnText patchId: Str preRoot: Str -> Str
  (let [(preRootField (if (stringEmpty? preRoot) "" (str "  :preRoot \"" preRoot "\"\n")))] (str "(:astPatch\n" "  :id \"" patchId "\"\n" "  :targetModule \"sample/mathEngine\"\n" preRootField "  :ops [\n" "    (:replace\n" "      :target \"sample/mathEngine:multiplyNumbers\"\n" "      :anchor \"body\"\n" "      :oldNode \"(* a b)\"\n" "      :newNode \"(/ a b)\")\n" "  ])\n"))

fn testMerkleRootValidation -> Bool
  (let [(h1 "d81a9f02c") (h2 "d81a9f02c") (h3 "999ffffff")] (assert (cliPatch/validateMerkleRoot "" h1) "Empty expected Merkle root accepts any actual root") (assert (cliPatch/validateMerkleRoot h1 h2) "Identical Merkle roots validate successfully") (assert (not (cliPatch/validateMerkleRoot h1 h3)) "Divergent Merkle roots fail validation") (assert (not (cliPatch/validateMerkleRoot h3 h1)) "Asymmetric Merkle roots fail validation") (refute (cliPatch/validateMerkleRoot h1 h3) "Refutation: Divergent Merkle root cannot validate") (refute (not (cliPatch/validateMerkleRoot h1 h2)) "Refutation: Identical Merkle roots cannot fail") (refute (not (cliPatch/validateMerkleRoot "" h3)) "Refutation: Empty expected root cannot fail") (refute (cliPatch/validateMerkleRoot "rootA" "rootB") "Refutation: Explicit mismatch cannot validate") true)

fn testDisjointCommutativity -> Bool
  (let [(p1Res (irPatch/parsePatch (samplePatchAsnText "p1" ""))) (p2Res (irPatch/parsePatch (sampleSecondPatchAsnText "p2" ""))) (pConflictRes (irPatch/parsePatch (samplePatchAsnText "pConflict" "")))] (match p1Res ((err d1) (do (assert false (str "p1 parse failed: " d1.message)) false)) ((ok p1) (match p2Res ((err d2) (do (assert false (str "p2 parse failed: " d2.message)) false)) ((ok p2) (match pConflictRes ((err d3) (do (assert false (str "pConflict parse failed: " d3.message)) false)) ((ok pConflict) (do (assert (cliPatch/checkDisjointCommutativity p1 p2) "Disjoint patches targeting distinct anchors must commute") (assert (cliPatch/checkDisjointCommutativity p2 p1) "Commutativity relation must be symmetric across disjoint anchors") (assert (not (cliPatch/checkDisjointCommutativity p1 pConflict)) "Overlapping patches targeting same anchor must not commute") (assert (not (cliPatch/checkDisjointCommutativity p1 p1)) "Identical patches targeting same anchor must not commute") (refute (not (cliPatch/checkDisjointCommutativity p1 p2)) "Refutation: Non-overlapping anchors must never fail commutativity check") (refute (cliPatch/checkDisjointCommutativity p1 pConflict) "Refutation: Overlapping anchors must never pass commutativity check") (refute (cliPatch/checkDisjointCommutativity p1 p1) "Refutation: Identical anchors must never pass commutativity check") (refute (not (cliPatch/checkDisjointCommutativity p2 p1)) "Refutation: Symmetric check must not fail") true))))))))

fn testPatchStackSerializationRoundtrip -> Bool
  (let [(inv (irPatch/makeReplacePatch "inv-01" "sample/mathEngine" "sample/mathEngine:addNumbers" "body" "(- a b)" "(+ a b)")) (e1 (cliPatch/makeRollbackEntry "patch-01" "tmp/test_target.asl" "sample/mathEngine" "hashPre1" "hashPost1" inv 1789720001000)) (e2 (cliPatch/makeRollbackEntry "patch-02" "tmp/test_target2.asl" "sample/mathEngine" "hashPre2" "hashPost2" inv 1789720002000)) (entries (list e1 e2)) (rendered (cliPatch/renderPatchStackFile entries)) (parsed (cliPatch/parsePatchStackFile rendered))] (assert (= (listLength parsed) 2) "Parsed stack must contain exactly 2 rollback entries") (assert (stringContains? rendered ":patch-stack") "Rendered stack must include :patch-stack wrapper") (assert (stringContains? rendered "patch-01") "Rendered stack must contain patch-01") (assert (stringContains? rendered "patch-02") "Rendered stack must contain patch-02") (match (listHead parsed) ((some firstEntry) (do (assert (= firstEntry.patchId "patch-01") "First entry patchId matches") (assert (= firstEntry.targetFile "tmp/test_target.asl") "First entry targetFile matches") (assert (= firstEntry.preRoot "hashPre1") "First entry preRoot matches") (assert (= firstEntry.postRoot "hashPost1") "First entry postRoot matches") (refute (!= firstEntry.targetModule "sample/mathEngine") "Refutation: TargetModule must match") (refute (!= firstEntry.timestamp 1789720001000) "Refutation: Timestamp must match") (refute (stringEmpty? firstEntry.patchId) "Refutation: Patch ID cannot be empty") (refute (!= firstEntry.preRoot "hashPre1") "Refutation: PreRoot cannot diverge") true)) ((none) (do (assert false "Parsed stack must not be empty") false))))

fn testOptimisticConcurrencyAndApplication! -> Bool
  (let [(targetPath "tmp/test_target_concurrency.asl") (patchValidPath "tmp/test_patch_valid.asn") (patchStalePath "tmp/test_patch_stale.asn") (src (sampleSourceModule)) (w1 (fileWrite targetPath src)) (preDigest (irPatch/computeAstDigest src)) (validPatchText (samplePatchAsnText "p-valid-01" preDigest)) (stalePatchText (samplePatchAsnText "p-stale-01" "mismatched_stale_merkle_root_99999")) (w2 (fileWrite patchValidPath validPatchText)) (w3 (fileWrite patchStalePath stalePatchText))] (assert (isOk? w1) "Target file written successfully") (assert (isOk? w2) "Valid patch file written successfully") (assert (isOk? w3) "Stale patch file written successfully") (let [(staleRes (cliPatch/executePatchApply! patchStalePath (some targetPath)))] (match staleRes ((ok _) (do (assert false "Stale patch with mismatched preRoot must fail application") false)) ((err errMsg) (do (assert (stringContains? errMsg ":concurrencyConflict") "Error receipt must specify :concurrencyConflict") (assert (stringContains? errMsg "mismatched_stale_merkle_root_99999") "Error receipt must report expected root") (assert (stringContains? errMsg preDigest) "Error receipt must report actual diverged digest") (assert (stringContains? errMsg ":divergedAnchors") "Error receipt must list diverged anchor keys") (refute (stringContains? errMsg ":status :ok") "Refutation: Concurrency failure cannot contain :status :ok") (refute (not (stringContains? errMsg ":concurrencyConflict")) "Refutation: Concurrency conflict marker cannot be missing") true)))) (let [(applyRes (cliPatch/executePatchApply! patchValidPath (some targetPath)))] (match applyRes ((err errMsg) (do (assert false (str "Valid patch application must succeed, but got error: " errMsg)) false)) ((ok receipt) (do (assert (stringContains? receipt ":status :ok") "Valid patch receipt must report :status :ok") (assert (stringContains? receipt "p-valid-01") "Valid patch receipt must identify patch ID") (assert (stringContains? receipt preDigest) "Valid patch receipt must record preRoot") (refute (stringContains? receipt ":status :rejected") "Refutation: Valid application cannot be rejected") (refute (stringContains? receipt ":concurrencyConflict") "Refutation: Valid application cannot have concurrency conflict") (let [(patchedRead (fileReadString targetPath))] (match patchedRead ((err _) (do (assert false "Reading target file after apply failed") false)) ((ok patchedText) (do (assert (stringContains? patchedText "(- a b)") "Target file on disk must reflect patched expression") (assert (not (stringContains? patchedText "(+ a b)")) "Target file on disk must not retain old expression") (refute (stringContains? patchedText "(+ a b)") "Refutation: Old expression must not exist on disk") (refute (not (stringContains? patchedText "(- a b)")) "Refutation: New expression must exist on disk") true)))))))))

fn testPatchCheckDryRun! -> Bool
  (let [(targetPath "tmp/test_target_check.asl") (patchPath "tmp/test_patch_check.asn") (src (sampleSourceModule)) (w1 (fileWrite targetPath src)) (preDigest (irPatch/computeAstDigest src)) (patchText (samplePatchAsnText "p-check-01" preDigest)) (w2 (fileWrite patchPath patchText))] (assert (isOk? w1) "Target file for check written successfully") (assert (isOk? w2) "Patch file for check written successfully") (let [(checkRes (cliPatch/executePatchCheck! patchPath (some targetPath)))] (match checkRes ((err errMsg) (do (assert false (str "Check on valid patch must succeed, but got error: " errMsg)) false)) ((ok receipt) (do (assert (stringContains? receipt ":action :check") "Receipt action is :check") (assert (stringContains? receipt ":status :ok") "Receipt status is :ok") (assert (stringContains? receipt "p-check-01") "Receipt identifies patch ID") (refute (stringContains? receipt ":status :rejected") "Refutation: Valid check must not be rejected") (refute (stringContains? receipt ":concurrencyConflict") "Refutation: Valid check cannot report conflict") (let [(readRes (fileReadString targetPath))] (match readRes ((err _) (do (assert false "Reading target file after check failed") false)) ((ok contentAfterCheck) (do (assert (= (irPatch/computeAstDigest contentAfterCheck) preDigest) "Target file on disk must be completely untouched by check") (assert (stringContains? contentAfterCheck "(+ a b)") "Target file must retain original source text") (refute (stringContains? contentAfterCheck "(- a b)") "Refutation: Check cannot modify source on disk") (refute (!= (irPatch/computeAstDigest contentAfterCheck) preDigest) "Refutation: Digest after check must not change") true)))))))))

fn testRollbackStackDirtyStateDefenseAndRestore! -> Bool
  (let [(targetPath "tmp/test_target_rollback.asl") (patchPath "tmp/test_patch_rollback.asn") (src (sampleSourceModule)) (w1 (fileWrite targetPath src)) (preDigest (irPatch/computeAstDigest src)) (patchText (samplePatchAsnText "p-rollback-01" preDigest)) (w2 (fileWrite patchPath patchText))] (assert (isOk? w1) "Target file written") (assert (isOk? w2) "Patch file written") (let [(applyRes (cliPatch/executePatchApply! patchPath (some targetPath))) (patchedSrc (match (fileReadString targetPath) ((ok s) s) ((err _) "")))] (assert (isOk? applyRes) "Apply before rollback must succeed") (let [(tamperWrite (fileWrite targetPath "(module external/drift)"))] (assert (isOk? tamperWrite) "External tamper write succeeded") (let [(dirtyRollbackRes (cliPatch/executePatchRollback! (some 1)))] (match dirtyRollbackRes ((ok _) (do (assert false "Rollback must be rejected when external file drift occurred") false)) ((err errMsg) (do (assert (stringContains? errMsg ":dirtyRollbackState") "Error receipt must report :dirtyRollbackState") (assert (stringContains? errMsg "Refusing rollback: external file drift detected") "Error receipt explains refusal") (refute (stringContains? errMsg ":status :ok") "Refutation: Dirty rollback must never return :status :ok") (refute (not (stringContains? errMsg ":dirtyRollbackState")) "Refutation: Dirty state marker must be present") (let [(fixWrite (fileWrite targetPath patchedSrc))] (assert (isOk? fixWrite) "Restoring expected postRoot on disk succeeded") (let [(cleanRollbackRes (cliPatch/executePatchRollback! (some 1)))] (match cleanRollbackRes ((err cleanErr) (do (assert false (str "Clean rollback should succeed, got error: " cleanErr)) false)) ((ok receipt) (do (assert (stringContains? receipt ":action :rollback") "Rollback receipt action is :rollback") (assert (stringContains? receipt ":status :ok") "Rollback receipt status is :ok") (assert (stringContains? receipt "p-rollback-01") "Rollback receipt identifies reverted patch ID") (refute (stringContains? receipt ":dirtyRollbackState") "Refutation: Clean rollback cannot report dirty state") (refute (stringContains? receipt ":status :rejected") "Refutation: Clean rollback cannot be rejected") (let [(diskRead (fileReadString targetPath))] (match diskRead ((err _) (do (assert false "Reading target file after rollback failed") false)) ((ok contentAfterRollback) (do (assert (stringContains? contentAfterRollback "(+ a b)") "Target file on disk has restored original operator (+ a b)") (refute (stringContains? contentAfterRollback "(- a b)") "Refutation: Patched operator (- a b) must be eradicated after rollback") true))))))))))))))))

fn testCliDispatcherOptions! -> Bool
  (do (match (cliPatch/runPatchCommand! (list)) ((ok msg) (do (assert (stringContains? msg "Usage: asl patch") "Empty args returns usage help") (assert (stringContains? msg "--apply") "Help contains --apply") (refute (stringContains? msg "Unknown flag") "Refutation: Empty args does not report unknown flag") true)) ((err _) (do (assert false "Empty args should return ok with usage help") false))) (match (cliPatch/runPatchCommand! (list "--help")) ((ok msg) (do (assert (stringContains? msg "Usage: asl patch") "--help returns usage help") (assert (stringContains? msg "--rollback") "Help contains --rollback") (refute (stringContains? msg "Error") "Refutation: Help does not contain error") true)) ((err _) (do (assert false "--help should succeed") false))) (match (cliPatch/runPatchCommand! (list "--check")) ((ok _) (do (assert false "--check without file argument must fail") false)) ((err msg) (do (assert (stringContains? msg "Usage: asl patch --check") "Missing argument error for --check") (refute (stringContains? msg ":status :ok") "Refutation: Missing arg error cannot report ok") true))) (match (cliPatch/runPatchCommand! (list "--apply")) ((ok _) (do (assert false "--apply without file argument must fail") false)) ((err msg) (do (assert (stringContains? msg "Usage: asl patch --apply") "Missing argument error for --apply") (refute (stringContains? msg ":status :ok") "Refutation: Missing arg error cannot report ok") true))) (match (cliPatch/runPatchCommand! (list "--non-existent-option-xyz")) ((ok _) (do (assert false "Unknown option must return error") false)) ((err msg) (do (assert (stringContains? msg "Unknown flag") "Unknown flag error reported") (refute (stringContains? msg "Usage: asl patch [options]") "Refutation: Unknown flag error is not generic usage") true))) true)

fn ! allCases -> Bool
  (and (testMerkleRootValidation) (and (testDisjointCommutativity) (and (testPatchStackSerializationRoundtrip) (and (testOptimisticConcurrencyAndApplication!) (and (testPatchCheckDryRun!) (and (testRollbackStackDirtyStateDefenseAndRestore!) (testCliDispatcherOptions!)))))))

fn ! restoreStack! path: String saved: (Result String String) -> Bool
  (match saved ((ok text) (ok? (fileWrite path text))) ((err _) (= (run/runOneLimited (run/job (list "rm" "-f" path) "." (run/childEnv (list))) (run/limits 180 8)).exit 0)))

fn ! runTests -> Bool
  (let [(stackPath ".asl/mem/patch_stack.asn")
        (madeTmp (= (run/runOneLimited (run/job (list "mkdir" "-p" "tmp") "." (run/childEnv (list))) (run/limits 180 8)).exit 0))
        (saved (fileReadString stackPath))
        (passed (allCases))]
    (do (assert madeTmp "fixture directory tmp/ exists")
        (assert (restoreStack! stackPath saved) "the workspace rollback stack is restored after the run")
        passed))

fn ! RunTests -> Bool
  (runTests)
