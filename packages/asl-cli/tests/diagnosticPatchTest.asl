(module asl-cli/tests/diagnosticPatchTest :x [RunTests runTests] :i [(asl-compiler/diagnostics :a diag) (asl-cli/check :a checkCli) (asl-cli/patch :a cliPatch) (asl-ir/patch :a irPatch) (asl-parser/reader :a rd) (asl-parser/lexer :a lx) (asl-parser/ast :a ast)])

fn isOk? r: (Result T E) -> Bool
  (match r ((ok _) true) ((err _) false))

fn isErr? r: (Result T E) -> Bool
  (match r ((ok _) false) ((err _) true))

fn sampleModuleMissingImport -> Str
  (str "(module sample/mathService\n" "  :x [computeSum]\n" "  :i [(asl-core/types :as ty)])\n\n" "(df computeSum [(a Int64) (b Int64)] -> Int64\n" "  (+ a b))\n")

fn sampleModuleUnhandledMatch -> Str
  (str "(module sample/optionService\n" "  :x [unwrapOrZero]\n" "  :i [])\n\n" "(df unwrapOrZero [(val (Option Int64))] -> Int64\n" "  (match val\n" "    ((some x) (+ x 1))))\n")

fn sampleModuleTypeMismatch -> Str
  (str "(module sample/stringService\n" "  :x [formatGreeting]\n" "  :i [])\n\n" "(df formatGreeting [(name Str)] -> Int64\n" "  (str \"Hello \" name))\n")

fn testDiagnosticModelAndConstruction -> Bool
  (let [(dummyPatch (diag/suggestMissingImportPatch "sample/mod" "(:i [])" "(asl-core/base :as base)")) (diagWithPatch (diag/emitDiagnosticWithPatch "ERR_UNBOUND_SYMBOL" "sample/mod:computeSum" "imports" "Unbound symbol 'base/id' requires import" (some dummyPatch))) (diagNoPatch (diag/makeSelfHealingDiagnostic "ERR_SYNTAX_ERROR" "sample/mod:syntax" "body" "Unclosed delimiter in expression" (none)))] (assert (= diagWithPatch.code "ERR_UNBOUND_SYMBOL") "diagnostic code matches") (assert (= diagWithPatch.symbol "sample/mod:computeSum") "diagnostic symbol matches") (assert (= diagWithPatch.anchor "imports") "diagnostic anchor matches") (assert (some? diagWithPatch.suggestedPatch) "suggested patch present") (assert (none? diagNoPatch.suggestedPatch) "suggested patch absent for syntax error") (refute (= diagWithPatch.code diagNoPatch.code) "distinct diagnostics have distinct codes") (refute (stringContains? diagWithPatch.symbol ":line") "Refutation: Zero-Line-Number Invariant: symbol contains no line number") (refute (stringContains? diagWithPatch.symbol "#L") "Refutation: Zero-Line-Number Invariant: symbol contains no line hash") (refute (stringContains? diagWithPatch.anchor "line") "Refutation: Zero-Line-Number Invariant: anchor contains no line numbers") true)

fn testMissingImportPatchGenerator -> Bool
  (let [(targetMod "sample/mathService") (existingImp "[(asl-core/types :as ty)]") (missingImp "(asl-core/base :as base)") (patchObj (diag/suggestMissingImportPatch targetMod existingImp missingImp)) (src (sampleModuleMissingImport))] (assert (= patchObj.targetModule targetMod) "patch target module matches") (assert (= (listLength patchObj.ops) 1) "patch contains exactly 1 atomic operation") (let [(op (optionOr (listHead patchObj.ops) (irPatch/makePatchOpReplace "" "" "" "")))] (match op ((irPatch/patchOpReplace tgt anc oldN newN) (do (assert (= tgt targetMod) "operation target matches module") (assert (= anc "imports") "operation anchor is imports") (assert (= oldN existingImp) "operation oldNode matches existing import clause") (assert (stringContains? newN "(asl-core/base :as base)") "newNode contains missing import") (assert (stringContains? newN "(asl-core/types :as ty)") "newNode preserves existing import") (refute (= oldN newN) "oldNode and newNode must differ") (refute (stringEmpty? newN) "newNode cannot be empty"))) (_ (assert false "expected patchOpReplace operation")))) (let [(verifyRes (irPatch/verifyPatch patchObj src))] (assert (isOk? verifyRes) "suggested import patch passes in-memory validation") (refute (isErr? verifyRes) "valid import patch produces zero diagnostics")) (let [(applyRes (irPatch/applyPatch patchObj src))] (assert applyRes.success "suggested import patch applies cleanly") (assert (stringContains? applyRes.patchedSource "(asl-core/base :as base)") "patched source contains new import") (assert (stringContains? applyRes.patchedSource "(asl-core/types :as ty)") "patched source preserves existing import") (refute (= applyRes.patchedSource src) "patched source differs from baseline") (let [(invOpt applyRes.inversePatch)] (assert (match invOpt ((some _) true) ((none) false)) "applyPatch generates inverse patch") (match invOpt ((some inv) (let [(rollbackRes (irPatch/applyPatch inv applyRes.patchedSource))] (assert rollbackRes.success "inverse patch applies cleanly") (assert (stringContains? rollbackRes.patchedSource "(asl-core/types :as ty)") "inverse patch retains existing import") (refute (stringContains? rollbackRes.patchedSource "(asl-core/base :as base)") "inverse patch removes added import"))) ((none) (assert false "inverse patch must exist"))))) (let [(corruptedPatch (irPatch/makeAstPatch "corrupt-import" targetMod (none) (none) (list (irPatch/makePatchOpReplace targetMod "imports" "(:i [unbalanced(" "(:i [broken)"))))] (let [(corruptVerify (irPatch/verifyPatch corruptedPatch src))] (assert (isErr? corruptVerify) "corrupted import patch is rejected by validator") (refute (isOk? corruptVerify) "corrupted patch cannot be verified as valid") (match corruptVerify ((err diags) (assert (not (listEmpty? diags)) "corrupted patch produces diagnostics")) ((ok _) (assert false "expected corrupted patch to fail"))))) true)

fn testMissingMatchBranchPatchGenerator -> Bool
  (let [(targetMod "sample/optionService") (fnSym "unwrapOrZero") (oldMatch "(match val ((some x) (+ x 1)))") (missingBranch "((none) 0)") (patchObj (diag/suggestMissingMatchBranchPatch targetMod fnSym oldMatch missingBranch)) (src (sampleModuleUnhandledMatch))] (assert (= patchObj.targetModule targetMod) "match patch target module matches") (assert (= (listLength patchObj.ops) 1) "match patch has 1 operation") (let [(op (optionOr (listHead patchObj.ops) (irPatch/makePatchOpReplace "" "" "" "")))] (match op ((irPatch/patchOpReplace tgt anc oldN newN) (do (assert (= tgt fnSym) "operation target matches function symbol") (assert (= anc "body") "operation anchor is body") (assert (stringContains? newN "((none) 0)") "newNode contains missing variant arm") (assert (stringContains? newN "((some x) (+ x 1))") "newNode preserves existing variant arm") (refute (= oldN newN) "match oldNode and newNode must differ") (refute (stringContains? oldN "((none) 0)") "oldNode lacks missing variant arm"))) (_ (assert false "expected patchOpReplace for match branch")))) (let [(verifyRes (irPatch/verifyPatch patchObj src))] (assert (isOk? verifyRes) "suggested match patch passes in-memory validation") (refute (isErr? verifyRes) "valid match patch produces zero diagnostics")) (let [(applyRes (irPatch/applyPatch patchObj src))] (assert applyRes.success "suggested match patch applies cleanly") (assert (stringContains? applyRes.patchedSource "((none) 0)") "patched source contains unhandled variant") (assert (stringContains? applyRes.patchedSource "((some x) (+ x 1))") "patched source retains existing arm") (refute (= applyRes.patchedSource src) "patched source must differ from original") (let [(invOpt applyRes.inversePatch)] (assert (match invOpt ((some _) true) ((none) false)) "inverse patch generated for match repair") (match invOpt ((some inv) (let [(rollbackRes (irPatch/applyPatch inv applyRes.patchedSource))] (assert rollbackRes.success "inverse patch for match applies cleanly") (assert (stringContains? rollbackRes.patchedSource "((some x) (+ x 1))") "rollback restores original unhandled match state") (refute (stringContains? rollbackRes.patchedSource "((none) 0)") "rollback removes added variant arm"))) ((none) (assert false "inverse patch must exist for match repair"))))) (let [(malformedBranch "((none) unclosed") (badPatch (diag/suggestMissingMatchBranchPatch targetMod fnSym oldMatch malformedBranch)) (badVerify (irPatch/verifyPatch badPatch src))] (assert (isErr? badVerify) "malformed match branch syntax is rejected by validator") (refute (isOk? badVerify) "syntax errors must not validate") (match badVerify ((err diags) (assert (not (listEmpty? diags)) "malformed branch generates error diagnostics")) ((ok _) (assert false "malformed branch should fail verification")))) true)

fn testTypeMismatchAndExportPatchGenerators -> Bool
  (let [(targetMod "sample/stringService") (fnSym "formatGreeting") (typePatch (diag/suggestTypeMismatchPatch targetMod fnSym "Int64" "Str")) (src (sampleModuleTypeMismatch))] (assert (= typePatch.targetModule targetMod) "type patch target module matches") (let [(op (optionOr (listHead typePatch.ops) (irPatch/makePatchOpRetype "" "" "" "")))] (match op ((irPatch/patchOpRetype tgt anc oldT newT) (do (assert (= tgt fnSym) "type op target matches function") (assert (= anc "retType") "type op anchor is retType") (assert (= oldT "Int64") "old return type is Int64") (assert (= newT "Str") "new return type is Str") (refute (= oldT newT) "old and new types must differ"))) (_ (assert false "expected patchOpRetype operation")))) (let [(verifyRes (irPatch/verifyPatch typePatch src))] (assert (isOk? verifyRes) "type mismatch candidate patch validates cleanly") (refute (isErr? verifyRes) "valid type patch has 0 diagnostics")) (let [(applyRes (irPatch/applyPatch typePatch src))] (assert applyRes.success "type mismatch candidate patch applies cleanly") (assert (stringContains? applyRes.patchedSource "-> Str") "patched source has corrected return type") (refute (stringContains? applyRes.patchedSource "-> Int64") "patched source no longer has wrong return type")) (let [(existingExp "[:x [computeSum]]") (exportPatch (diag/suggestMissingExportPatch targetMod existingExp "formatGreeting"))] (assert (= exportPatch.targetModule targetMod) "export patch target module matches") (let [(expOp (optionOr (listHead exportPatch.ops) (irPatch/makePatchOpReplace "" "" "" "")))] (match expOp ((irPatch/patchOpReplace tgt anc oldN newN) (do (assert (= tgt targetMod) "export op target matches module") (assert (= anc "exports") "export op anchor is exports") (assert (stringContains? newN "formatGreeting") "newNode contains new exported symbol") (assert (stringContains? newN "computeSum") "newNode preserves existing exports") (refute (= oldN newN) "old and new export nodes must differ"))) (_ (assert false "expected patchOpReplace for export patch"))))) true)

fn testReceiptSerializationAndZeroLineNumber -> Bool
  (let [(dummyPatch (diag/suggestMissingImportPatch "mathPkg" "(:i [])" "(core :a c)")) (diagObj (diag/emitDiagnosticWithPatch "ERR_UNBOUND_SYMBOL" "mathPkg:add" "imports" "Unbound symbol 'core/id' requires import" (some dummyPatch))) (rendered (diag/formatDiagnosticWithPatch diagObj))] (assert (stringContains? rendered "(:diagnostic") "rendered receipt starts with :diagnostic") (assert (stringContains? rendered ":code \"ERR_UNBOUND_SYMBOL\"") "rendered receipt contains :code") (assert (stringContains? rendered ":symbol \"mathPkg:add\"") "rendered receipt contains :symbol") (assert (stringContains? rendered ":anchor \"imports\"") "rendered receipt contains :anchor") (assert (stringContains? rendered ":message \"Unbound symbol 'core/id' requires import\"") "rendered receipt contains :message") (assert (stringContains? rendered ":suggestedPatch") "rendered receipt contains :suggestedPatch") (assert (stringContains? rendered "(:astPatch") "rendered receipt contains nested :astPatch") (refute (stringContains? rendered ":line") "Zero-line-number invariant: no :line in formatted diagnostic") (refute (stringContains? rendered ":col") "Zero-line-number invariant: no :col in formatted diagnostic") (refute (stringContains? rendered "#L") "Zero-line-number invariant: no #L in formatted diagnostic") (let [(parseRes (diag/parseDiagnosticReceipt rendered))] (assert (isOk? parseRes) "parseDiagnosticReceipt succeeds on valid rendered receipt") (refute (isErr? parseRes) "parseDiagnosticReceipt does not fail") (match parseRes ((err _) (assert false "expected successful receipt parsing")) ((ok parsedDiag) (do (assert (= parsedDiag.code "ERR_UNBOUND_SYMBOL") "parsed code matches") (assert (= parsedDiag.symbol "mathPkg:add") "parsed symbol matches") (assert (= parsedDiag.anchor "imports") "parsed anchor matches") (assert (= parsedDiag.message "Unbound symbol 'core/id' requires import") "parsed message matches") (assert (match parsedDiag.suggestedPatch ((some _) true) ((none) false)) "parsed diagnostic holds candidate patch") (refute (stringEmpty? parsedDiag.code) "parsed code cannot be empty"))))) (let [(badReceipt "(:diagnostic :message \"no code or symbol\")") (badParse (diag/parseDiagnosticReceipt badReceipt))] (assert (isErr? badParse) "parseDiagnosticReceipt fails on receipt missing mandatory fields") (refute (isOk? badParse) "corrupted receipt must not parse successfully")) (let [(nonDiagReceipt "(:otherForm :val 123)") (nonDiagParse (diag/parseDiagnosticReceipt nonDiagReceipt))] (assert (isErr? nonDiagParse) "parseDiagnosticReceipt fails on non-diagnostic form") (refute (isOk? nonDiagParse) "non-diagnostic form must not parse as diagnostic")) true)

fn testCheckCliHelpAndDiagnostics! -> Bool
  (do (let [(helpOut (checkCli/formatCheckHelp))] (assert (stringContains? helpOut "Usage: asl check") "help manual contains usage") (assert (stringContains? helpOut "--fix") "help manual describes --fix option") (assert (stringContains? helpOut "GroundTruthOverReport") "help manual cites GroundTruthOverReport principle") (assert (stringContains? helpOut "ERR_NOT_IMPLEMENTED") "help manual states --fix is not implemented") (refute (stringContains? helpOut ":line") "Zero-line-number invariant in CLI help") (refute (stringContains? helpOut ":col") "Zero-col invariant in CLI help")) (match (checkCli/runCheckCommand! (list)) ((ok _) (assert false "empty check command must fail")) ((err msg) (do (assert (stringContains? msg "Usage: asl check") "empty check returns usage error") (refute (stringEmpty? msg) "usage error message is not empty")))) (match (checkCli/runCheckCommand! (list "--help")) ((err _) (assert false "check --help should succeed")) ((ok msg) (do (assert (stringContains? msg "Usage: asl check") "check --help returns usage guide") (assert (stringContains? msg "--fix") "check --help mentions --fix")))) (let [(cleanSrc "(module test/cleanMod :x [foo] :i []) (df foo [] -> Int64 42)") (cleanRes (checkCli/checkSourceWithFix "tmp/clean.asl" cleanSrc false))] (assert (isOk? cleanRes) "clean source passes check without diagnostics") (refute (isErr? cleanRes) "clean source produces no check errors") (match cleanRes ((ok out) (assert (stringContains? out "Semantic check passed cleanly") "clean check success message")) ((err _) (assert false "clean check should succeed")))) (let [(unboundSrc "(module test/unboundMod :x [run] :i [(asl-core/types :as ty)])\n(df run [] -> Int64 0)") (noFixRes (checkCli/checkSourceWithFix "tmp/unbound.asl" unboundSrc false))] (assert (isErr? noFixRes) "unbound import without --fix returns diagnostic error") (refute (isOk? noFixRes) "unbound import must not pass check without fix") (match noFixRes ((err diagStr) (do (assert (stringContains? diagStr "unresolved-import") "diagnostic names the unresolved import") (assert (stringContains? diagStr "asl-core/types") "diagnostic names the missing module") (assert (stringContains? diagStr "tmp/unbound.asl:1:1") "diagnostic carries the file position"))) ((ok _) (assert false "unbound source should produce diagnostic error")))) (match (checkCli/runCheckCommand! (list "--fix" "tmp/unbound.asl")) ((ok _) (assert false "check --fix must not report success")) ((err fixMsg) (assert (stringContains? fixMsg "ERR_NOT_IMPLEMENTED") "check --fix fails with ERR_NOT_IMPLEMENTED"))) true)

fn ! runTests -> Bool
  (and (testDiagnosticModelAndConstruction) (and (testMissingImportPatchGenerator) (and (testMissingMatchBranchPatchGenerator) (and (testTypeMismatchAndExportPatchGenerators) (and (testReceiptSerializationAndZeroLineNumber) (testCheckCliHelpAndDiagnostics!))))))

fn ! RunTests -> Bool
  (runTests)
