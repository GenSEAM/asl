(module asl-cli/target
  :x [targetCommand!]
  :i [(asl/packages/asl-cli/src/system :a sys)])

fn targetList -> String
  (str "Supported ASL compilation & distribution targets:\n"
       "  • sh, shell, posix-shell (macOS / Linux POSIX /bin/sh via asl-target-sh)\n"
       "  • ps1, powershell, windows-powershell (Windows PowerShell via asl-target-sh/emitPs1)\n"
       "  • cmd, bat, windows-cmd (Windows Command Prompt batch via asl-target-sh/emitCmd)\n"
       "  • distrib (Universal SSOT distribution generator: install.sh, install.ps1, asl.cmd)\n"
       "  • c, go, llvm, py, rs, swift, wat (Language targets via asl-target-*)")

fn rule -> String
  "# ============================================================================"

fn ps1Header -> String
  (str (rule) "\n"
       "# Generated by AgentSlang (ASL) Target Generator (asl-target-sh/emitPs1).\n"
       "# DO NOT EDIT THIS FILE BY HAND.\n"
       "# Single Source of Truth (SSOT): asl/packages/asl-target-sh/src/distrib.asl\n"
       "# All modifications must be made to the ASL source and compiled via: asl target distrib\n"
       (rule) "\n")

fn ! readText! path: String -> (Result String String)
  (mt (fileRead path)
    ((err _) (err (str "cannot read " path)))
    ((ok text) (ok (stringReplace (stringReplace text "\r\n" "\n") "\r" "\n"))))

fn ! writeText! path: String text: String -> (Result Unit String)
  (mt (fileWrite path text) ((err _) (err (str "cannot write " path))) ((ok _) (ok ())))

fn ! stampPs1! root: String -> (Result Unit String)
  (let [(path (str root "/scripts/install.ps1"))]
    (if (not (fileExists? path))
      (ok ())
      (mt (readText! path)
        ((err e) (err e))
        ((ok current)
          (if (stringStartsWith? current (rule))
            (do (sys/say! "✓ scripts/install.ps1 synchronized with ASL Windows PowerShell target.") (ok ()))
            (mt (writeText! path (str (ps1Header) current))
              ((err e) (err e))
              ((ok _) (do (sys/say! "✓ Generated scripts/install.ps1 from ASL Windows PowerShell target.") (ok ())))))))))

fn ! syncInstallers! source: String dests: (List String) -> (Result Unit String)
  (mt (listHead dests)
    ((none) (ok ()))
    ((some dest)
      (let [(rest (optionOr (listTail dests) (list)))]
        (if (not (and (fileExists? dest) (fileExists? source)))
          (syncInstallers! source rest)
          (mt (readText! source)
            ((err e) (err e))
            ((ok content)
              (mt (writeText! dest content)
                ((err e) (err e))
                ((ok _) (do (sys/say! (str "✓ Synchronized distribution installer: " dest)) (syncInstallers! source rest))))))))))

fn ! distrib! ctx: sys/Context -> Int64
  (let [(root ctx.root)
        (result (mt (stampPs1! root)
                  ((err e) (err e))
                  ((ok _) (syncInstallers! (str root "/scripts/install.sh")
                                           (list (str root "/asl/web/public/install.sh") (str root "/asl/dist/install.sh") (str root "/asl/web/dist/install.sh"))))))]
    (mt result
      ((err e) (do (sys/sayErr! (str "asl target distrib: " e)) 1))
      ((ok _) (do (sys/say! "✓ All distribution targets compiled and synchronized with ASL SSOT.") 0))))

fn ! skeleton! kind: String args: (List String) -> Int64
  (let [(src (optionOr (listHead args) ""))]
    (if (or (stringEmpty? src) (not (sys/isFile? src)))
      (do (sys/sayErr! (str "Usage: asl target " kind " <file.asl>")) 1)
      (do
        (cond
          ((= kind "sh") (sys/say! (str "#!/bin/sh\n# Generated by AgentSlang (ASL) Target Shell from " src "\nset -eu\n\nmain() {\n    return 0\n}\nmain")))
          ((= kind "ps1") (sys/say! (str "# Generated by AgentSlang (ASL) Target PowerShell from " src "\n$ErrorActionPreference = 'Stop'\nfunction Main {\n    return 0\n}\nMain")))
          (else (sys/say! (str "@echo off\n:: Generated by AgentSlang (ASL) Target CMD from " src "\nexit /b 0"))))
        0)))

fn ! targetCommand! ctx: sys/Context args: (List String) -> Int64
  (let [(given (optionOr (listHead args) ""))
        (sub (if (stringEmpty? given) "list" given))
        (rest (optionOr (listTail args) (list)))]
    (cond
      ((= sub "list") (do (sys/say! (targetList)) 0))
      ((= sub "distrib") (distrib! ctx))
      ((or (= sub "sh") (or (= sub "shell") (= sub "posix"))) (skeleton! "sh" rest))
      ((or (= sub "ps1") (= sub "powershell")) (skeleton! "ps1" rest))
      ((or (= sub "cmd") (= sub "bat")) (skeleton! "cmd" rest))
      (else (do (sys/sayErr! (str "Unknown target: " sub "\nRun '\\''asl target list'\\'' for available targets.")) 1))))
