(:grammar
  :package asl-cli
  :version "0.1.0"
  :tokensBaseline 1
  :symbols [

    (:sym :name "dispatch" :kind :fn :tokens 1)
    (:sym :name "dispatchCmd" :kind :fn :tokens 2)
    (:sym :name "dispatchRpc" :kind :fn :tokens 2)
    (:sym :name "evalBatch" :kind :fn :tokens 2)
    (:sym :name "executeCli" :kind :fn :tokens 2)
    (:sym :name "formatHelp" :kind :fn :tokens 2)
    (:sym :name "formatVersion" :kind :fn :tokens 2)
    (:sym :name "main" :kind :fn :tokens 1)
    (:sym :name "runTests" :kind :fn :tokens 2)
    (:sym :name "testHelp" :kind :fn :tokens 2)
    (:sym :name "testVersion" :kind :fn :tokens 2)

    (:sym :name "checkGateFiles" :kind :fn :tokens 3
          :rationale "Validates and gates each provided target file before dispatching gate verification")
    (:sym :name "testDispatchEval" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-eval': scopes test to CLI dispatcher handling of inline expression evaluation")
    (:sym :name "testDispatchGate" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-gate': tests the CLI command-line dispatcher specifically rather than running the verification gates themselves")
    (:sym :name "testDispatchMissing" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-missing': scopes test to CLI dispatcher argument validation rather than missing file lookups")
    (:sym :name "testDispatchTest" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-test': scopes test to CLI dispatcher test suite execution rather than recursive test runner")
    (:sym :name "testDispatchUnknown" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-unknown': scopes test to CLI subcommand dispatch fallback for invalid flags")
    (:sym :name "testDispatchVersion" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-version': scopes test to CLI version command dispatch rather than package semver parsing")
    (:sym :name "testMainDispatch" :kind :fn :tokens 3
          :rationale "Asserts command line argument dispatching through main module")
    (:sym :name "testVersionOutput" :kind :fn :tokens 3
          :rationale "Asserts canonical version string output formatting")
    (:sym :name "testHelpOutput" :kind :fn :tokens 3
          :rationale "Asserts command line help manual formatting and options")
    (:sym :name "testSubcommandsDispatch" :kind :fn :tokens 3
          :rationale "Asserts dispatching of language toolchain subcommands")
    (:sym :name "testEvalDispatch" :kind :fn :tokens 3
          :rationale "Asserts inline expression evaluation dispatch and math results")
  ])
