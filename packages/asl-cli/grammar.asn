;; Package Grammar & Exported Symbol Registry (ASN)
;; asl-cli
(:grammar
  :package asl-cli
  :version "0.1.0"
  :tokens-baseline 1
  :symbols [
    ;; 1-Token Baseline Types

    ;; <= 2-Token Primary API Symbols
    (:sym :name "dispatch-asn" :kind :fn :tokens 2)
    (:sym :name "dispatch-cmd" :kind :fn :tokens 2)
    (:sym :name "execute-cli" :kind :fn :tokens 2)
    (:sym :name "format-help" :kind :fn :tokens 2)
    (:sym :name "format-version" :kind :fn :tokens 2)
    (:sym :name "main" :kind :fn :tokens 1)
    (:sym :name "run-check" :kind :fn :tokens 2)
    (:sym :name "run-tests" :kind :fn :tokens 2)
    (:sym :name "test-help" :kind :fn :tokens 2)
    (:sym :name "test-version" :kind :fn :tokens 2)

    ;; Multi-Token Symbols (with :rationale)
    (:sym :name "asn-to-json-value" :kind :fn :tokens 4
          :rationale "Cannot be reduced to 'to-json': explicitly bounds transformation from ASN AST to JSON value types without string serialization")
    (:sym :name "format-asn-help" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'format-help': disambiguates ASN grammar-aware CLI usage help from standard UNIX man-style formatting")
    (:sym :name "run-from-json" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'run-json': distinguishes consuming stdin JSON payloads from executing JSON-formatted ASL source files")
    (:sym :name "run-to-json" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'run-json': distinguishes emitting JSON output from accepting JSON input")
    (:sym :name "test-dispatch-eval" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-eval': scopes test to CLI dispatcher handling of inline expression evaluation")
    (:sym :name "test-dispatch-gate" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-gate': tests the CLI command-line dispatcher specifically rather than running the verification gates themselves")
    (:sym :name "test-dispatch-missing" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-missing': scopes test to CLI dispatcher argument validation rather than missing file lookups")
    (:sym :name "test-dispatch-test" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-test': scopes test to CLI dispatcher test suite execution rather than recursive test runner")
    (:sym :name "test-dispatch-unknown" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-unknown': scopes test to CLI subcommand dispatch fallback for invalid flags")
    (:sym :name "test-dispatch-version" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-version': scopes test to CLI version command dispatch rather than package semver parsing")
  ])
