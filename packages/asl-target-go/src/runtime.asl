(module asl-target-go/runtime
  :x [runtimeText builtinNames entryNames]
  :i [])

fn runtimeText -> String
  (stringJoin
    ["import ("
     "	\"encoding/binary\""
     "	\"math\""
     "	\"os\""
     "	\"regexp\""
     "	\"strconv\""
     "	\"strings\""
     "	\"time\""
     ")"
     ""
     "type V = any"
     "type Fn = func(...V) V"
     ""
     "type AslTrap struct{ Code, Message string }"
     ""
     "func (t *AslTrap) Error() string { return t.Code + \": \" + t.Message }"
     ""
     "func trap(code, message string) V { panic(&AslTrap{code, message}) }"
     ""
     "type unitT struct{}"
     ""
     "var Unit V = unitT{}"
     ""
     "type Kw struct{ Name string }"
     "type Sym struct{ Name string }"
     ""
     "var kws, syms = map[string]*Kw{}, map[string]*Sym{}"
     ""
     "func kw(n string) V {"
     "	if k, ok := kws[n]; ok {"
     "		return k"
     "	}"
     "	kws[n] = &Kw{n}"
     "	return kws[n]"
     "}"
     "func sym(n string) V {"
     "	if k, ok := syms[n]; ok {"
     "		return k"
     "	}"
     "	syms[n] = &Sym{n}"
     "	return syms[n]"
     "}"
     ""
     "type Variant struct {"
     "	Type, Name string"
     "	Fields     []V"
     "}"
     "type Rec struct {"
     "	Schema string"
     "	Keys   []string"
     "	M      map[string]V"
     "}"
     "type Cons struct{ H, T V }"
     "type Bytes struct{ B []byte }"
     ""
     "func newRec(schema string, keys []string, vals []V) V {"
     "	m := make(map[string]V, len(keys))"
     "	for i, k := range keys {"
     "		m[k] = vals[i]"
     "	}"
     "	return &Rec{schema, keys, m}"
     "}"
     "func field(r V, k string) V {"
     "	if rec, ok := r.(*Rec); ok {"
     "		if x, ok := rec.M[k]; ok {"
     "			return x"
     "		}"
     "	}"
     "	return trap(\"ERR_TYPE\", \"no field \"+k)"
     "}"
     "func vfield(v V, i int) V { return v.(*Variant).Fields[i] }"
     "func vname(v V) string  { return v.(*Variant).Name }"
     ""
     "func list(xs ...V) V {"
     "	var l V"
     "	for i := len(xs) - 1; i >= 0; i-- {"
     "		l = &Cons{xs[i], l}"
     "	}"
     "	return l"
     "}"
     ""
     "func call(c V, a ...V) V {"
     "	f, ok := c.(Fn)"
     "	if !ok {"
     "		return trap(\"ERR_TYPE\", \"call of a value that is not a function\")"
     "	}"
     "	return f(a...)"
     "}"
     ""
     "func truth(v V) bool { return v.(bool) }"
     ""
     "func addInt(a, b V) V {"
     "	x, y := a.(int64), b.(int64)"
     "	r := x + y"
     "	if (x > 0 && y > 0 && r < 0) || (x < 0 && y < 0 && r >= 0) {"
     "		return trap(\"ERR_INT_OVERFLOW\", \"Int + leaves int64\")"
     "	}"
     "	return r"
     "}"
     "func subInt(a, b V) V {"
     "	x, y := a.(int64), b.(int64)"
     "	r := x - y"
     "	if (x >= 0 && y < 0 && r < 0) || (x < 0 && y > 0 && r >= 0) {"
     "		return trap(\"ERR_INT_OVERFLOW\", \"Int - leaves int64\")"
     "	}"
     "	return r"
     "}"
     "func mulInt(a, b V) V {"
     "	x, y := a.(int64), b.(int64)"
     "	if x == 0 || y == 0 {"
     "		return int64(0)"
     "	}"
     "	r := x * y"
     "	if r/y != x || (x == -1 && y == math.MinInt64) || (y == -1 && x == math.MinInt64) {"
     "		return trap(\"ERR_INT_OVERFLOW\", \"Int * leaves int64\")"
     "	}"
     "	return r"
     "}"
     "func divInt(a, b V) V {"
     "	x, y := a.(int64), b.(int64)"
     "	if y == 0 {"
     "		return trap(\"ERR_DIV_ZERO\", \"division by zero\")"
     "	}"
     "	if x == math.MinInt64 && y == -1 {"
     "		return trap(\"ERR_INT_OVERFLOW\", \"Int / leaves int64\")"
     "	}"
     "	q := x / y"
     "	if x%y != 0 && (x < 0) != (y < 0) {"
     "		q--"
     "	}"
     "	return q"
     "}"
     "func modInt(a, b V) V {"
     "	x, y := a.(int64), b.(int64)"
     "	if y == 0 {"
     "		return trap(\"ERR_DIV_ZERO\", \"division by zero\")"
     "	}"
     "	if y == -1 {"
     "		return int64(0)"
     "	}"
     "	r := x % y"
     "	if r != 0 && (r < 0) != (y < 0) {"
     "		r += y"
     "	}"
     "	return r"
     "}"
     "func negInt(a V) V {"
     "	x := a.(int64)"
     "	if x == math.MinInt64 {"
     "		return trap(\"ERR_INT_OVERFLOW\", \"Int - leaves int64\")"
     "	}"
     "	return -x"
     "}"
     "func quotInt(a, b V) V {"
     "	x, y := a.(int64), b.(int64)"
     "	if y == 0 {"
     "		return trap(\"ERR_DIV_ZERO\", \"division by zero\")"
     "	}"
     "	if x == math.MinInt64 && y == -1 {"
     "		return trap(\"ERR_INT_OVERFLOW\", \"Int / leaves int64\")"
     "	}"
     "	return x / y"
     "}"
     "func remInt(a, b V) V {"
     "	x, y := a.(int64), b.(int64)"
     "	if y == 0 {"
     "		return trap(\"ERR_DIV_ZERO\", \"division by zero\")"
     "	}"
     "	if y == -1 {"
     "		return int64(0)"
     "	}"
     "	return x % y"
     "}"
     "func floatToInt(a V) V {"
     "	x := a.(float64)"
     "	if math.IsNaN(x) || math.IsInf(x, 0) {"
     "		return trap(\"ERR_RANGE\", \"floatToInt of a non-finite Float\")"
     "	}"
     "	t := math.Trunc(x)"
     "	if t < -9223372036854775808.0 || t >= 9223372036854775808.0 {"
     "		return trap(\"ERR_INT_OVERFLOW\", \"Int floatToInt leaves int64\")"
     "	}"
     "	return int64(t)"
     "}"
     ""
     "func arith(op string, a, b V) V {"
     "	if x, ok := a.(int64); ok {"
     "		if _, ok := b.(int64); ok {"
     "			switch op {"
     "			case \"+\":"
     "				return addInt(x, b)"
     "			case \"-\":"
     "				return subInt(x, b)"
     "			case \"*\":"
     "				return mulInt(x, b)"
     "			case \"/\":"
     "				return divInt(x, b)"
     "			default:"
     "				return modInt(x, b)"
     "			}"
     "		}"
     "	}"
     "	if x, ok := a.(float64); ok {"
     "		if y, ok := b.(float64); ok {"
     "			switch op {"
     "			case \"+\":"
     "				return x + y"
     "			case \"-\":"
     "				return x - y"
     "			case \"*\":"
     "				return x * y"
     "			case \"/\":"
     "				return x / y"
     "			}"
     "		}"
     "	}"
     "	return trap(\"ERR_TYPE\", op+\" expects two Ints or two Floats\")"
     "}"
     ""
     "func eq(a, b V) bool {"
     "	switch x := a.(type) {"
     "	case nil:"
     "		return b == nil"
     "	case int64, float64, bool, string, unitT, *Kw, *Sym:"
     "		return a == b"
     "	case *Cons:"
     "		y, ok := b.(*Cons)"
     "		if !ok {"
     "			return false"
     "		}"
     "		var l, r V = x, y"
     "		for l != nil && r != nil {"
     "			lc, rc := l.(*Cons), r.(*Cons)"
     "			if !eq(lc.H, rc.H) {"
     "				return false"
     "			}"
     "			l, r = lc.T, rc.T"
     "		}"
     "		return l == nil && r == nil"
     "	case *Variant:"
     "		y, ok := b.(*Variant)"
     "		if !ok || x.Name != y.Name || len(x.Fields) != len(y.Fields) {"
     "			return false"
     "		}"
     "		for i := range x.Fields {"
     "			if !eq(x.Fields[i], y.Fields[i]) {"
     "				return false"
     "			}"
     "		}"
     "		return true"
     "	case *Rec:"
     "		y, ok := b.(*Rec)"
     "		if !ok || x.Schema != y.Schema {"
     "			return false"
     "		}"
     "		for _, k := range x.Keys {"
     "			if !eq(x.M[k], y.M[k]) {"
     "				return false"
     "			}"
     "		}"
     "		return true"
     "	case *Bytes:"
     "		y, ok := b.(*Bytes)"
     "		return ok && string(x.B) == string(y.B)"
     "	}"
     "	return false"
     "}"
     ""
     "func order(op string, a, b V) bool {"
     "	c := 0"
     "	nan := false"
     "	switch x := a.(type) {"
     "	case int64:"
     "		y, ok := b.(int64)"
     "		if !ok {"
     "			trap(\"ERR_TYPE\", op+\" expects two Ints, two Floats or two Strings\")"
     "		}"
     "		if x < y {"
     "			c = -1"
     "		} else if x > y {"
     "			c = 1"
     "		}"
     "	case float64:"
     "		y, ok := b.(float64)"
     "		if !ok {"
     "			trap(\"ERR_TYPE\", op+\" expects two Ints, two Floats or two Strings\")"
     "		}"
     "		nan = math.IsNaN(x) || math.IsNaN(y)"
     "		if x < y {"
     "			c = -1"
     "		} else if x > y {"
     "			c = 1"
     "		}"
     "	case string:"
     "		y, ok := b.(string)"
     "		if !ok {"
     "			trap(\"ERR_TYPE\", op+\" expects two Ints, two Floats or two Strings\")"
     "		}"
     "		c = strings.Compare(x, y)"
     "	default:"
     "		trap(\"ERR_TYPE\", op+\" expects two Ints, two Floats or two Strings\")"
     "	}"
     "	switch op {"
     "	case \"<\":"
     "		return c < 0 && !nan"
     "	case \"<=\":"
     "		return c <= 0 && !nan"
     "	case \">\":"
     "		return c > 0"
     "	}"
     "	return c >= 0 && !nan"
     "}"
     ""
     "func some(v V) V { return &Variant{\"Option\", \"some\", []V{v}} }"
     ""
     "var none V = &Variant{\"Option\", \"none\", nil}"
     ""
     "func quote(s string) string {"
     "	r := strings.NewReplacer(\"\\\\\", \"\\\\\\\\\", \"\\\"\", \"\\\\\\\"\", \"\\n\", \"\\\\n\", \"\\r\", \"\\\\r\", \"\\t\", \"\\\\t\")"
     "	return \"\\\"\" + r.Replace(s) + \"\\\"\""
     "}"
     ""
     "func floatText(x float64) string {"
     "	if math.IsNaN(x) {"
     "		return \"nan\""
     "	}"
     "	if math.IsInf(x, 1) {"
     "		return \"inf\""
     "	}"
     "	if math.IsInf(x, -1) {"
     "		return \"-inf\""
     "	}"
     "	o := \"\""
     "	if math.Signbit(x) {"
     "		o = \"-\""
     "	}"
     "	e := strconv.FormatFloat(math.Abs(x), 'e', -1, 64)"
     "	at := strings.IndexByte(e, 'e')"
     "	digits := strings.TrimRight(strings.Replace(e[:at], \".\", \"\", 1), \"0\")"
     "	if digits == \"\" {"
     "		digits = \"0\""
     "	}"
     "	exp10, _ := strconv.Atoi(e[at+1:])"
     "	if exp10 >= -4 && exp10 < 16 {"
     "		decpt := exp10 + 1"
     "		if decpt <= 0 {"
     "			o += \"0.\" + strings.Repeat(\"0\", -decpt) + digits"
     "		} else if decpt >= len(digits) {"
     "			o += digits + strings.Repeat(\"0\", decpt-len(digits)) + \".0\""
     "		} else {"
     "			o += digits[:decpt] + \".\" + digits[decpt:]"
     "		}"
     "	} else {"
     "		o += digits[:1]"
     "		if len(digits) > 1 {"
     "			o += \".\" + digits[1:]"
     "		}"
     "		sign := \"+\""
     "		if exp10 < 0 {"
     "			sign, exp10 = \"-\", -exp10"
     "		}"
     "		ex := strconv.Itoa(exp10)"
     "		if len(ex) < 2 {"
     "			ex = \"0\" + ex"
     "		}"
     "		o += \"e\" + sign + ex"
     "	}"
     "	return o"
     "}"
     ""
     "var floatSyntax = regexp.MustCompile(`^[+-]?(\\d+\\.?\\d*|\\.\\d+)([eE][+-]?\\d+)?$`)"
     ""
     "func parseFloatText(s string) V {"
     "	switch s {"
     "	case \"nan\":"
     "		return some(math.NaN())"
     "	case \"inf\":"
     "		return some(math.Inf(1))"
     "	case \"-inf\":"
     "		return some(math.Inf(-1))"
     "	}"
     "	if !floatSyntax.MatchString(s) {"
     "		return none"
     "	}"
     "	f, err := strconv.ParseFloat(s, 64)"
     "	if err != nil && !strings.Contains(err.Error(), \"range\") {"
     "		return none"
     "	}"
     "	return some(f)"
     "}"
     ""
     "func show(v V, nested bool) string {"
     "	switch x := v.(type) {"
     "	case string:"
     "		if nested {"
     "			return quote(x)"
     "		}"
     "		return x"
     "	case bool:"
     "		if x {"
     "			return \"true\""
     "		}"
     "		return \"false\""
     "	case int64:"
     "		return strconv.FormatInt(x, 10)"
     "	case float64:"
     "		return floatText(x)"
     "	case nil, unitT:"
     "		return \"()\""
     "	case *Kw:"
     "		return \":\" + x.Name"
     "	case *Sym:"
     "		return x.Name"
     "	case *Cons:"
     "		var out []string"
     "		var l V = x"
     "		for l != nil {"
     "			c := l.(*Cons)"
     "			out = append(out, show(c.H, true))"
     "			l = c.T"
     "		}"
     "		return \"(\" + strings.Join(out, \" \") + \")\""
     "	case *Variant:"
     "		out := []string{x.Name}"
     "		for _, f := range x.Fields {"
     "			out = append(out, show(f, true))"
     "		}"
     "		return \"(\" + strings.Join(out, \" \") + \")\""
     "	case *Rec:"
     "		var out []string"
     "		for _, k := range x.Keys {"
     "			out = append(out, \":\"+k+\" \"+show(x.M[k], true))"
     "		}"
     "		return \"{\" + strings.Join(out, \" \") + \"}\""
     "	case *Bytes:"
     "		return \"#<Bytes>\""
     "	case Fn:"
     "		return \"#<fn>\""
     "	}"
     "	return \"?\""
     "}"
     ""
     "func spaced(xs []V) string {"
     "	out := make([]string, len(xs))"
     "	for i, x := range xs {"
     "		out[i] = show(x, false)"
     "	}"
     "	return strings.Join(out, \" \")"
     "}"
     ""
     "var output = func(s string) { os.Stdout.WriteString(s) }"
     ""
     "func SetOutput(f func(string)) { output = f }"
     ""
     "var Counts = struct{ Asserts, Refutes int }{}"
     ""
     "func asInt(v V, who string) int64 {"
     "	x, ok := v.(int64)"
     "	if !ok {"
     "		trap(\"ERR_TYPE\", who+\" expects Int\")"
     "	}"
     "	return x"
     "}"
     "func asStr(v V, who string) string {"
     "	x, ok := v.(string)"
     "	if !ok {"
     "		trap(\"ERR_TYPE\", who+\" expects String\")"
     "	}"
     "	return x"
     "}"
     "func asFloat(v V, who string) float64 {"
     "	x, ok := v.(float64)"
     "	if !ok {"
     "		trap(\"ERR_TYPE\", who+\" expects Float\")"
     "	}"
     "	return x"
     "}"
     "func opt(v V, ok bool) V {"
     "	if ok {"
     "		return some(v)"
     "	}"
     "	return none"
     "}"
     "func slice(s string, i, j int64) (string, bool) {"
     "	if i < 0 || j > int64(len(s)) || i > j {"
     "		return \"\", false"
     "	}"
     "	return s[i:j], true"
     "}"
     "func fmath(who string, f func(float64) float64) Fn {"
     "	return func(a ...V) V { return f(asFloat(a[0], who)) }"
     "}"
     "func roundHalfAway(x float64) float64 {"
     "	if x < 0 {"
     "		return -math.Floor(-x + 0.5)"
     "	}"
     "	return math.Floor(x + 0.5)"
     "}"
     ""
     "var builtins = map[string]Fn{"
     "	\"print\":   func(a ...V) V { output(spaced(a)); return Unit },"
     "	\"println\": func(a ...V) V { output(spaced(a) + \"\\n\"); return Unit },"
     "	\"str\": func(a ...V) V {"
     "		var b strings.Builder"
     "		for _, x := range a {"
     "			b.WriteString(show(x, false))"
     "		}"
     "		return b.String()"
     "	},"
     "	\"max\": func(a ...V) V {"
     "		if order(\">=\", a[0], a[1]) {"
     "			return a[0]"
     "		}"
     "		return a[1]"
     "	},"
     "	\"min\": func(a ...V) V {"
     "		if order(\"<=\", a[0], a[1]) {"
     "			return a[0]"
     "		}"
     "		return a[1]"
     "	},"
     "	\"abs\": func(a ...V) V {"
     "		if x, ok := a[0].(int64); ok {"
     "			if x < 0 {"
     "				return negInt(x)"
     "			}"
     "			return x"
     "		}"
     "		return math.Abs(a[0].(float64))"
     "	},"
     "	\"cons\":       func(a ...V) V { return &Cons{a[0], a[1]} },"
     "	\"listEmpty?\": func(a ...V) V { return a[0] == nil },"
     "	\"listHead\": func(a ...V) V {"
     "		if a[0] == nil {"
     "			return none"
     "		}"
     "		return some(a[0].(*Cons).H)"
     "	},"
     "	\"listTail\": func(a ...V) V {"
     "		if a[0] == nil {"
     "			return none"
     "		}"
     "		return some(a[0].(*Cons).T)"
     "	},"
     "	\"list\":              func(a ...V) V { return list(a...) },"
     "	\"stringConcat\":      func(a ...V) V { return asStr(a[0], \"stringConcat\") + asStr(a[1], \"stringConcat\") },"
     "	\"stringContains?\":   func(a ...V) V { return strings.Contains(asStr(a[0], \"stringContains?\"), asStr(a[1], \"stringContains?\")) },"
     "	\"stringStartsWith?\": func(a ...V) V { return strings.HasPrefix(asStr(a[0], \"stringStartsWith?\"), asStr(a[1], \"stringStartsWith?\")) },"
     "	\"stringLength\":      func(a ...V) V { return int64(len(asStr(a[0], \"stringLength\"))) },"
     "	\"stringSlice\": func(a ...V) V {"
     "		s, ok := slice(asStr(a[0], \"stringSlice\"), asInt(a[1], \"stringSlice\"), asInt(a[2], \"stringSlice\"))"
     "		return opt(s, ok)"
     "	},"
     "	\"stringFromInt64\": func(a ...V) V { return strconv.FormatInt(asInt(a[0], \"stringFromInt64\"), 10) },"
     "	\"stringToBytes\":   func(a ...V) V { return &Bytes{[]byte(asStr(a[0], \"stringToBytes\"))} },"
     "	\"bytesLength\":     func(a ...V) V { return int64(len(a[0].(*Bytes).B)) },"
     "	\"bytesGet\": func(a ...V) V {"
     "		b, i := a[0].(*Bytes).B, asInt(a[1], \"bytesGet\")"
     "		if i < 0 || i >= int64(len(b)) {"
     "			return trap(\"ERR_RANGE\", \"bytesGet index out of range\")"
     "		}"
     "		return int64(b[i])"
     "	},"
     "	\"stringFromFloat64\": func(a ...V) V { return floatText(asFloat(a[0], \"stringFromFloat64\")) },"
     "	\"stringToFloat64\":   func(a ...V) V { return parseFloatText(asStr(a[0], \"stringToFloat64\")) },"
     "	\"int64ToFloat64\":    func(a ...V) V { return float64(asInt(a[0], \"int64ToFloat64\")) },"
     "	\"float64ToInt64\": func(a ...V) V {"
     "		x := asFloat(a[0], \"float64ToInt64\")"
     "		t := math.Trunc(x)"
     "		if math.IsNaN(x) || math.IsInf(x, 0) || t < -9223372036854775808.0 || t >= 9223372036854775808.0 {"
     "			return none"
     "		}"
     "		return some(int64(t))"
     "	},"
     "	\"floor\": fmath(\"floor\", math.Floor), \"ceil\": fmath(\"ceil\", math.Ceil), \"round\": fmath(\"round\", roundHalfAway),"
     "	\"sqrt\": fmath(\"sqrt\", math.Sqrt), \"exp\": fmath(\"exp\", math.Exp), \"log\": fmath(\"log\", math.Log),"
     "	\"log2\": fmath(\"log2\", math.Log2), \"log10\": fmath(\"log10\", math.Log10),"
     "	\"sin\": fmath(\"sin\", math.Sin), \"cos\": fmath(\"cos\", math.Cos), \"tan\": fmath(\"tan\", math.Tan),"
     "	\"atan2\": func(a ...V) V { return math.Atan2(asFloat(a[0], \"atan2\"), asFloat(a[1], \"atan2\")) },"
     "	\"pow\":   func(a ...V) V { return math.Pow(asFloat(a[0], \"pow\"), asFloat(a[1], \"pow\")) },"
     "	\"clamp\": func(a ...V) V {"
     "		lo, hi, x := asFloat(a[0], \"clamp\"), asFloat(a[1], \"clamp\"), asFloat(a[2], \"clamp\")"
     "		if !(lo <= hi) {"
     "			return trap(\"ERR_RANGE\", \"clamp: lo <= hi required\")"
     "		}"
     "		return math.Min(hi, math.Max(lo, x))"
     "	},"
     "	\"partial\": func(a ...V) V {"
     "		f, bound := a[0], append([]V{}, a[1:]...)"
     "		return Fn(func(rest ...V) V { return call(f, append(append([]V{}, bound...), rest...)...) })"
     "	},"
     "	\"bytesAlloc\": func(a ...V) V {"
     "		n := asInt(a[0], \"bytesAlloc\")"
     "		if n < 0 {"
     "			return trap(\"ERR_RANGE\", \"bytesAlloc of a negative size\")"
     "		}"
     "		return &Bytes{make([]byte, n)}"
     "	},"
     "	\"bytesSet\": func(a ...V) V {"
     "		b, i := a[0].(*Bytes).B, asInt(a[1], \"bytesSet\")"
     "		if i < 0 || i >= int64(len(b)) {"
     "			return trap(\"ERR_RANGE\", \"bytesSet index out of range\")"
     "		}"
     "		b[i] = byte(asInt(a[2], \"bytesSet\"))"
     "		return Unit"
     "	},"
     "	\"bytesGetFloat64\": func(a ...V) V {"
     "		return math.Float64frombits(binary.LittleEndian.Uint64(a[0].(*Bytes).B[asInt(a[1], \"bytesGetFloat64\"):]))"
     "	},"
     "	\"bytesSetFloat64\": func(a ...V) V {"
     "		binary.LittleEndian.PutUint64(a[0].(*Bytes).B[asInt(a[1], \"bytesSetFloat64\"):], math.Float64bits(asFloat(a[2], \"bytesSetFloat64\")))"
     "		return Unit"
     "	},"
     "	\"eprintln\":    func(a ...V) V { os.Stderr.WriteString(spaced(a) + \"\\n\"); return Unit },"
     "	\"nowNs\":       func(a ...V) V { return time.Now().UnixNano() },"
     "	\"monotonicNs\": func(a ...V) V { return int64(time.Since(started)) },"
     "	\"trap\":        func(a ...V) V { return trap(show(a[0], false), show(a[1], false)) },"
     "	\"assert\": func(a ...V) V {"
     "		Counts.Asserts++"
     "		if a[0] != true {"
     "			return trap(\"ERR_ASSERT\", \"assertion failed: \"+show(a[1], false))"
     "		}"
     "		return Unit"
     "	},"
     "	\"refute\": func(a ...V) V {"
     "		Counts.Refutes++"
     "		if a[0] != false {"
     "			return trap(\"ERR_REFUTE\", \"refutation failed: \"+show(a[1], false))"
     "		}"
     "		return Unit"
     "	},"
     "}"
     ""
     "var started = time.Now()"
     ""
     "var entries = func() map[string]Fn {"
     "	m := map[string]Fn{"
     "		\"+\": func(a ...V) V { return arith(\"+\", a[0], a[1]) },"
     "		\"-\": func(a ...V) V {"
     "			if len(a) == 1 {"
     "				if x, ok := a[0].(int64); ok {"
     "					return negInt(x)"
     "				}"
     "				if x, ok := a[0].(float64); ok {"
     "					return -x"
     "				}"
     "				return trap(\"ERR_TYPE\", \"- expects a number\")"
     "			}"
     "			return arith(\"-\", a[0], a[1])"
     "		},"
     "		\"*\":   func(a ...V) V { return arith(\"*\", a[0], a[1]) },"
     "		\"/\":   func(a ...V) V { return arith(\"/\", a[0], a[1]) },"
     "		\"mod\": func(a ...V) V { return arith(\"mod\", a[0], a[1]) },"
     "		\"%\":   func(a ...V) V { return arith(\"%\", a[0], a[1]) },"
     "		\"=\":   func(a ...V) V { return eq(a[0], a[1]) },"
     "		\"==\":  func(a ...V) V { return eq(a[0], a[1]) },"
     "		\"!=\":  func(a ...V) V { return !eq(a[0], a[1]) },"
     "		\"<\":   func(a ...V) V { return order(\"<\", a[0], a[1]) },"
     "		\"<=\":  func(a ...V) V { return order(\"<=\", a[0], a[1]) },"
     "		\">\":   func(a ...V) V { return order(\">\", a[0], a[1]) },"
     "		\">=\":  func(a ...V) V { return order(\">=\", a[0], a[1]) },"
     "		\"@listFirst\": func(a ...V) V {"
     "			if a[0] == nil {"
     "				return trap(\"ERR_RANGE\", \"listFirst of an empty list\")"
     "			}"
     "			return a[0].(*Cons).H"
     "		},"
     "		\"@listRest\": func(a ...V) V {"
     "			if a[0] == nil {"
     "				return trap(\"ERR_RANGE\", \"listRest of an empty list\")"
     "			}"
     "			return a[0].(*Cons).T"
     "		},"
     "		\"@stringSliceOr\": func(a ...V) V {"
     "			if s, ok := slice(a[0].(string), a[1].(int64), a[2].(int64)); ok {"
     "				return s"
     "			}"
     "			return a[3]"
     "		},"
     "		\"@stringIndexOf\": func(a ...V) V {"
     "			i := strings.Index(a[0].(string), a[1].(string))"
     "			return opt(int64(i), i >= 0)"
     "		},"
     "		\"@listHeadOr\": func(a ...V) V {"
     "			if a[0] == nil {"
     "				return a[1]"
     "			}"
     "			return a[0].(*Cons).H"
     "		},"
     "		\"@listTailOr\": func(a ...V) V {"
     "			if a[0] == nil {"
     "				return a[1]"
     "			}"
     "			return a[0].(*Cons).T"
     "		},"
     "		\"@listGetOr\": func(a ...V) V {"
     "			l, i := a[0], a[1].(int64)"
     "			if i < 0 {"
     "				return a[2]"
     "			}"
     "			for l != nil {"
     "				c := l.(*Cons)"
     "				if i == 0 {"
     "					return c.H"
     "				}"
     "				l, i = c.T, i-1"
     "			}"
     "			return a[2]"
     "		},"
     "		\"not\": func(a ...V) V { return !a[0].(bool) },"
     "	}"
     "	for k, f := range builtins {"
     "		m[k] = f"
     "	}"
     "	return m"
     "}()"
     ""
     "func unreachable() V { return trap(\"ERR_UNREACHABLE\", \"control reached an unreachable block\") }"
     ""
     "func runMain(f func() V) {"
     "	code := 0"
     "	func() {"
     "		defer func() {"
     "			if r := recover(); r != nil {"
     "				t, ok := r.(*AslTrap)"
     "				if !ok {"
     "					panic(r)"
     "				}"
     "				os.Stderr.WriteString(t.Error() + \"\\n\")"
     "				code = 1"
     "			}"
     "		}()"
     "		switch r := f().(type) {"
     "		case int64:"
     "			code = int(r)"
     "		case *Variant:"
     "			if r.Name != \"ok\" {"
     "				os.Stderr.WriteString(\"ERR_MAIN_FAILED: main returned \" + show(r, true) + \", not (ok ...)\\n\")"
     "				code = 1"
     "			}"
     "		default:"
     "			os.Stderr.WriteString(\"ERR_MAIN_FAILED: main returned \" + show(r, true) + \", not (ok ...)\\n\")"
     "			code = 1"
     "		}"
     "	}()"
     "	os.Exit(code & 255)"
     "}" ""]
    "\n")

fn builtinNames -> (List String)
  ["print" "println" "str" "max" "min" "abs" "cons" "listEmpty?" "listHead" "listTail" "list" "stringConcat" "stringContains?" "stringStartsWith?" "stringLength" "stringSlice" "stringFromInt64" "stringToBytes" "bytesLength" "bytesGet" "stringFromFloat64" "stringToFloat64" "int64ToFloat64" "float64ToInt64" "floor" "sqrt" "log2" "sin" "atan2" "pow" "clamp" "partial" "bytesAlloc" "bytesSet" "bytesGetFloat64" "bytesSetFloat64" "eprintln" "nowNs" "monotonicNs" "trap" "assert" "refute" "ceil" "round" "exp" "log" "log10" "cos" "tan"]

fn entryNames -> (List String)
  (listAppend ["+" "-" "*" "/" "mod" "%" "=" "==" "!=" "<" "<=" ">" ">=" "@listFirst" "@listRest" "@stringSliceOr" "@stringIndexOf" "@listHeadOr" "@listTailOr" "@listGetOr" "not"] (builtinNames))
