(module asl-forms/tests/claimTest :x [runTests] :i [])

fn currentHost! root: String -> (Option String)
  (mt (envGet "ASL_HOST")
    ((some h) (if (fileExists? h)
                (some (resultOr (realPath h) h))
                (do (println (str "invalid environment variable: ASL_HOST path does not exist: " h))
                    (assert false (str "invalid environment variable: ASL_HOST path does not exist: " h))
                    (none))))
    ((none) (let [(p (str root "/asl/host/out/asl-host"))]
              (if (fileExists? p)
                (some (resultOr (realPath p) p))
                (do (println (str "the stage-0 host is absent at " p "; build it with sh asl/host/build.sh or set ASL_HOST"))
                    (assert false (str "the stage-0 host is absent at " p "; build it with sh asl/host/build.sh or set ASL_HOST"))
                    (none))))))

fn runEnv! workspace: String env: String form: String -> ProcessOutput
  (let [(root (optionOr (envGet "ROOT_DIR") (resultOr (realPath ".") ".")))
        (hostOpt (currentHost! root))]
    (mt hostOpt
      ((none) (processRun "exit 127"))
      ((some host)
       (let [(main (str root "/asl/packages/asl-forms/src/main.asl"))
             (payload (stringReplace form "\"" "\\\""))]
         (processRun (str "cd " workspace " && ROOT_DIR=" root " ASL_LEASE_PID=0 ASL_HOST=" host " " env " ASL_VFS_DIR=" workspace "/.asl/vfs " host " run " main " --root " workspace " \"" payload "\""))))))

fn runAt! workspace: String unit: String form: String -> ProcessOutput
  (runEnv! workspace (str "ASL_UNIT=" unit " ASL_AGENT=" unit) form)

fn runAtBranch! workspace: String agent: String form: String -> ProcessOutput
  (runEnv! workspace (str "ASL_AGENT=" agent) form)

fn ! runTests -> Bool
  (let [(root (resultOr (realPath ".") "."))]
    (mt (currentHost! root)
      ((none) false)
      ((some _)
       (let [(tmp (str (optionOr (envGet "TMPDIR") "/tmp") "/aslClaims" (stringFromInt64 (nowNs))))
        (seed (str tmp "/seed"))
        (a (str tmp "/a"))
        (b (str tmp "/b"))
        (setup (processRun (str "mkdir -p " seed "/src/a " seed "/src/b && cd " seed " && git init -b main >/dev/null && git config user.email test@example.invalid && git config user.name test && printf 'before\\n' > src/a/y.asl && printf 'before\\n' > src/a/txn.asl && printf 'before\\n' > src/b/y.asl && git add src && git commit -m base >/dev/null && git worktree add -b sh/A " a " >/dev/null && git worktree add -b sh/B " b " >/dev/null")))
        (unclaimedEdit (runAt! b "B" "(:edit :file \"src/b/y.asl\" :old \"before\" :new \"free\") (:flush)"))
        (claimsAbsentAfterEdit (mt (dirList (str seed "/.git/asl/claims")) ((err _) true) ((ok _) false)))
        (commitA (processRun (str "cd " a " && git -c user.email=test@example.invalid -c user.name=test commit --allow-empty -m claimed >/dev/null")))
        (claimA (runAt! a "A" "(:claim :unit \"A\" :owns (\"src/a\" \"scripts/audit/foreignBaseline.asn\" \"scripts/audit/foreignAllowlist.asn\"))"))
        (leasePath (str seed "/.git/asl/claims/A.asn"))
        (mtimeBefore (mt (fileStat leasePath) ((ok st) st.mtimeNs) ((err _) 0)))
        (pause (processRun "sleep 0.01"))
        (ownEdit (runAtBranch! a "A" "(:edit :file \"src/a/y.asl\" :old \"before\" :new \"after\") (:flush)"))
        (pidRecord (resultOr (fileReadString leasePath) ""))
        (txnBypass (runAt! b "B" "(:txn :owns (\"src/a/txn.asl\") (:write :file \"src/a/txn.asl\" :content \"txnBypass\"))"))
        (txnDisk (resultOr (fileReadString (str seed "/src/a/txn.asl")) ""))
        (releaseOther (runAt! b "B" "(:release :unit \"A\")"))
        (leaseAfterRelease (fileExists? leasePath))
        (mtimeAfter (mt (fileStat leasePath) ((ok st) st.mtimeNs) ((err _) 0)))
        (conflict (runAt! b "B" "(:claim :unit \"B\" :owns (\"src/a/x.asl\"))"))
        (independent (runAt! b "B" "(:claim :unit \"B\" :owns (\"src/b\"))"))
        (exempt (runAt! b "C" "(:claim :unit \"C\" :owns (\"scripts/audit/foreignBaseline.asn\" \"scripts/audit/foreignAllowlist.asn\"))"))
        (listed (runAt! b "B" "(:claims)"))
        (edit (runAt! b "B" "(:edit :file \"src/a/y.asl\" :old \"before\" :new \"blocked\")"))
        (flush (runAt! b "B" "(:write :file \"src/a/y.asl\" :content \"staged\") (:flush)"))
        (releaseB (runAt! b "B" "(:release :unit \"B\")"))
        (mergeA (processRun (str "cd " seed " && git merge --ff-only sh/A >/dev/null")))
        (afterMerge (runAt! b "B" "(:claim :unit \"B\" :owns (\"src/a\"))"))
        (commitB (processRun (str "cd " b " && git -c user.email=test@example.invalid -c user.name=test commit --allow-empty -m b-live >/dev/null")))
        (liveC (runAt! b "C" "(:claim :unit \"C\" :owns (\"src/c\"))"))
        (moveB (processRun (str "git -C " seed " worktree move " b " " tmp "/b-moved >/dev/null")))
        (gone (runAt! a "D" "(:claim :unit \"D\" :owns (\"src/c\"))"))
        (movedB (str tmp "/b-moved"))
        (liveE (runAt! movedB "E" "(:claim :unit \"E\" :owns (\"src/d\"))"))
        (ttlRecord (resultOr (fileReadString (str seed "/.git/asl/claims/E.asn")) ""))
        (aged (fileUtime (str seed "/.git/asl/claims/E.asn") (- (nowNs) 7201000000000)))
        (ttlTakeover (runAt! movedB "F" "(:claim :unit \"F\" :owns (\"src/d\"))"))
        (holderPid (stringTrim (processRun "printf %s $PPID").stdout))
        (liveHolder (runEnv! movedB (str "ASL_UNIT=H ASL_AGENT=H ASL_LEASE_PID=" holderPid) "(:claim :unit \"H\" :owns (\"src/h\"))"))
        (agedHolder (fileUtime (str seed "/.git/asl/claims/H.asn") (- (nowNs) 7201000000000)))
        (holderKept (runAt! movedB "I" "(:claim :unit \"I\" :owns (\"src/h\"))"))
        (ownClaim (runAtBranch! movedB "agentX" "(:claim :unit \"B\" :owns (\"src/e\"))"))
        (otherAgentRelease (runAtBranch! movedB "agentY" "(:release :unit \"B\")"))
        (ownRelease (runAtBranch! movedB "agentX" "(:release :unit \"B\")"))
        (ownLeaseGone (not (fileExists? (str seed "/.git/asl/claims/B.asn"))))
        (cleaned (pathRemove tmp))]
    (do
      (assert (= setup.exitCode 0) "the test creates two linked worktrees of a temporary repository")
      (assert (= unclaimedEdit.exitCode 0) "edits without any leases retain their existing behavior")
      (assert claimsAbsentAfterEdit "unleased edits do not create a claims store in the common git directory")
      (assert (= claimA.exitCode 0) "unit A acquires src/a in the common git dir")
      (assert (= releaseOther.exitCode 1) (str "a different unit cannot release A's live lease: " releaseOther.stdout " " releaseOther.stderr))
      (assert leaseAfterRelease "the unauthorized release leaves A's lease in place")
      (assert (= txnBypass.exitCode 1) (str "txn write cannot bypass another unit's path lease: " txnBypass.stdout " " txnBypass.stderr))
      (assert (= txnDisk "before\n") (str "a refused txn leaves the protected file untouched: " txnDisk))
      (assert (stringContains? pidRecord ":pid 0 ") (str "without ASL_LEASE_PID a lease records no transient command pid: " pidRecord))
      (assert (= ownEdit.exitCode 0) (str "a lease owner can edit and flush within its scope: " ownEdit.stdout " " ownEdit.stderr))
      (assert (> mtimeAfter mtimeBefore) (str "edit and flush heartbeat the lease mtime: " (stringFromInt64 mtimeBefore) " -> " (stringFromInt64 mtimeAfter)))
      (assert (= conflict.exitCode 1) "unit B cannot claim a descendant of A's path")
      (assert (stringContains? conflict.stdout ":unit \"B\" :by \"A\" :path \"src/a/x.asl\"") "the refusal names the caller, conflicting unit, and exact path")
      (assert (= independent.exitCode 0) "unit B can claim a non-overlapping path")
      (assert (= exempt.exitCode 0) "the two row-merged audit ledgers are exempt from overlap claims")
      (assert (stringContains? listed.stdout ":claims") "claims lists the shared active lease records")
      (assert (stringContains? listed.stdout ":unit \"A\" :owns (\"src/a\"") "claims exposes the persisted unit and owns paths")
      (assert (= edit.exitCode 1) "edit refuses a path outside another unit's live lease")
      (assert (stringContains? edit.stdout ":refused") "edit refusal returns the machine-readable receipt")
      (assert (= flush.exitCode 1) "flush refuses staged content under another live lease")
      (assert (stringContains? flush.stdout ":refused") "flush refusal returns the machine-readable receipt")
      (assert (= releaseB.exitCode 0) "release removes B's live lease")
      (assert (= mergeA.exitCode 0) "unit A's branch merges into main")
      (assert (= afterMerge.exitCode 0) "a merged lease is retired before the next claim")
      (assert (= commitB.exitCode 0) "B advances its branch beyond main for stale-lease probes")
      (assert (= liveC.exitCode 0) "a second lease is acquired in the still-live B worktree")
      (assert (= moveB.exitCode 0) "moving, not deleting, B's worktree removes its registered old path")
      (assert (= gone.exitCode 0) "a lease whose worktree is no longer listed is retired")
      (assert (= liveE.exitCode 0) "a live branch acquires a lease for the TTL probe")
      (assert (stringContains? ttlRecord ":ttl 7200") "lease records carry the adopted 7200-second TTL")
      (assert (mt aged ((ok _) true) ((err _) false)) "the dead holder's lease mtime is made older than its TTL")
      (assert (= ttlTakeover.exitCode 0) "a dead holder past TTL is retired before a competing claim")
      (assert (and (= liveHolder.exitCode 0) (mt agedHolder ((ok _) true) ((err _) false))) "a lease declaring a live ASL_LEASE_PID is aged past its TTL")
      (assert (= holderKept.exitCode 1) (str "a live declared holder keeps its lease past the TTL: " holderKept.stdout))
      (assert (= ownClaim.exitCode 0) "the branch unit B claims a live lease as agentX")
      (assert (= otherAgentRelease.exitCode 1) "another agent of the same unit cannot release the live lease")
      (assert (= ownRelease.exitCode 0) (str "the holder releases its own live lease: " ownRelease.stdout " " ownRelease.stderr))
      (assert ownLeaseGone "the holder's release removes the lease file")
      (assert (and (ok? cleaned) (not (fileExists? tmp))) "the temporary repository is removed")
      true)))))
