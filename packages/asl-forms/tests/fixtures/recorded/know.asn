(:case :id "30" :ws "@tc" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:tools)" :stdout "(:tools :v 2 :workspace \"tc\" :help \"(:help :op x) | (:help :topic t)\" :ops ((:op :tools \"\" \"Print the operation registry.\") (:op :help \"op? topic? builtin?\" \"Show help for an op, a topic, or the ASL builtins whose name contains a text.\") (:op :manage \"action id? cmd? lines? timeoutMs?\" \"APM engine process supervision, streaming logs, and session lifecycle. Replaces host manage_task.\") (:op :engine \"action scope? force?\" \"Resident ASL engine runtime management, scope isolation, socket status, liveness ping, and graceful restart/termination via RPC.\") (:op :lens \"file? target? lenses? profile?\" \"Execute a multi-lens audit across 13 canonical inquiry lenses returning structured ASN report.\") (:op :agent \"answer? backend? base? budget? contextFile? contextTokens? dryRun? gates? gateTimeout? intent? model? owns? plan? queueTimeout? resume? root? task timeout? wallBudget?\" \"Leon loop. Receipt: status session journal findings gates queueWaitSec execSec; exit 1 failed or escalated, 2 bad invocation.\") (:op :intel \"op target? symbol? file? strict? filter? symbol? module? path? spec? id? limit? module?\" \"Unified Code Intelligence: whole-repo call graph, execution complexity metrics, stub detection, runtime hot-path tracing, package coupling DAG, blast radius impact, dead code detection, vacuity audit, and bounded outline extraction.\") (:op :read \"file symbol? anchor? limit? start? end?\" \"Return a symbol or bounded slice of a file.\") (:op :query \"text in? limit?\" \"Search code for definitions and uses of a name; :in text searches comments, docs, memories and data instead, each labelled.\") (:op :edit \"file old new all? autofix? force?\" \"Stage a string replacement in the session buffer.\") (:op :write \"file content force?\" \"Stage whole-file content in the session buffer.\") (:op :tree \"path?\" \"Count files and directories under :path inside the workspace.\") (:op :observe \"dim scope? limit?\" \"Read-only workspace facts; an unknown :dim lists :nearest.\") (:op :diff \"file?\" \"Show staged changes against disk.\") (:op :flush \"file?\" \"Write all staged changes to disk atomically.\") (:op :discard \"file?\" \"Drop all staged changes.\") (:op :check \"file?\" \"Check a file: delimiter balance, then for an .asl file the stage-0 host check on staged content.\") (:op :test \"file\" \"Run an ASL test file on the stage-0 host against staged content.\") (:op :fix \"file apply?\" \"Propose or stage minimal delimiter repair.\") (:op :txn \"owns\" \"Run nested edits and gates atomically inside owns.\") (:op :audit \"subcmd?\" \"Run systemic monorepo audit across declared dimensions including whole-repo sweep, dead code, test vacuity, stub detection, runtime tracing, and master system vitality.\") (:op :crawl \"url mode? distill?\" \"Crawl target web page and distill DOM to pure Dyck-1 ASN without noise.\") (:op :search \"query limit?\" \"Cognitive web search with provider cascading and direct fallback.\") (:op :research \"topic depth?\" \"Web research through the gateway: the research route of its profile extracts facts; a report is :verified only when facts with source urls pass verification, else :unverified, :noEvidence or :failed with a :reason.\") (:op :doctor \"\" \"Audit measured capabilities and substrate invariants.\") (:op :note \"action? kind? scope? date? claim?\" \"Record or query working memory observations in pure ASN.\") (:op :target \"name? file?\" \"Compile ASL to standalone target code or synchronize distribution artifacts (sh, ps1, cmd, distrib, c, go, llvm, py, rs, swift, wat).\") (:op :pack \"target? quick? dist? install? skipGates? self?\" \"Assemble native self-hosted LLVM binary, audit verification gates, and package target distribution bundles (darwin-arm64, linux-x64, wasm).\")))" :exit "0")
