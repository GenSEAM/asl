(:case :id "53" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:help :tool query)" :stdout "(:help :op (:op :query :public \"Search code for definitions and uses of a name; :in text searches comments, docs, memories and data instead, each labelled.\" :doc \"A mention outside code is not a use: it is counted under :text. Matching binary files are skipped, counted as :binarySkipped. Every call site of a function, through aliases and modules: (:observe :dim callers).\" :form \"(:query :text <str> [:in code|text|all] [:limit <int>])\" :params ((:text str req \"substring or symbol query text\") (:in sym :code \"code: definitions confirmed against the symbol index, then code lines where the text is code, and a :text count of what else matched; text: sections :comment (comments and strings in code) :doc :memory :data; all: both\") (:limit int 20 \"maximum definition and hit count per section\")) :examples (\"(:query :text \\\"rules\\\" :limit 5)\" \"(:query :text \\\"rules\\\" :in text)\") :errors (ERR_MISSING_ARG ERR_QUERY_FAILED) :related (read observe)))" :exit "0")
(:case :id "54" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:help :builtin string)" :stdout "(:help :builtin \"string\" :match :name :count 24 :of 195 :builtins ((:name \"stringChars\" :type \"String -> (List String)\" :doc \"UTF-8 characters as one-character strings.\") (:name \"stringConcat\" :type \"String String -> String\" :doc \"Concatenate two strings.\") (:name \"stringContains?\" :type \"String String -> Bool\" :doc \"True when the substring occurs; the empty string always occurs.\") (:name \"stringCountChar\" :type \"String String -> Int64\" :doc \"How many characters of the string equal the one-character second argument.\") (:name \"stringEmpty?\" :type \"String -> Bool\" :doc \"True when the string has no bytes.\") (:name \"stringEndsWith?\" :type \"String String -> Bool\" :doc \"True when the string ends with the suffix.\") (:name \"stringFromFloat64\" :type \"Float64 -> String\" :doc \"Decimal rendering of a float.\") (:name \"stringFromInt64\" :type \"Int64 -> String\" :doc \"Decimal rendering of an integer.\") (:name \"stringIndexOf\" :type \"String String -> (Option Int64)\" :doc \"Byte index of the first occurrence, or none.\") (:name \"stringJoin\" :type \"(List String) String -> String\" :doc \"Join with a separator.\") (:name \"stringLength\" :type \"String -> Int64\" :doc \"Length in UTF-8 bytes, so (stringLength \\\"héllo\\\") is 6.\") (:name \"stringLines\" :type \"String -> (List String)\" :doc \"Split on \\\"\\\\n\\\"; a trailing newline gives a last empty line.\") (:name \"stringLower\" :type \"String -> String\" :doc \"Lower case for ASCII letters; other characters are unchanged.\") (:name \"stringRepeat\" :type \"String Int64 -> String\" :doc \"The string n times; n <= 0 gives \\\"\\\".\") (:name \"stringReplace\" :type \"String String String -> String\" :doc \"Replace every occurrence. An empty search string traps.\") (:name \"stringReverse\" :type \"String -> String\" :doc \"Reverse the UTF-8 character sequence.\") (:name \"stringSlice\" :type \"String Int64 Int64 -> (Option String)\" :doc \"Half-open byte slice, or none when out of range; a cut inside a multi-byte character splits it.\") (:name \"stringSplit\" :type \"String String -> (List String)\" :doc \"Split on a separator. An empty separator traps.\") (:name \"stringStartsWith?\" :type \"String String -> Bool\" :doc \"True when the string begins with the prefix.\") (:name \"stringToBytes\" :type \"String -> Bytes\" :doc \"The UTF-8 bytes of a string. The one string primitive past stringLength, stringSlice and stringConcat; charCode and fnv1a64 derive from it.\") (:name \"stringToFloat64\" :type \"String -> (Option Float64)\" :doc \"Parse a float; malformed input traps with ERR_PARSE.\") (:name \"stringToInt64\" :type \"String -> (Option Int64)\" :doc \"Parse an optionally signed integer, or none when it is malformed or outside Int64.\") (:name \"stringTrim\" :type \"String -> String\" :doc \"Remove leading and trailing spaces, tabs, carriage returns and newlines.\") (:name \"stringUpper\" :type \"String -> String\" :doc \"Upper case for ASCII letters; other characters are unchanged.\")))" :exit "0")
(:case :id "55" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:help :builtin parse-int)" :stdout "(:help :builtin \"parse-int\" :match :doc :count 1 :of 195 :builtins ((:name \"stringToInt64\" :type \"String -> (Option Int64)\" :doc \"Parse an optionally signed integer, or none when it is malformed or outside Int64.\")))" :exit "0")
(:case :id "56" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:help :builtin zzqqxx)" :stdout "(:help :status :rejected :error ERR_UNKNOWN_SYMBOL :message \"no builtin name contains zzqqxx\" :nearest () :see \"(:help :op help)\")" :exit "1")
(:case :id "57" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:help :builtin read-)" :stdout "(:help :builtin \"read-\" :match :doc :count 10 :of 195 :builtins ((:name \"alreadyExists\" :type \"() -> IoError\" :doc \"The already exists failure (constructor).\") (:name \"envGet\" :type \"String -> (Option String)\" :doc \"Read an environment variable by name: (some val) or (none).\") (:name \"fileCreateExclusive\" :type \"String String -> (Result Unit String)\" :doc \"Create a file exclusively (O_CREAT|O_EXCL) and write content; returns err \\\"exists\\\" if file already exists.\") (:name \"fileRead\" :type \"String -> (Result String IoError)\" :doc \"Read a whole file as text; the failure is the IoError case of the host message, e.g. (err (notFound)).\") (:name \"fileReadBytes\" :type \"String -> (Result Bytes String)\" :doc \"Read a whole file as bytes; the failure is a \\\"KIND: PATH: reason\\\" message.\") (:name \"fileReadRange\" :type \"String Int64 Int64 -> (Result Bytes String)\" :doc \"Read length bytes starting at offset from path via pread; window past the end returns bytes up to the end; negative offset or length or missing file returns err.\") (:name \"fileReadString\" :type \"String -> (Result String String)\" :doc \"Read a whole file as text. Every host IO failure is the message \\\"KIND: PATH: reason\\\", KIND an IoError case from errno, as in \\\"notFound: /x: No such file or directory\\\".\") (:name \"parquetReadF64\" :type \"ParquetHandle String Int64 -> F64Array\" :doc \"A double column of one row group; a wrong type or row group traps.\") (:name \"parquetReadI64\" :type \"ParquetHandle String Int64 -> I64Array\" :doc \"An int64 column of one row group; a wrong type or row group traps.\") (:name \"parquetReadI8\" :type \"ParquetHandle String Int64 -> I8Array\" :doc \"An int8 column of one row group; a wrong type or row group traps.\")) :unbound (\"read-line\" \"read-all\"))" :exit "0")
(:case :id "58" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:help :builtin \"\")" :stdout "(:help :builtin \"\" :match :name :count 195 :of 195 :builtins ((:name \"!=\" :type \"T T -> Bool\" :doc \"Structural inequality.\") (:name \"*\" :type \"N N -> N\" :doc \"Product. Traps on Int64 overflow.\") (:name \"+\" :type \"N N -> N\" :doc \"Sum of two Int or two Float; Int and Float never mix. Traps on Int64 overflow.\") (:name \"-\" :type \"N N -> N\" :doc \"Difference, or negation with one operand. Traps on Int64 overflow.\") (:name \"/\" :type \"N N -> N\" :doc \"Division; Int division floors, so (/ -7 2) is -4. Traps on a zero Int divisor and on a quotient outside Int64.\") (:name \"<\" :type \"T T -> Bool\" :doc \"Ordered comparison, for numbers and strings.\") (:name \"<=\" :type \"T T -> Bool\" :doc \"Ordered comparison, for numbers and strings.\") (:name \"=\" :type \"T T -> Bool\" :doc \"Structural equality over lists and records; comparing values of different kinds is a type error.\") (:name \"==\" :type \"T T -> Bool\" :doc \"The same operator as =.\") (:name \">\" :type \"T T -> Bool\" :doc \"Ordered comparison, for numbers and strings.\") (:name \">=\" :type \"T T -> Bool\" :doc \"Ordered comparison, for numbers and strings.\") (:name \"abs\" :type \"N -> N\" :doc \"Absolute value. Traps on the Int64 minimum.\") (:name \"alreadyExists\" :type \"() -> IoError\" :doc \"The already exists failure (constructor).\") (:name \"and\" :type \"Bool... -> Bool\" :doc \"Conjunction; short-circuits; takes one or more Bool operands. Any other value is a type error.\") (:name \"bitAnd\" :type \"Int64 Int64 -> Int64\" :doc \"Bitwise and on two's complement Int64.\") (:name \"bitNot\" :type \"Int64 -> Int64\" :doc \"Bitwise complement, (- -1 x).\") (:name \"bitOr\" :type \"Int64 Int64 -> Int64\" :doc \"Bitwise or on two's complement Int64.\") (:name \"bitXor\" :type \"Int64 Int64 -> Int64\" :doc \"Bitwise exclusive or on two's complement Int64.\") (:name \"bytesAlloc\" :type \"Int64 -> Bytes\" :doc \"n zero bytes; a negative n traps with ERR_RANGE.\") (:name \"bytesFromBase64\" :type \"String -> (Result Bytes String)\" :doc \"Decode padded RFC 4648 base64; a character outside the alphabet, misplaced padding or a length not a multiple of 4 is an err.\") (:name \"bytesGet\" :type \"Bytes Int64 -> Int64\" :doc \"The byte at an index, 0..255; an index outside the bytes traps with ERR_RANGE.\") (:name \"bytesGetFloat64\" :type \"Bytes Int64 -> Float64\" :doc \"The native-endian Float64 in 8-byte slot i; a slot outside the bytes traps with ERR_RANGE.\") (:name \"bytesLength\" :type \"Bytes -> Int64\" :doc \"Byte count.\") (:name \"bytesSet\" :type \"Bytes Int64 Int64 -> Unit\" :doc \"Overwrite the byte at an index in place; an index outside the bytes or a value outside 0..255 traps with ERR_RANGE.\") (:name \"bytesSetFloat64\" :type \"Bytes Int64 Float64 -> Unit\" :doc \"Overwrite 8-byte slot i in place; a slot outside the bytes traps with ERR_RANGE, an Int value with ERR_TYPE.\") (:name \"bytesSha256\" :type \"Bytes -> String\" :doc \"SHA-256 digest as 64 lower-case hex characters.\") (:name \"bytesToBase64\" :type \"Bytes -> String\" :doc \"RFC 4648 base64 with = padding.\") (:name \"charCode\" :type \"String -> Int64\" :doc \"Unicode code point of the first character, so (charCode \\\"é\\\") is 233; the empty string traps.\") (:name \"checkedDiv\" :type \"N N -> (Option N)\" :doc \"Division, or none on a zero divisor or a quotient outside Int64.\") (:name \"checkedMod\" :type \"N N -> (Option N)\" :doc \"Floored remainder, or none on a zero divisor. A Float argument traps, as mod does.\") (:name \"cons\" :type \"T (List T) -> (List T)\" :doc \"Prepend an element.\") (:name \"dirCreate\" :type \"String -> (Result Unit String)\" :doc \"Create directory and any missing parents (mkdir -p semantics); ok if dir exists, err if a file exists there.\") (:name \"dirList\" :type \"String -> (Result (List String) String)\" :doc \"Entry names of a directory without . and .., sorted bytewise; the failure is a \\\"KIND: PATH: reason\\\" message.\") (:name \"enumerate\" :type \"(List T) -> (List (Pair Int64 T))\" :doc \"Each element paired with its index from 0.\") (:name \"envGet\" :type \"String -> (Option String)\" :doc \"Read an environment variable by name: (some val) or (none).\") (:name \"eprintln\" :type \"String -> (Result Unit IoError)\" :doc \"Write the arguments to standard error, separated by spaces, then a newline.\") (:name \"err\" :type \"E -> (Result T E)\" :doc \"A failed result (constructor).\") (:name \"err?\" :type \"(Result T E) -> Bool\" :doc \"True when the result failed.\") (:name \"f64ArrayConcat\" :type \"(List F64Array) -> F64Array\" :doc \"Concatenate a list of arrays.\") (:name \"f64ArrayCountEq\" :type \"F64Array Float64 -> Int64\" :doc \"Number of elements equal to the value.\") (:name \"f64ArrayFold\" :type \"(fn [B Float64] -> B) B F64Array -> B\" :doc \"Left fold.\") (:name \"f64ArrayGenerate\" :type \"Int64 (fn [Int64] -> Float64) -> F64Array\" :doc \"Array of n elements, element i from the function applied to i.\") (:name \"f64ArrayGet\" :type \"F64Array Int64 -> Float64\" :doc \"Element at an index; an index outside the array traps with ERR_RANGE.\") (:name \"f64ArrayLen\" :type \"F64Array -> Int64\" :doc \"Element count.\") (:name \"f64ArrayScan\" :type \"(fn [Float64 Float64] -> Float64) Float64 F64Array -> F64Array\" :doc \"Every intermediate accumulator of a left fold, as an array.\") (:name \"f64ArraySlice\" :type \"F64Array Int64 Int64 -> F64Array\" :doc \"Half-open copy; bounds outside the array trap with ERR_RANGE.\") (:name \"f64ArraySum\" :type \"F64Array -> Float64\" :doc \"Neumaier-compensated sum.\") (:name \"fileCreateExclusive\" :type \"String String -> (Result Unit String)\" :doc \"Create a file exclusively (O_CREAT|O_EXCL) and write content; returns err \\\"exists\\\" if file already exists.\") (:name \"fileExists?\" :type \"String -> Bool\" :doc \"True when fileStat succeeds on the path (a file or a directory).\") (:name \"fileRead\" :type \"String -> (Result String IoError)\" :doc \"Read a whole file as text; the failure is the IoError case of the host message, e.g. (err (notFound)).\") (:name \"fileReadBytes\" :type \"String -> (Result Bytes String)\" :doc \"Read a whole file as bytes; the failure is a \\\"KIND: PATH: reason\\\" message.\") (:name \"fileReadRange\" :type \"String Int64 Int64 -> (Result Bytes String)\" :doc \"Read length bytes starting at offset from path via pread; window past the end returns bytes up to the end; negative offset or length or missing file returns err.\") (:name \"fileReadString\" :type \"String -> (Result String String)\" :doc \"Read a whole file as text. Every host IO failure is the message \\\"KIND: PATH: reason\\\", KIND an IoError case from errno, as in \\\"notFound: /x: No such file or directory\\\".\") (:name \"fileSize\" :type \"String -> (Result Int64 String)\" :doc \"File size in bytes via stat; the failure is a \\\"KIND: PATH: reason\\\" message.\") (:name \"fileStat\" :type \"String -> (Result FileStat String)\" :doc \"stat of a path as {:isFile Bool :isDir Bool :size Int64 :mtime Int64 :mode Int64}; the failure is a \\\"KIND: PATH: reason\\\" message.\") (:name \"fileWrite\" :type \"String String -> (Result Unit IoError)\" :doc \"Create or truncate a file and write the text or bytes; the failure is a \\\"KIND: PATH: reason\\\" message.\") (:name \"filter\" :type \"(fn [T] -> Bool) (List T) -> (List T)\" :doc \"Keep elements satisfying a predicate, which must return a Bool.\") (:name \"float64ToInt64\" :type \"Float64 -> (Option Int64)\" :doc \"Truncate toward zero; NaN, infinity and values outside Int64 trap with ERR_RANGE.\") (:name \"floatInf\" :type \"-> Float64\" :doc \"Positive infinity.\") (:name \"floatNan\" :type \"-> Float64\" :doc \"The float NaN.\") (:name \"floatNegInf\" :type \"-> Float64\" :doc \"Negative infinity.\") (:name \"fnv1a64\" :type \"String -> Int64\" :doc \"FNV-1a 64-bit hash of the string's UTF-8 bytes, as a signed Int64.\") (:name \"fold\" :type \"(fn [B A] -> B) B (List A) -> B\" :doc \"Left fold with an initial accumulator.\") (:name \"i64ArrayConcat\" :type \"(List I64Array) -> I64Array\" :doc \"Concatenate a list of arrays.\") (:name \"i64ArrayCountEq\" :type \"I64Array Int64 -> Int64\" :doc \"Number of elements equal to the value.\") (:name \"i64ArrayFold\" :type \"(fn [B Int64] -> B) B I64Array -> B\" :doc \"Left fold. The accumulator must end as an Int.\") (:name \"i64ArrayGenerate\" :type \"Int64 (fn [Int64] -> Int64) -> I64Array\" :doc \"Array of n elements, element i from the function applied to i.\") (:name \"i64ArrayGet\" :type \"I64Array Int64 -> Int64\" :doc \"Element at an index; an index outside the array traps with ERR_RANGE.\") (:name \"i64ArrayLen\" :type \"I64Array -> Int64\" :doc \"Element count.\") (:name \"i64ArrayScan\" :type \"(fn [Int64 Int64] -> Int64) Int64 I64Array -> I64Array\" :doc \"Every intermediate accumulator of a left fold, as an array.\") (:name \"i64ArraySlice\" :type \"I64Array Int64 Int64 -> I64Array\" :doc \"Half-open copy; bounds outside the array trap with ERR_RANGE.\") (:name \"i64ArraySum\" :type \"I64Array -> Int64\" :doc \"Sum; traps on Int64 overflow.\") (:name \"i8ArrayConcat\" :type \"(List I8Array) -> I8Array\" :doc \"Concatenate a list of arrays.\") (:name \"i8ArrayCountEq\" :type \"I8Array Int64 -> Int64\" :doc \"Number of elements equal to the value.\") (:name \"i8ArrayFold\" :type \"(fn [B Int64] -> B) B I8Array -> B\" :doc \"Left fold. The accumulator must end as an Int.\") (:name \"i8ArrayGenerate\" :type \"Int64 (fn [Int64] -> Int64) -> I8Array\" :doc \"Array of n elements, element i from the function applied to i. An element outside -128..127 traps.\") (:name \"i8ArrayGet\" :type \"I8Array Int64 -> Int64\" :doc \"Element at an index; an index outside the array traps with ERR_RANGE.\") (:name \"i8ArrayLen\" :type \"I8Array -> Int64\" :doc \"Element count.\") (:name \"i8ArrayScan\" :type \"(fn [Int64 Int64] -> Int64) Int64 I8Array -> I8Array\" :doc \"Every intermediate accumulator of a left fold, as an array.\") (:name \"i8ArraySlice\" :type \"I8Array Int64 Int64 -> I8Array\" :doc \"Half-open copy; bounds outside the array trap with ERR_RANGE.\") (:name \"i8ArraySum\" :type \"I8Array -> Int64\" :doc \"Sum; traps on Int64 overflow.\") (:name \"int32ToInt64\" :type \"Int32 -> Int64\" :doc \"Widen.\") (:name \"int64ToFloat64\" :type \"Int64 -> Float64\" :doc \"Convert to floating point.\") (:name \"int64ToInt32\" :type \"Int64 -> (Option Int32)\" :doc \"Narrow, or none when out of range.\") (:name \"interrupted\" :type \"() -> IoError\" :doc \"The interrupted failure (constructor).\") (:name \"invalidPath\" :type \"() -> IoError\" :doc \"The invalid path failure (constructor).\") (:name \"isFinite?\" :type \"Float64 -> Bool\" :doc \"False for NaN, inf and -inf.\") (:name \"isNan?\" :type \"Float64 -> Bool\" :doc \"True for NaN.\") (:name \"list\" :type \"T... -> (List T)\" :doc \"Construct a list; [a b] is the same value.\") (:name \"listAll?\" :type \"(fn [T] -> Bool) (List T) -> Bool\" :doc \"True when the predicate holds for every element, so true for an empty list.\") (:name \"listAny?\" :type \"(fn [T] -> Bool) (List T) -> Bool\" :doc \"True when the predicate holds for some element; stops at the first.\") (:name \"listAppend\" :type \"(List T) (List T) -> (List T)\" :doc \"Concatenate two lists.\") (:name \"listContains?\" :type \"(List T) T -> Bool\" :doc \"True when the element occurs.\") (:name \"listDrop\" :type \"(List T) Int64 -> (List T)\" :doc \"The list without its first n elements; (list) when it is shorter.\") (:name \"listEmpty?\" :type \"(List T) -> Bool\" :doc \"True when the list has no elements.\") (:name \"listGet\" :type \"(List T) Int64 -> (Option T)\" :doc \"Element at an index, or none.\") (:name \"listHead\" :type \"(List T) -> (Option T)\" :doc \"First element, or none.\") (:name \"listIndexOf\" :type \"(List T) T -> (Option Int64)\" :doc \"Index of the first occurrence, or none.\") (:name \"listLast\" :type \"(List T) -> (Option T)\" :doc \"The last element, or none for an empty list.\") (:name \"listLength\" :type \"(List T) -> Int64\" :doc \"Element count.\") (:name \"listMax\" :type \"(List T) -> (Option T)\" :doc \"Greatest element, or none when empty.\") (:name \"listMin\" :type \"(List T) -> (Option T)\" :doc \"Least element, or none when empty.\") (:name \"listReverse\" :type \"(List T) -> (List T)\" :doc \"Reverse order.\") (:name \"listSlice\" :type \"(List T) Int64 Int64 -> (Option (List T))\" :doc \"Half-open slice, or none when out of range.\") (:name \"listSort\" :type \"(List T) -> (List T)\" :doc \"Stable ascending merge sort; a NaN sorts last.\") (:name \"listSortBy\" :type \"(fn [T] -> K) (List T) -> (List T)\" :doc \"Stable ascending sort by a derived key; a NaN key sorts last.\") (:name \"listSum\" :type \"(List N) -> N\" :doc \"Sum of elements, 0 when empty. Traps on Int64 overflow.\") (:name \"listTail\" :type \"(List T) -> (Option (List T))\" :doc \"All but the first element, or none when empty.\") (:name \"listTake\" :type \"(List T) Int64 -> (List T)\" :doc \"The first n elements, fewer when the list is shorter; n <= 0 gives (list).\") (:name \"map\" :type \"(fn [A] -> B) (List A) -> (List B)\" :doc \"Apply a function to every element.\") (:name \"mapEmpty\" :type \"() -> (Map K V)\" :doc \"The empty map.\") (:name \"mapFromPairs\" :type \"(List (Pair K V)) -> (Map K V)\" :doc \"Build from pairs; later entries win.\") (:name \"mapGet\" :type \"(Map K V) K -> (Option V)\" :doc \"Value for a key, or none.\") (:name \"mapHas?\" :type \"(Map K V) K -> Bool\" :doc \"True when the key is present.\") (:name \"mapKeys\" :type \"(Map K V) -> (List K)\" :doc \"Keys, sorted.\") (:name \"mapPairs\" :type \"(Map K V) -> (List (Pair K V))\" :doc \"Entries as pairs, ordered by sorted key.\") (:name \"mapRemove\" :type \"(Map K V) K -> (Map K V)\" :doc \"Map without the key.\") (:name \"mapSet\" :type \"(Map K V) K V -> (Map K V)\" :doc \"Map with the key bound to the value; entries stay ordered by key.\") (:name \"mapSize\" :type \"(Map K V) -> Int64\" :doc \"Number of entries.\") (:name \"mapValues\" :type \"(Map K V) -> (List V)\" :doc \"Values, ordered by sorted key.\") (:name \"max\" :type \"N N -> N\" :doc \"Greater of two Int or two Float. With a NaN the result depends on order: (max nan 1.0) is 1.0.\") (:name \"min\" :type \"N N -> N\" :doc \"Lesser of two Int or two Float. With a NaN the result depends on order: (min nan 1.0) is nan, (min 1.0 nan) is 1.0.\") (:name \"mod\" :type \"N N -> N\" :doc \"Floored remainder, so the sign follows the divisor: (mod -7 3) is 2. Int only; traps on a zero divisor.\") (:name \"monotonicNs\" :type \"() -> Int64\" :doc \"Nanoseconds of monotonic time since an unspecified starting point (CLOCK_MONOTONIC).\") (:name \"none\" :type \"() -> (Option T)\" :doc \"An absent value (constructor).\") (:name \"none?\" :type \"(Option T) -> Bool\" :doc \"True when no value is present.\") (:name \"not\" :type \"Bool -> Bool\" :doc \"Negation of a Bool.\") (:name \"not=\" :type \"T T -> Bool\" :doc \"The same operator as !=.\") (:name \"notFound\" :type \"() -> IoError\" :doc \"The not found failure (constructor).\") (:name \"nowNs\" :type \"() -> Int64\" :doc \"Nanoseconds since the Unix epoch (CLOCK_REALTIME).\") (:name \"ok\" :type \"T -> (Result T E)\" :doc \"A successful result (constructor).\") (:name \"ok?\" :type \"(Result T E) -> Bool\" :doc \"True when the result succeeded.\") (:name \"optionMap\" :type \"(fn [A] -> B) (Option A) -> (Option B)\" :doc \"Transform a present value.\") (:name \"optionOr\" :type \"(Option T) T -> T\" :doc \"The value, or a fallback when absent.\") (:name \"optionToResult\" :type \"(Option T) E -> (Result T E)\" :doc \"Absent becomes the given failure.\") (:name \"or\" :type \"Bool... -> Bool\" :doc \"Disjunction; short-circuits; takes one or more Bool operands.\") (:name \"other\" :type \"() -> IoError\" :doc \"The other failure (constructor).\") (:name \"pair\" :type \"A B -> (Pair A B)\" :doc \"Construct a pair, taken apart with (mt p ((pair a b) ...)); a pair has no .-first field.\") (:name \"pairFirst\" :type \"(Pair A B) -> A\" :doc \"First component of a pair.\") (:name \"pairSecond\" :type \"(Pair A B) -> B\" :doc \"Second component of a pair.\") (:name \"parquetColumnType\" :type \"ParquetHandle String -> String\" :doc \"The column's physical type: int64, double, int8, int32 or other. An unknown column traps.\") (:name \"parquetNumRowGroups\" :type \"ParquetHandle -> Int64\" :doc \"Row group count.\") (:name \"parquetNumRows\" :type \"ParquetHandle -> Int64\" :doc \"Row count.\") (:name \"parquetOpen\" :type \"String -> (Result ParquetHandle String)\" :doc \"Open a Parquet file; the failure is a message.\") (:name \"parquetReadF64\" :type \"ParquetHandle String Int64 -> F64Array\" :doc \"A double column of one row group; a wrong type or row group traps.\") (:name \"parquetReadI64\" :type \"ParquetHandle String Int64 -> I64Array\" :doc \"An int64 column of one row group; a wrong type or row group traps.\") (:name \"parquetReadI8\" :type \"ParquetHandle String Int64 -> I8Array\" :doc \"An int8 column of one row group; a wrong type or row group traps.\") (:name \"partial\" :type \"(fn [A... B...] -> R) A... -> (fn [B...] -> R)\" :doc \"Bind leading arguments of a function.\") (:name \"pathCanonicalize\" :type \"String -> (Result String IoError)\" :doc \"Resolve a path with realpath; the failure is the IoError case, e.g. (err (notFound)).\") (:name \"pathRemove\" :type \"String -> (Result Unit String)\" :doc \"Remove a file or directory tree recursively without following symlinks out of it.\") (:name \"pathRename\" :type \"String String -> (Result Unit String)\" :doc \"Rename from to (rename(2)).\") (:name \"permissionDenied\" :type \"() -> IoError\" :doc \"The permission denied failure (constructor).\") (:name \"popcount64\" :type \"Int64 -> Int64\" :doc \"Number of one bits in the two's complement Int64, so (popcount64 -1) is 64.\") (:name \"print\" :type \"String -> (Result Unit IoError)\" :doc \"Write the arguments to standard output, separated by spaces, with no trailing newline.\") (:name \"println\" :type \"String -> (Result Unit IoError)\" :doc \"Write the arguments to standard output, separated by spaces, then a newline.\") (:name \"processRun\" :type \"String -> ProcessOutput\" :doc \"Run a command with /bin/sh -c and wait: {:exitCode Int64 :stdout String :stderr String}; a child killed by signal N exits 128+N. Failing to start it (pipe, fork) traps with ERR_IO.\") (:name \"processSpawn\" :type \"String -> (Result Int64 String)\" :doc \"Start /bin/sh -c cmd with stdout and stderr redirected, returning a handle id.\") (:name \"processWait\" :type \"Int64 Int64 -> (Result ProcessOutput String)\" :doc \"Wait up to timeoutMs (0 = no limit) for handle: (ok {:exitCode ... :stdout ... :stderr ...}); on timeout kills process group and returns exitCode 124.\") (:name \"range\" :type \"Int64 Int64 -> (List Int64)\" :doc \"Half-open integer range; empty when start is not below end.\") (:name \"realPath\" :type \"String -> (Result String String)\" :doc \"Resolve a path with realpath; the failure is a \\\"KIND: PATH: reason\\\" message.\") (:name \"resultMap\" :type \"(Result A E) (fn [A] -> B) -> (Result B E)\" :doc \"Transform a successful value. The Result comes first, unlike optionMap and resultMapErr.\") (:name \"resultMapErr\" :type \"(fn [E] -> F) (Result T E) -> (Result T F)\" :doc \"Transform a failure value.\") (:name \"resultOr\" :type \"(Result T E) T -> T\" :doc \"The value, or a fallback on failure.\") (:name \"resultToOption\" :type \"(Result T E) -> (Option T)\" :doc \"Failure becomes absence.\") (:name \"sleepMs\" :type \"Int64 -> Unit\" :doc \"Sleep for ms milliseconds (nanosleep, resumed after EINTR). A negative ms traps with ERR_RANGE.\") (:name \"some\" :type \"T -> (Option T)\" :doc \"A present value (constructor).\") (:name \"some?\" :type \"(Option T) -> Bool\" :doc \"True when a value is present.\") (:name \"sqrt\" :type \"Float64 -> Float64\" :doc \"Square root by scaled Newton steps; NaN for a negative or NaN argument, inf for inf.\") (:name \"str\" :type \"A... -> String\" :doc \"Concatenate the arguments; an Int or Float argument is rendered as text.\") (:name \"stringChars\" :type \"String -> (List String)\" :doc \"UTF-8 characters as one-character strings.\") (:name \"stringConcat\" :type \"String String -> String\" :doc \"Concatenate two strings.\") (:name \"stringContains?\" :type \"String String -> Bool\" :doc \"True when the substring occurs; the empty string always occurs.\") (:name \"stringCountChar\" :type \"String String -> Int64\" :doc \"How many characters of the string equal the one-character second argument.\") (:name \"stringEmpty?\" :type \"String -> Bool\" :doc \"True when the string has no bytes.\") (:name \"stringEndsWith?\" :type \"String String -> Bool\" :doc \"True when the string ends with the suffix.\") (:name \"stringFromFloat64\" :type \"Float64 -> String\" :doc \"Decimal rendering of a float.\") (:name \"stringFromInt64\" :type \"Int64 -> String\" :doc \"Decimal rendering of an integer.\") (:name \"stringIndexOf\" :type \"String String -> (Option Int64)\" :doc \"Byte index of the first occurrence, or none.\") (:name \"stringJoin\" :type \"(List String) String -> String\" :doc \"Join with a separator.\") (:name \"stringLength\" :type \"String -> Int64\" :doc \"Length in UTF-8 bytes, so (stringLength \\\"héllo\\\") is 6.\") (:name \"stringLines\" :type \"String -> (List String)\" :doc \"Split on \\\"\\\\n\\\"; a trailing newline gives a last empty line.\") (:name \"stringLower\" :type \"String -> String\" :doc \"Lower case for ASCII letters; other characters are unchanged.\") (:name \"stringRepeat\" :type \"String Int64 -> String\" :doc \"The string n times; n <= 0 gives \\\"\\\".\") (:name \"stringReplace\" :type \"String String String -> String\" :doc \"Replace every occurrence. An empty search string traps.\") (:name \"stringReverse\" :type \"String -> String\" :doc \"Reverse the UTF-8 character sequence.\") (:name \"stringSlice\" :type \"String Int64 Int64 -> (Option String)\" :doc \"Half-open byte slice, or none when out of range; a cut inside a multi-byte character splits it.\") (:name \"stringSplit\" :type \"String String -> (List String)\" :doc \"Split on a separator. An empty separator traps.\") (:name \"stringStartsWith?\" :type \"String String -> Bool\" :doc \"True when the string begins with the prefix.\") (:name \"stringToBytes\" :type \"String -> Bytes\" :doc \"The UTF-8 bytes of a string. The one string primitive past stringLength, stringSlice and stringConcat; charCode and fnv1a64 derive from it.\") (:name \"stringToFloat64\" :type \"String -> (Option Float64)\" :doc \"Parse a float; malformed input traps with ERR_PARSE.\") (:name \"stringToInt64\" :type \"String -> (Option Int64)\" :doc \"Parse an optionally signed integer, or none when it is malformed or outside Int64.\") (:name \"stringTrim\" :type \"String -> String\" :doc \"Remove leading and trailing spaces, tabs, carriage returns and newlines.\") (:name \"stringUpper\" :type \"String -> String\" :doc \"Upper case for ASCII letters; other characters are unchanged.\") (:name \"zip\" :type \"(List A) (List B) -> (List (Pair A B))\" :doc \"Pair up elements, truncating to the shorter list.\") (:name \"zstdDecompress\" :type \"Bytes -> (Result Bytes String)\" :doc \"Decompress a zstd frame; the failure is a message.\")) :unbound (\"read-line\" \"read-all\" \"file-append\" \"try\"))" :exit "0")
