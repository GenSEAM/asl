(:case :id "114" :ws "notes" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:note write :text \"via args\" :date \"2026-01-03\")" :stdout "(:note :action \"write\" :id \"n4\" :ledger \".asl/mem/notes.asn\" :countBefore 3 :countAfter 4 :persisted true)" :exit "0" :ledger ";; ledger\n(:notesLedger\n  :version \"1.0.0\"\n  :notes [\n    (:note :id \"n1\" :topic \"x\" :fact \"widget one\")\n    (:note :id \"n3\" :topic \"y\" :fact \"quoted (:note inside\")\n    (:note\n      :topic \"z\" :fact \"no id widget\")\n    (:note\n      :id \"n4\"\n      :topic \"observation\"\n      :author \"agent\"\n      :date \"2026-01-03\"\n      :status \"active\"\n      :scope [\"workspace\"]\n      :tags []\n      :fact \"via args\"\n      :timestamp 0)\n  ]\n)\n" :files ".asl/mem/notes.asn|.asl/vfs/notesLedger.lock")
(:case :id "115" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:batch (:query widgetCount :limit 2) (:tools :op read) (:note))" :stdout "(:batch (:query :in :code :defs (\"src/alpha.asl#widgetCount\") :hits (\"src/alpha.asl\" (\"(module ws/alpha :x [widgetCount widgetHelper])\")) :more 2 :text (:comment 1) :see \"(:query :text ... :in text)\") (:tools :op (:op :read :form \"(:read :file <path> [:symbol <sym>] [:anchor <str>] [:limit <int>] [:start <int>] [:end <int>])\" :params ((:file str req \"path to file in repository\") (:symbol str \"\" \"symbol definition to extract\") (:anchor str \"\" \"text anchor substring\") (:limit int 200 \"maximum line count to return\") (:start int 0 \"starting line number for slice\") (:end int 0 \"ending line number for slice\")) :examples (\"(:read :file \\\"asl/grammar/rules.asn\\\" :limit 10)\") :errors (ERR_MISSING_ARG ERR_FILE_NOT_FOUND ERR_SYMBOL_NOT_FOUND ERR_BOUNDARY_VIOLATION ERR_ANCHOR_NOT_FOUND ERR_BINARY) :related (query))) (:note :action \"list\" :receipt (:notes :count 0 :status :empty :source \".asl/mem/notes.asn\")))" :exit "0")
(:case :id "116" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:batch :seq true (:where) (:observe :dim ok))" :stdout "(:batch (:where :status :rejected :error ERR_MISSING_ARG :message \"Missing symbol argument\" :see \"(:help :op tools)\") (:observe :status :rejected :error ERR_UNKNOWN_DIM :dim \"ok\" :nearest (tokenCost memory) :message \"unknown dimension ok; known: tokenCost memory session callers status coverage\" :see \"(:help :op observe)\"))" :exit "1")
