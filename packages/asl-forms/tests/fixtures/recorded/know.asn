(:case :id "45" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:help)" :stdout "(:help :op (:op :read :public \"Return a symbol or bounded slice of a file.\" :doc \"Bounded AST symbol and slice retrieval without whole-file dumping; a binary file (NUL in the first 8 KB or a known magic) is rejected with ERR_BINARY, :bytes and :kind, never returned.\" :form \"(:read :file <path> [:symbol <sym>] [:anchor <str>] [:limit <int>] [:start <int>] [:end <int>])\" :params ((:file str req \"path to file in repository\") (:symbol str \"\" \"symbol definition to extract\") (:anchor str \"\" \"text anchor substring\") (:limit int 200 \"maximum line count to return\") (:start int 0 \"starting line number for slice\") (:end int 0 \"ending line number for slice\")) :examples (\"(:read :file \\\"asl/grammar/rules.asn\\\" :limit 10)\") :errors (ERR_MISSING_ARG ERR_FILE_NOT_FOUND ERR_SYMBOL_NOT_FOUND ERR_BOUNDARY_VIOLATION ERR_ANCHOR_NOT_FOUND ERR_BINARY) :related (query)))" :exit "0")
(:case :id "46" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:help :op edit)" :stdout "(:help :op (:op :edit :public \"Stage a string replacement in the session buffer.\" :doc \"Atomic string replacement staged in the session buffer; rejected when the staged result breaks delimiter balance or syntax. :all replaces every occurrence, :autofix (true, indentation or heuristic) stages a delimiter repair, :force stages anyway.\" :form \"(:edit :file <path> :old <str> :new <str> [:all <bool>] [:autofix <sym>] [:force <bool>])\" :params ((:file str req \"path to target file\") (:old str req \"exact target string to replace\") (:new str req \"replacement string\") (:all bool false \"replace all occurrences\") (:autofix sym :none \"structural or heuristic delimiter repair\") (:force bool false \"stage despite balance or syntax errors\")) :examples (\"(:edit :file \\\"asl/grammar/rules.asn\\\" :old \\\"rules\\\" :new \\\"rules\\\" :all true)\") :errors (ERR_MISSING_ARG ERR_FILE_NOT_FOUND ERR_NO_MATCH ERR_AMBIGUOUS ERR_UNBALANCED) :related (diff flush discard check txn)))" :exit "0")
(:case :id "47" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:help :topic staging)" :stdout "(:help :topic (:topic :name :staging :text \"Operations edit, write, and fix with :apply stage changes in a buffer on disk outside the working tree: .asl/vfs, or ~/.cache/asl/vfs/<hash> for a workspace without .asl; each ASL_SESSION has its own buffer, and without ASL_SESSION the workspace shares one. The buffer persists across calls until flush or discard, so a later bare (:flush) writes changes staged earlier. Operation diff shows staged changes against disk; check and test run against staged content. Operation flush writes every staged file atomically (fsync and rename) and refuses with ERR_STALE_BASE a file whose disk content changed since it was staged. Operation discard drops staged changes without touching disk. (:txn) stages, gates and flushes in one call.\" :examples (\"(:diff)\")))" :exit "0")
(:case :id "48" :ws "code" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:help staging)" :stdout "(:help :topic (:topic :name :staging :text \"Operations edit, write, and fix with :apply stage changes in a buffer on disk outside the working tree: .asl/vfs, or ~/.cache/asl/vfs/<hash> for a workspace without .asl; each ASL_SESSION has its own buffer, and without ASL_SESSION the workspace shares one. The buffer persists across calls until flush or discard, so a later bare (:flush) writes changes staged earlier. Operation diff shows staged changes against disk; check and test run against staged content. Operation flush writes every staged file atomically (fsync and rename) and refuses with ERR_STALE_BASE a file whose disk content changed since it was staged. Operation discard drops staged changes without touching disk. (:txn) stages, gates and flushes in one call.\" :examples (\"(:diff)\")))" :exit "0")
