(:case :id "108" :ws "empty" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:note :action write :claim first :date \"2026-01-02\")" :stdout "(:note :action \"write\" :id \"n1\" :ledger \".asl/mem/notes.asn\" :countBefore 0 :countAfter 1 :persisted true)" :exit "0" :ledger ";; Machine-Native Observations & Technical Notes Ledger\n(:notesLedger\n  :version \"1.0.0\"\n  :notes [\n    (:note\n      :id \"n1\"\n      :topic \"observation\"\n      :author \"agent\"\n      :date \"2026-01-02\"\n      :status \"active\"\n      :scope [\"workspace\"]\n      :tags []\n      :fact \"first\"\n      :timestamp 0)\n  ]\n)\n" :files ".asl/mem/notes.asn|.asl/vfs/notesLedger.lock|.keep")
(:case :id "109" :ws "notes" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:note :action write :claim \"   \")" :stdout "(:note :status :rejected :action \"write\" :error ERR_MISSING_ARG :message \"Missing :claim argument\" :see \"(:help :op note)\")" :exit "1" :ledger ";; ledger\n(:notesLedger\n  :version \"1.0.0\"\n  :notes [\n    (:note :id \"n1\" :topic \"x\" :fact \"widget one\")\n    (:note :id \"n3\" :topic \"y\" :fact \"quoted (:note inside\")\n    (:note\n      :topic \"z\" :fact \"no id widget\")\n  ]\n)\n" :files ".asl/mem/notes.asn")
(:case :id "110" :ws "notesBad" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:note :action write :claim x :date \"2026-01-02\")" :stdout "(:note :status :rejected :action \"write\" :error ERR_NOT_PERSISTED :message \"notes ledger has no closing :notes vector; refusing to guess an insertion point\" :see \"(:help :op note)\")" :exit "1" :ledger "(:notesLedger :notes [ (:note :id \"n1\") ] :extra 1)\n" :files ".asl/mem/notes.asn|.asl/vfs/notesLedger.lock")
(:case :id "111" :ws "notesUnbal" :tc "tc1" :extra "" :git "none" :bin "echo" :tools "" :form "(:note :action write :claim x :date \"2026-01-02\")" :stdout "(:note :status :rejected :action \"write\" :error ERR_NOT_PERSISTED :message \"appending would corrupt the ledger: mismatched delimiter ']' (expected ')') at byte 270\" :see \"(:help :op note)\")" :exit "1" :ledger "(:notesLedger\n  :notes [\n    (:note :id \"n1\" :fact \"x\"\n  ]\n)\n" :files ".asl/mem/notes.asn|.asl/vfs/notesLedger.lock")
