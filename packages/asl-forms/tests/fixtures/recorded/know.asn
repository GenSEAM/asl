           ((err e) (err (str \"cannot read \" f.rel \": \" e)))\n                    ((ok raw)\n                      (let [(mn (moduleName f.rel)) (name (pairFirst mn)) (isPkg (pairSecond mn))\n                            (m (PyMod :rel f.rel :name name :isPkg isPkg :pkg (if isPkg name (rpartDot name)) :src (c/universalNewlines raw) :tree tree\n                                      :isTest (testRel? f.rel) :toks f.toks :top (h/hmEmpty) :bindings (h/hmEmpty) :vars (h/omEmpty)\n                                      :varTypes (h/hmEmpty) :stars (list) :docstrings (h/hmEmpty) :importLines (h/hmEmpty) :comments (commentToks f.toks)))]\n                        (ok (pair (h/omPut (pairFirst st) name m) (pairSecond st)))))))))))\n        (ok (pair (h/omEmpty) (list))) files)\n\nfn collectMod st: (Pair (h/OMap PyMod) (h/OMap PyDef)) m: PyMod -> (Pair (h/OMap PyMod) (h/OMap PyDef))\n  (let [(b (Base :rel m.rel :name m.name :pkg m.pkg))\n        (mc (collect b (d/kids m.tree \"body\") \"\" (none) false\n                     (MC :top (h/hmEmpty) :bindings (h/hmEmpty) :vars (h/omEmpty) :stars (list) :importLines (h/hmEmpty) :defs (pairSecond st) :own (h/hmEmpty))))\n        (m2 (PyMod :rel m.rel :name m.name :isPkg m.isPkg :pkg m.pkg :src m.src :tree m.tree :isTest m.isTest :toks m.toks\n                   :top mc.top :bindings mc.bindings :vars mc.vars :varTypes (h/hmEmpty) :stars (listReverse mc.stars)\n                   :docstrings (docstringsOf m.tree (fold (fn [(acc (List d/PyNode)) (o (Option d/PyNode))] -> (List d/PyNode) (mt o ((some n) (cons n acc)) ((none) acc))) (list) (h/hmValues mc.own))) :importLines mc.importLines :comments m.comments))]\n    (pair (h/omPut (pairFirst st) m.name m2) mc.defs))\n\nfn ! buildPyIndex root: String want: String files: (List String) ctx: c/Ctx -> (Result Built String)\n  (let [(rels (filter (fn [(f String)] -> Bool (stringEndsWith? f \".py\")) files))]\n    (mt (d/runDump! root want rels ctx)\n      ((err e) (err e))\n      ((ok dump)\n        (mt dump\n          ((d/absent why) (ok (pyAbsent why)))\n          ((d/dumped pfiles warnings)\n            (mt (loadMods! root pfiles)\n              ((err e) (err e))\n              ((ok lm)\n                (let [(mods0 (pairFirst lm))\n                      (collected (fold collectMod (pair mods0 (h/omEmpty)) (h/omValues mods0)))\n                      (defs (pairSecond collected))\n                      (defList (h/omValues defs))\n                      (ix0 (Ix :mods (pairFirst collected) :pkgs (pkgsOf (map (fn [(p (Pair String PyMod))] -> String (pairFirst p)) (h/omPairs (pairFirst collected))))\n                               :defs defs :attrTypes (h/hmEmpty) :children (childrenOf defList)\n                               :lambdaKeys (fold (fn [(acc (h/HMap String)) (dd PyDef)] -> (h/HMap String) (if (= dd.kind \"lambda\") (h/hmPut acc (stringFromInt64 dd.node.id) dd.key) acc))\n                                                 (h/hmEmpty) defList)))\n                      (names (map (fn [(p (Pair String PyMod))] -> String (pairFirst p)) (h/omPairs ix0.mods)))\n                      (methods (fold (fn [(acc (h/HMap (List PyDef))) (dd PyDef)] -> (h/HMap (List PyDef)) (if (= dd.kind \"method\") (h/hmPut acc dd.modName (cons dd (optionOr (h/hmGet acc dd.modName) (list)))) acc))\n                                     (h/hmEmpty) (listReverse defList)))\n                      (ix (fold (fn [(acc Ix) (nm String)] -> Ix (typesOf methods acc nm)) ix0 names))\n                      (w (fold (fn [(acc W) (m PyMod)] -> W\n                                 (fold (fn [(a2 W) (st d/PyNode)] -> W (walk ix m st (list) (list) a2).w) acc (d/kids m.tree \"body\")))\n                               (emptyW) (h/omValues ix.mods)))\n                      (wOut (W :calls (listReverse w.calls) :refs (listReverse w.refs) :dynamic (listReverse w.dynamic) :untyped (listReverse w.untyped)\n                               :varReads w.varReads :edges w.edges :localsAt w.localsAt))]\n                  (ok (built (PyIndex :root root :ix ix :w wOut :unparsed (listReverse (pairSecond lm)) :warnings warnings)))))))))))\n")
(:file :tree "tc1" :path "asl/tools/observe/pyQuery.asl" :text "(module ws/asl/tools/observe/pyQuery\n  :x [targets stubWhy testDefs skipped patches reach directCallees commentsOf wordAt? todoIn? allDefs]\n  :i [(ws/asl/tools/observe/common :a c)\n      (ws/asl/tools/observe/hmap :a h)\n      (ws/asl/tools/observe/pyDump :a d)\n      (ws/asl/tools/observe/pyIndex :a p)])\n\nfn allDefs pi: p/PyIndex -> (List p/PyDef)\n  (h/omValues pi.ix.defs)\n\nfn keep? module: String dd: p/PyDef -> Bool\n  (or (stringEmpty? module) (= module dd.rel) (= module dd.modName))\n\nfn targets pi: p/PyIndex name: String module: String -> (List p/PyDef)\n  (let [(ds (allDefs pi))]\n    (if (stringContains? name \".\")\n      (filter (fn [(dd p/PyDef)] -> Bool (and (or (= dd.qual name) (stringEndsWith? dd.qual (str \".\" name))) (keep? module dd))) ds)\n      (let [(top (filter (fn [(dd p/PyDef)] -> Bool (and (= dd.name name) (listContains? (list \"function\" \"class\" \"lambda\") dd.kind) (keep? module dd))) ds))]\n        (if (not (listEmpty? top)) top (filter (fn [(dd p/PyDef)] -> Bool (and (= dd.name name) (keep? module dd))) ds)))))\n\nfn commentsOf m: p/PyMod -> (List (Pair Int64 String))\n  m.comments\n\nfn wordCode? k: Int64 -> Bool\n  (cond\n    ((< k 0) false)\n    ((< k 128) (or (and (>= k 48) (<= k 57)) (and (>= k 65) (<= k 90)) (and (>= k 97) (<= k 122)) (= k 95)))\n    ((c/pyIsSpaceCode k) false)\n    ((and (>= k 161) (<= k 191)) (listContains? (list 170 178 179 181 185 186 188 189 190) k))\n    ((or (= k 215) (= k 247)) false)\n    ((and (>= k 8208) (<= k 8231)) false)\n    ((and (>= k 8240) (<= k 8286)) false)\n    ((and (>= k 12288) (<= k 12291)) false)\n    ((and (>= k 12296) (<= k 12305)) false)\n    (else true))\n\nfn codeBefore s: String i: Int64 -> Int64\n  (if (<= i 0) -1 (let [(cs (c/charCodes (optionOr (stringSlice s (max 0 (- i 4)) i) \"\")))] (mt (listLast cs) ((some p) (pairFirst p)) ((none) -1))))\n\nfn codeAfter s: String i: Int64 -> Int64\n  (if (>= i (stringLength s)) -1 (mt (listHead (c/charCodes (optionOr (stringSlice s i (min (stringLength s) (+ i 4))) \"\"))) ((some p) (pairFirst p)) ((none) -1)))\n\nfn wordAt? s: String i: Int64 j: Int64 -> Bool\n  (let [(first (codeAfter s i)) (last (codeBefore s j))]\n    (and (!= (wordCode? (codeBefore s i)) (wordCode? first))\n         (!= (wordCode? last) (wordCode? (codeAfter s j)))))\n\nfn occurrences s: String w: String from: Int64 acc: (List Int64) -> (List Int64)\n  (let [(bs (stringToBytes s)) (i (c/findFrom bs (bytesLength bs) (stringToBytes w) from))]\n    (if (< i 0) (listReverse acc) (occurrences s w (+ i 1) (cons i acc))))\n\nfn anyWord? s: String w: String -> Bool\n  (listAny? (fn [(i Int64)] -> Bool (wordAt? s i (+ i (stringLength w)))) (occurrences s w 0 (list)))\n\nfn todoIn? text: String -> Bool\n  (or (anyWord? text \"TODO\") (anyWord? text \"FIXME\") (anyWord? text \"XXX\"))\n\nfn skipRx? s: String -> Bool\n  (let [(starts (occurrences s \"skip\" 0 (list)))\n        (lead? (fn [(i Int64)] -> Bool (not (wordCode? (codeBefore s i)))))\n        (tail? (fn [(j Int64)] -> Bool (not (wordCode? (codeAfter s j)))))\n        (sub (fn [(i Int64) (w String)] -> Bool (= (optionOr (stringSlice s i (+ i (stringLength w))) \"\") w)))]\n    (or (listAny? (fn [(i Int64)] -> Bool\n                    (and (lead? i)\n                         (or (and (sub (+ i 4) \"If\") (tail? (+ i 6)))\n                             (and (sub (+ i 4) \"Unless\") (tail? (+ i 10)))\n                             (tail? (+ i 4)))))\n                  starts)\n        (listAny? (fn [(i Int64)] -> Bool\n                    (and (>= i 5) (sub (- i 5) \"mark.\") (lead? (- i 5))\n                         (or (and (sub (+ i 4) \"if\") (tail? (+ i 6))) (tail? (+ i 4)))))\n                  starts)))\n\nfn bodyNoDoc n: d/PyNode -> (List d/PyNode)\n  (let [(body (d/kids n \"body\"))]\n    (mt (listHead body)\n      ((some b0) (if (and (d/isType? b0 \"Expr\") (mt (d/kid b0 \"value\") ((some v) (some? (d/constStr v))) ((none) false))) (optionOr (listTail body) (list)) body))\n      ((none) body)))\n\nfn exprConst? s: d/PyNode kind: String -> Bool\n  (and (d/isType? s \"Expr\") (mt (d/kid s \"value\") ((some v) (= (d/constKind v) (some kind))) ((none) false)))\n\nfn singleWhy s: d/PyNode -> (Option String)\n  (cond\n    ((and (d/isType? s \"Raise\") (some? (d/kid s \"exc\")))\n      (let [(ex (optionOr (d/kid s \"exc\") s))\n            (e (if (d/isType? ex \"Call\") (optionOr (d/kid ex \"func\") ex) ex))\n            (nm (optionOr (d/sfield e \"id\") \"\"))]\n        (if (and (d/isType? e \"Name\") (or (= nm \"NotImplementedError\") (= nm \"NotImplemented\"))) (some (str \"raises \" nm)) (none))))\n    ((d/isType? s \"Return\")\n      (mt (d/kid s \"value\")\n        ((none) (some \"returns None\"))\n        ((some v)\n          (cond\n            ((= (d/constKind v) (some \"NoneType\")) (some \"returns None\"))\n            ((and (d/isType? v \"Name\") (= (d/sfield v \"id\") (some \"NotImplemented\"))) (some \"returns NotImplemented\"))\n            (else (none))))))\n    (else (none)))\n\nfn stubWhy pi: p/PyIndex dd: p/PyDef -> (Option String)\n  (if (or (= dd.kind \"class\") (= dd.kind \"lambda\"))\n    (none)\n    (let [(body (bodyNoDoc dd.node))]\n      (cond\n        ((listEmpty? body) (some \"docstring only\"))\n        ((listAll? (fn [(s d/PyNode)] -> Bool (d/isType? s \"Pass\")) body) (some \"body is pass\"))\n        ((listAll? (fn [(s d/PyNode)] -> Bool (exprConst? s \"ellipsis\")) body) (some \"body is ...\"))\n        (else\n          (let [(single (if (= (listLength body) 1) (singleWhy (optionOr (listHead body) dd.node)) (none)))]\n            (mt single\n              ((some w) (some w))\n              ((none)\n                (mt (p/modOf pi.ix dd.modName)\n                  ((none) (none))\n                  ((some m)\n                    (mt (listHead (filter (fn [(cm (Pair Int64 String))] -> Bool (and (<= dd.line (pairFirst cm)) (<= (pairFirst cm) dd.end) (todoIn? (pairSecond cm)))) (commentsOf m)))\n                      ((some cm) (some (str \"TODO at line \" (stringFromInt64 (pairFirst cm)))))\n                      ((none) (none))))))))))))\n\nfn isTestMod? pi: p/PyIndex dd: p/PyDef -> Bool\n  (mt (p/modOf pi.ix dd.modName) ((some m) m.isTest) ((none) false))\n\nfn padLine n: Int64 -> String\n  (let [(s (stringFromInt64 n))] (str (stringRepeat \"0\" (max 0 (- 12 (stringLength s)))) s))\n\nfn testDefs pi: p/PyIndex -> (List p/PyDef)\n  (listSortBy (fn [(dd p/PyDef)] -> String (str dd.rel \"\\x00\" (padLine dd.line)))\n              (filter (fn [(dd p/PyDef)] -> Bool\n                        (and (isTestMod? pi dd) (stringStartsWith? dd.name \"test\")\n                             (or (= dd.kind \"function\")\n                                 (and (= dd.kind \"method\") (= (p/defKind pi.ix (p/defKey dd.modName (optionOr dd.cls \"\"))) \"class\")))))\n                      (allDefs pi)))\n\nfn classDecos pi: p/PyIndex t: p/PyDef -> (List d/PyNode)\n  (mt t.cls\n    ((some cq) (mt (p/defOf pi.ix (p/defKey t.modName cq)) ((some cd) (d/kids cd.node \"decorator_list\")) ((none) (list))))\n    ((none) (list)))\n\nfn skipped pi: p/PyIndex t: p/PyDef -> Bool\n  (let [(decos (listAppend (d/kids t.node \"decorator_list\") (classDecos pi t)))]\n    (or (listAny? (fn [(x d/PyNode)] -> Bool (skipRx? (optionOr x.u \"\"))) decos)\n        (listAny? (fn [(n d/PyNode)] -> Bool\n                    (and (d/isType? n \"Call\")\n                         (mt (d/kid n \"func\")\n                           ((some f) (let [(s (optionOr f.u \"\"))] (or (stringEndsWith? s \"skipTest\") (= s \"pytest.skip\") (= s \"skip\"))))\n                           ((none) false))))\n                  (d/walkBfs t.node))))\n\nfn dottedStep ix: p/Ix cur: (Option p/Res) part: String -> (Option p/Res)\n  (mt cur\n    ((none) (none))\n    ((some r)\n      (cond\n        ((= r.tag \"mod\") (p/resolveSym ix r.val part 0))\n        ((and (= r.tag \"def\") (= (p/defKind ix r.val) \"class\"))\n          (optionMap (fn [(k String)] -> p/Res (p/Res :tag \"def\" :val k :how \"\" :hops 0)) (p/methodOf ix r.val part 0)))\n        (else (none)))))\n\nfn dottedFrom ix: p/Ix parts: (List String) i: Int64 -> (Option String)\n  (if (< i 1)\n    (none)\n    (let [(m (c/joinWith (listTake parts i) \".\"))]\n      (if (not (or (h/omHas? ix.mods m) (h/hmHas? ix.pkgs m)))\n        (dottedFrom ix parts (- i 1))\n        (mt (fold (fn [(cur (Option p/Res)) (part String)] -> (Option p/Res) (dottedStep ix cur part))\n                  (some (p/Res :tag \"mod\" :val m :how \"\" :hops 0)) (listDrop parts i))\n          ((some r) (if (= r.tag \"def\") (some r.val) (none)))\n          ((none) (none))))))\n\nfn resolveDotted ix: p/Ix s: String -> (Option String)\n  (let [(parts (stringSplit s \".\"))] (dottedFrom ix parts (- (listLength parts) 1)))\n\nfn patchKey pi: p/PyIndex tmod: p/PyMod n: d/PyNode -> (Option String)\n  (let [(ix pi.ix)\n        (fname (mt (d/kid n \"func\") ((some f) (optionOr f.u \"\")) ((none) \"\")))\n        (args (d/kids n \"args\"))\n        (arg0 (listGet args 0))\n        (str0 (mt arg0 ((some a) (d/constStr a)) ((none) (none))))\n        (str1 (mt (listGet args 1) ((some a) (d/constStr a)) ((none) (none))))\n        (monkey (and (stringEndsWith? fname \".setattr\") (stringContains? fname \"monkeypatch\")))]\n    (cond\n      ((and (or (= fname \"patch\") (stringEndsWith? fname \".patch\")) (some? str0)) (resolveDotted ix (optionOr str0 \"\")))\n      ((and (or (stringEndsWith? fname \"patch.object\") monkey) (>= (listLength args) 2) (some? str1))\n        (let [(attr (optionOr str1 \"\"))]\n          (mt (p/resolveExpr ix tmod (optionOr arg0 n) (list))\n            ((some base)\n              (cond\n                ((= base.tag \"mod\")\n                  (mt (p/resolveSym ix base.val attr 0) ((some r) (if (= r.tag \"def\") (some r.val) (none))) ((none) (none))))\n                ((or (= base.tag \"def\") (= base.tag \"inst\"))\n                  (if (= (p/defKind ix base.val) \"class\") (p/methodOf ix base.val attr 0) (none)))\n                (else (none))))\n            ((none) (none)))))\n      ((and monkey (some? str0)) (resolveDotted ix (optionOr str0 \"\")))\n      (else (none))))\n\nfn patches pi: p/PyIndex t: p/PyDef -> (h/HMap Bool)\n  (mt (p/modOf pi.ix t.modName)\n    ((none) (h/hmEmpty))\n    ((some tmod)\n      (let [(roots (listAppend (listAppend (d/kids t.node \"decorator_list\") (list t.node)) (classDecos pi t)))]\n        (fold (fn [(acc (h/HMap Bool)) (root d/PyNode)] -> (h/HMap Bool)\n                (fold (fn [(a2 (h/HMap Bool)) (n d/PyNode)] -> (h/HMap Bool)\n                        (if (d/isType? n \"Call\") (mt (patchKey pi tmod n) ((some k) (h/hmPut a2 k true)) ((none) a2)) a2))\n                      acc (d/walkBfs root)))\n              (h/hmEmpty) roots))))\n\nfn edgesOf pi: p/PyIndex k: String -> (List String)\n  (map (fn [(q (Pair String Bool))] -> String (pairFirst q)) (h/hmPairs (optionOr (h/hmGet pi.w.edges k) (h/hmEmpty))))\n\nfn reachLoop pi: p/PyIndex todo: (List String) cut: (h/HMap Bool) seen: (h/HMap Bool) -> (h/HMap Bool)\n  (mt (listHead todo)\n    ((none) seen)\n    ((some k)\n      (let [(st (fold (fn [(acc (Pair (h/HMap Bool) (List String))) (cc String)] -> (Pair (h/HMap Bool) (List String))\n                        (if (or (h/hmHas? (pairFirst acc) cc) (h/hmHas? cut cc)) acc (pair (h/hmPut (pairFirst acc) cc true) (cons cc (pairSecond acc)))))\n                      (pair seen (optionOr (listTail todo) (list))) (edgesOf pi k)))]\n        (reachLoop pi (pairSecond st) cut (pairFirst st)))))\n\nfn reach pi: p/PyIndex t: p/PyDef cut: (h/HMap Bool) -> (h/HMap Bool)\n  (let [(setUp (mt t.cls ((some cq) (p/methodOf pi.ix (p/defKey t.modName cq) \"setUp\" 0)) ((none) (none))))\n        (start (mt setUp ((some s) (list t.key s)) ((none) (list t.key))))]\n    (reachLoop pi start cut (h/hmEmpty)))\n\nfn directCallees pi: p/PyIndex t: p/PyDef -> (h/HMap Bool)\n  (optionOr (h/hmGet pi.w.edges t.key) (h/hmEmpty))\n")
(:file :tree "tc1" :path "asl/packages/asl-forms/src/similarity.asl" :text "(module asl-forms/similarity :x [ratio getCloseMatches nearestSymbols] :i [])\n\n\n(schema MatchBlock (:f i Int64) (:f j Int64) (:f size Int64))\n\n(schema Scored (:f score Float64) (:f text String))\n\n\nfn runLength a: Bytes b: Bytes i: Int64 j: Int64 ahi: Int64 bhi: Int64 k: Int64 -> Int64\n  (if (and (< (+ i k) ahi) (< (+ j k) bhi) (= (bytesGet a (+ i k)) (bytesGet b (+ j k))))\n    (runLength a b i j ahi bhi (+ k 1))\n    k)\n\nfn scanJ a: Bytes b: Bytes i: Int64 j: Int64 ahi: Int64 bhi: Int64 best: MatchBlock -> MatchBlock\n  (if (>= j bhi)\n    best\n    (let [(k (runLength a b i j ahi bhi 0))]\n      (scanJ a b i (+ j 1) ahi bhi (if (> k best.size) (MatchBlock :i i :j j :size k) best))))\n\nfn longestMatch a: Bytes b: Bytes i: Int64 ahi: Int64 blo: Int64 bhi: Int64 best: MatchBlock -> MatchBlock\n  (if (>= i ahi)\n    best\n    (longestMatch a b (+ i 1) ahi blo bhi (scanJ a b i blo ahi bhi best)))\n\nfn matchedCount a: Bytes b: Bytes alo: Int64 ahi: Int64 blo: Int64 bhi: Int64 -> Int64\n  (if (or (>= alo ahi) (>= blo bhi))\n    0\n    (let [(m (longestMatch a b alo ahi blo bhi (MatchBlock :i alo :j blo :size 0)))\n          (k m.size)]\n      (if (= k 0)\n        0\n        (+ k\n           (matchedCount a b alo m.i blo m.j)\n           (matchedCount a b (+ m.i k) ahi (+ m.j k) bhi)))))\n\nfn ratio a: String b: String -> Float64\n  (let [(la (stringLength a))\n        (lb (stringLength b))]\n    (if (= (+ la lb) 0)\n      1.0\n      (/ (* 2.0 (int64ToFloat64 (matchedCount (stringToBytes a) (stringToBytes b) 0 la 0 lb))) (int64ToFloat64 (+ la lb)))))\n\nfn better? x: Scored y: Scored -> Bool\n  (or (> x.score y.score) (and (= x.score y.score) (> x.text y.text)))\n\nfn insertScored item: Scored items: (List Scored) -> (List Scored)\n  (mt (listHead items)\n    ((none) (list item))\n    ((some hd) (if (better? item hd) (cons item items) (cons hd (insertScored item (optionOr (listTail items) (list)))))))\n\nfn getCloseMatches word: String possibilities: (List String) n: Int64 cutoff: Float64 -> (List String)\n  (let [(scored (fold (fn [(acc (List Scored)) (x String)] -> (List Scored)\n                        (let [(r (ratio x word))]\n                          (if (>= r cutoff) (insertScored (Scored :score r :text x) acc) acc)))\n                      (list)\n                      possibilities))]\n    (map (fn [(s Scored)] -> String s.text) (listTake scored n)))\n\nfn dedupSorted items: (List String) acc: (List String) -> (List String)\n  (mt (listHead items)\n    ((none) (listReverse acc))\n    ((some x)\n      (dedupSorted (optionOr (listTail items) (list)) (if (and (not (listEmpty? acc)) (= (optionOr (listHead acc) \"\") x)) acc (cons x acc)))))\n\nfn fillNear names: (List String) low: String near: (List String) k: Int64 -> (List String)\n  (mt (listHead names)\n    ((none) near)\n    ((some nm)\n      (if (>= (listLength near) k)\n        near\n        (let [(lowNm (stringLower nm))\n              (take (and (not (listContains? near nm)) (or (stringContains? lowNm low) (stringContains? low lowNm))))]\n          (fillNear (optionOr (listTail names) (list)) low (if take (listAppend near (list nm)) near) k)))))\n\nfn nearestSymbols sym: String names: (List String) k: Int64 -> (List String)\n  (let [(sorted (dedupSorted (listSort names) (list)))\n        (near (getCloseMatches sym sorted k 0.5))]\n    (listTake (fillNear sorted (stringLower sym) near k) k))\n")
(:file :tree "tc1" :path "asl/packages/asl-regex/src/regex.asl" :text "(module asl-regex/regex\n  :x [Match Regex regex-compile! regex-compile-flags! regex-search! regex-match-full! regex-find-all! regex-replace-all! regex-group regex-match?]\n  :i [])\n\nschema Match {\n  start: Int64\n  end: Int64\n  text: String\n  groups: (List (Option String))\n}\n\nschema Regex {\n  pattern: String\n  unanchoredCode: I64Array\n  unanchoredLen: Int64\n  anchoredCode: I64Array\n  anchoredLen: Int64\n  nsub: Int64\n  classes: (List Bytes)\n  multiline: Bool\n  dotall: Bool\n  ignoreCase: Bool\n}\n\nschema Thread {\n  pc: Int64\n  saved: (List Int64)\n}\n\nenum Ast\n  (astChar c: Int64)\n  (astDot)\n  (astClass id: Int64)\n  (astAnchor atype: Int64)\n  (astEmpty)\n  (astSeq items: (List Ast))\n  (astAlt left: Ast right: Ast)\n  (astGroup gid: Int64 inner: Ast)\n  (astRep inner: Ast min: Int64 max: Int64 greedy: Bool)\n\nenum ParseRes\n  (parseOk node: Ast nextPos: Int64 groupCount: Int64 classes: (List Bytes))\n  (parseErr pos: Int64 msg: String)\n\nschema StepRes {\n  threads: (List Thread)\n  matched: (Option (List Int64))\n  visitedPcs: (List Int64)\n}\n\nfn is-word-byte b: Int64 -> Bool\n  (or (and (>= b 97) (<= b 122))\n      (or (and (>= b 65) (<= b 90))\n          (or (and (>= b 48) (<= b 57))\n              (= b 95))))\n\nfn is-digit-byte b: Int64 -> Bool\n  (and (>= b 48) (<= b 57))\n\nfn is-space-byte b: Int64 -> Bool\n  (or (= b 32)\n      (or (= b 9)\n          (or (= b 10)\n              (or (= b 13)\n                  (or (= b 12)\n                      (= b 11))))))\n\nfn fill-range! bytes: Bytes from: Int64 to: Int64 val: Int64 -> Unit\n  (if (> from to)\n    ()\n    (let [(_ (bytesSet bytes from val))]\n      (fill-range! bytes (+ from 1) to val)))\n\nfn make-digit-class! -> Bytes\n  (let [(b (bytesAlloc 256))]\n    (fill-range! b 48 57 1)\n    b)\n\nfn make-not-digit-class! -> Bytes\n  (let [(b (bytesAlloc 256))]\n    (fill-range! b 0 255 1)\n    (fill-range! b 48 57 0)\n    b)\n\nfn make-word-class! -> Bytes\n  (let [(b (bytesAlloc 256))]\n    (fill-range! b 48 57 1)\n    (fill-range! b 65 90 1)\n    (fill-range! b 97 122 1)\n    (bytesSet b 95 1)\n    b)\n\nfn make-not-word-class! -> Bytes\n  (let [(b (bytesAlloc 256))]\n    (fill-range! b 0 255 1)\n    (fill-range! b 48 57 0)\n    (fill-range! b 65 90 0)\n    (fill-range! b 97 122 0)\n    (bytesSet b 95 0)\n    b)\n\nfn make-space-class -> Bytes\n  (let [(b (bytesAlloc 256))]\n    (bytesSet b 32 1)\n    (bytesSet b 9 1)\n    (bytesSet b 10 1)\n    (bytesSet b 13 1)\n    (bytesSet b 12 1)\n    (bytesSet b 11 1)\n    b)\n\nfn make-not-space-class! -> Bytes\n  (let [(b (bytesAlloc 256))]\n    (fill-range! b 0 255 1)\n    (bytesSet b 32 0)\n    (bytesSet b 9 0)\n    (bytesSet b 10 0)\n    (bytesSet b 13 0)\n    (bytesSet b 12 0)\n    (bytesSet b 11 0)\n    b)\n\nfn add-class classes: (List Bytes) cls: Bytes -> (Pair Int64 (List Bytes))\n  (let [(id (listLength classes))\n        (newClasses (listAppend classes (list cls)))]\n    (pair id newClasses))\n\nfn parse-regex! bs: Bytes n: Int64 pos: Int64 gc: Int64 classes: (List Bytes) -> ParseRes\n  (parse-alt! bs n pos gc classes)\n\nfn parse-alt! bs: Bytes n: Int64 pos: Int64 gc: Int64 classes: (List Bytes) -> ParseRes\n  (mt (parse-concat! bs n pos gc classes)\n    ((parseErr ep em) (parseErr ep em))\n    ((parseOk leftNode p1 gc1 cl1)\n      (if (and (< p1 n) (= (bytesGet bs p1) 124))\n        (mt (parse-alt! bs n (+ p1 1) gc1 cl1)\n          ((parseErr ep em) (parseErr ep em))\n          ((parseOk rightNode p2 gc2 cl2)\n            (parseOk (astAlt leftNode rightNode) p2 gc2 cl2)))\n        (parseOk leftNode p1 gc1 cl1))))\n\nfn parse-concat-loop! bs: Bytes n: Int64 pos: Int64 gc: Int64 classes: (List Bytes) acc: (List Ast) -> ParseRes\n  (if (or (>= pos n) (or (= (bytesGet bs pos) 124) (= (bytesGet bs pos) 41)))\n    (cond\n      ((listEmpty? acc) (parseOk (astEmpty) pos gc classes))\n      ((= (listLength acc) 1) (parseOk (optionOr (listHead acc) (astEmpty)) pos gc classes))\n      (else (parseOk (astSeq acc) pos gc classes)))\n    (mt (parse-piece! bs n pos gc classes)\n      ((parseErr ep em) (parseErr ep em))\n      ((parseOk piece p1 gc1 cl1)\n        (parse-concat-loop! bs n p1 gc1 cl1 (listAppend acc (list piece))))))\n\nfn parse-concat! bs: Bytes n: Int64 pos: Int64 gc: Int64 classes: (List Bytes) -> ParseRes\n  (parse-concat-loop! bs n pos gc classes (list))\n\nfn desugar-repeat atom: Ast min: Int64 max: Int64 greedy: Bool -> Ast\n  (cond\n    ((and (= min 0) (= max 1)) (astRep atom 0 1 greedy))\n    ((and (= min 0) (= max -1)) (astRep atom 0 -1 greedy))\n    ((and (= min 1) (= max -1)) (astRep atom 1 -1 greedy))\n    ((= min max)\n      (let [(copies (make-copies atom min (list)))]\n        (if (= min 1) atom (astSeq copies))))\n    ((= max -1)\n      (let [(exactCopies (make-copies atom (- min 1) (list)))\n            (repTail (astRep atom 1 -1 greedy))]\n        (astSeq (listAppend exactCopies (list repTail)))))\n    (else\n      (let [(exactCopies (make-copies atom min (list)))\n            (optCopies (make-copies (astRep atom 0 1 greedy) (- max min) (list)))]\n        (astSeq (listAppend exactCopies optCopies)))))\n\nfn make-copies atom: Ast count: Int64 acc: (List Ast) -> (List Ast)\n  (if (<= count 0)\n    acc\n    (make-copies atom (- count 1) (cons atom acc)))\n\nfn parse-digits bs: Bytes n: Int64 pos: Int64 acc: Int64 count: Int64 -> (Pair Int64 Int64)\n  (if (>= pos n)\n    (pair pos (if (> count 0) acc -1))\n    (let [(b (bytesGet bs pos))]\n      (if (is-digit-byte b)\n        (parse-digits bs n (+ pos 1) (+ (* acc 10) (- b 48)) (+ count 1))\n        (pair pos (if (> count 0) acc -1)))))\n\nfn parse-repeat bs: Bytes n: Int64 pos: Int64 atom: Ast gc: Int64 classes: (List Bytes) -> ParseRes\n  (let [(d1 (parse-digits bs n (+ pos 1) 0 0))\n        (p1 (pairFirst d1))\n        (m (pairSecond d1))]\n    (if (< m 0)\n      (parseErr pos \"invalid repeat count in '{...}'\")\n      (if (>= p1 n)\n        (parseErr pos \"unclosed repeat '{...'\")\n        (let [(b1 (bytesGet bs p1))]\n          (cond\n            ((= b1 125)\n              (let [(p2 (+ p1 1))\n                    (greedy (not (and (< p2 n) (= (bytesGet bs p2) 63))))\n                    (nextP (if greedy p2 (+ p2 1)))]\n                (parseOk (desugar-repeat atom m m greedy) nextP gc classes)))\n            ((= b1 44)\n              (let [(d2 (parse-digits bs n (+ p1 1) 0 0))\n                    (p2 (pairFirst d2))\n                    (maxVal (pairSecond d2))]\n                (if (>= p2 n)\n                  (parseErr pos \"unclosed repeat '{...'\")\n                  (if (= (bytesGet bs p2) 125)\n                    (let [(p3 (+ p2 1))\n                          (greedy (not (and (< p3 n) (= (bytesGet bs p3) 63))))\n                          (nextP (if greedy p3 (+ p3 1)))]\n                      (if (>= maxVal 0)\n                        (if (< maxVal m)\n                          (parseErr pos \"min repeat greater than max\")\n                          (parseOk (desugar-repeat atom m maxVal greedy) nextP gc classes))\n                        (parseOk (desugar-repeat atom m -1 greedy) nextP gc classes)))\n                    (parseErr p2 \"expected '}' in repeat\")))))\n            (else (parseErr p1 \"expected ',' or '}' in repeat\")))))))\n\nfn parse-piece! bs: Bytes n: Int64 pos: Int64 gc: Int64 classes: (List Bytes) -> ParseRes\n  (mt (parse-atom! bs n pos gc classes)\n    ((parseErr ep em) (parseErr ep em))\n    ((parseOk atom p1 gc1 cl1)\n      (if (>= p1 n)\n        (parseOk atom p1 gc1 cl1)\n        (let [(b (bytesGet bs p1))]\n          (cond\n            ((= b 42)\n              (let [(lazy (and (< (+ p1 1) n) (= (bytesGet bs (+ p1 1)) 63)))\n                    (nextP (if lazy (+ p1 2) (+ p1 1)))]\n                (parseOk (astRep atom 0 -1 (not lazy)) nextP gc1 cl1)))\n            ((= b 43)\n              (let [(lazy (and (< (+ p1 1) n) (= (bytesGet bs (+ p1 1)) 63)))\n                    (nextP (if lazy (+ p1 2) (+ p1 1)))]\n                (parseOk (astRep atom 1 -1 (not lazy)) nextP gc1 cl1)))\n            ((= b 63)\n              (let [(lazy (and (< (+ p1 1) n) (= (bytesGet bs (+ p1 1)) 63)))\n                    (nextP (if lazy (+ p1 2) (+ p1 1)))]\n                (parseOk (astRep atom 0 1 (not lazy)) nextP gc1 cl1)))\n            ((= b 123)\n              (parse-repeat bs n p1 atom gc1 cl1))\n            (else (parseOk atom p1 gc1 cl1)))))))\n\nfn parse-class! bs: Bytes n: Int64 pos: Int64 gc: Int64 classes: (List Bytes) -> ParseRes\n  (let [(p0 (+ pos 1))]\n    (if (>= p0 n)\n      (parseErr pos \"unclosed character class '['\")\n      (let [(negated (= (bytesGet bs p0) 94))\n            (p1 (if negated (+ p0 1) p0))\n            (table (bytesAlloc 256))]\n        (parse-class-items! bs n p1 table negated pos gc classes))))\n\nfn parse-class-items! bs: Bytes n: Int64 p: Int64 table: Bytes negated: Bool startPos: Int64 gc: Int64 classes: (List Bytes) -> ParseRes\n  (if (>= p n)\n    (parseErr startPos \"unclosed character class '['\")\n    (let [(b (bytesGet bs p))]\n      (if (= b 93)\n        (let [(finalTable (if negated (invert-class-table! table) table))\n              (pCls (add-class classes finalTable))\n              (clsId (pairFirst pCls))\n              (newCls (pairSecond pCls))]\n          (parseOk (astClass clsId) (+ p 1) gc newCls))\n        (parse-one-class-item! bs n p table negated startPos gc classes))))\n\nfn invert-class-table! table: Bytes -> Bytes\n  (let [(out (bytesAlloc 256))]\n    (invert-loop! table out 0)\n    out)\n\nfn invert-loop! table: Bytes out: Bytes i: Int64 -> Unit\n  (if (> i 255)\n    ()\n    (let [(_ (bytesSet out i (if (= (bytesGet table i) 1) 0 1)))]\n      (invert-loop! table out (+ i 1))))\n\nfn parse-one-class-item! bs: Bytes n: Int64 p: Int64 table: Bytes negated: Bool startPos: Int64 gc: Int64 classes: (List Bytes) -> ParseRes\n  (let [(b (bytesGet bs p))]\n    (if (= b 92)\n      (if (>= (+ p 1) n)\n        (parseErr p \"trailing backslash in character class\")\n        (let [(esc (bytesGet bs (+ p 1)))]\n          (cond\n            ((= esc 100)\n              (fill-range! table 48 57 1)\n              (parse-class-items! bs n (+ p 2) table negated startPos gc classes))\n            ((= esc 119)\n              (fill-range! table 48 57 1)\n              (fill-range! table 65 90 1)\n              (fill-range! table 97 122 1)\n              (bytesSet table 95 1)\n              (parse-class-items! bs n (+ p 2) table negated startPos gc classes))\n            ((= esc 115)\n              (bytesSet table 32 1)\n              (bytesSet table 9 1)\n              (bytesSet table 10 1)\n              (bytesSet table 13 1)\n              (bytesSet table 12 1)\n              (bytesSet table 11 1)\n              (parse-class-items! bs n (+ p 2) table negated startPos gc classes))\n            ((= esc 110)\n              (parse-range-or-char! bs n (+ p 2) 10 table negated startPos gc classes))\n            ((= esc 116)\n              (parse-range-or-char! bs n (+ p 2) 9 table negated startPos gc classes))\n            ((= esc 114)\n              (parse-range-or-char! bs n (+ p 2) 13 table negated startPos gc classes))\n            (else\n              (parse-range-or-char! bs n (+ p 2) esc table negated startPos gc classes)))))\n      (parse-range-or-char! bs n (+ p 1) b table negated startPos gc classes)))\n\nfn parse-range-or-char! bs: Bytes n: Int64 nextP: Int64 c1: Int64 table: Bytes negated: Bool startPos: Int64 gc: Int64 classes: (List Bytes) -> ParseRes\n  (if (and (< (+ nextP 1) n) (and (= (bytesGet bs nextP) 45) (!= (bytesGet bs (+ nextP 1)) 93)))\n    (let [(p2 (+ nextP 1))\n          (b2 (bytesGet bs p2))]\n      (if (= b2 92)\n        (if (>= (+ p2 1) n)\n          (parseErr p2 \"trailing backslash in class range\")\n          (let [(c2 (unescape-char-byte (bytesGet bs (+ p2 1))))]\n            (if (< c2 c1)\n              (parseErr nextP \"range out of order in character class\")\n              (let [(_ (fill-range! table c1 c2 1))]\n                (parse-class-items! bs n (+ p2 2) table negated startPos gc classes)))))\n        (if (< b2 c1)\n          (parseErr nextP \"range out of order in character class\")\n          (let [(_ (fill-range! table c1 b2 1))]\n            (parse-class-items! bs n (+ p2 1) table negated startPos gc classes)))))\n    (let [(_ (bytesSet table c1 1))]\n      (parse-class-items! bs n nextP table negated startPos gc classes)))\n\nfn unescape-char-byte esc: Int64 -> Int64\n  (cond\n    ((= esc 110) 10)\n    ((= esc 114) 13)\n    ((= esc 116) 9)\n    ((= esc 102) 12)\n    ((= esc 118) 11)\n    (else esc))\n\nfn parse-atom! bs: Bytes n: Int64 pos: Int64 gc: Int64 classes: (List Bytes) -> ParseRes\n  (if (>= pos n)\n    (parseErr pos \"unexpected end of pattern\")\n    (let [(b (bytesGet bs pos))]\n      (cond\n        ((= b 40)\n          (if (and (< (+ pos 2) n) (and (= (bytesGet bs (+ pos 1)) 63) (= (bytesGet bs (+ pos 2)) 58)))\n            (mt (parse-regex! bs n (+ pos 3) gc classes)\n              ((parseErr ep em) (parseErr ep em))\n              ((parseOk inner p1 gc1 cl1)\n                (if (and (< p1 n) (= (bytesGet bs p1) 41))\n                  (parseOk (astGroup 0 inner) (+ p1 1) gc1 cl1)\n                  (parseErr p1 \"unclosed non-capturing group '(?:'\"))))\n            (let [(newGc (+ gc 1))]\n              (mt (parse-regex! bs n (+ pos 1) newGc classes)\n                ((parseErr ep em) (parseErr ep em))\n                ((parseOk inner p1 gc1 cl1)\n                  (if (and (< p1 n) (= (bytesGet bs p1) 41))\n                    (parseOk (astGroup newGc inner) (+ p1 1) gc1 cl1)\n                    (parseErr pos \"unclosed group '('\")))))))\n        ((= b 41) (parseErr pos \"unmatched close parenthesis ')'\"))\n        ((= b 91) (parse-class! bs n pos gc classes))\n        ((= b 46) (parseOk (astDot) (+ pos 1) gc classes))\n        ((= b 94) (parseOk (astAnchor 1) (+ pos 1) gc classes))\n        ((= b 36) (parseOk (astAnchor 2) (+ pos 1) gc classes))\n        ((or (= b 42) (or (= b 43) (= b 63))) (parseErr pos \"quantifier without preceding token\"))\n        ((= b 92)\n          (if (>= (+ pos 1) n)\n            (parseErr pos \"trailing backslash '\\\\'\")\n            (let [(esc (bytesGet bs (+ pos 1)))]\n              (cond\n                ((= esc 100)\n                  (let [(pCls (add-class classes (make-digit-class!)))]\n                    (parseOk (astClass (pairFirst pCls)) (+ pos 2) gc (pairSecond pCls))))\n                ((= esc 68)\n                  (let [(pCls (add-class classes (make-not-digit-class!)))]\n                    (parseOk (astClass (pairFirst pCls)) (+ pos 2) gc (pairSecond pCls))))\n                ((= esc 119)\n                  (let [(pCls (add-class classes (make-word-class!)))]\n                    (parseOk (astClass (pairFirst pCls)) (+ pos 2) gc (pairSecond pCls))))\n                ((= esc 87)\n                  (let [(pCls (add-class classes (make-not-word-class!)))]\n                    (parseOk (astClass (pairFirst pCls)) (+ pos 2) gc (pairSecond pCls))))\n                ((= esc 115)\n                  (let [(pCls (add-class classes (make-space-class)))]\n                    (parseOk (astClass (pairFirst pCls)) (+ pos 2) gc (pairSecond pCls))))\n                ((= esc 83)\n                  (let [(pCls (add-class classes (make-not-space-class!)))]\n                    (parseOk (astClass (pairFirst pCls)) (+ pos 2) gc (pairSecond pCls))))\n                ((= esc 98) (parseOk (astAnchor 3) (+ pos 2) gc classes))\n                ((= esc 66) (parseOk (astAnchor 4) (+ pos 2) gc classes))\n                ((= esc 110) (parseOk (astChar 10) (+ pos 2) gc classes))\n                ((= esc 114) (parseOk (astChar 13) (+ pos 2) gc classes))\n                ((= esc 116) (parseOk (astChar 9) (+ pos 2) gc classes))\n                ((= esc 102) (parseOk (astChar 12) (+ pos 2) gc classes))\n                ((= esc 118) (parseOk (astChar 11) (+ pos 2) gc classes))\n                ((= esc 48) (parseOk (astChar 0) (+ pos 2) gc classes))\n                (else (parseOk (astChar esc) (+ pos 2) gc classes))))))\n        (else (parseOk (astChar b) (+ pos 1) gc classes)))))\n\nfn astSize node: Ast -> Int64\n  (mt node\n    ((astChar c) 1)\n    ((astDot) 1)\n    ((astClass id) 1)\n    ((astAnchor atype) 1)\n    ((astEmpty) 0)\n    ((astSeq items) (fold (fn [acc x] (+ acc (astSize x))) 0 items))\n    ((astGroup gid inner) (if (> gid 0) (+ (astSize inner) 2) (astSize inner)))\n    ((astAlt left right) (+ (+ (astSize left) (astSize right)) 2))\n    ((astRep inner min max greedy)\n      (let [(sz (astSize inner))]\n        (cond\n          ((and (= min 0) (= max 1)) (+ sz 1))\n          ((and (= min 0) (= max -1)) (+ sz 2))\n          ((and (= min 1) (= max -1)) (+ sz 1))\n          (else (+ sz 2))))))\n\nfn compileAst node: Ast pc: Int64 dotall: Bool -> (List (List Int64))\n  (mt node\n    ((astChar c) (list (list 1 c 0)))\n    ((astDot) (list (list (if dotall 4 3) 0 0)))\n    ((astClass id) (list (list 2 id 0)))\n    ((astAnchor atype)\n      (list (list (cond ((= atype 1) 8) ((= atype 2) 9) ((= atype 3) 10) (else 11)) 0 0)))\n    ((astEmpty) (list))\n    ((astSeq items) (compileSeq items pc dotall (list)))\n    ((astGroup gid inner)\n      (if (> gid 0)\n        (let [(sStart (list 7 (* 2 gid) 0))\n              (innerInsts (compileAst inner (+ pc 1) dotall))\n              (sEnd (list 7 (+ (* 2 gid) 1) 0))]\n          (cons sStart (listAppend innerInsts (list sEnd))))\n        (compileAst inner pc dotall)))\n    ((astAlt left right)\n      (let [(sizeL (astSize left))\n            (sizeR (astSize right))\n            (split (list 5 (+ pc 1) (+ (+ pc 1 sizeL) 1)))\n            (codeL (compileAst left (+ pc 1) dotall))\n            (jump (list 6 (+ (+ (+ pc 1 sizeL) 1) sizeR) 0))\n            (codeR (compileAst right (+ (+ pc 1 sizeL) 1) dotall))]\n        (cons split (listAppend codeL (cons jump codeR)))))\n    ((astRep inner min max greedy)\n      (let [(sz (astSize inner))]\n        (cond\n          ((and (= min 0) (= max 1))\n            (let [(split (if greedy (list 5 (+ pc 1) (+ pc 1 sz)) (list 5 (+ pc 1 sz) (+ pc 1))))\n                  (code (compileAst inner (+ pc 1) dotall))]\n              (cons split code)))\n          ((and (= min 0) (= max -1))\n            (let [(split (if greedy (list 5 (+ pc 1) (+ (+ pc 1 sz) 1)) (list 5 (+ (+ pc 1 sz) 1) (+ pc 1))))\n                  (code (compileAst inner (+ pc 1) dotall))\n                  (jump (list 6 pc 0))]\n              (cons split (listAppend code (list jump)))))\n          ((and (= min 1) (= max -1))\n            (let [(code (compileAst inner pc dotall))\n                  (split (if greedy (list 5 pc (+ (+ pc sz) 1)) (list 5 (+ (+ pc sz) 1) pc)))]\n              (listAppend code (list split))))\n          (else (list))))))\n\nfn compileSeq items: (List Ast) pc: Int64 dotall: Bool acc: (List (List Int64)) -> (List (List Int64))\n  (if (listEmpty? items)\n    acc\n    (let [(item (optionOr (listHead items) (astEmpty)))\n          (rest (optionOr (listTail items) (list)))\n          (code (compileAst item pc dotall))]\n      (compileSeq rest (+ pc (astSize item)) dotall (listAppend acc code))))\n\nfn flattenTriples triples: (List (List Int64)) acc: (List Int64) -> (List Int64)\n  (if (listEmpty? triples)\n    (listReverse acc)\n    (let [(trip (optionOr (listHead triples) (list)))\n          (rest (optionOr (listTail triples) (list)))\n          (op (optionOr (listHead trip) 0))\n          (rest1 (optionOr (listTail trip) (list)))\n          (arg1 (optionOr (listHead rest1) 0))\n          (rest2 (optionOr (listTail rest1) (list)))\n          (arg2 (optionOr (listHead rest2) 0))]\n      (flattenTriples rest (cons arg2 (cons arg1 (cons op acc))))))\n\nfn assembleCode insts: (List (List Int64)) -> (Pair I64Array Int64)\n  (let [(numInsts (listLength insts))\n        (flat (flattenTriples insts (list)))\n        (arr (i64ArrayGenerate (* 3 numInsts) (fn [i] (optionOr (listGet flat i) 0))))]\n    (pair arr numInsts))\n\nfn saved-init count: Int64 -> (List Int64)\n  (make-saved-init count (list))\n\nfn make-saved-init count: Int64 acc: (List Int64) -> (List Int64)\n  (if (<= count 0)\n    acc\n    (make-saved-init (- count 1) (cons -1 acc)))\n\nfn saved-set lst: (List Int64) idx: Int64 val: Int64 -> (List Int64)\n  (if (<= idx 0)\n    (cons val (optionOr (listTail lst) (list)))\n    (mt (listHead lst)\n      ((none) (list val))\n      ((some h) (cons h (saved-set (optionOr (listTail lst) (list)) (- idx 1) val)))))\n\nfn clear-visited! visited: Bytes pcs: (List Int64) -> Unit\n  (if (listEmpty? pcs)\n    ()\n    (let [(h (optionOr (listHead pcs) 0))\n          (rest (optionOr (listTail pcs) (list)))\n          (_ (bytesSet visited h 0))]\n      (clear-visited! visited rest)))\n\nfn addthread! pc: Int64 saved: (List Int64) pos: Int64 bytes: Bytes len: Int64 visited: Bytes code: I64Array ninst: Int64 multiline: Bool threads: (List Thread) matched: (Option (List Int64)) visitedPcs: (List Int64) -> StepRes\n  (if (or (>= pc ninst) (= (bytesGet visited pc) 1))\n    (StepRes :threads threads :matched matched :visitedPcs visitedPcs)\n    (let [(_ (bytesSet visited pc 1))\n          (newVpcs (cons pc visitedPcs))\n          (op (i64ArrayGet code (* 3 pc)))\n          (arg1 (i64ArrayGet code (+ (* 3 pc) 1)))\n          (arg2 (i64ArrayGet code (+ (* 3 pc) 2)))]\n      (cond\n        ((= op 5)\n          (let [(res1 (addthread! arg1 saved pos bytes len visited code ninst multiline threads matched newVpcs))]\n            (if (some? res1.matched)\n              res1\n              (addthread! arg2 saved pos bytes len visited code ninst multiline res1.threads res1.matched res1.visitedPcs))))\n        ((= op 6)\n          (addthread! arg1 saved pos bytes len visited code ninst multiline threads matched newVpcs))\n        ((= op 7)\n          (let [(newSaved (saved-set saved arg1 pos))]\n            (addthread! (+ pc 1) newSaved pos bytes len visited code ninst multiline threads matched newVpcs)))\n        ((= op 8)\n          (let [(ok (if multiline\n                      (or (= pos 0) (= (bytesGet bytes (- pos 1)) 10))\n                      (= pos 0)))]\n            (if ok\n              (addthread! (+ pc 1) saved pos bytes len visited code ninst multiline threads matched newVpcs)\n              (StepRes :threads threads :matched matched :visitedPcs newVpcs))))\n        ((= op 9)\n          (let [(ok (if multiline\n                      (or (= pos len) (and (< pos len) (= (bytesGet bytes pos) 10)))\n                      (or (= pos len) (and (= pos (- len 1)) (= (bytesGet bytes pos) 10)))))]\n            (if ok\n              (addthread! (+ pc 1) saved pos bytes len visited code ninst multiline threads matched newVpcs)\n              (StepRes :threads threads :matched matched :visitedPcs newVpcs))))\n        ((= op 10)\n          (let [(prevWord (if (> pos 0) (is-word-byte (bytesGet bytes (- pos 1))) false))\n                (currWord (if (< pos len) (is-word-byte (bytesGet bytes pos)) false))]\n            (if (!= prevWord currWord)\n              (addthread! (+ pc 1) saved pos bytes len visited code ninst multiline threads matched newVpcs)\n              (StepRes :threads threads :matched matched :visitedPcs newVpcs))))\n        ((= op 11)\n          (let [(prevWord (if (> pos 0) (is-word-byte (bytesGet bytes (- pos 1))) false))\n                (currWord (if (< pos len) (is-word-byte (bytesGet bytes pos)) false))]\n            (if (= prevWord currWord)\n              (addthread! (+ pc 1) saved pos bytes len visited code ninst multiline threads matched newVpcs)\n              (StepRes :threads threads :matched matched :visitedPcs newVpcs))))\n        ((= op 12)\n          (StepRes :threads threads :matched (some saved) :visitedPcs newVpcs))\n        (else\n          (StepRes :threads (cons (Thread :pc pc :saved saved) threads) :matched matched :visitedPcs newVpcs)))))\n\nfn step-one-char! threads: (List Thread) b: Int64 nextPos: Int64 bytes: Bytes len: Int64 visited: Bytes code: I64Array ninst: Int64 classes: (List Bytes) multiline: Bool accThreads: (List Thread) matched: (Option (List Int64)) vpcs: (List Int64) -> StepRes\n  (if (listEmpty? threads)\n    (StepRes :threads accThreads :matched matched :visitedPcs vpcs)\n    (let [(t (optionOr (listHead threads) (Thread :pc 0 :saved (list))))\n          (rest (optionOr (listTail threads) (list)))\n          (pc t.pc)\n          (op (i64ArrayGet code (* 3 pc)))\n          (arg1 (i64ArrayGet code (+ (* 3 pc) 1)))\n          (match (cond\n                   ((= op 1) (= b arg1))\n                   ((= op 2)\n                     (let [(cls (optionOr (listGet classes arg1) (bytesAlloc 256)))]\n                       (= (bytesGet cls b) 1)))\n                   ((= op 3) (!= b 10))\n                   ((= op 4) true)\n                   (else false)))]\n      (if match\n        (let [(res1 (addthread! (+ pc 1) t.saved nextPos bytes len visited code ninst multiline accThreads matched vpcs))]\n          (if (some? res1.matched)\n            res1\n            (step-one-char! rest b nextPos bytes len visited code ninst classes multiline res1.threads res1.matched res1.visitedPcs)))\n        (step-one-char! rest b nextPos bytes len visited code ninst classes multiline accThreads matched vpcs))))\n\nfn is-better-match newSaved: (List Int64) oldMatch: (Option (List Int64)) -> Bool\n  (mt oldMatch\n    ((none) true)\n    ((some oldSaved)\n      (let [(newStart (optionOr (listGet newSaved 0) -1))\n            (oldStart (optionOr (listGet oldSaved 0) -1))]\n        (cond\n          ((< newStart oldStart) true)\n          ((= newStart oldStart)\n            (let [(newEnd (optionOr (listGet newSaved 1) -1))\n                  (oldEnd (optionOr (listGet oldSaved 1) -1))]\n              (>= newEnd oldEnd)))\n          (else false)))))\n\nfn keep-candidate-thread t: Thread bestStart: Int64 -> Bool\n  (= (optionOr (listGet t.saved 0) -1) bestStart)\n\nfn vm-loop! pos: Int64 len: Int64 bytes: Bytes visited: Bytes code: I64Array ninst: Int64 classes: (List Bytes) multiline: Bool curThreads: (List Thread) bestMatch: (Option (List Int64)) -> (Option (List Int64))\n  (if (or (>= pos len) (listEmpty? curThreads))\n    bestMatch\n    (let [(b (bytesGet bytes pos))\n          (res (step-one-char! curThreads b (+ pos 1) bytes len visited code ninst classes multiline (list) (none) (list)))\n          (_ (clear-visited! visited res.visitedPcs))\n          (nextThreads (listReverse res.threads))\n          (newMatched res.matched)\n          (updatedBest (if (some? newMatched)\n                         (if (is-better-match (unwrap-saved newMatched) bestMatch)\n                           newMatched\n                           bestMatch)\n                         bestMatch))]\n      (if (some? updatedBest)\n        (let [(bestStart (optionOr (listGet (unwrap-saved updatedBest) 0) -1))\n              (validThreads (filter (fn [(t Thread)] -> Bool (keep-candidate-thread t bestStart)) nextThreads))]\n          (if (listEmpty? validThreads)\n            updatedBest\n            (vm-loop! (+ pos 1) len bytes visited code ninst classes multiline validThreads updatedBest)))\n        (vm-loop! (+ pos 1) len bytes visited code ninst classes multiline nextThreads updatedBest))))\n\nfn extract-groups text: String saved: (List Int64) nsub: Int64 -> (List (Option String))\n  (extract-groups-loop text saved 1 nsub (list))\n\nfn extract-groups-loop text: String saved: (List Int64) i: Int64 nsub: Int64 acc: (List (Option String)) -> (List (Option String))\n  (if (> i nsub)\n    (listReverse acc)\n    (let [(s (optionOr (listGet saved (* 2 i)) -1))\n          (e (optionOr (listGet saved (+ (* 2 i) 1)) -1))\n          (val (if (and (>= s 0) (>= e s))\n                 (some (optionOr (stringSlice text s e) \"\"))\n                 (none)))]\n      (extract-groups-loop text saved (+ i 1) nsub (cons val acc))))\n\nfn make-match-record text: String saved: (List Int64) nsub: Int64 -> Match\n  (let [(s0 (optionOr (listGet saved 0) 0))\n        (e0 (optionOr (listGet saved 1) 0))\n        (matchedText (optionOr (stringSlice text s0 e0) \"\"))\n        (groups (extract-groups text saved nsub))]\n    (Match :start s0 :end e0 :text matchedText :groups groups))\n\nfn regex-compile-flags! pattern: String multiline: Bool dotall: Bool ignoreCase: Bool -> (Result Regex String)\n  (let [(bs (stringToBytes pattern))\n        (n (bytesLength bs))]\n    (mt (parse-regex! bs n 0 0 (list))\n      ((parseErr ep em)\n        (err (str \"regex-compile: error at position \" (stringFromInt64 ep) \": \" em)))\n      ((parseOk ast nextP gc classes)\n        (let [(coreSize (astSize ast))\n              (anchoredCore (compileAst ast 1 dotall))\n              (anchoredInsts (cons (list 7 0 0) (listAppend anchoredCore (list (list 7 1 0) (list 12 0 0)))))\n              (pAnch (assembleCode anchoredInsts))\n              (unanchCore (compileAst ast 4 dotall))\n              (prefix (list (list 5 3 1) (list 4 0 0) (list 6 0 0) (list 7 0 0)))\n              (unanchInsts (listAppend prefix (listAppend unanchCore (list (list 7 1 0) (list 12 0 0)))))\n              (pUnanch (assembleCode unanchInsts))]\n          (ok (Regex :pattern pattern\n                     :unanchoredCode (pairFirst pUnanch)\n                     :unanchoredLen (pairSecond pUnanch)\n                     :anchoredCode (pairFirst pAnch)\n                     :anchoredLen (pairSecond pAnch)\n                     :nsub gc\n                     :classes classes\n                     :multiline multiline\n                     :dotall dotall\n                     :ignoreCase ignoreCase))))))\n\nfn regex-compile! pattern: String -> (Result Regex String)\n  (regex-compile-flags! pattern false false false)\n\nfn regex-search! re: Regex s: String -> (Option Match)\n  (let [(code re.unanchoredCode)\n        (ninst re.unanchoredLen)\n        (bs (stringToBytes s))\n        (len (bytesLength bs))\n        (visited (bytesAlloc ninst))\n        (initSaved (saved-init (* 2 (+ re.nsub 1))))\n        (step0 (addthread! 0 initSaved 0 bs len visited code ninst re.multiline (list) (none) (list)))\n        (_ (clear-visited! visited step0.visitedPcs))\n        (threads0 (listReverse step0.threads))\n        (matched0 step0.matched)]\n    (if (and (some? matched0) (listEmpty? threads0))\n      (some (make-match-record s (unwrap-saved matched0) re.nsub))\n      (let [(finalMatched (vm-loop! 0 len bs visited code ninst re.classes re.multiline threads0 matched0))]\n        (mt finalMatched\n          ((none) (none))\n          ((some saved)\n            (some (make-match-record s saved re.nsub)))))))\n\nfn regex-match-full! re: Regex s: String -> (Option Match)\n  (let [(code re.anchoredCode)\n        (ninst re.anchoredLen)\n        (bs (stringToBytes s))\n        (len (bytesLength bs))\n        (visited (bytesAlloc ninst))\n        (initSaved (saved-init (* 2 (+ re.nsub 1))))\n        (step0 (addthread! 0 initSaved 0 bs len visited code ninst re.multiline (list) (none) (list)))\n        (_ (clear-visited! visited step0.visitedPcs))\n        (threads0 (listReverse step0.threads))\n        (matched0 step0.matched)]\n    (if (and (some? matched0) (listEmpty? threads0))\n      (let [(saved (unwrap-saved matched0))]\n        (if (= (optionOr (listGet saved 1) -1) len)\n          (some (make-match-record s saved re.nsub))\n          (none)))\n      (let [(finalMatched (vm-loop! 0 len bs visited code ninst re.classes re.multiline threads0 matched0))]\n        (mt finalMatched\n          ((none) (none))\n          ((some saved)\n            (if (= (optionOr (listGet saved 1) -1) len)\n              (some (make-match-record s saved re.nsub))\n              (none)))))))\n\nfn unwrap-saved opt: (Option (List Int64)) -> (List Int64)\n  (mt opt\n    ((none) (list))\n    ((some s) s))\n\nfn ! regex-match? re: Regex s: String -> Bool\n  (some? (regex-search! re s))\n\nfn regex-group m: Match i: Int64 -> (Option String)\n  (cond\n    ((= i 0) (some m.text))\n    ((> i 0) (optionOr (listGet m.groups (- i 1)) (none)))\n    (else (none)))\n\nfn regex-find-all! re: Regex s: String -> (List Match)\n  (find-all-from! re s 0 (list))\n\nfn find-all-from! re: Regex s: String pos: Int64 acc: (List Match) -> (List Match)\n  (let [(slen (stringLength s))]\n    (if (> pos slen)\n      (listReverse acc)\n      (let [(sub (optionOr (stringSlice s pos slen) \"\"))]\n        (mt (regex-search! re sub)\n          ((none) (listReverse acc))\n          ((some m)\n            (let [(realStart (+ pos m.start))\n                  (realEnd (+ pos m.end))\n                  (realText (optionOr (stringSlice s realStart realEnd) \"\"))\n                  (realGroups m.groups)\n                  (realMatch (Match :start realStart :end realEnd :text realText :groups realGroups))\n                  (nextPos (if (> m.end m.start)\n                             realEnd\n                             (+ realStart 1)))]\n              (find-all-from! re s nextPos (cons realMatch acc))))))))\n\nfn regex-replace-all! re: Regex s: String template: String -> String\n  (let [(matches (regex-find-all! re s))]\n    (if (listEmpty? matches)\n      s\n      (replace-all-loop s template matches 0 (list))))\n\nfn replace-all-loop s: String template: String matches: (List Match) prevEnd: Int64 acc: (List String) -> String\n  (if (listEmpty? matches)\n    (let [(tail (optionOr (stringSlice s prevEnd (stringLength s)) \"\"))]\n      (stringJoin (listReverse (cons tail acc)) \"\"))\n    (let [(m (optionOr (listHead matches) (Match :start 0 :end 0 :text \"\" :groups (list))))\n          (rest (optionOr (listTail matches) (list)))\n          (prefix (optionOr (stringSlice s prevEnd m.start) \"\"))\n          (expanded (expand-template template m))\n          (newAcc (cons expanded (cons prefix acc)))]\n      (replace-all-loop s template rest m.end newAcc)))\n\nfn expand-template template: String m: Match -> String\n  (let [(tlen (stringLength template))]\n    (expand-template-loop template tlen 0 m (list)))\n\nfn expand-template-loop template: String tlen: Int64 i: Int64 m: Match acc: (List String) -> String\n  (if (>= i tlen)\n    (stringJoin (listReverse acc) \"\")\n    (let [(ch (optionOr (stringSlice template i (+ i 1)) \"\"))]\n      (if (= ch \"\\\\\")\n        (let [(nextCh (optionOr (stringSlice template (+ i 1) (+ i 2)) \"\"))\n              (nextCode (if (stringEmpty? nextCh) 0 (charCode nextCh)))]\n          (cond\n            ((= nextCh \"\\\\\")\n              (expand-template-loop template tlen (+ i 2) m (cons \"\\\\\" acc)))\n            ((or (= nextCh \"0\") (= nextCh \"&\"))\n              (expand-template-loop template tlen (+ i 2) m (cons m.text acc)))\n            ((and (>= nextCode 49) (<= nextCode 57))\n              (let [(gid (- nextCode 48))\n                    (rep (optionOr (regex-group m gid) \"\"))]\n                (expand-template-loop template tlen (+ i 2) m (cons rep acc))))\n            (else\n              (expand-template-loop template tlen (+ i 2) m (cons (str \"\\\\\" nextCh) acc)))))\n        (expand-template-loop template tlen (+ i 1) m (cons ch acc)))))\n")
(:file :tree "tc1" :path "asl/packages/asl-tokenizer/src/tokenizer.asl" :text "(module asl-tokenizer/tokenizer\n  :x [Tokenizer loadTokenizer! countTokens! countTokensBytes!]\n  :i [])\n\nschema Tokenizer\n  tokenBytes: Bytes\n  table: Bytes\n  mask: Int64\n  asciiTable: Bytes\n  unicodeTable: Bytes\n  nUnicodeRanges: Int64\n  scratchOff: Bytes\n  scratchLen: Bytes\n\nfn toLower b: Int64 -> Int64\n  (if (and (>= b 65) (<= b 90)) (+ b 32) b)\n\nfn isSpace c: Int64 -> Bool\n  (or (= c 1) (= c 2))\n\nfn isUpperOrMark c: Int64 -> Bool\n  (or (= c 3) (or (= c 5) (= c 6)))\n\nfn isLowerOrMark c: Int64 -> Bool\n  (or (= c 4) (or (= c 5) (= c 6)))\n\nfn isLetterOrMark c: Int64 -> Bool\n  (or (or (= c 3) (= c 4)) (or (= c 5) (= c 6)))\n\nfn isPunctOrSymbol c: Int64 -> Bool\n  (or (= c 6) (= c 8))\n\nfn isOptLead c: Int64 -> Bool\n  (or (= c 2) (or (= c 6) (= c 8)))\n\nfn initAsciiTable! t: Bytes i: Int64 -> Bytes\n  (if (>= i 128) t\n    (let [(c (cond\n               ((or (= i 10) (= i 13)) 1)\n               ((or (= i 32) (or (= i 9) (or (= i 11) (= i 12)))) 2)\n               ((and (>= i 65) (<= i 90)) 3)\n               ((and (>= i 97) (<= i 122)) 4)\n               ((and (>= i 48) (<= i 57)) 7)\n               (else 8)))]\n      (do\n        (bytesSet t i c)\n        (initAsciiTable! t (+ i 1)))))\n\nfn bsearchClass unicodeTable: Bytes lo: Int64 hi: Int64 cp: Int64 -> Int64\n  (if (> lo hi) 8\n    (let [(mid (/ (+ lo hi) 2))\n          (midOff (* mid 7))\n          (s (+ (+ (* (bytesGet unicodeTable midOff) 65536)\n                   (* (bytesGet unicodeTable (+ midOff 1)) 256))\n                (bytesGet unicodeTable (+ midOff 2))))\n          (e (+ (+ (* (bytesGet unicodeTable (+ midOff 3)) 65536)\n                   (* (bytesGet unicodeTable (+ midOff 4)) 256))\n                (bytesGet unicodeTable (+ midOff 5))))]\n      (cond\n        ((< cp s) (bsearchClass unicodeTable lo (- mid 1) cp))\n        ((> cp e) (bsearchClass unicodeTable (+ mid 1) hi cp))\n        (else (bytesGet unicodeTable (+ midOff 6))))))\n\nfn getClass asciiTable: Bytes unicodeTable: Bytes nRanges: Int64 cp: Int64 -> Int64\n  (if (< cp 128)\n    (bytesGet asciiTable cp)\n    (bsearchClass unicodeTable 0 (- nRanges 1) cp))\n\nfn decodeUtf8 bs: Bytes i: Int64 n: Int64 -> (Pair Int64 Int64)\n  (let [(b0 (bytesGet bs i))]\n    (cond\n      ((< b0 128) (pair b0 1))\n      ((and (>= b0 192) (< b0 224))\n        (if (< (+ i 1) n)\n          (let [(b1 (bytesGet bs (+ i 1)))]\n            (pair (+ (* (- b0 192) 64) (- b1 128)) 2))\n          (pair b0 1)))\n      ((and (>= b0 224) (< b0 240))\n        (if (< (+ i 2) n)\n          (let [(b1 (bytesGet bs (+ i 1)))\n                (b2 (bytesGet bs (+ i 2)))]\n            (pair (+ (+ (* (- b0 224) 4096) (* (- b1 128) 64)) (- b2 128)) 3))\n          (pair b0 1)))\n      ((>= b0 240)\n        (if (< (+ i 3) n)\n          (let [(b1 (bytesGet bs (+ i 1)))\n                (b2 (bytesGet bs (+ i 2)))\n                (b3 (bytesGet bs (+ i 3)))]\n            (pair (+ (+ (+ (* (- b0 240) 262144) (* (- b1 128) 4096)) (* (- b2 128) 64)) (- b3 128)) 4))\n          (pair b0 1)))\n      (else (pair b0 1))))\n\nfn checkContraction bs: Bytes j: Int64 n: Int64 -> Int64\n  (if (>= j n) j\n    (if (!= (bytesGet bs j) 39) j\n      (let [(rem (- n (+ j 1)))]\n        (cond\n          ((>= rem 2)\n            (let [(c0 (toLower (bytesGet bs (+ j 1))))\n                  (c1 (toLower (bytesGet bs (+ j 2))))]\n              (if (or (and (= c0 114) (= c1 101))\n                      (or (and (= c0 118) (= c1 101))\n                          (and (= c0 108) (= c1 108))))\n                (+ j 3)\n                (if (or (= c0 115) (or (= c0 116) (or (= c0 109) (= c0 100))))\n                  (+ j 2)\n                  j))))\n          ((>= rem 1)\n            (let [(c0 (toLower (bytesGet bs (+ j 1))))]\n              (if (or (= c0 115) (or (= c0 116) (or (= c0 109) (= c0 100))))\n                (+ j 2)\n                j)))\n          (else j)))))\n\nfn scanUpper bs: Bytes j: Int64 n: Int64 at: Bytes ut: Bytes nr: Int64 -> Int64\n  (if (>= j n) j\n    (let [(b0 (bytesGet bs j))]\n      (if (< b0 128)\n        (if (= (bytesGet at b0) 3)\n          (scanUpper bs (+ j 1) n at ut nr)\n          j)\n        (let [(p (decodeUtf8 bs j n))]\n          (mt p\n            ((pair cp charLen)\n              (if (isUpperOrMark (getClass at ut nr cp))\n                (scanUpper bs (+ j charLen) n at ut nr)\n                j)))))))\n\nfn scanLower bs: Bytes j: Int64 n: Int64 at: Bytes ut: Bytes nr: Int64 -> Int64\n  (if (>= j n) j\n    (let [(b0 (bytesGet bs j))]\n      (if (< b0 128)\n        (if (= (bytesGet at b0) 4)\n          (scanLower bs (+ j 1) n at ut nr)\n          j)\n        (let [(p (decodeUtf8 bs j n))]\n          (mt p\n            ((pair cp charLen)\n              (if (isLowerOrMark (getClass at ut nr cp))\n                (scanLower bs (+ j charLen) n at ut nr)\n                j)))))))\n\nfn scanNum bs: Bytes j: Int64 n: Int64 count: Int64 at: Bytes ut: Bytes nr: Int64 -> Int64\n  (if (or (>= j n) (>= count 3)) j\n    (let [(b0 (bytesGet bs j))]\n      (if (< b0 128)\n        (if (= (bytesGet at b0) 7)\n          (scanNum bs (+ j 1) n (+ count 1) at ut nr)\n          j)\n        (let [(p (decodeUtf8 bs j n))]\n          (mt p\n            ((pair cp charLen)\n              (if (= (getClass at ut nr cp) 7)\n                (scanNum bs (+ j charLen) n (+ count 1) at ut nr)\n                j)))))))\n\nfn scanOther bs: Bytes j: Int64 n: Int64 at: Bytes ut: Bytes nr: Int64 -> Int64\n  (if (>= j n) j\n    (let [(b0 (bytesGet bs j))]\n      (if (< b0 128)\n        (if (= (bytesGet at b0) 8)\n          (scanOther bs (+ j 1) n at ut nr)\n          j)\n        (let [(p (decodeUtf8 bs j n))]\n          (mt p\n            ((pair cp charLen)\n              (if (isPunctOrSymbol (getClass at ut nr cp))\n                (scanOther bs (+ j charLen) n at ut nr)\n                j)))))))\n\nfn scanSlashNl bs: Bytes j: Int64 n: Int64 -> Int64\n  (if (>= j n) j\n    (let [(b (bytesGet bs j))]\n      (if (or (= b 10) (or (= b 13) (= b 47)))\n        (scanSlashNl bs (+ j 1) n)\n        j)))\n\nfn scanSpaceWithNl bs: Bytes j: Int64 n: Int64 lastNl: Int64 at: Bytes ut: Bytes nr: Int64 -> (Pair Int64 Int64)\n  (if (>= j n) (pair j lastNl)\n    (let [(b (bytesGet bs j))]\n      (if (or (= b 10) (= b 13))\n        (scanSpaceWithNl bs (+ j 1) n (+ j 1) at ut nr)\n        (if (< b 128)\n          (if (= (bytesGet at b) 2)\n            (scanSpaceWithNl bs (+ j 1) n lastNl at ut nr)\n            (pair j lastNl))\n          (let [(p (decodeUtf8 bs j n))]\n            (mt p\n              ((pair cp charLen)\n                (if (= (getClass at ut nr cp) 2)\n                  (scanSpaceWithNl bs (+ j charLen) n lastNl at ut nr)\n                  (pair j lastNl)))))))))\n\nfn tryOtherBranches bs: Bytes i: Int64 n: Int64 at: Bytes ut: Bytes nr: Int64 c0: Int64 charLen0: Int64 -> Int64\n  (cond\n    ((= c0 7)\n      (scanNum bs (+ i charLen0) n 1 at ut nr))\n    ((or (isPunctOrSymbol c0)\n         (and (= (bytesGet bs i) 32)\n              (and (< (+ i 1) n)\n                   (let [(pSp (decodeUtf8 bs (+ i 1) n))]\n                     (mt pSp\n                       ((pair cpSp _)\n                         (isPunctOrSymbol (getClass at ut nr cpSp))))))))\n      (let [(hasSp (= (bytesGet bs i) 32))\n            (pStart (if hasSp (+ i 1) i))\n            (jP (scanOther bs pStart n at ut nr))]\n        (scanSlashNl bs jP n)))\n    ((isSpace c0)\n      (let [(pairSp (scanSpaceWithNl bs i n -1 at ut nr))]\n        (mt pairSp\n          ((pair endSp lastNl)\n            (if (> lastNl 0)\n              lastNl\n              (if (= endSp n)\n                n\n                (if (>= (- endSp i) 2)\n                  (- endSp 1)\n                  endSp)))))))\n    (else (+ i charLen0)))\n\nfn matchNextChunk bs: Bytes i: Int64 n: Int64 at: Bytes ut: Bytes nr: Int64 -> Int64\n  (if (>= i n) i\n    (let [(p0 (decodeUtf8 bs i n))]\n      (mt p0\n        ((pair cp0 charLen0)\n          (let [(c0 (getClass at ut nr cp0))]\n            (if (or (isLetterOrMark c0) (isOptLead c0))\n              (let [(optLead (isOptLead c0))\n                    (letStart (if optLead (+ i charLen0) i))]\n                (if (< letStart n)\n                  (let [(p1 (decodeUtf8 bs letStart n))]\n                    (mt p1\n                      ((pair cp1 len1)\n                        (let [(c1 (getClass at ut nr cp1))]\n                          (if (isLetterOrMark c1)\n                            (let [(jUp (scanUpper bs letStart n at ut nr))\n                                  (jLow (scanLower bs jUp n at ut nr))]\n                              (if (> jLow jUp)\n                                (checkContraction bs jLow n)\n                                (if (> jUp letStart)\n                                  (checkContraction bs jUp n)\n                                  (tryOtherBranches bs i n at ut nr c0 charLen0))))\n                            (tryOtherBranches bs i n at ut nr c0 charLen0))))))\n                  (tryOtherBranches bs i n at ut nr c0 charLen0)))\n              (tryOtherBranches bs i n at ut nr c0 charLen0)))))))\n\nfn initB64Table! t: Bytes i: Int64 chars: String -> Bytes\n  (if (>= i 64) t\n    (let [(c (bytesGet (stringToBytes chars) i))]\n      (do\n        (bytesSet t c i)\n        (initB64Table! t (+ i 1) chars))))\n\nfn parseRank bs: Bytes i: Int64 acc: Int64 -> (Pair Int64 Int64)\n  (let [(c (bytesGet bs i))]\n    (if (or (= c 10) (= c 13))\n      (pair acc (+ i (if (and (= c 13) (= (bytesGet bs (+ i 1)) 10)) 2 1)))\n      (parseRank bs (+ i 1) (+ (* acc 10) (- c 48)))))\n\nfn findSpace bs: Bytes i: Int64 -> Int64\n  (if (= (bytesGet bs i) 32) i (findSpace bs (+ i 1)))\n\nfn decodeB64! bs: Bytes i: Int64 endI: Int64 b64t: Bytes out: Bytes outOff: Int64 -> Int64\n  (if (>= i endI) outOff\n    (let [(c0 (bytesGet bs i))\n          (c1 (bytesGet bs (+ i 1)))\n          (c2 (bytesGet bs (+ i 2)))\n          (c3 (bytesGet bs (+ i 3)))\n          (v0 (bytesGet b64t c0))\n          (v1 (bytesGet b64t c1))\n          (b0 (+ (* v0 4) (/ v1 16)))]\n      (do\n        (bytesSet out outOff b0)\n        (if (= c2 61)\n          (+ outOff 1)\n          (let [(v2 (bytesGet b64t c2))\n                (b1 (+ (* (mod v1 16) 16) (/ v2 4)))]\n            (do\n              (bytesSet out (+ outOff 1) b1)\n              (if (= c3 61)\n                (+ outOff 2)\n                (let [(v3 (bytesGet b64t c3))\n                      (b2 (+ (* (mod v2 4) 64) v3))]\n                  (do\n                    (bytesSet out (+ outOff 2) b2)\n                    (decodeB64! bs (+ i 4) endI b64t out (+ outOff 3)))))))))))\n\nfn hashBytes bs: Bytes off: Int64 len: Int64 i: Int64 h: Int64 -> Int64\n  (if (>= i len) h\n    (let [(b (bytesGet bs (+ off i)))\n          (hNext (mod (+ (* h 31) b) 524287))]\n      (hashBytes bs off len (+ i 1) hNext)))\n\nfn insertTable! table: Bytes mask: Int64 slot: Int64 off: Int64 len: Int64 rank: Int64 -> Bool\n  (let [(slotOff (* slot 8))\n        (status (bytesGet table (+ slotOff 7)))]\n    (if (= status 0)\n      (do\n        (bytesSet table slotOff (mod off 256))\n        (bytesSet table (+ slotOff 1) (mod (/ off 256) 256))\n        (bytesSet table (+ slotOff 2) (mod (/ off 65536) 256))\n        (bytesSet table (+ slotOff 3) len)\n        (bytesSet table (+ slotOff 4) (mod rank 256))\n        (bytesSet table (+ slotOff 5) (mod (/ rank 256) 256))\n        (bytesSet table (+ slotOff 6) (mod (/ rank 65536) 256))\n        (bytesSet table (+ slotOff 7) 1))\n      (insertTable! table mask (mod (+ slot 1) mask) off len rank)))\n\nfn parseAll! bs: Bytes i: Int64 n: Int64 b64t: Bytes tokenBytes: Bytes tbOff: Int64 table: Bytes mask: Int64 count: Int64 -> (Pair Int64 Int64)\n  (if (>= i n) (pair count tbOff)\n    (let [(c (bytesGet bs i))]\n      (if (or (= c 10) (= c 13))\n        (parseAll! bs (+ i 1) n b64t tokenBytes tbOff table mask count)\n        (let [(sp (findSpace bs i))\n              (pRank (parseRank bs (+ sp 1) 0))]\n          (mt pRank\n            ((pair rank nextI)\n              (let [(newTbOff (decodeB64! bs i sp b64t tokenBytes tbOff))\n                    (tokLen (- newTbOff tbOff))\n                    (h (hashBytes tokenBytes tbOff tokLen 0 2166136261))\n                    (slot (mod h mask))]\n                (do\n                  (insertTable! table mask slot tbOff tokLen rank)\n                  (parseAll! bs nextI n b64t tokenBytes newTbOff table mask (+ count 1))))))))))\n\nfn bytesEqual a: Bytes aOff: Int64 b: Bytes bOff: Int64 len: Int64 i: Int64 -> Bool\n  (if (>= i len) true\n    (if (!= (bytesGet a (+ aOff i)) (bytesGet b (+ bOff i)))\n      false\n      (bytesEqual a aOff b bOff len (+ i 1))))\n\nfn lookupRank tokenBytes: Bytes table: Bytes mask: Int64 key: Bytes keyOff: Int64 keyLen: Int64 slot: Int64 -> Int64\n  (let [(slotOff (* slot 8))\n        (status (bytesGet table (+ slotOff 7)))]\n    (if (= status 0)\n      -1\n      (let [(slotLen (bytesGet table (+ slotOff 3)))]\n        (if (= slotLen keyLen)\n          (let [(slotTbOff (+ (+ (bytesGet table slotOff)\n                                 (* (bytesGet table (+ slotOff 1)) 256))\n                              (* (bytesGet table (+ slotOff 2)) 65536)))]\n            (if (bytesEqual tokenBytes slotTbOff key keyOff keyLen 0)\n              (+ (+ (bytesGet table (+ slotOff 4))\n                    (* (bytesGet table (+ slotOff 5)) 256))\n                 (* (bytesGet table (+ slotOff 6)) 65536))\n              (lookupRank tokenBytes table mask key keyOff keyLen (mod (+ slot 1) mask))))\n          (lookupRank tokenBytes table mask key keyOff keyLen (mod (+ slot 1) mask))))))\n\nfn getI32 b: Bytes off: Int64 -> Int64\n  (+ (+ (+ (bytesGet b off)\n           (* (bytesGet b (+ off 1)) 256))\n        (* (bytesGet b (+ off 2)) 65536))\n     (* (bytesGet b (+ off 3)) 16777216))\n\nfn setI32! b: Bytes off: Int64 val: Int64 -> Unit\n  (do\n    (bytesSet b off (mod val 256))\n    (bytesSet b (+ off 1) (mod (/ val 256) 256))\n    (bytesSet b (+ off 2) (mod (/ val 65536) 256))\n    (bytesSet b (+ off 3) (mod (/ val 16777216) 256)))\n\nfn piecePrev pieces: Bytes i: Int64 -> Int64\n  (- (getI32 pieces (* i 16)) 1)\n\nfn pieceNext pieces: Bytes i: Int64 -> Int64\n  (- (getI32 pieces (+ (* i 16) 4)) 1)\n\nfn pieceOff pieces: Bytes i: Int64 -> Int64\n  (getI32 pieces (+ (* i 16) 8))\n\nfn pieceLen pieces: Bytes i: Int64 -> Int64\n  (getI32 pieces (+ (* i 16) 12))\n\nfn setPiecePrev! pieces: Bytes i: Int64 p: Int64 -> Unit\n  (setI32! pieces (* i 16) (+ p 1))\n\nfn setPieceNext! pieces: Bytes i: Int64 nxt: Int64 -> Unit\n  (setI32! pieces (+ (* i 16) 4) (+ nxt 1))\n\nfn setPieceOff! pieces: Bytes i: Int64 off: Int64 -> Unit\n  (setI32! pieces (+ (* i 16) 8) off)\n\nfn setPieceLen! pieces: Bytes i: Int64 len: Int64 -> Unit\n  (setI32! pieces (+ (* i 16) 12) len)\n\nfn heapRank heap: Bytes k: Int64 -> Int64\n  (getI32 heap (* k 12))\n\nfn heapIdx heap: Bytes k: Int64 -> Int64\n  (getI32 heap (+ (* k 12) 4))\n\nfn heapLen heap: Bytes k: Int64 -> Int64\n  (getI32 heap (+ (* k 12) 8))\n\nfn setHeapNode! heap: Bytes k: Int64 rank: Int64 idx: Int64 len: Int64 -> Unit\n  (do\n    (setI32! heap (* k 12) rank)\n    (setI32! heap (+ (* k 12) 4) idx)\n    (setI32! heap (+ (* k 12) 8) len))\n\nfn copyHeapNode! heap: Bytes dst: Int64 src: Int64 -> Unit\n  (setHeapNode! heap dst (heapRank heap src) (heapIdx heap src) (heapLen heap src))\n\nfn isHeapLess heap: Bytes a: Int64 b: Int64 -> Bool\n  (let [(ra (heapRank heap a))\n        (rb (heapRank heap b))]\n    (if (< ra rb) true\n      (if (> ra rb) false\n        (< (heapIdx heap a) (heapIdx heap b)))))\n\nfn siftUp! heap: Bytes k: Int64 -> Unit\n  (if (<= k 0) ()\n    (let [(p (/ (- k 1) 2))]\n      (if (isHeapLess heap k p)\n        (let [(rK (heapRank heap k))\n              (iK (heapIdx heap k))\n              (lK (heapLen heap k))]\n          (do\n            (copyHeapNode! heap k p)\n            (setHeapNode! heap p rK iK lK)\n            (siftUp! heap p)))\n        ())))\n\nfn siftDown! heap: Bytes k: Int64 size: Int64 -> Unit\n  (let [(l (+ (* k 2) 1))\n        (r (+ (* k 2) 2))]\n    (if (>= l size) ()\n      (let [(smallest (if (and (< r size) (isHeapLess heap r l)) r l))]\n        (if (isHeapLess heap smallest k)\n          (let [(rK (heapRank heap k))\n                (iK (heapIdx heap k))\n                (lK (heapLen heap k))]\n            (do\n              (copyHeapNode! heap k smallest)\n              (setHeapNode! heap smallest rK iK lK)\n              (siftDown! heap smallest size)))\n          ()))))\n\nfn heapPush! heap: Bytes size: Int64 rank: Int64 idx: Int64 len: Int64 -> Int64\n  (do\n    (setHeapNode! heap size rank idx len)\n    (siftUp! heap size)\n    (+ size 1))\n\nfn heapPop! heap: Bytes size: Int64 -> Int64\n  (if (<= size 1) 0\n    (do\n      (copyHeapNode! heap 0 (- size 1))\n      (siftDown! heap 0 (- size 1))\n      (- size 1)))\n\nfn initPiecesLoop! pieces: Bytes k: Int64 n: Int64 -> Unit\n  (if (>= k n) ()\n    (do\n      (setPiecePrev! pieces k (- k 1))\n      (setPieceNext! pieces k (if (= k (- n 1)) -1 (+ k 1)))\n      (setPieceOff! pieces k k)\n      (setPieceLen! pieces k 1)\n      (initPiecesLoop! pieces (+ k 1) n)))\n\nfn initHeapLoop! tb: Bytes tbl: Bytes mask: Int64 textBytes: Bytes baseOff: Int64 heap: Bytes size: Int64 i: Int64 n: Int64 -> Int64\n  (if (>= i (- n 1)) size\n    (let [(pairOff (+ baseOff i))\n          (h (hashBytes textBytes pairOff 2 0 2166136261))\n          (rank (lookupRank tb tbl mask textBytes pairOff 2 (mod h mask)))]\n      (if (>= rank 0)\n        (let [(newSize (heapPush! heap size rank i 1))]\n          (initHeapLoop! tb tbl mask textBytes baseOff heap newSize (+ i 1) n))\n        (initHeapLoop! tb tbl mask textBytes baseOff heap size (+ i 1) n))))\n\nfn pushPairIfRanked! tb: Bytes tbl: Bytes mask: Int64 textBytes: Bytes baseOff: Int64 pieces: Bytes heap: Bytes size: Int64 leftIdx: Int64 rightIdx: Int64 -> Int64\n  (if (or (< leftIdx 0) (< rightIdx 0)) size\n    (let [(lLen (pieceLen pieces leftIdx))\n          (rLen (pieceLen pieces rightIdx))\n          (pairLen (+ lLen rLen))\n          (pairOff (+ baseOff (pieceOff pieces leftIdx)))\n          (h (hashBytes textBytes pairOff pairLen 0 2166136261))\n          (rank (lookupRank tb tbl mask textBytes pairOff pairLen (mod h mask)))]\n      (if (>= rank 0)\n        (heapPush! heap size rank leftIdx lLen)\n        size)))\n\nfn bpeHeapLoop! tb: Bytes tbl: Bytes mask: Int64 textBytes: Bytes baseOff: Int64 pieces: Bytes heap: Bytes size: Int64 count: Int64 -> Int64\n  (if (<= size 0) count\n    (let [(topRank (heapRank heap 0))\n          (topIdx (heapIdx heap 0))\n          (topLen (heapLen heap 0))\n          (newSize (heapPop! heap size))]\n      (if (!= (pieceLen pieces topIdx) topLen)\n        (bpeHeapLoop! tb tbl mask textBytes baseOff pieces heap newSize count)\n        (let [(nxt (pieceNext pieces topIdx))]\n          (if (< nxt 0)\n            (bpeHeapLoop! tb tbl mask textBytes baseOff pieces heap newSize count)\n            (let [(pairLen (+ topLen (pieceLen pieces nxt)))\n                  (pairOff (+ baseOff (pieceOff pieces topIdx)))\n                  (h (hashBytes textBytes pairOff pairLen 0 2166136261))\n                  (curRank (lookupRank tb tbl mask textBytes pairOff pairLen (mod h mask)))]\n              (if (!= curRank topRank)\n                (bpeHeapLoop! tb tbl mask textBytes baseOff pieces heap newSize count)\n                (let [(nxtNext (pieceNext pieces nxt))\n                      (prev (piecePrev pieces topIdx))]\n                  (do\n                    (setPieceLen! pieces topIdx pairLen)\n                    (setPieceNext! pieces topIdx nxtNext)\n                    (if (>= nxtNext 0)\n                      (setPiecePrev! pieces nxtNext topIdx)\n                      ())\n                    (setPieceLen! pieces nxt 0)\n                    (let [(s1 (pushPairIfRanked! tb tbl mask textBytes baseOff pieces heap newSize prev topIdx))\n                          (s2 (pushPairIfRanked! tb tbl mask textBytes baseOff pieces heap s1 topIdx nxtNext))]\n                      (bpeHeapLoop! tb tbl mask textBytes baseOff pieces heap s2 (- count 1))))))))))))\n\nfn bpeCountChunk! tokenBytes: Bytes table: Bytes mask: Int64 textBytes: Bytes i: Int64 chunkLen: Int64 sOff: Bytes sLen: Bytes -> Int64\n  (cond\n    ((<= chunkLen 0) 0)\n    ((= chunkLen 1) 1)\n    (else\n      (let [(h (hashBytes textBytes i chunkLen 0 2166136261))\n            (wholeRank (lookupRank tokenBytes table mask textBytes i chunkLen (mod h mask)))]\n        (if (>= wholeRank 0)\n          1\n          (let [(pieces (if (<= chunkLen 1024) sOff (bytesAlloc (* chunkLen 16))))\n                (heap (if (<= chunkLen 1024) sLen (bytesAlloc (* chunkLen 36))))]\n            (do\n              (initPiecesLoop! pieces 0 chunkLen)\n              (let [(initSize (initHeapLoop! tokenBytes table mask textBytes i heap 0 0 chunkLen))]\n                (bpeHeapLoop! tokenBytes table mask textBytes i pieces heap initSize chunkLen))))))))\n\nfn countTokensLoop! bs: Bytes i: Int64 n: Int64 at: Bytes ut: Bytes nr: Int64 tb: Bytes tbl: Bytes mask: Int64 sOff: Bytes sLen: Bytes total: Int64 -> Int64\n  (if (>= i n) total\n    (let [(nextI (matchNextChunk bs i n at ut nr))]\n      (if (<= nextI i)\n        (do (assert (> nextI i) \"ERR_CHUNK_STALL: matchNextChunk failed to advance\") total)\n        (let [(chunkLen (- nextI i))\n              (toks (bpeCountChunk! tb tbl mask bs i chunkLen sOff sLen))]\n          (countTokensLoop! bs nextI n at ut nr tb tbl mask sOff sLen (+ total toks))))))\n\nfn loadTokenizer! dataDir: String -> (Result Tokenizer String)\n  (let [(tiktokenPath (str dataDir \"/o200k_base.tiktoken\"))\n        (classesPath (str dataDir \"/unicode_classes.bin\"))\n        (resUt (fileReadBytes classesPath))]\n    (mt resUt\n      ((err e) (err (str \"loadTokenizer: cannot read \" classesPath \": \" e)))\n      ((ok ut)\n        (let [(resTk (fileReadBytes tiktokenPath))]\n          (mt resTk\n            ((err e) (err (str \"loadTokenizer: cannot read \" tiktokenPath \": \" e)))\n            ((ok bsTk)\n              (let [(nr (/ (bytesLength ut) 7))\n                    (at (bytesAlloc 128))\n                    (_ (initAsciiTable! at 0))\n                    (b64t (bytesAlloc 256))\n                    (_ (initB64Table! b64t 0 \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\"))\n                    (tokenBytes (bytesAlloc 3000000))\n                    (mask 524288)\n                    (table (bytesAlloc (* mask 8)))\n                    (_ (parseAll! bsTk 0 (bytesLength bsTk) b64t tokenBytes 0 table mask 0))\n                    (sOff (bytesAlloc 16384))\n                    (sLen (bytesAlloc 36864))]\n                (ok (Tokenizer :tokenBytes tokenBytes\n                               :table table\n                               :mask mask\n                               :asciiTable at\n                               :unicodeTable ut\n                               :nUnicodeRanges nr\n                               :scratchOff sOff\n                               :scratchLen sLen)))))))))\n\nfn countTokensBytes! tok: Tokenizer bs: Bytes -> Int64\n  (let [(n (bytesLength bs))]\n    (if (<= n 0) 0\n      (countTokensLoop! bs 0 n\n                       tok.asciiTable\n                       tok.unicodeTable\n                       tok.nUnicodeRanges\n                       tok.tokenBytes\n                       tok.table\n                       tok.mask\n                       tok.scratchOff\n                       tok.scratchLen\n                       0)))\n\nfn countTokens! tok: Tokenizer text: String -> Int64\n  (countTokensBytes! tok (stringToBytes text))\n")
(:file :tree "tcEdge" :path "asl/.asl.config.asn" :text "(:aslConfig\n  :workspace \"asl\"\n  :version \"0.1.0\"\n  :pureAsl true\n  :aslFirst true\n  :projections [\n    (:proj :from \"package.asn\" :to \"package.json\" :format \"json\" :doc \"Root ASL NPM manifest\")\n    (:proj :from \"web/package.asn\" :to \"web/package.json\" :format \"json\" :doc \"Web showcase package manifest\")\n    (:proj :from \"wrangler.asn\" :to \"wrangler.toml\" :format \"toml\" :doc \"Cloudflare Workers configuration\")\n  ]\n  :ignore [\n    \"scratch/**\"\n    \"tmp/**\"\n    \".asl/cache/**\"\n    \".asl/log/**\"\n    \"**/.system_generated/**\"\n    \"**/*.tmp\"\n    \"bench/*.lock\"\n    \"grammar/*.lock\"\n    \"prelude/*.lock\"\n    \".pre-commit-config.yaml\"\n    \"**/pnpm-lock.yaml\"\n    \"**/package-lock.json\"\n    \"**/pnpm-workspace.yaml\"\n    \"web/dist/**\"\n  ]\n  :gates [1 2 3 4 5 6 7]\n  :tokenBaseline 2\n  :telemetry (:targetTurnMs 100 :maxTokenCeiling 150)\n  :daemon (:resident true :memoryIndex true :maxFiles 2000)\n  :coverage (\n    :desired 75.0\n    :minAssertions 2\n    :strictPolarity false\n    :discountZeroAsserts true\n    :coreDesired 100.0\n    :corePackages [\"packages/asl-compiler\" \"packages/asl-parser\" \"packages/asl-codec\" \"packages/asl-lint\" \"packages/asl-gates\" \"packages/asl-pack\"]\n    :exclude [\"examples/**\" \"asl-arduino/**\" \"asl-quantum/**\"]\n  )\n  :tasks [\n    (:task :name \"project\" :cmd \"asl project\" :doc \"Transpile all declared ASN projections to host targets\")\n    (:task :name \"gate\" :cmd \"asl gate\" :doc \"Run full 7-gate pure ASL verification\")\n    (:task :name \"test\" :cmd \"asl test\" :doc \"Run native ASL test suites\")\n    (:task :name \"coverage\" :cmd \"asl coverage\" :doc \"Audit native function test coverage\")\n    (:task :name \"telemetry\" :cmd \"asl telemetry\" :doc \"Collect performance telemetry and token metrics\")\n    (:task :name \"web:transpile\" :cmd \"asl transpile-pkg web/package.asn web/package.json\" :doc \"Transpile web package.asn to package.json\")\n    (:task :name \"web:build\" :cmd \"asl task web:transpile && npm --prefix web run build\" :doc \"Build production web showcase\")\n    (:task :name \"web:dev\" :cmd \"asl task web:transpile && npm --prefix web run dev\" :doc \"Start Vite development server\")\n  ])\n")
(:file :tree "tcEdge" :path "asl/tools/observe/observe.asl" :text "(module ws/asl/tools/observe/observe\n  :x [runObserve main]\n  :i [(ws/asl/tools/observe/common :a c)\n      (ws/asl/tools/observe/args :a a)\n      (ws/asl/tools/observe/memory :a mem)\n      (ws/asl/tools/observe/session :a ses)\n      (ws/asl/tools/observe/callers :a cal)\n      (ws/asl/tools/observe/status :a sts)\n      (ws/asl/tools/observe/coverage :a cov)\n      (ws/asl/tools/observe/tokenCost :a tc)\n      (asl-regex/regex :a re)])\n\nfn dims -> (List String)\n  (list \"tokenCost\" \"memory\" \"session\" \"callers\" \"status\" \"coverage\")\n\nfn listDims? dim: String -> Bool\n  (or (= dim \"callers\") (= dim \"status\") (= dim \"coverage\"))\n\nfn finish r: (Result String String) -> c/Outcome\n  (mt r ((ok receipt) (c/Outcome :out (str receipt \"\\n\") :err \"\" :code 0)) ((err line) (c/rejected line)))\n\nfn crashOr r: (Result String String) -> c/Outcome\n  (mt r\n    ((ok receipt) (c/Outcome :out (str receipt \"\\n\") :err \"\" :code 0))\n    ((err line) (if (stringStartsWith? line \"(:observe \") (c/rejected line) (c/crashed line))))\n\nfn warned wr: (Pair String (Result String String)) -> c/Outcome\n  (let [(o (crashOr (pairSecond wr)))]\n    (c/Outcome :out o.out :err (str (pairFirst wr) o.err) :code o.code))\n\nfn parseLimit raw: String -> (Result Int64 String)\n  (mt (c/pyIntText (c/lstripChars raw \":\"))\n    ((none) (err (c/rejectLine \"ERR_BAD_ARG\" (str \":limit must be an integer, got \" raw) \"\")))\n    ((some n)\n      (let [(v (if (or (stringStartsWith? n \"-\") (> (stringLength n) 3)) (none) (stringToInt64 n)))]\n        (mt v\n          ((some k) (if (or (< k 1) (> k (c/limitMax))) (err (c/rejectLine \"ERR_BAD_ARG\" (str \":limit must be within 1..\" (stringFromInt64 (c/limitMax)) \", got \" n) \"\")) (ok k)))\n          ((none) (err (c/rejectLine \"ERR_BAD_ARG\" (str \":limit must be within 1..\" (stringFromInt64 (c/limitMax)) \", got \" n) \"\")))))))\n\nfn ! dispatch! ctx: c/Ctx args: a/Args dim: String limit: Int64 root: String scope: String -> c/Outcome\n  (let [(symbol (c/pyStrip args.symbol)) (pathArg (c/pyStrip args.path))]\n    (cond\n      ((= dim \"session\") (crashOr (ses/observeSession! root limit ctx)))\n      ((= dim \"memory\") (finish (mem/observeMemory! root ctx)))\n      ((= dim \"callers\")\n        (if (stringEmpty? symbol)\n          (c/rejected (c/rejectLine \"ERR_BAD_ARG\" \"callers needs :symbol <name>\" \"\"))\n          (warned (cal/observeCallers! root symbol (c/pyStrip args.module) limit ctx))))\n      ((= dim \"status\")\n        (if (= (not (stringEmpty? symbol)) (not (stringEmpty? pathArg)))\n          (c/rejected (c/rejectLine \"ERR_BAD_ARG\" \"status needs exactly one of :symbol <name> or :path <file>\" \"\"))\n          (mt (if (stringEmpty? pathArg) (ok \"\") (c/relPath! root pathArg \":path\"))\n            ((err line) (c/rejected line))\n            ((ok path) (warned (sts/observeStatus! root symbol path limit ctx))))))\n      ((= dim \"coverage\")\n        (if (stringEmpty? (c/pyStrip args.spec))\n          (c/rejected (c/rejectLine \"ERR_BAD_ARG\" \"coverage needs :spec <file>\" \"\"))\n          (mt (c/relPath! root (c/pyStrip args.spec) \":spec\")\n            ((err line) (c/rejected line))\n            ((ok spec)\n              (if (not (c/isFile? (c/joinPath root spec)))\n                (c/rejected (c/rejectLine \"ERR_BAD_ARG\" (str \":spec is not a file: \" args.spec) \"\"))\n                (if (stringEmpty? args.id)\n                  (warned (cov/observeCoverage! root spec (none) limit ctx))\n                  (mt (mt (unbalancedAt (stringToBytes args.id) 0 (bytesLength (stringToBytes args.id)) 0)\n                        ((some i) (err (str \"regex-compile: error at position \" (stringFromInt64 i) \": unmatched close parenthesis ')'\")))\n                        ((none) (re/regex-compile! args.id)))\n                    ((err e) (c/rejected (c/rejectLine \"ERR_BAD_ARG\" (str \":id is not a regular expression: \" (pyRegexError e)) \"\")))\n                    ((ok rx) (warned (cov/observeCoverage! root spec (some rx) limit ctx))))))))))\n      ((= dim \"tokenCost\") (finish (tc/observeTokenCost! root scope limit ctx)))\n      (else (c/rejected (c/rejectLine \"ERR_UNKNOWN_DIM\" (str \"unknown dimension \" dim) \"\")))))\n\nfn classEnd bs: Bytes i: Int64 n: Int64 first: Bool -> Int64\n  (cond\n    ((>= i n) n)\n    ((and first (= (bytesGet bs i) 94)) (classEnd bs (+ i 1) n true))\n    ((and first (= (bytesGet bs i) 93)) (classEnd bs (+ i 1) n false))\n    ((= (bytesGet bs i) 92) (classEnd bs (+ i 2) n false))\n    ((= (bytesGet bs i) 93) (+ i 1))\n    (else (classEnd bs (+ i 1) n false)))\n\nfn unbalancedAt bs: Bytes i: Int64 n: Int64 depth: Int64 -> (Option Int64)\n  (if (>= i n)\n    (none)\n    (let [(b (bytesGet bs i))]\n      (cond\n        ((= b 92) (unbalancedAt bs (+ i 2) n depth))\n        ((= b 91) (unbalancedAt bs (classEnd bs (+ i 1) n true) n depth))\n        ((= b 40) (unbalancedAt bs (+ i 1) n (+ depth 1)))\n        ((= b 41) (if (= depth 0) (some i) (unbalancedAt bs (+ i 1) n (- depth 1))))\n        (else (unbalancedAt bs (+ i 1) n depth)))))\n\nfn pyRegexError e: String -> String\n  (let [(rest (optionOr (stringSlice e (stringLength \"regex-compile: error at position \") (stringLength e)) e))\n        (colon (optionOr (stringIndexOf rest \": \") 0))\n        (pos (optionOr (stringSlice rest 0 colon) \"\"))\n        (what (optionOr (stringSlice rest (+ colon 2) (stringLength rest)) rest))]\n    (cond\n      ((stringStartsWith? what \"unclosed group\") (str \"missing ), unterminated subpattern at position \" pos))\n      ((stringStartsWith? what \"unclosed non-capturing group\") (str \"missing ), unterminated subpattern at position \" pos))\n      ((stringStartsWith? what \"unmatched close parenthesis\") (str \"unbalanced parenthesis at position \" pos))\n      ((stringStartsWith? what \"unclosed character class\") (str \"unterminated character set at position \" pos))\n      ((stringStartsWith? what \"trailing backslash\") (str \"bad escape (end of pattern) at position \" pos))\n      (else (str what \" at position \" pos))))\n\nfn ! runObserve ctx: c/Ctx argv: (List String) -> c/Outcome\n  (mt (a/parseArgs argv)\n    ((err o) o)\n    ((ok args)\n      (let [(dim (c/lstripChars (optionOr args.dim \"\") \":\"))]\n        (if (not (listContains? (dims) dim))\n          (c/rejected (c/rejectLine \"ERR_UNKNOWN_DIM\" (str \"unknown dimension \" dim \"; known: \" (c/joinWith (dims) \" \"))\n                                    (str \" :dim \" (c/quoted dim) \" :nearest (\" (c/joinWith (c/closeMatches dim (dims) 2 0.0) \" \") \")\")))\n          (let [(rawLimit (if (stringEmpty? (c/pyStrip args.limit)) (if (listDims? dim) \"100\" \"20\") args.limit))]\n            (mt (parseLimit rawLimit)\n              ((err line) (c/rejected line))\n              ((ok limit)\n                (mt (c/workspace! ctx)\n                  ((err line) (c/rejected line))\n                  ((ok root)\n                    (let [(scopeArg (c/pyStrip args.scope))]\n                      (mt (if (stringEmpty? scopeArg) (ok \"\") (c/relPath! root scopeArg \":scope\"))\n                        ((err line) (c/rejected line))\n                        ((ok scope) (dispatch! ctx args dim limit root scope)))))))))))))\n\nfn envPair row: String -> (Pair String String)\n  (mt (stringIndexOf row \"=\")\n    ((some i) (pair (optionOr (stringSlice row 0 i) row) (optionOr (stringSlice row (+ i 1) (stringLength row)) \"\")))\n    ((none) (pair row \"\")))\n\nfn ! main args: (List String) -> (Result Int64 String)\n  (mt (realPath \".\")\n    ((err e) (err e))\n    ((ok cwd)\n      (let [(ctx (c/Ctx :cwd cwd :env (map envPair (envList)) :spawnEnv (none) :now (/ (nowNs) 1000000000) :date \"\"))\n            (o (runObserve ctx args))]\n        (do\n          (if (stringEmpty? o.out) true (print o.out))\n          (if (stringEmpty? o.err) true (do (fdWrite 2 o.err) true))\n          (ok o.code)))))\n")
(:file :tree "tcEdge" :path "asl/tools/observe/args.asl" :text "(module ws/asl/tools/observe/args\n  :x [Args parseArgs usageText helpText]\n  :i [(ws/asl/tools/observe/common :a c)])\n\n(schema Args\n  (:f dim (Option String)) (:f scope String) (:f limit String) (:f symbol String) (:f module String)\n  (:f path String) (:f spec String) (:f id String))\n\nfn usageText -> String\n  (str \"usage: observe.asl [-h] --dim DIM [--scope SCOPE] [--limit LIMIT]\\n\"\n       \"                   [--symbol SYMBOL] [--module MODULE] [--path PATH]\\n\"\n       \"                   [--spec SPEC] [--id ID]\\n\")\n\nfn helpText -> String\n  (str (usageText) \"\\noptions:\\n  -h, --help       show this help message and exit\\n  --dim DIM\\n  --scope SCOPE\\n  --limit LIMIT\\n\"\n       \"  --symbol SYMBOL\\n  --module MODULE\\n  --path PATH\\n  --spec SPEC\\n  --id ID\\n\")\n\nfn optionStrings -> (List String)\n  (list \"-h\" \"--help\" \"--dim\" \"--scope\" \"--limit\" \"--symbol\" \"--module\" \"--path\" \"--spec\" \"--id\")\n\nfn actionOf opt: String -> String\n  (cond ((or (= opt \"-h\") (= opt \"--help\")) \"help\") (else (optionOr (stringSlice opt 2 (stringLength opt)) \"\")))\n\nfn actionName act: String -> String\n  (if (= act \"help\") \"-h/--help\" (str \"--\" act))\n\n(schema Opt (:f act (Option String)) (:f spelling String) (:f sep (Option String)) (:f explicit (Option String)))\n\n(enum Tok (:c tokArg [(s String)]) (:c tokSep [(s String)]) (:c tokOpt [(o Opt) (s String)]))\n\nfn usageError msg: String -> c/Outcome\n  (c/Outcome :out \"\" :err (str (usageText) \"observe.asl: error: \" msg \"\\n\") :code 2)\n\nfn partitionEq s: String -> (Pair String (Option String))\n  (mt (stringIndexOf s \"=\")\n    ((none) (pair s (none)))\n    ((some i) (pair (optionOr (stringSlice s 0 i) \"\") (some (optionOr (stringSlice s (+ i 1) (stringLength s)) \"\")))))\n\nfn negNumber? s: String -> Bool\n  (let [(body (optionOr (stringSlice s 1 (stringLength s)) \"\"))\n        (digits? (fn [(t String)] -> Bool (listAll? (fn [(ch String)] -> Bool (and (>= (charCode ch) 48) (<= (charCode ch) 57))) (stringChars t))))]\n    (and (stringStartsWith? s \"-\")\n         (or (and (not (stringEmpty? body)) (digits? body))\n             (mt (stringIndexOf body \".\")\n               ((none) false)\n               ((some i) (let [(a (optionOr (stringSlice body 0 i) \"\")) (b (optionOr (stringSlice body (+ i 1) (stringLength body)) \"\"))]\n                           (and (digits? a) (not (stringEmpty? b)) (digits? b))))))))\n\nfn optionTuples s: String -> (List Opt)\n  (if (stringStartsWith? s \"--\")\n    (let [(pe (partitionEq s))]\n      (map (fn [(o String)] -> Opt (Opt :act (some (actionOf o)) :spelling o :sep (optionMap (fn [(x String)] -> String \"=\") (pairSecond pe)) :explicit (pairSecond pe)))\n           (filter (fn [(o String)] -> Bool (stringStartsWith? o (pairFirst pe))) (optionStrings))))\n    (let [(short (optionOr (stringSlice s 0 2) s)) (rest (optionOr (stringSlice s 2 (stringLength s)) \"\"))]\n      (fold (fn [(acc (List Opt)) (o String)] -> (List Opt)\n              (cond ((= o short) (listAppend acc (list (Opt :act (some (actionOf o)) :spelling o :sep (some \"\") :explicit (some rest)))))\n                    ((stringStartsWith? o s) (listAppend acc (list (Opt :act (some (actionOf o)) :spelling o :sep (none) :explicit (none)))))\n                    (else acc)))\n            (list) (optionStrings))))\n\nfn classify s: String -> (Result Tok c/Outcome)\n  (cond\n    ((or (stringEmpty? s) (not (stringStartsWith? s \"-\"))) (ok (tokArg s)))\n    ((listContains? (optionStrings) s) (ok (tokOpt (Opt :act (some (actionOf s)) :spelling s :sep (none) :explicit (none)) s)))\n    ((= (stringLength s) 1) (ok (tokArg s)))\n    (else\n      (let [(pe (partitionEq s))]\n        (if (and (some? (pairSecond pe)) (listContains? (optionStrings) (pairFirst pe)))\n          (ok (tokOpt (Opt :act (some (actionOf (pairFirst pe))) :spelling (pairFirst pe) :sep (some \"=\") :explicit (pairSecond pe)) s))\n          (let [(tups (optionTuples s))]\n            (cond\n              ((> (listLength tups) 1)\n                (err (usageError (str \"ambiguous option: \" s \" could match \" (stringJoin (map (fn [(o Opt)] -> String o.spelling) tups) \", \")))))\n              ((= (listLength tups) 1) (ok (tokOpt (optionOr (listHead tups) (Opt :act (none) :spelling s :sep (none) :explicit (none))) s)))\n              ((negNumber? s) (ok (tokArg s)))\n              ((stringContains? s \" \") (ok (tokArg s)))\n              (else (ok (tokOpt (Opt :act (none) :spelling s :sep (none) :explicit (none)) s)))))))))\n\nfn classifyAll args: (List String) acc: (List Tok) -> (Result (List Tok) c/Outcome)\n  (mt (listHead args)\n    ((none) (ok (listReverse acc)))\n    ((some a)\n      (if (= a \"--\")\n        (ok (listAppend (listReverse acc) (cons (tokSep a) (map (fn [(x String)] -> Tok (tokArg x)) (optionOr (listTail args) (list))))))\n        (mt (classify a)\n          ((err o) (err o))\n          ((ok t) (classifyAll (optionOr (listTail args) (list)) (cons t acc)))))))\n\nfn pyRepr s: String -> String\n  (let [(q (if (and (stringContains? s \"'\") (not (stringContains? s \"\\\"\"))) \"\\\"\" \"'\"))\n        (body (stringJoin (map (fn [(ch String)] -> String\n                                 (let [(k (charCode ch))]\n                                   (cond ((= ch \"\\\\\") \"\\\\\\\\\") ((= ch q) (str \"\\\\\" q)) ((= ch \"\\n\") \"\\\\n\") ((= ch \"\\r\") \"\\\\r\") ((= ch \"\\t\") \"\\\\t\")\n                                         ((or (< k 32) (= k 127)) (str \"\\\\x\" (hex2 k))) (else ch))))\n                               (stringChars s)) \"\"))]\n    (str q body q))\n\nfn hexDigit n: Int64 -> String\n  (optionOr (stringSlice \"0123456789abcdef\" n (+ n 1)) \"0\")\n\nfn hex2 n: Int64 -> String\n  (str (hexDigit (/ n 16)) (hexDigit (mod n 16)))\n\n(schema St (:f args Args) (:f extras (List String)) (:f seen (List String)))\n\nfn setArg a: Args act: String v: String -> Args\n  (cond\n    ((= act \"dim\") (with a :dim (some v)))\n    ((= act \"scope\") (with a :scope v))\n    ((= act \"limit\") (with a :limit v))\n    ((= act \"symbol\") (with a :symbol v))\n    ((= act \"module\") (with a :module v))\n    ((= act \"path\") (with a :path v))\n    ((= act \"spec\") (with a :spec v))\n    (else (with a :id v)))\n\nfn helpOutcome -> c/Outcome\n  (c/Outcome :out (helpText) :err \"\" :code 0)\n\nfn shortTail st: St o: Opt -> (Result St c/Outcome)\n  (let [(ex (optionOr o.explicit \"\")) (sp (optionOr o.sep \"\"))]\n    (if (or (not (stringEmpty? sp)) (stringStartsWith? ex \"-\"))\n      (err (usageError (str \"argument -h/--help: ignored explicit argument \" (pyRepr ex))))\n      (err (helpOutcome))))\n\nfn tokAt toks: (List Tok) i: Int64 -> (Option Tok)\n  (listGet toks i)\n\nfn consumeOpt st: St o: Opt raw: String toks: (List Tok) i: Int64 -> (Result (Pair St Int64) c/Outcome)\n  (mt o.act\n    ((none) (ok (pair (with st :extras (listAppend st.extras (list raw))) (+ i 1))))\n    ((some act)\n      (mt o.explicit\n        ((some ex)\n          (cond\n            ((and (= act \"help\") (not (stringStartsWith? o.spelling \"--\")) (not (stringEmpty? ex)))\n              (mt (shortTail st o) ((ok s2) (ok (pair s2 (+ i 1)))) ((err e) (err e))))\n            ((= act \"help\") (err (usageError (str \"argument -h/--help: ignored explicit argument \" (pyRepr ex)))))\n            (else (ok (pair (with st :args (setArg st.args act ex) :seen (cons act st.seen)) (+ i 1))))))\n        ((none)\n          (if (= act \"help\")\n            (err (helpOutcome))\n            (mt (tokAt toks (+ i 1))\n              ((some nt) (mt nt\n                           ((tokArg v) (ok (pair (with st :args (setArg st.args act v) :seen (cons act st.seen)) (+ i 2))))\n                           (_ (err (usageError (str \"argument \" (actionName act) \": expected one argument\"))))))\n              ((none) (err (usageError (str \"argument \" (actionName act) \": expected one argument\"))))))))))\n\nfn walk st: St toks: (List Tok) i: Int64 -> (Result St c/Outcome)\n  (mt (tokAt toks i)\n    ((none) (ok st))\n    ((some t)\n      (mt t\n        ((tokOpt o raw) (mt (consumeOpt st o raw toks i) ((ok p) (walk (pairFirst p) toks (pairSecond p))) ((err e) (err e))))\n        ((tokArg s) (walk (with st :extras (listAppend st.extras (list s))) toks (+ i 1)))\n        ((tokSep s) (walk (with st :extras (listAppend st.extras (list s))) toks (+ i 1))))))\n\nfn parseArgs argv: (List String) -> (Result Args c/Outcome)\n  (mt (classifyAll argv (list))\n    ((err e) (err e))\n    ((ok toks)\n      (mt (walk (St :args (Args :dim (none) :scope \"\" :limit \"\" :symbol \"\" :module \"\" :path \"\" :spec \"\" :id \"\") :extras (list) :seen (list)) toks 0)\n        ((err e) (err e))\n        ((ok st)\n          (cond\n            ((not (listContains? st.seen \"dim\")) (err (usageError \"the following arguments are required: --dim\")))\n            ((not (listEmpty? st.extras)) (err (usageError (str \"unrecognized arguments: \" (stringJoin st.extras \" \")))))\n            (else (ok st.args)))))))\n")
(:file :tree "tcEdge" :path "asl/tools/observe/common.asl" :text "(module ws/asl/tools/observe/common\n  :x [Ctx Outcome Proc Section\n      ctxEnv ctxHome esc rejectLine rejected crashed receiptMax limitMax\n      runArgv! git! workspace! shortRev! workspaceFiles!\n      joinPath dirName baseName splitExt isAbs lexists? isDir? isFile? isLink? realPathLoose! relPath!\n      pyIntText lstripChars rstripChars stripChars pyStrip pyIsSpaceCode\n      fitReceipt atStr quoted sortUnique dedupe byteLen lines keepEndsLines\n      closeMatches charCodes utf8Replace mapGetOr utf8Valid? spaceLenAt findFrom universalNewlines catAll joinWith splitByte]\n  :i [(asl-forms/similarity :a sim)])\n\n(schema Ctx\n  (:f cwd String)\n  (:f env (List (Pair String String)))\n  (:f spawnEnv (Option (List String)))\n  (:f now Int64)\n  (:f date String))\n\n(schema Outcome (:f out String) (:f err String) (:f code Int64))\n\n(schema Proc (:f code Int64) (:f out String) (:f errText String))\n\n(schema Section (:f key String) (:f items (List String)) (:f limit Int64))\n\nfn receiptMax -> Int64\n  4096\n\nfn limitMax -> Int64\n  100\n\nfn mapGetOr kv: (List (Pair String String)) k: String -> (Option String)\n  (mt (listHead kv)\n    ((none) (none))\n    ((some p) (if (= (pairFirst p) k) (some (pairSecond p)) (mapGetOr (optionOr (listTail kv) (list)) k))))\n\nfn ctxEnv ctx: Ctx k: String -> (Option String)\n  (mapGetOr ctx.env k)\n\nfn ctxHome ctx: Ctx -> String\n  (optionOr (ctxEnv ctx \"HOME\") \"\")\n\nfn esc s: String -> String\n  (stringReplace (stringReplace (stringReplace s \"\\\\\" \"\\\\\\\\\") \"\\\"\" \"\\\\\\\"\") \"\\n\" \"\\\\n\")\n\nfn rejectLine code: String message: String extra: String -> String\n  (str \"(:observe :status :rejected :error \" code extra \" :message \\\"\" (esc message) \"\\\")\")\n\nfn rejected line: String -> Outcome\n  (Outcome :out (str line \"\\n\") :err \"\" :code 1)\n\nfn crashed message: String -> Outcome\n  (Outcome :out \"\" :err (str message \"\\n\") :code 1)\n\nfn quoted s: String -> String\n  (str \"\\\"\" (esc s) \"\\\"\")\n\nfn atStr rel: String line: Int64 -> String\n  (str \"\\\"\" (esc rel) \":\" (stringFromInt64 line) \"\\\"\")\n\nfn byteLen s: String -> Int64\n  (stringLength s)\n\n(schema Pump (:f outOpen Bool) (:f errOpen Bool) (:f out (List String)) (:f errs (List String)))\n\nfn ! readSide fd: Int64 -> (Pair Bool String)\n  (mt (fdRead fd 65536)\n    ((ok chunk) (if (stringEmpty? chunk) (do (fdClose fd) (pair false \"\")) (pair true chunk)))\n    ((err e) (if (= e \"wouldBlock\") (pair true \"\") (do (fdClose fd) (pair false \"\")))))\n\nfn ! pump sp: SpawnedProc st: Pump -> Pump\n  (if (not (or st.outOpen st.errOpen))\n    st\n    (let [(fds (listAppend (if st.outOpen (list (pair sp.stdout 1)) (list)) (if st.errOpen (list (pair sp.stderr 1)) (list))))]\n      (mt (fdPoll fds 60000)\n        ((err e) (if (= e \"interrupted\") (pump sp st) (with st :outOpen false :errOpen false :errs (cons (str \"poll: \" e) st.errs))))\n        ((ok ready)\n          (let [(ro (and st.outOpen (listAny? (fn [(p (Pair Int64 Int64))] -> Bool (= (pairFirst p) sp.stdout)) ready)))\n                (re (and st.errOpen (listAny? (fn [(p (Pair Int64 Int64))] -> Bool (= (pairFirst p) sp.stderr)) ready)))\n                (o (if ro (readSide sp.stdout) (pair st.outOpen \"\")))\n                (e2 (if re (readSide sp.stderr) (pair st.errOpen \"\")))]\n            (pump sp (Pump :outOpen (pairFirst o) :errOpen (pairFirst e2)\n                           :out (if (stringEmpty? (pairSecond o)) st.out (cons (pairSecond o) st.out))\n                           :errs (if (stringEmpty? (pairSecond e2)) st.errs (cons (pairSecond e2) st.errs)))))))))\n\nfn ! runArgv! argv: (List String) cwd: String ctx: Ctx -> (Result Proc String)\n  (mt (procSpawnv argv (some cwd) ctx.spawnEnv)\n    ((err e) (err e))\n    ((ok sp)\n      (do\n        (fdClose sp.stdin)\n        (let [(st (pump sp (Pump :outOpen true :errOpen true :out (list) :errs (list))))]\n          (mt (procWaitPid sp.pid false)\n            ((err e) (err e))\n            ((ok code) (ok (Proc :code (optionOr code -1) :out (catAll (listReverse st.out)) :errText (catAll (listReverse st.errs))))))))))\n\nfn ! git! args: (List String) root: String ctx: Ctx -> (Result (Pair Int64 String) String)\n  (mt (runArgv! (cons \"git\" args) root ctx)\n    ((ok p) (ok (pair p.code p.out)))\n    ((err e) (err (rejectLine \"ERR_TOOL_ABSENT\" (str \"git could not be run (\" e \"); observe reads the workspace through git\") \"\"))))\n\nfn ! workspace! ctx: Ctx -> (Result String String)\n  (mt (git! (list \"rev-parse\" \"--show-toplevel\") ctx.cwd ctx)\n    ((err e) (err e))\n    ((ok p) (let [(top (pyStrip (pairSecond p)))] (ok (if (and (= (pairFirst p) 0) (not (stringEmpty? top))) top ctx.cwd)))))\n\nfn ! shortRev! root: String ctx: Ctx -> (Result String String)\n  (mt (git! (list \"rev-parse\" \"--short\" \"HEAD\") root ctx)\n    ((err e) (err e))\n    ((ok p) (let [(r (pyStrip (pairSecond p)))] (ok (if (and (= (pairFirst p) 0) (not (stringEmpty? r))) r \"none\")))))\n\nfn ! workspaceFiles! root: String ctx: Ctx -> (Result (List String) String)\n  (mt (git! (list \"ls-files\" \"-z\" \"-co\" \"--exclude-standard\") root ctx)\n    ((err e) (err e))\n    ((ok p)\n      (if (!= (pairFirst p) 0)\n        (err (rejectLine \"ERR_GIT\" (str \"git ls-files failed in \" root) \"\"))\n        (ok (filter (fn [(rel String)] -> Bool (isFile? (joinPath root rel)))\n                    (sortUnique (filter (fn [(x String)] -> Bool (not (stringEmpty? x))) (splitByte (pairSecond p) 0))))))))\n\nfn isAbs p: String -> Bool\n  (stringStartsWith? p \"/\")\n\nfn joinPath a: String b: String -> String\n  (cond ((isAbs b) b) ((stringEmpty? a) b) ((stringEndsWith? a \"/\") (str a b)) (else (str a \"/\" b)))\n\nfn lastSlash s: String i: Int64 -> Int64\n  (cond ((< i 0) -1) ((= (optionOr (stringSlice s i (+ i 1)) \"\") \"/\") i) (else (lastSlash s (- i 1))))\n\nfn dirName p: String -> String\n  (let [(i (lastSlash p (- (stringLength p) 1)))]\n    (if (< i 0) \"\" (let [(head (optionOr (stringSlice p 0 (+ i 1)) \"\"))] (let [(t (rstripChars head \"/\"))] (if (stringEmpty? t) head t)))))\n\nfn baseName p: String -> String\n  (let [(i (lastSlash p (- (stringLength p) 1)))]\n    (optionOr (stringSlice p (+ i 1) (stringLength p)) p))\n\nfn lastDot s: String i: Int64 -> Int64\n  (cond ((< i 0) -1) ((= (optionOr (stringSlice s i (+ i 1)) \"\") \".\") i) (else (lastDot s (- i 1))))\n\nfn allDots? s: String i: Int64 -> Bool\n  (cond ((< i 0) true) ((= (optionOr (stringSlice s i (+ i 1)) \"\") \".\") (allDots? s (- i 1))) (else false))\n\nfn splitExt p: String -> (Pair String String)\n  (let [(b (baseName p)) (i (lastDot b (- (stringLength b) 1)))]\n    (if (or (< i 0) (allDots? b (- i 1)))\n      (pair p \"\")\n      (let [(cut (- (stringLength p) (- (stringLength b) i)))]\n        (pair (optionOr (stringSlice p 0 cut) p) (optionOr (stringSlice p cut (stringLength p)) \"\")))))\n\nfn ! lexists? p: String -> Bool\n  (ok? (fileStat p))\n\nfn ! isDir? p: String -> Bool\n  (mt (fileStat p) ((ok s) s.isDir) ((err _) false))\n\nfn ! isFile? p: String -> Bool\n  (mt (fileStat p) ((ok s) s.isFile) ((err _) false))\n\nfn ! isLink? p: String -> Bool\n  (let [(parent (dirName p)) (name (baseName p))]\n    (mt (realPath p)\n      ((err _) false)\n      ((ok r) (mt (realPath (if (stringEmpty? parent) \".\" parent))\n                ((ok pr) (!= r (joinPath pr name)))\n                ((err _) false)))))\n\nfn loosePart! cur: String parts: (List String) -> String\n  (mt (listHead parts)\n    ((none) (if (stringEmpty? cur) \"/\" cur))\n    ((some c)\n      (let [(rest (optionOr (listTail parts) (list)))]\n        (cond\n          ((or (stringEmpty? c) (= c \".\")) (loosePart! cur rest))\n          ((= c \"..\") (loosePart! (let [(d (dirName cur))] (if (= d \"/\") \"\" d)) rest))\n          (else (let [(nxt (str cur \"/\" c))]\n                  (mt (realPath nxt)\n                    ((ok r) (loosePart! (if (= r \"/\") \"\" r) rest))\n                    ((err _) (loosePart! nxt rest)))))))))\n\nfn realPathLoose! p: String cwd: String -> String\n  (let [(full (if (isAbs p) p (joinPath cwd p)))]\n    (loosePart! \"\" (stringSplit full \"/\")))\n\nfn relPath! root: String arg: String what: String -> (Result String String)\n  (let [(full (realPathLoose! (joinPath root arg) root))\n        (base (realPathLoose! root root))]\n    (cond\n      ((and (!= full base) (not (stringStartsWith? full (str base \"/\"))))\n        (err (rejectLine \"ERR_BOUNDARY_VIOLATION\" (str what \" resolves outside the workspace: \" arg) \"\")))\n      ((not (lexists? full))\n        (err (rejectLine \"ERR_PATH_NOT_FOUND\" (str what \" not found: \" arg) \"\")))\n      ((= full base) (ok \"\"))\n      (else (ok (optionOr (stringSlice full (+ (stringLength base) 1) (stringLength full)) \"\")))))\n\nfn charAt s: String i: Int64 -> String\n  (optionOr (stringSlice s i (+ i 1)) \"\")\n\nfn inChars? c: String chars: String -> Bool\n  (and (not (stringEmpty? c)) (stringContains? chars c))\n\nfn lstripFrom s: String chars: String i: Int64 -> Int64\n  (if (and (< i (stringLength s)) (inChars? (charAt s i) chars)) (lstripFrom s chars (+ i 1)) i)\n\nfn rstripFrom s: String chars: String i: Int64 -> Int64\n  (if (and (> i 0) (inChars? (charAt s (- i 1)) chars)) (rstripFrom s chars (- i 1)) i)\n\nfn lstripChars s: String chars: String -> String\n  (optionOr (stringSlice s (lstripFrom s chars 0) (stringLength s)) \"\")\n\nfn rstripChars s: String chars: String -> String\n  (optionOr (stringSlice s 0 (rstripFrom s chars (stringLength s))) \"\")\n\nfn stripChars s: String chars: String -> String\n  (lstripChars (rstripChars s chars) chars)\n\nfn pyIsSpaceCode c: Int64 -> Bool\n  (or (and (>= c 9) (<= c 13)) (and (>= c 28) (<= c 32)) (= c 133) (= c 160) (= c 5760) (and (>= c 8192) (<= c 8202))\n      (= c 8232) (= c 8233) (= c 8239) (= c 8287) (= c 12288))\n\nfn contAt? bs: Bytes i: Int64 n: Int64 -> Bool\n  (and (< i n) (>= (bytesGet bs i) 128) (<= (bytesGet bs i) 191))\n\nfn codeAt bs: Bytes i: Int64 n: Int64 -> (Pair Int64 Int64)\n  (let [(b0 (bytesGet bs i))\n        (need (cond ((< b0 128) 1) ((and (>= b0 194) (< b0 224)) 2) ((and (>= b0 224) (< b0 240)) 3) ((and (>= b0 240) (< b0 245)) 4) (else 0)))]\n    (cond\n      ((= need 0) (pair -1 1))\n      ((= need 1) (pair b0 1))\n      (else\n        (let [(lo1 (cond ((= b0 224) 160) ((= b0 240) 144) (else 128)))\n              (hi1 (cond ((= b0 237) 159) ((= b0 244) 143) (else 191)))\n              (b1 (if (< (+ i 1) n) (bytesGet bs (+ i 1)) -1))]\n          (cond\n            ((or (< b1 lo1) (> b1 hi1)) (pair -1 1))\n            ((= need 2) (pair (+ (* (- b0 192) 64) (- b1 128)) 2))\n            ((not (contAt? bs (+ i 2) n)) (pair -1 2))\n            ((= need 3) (pair (+ (* (- b0 224) 4096) (* (- b1 128) 64) (- (bytesGet bs (+ i 2)) 128)) 3))\n            ((not (contAt? bs (+ i 3) n)) (pair -1 3))\n            (else (pair (+ (* (- b0 240) 262144) (* (- b1 128) 4096) (* (- (bytesGet bs (+ i 2)) 128) 64) (- (bytesGet bs (+ i 3)) 128)) 4)))))))\n\nfn validLoop bs: Bytes i: Int64 n: Int64 -> Bool\n  (cond\n    ((>= i n) true)\n    ((< (bytesGet bs i) 128) (validLoop bs (+ i 1) n))\n    (else (let [(c (codeAt bs i n))] (if (< (pairFirst c) 0) false (validLoop bs (+ i (pairSecond c)) n)))))\n\nfn utf8Valid? s: String -> Bool\n  (let [(bs (stringToBytes s))] (validLoop bs 0 (bytesLength bs)))\n\nfn spaceLenAt bs: Bytes i: Int64 n: Int64 -> Int64\n  (if (>= i n)\n    0\n    (let [(b (bytesGet bs i))]\n      (if (< b 128)\n        (if (pyIsSpaceCode b) 1 0)\n        (let [(c (codeAt bs i n))] (if (and (>= (pairFirst c) 0) (pyIsSpaceCode (pairFirst c))) (pairSecond c) 0)))))\n\nfn matchAt bs: Bytes pat: Bytes i: Int64 k: Int64 m: Int64 -> Bool\n  (cond ((>= k m) true) ((= (bytesGet bs (+ i k)) (bytesGet pat k)) (matchAt bs pat i (+ k 1) m)) (else false))\n\nfn findFrom bs: Bytes n: Int64 pat: Bytes i: Int64 -> Int64\n  (let [(m (bytesLength pat))]\n    (cond ((> (+ i m) n) -1) ((matchAt bs pat i 0 m) i) (else (findFrom bs n pat (+ i 1)))))\n\nfn codesLoop bs: Bytes i: Int64 n: Int64 acc: (List (Pair Int64 Int64)) -> (List (Pair Int64 Int64))\n  (if (>= i n)\n    (listReverse acc)\n    (let [(c (codeAt bs i n))]\n      (codesLoop bs (+ i (pairSecond c)) n (cons (pair (pairFirst c) i) acc))))\n\nfn charCodes s: String -> (List (Pair Int64 Int64))\n  (let [(bs (stringToBytes s))] (codesLoop bs 0 (bytesLength bs) (list)))\n\nfn replaceLoop s: String bs: Bytes i: Int64 n: Int64 start: Int64 acc: (List String) -> (List String)\n  (if (>= i n)\n    (listReverse (cons (optionOr (stringSlice s start n) \"\") acc))\n    (let [(c (codeAt bs i n))]\n      (if (< (pairFirst c) 0)\n        (replaceLoop s bs (+ i (pairSecond c)) n (+ i (pairSecond c)) (cons \"\\xef\\xbf\\xbd\" (cons (optionOr (stringSlice s start i) \"\") acc)))\n        (replaceLoop s bs (+ i (pairSecond c)) n start acc))))\n\nfn utf8Replace s: String -> String\n  (let [(bs (stringToBytes s))] (catAll (replaceLoop s bs 0 (bytesLength bs) 0 (list))))\n\nfn pyStripStart codes: (List (Pair Int64 Int64)) -> (List (Pair Int64 Int64))\n  (mt (listHead codes)\n    ((none) codes)\n    ((some c) (if (pyIsSpaceCode (pairFirst c)) (pyStripStart (optionOr (listTail codes) (list))) codes)))\n\nfn pyStrip s: String -> String\n  (let [(codes (pyStripStart (charCodes s)))]\n    (mt (listHead codes)\n      ((none) \"\")\n      ((some first)\n        (let [(back (pyStripStart (listReverse codes)))]\n          (mt (listHead back)\n            ((none) \"\")\n            ((some last) (let [(endAt (+ (pairSecond last) (pairSecond (codeAt (stringToBytes s) (pairSecond last) (stringLength s)))))]\n                           (optionOr (stringSlice s (pairSecond first) endAt) \"\"))))))))\n\nfn digit? c: String -> Bool\n  (and (= (stringLength c) 1) (>= (charCode c) 48) (<= (charCode c) 57))\n\nfn digitsOk? s: String i: Int64 prevDigit: Bool -> Bool\n  (if (>= i (stringLength s))\n    prevDigit\n    (let [(c (charAt s i))]\n      (cond ((digit? c) (digitsOk? s (+ i 1) true))\n            ((and (= c \"_\") prevDigit) (digitsOk? s (+ i 1) false))\n            (else false))))\n\nfn pyIntText raw: String -> (Option String)\n  (let [(s (pyStrip raw))\n        (neg (stringStartsWith? s \"-\"))\n        (body (if (or neg (stringStartsWith? s \"+\")) (optionOr (stringSlice s 1 (stringLength s)) \"\") s))]\n    (if (or (stringEmpty? body) (not (digit? (charAt body 0))) (not (digitsOk? body 0 false)))\n      (none)\n      (let [(digits (lstripChars (stringReplace body \"_\" \"\") \"0\"))\n            (mag (if (stringEmpty? digits) \"0\" digits))]\n        (some (if (and neg (!= mag \"0\")) (str \"-\" mag) mag)))))\n\nfn sortUnique xs: (List String) -> (List String)\n  (dedupe (listSort xs) (list))\n\nfn dedupe xs: (List String) acc: (List String) -> (List String)\n  (mt (listHead xs)\n    ((none) (listReverse acc))\n    ((some x) (dedupe (optionOr (listTail xs) (list)) (if (= (optionOr (listHead acc) \"\\x00none\") x) acc (cons x acc)))))\n\nfn linesLoop s: String i: Int64 start: Int64 n: Int64 acc: (List String) -> (List String)\n  (cond\n    ((>= i n) (listReverse (if (< start n) (cons (optionOr (stringSlice s start n) \"\") acc) acc)))\n    ((= (charAt s i) \"\\n\") (linesLoop s (+ i 1) (+ i 1) n (cons (optionOr (stringSlice s start (+ i 1)) \"\") acc)))\n    (else (linesLoop s (+ i 1) start n acc)))\n\nfn keepEndsLines s: String -> (List String)\n  (let [(bs (stringToBytes s))] (keepEndsBytes s bs 0 0 (bytesLength bs) (list)))\n\nfn keepEndsBytes s: String bs: Bytes i: Int64 start: Int64 n: Int64 acc: (List String) -> (List String)\n  (cond\n    ((>= i n) (listReverse (if (< start n) (cons (optionOr (stringSlice s start n) \"\") acc) acc)))\n    ((= (bytesGet bs i) 10) (keepEndsBytes s bs (+ i 1) (+ i 1) n (cons (optionOr (stringSlice s start (+ i 1)) \"\") acc)))\n    (else (keepEndsBytes s bs (+ i 1) start n acc)))\n\nfn catAll xs: (List String) -> String\n  (let [(n (listLength xs))]\n    (cond ((= n 0) \"\") ((= n 1) (optionOr (listHead xs) \"\")) ((= n 2) (stringConcat (optionOr (listHead xs) \"\") (optionOr (listGet xs 1) \"\")))\n          (else (let [(h (/ n 2))] (stringConcat (catAll (listTake xs h)) (catAll (listDrop xs h)))))))\n\nfn interleave xs: (List String) sep: String acc: (List String) -> (List String)\n  (mt (listHead xs)\n    ((none) (listReverse acc))\n    ((some x) (interleave (optionOr (listTail xs) (list)) sep (cons x (if (listEmpty? acc) acc (cons sep acc))))))\n\nfn joinWith xs: (List String) sep: String -> String\n  (catAll (interleave xs sep (list)))\n\nfn splitLoop s: String bs: Bytes b: Int64 i: Int64 start: Int64 n: Int64 acc: (List String) -> (List String)\n  (cond\n    ((>= i n) (listReverse (cons (optionOr (stringSlice s start n) \"\") acc)))\n    ((= (bytesGet bs i) b) (splitLoop s bs b (+ i 1) (+ i 1) n (cons (optionOr (stringSlice s start i) \"\") acc)))\n    (else (splitLoop s bs b (+ i 1) start n acc)))\n\nfn splitByte s: String b: Int64 -> (List String)\n  (let [(bs (stringToBytes s))] (splitLoop s bs b 0 0 (bytesLength bs) (list)))\n\nfn crLoop s: String bs: Bytes i: Int64 start: Int64 n: Int64 acc: (List String) -> (List String)\n  (cond\n    ((>= i n) (listReverse (cons (optionOr (stringSlice s start n) \"\") acc)))\n    ((= (bytesGet bs i) 13)\n      (let [(skip (if (and (< (+ i 1) n) (= (bytesGet bs (+ i 1)) 10)) 2 1))]\n        (crLoop s bs (+ i skip) (+ i skip) n (cons \"\\n\" (cons (optionOr (stringSlice s start i) \"\") acc)))))\n    (else (crLoop s bs (+ i 1) start n acc)))\n\nfn universalNewlines s: String -> String\n  (if (stringContains? s \"\\r\") (let [(bs (stringToBytes s))] (catAll (crLoop s bs 0 0 (bytesLength bs) (list)))) s)\n\nfn lines s: String -> (List String)\n  (splitByte s 10)\n\nfn sectionBody secs: (List Section) shown: (List Int64) -> String\n  (joinWith (map (fn [(p (Pair Section Int64))] -> String\n                     (str \" :\" (pairFirst p).key \" (\" (joinWith (listTake (pairFirst p).items (pairSecond p)) \" \") \")\"))\n                   (zip secs shown)) \"\")\n\nfn sectionMore secs: (List Section) shown: (List Int64) -> String\n  (str \" :more (\" (joinWith (map (fn [(p (Pair Section Int64))] -> String\n                                     (str \":\" (pairFirst p).key \" \" (stringFromInt64 (- (listLength (pairFirst p).items) (pairSecond p)))))\n                                   (zip secs shown)) \" \") \")\")\n\nfn shrinkLast shown: (List Int64) -> (Option (List Int64))\n  (let [(rev (listReverse shown))]\n    (mt (shrinkFirstPositive rev (list))\n      ((some r) (some (listReverse r)))\n      ((none) (none))))\n\nfn shrinkFirstPositive xs: (List Int64) acc: (List Int64) -> (Option (List Int64))\n  (mt (listHead xs)\n    ((none) (none))\n    ((some x) (if (> x 0)\n                (some (listAppend (listReverse acc) (cons (- x 1) (optionOr (listTail xs) (list)))))\n                (shrinkFirstPositive (optionOr (listTail xs) (list)) (cons x acc)))))\n\nfn fitLoop head: String secs: (List Section) tail: String what: String shown: (List Int64) -> (Result String String)\n  (let [(receipt (str head (sectionBody secs shown) (sectionMore secs shown) tail \")\"))]\n    (if (< (byteLen receipt) (receiptMax))\n      (ok receipt)\n      (mt (shrinkLast shown)\n        ((some next) (fitLoop head secs tail what next))\n        ((none) (err (rejectLine \"ERR_RECEIPT_TOO_LARGE\" (str what \" receipt exceeds \" (stringFromInt64 (receiptMax)) \" bytes with every list empty\") \"\"))))))\n\nfn fitReceipt head: String secs: (List Section) tail: String what: String -> (Result String String)\n  (fitLoop head secs tail what (map (fn [(s Section)] -> Int64 (min s.limit (listLength s.items))) secs))\n\nfn closeMatches word: String names: (List String) n: Int64 cutoff: Float64 -> (List String)\n  (sim/getCloseMatches word names n cutoff)\n")
(:file :tree "tcEdge" :path "asl/tools/observe/memory.asl" :text "(module ws/asl/tools/observe/memory\n  :x [topLevelForms observeMemory!]\n  :i [(ws/asl/tools/observe/common :a c)])\n\nfn ledgerCap -> Int64\n  40\n\nfn formsLoop bs: Bytes i: Int64 n: Int64 depth: Int64 forms: Int64 inStr: Bool inComment: Bool -> Int64\n  (if (>= i n)\n    forms\n    (let [(b (bytesGet bs i))]\n      (cond\n        (inComment (formsLoop bs (+ i 1) n depth forms inStr (!= b 10)))\n        (inStr (cond ((= b 92) (formsLoop bs (+ i 2) n depth forms true false))\n                     ((= b 34) (formsLoop bs (+ i 1) n depth forms false false))\n                     (else (formsLoop bs (+ i 1) n depth forms true false))))\n        ((= b 34) (formsLoop bs (+ i 1) n depth forms true false))\n        ((= b 59) (formsLoop bs (+ i 1) n depth forms false true))\n        ((or (= b 40) (= b 91) (= b 123)) (formsLoop bs (+ i 1) n (+ depth 1) (if (= depth 0) (+ forms 1) forms) false false))\n        ((or (= b 41) (= b 93) (= b 125)) (formsLoop bs (+ i 1) n (max 0 (- depth 1)) forms false false))\n        (else (formsLoop bs (+ i 1) n depth forms false false)))))\n\nfn topLevelForms data: String -> Int64\n  (let [(bs (stringToBytes data))] (formsLoop bs 0 (bytesLength bs) 0 0 false false))\n\nfn ledgerStats! path: String -> (Result (Pair Int64 Int64) String)\n  (mt (fileReadString path)\n    ((ok data) (ok (pair (topLevelForms data) (stringLength data))))\n    ((err e) (err e)))\n\nfn listDir! path: String -> (Result (List String) String)\n  (dirList path)\n\nfn walkSum! dir: String -> (Result (Pair Int64 Int64) String)\n  (mt (listDir! dir)\n    ((err e) (err e))\n    ((ok names)\n      (fold (fn [(acc (Result (Pair Int64 Int64) String)) (name String)] -> (Result (Pair Int64 Int64) String)\n              (mt acc\n                ((err e) (err e))\n                ((ok tot)\n                  (let [(full (c/joinPath dir name))]\n                    (cond\n                      ((c/isDir? full)\n                        (if (c/isLink? full)\n                          (ok tot)\n                          (mt (walkSum! full) ((ok s) (ok (pair (+ (pairFirst tot) (pairFirst s)) (+ (pairSecond tot) (pairSecond s))))) ((err e) (err e)))))\n                      ((stringEndsWith? name \".asn\")\n                        (mt (ledgerStats! full) ((ok s) (ok (pair (+ (pairFirst tot) (pairFirst s)) (+ (pairSecond tot) (pairSecond s))))) ((err e) (err e))))\n                      (else (ok tot)))))))\n            (ok (pair 0 0)) names)))\n\n(schema Ledger (:f path String) (:f forms Int64) (:f bytes Int64))\n\nfn ledgerForm l: Ledger -> String\n  (str \"(:path \" (c/quoted l.path) \" :forms \" (stringFromInt64 l.forms) \" :bytes \" (stringFromInt64 l.bytes) \")\")\n\nfn entries! mem: String names: (List String) acc: (List Ledger) -> (Result (List Ledger) String)\n  (mt (listHead names)\n    ((none) (ok (listReverse acc)))\n    ((some name)\n      (let [(full (c/joinPath mem name)) (rel (str \".asl/mem/\" name)) (rest (optionOr (listTail names) (list)))]\n        (cond\n          ((and (c/isFile? full) (stringEndsWith? name \".asn\"))\n            (mt (ledgerStats! full) ((ok s) (entries! mem rest (cons (Ledger :path rel :forms (pairFirst s) :bytes (pairSecond s)) acc))) ((err e) (err e))))\n          ((c/isDir? full)\n            (mt (walkSum! full) ((ok s) (entries! mem rest (cons (Ledger :path (str rel \"/\") :forms (pairFirst s) :bytes (pairSecond s)) acc))) ((err e) (err e))))\n          (else (entries! mem rest acc))))))\n\nfn ! observeMemory! root: String ctx: c/Ctx -> (Result String String)\n  (let [(mem (c/joinPath root \".asl/mem\"))]\n    (if (not (c/isDir? mem))\n      (err (c/rejectLine \"ERR_PATH_NOT_FOUND\" (str \"no .asl/mem directory under \" root) \"\"))\n      (mt (listDir! mem)\n        ((err e) (err (c/rejectLine \"ERR_IO\" e \"\")))\n        ((ok names)\n          (mt (entries! mem names (list))\n            ((err e) (err (c/rejectLine \"ERR_IO\" e \"\")))\n            ((ok ls)\n              (mt (c/shortRev! root ctx)\n                ((err e) (err e))\n                ((ok rev)\n                  (let [(shown (listTake ls (ledgerCap)))]\n                    (ok (str \"(:observe :dim memory :rev \" rev \" :ledgers (\" (c/joinWith (map ledgerForm shown) \" \") \") :more \"\n                             (stringFromInt64 (- (listLength ls) (listLength shown))) \")\")))))))))))\n")
(:file :tree "tcEdge" :path "asl/tools/observe/session.asl" :text "(module ws/asl/tools/observe/session\n  :x [JVal jsonParse pyStr truthy? fnmatch? ownsCover? ownsMeet readJournal observeSession!]\n  :i [(ws/asl/tools/observe/common :a c)])\n\nfn staleAfter -> Int64\n  1800\n\nfn pathsCap -> Int64\n  8\n\nfn alnum? k: Int64 -> Bool\n  (or (and (>= k 48) (<= k 57)) (and (>= k 65) (<= k 90)) (and (>= k 97) (<= k 122)))\n\nfn alpha? k: Int64 -> Bool\n  (or (and (>= k 65) (<= k 90)) (and (>= k 97) (<= k 122)))\n\nfn sessionId? s: String -> Bool\n  (let [(bs (stringToBytes s)) (n (bytesLength bs))]\n    (and (> n 0) (alnum? (bytesGet bs 0))\n         (listAll? (fn [(i Int64)] -> Bool (let [(k (bytesGet bs i))] (or (alnum? k) (= k 46) (= k 95) (= k 45)))) (range 1 n))))\n\n(enum JVal\n  (:c jNull [])\n  (:c jBool [(b Bool)])\n  (:c jInt [(digits String)])\n  (:c jFloat [(x Float64)])\n  (:c jStr [(s String)])\n  (:c jArr [(xs (List JVal))])\n  (:c jObj [(kvs (List (Pair String JVal)))]))\n\n(schema JP (:f v JVal) (:f at Int64))\n\nfn byteAt bs: Bytes i: Int64 n: Int64 -> Int64\n  (if (< i n) (bytesGet bs i) -1)\n\nfn skipWs bs: Bytes i: Int64 n: Int64 -> Int64\n  (let [(b (byteAt bs i n))]\n    (if (or (= b 32) (= b 9) (= b 10) (= b 13)) (skipWs bs (+ i 1) n) i))\n\nfn sliceOf s: String a: Int64 b: Int64 -> String\n  (optionOr (stringSlice s a b) \"\")\n\nfn digitsEnd bs: Bytes i: Int64 n: Int64 -> Int64\n  (let [(b (byteAt bs i n))] (if (and (>= b 48) (<= b 57)) (digitsEnd bs (+ i 1) n) i))\n\nfn hexVal b: Int64 -> Int64\n  (cond ((and (>= b 48) (<= b 57)) (- b 48)) ((and (>= b 97) (<= b 102)) (- b 87)) ((and (>= b 65) (<= b 70)) (- b 55)) (else -1))\n\nfn hex4 bs: Bytes i: Int64 n: Int64 -> Int64\n  (if (> (+ i 4) n)\n    -1\n    (let [(a (hexVal (bytesGet bs i))) (b (hexVal (bytesGet bs (+ i 1)))) (d (hexVal (bytesGet bs (+ i 2)))) (e (hexVal (bytesGet bs (+ i 3))))]\n      (if (or (< a 0) (< b 0) (< d 0) (< e 0)) -1 (+ (* a 4096) (* b 256) (* d 16) e))))\n\nfn byteStr k: Int64 -> String\n  (optionOr (stringSlice (byteTable) k (+ k 1)) \"\")\n\nfn byteTable -> String\n  \"\\x00\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\\x0a\\x0b\\x0c\\x0d\\x0e\\x0f\\x10\\x11\\x12\\x13\\x14\\x15\\x16\\x17\\x18\\x19\\x1a\\x1b\\x1c\\x1d\\x1e\\x1f\\x20\\x21\\x22\\x23\\x24\\x25\\x26\\x27\\x28\\x29\\x2a\\x2b\\x2c\\x2d\\x2e\\x2f\\x30\\x31\\x32\\x33\\x34\\x35\\x36\\x37\\x38\\x39\\x3a\\x3b\\x3c\\x3d\\x3e\\x3f\\x40\\x41\\x42\\x43\\x44\\x45\\x46\\x47\\x48\\x49\\x4a\\x4b\\x4c\\x4d\\x4e\\x4f\\x50\\x51\\x52\\x53\\x54\\x55\\x56\\x57\\x58\\x59\\x5a\\x5b\\x5c\\x5d\\x5e\\x5f\\x60\\x61\\x62\\x63\\x64\\x65\\x66\\x67\\x68\\x69\\x6a\\x6b\\x6c\\x6d\\x6e\\x6f\\x70\\x71\\x72\\x73\\x74\\x75\\x76\\x77\\x78\\x79\\x7a\\x7b\\x7c\\x7d\\x7e\\x7f\\x80\\x81\\x82\\x83\\x84\\x85\\x86\\x87\\x88\\x89\\x8a\\x8b\\x8c\\x8d\\x8e\\x8f\\x90\\x91\\x92\\x93\\x94\\x95\\x96\\x97\\x98\\x99\\x9a\\x9b\\x9c\\x9d\\x9e\\x9f\\xa0\\xa1\\xa2\\xa3\\xa4\\xa5\\xa6\\xa7\\xa8\\xa9\\xaa\\xab\\xac\\xad\\xae\\xaf\\xb0\\xb1\\xb2\\xb3\\xb4\\xb5\\xb6\\xb7\\xb8\\xb9\\xba\\xbb\\xbc\\xbd\\xbe\\xbf\\xc0\\xc1\\xc2\\xc3\\xc4\\xc5\\xc6\\xc7\\xc8\\xc9\\xca\\xcb\\xcc\\xcd\\xce\\xcf\\xd0\\xd1\\xd2\\xd3\\xd4\\xd5\\xd6\\xd7\\xd8\\xd9\\xda\\xdb\\xdc\\xdd\\xde\\xdf\\xe0\\xe1\\xe2\\xe3\\xe4\\xe5\\xe6\\xe7\\xe8\\xe9\\xea\\xeb\\xec\\xed\\xee\\xef\\xf0\\xf1\\xf2\\xf3\\xf4\\xf5\\xf6\\xf7\\xf8\\xf9\\xfa\\xfb\\xfc\\xfd\\xfe\\xff\"\n\nfn utf8Of cp: Int64 -> String\n  (cond\n    ((< cp 128) (byteStr cp))\n    ((< cp 2048) (str (byteStr (+ 192 (/ cp 64))) (byteStr (+ 128 (mod cp 64)))))\n    ((< cp 65536) (str (byteStr (+ 224 (/ cp 4096))) (byteStr (+ 128 (mod (/ cp 64) 64))) (byteStr (+ 128 (mod cp 64)))))\n    (else (str (byteStr (+ 240 (/ cp 262144))) (byteStr (+ 128 (mod (/ cp 4096) 64))) (byteStr (+ 128 (mod (/ cp 64) 64))) (byteStr (+ 128 (mod cp 64))))))\n\nfn strBody s: String bs: Bytes i: Int64 n: Int64 start: Int64 acc: (List String) -> (Result JP String)\n  (let [(b (byteAt bs i n))]\n    (cond\n      ((< b 0) (err \"Unterminated string\"))\n      ((= b 34) (ok (JP :v (jStr (c/catAll (listReverse (cons (sliceOf s start i) acc)))) :at (+ i 1))))\n      ((< b 32) (err \"Invalid control character\"))\n      ((= b 92)\n        (let [(e (byteAt bs (+ i 1) n)) (pre (cons (sliceOf s start i) acc))]\n          (cond\n            ((= e 34) (strBody s bs (+ i 2) n (+ i 2) (cons \"\\\"\" pre)))\n            ((= e 92) (strBody s bs (+ i 2) n (+ i 2) (cons \"\\\\\" pre)))\n            ((= e 47) (strBody s bs (+ i 2) n (+ i 2) (cons \"/\" pre)))\n            ((= e 98) (strBody s bs (+ i 2) n (+ i 2) (cons \"\\x08\" pre)))\n            ((= e 102) (strBody s bs (+ i 2) n (+ i 2) (cons \"\\x0c\" pre)))\n            ((= e 110) (strBody s bs (+ i 2) n (+ i 2) (cons \"\\n\" pre)))\n            ((= e 114) (strBody s bs (+ i 2) n (+ i 2) (cons \"\\r\" pre)))\n            ((= e 116) (strBody s bs (+ i 2) n (+ i 2) (cons \"\\t\" pre)))\n            ((= e 117)\n              (let [(u (hex4 bs (+ i 2) n))]\n                (cond\n                  ((< u 0) (err \"Invalid \\\\uXXXX escape\"))\n                  ((and (>= u 55296) (<= u 56319) (= (byteAt bs (+ i 6) n) 92) (= (byteAt bs (+ i 7) n) 117))\n                    (let [(lo (hex4 bs (+ i 8) n))]\n                      (if (and (>= lo 56320) (<= lo 57343))\n                        (strBody s bs (+ i 12) n (+ i 12) (cons (utf8Of (+ 65536 (* (- u 55296) 1024) (- lo 56320))) pre))\n                        (strBody s bs (+ i 6) n (+ i 6) (cons (utf8Of u) pre)))))\n                  (else (strBody s bs (+ i 6) n (+ i 6) (cons (utf8Of u) pre))))))\n            (else (err \"Invalid \\\\escape\")))))\n      (else (strBody s bs (+ i 1) n start acc))))\n\nfn numberAt s: String bs: Bytes i: Int64 n: Int64 -> (Result JP String)\n  (let [(neg (= (byteAt bs i n) 45))\n        (j (if neg (+ i 1) i))\n        (b (byteAt bs j n))]\n    (cond\n      ((and neg (= b 73) (= (sliceOf s j (+ j 8)) \"Infinity\")) (ok (JP :v (jFloat (floatNegInf)) :at (+ j 8))))\n      ((not (and (>= b 48) (<= b 57))) (err \"Expecting value\"))\n      (else\n        (let [(intEnd (if (= b 48) (+ j 1) (digitsEnd bs j n)))\n              (fracEnd (if (and (= (byteAt bs intEnd n) 46) (let [(d (byteAt bs (+ intEnd 1) n))] (and (>= d 48) (<= d 57)))) (digitsEnd bs (+ intEnd 1) n) intEnd))\n              (e (byteAt bs fracEnd n))\n              (expStart (if (or (= e 101) (= e 69)) (let [(sg (byteAt bs (+ fracEnd 1) n))] (if (or (= sg 43) (= sg 45)) (+ fracEnd 2) (+ fracEnd 1))) -1))\n              (expEnd (if (and (>= expStart 0) (let [(d (byteAt bs expStart n))] (and (>= d 48) (<= d 57)))) (digitsEnd bs expStart n) fracEnd))\n              (text (sliceOf s i expEnd))]\n          (if (and (= fracEnd intEnd) (= expEnd fracEnd))\n            (let [(mag (c/lstripChars (sliceOf s j intEnd) \"0\"))]\n              (ok (JP :v (jInt (if (stringEmpty? mag) \"0\" (if neg (str \"-\" mag) mag))) :at expEnd)))\n            (mt (stringToFloat64 text)\n              ((some f) (ok (JP :v (jFloat f) :at expEnd)))\n              ((none) (err \"Invalid number\"))))))))\n\nfn valueAt s: String bs: Bytes i: Int64 n: Int64 depth: Int64 -> (Result JP String)\n  (let [(b (byteAt bs i n))]\n    (cond\n      ((> depth 900) (err \"RecursionError\"))\n      ((= b 34) (strBody s bs (+ i 1) n (+ i 1) (list)))\n      ((= b 123) (objectAt s bs (skipWs bs (+ i 1) n) n depth (list) true))\n      ((= b 91) (arrayAt s bs (skipWs bs (+ i 1) n) n depth (list) true))\n      ((= (sliceOf s i (+ i 4)) \"null\") (ok (JP :v (jNull) :at (+ i 4))))\n      ((= (sliceOf s i (+ i 4)) \"true\") (ok (JP :v (jBool true) :at (+ i 4))))\n      ((= (sliceOf s i (+ i 5)) \"false\") (ok (JP :v (jBool false) :at (+ i 5))))\n      ((= (sliceOf s i (+ i 3)) \"NaN\") (ok (JP :v (jFloat (floatNan)) :at (+ i 3))))\n      ((= (sliceOf s i (+ i 8)) \"Infinity\") (ok (JP :v (jFloat (floatInf)) :at (+ i 8))))\n      (else (numberAt s bs i n))))\n\nfn arrayAt s: String bs: Bytes i: Int64 n: Int64 depth: Int64 acc: (List JVal) first: Bool -> (Result JP String)\n  (if (and first (= (byteAt bs i n) 93))\n    (ok (JP :v (jArr (list)) :at (+ i 1)))\n    (mt (valueAt s bs i n (+ depth 1))\n      ((err e) (err e))\n      ((ok p)\n        (let [(j (skipWs bs p.at n)) (b (byteAt bs j n)) (acc2 (cons p.v acc))]\n          (cond\n            ((= b 93) (ok (JP :v (jArr (listReverse acc2)) :at (+ j 1))))\n            ((= b 44) (arrayAt s bs (skipWs bs (+ j 1) n) n depth acc2 false))\n            (else (err \"Expecting ',' delimiter\")))))))\n\nfn putKey kvs: (List (Pair String JVal)) k: String v: JVal -> (List (Pair String JVal))\n  (if (listAny? (fn [(p (Pair String JVal))] -> Bool (= (pairFirst p) k)) kvs)\n    (map (fn [(p (Pair String JVal))] -> (Pair String JVal) (if (= (pairFirst p) k) (pair k v) p)) kvs)\n    (listAppend kvs (list (pair k v))))\n\nfn objectAt s: String bs: Bytes i: Int64 n: Int64 depth: Int64 acc: (List (Pair String JVal)) first: Bool -> (Result JP String)\n  (let [(b (byteAt bs i n))]\n    (cond\n      ((and first (= b 125)) (ok (JP :v (jObj (list)) :at (+ i 1))))\n      ((!= b 34) (err \"Expecting property name enclosed in double quotes\"))\n      (else\n        (mt (strBody s bs (+ i 1) n (+ i 1) (list))\n          ((err e) (err e))\n          ((ok kp)\n            (let [(j (skipWs bs kp.at n))]\n              (if (!= (byteAt bs j n) 58)\n                (err \"Expecting ':' delimiter\")\n                (mt (valueAt s bs (skipWs bs (+ j 1) n) n (+ depth 1))\n                  ((err e) (err e))\n                  ((ok vp)\n                    (let [(key (mt kp.v ((jStr k) k) (_ \"\")))\n                          (acc2 (putKey acc key vp.v))\n                          (m (skipWs bs vp.at n))\n                          (d (byteAt bs m n))]\n                      (cond\n                        ((= d 125) (ok (JP :v (jObj acc2) :at (+ m 1))))\n                        ((= d 44) (objectAt s bs (skipWs bs (+ m 1) n) n depth acc2 false))\n                        (else (err \"Exp