(:case :src leon :form "(:read :file \"asl/packages/asl-checker/src/resolve.asl\" :symbol \"resolveModule\")" :want "(:read :file \"asl/packages/asl-checker/src/resolve.asl\" :symbol \"resolveModule\" :kind \"fn\" :language \"asl\" :start 856 :end 858 :content \"fn resolveModule mod: ModuleSummary forms: (List a/TopForm) deps: (Map String ModuleSummary) -> (List ty/Diagnostic)\\n  :d \\\"Pass 1 and 2 diagnostics: reserved names, module rules, imports and cycles, export closure, type annotations and body resolution.\\\"\\n  (let [(p (.-path mod)) (poses (defunPositions forms))] (listAppend (checkReservedNames forms p) (listAppend (checkModuleRules mod poses p) (listAppend (checkImportsAndCycles mod deps p) (listAppend (checkExportClosure mod p) (listAppend (checkTypeAnnotations mod deps poses p) (checkBodies forms mod deps p)))))))\")\n" :exit 0)
(:case :src leon :form "(:read :file \"asl/grammar/tools.asn\" :symbol \"observe\")" :want "(:read :file \"asl/grammar/tools.asn\" :symbol \"observe\" :kind \"op\" :language \"asn\" :start 226 :end 238 :content \"(:op :observe\\n      :scope toolchain\\n      :form \\\"(:observe :dim <tokenCost|memory|session|callers|status|coverage> [:scope p] [:limit n] [:symbol s] [:module m] [:path p] [:spec p] [:id r])\\\"\\n      :params (\\n        (:dim :type sym :req true :note \\\"callers: call sites of :symbol with path:line and kind, :possible, :excluded decoys; status: stub, callers, executing tests of :symbol or :path; coverage: :spec requirements implemented/tested; tokenCost: tokens by kind; memory: .asl/mem ledger sizes; session: agent sessions and :overlaps\\\")\\n        (:scope :type str :default \\\".\\\" :note \\\"tokenCost: tracked files under this path\\\")\\n        (:limit :type int :default 20 :note \\\"tokenCost :top or sessions shown, rest in :more; 1-100; receipt < 4096 bytes\\\")\\n      )\\n      :examples (\\n        \\\"(:observe :dim callers :symbol \\\\\\\"Cache.fetch\\\\\\\")\\\"\\n      )\\n      :errors (ERR_UNKNOWN_DIM ERR_NO_ENCODER ERR_BAD_ARG ERR_PATH_NOT_FOUND ERR_BOUNDARY_VIOLATION ERR_EXEC_FAILED)\\n      :doc \\\"Read-only workspace facts; an unknown :dim lists :nearest.\\\")\")\n" :exit 0)
