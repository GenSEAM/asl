(:case :src leon :form "(:read :file \"scripts/audit/foreignAllowlist.asn\" :start 1 :end 80)" :want "(:read :file \"scripts/audit/foreignAllowlist.asn\" :start 1 :end 80 :content \"(:foreignAllowlist :v 1 :owner \\\"T3 U5\\\" :date \\\"2026-09-23\\\"\\n  :doc \\\"exact tracked paths allowed to hold foreign code; foreign means a foreign extension, a #! first line, or Mach-O, universal, ELF or wasm magic; an unlisted foreign file is ERR_FOREIGN and an entry naming no tracked file is ERR_STALE_ALLOWLIST; :kind must admit the file language (ERR_FOREIGN_KIND); every entry has a volume row in foreignBaseline.asn (ERR_FOREIGN_BASELINE, ERR_FOREIGN_GROWTH); an entry new since the ratchet base with :until :none carries :reason (ERR_UNTIL_NONE_REASON)\\\"\\n \\n \\n \\n \\n \\n \\n \\n \\n \\n \\n \\n \\n \\n \\n \\n \\n \\n \\n \\n \\n  (:path \\\"asl/agentLoop/tests/genPlanFixture.py\\\" :kind :testGenerator :rationale \\\"fixture generator running Python originals from main:scripts/agentLoop/loop.py for planParityFixture.asn\\\" :until :none :reason \\\"LP1 parity fixture generator\\\")\\n  (:path \\\"tests/parity/observe/observeGen.py\\\" :kind :testGenerator :rationale \\\"fixture generator running scripts/observe.py pinned at 02aff5d0 for observeFixture.asn\\\" :until :none :reason \\\"U14 parity fixture generator\\\")\\n  (:path \\\"tests/parity/observe/observePyCases.py\\\" :kind :testGenerator :rationale \\\"python-subject cases of the observe fixture generator (callers, status, coverage, python3 absent, tokenCost)\\\" :until :none :reason \\\"U14 parity fixture cases\\\")\\n  (:path \\\"tests/parity/agentLoop/providersGen.py\\\" :kind :testGenerator :rationale \\\"U1 fixture generator running scripts/agentLoop/backend.py pinned at a33969ab for asl/agentLoop/tests/providersFixture.asn\\\" :until :none :reason \\\"the parity oracle until LP14 deletes backend.py; then the fixture is frozen and this generator goes\\\")\\n  (:path \\\"tests/parity/gates/recordRunnerCorpus.py\\\" :kind :testGenerator :rationale \\\"RN1a fixture recorder computes runner.py's blob SHA at record time for the frozen 26-suite corpus\\\" :until :none :reason \\\"RN1a runner corpus fixture generator\\\")\\n  (:path \\\"tests/parity/gates/recordAuditFixture.py\\\" :kind :testGenerator :rationale \\\"RN1a audit fixture recorder running dyck.py and vacuity.py at pinned blobs for audit parity fixtures\\\" :until :none :reason \\\"RN1a audit fixture generator\\\")\\n  (:path \\\"tests/parity/agentLoop/loopRunGen.py\\\" :kind :testGenerator :rationale \\\"LOOP4 deterministic run_loop fixture recorder pinned to the Python loop\\\" :until :none :reason \\\"LOOP4 run_loop fixture generator\\\")\\n  (:path \\\"tests/parity/agentLoop/loopRunGenTest.py\\\" :kind :python :rationale \\\"regression gate proving fixture recording rejects absent host failures, sandbox errors and unmasked paths\\\" :until :none :reason \\\"LOOP4 fixture recorder safety tests\\\")\\n  (:path \\\"tests/parity/agentLoop/turnParityGen.py\\\" :kind :testGenerator :rationale \\\"LX2b scripted-provider journal-delta fixture generator pinned to main loop.py\\\" :until :none :reason \\\"LX2b turn parity fixture generator\\\")\\n  (:path \\\"tests/parity/agentLoop/toolCallsGen.py\\\" :kind :testGenerator :rationale \\\"LOOP1 tool-call template parity fixture generator using pinned main loop.py\\\" :until :none :reason \\\"LOOP1 parity oracle for tool-call conversion\\\")\\n  (:path \\\"tests/parity/agentLoop/turnGlueTest.py\\\" :kind :testGenerator :rationale \\\"LX2b Python/core-host boundary and per-turn journal-delta regression gate\\\" :until :none :reason \\\"LX2b turn glue regression tests\\\")\\n  (:path \\\"tests/parity/agentLoop/gateIntegrityGen.py\\\" :kind :testGenerator :rationale \\\"LOOP2 fixture generator running original scripts/agentLoop/loop.py to generate gateIntegrityFixture.asn\\\" :until :none :reason \\\"LOOP2 gate-integrity parity fixture generator\\\")\\n  (:path \\\"asl/agentslang\\\" :kind :shell :rationale \\\"host launcher or tool binary predating R1\\\" :until :none)\\n  (:path \\\"asl/asl\\\" :kind :machO :rationale \\\"host launcher or tool binary predating R1\\\" :until :none)\\n  (:path \\\"asl/bin/addie\\\" :kind :shell :rationale \\\"host launcher or tool binary predating R1\\\" :until :none)\\n  (:path \\\"asl/bin/asl\\\" :kind :machO :rationale \\\"host launcher or tool binary predating R1\\\" :until :none)\\n  (:path \\\"asl/bin/asl-eval\\\" :kind :shell :rationale \\\"host launcher or tool binary predating R1\\\" :until :none)\\n  (:path \\\"asl/bin/eddie\\\" :kind :shell :rationale \\\"host launcher or tool binary predating R1\\\" :until :none)\\n  (:path \\\"asl/dist/install.sh\\\" :kind :shell :rationale \\\"byte copy of scripts/install.sh checked by the installer identity check\\\" :until :none)\\n  (:path \\\"asl/host/build.sh\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/abi.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host runtime ABI for LLVM-compiled code, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/arrays.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/check.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/compile.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/compile.h\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/embed.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/float.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/gc.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/gcHooks.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/loader.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/main.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/parquet.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/prelude.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/reader.c\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/host/src/reader.h\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1