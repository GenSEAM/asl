n\\nfn getSexprItemsList expr: rd/SExpr -> (List rd/SExpr)\\n  (mt expr ((rd/sexprList items) items) (_ (list)))\\n\\nfn isNonEmptySexpr expr: rd/SExpr -> Bool\\n  (mt expr ((rd/sexprList items) (not (listEmpty? items))) ((rd/sexprVect items) (not (listEmpty? items))) ((rd/sexprAtom v) (> (stringLength (stringTrim v)) 0)))\\n\\nfn projectLensHtml model: MultilensModel opts: LensOptions -> LensResult\\n  (let [(title (findMetadataVal (.-meta model) \\\":title\\\" \\\"AgentSlang Document\\\")) (lang (findMetadataVal (.-meta model) \\\":lang\\\" \\\"en\\\")) (cssText (if (.-includeStyles opts) (ce/asnToCss (.-styles model) (.-minify opts)) \\\"\\\")) (contentExpr (.-content model)) (bodyHtml (mt contentExpr ((rd/sexprList items) (if (listEmpty? items) \\\"\\\" (tr/vdomNodeToHtml contentExpr))) ((rd/sexprAtom v) (txt/stripQuotes v)) (_ \\\"\\\"))) (htmlOut (if (.-standalone opts) (tr/renderHtml5Document title lang cssText bodyHtml (.-minify opts)) bodyHtml)) (origStr (rd/renderSexpr (.-content model))) (origTok (txt/estimateTokens origStr)) (outTok (txt/estimateTokens htmlOut)) (savings (txt/calcSavings origTok outTok))] (LensResult :lens \\\"html\\\" :output htmlOut :originalTokens origTok :emittedTokens outTok :savingsPercent savings :success true :errorMsg \\\"\\\"))\\n\\nfn projectLensCss model: MultilensModel opts: LensOptions -> LensResult\\n  (let [(stylesExpr (.-styles model)) (cssOut (ce/asnToCss stylesExpr (.-minify opts))) (origStr (rd/renderSexpr stylesExpr)) (origTok (txt/estimateTokens origStr)) (outTok (txt/estimateTokens cssOut)) (savings (txt/calcSavings origTok outTok))] (LensResult :lens \\\"css\\\" :output cssOut :originalTokens origTok :emittedTokens outTok :savingsPercent savings :success true :errorMsg \\\"\\\"))\\n\\nfn projectLensYaml model: MultilensModel opts: LensOptions -> LensResult\\n  (let [(cfg (.-config model)) (dat (.-data model)) (targetExpr (if (isNonEmptySexpr cfg) (if (isNonEmptySexpr dat) (rd/makeList (listAppend (getSexprItemsList cfg) (getSexprItemsList dat))) cfg) (if (isNonEmptySexpr dat) dat (rd/makeList (list))))) (compactAsn (rd/renderSexpr targetExpr)) (res (yt/asnToYaml compactAsn))] (LensResult :lens \\\"yaml\\\" :output (.-output res) :originalTokens (.-originalTokens res) :emittedTokens (.-asnTokens res) :savingsPercent (.-savingsPercent res) :success (.-success res) :errorMsg \\\"\\\"))\\n\\nfn projectLensJson model: MultilensModel opts: LensOptions -> LensResult\\n  (let [(dat (.-data model)) (cfg (.-config model)) (targetExpr (if (isNonEmptySexpr dat) dat (if (isNonEmptySexpr cfg) cfg (rd/makeList (list))))) (compactAsn (rd/renderSexpr targetExpr)) (res (tr/asnToJson compactAsn))] (LensResult :lens \\\"json\\\" :output (.-output res) :originalTokens (.-originalTokens res) :emittedTokens (.-asnTokens res) :savingsPercent (.-savingsPercent res) :success (.-success res) :errorMsg \\\"\\\"))\\n\\nfn projectLensToml model: MultilensModel opts: LensOptions -> LensResult\\n  (let [(cfg (.-config model)) (meta (.-meta model)) (targetExpr (if (isNonEmptySexpr cfg) (if (isNonEmptySexpr meta) (rd/makeList (listAppend (getSexprItemsList meta) (getSexprItemsList cfg))) cfg) (if (isNonEmptySexpr meta) meta (rd/makeList (list))))) (compactAsn (rd/renderSexpr targetExpr)) (res (tt/asnToTomlDocument compactAsn))] (LensResult :lens \\\"toml\\\" :output (.-output res) :originalTokens (.-originalTokens res) :emittedTokens (.-asnTokens res) :savingsPercent (.-savingsPercent res) :success (.-success res) :errorMsg \\\"\\\"))\\n\\nfn projectLens lens: Str model: MultilensModel opts: LensOptions -> LensResult\\n  (let [(cleanLens (stringTrim (txt/stripColon lens)))] (cond ((= cleanLens \\\"html\\\") (projectLensHtml model opts)) ((= cleanLens \\\"css\\\") (projectLensCss model opts)) ((= cleanLens \\\"yaml\\\") (projectLensYaml model opts)) ((= cleanLens \\\"json\\\") (projectLensJson model opts)) ((= cleanLens \\\"toml\\\") (projectLensToml model opts)) (else (LensResult :lens lens :output \\\"\\\" :originalTokens 0 :emittedTokens 0 :savingsPercent 0.0 :success false :errorMsg (str \\\"Unsupported lens: \\\" lens)))))\\n\\nfn findLensOutput results: (List LensResult) target: Str -> Str\\n  (mt (listHead results) ((none) \\\"\\\") ((some r) (if (= (.-lens r) target) (.-output r) (findLensOutput (optionOr (listTail results) (list)) target))))\\n\\nfn emitMultilensBundle model: MultilensModel lenses: (List Str) opts: LensOptions -> MultilensBundle\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"asl/packages/asl-cli/src/cli.asl\")" :want "(:read :file \"asl/packages/asl-cli/src/cli.asl\" :truncated true :limit 200 :maxBytes 12000 :totalLines 228 :more (:start 183 :end 228) :content \"(module asl-cli/cli :d \\\"Pure AgentSlang native command-line interface toolchain.\\\" :x [formatVersion formatHelp checkGateFiles dispatchRpc dispatchCmd executeCli main] :i [(ast :a a) (compiler :a comp) (asl-checker/types :a ty) (asl-checker/check :a chk) (reader :a rd) (batch :a b) (migrate :a mig) (asl-cli/patch :a patchCli) (asl-cli/impact :a impactCli) (asl-cli/check :a checkCli) (asl-cli/watch :a watchCli) (asl-cli/heal :a healCli) (asl-cli/digest :a digestCli) (asl-cli/auditCmd :a auditCli) (asl-cli/lensCmd :a lensCmd) (asl-cli/consiliumCmd :a consiliumCmd)])\\n\\nfn formatVersion -> Str\\n  \\\"asl 0.1.0 (pure AgentSlang self-hosted toolchain)\\\"\\n\\nfn formatHelp -> Str\\n  (str \\\"AgentSlang Native CLI (Unified Full S-Expression Toolchain)\\\\n\\\"\\n       \\\"Usage: asl '(:query ...) (:read ...)'   [Implicit parallel batch execution]\\\\n\\\"\\n       \\\"   or: asl <command> [args...]          [First-class toolchain subcommands]\\\\n\\\"\\n       \\\"   or: asl rpc '(:batch ...)'           [Explicit batch RPC evaluation]\\\\n\\\"\\n       \\\"   or: asl check <file>                 [Semantic check module]\\\\n\\\"\\n       \\\"   or: asl build <file>                 [Compile module to C99]\\\\n\\\"\\n       \\\"   or: asl run <file>                   [Execute main function of module]\\\\n\\\"\\n       \\\"   or: asl test <file>                  [Run module test assertions]\\\\n\\\"\\n       \\\"   or: asl migrate [--dry-run|--check] <file> [Syntax migration utility]\\\\n\\\"\\n       \\\"   or: asl '(:tools)'                   [Introspect self-describing tool catalog]\\\\n\\\"\\n       \\\"   or: asl '(:where)'                   [Situational guidance & active invariants]\\\\n\\\\n\\\"\\n       \\\"First-Class Unified Ecosystem Capabilities:\\\\n\\\"\\n       \\\"  lens [cmd|opt]     Sovereign multi-lens discovery & multi-agent Popperian audit\\\\n\\\"\\n       \\\"  consilium [cmd]    Multi-LLM Frontier Council (Astra, DeepSeek, GLM >=75% consensus)\\\\n\\\"\\n       \\\"  mesh [cmd]         24/7 Autonomous agent mesh daemon & shard intent sweeps\\\\n\\\"\\n       \\\"  relay, rla [cmd]   Sovereign proxy relay & multi-model orchestration gateway\\\\n\\\"\\n       \\\"  gateway [cmd]      Universal L7 cognitive gateway & hallucination interception proxy\\\\n\\\\n\\\"\\n       \\\"Agent Operations (Pure S-Expressions):\\\\n\\\"\\n       \\\"  (:tools)                                Introspect authoritative runtime tool registry\\\\n\\\"\\n       \\\"  (:manage :action <a> ...)               Resident daemon process supervision & logs\\\\n\\\"\\n       \\\"  (:lens :file <f> [:lenses (<l> ...)])   Sovereign multi-lens analytical verification\\\\n\\\"\\n       \\\"  (:query <text> [:scope <s>] [:limit <n>]) Bounded AST & symbol semantic search\\\\n\\\"\\n       \\\"  (:read :file <f> [:symbol <s>] [:anchor <a>] [:limit <n>]) Bounded AST slice retrieval\\\\n\\\"\\n       \\\"  (:edit :file <f> :old <target> :new <replacement>) Virtual RAM buffer staging\\\\n\\\"\\n       \\\"  (:diff [:file <f>])                     Inspect staged RAM diffs before flush\\\\n\\\"\\n       \\\"  (:flush)                                Atomically persist staged edits to disk\\\\n\\\"\\n       \\\"  (:discard)                              Clear pending RAM modifications\\\\n\\\"\\n       \\\"  (:check [:file <f>])                    Verify Dyck-1 delimiter balance & syntax\\\\n\\\"\\n       \\\"  (:test [:file <f>])                     Execute assertions under verification\\\\n\\\"\\n       \\\"  (:doctor)                               Audit measured capabilities & invariants\\\\n\\\"\\n       \\\"  (:note <subcmd> ...)                    Working memory recorder and query surface\\\\n\\\\n\\\"\\n       \\\"Use 'asl help --full' for host environment administration.\\\\n\\\")\\n\\nfn formatDiagnostic d: ty/Diagnostic -> Str\\n  (str (.-path d) \\\":\\\" (stringFromInt64 (.-line d)) \\\":\\\" (stringFromInt64 (.-col d)) \\\": \\\" (.-code d) \\\" \\\" (.-message d))\\n\\nfn formatDiagnostics diags: (List ty/Diagnostic) -> Str\\n  (stringJoin (map (fn [(d ty/Diagnostic)] -> Str (formatDiagnostic d)) diags) \\\"\\\\n\\\")\\n\\nfn shellQuote s: Str -> Str\\n  (str \\\"'\\\" (stringReplace s \\\"'\\\" \\\"'\\\\\\\\''\\\") \\\"'\\\")\\n\\nfn checkGateSrc! files: (List Str) count: I64 path: Str srcRes: (Result Str IoError) -> (Result Str Str)\\n  (mt srcRes ((err _) (err (str \\\"Failed to read gate target file: \\\" path))) ((ok src) (mt (a/parse src) ((err pe) (if (stringContains? (.-msg pe) \\\"not kebab-case\\\") (checkGateFilesStep! (optionOr (listTail files) (list)) (+ count 1)) (err (str path \\\":\\\" (stringFromInt64 (.-line pe)) \\\":\\\" (stringFromInt64 (.-col pe)) \\\": [parse-error] \\\" (.-msg pe))))) ((ok _) (checkGateFilesStep! (optionOr (listTail files) (list)) (+ count 1))))))\\n\\nfn checkGateFilesStep! files: (List Str) count: I64 -> (Result Str Str)\\n  (mt (listHead files) ((none) (ok (str \\\"✓ [Pure ASL Gate] \\\" (stringFromInt64 count) \\\" file(s) verified cleanly.\\\"))) ((some path) (checkGateSrc! files count path (fileRead path))))\\n\\nfn ! checkGateFiles files: (List Str) -> (Result Str Str)\\n  (if (listEmpty? files) (err \\\"Usage: asl gate <file1.asl> [file2.asl ...]\\\") (checkGateFilesStep! files 0))\\n\\nfn ! dispatchRpc args: (List Str) -> (Result Str Str)\\n  (if (listEmpty? args) (err \\\"Usage: asl rpc '(:batch ...)'\\\") (let [(payload (stringJoin args \\\" \\\"))] (b/evalBatch! payload)))\\n\\nfn ! cmdSysDelegate targetBin: Str args: (List Str) -> (Result Str Str)\\n  (let [(quotedArgs (map (fn [(a Str)] -> Str (shellQuote a)) args))\\n        (cmdStr (str targetBin (if (listEmpty? quotedArgs) \\\"\\\" (str \\\" \\\" (stringJoin quotedArgs \\\" \\\")))))\\n        (res (processRun cmdStr))]\\n    (if (= (.-exitCode res) 0)\\n      (ok (.-stdout res))\\n      (err (if (stringEmpty? (.-stderr res)) (.-stdout res) (.-stderr res)))))\\n\\nfn ! dispatchCmd cmd: Str args: (List Str) -> (Result Str Str)\\n  (cond ((= cmd \\\"rpc\\\") (dispatchRpc args))\\n        ((or (stringStartsWith? cmd \\\"(\\\") (stringStartsWith? cmd \\\":batch\\\")) (dispatchRpc (cons cmd args)))\\n        ((or (= cmd \\\"version\\\") (or (= cmd \\\"-v\\\") (= cmd \\\"--version\\\"))) (ok (formatVersion)))\\n        ((or (= cmd \\\"help\\\") (or (= cmd \\\"-h\\\") (= cmd \\\"--help\\\"))) (ok (formatHelp)))\\n        ((= cmd \\\"lens\\\") (lensCmd/runLensCommand args))\\n        ((= cmd \\\"consilium\\\") (consiliumCmd/runConsiliumCommand args))\\n        ((= cmd \\\"mesh\\\") (cmdSysDelegate \\\"bin/asl mesh\\\" args))\\n        ((or (= cmd \\\"relay\\\") (= cmd \\\"rla\\\")) (cmdSysDelegate \\\"bin/asl-gateway\\\" args))\\n        ((= cmd \\\"gateway\\\") (cmdSysDelegate \\\"bin/asl-gateway\\\" args))\\n        ((= cmd \\\"full\\\") (if (listEmpty? args) (ok (formatHelp)) (dispatchCmd (optionOr (listHead args) \\\"help\\\") (optionOr (listTail args) (list)))))\\n        ((= cmd \\\"gate\\\") (checkGateFiles args))\\n        ((= cmd \\\"check\\\") (cmdCheck args))\\n        ((= cmd \\\"migrate\\\") (mig/runMigrate args))\\n        ((= cmd \\\"build\\\") (cmdBuild args))\\n        ((= cmd \\\"eval\\\") (cmdEval args))\\n        ((= cmd \\\"run\\\") (cmdRun args))\\n        ((= cmd \\\"test\\\") (cmdTest args))\\n        ((= cmd \\\"parse\\\") (cmdParse args))\\n        ((= cmd \\\"lint\\\") (cmdLint args))\\n        ((= cmd \\\"tool\\\") (err \\\"ERR_NOT_IMPLEMENTED\\\"))\\n        ((= cmd \\\"launch\\\") (err \\\"ERR_NOT_IMPLEMENTED\\\"))\\n        ((= cmd \\\"chk\\\") (err \\\"ERR_NOT_IMPLEMENTED\\\"))\\n        ((= cmd \\\"where\\\") (err \\\"ERR_NOT_IMPLEMENTED\\\"))\\n        ((= cmd \\\"conform\\\") (err \\\"ERR_NOT_IMPLEMENTED\\\"))\\n        ((= cmd \\\"ir\\\") (err \\\"ERR_NOT_IMPLEMENTED\\\"))\\n        ((= cmd \\\"impact\\\") (impactCli/runImpactCommand! args))\\n        ((= cmd \\\"audit\\\") (auditCli/runAuditCommand args))\\n        ((= cmd \\\"patch\\\") (patchCli/runPatchCommand! args))\\n        ((= cmd \\\"watch\\\") (watchCli/runWatchCommand! args))\\n        ((= cmd \\\"heal\\\") (healCli/runHealCommand! args))\\n        ((= cmd \\\"outline\\\") (digestCli/runOutlineCommand! args))\\n        (else (err (str \\\"Unknown command '\\\" cmd \\\"'. Run 'asl help' for usage.\\\"))))\\n\\nfn ! cmdCheck args: (List Str) -> (Result Str Str)\\n  (checkCli/runCheckCommand! args)\\n\\nfn ! cmdBuild args: (List Str) -> (Result Str Str)\\n  (if (listEmpty? args) (err \\\"Usage: asl build [--target <c99|c-embedded>] <file.asl>\\\") (let [(hasTargetFlag (and (>= (listLength args) 2) (= (optionOr (listHead args) \\\"\\\") \\\"--target\\\"))) (target (if hasTargetFlag (optionOr (listGet args 1) \\\"c99\\\") \\\"c99\\\")) (restArgs (if hasTargetFlag (optionOr (listTail (optionOr (listTail args) (list))) (list)) args)) (path (optionOr (listHead restArgs) \\\"\\\"))] (cond ((stringEmpty? path) (err \\\"Usage: asl build [--target <c99|c-embedded>] <file.asl>\\\")) ((and (!= target \\\"c99\\\") (!= target \\\"c-embedded\\\")) (err (str \\\"Target '\\\" target \\\"' is not built into the self-hosting core; it lives in asl-compiler/targets\\\"))) (else (let [(srcRes (fileRead path))] (mt srcRes ((err ioErr) (err (str \\\"Failed to read source file: \\\" path))) ((ok src) (let [(cres (comp/compileSourceToC99 src path (= target \\\"c-embedded\\\")))] (if (.-ok cres) (ok (.-code cres)) (err (str \\\"Build failed: \\\" (stringJoin (.-diagnostics cres) \\\"\\\\n\\\"))))))))))))\\n\\nfn findRepoRootLoop! dir: Str candidate: (Option Str) -> (Result Str Str)\\n  (let [(cfgPath (if (= dir \\\"/\\\") \\\"/.asl.config.asn\\\" (str dir \\\"/.asl.config.asn\\\")))\\n        (hasCfg (ok? (fileStat cfgPath)))\\n        (newCand (if hasCfg (some dir) candidate))\\n        (parentRes (realPath (str dir \\\"/..\\\")))]\\n    (mt parentRes\\n      ((err _)\\n       (mt newCand\\n         ((some root) (ok root))\\n         ((none) (err \\\"Failed to resolve parent directory while searching for .asl.config.asn\\\"))))\\n      ((ok parent)\\n       (if (or (stringEmpty? parent) (= parent dir))\\n         (mt newCand\\n           ((some root) (ok root))\\n           ((none) (err \\\"Could not find .asl.config.asn in current or parent directories\\\")))\\n         (findRepoRootLoop! parent newCand)))))\\n\\nfn findRepoRoot! dir: Str -> (Result Str Str)\\n  (findRepoRootLoop! dir (none))\\n\\nfn resolveHostBinary! -> (Result Str Str)\\n  (let [(envRes (processRun \\\"printf %s \\\\\\\"$ASL_HOST\\\\\\\"\\\"))\\n        (envHost (if (= (.-exitCode envRes) 0) (stringTrim (.-stdout envRes)) \\\"\\\"))]\\n    (if (not (stringEmpty? envHost))\\n      (mt (fileStat envHost)\\n        ((ok _) (ok envHost))\\n        ((err _) (err (str \\\"ASL_HOST binary not found: \\\" envHost))))\\n      (let [(curDirRes (realPath \\\".\\\"))]\\n        (mt curDirRes\\n          ((err _) (err \\\"Failed to get current working directory\\\"))\\n          ((ok curDir)\\n           (mt (findRepoRoot! curDir)\\n             ((err e) (err (str \\\"Could not resolve ASL host: \\\" e)))\\n             ((ok repoRoot)\\n              (let [(binPath (if (= repoRoot \\\"/\\\") \\\"/asl/host/out/asl-host\\\" (str repoRoot \\\"/asl/host/out/asl-host\\\")))]\\n                (mt (fileStat binPath)\\n                  ((ok _) (ok binPath))\\n                  ((err _) (err (str \\\"ASL host binary not found at \\\" binPath \\\". Run 'bash asl/host/build.sh' to build it.\\\"))))))))))))\\n\\nfn ! cmdEval args: (List Str) -> (Result Str Str)\\n  (if (listEmpty? args)\\n    (err \\\"Usage: asl eval <expr>\\\")\\n    (let [(hostRes (resolveHostBinary!))]\\n      (mt hostRes\\n        ((err e) (err e))\\n        ((ok hostBin)\\n         (let [(exprStr (stringJoin args \\\" \\\"))\\n               (evalCmd (str (shellQuote hostBin) \\\" eval \\\" (shellQuote exprStr)))\\n               (procRes (processRun evalCmd))]\\n           (if (= (.-exitCode procRes) 0)\\n             (ok (stringTrim (.-stdout procRes)))\\n             (err (stringTrim (if (stringEmpty? (.-stderr procRes)) (.-stdout procRes) (.-stderr procRes))))))))))\\n\\nfn ! cmdRun args: (List Str) -> (Result Str Str)\\n  (if (listEmpty? args)\\n    (err \\\"Usage: asl run <file.asl>\\\")\\n    (let [(hostRes (resolveHostBinary!))]\\n      (mt hostRes\\n        ((err e) (err e))\\n        ((ok hostBin)\\n         (let [(path (optionOr (listHead args) \\\"\\\"))\\n               (srcRes (fileRead path))]\\n           (mt srcRes\\n             ((err ioErr) (err (str \\\"Failed to read source file: \\\" path)))\\n             ((ok src)\\n              (mt (a/parse src)\\n                ((err pe) (err (str path \\\":\\\" (stringFromInt64 (.-line pe)) \\\":\\\" (stringFromInt64 (.-col pe)) \\\": [parse-error] \\\" (.-msg pe))))\\n                ((ok forms)\\n                 (let [(diags (chk/checkModule forms (mapEmpty) path))]\\n                   (if (not (listEmpty? diags))\\n                     (err (formatDiagnostics diags))\\n                     (let [(quotedArgs (map (fn [(a Str)] -> Str (shellQuote a)) args))\\n                           (runCmd (str (shellQuote hostBin) \\\" run \\\" (stringJoin quotedArgs \\\" \\\")))\\n                           (procRes (processRun runCmd))]\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"mem/tests/taskModularTest.asl\")" :want "(:read :file \"mem/tests/taskModularTest.asl\" :content \"(module aslMem/tests/taskModularTest :d \\\"Unit verification suite for task/* and proc/* 1-to-2 token modular aliases per d46 and d47.\\\" :x [runTests testTaskClaimAndState testTaskSettle testProcStatus testProcList] :i [(tasks :a task) (asl-proc/process :a proc) (asl-proc/apm :a apm)])\\n\\nfn testTaskClaimAndState -> Bool\\n  (let [(t0 (task/makeTask \\\"t1\\\" \\\"p1\\\" \\\"Test Task\\\" \\\"main\\\" \\\"planned\\\" \\\"normal\\\" 1000 (list \\\"src/a.asl\\\") (list) \\\"asl check\\\" \\\"why1\\\")) (initialState (task/state t0)) (t1 (task/claim t0 2000)) (claimedState (task/state t1))] (assert (= initialState \\\"planned\\\") \\\"Initial task state must be planned\\\") (assert (= claimedState \\\"claimed\\\") \\\"task/claim must transition task state to claimed\\\") (assert (= (.-updatedAt t1) 2000) \\\"Claimed task updated-at must reflect claim epoch\\\") (assert (= (.-id t1) \\\"t1\\\") \\\"Task id must be preserved across claim\\\") true)\\n\\nfn testTaskSettle -> Bool\\n  (let [(t0 (task/makeTask \\\"t2\\\" \\\"p1\\\" \\\"Task Settle\\\" \\\"main\\\" \\\"planned\\\" \\\"normal\\\" 1000 (list \\\"src/b.asl\\\") (list) \\\"asl test\\\" \\\"why2\\\")) (t1 (task/claim t0 2000)) (receipt \\\"(:receipt :exit-code 0 :asserts 10)\\\") (t2 (task/settle t1 receipt 3000)) (settledState (task/state t2))] (assert (= settledState \\\"completed\\\") \\\"task/settle must transition task to completed state\\\") (assert (= (.-completedAt t2) 3000) \\\"task/settle completed-at must match completion epoch\\\") (assert (= (listLength (.-receipts t2)) 1) \\\"Settled task must have exactly 1 attached receipt\\\") (assert (= (optionOr (listGet (.-receipts t2) 0) \\\"\\\") receipt) \\\"Attached receipt must match settled payload\\\") true)\\n\\nfn testProcStatus -> Bool\\n  (let [(vOk (proc/status 50 1000 \\\"build-step\\\")) (vTimeout (proc/status 15000 10000 \\\"hanging-step\\\"))] (assert (= (.-status vOk) \\\":ok\\\") \\\"Step within deadline must have :ok status\\\") (assert (= (.-exitCode vOk) 0) \\\"Step within deadline must have exit-code 0\\\") (assert (not (.-workerRecycled vOk)) \\\"Step within deadline must not recycle worker\\\") (assert (= (.-status vTimeout) \\\":recycled\\\") \\\"Exceeded deadline must have :recycled status\\\") (assert (= (.-exitCode vTimeout) 124) \\\"Exceeded deadline must emit exit code 124\\\") (assert (.-workerRecycled vTimeout) \\\"Exceeded deadline must flag worker as recycled\\\") true)\\n\\nfn testProcList -> Bool\\n  (let [(e1 (apm/makeDaemonEntry \\\"d-abc12\\\" 4510 128 \\\":active\\\" \\\"step-eval\\\")) (emptyTbl (proc/list (list))) (popTbl (proc/list (list e1)))] (assert (stringContains? emptyTbl \\\"DAEMON ID\\\") \\\"Empty process list table must render header\\\") (assert (stringContains? popTbl \\\"DAEMON ID\\\") \\\"Populated table must contain header\\\") (assert (stringContains? popTbl \\\"d-abc12\\\") \\\"Populated table must contain daemon identifier\\\") (assert (stringContains? popTbl \\\"4510\\\") \\\"Populated table must contain pid\\\") (assert (stringContains? popTbl \\\":active\\\") \\\"Populated table must contain daemon status\\\") true)\\n\\nfn runTests -> Bool\\n  (and (testTaskClaimAndState) (and (testTaskSettle) (and (testProcStatus) (testProcList))))\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"asl/packages/asl-pack/manifest.asn\")" :want "(:read :file \"asl/packages/asl-pack/manifest.asn\" :content \"(:package asl-pack\\n :version \\\"0.1.0\\\"\\n :entry \\\"src/pack.asl\\\"\\n :description \\\"Universal cross-platform packager and runtime runner for AgentSlang\\\"\\n :aslFirst true\\n :modules [\\n   \\\"asl-pack/build-graph\\\"\\n   \\\"asl-pack/package-asl\\\"\\n   \\\"asl-pack/target-adapter\\\"\\n   \\\"asl-pack/packaging\\\"\\n   \\\"asl-pack/distribution-profiles\\\"\\n   \\\"asl-pack/dist\\\"\\n   \\\"asl-pack/ffi-linker\\\"\\n   \\\"asl-pack/installer\\\"\\n   \\\"asl-pack/pack\\\"\\n   \\\"asl-pack/platform\\\"\\n   \\\"asl-pack/release\\\"\\n   \\\"asl-pack/runtime\\\"\\n   \\\"asl-pack/standalone\\\"\\n   \\\"asl-pack/targets/kotlin\\\"\\n   \\\"asl-pack/targets/preview\\\"\\n   \\\"asl-pack/targets/preview-server\\\"\\n   \\\"asl-pack/targets/swift\\\"\\n   \\\"asl-pack/intermediate-policy\\\"\\n ]\\n :dependencies [\\\"asl-transpile\\\" \\\"asl-proc\\\"])\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \".asl/mem/inbox/workspace-20260924-scalarF64Helpers.asn\")" :want "(:read :file \".asl/mem/inbox/workspace-20260924-scalarF64Helpers.asn\" :content \"(:todo :from \\\"/Users/purplelephant/projects/workspace\\\" :date \\\"2026-09-24\\\" :kind feature :component asl\\n  :what \\\"the prelude has abs, min, max, floor, ceil and round but no clamp, sign, copysign, lerp, fma, hypot, trunc, round-half-even, round-to-step (quantise to a grid) or next-power-of-two, so vtbot redefines clamp, abs and sign per module and every grid snap silently replaces tiny steps with 0.01\\\"\\n  :evidence \\\"duplicates in vtbot/asl: clampF in dynamicTimeSeriesParameterEngine.asl, onlineGradientAdaptiveEngine.asl, segmentAdaptabilityBoundEngine.asl; clampParam in stochasticHillClimber.asl; absF in dynamicLivePaperEngine.asl and dynamicTimeSeriesParameterEngine.asl; absVal in microstructureToxicityAndPeaks.asl; sgnVal, minVal, maxVal in advancedSignalProcessingKernels.asl; fastSqrt (a guarded sqrt wrapper) in 7 modules (see workspace-20260924-floatEdgeSemantics); nextPowerOfTwo in spscRingBuffer.asl (62-step fold). Grid quantisation: vtbot/asl/numericKernels.asl clampToGrid, used by flatOrderbookLadder.asl clampToTickGrid, and asex asl/packages/asl-runtime/src/math.asl clampToGrid both substitute step 0.01 whenever step <= 1e-8, so a 1e-9 tick grid silently snaps to cents: asl eval '(let [(step 1.0e-9) (safeStep (if (<= step 0.00000001) 0.01 step))] (* (floor (+ (/ 1.23e-7 safeStep) 0.5)) safeStep))' (the numericKernels body) => 0, exit 0, where 1.23e-7 is expected. asl eval '(clamp 5.0 0.0 1.0)' => (clamp 5 0 1), '(sign -2.0)', '(copysign 1.0 -2.0)', '(fma 1.0 2.0 3.0)', '(hypot 3.0 4.0)', '(lerp 0.0 1.0 0.5)', '(round-to-step 0.3 0.1)', '(next-power-of-two 5)' all unevaluated, exit 0; asl-host: ERR_UNKNOWN_SYMBOL clamp and round-to-step (and ERR_UNKNOWN_SYMBOL sqrt, already in workspace-20260924-hostPreludeDivergence)\\\"\\n  :repro \\\"asl eval '(clamp 5.0 0.0 1.0)'; asl-host test module calling (clamp 5.0 0.0 1.0) => ERR_UNKNOWN_SYMBOL clamp, exit 1\\\"\\n  :want \\\"core ASL scalar builtins on asl-core and the host: clamp x lo hi (lo > hi is err; NaN x gives NaN; works for Int and F64), sign x (-1, 0, +1 as the input type; sign of NaN is NaN), copysign x y, lerp a b t (a + t (b - a), exact at t = 0 and 1), fma x y z (single rounding, C fma), hypot x y (no intermediate overflow), trunc x, round-half-even x (round already exists; document whether it is half-away-from-zero), round-to-step x step origin = origin + k * step with k = round-half-even((x - origin) / step) held as an exact integer (the grid point is always the float64 product k * step, so results are reproducible; step <= 0, NaN or inf is err, never a substitute value; |k| > 2^53 is err), floor-to-step and ceil-to-step, next-power-of-two n (Int; n <= 1 gives 1; n > 2^62 is err). Fix or remove the 0.01 fallback in asl-runtime/math clampToGrid. Acceptance: clamp 5.0 0.0 1.0 = 1.0, clamp with lo > hi is err; sign -0.0 = 0 and sign -2.0 = -1.0; fma 0.1 10.0 -1.0 equals C fma (5.551115123125783e-17); hypot 1e300 1e300 = 1.4142135623730952e300; round-to-step 1.23e-7 1.0e-9 0.0 = 1.23e-7 (Python round(1.23e-7 / 1e-9) * 1e-9), round-to-step 0.29 0.1 0.0 = 3 * 0.1 = 0.30000000000000004; next-power-of-two 1000 = 1024 and 1024 = 1024\\\")\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"bin/asl\")" :want "(:read :file \"bin/asl\" :content \"#!/usr/bin/env bash\\n# bin/asl: finds the workspace and a stage-0 host, then execs the ASL dispatcher asl/packages/asl-cli/src/command.asl.\\nset -eo pipefail\\n\\nPRG=\\\"${BASH_SOURCE[0]}\\\"\\nwhile [ -h \\\"$PRG\\\" ]; do\\n  ls=$(ls -ld \\\"$PRG\\\")\\n  link=$(expr \\\"$ls\\\" : '.*-> \\\\(.*\\\\)$')\\n  if expr \\\"$link\\\" : '/.*' > /dev/null; then\\n    PRG=\\\"$link\\\"\\n  else\\n    PRG=\\\"$(dirname \\\"$PRG\\\")/$link\\\"\\n  fi\\ndone\\nSCRIPT_DIR=\\\"$(cd \\\"$(dirname \\\"$PRG\\\")\\\" && pwd)\\\"\\nROOT_DIR=\\\"$(cd \\\"${SCRIPT_DIR}/..\\\" 2>/dev/null && pwd)\\\"\\n# ASL_HOST: absolute path of a built stage-0 host, for a checkout without asl/host/out (a fresh clone)\\nHOST_BIN=\\\"${ASL_HOST:-${ROOT_DIR}/asl/host/out/asl-host}\\\"\\nRUNNER=\\\"$HOST_BIN\\\"\\n[ -x \\\"$RUNNER\\\" ] || RUNNER=\\\"${ROOT_DIR}/asl/host/out/asl-host\\\"\\n[ -x \\\"$RUNNER\\\" ] || RUNNER=\\\"$(command -v asl-host 2>/dev/null || true)\\\"\\nif [ -z \\\"$RUNNER\\\" ] || [ ! -x \\\"$RUNNER\\\" ]; then\\n  echo \\\"(:asl :status :failed :error ERR_HOST_ABSENT :message \\\\\\\"asl runs on the stage-0 host at asl/host/out/asl-host; build it with sh asl/host/build.sh or set ASL_HOST\\\\\\\")\\\"\\n  exit 2\\nfi\\nunset ASL_CLI_HOST_UNSET\\n[ -n \\\"${ASL_HOST+set}\\\" ] || export ASL_CLI_HOST_UNSET=1\\nexport ASL_CLI_ROOT=\\\"$ROOT_DIR\\\" ASL_CLI_SCRIPT_DIR=\\\"$SCRIPT_DIR\\\" ASL_CLI_ARGV0=\\\"$0\\\" ASL_CLI_HOST_BIN=\\\"$HOST_BIN\\\"\\nexec \\\"$RUNNER\\\" run \\\"${ROOT_DIR}/asl/packages/asl-cli/src/command.asl\\\" \\\"$@\\\"\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tests/acceptance/agentLoop/capBudgetTest.sh\")" :want "(:read :file \"tests/acceptance/agentLoop/capBudgetTest.sh\" :content \"#!/usr/bin/env bash\\n# tests/acceptance/agentLoop/capBudgetTest.sh\\n\\nSCRIPT_DIR=\\\"$(cd \\\"$(dirname \\\"${BASH_SOURCE[0]}\\\")\\\" && pwd)\\\"\\n\\nif [ \\\"${ASL_SANDBOX_ACTIVE:-0}\\\" != \\\"1\\\" ]; then\\n    SANDBOX_SCRIPT=\\\"${SCRIPT_DIR}/sandbox.sh\\\"\\n    if [ -f \\\"$SANDBOX_SCRIPT\\\" ]; then\\n        exec sh \\\"$SANDBOX_SCRIPT\\\" \\\"$0\\\" \\\"$@\\\"\\n    fi\\nfi\\n\\npython3 - \\\"$@\\\" << 'PY_EOF'\\nimport os, sys, tempfile, shutil\\n\\nROOT = os.getcwd()\\nsys.path.insert(0, os.path.join(ROOT, \\\"scripts\\\", \\\"agentLoop\\\"))\\nimport loop\\nfrom loop import run_loop\\nloop.VENDOR_BACKOFF_SEC = ()\\ntry:\\n    from backend import ProviderError\\nexcept ImportError:\\n    class ProviderError(Exception):\\n        def __init__(self, code, message=\\\"\\\"):\\n            super().__init__(message); self.code = code\\n\\ntotal_asserts = 0\\nfailed_asserts = 0\\n\\ndef assert_item(name, passed, detail=\\\"\\\"):\\n    global total_asserts, failed_asserts\\n    total_asserts += 1\\n    if passed:\\n        print(f\\\"ok {name}\\\")\\n    else:\\n        failed_asserts += 1\\n        print(f\\\"FAIL {name}: {str(detail)[:300]}\\\")\\n\\nclass Script:\\n    def __init__(self, replies):\\n        self.replies = list(replies)\\n        self.sent = []\\n        self.last_timing = None\\n    def next_turn(self, system_prompt, user_message):\\n        self.sent.append(user_message)\\n        r = self.replies.pop(0) if self.replies else '(:escalate :reason \\\"script exhausted\\\")'\\n        if isinstance(r, Exception):\\n            raise r\\n        return r\\n\\ntmp = tempfile.mkdtemp(prefix=\\\"asl_cap_budget_\\\")\\ntry:\\n    page = lambda a, b: f'(:step :op \\\"read\\\" :file \\\"scripts/agentLoop/loop.py\\\" :start {a} :end {b})'\\n    # paging through new ranges is progress: 6 read-only turns, then escalate by choice, not by cap\\n    p = Script([page(1, 50), page(51, 100), page(101, 150), page(151, 200), page(201, 250), page(251, 300),\\n                '(:escalate :reason \\\"done reading\\\")'])\\n    res = run_loop(p, \\\"read loop.py\\\", \\\"implement\\\", [\\\"x.txt\\\"], [\\\"true\\\"], ROOT, 20, os.path.join(tmp, \\\"a.journal\\\"), max_retries=1)\\n    j = open(os.path.join(tmp, \\\"a.journal\\\")).read()\\n    assert_item(\\\"pagingNotCapped\\\", \\\"observation cap\\\" not in j, j[-300:])\\n    assert_item(\\\"pagingReachesModelChoice\\\", len(p.sent) == 7, len(p.sent))\\n\\n    # re-reading the same range is not progress: the cap fires\\n    p = Script([page(1, 50)] * 12)\\n    res = run_loop(p, \\\"read loop.py\\\", \\\"implement\\\", [\\\"x.txt\\\"], [\\\"true\\\"], ROOT, 20, os.path.join(tmp, \\\"b.journal\\\"), max_retries=1)\\n    j = open(os.path.join(tmp, \\\"b.journal\\\")).read()\\n    assert_item(\\\"repeatCapped\\\", \\\"observation cap\\\" in j, j[-300:])\\n    assert_item(\\\"repeatEscalates\\\", res.get(\\\"status\\\") == \\\"escalated\\\", res.get(\\\"status\\\"))\\n\\n    # a vendor error spends the vendor budget, resends the same message, sends no brief\\n    p = Script([page(1, 50), ProviderError(\\\"ERR_VENDOR\\\", \\\"503\\\"), '(:escalate :reason \\\"stop\\\")'])\\n    res = run_loop(p, \\\"read loop.py\\\", \\\"implement\\\", [\\\"x.txt\\\"], [\\\"true\\\"], ROOT, 20, os.path.join(tmp, \\\"c.journal\\\"), max_retries=1)\\n    j = open(os.path.join(tmp, \\\"c.journal\\\")).read()\\n    assert_item(\\\"vendorResendsSameMessage\\\", len(p.sent) == 3 and p.sent[1] == p.sent[2], [m[-120:] for m in p.sent])\\n    assert_item(\\\"vendorNoRetryBrief\\\", \\\"Retry 1\\\" not in p.sent[-1], p.sent[-1][-200:])\\n    assert_item(\\\"vendorJournalled\\\", \\\":vendorRetry 1\\\" in j, j[-300:])\\n    assert_item(\\\"vendorTranscriptNotDuplicated\\\", p.sent[-1].count(\\\"(:turn 1 \\\") == 1, p.sent[-1][-300:])\\n\\n    # vendor errors do not eat the model's retries: max_retries=1 still survives two vendor errors\\n    p = Script([ProviderError(\\\"ERR_VENDOR\\\", \\\"503\\\"), '(:step :op \\\"tree\\\" :path \\\"scripts\\\")', ProviderError(\\\"ERR_VENDOR\\\", \\\"503\\\"), '(:escalate :reason \\\"stop\\\")'])\\n    res = run_loop(p, \\\"t\\\", \\\"implement\\\", [\\\"x.txt\\\"], [\\\"true\\\"], ROOT, 20, os.path.join(tmp, \\\"d.journal\\\"), max_retries=1)\\n    assert_item(\\\"vendorBudgetSeparate\\\", res.get(\\\"status\\\") != \\\"failed\\\", res)\\n    # vendor-reported token usage is journalled per turn and summed in the result\\n    class Usage(Script):\\n        def next_turn(self, system_prompt, user_message):\\n            self.last_usage = {\\\"inputTokens\\\": 100, \\\"cachedTokens\\\": 40, \\\"outputTokens\\\": 7}\\n            return Script.next_turn(self, system_prompt, user_message)\\n    p = Usage([page(1, 50), '(:escalate :reason \\\"stop\\\")'])\\n    res = run_loop(p, \\\"t\\\", \\\"implement\\\", [\\\"x.txt\\\"], [\\\"true\\\"], ROOT, 20, os.path.join(tmp, \\\"e.journal\\\"), max_retries=1)\\n    j = open(os.path.join(tmp, \\\"e.journal\\\")).read()\\n    assert_item(\\\"usageJournalledPerTurn\\\", j.count(\\\":usage (:input 100 :cached 40 :output 7)\\\") == 2, j[-400:])\\n    assert_item(\\\"usageSummed\\\", res.get(\\\"usage\\\") == {\\\"inputTokens\\\": 200, \\\"cachedTokens\\\": 80, \\\"outputTokens\\\": 14}, res.get(\\\"usage\\\"))\\nfinally:\\n    shutil.rmtree(tmp, ignore_errors=True)\\n\\nprint(f'(:gate :name \\\"capBudgetTest\\\" :asserts {total_asserts} :failed {failed_asserts})')\\nsys.exit(0 if failed_asserts == 0 and total_asserts > 0 else 1)\\nPY_EOF\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tests/agentEval/scoreTest.sh\")" :want "(:read :status :rejected :error ERR_FILE_NOT_FOUND :message \"File not found: tests/agentEval/scoreTest.sh\" :hint \"paths resolve against the workspace root; :nearest, when present, names entries beside the missing one\" :see \"(:help :op read)\")\n" :exit 1)
(:case :src leon :form "(:read :file \"tests/acceptance/observe/tokenCostTest.sh\")" :want "(:read :file \"tests/acceptance/observe/tokenCostTest.sh\" :content \"#!/bin/bash\\n# OBS1 (:observe :dim tokenCost) via bin/asl on a temp clone (ASL_ROOT) and a non-asl git repo; no network.\\n# Claims: a tracked .asl file of N o200k tokens (tiktoken oracle) adds exactly N tokens and one file, an untracked one\\n# adds nothing, receipts stay under 4096 bytes at :limit 100 and with long paths, a deleted tracked file is :missing,\\n# an unknown dim gives ERR_UNKNOWN_DIM with :nearest, and a non-asl repo is counted with the checkout's tokenizer.\\nset -u\\nROOT=\\\"$(cd \\\"$(dirname \\\"$0\\\")/../../..\\\" && pwd)\\\"\\nTMP=\\\"$(mktemp -d \\\"${TMPDIR:-/tmp}/obsTokenCost.XXXXXX\\\")\\\"\\ntrap 'rm -rf \\\"$TMP\\\"' EXIT\\nif ! git clone -q --shared \\\"$ROOT\\\" \\\"$TMP/repo\\\" || ! git init -q \\\"$TMP/foreign\\\"; then\\n    echo \\\"clone failed\\\" >&2\\n    echo '(:gate :name \\\"observeTokenCost\\\" :asserts 0 :failed 1)'\\n    exit 1\\nfi\\nROOT=\\\"$ROOT\\\" CLONE=\\\"$TMP/repo\\\" FOREIGN=\\\"$TMP/foreign\\\" python3 - <<'PY_EOF'\\nimport os, re, subprocess, sys\\nroot, clone, foreign = os.environ[\\\"ROOT\\\"], os.environ[\\\"CLONE\\\"], os.environ[\\\"FOREIGN\\\"]\\nsys.path.insert(0, os.path.join(root, \\\"scripts\\\"))\\nasserts = failed = 0\\n\\ndef ok(cond, label):\\n    global asserts, failed\\n    asserts += 1\\n    if not cond:\\n        failed += 1\\n        print(\\\"FAIL: \\\" + label, file=sys.stderr)\\n\\ndef observe(form, ws=clone):\\n    env = {k: v for k, v in os.environ.items() if not k.startswith(\\\"ASL_CLI_\\\")}\\n    p = subprocess.run([os.path.join(root, \\\"bin\\\", \\\"asl\\\"), form], cwd=ws, capture_output=True, text=True,\\n                       env=dict(env, ASL_ROOT=ws, ASL_HOST=os.path.join(root, \\\"asl\\\", \\\"host\\\", \\\"out\\\", \\\"asl-host\\\")), stdin=subprocess.DEVNULL, timeout=300)\\n    return p.returncode, p.stdout.strip()\\n\\ndef asl_kind(out):\\n    m = re.search(r\\\"\\\\(:kind asl :files (\\\\d+) :tok (\\\\d+)\\\", out)\\n    return (int(m.group(1)), int(m.group(2))) if m else None\\n\\nprobe_dir = os.path.join(clone, \\\"tokenCostProbe\\\")\\nos.makedirs(probe_dir)\\nfor name, body in ((\\\"base.asl\\\", \\\"(module base :x [base])\\\\n\\\"), (\\\"base.py\\\", \\\"def base(): return 1\\\\n\\\"), (\\\"readme.md\\\", \\\"token cost probe\\\\n\\\")):\\n    with open(os.path.join(probe_dir, name), \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n        fh.write(body)\\nsubprocess.run([\\\"git\\\", \\\"add\\\", \\\"tokenCostProbe\\\"], cwd=clone, check=True)\\n# Long paths make the untruncated top exceed the byte cap while the receipt header still fits.\\nlong_dir = os.path.join(probe_dir, \\\"long\\\")\\nos.makedirs(long_dir)\\nfor i in range(64):\\n    name = (\\\"entry%02d_\\\" % i) + (\\\"x\\\" * 68) + \\\".txt\\\"\\n    with open(os.path.join(long_dir, name), \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n        fh.write(\\\"one token\\\\n\\\")\\nsubprocess.run([\\\"git\\\", \\\"add\\\", \\\"tokenCostProbe/long\\\"], cwd=clone, check=True)\\nscope = \\\"tokenCostProbe\\\"\\nform = \\\"(:observe :dim tokenCost :scope tokenCostProbe)\\\"\\nrc0, base = observe(form)\\nok(rc0 == 0 and base.startswith(\\\"(:observe :dim tokenCost :v 1 :method o200kBase\\\"), \\\"baseline receipt: rc=%d %s\\\" % (rc0, base[:200]))\\nb = asl_kind(base)\\nok(b is not None, \\\"baseline carries (:kind asl ...)\\\")\\n\\nprobe = os.path.join(probe_dir, \\\"obsProbe.asl\\\")\\nwith open(probe, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n    fh.write(\\\"(defun obsProbe ((n Int)) -> Int\\\\n  (+ n 41))\\\\n\\\")\\nimport tiktoken\\nenc = tiktoken.get_encoding(\\\"o200k_base\\\")\\nn = len(enc.encode(open(probe, encoding=\\\"utf-8\\\").read(), disallowed_special=()))\\nok(n > 0, \\\"probe has tokens\\\")\\n\\nrc1, untracked = observe(form)\\nok(b is not None and asl_kind(untracked) == b, \\\"an untracked file changes nothing: %s vs %s\\\" % (asl_kind(untracked), b))\\n\\nsubprocess.run([\\\"git\\\", \\\"add\\\", \\\"tokenCostProbe/obsProbe.asl\\\"], cwd=clone, check=True)\\nrc2, after = observe(form)\\na = asl_kind(after)\\nok(rc2 == 0 and a is not None and b is not None and a[1] - b[1] == n, \\\"asl :tok rises by exactly N=%d: %s -> %s\\\" % (n, b, a))\\nok(a is not None and b is not None and a[0] - b[0] == 1, \\\"asl :files rises by one\\\")\\n\\nrc3, big = observe(\\\"(:observe :dim tokenCost :scope tokenCostProbe :limit 100)\\\")\\nok(rc3 == 0 and big.startswith(\\\"(:observe :dim tokenCost\\\") and len(big.encode(\\\"utf-8\\\")) < 4096, \\\"receipt at :limit 100 under 4096 bytes: rc=%d %d\\\" % (rc3, len(big.encode(\\\"utf-8\\\"))))\\nrc_one, one = observe(\\\"(:observe :dim tokenCost :scope tokenCostProbe :limit 1)\\\")\\ntop_section = one.split(\\\":top (\\\", 1)[1].split(\\\") :more\\\", 1)[0] if \\\":top (\\\" in one else \\\"\\\"\\nmore = one.split(\\\":more \\\", 1)[1].split(\\\")\\\", 1)[0] if \\\":more \\\" in one else \\\"0\\\"\\nok(rc_one == 0 and top_section.count(\\\"(\\\\\\\"\\\") == 1 and int(more) > 0, \\\"limit 1 returns exactly one top item and counts the remainder: rc=%d %s\\\" % (rc_one, one[-120:]))\\nok(rc2 == 0 and len(after.encode(\\\"utf-8\\\")) < 4096, \\\"default receipt under 4096 bytes\\\")\\nrc_long, long_receipt = observe(\\\"(:observe :dim tokenCost :scope tokenCostProbe/long :limit 100)\\\")\\nlong_top = long_receipt.split(\\\":top (\\\", 1)[1].split(\\\") :more\\\", 1)[0] if \\\":top (\\\" in long_receipt else \\\"\\\"\\nlong_more = int(long_receipt.split(\\\":more \\\", 1)[1].split(\\\")\\\", 1)[0]) if \\\":more \\\" in long_receipt else 0\\nok(rc_long == 0 and len(long_receipt.encode(\\\"utf-8\\\")) < 4096 and long_top.count(\\\"(\\\\\\\"\\\") > 0 and long_more > 0, \\\"long top is truncated to fit the 4096-byte receipt cap: rc=%d bytes=%d more=%d\\\" % (rc_long, len(long_receipt.encode(\\\"utf-8\\\")), long_more))\\n\\nmissing_dir = os.path.join(probe_dir, \\\"missing\\\")\\nos.makedirs(missing_dir)\\nmissing_file = os.path.join(missing_dir, \\\"deleted.asl\\\")\\nwith open(missing_file, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n    fh.write(\\\"(module gone :x [gone])\\\\n\\\")\\nsubprocess.run([\\\"git\\\", \\\"add\\\", \\\"tokenCostProbe/missing/deleted.asl\\\"], cwd=clone, check=True)\\nos.unlink(missing_file)\\nrc_missing, missing_receipt = observe(\\\"(:observe :dim tokenCost :scope tokenCostProbe/missing)\\\")\\nok(rc_missing == 0 and \\\":missing 1\\\" in missing_receipt, \\\"a tracked but deleted file is counted as missing: rc=%d %s\\\" % (rc_missing, missing_receipt[:220]))\\n\\nforeign_asl = \\\"(module foreignProbe :x [f])\\\\nfn f n: Int64 -> Int64\\\\n  (+ n 1)\\\\n\\\"\\nwith open(os.path.join(foreign, \\\"probe.asl\\\"), \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n    fh.write(foreign_asl)\\nsubprocess.run([\\\"git\\\", \\\"add\\\", \\\"probe.asl\\\"], cwd=foreign, check=True)\\nok(not os.path.exists(os.path.join(foreign, \\\"data\\\", \\\"tokenizers\\\")), \\\"the foreign repo carries no tokenizer data\\\")\\nrc5, far = observe(\\\"(:observe :dim tokenCost)\\\", foreign)\\nn_far = len(enc.encode(foreign_asl, disallowed_special=()))\\nok(rc5 == 0 and asl_kind(far) == (1, n_far), \\\"bin/asl counts a foreign repo with the checkout tokenizer: rc=%d want (1, %d) %s\\\" % (rc5, n_far, far[:300]))\\n\\nrc4, bad = observe(\\\"(:observe :dim tokenCots)\\\")\\nok(rc4 == 1 and \\\":error ERR_UNKNOWN_DIM\\\" in bad and \\\":nearest (tokenCost\\\" in bad, \\\"unknown dim rejected: rc=%d %s\\\" % (rc4, bad[:200]))\\n\\nprint('(:gate :name \\\"observeTokenCost\\\" :asserts %d :failed %d)' % (asserts, failed))\\nsys.exit(1 if failed else 0)\\nPY_EOF\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"scripts/agentLoop/backend.py\" :anchor \"_call_agy\" :limit 100)" :want "(:read :file \"scripts/agentLoop/backend.py\" :anchor \"_call_agy\" :occurrence 1 :content \"            return self._call_agy(system_prompt, user_message)\\n        elif self.vendor == \\\"codex\\\":\\n\")\n" :exit 0)
