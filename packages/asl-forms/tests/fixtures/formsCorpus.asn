(:case :src leon :form "(:read :file \"tests/acceptance/agentLoop/truncationTest.sh\" :start 20 :end 45)" :want "(:read :file \"tests/acceptance/agentLoop/truncationTest.sh\" :start 20 :end 45 :content \"    asserts += 1\\n    if not cond:\\n        print(f\\\"FAIL: {name} - {msg}\\\")\\n        failed += 1\\n    else:\\n        print(f\\\"ok: {name}\\\")\\n\\n# 1. Unit test _read_asn_reply on stop vs length finish\\ndef make_asn_reply(content, finish=\\\"stop\\\", model=\\\"test\\\"):\\n    def asn_escape(s):\\n        return str(s).replace('\\\\\\\\', '\\\\\\\\\\\\\\\\').replace('\\\"', '\\\\\\\\\\\"').replace('\\\\n', '\\\\\\\\n').replace('\\\\r', '\\\\\\\\r').replace('\\\\t', '\\\\\\\\t')\\n    content_asn = f'\\\"{asn_escape(content)}\\\"'\\n    return f'(:reply :model \\\"{asn_escape(model)}\\\" :content {content_asn} :finish \\\"{asn_escape(finish)}\\\")'\\n\\nprovider = VendorProvider(vendor=\\\"agy\\\", mode=\\\"scout\\\", root_dir=\\\".\\\")\\nasn_stop = make_asn_reply('(:step :op \\\"query\\\" :query \\\"hi\\\")', finish=\\\"stop\\\")\\nasn_length = make_asn_reply('(:step :op \\\"query\\\" :query \\\"cut text', finish=\\\"length\\\")\\n\\nreply_stop = provider._read_asn_reply(asn_stop)\\ncheck(\\\"finishStopNotTruncated\\\", getattr(provider, \\\"last_truncated\\\", None) is False and getattr(provider, \\\"last_finish\\\", None) == \\\"stop\\\",\\n      (getattr(provider, \\\"last_truncated\\\", None), getattr(provider, \\\"last_finish\\\", None)))\\n\\nreply_length = provider._read_asn_reply(asn_length)\\ncheck(\\\"finishLengthTruncated\\\", getattr(provider, \\\"last_truncated\\\", None) is True and getattr(provider, \\\"last_finish\\\", None) == \\\"length\\\",\\n      (getattr(provider, \\\"last_truncated\\\", None), getattr(provider, \\\"last_finish\\\", None)))\\n\\n\")\n" :exit 0)
