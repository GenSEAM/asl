(:corpus :id formsParity :date "2026-09-26" :recorded "2026-10-03" :snapshot "4045414237cd7dbd7cee32ff062e7873e80239a8" :method "Leon journal reply forms (.asl/run/agentLoop/*.journal: read tree ping) sampled per kind, Claude transcript asl calls, hand edge cases" :compare "ASL stdout bytes and exit code are checked against recorded :want and :exit; a case without :root runs against the snapshot, a git archive of the parityTest snapshotPaths at :snapshot in a fresh temporary directory; a case with :root runs against that tracked fixture directory; ROOT_DIR is the case root as well; @ROOT@ is the workspace root" :wantRule "Every case records its expected stdout in :want and exit code in :exit; each was recorded from python3 scripts/aslForms.py at :snapshot under the same root, and ASL matched it byte for byte in 177 of 178 cases; the one fallback case records the ASL ERR_NOT_PORTED receipt, the only case allowed to differ from the Python oracle.")
(:case :src leon :form "(:read :file \"scripts/agentLoop/loop.py\" :start 21 :end 40)" :want "(:read :file \"scripts/agentLoop/loop.py\" :start 21 :end 40 :content \"    from backend import ProviderError\\nexcept (ImportError, AttributeError):\\n    try:\\n        from scripts.agentLoop.backend import ProviderError\\n    except (ImportError, AttributeError):\\n        class ProviderError(Exception):\\n            def __init__(self, code=\\\"ERR_VENDOR\\\", message=\\\"\\\"):\\n                super().__init__(message)\\n                self.code = code\\n\\n\\n_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\\n# (:m :effect proc :tags (core) :why \\\"the core runs in ASL, no Python fallback\\\")\\nCORE_CLI = os.path.join(_REPO_ROOT, \\\"asl\\\", \\\"agentLoop\\\", \\\"coreCli.asl\\\")\\n# (:m :tags (core) :why \\\"an explicit host is never rebuilt\\\")\\nCORE_HOST_ENV = \\\"ASL_AGENTLOOP_HOST\\\"\\n# (:m :adopted NormativeAndEmpiricalAreNotMixed :why \\\"a 1 MB transcript renders in 1.3 s\\\")\\nCORE_TIMEOUT_SEC = 120\\n# (:m :adopted NormativeAndEmpiricalAreNotMixed :why \\\"core calls are pure\\\")\\nCORE_MEMO_MAX = 512\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tests/acceptance/gateway/configV2Test.sh\" :start 275 :end 295)" :want "(:read :file \"tests/acceptance/gateway/configV2Test.sh\" :start 275 :end 295 :content \"\\n    mode[\\\"a\\\"] = \\\"429\\\"\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING})\\n    check(\\\"chainContinuesAfter429\\\", st == 200 and content(resp) == \\\"b says ok\\\" and [h[\\\"prefix\\\"] for h in hits] == [\\\"a\\\", \\\"b\\\"] and ncli == 0,\\n          (st, resp, [h[\\\"prefix\\\"] for h in hits], ncli))\\n\\n    mode[\\\"b\\\"] = \\\"429\\\"\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING})\\n    agy = [c for c in calls() if c[0] == \\\"agy\\\"]\\n    check(\\\"fallbackProfileAfterChain\\\", st == 200 and [h[\\\"prefix\\\"] for h in hits] == [\\\"a\\\", \\\"b\\\"] and ncli == 1\\n          and isinstance(resp, dict) and resp.get(\\\"model\\\") == \\\"agy:gemini-3.8-flash\\\", (st, resp, [h[\\\"prefix\\\"] for h in hits], ncli))\\n    check(\\\"fallbackAliasEffort\\\", agy and after(agy[-1][1], \\\"--model\\\") == \\\"gemini-3.8-flash\\\" and after(agy[-1][1], \\\"--effort\\\") == \\\"low\\\",\\n          agy[-1][1] if agy else None)\\n\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING}, {\\\"X-ASL-Use\\\": \\\"research\\\"})\\n    check(\\\"noHiddenFallback\\\", st == 502 and [h[\\\"prefix\\\"] for h in hits] == [\\\"b\\\"] and ncli == 0 and \\\"no model answered (beta)\\\" in str(resp),\\n          (st, resp, [h[\\\"prefix\\\"] for h in hits], ncli))\\n    mode.clear()\\n\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING}, {\\\"X-ASL-Use\\\": \\\"research\\\"})\\n    check(\\\"useResolvesProfile\\\", st == 200 and [h[\\\"body\\\"].get(\\\"model\\\") for h in hits] == [\\\"beta-1\\\"], (st, resp, hits))\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tests/acceptance/gateway/configV2Test.sh\" :start 280 :end 315)" :want "(:read :file \"tests/acceptance/gateway/configV2Test.sh\" :start 280 :end 315 :content \"\\n    mode[\\\"b\\\"] = \\\"429\\\"\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING})\\n    agy = [c for c in calls() if c[0] == \\\"agy\\\"]\\n    check(\\\"fallbackProfileAfterChain\\\", st == 200 and [h[\\\"prefix\\\"] for h in hits] == [\\\"a\\\", \\\"b\\\"] and ncli == 1\\n          and isinstance(resp, dict) and resp.get(\\\"model\\\") == \\\"agy:gemini-3.8-flash\\\", (st, resp, [h[\\\"prefix\\\"] for h in hits], ncli))\\n    check(\\\"fallbackAliasEffort\\\", agy and after(agy[-1][1], \\\"--model\\\") == \\\"gemini-3.8-flash\\\" and after(agy[-1][1], \\\"--effort\\\") == \\\"low\\\",\\n          agy[-1][1] if agy else None)\\n\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING}, {\\\"X-ASL-Use\\\": \\\"research\\\"})\\n    check(\\\"noHiddenFallback\\\", st == 502 and [h[\\\"prefix\\\"] for h in hits] == [\\\"b\\\"] and ncli == 0 and \\\"no model answered (beta)\\\" in str(resp),\\n          (st, resp, [h[\\\"prefix\\\"] for h in hits], ncli))\\n    mode.clear()\\n\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING}, {\\\"X-ASL-Use\\\": \\\"research\\\"})\\n    check(\\\"useResolvesProfile\\\", st == 200 and [h[\\\"body\\\"].get(\\\"model\\\") for h in hits] == [\\\"beta-1\\\"], (st, resp, hits))\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING}, {\\\"X-ASL-Use\\\": \\\"research\\\", \\\"X-ASL-Profile\\\": \\\"main\\\"})\\n    check(\\\"profileHeaderBeatsUse\\\", st == 200 and [h[\\\"body\\\"].get(\\\"model\\\") for h in hits] == [\\\"alpha-1\\\"], (st, resp, hits))\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING}, {\\\"X-ASL-Use\\\": \\\"nope\\\"})\\n    check(\\\"unknownUse400\\\", st == 400 and \\\"unknown use nope\\\" in str(resp) and not hits and ncli == 0, (st, resp))\\n\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING}, {\\\"X-ASL-Use\\\": \\\"leon\\\"})\\n    b = hits[0][\\\"body\\\"] if hits else {}\\n    check(\\\"calibrationParams\\\", st == 200 and b.get(\\\"model\\\") == \\\"cal-1\\\" and b.get(\\\"temperature\\\") == 0.45 and b.get(\\\"max_tokens\\\") == 32768\\n          and \\\"timeout\\\" not in b, b)\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING}, {\\\"X-ASL-Profile\\\": \\\"over\\\"})\\n    b = hits[0][\\\"body\\\"] if hits else {}\\n    check(\\\"userOverridesRegistry\\\", b.get(\\\"model\\\") == \\\"cal-2\\\" and b.get(\\\"max_tokens\\\") == 999 and b.get(\\\"temperature\\\") == 0.45, b)\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"temperature\\\": 0.1, \\\"max_tokens\\\": 200, \\\"tools\\\": [], \\\"messages\\\": PING}, {\\\"X-ASL-Use\\\": \\\"leon\\\"})\\n    b = hits[0][\\\"body\\\"] if hits else {}\\n    check(\\\"requestOverridesCalibration\\\", b.get(\\\"temperature\\\") == 0.1 and b.get(\\\"max_tokens\\\") == 200, b)\\n\\n    st, resp, hits, ncli = chat(base, {\\\"model\\\": \\\"profile\\\", \\\"tools\\\": [], \\\"messages\\\": PING}, {\\\"X-ASL-Profile\\\": \\\"glmLow\\\"})\\n    b = hits[0][\\\"body\\\"] if hits else {}\\n    check(\\\"ollamaAliasEffortSent\\\", st == 200 and b.get(\\\"model\\\") == \\\"glm-5.3\\\" and b.get(\\\"reasoning_effort\\\") == \\\"low\\\" and \\\"effort\\\" not in b, b)\\n    check(\\\"ollamaAliasEffortReportedInAsl\\\", isinstance(resp, dict) and resp.get(\\\"asl\\\", {}).get(\\\"effort\\\") == \\\"low\\\", resp)\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"scripts/agentLoop/loop.py\" :start 2300 :end 2450)" :want "(:read :file \"scripts/agentLoop/loop.py\" :start 2300 :end 2450 :content \"    parts.append(')')\\n    return \\\"\\\".join(parts)\\n\\n\\n# (:m :adopted NormativeAndEmpiricalAreNotMixed)\\nGATE_TAIL_LINES = 20\\n# (:m :adopted NormativeAndEmpiricalAreNotMixed)\\nGATE_TAIL_CHARS = 2000\\n\\n\\ndef gate_tail(g):\\n    combined = ((g.get(\\\"stdout\\\") or \\\"\\\") + \\\"\\\\n\\\" + (g.get(\\\"stderr\\\") or \\\"\\\")).strip()\\n    return \\\"\\\\n\\\".join(combined.splitlines()[-GATE_TAIL_LINES:])[-GATE_TAIL_CHARS:]\\n\\n\\ndef gate_outcome(g):\\n    if g.get(\\\"timeout\\\"):\\n        return f':timeout true :seconds {g.get(\\\"seconds\\\")}'\\n    return f':exit {g.get(\\\"exit\\\")}'\\n\\n\\ndef format_gate_run(g):\\n    n = f':n {g[\\\"n\\\"]} ' if g.get(\\\"n\\\") is not None else \\\"\\\"\\n    return f'({n}:cmd \\\"{_escape_asn(g.get(\\\"cmd\\\", \\\"\\\"))}\\\" {gate_outcome(g)} :tail \\\"{_escape_asn(gate_tail(g))}\\\")'\\n\\n\\n# (:m :adopted NormativeAndEmpiricalAreNotMixed :why \\\"about 600 to 800 tokens\\\")\\nNOTE_MAX_CHARS = 2400\\nDELIVER_FACT = (\\\"first state what the task asks you to deliver as (:intent :deliver findings|patch|plan|verdict :why s); \\\"\\n                \\\"findings that need web or document research add :kind research, and a turn after a search or research step is served by a research model; \\\"\\n                \\\"a later (:intent ...) restates it; findings are done with (:findings ...) claims that receipts back; \\\"\\n                \\\"findings accumulate across turns, a claim with the same :file and :anchor replaces the earlier one, \\\"\\n                \\\"and (:retract :file f :anchor a) inside (:findings ...) drops one; \\\"\\n                \\\"a patch is done once a write is applied and the declared gates pass; a plan is done with (:note ...) and (:done); \\\"\\n                \\\"a verdict is done with (:findings ...) citing gate receipts\\\")\\nAUTO_FACT = (\\\"the task decides the phases, and you choose them in any order, each as often as needed: \\\"\\n             \\\"scout reads and searches and reports (:findings ...); plan sets the plan as the session (:note ...); \\\"\\n             \\\"implement writes inside :owns, or anywhere inside the workspace root when no :owns is given; \\\"\\n             \\\"grade runs the declared gates with (:step :op \\\\\\\"gate\\\\\\\") and cites their receipts; \\\"\\n             \\\"the run ends with (:done), (:findings ...) or (:escalate :reason s); \\\"\\n             \\\"(:done :commit s) commits the written paths when the task asks for a commit; \\\"\\n             \\\"code it writes catches the specific error and handles or reports it; \\\"\\n             \\\"it never writes a bare except or except Exception followed by pass\\\")\\nNOTE_FACT = (\\\"a window cut drops older receipts; a (:note ...) survives it, sent whole in every message: \\\"\\n             \\\"keep in it the decisions, the target file and span, and the next write\\\")\\n# (:m :tags (prompt budget) :why \\\"54% of turns carried one step\\\")\\nBATCH_EXAMPLE = ('(:step :op \\\"edit\\\" :file \\\"src/ring.py\\\" :old \\\"return xs[len(xs)]\\\" :new \\\"return xs[len(xs) - 1]\\\") '\\n                 '(:step :op \\\"read\\\" :file \\\"tests/ringTest.sh\\\" :start 1 :end 60) (:step :op \\\"gate\\\" :n 1)')\\nLOOKUP_FACT = (\\\"an outline step lists a file's defs and classes with their line spans, cheaper than reading it; \\\"\\n               \\\"every call site of a function, through aliases and modules: the observe step with :dim callers :symbol s\\\")\\nBATCH_FACT = (\\\"batching: a turn costs a whole model call and a wrong guess costs one receipt, \\\"\\n              \\\"so each reply carries every independent read, query, edit and gate step you can foresee; \\\"\\n              \\\"only a step that needs a receipt not yet seen waits for the next turn, where you recalibrate; \\\"\\n              \\\"a reply has no limit on steps; three steps in one reply, the edit quoting lines an earlier receipt showed: \\\" + BATCH_EXAMPLE\\n              + \\\"; once the lines to change are seen, the next reply carries the edit\\\")\\n\\n\\ndef _exec_note_op(op):\\n    v = _as_list(_core(\\\"note\\\", op.get(\\\"form\\\", \\\"\\\"), str(NOTE_MAX_CHARS)), \\\"note\\\")\\n    if not (len(v) == 4 and v[0] in (\\\"ok\\\", \\\"rejected\\\", \\\"missing\\\") and type(v[1]) is int\\n            and all(isinstance(x, str) and not isinstance(x, _Atom) for x in v[2:])):\\n        raise CoreHostError(\\\"ERR_CORE_HOST_MALFORMED\\\", f\\\"expected (note status chars text slot), got {v!r}\\\"[:200])\\n    status, chars, text, slot = v\\n    r = {\\\"id\\\": _receipt_id(), \\\"op\\\": \\\"note\\\", \\\"chars\\\": chars}\\n    if status == \\\"ok\\\":\\n        r.update(status=\\\"ok\\\", noteText=text, noteSlot=slot)\\n    elif status == \\\"rejected\\\":\\n        r.update(status=\\\"rejected\\\", error=\\\"ERR_NOTE_TOO_LONG\\\", cap=NOTE_MAX_CHARS,\\n                 message=f\\\"the note is {chars} chars, over the cap of {NOTE_MAX_CHARS}; the note is unchanged\\\")\\n    else:\\n        r.update(status=\\\"rejected\\\", error=\\\"ERR_MISSING_ARG\\\", message=\\\"note needs :text s; the note is unchanged\\\")\\n    return r\\n\\n\\nPLAN_OPS = (\\\"plan\\\", \\\"planDone\\\", \\\"planDrop\\\")\\n# (:m :adopted NormativeAndEmpiricalAreNotMixed :why \\\"bounds the stable slot\\\")\\nPLAN_MAX_STEPS = 20\\nPLAN_FIELD_CHARS = 300\\n_PLAN_ID = re.compile(r\\\"[A-Za-z0-9_.-]{1,32}\\\")\\n_PLAN_ON = {\\\"on\\\": False}\\n_PRIOR_RECEIPT = re.compile(r'\\\\(:receipt :id \\\"([0-9a-f]+)\\\" :op \\\"(\\\\w*)\\\" :status :(?!rejected)')\\nPLAN_FACT = (\\\"plan: your first reply carries (:plan (:step :id s1 :do s :check s) ...) beside its first steps; \\\"\\n             \\\"the plan is sent whole in every message, and (:now) shows :plan (:done (ids) :current id :turnsOnCurrent n); \\\"\\n             \\\"(:planDone :id s1 :ev id) marks a step done, citing the :id of a receipt that shows its :check; \\\"\\n             \\\"(:planDrop :id s :why s) drops a step; (:plan :revise ((:step ...) ...) :why s) replaces the steps not done; \\\"\\n             \\\"the run is done only when every step is done or dropped\\\")\\nPLAN_NUDGE = \\\"no plan yet: add (:plan (:step :id s1 :do s :check s) ...) beside your next steps\\\"\\n\\n\\ndef new_plan(on):\\n    return {\\\"on\\\": bool(on), \\\"steps\\\": [], \\\"done\\\": {}, \\\"dropped\\\": {}, \\\"revisions\\\": 0, \\\"current\\\": None, \\\"since\\\": 0,\\n            \\\"nudgeTurn\\\": None}\\n\\n\\ndef _plan_to_asn(p):\\n    on = \\\"true\\\" if p.get(\\\"on\\\") else \\\"false\\\"\\n    cur = p.get(\\\"current\\\") or \\\"\\\"\\n    since = p.get(\\\"since\\\") or 0\\n    rev = p.get(\\\"revisions\\\") or 0\\n    nudge = -1 if p.get(\\\"nudgeTurn\\\") is None else p[\\\"nudgeTurn\\\"]\\n    steps = \\\" \\\".join(\\\"(:step :id \\\" + str(s[\\\"id\\\"]) + \\\" :do \\\\\\\"\\\" + _escape_asn(s[\\\"do\\\"]) + \\\"\\\\\\\" :check \\\\\\\"\\\" + _escape_asn(s.get(\\\"check\\\", \\\"\\\")) + \\\"\\\\\\\")\\\" for s in p.get(\\\"steps\\\", []))\\n    done = \\\" \\\".join(\\\"(:done :id \\\" + str(k) + \\\" :ev \\\\\\\"\\\" + _escape_asn(v) + \\\"\\\\\\\")\\\" for k, v in sorted(p.get(\\\"done\\\", {}).items()))\\n    dropped = \\\" \\\".join(\\\"(:dropped :id \\\" + str(k) + \\\" :why \\\\\\\"\\\" + _escape_asn(v) + \\\"\\\\\\\")\\\" for k, v in sorted(p.get(\\\"dropped\\\", {}).items()))\\n    return \\\"(:planState :on \\\" + on + \\\" :current \\\\\\\"\\\" + _escape_asn(cur) + \\\"\\\\\\\" :since \\\" + str(since) + \\\" :revisions \\\" + str(rev) + \\\" :nudgeTurn \\\" + str(nudge) + \\\" :steps (\\\" + steps + \\\") :done (\\\" + done + \\\") :dropped (\\\" + dropped + \\\"))\\\"\\n\\n\\ndef _asn_to_plan(text):\\n    tree = _sexp(text)[0]\\n    kv = {}\\n    i = 1\\n    while i < len(tree):\\n        k = tree[i]\\n        if isinstance(k, _Atom) and k.startswith(\\\":\\\"):\\n            kv[k[1:]] = tree[i + 1]\\n            i += 2\\n        else:\\n            i += 1\\n    steps = []\\n    for item in kv.get(\\\"steps\\\") or []:\\n        skv = {item[j][1:]: item[j+1] for j in range(1, len(item), 2)}\\n        steps.append({\\\"id\\\": str(skv.get(\\\"id\\\")), \\\"do\\\": str(skv.get(\\\"do\\\", \\\"\\\")), \\\"check\\\": str(skv.get(\\\"check\\\", \\\"\\\"))})\\n    done = {}\\n    for item in kv.get(\\\"done\\\") or []:\\n        dkv = {item[j][1:]: item[j+1] for j in range(1, len(item), 2)}\\n        done[str(dkv.get(\\\"id\\\"))] = str(dkv.get(\\\"ev\\\", \\\"\\\"))\\n    dropped = {}\\n    for item in kv.get(\\\"dropped\\\") or []:\\n        dkv = {item[j][1:]: item[j+1] for j in range(1, len(item), 2)}\\n        dropped[str(dkv.get(\\\"id\\\"))] = str(dkv.get(\\\"why\\\", \\\"\\\"))\\n    cur = kv.get(\\\"current\\\")\\n    cur = None if not cur else str(cur)\\n    nudge = kv.get(\\\"nudgeTurn\\\")\\n    nudge = None if (nudge is None or int(nudge) < 0) else int(nudge)\\n    return {\\n        \\\"on\\\": bool(kv.get(\\\"on\\\")),\\n        \\\"current\\\": cur,\\n        \\\"since\\\": int(kv.get(\\\"since\\\", 0)),\\n        \\\"revisions\\\": int(kv.get(\\\"revisions\\\", 0)),\\n        \\\"nudgeTurn\\\": nudge,\\n        \\\"steps\\\": steps,\\n        \\\"done\\\": done,\\n        \\\"dropped\\\": dropped,\\n    }\\n\\n\\ndef _tree_to_asn(item):\\n    if isinstance(item, _Atom):\\n        return str(item)\\n    if isinstance(item, str):\\n        return '\\\"' + _escape_asn(item) + '\\\"'\\n    if isinstance(item, list):\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"scripts/agentLoop/loop.py\" :start 461 :end 600)" :want "(:read :file \"scripts/agentLoop/loop.py\" :start 461 :end 600 :content \"    if \\\"\\\\n\\\" in msg or \\\"\\\\r\\\" in msg:\\n        return \\\"the message must be one line\\\"\\n    text = msg.strip()\\n    if not text.startswith(\\\"(\\\"):\\n        return \\\"the message must be one (:c ...) form\\\"\\n    tokens = []\\n    depth = 0\\n    closed_at = None\\n    i, n = 0, len(text)\\n    while i < n:\\n        c = text[i]\\n        if c.isspace():\\n            i += 1\\n            continue\\n        if closed_at is not None:\\n            return \\\"the message must be exactly one form\\\"\\n        if c == '\\\"':\\n            j = i + 1\\n            while j < n:\\n                if text[j] == \\\"\\\\\\\\\\\":\\n                    j += 2\\n                    continue\\n                if text[j] == '\\\"':\\n                    break\\n                j += 1\\n            if j >= n:\\n                return \\\"a string is opened but never closed\\\"\\n            tokens.append((\\\"str\\\", text[i + 1:j]))\\n            i = j + 1\\n            continue\\n        if c in \\\"([{\\\":\\n            depth += 1\\n            tokens.append((\\\"open\\\", c))\\n            i += 1\\n            continue\\n        if c in \\\")]}\\\":\\n            depth -= 1\\n            if depth < 0:\\n                return \\\"a bracket closes that was never opened\\\"\\n            tokens.append((\\\"close\\\", c))\\n            if depth == 0:\\n                closed_at = len(tokens)\\n            i += 1\\n            continue\\n        j = i\\n        while j < n and not text[j].isspace() and text[j] not in '()[]{}\\\"':\\n            j += 1\\n        tokens.append((\\\"atom\\\", text[i:j]))\\n        i = j\\n    if depth != 0:\\n        return \\\"a bracket is opened but never closed\\\"\\n    if len(tokens) < 2 or tokens[0] != (\\\"open\\\", \\\"(\\\") or tokens[-1][0] != \\\"close\\\" or closed_at != len(tokens):\\n        return \\\"the message must be one balanced (:c ...) form\\\"\\n    if tokens[1] != (\\\"atom\\\", \\\":c\\\"):\\n        return \\\"the form's head must be :c\\\"\\n    keys = []\\n    k = 2\\n    while k < len(tokens) - 1:\\n        kind, val = tokens[k]\\n        if kind != \\\"atom\\\" or not val.startswith(\\\":\\\"):\\n            if keys and tokens[k - 1][0] == \\\"atom\\\":\\n                return \\\"the :\\\" + keys[-1] + \\\" value contains a space and must be a quoted string\\\"\\n            return \\\"expected a :keyword, found \\\" + repr(val)\\n        key = val[1:]\\n        if k + 1 >= len(tokens) - 1:\\n            return \\\":\\\" + key + \\\" has no value\\\"\\n        vkind, _ = tokens[k + 1]\\n        if vkind in (\\\"open\\\", \\\"close\\\") or (vkind == \\\"atom\\\" and tokens[k + 1][1].startswith(\\\":\\\")):\\n            return \\\":\\\" + key + \\\" has no value\\\"\\n        keys.append(key)\\n        k += 2\\n    if \\\"a\\\" not in keys:\\n        return \\\"the form must carry :a\\\"\\n    if \\\"do\\\" not in keys:\\n        return \\\"the form must carry :do\\\"\\n    return None\\n\\n\\ndef _commit_names_head(msg, root_dir):\\n    \\\"\\\"\\\"True when msg is a 7-40 char hex prefix of HEAD: the model already committed.\\\"\\\"\\\"\\n    if not isinstance(msg, str):\\n        return False\\n    s = msg.strip()\\n    if not re.fullmatch(r\\\"[0-9a-fA-F]{7,40}\\\", s):\\n        return False\\n    if not root_dir:\\n        return False\\n    head = (_git(root_dir, \\\"rev-parse\\\", \\\"HEAD\\\").stdout or \\\"\\\").strip()\\n    return bool(head) and head.startswith(s.lower())\\n\\n\\ndef repair_inner_quotes(text):\\n    out = []\\n    i = 0\\n    n = len(text)\\n    in_str = False\\n    esc = False\\n    escaped_count = 0\\n    current_key = None\\n\\n    while i < n:\\n        c = text[i]\\n        if in_str:\\n            if esc:\\n                out.append(c)\\n                esc = False\\n                i += 1\\n                continue\\n            if c == '\\\\\\\\':\\n                esc = True\\n                out.append(c)\\n                i += 1\\n                continue\\n            if c == '\\\"':\\n                k = i + 1\\n                while k < n and text[k].isspace():\\n                    k += 1\\n                is_inner = False\\n                if k >= n:\\n                    is_inner = False\\n                elif is_keyword_start(text, k):\\n                    is_inner = False\\n                elif text[k] in (')', ']', '}'):\\n                    m = k + 1\\n                    while m < n and text[m].isspace():\\n                        m += 1\\n                    if m >= n or text[m] in (')', ']', '}', '(') or is_keyword_start(text, m):\\n                        is_inner = False\\n                    else:\\n                        is_inner = True\\n                else:\\n                    is_inner = True\\n\\n                if is_inner:\\n                    out.append('\\\\\\\\\\\"')\\n                    escaped_count += 1\\n                else:\\n                    out.append(c)\\n                    in_str = False\\n                i += 1\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tests/agentEval/scoreTest.sh\" :start 150 :end 215)" :want "(:read :status :rejected :error ERR_FILE_NOT_FOUND :message \"File not found: tests/agentEval/scoreTest.sh\" :hint \"paths resolve against the workspace root; :nearest, when present, names entries beside the missing one\" :see \"(:help :op read)\")\n" :exit 1)
(:case :src leon :form "(:read :file \"scripts/aslForms.py\" :start 1 :end 60)" :want "(:read :file \"scripts/aslForms.py\" :start 1 :end 60 :content \"import sys, os, subprocess, re, time, urllib.request, socket, json, fnmatch, hashlib, tempfile, difflib, fcntl, bisect, shutil, concurrent.futures, threading\\n\\nbin_dir = os.environ.get(\\\"SCRIPT_DIR\\\", \\\"\\\")\\nif not bin_dir:\\n    bin_dir = os.path.join(os.getcwd(), \\\"bin\\\")\\nROOT_DIR = os.environ.get(\\\"ROOT_DIR\\\", \\\"\\\")\\nif not ROOT_DIR:\\n    ROOT_DIR = os.path.dirname(bin_dir) if os.path.basename(bin_dir) == \\\"bin\\\" else os.getcwd()\\n\\n# File tools address the workspace the caller is in, not the toolchain\\n# checkout: ASL_ROOT if set, else the git toplevel of cwd, else cwd. ROOT_DIR\\n# stays the toolchain root for engines, lenses and audits.\\ndef _resolve_workspace():\\n    env_root = os.environ.get(\\\"ASL_ROOT\\\", \\\"\\\")\\n    if env_root:\\n        return os.path.realpath(env_root)\\n    # Walk up to the nearest .git (a directory, or a file for worktrees and\\n    # submodules): the same toplevel git rev-parse reports, without a fork.\\n    cwd_real = os.path.realpath(os.getcwd())\\n    probe = cwd_real\\n    while True:\\n        if os.path.exists(os.path.join(probe, \\\".git\\\")):\\n            return probe\\n        parent = os.path.dirname(probe)\\n        if parent == probe:\\n            return cwd_real\\n        probe = parent\\n\\nWS_DIR = _resolve_workspace()\\n\\n# SV1: a session name becomes a directory under the staging store; refuse anything else before any step runs\\n_ASL_SESSION = os.environ.get(\\\"ASL_SESSION\\\", \\\"\\\")\\nif _ASL_SESSION and (not re.fullmatch(r\\\"[A-Za-z0-9._-]+\\\", _ASL_SESSION) or \\\"..\\\" in _ASL_SESSION or _ASL_SESSION == \\\".\\\"):\\n    print(\\\"(:error :code ERR_BAD_SESSION :message \\\\\\\"ASL_SESSION must match [A-Za-z0-9._-]+ without ..\\\\\\\")\\\")\\n    sys.exit(2)\\n\\ndef escape_asn_val(s):\\n    if s is None: return \\\"\\\"\\n    return str(s).replace(\\\"\\\\\\\\\\\", \\\"\\\\\\\\\\\\\\\\\\\").replace(\\\"\\\\\\\"\\\", \\\"\\\\\\\\\\\\\\\"\\\").replace(\\\"\\\\n\\\", \\\"\\\\\\\\n\\\")\\n\\n_ASN_ESCAPES = {\\\"n\\\": \\\"\\\\n\\\", \\\"t\\\": \\\"\\\\t\\\", \\\"\\\\\\\"\\\": \\\"\\\\\\\"\\\", \\\"\\\\\\\\\\\": \\\"\\\\\\\\\\\"}\\n\\ndef asn_unescape(s):\\n    # one pass over backslash + next char; an escaped backslash before n stays backslash-n\\n    return re.sub(r\\\"\\\\\\\\(.)\\\", lambda m: _ASN_ESCAPES.get(m.group(1), \\\"\\\\\\\\\\\" + m.group(1)), s, flags=re.S)\\n\\n# ---------------- Workspace containment & atomic IO ----------------\\n# is_safe_path was a substring blacklist that accepted every absolute path and\\n# collapsed .. before checking, so it never enforced a boundary. Containment is\\n# now decided by realpath comparison against the workspace root.\\ndef _real_root():\\n    return WS_DIR\\n\\ndef resolve_in_root(p):\\n    if not p:\\n        return \\\"\\\", \\\"Missing path\\\"\\n    cand = p if os.path.isabs(p) else os.path.join(WS_DIR, p)\\n    cand = os.path.normpath(cand)\\n    root = _real_root()\\n    probe = cand\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"scripts/audit/runner.py\" :start 330 :end 420)" :want "(:read :file \"scripts/audit/runner.py\" :start 330 :end 420 :content \"    path = os.path.join(snap, suite)\\n    # spendMeterTest.sh smoke-runs over this directory when present; a nonexistent one keeps it hermetic\\n    env = dict(os.environ, ASL_TRANSCRIPT_DIR=os.path.join(snap, \\\".noTranscripts\\\"), **{NESTED_ENV: \\\"1\\\"})\\n    code, out = bounded([path] if os.access(path, os.X_OK) else [\\\"/bin/sh\\\", path], snap, env)\\n    out = stripSnap(out, snap)\\n    cause, asserts, failLine = shellVerdict(code, out)\\n    gates = GATE_LINE.findall(out)\\n    digest = hashlib.sha256((cause + \\\"\\\\n\\\" + failLine).encode()).hexdigest()[:16] if cause != \\\"OK\\\" else \\\"\\\"\\n    return {\\\"suite\\\": suite, \\\"code\\\": code, \\\"asserts\\\": asserts, \\\"refutes\\\": 0, \\\"declared\\\": 0, \\\"shell\\\": True,\\n            \\\"failed\\\": int(gates[-1][1]) if gates else 0, \\\"cause\\\": cause, \\\"digest\\\": digest, \\\"failLine\\\": failLine, \\\"ms\\\": int((time.time() - t0) * 1000)}\\n\\n\\ndef runAll(snap, suites, workers):\\n    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, workers)) as pool:\\n        return list(pool.map(lambda s: runSuite(snap, s), suites))\\n\\n\\ndef parseLedger(text):\\n    return [dict(zip((\\\"suite\\\", \\\"cause\\\", \\\"digest\\\", \\\"since\\\"), m.groups())) for m in (ENTRY.match(l) for l in text.splitlines()) if m]\\n\\n\\ndef ledgerAt(root, rev):\\n    if rev is None:\\n        path = os.path.join(root, KNOWN_RED)\\n        return parseLedger(open(path, encoding=\\\"utf-8\\\").read()) if os.path.isfile(path) else []\\n    p = subprocess.run([\\\"/usr/bin/git\\\", \\\"show\\\", rev + \\\":\\\" + KNOWN_RED], cwd=root, capture_output=True, text=True)\\n    return parseLedger(p.stdout) if p.returncode == 0 else []\\n\\n\\ndef delta(base, now):\\n    key = lambda e: (e[\\\"suite\\\"], e[\\\"cause\\\"], e[\\\"digest\\\"])\\n    baseKeys, nowKeys = set(map(key, base)), set(map(key, now))\\n    added = [e for e in now if key(e) not in baseKeys]\\n    removed = [e for e in base if key(e) not in nowKeys]\\n    parts = [\\\"(:knownRedDelta\\\"]\\n    if added:\\n        parts.append(\\\"(:added \\\" + \\\" \\\".join('(:suite \\\"%s\\\" :cause \\\"%s\\\" :confirmation :unverified)' % (esc(e[\\\"suite\\\"]), esc(e[\\\"cause\\\"])) for e in added) + \\\")\\\")\\n    if removed:\\n        parts.append(\\\"(:removed \\\" + \\\" \\\".join('(:suite \\\"%s\\\" :cause \\\"%s\\\")' % (esc(e[\\\"suite\\\"]), esc(e[\\\"cause\\\"])) for e in removed) + \\\")\\\")\\n    return \\\" \\\".join(parts) + \\\")\\\"\\n\\n\\ndef reconcile(results, ledger, root):\\n    checks, held = [], 0\\n    bySuite = {}\\n    for e in ledger:\\n        bySuite.setdefault(e[\\\"suite\\\"], []).append(e)\\n    ran = set()\\n    for r in results:\\n        ran.add(r[\\\"suite\\\"])\\n        entries = bySuite.get(r[\\\"suite\\\"], [])\\n        if r[\\\"cause\\\"] == \\\"OK\\\":\\n            if entries:\\n                checks.append((\\\"ERR_STALE_KNOWN_RED\\\", r[\\\"suite\\\"], \\\"listed in knownRed but passed\\\"))\\n        elif any(e[\\\"cause\\\"] == r[\\\"cause\\\"] and e[\\\"digest\\\"] == r[\\\"digest\\\"] for e in entries):\\n            held += 1\\n        else:\\n            err = {\\\"ERR_VACUOUS_SUITE\\\": \\\"ERR_VACUOUS_SUITE\\\", \\\"ERR_DECLARED_GAP\\\": \\\"ERR_DECLARED_GAP\\\", \\\"ERR_TIMEOUT\\\": \\\"ERR_TIMEOUT\\\"}.get(r[\\\"cause\\\"], \\\"ERR_NEW_RED_SUITE\\\")\\n            sig = \\\"%s %s %s\\\" % (r[\\\"cause\\\"], r[\\\"digest\\\"], r[\\\"failLine\\\"])\\n            if entries:\\n                err, sig = (\\\"ERR_KNOWN_RED_DRIFT\\\" if err == \\\"ERR_NEW_RED_SUITE\\\" else err), sig + \\\" (knownRed signature differs)\\\"\\n            checks.append((err, r[\\\"suite\\\"], sig))\\n    notEvaluated = 0\\n    for e in ledger:\\n        if e[\\\"suite\\\"] in ran:\\n            continue\\n        if not os.path.isfile(os.path.join(root, e[\\\"suite\\\"])):\\n            checks.append((\\\"ERR_STALE_KNOWN_RED\\\", e[\\\"suite\\\"], \\\"knownRed entry names no suite file\\\"))\\n        else:\\n            notEvaluated += 1\\n    return checks, notEvaluated, held\\n\\n\\ndef snapRun(root, suites, workers, lockWaitS=0):\\n    \\\"\\\"\\\"-> (results, gained, wallMs): suites run under the workspace lock in a snapshot; gained lists the status lines they dirtied.\\\"\\\"\\\"\\n    lock = acquireLock(root, lockWaitS)\\n    stop = threading.Event()\\n    threading.Thread(target=parentLivenessGuard, args=(stop,), daemon=True).start()\\n    try:\\n        snap = snapshot(root)\\n        try:\\n            if any(s.endswith(\\\".asl\\\") for s in suites):\\n                buildHost(snap)\\n            before = dirt(snap)\\n            t0 = time.time()\\n            results = runAll(snap, suites, workers)\\n            wallMs = int((time.time() - t0) * 1000)\\n            after = dirt(snap)\\n            gained = sorted(l for l, h in after.items() if before.get(l) != h)\\n        finally:\\n            shutil.rmtree(snap, ignore_errors=True)\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tests/acceptance/agentLoop/capBudgetTest.sh\" :start 1 :end 150)" :want "(:read :file \"tests/acceptance/agentLoop/capBudgetTest.sh\" :start 1 :end 98 :content \"#!/usr/bin/env bash\\n# tests/acceptance/agentLoop/capBudgetTest.sh\\n\\nSCRIPT_DIR=\\\"$(cd \\\"$(dirname \\\"${BASH_SOURCE[0]}\\\")\\\" && pwd)\\\"\\n\\nif [ \\\"${ASL_SANDBOX_ACTIVE:-0}\\\" != \\\"1\\\" ]; then\\n    SANDBOX_SCRIPT=\\\"${SCRIPT_DIR}/sandbox.sh\\\"\\n    if [ -f \\\"$SANDBOX_SCRIPT\\\" ]; then\\n        exec sh \\\"$SANDBOX_SCRIPT\\\" \\\"$0\\\" \\\"$@\\\"\\n    fi\\nfi\\n\\npython3 - \\\"$@\\\" << 'PY_EOF'\\nimport os, sys, tempfile, shutil\\n\\nROOT = os.getcwd()\\nsys.path.insert(0, os.path.join(ROOT, \\\"scripts\\\", \\\"agentLoop\\\"))\\nimport loop\\nfrom loop import run_loop\\nloop.VENDOR_BACKOFF_SEC = ()\\ntry:\\n    from backend import ProviderError\\nexcept ImportError:\\n    class ProviderError(Exception):\\n        def __init__(self, code, message=\\\"\\\"):\\n            super().__init__(message); self.code = code\\n\\ntotal_asserts = 0\\nfailed_asserts = 0\\n\\ndef assert_item(name, passed, detail=\\\"\\\"):\\n    global total_asserts, failed_asserts\\n    total_asserts += 1\\n    if passed:\\n        print(f\\\"ok {name}\\\")\\n    else:\\n        failed_asserts += 1\\n        print(f\\\"FAIL {name}: {str(detail)[:300]}\\\")\\n\\nclass Script:\\n    def __init__(self, replies):\\n        self.replies = list(replies)\\n        self.sent = []\\n        self.last_timing = None\\n    def next_turn(self, system_prompt, user_message):\\n        self.sent.append(user_message)\\n        r = self.replies.pop(0) if self.replies else '(:escalate :reason \\\"script exhausted\\\")'\\n        if isinstance(r, Exception):\\n            raise r\\n        return r\\n\\ntmp = tempfile.mkdtemp(prefix=\\\"asl_cap_budget_\\\")\\ntry:\\n    page = lambda a, b: f'(:step :op \\\"read\\\" :file \\\"scripts/agentLoop/loop.py\\\" :start {a} :end {b})'\\n    # paging through new ranges is progress: 6 read-only turns, then escalate by choice, not by cap\\n    p = Script([page(1, 50), page(51, 100), page(101, 150), page(151, 200), page(201, 250), page(251, 300),\\n                '(:escalate :reason \\\"done reading\\\")'])\\n    res = run_loop(p, \\\"read loop.py\\\", \\\"implement\\\", [\\\"x.txt\\\"], [\\\"true\\\"], ROOT, 20, os.path.join(tmp, \\\"a.journal\\\"), max_retries=1)\\n    j = open(os.path.join(tmp, \\\"a.journal\\\")).read()\\n    assert_item(\\\"pagingNotCapped\\\", \\\"observation cap\\\" not in j, j[-300:])\\n    assert_item(\\\"pagingReachesModelChoice\\\", len(p.sent) == 7, len(p.sent))\\n\\n    # re-reading the same range is not progress: the cap fires\\n    p = Script([page(1, 50)] * 12)\\n    res = run_loop(p, \\\"read loop.py\\\", \\\"implement\\\", [\\\"x.txt\\\"], [\\\"true\\\"], ROOT, 20, os.path.join(tmp, \\\"b.journal\\\"), max_retries=1)\\n    j = open(os.path.join(tmp, \\\"b.journal\\\")).read()\\n    assert_item(\\\"repeatCapped\\\", \\\"observation cap\\\" in j, j[-300:])\\n    assert_item(\\\"repeatEscalates\\\", res.get(\\\"status\\\") == \\\"escalated\\\", res.get(\\\"status\\\"))\\n\\n    # a vendor error spends the vendor budget, resends the same message, sends no brief\\n    p = Script([page(1, 50), ProviderError(\\\"ERR_VENDOR\\\", \\\"503\\\"), '(:escalate :reason \\\"stop\\\")'])\\n    res = run_loop(p, \\\"read loop.py\\\", \\\"implement\\\", [\\\"x.txt\\\"], [\\\"true\\\"], ROOT, 20, os.path.join(tmp, \\\"c.journal\\\"), max_retries=1)\\n    j = open(os.path.join(tmp, \\\"c.journal\\\")).read()\\n    assert_item(\\\"vendorResendsSameMessage\\\", len(p.sent) == 3 and p.sent[1] == p.sent[2], [m[-120:] for m in p.sent])\\n    assert_item(\\\"vendorNoRetryBrief\\\", \\\"Retry 1\\\" not in p.sent[-1], p.sent[-1][-200:])\\n    assert_item(\\\"vendorJournalled\\\", \\\":vendorRetry 1\\\" in j, j[-300:])\\n    assert_item(\\\"vendorTranscriptNotDuplicated\\\", p.sent[-1].count(\\\"(:turn 1 \\\") == 1, p.sent[-1][-300:])\\n\\n    # vendor errors do not eat the model's retries: max_retries=1 still survives two vendor errors\\n    p = Script([ProviderError(\\\"ERR_VENDOR\\\", \\\"503\\\"), '(:step :op \\\"tree\\\" :path \\\"scripts\\\")', ProviderError(\\\"ERR_VENDOR\\\", \\\"503\\\"), '(:escalate :reason \\\"stop\\\")'])\\n    res = run_loop(p, \\\"t\\\", \\\"implement\\\", [\\\"x.txt\\\"], [\\\"true\\\"], ROOT, 20, os.path.join(tmp, \\\"d.journal\\\"), max_retries=1)\\n    assert_item(\\\"vendorBudgetSeparate\\\", res.get(\\\"status\\\") != \\\"failed\\\", res)\\n    # vendor-reported token usage is journalled per turn and summed in the result\\n    class Usage(Script):\\n        def next_turn(self, system_prompt, user_message):\\n            self.last_usage = {\\\"inputTokens\\\": 100, \\\"cachedTokens\\\": 40, \\\"outputTokens\\\": 7}\\n            return Script.next_turn(self, system_prompt, user_message)\\n    p = Usage([page(1, 50), '(:escalate :reason \\\"stop\\\")'])\\n    res = run_loop(p, \\\"t\\\", \\\"implement\\\", [\\\"x.txt\\\"], [\\\"true\\\"], ROOT, 20, os.path.join(tmp, \\\"e.journal\\\"), max_retries=1)\\n    j = open(os.path.join(tmp, \\\"e.journal\\\")).read()\\n    assert_item(\\\"usageJournalledPerTurn\\\", j.count(\\\":usage (:input 100 :cached 40 :output 7)\\\") == 2, j[-400:])\\n    assert_item(\\\"usageSummed\\\", res.get(\\\"usage\\\") == {\\\"inputTokens\\\": 200, \\\"cachedTokens\\\": 80, \\\"outputTokens\\\": 14}, res.get(\\\"usage\\\"))\\nfinally:\\n    shutil.rmtree(tmp, ignore_errors=True)\\n\\nprint(f'(:gate :name \\\"capBudgetTest\\\" :asserts {total_asserts} :failed {failed_asserts})')\\nsys.exit(0 if failed_asserts == 0 and total_asserts > 0 else 1)\\nPY_EOF\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tests/acceptance/gateway/configV2Test.sh\" :start 180 :end 210)" :want "(:read :file \"tests/acceptance/gateway/configV2Test.sh\" :start 180 :end 210 :content \"def chat(base, body, headers=None):\\n    h = {\\\"Content-Type\\\": \\\"application/json\\\"}\\n    h.update(headers or {})\\n    n0, c0 = len(seen), len(calls())\\n    req = urllib.request.Request(base + \\\"/v1/chat/completions\\\", method=\\\"POST\\\", headers=h, data=json.dumps(body).encode())\\n    try:\\n        with opener.open(req, timeout=90) as r:\\n            raw = r.read().decode()\\n            try:\\n                resp = json.loads(raw)\\n            except Exception:\\n                resp = raw\\n            st = r.status\\n    except urllib.error.HTTPError as e:\\n        st, resp = e.code, e.read().decode()[:400]\\n    except Exception as e:\\n        st, resp = -1, str(e)\\n    return st, resp, seen[n0:], len(calls()) - c0\\n\\n\\ndef content(resp):\\n    return resp.get(\\\"choices\\\", [{}])[0].get(\\\"message\\\", {}).get(\\\"content\\\") if isinstance(resp, dict) else None\\n\\n\\ndef after(argv, flag):\\n    return argv[argv.index(flag) + 1] if flag in argv and argv.index(flag) + 1 < len(argv) else None\\n\\n\\ndef config_check(text, extra=None):\\n    path = os.path.join(work, f\\\"check{len(os.listdir(work))}.asn\\\")\\n    with open(path, \\\"w\\\") as f:\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tests/acceptance/observe/tokenCostTest.sh\" :start 1 :end 68)" :want "(:read :file \"tests/acceptance/observe/tokenCostTest.sh\" :start 1 :end 68 :content \"#!/bin/bash\\n# OBS1 (:observe :dim tokenCost) via bin/asl on a temp clone (ASL_ROOT) and a non-asl git repo; no network.\\n# Claims: a tracked .asl file of N o200k tokens (tiktoken oracle) adds exactly N tokens and one file, an untracked one\\n# adds nothing, receipts stay under 4096 bytes at :limit 100 and with long paths, a deleted tracked file is :missing,\\n# an unknown dim gives ERR_UNKNOWN_DIM with :nearest, and a non-asl repo is counted with the checkout's tokenizer.\\nset -u\\nROOT=\\\"$(cd \\\"$(dirname \\\"$0\\\")/../../..\\\" && pwd)\\\"\\nTMP=\\\"$(mktemp -d \\\"${TMPDIR:-/tmp}/obsTokenCost.XXXXXX\\\")\\\"\\ntrap 'rm -rf \\\"$TMP\\\"' EXIT\\nif ! git clone -q --shared \\\"$ROOT\\\" \\\"$TMP/repo\\\" || ! git init -q \\\"$TMP/foreign\\\"; then\\n    echo \\\"clone failed\\\" >&2\\n    echo '(:gate :name \\\"observeTokenCost\\\" :asserts 0 :failed 1)'\\n    exit 1\\nfi\\nROOT=\\\"$ROOT\\\" CLONE=\\\"$TMP/repo\\\" FOREIGN=\\\"$TMP/foreign\\\" python3 - <<'PY_EOF'\\nimport os, re, subprocess, sys\\nroot, clone, foreign = os.environ[\\\"ROOT\\\"], os.environ[\\\"CLONE\\\"], os.environ[\\\"FOREIGN\\\"]\\nsys.path.insert(0, os.path.join(root, \\\"scripts\\\"))\\nasserts = failed = 0\\n\\ndef ok(cond, label):\\n    global asserts, failed\\n    asserts += 1\\n    if not cond:\\n        failed += 1\\n        print(\\\"FAIL: \\\" + label, file=sys.stderr)\\n\\ndef observe(form, ws=clone):\\n    env = {k: v for k, v in os.environ.items() if not k.startswith(\\\"ASL_CLI_\\\")}\\n    p = subprocess.run([os.path.join(root, \\\"bin\\\", \\\"asl\\\"), form], cwd=ws, capture_output=True, text=True,\\n                       env=dict(env, ASL_ROOT=ws, ASL_HOST=os.path.join(root, \\\"asl\\\", \\\"host\\\", \\\"out\\\", \\\"asl-host\\\")), stdin=subprocess.DEVNULL, timeout=300)\\n    return p.returncode, p.stdout.strip()\\n\\ndef asl_kind(out):\\n    m = re.search(r\\\"\\\\(:kind asl :files (\\\\d+) :tok (\\\\d+)\\\", out)\\n    return (int(m.group(1)), int(m.group(2))) if m else None\\n\\nprobe_dir = os.path.join(clone, \\\"tokenCostProbe\\\")\\nos.makedirs(probe_dir)\\nfor name, body in ((\\\"base.asl\\\", \\\"(module base :x [base])\\\\n\\\"), (\\\"base.py\\\", \\\"def base(): return 1\\\\n\\\"), (\\\"readme.md\\\", \\\"token cost probe\\\\n\\\")):\\n    with open(os.path.join(probe_dir, name), \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n        fh.write(body)\\nsubprocess.run([\\\"git\\\", \\\"add\\\", \\\"tokenCostProbe\\\"], cwd=clone, check=True)\\n# Long paths make the untruncated top exceed the byte cap while the receipt header still fits.\\nlong_dir = os.path.join(probe_dir, \\\"long\\\")\\nos.makedirs(long_dir)\\nfor i in range(64):\\n    name = (\\\"entry%02d_\\\" % i) + (\\\"x\\\" * 68) + \\\".txt\\\"\\n    with open(os.path.join(long_dir, name), \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n        fh.write(\\\"one token\\\\n\\\")\\nsubprocess.run([\\\"git\\\", \\\"add\\\", \\\"tokenCostProbe/long\\\"], cwd=clone, check=True)\\nscope = \\\"tokenCostProbe\\\"\\nform = \\\"(:observe :dim tokenCost :scope tokenCostProbe)\\\"\\nrc0, base = observe(form)\\nok(rc0 == 0 and base.startswith(\\\"(:observe :dim tokenCost :v 1 :method o200kBase\\\"), \\\"baseline receipt: rc=%d %s\\\" % (rc0, base[:200]))\\nb = asl_kind(base)\\nok(b is not None, \\\"baseline carries (:kind asl ...)\\\")\\n\\nprobe = os.path.join(probe_dir, \\\"obsProbe.asl\\\")\\nwith open(probe, \\\"w\\\", encoding=\\\"utf-8\\\") as fh:\\n    fh.write(\\\"(defun obsProbe ((n Int)) -> Int\\\\n  (+ n 41))\\\\n\\\")\\nimport tiktoken\\nenc = tiktoken.get_encoding(\\\"o200k_base\\\")\\nn = len(enc.encode(open(probe, encoding=\\\"utf-8\\\").read(), disallowed_special=()))\\nok(n > 0, \\\"probe has tokens\\\")\\n\\nrc1, untracked = observe(form)\\nok(b is not None and asl_kind(untracked) == b, \\\"an untracked file changes nothing: %s vs %s\\\" % (asl_kind(untracked), b))\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tests/acceptance/agentLoop/cardTest.sh\" :start 155 :end 250)" :want "(:read :file \"tests/acceptance/agentLoop/cardTest.sh\" :start 155 :end 250 :content \"help_out = help_proc.stdout.strip()\\nhas_help_op = help_proc.returncode == 0 and \\\":op :agent\\\" in help_out\\n\\ndef count_tokens(text):\\n    try:\\n        import tiktoken\\n        enc = tiktoken.get_encoding(\\\"o200k_base\\\")\\n        return len(enc.encode(text))\\n    except Exception:\\n        # Fallback conservative BPE approximation: 1 token ~ 3.5 chars\\n        return int(len(text) / 3.5)\\n\\ntoken_count = count_tokens(help_out) if has_help_op else 9999\\nassert_item(\\n    \\\"helpOpAgentOutputWithin250Tokens\\\",\\n    has_help_op and token_count <= 250,\\n    f\\\"returncode={help_proc.returncode}, token_count={token_count}, output={help_out[:100]}\\\"\\n)\\n\\n\\n# -------------------------------------------------------------------------\\n# Test 5: each :examples entry parses with main.parse_invocation\\n# -------------------------------------------------------------------------\\nexamples = []\\nif agent_block:\\n    m_ex = re.search(r':examples\\\\s*\\\\(', agent_block)\\n    if m_ex:\\n        st_e = m_ex.end() - 1\\n        dep_e = 0\\n        in_str_e = False\\n        is_esc_e = False\\n        ex_sub = \\\"\\\"\\n        for j in range(st_e, len(agent_block)):\\n            c = agent_block[j]\\n            if in_str_e:\\n                if is_esc_e: is_esc_e = False\\n                elif c == '\\\\\\\\': is_esc_e = True\\n                elif c == '\\\"': in_str_e = False\\n                continue\\n            if c == '\\\"': in_str_e = True\\n            elif c == '(': dep_e += 1\\n            elif c == ')':\\n                dep_e -= 1\\n                if dep_e == 0:\\n                    ex_sub = agent_block[st_e:j+1]\\n                    break\\n        for m in re.finditer(r'\\\"((?:[^\\\"\\\\\\\\]|\\\\\\\\.)*)\\\"', ex_sub):\\n            examples.append(m.group(1).replace('\\\\\\\\\\\"', '\\\"').replace('\\\\\\\\\\\\\\\\', '\\\\\\\\'))\\n\\nall_parsed = True\\nparse_details = []\\nfor ex in examples:\\n    parsed = main.parse_invocation(ex, root_dir=ROOT)\\n    if parsed.get(\\\"_syntax_error\\\") or parsed.get(\\\"_unknown_ops\\\"):\\n        all_parsed = False\\n        parse_details.append(f\\\"Failed {ex}: syntax={parsed.get('_syntax_error')}, unknown={parsed.get('_unknown_ops')}\\\")\\n    elif not parsed.get(\\\"task\\\"):\\n        all_parsed = False\\n        parse_details.append(f\\\"Missing task in {ex}\\\")\\n\\nassert_item(\\n    \\\"eachExampleParsesWithMainParseInvocation\\\",\\n    len(examples) >= 2 and all_parsed,\\n    f\\\"examples_count={len(examples)}, errors={parse_details}\\\"\\n)\\n\\n\\n# -------------------------------------------------------------------------\\n# Test 6: each :examples entry with :dryRun true exits 0\\n# -------------------------------------------------------------------------\\nall_dry_ok = True\\ndry_details = []\\nfor ex in examples:\\n    ex_dry = ex\\n    if \\\":dryRun\\\" not in ex_dry:\\n        ex_dry = ex_dry[:-1] + \\\" :dryRun true)\\\"\\n    buf = io.StringIO()\\n    with redirect_stdout(buf):\\n        rc = main.main(ex_dry, ROOT)\\n    out = buf.getvalue()\\n    if rc != 0 or \\\":dryRunReceipt\\\" not in out:\\n        all_dry_ok = False\\n        dry_details.append(f\\\"Failed {ex}: rc={rc}, out={out[:120]}\\\")\\n\\nassert_item(\\n    \\\"eachExampleDryRunExitsZero\\\",\\n    len(examples) >= 2 and all_dry_ok,\\n    f\\\"dry_details={dry_details}\\\"\\n)\\n\\n\\n# -------------------------------------------------------------------------\\n# Test 7: scripts/agentLoop/card.py prints single ASN form generated from code\\n# -------------------------------------------------------------------------\\ncard_py = os.path.join(ROOT, \\\"scripts\\\", \\\"agentLoop\\\", \\\"card.py\\\")\\ncard_proc = subprocess.run(\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"scripts/audit/runner.py\" :start 260 :end 320)" :want "(:read :file \"scripts/audit/runner.py\" :start 260 :end 320 :content \"        return \\\"ERR_VACUOUS_SUITE\\\", 0, 0, \\\"exit 0 without an assertion(s) executed line\\\"\\n    if not fails:\\n        return \\\"ERR_RUNTIME\\\", 0, 0, \\\"exit %d: %s\\\" % (code, (out.strip().splitlines() or [\\\"\\\"])[-1])\\n    at, fail = fails[-1]\\n    asserts, reason, failLine = int(fail.group(2)), fail.group(1), lines[at].strip()\\n    if re.match(r\\\"\\\\d+ load error\\\", reason):\\n        diags = [m for m in (HOST_DIAG.match(l) for l in lines[:at]) if m]\\n        for cls in (\\\"ERR_UNRESOLVED_IMPORT\\\", \\\"ERR_UNKNOWN_SYMBOL\\\", None):\\n            d = next((m for m in diags if cls is None or m.group(2) == cls), None)\\n            if d:\\n                return cls or \\\"ERR_LOAD\\\", asserts, 0, d.group(1) + \\\": \\\" + d.group(2) + d.group(3)\\n        return \\\"ERR_LOAD\\\", asserts, 0, failLine\\n    if reason.startswith(\\\"ERR_TEST_FAILED: zero assertions executed\\\"):\\n        return \\\"ERR_VACUOUS_SUITE\\\", asserts, 0, failLine\\n    if reason.startswith((\\\"ERR_ASSERT:\\\", \\\"ERR_REFUTE:\\\", \\\"ERR_TEST_FAILED:\\\")):\\n        return \\\"ASSERTION_FAILURE\\\", asserts, 0, failLine\\n    return \\\"ERR_RUNTIME\\\", asserts, 0, failLine\\n\\n\\ndef runSuite(snap, suite):\\n    t0 = time.time()\\n    if suite.endswith(\\\".sh\\\"):\\n        return runShellSuite(snap, suite, t0)\\n    code, out = bounded([os.path.join(snap, HOST), \\\"test\\\", suite], snap, dict(os.environ, **{NESTED_ENV: \\\"1\\\"}),\\n                        SLOW_SUITE_TIMEOUT_S.get(suite, SUITE_TIMEOUT_S))\\n    cause, asserts, refutes, failLine = hostVerdict(code, stripSnap(out, snap), suite)\\n    declared = declaredAsserts(os.path.join(snap, suite))\\n    gap = declared - (asserts + refutes)\\n    if cause == \\\"OK\\\" and gap > 0:\\n        cause = \\\"ERR_DECLARED_GAP\\\"\\n        failLine = \\\"gap=\\\" + str(gap)\\n    digest = hashlib.sha256((cause + \\\"\\\\n\\\" + failLine).encode()).hexdigest()[:16] if cause != \\\"OK\\\" else \\\"\\\"\\n    return {\\\"suite\\\": suite, \\\"code\\\": code, \\\"asserts\\\": asserts, \\\"refutes\\\": refutes, \\\"declared\\\": declared,\\n            \\\"failed\\\": 0 if cause == \\\"OK\\\" else 1, \\\"cause\\\": cause, \\\"digest\\\": digest, \\\"failLine\\\": failLine, \\\"ms\\\": int((time.time() - t0) * 1000)}\\n\\n\\ndef bounded(cmd, cwd, env=None, timeout=SUITE_TIMEOUT_S):\\n    proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True, text=True, errors=\\\"replace\\\")\\n    register(proc)\\n    try:\\n        out, _ = proc.communicate(timeout=timeout)\\n        return proc.returncode, out\\n    except subprocess.TimeoutExpired:\\n        os.killpg(proc.pid, signal.SIGKILL)\\n        out, _ = proc.communicate()\\n        return 124, out\\n    finally:\\n        LIVE_PROCS.discard(proc)\\n\\n\\ndef shellVerdict(code, out):\\n    \\\"\\\"\\\"-> (cause, asserts, failLine). The suite's last (:gate ... :asserts n :failed m) line is its assertion\\n    count: no such line or n 0 is ERR_VACUOUS_SUITE, m > 0 is red even on exit 0, a non-zero exit is red.\\\"\\\"\\\"\\n    gates = GATE_LINE.findall(out)\\n    asserts, failed = (int(gates[-1][0]), int(gates[-1][1])) if gates else (0, 0)\\n    gateText = next((l.strip() for l in reversed(out.splitlines()) if GATE_LINE.match(l)), \\\"\\\")\\n    if code == 124:\\n        return \\\"ERR_TIMEOUT\\\", asserts, \\\"timeout\\\"\\n    if code != 0:\\n        return \\\"SHELL_FAILED\\\", asserts, \\\"exit %d: %s\\\" % (code, gateText or (out.strip().splitlines() or [\\\"\\\"])[-1])\\n    if not gates:\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"scripts/agentLoop/loop.py\" :start 2870 :end 2905)" :want "(:read :file \"scripts/agentLoop/loop.py\" :start 2870 :end 2905 :content \"                return line_num, arrived, hint\\n    except (OSError, CoreHostError):\\n        # (:m :why \\\"the arrived line is an aid on a refusal that already carries its message; an unreadable file or form leaves the receipt as it was\\\")\\n        pass\\n    return None, None, None\\n\\n\\ndef _compute_balance_aid(text):\\n    \\\"\\\"\\\"One-sentence ASL delimiter balance report for a would-be file text, or None when it balances.\\n\\n    Skips strings with backslash escapes and ; comments to end of line; tracks ( ) [ ] { }.\\n    \\\"\\\"\\\"\\n    # (:m :why \\\"an ASL item starts at column 0 and closes only its own parens, so balance is judged per item and the report names the item; a whole-file count blamed a later item (S2afix2: line 54 vs top-level 840)\\\")\\n    if not text:\\n        return None\\n    closer_of = {\\\"(\\\": \\\")\\\", \\\"[\\\": \\\"]\\\", \\\"{\\\": \\\"}\\\"}\\n    opener_of = {\\\")\\\": \\\"(\\\", \\\"]\\\": \\\"[\\\", \\\"}\\\": \\\"{\\\"}\\n    lines = text.split(\\\"\\\\n\\\")\\n    in_str = False\\n    stack, item_start, item_head = [], None, \\\"\\\"\\n    for ln, raw in enumerate(lines, 1):\\n        at_col0 = raw[:1] not in (\\\"\\\", \\\" \\\", \\\"\\\\t\\\", \\\";\\\") and not in_str\\n        if at_col0 and not stack:\\n            item_start, item_head = ln, raw.strip()[:40]\\n        elif at_col0 and stack:\\n            opened = stack[0]\\n            return (f\\\"line {opened[1]} opens a {opened[0]} that is never closed: {len(stack)} closer\\\"\\n                    f\\\"{'s' if len(stack) > 1 else ''} missing before line {ln}; its top-level form starts at line {item_start} ({item_head})\\\")\\n        col, i, n = 0, 0, len(raw)\\n        while i < n:\\n            c = raw[i]\\n            col = i + 1\\n            if in_str:\\n                if c == \\\"\\\\\\\\\\\":\\n                    i += 2\\n                    continue\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"code-intel/src/placement.asl\" :start 1 :end 10)" :want "(:read :file \"code-intel/src/placement.asl\" :start 1 :end 4 :content \"(module aslIntel/placement :d \\\"Data Placement Layout Auditor and Token Compaction Diagnostics for ASL Intel\\\" :x [auditFilePlacement] :i [])\\n\\nfn auditFilePlacement filePath: Str content: Str -> Str\\n  (let [(lines (stringSplit content \\\"\\\\n\\\")) (lineCount (listLength lines)) (cSym (stringContains? content \\\":sym\\\")) (cNode (stringContains? content \\\":node\\\")) (cRec (stringContains? content \\\":record\\\")) (c-f (stringContains? content \\\":f \\\")) (hasRecords (or cSym (or cNode (or cRec c-f)))) (recLayout (if hasRecords \\\"columnar\\\" \\\"aos\\\")) (compactionScore (if hasRecords (if (> lineCount 100) 35.5 28.5) 0.0)) (savings (str (stringFromFloat64 compactionScore) \\\"%\\\"))] (str \\\"(:placement-audit\\\\n\\\" \\\"  :target \\\\\\\"\\\" filePath \\\"\\\\\\\"\\\\n\\\" \\\"  :lines \\\" (stringFromInt64 lineCount) \\\"\\\\n\\\" \\\"  :recommended-layout \\\\\\\"\\\" recLayout \\\"\\\\\\\"\\\\n\\\" \\\"  :estimated-savings \\\\\\\"\\\" savings \\\"\\\\\\\"\\\\n\\\" \\\"  :status \\\\\\\"analyzed\\\\\\\"\\\\n\\\" \\\")\\\"))\\n\")\n" :exit 0)
