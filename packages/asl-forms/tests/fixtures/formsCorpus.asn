(:case :src leon :form "(:read :file \"tests/fixtures/agentLoop/mvp/fixEcho.asn\" :limit 30)" :want "(:read :file \"tests/fixtures/agentLoop/mvp/fixEcho.asn\" :content \"(:script :id \\\"fixEcho\\\" :mode :implement\\n  :turns (\\n    (:turn :num 1\\n      :reply \\\"(:step :op \\\\\\\"write\\\\\\\" :file \\\\\\\"echo.txt\\\\\\\" :content \\\\\\\"hello world\\\\\\\") (:evidence (:cmd \\\\\\\"grep -qx 'hello world' echo.txt 2>/dev/null && echo '(:gate :asserts 1 :failed 0)' || { echo '(:gate :asserts 1 :failed 1)'; exit 1; }\\\\\\\" :exit 0))\\\"\\n    )\\n  )\\n)\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tests/fixtures/agentLoop/mvp/resume.asn\" :limit 30)" :want "(:read :file \"tests/fixtures/agentLoop/mvp/resume.asn\" :content \"(:script :id \\\"resume\\\" :mode :implement\\n  :turns (\\n    (:turn :num 1\\n      :reply \\\"(:step :op \\\\\\\"read\\\\\\\" :file \\\\\\\"echo.txt\\\\\\\")\\\"\\n    )\\n    (:turn :num 2\\n      :reply \\\"(:step :op \\\\\\\"edit\\\\\\\" :file \\\\\\\"echo.txt\\\\\\\" :old \\\\\\\"hello\\\\\\\" :new \\\\\\\"greetings\\\\\\\")\\\"\\n    )\\n    (:turn :num 3\\n      :reply \\\"(:step :op \\\\\\\"write\\\\\\\" :file \\\\\\\"echo.txt\\\\\\\" :content \\\\\\\"final greetings\\\\\\\") (:evidence (:cmd \\\\\\\"test -s echo.txt\\\\\\\" :exit 0))\\\"\\n    )\\n  )\\n)\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"asl/agentLoop/coreCli.asl\" :limit 100)" :want "(:read :file \"asl/agentLoop/coreCli.asl\" :truncated true :limit 100 :maxBytes 12000 :totalLines 821 :more (:start 101 :end 821) :content \"(module asl/agentLoop/coreCli\\n  :d \\\"asl-host run asl/agentLoop/coreCli.asl CORPUS: reads netstring cases (<len>:<bytes>; kind, field count, fields) and prints one line per case, <index> <kind> <result>, in the serialisation of tests/acceptance/r1AgentLoop/coreParity.py. scripts/agentLoop/loop.py sends its batches here on /dev/stdin (ASLF stage 2); the kinds window, strip, kv, key, seen, spanSeen, reads, steps, dataFindings, nearest, terminal, gate, note, outward, changePlan, repair and the LP2 claims kinds and LP3 retry/advisor kinds (extractClaims receiptBacks isBacked isProseClaimBacked turnBringsEvidence forgetCutEvidence isTurnObservation unwrapReadTxns mergeFindings wrongCitationNote hasNegatorNear extractProseStrings collectProseStrings batchingRates costForm escalationNear reinforceWhyFor nowForm noWriteNudge gateNow buildRetryBrief advisorSkip parseAdvice parseSpecVerdict digestLine evidenceDigest advisorGateOutput advisorOpLine advisorSummary) and the LP4 gate kinds (gateVerdicts vacuousOutsideOwns isSwallowedExceptLine isPassLine isSingleLineSwallow findSwallowedInAdded scanSwallowed placeholderHit missingGatePaths missingGateFiles gateRunScripts gatePartitionFiles gateVacuousMessage gateRevertVerdict) and LP3b loop kinds (sessionHeader endStatus finalGatesGreen preserveFiles handBackRestore loopBoundary) serve it\\\"\\n  :x [main]\\n  :i [(asl/agentLoop/core :a c) (asl-forms/repair :a rep) (asl/agentLoop/plan :a p) (asl/agentLoop/retry :a r) (asl/agentLoop/claims :a cl) (asl/agentLoop/gates :a g) (asl/agentLoop/diff :a d) (asl/agentLoop/turn :a tr) (asl/agentLoop/loop :a lp)])\\n\\nfn digitsEnd s: String i: Int64 -> Int64\\n  (if (= (c/sliceOf s i (+ i 1)) \\\":\\\") i (digitsEnd s (+ i 1)))\\n\\nfn netString s: String i: Int64 -> (Pair String Int64)\\n  (let [colon (digitsEnd s i)\\n        len (optionOr (stringToInt64 (c/sliceOf s i colon)) -1)]\\n    (pair (c/sliceOf s (+ colon 1) (+ (+ colon 1) len)) (+ (+ colon 1) len)))\\n\\nfn netStrings s: String i: Int64 k: Int64 acc: (List String) -> (Pair (List String) Int64)\\n  (if (= k 0)\\n    (pair (listReverse acc) i)\\n    (mt (netString s i) ((pair v j) (netStrings s j (- k 1) (cons v acc)))))\\n\\nfn toInt s: String -> Int64\\n  (optionOr (stringToInt64 s) 0)\\n\\nfn toFloat s: String -> Float64\\n  (optionOr (stringToFloat64 s) 0.0)\\n\\nfn triples xs: (List String) acc: (List (List String)) -> (List (List String))\\n  (if (listEmpty? xs)\\n    (listReverse acc)\\n    (triples (optionOr (listSlice xs 3 (listLength xs)) (list)) (cons (optionOr (listSlice xs 0 3) (list)) acc)))\\n\\nfn spanPairs xs: (List String) acc: (List (Pair Int64 Int64)) -> (List (Pair Int64 Int64))\\n  (if (listEmpty? xs)\\n    (listReverse acc)\\n    (spanPairs (c/restOf (c/restOf xs)) (cons (pair (toInt (c/firstOf xs)) (toInt (c/firstOf (c/restOf xs)))) acc)))\\n\\nfn arg fs: (List String) i: Int64 -> String\\n  (optionOr (listGet fs i) \\\"\\\")\\n\\nfn coverageRun reads: (List (List String)) -> String\\n  (mt (fold (fn [st r]\\n              (mt st ((pair news cov)\\n                (mt (c/recordRead cov (arg r 0) (toInt (arg r 1)) (toInt (arg r 2)))\\n                  ((pair new cov2) (pair (cons (if new \\\" true\\\" \\\" false\\\") news) cov2))))))\\n        (pair (list) (list)) reads)\\n    ((pair news cov) (str \\\"(new\\\" (c/joinAll (listReverse news)) \\\") \\\" (c/serString (c/renderSeen cov)))))\\n\\nfn restFrom fs: (List String) i: Int64 -> (List String)\\n  (optionOr (listSlice fs i (listLength fs)) (list))\\n\\nfn coverageFields fs: (List String) acc: (List (Pair String (List (Pair Int64 Int64)))) -> (List (Pair String (List (Pair Int64 Int64))))\\n  (if (listEmpty? fs)\\n    (listReverse acc)\\n    (let [k (* 2 (toInt (arg fs 1)))\\n          spans (restFrom fs 2)]\\n      (coverageFields (restFrom spans k)\\n        (cons (pair (c/firstOf fs) (spanPairs (optionOr (listSlice spans 0 k) (list)) (list))) acc))))\\n\\nfn serCoverage cov: (List (Pair String (List (Pair Int64 Int64)))) -> String\\n  (str \\\"(coverage\\\" (c/joinAll (map (fn [e] (mt e ((pair p sp) (str \\\" (\\\" (c/serString p) \\\" \\\" (c/serSpans sp) \\\")\\\")))) cov)) \\\")\\\")\\n\\nfn readsRun reads: (List (List String)) cov0: (List (Pair String (List (Pair Int64 Int64)))) -> String\\n  (mt (fold (fn [st r]\\n              (mt st ((pair news cov)\\n                (mt (c/recordRead cov (arg r 0) (toInt (arg r 1)) (toInt (arg r 2)))\\n                  ((pair new cov2) (pair (cons (if new \\\" true\\\" \\\" false\\\") news) cov2))))))\\n        (pair (list) cov0) reads)\\n    ((pair news cov) (str \\\"(new\\\" (c/joinAll (listReverse news)) \\\") \\\" (serCoverage cov))))\\n\\nfn opFields xs: (List (List String)) -> (List (Pair String c/KvVal))\\n  (map (fn [t] (pair (arg t 0) (c/fieldVal (= (arg t 1) \\\"i\\\") (arg t 2)))) xs)\\n\\nfn boolOf s: String -> Bool\\n  (= s \\\"1\\\")\\n\\nfn chunks xs: (List String) n: Int64 acc: (List (List String)) -> (List (List String))\\n  (if (listEmpty? xs)\\n    (listReverse acc)\\n    (chunks (optionOr (listSlice xs n (listLength xs)) (list)) n (cons (optionOr (listSlice xs 0 n) (list)) acc)))\\n\\n; a gate is 6 flat fields: cmd exit(-1=none) timeout(0/1) seconds(-1=none) stdout stderr\\nfn gateFromFields fs: (List String) -> r/GateRec\\n  (r/makeGateRec (arg fs 0) (toInt (arg fs 1)) (boolOf (arg fs 2)) (toInt (arg fs 3)) (arg fs 4) (arg fs 5))\\n\\nfn gatesFrom fs: (List String) -> (List r/GateRec)\\n  (map gateFromFields (chunks fs 6 (list)))\\n\\n; a receipt is 15 flat fields: id op kind cmd stdout file path symbol query topic url exit(-1=none) status error content\\nfn receiptFromFields fs: (List String) -> r/ReceiptRec\\n  (r/makeReceiptRec (arg fs 0) (arg fs 1) (arg fs 2) (arg fs 3) (arg fs 4) (arg fs 5) (arg fs 6) (arg fs 7)\\n                     (arg fs 8) (arg fs 9) (arg fs 10) (toInt (arg fs 11)) (arg fs 12) (arg fs 13) (arg fs 14))\\n\\nfn receiptsFrom fs: (List String) -> (List r/ReceiptRec)\\n  (map receiptFromFields (chunks fs 15 (list)))\\n\\n; a \\\"kv int\\\" pair is 2 flat fields: key count\\nfn kvIntFromFields fs: (List String) -> (Pair String Int64)\\n  (pair (arg fs 0) (toInt (arg fs 1)))\\n\\nfn kvIntsFrom fs: (List String) -> (List (Pair String Int64))\\n  (map kvIntFromFields (chunks fs 2 (list)))\\n\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \".asl/run/agentLoop\" :limit 10)" :want "(:read :status :rejected :error ERR_FILE_NOT_FOUND :message \"File not found: .asl/run/agentLoop\" :hint \"paths resolve against the workspace root; :nearest, when present, names entries beside the missing one\" :see \"(:help :op read)\")\n" :exit 1)
