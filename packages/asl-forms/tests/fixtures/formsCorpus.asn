\\\" :kind :stage0Host :rationale \\\"R1 stage-0 C11 host, user-approved scaffolding exception to the ASL-first floor; replaced by ASL after R1\\\" :until :R1)\\n  (:path \\\"asl/tools/asl\\\" :kind :machO :rationale \\\"host launcher or tool binary predating R1\\\" :until :none)\\n  (:path \\\"asl/tools/hooks/pre-commit\\\" :kind :shell :rationale \\\"git hook for the standalone asl package\\\" :until :none)\\n  (:path \\\"asl/web/dist/install.sh\\\" :kind :shell :rationale \\\"byte copy of scripts/install.sh checked by the installer identity check\\\" :until :none)\\n  (:path \\\"asl/web/plugins/vitePluginAsl.js\\\" :kind :javascript :rationale \\\"web build configuration under the asl/web justified leaf\\\" :until :none)\\n  (:path \\\"asl/web/public/install.ps1\\\" :kind :powershell :rationale \\\"Turn-0 bootstrap installer for hosts without an asl binary\\\" :until :none)\\n  (:path \\\"asl/web/public/install.sh\\\" :kind :shell :rationale \\\"byte copy of scripts/install.sh checked by the installer identity check\\\" :until :none)\\n  (:path \\\"asl/web/tailwind.config.js\\\" :kind :javascript :rationale \\\"web build configuration under the asl/web justified leaf\\\" :until :none)\\n  (:path \\\"asl/web/vite.config.js\\\" :kind :javascript :rationale \\\"web build configuration under the asl/web justified leaf\\\" :until :none)\\n  (:path \\\"bench/experiments/bench_asl_native_experiment.py\\\" :kind :python :rationale \\\"benchmark experiment script\\\" :until :none)\\n  (:path \\\"bench/experiments/bench_asl_v04_deep_dive.py\\\" :kind :python :rationale \\\"benchmark experiment script\\\" :until :none)\\n  (:path \\\"bench/experiments/bench_asl_v04_experiment.py\\\" :kind :python :rationale \\\"benchmark experiment script\\\" :until :none)\\n  (:path \\\"bench/experiments/bench_gemini_research_comparison.py\\\" :kind :python :rationale \\\"benchmark experiment script\\\" :until :none)\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"asl/packages/asl-transpile/tests/codecTest.asl\" :start 1 :end 10)" :want "(:read :file \"asl/packages/asl-transpile/tests/codecTest.asl\" :start 1 :end 10 :content \"(module asl-transpile/test :d \\\"Unit tests for native JSON codec.\\\" :x [runTests] :i [(asl-transpile/core :a c)])\\n\\nfn testPrimitives -> Bool\\n  (do (assert (= (c/renderJson (c/jsonNull)) \\\"null\\\") \\\"null render\\\") (assert (= (c/renderJson (c/jsonBool true)) \\\"true\\\") \\\"true render\\\") (assert (= (c/renderJson (c/jsonBool false)) \\\"false\\\") \\\"false render\\\") (assert (= (c/renderJson (c/jsonStr \\\"hello\\\")) \\\"\\\\\\\"hello\\\\\\\"\\\") \\\"str render\\\") true)\\n\\nfn testCollections -> Bool\\n  (let [(arr (c/jsonArr (list (c/jsonInt 1) (c/jsonStr \\\"two\\\")))) (obj (c/jsonObj (list (c/makeKv \\\"key\\\" (c/jsonStr \\\"val\\\")))))] (assert (= (c/renderJson arr) \\\"[1,\\\\\\\"two\\\\\\\"]\\\") \\\"array render\\\") (assert (= (c/renderJson obj) \\\"{\\\\\\\"key\\\\\\\":\\\\\\\"val\\\\\\\"}\\\") \\\"object render\\\") true)\\n\\nfn runTests -> Bool\\n  (do (assert (testPrimitives) \\\"test-primitives must pass\\\") (assert (testCollections) \\\"test-collections must pass\\\") true)\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"code-intel/src/extractor.asl\" :start 1 :end 5)" :want "(:read :file \"code-intel/src/extractor.asl\" :start 1 :end 5 :content \"(module aslIntel/extractor :d \\\"Multi-language AST Symbol & Reference Extractor for Code Intelligence\\\" :x [SymbolKind symFn symType symRecord symEnum symMethod symClass symInterface symVariable SymbolDef SymbolRef FileSymbols kindToString stringToKind parseAslTokens extractAslSymbols extractGenericSymbols filterExported])\\n\\n(enum SymbolKind (:c symFn [] \\\"Function symbol\\\") (:c symType [] \\\"Type symbol\\\") (:c symRecord [] \\\"Record symbol\\\") (:c symEnum [] \\\"Enum symbol\\\") (:c symMethod [] \\\"Method symbol\\\") (:c symClass [] \\\"Class symbol\\\") (:c symInterface [] \\\"Interface symbol\\\") (:c symVariable [] \\\"Variable symbol\\\"))\\n\\n(schema StringView (:f source Str \\\"Original source string\\\") (:f start I64 \\\"Start index\\\") (:f length I64 \\\"Length of the view\\\"))\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tools/preCommit.asl\" :start 1 :end 10)" :want "(:read :file \"tools/preCommit.asl\" :start 1 :end 10 :content \"(module aslTools/preCommit :d \\\"Pure AgentSlang Git Pre-Commit Hook & Automated Threshold Enforcement Engine.\\\" :x [main runPreCommit verifyThresholds countDashedIdentifiers countUncompensatedSagas evaluateCommitDiff PreCommitConfig] :i [(asl-proc :a sh)])\\n\\n(schema PreCommitConfig (:f strictTokens Bool \\\"Enforce camelCase tokens on new identifiers\\\") (:f checkConsistency Bool \\\"Enforce ADR and task consistency\\\") (:f maxComplexity I64 \\\"Maximum allowed function complexity\\\"))\\n\\nfn isDashedIdentifier? name: Str -> Bool\\n  (let [(clean (stringTrim name))] (and (stringContains? clean \\\"-\\\") (not (stringStartsWith? clean \\\":\\\")) (not (stringStartsWith? clean \\\"--\\\")) (not (= clean \\\"->\\\")) (not (= clean \\\"-\\\"))))\\n\\nfn extractFnNameFromLine line: Str -> Str\\n  (let [(trimmed (stringTrim line)) (afterPlus (if (stringStartsWith? trimmed \\\"+\\\") (stringTrim (optionOr (stringSlice trimmed 1 (stringLength trimmed)) \\\"\\\")) trimmed))] (cond ((stringStartsWith? afterPlus \\\"fn ! \\\") (let [(restS (stringTrim (optionOr (stringSlice afterPlus 5 (stringLength afterPlus)) \\\"\\\"))) (parts (stringSplit restS \\\" \\\"))] (optionOr (listHead parts) \\\"\\\"))) ((stringStartsWith? afterPlus \\\"fn \\\") (let [(restS (stringTrim (optionOr (stringSlice afterPlus 3 (stringLength afterPlus)) \\\"\\\"))) (parts (stringSplit restS \\\" \\\"))] (optionOr (listHead parts) \\\"\\\"))) ((stringStartsWith? afterPlus \\\"(fn ! \\\") (let [(restS (stringTrim (optionOr (stringSlice afterPlus 6 (stringLength afterPlus)) \\\"\\\"))) (parts (stringSplit restS \\\" \\\"))] (optionOr (listHead parts) \\\"\\\"))) ((stringStartsWith? afterPlus \\\"(fn \\\") (let [(restS (stringTrim (optionOr (stringSlice afterPlus 4 (stringLength afterPlus)) \\\"\\\"))) (parts (stringSplit restS \\\" \\\"))] (optionOr (listHead parts) \\\"\\\"))) (else \\\"\\\")))\\n\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"asl/packages/asl-proc/tests/tmpTest.asl\" :start 1 :end 30)" :want "(:read :file \"asl/packages/asl-proc/tests/tmpTest.asl\" :start 1 :end 14 :content \"(module asl-proc/tmpTest :x [runTests] :i [(asl-proc/process :a proc) (reducer :a red) (sh :a sh) (apm :a apm) (spool :a spool)])\\n\\nfn ! testOobStreamDemuxMemoryBound -> Bool\\n  (let [(spoolPathRes (spool/reserveSpoolPath! \\\"oob-100mb\\\" 0))]\\n    (do\\n      (assert (ok? spoolPathRes) \\\"reserve-spool-path! must succeed\\\")\\n      (let [(spoolPath (resultOr spoolPathRes \\\"\\\")) (demuxer0 (apm/makeOobDemuxer spoolPath 67108864)) (finishRes (apm/oobDemuxFinish demuxer0 0 1200))]\\n        (do\\n          (assert (ok? finishRes) \\\"oob-demux-finish! must succeed\\\")\\n          (assert (mt finishRes ((ok receipt) (and (= (.-exitCode receipt) 0) (= (.-durationMs receipt) 1200))) ((err _) false)) \\\"an unterminated demuxer finishes with the exit code it was given and keeps the duration\\\")\\n          (let [(_ (mt finishRes ((ok receipt) (spool/spoolPathRelease! (.-spoolPath receipt))) ((err _) (err \\\"no receipt\\\"))))] true)))))\\n\\nfn ! runTests -> Bool\\n  (testOobStreamDemuxMemoryBound)\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"asl/packages/asl-checker/src/resolve.asl\" :start 1 :end 80)" :want "(:read :file \"asl/packages/asl-checker/src/resolve.asl\" :start 1 :end 80 :content \"(module asl-checker/resolve :d \\\"Pass 1 & Pass 2 Symbol Resolution, Module Scoping, and Semantic Rules.\\\" :x [FunSummary SchemaSummary EnumSummary CaseSummary FieldSummary ModuleSummary emptyModuleSummary bodyPosAt placeDiags cleanNumSign collectSummary firstCharStr firstExprEmpty firstExprUnit firstExprVect firstHeadIdent firstVectItems isLiteralAtom? listAppendOne loadModuleDeps! loadModuleClosure! parentDirOf resolveImport! emptyModIndex ModIndex Resolution ResStatus ModuleClosure mapValuesList modEnum modFun modImport matchFamily ctorPatternAtom? unreachableArmDiags modSchema resolveDepTarget resolveModule safeTail secondExprEmpty sexprToList sliceFrom withImports] :i [(types :a ty) (ast :a a) (reader :a rd)])\\n\\n(schema FunSummary (:f name String \\\"Function name\\\") (:f params (List (pair String String)) \\\"Parameter name and type pairs\\\") (:f ret String \\\"Return type annotation\\\") (:f typevars (List String) \\\"Type variables bound in signature\\\") (:f hasDoc Bool \\\"True if docstring is present\\\") (:f effect Bool \\\"True if marked with !\\\"))\\n\\n(schema FieldSummary (:f name String \\\"Field name\\\") (:f type String \\\"Field type annotation\\\") (:f hasDefault Bool \\\"True if field has default\\\"))\\n\\n(schema SchemaSummary (:f name String \\\"Schema name\\\") (:f typevars (List String) \\\"Bound type variables\\\") (:f fields (List FieldSummary) \\\"Schema fields\\\"))\\n\\n(schema CaseSummary (:f name String \\\"Enum case name\\\") (:f params (List (pair String String)) \\\"Case parameters\\\"))\\n\\n(schema EnumSummary (:f name String \\\"Enum name\\\") (:f typevars (List String) \\\"Bound type variables\\\") (:f cases (List CaseSummary) \\\"Enum cases\\\"))\\n\\n(schema ModuleSummary (:f name String \\\"Module name\\\") (:f path String \\\"Source file path\\\") (:f hasHeader Bool \\\"True if header form exists\\\") (:f hasDoc Bool \\\"True if module docstring exists\\\") (:f exports (List String) \\\"Exported function names\\\") (:f exportedTypes (List String) \\\"Exported PascalCase type names\\\") (:f imports (Map String String) \\\"Import alias to module path mapping\\\") (:f funs (Map String FunSummary) \\\"Function summaries\\\") (:f schemas (Map String SchemaSummary) \\\"Schema summaries\\\") (:f enums (Map String EnumSummary) \\\"Enum summaries\\\") (:f caseOwner (Map String String) \\\"Case name to owning enum name mapping\\\") (:f exportedCases (Map String String) \\\"Exported case name to enum name mapping\\\") (:f exportedFields (Map String Bool) \\\"Exported record field names\\\"))\\n\\nfn emptyModuleSummary -> ModuleSummary\\n  :d \\\"A ModuleSummary with no name, exports or declarations.\\\"\\n  (ModuleSummary :name \\\"\\\" :path \\\"\\\" :hasHeader false :hasDoc false :exports (list) :exportedTypes (list) :imports (mapEmpty) :funs (mapEmpty) :schemas (mapEmpty) :enums (mapEmpty) :caseOwner (mapEmpty) :exportedCases (mapEmpty) :exportedFields (mapEmpty))\\n\\nfn firstCharStr s: String -> String\\n  :d \\\"The first byte of a string, empty for an empty string.\\\"\\n  (optionOr (stringSlice s 0 1) \\\"\\\")\\n\\nfn sliceFrom s: String start: Int64 -> String\\n  :d \\\"The suffix of s from byte start, s itself when out of range.\\\"\\n  (optionOr (stringSlice s start (stringLength s)) s)\\n\\nfn isPascalName? s: String -> Bool\\n  (if (stringEmpty? s) false (stringContains? \\\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\\\" (firstCharStr s)))\\n\\nfn isQualifiedName? s: String -> Bool\\n  (and (not (= s \\\"/\\\")) (and (not (stringStartsWith? s \\\"/\\\")) (stringContains? s \\\"/\\\")))\\n\\nfn makeDiag code: String msg: String path: String -> ty/Diagnostic\\n  (ty/Diagnostic :code code :message msg :msg msg :line 1 :col 1 :path path)\\n\\nfn collectFieldsStep fields: (List a/AstField) idx: Int64 len: Int64 acc: (List FieldSummary) -> (List FieldSummary)\\n  (if (>= idx len) acc (let [(f (optionOr (listGet fields idx) (a/AstField :name \\\"\\\" :type \\\"\\\" :docstring \\\"\\\" :default (none) :json (none)))) (s (FieldSummary :name (.-name f) :type (.-type f) :hasDefault (some? (.-default f))))] (collectFieldsStep fields (+ idx 1) len (listAppend acc (list s)))))\\n\\nfn collectFields fields: (List a/AstField) -> (List FieldSummary)\\n  (collectFieldsStep fields 0 (listLength fields) (list))\\n\\nfn collectParamsStep params: (List a/Param) idx: Int64 len: Int64 acc: (List (Pair String String)) -> (List (Pair String String))\\n  (if (>= idx len) acc (let [(p (optionOr (listGet params idx) (a/Param :name \\\"\\\" :type \\\"\\\")))] (collectParamsStep params (+ idx 1) len (listAppend acc (list (pair (.-name p) (.-type p)))))))\\n\\nfn collectCaseParams params: (List a/Param) -> (List (Pair String String))\\n  (collectParamsStep params 0 (listLength params) (list))\\n\\nfn collectCasesStep cases: (List a/EnumCase) idx: Int64 len: Int64 acc: (List CaseSummary) -> (List CaseSummary)\\n  (if (>= idx len) acc (let [(c (optionOr (listGet cases idx) (a/EnumCase :name \\\"\\\" :fields (list) :docstring \\\"\\\"))) (s (CaseSummary :name (.-name c) :params (collectCaseParams (.-fields c))))] (collectCasesStep cases (+ idx 1) len (listAppend acc (list s)))))\\n\\nfn collectCases cases: (List a/EnumCase) -> (List CaseSummary)\\n  (collectCasesStep cases 0 (listLength cases) (list))\\n\\nfn collectFunParams params: (List a/Param) -> (List (Pair String String))\\n  (collectParamsStep params 0 (listLength params) (list))\\n\\nfn collectSummary forms: (List a/TopForm) path: String -> ModuleSummary\\n  :d \\\"The module summary of parsed forms: header, exports, imports, functions, schemas and enums.\\\"\\n  (let [(modHeader (fold (fn [(acc (Option a/ModuleNode)) (form a/TopForm)] -> (Option a/ModuleNode) (mt form ((a/topModule m) (some m)) (_ acc))) (none) forms)) (hasHdr (mt modHeader ((some _) true) ((none) false))) (hdrDoc (mt modHeader ((some m) (not (stringEmpty? (.-docstring m)))) ((none) false))) (modName (mt modHeader ((some m) (let [(p (.-path m))] (if (stringEmpty? p) path p))) ((none) path))) (rawExports (mt modHeader ((some m) (.-exported m)) ((none) (list)))) (exports (filter (fn [(e String)] -> Bool (not (isPascalName? e))) rawExports)) (exportedTypes (filter (fn [(e String)] -> Bool (isPascalName? e)) rawExports)) (importsList (mt modHeader ((some m) (.-imports m)) ((none) (list)))) (importsMap (fold (fn [(acc (Map String String)) (p (pair String String))] -> (Map String String) (mapSet acc (pairSecond p) (pairFirst p))) (mapEmpty) importsList)) (funsMap (fold (fn [(acc (Map String FunSummary)) (form a/TopForm)] -> (Map String FunSummary) (mt form ((a/topDefun d) (let [(fparams (collectFunParams (.-params d))) (pTypes (map pairSecond fparams)) (tvars (if (listEmpty? (.-typeVars d)) (ty/collectTvars pTypes (.-retType d)) (.-typeVars d)))] (mapSet acc (.-name d) (FunSummary :name (.-name d) :params fparams :ret (.-retType d) :typevars tvars :hasDoc (not (stringEmpty? (.-docstring d))) :effect (.-effect d))))) (_ acc))) (mapEmpty) forms)) (schemasMap (fold (fn [(acc (Map String SchemaSummary)) (form a/TopForm)] -> (Map String SchemaSummary) (mt form ((a/topSchema s) (mapSet acc (.-name s) (SchemaSummary :name (.-name s) :typevars (.-typeVars s) :fields (collectFields (.-fields s))))) (_ acc))) (mapEmpty) forms)) (enumsMap (fold (fn [(acc (Map String EnumSummary)) (form a/TopForm)] -> (Map String EnumSummary) (mt form ((a/topEnum e) (mapSet acc (.-name e) (EnumSummary :name (.-name e) :typevars (.-typeVars e) :cases (collectCases (.-cases e))))) (_ acc))) (mapEmpty) forms)) (caseOwnerMap (fold (fn [(acc (Map String String)) (form a/TopForm)] -> (Map String String) (mt form ((a/topEnum e) (fold (fn [(cacc (Map String String)) (c a/EnumCase)] -> (Map String String) (mapSet cacc (.-name c) (.-name e))) acc (.-cases e))) (_ acc))) (mapEmpty) forms)) (expCases (fold (fn [(acc (Map String String)) (tname String)] -> (Map String String) (mt (mapGet enumsMap tname) ((some esum) (fold (fn [(cacc (Map String String)) (c CaseSummary)] -> (Map String String) (mapSet cacc (.-name c) tname)) acc (.-cases esum))) ((none) acc))) (mapEmpty) exportedTypes)) (expFields (fold (fn [(acc (Map String Bool)) (tname String)] -> (Map String Bool) (mt (mapGet schemasMap tname) ((some ssum) (addFieldsToSet acc (.-fields ssum))) ((none) acc))) (mapEmpty) exportedTypes))] (ModuleSummary :name modName :path path :hasHeader hasHdr :hasDoc hdrDoc :exports exports :exportedTypes exportedTypes :imports importsMap :funs funsMap :schemas schemasMap :enums enumsMap :caseOwner caseOwnerMap :exportedCases expCases :exportedFields expFields))\\n\\nfn addFieldsToSet facc: (Map String Bool) fields: (List FieldSummary) -> (Map String Bool)\\n  (fold (fn [(acc (Map String Bool)) (f FieldSummary)] -> (Map String Bool) (mapSet acc (.-name f) true)) facc fields)\\n\\nfn safeTail l: (List T) -> (List T)\\n  :d \\\"All but the first element, empty for an empty list.\\\"\\n  (if (listEmpty? l) (list) (mt (listTail l) ((some r) r) ((none) (list))))\\n\\nfn firstExprEmpty l: (List rd/SExpr) -> rd/SExpr\\n  :d \\\"The first expression, or an empty atom.\\\"\\n  (mt (listHead l) ((some h) h) ((none) (rd/makeAtom \\\"\\\")))\\n\\nfn firstExprUnit l: (List rd/SExpr) -> rd/SExpr\\n  :d \\\"The first expression, or the unit atom ().\\\"\\n  (mt (listHead l) ((some h) h) ((none) (rd/makeAtom \\\"()\\\")))\\n\\nfn firstExprVect l: (List rd/SExpr) -> rd/SExpr\\n  :d \\\"The first expression, or an empty vector.\\\"\\n  (mt (listHead l) ((some b) b) ((none) (rd/makeVect (list))))\\n\\nfn sexprToList e: rd/SExpr -> (List rd/SExpr)\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"asl/agentLoop/core.asl\" :start 45 :end 70)" :want "(:read :file \"asl/agentLoop/core.asl\" :start 45 :end 70 :content \"  (if (and (< i n) (test (ch s i))) (runEnd s n (+ i 1) test) i)\\n\\nfn joinPairs xs: (List String) acc: (List String) -> (List String)\\n  (cond\\n    ((listEmpty? xs) (listReverse acc))\\n    ((listEmpty? (restOf xs)) (listReverse (cons (firstOf xs) acc)))\\n    (else (joinPairs (restOf (restOf xs)) (cons (stringConcat (firstOf xs) (firstOf (restOf xs))) acc))))\\n\\nfn joinAll xs: (List String) -> String\\n  (cond\\n    ((listEmpty? xs) \\\"\\\")\\n    ((listEmpty? (restOf xs)) (firstOf xs))\\n    (else (joinAll (joinPairs xs (list)))))\\n\\nfn joinSep xs: (List String) sep: String -> String\\n  (if (listEmpty? xs) \\\"\\\"\\n    (joinAll (cons (firstOf xs) (fold (fn [acc x] (cons sep (cons x acc))) (list) (listReverse (restOf xs))))))\\n\\nfn mapBytes s: String n: Int64 i: Int64 start: Int64 table: (fn [String] -> String) acc: (List String) -> String\\n  (if (>= i n)\\n    (joinAll (listReverse (cons (sliceOf s start n) acc)))\\n    (let [m (table (ch s i))]\\n      (if (= m \\\"\\\")\\n        (mapBytes s n (+ i 1) start table acc)\\n        (mapBytes s n (+ i 1) (+ i 1) table (cons m (cons (sliceOf s start i) acc))))))\\n\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"asl/packages/asl-transpile/src/core/asn.asl\" :start 1 :end 30)" :want "(:read :file \"asl/packages/asl-transpile/src/core/asn.asl\" :start 1 :end 30 :content \"(module asl-transpile/asn :d \\\"ASN reader and writer in pure AgentSlang. Normative source: docs/ASN_SPEC.md.\\n\\n  The token stream comes from packages/asl-parser's lexer rather than a second\\n  scanner: ASN's whole claim is that it shares AGENT_SPEC_CORE.md section 2's\\n  lexical structure, and two scanners would be two answers to what a token is.\\n  What is NOT reused is asl-parser's ast.asl reader, which normalises a Nano atom\\n  to its verbose spelling: right for a program, wrong for data, because an ASN key\\n  spelled :f is a field called f and must survive as one.\\\" :x [AsnValue AsnEntry AsnField asnRead asnWrite valueOk? isVec? isKw? vecItems asnIntValue asnFloatValue asnStringValue] :i [(lexer :a lx) (asl-text/text :a txt)])\\n\\n(schema AsnField (:f key String \\\"Field key, including its leading colon\\\") (:f val AsnValue \\\"Field value\\\"))\\n\\n(schema AsnEntry (:f key AsnValue \\\"Entry key: a string, integer, boolean or keyword scalar\\\") (:f val AsnValue \\\"Entry value\\\") (:f paren Bool \\\"True when the source wrote the parenthesised entry form\\\"))\\n\\n(enum AsnValue (:c asnNil [] \\\"The nil sentinel `_`\\\") (:c asnBool [(b Bool)] \\\"true or false\\\") (:c asnUnit [] \\\"The unit literal `()`\\\") (:c asnInt [(lex String)] \\\"Integer literal, held as its source lexeme\\\") (:c asnFloat [(lex String)] \\\"Float literal, held as its source lexeme\\\") (:c asnStr [(lex String)] \\\"String literal, held as its source lexeme with quotes\\\") (:c asnKw [(k String)] \\\"Keyword scalar, including its leading colon\\\") (:c asnSym [(name String)] \\\"A bare name. Legal as a head, never as a value\\\") (:c asnVec [(items (List AsnValue))] \\\"A bracketed vector\\\") (:c asnMap [(entries (List AsnEntry))] \\\"A brace map\\\") (:c asnRec [(fields (List AsnField))] \\\"An anonymous record `(:k v ...)`\\\") (:c asnCtor [(name String) (fields (List AsnField))] \\\"Named construction `(Name :k v ...)`\\\") (:c asnRows [(name String) (rows (List AsnValue))] \\\"Schema-grouped rows `(Name [..] ..)`\\\") (:c asnTable [(cols (List AsnValue)) (rows (List AsnValue))] \\\"Ad-hoc table `([:c ..] [[..]])`\\\") (:c asnCase [(name String) (args (List AsnValue))] \\\"Union case value `(name v ..)`\\\") (:c asnPair [(key AsnValue) (val AsnValue)] \\\"A parenthesised map entry, legal only in a map\\\"))\\n\\nfn valueOk? v: AsnValue -> Bool\\n  (mt v ((asnSym _) false) ((asnPair _ _) false) (_ true))\\n\\nfn asnIntValue v: AsnValue -> (Option Int64)\\n  (mt v ((asnInt lex) (stringToInt64 lex)) (_ (none)))\\n\\nfn asnFloatValue v: AsnValue -> (Option Float64)\\n  (mt v ((asnFloat lex) (stringToFloat64 lex)) (_ (none)))\\n\\nfn asnStringValue v: AsnValue -> (Option String)\\n  (mt v ((asnStr lex) (some (unescape (txt/stripQuotes lex)))) (_ (none)))\\n\\n(schema UnState (:f out (List String) \\\"Decoded characters, most recent first\\\") (:f esc Bool \\\"True when the previous character was a backslash\\\"))\\n\\nfn escapeChar c: String -> String\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"code-intel/tests/placementTest.asl\")" :want "(:read :file \"code-intel/tests/placementTest.asl\" :content \"(module aslIntel/tests/placementTest :x [runTests] :i [(placement :a p)])\\n\\nfn runTests -> Bool\\n  (let [(repRec (p/auditFilePlacement \\\"schema.asl\\\" \\\":record Point (:f x I64) (:f y I64)\\\"))\\n        (repPlain (p/auditFilePlacement \\\"math.asl\\\" \\\"fn add a: I64 b: I64 -> I64\\\\n  (+ a b)\\\"))]\\n    (assert (stringContains? repRec \\\"recommended-layout \\\\\\\"columnar\\\\\\\"\\\") \\\"Record file must recommend columnar\\\")\\n    (assert (stringContains? repPlain \\\"recommended-layout \\\\\\\"aos\\\\\\\"\\\") \\\"Plain file must recommend aos\\\")\\n    (assert (stringContains? repPlain \\\"estimated-savings \\\\\\\"0.0%\\\\\\\"\\\") \\\"Plain file must have 0% savings\\\")\\n    (assert (stringContains? repRec \\\":status \\\\\\\"analyzed\\\\\\\"\\\") \\\"Report must carry analyzed status\\\")\\n    true)\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"asl/packages/asl-ir/src/lower.asl\")" :want "(:read :file \"asl/packages/asl-ir/src/lower.asl\" :truncated true :limit 200 :maxBytes 12000 :totalLines 1418 :more (:start 89 :end 1418) :content \"(module asl-ir/lower :d \\\"AST to SSA lowering for the core subset (plan SH units I2, I2b and I2c): Int64, Float64, Bool, String, keyword and unit literals, strings unescaped as the host reader does; the arithmetic and comparison builtins and the host C-floor builtins, + and * over more than two operands as a left fold, unary minus; assert and refute, special forms in the host, as a builtin call with the condition and the optional message; if; cond, which gives unit when no clause holds and no else ends it, as the host does; and/or short-circuiting through branches; sequential let, its bindings as (name expr) pairs or flat name expr pairs; do; a vector literal as a list; direct calls of module functions, recursion included; module enum constructors and the prelude some, none, ok and err as construct, a nullary constructor atom included, with Option and Result declared only when used; an unqualified constructor of an imported enum when exactly one import declares it; match over one enum as a tag switch whose constructor arms, bare or applied, bind payload names by variant-field, whose arm _, else, :else or a name is the default, any arms after it unreachable and dropped as in the host, and which, like the host, traps through an unreachable block when neither exhaustive nor defaulted or when it has no arms; schema construction by :field pairs, evaluated in source order and stored in declared order; .-field access; list literals; (fn [params] body) lambdas lifted to module functions named <declaration>@lambda<n>, a spelling the lexer rejects in source, with free variables in first-use order as make-closure captures, nested lambdas capturing transitively; a module function used as a value as a capture-free make-closure, a builtin or constructor used as a value as a lifted wrapper lambda; a call through a local name or a computed head as call-closure; listSortBy, optionMap, resultMap and resultMapErr, and the prelude map, filter and fold, taking the closure Val; a let-bound lambda calling itself is a diagnostic. An enum case's field count skips the nameless field the indent dialect's (list ...) rendering of the field vector adds. Values are typed: Int64, Float64 and Bool annotations give a function a raw signature, every main staying Val as the program entry; literals are raw; arithmetic and comparison over raw operands of one type are raw primitives that fail as the host does (a Val operand of an Int or Float operation is unboxed, since Int and Float never mix), a builtin with a runtime entry is an opEntry typed by builtinEntry, any other a builtin over boxed operands; values are boxed at lists, constructors, records, closure calls and captures and Val parameters, unboxed with a run-time check where a raw type is needed, and a box or unbox made for a value is undone by reusing its source; a join takes the raw type its arms share when every arm has it, and is Val when any arm is Val; (optionOr (listHead xs) d), its kin over listTail, listGet and stringSlice, and a match on (listHead xs) or (listTail xs) never build the Option; a module function with a raw signature used as a value is a lifted Val wrapper, and a lambda unboxes its captures and annotated parameters on entry. Strings are unescaped and interned once in the module string pool. An if or cond closes the open block with a branch and joins its arms in one block whose parameter carries the result. Anything outside the subset is an IrDiag naming the construct and the function with its declaration line:col, and every failing declaration reports; the parser keeps positions per declaration only, so a construct inside a body is located by its function. lowerLinked lowers one module of a linked closure (plan SH unit M1): its functions, lifted lambdas, enums and schemas are named <module>.<name>; alias/name calls, function values, constructors, patterns and schema constructions resolve through the LinkScope imports to exported declarations, an unknown alias or an unexported name being a diagnostic; prelude enums are visible unqualified below the module's own names, prelude functions below the builtins of the subset\\\" :x [LinkScope lowerModule lowerWithPrelude lowerLinked lowerSource declPositions builtinArity] :i [(asl-ir/types :a ty) (asl-parser/ast :a ast) (asl-parser/reader :a rd)])\\n\\n(schema Ctor (:f typeName String \\\"Enum declaring the variant, qualified by its module when linking\\\") (:f variant String \\\"Variant name as declared\\\") (:f arity Int64 \\\"Payload field count\\\"))\\n\\n(schema ModInfo\\n  (:f arities (Map String Int64) \\\"Callable functions by source name, own and alias/name imported, to parameter count\\\")\\n  (:f late (Map String Int64) \\\"Prelude functions by name when linking, consulted after the builtins of the subset\\\")\\n  (:f ctors (Map String Ctor) \\\"Variant constructors by source name, module enums over the prelude Option and Result\\\")\\n  (:f records (Map String (List String)) \\\"Schemas by source name, fields in declared order\\\")\\n  (:f defaults (Map String (Map String rd/SExpr)) \\\"Schema defaults: schema name to map of field to default expression\\\")\\n  (:f types (List ty/SsaTypeDecl) \\\"Module enums in source order\\\")\\n  (:f targets (Map String String) \\\"Function and schema source names to their symbols; a name absent here is its own symbol\\\")\\n  (:f foreign (List ty/SsaTypeDecl) \\\"Imported and prelude enums, for match exhaustiveness\\\")\\n  (:f aliases (Map String String) \\\"Import alias to module name, when linking\\\")\\n  (:f hidden (Map String String) \\\"alias/name of a declaration its module does not export, to that module\\\")\\n  (:f linked Bool \\\"Lowered as part of a linked closure\\\")\\n  (:f sigs (Map String FnSig) \\\"Signature of each callable by source name, own and imported over the prelude\\\"))\\n\\n(schema FnSig (:f params (List ty/SsaTy) \\\"Parameter types\\\") (:f ret ty/SsaTy \\\"Return type\\\"))\\n\\n(schema LinkScope\\n  (:f path String \\\"Source file, prefixed to declaration positions\\\")\\n  (:f imports (Map String (List ast/TopForm)) \\\"Forms of each imported module by import alias\\\")\\n  (:f prelude (List ast/TopForm) \\\"Prelude forms, visible unqualified below the module's own names and the builtins of the subset; empty for the prelude itself\\\")\\n  (:f strings (List String) \\\"String pool the module extends\\\")\\n  (:f only (Option (List String)) \\\"Declarations to lower, every one when none\\\"))\\n\\n(schema LowerCtx (:f fnName String \\\"Declaration being lowered\\\") (:f pos String \\\"Its line:col, or ? when the source is not known\\\") (:f info ModInfo \\\"Module declarations\\\"))\\n\\n(schema Arm (:f kind String \\\"ctor, wild or var\\\") (:f variant String \\\"Variant of a ctor arm, as declared\\\") (:f typeName String \\\"Enum of a ctor arm\\\") (:f binds (List String) \\\"Payload names of a ctor arm, _ for an unbound field\\\") (:f name String \\\"Name a var arm binds to the scrutinee\\\") (:f body (List rd/SExpr) \\\"Arm body forms\\\"))\\n\\n(schema KeyedExpr (:f key String \\\"Field name without its colon\\\") (:f expr rd/SExpr \\\"Value expression\\\"))\\n\\n(schema LowerState\\n  (:f next Int64 \\\"Next value number\\\")\\n  (:f labels Int64 \\\"Next if or cond number\\\")\\n  (:f strings (List String) \\\"Module string pool\\\")\\n  (:f done (List ty/SsaBlock) \\\"Finished blocks, latest first\\\")\\n  (:f label String \\\"Label of the open block\\\")\\n  (:f params (List ty/SsaParam) \\\"Parameters of the open block\\\")\\n  (:f instrs (List ty/SsaInstr) \\\"Instructions of the open block, latest first\\\")\\n  (:f lifted (List ty/SsaFunction) \\\"Lambdas of the declaration lifted to module functions, innermost first\\\")\\n  (:f lambdas Int64 \\\"Next lambda number in the declaration\\\")\\n  (:f types (Map String ty/SsaTy) \\\"Type of each value of the declaration that is raw; any other value is Val\\\")\\n  (:f twins (Map String String) \\\"Each value a box or unbox made to the value it came from, which dominates it and is reused instead of converting back\\\"))\\n\\n(schema Lowered (:f st LowerState \\\"State after lowering\\\") (:f value String \\\"Value holding the result\\\"))\\n\\n(schema LoweredList (:f st LowerState \\\"State after lowering\\\") (:f values (List String) \\\"Values holding the results, in order\\\"))\\n\\n(schema Bound (:f st LowerState \\\"State after the bindings\\\") (:f env (Map String String) \\\"Source names to value names\\\"))\\n\\n(schema LoweredFn (:f function ty/SsaFunction \\\"The lowered function\\\") (:f lifted (List ty/SsaFunction) \\\"Its lambdas as module functions\\\") (:f strings (List String) \\\"String pool after it\\\"))\\n\\n(schema Lambda (:f params (List String) \\\"Parameter names\\\") (:f types (List ty/SsaTy) \\\"Type each parameter's annotation names, Val when it names no raw type\\\") (:f body (List rd/SExpr) \\\"Body forms\\\"))\\n\\n(schema ModAcc (:f strings (List String) \\\"String pool\\\") (:f functions (List ty/SsaFunction) \\\"Lowered functions, in source order\\\") (:f diags (List ty/IrDiag) \\\"Diagnostics, in source order\\\"))\\n\\nfn builtinArity name: String -> (Option Int64)\\n  :d \\\"Operand count of a builtin the lowering emits as opBuiltin, -1 when variadic, none when the name is not one. Only builtins the host defines in C: a prelude function lowers from prelude.asl source, since asl_rt_builtin would load prelude.asl at run time for it.\\\"\\n  (mapGet (mapFromPairs (list (pair \\\"+\\\" 2) (pair \\\"-\\\" 2) (pair \\\"*\\\" 2) (pair \\\"/\\\" 2) (pair \\\"mod\\\" 2)\\n                                 (pair \\\"<\\\" 2) (pair \\\"<=\\\" 2) (pair \\\">\\\" 2) (pair \\\">=\\\" 2) (pair \\\"=\\\" 2) (pair \\\"!=\\\" 2) (pair \\\"not\\\" 1)\\n                                 (pair \\\"abs\\\" 1) (pair \\\"min\\\" 2) (pair \\\"max\\\" 2) (pair \\\"trap\\\" 2)\\n                                 (pair \\\"str\\\" -1) (pair \\\"stringConcat\\\" 2) (pair \\\"stringLength\\\" 1) (pair \\\"stringFromInt64\\\" 1)\\n                                 (pair \\\"print\\\" -1) (pair \\\"println\\\" -1)\\n                                 (pair \\\"parMap\\\" 3) (pair \\\"parFold\\\" 5)\\n                                 (pair \\\"listTail\\\" 1) (pair \\\"listHead\\\" 1) (pair \\\"listEmpty?\\\" 1) (pair \\\"cons\\\" 2)\\n                                 (pair \\\"stringSlice\\\" 3) (pair \\\"stringFromFloat64\\\" 1) (pair \\\"stringToFloat64\\\" 1) (pair \\\"int64ToFloat64\\\" 1) (pair \\\"float64ToInt64\\\" 1)\\n                                 (pair \\\"floatNan\\\" 0) (pair \\\"floatInf\\\" 0) (pair \\\"floatNegInf\\\" 0)\\n                                 (pair \\\"fileReadBytes\\\" 1) (pair \\\"fileReadString\\\" 1) (pair \\\"realPath\\\" 1) (pair \\\"fileReadlink\\\" 1) (pair \\\"zstdDecompress\\\" 1) (pair \\\"bytesSha256\\\" 1) (pair \\\"bytesLength\\\" 1)\\n                                 (pair \\\"stringStartsWith?\\\" 2) (pair \\\"stringContains?\\\" 2) (pair \\\"eprintln\\\" -1)\\n                                 (pair \\\"fileWrite\\\" 2) (pair \\\"fileAppend\\\" 2) (pair \\\"fileLock\\\" 2) (pair \\\"fileLockWait\\\" -1) (pair \\\"dirList\\\" 1) (pair \\\"fileStat\\\" 1) (pair \\\"processRun\\\" 1)\\n                                 (pair \\\"bytesAlloc\\\" 1) (pair \\\"bytesGet\\\" 2) (pair \\\"bytesSet\\\" 3) (pair \\\"bytesGetFloat64\\\" 2) (pair \\\"bytesSetFloat64\\\" 3) (pair \\\"stringToBytes\\\" 1)\\n                                 (pair \\\"i64ArrayLen\\\" 1) (pair \\\"i64ArrayGet\\\" 2) (pair \\\"i64ArrayConcat\\\" 1) (pair \\\"i64ArrayGenerate\\\" 2) (pair \\\"envGet\\\" 1)\\n                                 (pair \\\"dirCreate\\\" 1) (pair \\\"pathRemove\\\" 1) (pair \\\"pathRename\\\" 2) (pair \\\"monotonicNs\\\" 0) (pair \\\"nowNs\\\" 0)\\n                                 (pair \\\"fdRead\\\" 2) (pair \\\"fdWrite\\\" 2) (pair \\\"fdClose\\\" 1) (pair \\\"envList\\\" 0)\\n                                 (pair \\\"procSpawnv\\\" 3) (pair \\\"procPoll\\\" 3) (pair \\\"procExecv\\\" 2) (pair \\\"procSelf\\\" 0) (pair \\\"procExePath\\\" 0) (pair \\\"procWaitPid\\\" 2) (pair \\\"procKill\\\" 2)\\n                                 (pair \\\"sqrt\\\" 1) (pair \\\"floor\\\" 1) (pair \\\"ceil\\\" 1) (pair \\\"round\\\" 1)\\n                                 (pair \\\"pow\\\" 2) (pair \\\"exp\\\" 1) (pair \\\"log\\\" 1) (pair \\\"log2\\\" 1) (pair \\\"log10\\\" 1)\\n                                 (pair \\\"sin\\\" 1) (pair \\\"cos\\\" 1) (pair \\\"tan\\\" 1) (pair \\\"atan2\\\" 2)\\n                                 (pair \\\"tcpListen\\\" 1) (pair \\\"tcpConnect\\\" 1) (pair \\\"sockAccept\\\" 1) (pair \\\"sockLocalPort\\\" 1) (pair \\\"unixListen\\\" 1) (pair \\\"unixConnect\\\" 1)\\n                                 (pair \\\"f64ArrayLen\\\" 1) (pair \\\"f64ArrayGet\\\" 2) (pair \\\"f64ArrayGenerate\\\" 2) (pair \\\"f64ArraySlice\\\" 3)\\n                                 (pair \\\"dot\\\" 2) (pair \\\"axpy\\\" 3) (pair \\\"gemm\\\" 5)))\\n           name)\\n\\nfn locus ctx: LowerCtx -> String\\n  (str (.-fnName ctx) \\\"@\\\" (.-pos ctx))\\n\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"tests/agentEval/cases/implement-one-line-fix/truth.asn\")" :want "(:read :file \"tests/agentEval/cases/implement-one-line-fix/truth.asn\" :content \"(:gate\\n  :cmd \\\"python3 test_tax.py\\\"\\n  :exit 0)\\n\")\n" :exit 0)
(:case :src leon :form "(:read :file \"asl/packages/asl-transpile/src/multilens.asl\")" :want "(:read :file \"asl/packages/asl-transpile/src/multilens.asl\" :truncated true :limit 200 :maxBytes 12000 :totalLines 81 :more (:start 78 :end 81) :content \"(module asl-transpile/multilens :d \\\"Unified Multilens Document and Entity Model Architecture in Pure ASL\\\" :x [MultilensModel LensOptions LensResult MultilensBundle defaultLensOptions emptyModel validateMultilensModel parseUnifiedModel modelExtractMeta modelExtractStyles modelExtractContent modelExtractData modelExtractConfig projectLens projectLensHtml projectLensCss projectLensYaml projectLensJson projectLensToml emitMultilensBundle measureBundleSavings] :i [(asl-parser/reader :a rd) (asl-parser/lexer :a lx) (asl-parser/ast :a ast) (asl-text/text :a txt) (cssEmit :a ce) (transpile :a tr) (yamlTranspile :a yt) (tomlTranspile :a tt)])\\n\\n(schema MultilensModel (:f meta rd/SExpr \\\"Document metadata record\\\") (:f styles rd/SExpr \\\"Stylesheet AST declarations and rules\\\") (:f content rd/SExpr \\\"Semantic markup content VDOM AST\\\") (:f data rd/SExpr \\\"Structured business and telemetry records\\\") (:f config rd/SExpr \\\"Runtime options and environmental configuration\\\") (:f success Bool \\\"True if model was parsed cleanly\\\") (:f errorMsg Str \\\"Error description if parsing failed\\\"))\\n\\n(schema LensOptions (:f indent I64 \\\"Indentation spaces or level\\\") (:f minify Bool \\\"True to minify emitted output\\\") (:f standalone Bool \\\"True for standalone document or fragment\\\") (:f includeStyles Bool \\\"True to embed styles in HTML head\\\") (:f doctype Bool \\\"True to emit doctype in HTML\\\"))\\n\\n(schema LensResult (:f lens Str \\\"Projection lens format name\\\") (:f output Str \\\"Rendered text output\\\") (:f originalTokens I64 \\\"Original token count\\\") (:f emittedTokens I64 \\\"Emitted token count\\\") (:f savingsPercent F64 \\\"Token compaction savings percentage\\\") (:f success Bool \\\"True if projection succeeded\\\") (:f errorMsg Str \\\"Error message on failure\\\"))\\n\\n(schema MultilensBundle (:f html Str \\\"Emitted HTML5 output\\\") (:f css Str \\\"Emitted CSS stylesheet\\\") (:f yaml Str \\\"Emitted YAML configuration\\\") (:f json Str \\\"Emitted JSON data\\\") (:f toml Str \\\"Emitted TOML configuration\\\") (:f artifacts (List LensResult) \\\"List of all generated lens results\\\") (:f totalOriginalTokens I64 \\\"Aggregate original tokens\\\") (:f totalEmittedTokens I64 \\\"Aggregate emitted tokens\\\") (:f success Bool \\\"True if all requested lenses succeeded\\\"))\\n\\nfn defaultLensOptions -> LensOptions\\n  (LensOptions :indent 2 :minify false :standalone true :includeStyles true :doctype true)\\n\\nfn emptyModel -> MultilensModel\\n  (MultilensModel :meta (rd/makeList (list)) :styles (rd/makeList (list)) :content (rd/makeList (list)) :data (rd/makeList (list)) :config (rd/makeList (list)) :success true :errorMsg \\\"\\\")\\n\\nfn modelExtractMeta m: MultilensModel -> rd/SExpr\\n  (.-meta m)\\n\\nfn modelExtractStyles m: MultilensModel -> rd/SExpr\\n  (.-styles m)\\n\\nfn modelExtractContent m: MultilensModel -> rd/SExpr\\n  (.-content m)\\n\\nfn modelExtractData m: MultilensModel -> rd/SExpr\\n  (.-data m)\\n\\nfn modelExtractConfig m: MultilensModel -> rd/SExpr\\n  (.-config m)\\n\\nfn extractSectionLoop items: (List rd/SExpr) plain: Str colon: Str -> rd/SExpr\\n  (mt (listHead items) ((none) (rd/makeList (list))) ((some it) (let [(tail (optionOr (listTail items) (list)))] (mt it ((rd/sexprAtom v) (let [(stripped (txt/stripColon v))] (if (or (= v plain) (or (= v colon) (= stripped plain))) (mt (listHead tail) ((some nextIt) nextIt) ((none) (rd/makeList (list)))) (extractSectionLoop tail plain colon)))) ((rd/sexprList subItems) (let [(hd (rd/sexprHead it)) (stripped (txt/stripColon hd))] (if (or (= hd plain) (or (= hd colon) (= stripped plain))) it (extractSectionLoop tail plain colon)))) ((rd/sexprVect _) (extract