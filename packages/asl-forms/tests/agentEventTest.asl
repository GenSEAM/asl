(module asl-forms/tests/agentEventTest
  :x [runTests]
  :i [(asl-forms/delegate :a d) (aslAgent/bus :a bus)])

; (:m :ref ULOOP-LOWS2 :do "the (:agent) dispatcher writes BusEvent rows the waiter parses, and skips its row when Leon already signalled the unit since the run started")
fn ! runTests -> Bool
  (let [(dir (str (optionOr (envGet "TMPDIR") "/tmp") "/agentEventTest-" (stringFromInt64 (procSelf))))
        (mk (dirCreate dir))
        (events (str dir "/bus/events.asn"))
        (receipt "(:agentReceipt :status :ok :stop done :session \"s9\" :head \"abc123\" :journal \".asl/run/agentLoop/s9.journal\" :turns 4)")
        (ev1 (d/agentBusEvent "SIGNAL-LEON-DONE" "done" receipt 0 1000))
        (r1 (d/postBusEvent! events ev1 900))
        (rows1 (resultOr (bus/readEvents! events) (list)))
        (parsed (bus/findEvent rows1 "SIGNAL-LEON-DONE" 0))
        (r2 (d/postBusEvent! events (d/agentBusEvent "SIGNAL-LEON-DONE" "killed" "" 137 1100) 900))
        (rows2 (resultOr (bus/readEvents! events) (list)))
        (r3 (d/postBusEvent! events (d/agentBusEvent "SIGNAL-LEON-DONE" "killed" "" 137 2100) 2000))
        (rows3 (resultOr (bus/readEvents! events) (list)))
        (notDir (str dir "/not-a-directory"))
        (badFixture (fileWrite notDir "file blocks directory creation"))
        (bad (d/postBusEvent! (str notDir "/events.asn") (d/agentBusEvent "u" "error" "" 1 5) 0))
        (removed (pathRemove dir))]
    (do
      (assert (ok? mk) "fixture root created")
      (assert (= r1 (ok true)) "the first row for a unit is written and creates its parent directory")
      (assert (= (listLength rows1) 1) "one call appends exactly one row")
      (assert (some? parsed) "the row parses as a BusEvent, which the old (:event :at :root :turns) shape did not")
      (assert (match parsed ((some e) (and (= e.stop "done") (= e.head "abc123") (= e.receiptPath ".asl/run/agentLoop/s9.journal") (= e.exit 0) (= e.at 1000))) ((none) false)) "stop, head, journal, exit and at come from the run")
      (assert (= r2 (ok false)) "a row already present for the unit since the start is not doubled")
      (assert (= (listLength rows2) 1) "the skipped call appends nothing")
      (assert (= r3 (ok true)) "a later run of the same unit gets its own row")
      (assert (match (bus/findEvent rows3 "SIGNAL-LEON-DONE" 2000) ((some e) (and (= e.stop "killed") (= e.exit 137))) ((none) false)) "the later row carries its stop and exit")
      (assert (ok? badFixture) "bad-directory fixture created")
      (assert (err? bad) "an events path beneath a non-directory reports err")
      (assert (= (d/receiptToken receipt ":stop") "done") "a bare receipt token is read up to the next space")
      (assert (= (d/receiptToken receipt ":journal") ".asl/run/agentLoop/s9.journal") "a quoted receipt value is unquoted")
      (assert (= (d/receiptToken receipt ":turns") "4") "a token before the closing paren ends there")
      (assert (= (d/receiptToken receipt ":missing") "") "an absent key gives empty")
      (assert (ok? removed) "fixture removed")
      true))
