(module asl-forms/tests/foreignCheckTest
  :x [runTests]
  :i [(asl-forms/check :a chk)])

fn nodeJsValid! code: String -> Bool
  (let [(cmd (str "node --check - << 'EOF'\n" code "\nEOF"))
        (res (processRun cmd))]
    (= res.exitCode 0))

fn testJsonParity! -> Bool
  (let [(valid1 "{\"key\": \"value\"}")
        (valid2 "[1, 2, 3, \"hello\", null, true, false]")
        (valid3 "{\"nested\": {\"array\": [1, 2, {}]}}")
        (valid4 "42")
        (valid5 "\"a string\"")
        (invalid1 "{\"key\": \"value\",}")
        (invalid2 "{\"key\": ")
        (invalid3 "[1, 2, 3,]")
        (invalid4 "unquoted_string")
        (invalid5 "{key: \"no quotes\"}")
        (v1 (chk/foreignSyntax "t1.json" valid1))
        (v2 (chk/foreignSyntax "t2.json" valid2))
        (v3 (chk/foreignSyntax "t3.json" valid3))
        (v4 (chk/foreignSyntax "t4.json" valid4))
        (v5 (chk/foreignSyntax "t5.json" valid5))
        (i1 (chk/foreignSyntax "i1.json" invalid1))
        (i2 (chk/foreignSyntax "i2.json" invalid2))
        (i3 (chk/foreignSyntax "i3.json" invalid3))
        (i4 (chk/foreignSyntax "i4.json" invalid4))
        (i5 (chk/foreignSyntax "i5.json" invalid5))]
    (do
      (assert (= v1.status "ok") "json valid1 is ok in asl")
      (assert (stringEmpty? v1.message) "json valid1 has no diagnostic")
      (assert (= v2.status "ok") "json valid2 is ok in asl")
      (assert (stringEmpty? v2.message) "json valid2 has no diagnostic")
      (assert (= v3.status "ok") "json valid3 is ok in asl")
      (assert (stringEmpty? v3.message) "json valid3 has no diagnostic")
      (assert (= v4.status "ok") "json valid4 is ok in asl")
      (assert (stringEmpty? v4.message) "json valid4 has no diagnostic")
      (assert (= v5.status "ok") "json valid5 is ok in asl")
      (assert (stringEmpty? v5.message) "json valid5 has no diagnostic")
      (assert (= i1.status "error") "json invalid1 is error in asl")
      (assert (not (stringEmpty? i1.message)) "json invalid1 reports a diagnostic")
      (assert (= i2.status "error") "json invalid2 is error in asl")
      (assert (not (stringEmpty? i2.message)) "json invalid2 reports a diagnostic")
      (assert (= i3.status "error") "json invalid3 is error in asl")
      (assert (not (stringEmpty? i3.message)) "json invalid3 reports a diagnostic")
      (assert (= i4.status "error") "json invalid4 is error in asl")
      (assert (not (stringEmpty? i4.message)) "json invalid4 reports a diagnostic")
      (assert (= i5.status "error") "json invalid5 is error in asl")
      (assert (not (stringEmpty? i5.message)) "json invalid5 reports a diagnostic")
      true))

fn testJsParity! -> Bool
  (let [(valid1 "function test(x) { return x + 1; }")
        (valid2 "const [a, b] = [1, 2]; const obj = { a, b };")
        (valid3 "class Greeter {\n  constructor(name) { this.name = name; }\n  greet() { return 'hi ' + this.name; }\n}")
        (valid4 "async function load() { const res = await fetch('/api'); return res.json(); }")
        (valid5 "const config = { host: 'localhost', port: 8080 }; const { host, port } = config;")
        (invalid1 "function ( {}")
        (invalid2 "const 123 = 4;")
        (invalid3 "let if = 1;")
        (invalid4 "if (x {")
        (invalid5 "const x = ;")
        (v1 (chk/foreignSyntax "t1.js" valid1))
        (v2 (chk/foreignSyntax "t2.js" valid2))
        (v3 (chk/foreignSyntax "t3.js" valid3))
        (v4 (chk/foreignSyntax "t4.js" valid4))
        (v5 (chk/foreignSyntax "t5.js" valid5))
        (i1 (chk/foreignSyntax "i1.js" invalid1))
        (i2 (chk/foreignSyntax "i2.js" invalid2))
        (i3 (chk/foreignSyntax "i3.js" invalid3))
        (i4 (chk/foreignSyntax "i4.js" invalid4))
        (i5 (chk/foreignSyntax "i5.js" invalid5))]
    (do
      (assert (= v1.status "ok") "js valid1 is ok in asl")
      (assert (nodeJsValid! valid1) "js valid1 is ok in node")
      (assert (= v2.status "ok") "js valid2 is ok in asl")
      (assert (nodeJsValid! valid2) "js valid2 is ok in node")
      (assert (= v3.status "ok") "js valid3 is ok in asl")
      (assert (nodeJsValid! valid3) "js valid3 is ok in node")
      (assert (= v4.status "ok") "js valid4 is ok in asl")
      (assert (nodeJsValid! valid4) "js valid4 is ok in node")
      (assert (= v5.status "ok") "js valid5 is ok in asl")
      (assert (nodeJsValid! valid5) "js valid5 is ok in node")
      (assert (= i1.status "error") "js invalid1 is error in asl")
      (assert (not (nodeJsValid! invalid1)) "js invalid1 is error in node")
      (assert (= i2.status "error") "js invalid2 is error in asl")
      (assert (not (nodeJsValid! invalid2)) "js invalid2 is error in node")
      (assert (= i3.status "error") "js invalid3 is error in asl")
      (assert (not (nodeJsValid! invalid3)) "js invalid3 is error in node")
      (assert (= i4.status "error") "js invalid4 is error in asl")
      (assert (not (nodeJsValid! invalid4)) "js invalid4 is error in node")
      (assert (= i5.status "error") "js invalid5 is error in asl")
      (assert (not (nodeJsValid! invalid5)) "js invalid5 is error in node")
      true))

fn testHtmlCheck -> Bool
  (let [(valid1 "<div class=\"container\"><p>Hello <strong>world</strong></p><img src=\"pic.jpg\"></div>")
        (valid2 "<!DOCTYPE html><html><head><title>Test</title></head><body><h1>Title</h1></body></html>")
        (invalid1 "<div class=\"container\"")
        (invalid2 "<div><spa")
        (invalid3 "<div><span attr")
        (invalid4 "<div><")
        (v1 (chk/foreignSyntax "t1.html" valid1))
        (v2 (chk/foreignSyntax "t2.html" valid2))
        (i1 (chk/foreignSyntax "i1.html" invalid1))
        (i2 (chk/foreignSyntax "i2.html" invalid2))
        (i3 (chk/foreignSyntax "i3.html" invalid3))
        (i4 (chk/foreignSyntax "i4.html" invalid4))]
    (do
      (assert (= v1.status "ok") "html valid1 is ok")
      (assert (= v2.status "ok") "html valid2 is ok")
      (assert (= i1.status "error") "html invalid1 is error")
      (assert (= i2.status "error") "html invalid2 is error")
      (assert (= i3.status "error") "html invalid3 is error")
      (assert (= i4.status "error") "html invalid4 is error")
      true))

fn testXmlCheck -> Bool
  (let [(valid1 "<?xml version=\"1.0\"?><catalog><book id=\"bk101\"><title>XML Guide</title></book></catalog>")
        (valid2 "<svg width=\"100\" height=\"100\"><circle cx=\"50\" cy=\"50\" r=\"40\" stroke=\"green\"/></svg>")
        (invalid1 "<catalog><book id=\"bk101\"><title>Unclosed</book></catalog>")
        (invalid2 "<unclosed")
        (invalid3 "no root tag < >")
        (v1 (chk/foreignSyntax "t1.xml" valid1))
        (v2 (chk/foreignSyntax "t2.xml" valid2))
        (i1 (chk/foreignSyntax "i1.xml" invalid1))
        (i2 (chk/foreignSyntax "i2.xml" invalid2))
        (i3 (chk/foreignSyntax "i3.xml" invalid3))]
    (do
      (assert (= v1.status "ok") "xml valid1 is ok")
      (assert (= v2.status "ok") "xml valid2 is ok")
      (assert (= i1.status "error") "xml invalid1 is error")
      (assert (= i2.status "error") "xml invalid2 is error")
      (assert (= i3.status "error") "xml invalid3 is error")
      true))

fn testCssCheck -> Bool
  (let [(valid1 "body { margin: 0; padding: 0; font-family: sans-serif; }")
        (valid2 "@media screen and (min-width: 768px) { .sidebar { display: block; } }")
        (invalid1 "h1, h2")
        (invalid2 "body ;")
        (v1 (chk/foreignSyntax "t1.css" valid1))
        (v2 (chk/foreignSyntax "t2.css" valid2))
        (i1 (chk/foreignSyntax "i1.css" invalid1))
        (i2 (chk/foreignSyntax "i2.css" invalid2))]
    (do
      (assert (= v1.status "ok") "css valid1 is ok")
      (assert (= v2.status "ok") "css valid2 is ok")
      (assert (= i1.status "error") "css invalid1 is error")
      (assert (= i2.status "error") "css invalid2 is error")
      true))

fn tscJsxValid! code: String -> Bool
  (let [(cmd (str "cat << 'EOF' > /tmp/_fcheck_jsx.jsx\n" code "\nEOF\ntsc --noEmit --jsx preserve --allowJs /tmp/_fcheck_jsx.jsx >/dev/null 2>&1\nRC=$?\nrm -f /tmp/_fcheck_jsx.jsx\nexit $RC"))
        (res (processRun cmd))]
    (= res.exitCode 0))

fn tscTsxValid! code: String -> Bool
  (let [(cmd (str "cat << 'EOF' > /tmp/_fcheck_tsx.tsx\n" code "\nEOF\ntsc --noEmit --jsx preserve /tmp/_fcheck_tsx.tsx >/dev/null 2>&1\nRC=$?\nrm -f /tmp/_fcheck_tsx.tsx\nexit $RC"))
        (res (processRun cmd))]
    (= res.exitCode 0))

fn testJsxCheck! -> Bool
  (let [(valid1 "<div className=\"box\">hello</div>")
        (valid2 "<div><span>nested</span></div>")
        (valid3 "<img src=\"foo.png\" alt=\"bar\" />")
        (valid4 "<div count={42} />")
        (invalid1 "<div></span>")
        (invalid2 "<div id=\"unclosed />")
        (invalid3 "<div>{foo</div>")
        (invalid4 "<div")
        (v1 (chk/foreignSyntax "t1.jsx" valid1))
        (v2 (chk/foreignSyntax "t2.jsx" valid2))
        (v3 (chk/foreignSyntax "t3.jsx" valid3))
        (v4 (chk/foreignSyntax "t4.jsx" valid4))
        (i1 (chk/foreignSyntax "i1.jsx" invalid1))
        (i2 (chk/foreignSyntax "i2.jsx" invalid2))
        (i3 (chk/foreignSyntax "i3.jsx" invalid3))
        (i4 (chk/foreignSyntax "i4.jsx" invalid4))]
    (if (hasTsc!)
      (do
        (assert (= v1.status "ok") "jsx valid1 is ok in asl")
        (assert (tscJsxValid! valid1) "jsx valid1 is ok in tsc")
        (assert (= v2.status "ok") "jsx valid2 is ok in asl")
        (assert (tscJsxValid! valid2) "jsx valid2 is ok in tsc")
        (assert (= v3.status "ok") "jsx valid3 is ok in asl")
        (assert (tscJsxValid! valid3) "jsx valid3 is ok in tsc")
        (assert (= v4.status "ok") "jsx valid4 is ok in asl")
        (assert (tscJsxValid! valid4) "jsx valid4 is ok in tsc")
        (assert (= i1.status "error") "jsx invalid1 is error in asl")
        (assert (not (tscJsxValid! invalid1)) "jsx invalid1 is error in tsc")
        (assert (= i2.status "error") "jsx invalid2 is error in asl")
        (assert (not (tscJsxValid! invalid2)) "jsx invalid2 is error in tsc")
        (assert (= i3.status "error") "jsx invalid3 is error in asl")
        (assert (not (tscJsxValid! invalid3)) "jsx invalid3 is error in tsc")
        (assert (= i4.status "error") "jsx invalid4 is error in asl")
        (assert (not (tscJsxValid! invalid4)) "jsx invalid4 is error in tsc")
        true)
      (do
        (println "tsc not found locally; comparing with asl-syntax verdict")
        (assert (= v1.status "ok") "jsx valid1 is ok in asl")
        (assert (= v2.status "ok") "jsx valid2 is ok in asl")
        (assert (= v3.status "ok") "jsx valid3 is ok in asl")
        (assert (= v4.status "ok") "jsx valid4 is ok in asl")
        (assert (= i1.status "error") "jsx invalid1 is error in asl")
        (assert (= i2.status "error") "jsx invalid2 is error in asl")
        (assert (= i3.status "error") "jsx invalid3 is error in asl")
        (assert (= i4.status "error") "jsx invalid4 is error in asl")
        true)))

fn testTsxCheck! -> Bool
  (let [(valid1 "const x: number = 1;")
        (valid2 "const el = <div className=\"box\">hello</div>;")
        (valid3 "const f = <T,>(x: T): T => x;")
        (valid4 "<><span>hello</span></>;")
        (invalid1 "const el = <div className=\"box\">hello;")
        (invalid2 "const x = <string>1;")
        (invalid3 "const x: number = ;")
        (invalid4 "<div></span>;")
        (v1 (chk/foreignSyntax "t1.tsx" valid1))
        (v2 (chk/foreignSyntax "t2.tsx" valid2))
        (v3 (chk/foreignSyntax "t3.tsx" valid3))
        (v4 (chk/foreignSyntax "t4.tsx" valid4))
        (i1 (chk/foreignSyntax "i1.tsx" invalid1))
        (i2 (chk/foreignSyntax "i2.tsx" invalid2))
        (i3 (chk/foreignSyntax "i3.tsx" invalid3))
        (i4 (chk/foreignSyntax "i4.tsx" invalid4))]
    (if (hasTsc!)
      (do
        (assert (= v1.status "ok") "tsx valid1 is ok in asl")
        (assert (tscTsxValid! valid1) "tsx valid1 is ok in tsc")
        (assert (= v2.status "ok") "tsx valid2 is ok in asl")
        (assert (tscTsxValid! valid2) "tsx valid2 is ok in tsc")
        (assert (= v3.status "ok") "tsx valid3 is ok in asl")
        (assert (tscTsxValid! valid3) "tsx valid3 is ok in tsc")
        (assert (= v4.status "ok") "tsx valid4 is ok in asl")
        (assert (tscTsxValid! valid4) "tsx valid4 is ok in tsc")
        (assert (= i1.status "error") "tsx invalid1 is error in asl")
        (assert (not (tscTsxValid! invalid1)) "tsx invalid1 is error in tsc")
        (assert (= i2.status "error") "tsx invalid2 is error in asl")
        (assert (not (tscTsxValid! invalid2)) "tsx invalid2 is error in tsc")
        (assert (= i3.status "error") "tsx invalid3 is error in asl")
        (assert (not (tscTsxValid! invalid3)) "tsx invalid3 is error in tsc")
        (assert (= i4.status "error") "tsx invalid4 is error in asl")
        (assert (not (tscTsxValid! invalid4)) "tsx invalid4 is error in tsc")
        true)
      (do
        (println "tsc not found locally; comparing with asl-syntax verdict")
        (assert (= v1.status "ok") "tsx valid1 is ok in asl")
        (assert (= v2.status "ok") "tsx valid2 is ok in asl")
        (assert (= v3.status "ok") "tsx valid3 is ok in asl")
        (assert (= v4.status "ok") "tsx valid4 is ok in asl")
        (assert (= i1.status "error") "tsx invalid1 is error in asl")
        (assert (= i2.status "error") "tsx invalid2 is error in asl")
        (assert (= i3.status "error") "tsx invalid3 is error in asl")
        (assert (= i4.status "error") "tsx invalid4 is error in asl")
        true)))

fn testStagedValidation -> Bool
  (let [(goodJson "{\"a\": 1}")
        (badJson "{\"a\": ")
        (goodAsl "(module test :x [main])")
        (badAsl "(module test (")
        (stNewGood (chk/validateStaged "x.json" (none) goodJson false))
        (stNewBad (chk/validateStaged "x.json" (none) badJson false))
        (stPreBad (chk/validateStaged "x.json" (some badJson) badJson false))
        (stForced (chk/validateStaged "x.json" (none) badJson true))
        (stAslGood (chk/validateStaged "x.asl" (none) goodAsl false))
        (stAslBad (chk/validateStaged "x.asl" (none) badAsl false))
        (stAslPre (chk/validateStaged "x.asl" (some badAsl) badAsl false))]
    (do
      (assert (= stNewGood.rejectCode "") "new valid json has empty rejectCode")
      (assert (stringContains? stNewGood.receiptFields ":syntax :ok") "new valid json receipt has :syntax :ok")
      (assert (= stNewBad.rejectCode ":ERR_SYNTAX") "new invalid json rejected with ERR_SYNTAX")
      (assert (= stPreBad.rejectCode "") "preexisting invalid json allowed")
      (assert (stringContains? stPreBad.receiptFields ":preexisting true") "preexisting invalid json flagged preexisting")
      (assert (= stForced.rejectCode "") "forced invalid json allowed")
      (assert (stringContains? stForced.receiptFields ":forced true") "forced invalid json flagged forced")
      (assert (= stAslGood.rejectCode "") "valid asl edit allowed")
      (assert (stringContains? stAslGood.receiptFields ":balanced true") "valid asl flagged balanced")
      (assert (= stAslBad.rejectCode ":ERR_UNBALANCED") "unbalanced asl rejected with ERR_UNBALANCED")
      (assert (= stAslPre.rejectCode "") "preexisting unbalanced asl allowed")
      (assert (stringContains? stAslPre.receiptFields ":preexisting true") "preexisting unbalanced asl flagged preexisting")
      true))

fn testCheckReceipts! -> Bool
  (let [(rGoodJson (chk/checkFileReceipt! 1 "check" "app.json" ":disk" "{\"ok\": true}"))
        (rBadJson (chk/checkFileReceipt! 2 "check" "app.json" ":disk" "{\"ok\": "))
        (rGoodJsx (chk/checkFileReceipt! 3 "check" "App.jsx" ":disk" "<div/>"))
        (rGoodTsx (chk/checkFileReceipt! 4 "check" "App.tsx" ":disk" "const x: number = 1;"))
        (rGoodAsl (chk/checkFileReceipt! 5 "check" "main.asl" ":disk" "(module a)"))
        (rBadAsl (chk/checkFileReceipt! 6 "check" "main.asl" ":disk" "(module a ("))
        (rTxt (chk/checkFileReceipt! 7 "check" "notes.txt" ":disk" "hello"))]
    (do
      (assert (stringContains? rGoodJson ":status \"ok\"") "good json receipt ok")
      (assert (stringContains? rGoodJson ":syntax :ok :checked true") "good json syntax ok checked true")
      (assert (stringContains? rBadJson ":status \"rejected\"") "bad json receipt rejected")
      (assert (stringContains? rBadJson ":error-code \":ERR_SYNTAX\"") "bad json error code ERR_SYNTAX")
      (assert (stringContains? rGoodJsx ":syntax :ok :checked true") "good jsx receipt syntax ok checked true")
      (assert (stringContains? rGoodTsx ":syntax :ok :checked true") "good tsx receipt syntax ok checked true")
      (assert (stringContains? rGoodAsl ":status \"ok\"") "good asl receipt ok")
      (assert (stringContains? rGoodAsl ":valid true :balanced true") "good asl receipt balanced")
      (assert (stringContains? rBadAsl ":status \"rejected\"") "bad asl receipt rejected")
      (assert (stringContains? rBadAsl ":error-code \":ERR_UNBALANCED_DELIMITERS\"") "bad asl error code ERR_UNBALANCED_DELIMITERS")
      (assert (stringContains? rTxt ":syntax :skipped :checked false") "txt receipt syntax skipped checked false")
      true))

fn testPathExtension -> Bool
  (do
    (assert (= (chk/pathExtension "Makefile") "") "Makefile has no extension")
    (assert (= (chk/pathExtension ".gitignore") "") ".gitignore has no extension")
    (assert (= (chk/pathExtension "dir/file") "") "dir/file has no extension")
    (assert (= (chk/pathExtension "dir/.gitignore") "") "dir/.gitignore has no extension")
    (assert (= (chk/pathExtension "dir/Makefile") "") "dir/Makefile has no extension")
    (assert (= (chk/pathExtension "code.ts") ".ts") "code.ts has .ts extension")
    (assert (= (chk/pathExtension "archive.tar.gz") ".gz") "archive.tar.gz has .gz extension")
    true)

fn hasTsc! -> Bool
  (= (processRun "which tsc").exitCode 0)

fn nodeTsValid! code: String -> Bool
  (let [(cmd (str "cat << 'EOF' > /tmp/_fcheck_ts.ts\n" code "\nEOF\ntsc --noEmit /tmp/_fcheck_ts.ts >/dev/null 2>&1\nRC=$?\nrm -f /tmp/_fcheck_ts.ts\nexit $RC"))
        (res (processRun cmd))]
    (= res.exitCode 0))

fn testTsCheck! -> Bool
  (let [(validTs "1 as number")
        (invalidTs "1 as ")
        (vRes (chk/foreignSyntax "valid.ts" validTs))
        (iRes (chk/foreignSyntax "invalid.ts" invalidTs))]
    (if (hasTsc!)
      (do
        (assert (and (= vRes.status "ok") (nodeTsValid! validTs)) "valid ts passes asl and tsc")
        (assert (and (= iRes.status "error") (not (nodeTsValid! invalidTs))) "invalid ts fails asl and tsc")
        true)
      (do
        (println "tsc not found locally; comparing with asl-syntax verdict")
        (assert (= vRes.status "ok") "valid ts passes asl-syntax")
        (assert (= iRes.status "error") "invalid ts fails asl-syntax")
        true)))

fn ! runTests -> Bool
  (do
    (assert (testJsonParity!) "testJsonParity")
    (assert (testJsParity!) "testJsParity")
    (assert (testHtmlCheck) "testHtmlCheck")
    (assert (testXmlCheck) "testXmlCheck")
    (assert (testCssCheck) "testCssCheck")
    (assert (testJsxCheck!) "testJsxCheck")
    (assert (testTsxCheck!) "testTsxCheck")
    (assert (testStagedValidation) "testStagedValidation")
    (assert (testCheckReceipts!) "testCheckReceipts")
    (assert (testPathExtension) "testPathExtension")
    (assert (testTsCheck!) "testTsCheck")
    true)
