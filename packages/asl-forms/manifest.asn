(:package asl-forms
 :version "0.1.0"
 :entry "src/main.asl"
 :description "Agent-plane forms kernel in pure ASL"
 :aslFirst true
 :modules ["asl-forms/main"
           "asl-forms/kernel"
           "asl-forms/wire"
           "asl-forms/similarity"
           "asl-forms/symbol"
           "asl-forms/ops"
           "asl-forms/search"
           "asl-forms/extract"
           "asl-forms/tools"
           "asl-forms/gate"
           "asl-forms/vfs"
           "asl-forms/edit"
           "asl-forms/delegate"
           "asl-forms/check"
           "asl-forms/lens"
           "asl-forms/query"
           "asl-forms/repair"
           "asl-forms/rewrite"]
 :dependencies ["aslGateway" "asl-json" "asl-intel" "asl-proc" "asl-syntax" "asl-coord" "asl-gates"])
