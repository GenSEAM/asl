(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#" :text "Row-major F64Array helpers for the factorisations: Bytes scratch buffers, shape-checked transpose and matrix-vector product, finiteness and symmetry checks")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#copyIn!" :text "copy an F64Array into a Bytes buffer of Float64 slots")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#toBuf" :text "new Bytes scratch buffer holding the array, 8 bytes per element")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#fromBuf" :text "copy n Float64 slots of a buffer out into a new F64Array")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#getAt!" :text "element i,j of a row-major buffer with cols columns")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#setAt!" :text "overwrite element i,j of a row-major buffer")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#allFinite" :text "true when no element is NaN or infinite")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#identity" :text "n x n identity, row-major")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#transpose" :text "transpose of an m x n row-major matrix; (err linalgShape ...) on a length that is not m*n")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#matVec" :text "A x for m x n A and a length n vector through gemm; (err linalgShape ...) on mismatch")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#asymmetric!" :text "true when some a_ij and a_ji differ by more than 1e-9 relative")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#" :text "Cholesky factorisation and solve for symmetric positive definite systems, row-major, explicit errors")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#rowDot!" :text "sum over t < k of L[i][t]*L[j][t]")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#chStep!" :text "fill the lower triangle row by row; err linalgNotPositiveDefinite on a pivot at or below 1e-13 times its diagonal entry or non-finite")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#choleskyFactor" :text "choleskyFactor n a: lower L with A = L L^T; err linalgShape, linalgNonFinite, linalgNotSymmetric or linalgNotPositiveDefinite; 500x500 takes 68 ms native")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#fwd!" :text "forward substitution L y = b in place")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#rowDot2!" :text "dot of row i of L with the solved prefix of y")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#colDot!" :text "dot of column i of L below the diagonal with the solved suffix of x")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#bwd!" :text "back substitution L^T x = y in place")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#choleskySolve" :text "choleskySolve n l b: solve L L^T x = b from a factor; err linalgShape, linalgNonFinite or linalgNotPositiveDefinite on a non-positive diagonal")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#diagPositive?" :text "true when every diagonal entry of the factor is positive")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#choleskySolveSpd" :text "factor A then solve A x = b; any error of choleskyFactor or choleskySolve")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#" :text "Least squares by Householder QR with column pivoting; rank is reported against a stated tolerance")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#Lstsq" :text "least squares result: coef (n coefficients), rank, residualNorm = |b - A coef|_2, tol used")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#defaultRankTol" :text "max(m,n) * 2.22e-16")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#colNorm2!" :text "squared norm of column j from row k down")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#pickPivot!" :text "column of the largest remaining norm from k on")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#swapCols!" :text "swap two columns of the working matrix")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#applyRefl!" :text "apply the Householder reflection to one column")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#vdot!" :text "dot of the reflector with a column")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#axpyCol!" :text "column += c * reflector")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#applyAll!" :text "reflect every column right of k")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#applyB!" :text "reflect the right-hand side")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#vdotB!" :text "dot of the reflector with the right-hand side")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#axpyB!" :text "right-hand side += c * reflector")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#fillV!" :text "build the reflector for column k and return its squared norm")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#qrLoop!" :text "pivoted Householder sweep; returns the rank, stopping when the pivot norm is at or below tol times the first pivot norm")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#backSub!" :text "solve R x = Q^T b on the leading rank x rank block")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#backDot!" :text "dot of an R row with the solved suffix")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#scatter!" :text "write the rank solved coefficients to their original columns, the rest stay 0")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#initPerm!" :text "identity column permutation")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#tailNorm2!" :text "squared norm of Q^T b below the rank")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#lstsqTol" :text "lstsqTol m n a b tol: min |A x - b|_2 for m x n row-major A; rank-deficient input is ok with rank < n and the basic solution; err linalgShape, linalgNonFinite or linalgTolerance (tol outside [0,1))")
(:doc :symbol "asl/packages/asl-linalg/src/qr.asl#lstsq" :text "lstsqTol with the default tolerance max(m,n)*2.2e-16, relative to the largest pivot; near-dependence of about 1e-14 relative is borderline, pass lstsqTol with an explicit tol and read rank; any scale from 1e-300 to 1e300 is handled")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#" :text "Symmetric eigenproblem by cyclic Jacobi for small matrices")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#Eigen" :text "values ascending, vectors row-major with column k the unit eigenvector of values[k], sweeps used")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#offMass!" :text "sum of squares of the off-diagonal entries")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#rotCols!" :text "rotate columns p and q")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#rotRows!" :text "rotate rows p and q")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#rotate!" :text "one Jacobi rotation zeroing a_pq, accumulated into the vectors")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#sweep!" :text "one cyclic sweep over all p < q")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#jacobi!" :text "sweeps until the off-diagonal mass is below 1e-28 of the Frobenius mass; -1 after 60 sweeps")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#argMin!" :text "index of the smallest unused diagonal entry")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#copyCol!" :text "copy one eigenvector column")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#order!" :text "sort eigenpairs ascending")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#diagMass!" :text "sum of squares of the diagonal")
(:doc :symbol "asl/packages/asl-linalg/src/eigen.asl#eigenSym" :text "eigenSym n a: eigenvalues and vectors of a symmetric matrix accurate to about 1e-14 times its norm; err linalgShape, linalgNonFinite, linalgNotSymmetric or linalgNoConvergence; 100x100 takes 54 ms native")
(:doc :symbol "asl/packages/asl-linalg/tests/choleskyTest.asl#runTests" :text "Hand-factored 3x3, L L^T reconstruction, A x = b, and the non-PD, singular, asymmetric, shape, empty and NaN failure gates")
(:doc :symbol "asl/packages/asl-linalg/tests/qrTest.asl#runTests" :text "Hand-computed regression, exact fit, rank-deficient and underdetermined input, residual orthogonality, tolerance and failure gates")
(:doc :symbol "asl/packages/asl-linalg/tests/eigenTest.asl#runTests" :text "Known eigenvalues, A v = lambda v, V^T V = I, trace, repeated and diagonal input and failure gates")
(:doc :symbol "asl/packages/asl-linalg/tests/denseTest.asl#runTests" :text "buffer access, finiteness, identity, transpose, matVec and symmetry gates including shape failures")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#pow2Exponent" :text "e with m/2^e in [1,2), 0 for m = 0")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#mul2" :text "x times 2^e in steps of 2^500, exact, no intermediate overflow")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#scaleArray" :text "every element times 2^e, the array itself when e = 0")
(:doc :symbol "asl/packages/asl-linalg/src/dense.asl#maxAbs" :text "largest absolute value, 0 for an empty array")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#choleskyRcond" :text "choleskyRcond n a l: reciprocal 1-norm condition estimate (Hager-Higham) from the factor; about 1e-16 means no correct digits, the caller decides whether to refuse; Hilbert 6 and 12 estimate within a factor 3 of numpy 3.4e-8 and 2.6e-17")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#sumAbs!" :text "sum of absolute values")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#colSums!" :text "largest absolute column sum, the 1-norm")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#argMaxAbs!" :text "index of the largest absolute element")
(:doc :symbol "asl/packages/asl-linalg/src/cholesky.asl#hager!" :text "Hager iteration estimating the 1-norm of the inverse through factor solves")
