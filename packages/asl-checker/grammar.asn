    (:sym :name "checkFile!" :kind :fn :tokens 2)
    (:sym :name "checkModule" :kind :fn :tokens 2)
    (:sym :name "checkSource" :kind :fn :tokens 2)
    (:sym :name "collectSummary" :kind :fn :tokens 2)
