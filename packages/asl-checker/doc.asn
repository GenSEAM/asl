(:doc :symbol "asl/packages/asl-checker/src/check.asl#bindArmPattern" :text "An arm's whole pattern: a bare head naming a form, builtin or function is a malformed arm; a name nested in a constructor pattern binds whatever it shadows.")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#schemaOfCtor" :text "The schema and defining module of constructor head, none if unexported or undefined.")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#checkDefunDiags" :text "Type-checks one defun's body against its declared params and return type.")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#untypedParamDiags" :text "One ERR_UNTYPED_PARAM per unannotated parameter, placed at the first body form like the other function-level annotation diagnostics.")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#checkModuleSource" :text "Host-facing file-check diagnostics: normalized codes and lint filtering. Untyped parameters come from parsed function nodes.")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#checkExprDiags" :text "Type-checks one bare top-level expression; no return type is expected of it.")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#checkModule" :text "Raw checker diagnostics for parsed forms, retaining resolver rule codes and documentation/type-name diagnostics. CHECKER-A: one DepIndex per check; every dep lookup in this module reads its bucket instead of rescanning the deps map")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#checkModuleIn" :text "checkModule over a DepIndex the caller built (r/depIndexOf): every former resolveDepTarget site reads its bucket through r/resolveDepIn instead of rescanning the deps map; exported so a caller checking many modules against one deps map builds the index once (CHECKER-A).")
