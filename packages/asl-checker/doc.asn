(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ModuleClosure.deps" :text "Summaries keyed by real path, and by import path for the entry's own imports; header-only unless bodies were parsed")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ModuleClosure.paths" :text "Real paths of the loaded modules in load order")
