(:doc :symbol "asl/packages/asl-checker/src/claims.asl#" :text "Pure AgentScript automated claim grounder, citation linker, and unbacked claim refutation engine under ADR D88.")
(:doc :symbol "asl/packages/asl-checker/src/exhaustive.asl#" :text "Pure AgentScript Compile-Time Exhaustive Pattern Matching Analysis")
(:doc :symbol "asl/packages/asl-checker/src/exhaustive.asl#makeExhaustiveReport" :text "Build an ExhaustiveReport.")
(:doc :symbol "asl/packages/asl-checker/src/exhaustive.asl#isArmCovered?" :text "True if an arm already covers the variant.")
(:doc :symbol "asl/packages/asl-checker/src/exhaustive.asl#checkMatchExhaustiveness" :text "Report the variants no arm covers; a wildcard arm covers all.")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#" :text "Hindley-Milner Functional Type Unification for AgentScript")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#resolveVarSubstRec" :text "Follow variable bindings in a substitution for at most fuel steps.")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#resolveVarSubst" :text "The type a variable is bound to after following its chain of bindings.")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#applySubst" :text "A type with every bound variable replaced through the substitution.")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#occursIn?" :text "True if variable id occurs in the type, the check that keeps substitutions acyclic.")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#kindNarrow" :text "The narrower of two variable kinds (any, num, int), none when they conflict.")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#typeEqual?" :text "Structural type equality; an absent module on either side matches any module.")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#bindVarCon" :text "The variable (kind k) is 'want': binds it to the concrete cTy, or reports cTy as 'found' against the kind's own showType wording, which is already want-then-found since the variable is want here.")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#bindVarConRev" :text "Mirror of bindVarCon for the opposite orientation: the concrete wantTy is 'want' and the variable (kind k) is 'found'. Binds the variable to wantTy when the kind allows it, else reports the mismatch as 'expected wantTy, found <the kind's showType>' (CHECKER-swappedExpectedFound: the caller used to flip to (unify (tyVar id k) wantTy subst), which hands the flipped pair to bindVarCon and comes back worded from the variable's kind, i.e. with want and found swapped).")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#unify" :text "Unify two types under a substitution: the extended substitution, or the mismatch.")
(:doc :symbol "asl/packages/asl-checker/tests/boundedSubstitutionTest.asl#" :text "Acceptance fixture for Task 50401: Eliminate range 5000 and implement bounded metavariable substitution (End-to-End)")
(:doc :symbol "asl/packages/asl-checker/tests/checkParityTypeSemanticsTest.asl#" :text "Regression coverage for CHECKPARITY type aliases, builtin signatures, structural equality, nullary builtins, flat let, and body diagnostic positions.")
(:doc :symbol "asl/packages/asl-checker/tests/checkerTest.asl#" :text "Comprehensive falsifiable test suite for Hindley-Milner type inference and checker.")
(:doc :symbol "asl/packages/asl-checker/tests/checkerTest.asl#testImportedSysHostVerbRejected" :text "hostVerb left the sys builtins in NX4: through an imported sys alias it is an unknown symbol too.")
(:doc :symbol "asl/packages/asl-checker/tests/checkerTest.asl#testHostRecordProcessOutput" :text "processRun returns the host record ProcessOutput (exitCode, stdout, stderr, built by mkRec in prelude.c); the checker must type its fields, accept it as a parameter annotation, and still reject a field used at the wrong type.")
(:doc :symbol "asl/packages/asl-checker/tests/checkerTest.asl#testFileExistsIsBool" :text "The prelude defines fileExists? as String -> Bool; the checker signature must agree, so it is usable directly as an if condition and rejected where an Int64 is expected.")
(:doc :symbol "asl/packages/asl-checker/tests/checkerTest.asl#testTopExprTypeError" :text "A type error inside a bare top-level expression (not inside any function body) must still be reported; checkModule dispatches topExpr forms to checkExprDiags, not just topDefun forms to checkDefunDiags.")
(:doc :symbol "asl/packages/asl-checker/tests/checkerTest.asl#testClampBuiltin" :text "clamp's checker signature must track asl-host's prelude.c bClamp, which wants three strict Float64 arguments and raises ERR_RANGE at runtime, not a mixed or Int version.")
(:doc :symbol "asl/packages/asl-checker/tests/checkerTest.asl#testBuiltinsAsValues" :text "Every builtin with one concrete, non-variadic function signature typechecks as a first-class value (e.g. passed to map), as asl-host run already accepts and the native lowering supports; a variadic builtin like and/or/str still has no single function type and stays rejected.")
(:doc :symbol "asl/packages/asl-checker/tests/checkerTest.asl#testKeywordCallRejected" :text "CHECKER-keywordCall: (:k v ...) passes as a call head (a keyword literal can never be called) but traps at runtime with 'cannot call a Keyword' (vm.c, abi.c); records are built (SchemaName :k v ...) in ASL, or {:k v ...} in quoted ASN data, never a bare keyword head. Checked in value, statement and nested position, plus that legitimate bare keyword values (schema ctor keys, plain arguments) are left untouched.")
(:doc :symbol "asl/packages/asl-checker/tests/claimsGroundingTest.asl#" :text "Acceptance fixture for Task 48903: Automated Ungrounded Claim Refutation and Citation Linker under ADR D88 and D77 dual polarity.")
(:doc :symbol "asl/packages/asl-checker/tests/closureParityTest.asl#" :text "Resolver parity: the ASL loader in asl-checker/resolve resolves imports as the host loader asl/host/src/loader.c does. The host's module set is read from the host itself: asl-host build embeds every module of the closure by real path, and those paths are grepped out of the built binary and cross-checked against the module count build prints.")
(:doc :symbol "asl/packages/asl-checker/tests/corpusTypeDebtGate.asl#" :text "Measures what the compiler never looks at. compilePackageToC99! type-checks the entry module alone, so every dependency is emitted unchecked; this gate runs checkModule over the whole bootstrap closure instead. The total is a mixture, not a type-error count: it holds genuine type errors, rule diagnostics such as missing docstrings and unmarked effects. Ratcheted against recorded debt baseline.")
(:doc :symbol "asl/packages/asl-checker/tests/ctorPatternTest.asl#" :text "Gate for CHECKER-foreignCtorPattern: a bare name in mt pattern position tests the tag only when it names a constructor of the enum the match tests (its first (ctor ...) pattern's, else its first bare constructor's); any other name, a visible constructor of another enum such as IoError's other included, binds the subject. asl-host run and check, asl1 check and the native asl1 build agree; a bare constructor of the match's own enum still tests its tag and counts toward exhaustiveness.")
(:doc :symbol "asl/packages/asl-checker/tests/ctorPatternTest.asl#fixtures" :text "Fixture name to source.")
(:doc :symbol "asl/packages/asl-checker/tests/ctorPatternTest.asl#runsAs" :text "asl-host check accepts the fixture, asl-host run prints want, asl1 check accepts it, and its asl1 native build prints want.")
(:doc :symbol "asl/packages/asl-checker/tests/ctorPatternTest.asl#checksAndRuns" :text "asl-host check accepts the fixture, asl-host run prints want, and asl1 check accepts it. No asl1 build/native leg: asl-ir lowering does not yet support keyword literal patterns (ERR_LOWER_UNSUPPORTED), a separate gap from the catch-all question this fixture targets.")
(:doc :symbol "asl/packages/asl-checker/tests/ctorPatternTest.asl#countOccurrences" :text "How many times text occurs in out, by splitting on it.")
(:doc :symbol "asl/packages/asl-checker/tests/ctorPatternTest.asl#rejectsOnce" :text "Like rejects, but text must occur exactly once in the combined output, not merge twice from two diagnostic sites.")
(:doc :symbol "asl/packages/asl-checker/tests/dialectTest.asl#" :text "The checker accepts the fn dialect the compiler is written in: record constructors, qualified types through import aliases, Unit, do, else in cond, bindings and lambdas as the fn-dialect parser writes them, pairFirst and pairSecond, and diagnostics at the offending body form. One accepted and one rejected source per construct.")
(:doc :symbol "asl/packages/asl-checker/tests/dialectTest.asl#cascade?" :text "what the checker said about the dialect itself before it accepted it: keys and binding slots as unbound atoms, do and else as undefined names")
(:doc :symbol "asl/packages/asl-checker/tests/exhaustiveTest.asl#" :text "Popperian verification suite for compile-time pattern matching exhaustiveness checking")
(:doc :symbol "asl/packages/asl-checker/tests/fixtures/closureParity/ambiguousImporter.asl#" :text "Imports the bare name parityDup, which two modules in this package declare; every loader must reject it.")
(:doc :symbol "asl/packages/asl-checker/tests/fixtures/closureParity/one/parityDup.asl#" :text "One of two modules whose declared names share the last segment parityDup, so a bare parityDup import inside asl-checker is ambiguous.")
(:doc :symbol "asl/packages/asl-checker/tests/fixtures/closureParity/symlinkImporter.asl#" :text "Imports asl-checker/resolveTest by declared name; resolve_test.asl is a symlink to it, which no loader may count as a second declaration.")
(:doc :symbol "asl/packages/asl-checker/tests/fixtures/closureParity/two/parityDup.asl#" :text "The other module whose declared name ends in parityDup.")
(:doc :symbol "asl/packages/asl-checker/tests/ifArmShapeTest.asl#" :text "One-armed if value positions and malformed mt arms")
(:doc :symbol "asl/packages/asl-checker/tests/mainCompatibilityTest.asl#" :text "CHECKPARITY-B compatibility contract for the checker's public diagnostics and type vocabulary.")
(:doc :symbol "asl/packages/asl-checker/tests/procResultTypeGate.asl#" :text "Regression gate for PROCRESULT: the undefined ProcessResult annotation (now ProcessOutput, asl-proc/coreProcess) must not reappear at asl-gates/src/gateRunner.asl, asl-engine/src/engine.asl, asl-engine/src/main.asl, asl-engine/src/transport.asl, asl-cli/tests/argvParityTest.asl or tests/host/genInventoryTest.asl. None of these modules sit inside asl-checker/tests/corpusTypeDebtGate.asl's bootstrap closure (main.asl's transitive imports), so that gate cannot see them; this one runs the same chk/checkModule directly against each file by path instead")
(:doc :symbol "asl/packages/asl-checker/tests/resolveCycleTest.asl#" :text "Rule 11: an import cycle through the checked module is one rule-11 diagnostic naming the modules; an acyclic import graph has none.")
(:doc :symbol "asl/packages/asl-checker/tests/resolveIoTest.asl#" :text "Resolver error paths: an unreadable module is an ERR_IO line, not a trap; loadModuleDeps! returns err on a missing or unreadable dependency; parentDirOf and resolveImport! terminate on a relative path; asl1 stops on a dependency that does not load.")
(:doc :symbol "asl/packages/asl-checker/tests/resolveTest.asl#" :text "Unit tests for asl-checker/resolve")
(:doc :symbol "asl/packages/asl-checker/tests/typesTest.asl#" :text "Unit tests for asl-checker/types")
(:doc :symbol "asl/packages/asl-checker/tests/typesTest.asl#arraySigTable" :text "The Arrays section of asl/prelude/prelude.asn as name and type; i64/i8 folds keep an Int64 accumulator, which asl/host/src/arrays.c foldScan enforces.")
(:doc :symbol "asl/packages/asl-checker/tests/unifyTest.asl#" :text "Unit tests for asl-checker/unify")
(:doc :symbol "asl/packages/asl-checker/tests/unknownTypeNameTest.asl#" :text "Falsifiable coverage for CHECKERTYPENAME: an unknown type constructor in a lambda's own annotation (never seen by collectSummary's defun-level pass) must be a checker error, not a silent tyCon that only shows up later as a type mismatch.")
(:doc :symbol "asl/packages/asl-checker/tests/unknownTypeNameTest.asl#testUnknownTypeNameInLambdaParam" :text "as an opaque \"expected (Fn A B), found an integer\" unify mismatch at the call site.\nCHECKERTYPENAME: a capitalized but undeclared type constructor inside an inline fn's\nown parameter annotation used to parse as a plain tyCon and only fail far downstream,")
(:doc :symbol "asl/packages/asl-checker/tests/unknownTypeNameTest.asl#testTypevarNotFlaggedAsUnknown" :text "must not be flagged as an unknown type constructor.\nsingle uppercase letters are the established implicit-typevar convention\n(ty/collectTvars, used by collectSummary for defun signatures); a lambda using one")
(:doc :symbol "asl/packages/asl-checker/tests/untypedParamTest.asl#" :text "Untyped top-level function parameters are rejected in host and self-hosted checkers; typed params and lambdas remain valid.")
(:doc :symbol "asl/packages/asl-checker/tests/checker_test.asl#testSwappedExpectedFound" :text "CHECKER-swappedExpectedFound: bindVarCon's wording is from the unifier's own view (the variable's kind requirement\n      vs the concrete type it met), which reads backwards whenever the concrete side is 'want' (the parameter) and the\n      kind-constrained variable is 'have' (the argument) -- unify used to reach that case by flipping to (unify have\n      want subst), so the message that came back was phrased as if 'have' were 'want' and vice versa: 'expected an\n      integer, found String' for (stringLength 1), where String is the actual parameter type (want) and the literal's\n      int kind is the actual argument (have). Checks both a bare literal argument and a non-literal one (a '+'\n      expression, whose result stays an int-kind variable until something concretizes it) so the fix is not keyed to\n      literal-ness.")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#" :text "Pass 3 Hindley-Milner Type Inference and Unified Checker Entry Points")
