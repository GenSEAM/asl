(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#firstHeadIdent" :text "The head identifier of the first expression.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#bodyPosAt" :text "Line and column of body form idx of a function, 1:1 when the parser gave none.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#placeDiags" :text "The diagnostics moved to a source position.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#resolveModule" :text "Pass 1 and 2 diagnostics: reserved names, module rules, imports and cycles, export closure, type annotations and body resolution.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#bindingItems" :text "the fn-dialect parser writes a [ ] binding vector as (list ...)")
