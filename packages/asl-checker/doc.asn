(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ModuleClosure.errors" :text "Read and parse failures; a module the parser rejects keeps its header summary")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ModuleClosure.index" :text "Index after loading")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ModHeader.name" :text "Declared name, empty when the header has none")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ModHeader.hasDoc" :text "True if the header carries a non-empty :d")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ModHeader.exports" :text "Names under :x")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ModHeader.imports" :text "Alias and import path of each :i entry, in order")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ImportPass.imports" :text "Alias to real path, or to the import path when it failed")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ImportPass.targets" :text "Real paths still to load")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ImportPass.unresolved" :text "Failure lines")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ImportPass.index" :text "Index after resolving")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#emptyModIndex" :text "A module index not yet built for any root.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#parentDirOf" :text "The directory part of a path, / for a top-level path, . for a slashless one.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#resolveImport!" :text "Resolve one import path from an importing file, the way the host loader does.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#resolveDepTarget" :text "Find a dependency ModuleSummary in deps by real path, declared module name, or import suffix. Ambiguous matches are rejected with ERR_AMBIGUOUS_MODULE.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#loadModuleClosure!" :text "Load the entry file and every module it imports, transitively.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#mapValuesList" :text "The values of a string map.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#importedTypeArity" :text "Find the arity of an exported schema or enum reachable through an import, for unqualified type annotations.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#checkTypeTree" :text "Validate unqualified imported schema and enum names before falling back to local and builtin type checks.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#checkTypeTreeRaw" :text "Walks a parsed annotation, checking local/builtin types, arity, qualified aliases and export visibility. t must be unqualified, straight from ty/parseTypeStr.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#listToSet" :text "A list of names as a presence-only set, the shape checkTypeTree's bound parameter wants.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#cleanNumSign" :text "A numeric token without its leading sign.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#isLiteralAtom?" :text "True for string, boolean, unit and numeric atoms. CHECK-PARITY-B: nil is no literal in the host, which reports it as an unknown symbol (Task54706)")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#keywordCallHeadDiag" :text "CHECKER-keywordCall: (:k v ...) traps at runtime with 'cannot call a Keyword' (vm.c, abi.c): a keyword literal in call-head position is never callable, record or not. Records are built (SchemaName :k v ...) in ASL source, or {:k v ...} in quoted ASN data; a bare keyword head names neither, so it is rejected here rather than left to the incidental unbound-symbol fallback, which a same-named local binding could dodge.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#unionForTag" :text "Resolve prelude and declared enum families; Pair has the single built-in constructor pair.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#armFamily" :text "The union the arm's pattern names: its (case ...) head's when bare is false, its bare case name's when true; empty otherwise.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#matchFamily" :text "The union an mt tests: its first (case ...) pattern's, else its first bare case name's; empty when no arm names a case. The host's matchFamily (compile.c) decides the same way.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ctorPatternAtom?" :text "A bare pattern name tests the tag only when it names a case of the match's union; any other name, a case of another union included, binds the subject.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#catchallPatternAtom?" :text "_, else, or a bare name that is not a case of the match's own union: the arm this closes over, as the host's matchForm/matchT (compile.c, types.c) stop compiling/checking there too. A literal atom is not a catchall (literal arms do not close a match).")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#elseKeywordPatternAtom?" :text "True when pat is literally the keyword atom :else: a literal test, not the catch-all (compile.c's matchForm/types.c's matchT reject it the same way CONDKW rejects :else in cond).")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#unreachableArmDiags" :text "Every arm after a catch-all binder arm, or _/else, can never run (compile.c's matchForm and types.c's matchT both stop compiling/checking there): a diagnostic per unreachable arm, where base silently dropped them with no diagnostic at all (round 2, CHECKER-foreignCtorPattern). A (:else ...) arm itself is rejected separately: it is a keyword literal, not the catch-all, so it never sets isCatchall.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ResolveWorkItem.expr" :text "Expression to evaluate")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ResolveWorkItem.scope" :text "Current lexical scope")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ResolveWorkItem.effectOk" :text "Effect capability")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ResolveState.work" :text "Pending expression stack")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ResolveState.diags" :text "Accumulated diagnostics")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#firstHeadIdent" :text "The head identifier of the first expression.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#bodyPosAt" :text "Line and column of body form idx of a function, 1:1 when the parser gave none.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#placeDiags" :text "The diagnostics moved to a source position.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#resolveModule" :text "Pass 1 and 2 diagnostics: reserved names, module rules, imports and cycles, export closure, type annotations and body resolution.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#bindingItems" :text "the fn-dialect parser writes a [ ] binding vector as (list ...)")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#loadModuleDeps!" :text "the caller knows no importer, so each root in turn stands in for the entry's directory: pass that directory first\nSummaries of the given imports and their closure, keyed by real path and by import path; err, after the lines on stderr, when an import does not resolve or a module does not read or parse.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#arrayBuiltinSig" :text "Signatures of the typed unboxed array family and its kernels, as in the prelude.asn Arrays section; i64 and i8 folds keep an Int64 accumulator, which the host foldScan enforces.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#builtinSig" :text "Signature of a prelude builtin as parameter and return type strings, with a flag for variadic ones.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#builtinSigFallback" :text "Signatures of the builtins outside the array family, which builtinSig consults after arrayBuiltinSig.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#showTypes" :text "showType over a list.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#showType" :text "A type as source text; unresolved variables show as _ or by kind.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#TypeTokState.toks" :text "Token accumulator, reversed")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#TypeTokState.cur" :text "Current atom accumulator")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#parseTypeStr" :text "Parse type text into a Type; names in typevars become type variables.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#collectTvars" :text "Extract single-uppercase-letter type variable names from parameter and return type strings.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#genericMulti?" :text "True for a D159 name with more than one receiver type; its first argument picks the row.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#genericAlias" :text "The concrete builtin of a one-type D159 name, empty for any other name.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#genericConcrete" :text "The concrete builtin a multi-type D159 name has over a receiver type name, empty outside its rows.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#genericCandidates" :text "The receiver type names of a multi-type D159 name, comma separated, for diagnostics.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#receiverOver" :text "The receiver type name a D159 row is keyed by: empty for a type variable, the name for a type of the closed set, ? for any other type.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#isTyVar?" :text "True when t is a type variable.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#genericRenamed" :text "The D159 generic name an old type-prefixed builtin name became, empty for any other name; the hint of a retired name.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#renamedHint" :text "The suffix of an unbound-symbol message for a D159 retired name: \"; renamed to NEW (D159)\", empty for any other name. It shows once the old names leave the builtins.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#genericName?" :text "True for a D159 generic builtin name, multi-type or one-type.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#genericSigName" :text "The name whose builtin signature a call of name has: a one-type generic name's concrete builtin, else name itself.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#" :text "Type AST, Diagnostics, and Builtin Vocabulary for the Self-Hosted Checker.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#Diagnostic.code" :text "Diagnostic rule code")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#Diagnostic.message" :text "Human diagnostic message")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#Diagnostic.msg" :text "Alias for human diagnostic message")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#Diagnostic.line" :text "1-based source line")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#Diagnostic.col" :text "1-based source column")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#Diagnostic.path" :text "Source file path")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#resolveTypeAlias" :text "Canonical name of a builtin type spelling: Int to Int64, Str to String, F64 to Float64; other names unchanged.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#unorderedType?" :text "True for types with no total order, which cannot key a Map.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#intRangeBounds" :text "Inclusive bounds of a fixed-width integer type, none for other types.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#preludeUnionCases" :text "The prelude union a case name belongs to: Option, Result, List or IoError.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#isNumericType?" :text "True for Int32, Int64 and Float64.")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#isIntegralType?" :text "True for Int32 and Int64.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#DepIndex" :text "DEP-INDEX: a module's deps map with, when indexed, a bucket per lookup key (each dep under its name, path, name tails and path tails) so a resolver lookup reads one bucket; unindexed it is the bare map, scanned.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#resolveDepIn" :text "Resolves mpath to one dep through the index (deduplicated bucket, then the scan's pick), ERR_NOT_FOUND for an empty path; an unindexed DepIndex falls back to resolveDepTarget's scan.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#depScanOf" :text "An unindexed DepIndex over deps, for callers that pass a bare deps map; resolveModuleIn rejects it.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#depMatches?" :text "DEP-INDEX: the caller builds both suffixes once per lookup, and stringContains? (a host builtin that does not allocate) rejects a dep before stringEndsWith? slices, so a non-matching dep costs no allocation")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#depKeys" :text "every mpath depMatches? accepts for m: its name, its path, each tail of the name after a /, and each tail of the path after a / with .asl stripped; depIndexOf drops repeats so a bucket holds m once")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#depIndexOf" :text "buckets keep the order of mapValues deps, so a bucket is exactly the sublist the scan filters and deduplicateSummaries returns the same list")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#depCandidates" :text "DEP-INDEX: an indexed lookup reads one bucket instead of scanning every dep; an unindexed one (depScanOf, for callers passing a bare deps map) is the scan")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#resolveModuleIn" :text "DEP-INDEX-GATE: a whole module makes Q lookups, so an unindexed DepIndex would cost Q x D; it is rejected rather than silently scanned")
(:doc :symbol "asl/packages/asl-checker/tests/depIndexTest.asl#" :text "DEP-INDEX and DEP-INDEX-GATE gate: indexed and scanning lookups agree on every probe (ambiguity, name and path tails, keys no rule matches, the empty path), an indexed lookup reads one candidate among 40 or 80 deps while the scan reads all, resolveModule equals resolveModuleIn over depIndexOf, a forged index whose bucket differs from the deps map shows any lookup that rescans the map, resolveModuleIn rejects a scan with ERR_INTERNAL, and qualified references to unexported members are still reported.")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#knownTypeName?" :text "UNKNOWN-TYPE: a name no rule resolves (rule-10 reports it) types as the host's unknown ?, which unifies with anything (unify.asl unknownType?), not as a nominal type every use mismatches; known: a qualified name, a builtin or prelude type (a generic one only at its arity), a single-letter type variable, an internal #name, a schema or enum of this module or one an import exports")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#nullaryCaseValue" :text "a nullary constructor named as a value, start or f/start, is its enum value, not a zero-argument function; (start) still types through the call path")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#typePhaseCode?" :text "the host type pass runs only after a clean compile, or one whose only errors are ERR_NOT_EXPORTED (check.c buildProgram); its codes")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#typeBoundary" :text "TYPE-BOUNDARY: a compile error other than ERR_NOT_EXPORTED (effect markers are checked after both passes) keeps the type diagnostics behind it, as the host reports")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#markedFn?" :text "CHECK-PARITY-B: the host marks a fn effectful by fn ! name or by a name ending in ! (resolve.c declareModule); the parser records only the ! token")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#pickDepTarget" :text "CHECK-PARITY-B: a deps key equal to mpath is the resolution loadTop! made for that exact import (the host resolution), so it wins over name and path suffix matches, which may be ambiguous across the closure")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#checkTypeTreeAt" :text "CHECK-PARITY-B: the host reads a/b/T as T through the import b of the module a names (c/ty/Diagnostic), so the head is checked in that module, its arguments in this one")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#checkCycleEdges" :text "CHECK-PARITY-B: only a cycle back to the checked module is rule-11 (doc: an import cycle through the checked module); a cycle among its imports is skipped here and reported when that module is checked")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#unionForTagRaw" :text "CHECK-PARITY-B: a fn of this module shadows a case name of a dependency, as in the host (localCtorShadowsHidden); a case the module declares itself wins over a prelude case of the same name, as in the host (a local enum Maybe with some and none is checked for exhaustiveness)")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#invalidArmHead" :text "CHECK-PARITY-B: a bare top-level pattern that names a fn of this module, a builtin that is not a constructor, or a form head is not a binder in the host (types.c matchT): ERR_INVALID_MT_ARM")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#closedEnumFamily?" :text "CHECK-PARITY-B: the host checks exhaustiveness only over declared enums (compile.c, enumId from a declared constructor; IoError and Pair are prelude enums); Option, Result and List are built in and a partial match over them traps at run time instead")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#hostOperatorArity?" :text "CHECK-PARITY-B: the host compiles + and * over one or more operands and - over one or two (compile.c, opFor branch), unless the module defines the name")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#fnHead?" :text "CHECK-PARITY-B: a capitalised head that names a fn (RunTests!, FRAME_DATA, alias/Review) is a call in the host (compile.c: DEF_FN before DEF_SCHEMA), not a record constructor")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#exportedFn?" :text "CHECK-PARITY-B: collectSummary files a capitalised export under exportedTypes, so an exported fn named Review is found there too")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#collectAllFieldNames" :text "CHECK-PARITY-B: a dotted access may reach a record declared anywhere in the loaded closure (a type re-exported through a direct import), so field names come from every summary in deps, not only the direct imports; the host checks no field name here")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#unknownType?" :text "UNKNOWN-TYPE: ? is a type name no rule resolves (check.asl knownTypeName?), the host's unknown type, compatible with every type")
(:doc :symbol "asl/packages/asl-checker/tests/checkDepIndexTest.asl#synthSource" :text "a module importing D deps whose body sums Q qualified calls, so a checker that rescans the deps map per typed reference costs Q x D and one reading a DepIndex bucket costs Q")
(:doc :symbol "asl/packages/asl-checker/tests/checkDepIndexTest.asl#synthDepsWithout" :text "synthDeps without pkg/mod'skip', the deps map of a forged index: pickDepTarget takes a deps key equal to the module path before any bucket (CHECK-PARITY-B ae8563d0a), so the forged module must be absent from the map for the bucket to be read")
(:doc :symbol "asl/packages/asl-checker/tests/checkDepIndexTest.asl#testCheckerReadsTheIndex" :text "a forged index whose pkg/mod1 bucket types g as String while its deps map has no pkg/mod1: checkModuleIn reads every typed lookup from the bucket, so (m1/g) returned as Int64 mismatches only through the forged index; a lookup that rescans the map would find no pkg/mod1 and report no type mismatch (CHECKER-A)")
(:doc :symbol "asl/packages/asl-checker/tests/checkDepIndexTest.asl#testCheckSourceDiagnostics" :text "checkSource over the deps map keeps its diagnostics: a clean module is clean and a seeded Int64/String mismatch through an imported signature is reported once")
(:doc :symbol "asl/packages/asl-checker/tests/checkDepIndexTest.asl#main" :text "bench for the allocation gate (CHECKER-A): run this file with ASL_GC_STATS=1 and argument D, for D and 2D; Q is fixed at 2000; bytesAllocated(2D)/bytesAllocated(D) must stay <= 1.05 (base 1.09: each typed qualified reference rescanned the deps map)")
(:doc :symbol "asl/packages/asl-checker/tests/depIndexTest.asl#synthSource" :text "a module importing D deps whose body makes Q qualified references, so a scanning lookup costs Q x D and an indexed one Q")
(:doc :symbol "asl/packages/asl-checker/tests/depIndexTest.asl#trickyDeps" :text "the shapes resolveDepTarget distinguishes: an ambiguous suffix, a name-only and a path-only match, one summary under two keys, a prefix collision (mod1/mod10), a path without .asl and a nested name")
(:doc :symbol "asl/packages/asl-checker/tests/depIndexTest.asl#testResolverReadsTheIndex" :text "a forged index whose pkg/mod1 bucket exports g while the deps map does not: the resolver threads the index, so every lookup goes through the bucket and none rescans the map; resolveModuleIn refuses a scan, so resolveModule passing anything but depIndexOf turns the last assertion red (DEP-INDEX-GATE)")
(:doc :symbol "asl/packages/asl-checker/tests/depIndexTest.asl#main" :text "bench for the allocation gate (DEP-INDEX): run this file with ASL_GC_STATS=1 and argument D, for D and 2D; Q is fixed at 2000; bytesAllocated(2D)/bytesAllocated(D) must stay <= 1.15")
(:doc :symbol "asl/packages/asl-checker/tests/parityBTest.asl#testNameBangMarksEffect" :text "OK~ERR_EFFECT_UNMARKED: the host marks a fn by fn ! name or by a name ending in ! (resolve.c declareModule)")
(:doc :symbol "asl/packages/asl-checker/tests/parityBTest.asl#testOperatorArity" :text "OK~ERR_ARITY: the host compiles + and * over one or more operands and - over one or two, every other operator over two")
(:doc :symbol "asl/packages/asl-checker/tests/parityBTest.asl#testFieldFromClosure" :text "OK~ERR_UNKNOWN_SYMBOL (field): a dotted access may name a field of a record declared anywhere in the loaded closure")
(:doc :symbol "asl/packages/asl-checker/tests/parityBTest.asl#testCycleThroughRootOnly" :text "OK~rule-11: only a cycle back to the checked module is rule-11; a cycle among its imports is reported when one of those modules is checked")
(:doc :symbol "asl/packages/asl-checker/tests/parityBTest.asl#testExhaustiveOverDeclaredEnums" :text "OK~ERR_MATCH_NONEXHAUSTIVE: the host checks exhaustiveness over declared enums only; a partial match over Option, Result or List passes check and traps at run time")
(:doc :symbol "asl/packages/asl-checker/tests/parityBTest.asl#testExactImportKeyWins" :text "OK~ERR_AMBIGUOUS_MODULE: a deps key equal to the import is the resolution the loader made for it, so it wins over suffix matches elsewhere in the closure")
(:doc :symbol "asl/packages/asl-checker/tests/parityBTest.asl#testChainedQualifiedType" :text "OK~ERR_NOT_EXPORTED: a/b/T names T through the import b of the module a names, as the host reads c/ty/Diagnostic")
(:doc :symbol "asl/packages/asl-checker/tests/parityBTest.asl#testInvalidArmHead" :text "ERR_INVALID_MT_ARM~OK: a bare top-level pattern naming a fn of the module, a builtin or a form head is invalid in the host, not a binder")
(:doc :symbol "asl/packages/asl-checker/tests/parityBTest.asl#testNilIsUnknown" :text "ERR_UNKNOWN_SYMBOL~ERR_UNKNOWN_SYMBOL: nil is an unknown symbol in the host, not a literal")
(:doc :symbol "asl/packages/asl-checker/tests/parityBTest.asl#testCapitalisedFnIsCall" :text "OK~ERR_UNKNOWN_SYMBOL (capitalised call): a capitalised head naming a fn is a call in the host, not a record constructor")
(:doc :symbol "asl/packages/asl-checker/tests/typeParityBucketsTest.asl#testUnknownTypeName" :text "bucket unknownType: a type name no rule resolves, such as (pair A B), Any or (Fn A R), is the host's unknown and unifies with anything (rule-10 reports the name); a resolved type still mismatches")
(:doc :symbol "asl/packages/asl-checker/tests/typeParityBucketsTest.asl#testAssertTrap" :text "bucket assertTrap: (assert false m) and (refute true m) never return, so like the host they take any type; a passing assert is still Unit")
(:doc :symbol "asl/packages/asl-checker/tests/typeParityBucketsTest.asl#testPrintReturnsUnit" :text "bucket printUnit: print, println and eprintln take a value of any type and return Unit (prelude.c bPrint/bPrintln/bEprintln return VUNIT), not (Result Unit IoError)")
(:doc :symbol "asl/packages/asl-checker/tests/typeParityBucketsTest.asl#testNullaryCaseValue" :text "bucket nullaryCase: a nullary constructor named as a value is its enum value, as the host reads it, not a zero-argument function; a zero-argument function named as a value is still a function")
(:doc :symbol "asl/packages/asl-checker/tests/typeParityBucketsTest.asl#testEffectfulFnType" :text "bucket fnBang: an effectful function type (fn ! [A] -> R) is a one-parameter function, the ! marks its effect and is not a parameter")
(:doc :symbol "asl/packages/asl-checker/tests/typeParityBucketsTest.asl#testUnitParensAnnotation" :text "bucket unitParens: the annotation () is Unit, as -> () on a lambda writes it, not a type named )")
(:doc :symbol "asl/packages/asl-checker/tests/typeParityBucketsTest.asl#testTypeBoundary" :text "bucket typeBoundary: like the host (check.c buildProgram), checkFile! reports type diagnostics only when no compile error other than ERR_NOT_EXPORTED precedes them; a file whose only error is a type error still reports it")
(:doc :symbol "asl/packages/asl-checker/src/unify.asl#textType?" :text "TEXT-KIND: a type variable of kind text (sig letter X) binds only String or Bytes, the content the host fileWrite and fileAppend accept")
(:doc :symbol "asl/packages/asl-checker/tests/typeParityBucketsTest.asl#testIoErrorPayloads" :text "bucket ioErrString: fileReadString, fileReadBytes, fileWrite and fileAppend fail with the host message String \"KIND: PATH: reason\" (prelude.c ioErr); only the prelude's fileRead and pathCanonicalize map it to IoError")
(:doc :symbol "asl/packages/asl-checker/tests/typeParityBucketsTest.asl#testTextKind" :text "bucket textKind: fileWrite and fileAppend content is String or Bytes (prelude.c bFileWrite, sys.c bFileAppend take both); any other content type is still a mismatch")
(:doc :symbol "asl/packages/asl-checker/tests/typeParityBucketsTest.asl#testMiscChecker" :text "bucket misc: a local named none or a module fn named quote shadows the builtin (the host has no quote form); (g) on an unannotated g calls it with no arguments; SpawnedProc has the host record fields pid stdin stdout stderr; cpuCount returns (Result Int64 String) (sys.c bCpuCount)")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#hostBuiltinSig" :text "CHECKER-RULE1 bucket missingBuiltinSig: bytesSha256, fileChmod, fileFsync, getHomeDir, localDate, procRusage, zstdDecompress, popcount64 and the six parquetX readers are real prelude.asn builtins the checker's signature table had dropped; a direct name now gets a signature instead of only its genericAlias sugar (bytesSha256) or nothing at all")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#knownTypeName?" :text "CHECKER-RULE1: ParquetHandle added as a known nominal type alongside the other opaque host records (FileStat, PlatformInfo, Rusage, SpawnedProc), so parquetOpen's result type annotates cleanly")
(:doc :symbol "asl/packages/asl-checker/tests/unknownSymbolBucketsTest.asl#testMissingBuiltinSig" :text "bucket missingBuiltinSig: OK~ERR_UNKNOWN_SYMBOL census class, root cause builtin missing from the checker's table (see types.asl#hostBuiltinSig)")
(:doc :symbol "asl/packages/asl-checker/tests/unknownSymbolBucketsTest.asl#testStillCatchesRealUnknowns" :text "sanity fixture: a genuinely unbound symbol is still ERR_UNKNOWN_SYMBOL after each CHECKER-RULE1 bucket, so none of them loosened rule-1/rule-2 in general")
(:doc :symbol "asl/packages/asl-checker/tests/unknownSymbolBucketsTest.asl#testPreludeSourcedBuiltins" :text "bucket preludeSourcedBuiltins: OK~ERR_UNKNOWN_SYMBOL census class, root cause preludeIoError, preludeFnvStep, zstdAslPack64, zstdAslXxhHash and zstdAslDecompress are plain top-level fns of prelude.asl (:x []), given host-wide visibility the same way the host gives every prelude.asl top-level fn, but the checker only special-cases a short hardcoded list of constructor-like names via resolve.asl's isPreludeTag? and otherwise requires a types.asl signature table entry like any other host builtin (see types.asl#hostBuiltinSig)")
(:doc :symbol "asl/packages/asl-checker/src/types.asl#builtinSigFallback" :text "CHECKER-RULE1 bucket cmpAliasOperators: == and not= are prelude.asn aliases of = and != (\"the same operator as\"); cmpBinopSig now covers all four spellings")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#rResolveTick" :text "CHECKER-RULE1 bucket cmpAliasOperators: a call headed by == no longer gets a hardcoded builtin-reference diagnostic (== was never a value-reference case, it was always called with two arguments like =); it now falls through to the normal call-head arity path, matching the host which treats it exactly like =")
(:doc :symbol "asl/packages/asl-checker/tests/unknownSymbolBucketsTest.asl#testCmpAliasOperators" :text "bucket cmpAliasOperators: OK~ERR_UNKNOWN_SYMBOL census class, root cause == and not= missing from cmpBinopSig and resolve.asl's incorrect == special case (see types.asl#builtinSigFallback, resolve.asl#rResolveTick)")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#inferAtom" :text "CHECKER-RULE1 bucket keywordLiteral: a bare keyword atom not bound as a local (e.g. :full in a vector literal, or a whole top-level (:tag ...) data form walked as a/topExpr) types as Keyword instead of falling through to the unbound-symbol case; resolve.asl's rResolveTick already skipped keywords the same way, this was check.asl's matching gap")
(:doc :symbol "asl/packages/asl-checker/tests/unknownSymbolBucketsTest.asl#testKeywordLiteral" :text "bucket keywordLiteral: OK~ERR_UNKNOWN_SYMBOL census class, root cause inferAtom missing a Keyword-literal case (see check.asl#inferAtom)")
(:doc :symbol "asl/packages/asl-checker/src/lint.asl#" :text "IDIOMLINT: a separate advisory pass over parsed defuns, never mixed into checkModule/checkFile!/checkSource's diagnostics (which asl check's exit status and checkParityTest's host comparison both key off); callers that want warnings run it on the side.")
(:doc :symbol "asl/packages/asl-checker/src/lint.asl#LintHit" :text "One lint finding: a stable code, the offending fn name, a human message with a suggested rewrite, and a position (the fn's first body form, like untypedParamDiags).")
(:doc :symbol "asl/packages/asl-checker/src/lint.asl#quadraticListGetHit?" :text "QUAD-LISTGET idiom: a defun with an Int-typed parameter, a self-recursive call anywhere in its body (the loop step) and a (listGet list counter) call indexed by that same parameter anywhere in its body; matches the qualifyTypesStep-shaped pattern fixed by 951171640/c042c49d2/d27577769 (idx/len/acc walked by listGet idx, appended with listAppend acc (list x), recursing on idx+1), each call is O(n) so the whole walk is O(n^2). A plain listHead/listTail walk has no listGet call and is never flagged; a single non-recursive listGet (a literal or one-shot index lookup) has no self-call and is never flagged either." :method "asl-checker/tests/quadLintTest.asl's three fixtures" :date "2026-10-11")
(:doc :symbol "asl/packages/asl-checker/src/lint.asl#lintModule" :text "Every LINT_QUADRATIC_LISTGET hit across a module's top-level defuns, in source order.")
(:doc :symbol "asl/packages/asl-checker/tests/quadLintTest.asl#" :text "Falsifiable fixture for the LINT_QUADRATIC_LISTGET idiom lint (IDIOMLINT): a synthetic listGet-by-counter recursive fn is flagged, a listHead/listTail walk and a single non-recursive listGet are not.")
