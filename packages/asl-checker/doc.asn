(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#resolveDepTarget" :text "Find a dependency ModuleSummary in deps by real path, declared module name, or import suffix. Ambiguous matches are rejected with ERR_AMBIGUOUS_MODULE.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#loadModuleClosure!" :text "Load the entry file and every module it imports, transitively.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#mapValuesList" :text "The values of a string map.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#importedTypeArity" :text "Find the arity of an exported schema or enum reachable through an import, for unqualified type annotations.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#checkTypeTree" :text "Validate unqualified imported schema and enum names before falling back to local and builtin type checks.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#checkTypeTreeRaw" :text "Walks a parsed annotation, checking local/builtin types, arity, qualified aliases and export visibility. t must be unqualified, straight from ty/parseTypeStr.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#listToSet" :text "A list of names as a presence-only set, the shape checkTypeTree's bound parameter wants.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#cleanNumSign" :text "A numeric token without its leading sign.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#isLiteralAtom?" :text "True for string, boolean, unit and numeric atoms.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#keywordCallHeadDiag" :text "CHECKER-keywordCall: (:k v ...) traps at runtime with 'cannot call a Keyword' (vm.c, abi.c): a keyword literal in call-head position is never callable, record or not. Records are built (SchemaName :k v ...) in ASL source, or {:k v ...} in quoted ASN data; a bare keyword head names neither, so it is rejected here rather than left to the incidental unbound-symbol fallback, which a same-named local binding could dodge.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#unionForTag" :text "Resolve prelude and declared enum families; Pair has the single built-in constructor pair.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#armFamily" :text "The union the arm's pattern names: its (case ...) head's when bare is false, its bare case name's when true; empty otherwise.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#matchFamily" :text "The union an mt tests: its first (case ...) pattern's, else its first bare case name's; empty when no arm names a case. The host's matchFamily (compile.c) decides the same way.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ctorPatternAtom?" :text "A bare pattern name tests the tag only when it names a case of the match's union; any other name, a case of another union included, binds the subject.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#catchallPatternAtom?" :text "_, else, or a bare name that is not a case of the match's own union: the arm this closes over, as the host's matchForm/matchT (compile.c, types.c) stop compiling/checking there too. A literal atom is not a catchall (literal arms do not close a match).")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#elseKeywordPatternAtom?" :text "True when pat is literally the keyword atom :else: a literal test, not the catch-all (compile.c's matchForm/types.c's matchT reject it the same way CONDKW rejects :else in cond).")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#unreachableArmDiags" :text "Every arm after a catch-all binder arm, or _/else, can never run (compile.c's matchForm and types.c's matchT both stop compiling/checking there): a diagnostic per unreachable arm, where base silently dropped them with no diagnostic at all (round 2, CHECKER-foreignCtorPattern). A (:else ...) arm itself is rejected separately: it is a keyword literal, not the catch-all, so it never sets isCatchall.")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ResolveWorkItem.expr" :text "Expression to evaluate")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ResolveWorkItem.scope" :text "Current lexical scope")
(:doc :symbol "asl/packages/asl-checker/src/resolve.asl#ResolveWorkItem.effectOk" :text "Effect capability")
