(:doc :symbol "asl/packages/asl-checker/src/check.asl#InferState.diags" :text "Pass 3 diagnostics")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#InferState.deferred" :text "D159 generic calls whose receiver was a type variable when the call was inferred")
(:doc :symbol "asl/packages/asl-checker/src/check.asl#Deferred.name" :text "Generic name")
