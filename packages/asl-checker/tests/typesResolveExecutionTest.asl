(module asl-checker/tests/typesResolveExecutionTest :x [testTypesDynamicExecution! testResolveDynamicExecution! testPreludeDynamicRegistry! runTests] :i [(asl-tools/fleet/run :a run)])

fn testTypesDynamicExecution! -> Bool
  (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-checker/tests/typesTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit) (out res.out)] (assert (= code 0) "asl-checker typesTest passes cleanly") (refute (!= code 0) "asl-checker typesTest must exit 0") (assert (stringContains? out "assertion(s) executed") "typesTest executed assertions") (refute (stringContains? out "0 assertion(s) executed") "typesTest assertions must not be 0") true)

fn testResolveDynamicExecution! -> Bool
  (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-checker/tests/resolveTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit) (out res.out)] (assert (= code 0) "asl-checker resolveTest passes cleanly") (refute (!= code 0) "asl-checker resolveTest must exit 0") (assert (stringContains? out "assertion(s) executed") "resolveTest executed assertions") (refute (stringContains? out "0 assertion(s) executed") "resolveTest assertions must not be 0") true)

fn testPreludeDynamicRegistry! -> Bool
  (let [(resSymbols (run/runOneLimited (run/job (list "grep" "-E" "\"dirList\"|\"processRun\"|\"fileStat\"" "asl/prelude/prelude.asn") "." (run/childEnv (list))) (run/limits 180 8))) (codeSymbols resSymbols.exit) (outSymbols resSymbols.out)] (assert (= codeSymbols 0) "prelude.asn names all 4 syscalls (bound or target)") (refute (!= codeSymbols 0) "prelude.asn must declare syscall builtins") (assert (stringContains? outSymbols "dirList") "prelude contains dirList") (refute (not (stringContains? outSymbols "dirList")) "dirList must be declared in prelude") (assert (stringContains? outSymbols "processRun") "prelude contains processRun") (refute (not (stringContains? outSymbols "processRun")) "processRun must be declared in prelude") (assert (stringContains? outSymbols "fileStat") "prelude contains fileStat") (refute (not (stringContains? outSymbols "fileStat")) "fileStat must be declared in prelude") (let [(resTypes (run/runOneLimited (run/job (list "grep" "-A" "2" "-E" ":(name|target) \"(dirList|processRun|fileStat)\"" "asl/prelude/prelude.asn") "." (run/childEnv (list))) (run/limits 180 8))) (outTypes resTypes.out)] (assert (stringContains? outTypes "(Result (List String) String)") "prelude has dirList signature") (refute (not (stringContains? outTypes "(Result (List String) String)")) "dirList signature must match") (assert (stringContains? outTypes "ProcessOutput") "prelude has processRun signature") (refute (not (stringContains? outTypes "ProcessOutput")) "processRun signature must match") (assert (stringContains? outTypes "(Result FileStat String)") "prelude has fileStat signature") (refute (not (stringContains? outTypes "(Result FileStat String)")) "fileStat signature must match") true))

fn ! runTests -> Bool
  (do (assert (testTypesDynamicExecution!) "testTypesDynamicExecution passes") (assert (testResolveDynamicExecution!) "testResolveDynamicExecution passes") (assert (testPreludeDynamicRegistry!) "testPreludeDynamicRegistry passes") true)
