(:package asl-conform
 :version "0.1.0"
 :entry "src/main.asl"
 :description "AgentScript Multi-Target Semantic Conformance and Mutation Verification Harness"
 :aslFirst true
 :modules [
   "aslConform/types"
   "aslConform/semantics"
   "aslConform/compare"
   "aslConform/mutant"
   "aslConform/runner"
   "asl-conform/hypergraph"
   "aslConform/main"
 ]
 :dependencies ["asl-target-c" "asl-target-py"])
