(module asl/packages/asl-conform/tests/auditHypergraphTest :x [runTests] :i [(asl-conform/hypergraph :a hyper) (asl-ui/auditDashboard :a dash) (asl-cli/auditCmd :a cmd) (asl-ui/vnode :a v)])

fn testAuditHypergraphDataStructure -> Bool
  (do (let [(graph (cmd/buildSampleAuditGraph))] (assert (= graph.version "0.1.0") "AuditHypergraph version matches schema 0.1.0") (assert (== (listLength graph.nodes) 6) "Sample hypergraph contains 6 diagnostic findings") (assert (== (listLength graph.edges) 3) "Sample hypergraph contains 3 causal edges") (assert (> graph.score 0) "Composite integrity score is strictly positive") (assert (<= graph.score 100) "Composite integrity score is bounded at 100") (let [(lenses (hyper/canonicalLenses))] (assert (== (listLength lenses) 6) "Exact 6 canonical diagnostic lenses defined under ADR D98") (assert (listContains? lenses "architecture") "Canonical lens: architecture present") (assert (listContains? lenses "platform") "Canonical lens: platform present") (assert (listContains? lenses "logic") "Canonical lens: logic present") (assert (listContains? lenses "memory") "Canonical lens: memory present") (assert (listContains? lenses "security") "Canonical lens: security present") (assert (listContains? lenses "tokenEconomics") "Canonical lens: tokenEconomics present") (refute (< (listLength lenses) 6) "refutation: canonical lenses cannot be fewer than 6") (refute (listContains? lenses "bogusLens") "refutation: non-existent lens must not be in canonical list")) (refute (< graph.score 0) "refutation: composite score must not be negative") (refute (> graph.score 100) "refutation: composite score cannot exceed 100") (refute (stringEmpty? (hyper/formatAuditAsn graph)) "refutation: formatted ASN must not be empty")) true)

fn testAuditGraphQueryAndFiltering -> Bool
  (let [(graph (cmd/buildSampleAuditGraph))] (let [(secNodes (hyper/queryAuditGraph graph (some "security") (none) (none))) (warnNodes (hyper/queryAuditGraph graph (none) (some "warning") (none))) (compNodes (hyper/queryAuditGraph graph (none) (none) (some "asl-compiler")))] (assert (== (listLength secNodes) 1) "Security lens filter returns exactly 1 finding") (assert (= (optionOr (listHead secNodes) (hyper/makeAuditNode "" "" "" "" "" "" "")).lens "security") "Returned node is security lens") (assert (== (listLength warnNodes) 2) "Warning severity filter returns 2 findings") (assert (= (optionOr (listHead warnNodes) (hyper/makeAuditNode "" "" "" "" "" "" "")).severity "warning") "Returned node has warning severity") (assert (== (listLength compNodes) 2) "Anchor prefix asl-compiler returns 2 findings") (refute (listEmpty? secNodes) "refutation: security nodes must not be empty") (refute (listEmpty? warnNodes) "refutation: warning nodes must not be empty") (refute (listEmpty? compNodes) "refutation: compiler-anchored nodes must not be empty") (refute (listAny? (fn [(n hyper/AuditNode)] -> Bool (!= n.lens "security")) secNodes) "refutation: no non-security nodes in security query")) (let [(emptyRes (hyper/queryAuditGraph graph (some "nonExistentLens") (none) (none)))] (assert (listEmpty? emptyRes) "Non-existent lens query returns empty list") (refute (not (listEmpty? emptyRes)) "refutation: bogus query must return empty list")) true)

fn testCycleDetectionAndBlastRadius -> Bool
  (do (let [(e1 (hyper/makeAuditEdge "ModuleA" "ModuleB" "imports")) (e2 (hyper/makeAuditEdge "ModuleB" "ModuleC" "imports")) (e3 (hyper/makeAuditEdge "ModuleC" "ModuleA" "imports")) (eAcyclic (hyper/makeAuditEdge "ModuleX" "ModuleY" "imports"))] (let [(cycleEdges (list e1 e2 e3)) (acyclicEdges (list eAcyclic))] (assert (hyper/pathExists? cycleEdges "ModuleA" "ModuleC" (list)) "Path from A to C exists in cyclic graph") (assert (hyper/pathExists? cycleEdges "ModuleC" "ModuleA" (list)) "Path from C to A exists in cyclic graph") (assert (not (hyper/pathExists? acyclicEdges "ModuleY" "ModuleX" (list))) "No path from Y to X in acyclic graph") (let [(cycles (hyper/detectCycles cycleEdges)) (noCycles (hyper/detectCycles acyclicEdges))] (assert (> (listLength cycles) 0) "Cycles detected in circular import graph") (assert (listEmpty? noCycles) "No cycles detected in acyclic edge list") (refute (listEmpty? cycles) "refutation: circular graph must report cycles") (refute (not (listEmpty? noCycles)) "refutation: acyclic graph must report zero cycles")))) (let [(graph (cmd/buildSampleAuditGraph)) (targetAnchor "asl-compiler:macho:hostDarwinAdapter")] (let [(radius (hyper/calculateBlastRadius graph targetAnchor))] (assert (listContains? radius targetAnchor) "Blast radius contains target anchor") (assert (listContains? radius "arch/coupling/core") "Blast radius contains connected causal audit node") (refute (not (listContains? radius targetAnchor)) "refutation: target anchor must be in blast radius") (refute (listContains? radius "unrelatedAnchor") "refutation: unrelated anchor not in blast radius"))) true)

fn testPatchReceiptGeneration -> Bool
  (do (let [(node (hyper/makeAuditNode "sec/cap/dce" "security" "error" "asl-compiler:compiler:eliminateDeadCapabilities" "Dead capability leakage in emitter" "(prune-stubs :capabilities [:netSocket])" "rule-security-dce"))] (let [(rc (hyper/emitPatchReceipt node))] (assert (= rc.status "ready") "PatchReceipt status is ready") (assert (= rc.target node.anchor) "PatchReceipt target matches node anchor") (assert (stringStartsWith? rc.id "rc-") "PatchReceipt id prefixed with rc-") (assert (< rc.tokenCount 120) "PatchReceipt token count strictly under 120 tokens") (assert (> rc.tokenCount 0) "PatchReceipt token count is strictly positive") (let [(asnStr (hyper/formatReceiptAsn rc))] (assert (stringContains? asnStr ":patchReceipt") "Formatted receipt carries :patchReceipt form") (assert (stringContains? asnStr ":tokens") "Formatted receipt declares :tokens") (refute (>= rc.tokenCount 120) "refutation: token count must never exceed 120 tokens") (refute (stringEmpty? rc.diffStr) "refutation: diff string must not be empty") (refute (!= rc.status "ready") "refutation: status must be ready") (refute (stringContains? asnStr ":line") "refutation: zero line numbers in PatchReceipt")))) true)

fn testAuditDashboardVdomAndSvgRadar -> Bool
  (do (let [(graph (cmd/buildSampleAuditGraph)) (scores (dash/extractLensScores graph.nodes))] (let [(svg (dash/renderRadarSvg scores)) (points (dash/radarAxisPoints scores))] (assert (stringContains? svg "<svg") "SVG markup begins with svg element") (assert (stringContains? svg "asl-audit-radar") "SVG element carries asl-audit-radar class") (assert (stringContains? svg "Architecture") "Radar chart contains Architecture axis label") (assert (stringContains? svg "Platform") "Radar chart contains Platform axis label") (assert (stringContains? svg "Logic") "Radar chart contains Logic axis label") (assert (stringContains? svg "Memory") "Radar chart contains Memory axis label") (assert (stringContains? svg "Security") "Radar chart contains Security axis label") (assert (stringContains? svg "TokenEconomics") "Radar chart contains TokenEconomics axis label") (assert (> (stringLength points) 10) "Radar axis polygon points non-empty") (refute (not (stringContains? svg "</svg>")) "refutation: SVG must be properly closed") (refute (stringContains? svg ":line") "refutation: zero line numbers in SVG dashboard") (refute (stringContains? svg "<script") "refutation: zero foreign JS script tags in pure ASL dashboard")) (let [(dashTree (dash/renderAuditDashboard graph))] (assert (= dashTree.tag "container") "Dashboard root is container VNode") (assert (= dashTree.key "audit-dashboard-root") "Dashboard root key matches audit-dashboard-root") (refute (listEmpty? dashTree.children) "refutation: dashboard children must not be empty"))) true)

fn testCliAuditCommandDispatch! -> Bool
  (do (let [(resHelp (cmd/runAuditCommand (list "help"))) (resRun (cmd/runAuditCommand (list "run"))) (resQuery (cmd/runAuditCommand (list "query" "lens:security"))) (resReceipt (cmd/runAuditCommand (list "receipt" "sec/cap/dce"))) (resVdom (cmd/runAuditCommand (list "vdom")))] (assert (ok? resHelp) "asl audit help executes cleanly") (assert (stringContains? (optionOr (resultToOption resHelp) "") "Usage: asl audit") "Help manual contains Usage: asl audit") (assert (ok? resRun) "asl audit run executes cleanly") (assert (stringContains? (optionOr (resultToOption resRun) "") ":auditHypergraph") "asl audit run returns :auditHypergraph") (assert (ok? resQuery) "asl audit query executes cleanly") (assert (stringContains? (optionOr (resultToOption resQuery) "") ":queryResult") "asl audit query returns :queryResult") (assert (ok? resReceipt) "asl audit receipt executes cleanly") (assert (stringContains? (optionOr (resultToOption resReceipt) "") ":patchReceipt") "asl audit receipt returns :patchReceipt") (assert (ok? resVdom) "asl audit vdom executes cleanly") (assert (stringContains? (optionOr (resultToOption resVdom) "") "<svg") "asl audit vdom returns SVG radar") (refute (err? resHelp) "refutation: help command must not fail") (refute (err? resRun) "refutation: run command must not fail") (refute (err? resQuery) "refutation: query command must not fail") (refute (err? resReceipt) "refutation: receipt command must not fail")) true)

fn testZeroLineNumberInvariantInAuditHypergraph! -> Bool
  (let [(rSchema (fileRead "asl/grammar/audit.asn")) (rHyper (fileRead "asl/packages/asl-conform/src/hypergraph.asl")) (rDash (fileRead "asl/packages/asl-ui/src/auditDashboard.asl")) (rCmd (fileRead "asl/packages/asl-cli/src/auditCmd.asl"))] (let [(cSchema (mt rSchema ((ok s) s) ((err _) ""))) (cHyper (mt rHyper ((ok s) s) ((err _) ""))) (cDash (mt rDash ((ok s) s) ((err _) ""))) (cCmd (mt rCmd ((ok s) s) ((err _) "")))] (refute (stringContains? cSchema ":line") "no :line in audit.asn") (refute (stringContains? cSchema "#L") "no #L in audit.asn") (refute (stringContains? cHyper "#L") "no #L in hypergraph.asl") (refute (stringContains? cDash "#L") "no #L in auditDashboard.asl") (refute (stringContains? cCmd "#L") "no #L in auditCmd.asl")) true)

fn ! runTests -> Bool
  (and (and (and (testAuditHypergraphDataStructure) (testAuditGraphQueryAndFiltering)) (and (testCycleDetectionAndBlastRadius) (testPatchReceiptGeneration))) (and (and (testAuditDashboardVdomAndSvgRadar) (testCliAuditCommandDispatch!)) (testZeroLineNumberInvariantInAuditHypergraph!)))
