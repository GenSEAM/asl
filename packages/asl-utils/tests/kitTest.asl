(module asl-utils/tests/kitTest
  :x [runTests]
  :i [(asl-tools/fleet/run :a fr) (asl-utils/kit :a kit)])

; (:m :ref SCRIPT-KIT :do "flags, args and env parse as declared; the diff is a valid unified diff with hunks split by context; writes are atomic and keep the mode; a three-line script replaces a word under --dry without writing and edits on a real run; edits outside the working directory are refused")
fn parsed argv: (List String) spec: String -> kit/Kit
  (match (kit/parse argv spec)
    ((ok k) k)
    ((err e) (kit/Kit :flags (list) :vals (mapSet (mapEmpty) "parseError" e) :args (list) :help false :dry false :outside false :root "")))

fn parseError argv: (List String) spec: String -> String
  (match (kit/parse argv spec)
    ((ok _) "")
    ((err e) e))

fn ! testFlags -> Bool
  (let [(spec "n=1000 dry=false out=x")
        (dflt (parsed (list) spec))
        (given (parsed (list "--n" "5" "--dry" "--out=y" "a.asl" "--" "--n") spec))]
    (do (assert (= (kit/flagInt dflt "n") 1000) "an int flag defaults to its declared value")
        (refute (kit/flagOn? dflt "dry") "a bool flag declared false is off by default")
        (assert (= (kit/flag dflt "out") "x") "a string flag defaults to its declared value")
        (assert (= (kit/flagInt given "n") 5) "--n 5 takes the next argument as the value")
        (assert given.dry "--dry alone turns the bool flag on and sets the kit's dry mode")
        (assert (= (kit/flag given "out") "y") "--out=y takes the value after the equals sign")
        (assert (= given.args (list "a.asl" "--n")) (str "positionals stay in order and everything after -- is positional: " (stringJoin given.args ",")))
        (assert (= (kit/arg given 0 "none") "a.asl") "arg reads the first positional")
        (assert (= (kit/arg given 5 "none") "none") "arg falls back past the end")
        (assert (= (kit/argNum (parsed (list "7") "") 0 3) 7) "argNum parses a positional integer")
        (assert (= (kit/argNum (parsed (list "x") "") 0 3) 3) "argNum falls back on a non-integer")
        (assert (= (parseError (list "--bogus") spec) "unknown flag --bogus; known: --n --dry --out --allow-outside --help") (parseError (list "--bogus") spec))
        (assert (= (parseError (list "-q") spec) "unknown flag -q; known: --n --dry --out --allow-outside --help") "a short unknown flag is an error too")
        (assert (= (parseError (list "--n" "five") spec) "flag --n takes an integer, given \"five\"") "an int flag rejects a non-integer")
        (assert (= (parseError (list "--out") spec) "flag --out needs a value") "a value flag at the end needs a value")
        (assert (= (parseError (list "--dry=maybe") spec) "flag --dry takes true or false, given \"maybe\"") "a bool flag rejects other values")
        (assert (= (kit/argNum (parsed (list "-4") "") 0 0) -4) "a negative number is a positional, not a flag")
        (assert (parsed (list "-h") spec).help "-h asks for help")
        (assert (stringContains? (kit/help (parsed (list "--help") spec)) "  --n INT (default 1000)\n") (kit/help dflt))
        (assert (stringContains? (kit/help dflt) "  --out STR (default x)\n") "help lists string flags with their default")
        (assert (stringContains? (kit/help dflt) "  --allow-outside  let edits leave the current directory\n") "help lists the built-in flags")
        true))

fn ! testEnv -> Bool
  (do (assert (= (kit/env "ASL_KIT_SURELY_UNSET_VARIABLE" "fallback") "fallback") "an unset variable reads as the fallback")
      (assert (not (stringEmpty? (kit/env "HOME" ""))) "a set variable reads its value")
      true)

fn ! testDiff -> Bool
  (let [(one (kit/diff "f" "a\nfoo\nb\n" "a\nbar\nb\n"))
        (far (kit/diff "f" "x\n1\n2\n3\n4\n5\n6\n7\n8\ny\n" "X\n1\n2\n3\n4\n5\n6\n7\n8\nY\n"))
        (near (kit/diff "f" "x\n1\n2\n3\n4\n5\n6\ny\n" "X\n1\n2\n3\n4\n5\n6\nY\n"))
        (eol (kit/diff "f" "a\nb" "a\nc"))
        (grow (kit/diff "f" "a\n" "a\nb\nc\n"))]
    (do (assert (= one.text "--- a/f\n+++ b/f\n@@ -1,3 +1,3 @@\n a\n-foo\n+bar\n b\n") one.text)
        (assert (= one.hunks 1) "one changed line is one hunk")
        (assert (= far.hunks 2) (str "changes seven equal lines apart are two hunks: " far.text))
        (assert (stringContains? far.text "@@ -7,4 +7,4 @@\n 6\n 7\n 8\n-y\n+Y\n") far.text)
        (assert (= near.hunks 1) (str "changes six equal lines apart share one hunk: " near.text))
        (assert (= eol.text "--- a/f\n+++ b/f\n@@ -1,2 +1,2 @@\n a\n-b\n\\ No newline at end of file\n+c\n\\ No newline at end of file\n") eol.text)
        (assert (= grow.text "--- a/f\n+++ b/f\n@@ -1,1 +1,3 @@\n a\n+b\n+c\n") grow.text)
        (assert (= (kit/diff "f" "same\n" "same\n").hunks 0) "equal texts have no hunks")
        true))

fn ! testText -> Bool
  (do (assert (= (kit/replaceAll "a.a.a" "." "-") "a-a-a") "replaceAll replaces every occurrence")
      (assert (= (kit/sub "(\\w+)@x" "me@x you@x" "\\1") (ok "me you")) "sub replaces regex matches with a template")
      (assert (= (kit/found? "^ab+$" "abbb") (ok true)) "found? matches a regex")
      (assert (err? (kit/sub "(" "x" "y")) "a bad regex is an error, not a no-op")
      (assert (= (kit/globRegex "**/*.asl") "^(?:.*/)?[^/]*\\.asl$") (kit/globRegex "**/*.asl"))
      true)

fn ! put! dir: String name: String text: String -> String
  (let [(path (str dir "/" name)) (_ (fileWrite path text))] path)

fn ! testFiles root: String work: String -> Bool
  (let [(rel (optionOr (stringSlice work (+ (stringLength root) 1) (stringLength work)) work))
        (_ (dirCreate (str work "/sub")))
        (_ (put! work "b.asl" "foo\n"))
        (_ (put! work "a.asl" "x\n"))
        (_ (put! work "sub/c.asl" "foo\n"))
        (_ (put! work "d.txt" "foo\n"))
        (_ (fileChmod (str work "/b.asl") 448))
        (flat (kit/glob! (str rel "/*.asl")))
        (deep (kit/glob! (str rel "/**/*.asl")))
        (ignored (kit/globGit! (str rel "/**/*.asl")))
        (tracked (kit/globGit! "asl/packages/asl-utils/src/*.asl"))
        (wrote (kit/writeText! (str rel "/b.asl") "new\n"))
        (mode (match (fileStat (str work "/b.asl")) ((ok st) (mod st.mode 4096)) ((err _) -1)))
        (left (match (dirList work) ((ok names) (listAny? (fn [(n String)] -> Bool (stringEndsWith? n ".tmp")) names)) ((err _) true)))
        (outside (kit/run! (list) "" (fn [(k kit/Kit)] -> (Result Unit String) (kit/edit! k "/etc/hosts" (fn [(t String)] -> String (str t "x"))))))
        (rx (kit/run! (list) "" (fn [(k kit/Kit)] -> (Result Unit String) (kit/editRx! k (list (str rel "/a.asl")) "(x)" "<\\1>"))))
        (badRx (kit/run! (list) "" (fn [(k kit/Kit)] -> (Result Unit String) (kit/editRx! k (list (str rel "/a.asl")) "(" "y"))))
        (inside (kit/run! (list "--dry") "" (fn [(k kit/Kit)] -> (Result Unit String) (kit/edit! k (str rel "/sub/c.asl") (fn [(t String)] -> String "changed\n")))))]
    (do (assert (= flat (list (str rel "/a.asl") (str rel "/b.asl"))) (str "glob lists matching files of one directory, sorted: " (stringJoin flat ",")))
        (assert (= deep (list (str rel "/a.asl") (str rel "/b.asl") (str rel "/sub/c.asl"))) (str "** descends into subdirectories: " (stringJoin deep ",")))
        (assert (= ignored (list)) (str "globGit! leaves out files under a .gitignore entry: " (stringJoin ignored ",")))
        (assert (listContains? tracked "asl/packages/asl-utils/src/timeout.asl") (str "globGit! lists tracked files: " (stringJoin tracked ",")))
        (refute (listContains? tracked "asl/packages/asl-utils/tests/timeoutTest.asl") "globGit! matches the pattern")
        (assert (ok? wrote) "writeText! writes")
        (assert (= (kit/readText! (str rel "/b.asl")) (ok "new\n")) "readText! reads back what writeText! wrote")
        (assert (= (kit/readLines! (str rel "/sub/c.asl")) (ok (list "foo"))) "readLines! splits a file into lines")
        (assert (= mode 448) (str "writeText! keeps the file mode: " mode))
        (refute left "writeText! leaves no temporary file")
        (assert (err? outside) "an edit outside the working directory is refused")
        (assert (stringContains? (match outside ((err e) e) ((ok _) "")) "(pass --allow-outside)") "and the error names the flag that allows it")
        (assert (ok? inside) "an edit inside the working directory runs")
        (assert (and (ok? rx) (= (fileReadString (str work "/a.asl")) (ok "<x>\n"))) "editRx! rewrites files with a regex template")
        (assert (err? badRx) "editRx! with a bad regex is an error")
        true))

fn ! sh argv: (List String) cwd: String env: (List String) -> fr/ProcOut
  (fr/runGuarded argv cwd (fr/childEnv env) (fr/limits 900 24))

fn scriptText -> String
  "#!/usr/bin/env asl\n(use asl-utils/kit)\n(kit/run! args \"from=foo to=bar\" (fn [k] (kit/editAll! k (kit/glob! \"**/*.asl\") (fn [t] (replace t (kit/flag k \"from\") (kit/flag k \"to\"))))))\n"

fn ! testScript root: String work: String -> Bool
  (let [(asl (str root "/bin/asl"))
        (tree (str work "/tree"))
        (_ (dirCreate tree))
        (_ (dirCreate (str tree "/sub")))
        (_ (put! tree "x.asl" "a\nfoo one\nb\n"))
        (_ (put! tree "sub/y.asl" "foo\n"))
        (_ (put! tree "z.asl" "none\n"))
        (_ (put! tree "n.txt" "foo\n"))
        (script (put! work "replace.asl" (scriptText)))
        (envScript (put! work "envRead.asl" "(use asl-utils/kit)\n(println (str \"len \" (stringLength (kit/env \"KIT_PROBE_VALUE\" \"\"))))\n"))
        (undeclared (put! work "undeclared.asl" "(use asl-utils/kit)\n(kit/run! args \"\" (fn [k] (do (println (kit/flag k \"nope\")) (ok ()))))\n"))
        (dry (sh (list asl script "--dry") tree (list)))
        (afterDry (fileReadString (str tree "/x.asl")))
        (real (sh (list asl script) tree (list)))
        (afterReal (fileReadString (str tree "/x.asl")))
        (renamed (sh (list asl script "--from" "bar" "--to=baz") tree (list)))
        (bogus (sh (list asl script "--bogus") tree (list)))
        (help (sh (list asl script "-h") tree (list)))
        (envRun (sh (list asl envScript) tree (list "KIT_PROBE_VALUE=hidden-probe-value")))
        (undeclaredRun (sh (list asl undeclared) tree (list)))]
    (do (assert (= dry.exitCode 0) (str "the script runs under --dry: " dry.stdout dry.stderr))
        (assert (stringContains? dry.stdout "--- a/x.asl\n+++ b/x.asl\n@@ -1,3 +1,3 @@\n a\n-foo one\n+bar one\n b\n(:wouldEdit \"x.asl\" :hunks 1)\n") (str "--dry prints a unified diff and a receipt: " dry.stdout))
        (assert (stringContains? dry.stdout "(:skipped \"z.asl\" :why \"unchanged\")") "a file without the word is skipped with a receipt")
        (refute (stringContains? dry.stdout "n.txt") "files outside the glob are not touched")
        (assert (= afterDry (ok "a\nfoo one\nb\n")) "--dry does not write")
        (assert (= real.exitCode 0) (str "the real run exits 0: " real.stdout real.stderr))
        (assert (= real.stdout "(:edited \"sub/y.asl\" :hunks 1)\n(:edited \"x.asl\" :hunks 1)\n(:skipped \"z.asl\" :why \"unchanged\")\n") (str "a real run prints one receipt per file in glob order: " real.stdout))
        (assert (= afterReal (ok "a\nbar one\nb\n")) "the real run edits the file")
        (assert (= (fileReadString (str tree "/n.txt")) (ok "foo\n")) "a file outside the glob keeps its text")
        (assert (= (fileReadString (str tree "/sub/y.asl")) (ok "baz\n")) (str "flags given on the command line override the defaults: " renamed.stdout renamed.stderr))
        (assert (= bogus.exitCode 1) "an unknown flag exits 1")
        (assert (stringContains? bogus.stderr "unknown flag --bogus; known: --from --to --dry --allow-outside --help") (str "and lists the known flags: " bogus.stderr))
        (assert (and (= help.exitCode 0) (stringContains? help.stdout "  --from STR (default foo)\n")) (str "-h prints the generated help: " help.stdout))
        (assert (stringContains? envRun.stdout "len 18") (str "env reads the variable: " envRun.stdout envRun.stderr))
        (refute (stringContains? (str envRun.stdout envRun.stderr) "hidden-probe") "and its value is not echoed")
        (assert (!= undeclaredRun.exitCode 0) "reading an undeclared flag stops the script")
        (assert (stringContains? undeclaredRun.stderr "flag --nope is not declared; known: --dry --allow-outside --help") (str "with an error naming the flag and the known ones: " undeclaredRun.stderr))
        true))

fn ! removeTree! p: String -> Bool
  (match (fileLstat p)
    ((err _) true)
    ((ok st)
      (if (and st.isDir (not st.isSymlink))
        (let [(kids (match (dirList p) ((ok names) (filter (fn [(n String)] -> Bool (and (!= n ".") (!= n ".."))) names)) ((err _) (list))))
              (gone (fold (fn [(a Bool) (n String)] -> Bool (and (removeTree! (str p "/" n)) a)) true kids))]
          (and gone (ok? (pathRemove p))))
        (ok? (pathRemove p)))))

fn ! runTests -> Bool
  (let [(root (resultOr (realPath ".") "."))
        (work (str root "/.asl/cache/kitTest." (stringFromInt64 (procSelf))))
        (_ (dirCreate (str root "/.asl/cache")))
        (made (dirCreate work))
        (flags (testFlags))
        (envs (testEnv))
        (diffs (testDiff))
        (texts (testText))
        (files (if (ok? made) (testFiles root work) false))
        (script (if (ok? made) (testScript root work) false))
        (cleaned (removeTree! work))]
    (do (assert (ok? made) (str "the work directory " work " was created"))
        (assert flags "flags and args parse as declared")
        (assert envs "env reads with a fallback")
        (assert diffs "diffs are unified diffs")
        (assert texts "text helpers replace and match")
        (assert files "glob, atomic writes and confined edits")
        (assert script "the three-line replace script")
        (assert cleaned "the work directory was removed")
        true))
