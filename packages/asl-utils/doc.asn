(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#" :text "asl timeout SECS -- argv...: GNU timeout convention (exit 124 on expiry, child exit code otherwise, 128+signal when signalled, 125 usage, 127 spawn failure); TERM to the child and its descendants collected before the first signal, 2 s grace, then KILL.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#main" :text "Entry run by asl timeout; first argument is the mode, then SECS, an optional --, and the command.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#timeoutRun!" :text "Limits until PROCSHIM-DETACH gives a real process group: a descendant that called setsid or double-forked away from the tree is out of reach and survives expiry; the tree is tracked by parentage and re-swept every 0.5 s, each pid pinned to its process start time so a reused pid is never signalled; signals sent to the shim itself are not forwarded to the child.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#watch!" :text "stdout and stderr are forwarded and stdin is pumped into the child; when the reader of the shim's stdout or stderr goes away the shim kills the tree and exits 141.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#Run" :text "State of one timed run: the spawned child, its fds, the deadline and the descendant pids pinned to their start times.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#brokenPipe?" :text "True when a write error means the reader of our stdout or stderr is gone (EPIPE), which ends the run with exit 141.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#parseTimeout" :text "SECS (integer or decimal, 0 = no limit) to milliseconds; none for malformed, negative, nan or overflowing input.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#timeoutMsOf" :text "parseTimeout with malformed input mapped to -1 (usage error, exit 125).")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#exitOfStatus" :text "Wait status to shell exit code: the child's code, or 128 plus the signal number when it was signalled.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#cmdOf" :text "The command after SECS, with one leading -- removed.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#startOf" :text "Pinned start time of pid from a snapshot, empty when unknown; a pid whose start time changed is never signalled.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#closure" :text "Descendants of members by parentage plus same-group orphans, iterated up to rounds times, excluding the shim itself.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#readRest!" :text "Read fd to EOF or EAGAIN, appending to acc.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#drainFd!" :text "Forward the rest of fd to dest after the child exited; false when dest is closed.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#" :text "Script kit: (kit/run! args \"n=1000 out=x\" (fn [k] ...)) parses flags typed by their defaults, prints generated help for -h, and hands the body a Kit; edits are confined to the working directory, --dry prints unified diffs instead of writing, and each action prints one ASN receipt line.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#Kit" :text "Parsed command line: declared flags, their values by name, positionals, help, dry and allow-outside switches, and the real path of the working directory.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#Flag" :text "One declared flag: name, kind (int, bool or str, from its default), default value and help note.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#Out" :text "Result of a child run: exit code, stdout and stderr.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#Op" :text "One diff line: eq, del or ins, its text with its newline, and its old and new line numbers.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#Diff" :text "Unified diff text and its hunk count.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#specOf" :text "Flag spec \"n=1000 dry out=x\" to flags: the default's text sets the kind (true/false bool, integer int, else str), a bare name is a bool off by default; --dry and --allow-outside are added when not declared.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#parse" :text "Command line to a Kit: --name value, --name=value, a bare --name for a bool, -h or --help, -- ends flags, a negative number is a positional; an unknown flag is an error that lists the known ones.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#help" :text "Generated help: one line per flag with its kind, default and note.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#run!" :text "Parse argv against spec; on -h print help and return ok, on a parse error return it (a script statement then exits 1 naming it), else run body with the Kit rooted at the working directory.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#flag" :text "Value of a declared flag as text; an undeclared name traps with ERR_ARG and the known flags.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#flagInt" :text "Value of a declared int flag; traps with ERR_ARG when the value is not an integer.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#flagOn?" :text "True when a bool flag is on.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#arg" :text "Positional i after flags are removed, or fallback.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#argNum" :text "Positional i as an integer, or fallback when absent or not an integer.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#env" :text "Environment variable or fallback; read-only, and the kit never prints it.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#glob!" :text "Files matching a pattern relative to the working directory, sorted: * and ? stay inside one path segment, ** crosses directories; .git is skipped, symlinked directories are not followed, an unreadable directory prints a skipped receipt on stderr.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#globGit!" :text "glob! over git ls-files --cached --others --exclude-standard, so .gitignore rules apply exactly; traps with ERR_IO when git fails.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#globRegex" :text "Anchored regex source for a glob pattern.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#readText!" :text "Whole file as text.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#readLines!" :text "File lines without their newlines; a final newline adds no empty line.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#writeText!" :text "Atomic write: a temporary file in the same directory, the old file's mode, fsync, then rename over the target; the temporary file is removed on any failure.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#inside?" :text "True when the path (or its parent when it does not exist) resolves inside the kit's working directory.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#edit!" :text "Read, apply f, and write atomically; unchanged text prints (:skipped path :why \"unchanged\"), --dry prints the diff and (:wouldEdit path :hunks n), a write prints (:edited path :hunks n); a path outside the working directory is an error unless --allow-outside.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#editAll!" :text "edit! over paths in order, stopping at the first error.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#editRx!" :text "editAll! with a regex replacement; template groups are \\1 to \\9 and \\0 for the whole match; a bad regex is an error before any file is read.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#replaceAll" :text "Replace every occurrence of a literal string.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#sub" :text "Regex replace-all over a string; a bad regex is an error.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#found?" :text "True when the regex matches somewhere in the string; a bad regex is an error.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#diff" :text "Line diff of two texts as a unified diff with 3 lines of context: common prefix and suffix are trimmed, an equal-length middle is paired line by line, otherwise it is one replaced block; a missing final newline is marked.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#sh!" :text "Run argv (no shell) through fleet/run runGuarded in the working directory with a 120 s timeout and at most 64 descendants.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#shFor!" :text "sh! with a timeout in seconds.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#quote" :text "ASN string literal of a text, as receipts print paths.")
