(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#" :text "asl timeout SECS -- argv...: GNU timeout convention (exit 124 on expiry, child exit code otherwise, 128+signal when signalled, 125 usage, 127 spawn failure); TERM to the child and its descendants collected before the first signal, 2 s grace, then KILL.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#main" :text "Entry run by asl timeout; first argument is the mode, then SECS, an optional --, and the command.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#timeoutRun!" :text "Limits until PROCSHIM-DETACH gives a real process group: a descendant that called setsid or double-forked away from the tree is out of reach and survives expiry; the tree is tracked by parentage and re-swept every 0.5 s, each pid pinned to its process start time so a reused pid is never signalled; signals sent to the shim itself are not forwarded to the child.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#watch!" :text "stdout and stderr are forwarded and stdin is pumped into the child; when the reader of the shim's stdout or stderr goes away the shim kills the tree and exits 141.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#Run" :text "State of one timed run: the spawned child, its fds, the deadline and the descendant pids pinned to their start times.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#brokenPipe?" :text "True when a write error means the reader of our stdout or stderr is gone (EPIPE), which ends the run with exit 141.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#parseTimeout" :text "SECS (integer or decimal, 0 = no limit) to milliseconds; none for malformed, negative, nan or overflowing input.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#timeoutMsOf" :text "parseTimeout with malformed input mapped to -1 (usage error, exit 125).")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#exitOfStatus" :text "Wait status to shell exit code: the child's code, or 128 plus the signal number when it was signalled.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#cmdOf" :text "The command after SECS, with one leading -- removed.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#startOf" :text "Pinned start time of pid from a snapshot, empty when unknown; a pid whose start time changed is never signalled.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#closure" :text "Descendants of members by parentage plus same-group orphans, iterated up to rounds times, excluding the shim itself.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#readRest!" :text "Read fd to EOF or EAGAIN, appending to acc.")
(:doc :symbol "asl/packages/asl-utils/src/timeout.asl#drainFd!" :text "Forward the rest of fd to dest after the child exited; false when dest is closed.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#" :text "Script kit: (kit/run! args \"n=1000 out=x\" (fn [k] ...)) parses flags typed by their defaults, prints generated help for -h, and hands the body a Kit; edits are confined to the working directory, --dry prints unified diffs instead of writing, and each action prints one ASN receipt line.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#Kit" :text "Parsed command line: declared flags, their values by name, positionals, help, dry and allow-outside switches, and the real path of the working directory.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#Flag" :text "One declared flag: name, kind (int, bool or str, from its default), default value and help note.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#Out" :text "Result of a child run: exit code, stdout and stderr.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#Op" :text "One diff line: eq, del or ins, its text with its newline, and its old and new line numbers.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#Diff" :text "Unified diff text and its hunk count.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#specOf" :text "Flag spec \"n=1000 dry out=x\" to flags: the default's text sets the kind (true/false bool, integer int, else str), a bare name is a bool off by default; --dry and --allow-outside are added when not declared.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#parse" :text "Command line to a Kit: --name value, --name=value, a bare --name for a bool, -h or --help, -- ends flags, a negative number is a positional; an unknown flag is an error that lists the known ones.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#help" :text "Generated help: one line per flag with its kind, default and note.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#run!" :text "Parse argv against spec; on -h print help and return ok, on a parse error return it (a script statement then exits 1 naming it), else run body with the Kit rooted at the working directory.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#flag" :text "Value of a declared flag as text; an undeclared name traps with ERR_ARG and the known flags.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#flagInt" :text "Value of a declared int flag; traps with ERR_ARG when the value is not an integer.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#flagOn?" :text "True when a bool flag is on.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#arg" :text "Positional i after flags are removed, or fallback.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#argNum" :text "Positional i as an integer, or fallback when absent or not an integer.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#env" :text "Environment variable or fallback; read-only, and the kit never prints it.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#glob!" :text "Files matching a pattern relative to the working directory, sorted: * and ? stay inside one path segment, ** crosses directories; .git is skipped, symlinked directories are not followed, an unreadable directory prints a skipped receipt on stderr.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#globGit!" :text "glob! over git ls-files --cached --others --exclude-standard, so .gitignore rules apply exactly; traps with ERR_IO when git fails.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#globRegex" :text "Anchored regex source for a glob pattern.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#readText!" :text "Whole file as text.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#readLines!" :text "File lines without their newlines; a final newline adds no empty line.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#writeText!" :text "Atomic write: a temporary file in the same directory, the old file's mode, fsync, then rename over the target; the temporary file is removed on any failure.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#inside?" :text "True when the path (or its parent when it does not exist) resolves inside the kit's working directory.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#edit!" :text "Read, apply f, and write atomically; unchanged text prints (:skipped path :why \"unchanged\"), --dry prints the diff and (:wouldEdit path :hunks n), a write prints (:edited path :hunks n); a path outside the working directory is an error unless --allow-outside.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#editAll!" :text "edit! over paths in order, stopping at the first error.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#editRx!" :text "editAll! with a regex replacement; template groups are \\1 to \\9 and \\0 for the whole match; a bad regex is an error before any file is read.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#replaceAll" :text "Replace every occurrence of a literal string.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#sub" :text "Regex replace-all over a string; a bad regex is an error.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#found?" :text "True when the regex matches somewhere in the string; a bad regex is an error.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#diff" :text "Line diff of two texts as a unified diff with 3 lines of context: common prefix and suffix are trimmed, an equal-length middle is paired line by line, otherwise it is one replaced block; a missing final newline is marked.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#sh!" :text "Run argv (no shell) through fleet/run runGuarded in the working directory with a 120 s timeout and at most 64 descendants.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#shFor!" :text "sh! with a timeout in seconds.")
(:doc :symbol "asl/packages/asl-utils/src/kit.asl#quote" :text "ASN string literal of a text, as receipts print paths.")
(:doc :symbol "asl/packages/asl-utils/tests/exitOfStatusCoverTest.asl#runTests" :text "exitOfStatus cover: a signalled status maps to 128 plus the signal, a plain exit status passes through and zero stays zero")
(:doc :symbol "asl/packages/asl-utils/tests/parseTimeoutCoverTest.asl#runTests" :text "parseTimeout cover: a decimal seconds text is converted to milliseconds, and a negative or malformed one is rejected")
(:doc :symbol "asl/packages/asl-utils/src/stats.asl#" :text "Descriptive statistics over lists of Float64: mean, median, population variance and stddev, linearly interpolated percentile, and histogram; each returns an err on an empty list.")
(:doc :symbol "asl/packages/asl-utils/src/stats.asl#mean" :text "Arithmetic mean of a non-empty list of Float64; an empty list is an err.")
(:doc :symbol "asl/packages/asl-utils/src/stats.asl#median" :text "Median of a non-empty list: the middle value after sorting, or the mean of the two middle values when the count is even; an empty list is an err.")
(:doc :symbol "asl/packages/asl-utils/src/stats.asl#variance" :text "Population variance (sum of squared deviations divided by n) of a non-empty list; an empty list is an err.")
(:doc :symbol "asl/packages/asl-utils/src/stats.asl#stddev" :text "Population standard deviation, the square root of variance; an empty list is an err.")
(:doc :symbol "asl/packages/asl-utils/src/stats.asl#percentile" :text "Percentile p in [0,100] by linear interpolation over the sorted list at rank p/100*(n-1); an empty list or p outside [0,100] is an err.")
(:doc :symbol "asl/packages/asl-utils/src/stats.asl#histogram" :text "Counts of a non-empty list in bins equal-width bins from min to max, the maximum in the last bin; an empty list or bins <= 0 is an err.")
(:doc :symbol "asl/packages/asl-utils/tests/statsTest.asl#runTests" :text "stats cover: mean, median, variance, stddev, percentile and histogram over Float64 lists, including empty-list errors and percentile bounds")
(:doc :symbol "asl/packages/asl-utils/src/unionFind.asl#Dsu" :text "Persistent disjoint-set state: parent links, union-by-rank ranks and the component count; every operation returns a new Dsu and never mutates the input.")
(:doc :symbol "asl/packages/asl-utils/src/unionFind.asl#empty" :text "The empty disjoint set: no elements, zero components; never fails.")
(:doc :symbol "asl/packages/asl-utils/src/unionFind.asl#add" :text "d with element n present as its own singleton component, or d unchanged when n is already present; never fails.")
(:doc :symbol "asl/packages/asl-utils/src/unionFind.asl#find" :text "The pair of the set with path halving applied along the way and the root of n, n itself when n is absent; never fails.")
(:doc :symbol "asl/packages/asl-utils/src/unionFind.asl#union" :text "The set with a and b in one component, adding either when absent, linking by rank and decrementing the component count only when two roots merge; never fails.")
(:doc :symbol "asl/packages/asl-utils/src/unionFind.asl#connected" :text "True when a and b are both present and share a root, false when either is absent; never fails.")
(:doc :symbol "asl/packages/asl-utils/src/unionFind.asl#componentCount" :text "The number of disjoint components in the set, zero for the empty set; never fails.")
(:doc :symbol "asl/packages/asl-utils/src/unionFind.asl#" :text "Persistent disjoint-set (union-find) over Int64 nodes: every operation returns a new Dsu and leaves its input unchanged; union is by rank and find halves the path it walks.")
(:doc :symbol "asl/packages/asl-utils/tests/unionFindTest.asl#runTests" :text "unionFind cover: basics (add, union, connected, component count, persistence), transitivity, and a 3x3 grid whose blocked middle column splits two components that a bridge merges.")
(:doc :symbol "asl/packages/asl-utils/src/deque.asl#" :text "asl-utils/deque: persistent two-list double-ended queue; every operation returns a new deque and leaves its input unchanged, pushFront, pushBack, popFront and popBack are amortised O(1) because a list is only reversed when it empties.")
(:doc :symbol "asl/packages/asl-utils/src/deque.asl#Deque" :text "A deque held as two lists, front in order and back reversed; it never fails and toList is the only way to observe the contents.")
(:doc :symbol "asl/packages/asl-utils/src/deque.asl#empty" :text "The empty deque; never fails.")
(:doc :symbol "asl/packages/asl-utils/src/deque.asl#pushFront" :text "A new deque with x at the front, the input deque unchanged; never fails.")
(:doc :symbol "asl/packages/asl-utils/src/deque.asl#pushBack" :text "A new deque with x at the back, the input deque unchanged; never fails.")
(:doc :symbol "asl/packages/asl-utils/src/deque.asl#popFront" :text "some (pair x rest) with the front element and the remaining deque, or none when the deque is empty.")
(:doc :symbol "asl/packages/asl-utils/src/deque.asl#popBack" :text "some (pair x rest) with the back element and the remaining deque, or none when the deque is empty.")
(:doc :symbol "asl/packages/asl-utils/src/deque.asl#toList" :text "The elements front to back as a list; never fails.")
(:doc :symbol "asl/packages/asl-utils/tests/dequeTest.asl#runTests" :text "deque cover: pushFront/pushBack order and persistence, popFront/popBack values and rests, none on empty, and a 300-op randomised model test against a plain list after every operation; true when all assertions pass.")
(:doc :symbol "asl/packages/asl-utils/src/binaryHeap.asl#push" :text "push cmp h x: a new heap with x added, the original heap unchanged; cmp orders elements, negative when the first is smaller.")
(:doc :symbol "asl/packages/asl-utils/src/binaryHeap.asl#pop" :text "pop cmp h: (pair (some min) rest) with the minimum removed, or (pair (none) h) on an empty heap; the original heap is unchanged.")
(:doc :symbol "asl/packages/asl-utils/src/binaryHeap.asl#peek" :text "peek h: (some min) for the minimum of the heap, (none) when it is empty.")
(:doc :symbol "asl/packages/asl-utils/src/binaryHeap.asl#fromList" :text "fromList cmp xs: a heap holding every element of xs, built by repeated push; the list is unchanged.")
(:doc :symbol "asl/packages/asl-utils/src/binaryHeap.asl#toSortedList" :text "toSortedList cmp h: the elements of h in cmp order, smallest first, by repeated pop; the heap is unchanged.")
(:doc :symbol "asl/packages/asl-utils/tests/binaryHeapTest.asl#runTests" :text "runTests: heap-sort property test comparing toSortedList and repeated pop against listSortBy, plus peek, push and pop persistence checks; fails when any assertion fails.")
(:doc :symbol "asl/packages/asl-utils/src/checksums.asl#" :text "Checksums over Bytes as Int64: Adler-32, FNV-1a 32 and 64, and CRC-32 (IEEE, reflected); 32-bit results are unsigned 0..4294967295, the 64-bit FNV result is the two's-complement signed Int64 of the unsigned hash.")
(:doc :symbol "asl/packages/asl-utils/src/checksums.asl#adler32" :text "Adler-32 (RFC 1950) of the bytes as an unsigned Int64; the empty input gives 1.")
(:doc :symbol "asl/packages/asl-utils/src/checksums.asl#fnv1a32" :text "FNV-1a 32-bit of the bytes as an unsigned Int64; the empty input gives the offset basis 2166136261.")
(:doc :symbol "asl/packages/asl-utils/src/checksums.asl#fnv1a64" :text "FNV-1a 64-bit of the bytes as a signed Int64 (two's complement of the unsigned hash); the empty input gives the offset basis 14695981039346656037, i.e. -3750763034362895579.")
(:doc :symbol "asl/packages/asl-utils/src/checksums.asl#crc32" :text "CRC-32 (IEEE 802.3, polynomial 0xEDB88320 reflected, init and final xor 0xFFFFFFFF) of the bytes as an unsigned Int64; the empty input gives 0.")
(:doc :symbol "asl/packages/asl-utils/tests/checksumsTest.asl#runTests" :text "checksums cover: Adler-32, FNV-1a 32/64 and CRC-32 against published vectors (empty, a, abc, foobar, hello, 123456789, Wikipedia, the quick brown fox)")
(:doc :symbol "asl/packages/asl-utils/src/duration.asl#parseDuration" :text "Duration text to milliseconds: the simple form 1h30m15s (units w d h m s ms, case-insensitive, any order, each number followed by its unit) or ISO-8601 PT1H30M15S / P1DT1H; err with a message for empty input, a number without a unit, a missing number before a unit, or an unknown character.")
(:doc :symbol "asl/packages/asl-utils/src/duration.asl#formatDuration" :text "Milliseconds to the shortest exact duration text: 0s for zero, a leading - for negative input, and only the non-zero parts of d h m s ms in that order (5415000 is 1h30m15s, 1500 is 1s500ms).")
(:doc :symbol "asl/packages/asl-utils/tests/durationTest.asl#runTests" :text "Runs the duration parse, format and round-trip tests; returns true when every assert passes and fails on the first wrong parse, format or round-trip result.")
