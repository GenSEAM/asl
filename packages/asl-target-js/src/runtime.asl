(module asl-target-js/runtime
  :x [runtimeText builtinNames entryNames]
  :i [])

fn runtimeText -> String
  (stringJoin
    ["const $ = (() => {"
     "class AslTrap extends Error {"
     "  constructor(code, message) { super(`${code}: ${message}`); this.code = code; }"
     "}"
     "const trap = (code, message) => { throw new AslTrap(code, message); };"
     "const callClosure = (c, ...a) => (typeof c === 'function' ? c(...a) : trap('ERR_TYPE', 'call of a value that is not a function'));"
     "const UNIT = Object.freeze({ toString: () => '()' });"
     "class Kw { constructor(name) { this.name = name; } }"
     "class Sym { constructor(name) { this.name = name; } }"
     "const kws = new Map(), syms = new Map();"
     "const kw = (n) => kws.get(n) ?? (kws.set(n, new Kw(n)), kws.get(n));"
     "const sym = (n) => syms.get(n) ?? (syms.set(n, new Sym(n)), syms.get(n));"
     "class Variant { constructor(type, name, fields) { this.type = type; this.name = name; this.fields = fields; } }"
     "class Rec { constructor(schema, keys, vals) { this.$schema = schema; this.$keys = keys; for (let i = 0; i < keys.length; i++) this[keys[i]] = vals[i]; } }"
     "class Cons { constructor(h, t) { this.h = h; this.t = t; } }"
     "const list = (...xs) => { let l = null; for (let i = xs.length - 1; i >= 0; i--) l = new Cons(xs[i], l); return l; };"
     "const MIN = -(2n ** 63n), MAX = 2n ** 63n - 1n;"
     "const fit = (v, op) => (v < MIN || v > MAX ? trap('ERR_INT_OVERFLOW', `Int ${op} leaves int64`) : v);"
     "const isInt = (v) => typeof v === 'bigint';"
     "const isFloat = (v) => typeof v === 'number';"
     "const floorDiv = (a, b) => { if (b === 0n) trap('ERR_DIV_ZERO', 'division by zero'); const q = a / b; return (a % b !== 0n && (a < 0n) !== (b < 0n)) ? q - 1n : q; };"
     "const floorMod = (a, b) => { if (b === 0n) trap('ERR_DIV_ZERO', 'division by zero'); const r = a % b; return (r !== 0n && (r < 0n) !== (b < 0n)) ? r + b : r; };"
     "const arith = (op, a, b) => {"
     "  if (isInt(a) && isInt(b)) {"
     "    switch (op) {"
     "      case '+': return fit(a + b, '+'); case '-': return fit(a - b, '-'); case '*': return fit(a * b, '*');"
     "      case '/': return fit(floorDiv(a, b), '/'); case 'mod': case '%': return floorMod(a, b);"
     "    }"
     "  }"
     "  if (isFloat(a) && isFloat(b)) {"
     "    switch (op) { case '+': return a + b; case '-': return a - b; case '*': return a * b; case '/': return a / b; }"
     "  }"
     "  return trap('ERR_TYPE', `${op} expects two Ints or two Floats`);"
     "};"
     "const eq = (a, b) => {"
     "  if (a === b) return true;"
     "  if (isFloat(a) && isFloat(b)) return a === b;"
     "  if (a instanceof Cons && b instanceof Cons) { for (; a && b; a = a.t, b = b.t) if (!eq(a.h, b.h)) return false; return a === b; }"
     "  if (a instanceof Variant && b instanceof Variant) return a.name === b.name && a.fields.length === b.fields.length && a.fields.every((f, i) => eq(f, b.fields[i]));"
     "  if (a instanceof Rec && b instanceof Rec) return a.$schema === b.$schema && a.$keys.every((k) => eq(a[k], b[k]));"
     "  if (a instanceof BStr && b instanceof BStr) return a.b.length === b.b.length && a.b.every((x, i) => x === b.b[i]);"
     "  if (a instanceof Uint8Array && b instanceof Uint8Array) return a.length === b.length && a.every((x, i) => x === b[i]);"
     "  return false;"
     "};"
     "const cmp = (a, b) => (a < b ? -1 : a > b ? 1 : 0);"
     "const order = (op, a, b) => {"
     "  if (!((isInt(a) && isInt(b)) || (isFloat(a) && isFloat(b)) || (isStr(a) && isStr(b)))) trap('ERR_TYPE', `${op} expects two Ints, two Floats or two Strings`);"
     "  const c = isStr(a) ? Math.sign(byteCmp(a, b)) : cmp(a, b);"
     "  return op === '<' ? c < 0 : op === '<=' ? c <= 0 : op === '>' ? c > 0 : c >= 0;"
     "};"
     "const enc = new TextEncoder(), dec = new TextDecoder('utf-8'), strict = new TextDecoder('utf-8', { fatal: true });"
     "class BStr { constructor(b) { this.b = b; } }"
     "const isStr = (v) => typeof v === 'string' || v instanceof BStr;"
     "const fromBytes = (b) => { try { return strict.decode(b); } catch { return new BStr(b.slice()); } };"
     "const concatBytes = (parts) => { const n = parts.reduce((k, p) => k + p.length, 0), out = new Uint8Array(n); let at = 0; for (const p of parts) { out.set(p, at); at += p.length; } return out; };"
     "const join = (parts) => (parts.some((p) => p instanceof BStr) ? fromBytes(concatBytes(parts.map(bytesOf))) : parts.join(''));"
     "const ascii = (s) => typeof s === 'string' && /^[\\x00-\\x7f]*$/.test(s);"
     "const bytesOf = (s) => (s instanceof BStr ? s.b : enc.encode(s));"
     "const byteCmp = (a, b) => { if (typeof a === 'string' && typeof b === 'string' && ascii(a) && ascii(b)) return a < b ? -1 : a > b ? 1 : 0; const x = bytesOf(a), y = bytesOf(b); for (let i = 0; i < Math.min(x.length, y.length); i++) if (x[i] !== y[i]) return x[i] - y[i]; return x.length - y.length; };"
     "const byteLen = (s) => (ascii(s) ? s.length : bytesOf(s).length);"
     "const slice = (s, i, j) => {"
     "  const a = Number(i), b = Number(j);"
     "  if (ascii(s)) return a < 0 || b > s.length || a > b ? null : s.slice(a, b);"
     "  const bs = bytesOf(s);"
     "  if (a < 0 || b > bs.length || a > b) return null;"
     "  return fromBytes(bs.subarray(a, b));"
     "};"
     "const findBytes = (h, n) => { outer: for (let i = 0; i + n.length <= h.length; i++) { for (let k = 0; k < n.length; k++) if (h[i + k] !== n[k]) continue outer; return i; } return -1; };"
     "const indexOf = (s, t) => {"
     "  if (typeof s === 'string' && typeof t === 'string') { const i = s.indexOf(t); if (i < 0) return null; return ascii(s) ? BigInt(i) : BigInt(enc.encode(s.slice(0, i)).length); }"
     "  const i = findBytes(bytesOf(s), bytesOf(t)); return i < 0 ? null : BigInt(i);"
     "};"
     "const contains = (s, t) => (typeof s === 'string' && typeof t === 'string' ? s.includes(t) : findBytes(bytesOf(s), bytesOf(t)) >= 0);"
     "const startsWith = (s, t) => (typeof s === 'string' && typeof t === 'string' ? s.startsWith(t) : (() => { const a = bytesOf(s), b = bytesOf(t); return b.length <= a.length && b.every((x, k) => a[k] === x); })());"
     "const some = (v) => new Variant('Option', 'some', [v]);"
     "const none = new Variant('Option', 'none', []);"
     "const opt = (v) => (v === null ? none : some(v));"
     "const quote = (s) => '\"' + text(s).replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"').replace(/\\n/g, '\\\\n').replace(/\\r/g, '\\\\r').replace(/\\t/g, '\\\\t') + '\"';"
     "const floatText = (x) => {"
     "  if (Number.isNaN(x)) return 'nan';"
     "  if (!Number.isFinite(x)) return x > 0 ? 'inf' : '-inf';"
     "  const neg = x < 0 || Object.is(x, -0);"
     "  const [mant, e] = Math.abs(x).toExponential().split('e');"
     "  const digits = mant.replace('.', '').replace(/0+$/, '') || '0';"
     "  const exp10 = Number(e);"
     "  let o = neg ? '-' : '';"
     "  if (exp10 >= -4 && exp10 < 16) {"
     "    const decpt = exp10 + 1;"
     "    if (decpt <= 0) o += '0.' + '0'.repeat(-decpt) + digits;"
     "    else if (decpt >= digits.length) o += digits + '0'.repeat(decpt - digits.length) + '.0';"
     "    else o += digits.slice(0, decpt) + '.' + digits.slice(decpt);"
     "  } else {"
     "    o += digits[0] + (digits.length > 1 ? '.' + digits.slice(1) : '') + 'e' + (exp10 < 0 ? '-' : '+') + String(Math.abs(exp10)).padStart(2, '0');"
     "  }"
     "  return o;"
     "};"
     "const parseFloatText = (s) => {"
     "  if (s === 'nan') return NaN; if (s === 'inf') return Infinity; if (s === '-inf') return -Infinity;"
     "  return /^[+-]?(\\d+\\.?\\d*|\\.\\d+)([eE][+-]?\\d+)?$/.test(s) ? Number(s) : null;"
     "};"
     "const float = (v, who) => (isFloat(v) ? v : trap('ERR_TYPE', `${who} expects Float, got ${isInt(v) ? 'Int' : typeof v}`));"
     "const roundHalfAway = (x) => (x < 0 ? -Math.round(-x) : Math.round(x));"
     "const text = (s) => (s instanceof BStr ? dec.decode(s.b) : s);"
     "const show = (v, nested) => {"
     "  if (typeof v === 'string') return nested ? quote(v) : v;"
     "  if (v instanceof BStr) return nested ? quote(v) : v;"
     "  if (isInt(v)) return String(v);"
     "  if (isFloat(v)) return floatText(v);"
     "  if (typeof v === 'boolean') return v ? 'true' : 'false';"
     "  if (v === null) return '()';"
     "  if (v === UNIT) return '()';"
     "  if (v instanceof Kw) return ':' + v.name;"
     "  if (v instanceof Sym) return v.name;"
     "  if (v instanceof Cons) { const out = []; for (let l = v; l; l = l.t) out.push(show(l.h, true)); return '(' + out.join(' ') + ')'; }"
     "  if (v instanceof Variant) return '(' + [v.name, ...v.fields.map((f) => show(f, true))].join(' ') + ')';"
     "  if (v instanceof Rec) return '{' + v.$keys.map((k) => `:${k} ${show(v[k], true)}`).join(' ') + '}';"
     "  if (typeof v === 'function') return '#<fn>';"
     "  if (v instanceof Uint8Array) return '#<Bytes>';"
     "  return String(v);"
     "};"
     "const spaced = (xs) => join(xs.flatMap((x, i) => (i ? [' ', show(x, false)] : [show(x, false)])));"
     "let write = (s) => (globalThis.process?.stdout ? process.stdout.write(s) : console.log(s));"
     "const setOutput = (f) => { write = f; };"
     "const int = (v, who) => (isInt(v) ? v : trap('ERR_TYPE', `${who} expects Int`));"
     "const string = (v, who) => (isStr(v) ? v : trap('ERR_TYPE', `${who} expects String`));"
     "const builtins = {"
     "  print: (...xs) => { write(text(spaced(xs))); return UNIT; },"
     "  println: (...xs) => { write(text(spaced(xs)) + '\\n'); return UNIT; },"
     "  str: (...xs) => join(xs.map((x) => show(x, false))),"
     "  max: (a, b) => (order('>=', a, b) ? a : b),"
     "  min: (a, b) => (order('<=', a, b) ? a : b),"
     "  abs: (a) => (isInt(a) ? fit(a < 0n ? -a : a, 'abs') : Math.abs(a)),"
     "  cons: (h, t) => new Cons(h, t),"
     "  'listEmpty?': (l) => l === null,"
     "  listHead: (l) => (l === null ? none : some(l.h)),"
     "  listTail: (l) => (l === null ? none : some(l.t)),"
     "  list: (...xs) => list(...xs),"
     "  stringConcat: (a, b) => join([string(a, 'stringConcat'), string(b, 'stringConcat')]),"
     "  'stringContains?': (s, t) => contains(string(s, 'stringContains?'), string(t, 'stringContains?')),"
     "  'stringStartsWith?': (s, t) => startsWith(string(s, 'stringStartsWith?'), string(t, 'stringStartsWith?')),"
     "  stringLength: (s) => BigInt(s instanceof BStr ? s.b.length : byteLen(string(s, 'stringLength'))),"
     "  stringSlice: (s, i, j) => opt(slice(string(s, 'stringSlice'), int(i, 'stringSlice'), int(j, 'stringSlice'))),"
     "  stringFromInt64: (n) => String(int(n, 'stringFromInt64')),"
     "  stringToBytes: (s) => bytesOf(string(s, 'stringToBytes')).slice(),"
     "  bytesLength: (b) => BigInt(b.length),"
     "  bytesGet: (b, i) => (i >= 0n && i < BigInt(b.length) ? BigInt(b[Number(i)]) : trap('ERR_RANGE', 'bytesGet index out of range')),"
     "  'stringFromFloat64': (x) => floatText(float(x, 'stringFromFloat64')),"
     "  'stringToFloat64': (s) => opt(parseFloatText(text(string(s, 'stringToFloat64')))),"
     "  int64ToFloat64: (n) => Number(int(n, 'int64ToFloat64')),"
     "  float64ToInt64: (x) => { const f = float(x, 'float64ToInt64'); const t = Math.trunc(f); return Number.isFinite(f) && t >= -9223372036854775808 && t < 9223372036854775808 ? some(BigInt(t)) : none; },"
     "  floor: (x) => Math.floor(float(x, 'floor')), ceil: (x) => Math.ceil(float(x, 'ceil')), round: (x) => roundHalfAway(float(x, 'round')),"
     "  sqrt: (x) => Math.sqrt(float(x, 'sqrt')), exp: (x) => Math.exp(float(x, 'exp')), log: (x) => Math.log(float(x, 'log')),"
     "  log2: (x) => Math.log2(float(x, 'log2')), log10: (x) => Math.log10(float(x, 'log10')),"
     "  sin: (x) => Math.sin(float(x, 'sin')), cos: (x) => Math.cos(float(x, 'cos')), tan: (x) => Math.tan(float(x, 'tan')),"
     "  atan2: (y, x) => Math.atan2(float(y, 'atan2'), float(x, 'atan2')), pow: (a, b) => Math.pow(float(a, 'pow'), float(b, 'pow')),"
     "  clamp: (lo, hi, x) => { float(lo, 'clamp'); float(hi, 'clamp'); float(x, 'clamp'); if (!(lo <= hi)) trap('ERR_RANGE', 'clamp: lo <= hi required'); return Math.min(hi, Math.max(lo, x)); },"
     "  partial: (f, ...bound) => (...rest) => callClosure(f, ...bound, ...rest),"
     "  bytesAlloc: (n) => (int(n, 'bytesAlloc') >= 0n ? new Uint8Array(Number(n)) : trap('ERR_RANGE', 'bytesAlloc of a negative size')),"
     "  bytesSet: (b, i, x) => { if (!(i >= 0n && i < BigInt(b.length))) trap('ERR_RANGE', 'bytesSet index out of range'); b[Number(i)] = Number(BigInt.asUintN(8, x)); return UNIT; },"
     "  bytesGetFloat64: (b, i) => new DataView(b.buffer, b.byteOffset).getFloat64(Number(i), true),"
     "  bytesSetFloat64: (b, i, x) => { new DataView(b.buffer, b.byteOffset).setFloat64(Number(i), x, true); return UNIT; },"
     "  eprintln: (...xs) => { (globalThis.console?.error ?? (() => {}))(xs.map((x) => show(x, false)).join(' ')); return UNIT; },"
     "  nowNs: () => BigInt(Date.now()) * 1000000n,"
     "  monotonicNs: () => BigInt(Math.round((globalThis.performance?.now() ?? Date.now()) * 1e6)),"
     "  trap: (code, m) => trap(show(code, false), show(m, false)),"
     "};"
     "const entries = {"
     "  '+': (a, b) => arith('+', a, b), '-': (a, b) => arith('-', a, b), '*': (a, b) => arith('*', a, b),"
     "  '/': (a, b) => arith('/', a, b), 'mod': (a, b) => arith('mod', a, b), '%': (a, b) => arith('%', a, b),"
     "  '=': (a, b) => eq(a, b), '!=': (a, b) => !eq(a, b), '==': (a, b) => eq(a, b),"
     "  '<': (a, b) => order('<', a, b), '<=': (a, b) => order('<=', a, b), '>': (a, b) => order('>', a, b), '>=': (a, b) => order('>=', a, b),"
     "  '@listFirst': (l) => (l === null ? trap('ERR_RANGE', 'listFirst of an empty list') : l.h),"
     "  '@listRest': (l) => (l === null ? trap('ERR_RANGE', 'listRest of an empty list') : l.t),"
     "  '@stringSliceOr': (s, i, j, d) => slice(s, i, j) ?? d,"
     "  '@stringIndexOf': (s, t) => opt(indexOf(s, t)),"
     "  '@listHeadOr': (l, d) => (l === null ? d : l.h),"
     "  '@listTailOr': (l, d) => (l === null ? d : l.t),"
     "  '@listGetOr': (l, i, d) => { if (i < 0n) return d; for (; l !== null; l = l.t, i--) if (i === 0n) return l.h; return d; },"
     "  not: (b) => !b,"
     "  ...builtins,"
     "};"
     "const prims = {"
     "  addIntHost: (a, b) => fit(a + b, '+'), subIntHost: (a, b) => fit(a - b, '-'), mulIntHost: (a, b) => fit(a * b, '*'),"
     "  divIntHost: (a, b) => fit(floorDiv(a, b), '/'), modIntHost: (a, b) => floorMod(a, b), negIntHost: (a) => fit(-a, '-'),"
     "  addInt: (a, b) => fit(a + b, '+'), subInt: (a, b) => fit(a - b, '-'), mulInt: (a, b) => fit(a * b, '*'),"
     "  quotInt: (a, b) => (b === 0n ? trap('ERR_DIV_ZERO', 'division by zero') : fit(a / b, '/')),"
     "  remInt: (a, b) => (b === 0n ? trap('ERR_DIV_ZERO', 'division by zero') : a % b),"
     "  eqInt: (a, b) => a === b, neInt: (a, b) => a !== b, ltInt: (a, b) => a < b, leInt: (a, b) => a <= b, gtInt: (a, b) => a > b, geInt: (a, b) => a >= b,"
     "  addFloat: (a, b) => a + b, subFloat: (a, b) => a - b, mulFloat: (a, b) => a * b, divFloat: (a, b) => a / b, negFloat: (a) => -a,"
     "  eqFloat: (a, b) => a === b, neFloat: (a, b) => a !== b, ltFloat: (a, b) => a < b, leFloat: (a, b) => a <= b, gtFloat: (a, b) => a > b, geFloat: (a, b) => a >= b,"
     "  eqBool: (a, b) => a === b, neBool: (a, b) => a !== b, andBool: (a, b) => a && b, orBool: (a, b) => a || b, notBool: (a) => !a,"
     "  intToFloat: (a) => Number(a), floatToInt: (a) => (Number.isFinite(a) ? fit(BigInt(Math.trunc(a)), 'floatToInt') : trap('ERR_RANGE', 'floatToInt of a non-finite Float')),"
     "};"
     "const unreachable = () => trap('ERR_UNREACHABLE', 'control reached an unreachable block');"
     "const fieldOf = (r, k) => (r instanceof Rec && k in r ? r[k] : trap('ERR_TYPE', `no field ${k}`));"
     "return { AslTrap, callClosure, UNIT, kw, sym, Variant, Rec, Cons, list, eq, BStr, show, setOutput, builtins, entries, prims, unreachable, fieldOf };"
     "})();"
     ""]
    "\n")

fn builtinNames -> (List String)
  ["print" "println" "str" "max" "min" "abs" "cons" "listEmpty?" "listHead" "listTail" "list" "stringConcat" "stringContains?" "stringStartsWith?" "stringLength" "stringSlice" "stringFromInt64" "stringToBytes" "bytesLength" "bytesGet" "stringFromFloat64" "stringToFloat64" "int64ToFloat64" "float64ToInt64" "floor" "sqrt" "log2" "sin" "atan2" "clamp" "partial" "bytesAlloc" "bytesSet" "bytesGetFloat64" "bytesSetFloat64" "eprintln" "nowNs" "monotonicNs" "trap" "ceil" "round" "exp" "log" "log10" "cos" "tan" "pow"]

fn entryNames -> (List String)
  (listAppend ["+" "/" "=" "<" "@listFirst" "@listRest" "@stringSliceOr" "@stringIndexOf" "@listHeadOr" "@listTailOr" "@listGetOr" "not" "-" "*" "mod" "%" "!=" "==" "<=" ">" ">="] (builtinNames))
