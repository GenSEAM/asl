   "aslBrowserPlugin/plugin"
   "browserPlugin/popup"
   "aslBrowserPlugin/runtime"
   "aslBrowserPlugin/safetyGate"
 ]
 :dependencies ["aslContracts" "aslAgentBus" "aslVdom"])
