   "asl-browser-plugin/mesh-client"
   "asl-browser-plugin/plugin"
   "asl-browser-plugin/popup"
   "asl-browser-plugin/runtime"
   "asl-browser-plugin/safety-gate"
 ]
 :dependencies ["aslContracts" "aslAgentBus" "aslVdom"])
