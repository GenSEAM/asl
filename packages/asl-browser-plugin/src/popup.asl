(module browserPlugin/popup :i [(aslVdom/html :a h) (aslVdom/vdom :a v)] :x [renderPopup viewModel])

fn viewModel -> (Map Str Str)
  (let [(m0 (mapEmpty)) (m1 (mapSet m0 "title" "ASL Agent Plugin")) (m2 (mapSet m1 "status" "WASI Sandbox")) (m3 (mapSet m2 "prompt" "Extract DOM & execute agent tools in browser memory:")) (m4 (mapSet m3 "output" "Ready. Click a button to execute.")) (m5 (mapSet m4 "pending-action" "None"))] m5)

fn renderPopup vm: (Map Str Str) -> Str
  (let [(title (optionOr (mapGet vm "title") "ASL Agent Plugin")) (status (optionOr (mapGet vm "status") "WASI Sandbox")) (prompt (optionOr (mapGet vm "prompt") "Ready")) (out (optionOr (mapGet vm "output") "Ready")) (pending (optionOr (mapGet vm "pending-action") "None")) (styleStr ":root { --bg-card: #1e2230; --text-accent: #38bdf8; --border-card: #2e364f; --text-primary: #f8fafc; }\nbody {\n  width: 100%;\n  min-width: 320px;\n  max-width: 420px;\n  margin: 0;\n  padding: 16px;\n  background: var(--bg-card);\n  color: var(--text-primary);\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n}\n.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n.badge { background: var(--border-card); padding: 4px 8px; border-radius: 4px; font-size: 12px; }\n.actions { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }\nbutton {\n  background: var(--border-card);\n  color: var(--text-accent);\n  border: 1px solid var(--border-card);\n  padding: 8px 12px;\n  border-radius: 6px;\n  cursor: pointer;\n}\nbutton:hover { filter: brightness(1.2); }\n.pending, .output {\n  min-height: 48px;\n  contain: layout size;\n  border: 1px solid var(--border-card);\n  padding: 8px;\n  border-radius: 6px;\n  margin-top: 8px;\n  background: #0f172a;\n}") (doc (h/el "html" (h/attrsOf (list (h/attr "lang" "en"))) (list (h/el "head" (mapEmpty) (list (h/el "meta" (h/attrsOf (list (h/attr "charset" "UTF-8"))) (list)) (h/el "title" (mapEmpty) (list (h/t title))) (h/el "style" (mapEmpty) (list (h/raw styleStr))))) (h/el "body" (mapEmpty) (list (h/d (h/attrsOf (list (h/attr "class" "header"))) (list (h/el "strong" (mapEmpty) (list (h/t title))) (h/sp (h/attrsOf (list (h/attr "class" "badge"))) (list (h/t status))))) (h/el "p" (mapEmpty) (list (h/t prompt))) (h/d (h/attrsOf (list (h/attr "class" "actions"))) (list (h/btn (h/attrsOf (list (h/attr "id" "btn-extract"))) (list (h/t "Extract DOM to S-Expression"))) (h/btn (h/attrsOf (list (h/attr "id" "btn-eval"))) (list (h/t "Run In-Memory Wasm Benchmark"))) (h/btn (h/attrsOf (list (h/attr "id" "btn-approve"))) (list (h/t "Approve Dangerous Action"))))) (h/d (h/attrsOf (list (h/attr "id" "pending") (h/attr "class" "pending"))) (list (h/t (str "Pending Action: " pending)))) (h/d (h/attrsOf (list (h/attr "id" "output") (h/attr "class" "output"))) (list (h/t out))) (h/el "script" (h/attrsOf (list (h/attr "src" "../dist/popup.js"))) (list)))))))] (str "<!DOCTYPE html>\n" (h/vnodeToHtml doc)))
