(module asl/eddie
  :doc "EDDIE: 3-Layer Superposition Swarm Orchestrator, Consultative Router & Task Pool"
  :export [TaskTier TaskIntent TriageVerdict TaskItem TaskPool OrchestrationPlan VoiceCommand
           fast-triage consult-and-refine plan-execution evaluate-circuit-breaker]
  :import [(core/strings :as s)])

(defenum TriageVerdict
  (:case instant [] "Layer 1: Instant single-shot execution (<0.04ms)")
  (:case consult [] "Layer 2: Consultative clarification, follow-ups, and ambiguity resolution")
  (:case swarm [] "Layer 3: Multi-agent task pool decomposition and mesh delegation"))

(defenum TaskTier
  (:case tier-0 [] "Fast-Track: Deterministic S-expression evaluation in 64KB Wasm")
  (:case tier-1 [] "Specialist: Single agent direct dispatch")
  (:case tier-2 [] "Superposition: Multi-agent speculative deliberation and verification"))

(defenum TaskIntent
  (:case code-gen [] "Code synthesis, refactoring, or bug repair")
  (:case web-search [] "SearXNG real-time research and RAG extraction")
  (:case browser-nav [] "Live DOM interaction, form fill, or scraping")
  (:case sys-command [] "Shell command execution, build, or deployment")
  (:case voice-dialog [] "Voice / audio natural language conversation")
  (:case chat-rag [] "Knowledge retrieval and vector memory query"))

(defschema TaskItem
  (:field id String)
  (:field title String)
  (:field assigned-agent String)
  (:field status String "pending")
  (:field duration-ms Float64 0.04))

(defschema TaskPool
  (:field leader-task-id String)
  (:field prompt String)
  (:field subtasks (List TaskItem))
  (:field follow-ups (List String))
  (:field total-completed Int64 0))

(defschema VoiceCommand
  (:field transcript String)
  (:field is-voice Bool true)
  (:field audio-duration-sec Float64 2.5))

(defschema OrchestrationPlan
  (:field task-id String)
  (:field intent TaskIntent)
  (:field tier TaskTier)
  (:field triage TriageVerdict)
  (:field assigned-agents (List String))
  (:field follow-up-needed Bool false)
  (:field speculative-branches Int64 2)
  (:field circuit-breaker-limit Int64 2))

(defun fast-triage [(prompt String)] -> TriageVerdict
  :doc "Layer 1: Ultra-fast heuristic triage (<0.04ms)"
  (if (s/starts-with prompt "help")
      (:consult)
      (if (s/starts-with prompt "build")
          (:swarm)
          (if (s/starts-with prompt "search")
              (:instant)
              (:swarm)))))

(defun consult-and-refine [(prompt String) (ambiguous Bool)] -> OrchestrationPlan
  :doc "Layer 2: Consultative ambiguity resolution and follow-up generation"
  (if ambiguous
      ["eddie-consult" (:chat-rag) (:tier-0) (:consult) ["agent-consultant"] true 1 1]
      ["eddie-task" (:code-gen) (:tier-2) (:swarm) ["agent-planner" "agent-coder" "agent-reviewer"] false 2 2]))

(defun plan-execution [(task-id String) (prompt String)] -> OrchestrationPlan
  :doc "Layer 3: Decomposes prompt into full multi-agent task pool"
  (let [(triage (fast-triage prompt))]
    (match triage
      ((:instant)
       [task-id (:web-search) (:tier-0) triage ["agent-searcher"] false 1 1])
      ((:consult)
       [task-id (:voice-dialog) (:tier-1) triage ["agent-consultant"] true 1 2])
      ((:swarm)
       [task-id (:code-gen) (:tier-2) triage ["agent-planner" "agent-coder" "agent-reviewer"] false 2 2]))))

(defun evaluate-circuit-breaker [(failures Int64) (threshold Int64)] -> Bool
  :doc "Evaluates if circuit breaker must trip to trigger automatic tree rollback"
  (>= failures threshold))
