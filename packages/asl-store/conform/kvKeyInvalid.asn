(:script :id kvKeyInvalid :checks 13)
(:step (:get "bad col" a 1) (:err keyInvalid _))
(:step (:get notes .. 1) (:err keyInvalid _))
(:step (:get notes a/../b 1) (:err keyInvalid _))
(:step (:get notes "" 1) (:err keyInvalid _))
(:step (:put notes a//b "v" 0 1) (:err keyInvalid _))
(:step (:put "a/b" x "v" 0 1) (:err keyInvalid _))
(:step (:put notes ok.id-1_x/seg "v" 0 1) (:written 1))
(:step (:scan "bad col" "" "" 1 1) (:err keyInvalid _))
(:step (:put notes .h "v" 0 1) (:err keyInvalid _))
(:step (:put notes a.row/b "v" 0 1) (:err keyInvalid _))
(:step (:put notes x.row "v" 0 1) (:err keyInvalid _))
(:step (:get .c a 1) (:err keyInvalid _))
(:step (:scan notes "" "" 10 1) (:page ((ok.id-1_x/seg 1 "v" 0)) ""))
