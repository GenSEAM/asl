(:script :id kvScanOrderLimitCursor :checks 12)
(:step (:put s b "B" 0 1) (:written 1))
(:step (:put s a "A" 0 1) (:written 1))
(:step (:put s c "C" 0 1) (:written 1))
(:step (:scan s "" "" 0 1) (:page ((a 1 "A" 0) (b 1 "B" 0) (c 1 "C" 0)) ""))
(:step (:scan s "" "" 2 1) (:page ((a 1 "A" 0) (b 1 "B" 0)) "b"))
(:step (:scan s "" "b" 2 1) (:page ((c 1 "C" 0)) ""))
(:step (:put s p/x "X" 0 1) (:written 1))
(:step (:put s p/y "Y" 0 1) (:written 1))
(:step (:scan s "p/" "" 10 1) (:page ((p/x 1 "X" 0) (p/y 1 "Y" 0)) ""))
(:step (:scan other "" "" 10 1) (:page () ""))
(:step (:scan s "" "c" 10 1) (:page ((p/x 1 "X" 0) (p/y 1 "Y" 0)) ""))
(:step (:scan s "" "" 4 1) (:page ((a 1 "A" 0) (b 1 "B" 0) (c 1 "C" 0) (p/x 1 "X" 0)) "p/x"))
