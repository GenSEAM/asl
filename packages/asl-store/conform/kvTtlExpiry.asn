(:script :id kvTtlExpiry :checks 9)
(:step (:put notes t "v" 50 1000) (:written 1))
(:step (:get notes t 1049) (:value 1 "v" 1050))
(:step (:get notes t 1050) (:absent))
(:step (:cas notes t 1 "x" 0 1050) (:conflict 0))
(:step (:cas notes t 0 "fresh" 0 1050) (:written 1))
(:step (:get notes t 2000) (:value 1 "fresh" 0))
(:step (:put notes u "v" 10 100) (:written 1))
(:step (:scan notes "" "" 10 200) (:page ((t 1 "fresh" 0)) ""))
(:step (:del notes u 1 200) (:conflict 0))
