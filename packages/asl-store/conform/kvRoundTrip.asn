(:script :id kvRoundTrip :checks 9)
(:step (:put notes a "héllo wörld ✓" 0 100) (:written 1))
(:step (:get notes a 100) (:value 1 "héllo wörld ✓" 0))
(:step (:put notes q "say \"hi\" \\ ok" 0 100) (:written 1))
(:step (:get notes q 100) (:value 1 "say \"hi\" \\ ok" 0))
(:step (:put notes nl "line1\nline2\ttab" 0 100) (:written 1))
(:step (:get notes nl 100) (:value 1 "line1\nline2\ttab" 0))
(:step (:put notes empty "" 0 100) (:written 1))
(:step (:get notes empty 100) (:value 1 "" 0))
(:step (:put notes a "second" 0 100) (:written 2))
