(module asl-codegen/builtins :x [builtinTemplate renderTemplate renderBuiltin] :i [])

fn builtinTemplate name: String -> (Option String)
  (cond ((= name "!=") (some "({0} != {1})")) ((= name "*") (some "rt::mul({0}, {1})")) ((= name "+") (some "rt::add({0}, {1})")) ((= name "-") (some "rt::sub({0}, {1})")) ((= name "/") (some "rt::div({0}, {1})")) ((= name "<") (some "({0} < {1})")) ((= name "<=") (some "({0} <= {1})")) ((= name "=") (some "({0} == {1})")) ((= name ">") (some "({0} > {1})")) ((= name ">=") (some "({0} >= {1})")) ((= name "abs") (some "rt::abs({0})")) ((= name "alreadyExists") (some "rt::IoError::AlreadyExists")) ((= name "and") (some "({0} && {1})")) ((= name "checkedDiv") (some "rt::checked_div({0}, {1})")) ((= name "checkedMod") (some "rt::checked_rem({0}, {1})")) ((= name "eprintln") (some "rt::eprintln(&{0})")) ((= name "err") (some "Err({0})")) ((= name "file-append") (some "rt::file_append(&{0}, &{1})")) ((= name "fileExists?") (some "rt::file_exists(&{0})")) ((= name "fileRead") (some "rt::file_read(&{0})")) ((= name "fileWrite") (some "rt::file_write(&{0}, &{1})")) ((= name "filter") (some "rt::filter({1}, {0})")) ((= name "float64ToInt64") (some "rt::f_to_i({0})")) ((= name "fold") (some "{2}.into_iter().fold({1}, {0})")) ((= name "int32ToInt64") (some "({0} as i64)")) ((= name "int64ToFloat64") (some "rt::i_to_f({0})")) ((= name "int64ToInt32") (some "rt::to_i32({0})")) ((= name "interrupted") (some "rt::IoError::Interrupted")) ((= name "invalidPath") (some "rt::IoError::InvalidPath")) ((= name "err?") (some "{0}.is_err()")) ((= name "none?") (some "{0}.is_none()")) ((= name "ok?") (some "{0}.is_ok()")) ((= name "some?") (some "{0}.is_some()")) ((= name "list") (some "vec![{*}]")) ((= name "listAppend") (some "rt::append({0}, {1})")) ((= name "listContains?") (some "{0}.contains(&{1})")) ((= name "listEmpty?") (some "{0}.is_empty()")) ((= name "listGet") (some "rt::at(&{0}, {1})")) ((= name "listHead") (some "rt::at(&{0}, 0)")) ((= name "listIndexOf") (some "rt::index_of(&{0}, &{1})")) ((= name "listLength") (some "({0}.len() as i64)")) ((= name "listMax") (some "rt::greatest(&{0})")) ((= name "listMin") (some "rt::least(&{0})")) ((= name "listReverse") (some "rt::rev({0})")) ((= name "listSlice") (some "rt::list_slice(&{0}, {1}, {2})")) ((= name "listSort") (some "rt::sort({0})")) ((= name "listSortBy") (some "rt::sort_by({1}, {0})")) ((= name "listSum") (some "rt::sum({0})")) ((= name "listTail") (some "rt::tail(&{0})")) ((= name "map") (some "{1}.into_iter().map({0}).collect::<Vec<_>>()")) ((= name "mapEmpty") (some "std::collections::BTreeMap::new()")) ((= name "mapFromPairs") (some "rt::m_from({0})")) ((= name "mapGet") (some "rt::m_get(&{0}, &{1})")) ((= name "mapHas?") (some "{0}.contains_key(&{1})")) ((= name "mapKeys") (some "{0}.keys().cloned().collect::<Vec<_>>()")) ((= name "mapPairs") (some "rt::m_pairs(&{0})")) ((= name "mapRemove") (some "rt::m_del({0}, &{1})")) ((= name "mapSet") (some "rt::m_set({0}, {1}, {2})")) ((= name "mapSize") (some "({0}.len() as i64)")) ((= name "mapValues") (some "{0}.values().cloned().collect::<Vec<_>>()")) ((= name "max") (some "rt::max({0}, {1})")) ((= name "min") (some "rt::min({0}, {1})")) ((= name "mod") (some "rt::rem({0}, {1})")) ((= name "neg") (some "rt::neg({0})")) ((= name "none") (some "None")) ((= name "not") (some "(!{0})")) ((= name "notFound") (some "rt::IoError::NotFound")) ((= name "ok") (some "Ok({0})")) ((= name "optionMap") (some "{1}.map({0})")) ((= name "optionOr") (some "{0}.unwrap_or({1})")) ((= name "optionToResult") (some "{0}.ok_or({1})")) ((= name "or") (some "({0} || {1})")) ((= name "other") (some "rt::IoError::Other")) ((= name "pair") (some "({0}, {1})")) ((= name "permissionDenied") (some "rt::IoError::PermissionDenied")) ((= name "print") (some "rt::print_out(&{0})")) ((= name "println") (some "rt::println(&{0})")) ((= name "range") (some "rt::range({0}, {1})")) ((= name "read-all") (some "rt::read_all()")) ((= name "read-line") (some "rt::read_line()")) ((= name "resultMap") (some "{1}.map({0})")) ((= name "resultMapErr") (some "{1}.map_err({0})")) ((= name "resultOr") (some "{0}.unwrap_or({1})")) ((= name "resultToOption") (some "{0}.ok()")) ((= name "some") (some "Some({0})")) ((= name "str") (some "rt::concat(&[{*}])")) ((= name "stringChars") (some "rt::chars(&{0})")) ((= name "stringContains?") (some "{0}.contains(&{1})")) ((= name "stringEmpty?") (some "{0}.is_empty()")) ((= name "stringEndsWith?") (some "{0}.ends_with(&{1})")) ((= name "stringFromFloat64") (some "rt::fmt_f64({0})")) ((= name "stringFromInt64") (some "rt::fmt_i64({0})")) ((= name "stringIndexOf") (some "rt::str_index_of(&{0}, &{1})")) ((= name "stringJoin") (some "{0}.join(&{1})")) ((= name "stringLength") (some "rt::str_len(&{0})")) ((= name "stringLower") (some "{0}.to_lowercase()")) ((= name "stringReplace") (some "{0}.replace(&{1}, &{2})")) ((= name "stringReverse") (some "rt::str_rev(&{0})")) ((= name "stringSlice") (some "rt::str_slice(&{0}, {1}, {2})")) ((= name "stringSplit") (some "rt::split(&{0}, &{1})")) ((= name "stringStartsWith?") (some "{0}.starts_with(&{1})")) ((= name "stringToFloat64") (some "rt::to_f64(&{0})")) ((= name "stringToInt64") (some "rt::to_i64(&{0})")) ((= name "stringTrim") (some "{0}.trim().to_string()")) ((= name "stringUpper") (some "{0}.to_uppercase()")) ((= name "zip") (some "rt::zip({0}, {1})")) (else (none)))

fn renderTemplate tmpl: String args: (List String) -> String
  (let [(tStar (if (stringContains? tmpl "{*}") (stringReplace tmpl "{*}" (stringJoin args ", ")) tmpl)) (a0 (optionOr (listGet args 0) "")) (t0 (if (stringContains? tStar "{0}") (stringReplace tStar "{0}" a0) tStar)) (a1 (optionOr (listGet args 1) "")) (t1 (if (stringContains? t0 "{1}") (stringReplace t0 "{1}" a1) t0)) (a2 (optionOr (listGet args 2) "")) (t2 (if (stringContains? t1 "{2}") (stringReplace t1 "{2}" a2) t1))] t2)

fn renderBuiltin bname: String args: (List String) -> (Option String)
  (mt (builtinTemplate bname) ((none) (none)) ((some tmpl) (some (renderTemplate tmpl args))))
