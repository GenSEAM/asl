    (:sym :name "lowerCAtom" :kind :fn :tokens 3
          :rationale "Lowers terminal SExpr atoms into C99 literals or sanitized identifiers")
    (:sym :name "lowerCLet" :kind :fn :tokens 3
          :rationale "Synthesizes scoped C99 block statements from ASL let binding vectors")
    (:sym :name "lowerCIf" :kind :fn :tokens 3
