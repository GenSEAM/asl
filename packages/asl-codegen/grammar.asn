    (:sym :name "boxedTypeIfRecursive" :kind :fn :tokens 4
          :rationale "Cannot be reduced to 'boxed-type': the 'if-recursive' condition is mandatory to prevent unconditional heap allocation of non-recursive types in Rust")
    (:sym :name "cloneIfIdent" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'clone-ident': conditional qualifier 'if-ident' is critical to avoid emitting superfluous .clone() on literal values or borrowing contexts")
    (:sym :name "emitArduinoHeader" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-header': targets microcontroller C/C++ hardware headers, distinguishing from ANSI C emit-c-header")
    (:sym :name "emitArduinoSketch" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-sketch': explicitly specifies Arduino target platform emission with setup() and loop() bindings")
    (:sym :name "emitBodySeq" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-seq': disambiguates statement-block body lowering from top-level declaration sequences")
    (:sym :name "emitCFn" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-fn': language qualifier 'c' is mandatory to separate ANSI C function transpilation from Rust/TSX emission")
    (:sym :name "emitCHeader" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-header': distinguishes ANSI C header guards and prototypes from Arduino and C++ headers")
    (:sym :name "emitCType" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-type': language qualifier 'c' is mandatory to separate ANSI C type formatting from Rust/TSX")
    (:sym :name "emitJsxAttrs" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-attrs': distinguishes React JSX key={val} prop formatting from HTML string attribute rendering")
    (:sym :name "emitRustProgram" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-program': language qualifier 'rust' is required to isolate Rust crate compilation output")
    (:sym :name "emitTopForms" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-forms': disambiguates top-level module declarations from scoped inner expressions")
    (:sym :name "emitTsxModule" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-module': language qualifier 'tsx' is required to distinguish React TypeScript modules from ASL manifests")
    (:sym :name "emitTypeStr" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-type': specifies stringification of AST type descriptors, avoiding collision with emit-c-type")
    (:sym :name "emitVnodeJsx" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-vnode': target format 'jsx' is mandatory to distinguish JSX syntax from direct VNode tree emission")
    (:sym :name "emitWatExpr" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-expr': language qualifier 'wat' is required to isolate WebAssembly Text expression lowering from Rust and JSX expression generators")
    (:sym :name "emitWatModule" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'emit-wat': language and envelope qualifier 'module' is required to distinguish whole-module WAT emission from individual WAT expression or function helpers")
    (:sym :name "formatDelayCall" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'format-delay': specifies codegen lowering into target-specific delay timer API syntax")
    (:sym :name "formatGpioCall" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'format-gpio': specifies codegen lowering into microcontroller pin manipulation statements")
    (:sym :name "hasMainFn?" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'has-main?': explicitly checks for an executable function definition rather than module configuration")
    (:sym :name "isComponentTag?" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'is-component?': restricts predicate check to string tag names, preventing collision with VNode checks")
    (:sym :name "isRustKeyword?" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'is-keyword?': scopes reservation check to Rust grammar keywords to drive identifier mangling")
    (:sym :name "isVoidTag?" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'is-void?': restricts check to self-closing HTML void elements without children")
    (:sym :name "jsxAttrKey" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'attr-key': distinguishes React JSX prop name mapping (className, htmlFor) from raw HTML attributes")
    (:sym :name "primitiveRustType" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'rust-type': scopes mapping strictly to Rust primitive scalar types (i64, f64, bool, String)")
    (:sym :name "resolveQualifiedCase" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'resolve-case': distinguishes module-namespaced enum variants from simple pattern-match arms")
    (:sym :name "rustModName" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'mod-name': scopes identifier sanitization strictly to snake_case Rust crate module paths")
    (:sym :name "shortModName" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'mod-name': specifies terminal path component extraction, distinguishing from full module identifiers")
    (:sym :name "sliceStrOr" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'slice-str': 'or' suffix is essential to indicate safe fallback return on out-of-bounds indices")
    (:sym :name "testArduinoSketch" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-sketch': disambiguates Arduino codegen unit tests from generic compiler sketches")
    (:sym :name "testCHeader" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-header': isolates ANSI C header emission tests from Arduino headers")
    (:sym :name "testCType" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-type': isolates ANSI C struct and enum type mapping tests from Rust and TSX")
    (:sym :name "testGpioCalls" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'test-gpio': isolates pin read/write codegen assertions from hardware simulator logic")
    (:sym :name "testWatConst" :kind :fn :tokens 3
