(module asl-codegen/tests/c99ExprLoweringTest :x [testC99ExprDynamicExecution! testC99ExprInvariants testC99ExprDualPolarityRefutations testLiveClangCompilationOfEmittedC99! runTests] :i [(asl-codegen/c99Expr :a ex) (asl-parser/reader :a rd)])

fn testC99ExprDynamicExecution! -> Bool
  (let [(res (processRun "bin/asl test asl/packages/asl-codegen/tests/c99ExprTest.asl")) (code res.exitCode) (stdout res.stdout)] (assert (= code 0) (str "c99ExprTest must exit 0, stderr: " res.stderr)) (refute (!= code 0) "c99ExprTest must not fail") (assert (stringContains? stdout "assertion(s) executed") "c99ExprTest must report executed assertions") (assert (stringContains? stdout "refutation(s) executed") "c99ExprTest must report executed refutations") (refute (stringContains? stdout "ASL_ASSERTION_FAILURE") "c99ExprTest must not fail assertions") true)

fn testC99ExprInvariants -> Bool
  (let [(ctx (ex/emptyLowerCtx)) (atomInt (ex/lowerCAtom "42")) (atomStr (ex/lowerCAtom "\"acceptance\"")) (atomBool (ex/lowerCAtom "true")) (atomMangled (ex/lowerCAtom "is-finished?")) (atomKw (ex/lowerCAtom "volatile")) (fAccess (ex/lowerCFieldAccess "session" "status")) (fAccessKebab (ex/lowerCFieldAccess "record" "first-name")) (addNode (rd/sexprList (list (rd/sexprAtom "+") (rd/sexprAtom "a") (rd/sexprAtom "b")))) (eAdd (ex/lowerCExpr ctx addNode)) (mulNestedNode (rd/sexprList (list (rd/sexprAtom "*") addNode (rd/sexprAtom "c")))) (eMul (ex/lowerCExpr ctx mulNestedNode)) (divNode (rd/sexprList (list (rd/sexprAtom "/") (rd/sexprAtom "top") (rd/sexprAtom "bottom")))) (eDiv (ex/lowerCExpr ctx divNode)) (ifNode (rd/sexprList (list (rd/sexprAtom "if") (rd/sexprAtom "ready") (rd/sexprAtom "1") (rd/sexprAtom "0")))) (eIf (ex/lowerCIf ctx (rd/sexprToList ifNode))) (callNode (rd/sexprList (list (rd/sexprAtom "compute-sum") (rd/sexprAtom "10") (rd/sexprAtom "20")))) (eCall (ex/lowerCCall ctx (rd/sexprToList callNode))) (bPair (rd/sexprVect (list (rd/sexprAtom "total") (rd/sexprAtom "Int64") (rd/sexprAtom "100")))) (bindings (rd/sexprVect (list bPair))) (letNode (rd/sexprList (list (rd/sexprAtom "let") bindings (rd/sexprAtom "total")))) (eLet (ex/lowerCLet ctx (rd/sexprToList letNode))) (recNode (rd/sexprList (list (rd/sexprAtom "TaskConfig") (rd/sexprAtom ":id") (rd/sexprAtom "50903") (rd/sexprAtom ":active") (rd/sexprAtom "true")))) (eRec (ex/lowerCRecordInit ctx (rd/sexprToList recNode))) (arm1 (rd/sexprList (list (rd/sexprList (list (rd/sexprAtom "success") (rd/sexprAtom "code"))) (rd/sexprAtom "code")))) (arm2 (rd/sexprList (list (rd/sexprList (list (rd/sexprAtom "failure"))) (rd/sexprAtom "-1")))) (matchNode (rd/sexprList (list (rd/sexprAtom "match") (rd/sexprAtom "res") arm1 arm2))) (eMatch (ex/lowerCMatch ctx (rd/sexprToList matchNode)))] (assert (= atomInt "42LL") "atom integer lowered with LL suffix") (assert (= atomStr "(asl_string_t){ .data = \"acceptance\", .len = 10 }") "atom string lowered with length") (assert (= atomBool "true") "atom boolean preserved") (assert (= atomMangled "is_finished") "kebab predicate mangled to snake") (assert (= atomKw "asl_volatile") "c99 reserved keyword safely prefixed") (assert (= fAccess "session.status") "field access lowered to dot notation") (assert (= fAccessKebab "record.first_name") "field name mangled to snake") (assert (= eAdd "((a) + (b))") "arithmetic addition fully parenthesized") (assert (= eMul "((((a) + (b))) * (c))") "nested arithmetic defensive parenthesization") (assert (= eDiv "((top) / (bottom))") "division fully parenthesized") (assert (= eIf "((ready) ? (1LL) : (0LL))") "if lowered to defensive ternary") (assert (= eCall "compute_sum(10LL, 20LL)") "function call with mangled name and lowered args") (assert (= eLet "{ int64_t total = 100LL; total; }") "let lowered to scoped C99 block statement") (assert (= eRec "(AslTaskConfig){ .id = 50903LL, .active = true }") "record lowered to designated compound literal") (assert (stringContains? eMatch "switch ((int)((res).tag)) {") "match switches on the tag cast to int") (assert (stringContains? eMatch "case ASL_TAG_SUCCESS:") "match contains success case") (assert (stringContains? eMatch "case ASL_TAG_FAILURE:") "match contains failure case") (assert (stringContains? eMatch "break;") "match cases have explicit break") (assert (stringContains? eMatch "default: { abort(); break; }") "match contains unreachable default guard") true)

fn testC99ExprDualPolarityRefutations -> Bool
  (let [(ctx (ex/emptyLowerCtx)) (divNode (rd/sexprList (list (rd/sexprAtom "/") (rd/sexprAtom "x") (rd/sexprAtom "y")))) (eDiv (ex/lowerCExpr ctx divNode)) (addNode (rd/sexprList (list (rd/sexprAtom "+") (rd/sexprAtom "x") (rd/sexprAtom "y")))) (eAdd (ex/lowerCExpr ctx addNode)) (matchNode (rd/sexprList (list (rd/sexprAtom "match") (rd/sexprAtom "state") (rd/sexprList (list (rd/sexprList (list (rd/sexprAtom "open"))) (rd/sexprAtom "1"))) (rd/sexprList (list (rd/sexprList (list (rd/sexprAtom "closed"))) (rd/sexprAtom "0")))))) (eMatch (ex/lowerCMatch ctx (rd/sexprToList matchNode))) (letNode (rd/sexprList (list (rd/sexprAtom "let") (rd/sexprVect (list (rd/sexprVect (list (rd/sexprAtom "temp") (rd/sexprAtom "99"))))) (rd/sexprAtom "temp")))) (eLet (ex/lowerCLet ctx (rd/sexprToList letNode)))] (refute (not (stringStartsWith? eDiv "((")) "division must not omit outer parentheses") (refute (not (stringEndsWith? eDiv "))")) "division must not omit closing parentheses") (refute (= eDiv "x / y") "division must never emit bare unparenthesized infix") (refute (not (stringStartsWith? eAdd "((")) "addition must start with double parens") (refute (not (stringEndsWith? eAdd "))")) "addition must end with double parens") (refute (not (stringContains? eMatch "break;")) "match arms must never fall through") (refute (not (stringContains? eMatch "abort();")) "match must never omit default abort guard") (refute (not (stringStartsWith? eLet "{")) "let statement block must start with open brace") (refute (not (stringEndsWith? eLet "}")) "let statement block must end with close brace") (refute (= (ex/mangleCIdent "int") "int") "reserved keyword int must not remain bare") (refute (= (ex/mangleCIdent "return") "return") "reserved keyword return must not remain bare") (refute (= (ex/mangleCIdent "struct") "struct") "reserved keyword struct must not remain bare") (refute (stringContains? (ex/mangleCIdent "has-value?") "?") "mangled identifier must not contain question mark") (refute (stringContains? (ex/mangleCIdent "mutate-state!") "!") "mangled identifier must not contain bang") (refute (stringContains? (ex/mangleCIdent "foo-bar") "-") "mangled identifier must not contain dash") true)

fn testLiveClangCompilationOfEmittedC99! -> Bool
  (let [(ctx (ex/emptyLowerCtx)) (addNode (rd/sexprList (list (rd/sexprAtom "+") (rd/sexprAtom "10") (rd/sexprAtom "20")))) (eAdd (ex/lowerCExpr ctx addNode)) (divNode (rd/sexprList (list (rd/sexprAtom "/") (rd/sexprAtom "100") (rd/sexprAtom "4")))) (eDiv (ex/lowerCExpr ctx divNode)) (ifNode (rd/sexprList (list (rd/sexprAtom "if") (rd/sexprAtom "true") (rd/sexprAtom "1") (rd/sexprAtom "0")))) (eIf (ex/lowerCExpr ctx ifNode)) (cCode (str "#include <stdint.h>\n" "#include <stdbool.h>\n" "#include <stdlib.h>\n" "typedef struct { const char* data; size_t len; } asl_string_t;\n" "typedef enum { ASL_TAG_SOME, ASL_TAG_NONE } AslOptionTag;\n" "typedef struct { AslOptionTag tag; union { int64_t some; } data; } AslOption;\n" "int main(void) {\n" "  int64_t a = " eAdd ";\n" "  int64_t b = " eDiv ";\n" "  int64_t c = " eIf ";\n" "  asl_string_t s = (asl_string_t){ .data = \"live\", .len = 4 };\n" "  AslOption opt;\n" "  opt.tag = ASL_TAG_SOME;\n" "  opt.data.some = 42LL;\n" "  int64_t matchRes = 0LL;\n" "  switch ((opt).tag) {\n" "    case ASL_TAG_SOME: {\n" "      matchRes = opt.data.some;\n" "      break;\n" "    }\n" "    case ASL_TAG_NONE: {\n" "      matchRes = 0LL;\n" "      break;\n" "    }\n" "    default: {\n" "      abort();\n" "      break;\n" "    }\n" "  }\n" "  if (a == 30LL && b == 25LL && c == 1LL && s.len == 4 && matchRes == 42LL) {\n" "    return 0;\n" "  }\n" "  return 1;\n" "}\n")) (cPath "/tmp/c99expr_live_test.c") (binPath "/tmp/c99expr_live_test") (writeRes (processRun (str "cat << 'EOF' > " cPath "\n" cCode "EOF"))) (compileRes (processRun (str "clang -std=c99 -Wall -Wextra -Werror -pedantic " cPath " -o " binPath))) (compileCode compileRes.exitCode)] (assert (= compileCode 0) (str "clang compilation must exit 0, stderr: " compileRes.stderr)) (refute (!= compileCode 0) "clang compilation must never produce warnings or errors") (let [(runRes (processRun binPath)) (runCode runRes.exitCode)] (assert (= runCode 0) (str "native executable must exit 0, stderr: " runRes.stderr)) (refute (!= runCode 0) "native binary execution must not fail") (processRun (str "rm -f " cPath " " binPath)) true))

fn ! runTests -> Bool
  (do (assert (testC99ExprDynamicExecution!) "testC99ExprDynamicExecution must pass") (assert (testC99ExprInvariants) "testC99ExprInvariants must pass") (assert (testC99ExprDualPolarityRefutations) "testC99ExprDualPolarityRefutations must pass") (assert (testLiveClangCompilationOfEmittedC99!) "testLiveClangCompilationOfEmittedC99 must pass") true)
