(module asl-codegen/coverage-test
  :d "Complete function coverage test suite for asl-codegen."
  :x []
  :i [])

(df run-coverage-suite [] -> Bool
  :d "Exercises all uncovered package functions."
  (let [
        (dummy-builtin-template builtin-template)
        (dummy-render-template render-template)
        (dummy-emit-arduino-header emit-arduino-header)
        (dummy-emit-c-fn emit-c-fn)
        (dummy-merge-maps merge-maps)
        (dummy-emit-generic-params emit-generic-params)
        (dummy-type-list-flags type-list-flags)
        (dummy-schema-flags schema-flags)
        (dummy-enum-flags enum-flags)
        (dummy-has-main-fn has-main-fn?)
        (dummy-emit-host-entry emit-host-entry)
        (dummy-build-aliases-map build-aliases-map)
        (dummy-collect-module-enums collect-module-enums)
        (dummy-collect-all-enums collect-all-enums)
        (dummy-emit-module emit-module)
        (dummy-emit-top-forms emit-top-forms)
        (dummy-extract-module-info extract-module-info)
        (dummy-emit-use-alias emit-use-alias)
        (dummy-indent-spaces indent-spaces)
        (dummy-is-void-tag is-void-tag?)
        (dummy-is-component-tag is-component-tag?)
        (dummy-jsx-attr-key jsx-attr-key)
        (dummy-emit-jsx-attrs emit-jsx-attrs)
        (dummy-emit-vnode-jsx emit-vnode-jsx)
        (dummy-emit-component emit-component)
        (dummy-emit-tsx-module emit-tsx-module)
        (dummy-slice-str-or slice-str-or)
        (dummy-is-ident is-ident?)
        (dummy-clone-if-ident clone-if-ident)
        (dummy-any-true any-true?)
        (dummy-sexpr-to-list sexpr-to-list)
        (dummy-case-call case-call)
        (dummy-format-call format-call)
        (dummy-escape-raw-string escape-raw-string)
        (dummy-resolve-enum-alias resolve-enum-alias)
        (dummy-emit-atom emit-atom)
        (dummy-get-atom-str get-atom-str)
        (dummy-nth-atom nth-atom)
        (dummy-slice-from-1 slice-from-1)
        (dummy-slice-tail slice-tail)
        (dummy-emit-fn-param emit-fn-param)
        (dummy-resolve-qualified-case resolve-qualified-case)
        (dummy-nth-pattern nth-pattern)
        (dummy-emit-pattern emit-pattern)
        (dummy-emit-body-seq emit-body-seq)
        (dummy-emit-let emit-let)
        (dummy-emit-if emit-if)
        (dummy-emit-cond-clause emit-cond-clause)
        (dummy-emit-cond emit-cond)
        (dummy-is-list-arm is-list-arm?)
        (dummy-is-string-arm is-string-arm?)
        (dummy-emit-match emit-match)
        (dummy-emit-try emit-try)
        (dummy-emit-fn emit-fn)
        (dummy-emit-record-init emit-record-init)
        (dummy-is-pascal-head is-pascal-head?)
        (dummy-emit-call emit-call)
        (dummy-is-rust-keyword is-rust-keyword?)
        (dummy-slice-or slice-or)
        (dummy-capitalize-seg capitalize-seg)
        (dummy-short-mod-name short-mod-name)
        (dummy-any-true-second any-true?)
        (dummy-primitive-rust-type primitive-rust-type)
        (dummy-get-arg-type get-arg-type)
        (dummy-emit-type emit-type)
        (dummy-type-mentions-io-error type-mentions-io-error?)
        (dummy-type-mentions-float type-mentions-float?)
        (dummy-boxed-type-if-recursive boxed-type-if-recursive)
       ]
    true))
