(:package asl-target-py
 :version "0.2.0"
 :entry "src/main.asl"
 :description "Python 3 backend: lowers a linked, verified asl-ir SSA module to one self-contained Python file with a small runtime; Int traps on int64 overflow, strings keep ASL's UTF-8 byte semantics, main's result is the exit code"
 :aslFirst true
 :modules [
   "asl-target-py"
   "asl-target-py/emit"
   "asl-target-py/runtime"
 ]
 :dependencies ["asl-ir"])
