(module asl/packages/asl-target-py/tests/divisionEscapeTest :x [runTests] :i [(asl-target-py/emitPy :a py) (ast :a a) (reader :a rd) (asl-text/string :a s)])

fn testEmitterSyntaxModernization! -> Bool
  (let [(resPy (fileRead "asl/packages/asl-target-py/src/emitPy.asl")) (codePy (resultOr resPy ""))] (assert (ok? resPy) "emitPy.asl must exist and be readable") (refute (err? resPy) "emitPy.asl refutes read failure") (assert (stringContains? codePy "fn pyMangleIdent") "emitPy.asl affirms modern fn pyMangleIdent") (assert (stringContains? codePy "fn emitPyBinop") "emitPy.asl affirms modern fn emitPyBinop") (refute (stringContains? codePy "(df ") "emitPy.asl refutes legacy df definitions") (refute (stringContains? codePy "(defun ") "emitPy.asl refutes legacy defun") (assert (stringContains? codePy "pyMangleIdent") "emitPy.asl affirms pyMangleIdent export") true)

fn testTrueAndIntegerDivisionSemantics -> Bool
  (let [(divFloat (py/emitPyBinop "/" (list (rd/sexprAtom "10.0") (rd/sexprAtom "2.0")))) (divInt (py/emitPyBinop "//" (list (rd/sexprAtom "10") (rd/sexprAtom "2")))) (divIdiv (py/emitPyBinop "idiv" (list (rd/sexprAtom "10") (rd/sexprAtom "2")))) (divI64 (py/emitPyBinop "div-i64" (list (rd/sexprAtom "10") (rd/sexprAtom "2")))) (divF64 (py/emitPyBinop "div-f64" (list (rd/sexprAtom "10.0") (rd/sexprAtom "2.0"))))] (assert (= divFloat "10.0 / 2.0") "true division / emits single slash") (refute (stringContains? divFloat "//") "true division / refutes double slash") (assert (= divInt "10 // 2") "integer division // emits double slash") (refute (stringEndsWith? divInt " / 2") "integer division // refutes single slash") (assert (= divIdiv "10 // 2") "idiv emits integer division //") (assert (= divI64 "10 // 2") "div-i64 emits integer division //") (assert (= divF64 "10.0 / 2.0") "div-f64 emits float division /") (let [(fnFloat (py/emitPyFn (a/DefunNode :name "calc-ratio" :typeVars (list) :isExported true :effect false :params (list (a/Param :name "numerator" :type "F64") (a/Param :name "denominator" :type "F64")) :retType "F64" :docstring "\"Calculates ratio.\"" :body (list (rd/sexprList (list (rd/sexprAtom "/") (rd/sexprAtom "numerator") (rd/sexprAtom "denominator"))))))) (fnInt (py/emitPyFn (a/DefunNode :name "calc-quotient" :typeVars (list) :isExported true :effect false :params (list (a/Param :name "val" :type "I64") (a/Param :name "divisor" :type "I64")) :retType "I64" :docstring "\"Calculates quotient.\"" :body (list (rd/sexprList (list (rd/sexprAtom "idiv") (rd/sexprAtom "val") (rd/sexprAtom "divisor")))))))] (assert (stringContains? fnFloat "return numerator / denominator") "fnFloat emits return numerator / denominator") (refute (stringContains? fnFloat "return numerator // denominator") "fnFloat refutes floor division") (assert (stringContains? fnInt "return val // divisor") "fnInt emits return val // divisor") (refute (stringContains? fnInt "return val / divisor") "fnInt refutes float division") true))

fn testPythonReservedKeywordEscaping -> Bool
  (let [(kClass (py/pyMangleIdent "class")) (kDef (py/pyMangleIdent "def")) (kImport (py/pyMangleIdent "import")) (kReturn (py/pyMangleIdent "return")) (kPass (py/pyMangleIdent "pass")) (kFrom (py/pyMangleIdent "from")) (kAs (py/pyMangleIdent "as")) (kGlobal (py/pyMangleIdent "global")) (kLambda (py/pyMangleIdent "lambda")) (kYield (py/pyMangleIdent "yield")) (kTry (py/pyMangleIdent "try")) (kExcept (py/pyMangleIdent "except")) (kFinally (py/pyMangleIdent "finally")) (kWith (py/pyMangleIdent "with")) (kAsync (py/pyMangleIdent "async")) (kAwait (py/pyMangleIdent "await")) (kAssert (py/pyMangleIdent "assert")) (kDel (py/pyMangleIdent "del")) (kNormal (py/pyMangleIdent "normal-identifier"))] (assert (= kClass "class_") "keyword class escapes to class_") (refute (= kClass "class") "keyword class refutes unescaped collision") (assert (= kDef "def_") "keyword def escapes to def_") (refute (= kDef "def") "keyword def refutes unescaped collision") (assert (= kImport "import_") "keyword import escapes to import_") (refute (= kImport "import") "keyword import refutes unescaped collision") (assert (= kReturn "return_") "keyword return escapes to return_") (refute (= kReturn "return") "keyword return refutes unescaped collision") (assert (= kPass "pass_") "keyword pass escapes to pass_") (refute (= kPass "pass") "keyword pass refutes unescaped collision") (assert (= kFrom "from_") "keyword from escapes to from_") (assert (= kAs "as_") "keyword as escapes to as_") (assert (= kGlobal "global_") "keyword global escapes to global_") (assert (= kLambda "lambda_") "keyword lambda escapes to lambda_") (assert (= kYield "yield_") "keyword yield escapes to yield_") (assert (= kTry "try_") "keyword try escapes to try_") (assert (= kExcept "except_") "keyword except escapes to except_") (assert (= kFinally "finally_") "keyword finally escapes to finally_") (assert (= kWith "with_") "keyword with escapes to with_") (assert (= kAsync "async_") "keyword async escapes to async_") (assert (= kAwait "await_") "keyword await escapes to await_") (assert (= kAssert "assert_") "keyword assert escapes to assert_") (assert (= kDel "del_") "keyword del escapes to del_") (assert (= kNormal "normal_identifier") "normal identifier is not escaped with underscore") (refute (= kNormal "normal_identifier_") "normal identifier refutes unnecessary trailing underscore") (let [(fnKw (py/emitPyFn (a/DefunNode :name "filter-by-class" :typeVars (list) :isExported true :effect false :params (list (a/Param :name "class" :type "Str") (a/Param :name "import" :type "Bool") (a/Param :name "pass" :type "I64")) :retType "Bool" :docstring "\"Filters records.\"" :body (list (rd/sexprList (list (rd/sexprAtom "and") (rd/sexprAtom "import") (rd/sexprAtom "class"))))))) (clsKw (py/emitPyClass (a/SchemaNode :name "SyntaxToken" :typeVars (list) :fields (list (a/AstField :name "class" :type "Str" :docstring "" :default (none) :json (none)) (a/AstField :name "def" :type "Str" :docstring "" :default (none) :json (none)) (a/AstField :name "pass" :type "Bool" :docstring "" :default (none) :json (none))) :jsonCase (none))))] (assert (stringContains? fnKw "def filter_by_class(class_: str, import_: bool, pass_: int) -> bool:") "fnKw signature has escaped params") (refute (stringContains? fnKw "class: str") "fnKw refutes unescaped class: str") (refute (stringContains? fnKw "import: bool") "fnKw refutes unescaped import: bool") (refute (stringContains? fnKw "pass: int") "fnKw refutes unescaped pass: int") (assert (stringContains? clsKw "class_: str") "clsKw fields have escaped class_") (assert (stringContains? clsKw "def_: str") "clsKw fields have escaped def_") (assert (stringContains? clsKw "pass_: bool") "clsKw fields have escaped pass_") (refute (stringContains? clsKw "    class: str") "clsKw refutes raw unescaped class keyword field") (refute (stringContains? clsKw "    def: str") "clsKw refutes raw unescaped def keyword field") (refute (stringContains? clsKw "    pass: bool") "clsKw refutes raw unescaped pass keyword field") true))

fn ! runTests -> Bool
  (and (testEmitterSyntaxModernization!) (and (testTrueAndIntegerDivisionSemantics) (testPythonReservedKeywordEscaping)))
