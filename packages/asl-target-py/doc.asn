(:doc :symbol "asl/packages/asl-target-py/src/main.asl#" :text "Python target entry: compileEntry! links an entry module through asl-ir and emits one Python 3 file.")
(:doc :symbol "asl/packages/asl-target-py/src/main.asl#compileEntry!" :text "Link the entry module and emit Python; err lists ERR_CAPABILITY_ABSENT for every builtin the runtime lacks.")
(:doc :symbol "asl/packages/asl-target-py/src/emit.asl#" :text "SSA to Python: each function is a while loop over its blocks, self tail calls become jumps to block 0, captures are bound with functools.partial at creation.")
(:doc :symbol "asl/packages/asl-target-py/src/runtime.asl#" :text "The Python runtime embedded in every emitted file, generated from a Python source: values, int64 overflow traps, floored division, host-identical printing and float formatting, builtins and entries.")
(:doc :symbol "asl/packages/asl-target-py/tests/ssaPyTest.asl#" :text "Runs the asl-target-js fixtures compiled to Python against asl-host run, and asl-html's suites compiled to Python against asl-host test.")
