(module asl-target-py/runtime
  :x [runtimeText builtinNames entryNames]
  :i [])

fn runtimeText -> String
  (stringJoin
    ["import sys as _sys, math as _math, struct as _struct, time as _time, functools as _ft"
     "_sys.setrecursionlimit(10 ** 7)"
     ""
     "class AslTrap(Exception):"
     "    def __init__(self, code, message):"
     "        super().__init__(f\"{code}: {message}\")"
     "        self.code = code"
     ""
     "def _trap(code, message):"
     "    raise AslTrap(code, message)"
     ""
     "class _Unit:"
     "    __slots__ = ()"
     "    def __repr__(self): return \"()\""
     "UNIT = _Unit()"
     ""
     "class Kw:"
     "    __slots__ = (\"name\",)"
     "    def __init__(self, name): self.name = name"
     "class Sym:"
     "    __slots__ = (\"name\",)"
     "    def __init__(self, name): self.name = name"
     "_kws, _syms = {}, {}"
     "def _kw(n): return _kws.setdefault(n, Kw(n))"
     "def _sym(n): return _syms.setdefault(n, Sym(n))"
     ""
     "class Variant:"
     "    __slots__ = (\"type\", \"name\", \"fields\")"
     "    def __init__(self, type, name, fields): self.type, self.name, self.fields = type, name, fields"
     "class Rec:"
     "    __slots__ = (\"schema\", \"keys\", \"d\")"
     "    def __init__(self, schema, keys, vals): self.schema, self.keys, self.d = schema, keys, dict(zip(keys, vals))"
     "class Cons:"
     "    __slots__ = (\"h\", \"t\")"
     "    def __init__(self, h, t): self.h, self.t = h, t"
     "class BStr:"
     "    __slots__ = (\"b\",)"
     "    def __init__(self, b): self.b = bytes(b)"
     ""
     "def _list(*xs):"
     "    l = None"
     "    for x in reversed(xs): l = Cons(x, l)"
     "    return l"
     ""
     "def _closure(f, *caps):"
     "    return _ft.partial(f, *caps) if caps else f"
     ""
     "def _call(c, *a):"
     "    if not callable(c): _trap(\"ERR_TYPE\", \"call of a value that is not a function\")"
     "    return c(*a)"
     ""
     "_MIN, _MAX = -(2 ** 63), 2 ** 63 - 1"
     "def _fit(v, op):"
     "    if v < _MIN or v > _MAX: _trap(\"ERR_INT_OVERFLOW\", f\"Int {op} leaves int64\")"
     "    return v"
     "def _isint(v): return type(v) is int"
     "def _isfloat(v): return type(v) is float"
     "def _isstr(v): return type(v) is str or type(v) is BStr"
     "def _div(a, b):"
     "    if b == 0: _trap(\"ERR_DIV_ZERO\", \"division by zero\")"
     "    return _fit(a // b, \"/\")"
     "def _mod(a, b):"
     "    if b == 0: _trap(\"ERR_DIV_ZERO\", \"division by zero\")"
     "    return a % b"
     "def _arith(op, a, b):"
     "    if _isint(a) and _isint(b):"
     "        if op == \"+\": return _fit(a + b, \"+\")"
     "        if op == \"-\": return _fit(a - b, \"-\")"
     "        if op == \"*\": return _fit(a * b, \"*\")"
     "        if op == \"/\": return _div(a, b)"
     "        return _mod(a, b)"
     "    if _isfloat(a) and _isfloat(b):"
     "        if op == \"+\": return a + b"
     "        if op == \"-\": return a - b"
     "        if op == \"*\": return a * b"
     "        if op == \"/\":"
     "            if b == 0.0: return _math.copysign(_math.inf, a) * _math.copysign(1.0, b) if a != 0.0 and a == a else _math.nan"
     "            return a / b"
     "    _trap(\"ERR_TYPE\", f\"{op} expects two Ints or two Floats\")"
     ""
     "def _bytes(s): return s.b if type(s) is BStr else s.encode(\"utf-8\")"
     "def _from(b):"
     "    try: return bytes(b).decode(\"utf-8\")"
     "    except UnicodeDecodeError: return BStr(b)"
     "def _join(parts):"
     "    if any(type(p) is BStr for p in parts): return _from(b\"\".join(_bytes(p) for p in parts))"
     "    return \"\".join(parts)"
     "def _blen(s): return len(s.b) if type(s) is BStr else (len(s) if s.isascii() else len(s.encode(\"utf-8\")))"
     "def _slice(s, i, j):"
     "    if type(s) is str and s.isascii(): return None if i < 0 or j > len(s) or i > j else s[i:j]"
     "    b = _bytes(s)"
     "    if i < 0 or j > len(b) or i > j: return None"
     "    return _from(b[i:j])"
     "def _index(s, t):"
     "    if type(s) is str and type(t) is str:"
     "        i = s.find(t)"
     "        if i < 0: return None"
     "        return i if s.isascii() else len(s[:i].encode(\"utf-8\"))"
     "    i = _bytes(s).find(_bytes(t))"
     "    return None if i < 0 else i"
     "def _contains(s, t): return t in s if type(s) is str and type(t) is str else _bytes(t) in _bytes(s)"
     "def _starts(s, t): return s.startswith(t) if type(s) is str and type(t) is str else _bytes(s).startswith(_bytes(t))"
     "def _bcmp(a, b):"
     "    if type(a) is str and type(b) is str: return -1 if a < b else (1 if a > b else 0)"
     "    x, y = _bytes(a), _bytes(b)"
     "    return -1 if x < y else (1 if x > y else 0)"
     ""
     "def _some(v): return Variant(\"Option\", \"some\", [v])"
     "_none = Variant(\"Option\", \"none\", [])"
     "def _opt(v): return _none if v is None else _some(v)"
     ""
     "def eq(a, b):"
     "    if a is b: return True"
     "    ta = type(a)"
     "    if ta is not type(b): return False"
     "    if ta is Cons:"
     "        while a is not None and b is not None:"
     "            if not eq(a.h, b.h): return False"
     "            a, b = a.t, b.t"
     "        return a is b"
     "    if ta is Variant: return a.name == b.name and len(a.fields) == len(b.fields) and all(eq(x, y) for x, y in zip(a.fields, b.fields))"
     "    if ta is Rec: return a.schema == b.schema and all(eq(a.d[k], b.d[k]) for k in a.keys)"
     "    if ta is BStr: return a.b == b.b"
     "    if ta in (int, float, bool, str, bytearray): return a == b"
     "    return False"
     ""
     "def _order(op, a, b):"
     "    if _isstr(a) and _isstr(b): c = _bcmp(a, b)"
     "    elif (_isint(a) and _isint(b)) or (_isfloat(a) and _isfloat(b)): c = -1 if a < b else (1 if a > b else 0)"
     "    else: _trap(\"ERR_TYPE\", f\"{op} expects two Ints, two Floats or two Strings\")"
     "    if op == \"<\": return c < 0 and not (_isfloat(a) and (a != a or b != b))"
     "    if op == \"<=\": return c <= 0 and not (_isfloat(a) and (a != a or b != b))"
     "    if op == \">\": return c > 0"
     "    return c >= 0 and not (_isfloat(a) and (a != a or b != b))"
     ""
     "def _text(s): return s.b.decode(\"utf-8\", \"replace\") if type(s) is BStr else s"
     "def _quote(s): return '\"' + _text(s).replace(\"\\\\\", \"\\\\\\\\\").replace('\"', '\\\\\"').replace(\"\\n\", \"\\\\n\").replace(\"\\r\", \"\\\\r\").replace(\"\\t\", \"\\\\t\") + '\"'"
     "def _floattext(x):"
     "    if x != x: return \"nan\""
     "    if x in (_math.inf, -_math.inf): return \"inf\" if x > 0 else \"-inf\""
     "    neg = x < 0 or (x == 0.0 and _math.copysign(1.0, x) < 0)"
     "    r = repr(abs(x))"
     "    if \"e\" in r:"
     "        mant, e = r.split(\"e\"); exp10 = int(e)"
     "        digits = mant.replace(\".\", \"\").rstrip(\"0\") or \"0\""
     "    else:"
     "        ip, fp = r.split(\".\")"
     "        if ip != \"0\":"
     "            digits = (ip + fp).rstrip(\"0\") or \"0\"; exp10 = len(ip) - 1"
     "        else:"
     "            stripped = fp.lstrip(\"0\")"
     "            if not stripped: digits, exp10 = \"0\", 0"
     "            else: digits = stripped.rstrip(\"0\"); exp10 = -(len(fp) - len(stripped)) - 1"
     "    o = \"-\" if neg else \"\""
     "    if -4 <= exp10 < 16:"
     "        decpt = exp10 + 1"
     "        if decpt <= 0: o += \"0.\" + \"0\" * (-decpt) + digits"
     "        elif decpt >= len(digits): o += digits + \"0\" * (decpt - len(digits)) + \".0\""
     "        else: o += digits[:decpt] + \".\" + digits[decpt:]"
     "    else:"
     "        o += digits[0] + (\".\" + digits[1:] if len(digits) > 1 else \"\") + \"e\" + (\"-\" if exp10 < 0 else \"+\") + str(abs(exp10)).rjust(2, \"0\")"
     "    return o"
     "def _parsefloat(s):"
     "    if s == \"nan\": return _math.nan"
     "    if s == \"inf\": return _math.inf"
     "    if s == \"-inf\": return -_math.inf"
     "    import re"
     "    return float(s) if re.fullmatch(r\"[+-]?(\\d+\\.?\\d*|\\.\\d+)([eE][+-]?\\d+)?\", s) else None"
     ""
     "def show(v, nested=False):"
     "    t = type(v)"
     "    if t is str or t is BStr: return _quote(v) if nested else v"
     "    if t is bool: return \"true\" if v else \"false\""
     "    if t is int: return str(v)"
     "    if t is float: return _floattext(v)"
     "    if v is None or v is UNIT: return \"()\""
     "    if t is Kw: return \":\" + v.name"
     "    if t is Sym: return v.name"
     "    if t is Cons:"
     "        out = []"
     "        while v is not None: out.append(show(v.h, True)); v = v.t"
     "        return _join([\"(\"] + _sep(out) + [\")\"])"
     "    if t is Variant: return _join([\"(\"] + _sep([v.name] + [show(f, True) for f in v.fields]) + [\")\"])"
     "    if t is Rec: return _join([\"{\"] + _sep([_join([\":\", k, \" \", show(v.d[k], True)]) for k in v.keys]) + [\"}\"])"
     "    if t is bytearray: return \"#<Bytes>\""
     "    if callable(v): return \"#<fn>\""
     "    return str(v)"
     "def _sep(xs):"
     "    out = []"
     "    for i, x in enumerate(xs):"
     "        if i: out.append(\" \")"
     "        out.append(x)"
     "    return out"
     ""
     "def _out(s): _sys.stdout.buffer.write(_bytes(s))"
     "_write = _out"
     "def set_output(f):"
     "    global _write"
     "    _write = f"
     "counts = {\"asserts\": 0, \"refutes\": 0}"
     "def _int(v, who): return v if _isint(v) else _trap(\"ERR_TYPE\", f\"{who} expects Int\")"
     "def _str(v, who): return v if _isstr(v) else _trap(\"ERR_TYPE\", f\"{who} expects String\")"
     "def _flt(v, who): return v if _isfloat(v) else _trap(\"ERR_TYPE\", f\"{who} expects Float\")"
     "def _spaced(xs): return _join(_sep([show(x) for x in xs]))"
     "def _roundhalf(x): return -_math.floor(-x + 0.5) if x < 0 else _math.floor(x + 0.5)"
     "def _f2i(x):"
     "    if x != x or x in (_math.inf, -_math.inf): return _none"
     "    t = int(x)"
     "    return _some(t) if _MIN <= t <= _MAX and -9223372036854775808.0 <= _math.trunc(x) < 9223372036854775808.0 else _none"
     "def _assert(c, m):"
     "    counts[\"asserts\"] += 1"
     "    if c is not True: _trap(\"ERR_ASSERT\", f\"assertion failed: {_text(show(m))}\")"
     "    return UNIT"
     "def _refute(c, m):"
     "    counts[\"refutes\"] += 1"
     "    if c is not False: _trap(\"ERR_REFUTE\", f\"refutation failed: {_text(show(m))}\")"
     "    return UNIT"
     "def _clamp(lo, hi, x):"
     "    _flt(lo, \"clamp\"); _flt(hi, \"clamp\"); _flt(x, \"clamp\")"
     "    if not lo <= hi: _trap(\"ERR_RANGE\", \"clamp: lo <= hi required\")"
     "    return min(hi, max(lo, x))"
     "def _bget(b, i): return b[i] if 0 <= i < len(b) else _trap(\"ERR_RANGE\", \"bytesGet index out of range\")"
     "def _bset(b, i, x):"
     "    if not 0 <= i < len(b): _trap(\"ERR_RANGE\", \"bytesSet index out of range\")"
     "    b[i] = x & 255"
     "    return UNIT"
     "def _balloc(n): return bytearray(n) if _int(n, \"bytesAlloc\") >= 0 else _trap(\"ERR_RANGE\", \"bytesAlloc of a negative size\")"
     "def _bgetf(b, i): return _struct.unpack_from(\"<d\", b, i)[0]"
     "def _bsetf(b, i, x):"
     "    _struct.pack_into(\"<d\", b, i, x)"
     "    return UNIT"
     "def _neg(a):"
     "    if _isint(a): return _fit(-a, \"-\")"
     "    if _isfloat(a): return -a"
     "    _trap(\"ERR_TYPE\", \"- expects a number\")"
     "def _abs(a): return _fit(-a if a < 0 else a, \"abs\") if _isint(a) else abs(a)"
     "def _fmath(f, who):"
     "    def g(x):"
     "        x = _flt(x, who)"
     "        try: return f(x)"
     "        except ValueError: return _math.nan"
     "        except OverflowError: return _math.inf"
     "    return g"
     "def _log(x):"
     "    x = _flt(x, \"log\")"
     "    return -_math.inf if x == 0.0 else (_math.nan if x < 0 else _math.log(x))"
     "def _eprintln(*xs):"
     "    _sys.stderr.write(\" \".join(_text(show(x)) for x in xs) + \"\\n\")"
     "    return UNIT"
     "def _print(*xs):"
     "    _write(_spaced(xs))"
     "    return UNIT"
     "def _println(*xs):"
     "    _write(_join([_spaced(xs), \"\\n\"]))"
     "    return UNIT"
     "def _getor(l, i, d):"
     "    if i < 0: return d"
     "    while l is not None:"
     "        if i == 0: return l.h"
     "        l, i = l.t, i - 1"
     "    return d"
     "def _first(l): return _trap(\"ERR_RANGE\", \"listFirst of an empty list\") if l is None else l.h"
     "def _rest(l): return _trap(\"ERR_RANGE\", \"listRest of an empty list\") if l is None else l.t"
     "def _sliceor(s, i, j, d):"
     "    r = _slice(s, i, j)"
     "    return d if r is None else r"
     "def _minus(a, b=None): return _neg(a) if b is None else _arith(\"-\", a, b)"
     "def _pow(a, b):"
     "    a, b = _flt(a, \"pow\"), _flt(b, \"pow\")"
     "    try: return _math.pow(a, b)"
     "    except ValueError: return _math.nan"
     "    except OverflowError: return _math.inf"
     ""
     "builtins = {"
     "    \"print\": _print, \"println\": _println,"
     "    \"str\": lambda *xs: _join([show(x) for x in xs]),"
     "    \"max\": lambda a, b: a if _order(\">=\", a, b) else b,"
     "    \"min\": lambda a, b: a if _order(\"<=\", a, b) else b,"
     "    \"abs\": _abs,"
     "    \"cons\": lambda h, t: Cons(h, t),"
     "    \"listEmpty?\": lambda l: l is None,"
     "    \"listHead\": lambda l: _none if l is None else _some(l.h),"
     "    \"listTail\": lambda l: _none if l is None else _some(l.t),"
     "    \"list\": _list,"
     "    \"stringConcat\": lambda a, b: _join([_str(a, \"stringConcat\"), _str(b, \"stringConcat\")]),"
     "    \"stringContains?\": lambda s, t: _contains(_str(s, \"stringContains?\"), _str(t, \"stringContains?\")),"
     "    \"stringStartsWith?\": lambda s, t: _starts(_str(s, \"stringStartsWith?\"), _str(t, \"stringStartsWith?\")),"
     "    \"stringLength\": lambda s: _blen(_str(s, \"stringLength\")),"
     "    \"stringSlice\": lambda s, i, j: _opt(_slice(_str(s, \"stringSlice\"), _int(i, \"stringSlice\"), _int(j, \"stringSlice\"))),"
     "    \"stringFromInt64\": lambda n: str(_int(n, \"stringFromInt64\")),"
     "    \"stringToBytes\": lambda s: bytearray(_bytes(_str(s, \"stringToBytes\"))),"
     "    \"bytesLength\": lambda b: len(b),"
     "    \"bytesGet\": _bget,"
     "    \"stringFromFloat64\": lambda x: _floattext(_flt(x, \"stringFromFloat64\")),"
     "    \"stringToFloat64\": lambda s: _opt(_parsefloat(_text(_str(s, \"stringToFloat64\")))),"
     "    \"int64ToFloat64\": lambda n: float(_int(n, \"int64ToFloat64\")),"
     "    \"float64ToInt64\": lambda x: _f2i(_flt(x, \"float64ToInt64\")),"
     "    \"floor\": lambda x: float(_math.floor(_flt(x, \"floor\"))) if _math.isfinite(x) else x,"
     "    \"ceil\": lambda x: float(_math.ceil(_flt(x, \"ceil\"))) if _math.isfinite(x) else x,"
     "    \"round\": lambda x: float(_roundhalf(_flt(x, \"round\"))) if _math.isfinite(x) else x,"
     "    \"sqrt\": _fmath(_math.sqrt, \"sqrt\"), \"exp\": _fmath(_math.exp, \"exp\"), \"log\": _log,"
     "    \"log2\": _fmath(lambda x: -_math.inf if x == 0.0 else _math.log2(x), \"log2\"),"
     "    \"log10\": _fmath(lambda x: -_math.inf if x == 0.0 else _math.log10(x), \"log10\"),"
     "    \"sin\": _fmath(_math.sin, \"sin\"), \"cos\": _fmath(_math.cos, \"cos\"), \"tan\": _fmath(_math.tan, \"tan\"),"
     "    \"atan2\": lambda y, x: _math.atan2(_flt(y, \"atan2\"), _flt(x, \"atan2\")),"
     "    \"pow\": _pow,"
     "    \"clamp\": _clamp,"
     "    \"partial\": lambda f, *bound: (lambda *rest: _call(f, *bound, *rest)),"
     "    \"bytesAlloc\": _balloc, \"bytesSet\": _bset, \"bytesGetFloat64\": _bgetf, \"bytesSetFloat64\": _bsetf,"
     "    \"eprintln\": _eprintln,"
     "    \"nowNs\": lambda: _time.time_ns(),"
     "    \"monotonicNs\": lambda: _time.monotonic_ns(),"
     "    \"trap\": lambda code, m: _trap(_text(show(code)), _text(show(m))),"
     "    \"assert\": _assert, \"refute\": _refute,"
     "}"
     "entries = {"
     "    \"+\": lambda a, b: _arith(\"+\", a, b), \"-\": _minus, \"*\": lambda a, b: _arith(\"*\", a, b),"
     "    \"/\": lambda a, b: _arith(\"/\", a, b), \"mod\": lambda a, b: _arith(\"mod\", a, b), \"%\": lambda a, b: _arith(\"%\", a, b),"
     "    \"=\": eq, \"!=\": lambda a, b: not eq(a, b), \"==\": eq,"
     "    \"<\": lambda a, b: _order(\"<\", a, b), \"<=\": lambda a, b: _order(\"<=\", a, b),"
     "    \">\": lambda a, b: _order(\">\", a, b), \">=\": lambda a, b: _order(\">=\", a, b),"
     "    \"@listFirst\": _first, \"@listRest\": _rest, \"@stringSliceOr\": _sliceor,"
     "    \"@stringIndexOf\": lambda s, t: _opt(_index(s, t)),"
     "    \"@listHeadOr\": lambda l, d: d if l is None else l.h,"
     "    \"@listTailOr\": lambda l, d: d if l is None else l.t,"
     "    \"@listGetOr\": _getor,"
     "    \"not\": lambda b: not b,"
     "    **builtins,"
     "}"
     "def _quot(a, b): return _trap(\"ERR_DIV_ZERO\", \"division by zero\") if b == 0 else _fit(abs(a) // abs(b) * (1 if (a < 0) == (b < 0) else -1), \"/\")"
     "def _rem(a, b): return _trap(\"ERR_DIV_ZERO\", \"division by zero\") if b == 0 else a - b * (abs(a) // abs(b) * (1 if (a < 0) == (b < 0) else -1))"
     "def _f2iprim(a): return _fit(int(a), \"floatToInt\") if _math.isfinite(a) else _trap(\"ERR_RANGE\", \"floatToInt of a non-finite Float\")"
     "prims = {"
     "    \"addIntHost\": lambda a, b: _fit(a + b, \"+\"), \"subIntHost\": lambda a, b: _fit(a - b, \"-\"), \"mulIntHost\": lambda a, b: _fit(a * b, \"*\"),"
     "    \"divIntHost\": _div, \"modIntHost\": _mod, \"negIntHost\": lambda a: _fit(-a, \"-\"),"
     "    \"addInt\": lambda a, b: _fit(a + b, \"+\"), \"subInt\": lambda a, b: _fit(a - b, \"-\"), \"mulInt\": lambda a, b: _fit(a * b, \"*\"),"
     "    \"quotInt\": _quot, \"remInt\": _rem,"
     "    \"divFloat\": lambda a, b: _arith(\"/\", a, b),"
     "    \"floatToInt\": _f2iprim,"
     "}"
     "def _unreachable(): _trap(\"ERR_UNREACHABLE\", \"control reached an unreachable block\")"
     ""
     "class asl:"
     "    list = staticmethod(_list)"
     "    @staticmethod"
     "    def to_list(l):"
     "        out = []"
     "        while l is not None: out.append(l.h); l = l.t"
     "        return out"
     "    some = staticmethod(_some)"
     "    none = _none"
     "    ok = staticmethod(lambda v: Variant(\"Result\", \"ok\", [v]))"
     "    err = staticmethod(lambda e: Variant(\"Result\", \"err\", [e]))"
     "    pair = staticmethod(lambda a, b: Variant(\"Pair\", \"pair\", [a, b]))"
     "    variant = staticmethod(lambda name, *fields: Variant(\"\", name, list(fields)))"
     "    record = staticmethod(lambda schema, fields: Rec(schema, list(fields.keys()), list(fields.values())))"
     "    unit = UNIT"
     "    show = staticmethod(lambda v: _text(show(v, True)))"
     ""
     "def _run_main(f):"
     "    import threading"
     "    result = {}"
     "    def go():"
     "        try:"
     "            r = f()"
     "            if type(r) is int: result[\"code\"] = r"
     "            elif type(r) is Variant and r.name == \"ok\": result[\"code\"] = 0"
     "            else:"
     "                _sys.stderr.write(f\"ERR_MAIN_FAILED: main returned {_text(show(r, True))}, not (ok ...)\\n\"); result[\"code\"] = 1"
     "        except AslTrap as e:"
     "            _sys.stdout.flush(); _sys.stderr.write(str(e) + \"\\n\"); result[\"code\"] = 1"
     "    threading.stack_size(512 * 1024 * 1024)"
     "    t = threading.Thread(target=go); t.start(); t.join()"
     "    _sys.stdout.flush()"
     "    _sys.exit(result.get(\"code\", 1) & 255)" ""]
    "\n")

fn builtinNames -> (List String)
  ["print" "println" "str" "max" "min" "abs" "cons" "listEmpty?" "listHead" "listTail" "list" "stringConcat" "stringContains?" "stringStartsWith?" "stringLength" "stringSlice" "stringFromInt64" "stringToBytes" "bytesLength" "bytesGet" "stringFromFloat64" "stringToFloat64" "int64ToFloat64" "float64ToInt64" "floor" "ceil" "round" "sqrt" "exp" "log" "log2" "log10" "sin" "cos" "tan" "atan2" "pow" "clamp" "partial" "bytesAlloc" "bytesSet" "bytesGetFloat64" "bytesSetFloat64" "eprintln" "nowNs" "monotonicNs" "trap" "assert" "refute"]

fn entryNames -> (List String)
  (listAppend ["+" "-" "*" "/" "mod" "%" "=" "!=" "==" "<" "<=" ">" ">=" "@listFirst" "@listRest" "@stringSliceOr" "@stringIndexOf" "@listHeadOr" "@listTailOr" "@listGetOr" "not"] (builtinNames))
