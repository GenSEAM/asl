(:grammar
  :package asl-lint
  :version "0.1.0"
  :tokensBaseline 1
  :symbols [
    (:sym :name "CloneGroup" :kind :type :tokens 1)
    (:sym :name "CloneType" :kind :type :tokens 1)
    (:sym :name "CloneVerdict" :kind :type :tokens 1)
    (:sym :name "FixResult" :kind :type :tokens 1)
    (:sym :name "FixType" :kind :type :tokens 1)
    (:sym :name "PatchAction" :kind :type :tokens 1)
    (:sym :name "QualityMetrics" :kind :type :tokens 1)
    (:sym :name "Smell" :kind :type :tokens 1)
    (:sym :name "SmellCode" :kind :type :tokens 1)
    (:sym :name "SmellSeverity" :kind :type :tokens 1)
    (:sym :name "TokenCategory" :kind :type :tokens 1)
    (:sym :name "TokenMetrics" :kind :type :tokens 1)
    (:sym :name "TokenSmell" :kind :type :tokens 1)

    (:sym :name "canAutofix" :kind :fn :tokens 2)
    (:sym :name "detectCrutches" :kind :fn :tokens 2)
    (:sym :name "IncongruityReport" :kind :type :tokens 2)
    (:sym :name "isError" :kind :fn :tokens 2)
    (:sym :name "isOrthogonal?" :kind :fn :tokens 2)
    (:sym :name "main" :kind :fn :tokens 1)
    (:sym :name "OrthogonalityVerdict" :kind :type :tokens 2)
    (:sym :name "severityPenalty" :kind :fn :tokens 2)
    (:sym :name "tokenCeiling" :kind :fn :tokens 2)

    (:sym :name "calculateQualityScore" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'quality-score': separates the multi-factor calculation function from the resulting metric value")
    (:sym :name "canAutoRepair" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'can-repair': specifies automated linter rule repair without human interaction")
    (:sym :name "checkRationalOrthogonality" :kind :fn :tokens 3
          :rationale "Scopes static linting heuristic specifically to the Doctrine of Rational Universalism and architectural orthogonality")
    (:sym :name "computeDensityScore" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'density-score': separates dynamic AST token density scoring from static threshold constants")
    (:sym :name "computeDuplicationRatio" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'duplication-ratio': separates the clone ratio computation function from the metric field")
    (:sym :name "estimateIdentifierTokens" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'estimate-tokens': scopes BPE estimation specifically to identifier symbols rather than full files")
    (:sym :name "formatFixDescription" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'format-fix': specifies formatting of human-readable explanation strings rather than code patches")
    (:sym :name "formatTokenSmell" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'format-smell': specifies diagnostic report formatting for token inflation smells specifically")
    (:sym :name "isCloneExcessive" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'is-excessive': scopes threshold check specifically to AST clone redundancy")
    (:sym :name "isFixSuccessful" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'is-successful': scopes validation to applied automated linter repairs")
    (:sym :name "isNestingExcessive" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'is-excessive': scopes depth evaluation specifically to expression indentation")
    (:sym :name "isTokenSmell" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'is-smell': scopes rule check specifically to token bloat violations in symbol names")
    (:sym :name "minCloneNodeThreshold" :kind :fn :tokens 4
          :rationale "Cannot be reduced to 'clone-threshold': distinguishes AST subtree node count threshold from clone instance frequency")
    (:sym :name "detectLingeringSigils" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'detect-sigils': targets deprecated lingering sigils specifically")
    (:sym :name "makeIncongruityReport" :kind :fn :tokens 3
          :rationale "Standard constructor function for IncongruityReport record")
    (:sym :name "scanMonorepoIncongruities" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'scan-incongruities': scopes forensic audit specifically to the monorepo boundary")
    (:sym :name "shouldBlockGate" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'block-gate': distinguishes the general error severity gate check from specialized sub-gates")
    (:sym :name "shouldBlockTokenGate" :kind :fn :tokens 4
          :rationale "Cannot be reduced to 'block-gate': isolates token-density threshold gate blocking from general error severity blocking")
  ])
