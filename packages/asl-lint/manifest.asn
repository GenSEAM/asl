(:package asl-lint
 :version "0.1.0"
 :entry "src/core/lint.asl"
 :description "AgentSlang Native Quality, Smell, and Anti-Pattern Analysis Engine"
 :aslFirst true
 :modules [
   "asl-lint/core"
   "asl-lint/anchorGuard"
   "asl-lint/incongruity"
   "asl-lint/rules"
   "asl-lint/clone"
   "asl-lint/heal"
   "asl-lint/tokens"
 ]
 :dependencies ["asl-parser"])
