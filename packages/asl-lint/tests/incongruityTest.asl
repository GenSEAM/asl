(module asl-lint/incongruityTest :x [testDetectLingeringSigils testDetectCrutches testDetectForeignFiles testTokenCompliance testMakeIncongruityReport testScanMonorepoIncongruities runTests] :i [(incongruity :a inc)])

fn testDetectLingeringSigils -> Bool
  (let [(cleanItems (list "valid-id" "norm-path" "phase-396" "c1" "d48")) (dirtyItems (list "valid-id" "@sigil-ref" "anchor" "#hashtag" "c2")) (cleanCount (inc/detectLingeringSigils cleanItems)) (dirtyCount (inc/detectLingeringSigils dirtyItems))] (assert (= cleanCount 0) "Clean list must contain 0 sigils") (assert (= dirtyCount 2) "Dirty list must detect exactly 2 lingering sigils") (assert (> dirtyCount cleanCount) "Dirty count must exceed clean count") true)

fn testDetectCrutches -> Bool
  (let [(cleanItems (list "pure implementation" "production code" "canonical standard")) (dirtyItems (list (str "TO" "DO fix this") "temporary-scaffolding" "clean line" (str "ST" "UB fallback") "mock object")) (cleanCount (inc/detectCrutches cleanItems)) (dirtyCount (inc/detectCrutches dirtyItems))] (assert (= cleanCount 0) "Clean list must contain 0 crutches") (assert (= dirtyCount 4) "Dirty list must detect exactly 4 crutches") (assert (> dirtyCount 0) "Dirty crutch count must be strictly positive") true)

fn testDetectForeignFiles -> Bool
  (let [(cleanPaths (list "asl/packages/asl-lint/src/incongruity.asl" "harness/paradigm.asn" ".asl/mem/tasks/phase_396.asn")) (dirtyPaths (list "scripts/test.py" "web/bundle.js" "asl/packages/test.rs" ".asl/mem/decisions/old.md" "asl/packages/clean.asl")) (cleanReport (inc/scanMonorepoIncongruities cleanPaths (list) (list))) (dirtyReport (inc/scanMonorepoIncongruities dirtyPaths (list) (list)))] (assert (= cleanReport.foreignViolations 0) "Clean paths must have 0 foreign violations") (assert (= dirtyReport.foreignViolations 4) "Dirty paths must detect exactly 4 foreign violations") (assert cleanReport.passed "Clean file scan must pass") (assert (not dirtyReport.passed) "Dirty file scan must fail") true)

fn testTokenCompliance -> Bool
  (let [(cleanSyms (list "c1" "d46" "norm" "v/norm" "txt/len")) (dirtySyms (list "c1" "norm" "my-extremely-long-uncompacted-identifier-name" "another-super-verbose-non-compliant-symbol-name")) (cleanReport (inc/scanMonorepoIncongruities (list) cleanSyms (list))) (dirtyReport (inc/scanMonorepoIncongruities (list) dirtySyms (list)))] (assert (= cleanReport.tokenViolations 0) "Clean symbols must have 0 token violations") (assert (= dirtyReport.tokenViolations 2) "Dirty symbols must detect 2 token violations") (assert cleanReport.passed "Clean symbol scan must pass") (assert (not dirtyReport.passed) "Dirty symbol scan must fail") true)

fn testMakeIncongruityReport -> Bool
  (let [(clean (inc/makeIncongruityReport 50 0 0 0 0 0)) (dirtySigil (inc/makeIncongruityReport 50 1 0 0 0 0)) (dirtyForeign (inc/makeIncongruityReport 50 0 1 0 0 0)) (dirtyTokens (inc/makeIncongruityReport 50 0 0 1 0 0)) (dirtyCrutch (inc/makeIncongruityReport 50 0 0 0 1 0)) (dirtyDead (inc/makeIncongruityReport 50 0 0 0 0 1))] (assert clean.passed "Report with zero violations must pass") (assert (= clean.totalScanned 50) "Total scanned must match") (assert (not dirtySigil.passed) "Report with sigil violation must fail") (assert (not dirtyForeign.passed) "Report with foreign violation must fail") (assert (not dirtyTokens.passed) "Report with token violation must fail") (assert (not dirtyCrutch.passed) "Report with crutch violation must fail") (assert (not dirtyDead.passed) "Report with dead code violation must fail") (assert (= dirtyDead.deadCodeViolations 1) "Report must record 1 dead code violation") true)

fn testScanMonorepoIncongruities -> Bool
  (let [(cleanPaths (list "asl/packages/asl-lint/src/incongruity.asl" "harness/paradigm.asn")) (cleanSyms (list "c1" "d46" "v/norm" "txt/len")) (cleanSnippets (list "clean code without scaffolding" "verified physical truth")) (cleanRep (inc/scanMonorepoIncongruities cleanPaths cleanSyms cleanSnippets)) (dirtyPaths (list "tmp.py" ".asl/mem/notes.md")) (dirtySyms (list "@sigil-one" "#tag-two" "excessive-length-uncompacted-identifier-symbol")) (dirtySnippets (list (str "TO" "DO remove later") (str "HA" "CK work-around"))) (dirtyRep (inc/scanMonorepoIncongruities dirtyPaths dirtySyms dirtySnippets))] (assert cleanRep.passed "Clean composite scan must pass") (assert (= cleanRep.totalScanned 8) "Clean composite scanned count must be 8") (assert (= cleanRep.sigilViolations 0) "Clean sigil violations must be 0") (assert (= cleanRep.foreignViolations 0) "Clean foreign violations must be 0") (assert (= cleanRep.tokenViolations 0) "Clean token violations must be 0") (assert (= cleanRep.crutchViolations 0) "Clean crutch violations must be 0") (assert (= cleanRep.deadCodeViolations 0) "Clean dead code violations must be 0") (assert (not dirtyRep.passed) "Dirty composite scan must fail") (assert (= dirtyRep.foreignViolations 2) "Dirty foreign violations must be 2") (assert (= dirtyRep.sigilViolations 2) "Dirty sigil violations must be 2") (assert (= dirtyRep.tokenViolations 1) "Dirty token violations must be 1") (assert (= dirtyRep.crutchViolations 2) "Dirty crutch violations must be 2") true)

fn runTests -> Bool
  (do (assert (testDetectLingeringSigils) "test-detect-lingering-sigils must pass") (assert (testDetectCrutches) "test-detect-crutches must pass") (assert (testDetectForeignFiles) "test-detect-foreign-files must pass") (assert (testTokenCompliance) "test-token-compliance must pass") (assert (testMakeIncongruityReport) "test-make-incongruity-report must pass") (assert (testScanMonorepoIncongruities) "test-scan-monorepo-incongruities must pass") true)
