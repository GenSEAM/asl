(module asl-json/tests/jsonTest
  :x [runTests]
  :i [(asl-json/json :a j)])

fn shQuote s: String -> String
  (str "'" (stringReplace s "'" "'\\''") "'")

fn runPythonJson! input: String -> String
  (let [(cmd (str "python3 -c \"import json, sys; print(json.dumps(json.loads(sys.argv[1]), separators=(',', ':'), ensure_ascii=False), end='')\" " (shQuote input)))
        (res (processRun cmd))]
    (if (= res.exitCode 0)
      res.stdout
      (str "PY_ERROR: " res.stderr)))

fn checkAccept input: String msg: String -> Bool
  (ok? (j/jsonParse input))

fn checkRejectWith input: String expectedSubstr: String -> Bool
  (mt (j/jsonParse input)
    ((ok _) false)
    ((err msg)
     (and (stringContains? msg "at byte ")
          (stringContains? msg expectedSubstr))))

fn checkReject input: String msg: String -> Bool
  (mt (j/jsonParse input)
    ((ok _) false)
    ((err msg) (stringContains? msg "at byte ")))

fn checkParity! input: String -> Bool
  (mt (j/jsonParse input)
    ((ok parsed)
     (let [(aslEmit (j/jsonEmit parsed))
           (pyEmit (runPythonJson! input))]
       (= aslEmit pyEmit)))
    ((err _) false))

fn testAcceptCases -> Bool
  (do
    (assert (checkAccept "null" "literal null") "accept null")
    (assert (checkAccept "true" "literal true") "accept true")
    (assert (checkAccept "false" "literal false") "accept false")
    (assert (checkAccept "0" "zero") "accept 0")
    (assert (checkAccept "-0" "minus zero") "accept -0")
    (assert (checkAccept "42" "int 42") "accept 42")
    (assert (checkAccept "-42" "negative int") "accept -42")
    (assert (checkAccept "123456789" "large int") "accept large int")
    (assert (checkAccept "9223372036854775807" "i64 max") "accept i64 max")
    (assert (checkAccept "-9223372036854775807" "i64 min approx") "accept i64 min")
    (assert (checkAccept "0.0" "float 0.0") "accept 0.0")
    (assert (checkAccept "-0.0" "float -0.0") "accept -0.0")
    (assert (checkAccept "0.5" "float 0.5") "accept 0.5")
    (assert (checkAccept "-0.5" "float -0.5") "accept -0.5")
    (assert (checkAccept "12.34" "float 12.34") "accept 12.34")
    (assert (checkAccept "-12.34" "float -12.34") "accept -12.34")
    (assert (checkAccept "1e5" "exp 1e5") "accept 1e5")
    (assert (checkAccept "1e-5" "exp 1e-5") "accept 1e-5")
    (assert (checkAccept "1e+5" "exp 1e+5") "accept 1e+5")
    (assert (checkAccept "1.5e2" "float exp 1.5e2") "accept 1.5e2")
    (assert (checkAccept "1.5E-2" "float exp 1.5E-2") "accept 1.5E-2")
    (assert (checkAccept "0e0" "exp 0e0") "accept 0e0")
    (assert (checkAccept "\"\"" "empty string") "accept empty string")
    (assert (checkAccept "\"hello\"" "simple string") "accept hello")
    (assert (checkAccept "\"hello world\"" "string with spaces") "accept string spaces")
    (assert (checkAccept "\"\\\"\"" "escaped quote") "accept escaped quote")
    (assert (checkAccept "\"\\\\\"" "escaped backslash") "accept escaped backslash")
    (assert (checkAccept "\"\\/\"" "escaped slash") "accept escaped slash")
    (assert (checkAccept "\"\\b\"" "escaped backspace") "accept escaped b")
    (assert (checkAccept "\"\\f\"" "escaped formfeed") "accept escaped f")
    (assert (checkAccept "\"\\n\"" "escaped newline") "accept escaped n")
    (assert (checkAccept "\"\\r\"" "escaped carriage return") "accept escaped r")
    (assert (checkAccept "\"\\t\"" "escaped tab") "accept escaped t")
    (assert (checkAccept "\"\\u0041\"" "escaped unicode A") "accept u0041")
    (assert (checkAccept "\"\\u00e9\"" "escaped unicode e acute") "accept u00e9")
    (assert (checkAccept "\"\\u20ac\"" "escaped unicode euro") "accept u20ac")
    (assert (checkAccept "\"\\uD83D\\uDE00\"" "surrogate pair grinning") "accept surrogate pair emoji")
    (assert (checkAccept "\"\\uD834\\uDD1E\"" "surrogate pair g clef") "accept surrogate pair clef")
    (assert (checkAccept "\"UTF-8 literal: 你好世界\"" "utf8 literal Chinese") "accept utf8 literal")
    (assert (checkAccept "\"\\u0000\"" "escaped null byte") "accept u0000")
    (assert (checkAccept "[]" "empty array") "accept empty array")
    (assert (checkAccept "[1]" "single elem array") "accept single elem array")
    (assert (checkAccept "[1, 2, 3]" "int array") "accept int array")
    (assert (checkAccept "[true, false, null, \"foo\", 42, 3.14]" "mixed array") "accept mixed array")
    (assert (checkAccept "[[1, 2], [3, [4, 5]]]" "nested arrays") "accept nested arrays")
    (assert (checkAccept "[   1   ,   2   ,   3   ]" "array whitespace") "accept array whitespace")
    (assert (checkAccept "{}" "empty object") "accept empty object")
    (assert (checkAccept "{\"key\": \"value\"}" "single pair object") "accept single pair")
    (assert (checkAccept "{\"a\": 1, \"b\": 2, \"c\": 3}" "multi pair object") "accept multi pair")
    (assert (checkAccept "{\"nested\": {\"inner\": true}}" "nested object") "accept nested object")
    (assert (checkAccept "{\"arr\": [1, 2], \"obj\": {\"k\": null}}" "compound object") "accept compound")
    (assert (checkAccept "  {  \"a\"  :  1  ,  \"b\"  :  2  }  " "object whitespace") "accept object whitespace")
    (assert (checkAccept "\n\t  {\"spec\": \"RFC8259\"}  \r\n" "surrounding whitespace") "accept surrounding whitespace")
    true)

fn testRejectCases -> Bool
  (do
    (assert (checkRejectWith "" "empty JSON input") "reject empty")
    (assert (checkReject "   " "whitespace only") "reject whitespace only")
    (assert (checkRejectWith "01" "leading zero") "reject 01")
    (assert (checkRejectWith "-01" "leading zero") "reject -01")
    (assert (checkReject "+1" "leading plus") "reject +1")
    (assert (checkRejectWith "1." "expected digit after '.'") "reject 1.")
    (assert (checkReject ".5" "leading dot") "reject .5")
    (assert (checkRejectWith "1e" "expected digit in exponent") "reject 1e")
    (assert (checkReject "1e+" "missing exp digits after sign") "reject 1e+")
    (assert (checkReject "--1" "double minus") "reject --1")
    (assert (checkRejectWith "[1,]" "trailing comma in array") "reject [1,]")
    (assert (checkReject "[1, , 2]" "double comma array") "reject [1,,2]")
    (assert (checkReject "[,]" "lone comma array") "reject [, ]")
    (assert (checkRejectWith "{\"a\": 1,}" "trailing comma in object") "reject trailing comma object")
    (assert (checkReject "{\"a\": 1,, \"b\": 2}" "double comma object") "reject double comma object")
    (assert (checkReject "{a: 1}" "unquoted key") "reject unquoted key")
    (assert (checkReject "{'a': 1}" "single-quoted key") "reject single-quoted key")
    (assert (checkReject "'hello'" "single-quoted string") "reject single-quoted string")
    (assert (checkReject "\"unterminated" "unterminated string") "reject unterminated string")
    (assert (checkRejectWith "\"\n\"" "unescaped control character") "reject unescaped newline")
    (assert (checkRejectWith "\"\x00\"" "unescaped control character") "reject unescaped null byte")
    (assert (checkRejectWith "\"\t\"" "unescaped control character") "reject unescaped tab")
    (assert (checkRejectWith "\"\\uD83D\"" "lone high surrogate") "reject lone high surrogate end")
    (assert (checkRejectWith "\"\\uD83D abc\"" "lone high surrogate") "reject lone high surrogate ascii")
    (assert (checkRejectWith "\"\\uDE00\"" "lone low surrogate") "reject lone low surrogate")
    (assert (checkReject "\"\\uD83D\\u1234\"" "high surrogate followed by non-low surrogate") "reject surrogate followed by non-low")
    (assert (checkReject "\"\\u12G4\"" "invalid hex in unicode escape") "reject invalid hex in u")
    (assert (checkReject "\"\\z\"" "invalid escape character") "reject invalid escape z")
    (assert (checkReject "[1, 2" "unclosed array") "reject unclosed array")
    (assert (checkReject "{\"a\": 1" "unclosed object") "reject unclosed object")
    (assert (checkReject "{\"a\" 1}" "missing colon") "reject missing colon")
    (assert (checkRejectWith "123 abc" "trailing garbage") "reject trailing garbage number")
    (assert (checkRejectWith "{} []" "trailing garbage") "reject trailing garbage object")
    (assert (checkRejectWith "true false" "trailing garbage") "reject trailing garbage bool")
    (assert (checkRejectWith (str (stringRepeat "[" 513) (stringRepeat "]" 513)) "nesting depth limit 512 exceeded") "reject depth 513")
    true)

fn testParityCases! -> Bool
  (do
    (assert (checkParity! "null") "parity null")
    (assert (checkParity! "true") "parity true")
    (assert (checkParity! "false") "parity false")
    (assert (checkParity! "0") "parity 0")
    (assert (checkParity! "-42") "parity -42")
    (assert (checkParity! "123456789") "parity 123456789")
    (assert (checkParity! "3.14159") "parity 3.14159")
    (assert (checkParity! "-0.5") "parity -0.5")
    (assert (checkParity! "1.25e-4") "parity 1.25e-4")
    (assert (checkParity! "\"hello world\"") "parity hello world")
    (assert (checkParity! "\"quotes: \\\"hello\\\", slash: \\\\, tab: \\t, newline: \\n\"") "parity escapes")
    (assert (checkParity! "\"unicode: \\u00e9, emoji: \\uD83D\\uDE00\"") "parity unicode")
    (assert (checkParity! "\"control: \\u0000 \\u001f\"") "parity control chars")
    (assert (checkParity! "[]") "parity empty array")
    (assert (checkParity! "[1,2,3]") "parity int array")
    (assert (checkParity! "{}") "parity empty object")
    (assert (checkParity! "{\"key\":\"value\"}") "parity simple object")
    (assert (checkParity! "[true,null,42,\"text\",{\"nested\":[1.5,false]}]") "parity compound array")
    (assert (checkParity! "{\"a\":[1,2],\"b\":{\"c\":3,\"d\":\"str\"}}") "parity compound object")
    (assert (checkParity! "   {\"whitespace\"  :  [ 1 ,  \"a\"  ,  true ]  }   ") "parity whitespace")
    true)

fn testApiAndInspection -> Bool
  (let [(parsed (j/jsonParse "{\"name\": \"Alice\", \"age\": 30, \"active\": true, \"scores\": [95, 87], \"extra\": null}"))]
    (mt parsed
      ((err e) (assert false (str "API test parse failed: " e)))
      ((ok obj)
       (do
         (mt (j/jsonGet obj "name")
           ((some v) (mt v ((j/jstr s) (assert (= s "Alice") "name Alice")) (_ (assert false "expected jstr"))))
           ((none) (assert false "name not found")))
         (mt (j/jsonGet obj "age")
           ((some v) (mt v ((j/jint i) (assert (= i 30) "age 30")) (_ (assert false "expected jint"))))
           ((none) (assert false "age not found")))
         (mt (j/jsonGet obj "active")
           ((some v) (mt v ((j/jbool b) (assert b "active true")) (_ (assert false "expected jbool"))))
           ((none) (assert false "active not found")))
         (mt (j/jsonGet obj "scores")
           ((some v) (mt v ((j/jarr xs) (assert (= (listLength xs) 2) "scores len 2")) (_ (assert false "expected jarr"))))
           ((none) (assert false "scores not found")))
         (mt (j/jsonGet obj "extra")
           ((some v) (mt v ((j/jnull) (assert (= (j/jsonEmit v) "null") "extra is null")) (_ (assert false "expected jnull"))))
           ((none) (assert false "extra not found")))
         (assert (none? (j/jsonGet obj "missing")) "missing is none")
         (assert (none? (j/jsonGet (j/jint 42) "k")) "non-object get is none")
         true))))

fn ! runTests -> Bool
  (do
    (assert (testAcceptCases) "accept cases")
    (assert (testRejectCases) "reject cases")
    (assert (testParityCases!) "parity cases")
    (assert (testApiAndInspection) "api and inspection")
    true)
