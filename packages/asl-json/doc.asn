(:doc :symbol "asl/packages/asl-json/src/pointer.asl#" :text "RFC 6901 JSON Pointer get and set over asl-json Json values")
(:doc :symbol "asl/packages/asl-json/src/pointer.asl#jsonPointerGet" :text "Returns the Json value at an RFC 6901 pointer, or none when the pointer is malformed or the path does not exist")
(:doc :symbol "asl/packages/asl-json/src/pointer.asl#jsonPointerSet" :text "Returns a copy of the document with the value at the pointer replaced, adding a new object key when allowed, or an error for a malformed pointer, out-of-range index, or missing intermediate key")
