(module asl-transpile/tests/enhancedEmittersAcceptanceTest :x [testEnhancedEmittersDynamicExecution! testEnhancedEmittersInvariants testEnhancedEmittersDualPolarityRefutations runTests] :i [(asl-transpile/transpile :a tr) (asl-transpile/yamlTranspile :a yt) (asl-transpile/tomlTranspile :a tt) (asl-tools/fleet/run :a run)])

fn testEnhancedEmittersDynamicExecution! -> Bool
  (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-transpile/tests/enhancedEmittersTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit) (stdout res.out)] (assert (= code 0) (str "enhancedEmittersTest must exit 0, stderr: " "")) (refute (!= code 0) "enhancedEmittersTest must not fail") (assert (stringContains? stdout "assertion(s) executed") "enhancedEmittersTest must report executed assertions") (assert (stringContains? stdout "refutation(s) executed") "enhancedEmittersTest must report executed refutations") (refute (stringContains? stdout "ASL_ASSERTION_FAILURE") "enhancedEmittersTest must not fail assertions") true)

fn testEnhancedEmittersInvariants -> Bool
  (let [(htmlDoc (tr/renderHtml5Document "App" "en" "body { margin: 0; }" "<div id=\"root\">App</div>" false))] (assert (stringStartsWith? htmlDoc "<!DOCTYPE html>") "HTML5 doc must start with <!DOCTYPE html>") (assert (stringContains? htmlDoc "<html lang=\"en\">") "HTML5 doc must include html tag with lang") (assert (stringContains? htmlDoc "<head>") "HTML5 doc must contain head tag") (assert (stringContains? htmlDoc "<style>\nbody { margin: 0; }\n  </style>") "HTML5 doc must embed style tag") (assert (stringContains? htmlDoc "<body>\n  <div id=\"root\">App</div>\n</body>") "HTML5 doc must wrap body content") (assert (stringEndsWith? (stringTrim htmlDoc) "</html>") "HTML5 doc must end with </html>") (let [(yamlStream (yt/asnToYamlStream "(:service \"api\" :port 3000) (:service \"web\" :port 80)"))] (assert yamlStream.success "YAML stream must succeed") (assert (stringContains? yamlStream.output "---") "YAML stream must contain document separator ---") (assert (stringContains? yamlStream.output "service: api") "YAML stream contains first service") (assert (stringContains? yamlStream.output "service: web") "YAML stream contains second service") (let [(tomlDoc (tt/asnToTomlDocument "(:title \"Service\" :database (:primary (:host \"db.internal\" :port 5432)))"))] (assert tomlDoc.success "TOML document must succeed") (let [(out tomlDoc.output)] (assert (stringContains? out "title = \"Service\"") "TOML doc contains top-level title") (assert (stringContains? out "[database.primary]") "TOML doc contains dotted table header [database.primary]") (assert (stringContains? out "host = \"db.internal\"") "TOML doc contains host assignment") true))))

fn testEnhancedEmittersDualPolarityRefutations -> Bool
  (let [(doc (tr/renderHtml5Document "Title" "en" "" "<main>Content</main>" false)) (multiline "line one\nline two") (scalar (yt/formatYamlBlockScalar multiline 2 false)) (rEmptyYaml (yt/asnToYamlStream "")) (rEmptyToml (tt/asnToTomlDocument ""))] (refute (not (stringContains? doc "</html>")) "renderHtml5Document must not omit closing </html>") (refute (not (stringContains? doc "</body>")) "renderHtml5Document must not omit closing </body>") (refute (stringContains? doc "<style>") "renderHtml5Document must omit style tag when css is empty") (refute (not (stringContains? scalar "line one\n    line two")) "formatYamlBlockScalar must preserve newlines without corruption") (refute rEmptyYaml.success "empty yaml stream must not report success") (refute rEmptyToml.success "empty toml document must not report success") true)

fn ! runTests -> Bool
  (do (assert (testEnhancedEmittersDynamicExecution!) "testEnhancedEmittersDynamicExecution must pass") (assert (testEnhancedEmittersInvariants) "testEnhancedEmittersInvariants must pass") (assert (testEnhancedEmittersDualPolarityRefutations) "testEnhancedEmittersDualPolarityRefutations must pass") true)
