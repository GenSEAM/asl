(module asl-transpile/tests/cssEmitAcceptanceTest :x [testCssEmitDynamicExecution! testCssEmitInvariants testCssEmitDualPolarityRefutations runTests] :i [(asl-transpile/cssEmit :a ce) (asl-transpile/cssCascade :a cascade) (asl-tools/fleet/run :a run)])

fn testCssEmitDynamicExecution! -> Bool
  (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-transpile/tests/cssEmitTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit) (stdout res.out)] (assert (= code 0) (str "cssEmitTest must exit 0, stderr: " "")) (refute (!= code 0) "cssEmitTest must not fail") (assert (stringContains? stdout "assertion(s) executed") "cssEmitTest must report executed assertions") (assert (stringContains? stdout "refutation(s) executed") "cssEmitTest must report executed refutations") (refute (stringContains? stdout "ASL_ASSERTION_FAILURE") "cssEmitTest must not fail assertions") true)

fn testCssEmitInvariants -> Bool
  (let [(vars (list (pair "theme" "dark") (pair "--accent" "#ff5722"))) (varText (ce/renderCssVariables vars false)) (varMin (ce/renderCssVariables vars true))] (assert (stringContains? varText ":root {") "pretty vars has root block") (assert (stringContains? varText "--theme: dark;") "bare var prefixed with --") (assert (= varMin ":root{--theme:dark;--accent:#ff5722}") "minified vars compact") (let [(p1 (cascade/CssProperty :name "font-size" :value "16px" :important false)) (p2 (cascade/CssProperty :name "color" :value "#222" :important true)) (rule (cascade/CssRule :selector "h2.subtitle" :specificity (cascade/calcSpecificity "h2.subtitle") :properties (list p1 p2) :sourceOrder 0)) (ruleText (ce/renderCssRule rule false)) (ruleMin (ce/renderCssRule rule true))] (assert (stringContains? ruleText "h2.subtitle {") "rule selector formatted") (assert (stringContains? ruleText "color: #222 !important;") "important property formatted") (assert (= ruleMin "h2.subtitle{font-size:16px;color:#222!important}") "rule minified compact") (let [(parsed (cascade/parseCssRules (str varText "\n\n" ruleText)))] (assert (> (listLength parsed) 0) "roundtrip parsed rules non-empty") (let [(h2Matched (filter (fn [(r cascade/CssRule)] -> Bool (= r.selector "h2.subtitle")) parsed))] (assert (= (listLength h2Matched) 1) "h2 rule found in roundtrip") (let [(r (optionOr (listHead h2Matched) rule))] (assert (= (listLength r.properties) 2) "properties count preserved across roundtrip") true)))))

fn testCssEmitDualPolarityRefutations -> Bool
  (let [(vars (list (pair "bg" "#000"))) (rendered (ce/renderCssVariables vars true)) (emptyRuleset (ce/asnToCssStr "(:styles :rules [])" true)) (emptyRule (ce/renderCssRule (cascade/CssRule :selector "section" :specificity (cascade/calcSpecificity "section") :properties (list) :sourceOrder 0) false))] (refute (stringContains? rendered "{bg:") "rendered variable must never omit -- prefix") (assert (stringContains? rendered "{--bg:") "rendered variable must include -- prefix") (refute (stringContains? rendered " ") "minified variables must contain no whitespace") (assert (= emptyRuleset "") "empty ruleset must emit empty string") (refute (!= emptyRuleset "") "empty ruleset must not emit non-empty string") (assert (= emptyRule "section {}") "empty rule must emit selector with braces") (refute (stringContains? emptyRule "null") "empty rule must not contain null") true)

fn ! runTests -> Bool
  (do (assert (testCssEmitDynamicExecution!) "testCssEmitDynamicExecution must pass") (assert (testCssEmitInvariants) "testCssEmitInvariants must pass") (assert (testCssEmitDualPolarityRefutations) "testCssEmitDualPolarityRefutations must pass") true)
