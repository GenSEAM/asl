(module asl-transpile/tests/multilensIntegrationAcceptanceTest :x [testMultilensIntegrationDynamicExecution testMultilensE2EInvariants testMultilensE2EDualPolarityRefutations runTests] :i [(asl-transpile/multilens :a ml) (asl-transpile/cssCascade :a cascade) (asl-transpile/transpile :a tr) (asl-transpile/yamlTranspile :a yt) (asl-transpile/tomlTranspile :a tt) (asl-tools/fleet/run :a run)])

fn ! testMultilensIntegrationDynamicExecution -> Bool
  (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-transpile/tests/multilensIntegrationTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit) (stdout res.out)] (assert (= code 0) (str "multilensIntegrationTest must exit 0, stderr: " "")) (refute (!= code 0) "multilensIntegrationTest must not fail") (assert (stringContains? stdout "assertion(s) executed") "multilensIntegrationTest must report executed assertions") (assert (stringContains? stdout "refutation(s) executed") "multilensIntegrationTest must report executed refutations") (refute (stringContains? stdout "ASL_ASSERTION_FAILURE") "multilensIntegrationTest must not fail assertions") true)

fn testMultilensE2EInvariants -> Bool
  (let [(docSexpr "(:doc :meta (:title \"Service Portal\" :version \"1.0.0\" :lang \"en\") :styles (:vars [(:primary \"#10b981\")] :rules [(:rule :selector \".portal\" :props [(:margin \"0\")])]) :content (section (:class \"portal\") (h1 \"Active\")) :data (:users [(:id \"u1\")]) :config (:host \"127.0.0.1\" :port 4000))") (model (ml/parseUnifiedModel docSexpr)) (opts (ml/defaultLensOptions)) (bundle (ml/emitMultilensBundle model (list "html" "css" "yaml" "json" "toml") opts))] (assert bundle.success "E2E bundle succeeds") (assert (stringStartsWith? bundle.html "<!DOCTYPE html>") "HTML starts with DOCTYPE") (assert (stringContains? bundle.html "<section class=\"portal\">") "HTML contains section markup") (let [(cssRules (cascade/parseCssRules bundle.css))] (assert (> (listLength cssRules) 0) "emitted CSS parses back into rules") (let [(yamlAsn (yt/yamlToAsn bundle.yaml))] (assert yamlAsn.success "emitted YAML parses back to ASN") (let [(jsonAsn (tr/jsonToAsn bundle.json))] (assert jsonAsn.success "emitted JSON parses back to ASN") (let [(tomlAsn (tt/tomlToAsn bundle.toml))] (assert tomlAsn.success "emitted TOML parses back to ASN") true)))))

fn ! testMultilensE2EDualPolarityRefutations -> Bool
  (let [(taskRes (run/runOneLimited (run/job (list "cat" ".asl/mem/tasks/Phase508MultilensEmitters.asn") "." (run/childEnv (list))) (run/limits 180 8))) (taskContent taskRes.out) (model (ml/parseUnifiedModel "(:doc :meta () :styles () :content () :data () :config ())")) (opts (ml/defaultLensOptions)) (rUnknown (ml/projectLens "invalidFormat" model opts))] (assert (= taskRes.exit 0) "task file must exist and read cleanly") (assert (stringContains? taskContent ":id \"Task50801\"") "Task50801 present in task memory") (assert (stringContains? taskContent ":id \"Task50802\"") "Task50802 present in task memory") (assert (stringContains? taskContent ":id \"Task50803\"") "Task50803 present in task memory") (assert (stringContains? taskContent ":id \"Task50804\"") "Task50804 present in task memory") (assert (stringContains? taskContent ":id \"Task50805\"") "Task50805 present in task memory") (assert (stringContains? taskContent ":id \"Task50806\"") "Task50806 present in task memory") (refute (stringContains? taskContent ":id \"Task50807\"") "Task50807 must not exist") (refute rUnknown.success "dynamic projection must refute success for unknown lens") (refute (!= rUnknown.output "") "dynamic projection must not produce output for unknown lens") true)

fn ! runTests -> Bool
  (do (assert (testMultilensIntegrationDynamicExecution) "testMultilensIntegrationDynamicExecution must pass") (assert (testMultilensE2EInvariants) "testMultilensE2EInvariants must pass") (assert (testMultilensE2EDualPolarityRefutations) "testMultilensE2EDualPolarityRefutations must pass") true)
