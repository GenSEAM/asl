(module asl-transpile/multilensIntegrationTest :x [testDynamicMultilensExecution testMultilensRoundtripFidelity testMultilensRefutations testTaskRegistrationFile! runTests] :i [(asl-transpile/multilens :a ml) (asl-transpile/cssCascade :a cascade) (asl-transpile/transpile :a tr) (asl-transpile/yamlTranspile :a yt) (asl-transpile/tomlTranspile :a tt)])

fn productionModelSexpr -> Str
  (str "(:doc " ":meta (:title \"Agent Telemetry Service\" :version \"1.0.0\" :author \"Agent\" :lang \"en\") " ":styles (:vars [(:primary \"#2563eb\") (:bg \"#f8fafc\")] " "         :rules [(:rule :selector \".service-card\" :props [(:padding \"16px\") (:border-radius \"8px\")])]) " ":content (div (:class \"service-card\") (h1 \"Telemetry Overview\") (p \"Status: Online\")) " ":data (:endpoints [(:path \"/health\" :status 200) (:path \"/metrics\" :status 200)]) " ":config (:port 9090 :host \"0.0.0.0\" :ssl (:enabled false :certPath \"/certs\")))")

fn testDynamicMultilensExecution -> Bool
  (let [(model (ml/parseUnifiedModel (productionModelSexpr))) (opts (ml/defaultLensOptions)) (bundle (ml/emitMultilensBundle model (list "html" "css" "yaml" "json" "toml") opts))] (assert bundle.success "bundle projection succeeds") (assert (stringStartsWith? bundle.html "<!DOCTYPE html>") "HTML starts with DOCTYPE") (assert (stringContains? bundle.html "<style>") "HTML embeds stylesheet") (assert (stringContains? bundle.html "<div class=\"service-card\">") "HTML contains card markup") (assert (stringContains? bundle.css ":root {") "CSS contains :root custom properties") (assert (stringContains? bundle.css "--primary: #2563eb;") "CSS contains primary token") (assert (stringContains? bundle.css ".service-card {") "CSS contains service-card selector") (assert (stringContains? bundle.yaml "port: 9090") "YAML contains port configuration") (assert (stringContains? bundle.yaml "host: 0.0.0.0") "YAML contains host configuration") (assert (stringContains? bundle.json "\"endpoints\"") "JSON contains endpoints data key") (assert (stringContains? bundle.json "\"/health\"") "JSON contains /health path") (assert (stringContains? bundle.toml "port = 9090") "TOML contains port assignment") (assert (stringContains? bundle.toml "[ssl]") "TOML contains ssl table") true)

fn testMultilensRoundtripFidelity -> Bool
  (let [(model (ml/parseUnifiedModel (productionModelSexpr))) (opts (ml/defaultLensOptions)) (bundle (ml/emitMultilensBundle model (list "html" "css" "yaml" "json" "toml") opts)) (cssParsed (cascade/parseCssRules bundle.css)) (yamlParsed (yt/yamlToAsn bundle.yaml)) (jsonParsed (tr/jsonToAsn bundle.json)) (tomlParsed (tt/tomlToAsn bundle.toml))] (assert (> (listLength cssParsed) 0) "CSS roundtrip produces parsed rules") (let [(cardRule (filter (fn [(r cascade/CssRule)] -> Bool (= r.selector ".service-card")) cssParsed))] (assert (= (listLength cardRule) 1) "CSS parsed contains .service-card rule") (let [(r (optionOr (listHead cardRule) (cascade/CssRule :selector "" :specificity (cascade/calcSpecificity "") :properties (list) :sourceOrder 0)))] (assert (= (listLength r.properties) 2) "card rule has 2 properties") true)) (assert yamlParsed.success "YAML parses back into ASN cleanly") (assert (stringContains? yamlParsed.output ":port 9090") "YAML ASN preserves port") (assert jsonParsed.success "JSON parses back into ASN cleanly") (assert (stringContains? jsonParsed.output ":endpoints") "JSON ASN preserves endpoints key") (assert tomlParsed.success "TOML parses back into ASN cleanly") (assert (stringContains? tomlParsed.output ":port 9090") "TOML ASN preserves port") true)

fn testMultilensRefutations -> Bool
  (let [(model (ml/parseUnifiedModel (productionModelSexpr))) (opts (ml/defaultLensOptions)) (rBad (ml/projectLens "bogus" model opts))] (refute rBad.success "unknown lens must refute success") (refute (!= rBad.output "") "unknown lens must not emit content") (assert (stringContains? rBad.errorMsg "Unsupported lens") "errorMsg identifies unsupported lens") true)

fn testTaskRegistrationFile! -> Bool
  (let [(res (processRun "test -f .asl/mem/tasks/Phase508MultilensEmitters.asn")) (code res.exitCode)] (assert (= code 0) "Phase508MultilensEmitters.asn must exist on disk") (refute (!= code 0) "Phase508MultilensEmitters.asn existence check must not fail") true)

fn ! runTests -> Bool
  (do (assert (testDynamicMultilensExecution) "testDynamicMultilensExecution") (assert (testMultilensRoundtripFidelity) "testMultilensRoundtripFidelity") (assert (testMultilensRefutations) "testMultilensRefutations") (assert (testTaskRegistrationFile!) "testTaskRegistrationFile") true)
