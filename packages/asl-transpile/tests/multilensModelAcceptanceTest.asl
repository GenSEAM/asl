(module asl-transpile/tests/multilensModelAcceptanceTest :x [testMultilensModelDynamicExecution! testMultilensModelInvariants testMultilensDualPolarityRefutations runTests] :i [(asl-transpile/multilens :a ml) (asl-parser/reader :a rd) (asl-tools/fleet/run :a run)])

fn testMultilensModelDynamicExecution! -> Bool
  (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-transpile/tests/multilensModelTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit) (stdout res.out)] (assert (= code 0) (str "multilensModelTest must exit 0, stderr: " "")) (refute (!= code 0) "multilensModelTest must not fail") (assert (stringContains? stdout "assertion(s) executed") "multilensModelTest must report executed assertions") (assert (stringContains? stdout "refutation(s) executed") "multilensModelTest must report executed refutations") (refute (stringContains? stdout "ASL_ASSERTION_FAILURE") "multilensModelTest must not fail assertions") true)

fn testMultilensModelInvariants -> Bool
  (let [(payload "(:doc :meta (:title \"AcceptanceDoc\" :version \"1.0.0\") :styles (:vars ((--primary \"#007acc\"))) :content (main (h1 \"Acceptance\")) :data (:records [(:id 101)]) :config (:debug true))") (model (ml/parseUnifiedModel payload)) (meta (ml/modelExtractMeta model)) (styles (ml/modelExtractStyles model)) (content (ml/modelExtractContent model)) (data (ml/modelExtractData model)) (config (ml/modelExtractConfig model))] (assert model.success "parseUnifiedModel must report success on valid doc") (assert (= model.errorMsg "") "parseUnifiedModel errorMsg must be empty on success") (assert (rd/isList? meta) "modelExtractMeta must return list") (assert (rd/isList? styles) "modelExtractStyles must return list") (assert (rd/isList? content) "modelExtractContent must return list") (assert (rd/isList? data) "modelExtractData must return list") (assert (rd/isList? config) "modelExtractConfig must return list") (let [(minimal "(:doc :meta (:title \"Bare\"))") (minModel (ml/parseUnifiedModel minimal))] (assert minModel.success "minimal model succeeds") (assert (rd/isList? (ml/modelExtractStyles minModel)) "omitted styles default to list") (assert (rd/isList? (ml/modelExtractContent minModel)) "omitted content default to list") (assert (rd/isList? (ml/modelExtractData minModel)) "omitted data default to list") (assert (rd/isList? (ml/modelExtractConfig minModel)) "omitted config default to list") true))

fn testMultilensDualPolarityRefutations -> Bool
  (let [(rEmpty (ml/parseUnifiedModel "")) (rAtom (ml/parseUnifiedModel "plainAtom")) (rBadRoot (ml/parseUnifiedModel "(:notDoc :meta ())")) (vEmpty (ml/validateMultilensModel "")) (vBad (ml/validateMultilensModel "invalid")) (vBadRoot (ml/validateMultilensModel "(:invalidRoot :meta ())")) (vGood (ml/validateMultilensModel "(:doc :meta ())"))] (refute rEmpty.success "empty input must not report success") (refute rAtom.success "atom input must not report success") (refute rBadRoot.success "non-doc root must not report success") (refute vEmpty "validateMultilensModel must reject empty input") (refute vBad "validateMultilensModel must reject malformed input") (refute vBadRoot "validateMultilensModel must reject invalid root form") (assert vGood "validateMultilensModel must accept valid doc") true)

fn ! runTests -> Bool
  (do (assert (testMultilensModelDynamicExecution!) "testMultilensModelDynamicExecution must pass") (assert (testMultilensModelInvariants) "testMultilensModelInvariants must pass") (assert (testMultilensDualPolarityRefutations) "testMultilensDualPolarityRefutations must pass") true)
