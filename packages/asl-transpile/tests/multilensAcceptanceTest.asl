(module asl-transpile/tests/multilensAcceptanceTest :x [testMultilensDynamicExecution! testMultilensInvariants testMultilensDualPolarityRefutations runTests] :i [(asl-transpile/multilens :a ml) (asl-tools/fleet/run :a run)])

fn sampleDocText -> Str
  (str "(:doc " ":meta (:title \"System Cockpit\" :version \"2.0.0\" :lang \"en\") " ":styles (:vars [(:primary \"#3b82f6\")] :rules [(:rule :selector \".cockpit\" :props [(:padding \"20px\")])]) " ":content (div (:class \"cockpit\") (h1 \"Telemetry\")) " ":data (:stats [(:id \"rps\" :value 1200)]) " ":config (:cluster \"us-east\" :nodes 5))")

fn testMultilensDynamicExecution! -> Bool
  (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-transpile/tests/multilensTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit) (stdout res.out)] (assert (= code 0) (str "multilensTest must exit 0, stderr: " "")) (refute (!= code 0) "multilensTest must not fail") (assert (stringContains? stdout "assertion(s) executed") "multilensTest must report executed assertions") (assert (stringContains? stdout "refutation(s) executed") "multilensTest must report executed refutations") (refute (stringContains? stdout "ASL_ASSERTION_FAILURE") "multilensTest must not fail assertions") true)

fn testMultilensInvariants -> Bool
  (let [(model (ml/parseUnifiedModel (sampleDocText))) (opts (ml/defaultLensOptions)) (rH (ml/projectLens "html" model opts)) (rC (ml/projectLens "css" model opts)) (rY (ml/projectLens "yaml" model opts)) (rJ (ml/projectLens "json" model opts)) (rT (ml/projectLens "toml" model opts)) (bundle (ml/emitMultilensBundle model (list "html" "css" "yaml" "json" "toml") opts))] (assert rH.success "html projection succeeds") (assert (stringContains? rH.output "<!DOCTYPE html>") "html contains doctype") (assert (stringContains? rH.output "--primary: #3b82f6;") "html embeds styles") (assert (stringContains? rH.output "<div class=\"cockpit\">") "html contains content") (assert rC.success "css projection succeeds") (assert (stringContains? rC.output ".cockpit {") "css contains selector rule") (assert rY.success "yaml projection succeeds") (assert (stringContains? rY.output "cluster: us-east") "yaml contains cluster config") (assert rJ.success "json projection succeeds") (assert (stringContains? rJ.output "\"stats\"") "json contains stats data") (assert rT.success "toml projection succeeds") (assert (stringContains? rT.output "nodes = 5") "toml contains nodes config") (assert bundle.success "bundle emission succeeds") (assert (= (listLength bundle.artifacts) 5) "bundle produces exactly 5 artifacts") (assert (> (stringLength bundle.html) 0) "bundle html populated") (assert (> (stringLength bundle.css) 0) "bundle css populated") (assert (> (stringLength bundle.yaml) 0) "bundle yaml populated") (assert (> (stringLength bundle.json) 0) "bundle json populated") (assert (> (stringLength bundle.toml) 0) "bundle toml populated") true)

fn testMultilensDualPolarityRefutations -> Bool
  (let [(model (ml/parseUnifiedModel (sampleDocText))) (opts (ml/defaultLensOptions)) (rBad (ml/projectLens "unknown-lens" model opts)) (bundle (ml/emitMultilensBundle model (list "html") opts))] (refute rBad.success "projectLens unknown must not report success") (refute (!= rBad.output "") "projectLens unknown must emit empty string") (refute (listEmpty? bundle.artifacts) "emitMultilensBundle must not return empty artifacts") (assert (= (listLength bundle.artifacts) 1) "single lens bundle has length 1") true)

fn ! runTests -> Bool
  (do (assert (testMultilensDynamicExecution!) "testMultilensDynamicExecution must pass") (assert (testMultilensInvariants) "testMultilensInvariants must pass") (assert (testMultilensDualPolarityRefutations) "testMultilensDualPolarityRefutations must pass") true)
