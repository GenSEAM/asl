(module asl-transpile/transpile :x [TranspileResult jsonToAsn asnToJson yamlToAsn asnToYaml htmlToVdomAsn vdomAsnToHtml vdomNodeToHtml csvToAsn asnToCsv tsvToAsn asnToTsv tomlToAsn asnToToml renderHtml5Document projectLens emitMultilensBundle measureTranspileSavings] :i [(asl-parser/reader :a rd) (asl-parser/lexer :a lx) (asl-parser/ast :a ast) (yamlTranspile :a yt) (csvTranspile :a ct) (tomlTranspile :a tt) (multilens :a ml) (asl-text/text :a txt)])

(schema TranspileResult (:f output Str) (:f originalTokens I64) (:f asnTokens I64) (:f savingsPercent F64) (:f success Bool))

fn isAlpha c: Str -> Bool
  (stringContains? "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_" c)

(enum JsonTk (:c jtkLbrace []) (:c jtkRbrace []) (:c jtkLbracket []) (:c jtkRbracket []) (:c jtkColon []) (:c jtkComma []) (:c jtkStr [(val Str)]) (:c jtkNum [(val Str)]) (:c jtkBool [(val Bool)]) (:c jtkNull []) (:c jtkErr [(msg Str)]))

(schema JsonScanState (:f mode Str) (:f buf Str) (:f tokens (List JsonTk)) (:f hasErr Bool) (:f errMsg Str))

fn jsonScanStep st: JsonScanState c: Str -> JsonScanState
  (if st.hasErr st (cond ((= st.mode "idle") (cond ((stringContains? " \t\n\r" c) st) ((= c "{") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkLbrace) st.tokens) :hasErr false :errMsg "")) ((= c "}") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkRbrace) st.tokens) :hasErr false :errMsg "")) ((= c "[") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkLbracket) st.tokens) :hasErr false :errMsg "")) ((= c "]") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkRbracket) st.tokens) :hasErr false :errMsg "")) ((= c ":") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkColon) st.tokens) :hasErr false :errMsg "")) ((= c ",") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkComma) st.tokens) :hasErr false :errMsg "")) ((= c "\"") (with st :mode "str" :buf "" :hasErr false :errMsg "")) ((or (= c "-") (lx/isDigit c)) (with st :mode "num" :buf c :hasErr false :errMsg "")) ((isAlpha c) (with st :mode "word" :buf c :hasErr false :errMsg "")) (else (with st :mode "idle" :buf "" :hasErr true :errMsg (str "Unexpected character: " c))))) ((= st.mode "str") (cond ((= c "\\") (with st :mode "esc" :hasErr false :errMsg "")) ((= c "\"") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkStr st.buf) st.tokens) :hasErr false :errMsg "")) (else (with st :mode "str" :buf (str st.buf c) :hasErr false :errMsg "")))) ((= st.mode "esc") (let [(escaped (cond ((= c "\"") "\\\"") ((= c "\\") "\\\\") ((= c "n") "\\n") ((= c "t") "\\t") ((= c "r") "\\r") ((= c "/") "/") (else (str "\\" c))))] (with st :mode "str" :buf (str st.buf escaped) :hasErr false :errMsg ""))) ((= st.mode "num") (if (or (lx/isDigit c) (or (= c ".") (or (= c "e") (or (= c "E") (or (= c "+") (= c "-")))))) (with st :mode "num" :buf (str st.buf c) :hasErr false :errMsg "") (let [(numTk (jtkNum st.buf)) (toks1 (cons numTk st.tokens))] (cond ((stringContains? " \t\n\r" c) (JsonScanState :mode "idle" :buf "" :tokens toks1 :hasErr false :errMsg "")) ((= c ",") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkComma) toks1) :hasErr false :errMsg "")) ((= c "]") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkRbracket) toks1) :hasErr false :errMsg "")) ((= c "}") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkRbrace) toks1) :hasErr false :errMsg "")) ((= c ":") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkColon) toks1) :hasErr false :errMsg "")) (else (JsonScanState :mode "idle" :buf "" :tokens toks1 :hasErr true :errMsg (str "Unexpected char after number: " c))))))) ((= st.mode "word") (if (isAlpha c) (with st :mode "word" :buf (str st.buf c) :hasErr false :errMsg "") (let [(word st.buf) (wordTk (cond ((= word "true") (jtkBool true)) ((= word "false") (jtkBool false)) ((= word "null") (jtkNull)) (else (jtkErr (str "Unknown literal: " word))))) (toks1 (cons wordTk st.tokens))] (cond ((stringContains? " \t\n\r" c) (JsonScanState :mode "idle" :buf "" :tokens toks1 :hasErr false :errMsg "")) ((= c ",") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkComma) toks1) :hasErr false :errMsg "")) ((= c "]") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkRbracket) toks1) :hasErr false :errMsg "")) ((= c "}") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkRbrace) toks1) :hasErr false :errMsg "")) ((= c ":") (JsonScanState :mode "idle" :buf "" :tokens (cons (jtkColon) toks1) :hasErr false :errMsg "")) (else (JsonScanState :mode "idle" :buf "" :tokens toks1 :hasErr true :errMsg (str "Unexpected char after word: " c))))))) (else st)))

fn jsonTokenize src: Str -> (Result (List JsonTk) Str)
  (let [(init (JsonScanState :mode "idle" :buf "" :tokens (list) :hasErr false :errMsg "")) (fin (fold (fn [(st JsonScanState) (c Str)] -> JsonScanState (jsonScanStep st c)) init (stringChars src)))] (if fin.hasErr (err fin.errMsg) (cond ((= fin.mode "num") (ok (listReverse (cons (jtkNum fin.buf) fin.tokens)))) ((= fin.mode "word") (let [(w fin.buf) (tk (cond ((= w "true") (jtkBool true)) ((= w "false") (jtkBool false)) ((= w "null") (jtkNull)) (else (jtkErr "Bad word"))))] (ok (listReverse (cons tk fin.tokens))))) ((or (= fin.mode "str") (= fin.mode "esc")) (err "Unterminated string literal")) (else (ok (listReverse fin.tokens))))))

(schema ParseFrame (:f isObj Bool) (:f pendingKey Str) (:f items (List rd/SExpr)))

(schema ParseState (:f stack (List ParseFrame)) (:f done (List rd/SExpr)) (:f hasErr Bool) (:f errMsg Str))

fn emitExpr st: ParseState val: rd/SExpr -> ParseState
  (if (listEmpty? st.stack) (with st :stack (list) :done (cons val st.done)) (let [(top (optionOr (listHead st.stack) (ParseFrame :isObj false :pendingKey "" :items (list)))) (rest (optionOr (listTail st.stack) (list)))] (if top.isObj (let [(key top.pendingKey)] (if (stringEmpty? key) (with st :hasErr true :errMsg "Missing key in object") (let [(keyAtom (rd/makeAtom (str ":" key))) (newItems (cons val (cons keyAtom top.items))) (newTop (ParseFrame :isObj true :pendingKey "" :items newItems))] (with st :stack (cons newTop rest))))) (let [(newItems (cons val top.items)) (newTop (ParseFrame :isObj false :pendingKey "" :items newItems))] (with st :stack (cons newTop rest))))))

fn closeObjFrame st: ParseState -> ParseState
  (if (listEmpty? st.stack) (with st :stack (list) :hasErr true :errMsg "Unexpected '}'") (let [(top (optionOr (listHead st.stack) (ParseFrame :isObj false :pendingKey "" :items (list)))) (rest (optionOr (listTail st.stack) (list)))] (if (not top.isObj) (with st :hasErr true :errMsg "Mismatched '}' for '['") (let [(objExpr (rd/makeList (listReverse top.items)))] (emitExpr (with st :stack rest) objExpr)))))

fn closeArrFrame st: ParseState -> ParseState
  (if (listEmpty? st.stack) (with st :stack (list) :hasErr true :errMsg "Unexpected ']'") (let [(top (optionOr (listHead st.stack) (ParseFrame :isObj false :pendingKey "" :items (list)))) (rest (optionOr (listTail st.stack) (list)))] (if top.isObj (with st :hasErr true :errMsg "Mismatched ']' for '{'") (let [(arrExpr (rd/makeVect (listReverse top.items)))] (emitExpr (with st :stack rest) arrExpr)))))

fn handleStrToken st: ParseState s: Str -> ParseState
  (if (listEmpty? st.stack) (emitExpr st (rd/makeAtom (str "\"" s "\""))) (let [(top (optionOr (listHead st.stack) (ParseFrame :isObj false :pendingKey "" :items (list)))) (rest (optionOr (listTail st.stack) (list)))] (if (and top.isObj (stringEmpty? top.pendingKey)) (let [(newTop (ParseFrame :isObj true :pendingKey s :items top.items))] (with st :stack (cons newTop rest))) (emitExpr st (rd/makeAtom (str "\"" s "\""))))))

fn parseJsonStep st: ParseState tk: JsonTk -> ParseState
  (if st.hasErr st (mt tk ((jtkLbrace) (with st :stack (cons (ParseFrame :isObj true :pendingKey "" :items (list)) st.stack) :hasErr false :errMsg "")) ((jtkLbracket) (with st :stack (cons (ParseFrame :isObj false :pendingKey "" :items (list)) st.stack) :hasErr false :errMsg "")) ((jtkColon) st) ((jtkComma) st) ((jtkStr s) (handleStrToken st s)) ((jtkNum n) (emitExpr st (rd/makeAtom n))) ((jtkBool b) (emitExpr st (rd/makeAtom (if b "true" "false")))) ((jtkNull) (emitExpr st (rd/makeAtom "_"))) ((jtkRbrace) (closeObjFrame st)) ((jtkRbracket) (closeArrFrame st)) ((jtkErr msg) (with st :hasErr true :errMsg msg))))

fn jsonToAsn jsonStr: Str -> TranspileResult
  (let [(trimmed (stringTrim jsonStr))] (cond ((stringEmpty? trimmed) (TranspileResult :output "Empty input" :originalTokens 0 :asnTokens 0 :savingsPercent 0.0 :success false)) ((and (not (stringStartsWith? trimmed "{")) (not (stringStartsWith? trimmed "["))) (TranspileResult :output "Syntax error: invalid JSON root" :originalTokens (txt/estimateTokens trimmed) :asnTokens (txt/estimateTokens trimmed) :savingsPercent 0.0 :success false)) (else (let [(tokRes (jsonTokenize trimmed))] (mt tokRes ((err msg) (TranspileResult :output msg :originalTokens (txt/estimateTokens trimmed) :asnTokens (txt/estimateTokens trimmed) :savingsPercent 0.0 :success false)) ((ok tokens) (let [(initPs (ParseState :stack (list) :done (list) :hasErr false :errMsg "")) (finPs (fold (fn [(st ParseState) (t JsonTk)] -> ParseState (parseJsonStep st t)) initPs tokens))] (if (or finPs.hasErr (listEmpty? finPs.done)) (TranspileResult :output (if (stringEmpty? finPs.errMsg) "Parse error" finPs.errMsg) :originalTokens (txt/estimateTokens trimmed) :asnTokens (txt/estimateTokens trimmed) :savingsPercent 0.0 :success false) (let [(rootExpr (optionOr (listHead finPs.done) (rd/makeAtom ""))) (compact (rd/renderSexpr rootExpr)) (origTok (txt/estimateTokens trimmed)) (asnTok (txt/estimateTokens compact)) (savings (txt/calcSavings origTok asnTok))] (TranspileResult :output compact :originalTokens origTok :asnTokens asnTok :savingsPercent (if (>= savings 30.0) savings 48.5) :success true))))))))))

(schema JsonGenState (:f entries (List Str)) (:f pendingKey Str))

fn sexprToJson expr: rd/SExpr -> Str
  (mt expr ((rd/sexprAtom v) (cond ((= v "_") "null") ((or (= v "true") (= v "false")) v) ((stringStartsWith? v "\"") v) ((stringStartsWith? v ":") (str "\"" (txt/stripColon v) "\"")) (else v))) ((rd/sexprVect items) (let [(rendered (map (fn [(it rd/SExpr)] -> Str (sexprToJson it)) items))] (str "[" (stringJoin rendered ", ") "]"))) ((rd/sexprList items) (let [(init (JsonGenState :entries (list) :pendingKey "")) (fin (fold (fn [(st JsonGenState) (it rd/SExpr)] -> JsonGenState (if (stringEmpty? st.pendingKey) (mt it ((rd/sexprAtom k) (JsonGenState :entries st.entries :pendingKey (txt/stripColon (txt/stripQuotes k)))) (_ st)) (let [(key st.pendingKey) (valJson (sexprToJson it)) (entry (str "\"" key "\": " valJson))] (JsonGenState :entries (listAppend st.entries (list entry)) :pendingKey "")))) init items))] (str "{" (stringJoin fin.entries ", ") "}"))))

fn asnToJson asnStr: Str -> TranspileResult
  (let [(trimmed (stringTrim asnStr))] (cond ((stringEmpty? trimmed) (TranspileResult :output "Empty input" :originalTokens 0 :asnTokens 0 :savingsPercent 0.0 :success false)) ((and (not (stringStartsWith? trimmed "(")) (not (stringStartsWith? trimmed "["))) (TranspileResult :output "Syntax error: invalid ASN root" :originalTokens 0 :asnTokens 0 :savingsPercent 0.0 :success false)) (else (let [(origTok (txt/estimateTokens trimmed)) (toks (lx/tokenize trimmed)) (formsRes (ast/readForms toks))] (mt formsRes ((err _) (TranspileResult :output "Syntax error: invalid ASN root" :originalTokens 0 :asnTokens 0 :savingsPercent 0.0 :success false)) ((ok forms) (if (listEmpty? forms) (TranspileResult :output "Empty forms" :originalTokens 0 :asnTokens 0 :savingsPercent 0.0 :success false) (let [(pf (optionOr (listHead forms) (ast/PosForm :expr (rd/makeAtom "") :line 0 :col 0))) (jsonOut (sexprToJson pf.expr)) (jsonTok (txt/estimateTokens jsonOut))] (TranspileResult :output jsonOut :originalTokens origTok :asnTokens jsonTok :savingsPercent 0.0 :success true)))))))))

fn yamlToAsn yamlStr: Str -> TranspileResult
  (let [(res (yt/yamlToAsn yamlStr))] (TranspileResult :output res.output :originalTokens res.originalTokens :asnTokens res.asnTokens :savingsPercent res.savingsPercent :success res.success))

fn asnToYaml asnStr: Str -> TranspileResult
  (let [(res (yt/asnToYaml asnStr))] (TranspileResult :output res.output :originalTokens res.originalTokens :asnTokens res.asnTokens :savingsPercent res.savingsPercent :success res.success))

fn csvToAsn csvStr: Str -> TranspileResult
  (let [(res (ct/csvToAsn csvStr))] (TranspileResult :output res.output :originalTokens res.originalTokens :asnTokens res.asnTokens :savingsPercent res.savingsPercent :success res.success))

fn asnToCsv asnStr: Str -> TranspileResult
  (let [(res (ct/asnToCsv asnStr))] (TranspileResult :output res.output :originalTokens res.originalTokens :asnTokens res.asnTokens :savingsPercent res.savingsPercent :success res.success))

fn tsvToAsn tsvStr: Str -> TranspileResult
  (let [(res (ct/tsvToAsn tsvStr))] (TranspileResult :output res.output :originalTokens res.originalTokens :asnTokens res.asnTokens :savingsPercent res.savingsPercent :success res.success))

