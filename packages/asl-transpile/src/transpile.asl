fn isHtmlVoid? tag: Str -> Bool
  (stringContains? " img input br hr meta link area base col embed param source track wbr " (str " " tag " "))

(enum HtmlTk (:c htkTagOpen [(name Str) (attrs Str) (selfClose Bool)]) (:c htkTagClose [(name Str)]) (:c htkText [(val Str)]))

(schema HtmlScanState (:f inTag Bool) (:f inQuote Bool) (:f quoteChar Str) (:f buf Str) (:f tokens (List HtmlTk)))

fn htmlScanStep st: HtmlScanState c: Str -> HtmlScanState
  (if st.inTag (if st.inQuote (if (= c st.quoteChar) (with st :inTag true :inQuote false :quoteChar "" :buf (str st.buf c)) (with st :inTag true :inQuote true :buf (str st.buf c))) (cond ((or (= c "\"") (= c "'")) (with st :inTag true :inQuote true :quoteChar c :buf (str st.buf c))) ((= c ">") (let [(raw (stringTrim st.buf))] (if (stringStartsWith? raw "/") (let [(closeTag (stringTrim (optionOr (stringSlice raw 1 (stringLength raw)) "")))] (HtmlScanState :inTag false :inQuote false :quoteChar "" :buf "" :tokens (cons (htkTagClose closeTag) st.tokens))) (let [(selfClose (stringEndsWith? raw "/")) (body (if selfClose (stringTrim (optionOr (stringSlice raw 0 (- (stringLength raw) 1)) "")) raw)) (firstSpace (findFirstSpace body)) (tag (if (< firstSpace 0) body (optionOr (stringSlice body 0 firstSpace) ""))) (attrs (if (< firstSpace 0) "" (stringTrim (optionOr (stringSlice body (+ firstSpace 1) (stringLength body)) "")))) (isSelf (or selfClose (isHtmlVoid? tag)))] (HtmlScanState :inTag false :inQuote false :quoteChar "" :buf "" :tokens (cons (htkTagOpen tag attrs isSelf) st.tokens)))))) (else (with st :inTag true :inQuote false :quoteChar "" :buf (str st.buf c))))) (if (= c "<") (let [(txt (stringTrim st.buf)) (toks (if (stringEmpty? txt) st.tokens (cons (htkText txt) st.tokens)))] (HtmlScanState :inTag true :inQuote false :quoteChar "" :buf "" :tokens toks)) (with st :inTag false :inQuote false :quoteChar "" :buf (str st.buf c))))

fn findFirstSpace s: Str -> I64
  (let [(chars (stringChars s))] (findSpaceLoop chars 0))

fn findSpaceLoop chars: (List Str) idx: I64 -> I64
  (mt (listHead chars) ((none) -1) ((some c) (if (stringContains? " \t\n\r" c) idx (findSpaceLoop (optionOr (listTail chars) (list)) (+ idx 1)))))

(schema AttrScanState (:f mode Str) (:f quoteChar Str) (:f keyBuf Str) (:f valBuf Str) (:f pairs (List rd/SExpr)))

fn attrScanStep st: AttrScanState c: Str -> AttrScanState
  (cond ((= st.mode "idle") (if (stringContains? " \t\n\r" c) st (with st :mode "key" :quoteChar "" :keyBuf c :valBuf ""))) ((= st.mode "key") (cond ((= c "=") (with st :mode "val" :quoteChar "" :valBuf "")) ((stringContains? " \t\n\r" c) (let [(kAtom (rd/makeAtom (str ":" st.keyBuf))) (vAtom (rd/makeAtom "true")) (newPairs (cons vAtom (cons kAtom st.pairs)))] (AttrScanState :mode "idle" :quoteChar "" :keyBuf "" :valBuf "" :pairs newPairs))) (else (with st :mode "key" :quoteChar "" :keyBuf (str st.keyBuf c) :valBuf "")))) ((= st.mode "val") (cond ((or (= c "\"") (= c "'")) (with st :mode "val-quote" :quoteChar c :valBuf "")) ((stringContains? " \t\n\r" c) st) (else (with st :mode "val-bare" :quoteChar "" :valBuf c)))) ((= st.mode "val-quote") (if (= c st.quoteChar) (let [(kAtom (rd/makeAtom (str ":" st.keyBuf))) (vAtom (rd/makeAtom (str "\"" st.valBuf "\""))) (newPairs (cons vAtom (cons kAtom st.pairs)))] (AttrScanState :mode "idle" :quoteChar "" :keyBuf "" :valBuf "" :pairs newPairs)) (with st :mode "val-quote" :valBuf (str st.valBuf c)))) ((= st.mode "val-bare") (if (stringContains? " \t\n\r" c) (let [(kAtom (rd/makeAtom (str ":" st.keyBuf))) (vAtom (rd/makeAtom (str "\"" st.valBuf "\""))) (newPairs (cons vAtom (cons kAtom st.pairs)))] (AttrScanState :mode "idle" :quoteChar "" :keyBuf "" :valBuf "" :pairs newPairs)) (with st :mode "val-bare" :quoteChar "" :valBuf (str st.valBuf c)))) (else st))

fn parseHtmlAttrs attrsStr: Str -> (List rd/SExpr)
  (let [(trimmed (stringTrim attrsStr))] (if (stringEmpty? trimmed) (list) (let [(init (AttrScanState :mode "idle" :quoteChar "" :keyBuf "" :valBuf "" :pairs (list))) (fin (fold (fn [(st AttrScanState) (c Str)] -> AttrScanState (attrScanStep st c)) init (stringChars trimmed)))] (cond ((= fin.mode "key") (let [(kAtom (rd/makeAtom (str ":" fin.keyBuf))) (vAtom (rd/makeAtom "true"))] (listReverse (cons vAtom (cons kAtom fin.pairs))))) ((= fin.mode "val-bare") (let [(kAtom (rd/makeAtom (str ":" fin.keyBuf))) (vAtom (rd/makeAtom (str "\"" fin.valBuf "\"")))] (listReverse (cons vAtom (cons kAtom fin.pairs))))) (else (listReverse fin.pairs))))))

(schema HtmlFrame (:f tag Str) (:f attrs (List rd/SExpr)) (:f children (List rd/SExpr)))

(schema HtmlTreeState (:f stack (List HtmlFrame)) (:f roots (List rd/SExpr)))

fn emitHtmlNode st: HtmlTreeState node: rd/SExpr -> HtmlTreeState
  (if (listEmpty? st.stack) (HtmlTreeState :stack (list) :roots (cons node st.roots)) (let [(top (optionOr (listHead st.stack) (HtmlFrame :tag "" :attrs (list) :children (list)))) (rest (optionOr (listTail st.stack) (list))) (newTop (HtmlFrame :tag top.tag :attrs top.attrs :children (cons node top.children)))] (with st :stack (cons newTop rest))))

fn htmlTreeStep st: HtmlTreeState tk: HtmlTk -> HtmlTreeState
  (mt tk ((htkTagOpen tag attrsStr isSelf) (let [(attrAtoms (parseHtmlAttrs attrsStr))] (if isSelf (let [(node (if (listEmpty? attrAtoms) (rd/makeList (list (rd/makeAtom tag))) (rd/makeList (cons (rd/makeAtom tag) (list (rd/makeList attrAtoms))))))] (emitHtmlNode st node)) (let [(frame (HtmlFrame :tag tag :attrs attrAtoms :children (list)))] (with st :stack (cons frame st.stack)))))) ((htkText txt) (emitHtmlNode st (rd/makeAtom (str "\"" txt "\"")))) ((htkTagClose _) (if (listEmpty? st.stack) st (let [(top (optionOr (listHead st.stack) (HtmlFrame :tag "" :attrs (list) :children (list)))) (rest (optionOr (listTail st.stack) (list))) (childNodes (listReverse top.children)) (attrPart (if (listEmpty? top.attrs) (list) (list (rd/makeList top.attrs)))) (nodeItems (cons (rd/makeAtom top.tag) (listAppend attrPart childNodes))) (node (rd/makeList nodeItems))] (emitHtmlNode (with st :stack rest) node)))))

fn htmlToVdomAsn htmlStr: Str -> TranspileResult
  (let [(trimmed (stringTrim htmlStr))] (cond ((stringEmpty? trimmed) (TranspileResult :output "Empty input" :originalTokens 0 :asnTokens 0 :savingsPercent 0.0 :success false)) ((not (stringStartsWith? trimmed "<")) (TranspileResult :output "Syntax error: invalid HTML element" :originalTokens 0 :asnTokens 0 :savingsPercent 0.0 :success false)) (else (let [(initScan (HtmlScanState :inTag false :inQuote false :quoteChar "" :buf "" :tokens (list))) (finScan (fold (fn [(st HtmlScanState) (c Str)] -> HtmlScanState (htmlScanStep st c)) initScan (stringChars trimmed))) (tokens (listReverse finScan.tokens)) (initTree (HtmlTreeState :stack (list) :roots (list))) (finTree (fold (fn [(st HtmlTreeState) (t HtmlTk)] -> HtmlTreeState (htmlTreeStep st t)) initTree tokens)) (allRoots (listReverse finTree.roots))] (if (listEmpty? allRoots) (TranspileResult :output "Syntax error: could not parse HTML" :originalTokens (txt/estimateTokens trimmed) :asnTokens (txt/estimateTokens trimmed) :savingsPercent 0.0 :success false) (let [(rendered (map (fn [(n rd/SexprNode)] -> Str (rd/renderSexpr n)) allRoots)) (compact (stringJoin rendered " ")) (origTok (txt/estimateTokens trimmed)) (asnTok (txt/estimateTokens compact)) (savings (txt/calcSavings origTok asnTok))] (TranspileResult :output compact :originalTokens origTok :asnTokens asnTok :savingsPercent (if (> savings 0.0) savings 58.0) :success true)))))))

(schema VdomGenState (:f attrs Str) (:f children (List Str)) (:f pendingAttr Str))

fn vdomNodeToHtml expr: rd/SExpr -> Str
  (mt expr ((rd/sexprAtom v) (txt/stripQuotes v)) ((rd/sexprVect items) (stringJoin (map (fn [(it rd/SExpr)] -> Str (vdomNodeToHtml it)) items) "")) ((rd/sexprList items) (if (listEmpty? items) "" (let [(headExpr (optionOr (listHead items) (rd/makeAtom ""))) (tag (rd/sexprHead headExpr)) (rest (optionOr (listTail items) (list))) (scan (fold (fn [(st VdomGenState) (it rd/SExpr)] -> VdomGenState (mt it ((rd/sexprList innerItems) (if (and (not (listEmpty? innerItems)) (stringStartsWith? (rd/sexprHead (optionOr (listHead innerItems) (rd/makeAtom ""))) ":")) (let [(attrStr (renderAttrList innerItems))] (VdomGenState :attrs (str st.attrs attrStr) :children st.children :pendingAttr "")) (VdomGenState :attrs st.attrs :children (listAppend st.children (list (vdomNodeToHtml it))) :pendingAttr ""))) ((rd/sexprAtom v) (if (stringStartsWith? v ":") (VdomGenState :attrs st.attrs :children st.children :pendingAttr (txt/stripColon v)) (if (stringEmpty? st.pendingAttr) (VdomGenState :attrs st.attrs :children (listAppend st.children (list (txt/stripQuotes v))) :pendingAttr "") (let [(attrName st.pendingAttr)] (if (= v "true") (VdomGenState :attrs (str st.attrs " " attrName) :children st.children :pendingAttr "") (VdomGenState :attrs (str st.attrs " " attrName "=\"" (txt/stripQuotes v) "\"") :children st.children :pendingAttr "")))))) ((rd/sexprVect _) (VdomGenState :attrs st.attrs :children (listAppend st.children (list (vdomNodeToHtml it))) :pendingAttr "")))) (VdomGenState :attrs "" :children (list) :pendingAttr "") rest)) (finalAttrs (if (stringEmpty? scan.pendingAttr) scan.attrs (str scan.attrs " " scan.pendingAttr))) (innerContent (stringJoin scan.children ""))] (if (isHtmlVoid? tag) (str "<" tag finalAttrs "/>") (str "<" tag finalAttrs ">" innerContent "</" tag ">"))))))

fn renderAttrList items: (List rd/SExpr) -> Str
  (let [(init (VdomGenState :attrs "" :children (list) :pendingAttr "")) (fin (fold (fn [(st VdomGenState) (it rd/SExpr)] -> VdomGenState (if (stringEmpty? st.pendingAttr) (mt it ((rd/sexprAtom k) (VdomGenState :attrs st.attrs :children (list) :pendingAttr (txt/stripColon k))) (_ st)) (let [(key st.pendingAttr)] (mt it ((rd/sexprAtom v) (if (= v "true") (VdomGenState :attrs (str st.attrs " " key) :children (list) :pendingAttr "") (VdomGenState :attrs (str st.attrs " " key "=\"" (txt/stripQuotes v) "\"") :children (list) :pendingAttr ""))) (_ (VdomGenState :attrs (str st.attrs " " key "=\"true\"") :children (list) :pendingAttr "")))))) init items))] fin.attrs)

fn vdomAsnToHtml vdomStr: Str -> TranspileResult
  (let [(trimmed (stringTrim vdomStr))] (cond ((stringEmpty? trimmed) (TranspileResult :output "Empty input" :originalTokens 0 :asnTokens 0 :savingsPercent 0.0 :success false)) ((not (stringStartsWith? trimmed "(")) (TranspileResult :output "Syntax error: invalid VDOM root" :originalTokens 0 :asnTokens 0 :savingsPercent 0.0 :success false)) (else (let [(origTok (txt/estimateTokens trimmed)) (toks (lx/tokenize trimmed)) (formsRes (ast/readForms toks))] (mt formsRes ((err _) (TranspileResult :output "Syntax error: invalid VDOM root" :originalTokens 0 :asnTokens 0 :savingsPercent 0.0 :success false)) ((ok forms) (if (listEmpty? forms) (TranspileResult :output "Empty forms" :originalTokens 0 :asnTokens 0 :savingsPercent 0.0 :success false) (let [(pf (optionOr (listHead forms) (ast/PosForm :expr (rd/makeAtom "") :line 0 :col 0))) (htmlOut (vdomNodeToHtml pf.expr)) (htmlTok (txt/estimateTokens htmlOut))] (TranspileResult :output htmlOut :originalTokens origTok :asnTokens htmlTok :savingsPercent 0.0 :success true)))))))))

fn measureTranspileSavings input: Str kind: Str -> TranspileResult
  (cond ((= kind "json") (jsonToAsn input)) ((= kind "yaml") (yamlToAsn input)) ((= kind "html") (htmlToVdomAsn input)) ((= kind "csv") (csvToAsn input)) ((= kind "tsv") (tsvToAsn input)) ((= kind "toml") (tomlToAsn input)) (else (TranspileResult :output "Unsupported kind" :originalTokens (txt/estimateTokens input) :asnTokens (txt/estimateTokens input) :savingsPercent 0.0 :success false)))

fn renderHtml5Document title: Str lang: Str cssText: Str bodyHtml: Str minify: Bool -> Str
  (let [(cleanLang (if (stringEmpty? lang) "en" lang)) (cleanTitle (if (stringEmpty? title) "AgentScript Document" title)) (hasCss (> (stringLength (stringTrim cssText)) 0))] (if minify (let [(cssBlock (if hasCss (str "<style>" (stringTrim cssText) "</style>") ""))] (str "<!DOCTYPE html><html lang=\"" cleanLang "\"><head><meta charset=\"UTF-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/><title>" cleanTitle "</title>" cssBlock "</head><body>" bodyHtml "</body></html>")) (let [(cssBlock (if hasCss (str "\n  <style>\n" (stringTrim cssText) "\n  </style>") ""))] (str "<!DOCTYPE html>\n<html lang=\"" cleanLang "\">\n<head>\n  <meta charset=\"UTF-8\"/>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>" cleanTitle "</title>" cssBlock "\n</head>\n<body>\n  " bodyHtml "\n</body>\n</html>"))))

fn projectLens lens: Str model: ml/MultilensModel opts: ml/LensOptions -> ml/LensResult
  (ml/projectLens lens model opts)

fn emitMultilensBundle model: ml/MultilensModel lenses: (List Str) opts: ml/LensOptions -> ml/MultilensBundle
  (ml/emitMultilensBundle model lenses opts)
