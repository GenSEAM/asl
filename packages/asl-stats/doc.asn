(:doc :symbol "asl/packages/asl-stats/src/special.asl#" :text "Special functions in Float64 for the interval code: lgamma, regularized incomplete beta and gamma, normal and Student t cdfs and quantiles, beta quantile")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#pi" :text "3.141592653589793")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#lanczos" :text "the nine Lanczos coefficients")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#lanczosSum!" :text "sum of c_i/(x+i) over the coefficients")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#lgamma" :text "natural log of the gamma function, Lanczos g 7 with 9 terms and reflection below 0.5; about 1e-14 relative")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#betaCf!" :text "modified Lentz iteration of the incomplete beta continued fraction, 400 steps at most")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#tiny" :text "replace a magnitude below 1e-300 by 1e-300 so Lentz never divides by zero")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#betaCfStart" :text "first Lentz step of the beta continued fraction")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#betaInc" :text "regularized incomplete beta I_x(a,b) by continued fraction, 0 at x<=0 and 1 at x>=1")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#gammaSeries!" :text "series of the lower incomplete gamma")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#gammaCf!" :text "Lentz iteration of the upper incomplete gamma continued fraction")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#gammaIncP" :text "regularized lower incomplete gamma P(a,x) by series below a+1 and continued fraction above")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#normalCdf" :text "standard normal cdf through P(1/2, z^2/2)")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#bisect!" :text "bisect a monotone function to a target value in n steps")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#normalQuantile" :text "inverse normal cdf by 120 bisection steps on [-40,40]")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#studentCdf" :text "Student t cdf through the incomplete beta")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#studentQuantile" :text "inverse t cdf by 200 bisection steps on [-1e7,1e7]")
(:doc :symbol "asl/packages/asl-stats/src/special.asl#betaQuantile" :text "inverse regularized incomplete beta by 200 bisection steps on [0,1]")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#" :text "Descriptive statistics and effect sizes returning (Result Float64 String): mean, variance, stddev, median, percentile, MAD, robust z, percentile rank, Cohen d and Hedges g")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#statsEmpty" :text "label of the empty-input err")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#statsTooFew" :text "label of the fewer-than-two-values err")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#neumaier!" :text "compensated summation loop")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#sumKahan" :text "Neumaier compensated sum; an infinity in the input gives that infinity, inf minus inf gives NaN")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#mean" :text "arithmetic mean; err statsEmpty on no values")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#squares" :text "squared deviations from a mean")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#spread" :text "sum of squared deviations over d, scaled per term when the plain sum overflows; err statsRange when the variance itself passes Float64 max")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#popVariance" :text "population variance with n; err statsEmpty on no values")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#variance" :text "sample variance with n-1; err statsEmpty on no values, statsTooFew on one")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#stddev" :text "square root of the sample variance")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#percentileSorted" :text "percentile of an already ascending list; err statsRange for p outside 0..100 or NaN")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#percentile" :text "linear interpolation between order statistics (R type 7), p in 0..100; err statsRange outside, statsEmpty on no values")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#median" :text "50th percentile")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#mad" :text "median absolute deviation, unscaled")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#robustZ" :text "(x - median) / (1.4826 * MAD); err statsConstant when MAD is 0")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#percentileOf" :text "percentile rank of a value: (count below + half the ties) / n * 100")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#cohenD" :text "(mean a - mean b) / pooled sample standard deviation; errs statsTooFew and statsConstant")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#hedgesG" :text "Cohen d times 1 - 3/(4(n1+n2)-9)")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#" :text "Seeded xoshiro256** generator as a value, normal, gamma and beta draws")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#lsr" :text "logical right shift of an Int64")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#addW" :text "wrapping 64-bit add from 32-bit halves")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#rotl" :text "rotate left of an Int64")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#mulSoft!" :text "wrapping 64-bit multiply by shift and add")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#rngFromState" :text "generator from four explicit words, for published test vectors")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#splitmix" :text "one splitmix64 step: new state and output")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#rngSeed" :text "expand one Int64 into four state words with splitmix64")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#rngNext" :text "next 64-bit output and the new state")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#rngFloat" :text "uniform in [0,1) from the top 53 bits and the new state")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#rngNormal" :text "standard normal by Box-Muller, two uniforms per draw")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#gammaLoop!" :text "Marsaglia-Tsang accept/reject loop")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#gammaDraw" :text "Gamma(alpha,1) by Marsaglia-Tsang, shape below 1 boosted through shape+1; err statsRange for a shape not above 0")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#logGammaDraw" :text "log of a Gamma(alpha,1) draw; for a shape below 1 log g + log(u)/alpha with u clamped to 1e-300, finite where the draw underflows")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#betaDraw" :text "Beta(a,b) as 1/(1+exp(log y - log x)) of two log gamma draws, never NaN for tiny shapes")
(:doc :symbol "asl/packages/asl-stats/src/rng.asl#Rng" :text "four Int64 state words s0..s3")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#" :text "Confidence intervals and a sample-size formula: Wilson, Clopper-Pearson, Student t mean interval, seeded percentile bootstrap, two-proportion sample size")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#confOk?" :text "conf strictly inside (0,1)")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#countsOk?" :text "0 <= x <= n and n >= 1")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#wilson" :text "Wilson score interval for x of n at confidence conf as (lo hi); errs statsRange for bad counts or conf")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#clopperPearson" :text "exact binomial interval from beta quantiles; lower bound 0 at x=0 and upper 1 at x=n")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#meanCi" :text "Student t interval of the mean; errs statsEmpty, statsTooFew, statsRange")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#resampleLoop!" :text "draw n indexes into a source buffer")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#floatsOf" :text "Float64 slots of a buffer as a list")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#statLoop!" :text "compute the statistic over every resample")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#bootstrapPercentile" :text "resample with replacement from a seeded Rng, apply the statistic, return the percentile interval, the estimate and the new state; at least 10 and at most 1000000 resamples")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#fillFloats!" :text "copy a list into Float64 slots")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#twoProportionSampleSize" :text "per-group n to detect p1 vs p2 two-sided at alpha with the given power, rounded up; err statsRange for equal, out-of-range or NaN arguments and for a size that does not fit in Int64")
(:doc :symbol "asl/packages/asl-stats/src/interval.asl#BootResult" :text "bootstrap lo, hi, the statistic on the original sample, and the advanced Rng")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#" :text "Rank correlation and rater agreement: average ranks, Pearson, Spearman, Cohen and weighted kappa")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#rankLoop!" :text "assign average ranks over sorted tie groups")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#tieEnd" :text "end index of a tie group, searching from the index after the group start so every step makes progress")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#setRange!" :text "write one rank to every index of a tie group")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#floatsOf" :text "Float64 slots as a list")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#indexedList" :text "pair each value with its index")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#ranks" :text "(Result (List Float64) String): 1-based average ranks, ties share the mean of the ranks they span; err statsRange for a NaN or infinite value")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#pearson" :text "Pearson correlation; same errs as spearman, including statsRange for NaN or infinite values")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#spearman" :text "Pearson correlation of the average ranks; errs statsEmpty, statsTooFew, statsRange on unequal lengths or a NaN or infinite value, statsConstant on a constant series")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#tableOk?" :text "square, at least 2x2, non-negative counts")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#rowSums" :text "row totals")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#colSums" :text "column totals")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#cell" :text "table cell as Float64")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#weightAt" :text "agreement weight of cell i,j for none, linear or quadratic")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#weightedSum" :text "sum of f over all cells")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#weightedKappa" :text "kappa with none, linear or quadratic weights; errs statsRange, statsEmpty, statsConstant")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#cohenKappa" :text "Cohen kappa of a square count table, rows rater A, columns rater B")
(:doc :symbol "asl/packages/asl-stats/tests/describeTest.asl#runTests" :text "descriptive, effect size, error label, rank, Spearman and kappa gates against hand and python oracle values")
(:doc :symbol "asl/packages/asl-stats/tests/intervalTest.asl#runTests" :text "special function, Wilson against Newcombe 1998, Clopper-Pearson, t interval, seeded bootstrap and sample size gates")
(:doc :symbol "asl/packages/asl-stats/tests/rngTest.asl#runTests" :text "xoshiro256** published vector, splitmix seeding, bit-for-bit reproduction, normal, gamma and beta draw gates")
(:doc :symbol "asl/packages/asl-stats/src/agree.asl#finiteAll?" :text "true when every value is finite by describe finiteValue?")
(:doc :symbol "asl/packages/asl-stats/src/describe.asl#finiteValue?" :text "true for a Float64 that is neither NaN nor infinite; mean and everything built on it refuse anything else as statsRange")
