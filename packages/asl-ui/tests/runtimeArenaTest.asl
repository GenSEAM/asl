(module asl/packages/asl-ui/tests/runtimeArenaTest :x [RunTests runTests] :i [(asl-ui/vnode :a ui) (asl-ui/runtime :a elm) (asl-ui/arena :a arena)])

fn testDeclarativeUiDslAndVNodePrimitives -> Bool
  (let [(textNode (ui/makeText "Click Me" "btn-lbl")) (btnAttrs (mapSet (mapSet (mapEmpty) "class" "btn-primary") "disabled" "false")) (btnNode (ui/makeButton "submit-btn" btnAttrs (list textNode))) (inputAttrs (mapSet (mapSet (mapEmpty) "type" "text") "placeholder" "Username")) (inputNode (ui/makeInput "user-input" inputAttrs)) (containerChildren (list btnNode inputNode)) (containerAttrs (mapSet (mapEmpty) "layout" "column")) (containerNode (ui/makeContainer "main-box" containerAttrs containerChildren)) (canvasNode (ui/makeCanvas "chart-canvas" 800 600)) (modalNode (ui/makeModal "confirm-modal" true (list (ui/makeText "Are you sure?" "modal-text")))) (listItems (list (ui/makeText "Item 1" "item-1") (ui/makeText "Item 2" "item-2"))) (listNode (ui/makeList "todo-list" listItems))] (assert (= textNode.tag "text") "Text node tag is text") (assert (= textNode.text "Click Me") "Text node content matches") (assert (= textNode.key "btn-lbl") "Text node key matches") (assert (= btnNode.tag "button") "Button tag is button") (assert (= btnNode.key "submit-btn") "Button key matches") (assert (= (listLength btnNode.children) 1) "Button has 1 child") (assert (= inputNode.tag "input") "Input tag is input") (assert (= inputNode.key "user-input") "Input key matches") (assert (= containerNode.tag "container") "Container tag is container") (assert (= (listLength containerNode.children) 2) "Container has 2 children") (assert (= canvasNode.tag "canvas") "Canvas tag is canvas") (assert (= canvasNode.width 800) "Canvas width is 800") (assert (= canvasNode.height 600) "Canvas height is 600") (assert (= modalNode.tag "modal") "Modal tag is modal") (assert modalNode.visible "Modal is visible") (assert (= listNode.tag "list") "List tag is list") (assert (= (listLength listNode.children) 2) "List has 2 children") (refute (= btnNode.tag "div") "Refutation: Button tag cannot be div") (refute (= textNode.key "") "Refutation: Text key cannot be empty") (refute (= (listLength containerNode.children) 0) "Refutation: Container children cannot be empty") (refute (not modalNode.visible) "Refutation: Modal must be visible") true)

fn testElmRuntimeLifecycleAndImmutableModel -> Bool
  (let [(initModel (elm/makeCounterModel 0 "initial")) (viewInitial (elm/renderCounterView initModel)) (msgInc (elm/makeMsg "increment" 1)) (stepRes1 (elm/stepRuntime initModel msgInc)) (model1 stepRes1.model) (cmd1 stepRes1.cmd) (view1 (elm/renderCounterView model1)) (msgDec (elm/makeMsg "decrement" 5)) (stepRes2 (elm/stepRuntime model1 msgDec)) (model2 stepRes2.model)] (assert (= initModel.count 0) "Initial model count is 0") (assert (= viewInitial.tag "container") "Initial view produces container VNode") (assert (= model1.count 1) "Model incremented to 1") (assert (= model1.label "count: 1") "Model label reflects increment") (assert (= cmd1.kind "none") "Increment emits none command") (assert (= model2.count -4) "Model decremented to -4") (assert (= initModel.count 0) "Initial model remains strictly unchanged (immutability)") (refute (= model1.count 0) "Refutation: Model count must advance on increment") (refute (= initModel.count 1) "Refutation: Original model must not be mutated") (refute (= view1.tag "") "Refutation: Rendered VNode tag cannot be empty") (refute (not (= model2.count -4)) "Refutation: Compound decrement must equal -4") true)

fn testDoubleBufferedFrameArenaAndAlignment -> Bool
  (let [(arenaState (arena/makeFrameArena 1024)) (nodeA (arena/allocFrameNode arenaState "btn-1" "button" 32)) (allocOffsetA (arena/getArenaAllocatedBytes arenaState)) (alignCheckA (mod allocOffsetA 8)) (swapState1 (arena/swapArenas arenaState)) (activeIdx1 swapState1.activeIdx) (nodeB (arena/allocFrameNode swapState1 "btn-2" "button" 48)) (allocOffsetB (arena/getArenaAllocatedBytes swapState1)) (alignCheckB (mod allocOffsetB 8)) (swapState2 (arena/swapArenas swapState1)) (activeIdx2 swapState2.activeIdx) (recycledOffset (arena/getArenaAllocatedBytes swapState2)) (smallArena (arena/makeFrameArena 64)) (overflowRes (arena/tryAllocFrameNode smallArena "huge-node" "container" 128))] (assert (= arenaState.activeIdx 0) "Initial arena active index is 0") (assert (ok? nodeA) "Node A allocation in Arena 0 succeeds") (assert (= alignCheckA 0) "Allocated byte offset is strictly 8-byte aligned") (assert (= activeIdx1 1) "First swap switches active arena to index 1") (assert (ok? nodeB) "Node B allocation in Arena 1 succeeds") (assert (= alignCheckB 0) "Arena 1 byte offset is strictly 8-byte aligned") (assert (= activeIdx2 0) "Second swap ping-pongs active arena back to index 0") (assert (= recycledOffset 0) "Ping-ponged arena memory is reset to 0 bytes for new frame") (assert (err? overflowRes) "Exceeding arena capacity triggers allocation error") (assert (mt overflowRes ((err e) (= e "ERR_ARENA_OVERFLOW")) ((ok _) false)) "Error code matches ERR_ARENA_OVERFLOW") (refute (= activeIdx1 0) "Refutation: Swap must change active arena index") (refute (not (= alignCheckA 0)) "Refutation: Offset must not violate 8-byte boundary") (refute (ok? overflowRes) "Refutation: Overflow allocation cannot succeed") (refute (> recycledOffset 0) "Refutation: Recycled frame arena offset must reset to 0") true)

fn testKeyedVNodeDiffingAndMutationRecords -> Bool
  (let [(childA1 (ui/makeText "A1" "k-a")) (childB1 (ui/makeText "B1" "k-b")) (childC1 (ui/makeText "C1" "k-c")) (oldTree (ui/makeContainer "root" (mapSet (mapEmpty) "theme" "light") (list childA1 childB1 childC1))) (childA2 (ui/makeText "A2-Updated" "k-a")) (childC2 (ui/makeText "C1" "k-c")) (childD2 (ui/makeText "D-New" "k-d")) (newTree (ui/makeContainer "root" (mapSet (mapEmpty) "theme" "dark") (list childC2 childA2 childD2))) (mutations (arena/diffVNodes oldTree newTree)) (hasAttrMutation (arena/hasMutationKind mutations "updateAttrs")) (hasInsertMutation (arena/hasMutationKind mutations "insert")) (hasRemoveMutation (arena/hasMutationKind mutations "remove")) (hasReorderMutation (arena/hasMutationKind mutations "reorder"))] (assert (> (listLength mutations) 0) "Diffing diverged trees produces mutation records") (assert hasAttrMutation "Attribute change from light to dark emits updateAttrs mutation") (assert hasInsertMutation "New child k-d emits insert mutation") (assert hasRemoveMutation "Removed child k-b emits remove mutation") (assert hasReorderMutation "Reordered children emit reorder mutation") (let [(identicalMutations (arena/diffVNodes oldTree oldTree))] (assert (= (listLength identicalMutations) 0) "Diffing identical trees yields zero mutation records")) (refute (= (listLength mutations) 0) "Refutation: Diverged trees must emit mutations") (refute (not hasAttrMutation) "Refutation: Attr mutation cannot be omitted") (refute (not hasInsertMutation) "Refutation: Insert mutation cannot be omitted") (refute (not hasRemoveMutation) "Refutation: Remove mutation cannot be omitted") (refute (not hasReorderMutation) "Refutation: Reorder mutation cannot be omitted") true)

fn testProductionMutantDefects -> Bool
  (let [(badKeyTree (ui/makeContainer "root" (mapEmpty) (list (ui/makeText "A" "dup-key") (ui/makeText "B" "dup-key")))) (dupValidation (ui/validateKeyUniqueness badKeyTree))] (assert (err? dupValidation) "Duplicate keys in child list are rejected") (assert (mt dupValidation ((err e) (= e "ERR_VNODE_DUPLICATE_KEY")) ((ok _) false)) "Error code matches ERR_VNODE_DUPLICATE_KEY") (refute (ok? dupValidation) "Refutation: Duplicate keys must never pass validation") true)

fn runTests -> Bool
  (let [(okDsl (testDeclarativeUiDslAndVNodePrimitives)) (okElm (testElmRuntimeLifecycleAndImmutableModel)) (okArena (testDoubleBufferedFrameArenaAndAlignment)) (okDiff (testKeyedVNodeDiffingAndMutationRecords)) (okMutant (testProductionMutantDefects))] (and (and (and (and okDsl okElm) okArena) okDiff) okMutant))

fn RunTests -> Bool
  (runTests)
