(module asl-ui/tests/modelTest
  :x [RunTests runTests]
  :i [(asl-ui/model :a model) (aslVdom/signals :a sig)])

fn runTests -> Bool
  (let [(style (model/defaultStyle))
        (label (model/text "label" "Ready" style))
        (countSignal (sig/makeSignal "count" "0"))
        (binding (model/makeBinding "count"))
        (activate (model/makeEvent "activate" "increment"))
        (buttonProps (mapSet (mapEmpty) "command" "increment"))
        (action (model/button "action" buttonProps style (list) (list activate) (some binding)))
        (row1 (model/tableRow "row-1" style (list (model/cell "cell-1" "Alpha" style))))
        (row2 (model/tableRow "row-2" style (list (model/cell "cell-2" "Beta" style))))
        (row3 (model/tableRow "row-3" style (list (model/cell "cell-3" "Gamma" style))))
        (grid (model/table "grid" style (list row1 row2 row3)))
        (root (model/column "root" (mapEmpty) style (list label action grid)))
        (updated (model/setSignalValue root countSignal "1"))
        (updatedRoot (pairFirst updated))
        (updatedSignal (pairSecond updated))
        (updatedAction (optionOr (listGet updatedRoot.children 1) action))
        (updatedGrid (optionOr (listGet updatedRoot.children 2) grid))
        (legacyRoot (model/toVNode root))
        (source (resultOr (fileReadString "asl/packages/asl-ui/src/model.asl") ""))]
    (assert (= root.kind "column") "root is a column")
    (assert (= root.key "root") "root key is data")
    (assert (= (listLength root.children) 3) "column contains text button and table")
    (assert (= legacyRoot.tag "container") "vnode adapter reuses the legacy container representation")
    (assert (= (listLength legacyRoot.children) 3) "vnode adapter preserves all model children")
    (assert (= label.kind "text") "first child is text")
    (assert (= label.text "Ready") "text content is data")
    (assert (= action.kind "button") "second child is a button")
    (assert (= (optionOr (mapGet action.props "command") "") "increment") "props are data")
    (assert (= (listLength action.events) 1) "button has one event handler")
    (assert (= activate.event "activate") "event name is declarative")
    (assert (= activate.message "increment") "event handler names a message")
    (assert (match action.binding ((some b) (= b.signalId "count")) ((none) false)) "button binding names the count signal")
    (assert (= grid.kind "table") "third child is a table")
    (assert (= (listLength grid.children) 3) "table has exactly three rows")
    (assert (= row1.kind "row") "first table child is a row")
    (assert (= (listLength row1.children) 1) "table row contains a declarative cell")
    (assert (= (optionOr (listHead row1.children) label).text "Alpha") "table cell content is data")
    (assert (= row2.key "row-2") "second row has its own key")
    (assert (= row3.key "row-3") "third row has its own key")
    (assert (= style.spacing 4) "style spacing comes from grid tokens")
    (assert (= style.typography.fontSize 14) "style typography comes from typography tokens")
    (assert (= (model/dirtyCount root) 0) "initial tree is clean")
    (assert (= (model/dirtyCount (model/markSignalDirty root "missing")) 0) "an unrelated signal leaves every node clean")
    (assert (= (sig/signalGet updatedSignal) "1") "signal update uses the shared signal implementation")
    (assert (= (model/dirtyCount updatedRoot) 1) "signal change marks exactly one node dirty")
    (assert updatedAction.dirty "the bound button is the dirty node")
    (assert (= updatedAction.key "action") "the dirty node is the button bound to the changed signal")
    (refute updatedRoot.dirty "unbound column remains clean")
    (refute (optionOr (listHead updatedRoot.children) label).dirty "unbound text remains clean")
    (refute updatedGrid.dirty "unbound table remains clean")
    (assert (= (listLength updatedGrid.children) 3) "signal update preserves all three table rows")
    (assert (= (model/dirtyCount updatedGrid) 0) "all table rows and cells remain clean")
    (assert (> (stringLength source) 0) "model source was read")
    (assert (stringContains? source "(module asl-ui/model") "model source belongs to the asl-ui model module")
    (assert (stringContains? source "(aslVdom/signals :a sig)") "model imports the shared signal implementation")
    (refute (stringContains? source "fn makeSignal") "model does not duplicate signal construction")
    (refute (stringContains? source "fn signalGet") "model does not duplicate signal reads")
    (refute (stringContains? source "fn signalSet") "model does not duplicate signal updates")
    (refute (stringContains? source "(schema Signal
") "model does not duplicate the shared signal schema")
    (refute (stringContains? source "<") "model source contains no markup tag literals")
    (refute (stringContains? source "background-color:") "model source contains no CSS property text")
    (refute (stringContains? source "className=") "model source contains no serialized UI markup attributes")
    true)

fn RunTests -> Bool
  (runTests)
