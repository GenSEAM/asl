(module asl-ui/tests/uiTest :x [RunTests runTests] :i [(asl-ui/vnode :a ui) (asl-ui/runtime :a elm) (asl-ui/arena :a arena) (asl-ui/layout :a layout) (asl-ui/tokens :a tokens) (asl-ui/theme :a theme) (asl-ui/ax :a ax) (asl-ui/query :a query) (asl-ui/renderWeb :a web) (asl-ui/renderNative :a native)])

fn testVNodeAndElmRuntime -> Bool
  (let [(btn (ui/makeButton "btn-submit" (mapEmpty) (list (ui/makeText "Click" "lbl-1")))) (validKeys (ui/validateKeyUniqueness btn)) (initModel (elm/makeCounterModel 10 "count: 10")) (incMsg (elm/makeMsg "increment" 5)) (stepRes (elm/stepRuntime initModel incMsg)) (nextModel stepRes.model) (viewTree (elm/renderCounterView nextModel))] (assert (= btn.tag "button") "Button tag is button") (assert (= btn.key "btn-submit") "Button key is btn-submit") (assert (ok? validKeys) "Valid unique keys pass validation") (assert (= nextModel.count 15) "Increment message updates counter to 15") (assert (= viewTree.tag "container") "Counter view renders container root") (refute (= nextModel.count 10) "Refutation: State must advance from initial count") true)

fn testFrameArenaAllocation -> Bool
  (let [(fArena (arena/makeFrameArena 1024)) (alloc1 (arena/allocFrameNode fArena "btn-1" "button" 64)) (swapped (arena/swapArenas fArena)) (smallArena (arena/makeFrameArena 64)) (overflowAlloc (arena/tryAllocFrameNode smallArena "huge-node" "container" 2048))] (assert (= fArena.activeIdx 0) "Initial arena active index is 0") (assert (ok? alloc1) "Valid allocation succeeds") (assert (= swapped.activeIdx 1) "Swapped arena active index is 1") (assert (err? overflowAlloc) "Allocation exceeding capacity returns error") (assert (mt overflowAlloc ((err e) (= e "ERR_ARENA_OVERFLOW")) ((ok _) false)) "Error code is ERR_ARENA_OVERFLOW") (refute (= swapped.activeIdx 0) "Refutation: Active index must change on arena swap") (refute (ok? overflowAlloc) "Refutation: Overflow allocation must never succeed") true)

fn testLayoutEngine -> Bool
  (let [(c (layout/makeConstraints 50 400 30 300)) (txt (ui/makeVNode "text" "t1" "Hello" (mapEmpty) (list) 80 20 true)) (dim (layout/measure txt c)) (box (layout/arrange txt (layout/makeRect 0 0 dim.width dim.height)))] (assert (= dim.width 80) "Intrinsic text width 80 within bounds") (assert (= dim.height 30) "Intrinsic text height 20 clamped to minHeight 30") (assert (= box.bounds.x 0) "Arranged box x is 0") (assert (= box.bounds.y 0) "Arranged box y is 0") (refute (< dim.height 30) "Refutation: Height must not drop below min constraint") true)

fn testTokensAndTheme -> Bool
  (let [(g1 (tokens/gridStep 1)) (g2 (tokens/gridStep 2)) (g4 (tokens/gridStep 4)) (tBody (tokens/getTypographyToken "body")) (cWhite (theme/makeColorToken "white" "#ffffff" 255 255 255)) (cBlack (theme/makeColorToken "black" "#000000" 0 0 0)) (ratio (theme/calculateContrastRatio cWhite cBlack)) (passAa (theme/verifyWcagAa cWhite cBlack))] (assert (= g1 4) "Grid step 1 is 4px") (assert (= g2 8) "Grid step 2 is 8px") (assert (= g4 16) "Grid step 4 is 16px") (assert (= tBody.fontSize 14) "Body font size is 14px") (assert (= ratio 2100) "Black-on-white contrast ratio is 21.00:1 (2100)") (assert passAa "Black-on-white passes WCAG AA") (refute (< ratio 450) "Refutation: Black-on-white must exceed WCAG AA threshold") true)

fn testAccessibilityAndAgentQuery -> Bool
  (let [(btn (ui/makeButton "btn-ok" (mapEmpty) (list (ui/makeText "OK" "lbl-ok")))) (inp (ui/makeInput "inp-query" (mapEmpty))) (box (ui/makeContainer "c-main" (mapEmpty) (list btn inp))) (axRoot (ax/projectAccessibilityTree box)) (qBtn (query/queryAxNodeByAnchor axRoot "btn-ok")) (allButtons (query/queryAllAxNodesByRole axRoot "button")) (rcpt (query/dispatchSemanticAction axRoot "click" "btn-ok" "")) (desc (query/describeAxNode axRoot))] (assert (= axRoot.role "group") "Root container role is group") (assert (some? qBtn) "Query finds btn-ok anchor") (assert (= (optionOr qBtn (ax/makeEmptyAXNode)).role "button") "Button node role is button") (assert (= (listLength allButtons) 1) "Exactly 1 button found in query") (assert (= rcpt.status "ok") "Click dispatch returns status ok") (assert (= rcpt.reason "SUCCESS") "Click dispatch returns reason SUCCESS") (assert (> (stringLength desc) 0) "AXNode description is non-empty") (refute (none? qBtn) "Refutation: Button anchor must exist") (refute (= rcpt.status "error") "Refutation: Click on enabled button must not fail") true)

fn testWebAssemblyAndNativeSurfaceHost -> Bool
  (let [(mInsert (arena/makeMutationRecordOfType "insert" "btn-1" "button")) (patches (web/applyDomMutations (list mInsert))) (p (optionOr (listHead patches) (web/makeEmptyDomPatch))) (vText (ui/makeText "Hello Native" "lbl-msg")) (vDiv (ui/makeContainer "c-box" (mapEmpty) (list vText))) (html (web/renderToHtml vDiv)) (stride (native/calculateFrameStride 800 4)) (surfRes (native/initNativeSurface "Native Host" 800 600)) (h (optionOr (resultToOption surfRes) -1)) (buf (native/generateSolidFrameBuffer 800 600 0 255 0)) (presentRes (native/presentNativeFrame h buf 4096)) (vsyncOk (native/syncVSync 60)) (unmapOk (native/verifyBufferUnmap h))] (assert (= p.opcode "DOM_INSERT") "Mutation insert maps to DOM_INSERT") (assert (stringContains? html "Hello Native") "Rendered HTML contains inner text") (assert (= stride 3200) "Row stride for 800 width is 3200 bytes") (assert (> h 0) "Native surface initialization returns valid handle") (assert (ok? presentRes) "Native frame presentation succeeds") (assert vsyncOk "VSync synchronization returns true") (assert unmapOk "Buffer unmapping is verified") (refute (= p.opcode "DOM_REMOVE") "Refutation: Insert mutation must not produce DOM_REMOVE") (refute (not vsyncOk) "Refutation: VSync must succeed") true)

fn runTests -> Bool
  (let [(okVnode (testVNodeAndElmRuntime)) (okArena (testFrameArenaAllocation)) (okLayout (testLayoutEngine)) (okTheme (testTokensAndTheme)) (okAx (testAccessibilityAndAgentQuery)) (okHost (testWebAssemblyAndNativeSurfaceHost))] (and (and (and (and (and okVnode okArena) okLayout) okTheme) okAx) okHost))

fn RunTests -> Bool
  (runTests)
