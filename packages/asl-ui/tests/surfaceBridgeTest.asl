(module asl/packages/asl-ui/tests/surfaceBridgeTest :x [RunTests runTests] :i [(asl-ui/vnode :a ui) (asl-ui/arena :a arena) (asl-ui/renderWeb :a web) (asl-ui/renderNative :a native)])

fn testWebAssemblyDomMutationApplicatorAndHtmlRendering -> Bool
  (let [(lbl (ui/makeText "Confirm Action" "lbl-1")) (btnAttrs (mapSet (mapEmpty) "class" "btn-primary")) (btn (ui/makeButton "btn-submit" btnAttrs (list lbl))) (boxAttrs (mapSet (mapEmpty) "id" "main-panel")) (panel (ui/makeContainer "container-1" boxAttrs (list btn))) (html (web/renderToHtml panel)) (mut1 (arena/makeMutationRecordOfType "insert" "btn-new" "button")) (mut2 (arena/makeMutationRecordOfType "remove" "btn-old" "button")) (mut3 (arena/makeMutationRecordOfType "update" "lbl-1" "text")) (mutList (list mut1 mut2 mut3)) (patches (web/applyDomMutations mutList)) (p1 (optionOr (listHead patches) (web/makeEmptyDomPatch))) (p2 (optionOr (listHead (optionOr (listTail patches) (list))) (web/makeEmptyDomPatch))) (p3 (optionOr (listHead (listReverse patches)) (web/makeEmptyDomPatch))) (resizeMsg (web/handleWebResize 1920 1080 2))] (assert (= (listLength patches) 3) "Applies 3 mutation records to exactly 3 DOM patches") (assert (= p1.opcode "DOM_INSERT") "Mutation insert maps to DOM_INSERT opcode") (assert (= p1.targetKey "btn-new") "First patch target key matches btn-new") (assert (= p2.opcode "DOM_REMOVE") "Mutation remove maps to DOM_REMOVE opcode") (assert (= p2.targetKey "btn-old") "Second patch target key matches btn-old") (assert (= p3.opcode "DOM_UPDATE") "Mutation update maps to DOM_UPDATE opcode") (assert (= p3.targetKey "lbl-1") "Third patch target key matches lbl-1") (assert (stringContains? html "<div") "Rendered HTML contains container div") (assert (stringContains? html "<button") "Rendered HTML contains button tag") (assert (stringContains? html "Confirm Action") "Rendered HTML contains inner text") (assert (stringContains? html "id=\"main-panel\"") "Rendered HTML preserves container id attribute") (assert (= resizeMsg.kind "resize") "Web resize handler emits resize message") (assert (= resizeMsg.value 1920) "Web resize message stores width in value") (refute (= p1.opcode "DOM_REMOVE") "Refutation: Insert mutation must not produce remove patch") (refute (= p2.opcode "DOM_INSERT") "Refutation: Remove mutation must not produce insert patch") (refute (= (listLength patches) 0) "Refutation: Patch list must not be empty") (refute (not (stringContains? html "Confirm Action")) "Refutation: Rendered HTML must contain inner text") true)

fn testNativeSurfaceHostPresentationAndVSync -> Bool
  (let [(initRes (native/initNativeSurface "AgentScript Window" 1024 768)) (h (optionOr (resultToOption initRes) -1)) (stride (native/calculateFrameStride 1024 4)) (testFrame (native/generateSolidFrameBuffer 1024 768 255 0 0)) (presentRes (native/presentNativeFrame h testFrame stride)) (resizeRes (native/resizeNativeSurface h 1280 800)) (vsyncPass (native/syncVSync 60)) (pollRes (native/pollNativeEvents h))] (assert (ok? initRes) "Native surface initialization succeeds") (assert (> h 0) "Surface handle is positive integer") (assert (= stride 4096) "RGBA32 frame stride for 1024 width is 4096 bytes (1024 * 4)") (assert (ok? presentRes) "Frame presentation with valid stride succeeds") (assert (ok? resizeRes) "Surface resize succeeds") (assert vsyncPass "VSync synchronization targets 60 FPS cleanly") (assert (ok? pollRes) "Polling native window events returns ok") (refute (= h -1) "Refutation: Handle must not be invalid -1 on successful init") (refute (< stride 4096) "Refutation: Frame stride must be at least width * bpp") (refute (err? presentRes) "Refutation: Valid frame presentation must not error") (refute (not vsyncPass) "Refutation: VSync sync must return true") true)

fn testCrossPlatformHostSurfacePrimitivesAndSafety -> Bool
  (let [(badHandle -99) (badPresentRes (native/presentNativeFrame badHandle "pixels" 4096)) (badResizeRes (native/resizeNativeSurface badHandle 800 600)) (badStride (native/calculateFrameStride -50 4)) (corruptedStride 100) (stridePresentRes (native/presentNativeFrame 1 "pixels" corruptedStride)) (closeRes (native/closeNativeSurface 1))] (assert (err? badPresentRes) "Presentation to invalid handle returns error") (assert (err? badResizeRes) "Resize of invalid handle returns error") (assert (= badStride 0) "Negative width calculates safe 0 stride") (assert (err? stridePresentRes) "Presentation with corrupted undersized stride is rejected") (assert (ok? closeRes) "Closing native surface frees buffer cleanly without leak") (refute (ok? badPresentRes) "Refutation: Invalid handle must never present successfully") (refute (ok? badResizeRes) "Refutation: Invalid handle must never resize successfully") (refute (< badStride 0) "Refutation: Stride calculation must never return negative value") (refute (ok? stridePresentRes) "Refutation: Corrupted stride must be rejected") true)

fn testProductionMutantDefectDetection -> Bool
  (let [(mutUnknown (arena/makeMutationRecordOfType "unknown_op" "key-1" "div")) (patchUnknown (web/applyDomMutations (list mutUnknown))) (p (optionOr (listHead patchUnknown) (web/makeEmptyDomPatch))) (strideClamp (native/calculateFrameStride 0 4)) (unmapVerified (native/verifyBufferUnmap 1))] (assert (= p.opcode "DOM_NOOP") "Unknown mutation opcode maps to safe DOM_NOOP") (assert (= strideClamp 0) "Zero width yields zero stride") (assert unmapVerified "Buffer unmapping is verified prior to frame swap") (refute (= p.opcode "DOM_INSERT") "Refutation: Unknown opcode must not default to DOM_INSERT") (refute (= p.opcode "DOM_REMOVE") "Refutation: Unknown opcode must not default to DOM_REMOVE") (refute (not unmapVerified) "Refutation: Buffer unmap omission must fail verification") true)

fn runTests -> Bool
  (let [(okWeb (testWebAssemblyDomMutationApplicatorAndHtmlRendering)) (okNative (testNativeSurfaceHostPresentationAndVSync)) (okSafety (testCrossPlatformHostSurfacePrimitivesAndSafety)) (okMutants (testProductionMutantDefectDetection))] (and (and (and okWeb okNative) okSafety) okMutants))

fn RunTests -> Bool
  (runTests)
