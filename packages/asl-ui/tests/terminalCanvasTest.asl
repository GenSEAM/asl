(module asl-ui/tests/terminalCanvasTest :x [testTerminalCanvas runTests] :i [(asl-ui/terminalCanvas :a tc)])

fn testTerminalCanvas -> Bool
  (let [(cell (tc/makeTerminalCell "A" "cyan" "default" true false))
        (defC (tc/defaultCell))
        (buf0 (tc/makeTerminalBuffer 40 10))
        (c0 (tc/getCell buf0 5 5))
        (buf1 (tc/setCell buf0 5 5 cell))
        (c1 (tc/getCell buf1 5 5))
        (buf2 (tc/fillBox buf1 2 2 3 2 "#" "green" "default"))
        (cBoxTL (tc/getCell buf2 2 2))
        (cBoxBR (tc/getCell buf2 4 3))
        (buf3 (tc/drawText buf2 10 1 "Sovereign Cockpit" "yellow" "default" true))
        (cTextFirst (tc/getCell buf3 10 1))
        (cTextLast (tc/getCell buf3 26 1))
        (buf4 (tc/drawBorder buf3 0 0 30 8 "Cockpit Pane" "double" "blue" "default"))
        (cBorderTL (tc/getCell buf4 0 0))
        (cBorderTR (tc/getCell buf4 29 0))
        (canvas0 (tc/makeTerminalCanvas 40 10))
        (canvas1 (tc/TerminalCanvas :width 40 :height 10 :frontBuffer canvas0.frontBuffer :backBuffer buf4))
        (diffStr (tc/renderAnsiDiff canvas1))]
    (assert (= cell.ch "A") "Cell character preserved")
    (assert (= cell.fg "cyan") "Cell color preserved")
    (assert cell.bold "Cell bold flag preserved")
    (assert (= defC.ch " ") "Default cell is blank space")
    (assert (= buf0.width 40) "Buffer width initialized")
    (assert (= buf0.height 10) "Buffer height initialized")
    (assert (= c0.ch " ") "Unset cell returns default")
    (assert (= c1.ch "A") "setCell stored character")
    (assert (= c1.fg "cyan") "setCell stored color")
    (assert (= cBoxTL.ch "#") "fillBox top-left correct")
    (assert (= cBoxBR.ch "#") "fillBox bottom-right correct")
    (assert (= cTextFirst.ch "S") "drawText first character correct")
    (assert (= cTextLast.ch "t") "drawText last character correct")
    (assert (= cBorderTL.ch "╔") "drawBorder double top-left corner")
    (assert (= cBorderTR.ch "╗") "drawBorder double top-right corner")
    (assert (not (stringEmpty? diffStr)) "renderAnsiDiff non-empty on dirty backBuffer")
    (assert (stringContains? diffStr "\x1b[") "renderAnsiDiff contains ANSI cursor jump")
    (assert (stringContains? diffStr "\x1b[3") "renderAnsiDiff contains color sequence")

    (refute (not (= (tc/getCell buf0 999 999).ch " "))
      "Out of bounds coordinate returns default cell without panic")

    (refute (not (stringEmpty? (tc/renderAnsiDiff (tc/makeTerminalCanvas 20 5))))
      "Identical front and back buffers produce empty diff string")
    true)

fn runTests -> Bool
  (testTerminalCanvas)
