(module asl-ui/terminalObservatoryTest :x [testTerminalObservatory runTests] :i [(asl-ui/terminalCanvas :a tc) (asl-ui/terminalObservatory :a to) (asl-ui/radarCard :a rc) (asl-ui/blastRadiusHeatmap :a hm) (asl-ui/vacuousMockDetector :a md) (asl-ui/sessionTile :a sess)])


fn testTerminalObservatory -> Bool
  (let [(bar90 (to/scoreToBarChar 95))
        (bar75 (to/scoreToBarChar 80))
        (bar50 (to/scoreToBarChar 60))
        (bar25 (to/scoreToBarChar 30))
        (bar0 (to/scoreToBarChar 10))
        (shadeRun (to/riskToShadeChar 10 true true))
        (shadeCyc (to/riskToShadeChar 8 true false))
        (shadeHigh (to/riskToShadeChar 6 false false))
        (spark (to/formatRadarSparkline 90 80 70 60 50 40))
        (snap (rc/makeRadarSnapshot 92 88 85 90 95 80 "3eb08be7"))
        (buf0 (tc/makeTerminalBuffer 60 25))
        (bufRadar (to/renderTerminalRadarCard buf0 0 0 50 8 snap))
        (cRadarTL (tc/getCell bufRadar 0 0))
        (cRadarTitle (tc/getCell bufRadar 3 0))
        (node1 (hm/makeBlastRadiusNode "asl-core" 12 true true))
        (node2 (hm/makeBlastRadiusNode "asl-ui" 3 false false))
        (bufHeatmap (to/renderTerminalHeatmap bufRadar 0 9 50 6 (list node1 node2)))
        (mock1 (md/makeVacuousMockItem "testVacuousStub" "tests/fooTest.asl" 0 0 (md/anomalyZeroAssertions) false))
        (mock2 (md/makeVacuousMockItem "validFunc" "src/foo.asl" 4 12 (md/anomalyCleanConstant) true))
        (bufMock (to/renderTerminalMockDetector bufHeatmap 0 16 50 5 (list mock1 mock2)))
        (sess1 (sess/makeSessionCardItem "target-steel" "Steel Stealth" 1 false (sess/statusRunning) "Crawling Docs"))
        (sess2 (sess/makeSessionCardItem "target-chrome" "Google Chrome" 4 true (sess/statusActive) "PR Review"))
        (bufSess (to/renderTerminalSessionTile bufMock 0 22 50 5 (list sess1 sess2)))
        (pkg1 (to/makePackageCouplingItem "asl-core" 21 0 0.0 "foundation" "verified"))
        (pkg2 (to/makePackageCouplingItem "asl-intel" 0 3 1.0 "orchestrator" "active"))
        (pkg3 (to/makePackageCouplingItem "asl-ui" 1 2 0.667 "bridge" "active"))
        (barStable (to/formatInstabilityBar 0.1))
        (barVolatile (to/formatInstabilityBar 0.75))
        (barDynamic (to/formatInstabilityBar 0.95))
        (bufMatrix (to/renderTerminalCouplingMatrix buf0 0 0 60 10 (list pkg1 pkg2 pkg3)))
        (cMatrixTL (tc/getCell bufMatrix 0 0))
        (bufIntel (to/renderTerminalIntelTile buf0 0 0 50 8 46 327 0 0))
        (cIntelTL (tc/getCell bufIntel 0 0))]
    (assert (= bar90 "█") "Score >= 90 renders full block")
    (assert (= bar75 "▓") "Score >= 75 renders dark shade")
    (assert (= bar50 "▒") "Score >= 50 renders medium shade")
    (assert (= bar25 "░") "Score >= 25 renders light shade")
    (assert (= bar0 " ") "Score < 25 renders space")
    (assert (= shadeRun "█") "Runtime cycle renders full block")
    (assert (= shadeCyc "▓") "Type cycle renders dark shade")
    (assert (= shadeHigh "▒") "High blast radius renders medium shade")
    (assert (= (listLength (stringChars spark)) 6) "Radar sparkline length is 6 axes")
    (assert (= cRadarTL.ch "╔") "Radar card border top-left is double")
    (assert (= cRadarTitle.ch "R") "Radar card title rendered")
    (assert (= bufSess.width 60) "Canvas buffer width preserved")
    (assert (= bufSess.height 25) "Canvas buffer height preserved")

    (assert (stringContains? barStable "Stable") "Instability <= 0.2 indicates Stable")
    (assert (stringContains? barVolatile "Volatile") "Instability <= 0.8 indicates Volatile")
    (assert (stringContains? barDynamic "Dynamic") "Instability > 0.8 indicates Dynamic")
    (assert (= pkg1.name "asl-core") "PackageCouplingItem name matches")
    (assert (= pkg1.fanIn 21) "PackageCouplingItem fanIn matches")
    (assert (= cMatrixTL.ch "┌") "Coupling matrix border top-left is single")
    (assert (= cIntelTL.ch "╔") "Intel tile border top-left is double")

    (refute (not (= (to/scoreToBarChar 100) "█"))
      "Max score must map to full block")

    (refute (stringEmpty? spark)
      "Radar sparkline must not be empty")

    (refute (stringContains? barStable "Dynamic")
      "Stable bar must not report dynamic instability")

    (refute (= pkg1.fanOut 99)
      "Core foundation must not have 99 fan-out")
    true)

fn runTests -> Bool
  (testTerminalObservatory)

