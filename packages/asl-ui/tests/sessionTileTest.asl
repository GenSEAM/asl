(module asl-ui/tests/sessionTileTest :x [runTests] :i [(asl-ui/vnode :a ui) (asl-ui/sessionTile :a sess)])

fn testSessionCardAndTileRendering -> Bool
  (let [(cChrome (sess/makeSessionCardItem "target-chrome-user" "Google Chrome (Ext)" 5 true (sess/statusActive) "PR Review")) (cSafari (sess/makeSessionCardItem "target-safari-user" "Safari (Ext)" 2 true (sess/statusIdle) "Standby")) (cSteel (sess/makeSessionCardItem "target-steel-01" "Steel Stealth" 1 false (sess/statusRunning) "Crawling Docs")) (cHost (sess/makeSessionCardItem "host-desktop-01" "macOS Desktop" 0 false (sess/statusActive) "AXTree Ready")) (vnode (sess/renderSessionTile (list cChrome cSafari cSteel cHost))) (cueAct (sess/formatSessionCue (sess/statusActive))) (cueRun (sess/formatSessionCue (sess/statusRunning))) (cueIdle (sess/formatSessionCue (sess/statusIdle))) (cueBlk (sess/formatSessionCue (sess/statusBlocked))) (hashVal (sess/calculateSessionTileHash (list cChrome cSafari cSteel cHost)))] (do (assert (= cueAct "[OK] Active") "Active cue matches format") (assert (= cueRun "[RUN] Executing") "Running cue matches format") (assert (= cueIdle "[IDLE] Standby") "Idle cue matches format") (assert (= cueBlk "[BLOCKED] Safety Hold") "Blocked cue matches format") (assert (= vnode.tag "container") "Rendered session tile is container VNode") (assert (= vnode.key "session-tile-root") "Root container key is session-tile-root") (assert (> hashVal 0) "Session tile hash is strictly positive") (refute (= cueAct "[FAIL] Failed") "Active cue must not be failed") true))

fn runTests -> Bool
  (testSessionCardAndTileRendering)
