(module asl/packages/asl-ui/tests/axProjectionTest :x [RunTests runTests] :i [(asl-ui/vnode :a ui) (asl-ui/runtime :a elm) (asl-ui/ax :a ax) (asl-ui/query :a query)])

fn testAccessibilityTreeProjectionAndRoleMapping -> Bool
  (let [(lbl (ui/makeText "Submit Application" "lbl-sub")) (btnAttrs (mapSet (mapSet (mapEmpty) "aria-label" "Submit Form") "disabled" "false")) (btn (ui/makeButton "btn-submit" btnAttrs (list lbl))) (inputAttrs (mapSet (mapSet (mapEmpty) "type" "text") "placeholder" "Enter your username")) (txtInput (ui/makeInput "input-username" inputAttrs)) (chkAttrs (mapSet (mapSet (mapEmpty) "type" "checkbox") "aria-label" "Agree to Terms")) (chkInput (ui/makeInput "input-terms" chkAttrs)) (disAttrs (mapSet (mapEmpty) "disabled" "true")) (disBtn (ui/makeButton "btn-cancel" disAttrs (list (ui/makeText "Cancel" "lbl-cancel")))) (hidAttrs (mapSet (mapEmpty) "hidden" "true")) (hidText (ui/makeText "Secret Data" "txt-secret")) (hidBox (ui/makeContainer "box-hidden" hidAttrs (list hidText))) (canvasAttrs (mapSet (mapEmpty) "aria-label" "Quarterly Sales Chart")) (canvasNode (ui/makeVNode "canvas" "cv-chart" "" canvasAttrs (list) 600 400 true)) (listItems (list (ui/makeText "Step 1" "step-1") (ui/makeText "Step 2" "step-2"))) (listNode (ui/makeList "nav-list" listItems)) (modalChildren (list (ui/makeText "Confirm Exit?" "modal-title") (ui/makeButton "btn-confirm" (mapEmpty) (list (ui/makeText "Yes" "lbl-yes"))) (ui/makeButton "btn-dismiss" (mapEmpty) (list (ui/makeText "No" "lbl-no"))))) (modalNode (ui/makeModal "modal-exit" true modalChildren)) (rootChildren (list btn txtInput chkInput disBtn hidBox canvasNode listNode modalNode)) (rootContainer (ui/makeContainer "app-root" (mapEmpty) rootChildren)) (axRoot (ax/projectAccessibilityTree rootContainer)) (axChildren axRoot.children) (axBtn (optionOr (listHead axChildren) (ax/makeEmptyAXNode))) (axInput (optionOr (listHead (optionOr (listTail axChildren) (list))) (ax/makeEmptyAXNode))) (axDisBtn (query/queryAxNodeByAnchor axRoot "btn-cancel")) (axCanvas (query/queryAxNodeByAnchor axRoot "cv-chart")) (axModal (query/queryAxNodeByAnchor axRoot "modal-exit")) (axList (query/queryAxNodeByAnchor axRoot "nav-list"))] (assert (= axRoot.role "group") "Root container projects to group role") (assert (= axRoot.anchor "app-root") "Root container anchor matches app-root") (assert (= axBtn.role "button") "Button projects to button role") (assert (= axBtn.name "Submit Form") "Button resolves aria-label over inner text") (assert (not axBtn.disabled) "Button is enabled") (assert (= axInput.role "textbox") "Text input projects to textbox role") (assert (some? axDisBtn) "Disabled button is present in accessibility tree") (assert (optionOr axDisBtn (ax/makeEmptyAXNode)).disabled "Disabled button has disabled property true") (assert (some? axCanvas) "Canvas is present in accessibility tree") (assert (= (optionOr axCanvas (ax/makeEmptyAXNode)).role "img") "Canvas projects to img role") (assert (= (optionOr axCanvas (ax/makeEmptyAXNode)).name "Quarterly Sales Chart") "Canvas name resolves aria-label") (assert (some? axModal) "Modal is present in accessibility tree") (assert (= (optionOr axModal (ax/makeEmptyAXNode)).role "dialog") "Modal projects to dialog role") (assert (optionOr axModal (ax/makeEmptyAXNode)).ariaModal "Modal has ariaModal true") (assert (some? axList) "List is present in accessibility tree") (assert (= (optionOr axList (ax/makeEmptyAXNode)).role "list") "List projects to list role") (refute (= axBtn.role "textbox") "Refutation: Button must not project to textbox role") (refute (= axInput.role "button") "Refutation: Text input must not project to button role") (refute (= (optionOr axCanvas (ax/makeEmptyAXNode)).role "button") "Refutation: Canvas must not project to button role") (refute (not (optionOr axModal (ax/makeEmptyAXNode)).ariaModal) "Refutation: Modal dialog must have ariaModal true") (refute (not (optionOr axDisBtn (ax/makeEmptyAXNode)).disabled) "Refutation: Disabled button must have disabled flag true") true)

fn testAccessibleNameResolutionHierarchy -> Bool
  (let [(lblNode (ui/makeText "Heading Title" "title-id")) (n1Attrs (mapSet (mapSet (mapEmpty) "aria-label" "Priority Label") "aria-labelledby" "title-id")) (n1 (ui/makeButton "btn-1" n1Attrs (list (ui/makeText "Inner Button Text" "t1")))) (n2Attrs (mapSet (mapEmpty) "aria-labelledby" "title-id")) (n2 (ui/makeButton "btn-2" n2Attrs (list (ui/makeText "Inner Button Text" "t2")))) (n3 (ui/makeButton "btn-3" (mapEmpty) (list (ui/makeText "Only Inner Text" "t3")))) (n4 (ui/makeButton "btn-4" (mapEmpty) (list))) (testContainer (ui/makeContainer "test-box" (mapEmpty) (list lblNode n1 n2 n3 n4))) (axTree (ax/projectAccessibilityTree testContainer)) (ax1 (optionOr (query/queryAxNodeByAnchor axTree "btn-1") (ax/makeEmptyAXNode))) (ax2 (optionOr (query/queryAxNodeByAnchor axTree "btn-2") (ax/makeEmptyAXNode))) (ax3 (optionOr (query/queryAxNodeByAnchor axTree "btn-3") (ax/makeEmptyAXNode))) (ax4 (optionOr (query/queryAxNodeByAnchor axTree "btn-4") (ax/makeEmptyAXNode)))] (assert (= ax1.name "Priority Label") "Tier 1: aria-label wins over aria-labelledby and inner text") (assert (= ax2.name "Heading Title") "Tier 2: aria-labelledby resolves to target element text") (assert (= ax3.name "Only Inner Text") "Tier 3: inner text used when no ARIA attributes exist") (assert (= ax4.name "btn-4") "Tier 4: anchor used as fallback when no text or ARIA attributes exist") (refute (= ax1.name "Inner Button Text") "Refutation: Tier 1 aria-label must not be overridden by inner text") (refute (= ax1.name "Heading Title") "Refutation: Tier 1 aria-label must not be overridden by aria-labelledby") (refute (= ax2.name "Inner Button Text") "Refutation: Tier 2 aria-labelledby must not be overridden by inner text") (refute (= ax3.name "btn-3") "Refutation: Tier 3 inner text must take precedence over anchor fallback") true)

fn testSymbolicAgentPerceptionQueryEngine -> Bool
  (let [(b1 (ui/makeButton "btn-save" (mapEmpty) (list (ui/makeText "Save" "l1")))) (b2 (ui/makeButton "btn-delete" (mapEmpty) (list (ui/makeText "Delete" "l2")))) (b3 (ui/makeButton "btn-help" (mapEmpty) (list (ui/makeText "Help" "l3")))) (in1 (ui/makeInput "txt-name" (mapEmpty))) (in2 (ui/makeInput "txt-email" (mapEmpty))) (box (ui/makeContainer "form-box" (mapEmpty) (list b1 b2 b3 in1 in2))) (axTree (ax/projectAccessibilityTree box)) (qSave (query/queryAxNodeByAnchor axTree "btn-save")) (qMissing (query/queryAxNodeByAnchor axTree "ghost-anchor")) (allButtons (query/queryAllAxNodesByRole axTree "button")) (allInputs (query/queryAllAxNodesByRole axTree "textbox")) (allNonexistent (query/queryAllAxNodesByRole axTree "nonexistent-role")) (desc (query/describeAxNode (optionOr qSave (ax/makeEmptyAXNode))))] (assert (some? qSave) "Querying existing anchor returns some") (assert (= (optionOr qSave (ax/makeEmptyAXNode)).anchor "btn-save") "Resolved node anchor is btn-save") (assert (= (optionOr qSave (ax/makeEmptyAXNode)).role "button") "Resolved node role is button") (assert (none? qMissing) "Querying non-existent anchor returns none") (assert (= (listLength allButtons) 3) "Querying all buttons returns exactly 3 nodes") (assert (= (listLength allInputs) 2) "Querying all textboxes returns exactly 2 nodes") (assert (= (listLength allNonexistent) 0) "Querying invalid role returns empty list") (assert (> (stringLength desc) 0) "Symbolic description is non-empty") (refute (none? qSave) "Refutation: Existing anchor query must not return none") (refute (some? qMissing) "Refutation: Missing anchor query must never return some") (refute (= (listLength allButtons) 0) "Refutation: Button query list must not be empty") (refute (= (listLength allInputs) 0) "Refutation: Textbox query list must not be empty") true)

fn testProgrammaticSemanticActionDispatch -> Bool
  (let [(btnSubmit (ui/makeButton "btn-submit" (mapEmpty) (list (ui/makeText "Submit" "ls")))) (disAttrs (mapSet (mapEmpty) "disabled" "true")) (btnDisabled (ui/makeButton "btn-disabled" disAttrs (list (ui/makeText "Blocked" "lb")))) (hidAttrs (mapSet (mapEmpty) "hidden" "true")) (btnHidden (ui/makeButton "btn-hidden" hidAttrs (list (ui/makeText "Invisible" "lh")))) (inputTxt (ui/makeInput "txt-search" (mapEmpty))) (formContainer (ui/makeContainer "main-form" (mapEmpty) (list btnSubmit btnDisabled btnHidden inputTxt))) (axTree (ax/projectAccessibilityTree formContainer)) (rcptOk (query/dispatchSemanticAction axTree "click" "btn-submit" "")) (rcptDisabled (query/dispatchSemanticAction axTree "click" "btn-disabled" "")) (rcptHidden (query/dispatchSemanticAction axTree "click" "btn-hidden" "")) (rcptMissing (query/dispatchSemanticAction axTree "click" "btn-unknown" "")) (rcptInputOk (query/dispatchSemanticAction axTree "input" "txt-search" "quantum computing")) (rcptInputMissing (query/dispatchSemanticAction axTree "input" "missing-input" "test"))] (assert (= rcptOk.status "ok") "Clicking enabled button produces status ok") (assert (= rcptOk.reason "SUCCESS") "Clicking enabled button produces reason SUCCESS") (assert (= rcptOk.anchor "btn-submit") "Receipt records target anchor btn-submit") (assert (some? rcptOk.msg) "Successful click receipt carries generated Elm Msg") (assert (= rcptDisabled.status "error") "Clicking disabled button produces status error") (assert (= rcptDisabled.reason "DISABLED") "Clicking disabled button produces reason DISABLED") (assert (none? rcptDisabled.msg) "Disabled click receipt has no Msg") (assert (= rcptHidden.status "error") "Clicking hidden control produces status error") (assert (= rcptHidden.reason "HIDDEN") "Clicking hidden control produces reason HIDDEN") (assert (= rcptMissing.status "error") "Clicking missing control produces status error") (assert (= rcptMissing.reason "NOT_FOUND") "Clicking missing control produces reason NOT_FOUND") (assert (= rcptInputOk.status "ok") "Inputting text into enabled textbox produces status ok") (assert (= rcptInputOk.reason "SUCCESS") "Inputting text into enabled textbox produces reason SUCCESS") (assert (= rcptInputMissing.status "error") "Inputting text into missing textbox produces status error") (refute (= rcptDisabled.status "ok") "Refutation: Disabled action must not succeed") (refute (= rcptHidden.status "ok") "Refutation: Hidden action must not succeed") (refute (= rcptMissing.status "ok") "Refutation: Missing control action must not succeed") (refute (some? rcptDisabled.msg) "Refutation: Disabled action must not emit Msg") (refute (some? rcptMissing.msg) "Refutation: Missing control action must not emit Msg") true)

fn testProductionMutantFaultDetection -> Bool
  (let [(b1 (ui/makeButton "b1" (mapEmpty) (list (ui/makeText "Ok" "l1")))) (b2 (ui/makeButton "b2" (mapEmpty) (list (ui/makeText "Cancel" "l2")))) (in1 (ui/makeInput "i1" (mapEmpty))) (staticText (ui/makeText "Static Description" "txt-static")) (modal (ui/makeModal "modal-diag" true (list staticText b1 in1 b2))) (axModal (ax/projectAccessibilityTree modal)) (focusTrapList (ax/getFocusTrappedTargets axModal)) (firstFocus (optionOr (listHead focusTrapList) "none")) (lastFocus (optionOr (listHead (listReverse focusTrapList)) "none"))] (assert (= (listLength focusTrapList) 3) "Focus trap contains exactly 3 interactive targets (2 buttons, 1 input)") (assert (= firstFocus "b1") "First focus trap target is b1") (assert (= lastFocus "b2") "Last focus trap target is b2") (assert (not (listContains? focusTrapList "txt-static")) "Static text is excluded from modal focus trap") (refute (= (listLength focusTrapList) 4) "Refutation: Non-interactive static text must never enter focus trap list") (refute (listContains? focusTrapList "txt-static") "Refutation: Static text must not be focus trapped") (refute (= firstFocus "txt-static") "Refutation: First focus target must not be static text") (refute (= lastFocus "txt-static") "Refutation: Last focus target must not be static text") true)

fn runTests -> Bool
  (let [(okRoles (testAccessibilityTreeProjectionAndRoleMapping)) (okNames (testAccessibleNameResolutionHierarchy)) (okQuery (testSymbolicAgentPerceptionQueryEngine)) (okAction (testProgrammaticSemanticActionDispatch)) (okMutants (testProductionMutantFaultDetection))] (and (and (and (and okRoles okNames) okQuery) okAction) okMutants))

fn RunTests -> Bool
  (runTests)
