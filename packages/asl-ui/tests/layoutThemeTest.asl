(module asl/packages/asl-ui/tests/layoutThemeTest :x [RunTests runTests] :i [(asl-ui/vnode :a ui) (asl-ui/layout :a layout) (asl-ui/tokens :a tokens) (asl-ui/theme :a theme)])

fn testConstraintResolutionAnd0Clamping -> Bool
  (let [(c1 (layout/makeConstraints 100 300 50 200)) (cUnconstrained (layout/makeConstraints 0 -1 0 -1)) (dimClampW1 (layout/clampDim 100 50 300)) (dimClampW2 (layout/clampDim 100 500 300)) (dimClampW3 (layout/clampDim 100 200 300)) (dimClampNeg (layout/clampDim 0 -40 200)) (dimClampZero (layout/clampDim 0 0 100)) (dimClampH1 (layout/clampDim 50 20 200)) (dimClampH2 (layout/clampDim 50 250 200)) (dimClampH3 (layout/clampDim 50 120 200)) (resUnconstrainedW (layout/resolveConstraint 0 -1 180)) (resUnconstrainedH (layout/resolveConstraint 0 -1 240)) (resConstrainedW (layout/resolveConstraint 100 300 50)) (resConstrainedH (layout/resolveConstraint 50 200 350))] (assert (= c1.minWidth 100) "Constraints minWidth matches") (assert (= c1.maxWidth 300) "Constraints maxWidth matches") (assert (= c1.minHeight 50) "Constraints minHeight matches") (assert (= c1.maxHeight 200) "Constraints maxHeight matches") (assert (= dimClampW1 100) "Value below min width is clamped to minWidth") (assert (= dimClampW2 300) "Value above max width is clamped to maxWidth") (assert (= dimClampW3 200) "Value within range is preserved for width") (assert (= dimClampNeg 0) "Negative value is clamped to 0 non-negative lower bound") (assert (= dimClampZero 0) "Zero value is preserved at lower bound 0") (assert (= dimClampH1 50) "Value below min height is clamped to minHeight") (assert (= dimClampH2 200) "Value above max height is clamped to maxHeight") (assert (= dimClampH3 120) "Value within range is preserved for height") (assert (= resUnconstrainedW 180) "Unconstrained axis adopts intrinsic width") (assert (= resUnconstrainedH 240) "Unconstrained axis adopts intrinsic height") (assert (= resConstrainedW 100) "Constrained axis clamps intrinsic below min") (assert (= resConstrainedH 200) "Constrained axis clamps intrinsic above max") (refute (= dimClampW1 50) "Refutation: Clamped width must not remain below min") (refute (= dimClampW2 500) "Refutation: Clamped width must not exceed max") (refute (< dimClampNeg 0) "Refutation: Clamped dimension must never be negative") (refute (= resConstrainedW 50) "Refutation: Constraint resolution must never violate min bound") (refute (= resConstrainedH 350) "Refutation: Constraint resolution must never violate max bound") true)

fn testTwoPassLayoutEngineMeasureAndArrange -> Bool
  (let [(btnAttrs (mapSet (mapSet (mapEmpty) "width" "120") "height" "40")) (btnNode (ui/makeButton "btn-1" btnAttrs (list (ui/makeText "Submit" "btn-lbl")))) (inputAttrs (mapSet (mapSet (mapEmpty) "width" "200") "height" "32")) (inputNode (ui/makeInput "inp-1" inputAttrs)) (textAttrs (mapSet (mapSet (mapEmpty) "width" "160") "height" "24")) (textNode (ui/makeVNode "text" "txt-1" "Sample Text" textAttrs (list) 160 24 true)) (colAttrs (mapSet (mapSet (mapEmpty) "layout" "column") "gap" "8")) (colContainer (ui/makeContainer "col-box" colAttrs (list btnNode inputNode textNode))) (cLoose (layout/makeConstraints 0 800 0 600)) (colMeasured (layout/measure colContainer cLoose)) (parentBounds (layout/makeRect 0 0 colMeasured.width colMeasured.height)) (colArranged (layout/arrange colContainer parentBounds)) (colChildren colArranged.children) (box1 (optionOr (listHead colChildren) (layout/makeLayoutBox "" "" (layout/makeRect 0 0 0 0) (list)))) (tail1 (optionOr (listTail colChildren) (list))) (box2 (optionOr (listHead tail1) (layout/makeLayoutBox "" "" (layout/makeRect 0 0 0 0) (list)))) (tail2 (optionOr (listTail tail1) (list))) (box3 (optionOr (listHead tail2) (layout/makeLayoutBox "" "" (layout/makeRect 0 0 0 0) (list)))) (rowAttrs (mapSet (mapSet (mapEmpty) "layout" "row") "gap" "16")) (rowContainer (ui/makeContainer "row-box" rowAttrs (list btnNode inputNode textNode))) (rowMeasured (layout/measure rowContainer cLoose)) (rowParentBounds (layout/makeRect 10 20 rowMeasured.width rowMeasured.height)) (rowArranged (layout/arrange rowContainer rowParentBounds)) (rowChildren rowArranged.children) (rBox1 (optionOr (listHead rowChildren) (layout/makeLayoutBox "" "" (layout/makeRect 0 0 0 0) (list)))) (rTail1 (optionOr (listTail rowChildren) (list))) (rBox2 (optionOr (listHead rTail1) (layout/makeLayoutBox "" "" (layout/makeRect 0 0 0 0) (list)))) (rTail2 (optionOr (listTail rTail1) (list))) (rBox3 (optionOr (listHead rTail2) (layout/makeLayoutBox "" "" (layout/makeRect 0 0 0 0) (list))))] (assert (= colMeasured.width 200) "Column layout width equals maximum child width") (assert (= colMeasured.height 112) "Column layout height equals sum of child heights plus gaps (40+32+24+8+8 = 112)") (assert (= colArranged.bounds.x 0) "Column container x position matches bounds") (assert (= colArranged.bounds.y 0) "Column container y position matches bounds") (assert (= colArranged.bounds.width 200) "Column container arranged width matches") (assert (= colArranged.bounds.height 112) "Column container arranged height matches") (assert (= box1.key "btn-1") "Child 1 key matches btn-1") (assert (= box1.bounds.x 0) "Child 1 x offset is 0") (assert (= box1.bounds.y 0) "Child 1 y offset is 0") (assert (= box1.bounds.width 120) "Child 1 width is 120") (assert (= box1.bounds.height 40) "Child 1 height is 40") (assert (= box2.key "inp-1") "Child 2 key matches inp-1") (assert (= box2.bounds.x 0) "Child 2 x offset is 0") (assert (= box2.bounds.y 48) "Child 2 y offset is 48 (40 + 8 gap)") (assert (= box2.bounds.width 200) "Child 2 width is 200") (assert (= box2.bounds.height 32) "Child 2 height is 32") (assert (= box3.key "txt-1") "Child 3 key matches txt-1") (assert (= box3.bounds.x 0) "Child 3 x offset is 0") (assert (= box3.bounds.y 88) "Child 3 y offset is 88 (48 + 32 + 8 gap)") (assert (= box3.bounds.width 160) "Child 3 width is 160") (assert (= box3.bounds.height 24) "Child 3 height is 24") (assert (= rowMeasured.width 512) "Row layout width equals sum of child widths plus gaps (120+200+160+16+16 = 512)") (assert (= rowMeasured.height 40) "Row layout height equals maximum child height (40)") (assert (= rBox1.bounds.x 10) "Row child 1 x offset includes parent x 10") (assert (= rBox1.bounds.y 20) "Row child 1 y offset includes parent y 20") (assert (= rBox2.bounds.x 146) "Row child 2 x offset is 10 + 120 + 16 gap = 146") (assert (= rBox3.bounds.x 362) "Row child 3 x offset is 146 + 200 + 16 gap = 362") (refute (= colMeasured.height 96) "Refutation: Column height must account for inter-element gaps") (refute (= rowMeasured.width 480) "Refutation: Row width must account for inter-element gaps") (refute (= box2.bounds.y 40) "Refutation: Child 2 y offset must include gap") (refute (= box3.bounds.y 72) "Refutation: Child 3 y offset must include cumulative gap") (refute (= rBox2.bounds.x 130) "Refutation: Row child 2 x offset must include gap") (refute (= rBox3.bounds.x 330) "Refutation: Row child 3 x offset must include cumulative gap") true)

fn testSpatialGridTokensAndTypography -> Bool
  (let [(step1 (tokens/gridStep 1)) (step2 (tokens/gridStep 2)) (step3 (tokens/gridStep 3)) (step4 (tokens/gridStep 4)) (step6 (tokens/gridStep 6)) (step8 (tokens/gridStep 8)) (step12 (tokens/gridStep 12)) (step16 (tokens/gridStep 16)) (tCaption (tokens/getTypographyToken "caption")) (tBody (tokens/getTypographyToken "body")) (tTitle (tokens/getTypographyToken "title")) (tDisplay (tokens/getTypographyToken "display"))] (assert (= step1 4) "Grid step 1 produces 4px sub-grid step") (assert (= step2 8) "Grid step 2 produces 8px canonical base grid step") (assert (= step3 12) "Grid step 3 produces 12px step") (assert (= step4 16) "Grid step 4 produces 16px double step") (assert (= step6 24) "Grid step 6 produces 24px triple step") (assert (= step8 32) "Grid step 8 produces 32px quadruple step") (assert (= step12 48) "Grid step 12 produces 48px major step") (assert (= step16 64) "Grid step 16 produces 64px hero step") (assert (= tCaption.role "caption") "Caption role matches") (assert (= tCaption.fontSize 12) "Caption font size is 12px") (assert (= tCaption.lineHeight 16) "Caption line height is 16px") (assert (= tCaption.fontWeight 400) "Caption font weight is regular 400") (assert (= tBody.role "body") "Body role matches") (assert (= tBody.fontSize 14) "Body font size is 14px") (assert (= tBody.lineHeight 20) "Body line height is 20px") (assert (= tBody.fontWeight 400) "Body font weight is regular 400") (assert (= tTitle.role "title") "Title role matches") (assert (= tTitle.fontSize 20) "Title font size is 20px") (assert (= tTitle.lineHeight 28) "Title line height is 28px") (assert (= tTitle.fontWeight 600) "Title font weight is semibold 600") (assert (= tDisplay.role "display") "Display role matches") (assert (= tDisplay.fontSize 28) "Display font size is 28px") (assert (= tDisplay.lineHeight 36) "Display line height is 36px") (assert (= tDisplay.fontWeight 700) "Display font weight is bold 700") (refute (= step2 10) "Refutation: Grid step 2 must not use decimal 10px") (refute (= step4 20) "Refutation: Grid step 4 must scale by 4px factor") (refute (= tBody.fontSize 16) "Refutation: Standard body font size is 14px") (refute (= tTitle.lineHeight 20) "Refutation: Title line height must provide vertical rhythm") true)

fn testWcagColorContrastAndPaletteValidation -> Bool
  (let [(darkTheme (theme/defaultDarkTheme)) (lightTheme (theme/defaultLightTheme)) (black (theme/makeColorToken "pure-black" "#000000" 0 0 0)) (white (theme/makeColorToken "pure-white" "#ffffff" 255 255 255)) (slateBg (theme/makeColorToken "slate-900" "#0f172a" 15 23 42)) (slateFg (theme/makeColorToken "slate-50" "#f8fafc" 248 250 252)) (lowFg (theme/makeColorToken "slate-400" "#94a3b8" 148 163 184)) (lowBg (theme/makeColorToken "slate-600" "#475569" 71 85 105)) (lumBlack (theme/calculateLuminance black)) (lumWhite (theme/calculateLuminance white)) (lumSlateBg (theme/calculateLuminance slateBg)) (lumSlateFg (theme/calculateLuminance slateFg)) (ratioBw (theme/calculateContrastRatio white black)) (ratioSlate (theme/calculateContrastRatio slateFg slateBg)) (ratioLow (theme/calculateContrastRatio lowFg lowBg)) (passAaHigh (theme/verifyWcagAa slateFg slateBg)) (passAaaHigh (theme/verifyWcagAaa slateFg slateBg)) (passAaLow (theme/verifyWcagAa lowFg lowBg)) (valDark (theme/validateThemeContrast darkTheme)) (valLight (theme/validateThemeContrast lightTheme))] (assert (= lumBlack 0) "Black luminance is 0") (assert (= lumWhite 10000) "White luminance normalized to 10000") (assert (> lumSlateFg lumSlateBg) "High contrast foreground luminance exceeds background") (assert (= ratioBw 2100) "Pure black and white contrast ratio is exactly 21.00:1 (2100 fixed-point)") (assert (>= ratioSlate 700) "Slate-50 on slate-900 contrast ratio exceeds 7.00:1 AAA threshold") (assert (< ratioLow 450) "Muted slate-400 on slate-600 contrast ratio is below 4.5:1 AA threshold") (assert passAaHigh "High contrast text passes WCAG AA") (assert passAaaHigh "High contrast text passes WCAG AAA") (assert (not passAaLow) "Low contrast text fails WCAG AA") (assert (ok? valDark) "Default dark theme passes comprehensive WCAG contrast validation") (assert (ok? valLight) "Default light theme passes comprehensive WCAG contrast validation") (refute (= ratioBw 100) "Refutation: Black and white cannot have 1:1 contrast ratio") (refute (< ratioSlate 700) "Refutation: Slate theme text cannot drop below AAA threshold") (refute passAaLow "Refutation: Low contrast pair must never pass AA") (refute (err? valDark) "Refutation: Default dark theme must not fail validation") (refute (err? valLight) "Refutation: Default light theme must not fail validation") true)

fn testProductionMutantDefects -> Bool
  (let [(cInverted (layout/makeConstraints 400 200 100 50)) (resInvertedW (layout/resolveConstraint 400 200 250)) (cNeg (layout/clampDim 100 -50 300)) (stepBad (tokens/gridStep 0)) (tokenMissing (tokens/getTypographyToken "unknown-role"))] (assert (= resInvertedW 400) "Inverted constraint min > max resolves safely to min bound") (assert (= cNeg 100) "Negative value clamped against positive min bound yields min bound") (assert (= stepBad 0) "Grid step 0 yields 0px") (assert (= tokenMissing.role "body") "Unknown typography role falls back to body") (refute (< resInvertedW 200) "Refutation: Inverted constraint must not produce out-of-bounds dimension") (refute (< cNeg 0) "Refutation: Clamping must never preserve negative value when min is positive") (refute (< stepBad 0) "Refutation: Grid step must never be negative") (refute (= tokenMissing.role "display") "Refutation: Fallback role must not default to display") true)

fn runTests -> Bool
  (let [(okClamp (testConstraintResolutionAnd0Clamping)) (okLayout (testTwoPassLayoutEngineMeasureAndArrange)) (okTokens (testSpatialGridTokensAndTypography)) (okTheme (testWcagColorContrastAndPaletteValidation)) (okMutant (testProductionMutantDefects))] (and (and (and (and okClamp okLayout) okTokens) okTheme) okMutant))

fn RunTests -> Bool
  (runTests)
