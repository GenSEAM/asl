(:doc :symbol "asl/packages/asl-ui/src/model.asl#UiStyle" :text "schema of a node style: typography (TypographyToken), foreground and background (ColorToken) and spacing (Int64)")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#EventHandler" :text "schema of an event binding: event and message, both String")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#SignalBinding" :text "schema of a signal binding: signalId String")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#UiNode" :text "schema of a UI node: kind, key, props (Map String String), style, children (List UiNode), events, binding (Option SignalBinding), text and dirty (Bool)")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#makeStyle" :text "typography foreground background spacingStep: a UiStyle whose spacing is tokens/gridStep of spacingStep")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#defaultStyle" :text "the UiStyle of the body typography token, the default dark theme fgPrimary on bgSurface, grid step 1")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#makeEvent" :text "event message: an EventHandler with those fields")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#makeBinding" :text "signalId: a SignalBinding for that signal")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#makeNode" :text "kind key props style children events binding content: a UiNode with those fields, content as its text and dirty false")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#text" :text "key content style: a leaf node of kind text with no props, children, events or binding")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#column" :text "key props style children: a node of kind column with empty text")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#button" :text "key props style children events binding: a node of kind button with empty text")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#table" :text "key style rows: a node of kind table whose children are rows, with no props")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#tableRow" :text "key style cells: a node of kind row whose children are cells, with no props")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#cell" :text "key content style: a leaf node of kind cell holding content as its text")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#toVNode" :text "node: the VNode tree of node and its children; column, row and table become container (column and row also get a layout prop), cell becomes text, other kinds are kept")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#measureNode" :text "node constraints: the layout dimensions of node's VNode under constraints")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#markSignalDirty" :text "node signalId: node and its descendants with dirty true exactly where the binding names signalId, false elsewhere")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#setSignalValue" :text "root signal value: a pair of root marked dirty for signal.id and the signal set to value")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#dirtyCount" :text "node: the number of dirty nodes in node and its descendants")
(:doc :symbol "asl/packages/asl-ui/tests/modelTest.asl#runTests" :text "run the UI model cases: a column of text, button and table converts to a container VNode with all children, and a signal set marks the bound nodes dirty")
(:doc :symbol "asl/packages/asl-ui/tests/modelTest.asl#RunTests" :text "same suite as runTests, exported under the capitalised name")
