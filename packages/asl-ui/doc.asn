(:doc :symbol "asl/packages/asl-ui/src/model.asl#UiStyle" :text "schema of a node style: typography (TypographyToken), foreground and background (ColorToken) and spacing (Int64)")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#EventHandler" :text "schema of an event binding: event and message, both String")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#SignalBinding" :text "schema of a signal binding: signalId String")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#UiNode" :text "schema of a UI node: kind, key, props (Map String String), style, children (List UiNode), events, binding (Option SignalBinding), text and dirty (Bool)")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#makeStyle" :text "typography foreground background spacingStep: a UiStyle whose spacing is tokens/gridStep of spacingStep")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#defaultStyle" :text "the UiStyle of the body typography token, the default dark theme fgPrimary on bgSurface, grid step 1")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#makeEvent" :text "event message: an EventHandler with those fields")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#makeBinding" :text "signalId: a SignalBinding for that signal")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#makeNode" :text "kind key props style children events binding content: a UiNode with those fields, content as its text and dirty false")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#text" :text "key content style: a leaf node of kind text with no props, children, events or binding")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#column" :text "key props style children: a node of kind column with empty text")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#button" :text "key props style children events binding: a node of kind button with empty text")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#table" :text "key style rows: a node of kind table whose children are rows, with no props")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#tableRow" :text "key style cells: a node of kind row whose children are cells, with no props")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#cell" :text "key content style: a leaf node of kind cell holding content as its text")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#toVNode" :text "node: the VNode tree of node and its children; column, row and table become container (column and row also get a layout prop), cell becomes text, other kinds are kept")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#measureNode" :text "node constraints: the layout dimensions of node's VNode under constraints")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#markSignalDirty" :text "node signalId: node and its descendants with dirty true exactly where the binding names signalId, false elsewhere")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#setSignalValue" :text "root signal value: a pair of root marked dirty for signal.id and the signal set to value")
(:doc :symbol "asl/packages/asl-ui/src/model.asl#dirtyCount" :text "node: the number of dirty nodes in node and its descendants")
(:doc :symbol "asl/packages/asl-ui/tests/modelTest.asl#runTests" :text "run the UI model cases: a column of text, button and table converts to a container VNode with all children, and a signal set marks the bound nodes dirty")
(:doc :symbol "asl/packages/asl-ui/tests/modelTest.asl#RunTests" :text "same suite as runTests, exported under the capitalised name")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#" :text "UI kit tokens: the closed enums a view may name (Space, Tone, TextRole, Radius, Emphasis) and the Theme record that maps each case to a Length or Color; raw values exist only here")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#contrast" :text "WCAG 2 contrast ratio of two colours, from 1.0 to 21.0, independent of argument order")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#" :text "UI kit view tree: one View case per widget, label first, messages as Int64 codes; resolve derives each node's id from the parent path plus role and label (interactive) or slot (static), and build returns the problems instead of a tree when ids clash or an interactive widget has no label")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#when" :text "the view when show is true, else absent; absent keeps its slot, so sibling ids do not move")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#keyed" :text "replace the derived id segment with an explicit key; needed for repeated items with equal labels")
(:doc :symbol "asl/packages/asl-ui/src/lowerHtml.asl#" :text "UI kit web target: lowers a resolved view to asl-html nodes with semantic elements and ARIA, and a Theme to one :root rule of css variables that the fixed kit rules read; clicks are wired by data-msg as asl/web/bridge/boot.js expects, text input by data-msg-input")
(:doc :symbol "asl/packages/asl-ui/src/lowerHtml.asl#page" :text "style sheet plus lowered view, or the view's problems")
(:doc :symbol "asl/packages/asl-ui/src/harness.asl#" :text "UI kit test harness, query half: mount a view, find nodes by role and label, read state, get the message an act would send, snapshot the tree as ASN text")
(:doc :symbol "asl/packages/asl-ui/src/harness.asl#send" :text "the message code and value the act would send to update, or inert when the node does not answer that act")
(:doc :symbol "asl/packages/asl-ui/src/exampleForm.asl#" :text "UI kit example: a name field, a Send button and a conditional status note with Msg, step and view")
(:doc :symbol "asl/packages/asl-ui/tests/semTokensTest.asl#" :text "gate for semTokens: every enum case resolves to its own theme value and the default theme meets WCAG contrast")
(:doc :symbol "asl/packages/asl-ui/tests/viewTest.asl#" :text "gate for view: derived ids, stability under when, clash and missing-label errors, role, label, state and message of each widget")
(:doc :symbol "asl/packages/asl-ui/tests/lowerHtmlTest.asl#" :text "gate for lowerHtml: exact markup per widget, every emitted class has a rule, every variable read is defined, no raw value outside the :root rule")
(:doc :symbol "asl/packages/asl-ui/tests/harnessTest.asl#" :text "gate for harness: find by role and label, state, sent messages, faults and the ASN snapshot")
(:doc :symbol "asl/packages/asl-ui/tests/exampleFormTest.asl#" :text "gate for exampleForm: type a name and press Send through the harness and step, then lower the result to HTML")
(:doc :symbol "asl/packages/asl-ui/src/exampleForm.asl#Model" :text "the example form's state: the typed name and whether it was sent")
(:doc :symbol "asl/packages/asl-ui/src/exampleForm.asl#Msg" :text "the example form's messages: setName with a string, send, and unknown")
(:doc :symbol "asl/packages/asl-ui/src/exampleForm.asl#code" :text "the integer code of a message: 1 for setName, 2 for send, 0 for unknown")
(:doc :symbol "asl/packages/asl-ui/src/exampleForm.asl#msgOf" :text "the message for a code and a value: setName for 1, send for 2, else unknown")
(:doc :symbol "asl/packages/asl-ui/src/exampleForm.asl#start" :text "the initial model with an empty name and nothing sent")
(:doc :symbol "asl/packages/asl-ui/src/exampleForm.asl#step" :text "the model after a message: setName stores the name and clears sent, send sets sent when the trimmed name is not empty, unknown changes nothing")
(:doc :symbol "asl/packages/asl-ui/src/exampleForm.asl#view" :text "the form view: a Name field, a Send button and, once sent, a success note thanking the name")
(:doc :symbol "asl/packages/asl-ui/src/harness.asl#Act" :text "an act on a node: press, or enter with a string")
(:doc :symbol "asl/packages/asl-ui/src/harness.asl#Fault" :text "why a harness step failed: broken with the view problems, missing or ambiguous for a role and label, or inert for a node id that does not answer the act")
(:doc :symbol "asl/packages/asl-ui/src/harness.asl#Sent" :text "the message a node sent: its integer code and the entered value")
(:doc :symbol "asl/packages/asl-ui/src/harness.asl#mount" :text "builds a view into an item tree, or the broken fault with the view problems")
(:doc :symbol "asl/packages/asl-ui/src/harness.asl#findAll" :text "every item in the tree with the given role")
(:doc :symbol "asl/packages/asl-ui/src/harness.asl#find" :text "the one item with the given role and label, or the missing fault when none and the ambiguous fault when several")
(:doc :symbol "asl/packages/asl-ui/src/harness.asl#snapshot" :text "the item tree as indented ASN text, one line per node with role, id, label, state and message")
(:doc :symbol "asl/packages/asl-ui/src/harness.asl#faultText" :text "a plain sentence for a fault")
(:doc :symbol "asl/packages/asl-ui/src/lowerHtml.asl#lengthCss" :text "a length as a CSS rem value, its dp count divided by 16")
(:doc :symbol "asl/packages/asl-ui/src/lowerHtml.asl#colorCss" :text "a color as a lower-case hex string with a leading hash, each channel clamped to 0 to 255")
(:doc :symbol "asl/packages/asl-ui/src/lowerHtml.asl#themeRules" :text "the :root CSS rule holding the theme's stroke, space, radius, color, tone and text custom properties")
(:doc :symbol "asl/packages/asl-ui/src/lowerHtml.asl#kitRules" :text "the CSS rules of the kit classes: group, stack, row, note, button, emphasis, field, input, toggle, link, image, focus ring, selection, and the gap, align, tone and type classes")
(:doc :symbol "asl/packages/asl-ui/src/lowerHtml.asl#sheet" :text "the full style sheet of a theme: its theme rules followed by the kit rules")
(:doc :symbol "asl/packages/asl-ui/src/lowerHtml.asl#selector" :text "the CSS id selector of an item, a hash followed by its id")
(:doc :symbol "asl/packages/asl-ui/src/lowerHtml.asl#lower" :text "an item lowered to an HTML node with ARIA roles, kit classes and data message codes; a keyed or absent view lowers to an empty fragment")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#Space" :text "the spacing scale names xs, sm, md, lg and xl")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#Tone" :text "the tone names neutral, primary, success, warn and danger")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#TextRole" :text "the text role names body, caption, label, title, display and mono")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#Radius" :text "the corner radius names sharp, soft and pill")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#Emphasis" :text "the emphasis levels strong, normal and weak")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#Length" :text "a length in density-independent pixels, dp with an integer")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#Color" :text "an RGB color with integer channels")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#ColorRole" :text "a theme color role: surface, ink, inkWeak, border, linkInk, selection, focusRing, or fill or onFill of a tone")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#TextStyle" :text "a text style: size, line height, weight and whether the font is fixed pitch")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#ToneColor" :text "the fill color of a tone and the color of content on that fill")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#SpaceScale" :text "the length of each space name")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#RadiusScale" :text "the length of each radius name")
