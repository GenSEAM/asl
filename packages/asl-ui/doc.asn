(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#TextScale" :text "the text style of each text role")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#Theme" :text "a UI theme: name, stroke width, space and radius scales, palette and text scale")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#defaultTheme" :text "the light theme with its space, radius, palette and text scales")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#spaceOf" :text "the length a theme gives a space name")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#radiusOf" :text "the length a theme gives a radius name")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#textOf" :text "the text style a theme gives a text role")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#colorOf" :text "the color a theme gives a color role")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#spaceName" :text "the lower-case string name of a space")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#radiusName" :text "the lower-case string name of a radius")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#textName" :text "the lower-case string name of a text role")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#toneName" :text "the lower-case string name of a tone")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#emphasisName" :text "the lower-case string name of an emphasis")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#allSpaces" :text "the five spaces in order from xs to xl")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#allRadii" :text "the three radii in order sharp, soft, pill")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#allTextRoles" :text "the six text roles in declaration order")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#allTones" :text "the five tones in declaration order")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#luminance" :text "the relative luminance of a color in 0 to 1 by the sRGB formula")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#View" :text "a UI view: text, heading, note, button, field, toggle, link, image, stack, row, keyed and absent, each with its labels, message code and children")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#Level" :text "a heading level: top, section or sub")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#Align" :text "the cross-axis alignment of a stack or row: start, center, end or stretch")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#Role" :text "the accessible role of an item: static, heading, status, button, textbox, switch, link, image or group")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#State" :text "the state of an item: stateless, valued with a string, or switched with a flag")
