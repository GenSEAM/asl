(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#lg" :text "the large space")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#xl" :text "the extra large space")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#neutral" :text "the neutral tone")
(:doc :symbol "asl/packages/asl-ui/src/semTokens.asl#primary" :text "the primary tone")
