(:doc :symbol "asl/packages/asl-ui/src/view.asl#note" :text "a view of a status note with a tone")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#button" :text "a view of a button with a label, emphasis and message code")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#field" :text "a view of a text field with a label, current value and message code")
