(:doc :symbol "asl/packages/asl-ui/src/view.asl#image" :text "a view of an image with an alt label and url")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#stack" :text "a view that lays its children out in a column with a gap and alignment")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#row" :text "a view that lays its children out in a wrapping row with a gap and alignment")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#absent" :text "the view that renders nothing and gets no item")
(:doc :symbol "asl/packages/asl-ui/src/view.asl#roleName" :text "the accessible name of a role: text, heading, status, button, textbox, switch, link, image or group")
