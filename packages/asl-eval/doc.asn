(:doc :symbol "asl/packages/asl-eval/src/eval.asl#" :text "Pure AgentSlang AST Evaluator, Lexical Closures, and Module Loading Runtime.")
(:doc :symbol "asl/packages/asl-eval/src/eval.asl#EvalResult.value" :text "Serialized evaluated value or empty on error")
(:doc :symbol "asl/packages/asl-eval/src/eval.asl#EvalResult.ok" :text "True if evaluation succeeded cleanly")
(:doc :symbol "asl/packages/asl-eval/src/eval.asl#EvalResult.errCode" :text "Canonical failure error code")
(:doc :symbol "asl/packages/asl-eval/src/eval.asl#EvalEnv.bindings" :text "Lexical scope symbol keys")
(:doc :symbol "asl/packages/asl-eval/src/eval.asl#EvalEnv.values" :text "Lexical scope symbol values")
(:doc :symbol "asl/packages/asl-eval/src/eval.asl#EvalEnv.parentId" :text "Parent scope identifier")
(:doc :symbol "asl/packages/asl-eval/src/eval.asl#Closure.params" :text "Parameter symbol names")
(:doc :symbol "asl/packages/asl-eval/src/eval.asl#Closure.body" :text "Body expression serialized node")
(:doc :symbol "asl/packages/asl-eval/src/eval.asl#Closure.env" :text "Lexical environment")
(:doc :symbol "asl/packages/asl-eval/src/eval.asl#invokeClosure" :text "Invokes closure with bound arguments in child lexical scope and evaluates closure body.")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#" :text "R1 U12 ASL evaluator on the stage-0 host: asl-host run main.asl eval EXPR | test FILE. Slice 1: reader, core forms, single-module runner; imports, schema and enum are rejected, never skipped")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#headOf" :text "listHead listTail stringSlice answer Option since D148")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#charAt" :text "---- lexer: tokens carry whether they start at column 0, which groups top-level items")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#digit" :text "---- atoms")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#digitsNeg" :text "negative accumulation reaches INT64_MIN; host + and * raise ERR_INT_OVERFLOW outside int64")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#isFloatLit" :text "[+-] digits [. digits] [eE [+-] digits], with a dot or an exponent: the reader's float literal spelling")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#intFits" :text "unsigned digits fit int64; neg allows the magnitude of INT64_MIN")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#closerOf" :text "---- parser")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#parseDatum" :text "a brace literal {:k v ...} reads as (%map :k v ...); nesting past maxNesting is ERR_DEPTH, as in the host compiler")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#parseItems" :text "items: each column-0 token starts a new top-level item holding the datums up to the next one")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#render" :text "---- values")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#arith" :text "---- builtins: stage-0 primitives do the arithmetic, so floor division and overflow are the host's")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#L268" :text "structural = on lists, records and constructors; mixed types are ERR_TYPE as for scalars")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#deeper" :text "iterative and early-exit: runtime data nested past dataLimit is ERR_DEPTH for = and printing, as in the host")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#mkRec" :text "record from :key value pairs; a named schema requires exactly its fields")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#L437" :text "---- evaluator: a CEK machine. ev and ret tail-call each other over a heap continuation list, so ASL call depth")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#L438" :text "is bounded by kRet frames (one per non-tail user call, MAX_FRAMES as in the host), never by host frames")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#enter!" :text "a user call in tail position (continuation already returns from a call) pushes nothing; otherwise one kRet")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#builtinArity" :text "---- static pass (I1): every symbol in every branch resolves and direct calls match arity before anything runs")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#resolveMt" :text "closed-enum exhaustiveness: without a _ arm every variant of the first arm's enum is covered, named when missing")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#L792" :text "---- loader (I12): the whole import graph resolves before anything runs; roots are the .asl.config.asn directories")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#L793" :text "above the importing file, never the cwd; empty . and .. segments and realpath escapes are ERR_UNRESOLVED_IMPORT")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#linkMods" :text "resolve each module against its visible names, then key every def and rewrite references to keys")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#symText" :text "---- module runner (I5): header, fn items; anything else is rejected")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#fieldNames" :text "indented fields: name: Type pairs")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#listFields" :text "list-form fields: (:f name Type ...)")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#schemaDef" :text "a schema is a constructor def taking :field value pairs")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#enumDefs" :text "each enum variant is a constructor def carrying its enum name and the full variant list for exhaustiveness")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#collectItems" :text "top-level items: fn, schema and enum declare; a lone list, vector, brace or literal is a top-level expression run")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#collectItems" :text "after the whole graph links; list-form def defun df fn enum and bare symbols are rejected, never skipped")
(:doc :symbol "asl/packages/asl-eval/src/main.asl#walk" :text "imports finish before importers")
(:doc :symbol "asl/packages/asl-eval/tests/evalTest.asl#" :text "Unit test suite for the pure ASL AST evaluator.")
