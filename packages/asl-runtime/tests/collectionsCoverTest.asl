(module asl-runtime/tests/collectionsCoverTest
  :x [testSetUnion testSetIntersection testSetDifference runTests]
  :i [(asl-runtime/collections :a col)])

fn testSetUnion -> Bool
  (let [(a (col/setFromList (list "a" "b" "c")))
        (b (col/setFromList (list "b" "c" "d")))
        (u (col/setUnion a b))
        (e (col/setUnion (col/setEmpty) (col/setEmpty)))
        (uEmpty (col/setUnion a (col/setEmpty)))
        (big (col/setUnion (col/setFromList (list "x" "y")) (col/setFromList (list "z" "w" "v"))))
        (zero (col/setUnion (col/setFromList (list)) (col/setFromList (list))))
        (max (col/setUnion (col/setFromList (list "a" "b" "c" "d" "e" "f" "g" "h" "i" "j")) (col/setFromList (list "k" "l" "m" "n" "o" "p" "q" "r" "s" "t"))))
        (dup (col/setUnion (col/setFromList (list "a" "a" "b")) (col/setFromList (list "b" "b" "c"))))]
    (do
      (assert (= (col/setSize u) 4) "union of {a,b,c} and {b,c,d} has 4 elements")
      (assert (col/setContains? u "a") "union contains a")
      (assert (col/setContains? u "b") "union contains b")
      (assert (col/setContains? u "c") "union contains c")
      (assert (col/setContains? u "d") "union contains d")
      (assert (= (col/setSize e) 0) "union of two empty sets is empty")
      (refute (col/setContains? e "a") "empty union contains nothing")
      (assert (= (col/setSize uEmpty) 3) "union with empty set keeps size 3")
      (assert (col/setContains? uEmpty "b") "union with empty set keeps b")
      (assert (= (col/setSize big) 5) "union of disjoint sets has 5 elements")
      (assert (col/setContains? big "z") "disjoint union contains z")
      (assert (col/setContains? big "v") "disjoint union contains v")
      (assert (= (col/setSize zero) 0) "union of zero-element sets is empty")
      (assert (= (col/setSize max) 20) "union of max-size sets has 20 elements")
      (assert (col/setContains? max "a") "max union contains a")
      (assert (col/setContains? max "t") "max union contains t")
      (assert (= (col/setSize dup) 3) "union with duplicate inputs has 3 elements")
      (assert (col/setContains? dup "a") "dup union contains a")
      (assert (col/setContains? dup "b") "dup union contains b")
      (assert (col/setContains? dup "c") "dup union contains c")
      true))

fn testSetIntersection -> Bool
  (let [(a (col/setFromList (list "a" "b" "c")))
        (b (col/setFromList (list "b" "c" "d")))
        (i (col/setIntersection a b))
        (iEmpty (col/setIntersection a (col/setEmpty)))
        (iDisjoint (col/setIntersection (col/setFromList (list "x")) (col/setFromList (list "y"))))
        (iSelf (col/setIntersection a a))
        (iZero (col/setIntersection (col/setFromList (list)) (col/setFromList (list "a"))))
        (max (col/setIntersection (col/setFromList (list "a" "b" "c" "d" "e")) (col/setFromList (list "c" "d" "e" "f" "g"))))
        (dup (col/setIntersection (col/setFromList (list "a" "a" "b")) (col/setFromList (list "b" "b" "c"))))]
    (do
      (assert (= (col/setSize i) 2) "intersection of {a,b,c} and {b,c,d} has 2 elements")
      (assert (col/setContains? i "b") "intersection contains b")
      (assert (col/setContains? i "c") "intersection contains c")
      (refute (col/setContains? i "a") "intersection excludes a")
      (refute (col/setContains? i "d") "intersection excludes d")
      (assert (= (col/setSize iEmpty) 0) "intersection with empty set is empty")
      (assert (= (col/setSize iDisjoint) 0) "intersection of disjoint sets is empty")
      (assert (= (col/setSize iSelf) 3) "intersection with itself keeps all 3")
      (assert (col/setContains? iSelf "a") "self intersection contains a")
      (assert (col/setContains? iSelf "c") "self intersection contains c")
      (assert (= (col/setSize iZero) 0) "intersection with zero-element set is empty")
      (assert (= (col/setSize max) 3) "intersection of max sets has 3 elements")
      (assert (col/setContains? max "c") "max intersection contains c")
      (assert (col/setContains? max "d") "max intersection contains d")
      (assert (col/setContains? max "e") "max intersection contains e")
      (assert (= (col/setSize dup) 1) "intersection with duplicate inputs has 1 element")
      (assert (col/setContains? dup "b") "dup intersection contains b")
      true))

fn testSetDifference -> Bool
  (let [(a (col/setFromList (list "a" "b" "c")))
        (b (col/setFromList (list "b" "c" "d")))
        (d (col/setDifference a b))
        (dEmpty (col/setDifference a (col/setEmpty)))
        (dAll (col/setDifference a a))
        (dFromEmpty (col/setDifference (col/setEmpty) a))
        (dZero (col/setDifference (col/setFromList (list)) (col/setFromList (list "a"))))
        (max (col/setDifference (col/setFromList (list "a" "b" "c" "d" "e" "f" "g" "h" "i" "j")) (col/setFromList (list "f" "g" "h" "i" "j" "k" "l" "m" "n" "o"))))
        (dup (col/setDifference (col/setFromList (list "a" "a" "b" "b")) (col/setFromList (list "b" "c"))))]
    (do
      (assert (= (col/setSize d) 1) "difference {a,b,c} - {b,c,d} has 1 element")
      (assert (col/setContains? d "a") "difference contains a")
      (refute (col/setContains? d "b") "difference excludes b")
      (refute (col/setContains? d "c") "difference excludes c")
      (refute (col/setContains? d "d") "difference excludes d")
      (assert (= (col/setSize dEmpty) 3) "difference with empty set keeps 3")
      (assert (col/setContains? dEmpty "c") "difference with empty set keeps c")
      (assert (= (col/setSize dAll) 0) "difference with itself is empty")
      (assert (= (col/setSize dFromEmpty) 0) "difference of empty set is empty")
      (assert (= (col/setSize dZero) 0) "difference from zero-element set is empty")
      (assert (= (col/setSize max) 5) "difference of max sets has 5 elements")
      (assert (col/setContains? max "a") "max difference contains a")
      (assert (col/setContains? max "b") "max difference contains b")
      (assert (col/setContains? max "c") "max difference contains c")
      (assert (col/setContains? max "d") "max difference contains d")
      (assert (col/setContains? max "e") "max difference contains e")
      (refute (col/setContains? max "f") "max difference excludes f")
      (assert (= (col/setSize dup) 1) "difference with duplicate inputs has 1 element")
      (assert (col/setContains? dup "a") "dup difference contains a")
      true))

fn runTests -> Bool
  (do
    (assert (testSetUnion) "testSetUnion passes")
    (assert (testSetIntersection) "testSetIntersection passes")
    (assert (testSetDifference) "testSetDifference passes")
    true)
