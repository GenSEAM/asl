fn ! testVariables! -> Bool
  (do
    (assert (= (wrapOf 0 9223372036854775807 2) -2) "variable operands: mulWrap MAX 2 wraps to -2")
    (assert (= (wrapOf 0 -9223372036854775808 -1) -9223372036854775808) "variable operands: mulWrap MIN -1 stays MIN")
    (assert (= (wrapOf 1 9223372036854775807 1) -9223372036854775808) "variable operands: addWrap MAX 1 wraps to MIN")
    (assert (= (wrapOf 2 -9223372036854775808 1) 9223372036854775807) "variable operands: subWrap MIN 1 wraps to MAX")
    (assert (= (wrapOf 3 1 63) -9223372036854775808) "variable operands: rotateLeft 1 63 is MIN")
    (assert (= (wrapOf 3 1 64) 1) "variable operands: a rotate by 64 is a rotate by 0")
    (assert (= (wrapOf 3 1 -1) -9223372036854775808) "variable operands: rotateLeft by -1 is rotateLeft by 63")
    (assert (= (wrapOf 4 1 1) -9223372036854775808) "variable operands: rotateRight 1 1 is MIN")
    (assert (= (wrapOf 4 1 0) 1) "variable operands: rotateRight by 0 is the identity")
    (assert (= (wrapOf 3 (wrapOf 4 1311768467463790320 7) 7) 1311768467463790320) "rotateLeft undoes rotateRight")
    (assert (= (wrapOf 2 (wrapOf 1 1311768467463790320 -7046029254386353131) -7046029254386353131) 1311768467463790320) "subWrap undoes addWrap across the wrap")
    true)

fn ! runTests -> Bool
  (do
    (testLiterals!)
    (testVariables!)
    true)
