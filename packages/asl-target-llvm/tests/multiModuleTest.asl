fn ! compiled dir: String entry: String -> (Result comp/CompileResult String)
  (comp/compilePackageToLlvm! (str dir "/linkfx/" entry ".asl") (list dir))

fn codeOf res: (Result comp/CompileResult String) -> String
  (mt res
    ((ok cr) (if cr.ok cr.code (str "diagnostics: " (stringJoin cr.diagnostics "; "))))
    ((err e) (str "error: " e)))

fn ! testGolden dir: String -> Bool
  (let [(code (codeOf (compiled dir "app")))]
    (do
      (assert (= code (appGolden)) (str "3-module .ll equals its golden:\n" code))
      (assert (stringContains? code "%result = call tailcc %Val @linkfx$2Fapp$2Emain()") "@main calls the entry module's main")
      (assert (= (codeOf (compiled dir "app")) code) "compiling again gives the same .ll")
      true))

fn ! testNativeRun dir: String -> Bool
  (let [(ll (str dir "/app.ll"))
        (exe (str dir "/app"))]
    (do
      (assert (ok? (fileWrite ll (codeOf (compiled dir "app")))) (str "fileWrite " ll))
      (let [(linked (processRun (str "/usr/bin/clang -Wno-override-module -x ir " ll " -x none asl/host/out/libaslrt.a -lm -o " exe)))]
        (assert (= linked.exitCode 0) (str "clang links the 3-module .ll against libaslrt.a: " linked.stderr)))
      (let [(ran (processRun exe))]
        (assert (= ran.exitCode 42) (str "the 3-module program exits " ran.exitCode ", want 42; stderr: " ran.stderr)))
      true))

fn ! testUnexportedDiagnostic dir: String -> Bool
  (mt (compiled dir "badHidden")
    ((err e) (do (assert false (str "compilePackageToLlvm! badHidden: " e)) false))
    ((ok cr)
      (do
        (refute cr.ok "an unexported call does not compile")
        (assert (listAny? (fn [(d String)] -> Bool (stringContains? d "secret is not exported by linkfx/util")) cr.diagnostics)
                (str "diagnostics name the unexported function: " (stringJoin cr.diagnostics "; ")))
        true)))

fn ! runTests -> Bool
  (let [(made (processRun "mktemp -d"))
        (dir (stringReplace made.stdout "\n" ""))]
    (do
      (assert (= made.exitCode 0) "mktemp -d makes a work directory")
      (assert (lt/writeFixture! dir) "fixture modules written")
      (testGolden dir)
      (testNativeRun dir)
      (testUnexportedDiagnostic dir)
      (assert (= (processRun (str "rm -rf " dir)).exitCode 0) "work directory removed")
      true))
