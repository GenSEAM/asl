(module asl-target-llvm/wasmAlloc
  :x [allocatorImports wasmAllocatorText])

fn allocatorImports -> (List String)
  (list "declare i32 @llvm.wasm.memory.grow.i32(i32, i32)" "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1 immarg)" "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1 immarg)")

fn wasmAllocatorText -> String
  (stringJoin
    (list
      "@__asl_wasm_free_head = internal global i32 0, align 4"
      "@__asl_wasm_heap_cursor = internal global i32 0, align 4"
      "@__asl_wasm_heap_end = internal global i32 0, align 4"
      ""
      "define ptr @malloc(i64 %requested) {"
      "entry:"
      "  %tooLarge = icmp ugt i64 %requested, 4294901760"
      "  br i1 %tooLarge, label %fail, label %search"
      "fail:"
      "  ret ptr null"
      "search:"
      "  %raw = trunc i64 %requested to i32"
      "  %plus7 = add i32 %raw, 7"
      "  %rounded = and i32 %plus7, -8"
      "  %isZero = icmp eq i32 %rounded, 0"
      "  %need = select i1 %isZero, i32 8, i32 %rounded"
      "  %head = load i32, ptr @__asl_wasm_free_head, align 4"
      "  br label %loop"
      "loop:"
      "  %block = phi i32 [ %head, %search ], [ %next, %advance ]"
      "  %prev = phi i32 [ 0, %search ], [ %block, %advance ]"
      "  %empty = icmp eq i32 %block, 0"
      "  br i1 %empty, label %bump, label %check"
      "check:"
      "  %sizep = inttoptr i32 %block to ptr"
      "  %size = load i32, ptr %sizep, align 4"
      "  %fits = icmp uge i32 %size, %need"
      "  br i1 %fits, label %reuse, label %advance"
      "advance:"
      "  %nextp32 = add i32 %block, 4"
      "  %nextp = inttoptr i32 %nextp32 to ptr"
      "  %next = load i32, ptr %nextp, align 4"
      "  br label %loop"
      "reuse:"
      "  %reuseNextp32 = add i32 %block, 4"
      "  %reuseNextp = inttoptr i32 %reuseNextp32 to ptr"
      "  %reuseNext = load i32, ptr %reuseNextp, align 4"
      "  %first = icmp eq i32 %prev, 0"
      "  br i1 %first, label %reuseHead, label %reusePrev"
      "reuseHead:"
      "  store i32 %reuseNext, ptr @__asl_wasm_free_head, align 4"
      "  br label %returnReuse"
      "reusePrev:"
      "  %prevNextp32 = add i32 %prev, 4"
      "  %prevNextp = inttoptr i32 %prevNextp32 to ptr"
      "  store i32 %reuseNext, ptr %prevNextp, align 4"
      "  br label %returnReuse"
      "returnReuse:"
      "  %payload32 = add i32 %block, 8"
      "  %payload = inttoptr i32 %payload32 to ptr"
      "  ret ptr %payload"
      "bump:"
      "  %cursor = load i32, ptr @__asl_wasm_heap_cursor, align 4"
      "  %end = load i32, ptr @__asl_wasm_heap_end, align 4"
      "  %total = add i32 %need, 8"
      "  %cursor64 = zext i32 %cursor to i64"
      "  %end64 = zext i32 %end to i64"
      "  %total64 = zext i32 %total to i64"
      "  %requiredEnd = add i64 %cursor64, %total64"
      "  %inRun = icmp ule i64 %requiredEnd, %end64"
      "  %started = icmp ne i32 %cursor, 0"
      "  %room = and i1 %inRun, %started"
      "  br i1 %room, label %carve, label %grow"
      "grow:"
      "  %round = add i64 %total64, 65535"
      "  %pagesNeeded = lshr i64 %round, 16"
      "  %small = icmp ult i64 %pagesNeeded, 16"
      "  %pages64 = select i1 %small, i64 16, i64 %pagesNeeded"
      "  %pages = trunc i64 %pages64 to i32"
      "  %oldPages = call i32 @llvm.wasm.memory.grow.i32(i32 0, i32 %pages)"
      "  %growFailed = icmp eq i32 %oldPages, -1"
      "  br i1 %growFailed, label %fail, label %grown"
      "grown:"
      "  %start = shl i32 %oldPages, 16"
      "  %runBytes = shl i32 %pages, 16"
      "  %contiguous = icmp eq i32 %start, %end"
      "  %keep = and i1 %contiguous, %started"
      "  %newCursor = select i1 %keep, i32 %cursor, i32 %start"
      "  %newEnd = add i32 %start, %runBytes"
      "  store i32 %newCursor, ptr @__asl_wasm_heap_cursor, align 4"
      "  store i32 %newEnd, ptr @__asl_wasm_heap_end, align 4"
      "  br label %carve"
      "carve:"
      "  %base = load i32, ptr @__asl_wasm_heap_cursor, align 4"
      "  %nextCursor = add i32 %base, %total"
      "  store i32 %nextCursor, ptr @__asl_wasm_heap_cursor, align 4"
      "  %header = inttoptr i32 %base to ptr"
      "  store i32 %need, ptr %header, align 4"
      "  %tailp32 = add i32 %base, 4"
      "  %tailp = inttoptr i32 %tailp32 to ptr"
      "  store i32 0, ptr %tailp, align 4"
      "  %freshPayload32 = add i32 %base, 8"
      "  %freshPayload = inttoptr i32 %freshPayload32 to ptr"
      "  ret ptr %freshPayload"
      "}"
      ""
      "define internal i64 @__asl_wasm_free(ptr %p) {"
      "entry:"
      "  %isNull = icmp eq ptr %p, null"
      "  br i1 %isNull, label %done, label %insert"
      "insert:"
      "  %payload = ptrtoint ptr %p to i32"
      "  %header32 = sub i32 %payload, 8"
      "  %head = load i32, ptr @__asl_wasm_free_head, align 4"
      "  %nextp32 = add i32 %header32, 4"
      "  %nextp = inttoptr i32 %nextp32 to ptr"
      "  store i32 %head, ptr %nextp, align 4"
      "  store i32 %header32, ptr @__asl_wasm_free_head, align 4"
      "  br label %done"
      "done:"
      "  ret i64 0"
      "}"
      ""
      "define i64 @asl_wasm_free(ptr %p) {"
      "entry:"
      "  %r = call i64 @__asl_wasm_free(ptr %p)"
      "  ret i64 0"
      "}"
      ""
      "define void @free(ptr %p) {"
      "entry:"
      "  %r = call i64 @__asl_wasm_free(ptr %p)"
      "  ret void"
      "}"
      ""
      "define ptr @realloc(ptr %old, i64 %requested) {"
      "entry:"
      "  %oldNull = icmp eq ptr %old, null"
      "  br i1 %oldNull, label %fresh, label %inspect"
      "inspect:"
      "  %zero = icmp eq i64 %requested, 0"
      "  br i1 %zero, label %release, label %compare"
      "release:"
      "  %released0 = call i64 @__asl_wasm_free(ptr %old)"
      "  ret ptr null"
      "compare:"
      "  %oldPayload = ptrtoint ptr %old to i32"
      "  %oldHeader32 = sub i32 %oldPayload, 8"
      "  %oldHeader = inttoptr i32 %oldHeader32 to ptr"
      "  %oldSize32 = load i32, ptr %oldHeader, align 4"
      "  %oldSize = zext i32 %oldSize32 to i64"
      "  %fits = icmp ule i64 %requested, %oldSize"
      "  br i1 %fits, label %same, label %copy"
      "same:"
      "  ret ptr %old"
      "copy:"
      "  %new = call ptr @malloc(i64 %requested)"
      "  %failed = icmp eq ptr %new, null"
      "  br i1 %failed, label %fail, label %move"
      "move:"
      "  call void @llvm.memcpy.p0.p0.i64(ptr %new, ptr %old, i64 %oldSize, i1 false)"
      "  %released = call i64 @__asl_wasm_free(ptr %old)"
      "  ret ptr %new"
      "fresh:"
      "  %allocated = call ptr @malloc(i64 %requested)"
      "  ret ptr %allocated"
      "fail:"
      "  ret ptr null"
      "}"
      ""
      "define ptr @calloc(i64 %count, i64 %width) {"
      "entry:"
      "  %widthZero = icmp eq i64 %width, 0"
      "  br i1 %widthZero, label %allocate, label %check"
      "check:"
      "  %maxCount = udiv i64 4294901760, %width"
      "  %overflow = icmp ugt i64 %count, %maxCount"
      "  br i1 %overflow, label %fail, label %allocate"
      "allocate:"
      "  %size = mul i64 %count, %width"
      "  %result = call ptr @malloc(i64 %size)"
      "  %failed = icmp eq ptr %result, null"
      "  br i1 %failed, label %fail, label %clear"
      "clear:"
      "  call void @llvm.memset.p0.i64(ptr %result, i8 0, i64 %size, i1 false)"
      "  ret ptr %result"
      "fail:"
      "  ret ptr null"
      "}")
    "\n")
