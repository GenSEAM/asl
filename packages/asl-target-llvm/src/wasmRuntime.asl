(module asl-target-llvm/wasmRuntime
  :x [hostImportDecls runtimeText supportText]
  :i [(asl-target-llvm/libc :a libc)
      (asl-target-llvm/wasmAlloc :a alloc)
      (asl-target-llvm/wasmFormat :a fmt)])

fn importAttrs service: String -> String
  (let [(split (libc/hostImport service))]
    (str "\"wasm-import-module\"=\"" (pairFirst split) "\" \"wasm-import-name\"=\"" (pairSecond split) "\""))

fn hostImportDecls abi: libc/RuntimeAbi -> (List String)
  (list (str "declare i64 @asl_wasm_host_write(i32, ptr, i64) " (importAttrs abi.output))
        (str "declare void @asl_wasm_host_exit(i32) noreturn " (importAttrs abi.exit))
        (str "declare i64 @asl_wasm_host_now_ns() " (importAttrs abi.clock)))

fn runtimeDecls -> (List String)
  (list "declare i32 @main()" "declare void @gcInit()" "declare i32 @aslInternShared(ptr, i64)")

fn runtimeText -> String
  (stringJoin
    (list
      "@asl_wasm_ready = internal global i32 0, align 4"
      "@asl_wasm_roots = internal global ptr null, align 4"
      "@asl_wasm_root_count = internal global i64 0, align 8"
      "@asl_wasm_root_cap = internal global i64 0, align 8"
      "@asl_rt_spill = global [1024 x { i64, i64 }] zeroinitializer, align 8"
      "@asl_wasm_exit_fns = internal global [32 x ptr] zeroinitializer, align 4"
      "@asl_wasm_exit_count = internal global i64 0, align 8"
      "@.asl_wasm_kw_some = private unnamed_addr constant [5 x i8] c\"some\\00\""
      "@.asl_wasm_kw_none = private unnamed_addr constant [5 x i8] c\"none\\00\""
      "@.asl_wasm_kw_ok = private unnamed_addr constant [3 x i8] c\"ok\\00\""
      "@.asl_wasm_kw_err = private unnamed_addr constant [4 x i8] c\"err\\00\""
      "@.asl_wasm_kw_partial = private unnamed_addr constant [8 x i8] c\"partial\\00\""
      "@.asl_wasm_roots_code = private unnamed_addr constant [10 x i8] c\"ERR_LIMIT\\00\""
      "@.asl_wasm_oom_code = private unnamed_addr constant [8 x i8] c\"ERR_OOM\\00\""
      "@.asl_wasm_roots_limit = private unnamed_addr constant [28 x i8] c\"more than %lld global roots\\00\""
      "@.asl_wasm_roots_oom = private unnamed_addr constant [58 x i8] c\"out of memory growing the global root table to %lld slots\\00\""
      "@.asl_wasm_floor_line = private unnamed_addr constant [8 x i8] c\"%s: %s\\0A\\00\""
      ""
      "define void @_start() {"
      "entry:"
      "  %code = call i32 @main()"
      "  call void @exit(i32 %code)"
      "  unreachable"
      "}"
      ""
      "define void @exit(i32 %code) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %n = load i64, ptr @asl_wasm_exit_count"
      "  %none = icmp eq i64 %n, 0"
      "  br i1 %none, label %leave, label %run"
      "run:"
      "  %last = sub i64 %n, 1"
      "  store i64 %last, ptr @asl_wasm_exit_count"
      "  %slot = getelementptr [32 x ptr], ptr @asl_wasm_exit_fns, i64 0, i64 %last"
      "  %fn = load ptr, ptr %slot"
      "  call void %fn()"
      "  br label %loop"
      "leave:"
      "  call void @asl_wasm_host_exit(i32 %code)"
      "  unreachable"
      "}"
      ""
      "define i64 @asl_wasm_exit(i32 %code) {"
      "entry:"
      "  call void @exit(i32 %code)"
      "  unreachable"
      "}"
      ""
      "define i32 @atexit(ptr %fn) {"
      "entry:"
      "  %n = load i64, ptr @asl_wasm_exit_count"
      "  %full = icmp uge i64 %n, 32"
      "  br i1 %full, label %refuse, label %add"
      "refuse:"
      "  ret i32 -1"
      "add:"
      "  %slot = getelementptr [32 x ptr], ptr @asl_wasm_exit_fns, i64 0, i64 %n"
      "  store ptr %fn, ptr %slot"
      "  %n1 = add i64 %n, 1"
      "  store i64 %n1, ptr @asl_wasm_exit_count"
      "  ret i32 0"
      "}"
      ""
      "define i32 @fflush(ptr %stream) {"
      "entry:"
      "  ret i32 0"
      "}"
      ""
      "define ptr @getenv(ptr %name) {"
      "entry:"
      "  ret ptr null"
      "}"
      ""
      "define i64 @write(i32 %fd, ptr %p, i64 %n) {"
      "entry:"
      "  %w = call i64 @asl_wasm_host_write(i32 %fd, ptr %p, i64 %n)"
      "  ret i64 %w"
      "}"
      ""
      "define i64 @asl_wasm_write_all(i32 %fd, ptr %p, i64 %n) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %done = phi i64 [ 0, %entry ], [ %done1, %wrote ]"
      "  %left = sub i64 %n, %done"
      "  %more = icmp sgt i64 %left, 0"
      "  br i1 %more, label %call, label %out"
      "call:"
      "  %at = getelementptr i8, ptr %p, i64 %done"
      "  %w = call i64 @asl_wasm_host_write(i32 %fd, ptr %at, i64 %left)"
      "  %ok = icmp sgt i64 %w, 0"
      "  br i1 %ok, label %wrote, label %out"
      "wrote:"
      "  %done1 = add i64 %done, %w"
      "  br label %loop"
      "out:"
      "  ret i64 %done"
      "}"
      ""
      "define i64 @asl_wasm_now_ns() {"
      "entry:"
      "  %t = call i64 @asl_wasm_host_now_ns()"
      "  ret i64 %t"
      "}"
      ""
      "define void @asl_rt_init() {"
      "entry:"
      "  %ready = load i32, ptr @asl_wasm_ready"
      "  %done = icmp ne i32 %ready, 0"
      "  br i1 %done, label %out, label %init"
      "init:"
      "  call void @gcInit()"
      "  %s = call i32 @aslInternShared(ptr @.asl_wasm_kw_some, i64 4)"
      "  %n = call i32 @aslInternShared(ptr @.asl_wasm_kw_none, i64 4)"
      "  %o = call i32 @aslInternShared(ptr @.asl_wasm_kw_ok, i64 2)"
      "  %e = call i32 @aslInternShared(ptr @.asl_wasm_kw_err, i64 3)"
      "  %p = call i32 @aslInternShared(ptr @.asl_wasm_kw_partial, i64 7)"
      "  store i32 1, ptr @asl_wasm_ready"
      "  br label %out"
      "out:"
      "  ret void"
      "}"
      ""
      "define void @asl_rt_global_root(ptr %slot) {"
      "entry:"
      "  %n = load i64, ptr @asl_wasm_root_count"
      "  %cap = load i64, ptr @asl_wasm_root_cap"
      "  %full = icmp eq i64 %n, %cap"
      "  br i1 %full, label %grow, label %put"
      "grow:"
      "  %limit = icmp sgt i64 %cap, 1073741823"
      "  br i1 %limit, label %tooMany, label %resize"
      "tooMany:"
      "  %r0 = call i64 (ptr, ptr, ...) @gcFloorFail(ptr @.asl_wasm_roots_code, ptr @.asl_wasm_roots_limit, i64 %cap)"
      "  unreachable"
      "resize:"
      "  %empty = icmp eq i64 %cap, 0"
      "  %twice = shl i64 %cap, 1"
      "  %cap1 = select i1 %empty, i64 16, i64 %twice"
      "  %bytes = shl i64 %cap1, 2"
      "  %old = load ptr, ptr @asl_wasm_roots"
      "  %grown = call ptr @realloc(ptr %old, i64 %bytes)"
      "  %oom = icmp eq ptr %grown, null"
      "  br i1 %oom, label %noMemory, label %grew"
      "noMemory:"
      "  %r1 = call i64 (ptr, ptr, ...) @gcFloorFail(ptr @.asl_wasm_oom_code, ptr @.asl_wasm_roots_oom, i64 %cap1)"
      "  unreachable"
      "grew:"
      "  store ptr %grown, ptr @asl_wasm_roots"
      "  store i64 %cap1, ptr @asl_wasm_root_cap"
      "  br label %put"
      "put:"
      "  %table = load ptr, ptr @asl_wasm_roots"
      "  %at = getelementptr ptr, ptr %table, i64 %n"
      "  store ptr %slot, ptr %at"
      "  %n1 = add i64 %n, 1"
      "  store i64 %n1, ptr @asl_wasm_root_count"
      "  ret void"
      "}"
      ""
      "define void @gcMutatorRoots(ptr %mark) {"
      "entry:"
      "  %n = load i64, ptr @asl_wasm_root_count"
      "  br label %loop"
      "loop:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %body ]"
      "  %done = icmp uge i64 %i, %n"
      "  br i1 %done, label %out, label %body"
      "body:"
      "  %table = load ptr, ptr @asl_wasm_roots"
      "  %at = getelementptr ptr, ptr %table, i64 %i"
      "  %slot = load ptr, ptr %at"
      "  %v = load { i64, i64 }, ptr %slot"
      "  call void %mark({ i64, i64 } %v)"
      "  %i1 = add i64 %i, 1"
      "  br label %loop"
      "out:"
      "  ret void"
      "}"
      ""
      "define i64 @gcFloorFail(ptr %code, ptr %fmt, ...) {"
      "entry:"
      "  %msg = alloca [1024 x i8], align 1"
      "  %line = alloca [1152 x i8], align 1"
      "  %ap = alloca ptr, align 4"
      "  call void @llvm.va_start.p0(ptr %ap)"
      "  %k = call i64 @asl_wasm_vformat(ptr %msg, i64 1024, ptr %fmt, ptr %ap)"
      "  call void @llvm.va_end.p0(ptr %ap)"
      "  %n = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %line, i64 1152, ptr @.asl_wasm_floor_line, ptr %code, ptr %msg)"
      "  %n64 = sext i32 %n to i64"
      "  %over = icmp sge i64 %n64, 1152"
      "  br i1 %over, label %cut, label %emit"
      "cut:"
      "  %nl = getelementptr i8, ptr %line, i64 1150"
      "  store i8 10, ptr %nl"
      "  br label %emit"
      "emit:"
      "  %len = phi i64 [ %n64, %entry ], [ 1151, %cut ]"
      "  %w = call i64 @asl_wasm_write_all(i32 2, ptr %line, i64 %len)"
      "  call void @exit(i32 1)"
      "  unreachable"
      "}"
      ""
      "define i32 @memcmp(ptr %a, ptr %b, i64 %n) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %same ]"
      "  %done = icmp uge i64 %i, %n"
      "  br i1 %done, label %equal, label %body"
      "body:"
      "  %ap = getelementptr i8, ptr %a, i64 %i"
      "  %bp = getelementptr i8, ptr %b, i64 %i"
      "  %x = load i8, ptr %ap"
      "  %y = load i8, ptr %bp"
      "  %eq = icmp eq i8 %x, %y"
      "  %i1 = add i64 %i, 1"
      "  br i1 %eq, label %same, label %differ"
      "same:"
      "  br label %loop"
      "differ:"
      "  %xi = zext i8 %x to i32"
      "  %yi = zext i8 %y to i32"
      "  %d = sub i32 %xi, %yi"
      "  ret i32 %d"
      "equal:"
      "  ret i32 0"
      "}"
      ""
      "define i32 @strcmp(ptr %a, ptr %b) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %same ]"
      "  %ap = getelementptr i8, ptr %a, i64 %i"
      "  %bp = getelementptr i8, ptr %b, i64 %i"
      "  %x = load i8, ptr %ap"
      "  %y = load i8, ptr %bp"
      "  %eq = icmp eq i8 %x, %y"
      "  %end = icmp eq i8 %x, 0"
      "  %i1 = add i64 %i, 1"
      "  br i1 %eq, label %maybe, label %differ"
      "maybe:"
      "  br i1 %end, label %equal, label %same"
      "same:"
      "  br label %loop"
      "differ:"
      "  %xi = zext i8 %x to i32"
      "  %yi = zext i8 %y to i32"
      "  %d = sub i32 %xi, %yi"
      "  ret i32 %d"
      "equal:"
      "  ret i32 0"
      "}"
      ""
      "define ptr @strchr(ptr %s, i32 %c) {"
      "entry:"
      "  %want = trunc i32 %c to i8"
      "  br label %loop"
      "loop:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %next ]"
      "  %p = getelementptr i8, ptr %s, i64 %i"
      "  %x = load i8, ptr %p"
      "  %hit = icmp eq i8 %x, %want"
      "  br i1 %hit, label %found, label %check"
      "check:"
      "  %end = icmp eq i8 %x, 0"
      "  %i1 = add i64 %i, 1"
      "  br i1 %end, label %missing, label %next"
      "next:"
      "  br label %loop"
      "found:"
      "  ret ptr %p"
      "missing:"
      "  ret ptr null"
      "}"
      ""
      "define i64 @strlen(ptr %s) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]"
      "  %p = getelementptr i8, ptr %s, i64 %i"
      "  %x = load i8, ptr %p"
      "  %i1 = add i64 %i, 1"
      "  %end = icmp eq i8 %x, 0"
      "  br i1 %end, label %out, label %loop"
      "out:"
      "  ret i64 %i"
      "}"
      ""
      "define ptr @memset(ptr %dst, i32 %fill, i64 %n) {"
      "entry:"
      "  %byte = trunc i32 %fill to i8"
      "  call void @llvm.memset.p0.i64(ptr %dst, i8 %byte, i64 %n, i1 false)"
      "  ret ptr %dst"
      "}"
      ""
      "define ptr @memcpy(ptr %dst, ptr %src, i64 %n) {"
      "entry:"
      "  call void @llvm.memcpy.p0.p0.i64(ptr %dst, ptr %src, i64 %n, i1 false)"
      "  ret ptr %dst"
      "}"
      ""
      "define void @qsort(ptr %base, i64 %n, i64 %size, ptr %cmp) {"
      "entry:"
      "  br label %outer"
      "outer:"
      "  %i = phi i64 [ 1, %entry ], [ %i1, %inserted ]"
      "  %more = icmp ult i64 %i, %n"
      "  br i1 %more, label %inner, label %out"
      "inner:"
      "  %j = phi i64 [ %i, %outer ], [ %jm, %swap ]"
      "  %top = icmp eq i64 %j, 0"
      "  br i1 %top, label %inserted, label %compare"
      "compare:"
      "  %jm = sub i64 %j, 1"
      "  %offA = mul i64 %jm, %size"
      "  %offB = mul i64 %j, %size"
      "  %a = getelementptr i8, ptr %base, i64 %offA"
      "  %b = getelementptr i8, ptr %base, i64 %offB"
      "  %order = call i32 %cmp(ptr %a, ptr %b)"
      "  %after = icmp sgt i32 %order, 0"
      "  br i1 %after, label %swap, label %inserted"
      "swap:"
      "  call void @asl_wasm_swap(ptr %a, ptr %b, i64 %size)"
      "  br label %inner"
      "inserted:"
      "  %i1 = add i64 %i, 1"
      "  br label %outer"
      "out:"
      "  ret void"
      "}"
      ""
      "define internal void @asl_wasm_swap(ptr %a, ptr %b, i64 %size) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %k = phi i64 [ 0, %entry ], [ %k1, %body ]"
      "  %done = icmp uge i64 %k, %size"
      "  br i1 %done, label %out, label %body"
      "body:"
      "  %ap = getelementptr i8, ptr %a, i64 %k"
      "  %bp = getelementptr i8, ptr %b, i64 %k"
      "  %x = load i8, ptr %ap"
      "  %y = load i8, ptr %bp"
      "  store i8 %y, ptr %ap"
      "  store i8 %x, ptr %bp"
      "  %k1 = add i64 %k, 1"
      "  br label %loop"
      "out:"
      "  ret void"
      "}")
    "\n")

fn supportText abi: libc/RuntimeAbi -> String
  (stringJoin
    (listAppend
      (listAppend (list "target triple = \"wasm32-unknown-unknown\"" "")
                  (listAppend (hostImportDecls abi) (listAppend (alloc/allocatorImports) (listAppend (fmt/formatImports) (runtimeDecls)))))
      (list "" (alloc/wasmAllocatorText) "" (runtimeText) "" (fmt/formatText) ""))
    "\n")
