      "define i64 @asl_wasm_vformat(ptr %buf, i64 %cap, ptr %fmt, ptr %ap) {"
      "entry:"
      "  %st = alloca { ptr, i64, i64 }, align 8"
      "  store ptr %buf, ptr %st"
      "  %capp = getelementptr { ptr, i64, i64 }, ptr %st, i32 0, i32 1"
      "  store i64 %cap, ptr %capp"
      "  %lenp = getelementptr { ptr, i64, i64 }, ptr %st, i32 0, i32 2"
      "  store i64 0, ptr %lenp"
      "  %chp = alloca i8, align 1"
      "  br label %scan"
      "scan:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %literal ], [ %next, %converted ]"
      "  %cp = getelementptr i8, ptr %fmt, i64 %i"
      "  %c = load i8, ptr %cp"
      "  %end = icmp eq i8 %c, 0"
      "  br i1 %end, label %finish, label %char"
      "char:"
      "  %pct = icmp eq i8 %c, 37"
      "  br i1 %pct, label %spec, label %literal"
      "literal:"
      "  call void @asl_wasm_fmt_put(ptr %st, i8 %c)"
      "  %i1 = add i64 %i, 1"
      "  br label %scan"
      "spec:"
      "  %f0 = add i64 %i, 1"
      "  br label %flags"
      "flags:"
      "  %fi = phi i64 [ %f0, %spec ], [ %fi1, %flag ]"
      "  %fl = phi i64 [ 0, %spec ], [ %fl1, %flag ]"
      "  %fp = getelementptr i8, ptr %fmt, i64 %fi"
      "  %fc = load i8, ptr %fp"
      "  %isMinus = icmp eq i8 %fc, 45"
      "  %isZero = icmp eq i8 %fc, 48"
      "  %isPlus = icmp eq i8 %fc, 43"
      "  %isSpace = icmp eq i8 %fc, 32"
      "  %isHash = icmp eq i8 %fc, 35"
      "  %b0 = select i1 %isMinus, i64 1, i64 0"
      "  %b1 = select i1 %isZero, i64 2, i64 %b0"
      "  %b2 = select i1 %isPlus, i64 4, i64 %b1"
      "  %b3 = select i1 %isSpace, i64 8, i64 %b2"
      "  %bit = select i1 %isHash, i64 16, i64 %b3"
      "  %isFlag = icmp ne i64 %bit, 0"
      "  %fl1 = or i64 %fl, %bit"
      "  %fi1 = add i64 %fi, 1"
      "  br i1 %isFlag, label %flag, label %widthStart"
      "flag:"
      "  br label %flags"
      "widthStart:"
      "  %wstar = icmp eq i8 %fc, 42"
      "  br i1 %wstar, label %widthArg, label %widthDigits"
      "widthArg:"
      "  %wa = va_arg ptr %ap, i32"
      "  %wa64 = sext i32 %wa to i64"
      "  %wneg = icmp slt i64 %wa64, 0"
      "  %wabs = sub i64 0, %wa64"
      "  %wval = select i1 %wneg, i64 %wabs, i64 %wa64"
      "  %wleft = or i64 %fl, 1"
      "  %wflags = select i1 %wneg, i64 %wleft, i64 %fl"
      "  %wnext = add i64 %fi, 1"
      "  br label %precStart"
      "widthDigits:"
      "  %wi = phi i64 [ %fi, %widthStart ], [ %wi1, %widthDigit ]"
      "  %wacc = phi i64 [ 0, %widthStart ], [ %wacc1, %widthDigit ]"
      "  %wp = getelementptr i8, ptr %fmt, i64 %wi"
      "  %wc = load i8, ptr %wp"
      "  %wge = icmp uge i8 %wc, 48"
      "  %wle = icmp ule i8 %wc, 57"
      "  %wdig = and i1 %wge, %wle"
      "  br i1 %wdig, label %widthDigit, label %widthDone"
      "widthDigit:"
      "  %wd = sub i8 %wc, 48"
      "  %wd64 = zext i8 %wd to i64"
      "  %wm = mul i64 %wacc, 10"
      "  %wacc1 = add i64 %wm, %wd64"
      "  %wi1 = add i64 %wi, 1"
      "  br label %widthDigits"
      "widthDone:"
      "  br label %precStart"
      "precStart:"
      "  %pi0 = phi i64 [ %wnext, %widthArg ], [ %wi, %widthDone ]"
      "  %width = phi i64 [ %wval, %widthArg ], [ %wacc, %widthDone ]"
      "  %fls = phi i64 [ %wflags, %widthArg ], [ %fl, %widthDone ]"
      "  %pp0 = getelementptr i8, ptr %fmt, i64 %pi0"
      "  %pc0 = load i8, ptr %pp0"
      "  %dot = icmp eq i8 %pc0, 46"
      "  br i1 %dot, label %precDot, label %lengthStart"
      "precDot:"
      "  %pi1 = add i64 %pi0, 1"
      "  %pp1 = getelementptr i8, ptr %fmt, i64 %pi1"
      "  %pc1 = load i8, ptr %pp1"
      "  %pstar = icmp eq i8 %pc1, 42"
      "  br i1 %pstar, label %precArg, label %precDigits"
      "precArg:"
      "  %pa = va_arg ptr %ap, i32"
      "  %pa64 = sext i32 %pa to i64"
      "  %panext = add i64 %pi1, 1"
      "  br label %lengthStart"
      "precDigits:"
      "  %qi = phi i64 [ %pi1, %precDot ], [ %qi1, %precDigit ]"
      "  %qacc = phi i64 [ 0, %precDot ], [ %qacc1, %precDigit ]"
      "  %qp = getelementptr i8, ptr %fmt, i64 %qi"
      "  %qc = load i8, ptr %qp"
      "  %qge = icmp uge i8 %qc, 48"
      "  %qle = icmp ule i8 %qc, 57"
      "  %qdig = and i1 %qge, %qle"
      "  br i1 %qdig, label %precDigit, label %precDone"
      "precDigit:"
      "  %qd = sub i8 %qc, 48"
      "  %qd64 = zext i8 %qd to i64"
      "  %qm = mul i64 %qacc, 10"
      "  %qacc1 = add i64 %qm, %qd64"
      "  %qi1 = add i64 %qi, 1"
      "  br label %precDigits"
      "precDone:"
      "  br label %lengthStart"
      "lengthStart:"
      "  %li0 = phi i64 [ %pi0, %precStart ], [ %panext, %precArg ], [ %qi, %precDone ]"
      "  %prec = phi i64 [ -1, %precStart ], [ %pa64, %precArg ], [ %qacc, %precDone ]"
      "  br label %lengths"
      "lengths:"
      "  %li = phi i64 [ %li0, %lengthStart ], [ %li1, %lengthMod ]"
      "  %wide = phi i1 [ false, %lengthStart ], [ %wide1, %lengthMod ]"
      "  %narrow = phi i64 [ 0, %lengthStart ], [ %narrow1, %lengthMod ]"
      "  %lp = getelementptr i8, ptr %fmt, i64 %li"
      "  %lc = load i8, ptr %lp"
      "  %isL = icmp eq i8 %lc, 108"
      "  %isZ = icmp eq i8 %lc, 122"
      "  %isJ = icmp eq i8 %lc, 106"
      "  %isT = icmp eq i8 %lc, 116"
      "  %isBigL = icmp eq i8 %lc, 76"
      "  %isH = icmp eq i8 %lc, 104"
      "  %w0 = or i1 %isL, %isZ"
      "  %w1 = or i1 %w0, %isJ"
      "  %w2 = or i1 %w1, %isT"
      "  %w3 = or i1 %w2, %isBigL"
      "  %isMod = or i1 %w3, %isH"
      "  %wide1 = or i1 %wide, %w3"
      "  %narrowInc = add i64 %narrow, 1"
      "  %narrow1 = select i1 %isH, i64 %narrowInc, i64 %narrow"
      "  %li1 = add i64 %li, 1"
      "  br i1 %isMod, label %lengthMod, label %conv"
      "lengthMod:"
      "  br label %lengths"
      "conv:"
      "  %next = add i64 %li, 1"
      "  %isD = icmp eq i8 %lc, 100"
      "  %isI = icmp eq i8 %lc, 105"
      "  %signedConv = or i1 %isD, %isI"
      "  br i1 %signedConv, label %signedArg, label %notSigned"
      "signedArg:"
      "  br i1 %wide, label %signed64, label %signed32"
      "signed64:"
      "  %s64 = va_arg ptr %ap, i64"
      "  br label %signedOut"
      "signed32:"
      "  %s32 = va_arg ptr %ap, i32"
      "  %isHH = icmp sge i64 %narrow, 2"
      "  %isH1 = icmp eq i64 %narrow, 1"
      "  %s8 = trunc i32 %s32 to i8"
      "  %s8x = sext i8 %s8 to i64"
      "  %s16 = trunc i32 %s32 to i16"
      "  %s16x = sext i16 %s16 to i64"
      "  %s32x = sext i32 %s32 to i64"
      "  %sh = select i1 %isH1, i64 %s16x, i64 %s32x"
      "  %sn = select i1 %isHH, i64 %s8x, i64 %sh"
      "  br label %signedOut"
      "signedOut:"
      "  %sv = phi i64 [ %s64, %signed64 ], [ %sn, %signed32 ]"
      "  call void @asl_wasm_fmt_int(ptr %st, i64 %sv, i1 true, i64 10, i1 false, i64 %prec, i64 %width, i64 %fls)"
      "  br label %converted"
      "notSigned:"
      "  %isU = icmp eq i8 %lc, 117"
      "  %isX = icmp eq i8 %lc, 120"
