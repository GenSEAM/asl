(module asl-target-llvm/wasmFormat
  :x [formatImports formatText])

fn formatImports -> (List String)
  (list "declare void @llvm.va_start.p0(ptr)" "declare void @llvm.va_end.p0(ptr)" "declare void @llvm.va_copy.p0(ptr, ptr)" "declare double @llvm.fabs.f64(double)" "declare void @llvm.trap()")

fn formatText -> String
  (stringJoin
    (list
      "define internal i64 @asl_wasm_big_mul(ptr %a, i64 %len, i64 %m, i64 %cap) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %body ]"
      "  %carry = phi i64 [ 0, %entry ], [ %c1, %body ]"
      "  %done = icmp uge i64 %i, %len"
      "  br i1 %done, label %spill, label %body"
      "body:"
      "  %p = getelementptr i32, ptr %a, i64 %i"
      "  %v32 = load i32, ptr %p"
      "  %v = zext i32 %v32 to i64"
      "  %prod = mul i64 %v, %m"
      "  %t = add i64 %prod, %carry"
      "  %lo = urem i64 %t, 1000000000"
      "  %c1 = udiv i64 %t, 1000000000"
      "  %lo32 = trunc i64 %lo to i32"
      "  store i32 %lo32, ptr %p"
      "  %i1 = add i64 %i, 1"
      "  br label %loop"
      "spill:"
      "  %n = phi i64 [ %len, %loop ], [ %n1, %push ]"
      "  %c = phi i64 [ %carry, %loop ], [ %cq, %push ]"
      "  %more = icmp ne i64 %c, 0"
      "  br i1 %more, label %room, label %out"
      "room:"
      "  %full = icmp uge i64 %n, %cap"
      "  br i1 %full, label %overflow, label %push"
      "overflow:"
      "  call void @llvm.trap()"
      "  unreachable"
      "push:"
      "  %cl = urem i64 %c, 1000000000"
      "  %cq = udiv i64 %c, 1000000000"
      "  %cl32 = trunc i64 %cl to i32"
      "  %pp = getelementptr i32, ptr %a, i64 %n"
      "  store i32 %cl32, ptr %pp"
      "  %n1 = add i64 %n, 1"
      "  br label %spill"
      "out:"
      "  ret i64 %n"
      "}"
      ""
      "define internal i64 @asl_wasm_big_from(ptr %a, i64 %v, i64 %cap) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %n = phi i64 [ 0, %entry ], [ %n1, %push ]"
      "  %x = phi i64 [ %v, %entry ], [ %q, %push ]"
      "  %more = icmp ne i64 %x, 0"
      "  br i1 %more, label %room, label %out"
      "room:"
      "  %full = icmp uge i64 %n, %cap"
      "  br i1 %full, label %overflow, label %push"
      "overflow:"
      "  call void @llvm.trap()"
      "  unreachable"
      "push:"
      "  %r = urem i64 %x, 1000000000"
      "  %q = udiv i64 %x, 1000000000"
      "  %r32 = trunc i64 %r to i32"
      "  %p = getelementptr i32, ptr %a, i64 %n"
      "  store i32 %r32, ptr %p"
      "  %n1 = add i64 %n, 1"
      "  br label %loop"
      "out:"
      "  ret i64 %n"
      "}"
      ""
      "define internal i64 @asl_wasm_big_pow(ptr %a, i64 %len, i64 %base, i64 %k, i64 %cap) {"
      "entry:"
      "  %is2 = icmp eq i64 %base, 2"
      "  %is5 = icmp eq i64 %base, 5"
      "  %step5 = select i1 %is5, i64 13, i64 9"
      "  %step = select i1 %is2, i64 29, i64 %step5"
      "  br label %chunks"
      "chunks:"
      "  %n = phi i64 [ %len, %entry ], [ %n1, %chunk ]"
      "  %left = phi i64 [ %k, %entry ], [ %left1, %chunk ]"
      "  %big = icmp sge i64 %left, %step"
      "  br i1 %big, label %chunk, label %rest"
      "chunk:"
      "  %unit = call i64 @asl_wasm_ipow(i64 %base, i64 %step)"
      "  %n1 = call i64 @asl_wasm_big_mul(ptr %a, i64 %n, i64 %unit, i64 %cap)"
      "  %left1 = sub i64 %left, %step"
      "  br label %chunks"
      "rest:"
      "  %any = icmp sgt i64 %left, 0"
      "  br i1 %any, label %last, label %out"
      "last:"
      "  %unitLast = call i64 @asl_wasm_ipow(i64 %base, i64 %left)"
      "  %nLast = call i64 @asl_wasm_big_mul(ptr %a, i64 %n, i64 %unitLast, i64 %cap)"
      "  ret i64 %nLast"
      "out:"
      "  ret i64 %n"
      "}"
      ""
      "define internal i64 @asl_wasm_ipow(i64 %base, i64 %k) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %r = phi i64 [ 1, %entry ], [ %r1, %body ]"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %body ]"
      "  %done = icmp sge i64 %i, %k"
      "  br i1 %done, label %out, label %body"
      "body:"
      "  %r1 = mul i64 %r, %base"
      "  %i1 = add i64 %i, 1"
      "  br label %loop"
      "out:"
      "  ret i64 %r"
      "}"
      ""
      "define internal i32 @asl_wasm_big_cmp(ptr %a, i64 %alen, ptr %b, i64 %blen) {"
      "entry:"
      "  %lt = icmp ult i64 %alen, %blen"
      "  br i1 %lt, label %less, label %notLess"
      "notLess:"
      "  %gt = icmp ugt i64 %alen, %blen"
      "  br i1 %gt, label %greater, label %scan"
      "scan:"
      "  %i = phi i64 [ %alen, %notLess ], [ %j, %same ]"
      "  %end = icmp eq i64 %i, 0"
      "  br i1 %end, label %equal, label %step"
      "step:"
      "  %j = sub i64 %i, 1"
      "  %ap = getelementptr i32, ptr %a, i64 %j"
      "  %bp = getelementptr i32, ptr %b, i64 %j"
      "  %av = load i32, ptr %ap"
      "  %bv = load i32, ptr %bp"
      "  %l = icmp ult i32 %av, %bv"
      "  br i1 %l, label %less, label %step2"
      "step2:"
      "  %g = icmp ugt i32 %av, %bv"
      "  br i1 %g, label %greater, label %same"
      "same:"
      "  br label %scan"
      "less:"
      "  ret i32 -1"
      "greater:"
      "  ret i32 1"
      "equal:"
      "  ret i32 0"
      "}"
      ""
      "define internal i64 @asl_wasm_dec_digits(double %v, ptr %out, ptr %expOut) {"
      "entry:"
      "  %limbs = alloca [100 x i32], align 4"
      "  %bits = bitcast double %v to i64"
      "  %mant = and i64 %bits, 4503599627370495"
      "  %bexpRaw = lshr i64 %bits, 52"
      "  %bexp = and i64 %bexpRaw, 2047"
      "  %sub = icmp eq i64 %bexp, 0"
      "  %implicit = or i64 %mant, 4503599627370496"
      "  %f0 = select i1 %sub, i64 %mant, i64 %implicit"
      "  %enorm = sub i64 %bexp, 1075"
      "  %e0 = select i1 %sub, i64 -1074, i64 %enorm"
      "  br label %strip"
      "strip:"
      "  %f = phi i64 [ %f0, %entry ], [ %fh, %halve ]"
      "  %e = phi i64 [ %e0, %entry ], [ %eh, %halve ]"
      "  %low = and i64 %f, 1"
      "  %even = icmp eq i64 %low, 0"
      "  %neg = icmp slt i64 %e, 0"
      "  %can = and i1 %even, %neg"
      "  br i1 %can, label %halve, label %build"
      "halve:"
      "  %fh = lshr i64 %f, 1"
      "  %eh = add i64 %e, 1"
      "  br label %strip"
      "build:"
      "  %n0 = call i64 @asl_wasm_big_from(ptr %limbs, i64 %f, i64 100)"
      "  %pos = icmp sge i64 %e, 0"
      "  br i1 %pos, label %twos, label %fives"
      "twos:"
      "  %n2 = call i64 @asl_wasm_big_pow(ptr %limbs, i64 %n0, i64 2, i64 %e, i64 100)"
      "  br label %print"
      "fives:"
      "  %k = sub i64 0, %e"
      "  %n5 = call i64 @asl_wasm_big_pow(ptr %limbs, i64 %n0, i64 5, i64 %k, i64 100)"
      "  br label %print"
      "print:"
      "  %n = phi i64 [ %n2, %twos ], [ %n5, %fives ]"
      "  %scale = phi i64 [ 0, %twos ], [ %e, %fives ]"
      "  br label %limb"
      "limb:"
      "  %li = phi i64 [ %n, %print ], [ %lj, %limbDone ]"
      "  %at = phi i64 [ 0, %print ], [ %at9, %limbDone ]"
      "  %lend = icmp eq i64 %li, 0"
      "  br i1 %lend, label %trim, label %limbBody"
      "limbBody:"
      "  %lj = sub i64 %li, 1"
      "  %lp = getelementptr i32, ptr %limbs, i64 %lj"
      "  %lv32 = load i32, ptr %lp"
      "  %lv = zext i32 %lv32 to i64"
      "  br label %digit"
      "digit:"
      "  %d = phi i64 [ 8, %limbBody ], [ %d1, %digitBody ]"
      "  %x = phi i64 [ %lv, %limbBody ], [ %xq, %digitBody ]"
      "  %dend = icmp slt i64 %d, 0"
      "  br i1 %dend, label %limbDone, label %digitBody"
      "digitBody:"
      "  %xr = urem i64 %x, 10"
      "  %xq = udiv i64 %x, 10"
      "  %slot = add i64 %at, %d"
      "  %sp = getelementptr i8, ptr %out, i64 %slot"
      "  %ch64 = add i64 %xr, 48"
      "  %ch = trunc i64 %ch64 to i8"
      "  store i8 %ch, ptr %sp"
      "  %d1 = sub i64 %d, 1"
      "  br label %digit"
      "limbDone:"
      "  %at9 = add i64 %at, 9"
      "  br label %limb"
      "trim:"
      "  br label %lead"
      "lead:"
      "  %z = phi i64 [ 0, %trim ], [ %z1, %leadNext ]"
      "  %zp = getelementptr i8, ptr %out, i64 %z"
      "  %zc = load i8, ptr %zp"
      "  %isZero = icmp eq i8 %zc, 48"
      "  br i1 %isZero, label %leadNext, label %shift"
      "leadNext:"
      "  %z1 = add i64 %z, 1"
      "  br label %lead"
      "shift:"
      "  %total = sub i64 %at, %z"
      "  br label %move"
      "move:"
      "  %mi = phi i64 [ 0, %shift ], [ %mi1, %moveBody ]"
      "  %mdone = icmp uge i64 %mi, %total"
      "  br i1 %mdone, label %tail, label %moveBody"
      "moveBody:"
      "  %src = add i64 %mi, %z"
      "  %srcp = getelementptr i8, ptr %out, i64 %src"
      "  %dstp = getelementptr i8, ptr %out, i64 %mi"
      "  %mc = load i8, ptr %srcp"
      "  store i8 %mc, ptr %dstp"
      "  %mi1 = add i64 %mi, 1"
      "  br label %move"
      "tail:"
      "  %expTotal = sub i64 %total, 1"
      "  %exp10 = add i64 %expTotal, %scale"
      "  store i64 %exp10, ptr %expOut"
      "  br label %drop"
      "drop:"
      "  %len = phi i64 [ %total, %tail ], [ %lenm, %dropNext ]"
      "  %one = icmp ule i64 %len, 1"
      "  br i1 %one, label %done, label %dropCheck"
      "dropCheck:"
      "  %lastAt = sub i64 %len, 1"
      "  %lastp = getelementptr i8, ptr %out, i64 %lastAt"
      "  %lastc = load i8, ptr %lastp"
      "  %lastZero = icmp eq i8 %lastc, 48"
      "  br i1 %lastZero, label %dropNext, label %done"
      "dropNext:"
      "  %lenm = sub i64 %len, 1"
      "  br label %drop"
      "done:"
      "  ret i64 %len"
      "}"
      ""
      "define internal i64 @asl_wasm_dec_round(ptr %d, i64 %len, i64 %keep, ptr %carryOut) {"
      "entry:"
      "  store i64 0, ptr %carryOut"
      "  %all = icmp sge i64 %keep, %len"
      "  br i1 %all, label %whole, label %partial"
      "whole:"
      "  ret i64 %len"
      "partial:"
      "  %none = icmp slt i64 %keep, 0"
      "  br i1 %none, label %nothing, label %decide"
      "nothing:"
      "  ret i64 0"
      "decide:"
      "  %cp = getelementptr i8, ptr %d, i64 %keep"
      "  %c = load i8, ptr %cp"
      "  %above = icmp ugt i8 %c, 53"
      "  br i1 %above, label %up, label %maybe"
      "maybe:"
      "  %half = icmp eq i8 %c, 53"
      "  br i1 %half, label %sticky, label %down"
      "sticky:"
      "  %from = add i64 %keep, 1"
      "  br label %stickyLoop"
      "stickyLoop:"
      "  %si = phi i64 [ %from, %sticky ], [ %si1, %stickyNext ]"
      "  %send = icmp uge i64 %si, %len"
      "  br i1 %send, label %tie, label %stickyBody"
      "stickyBody:"
      "  %sp = getelementptr i8, ptr %d, i64 %si"
      "  %sc = load i8, ptr %sp"
      "  %nz = icmp ne i8 %sc, 48"
      "  br i1 %nz, label %up, label %stickyNext"
      "stickyNext:"
      "  %si1 = add i64 %si, 1"
      "  br label %stickyLoop"
      "tie:"
      "  %first = icmp eq i64 %keep, 0"
      "  br i1 %first, label %down, label %parity"
      "parity:"
      "  %prevAt = sub i64 %keep, 1"
      "  %pp = getelementptr i8, ptr %d, i64 %prevAt"
      "  %pc = load i8, ptr %pp"
      "  %podd = and i8 %pc, 1"
      "  %isOdd = icmp ne i8 %podd, 0"
      "  br i1 %isOdd, label %up, label %down"
      "down:"
      "  ret i64 %keep"
      "up:"
      "  %zeroKeep = icmp eq i64 %keep, 0"
      "  br i1 %zeroKeep, label %decade, label %carry"
      "carry:"
      "  %ci = phi i64 [ %keep, %up ], [ %cj, %nine ]"
      "  %cend = icmp eq i64 %ci, 0"
      "  br i1 %cend, label %decade, label %carryBody"
      "carryBody:"
      "  %cj = sub i64 %ci, 1"
      "  %cpp = getelementptr i8, ptr %d, i64 %cj"
      "  %cc = load i8, ptr %cpp"
      "  %is9 = icmp eq i8 %cc, 57"
      "  br i1 %is9, label %nine, label %bump"
      "nine:"
      "  store i8 48, ptr %cpp"
      "  br label %carry"
      "bump:"
      "  %cc1 = add i8 %cc, 1"
      "  store i8 %cc1, ptr %cpp"
      "  ret i64 %keep"
      "decade:"
      "  store i8 49, ptr %d"
      "  store i64 1, ptr %carryOut"
      "  ret i64 1"
      "}"
      ""
      "define internal void @asl_wasm_fmt_put(ptr %st, i8 %c) {"
      "entry:"
      "  %capp = getelementptr { ptr, i64, i64 }, ptr %st, i32 0, i32 1"
      "  %lenp = getelementptr { ptr, i64, i64 }, ptr %st, i32 0, i32 2"
      "  %cap = load i64, ptr %capp"
      "  %len = load i64, ptr %lenp"
      "  %next = add i64 %len, 1"
      "  %room = icmp ult i64 %next, %cap"
      "  br i1 %room, label %store, label %count"
      "store:"
      "  %buf = load ptr, ptr %st"
      "  %at = getelementptr i8, ptr %buf, i64 %len"
      "  store i8 %c, ptr %at"
      "  br label %count"
      "count:"
      "  store i64 %next, ptr %lenp"
      "  ret void"
      "}"
      ""
      "define internal void @asl_wasm_fmt_putn(ptr %st, ptr %s, i64 %n) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %body ]"
      "  %done = icmp sge i64 %i, %n"
      "  br i1 %done, label %out, label %body"
      "body:"
      "  %p = getelementptr i8, ptr %s, i64 %i"
      "  %c = load i8, ptr %p"
      "  call void @asl_wasm_fmt_put(ptr %st, i8 %c)"
      "  %i1 = add i64 %i, 1"
      "  br label %loop"
      "out:"
      "  ret void"
      "}"
      ""
      "define internal void @asl_wasm_fmt_pad(ptr %st, i8 %c, i64 %n) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %body ]"
      "  %done = icmp sge i64 %i, %n"
      "  br i1 %done, label %out, label %body"
      "body:"
      "  call void @asl_wasm_fmt_put(ptr %st, i8 %c)"
      "  %i1 = add i64 %i, 1"
      "  br label %loop"
      "out:"
      "  ret void"
      "}"
      ""
      "define internal void @asl_wasm_fmt_field(ptr %st, ptr %pre, i64 %preLen, i64 %zeros, ptr %body, i64 %bodyLen, i64 %width, i1 %left, i1 %zero) {"
      "entry:"
      "  %a = add i64 %preLen, %zeros"
      "  %used = add i64 %a, %bodyLen"
      "  %gap0 = sub i64 %width, %used"
      "  %pos = icmp sgt i64 %gap0, 0"
      "  %gap = select i1 %pos, i64 %gap0, i64 0"
      "  br i1 %left, label %leftField, label %rightField"
      "leftField:"
      "  call void @asl_wasm_fmt_putn(ptr %st, ptr %pre, i64 %preLen)"
      "  call void @asl_wasm_fmt_pad(ptr %st, i8 48, i64 %zeros)"
      "  call void @asl_wasm_fmt_putn(ptr %st, ptr %body, i64 %bodyLen)"
      "  call void @asl_wasm_fmt_pad(ptr %st, i8 32, i64 %gap)"
      "  ret void"
      "rightField:"
      "  br i1 %zero, label %zeroField, label %spaceField"
      "zeroField:"
      "  call void @asl_wasm_fmt_putn(ptr %st, ptr %pre, i64 %preLen)"
      "  %z = add i64 %zeros, %gap"
      "  call void @asl_wasm_fmt_pad(ptr %st, i8 48, i64 %z)"
      "  call void @asl_wasm_fmt_putn(ptr %st, ptr %body, i64 %bodyLen)"
      "  ret void"
      "spaceField:"
      "  call void @asl_wasm_fmt_pad(ptr %st, i8 32, i64 %gap)"
      "  call void @asl_wasm_fmt_putn(ptr %st, ptr %pre, i64 %preLen)"
      "  call void @asl_wasm_fmt_pad(ptr %st, i8 48, i64 %zeros)"
      "  call void @asl_wasm_fmt_putn(ptr %st, ptr %body, i64 %bodyLen)"
      "  ret void"
      "}"
      ""
      "define internal void @asl_wasm_fmt_int(ptr %st, i64 %v, i1 %signed, i64 %radix, i1 %upper, i64 %prec, i64 %width, i64 %flags) {"
      "entry:"
      "  %digits = alloca [24 x i8], align 1"
      "  %pre = alloca [3 x i8], align 1"
      "  %neg = icmp slt i64 %v, 0"
      "  %isNeg = and i1 %signed, %neg"
      "  %negated = sub i64 0, %v"
      "  %mag = select i1 %isNeg, i64 %negated, i64 %v"
      "  %noPrec = icmp slt i64 %prec, 0"
      "  %prec1 = select i1 %noPrec, i64 1, i64 %prec"
      "  %isZeroV = icmp eq i64 %mag, 0"
      "  %emptyDigits = icmp eq i64 %prec1, 0"
      "  %skip = and i1 %isZeroV, %emptyDigits"
      "  br i1 %skip, label %rendered, label %render"
      "render:"
      "  br label %loop"
      "loop:"
      "  %x = phi i64 [ %mag, %render ], [ %q, %loop ]"
      "  %n = phi i64 [ 0, %render ], [ %n1, %loop ]"
      "  %r = urem i64 %x, %radix"
      "  %q = udiv i64 %x, %radix"
      "  %small = icmp ult i64 %r, 10"
      "  %dch = add i64 %r, 48"
      "  %lowerBase = select i1 %upper, i64 55, i64 87"
      "  %ach = add i64 %r, %lowerBase"
      "  %ch64 = select i1 %small, i64 %dch, i64 %ach"
      "  %ch = trunc i64 %ch64 to i8"
      "  %rev = sub i64 23, %n"
      "  %slot = getelementptr i8, ptr %digits, i64 %rev"
      "  store i8 %ch, ptr %slot"
      "  %n1 = add i64 %n, 1"
      "  %more = icmp ne i64 %q, 0"
      "  br i1 %more, label %loop, label %rendered"
      "rendered:"
      "  %count = phi i64 [ 0, %entry ], [ %n1, %loop ]"
      "  %startAt = sub i64 24, %count"
      "  %body = getelementptr i8, ptr %digits, i64 %startAt"
      "  %padNeed = sub i64 %prec1, %count"
      "  %padPos = icmp sgt i64 %padNeed, 0"
      "  %zerosP = select i1 %padPos, i64 %padNeed, i64 0"
      "  %plusBit = and i64 %flags, 4"
      "  %spaceBit = and i64 %flags, 8"
      "  %altBit = and i64 %flags, 16"
      "  %hasPlus = icmp ne i64 %plusBit, 0"
      "  %hasSpace = icmp ne i64 %spaceBit, 0"
      "  %hasAlt = icmp ne i64 %altBit, 0"
      "  br i1 %isNeg, label %minus, label %unsigned"
      "minus:"
      "  store i8 45, ptr %pre"
      "  br label %prefixed"
      "unsigned:"
      "  %plusSigned = and i1 %hasPlus, %signed"
      "  br i1 %plusSigned, label %plus, label %space"
      "plus:"
      "  store i8 43, ptr %pre"
      "  br label %prefixed"
      "space:"
      "  %spaceSigned = and i1 %hasSpace, %signed"
      "  br i1 %spaceSigned, label %spaceSign, label %alt"
      "spaceSign:"
      "  store i8 32, ptr %pre"
      "  br label %prefixed"
      "alt:"
      "  %hex = icmp eq i64 %radix, 16"
      "  %notZero = icmp ne i64 %mag, 0"
      "  %hexAlt0 = and i1 %hex, %hasAlt"
      "  %hexAlt = and i1 %hexAlt0, %notZero"
      "  br i1 %hexAlt, label %hexPrefix, label %octal"
      "hexPrefix:"
      "  store i8 48, ptr %pre"
      "  %xAt = getelementptr i8, ptr %pre, i64 1"
      "  %xch = select i1 %upper, i8 88, i8 120"
      "  store i8 %xch, ptr %xAt"
      "  br label %prefixedTwo"
      "octal:"
      "  %oct = icmp eq i64 %radix, 8"
      "  %octAlt = and i1 %oct, %hasAlt"
      "  %noLeadZero = icmp eq i64 %zerosP, 0"
      "  %firstAt = getelementptr i8, ptr %body, i64 0"
      "  %firstCh = load i8, ptr %firstAt"
      "  %firstNotZero = icmp ne i8 %firstCh, 48"
      "  %bodyEmpty = icmp eq i64 %count, 0"
      "  %firstMissing = or i1 %bodyEmpty, %firstNotZero"
      "  %needZero0 = and i1 %octAlt, %noLeadZero"
      "  %needZero = and i1 %needZero0, %firstMissing"
      "  %zerosO = select i1 %needZero, i64 1, i64 %zerosP"
      "  br label %emit"
      "prefixed:"
      "  br label %emit"
      "prefixedTwo:"
      "  br label %emit"
      "emit:"
      "  %preLen = phi i64 [ 1, %prefixed ], [ 2, %prefixedTwo ], [ 0, %octal ]"
      "  %zeros = phi i64 [ %zerosP, %prefixed ], [ %zerosP, %prefixedTwo ], [ %zerosO, %octal ]"
      "  %leftBit = and i64 %flags, 1"
      "  %zeroBit = and i64 %flags, 2"
      "  %left = icmp ne i64 %leftBit, 0"
      "  %zeroFlag = icmp ne i64 %zeroBit, 0"
      "  %zeroOk0 = and i1 %zeroFlag, %noPrec"
      "  call void @asl_wasm_fmt_field(ptr %st, ptr %pre, i64 %preLen, i64 %zeros, ptr %body, i64 %count, i64 %width, i1 %left, i1 %zeroOk0)"
      "  ret void"
      "}"
