      "  %qm1 = sub i64 %q, 1"
      "  %cu = call i32 @asl_wasm_cmp_decimal(ptr %d, i64 %n, i64 %exp, i64 %upperA, i64 %qm1)"
      "  %above = icmp sgt i32 %cu, 0"
      "  br i1 %above, label %goUp, label %notAbove"
      "goUp:"
      "  %upBits = add i64 %xbits, 1"
      "  %xUp = bitcast i64 %upBits to double"
      "  %upInf = icmp eq i64 %upBits, 9218868437227405312"
      "  br i1 %upInf, label %infinite, label %fix"
      "notAbove:"
      "  %tieUp = icmp eq i32 %cu, 0"
      "  br i1 %tieUp, label %tieAbove, label %below"
      "tieAbove:"
      "  %mOdd = and i64 %m, 1"
      "  %odd = icmp ne i64 %mOdd, 0"
      "  br i1 %odd, label %roundUpOnce, label %done"
      "roundUpOnce:"
      "  %rBits = add i64 %xbits, 1"
      "  %xr = bitcast i64 %rBits to double"
      "  %rInf = icmp eq i64 %rBits, 9218868437227405312"
      "  br i1 %rInf, label %infinite, label %finalUp"
      "finalUp:"
      "  ret double %xr"
      "below:"
      "  %isZeroM = icmp eq i64 %xbits, 0"
      "  br i1 %isZeroM, label %done, label %lowerMid"
      "lowerMid:"
      "  %boundary0 = icmp eq i64 %mantBits, 0"
      "  %bexpBig = icmp ugt i64 %bexp, 1"
      "  %boundary = and i1 %boundary0, %bexpBig"
      "  %fourM = shl i64 %m, 2"
      "  %lowA4 = sub i64 %fourM, 1"
      "  %qm2 = sub i64 %q, 2"
      "  %lowA2 = sub i64 %twoM, 1"
      "  %lowA = select i1 %boundary, i64 %lowA4, i64 %lowA2"
      "  %lowQ = select i1 %boundary, i64 %qm2, i64 %qm1"
      "  %cl = call i32 @asl_wasm_cmp_decimal(ptr %d, i64 %n, i64 %exp, i64 %lowA, i64 %lowQ)"
      "  %beneath = icmp slt i32 %cl, 0"
      "  br i1 %beneath, label %goDown, label %lowTie"
      "goDown:"
      "  %downBits = sub i64 %xbits, 1"
      "  %xDown = bitcast i64 %downBits to double"
      "  br label %fix"
      "lowTie:"
      "  %tieLow = icmp eq i32 %cl, 0"
      "  %mOddL = and i64 %m, 1"
      "  %oddL = icmp ne i64 %mOddL, 0"
      "  %stepDown = and i1 %tieLow, %oddL"
      "  br i1 %stepDown, label %finalDown, label %done"
      "finalDown:"
      "  %fdBits = sub i64 %xbits, 1"
      "  %xfd = bitcast i64 %fdBits to double"
      "  ret double %xfd"
      "done:"
      "  %xd = bitcast i64 %xbits to double"
      "  ret double %xd"
      "infinite:"
      "  ret double 0x7FF0000000000000"
      "zero:"
      "  ret double 0.0"
      "}"
