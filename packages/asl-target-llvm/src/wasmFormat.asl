      "define internal i64 @asl_wasm_strnlen(ptr %s, i64 %max) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %body ]"
      "  %bounded = icmp sge i64 %max, 0"
      "  %atMax = icmp sge i64 %i, %max"
      "  %stop = and i1 %bounded, %atMax"
      "  br i1 %stop, label %out, label %body"
      "body:"
      "  %p = getelementptr i8, ptr %s, i64 %i"
      "  %c = load i8, ptr %p"
      "  %nul = icmp eq i8 %c, 0"
      "  %i1 = add i64 %i, 1"
      "  br i1 %nul, label %out, label %loop"
      "out:"
      "  ret i64 %i"
      "}"
