      "define internal i64 @asl_wasm_big_add(ptr %a, i64 %len, i64 %v, i64 %cap) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %body ]"
      "  %carry = phi i64 [ %v, %entry ], [ %c1, %body ]"
      "  %n = phi i64 [ %len, %entry ], [ %nb, %body ]"
      "  %zero = icmp eq i64 %carry, 0"
      "  br i1 %zero, label %out, label %room"
      "room:"
      "  %inside = icmp ult i64 %i, %n"
      "  br i1 %inside, label %body, label %grow"
      "grow:"
      "  %full = icmp uge i64 %n, %cap"
      "  br i1 %full, label %overflow, label %fresh"
      "overflow:"
      "  call void @llvm.trap()"
      "  unreachable"
      "fresh:"
      "  %fp = getelementptr i32, ptr %a, i64 %i"
      "  store i32 0, ptr %fp"
      "  %nf = add i64 %n, 1"
      "  br label %body"
      "body:"
      "  %nb = phi i64 [ %n, %room ], [ %nf, %fresh ]"
      "  %p = getelementptr i32, ptr %a, i64 %i"
      "  %x32 = load i32, ptr %p"
      "  %x = zext i32 %x32 to i64"
      "  %t = add i64 %x, %carry"
      "  %lo = urem i64 %t, 1000000000"
      "  %c1 = udiv i64 %t, 1000000000"
      "  %lo32 = trunc i64 %lo to i32"
      "  store i32 %lo32, ptr %p"
      "  %i1 = add i64 %i, 1"
      "  br label %loop"
      "out:"
      "  ret i64 %n"
      "}"
