      "define internal double @asl_wasm_scale10(double %w, i64 %e10) {"
      "entry:"
      "  %neg = icmp slt i64 %e10, 0"
      "  %abs0 = sub i64 0, %e10"
      "  %abs = select i1 %neg, i64 %abs0, i64 %e10"
      "  br label %chunks"
      "chunks:"
      "  %v = phi double [ %w, %entry ], [ %v1, %chunk ]"
      "  %left = phi i64 [ %abs, %entry ], [ %left1, %chunk ]"
      "  %big = icmp sgt i64 %left, 256"
      "  br i1 %big, label %chunk, label %last"
      "chunk:"
      "  %p256 = call double @asl_wasm_pow10(i64 256)"
      "  %vm = fmul double %v, %p256"
      "  %vd = fdiv double %v, %p256"
      "  %v1 = select i1 %neg, double %vd, double %vm"
      "  %left1 = sub i64 %left, 256"
      "  br label %chunks"
      "last:"
      "  %p = call double @asl_wasm_pow10(i64 %left)"
      "  %lm = fmul double %v, %p"
      "  %ld = fdiv double %v, %p"
      "  %r = select i1 %neg, double %ld, double %lm"
      "  ret double %r"
      "}"
      ""
      "define internal double @asl_wasm_pow10(i64 %k) {"
      "entry:"
      "  br label %loop"
      "loop:"
      "  %r = phi double [ 1.0, %entry ], [ %r1, %next ]"
      "  %base = phi double [ 10.0, %entry ], [ %base1, %next ]"
      "  %e = phi i64 [ %k, %entry ], [ %e1, %next ]"
      "  %done = icmp eq i64 %e, 0"
      "  br i1 %done, label %out, label %body"
      "body:"
      "  %bit = and i64 %e, 1"
      "  %set = icmp ne i64 %bit, 0"
      "  %rm = fmul double %r, %base"
      "  %r1 = select i1 %set, double %rm, double %r"
      "  br label %next"
      "next:"
      "  %base1 = fmul double %base, %base"
      "  %e1 = lshr i64 %e, 1"
      "  br label %loop"
      "out:"
      "  ret double %r"
      "}"
      ""
      "define internal i32 @asl_wasm_cmp_decimal(ptr %d, i64 %n, i64 %exp10, i64 %a, i64 %b) {"
      "entry:"
      "  %left = alloca [300 x i32], align 4"
      "  %right = alloca [300 x i32], align 4"
      "  br label %build"
      "build:"
      "  %i = phi i64 [ 0, %entry ], [ %i9, %chunkDone ]"
      "  %len = phi i64 [ 0, %entry ], [ %len2, %chunkDone ]"
      "  %more = icmp ult i64 %i, %n"
      "  br i1 %more, label %chunk, label %built"
      "chunk:"
      "  %rem = sub i64 %n, %i"
      "  %short = icmp ult i64 %rem, 9"
      "  %take = select i1 %short, i64 %rem, i64 9"
      "  br label %acc"
      "acc:"
      "  %j = phi i64 [ 0, %chunk ], [ %j1, %accBody ]"
      "  %v = phi i64 [ 0, %chunk ], [ %v1, %accBody ]"
      "  %jdone = icmp uge i64 %j, %take"
      "  br i1 %jdone, label %accDone, label %accBody"
      "accBody:"
      "  %at = add i64 %i, %j"
      "  %dp = getelementptr i8, ptr %d, i64 %at"
      "  %dc = load i8, ptr %dp"
      "  %dc64 = zext i8 %dc to i64"
      "  %vm = mul i64 %v, 10"
      "  %v1 = add i64 %vm, %dc64"
      "  %j1 = add i64 %j, 1"
      "  br label %acc"
      "accDone:"
      "  %unit = call i64 @asl_wasm_ipow(i64 10, i64 %take)"
      "  %len1 = call i64 @asl_wasm_big_mul(ptr %left, i64 %len, i64 %unit, i64 300)"
      "  %len2 = call i64 @asl_wasm_big_add(ptr %left, i64 %len1, i64 %v, i64 300)"
      "  %i9 = add i64 %i, %take"
      "  br label %chunkDone"
      "chunkDone:"
      "  br label %build"
      "built:"
      "  %rlen0 = call i64 @asl_wasm_big_from(ptr %right, i64 %a, i64 300)"
      "  %eNeg = icmp slt i64 %exp10, 0"
      "  br i1 %eNeg, label %rightTen, label %leftTen"
      "leftTen:"
      "  %lt = call i64 @asl_wasm_big_pow(ptr %left, i64 %len, i64 10, i64 %exp10, i64 300)"
      "  br label %twos"
      "rightTen:"
      "  %ek = sub i64 0, %exp10"
      "  %rt = call i64 @asl_wasm_big_pow(ptr %right, i64 %rlen0, i64 10, i64 %ek, i64 300)"
      "  br label %twos"
      "twos:"
      "  %l1 = phi i64 [ %lt, %leftTen ], [ %len, %rightTen ]"
      "  %r1 = phi i64 [ %rlen0, %leftTen ], [ %rt, %rightTen ]"
      "  %bNeg = icmp slt i64 %b, 0"
      "  br i1 %bNeg, label %leftTwo, label %rightTwo"
      "leftTwo:"
      "  %bk = sub i64 0, %b"
      "  %l2 = call i64 @asl_wasm_big_pow(ptr %left, i64 %l1, i64 2, i64 %bk, i64 300)"
      "  br label %compare"
      "rightTwo:"
      "  %r2 = call i64 @asl_wasm_big_pow(ptr %right, i64 %r1, i64 2, i64 %b, i64 300)"
      "  br label %compare"
      "compare:"
      "  %lf = phi i64 [ %l2, %leftTwo ], [ %l1, %rightTwo ]"
      "  %rf = phi i64 [ %r1, %leftTwo ], [ %r2, %rightTwo ]"
      "  %c = call i32 @asl_wasm_big_cmp(ptr %left, i64 %lf, ptr %right, i64 %rf)"
      "  ret i32 %c"
      "}"
