      "define internal i64 @asl_wasm_fmt_float_text(ptr %out, double %mag, i64 %prec, i1 %exp, i1 %upper, i1 %alt) {"
      "entry:"
      "  %digits = alloca [900 x i8], align 1"
      "  %exp10p = alloca i64, align 8"
      "  %carryp = alloca i64, align 8"
      "  %isZero = fcmp oeq double %mag, 0.0"
      "  br i1 %isZero, label %zero, label %nonzero"
      "zero:"
      "  store i8 48, ptr %digits"
      "  store i64 0, ptr %exp10p"
      "  br label %have"
      "nonzero:"
      "  %n0 = call i64 @asl_wasm_dec_digits(double %mag, ptr %digits, ptr %exp10p)"
      "  br label %have"
      "have:"
      "  %n = phi i64 [ 1, %zero ], [ %n0, %nonzero ]"
      "  %x0 = load i64, ptr %exp10p"
      "  br i1 %exp, label %sci, label %fixed"
      "sci:"
      "  %keepS = add i64 %prec, 1"
      "  %lenS = call i64 @asl_wasm_dec_round(ptr %digits, i64 %n, i64 %keepS, ptr %carryp)"
      "  %cs = load i64, ptr %carryp"
      "  %xs = add i64 %x0, %cs"
      "  store i8 0, ptr %out"
      "  %d0 = load i8, ptr %digits"
      "  store i8 %d0, ptr %out"
      "  %wantPoint = icmp sgt i64 %prec, 0"
      "  %point = or i1 %wantPoint, %alt"
      "  br i1 %point, label %sciPoint, label %sciFrac"
      "sciPoint:"
      "  %pp = getelementptr i8, ptr %out, i64 1"
      "  store i8 46, ptr %pp"
      "  br label %sciFrac"
      "sciFrac:"
      "  %at0 = phi i64 [ 1, %sci ], [ 2, %sciPoint ]"
      "  br label %sciLoop"
      "sciLoop:"
      "  %j = phi i64 [ 1, %sciFrac ], [ %j1, %sciBody ]"
      "  %at = phi i64 [ %at0, %sciFrac ], [ %at1, %sciBody ]"
      "  %jdone = icmp sgt i64 %j, %prec"
      "  br i1 %jdone, label %sciExp, label %sciBody"
      "sciBody:"
      "  %have1 = icmp slt i64 %j, %lenS"
      "  %dp = getelementptr i8, ptr %digits, i64 %j"
      "  %dv = load i8, ptr %dp"
      "  %dch = select i1 %have1, i8 %dv, i8 48"
      "  %op = getelementptr i8, ptr %out, i64 %at"
      "  store i8 %dch, ptr %op"
      "  %j1 = add i64 %j, 1"
      "  %at1 = add i64 %at, 1"
      "  br label %sciLoop"
      "sciExp:"
      "  %ep = getelementptr i8, ptr %out, i64 %at"
      "  %ech = select i1 %upper, i8 69, i8 101"
      "  store i8 %ech, ptr %ep"
      "  %xneg = icmp slt i64 %xs, 0"
      "  %sgn = select i1 %xneg, i8 45, i8 43"
      "  %sAt = add i64 %at, 1"
      "  %sp = getelementptr i8, ptr %out, i64 %sAt"
      "  store i8 %sgn, ptr %sp"
      "  %xn = sub i64 0, %xs"
      "  %xa = select i1 %xneg, i64 %xn, i64 %xs"
      "  %big3 = icmp sge i64 %xa, 100"
      "  %dAt = add i64 %at, 2"
      "  br i1 %big3, label %three, label %two"
      "three:"
      "  %h = udiv i64 %xa, 100"
      "  %hch64 = add i64 %h, 48"
      "  %hch = trunc i64 %hch64 to i8"
      "  %hp = getelementptr i8, ptr %out, i64 %dAt"
      "  store i8 %hch, ptr %hp"
      "  %rest = urem i64 %xa, 100"
      "  %tAt3 = add i64 %dAt, 1"
      "  br label %tens"
      "two:"
      "  br label %tens"
      "tens:"
      "  %tv = phi i64 [ %rest, %three ], [ %xa, %two ]"
      "  %tAt = phi i64 [ %tAt3, %three ], [ %dAt, %two ]"
      "  %t = udiv i64 %tv, 10"
      "  %u = urem i64 %tv, 10"
      "  %tch64 = add i64 %t, 48"
      "  %tch = trunc i64 %tch64 to i8"
      "  %uch64 = add i64 %u, 48"
      "  %uch = trunc i64 %uch64 to i8"
      "  %tp = getelementptr i8, ptr %out, i64 %tAt"
      "  store i8 %tch, ptr %tp"
      "  %uAt = add i64 %tAt, 1"
      "  %up = getelementptr i8, ptr %out, i64 %uAt"
      "  store i8 %uch, ptr %up"
      "  %endS = add i64 %uAt, 1"
      "  ret i64 %endS"
      "fixed:"
      "  %intDigits = add i64 %x0, 1"
      "  %keepF = add i64 %intDigits, %prec"
      "  %lenF = call i64 @asl_wasm_dec_round(ptr %digits, i64 %n, i64 %keepF, ptr %carryp)"
      "  %cf = load i64, ptr %carryp"
      "  %xf = add i64 %x0, %cf"
      "  %intPos = icmp sge i64 %xf, 0"
      "  br i1 %intPos, label %intPart, label %intZero"
      "intZero:"
      "  store i8 48, ptr %out"
      "  br label %point2"
      "intPart:"
      "  br label %intLoop"
      "intLoop:"
      "  %ii = phi i64 [ 0, %intPart ], [ %ii1, %intBody ]"
      "  %idone = icmp sgt i64 %ii, %xf"
      "  br i1 %idone, label %point2, label %intBody"
      "intBody:"
      "  %ihave = icmp slt i64 %ii, %lenF"
      "  %ip = getelementptr i8, ptr %digits, i64 %ii"
      "  %iv = load i8, ptr %ip"
      "  %ich = select i1 %ihave, i8 %iv, i8 48"
      "  %iop = getelementptr i8, ptr %out, i64 %ii"
      "  store i8 %ich, ptr %iop"
      "  %ii1 = add i64 %ii, 1"
      "  br label %intLoop"
      "point2:"
      "  %atF0 = phi i64 [ 1, %intZero ], [ %ii, %intLoop ]"
      "  %wantPointF = icmp sgt i64 %prec, 0"
      "  %pointF = or i1 %wantPointF, %alt"
      "  br i1 %pointF, label %fracPoint, label %fracDone"
      "fracPoint:"
      "  %fpp = getelementptr i8, ptr %out, i64 %atF0"
      "  store i8 46, ptr %fpp"
      "  %atF1 = add i64 %atF0, 1"
      "  br label %fracLoop"
      "fracLoop:"
      "  %fj = phi i64 [ 1, %fracPoint ], [ %fj1, %fracBody ]"
      "  %fat = phi i64 [ %atF1, %fracPoint ], [ %fat1, %fracBody ]"
      "  %fdone = icmp sgt i64 %fj, %prec"
      "  br i1 %fdone, label %fracDone, label %fracBody"
      "fracBody:"
      "  %fidx = add i64 %xf, %fj"
      "  %fnonneg = icmp sge i64 %fidx, 0"
      "  %fin = icmp slt i64 %fidx, %lenF"
      "  %fhave = and i1 %fnonneg, %fin"
      "  %fsafe = select i1 %fhave, i64 %fidx, i64 0"
      "  %fdp = getelementptr i8, ptr %digits, i64 %fsafe"
      "  %fdv = load i8, ptr %fdp"
      "  %fch = select i1 %fhave, i8 %fdv, i8 48"
      "  %fop = getelementptr i8, ptr %out, i64 %fat"
      "  store i8 %fch, ptr %fop"
      "  %fj1 = add i64 %fj, 1"
      "  %fat1 = add i64 %fat, 1"
      "  br label %fracLoop"
      "fracDone:"
      "  %endF = phi i64 [ %atF0, %point2 ], [ %fat, %fracLoop ]"
      "  ret i64 %endF"
      "}"
