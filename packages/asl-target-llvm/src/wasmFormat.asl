      "define i32 @atoi(ptr %s) {"
      "entry:"
      "  br label %ws"
      "ws:"
      "  %i = phi i64 [ 0, %entry ], [ %i1, %ws ]"
      "  %p = getelementptr i8, ptr %s, i64 %i"
      "  %c = load i8, ptr %p"
      "  %isSp = icmp eq i8 %c, 32"
      "  %ge9 = icmp uge i8 %c, 9"
      "  %le13 = icmp ule i8 %c, 13"
      "  %ctl = and i1 %ge9, %le13"
      "  %white = or i1 %isSp, %ctl"
      "  %i1 = add i64 %i, 1"
      "  br i1 %white, label %ws, label %sign"
      "sign:"
      "  %isMinus = icmp eq i8 %c, 45"
      "  %isPlus = icmp eq i8 %c, 43"
      "  %signed = or i1 %isMinus, %isPlus"
      "  %start = select i1 %signed, i64 %i1, i64 %i"
      "  br label %digits"
      "digits:"
      "  %j = phi i64 [ %start, %sign ], [ %j1, %digit ]"
      "  %acc = phi i32 [ 0, %sign ], [ %acc1, %digit ]"
      "  %dp = getelementptr i8, ptr %s, i64 %j"
      "  %dc = load i8, ptr %dp"
      "  %ge = icmp uge i8 %dc, 48"
      "  %le = icmp ule i8 %dc, 57"
      "  %isDigit = and i1 %ge, %le"
      "  br i1 %isDigit, label %digit, label %done"
      "digit:"
      "  %dv = sub i8 %dc, 48"
      "  %dv32 = zext i8 %dv to i32"
      "  %m = mul i32 %acc, 10"
      "  %acc1 = add i32 %m, %dv32"
      "  %j1 = add i64 %j, 1"
      "  br label %digits"
      "done:"
      "  %neg = sub i32 0, %acc"
      "  %r = select i1 %isMinus, i32 %neg, i32 %acc"
      "  ret i32 %r"
      "}")
    "\n")
