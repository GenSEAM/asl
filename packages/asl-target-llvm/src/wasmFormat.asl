      "define internal void @asl_wasm_fmt_float(ptr %st, double %v, i64 %prec0, i64 %conv, i64 %width, i64 %flags) {"
      "entry:"
      "  %pre = alloca i8, align 1"
      "  %noPrec = icmp slt i64 %prec0, 0"
      "  %prec = select i1 %noPrec, i64 6, i64 %prec0"
      "  %upperE = icmp eq i64 %conv, 69"
      "  %upperF = icmp eq i64 %conv, 70"
      "  %upper = or i1 %upperE, %upperF"
      "  %lowerE = icmp eq i64 %conv, 101"
      "  %exp = or i1 %lowerE, %upperE"
      "  %bits = bitcast double %v to i64"
      "  %neg = icmp slt i64 %bits, 0"
      "  %mag = call double @llvm.fabs.f64(double %v)"
      "  %plusBit = and i64 %flags, 4"
      "  %spaceBit = and i64 %flags, 8"
      "  %altBit = and i64 %flags, 16"
      "  %leftBit = and i64 %flags, 1"
      "  %zeroBit = and i64 %flags, 2"
      "  %hasPlus = icmp ne i64 %plusBit, 0"
      "  %hasSpace = icmp ne i64 %spaceBit, 0"
      "  %alt = icmp ne i64 %altBit, 0"
      "  %left = icmp ne i64 %leftBit, 0"
      "  %zeroFlag = icmp ne i64 %zeroBit, 0"
      "  %signCh0 = select i1 %hasSpace, i8 32, i8 0"
      "  %signCh1 = select i1 %hasPlus, i8 43, i8 %signCh0"
      "  %signCh = select i1 %neg, i8 45, i8 %signCh1"
      "  store i8 %signCh, ptr %pre"
      "  %hasSign = icmp ne i8 %signCh, 0"
      "  %preLen = zext i1 %hasSign to i64"
      "  %isNan = fcmp uno double %v, %v"
      "  %isInf = fcmp oeq double %mag, 0x7FF0000000000000"
      "  %special = or i1 %isNan, %isInf"
      "  %size = add i64 %prec, 340"
      "  %out = alloca i8, i64 %size, align 1"
      "  br i1 %special, label %word, label %number"
      "word:"
      "  %c0l = select i1 %isNan, i8 110, i8 105"
      "  %c1l = select i1 %isNan, i8 97, i8 110"
      "  %c2l = select i1 %isNan, i8 110, i8 102"
      "  %c0u = sub i8 %c0l, 32"
      "  %c1u = sub i8 %c1l, 32"
      "  %c2u = sub i8 %c2l, 32"
      "  %c0 = select i1 %upper, i8 %c0u, i8 %c0l"
      "  %c1 = select i1 %upper, i8 %c1u, i8 %c1l"
      "  %c2 = select i1 %upper, i8 %c2u, i8 %c2l"
      "  store i8 %c0, ptr %out"
      "  %o1 = getelementptr i8, ptr %out, i64 1"
      "  store i8 %c1, ptr %o1"
      "  %o2 = getelementptr i8, ptr %out, i64 2"
      "  store i8 %c2, ptr %o2"
      "  %nanSign = and i1 %isNan, true"
      "  %wordPre = select i1 %isNan, i64 0, i64 %preLen"
      "  call void @asl_wasm_fmt_field(ptr %st, ptr %pre, i64 %wordPre, i64 0, ptr %out, i64 3, i64 %width, i1 %left, i1 false)"
      "  ret void"
      "number:"
      "  %len = call i64 @asl_wasm_fmt_float_text(ptr %out, double %mag, i64 %prec, i1 %exp, i1 %upper, i1 %alt)"
      "  call void @asl_wasm_fmt_field(ptr %st, ptr %pre, i64 %preLen, i64 0, ptr %out, i64 %len, i64 %width, i1 %left, i1 %zeroFlag)"
      "  ret void"
      "}"
