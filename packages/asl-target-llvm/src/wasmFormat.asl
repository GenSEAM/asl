      "@.asl_wasm_null = private unnamed_addr constant [7 x i8] c\"(null)\\00\""
      "@.asl_wasm_fmt_code = private unnamed_addr constant [13 x i8] c\"ERR_INTERNAL\\00\""
      "@.asl_wasm_fmt_unsupported = private unnamed_addr constant [51 x i8] c\"wasm32 printf: unsupported conversion in format %s\\00\""
