(module asl-target-llvm/sysProc
  :x [procSpawnFn procWaitFn procWaitAnyFn procKillFn procSelfFn procAliveFn
      sysProcExterns sysProcFunctions sysProcRecords
      procRouteBuiltins procRouteExterns procRouteStrings procRouteRecords procRouteFunctions procPreludeGlobals procFactNames]
  :i [(asl-ir/types :a ty)
      (asl-target-llvm/sys :a sys)
      (asl-target-llvm/libc :a libc)])

fn appendAll lists: (List (List V)) -> (List V)
  (fold (fn [(acc (List V)) (l (List V))] -> (List V) (listAppend acc l)) (list) lists)

fn stringToPtrInstrs dest: String v: String -> (List ty/SsaInstr)
  (list
    (sys/int32Const (str dest ".repr") 0)
    (sys/callInstr dest (ty/tyPtr) "valToCStr" (list v (str dest ".repr"))))

fn constructResult dest: String variant: String field: String -> ty/SsaInstr
  (ty/ssaInstr dest (ty/tyVal) (ty/opConstruct "Result" variant (list field)))

fn freeInstr dest: String ptrName: String -> ty/SsaInstr
  (sys/callInstr dest (ty/tyI64) "free" (list ptrName))

fn errnoErrBlock label: String preFrees: (List ty/SsaInstr) nextLabel: String -> ty/SsaBlock
  (sys/block label
    (listAppend
      (list (sys/callInstr (str label ".errno") (ty/tyI64) "sysErrnoValue" (list)))
      (listAppend preFrees
        (list (ty/ssaInstr (str label ".box") (ty/tyVal) (ty/opBox (str label ".errno"))))))
    (ty/termJump (ty/ssaEdge nextLabel (list (str label ".box")))))

fn errnoFinBlock label: String -> ty/SsaBlock
  (ty/ssaBlock label (list (ty/ssaParam (str label ".box") (ty/tyVal)))
    (list (constructResult (str label ".errv") "err" (str label ".box")))
    (ty/termReturn (str label ".errv")))

fn ptrArrayBlocks prefix: String listVar: String okLabel: String errLabel: String -> (List ty/SsaBlock)
  (list
    (sys/block (str prefix ".setup")
      (list (sys/int64Const (str prefix ".cntZero") 0))
      (ty/termJump (ty/ssaEdge (str prefix ".count") (list listVar (str prefix ".cntZero")))))
    (ty/ssaBlock (str prefix ".count") (list (ty/ssaParam (str prefix ".crem") (ty/tyVal)) (ty/ssaParam (str prefix ".ccnt") (ty/tyI64)))
      (list (sys/entryInstr (str prefix ".cEmpty") (ty/tyI1) "listEmpty?" (list (str prefix ".crem"))))
      (ty/termBranch (str prefix ".cEmpty") (ty/ssaEdge (str prefix ".alloc") (list (str prefix ".ccnt"))) (sys/edgeTo (str prefix ".cstep"))))
    (sys/block (str prefix ".cstep")
      (list
        (sys/entryInstr (str prefix ".crest") (ty/tyVal) "@listRest" (list (str prefix ".crem")))
        (sys/int64Const (str prefix ".cOne") 1)
        (ty/ssaInstr (str prefix ".ccnt2") (ty/tyI64) (ty/opPrim "addInt" (list (str prefix ".ccnt") (str prefix ".cOne")))))
      (ty/termJump (ty/ssaEdge (str prefix ".count") (list (str prefix ".crest") (str prefix ".ccnt2")))))
    (ty/ssaBlock (str prefix ".alloc") (list (ty/ssaParam (str prefix ".cnt") (ty/tyI64)))
      (list
        (sys/int64Const (str prefix ".nZero") 0)
        (ty/ssaInstr (str prefix ".n") (ty/tyI64) (ty/opPrim "addInt" (list (str prefix ".cnt") (str prefix ".nZero"))))
        (sys/int64Const (str prefix ".one") 1)
        (ty/ssaInstr (str prefix ".n1") (ty/tyI64) (ty/opPrim "addInt" (list (str prefix ".n") (str prefix ".one"))))
        (sys/int64Const (str prefix ".eight") 8)
        (ty/ssaInstr (str prefix ".bytes") (ty/tyI64) (ty/opPrim "mulInt" (list (str prefix ".n1") (str prefix ".eight"))))
        (sys/callInstr (str prefix ".ptr") (ty/tyPtr) "malloc" (list (str prefix ".bytes")))
        (ty/ssaInstr (str prefix ".isNull") (ty/tyI1) (ty/opPrim "rawPtrIsNull" (list (str prefix ".ptr"))))
        (sys/int64Const (str prefix ".zeroIdx") 0))
      (ty/termBranch (str prefix ".isNull") (sys/edgeTo errLabel) (ty/ssaEdge (str prefix ".loop") (list listVar (str prefix ".zeroIdx")))))
    (ty/ssaBlock (str prefix ".loop") (list (ty/ssaParam (str prefix ".rem") (ty/tyVal)) (ty/ssaParam (str prefix ".idx") (ty/tyI64)))
      (list (sys/entryInstr (str prefix ".isEmpty") (ty/tyI1) "listEmpty?" (list (str prefix ".rem"))))
      (ty/termBranch (str prefix ".isEmpty") (sys/edgeTo (str prefix ".term")) (sys/edgeTo (str prefix ".store"))))
    (sys/block (str prefix ".store")
      (list
        (sys/entryInstr (str prefix ".head") (ty/tyVal) "@listFirst" (list (str prefix ".rem")))
        (sys/entryInstr (str prefix ".rest") (ty/tyVal) "@listRest" (list (str prefix ".rem")))
        (sys/int32Const (str prefix ".repr") 0)
        (sys/callInstr (str prefix ".elemPtr") (ty/tyPtr) "valToCStr" (list (str prefix ".head") (str prefix ".repr")))
        (ty/ssaInstr (str prefix ".elemInt") (ty/tyI64) (ty/opPrim "rawPtrToInt" (list (str prefix ".elemPtr"))))
        (sys/int64Const (str prefix ".eight2") 8)
        (ty/ssaInstr (str prefix ".off") (ty/tyI64) (ty/opPrim "mulInt" (list (str prefix ".idx") (str prefix ".eight2"))))
        (ty/ssaInstr (str prefix ".stored") (ty/tyI1) (ty/opPrim "rawStoreI64" (list (str prefix ".ptr") (str prefix ".off") (str prefix ".elemInt"))))
        (sys/int64Const (str prefix ".oneInc") 1)
        (ty/ssaInstr (str prefix ".idx2") (ty/tyI64) (ty/opPrim "addInt" (list (str prefix ".idx") (str prefix ".oneInc")))))
      (ty/termJump (ty/ssaEdge (str prefix ".loop") (list (str prefix ".rest") (str prefix ".idx2")))))
    (sys/block (str prefix ".term")
      (list
        (sys/int64Const (str prefix ".eight3") 8)
        (ty/ssaInstr (str prefix ".termOff") (ty/tyI64) (ty/opPrim "mulInt" (list (str prefix ".idx") (str prefix ".eight3"))))
        (sys/int64Const (str prefix ".zeroTerm") 0)
        (ty/ssaInstr (str prefix ".stored2") (ty/tyI1) (ty/opPrim "rawStoreI64" (list (str prefix ".ptr") (str prefix ".termOff") (str prefix ".zeroTerm")))))
      (ty/termJump (ty/ssaEdge okLabel (list)))))

fn freePtrArrayBlocks prefix: String ptrName: String nName: String nextLabel: String -> (List ty/SsaBlock)
  (list
    (sys/block (str prefix ".free.setup")
      (list (sys/int64Const (str prefix ".free.zero") 0))
      (ty/termJump (ty/ssaEdge (str prefix ".free.loop") (list (str prefix ".free.zero")))))
    (ty/ssaBlock (str prefix ".free.loop") (list (ty/ssaParam (str prefix ".free.idx") (ty/tyI64)))
      (list (ty/ssaInstr (str prefix ".free.done") (ty/tyI1) (ty/opPrim "eqInt" (list (str prefix ".free.idx") nName))))
      (ty/termBranch (str prefix ".free.done") (sys/edgeTo (str prefix ".free.fin")) (sys/edgeTo (str prefix ".free.one"))))
    (sys/block (str prefix ".free.one")
      (list
        (sys/int64Const (str prefix ".free.eight") 8)
        (ty/ssaInstr (str prefix ".free.off") (ty/tyI64) (ty/opPrim "mulInt" (list (str prefix ".free.idx") (str prefix ".free.eight"))))
        (ty/ssaInstr (str prefix ".free.elemInt") (ty/tyI64) (ty/opPrim "rawLoadI64" (list ptrName (str prefix ".free.off"))))
        (ty/ssaInstr (str prefix ".free.elemPtr") (ty/tyPtr) (ty/opPrim "rawIntToPtr" (list (str prefix ".free.elemInt"))))
        (freeInstr (str prefix ".free.elemFreed") (str prefix ".free.elemPtr"))
        (sys/int64Const (str prefix ".free.oneInc") 1)
        (ty/ssaInstr (str prefix ".free.idx2") (ty/tyI64) (ty/opPrim "addInt" (list (str prefix ".free.idx") (str prefix ".free.oneInc")))))
      (ty/termJump (ty/ssaEdge (str prefix ".free.loop") (list (str prefix ".free.idx2")))))
    (sys/block (str prefix ".free.fin")
      (list (freeInstr (str prefix ".free.arrFreed") ptrName))
      (ty/termJump (ty/ssaEdge nextLabel (list)))))

fn close4FdsInstrs label: String -> (List ty/SsaInstr)
  (list
    (sys/callInstr (str label ".c1") (ty/tyVal) "sysClose" (list "outReadFd"))
    (sys/callInstr (str label ".c2") (ty/tyVal) "sysClose" (list "outWriteFd"))
    (sys/callInstr (str label ".c3") (ty/tyVal) "sysClose" (list "errReadFd"))
    (sys/callInstr (str label ".c4") (ty/tyVal) "sysClose" (list "errWriteFd")))

fn destroyAndFreeActionsInstrs label: String -> (List ty/SsaInstr)
  (list
    (sys/callInstr (str label ".destroy") (ty/tyI32) "posix_spawn_file_actions_destroy" (list "actionsBuf"))
    (freeInstr (str label ".freed") "actionsBuf"))

fn pipeExtern -> ty/SsaExtern
  (ty/ssaExternTyped "pipe" (list (ty/tyPtr)) (ty/tyI32))

fn waitpidExtern -> ty/SsaExtern
  (ty/ssaExternTyped "waitpid" (list (ty/tyI32) (ty/tyPtr) (ty/tyI32)) (ty/tyI32))

fn posixSpawnFileActionsInitExtern -> ty/SsaExtern
  (ty/ssaExternTyped "posix_spawn_file_actions_init" (list (ty/tyPtr)) (ty/tyI32))

fn posixSpawnFileActionsAddDup2Extern -> ty/SsaExtern
  (ty/ssaExternTyped "posix_spawn_file_actions_adddup2" (list (ty/tyPtr) (ty/tyI32) (ty/tyI32)) (ty/tyI32))

fn posixSpawnFileActionsAddCloseExtern -> ty/SsaExtern
  (ty/ssaExternTyped "posix_spawn_file_actions_addclose" (list (ty/tyPtr) (ty/tyI32)) (ty/tyI32))

fn posixSpawnFileActionsDestroyExtern -> ty/SsaExtern
  (ty/ssaExternTyped "posix_spawn_file_actions_destroy" (list (ty/tyPtr)) (ty/tyI32))

fn posixSpawnExtern -> ty/SsaExtern
  (ty/ssaExternTyped "posix_spawn" (list (ty/tyPtr) (ty/tyPtr) (ty/tyPtr) (ty/tyPtr) (ty/tyPtr) (ty/tyPtr)) (ty/tyI32))

fn spawnFileActionsSize facts: libc/TripleFacts -> (Result Int64 String)
  (mt (libc/structSize facts "posix_spawn_file_actions_t")
    ((none) (err (str "libc.asl has no posix_spawn_file_actions_t size for triple " facts.triple)))
    ((some sz) (ok sz)))

fn requireConst facts: libc/TripleFacts name: String -> (Result Int64 String)
  (mt (libc/libcConst facts name)
    ((none) (err (str "libc.asl has no " name " constant for triple " facts.triple)))
    ((some v) (ok v)))

fn pidGuardBlocks goodLabel: String condInstrs: (List ty/SsaInstr) condName: String einval: Int64 -> (List ty/SsaBlock)
  (list
    (sys/block "pidCheck" condInstrs (ty/termBranch condName (sys/edgeTo goodLabel) (sys/edgeTo "badPid")))
    (sys/block "badPid"
      (list
        (sys/int64Const "badPid.einval" einval)
        (ty/ssaInstr "badPid.box" (ty/tyVal) (ty/opBox "badPid.einval"))
        (constructResult "badPid.errv" "err" "badPid.box"))
      (ty/termReturn "badPid.errv")))

fn onePidGuard pid: String goodLabel: String einval: Int64 -> (List ty/SsaBlock)
  (pidGuardBlocks goodLabel
    (list (sys/int64Const "pidCheck.zero" 0)
          (sys/int64Const "pidCheck.max" 2147483647)
          (ty/ssaInstr "pidCheck.positive" (ty/tyI1) (ty/opPrim "gtInt" (list pid "pidCheck.zero")))
          (ty/ssaInstr "pidCheck.fits" (ty/tyI1) (ty/opPrim "leInt" (list pid "pidCheck.max")))
          (ty/ssaInstr "pidCheck.ok" (ty/tyI1) (ty/opPrim "andBool" (list "pidCheck.positive" "pidCheck.fits"))))
    "pidCheck.ok" einval)

fn twoPidGuard pid1: String pid2: String goodLabel: String einval: Int64 -> (List ty/SsaBlock)
  (pidGuardBlocks goodLabel
    (list
      (sys/int64Const "pidCheck.zero" 0)
      (sys/int64Const "pidCheck.max" 2147483647)
      (ty/ssaInstr "pidCheck.p1ok" (ty/tyI1) (ty/opPrim "gtInt" (list pid1 "pidCheck.zero")))
      (ty/ssaInstr "pidCheck.p2ok" (ty/tyI1) (ty/opPrim "gtInt" (list pid2 "pidCheck.zero")))
      (ty/ssaInstr "pidCheck.p1fits" (ty/tyI1) (ty/opPrim "leInt" (list pid1 "pidCheck.max")))
      (ty/ssaInstr "pidCheck.p2fits" (ty/tyI1) (ty/opPrim "leInt" (list pid2 "pidCheck.max")))
      (ty/ssaInstr "pidCheck.p1valid" (ty/tyI1) (ty/opPrim "andBool" (list "pidCheck.p1ok" "pidCheck.p1fits")))
      (ty/ssaInstr "pidCheck.p2valid" (ty/tyI1) (ty/opPrim "andBool" (list "pidCheck.p2ok" "pidCheck.p2fits")))
      (ty/ssaInstr "pidCheck.ok" (ty/tyI1) (ty/opPrim "andBool" (list "pidCheck.p1valid" "pidCheck.p2valid"))))
    "pidCheck.ok" einval)

fn nsGetEnvironExtern -> ty/SsaExtern
  (ty/ssaExternTyped "_NSGetEnviron" (list) (ty/tyPtr))

fn realEnvironBlocks facts: libc/TripleFacts -> (List ty/SsaBlock)
  (if (stringStartsWith? facts.triple "darwin")
    (list
      (sys/block "envSelect.inherit"
        (list
          (sys/callInstr "envSelect.inherit.pp" (ty/tyPtr) "_NSGetEnviron" (list))
          (sys/int64Const "envSelect.inherit.off0" 0)
          (ty/ssaInstr "envSelect.inherit.rawInt" (ty/tyI64) (ty/opPrim "rawLoadI64" (list "envSelect.inherit.pp" "envSelect.inherit.off0")))
          (ty/ssaInstr "envSelect.inherit.real" (ty/tyPtr) (ty/opPrim "rawIntToPtr" (list "envSelect.inherit.rawInt"))))
        (ty/termJump (ty/ssaEdge "envSelect.join" (list "envSelect.inherit.real")))))
    (list
      (sys/block "envSelect.inherit"
        (list (ty/ssaInstr "envSelect.inherit.real" (ty/tyPtr) (ty/opLoadGlobal "environ")))
        (ty/termJump (ty/ssaEdge "envSelect.join" (list "envSelect.inherit.real"))))))


fn procSpawnEntryBlocks facts: libc/TripleFacts -> (List ty/SsaBlock)
  (listAppend
    (list
      (sys/block "entry"
        (list
          (sys/int32Const "zero32" 0)
          (ty/ssaInstr "inheritFlag" (ty/tyI1) (ty/opPrim "rawNeI32" (list "inheritEnv" "zero32"))))
        (ty/termJump (ty/ssaEdge "envp.setup" (list))))
      (sys/block "envpReadyJump" (list) (ty/termJump (ty/ssaEdge "envReady" (list "envp.ptr" "envp.n"))))
      (ty/ssaBlock "envReady" (list (ty/ssaParam "env.ptr" (ty/tyPtr)) (ty/ssaParam "env.n" (ty/tyI64))) (list)
        (ty/termBranch "inheritFlag" (sys/edgeTo "envSelect.inherit") (sys/edgeTo "envSelect.own"))))
    (listAppend (realEnvironBlocks facts)
      (list
        (sys/block "envSelect.own" (list) (ty/termJump (ty/ssaEdge "envSelect.join" (list "env.ptr"))))
        (ty/ssaBlock "envSelect.join" (list (ty/ssaParam "spawnEnvp" (ty/tyPtr))) (list)
          (ty/termJump (ty/ssaEdge "argv.setup" (list)))))))


fn procSpawnBodyBlocks setfd: Int64 fdCloexec: Int64 actionsSize: Int64 -> (List ty/SsaBlock)
  (list
    (sys/block "spawnBody"
      (listAppend (stringToPtrInstrs "pathPtr" "path")
        (list
          (sys/int64Const "pipeBufSize" 8)
          (sys/callInstr "outPipeBuf" (ty/tyPtr) "malloc" (list "pipeBufSize"))
          (ty/ssaInstr "outPipeBuf.isNull" (ty/tyI1) (ty/opPrim "rawPtrIsNull" (list "outPipeBuf")))))
      (ty/termBranch "outPipeBuf.isNull" (sys/edgeTo "errOutPipeAlloc") (sys/edgeTo "mkOutPipe")))
    (sys/block "mkOutPipe"
      (list
        (sys/callInstr "pipe1.ret" (ty/tyI32) "pipe" (list "outPipeBuf"))
        (sys/int32Const "pipe1.zero" 0)
        (ty/ssaInstr "pipe1.isErr" (ty/tyI1) (ty/opPrim "rawNeI32" (list "pipe1.ret" "pipe1.zero"))))
      (ty/termBranch "pipe1.isErr" (sys/edgeTo "errPipe1") (sys/edgeTo "outPipeReady")))
    (sys/block "outPipeReady"
      (list
        (sys/int64Const "off0" 0) (sys/int64Const "off4" 4)
        (ty/ssaInstr "outReadFd" (ty/tyI32) (ty/opPrim "rawLoadI32" (list "outPipeBuf" "off0")))
        (ty/ssaInstr "outWriteFd" (ty/tyI32) (ty/opPrim "rawLoadI32" (list "outPipeBuf" "off4")))
        (freeInstr "outPipeBufFreed" "outPipeBuf")
        (sys/int64Const "errPipeBufSize" 8)
        (sys/callInstr "errPipeBuf" (ty/tyPtr) "malloc" (list "errPipeBufSize"))
        (ty/ssaInstr "errPipeBuf.isNull" (ty/tyI1) (ty/opPrim "rawPtrIsNull" (list "errPipeBuf"))))
      (ty/termBranch "errPipeBuf.isNull" (sys/edgeTo "errErrPipeBufAlloc") (sys/edgeTo "mkErrPipe")))
    (sys/block "mkErrPipe"
      (list
        (sys/callInstr "pipe2.ret" (ty/tyI32) "pipe" (list "errPipeBuf"))
        (sys/int32Const "pipe2.zero" 0)
        (ty/ssaInstr "pipe2.isErr" (ty/tyI1) (ty/opPrim "rawNeI32" (list "pipe2.ret" "pipe2.zero"))))
      (ty/termBranch "pipe2.isErr" (sys/edgeTo "errPipe2") (sys/edgeTo "errPipeReady")))
    (sys/block "errPipeReady"
      (list
        (ty/ssaInstr "errReadFd" (ty/tyI32) (ty/opPrim "rawLoadI32" (list "errPipeBuf" "off0")))
        (ty/ssaInstr "errWriteFd" (ty/tyI32) (ty/opPrim "rawLoadI32" (list "errPipeBuf" "off4")))
        (freeInstr "errPipeBufFreed" "errPipeBuf")
        (sys/int32Const "setfdConst" setfd)
        (sys/int32Const "cloexecConst" fdCloexec)
        (sys/callInstr "fcntl1" (ty/tyVal) "sysFcntlSet" (list "outReadFd" "setfdConst" "cloexecConst")))
      (ty/termSwitch "fcntl1" "Result" (list (ty/ssaCase "ok" (sys/edgeTo "fcntl2")) (ty/ssaCase "err" (sys/edgeTo "errFcntl1"))) (none)))
    (sys/block "fcntl2"
      (list (sys/callInstr "fcntl2" (ty/tyVal) "sysFcntlSet" (list "errReadFd" "setfdConst" "cloexecConst")))
      (ty/termSwitch "fcntl2" "Result" (list (ty/ssaCase "ok" (sys/edgeTo "allocActions")) (ty/ssaCase "err" (sys/edgeTo "errFcntl2"))) (none)))
    (sys/block "allocActions"
      (list
        (sys/int64Const "actionsSize" actionsSize)
        (sys/callInstr "actionsBuf" (ty/tyPtr) "malloc" (list "actionsSize"))
        (ty/ssaInstr "actionsBuf.isNull" (ty/tyI1) (ty/opPrim "rawPtrIsNull" (list "actionsBuf"))))
      (ty/termBranch "actionsBuf.isNull" (sys/edgeTo "errActionsBufAlloc") (sys/edgeTo "initActions")))
    (sys/block "initActions"
      (list
        (sys/callInstr "init.ret" (ty/tyI32) "posix_spawn_file_actions_init" (list "actionsBuf"))
        (sys/int32Const "init.zero" 0)
        (ty/ssaInstr "init.isErr" (ty/tyI1) (ty/opPrim "rawNeI32" (list "init.ret" "init.zero"))))
      (ty/termBranch "init.isErr" (sys/edgeTo "errActionsInit") (sys/edgeTo "dup2Out")))
    (sys/block "dup2Out"
      (list
        (sys/int32Const "stdoutFd" 1)
        (sys/callInstr "a1.ret" (ty/tyI32) "posix_spawn_file_actions_adddup2" (list "actionsBuf" "outWriteFd" "stdoutFd"))
        (sys/int32Const "a1.zero" 0) (ty/ssaInstr "a1.isErr" (ty/tyI1) (ty/opPrim "rawNeI32" (list "a1.ret" "a1.zero")))
        (ty/ssaInstr "a1.ret64" (ty/tyI64) (ty/opPrim "rawWidenI32" (list "a1.ret"))))
      (ty/termBranch "a1.isErr" (ty/ssaEdge "errFinal" (list "a1.ret64")) (sys/edgeTo "dup2Err")))
    (sys/block "dup2Err"
      (list
        (sys/int32Const "stderrFd" 2)
        (sys/callInstr "a2.ret" (ty/tyI32) "posix_spawn_file_actions_adddup2" (list "actionsBuf" "errWriteFd" "stderrFd"))
        (sys/int32Const "a2.zero" 0) (ty/ssaInstr "a2.isErr" (ty/tyI1) (ty/opPrim "rawNeI32" (list "a2.ret" "a2.zero")))
        (ty/ssaInstr "a2.ret64" (ty/tyI64) (ty/opPrim "rawWidenI32" (list "a2.ret"))))
      (ty/termBranch "a2.isErr" (ty/ssaEdge "errFinal" (list "a2.ret64")) (sys/edgeTo "closeOutRead")))
    (sys/block "closeOutRead"
      (list
        (sys/callInstr "a3.ret" (ty/tyI32) "posix_spawn_file_actions_addclose" (list "actionsBuf" "outReadFd"))
        (sys/int32Const "a3.zero" 0) (ty/ssaInstr "a3.isErr" (ty/tyI1) (ty/opPrim "rawNeI32" (list "a3.ret" "a3.zero")))
        (ty/ssaInstr "a3.ret64" (ty/tyI64) (ty/opPrim "rawWidenI32" (list "a3.ret"))))
      (ty/termBranch "a3.isErr" (ty/ssaEdge "errFinal" (list "a3.ret64")) (sys/edgeTo "closeErrRead")))
    (sys/block "closeErrRead"
      (list
        (sys/callInstr "a4.ret" (ty/tyI32) "posix_spawn_file_actions_addclose" (list "actionsBuf" "errReadFd"))
        (sys/int32Const "a4.zero" 0) (ty/ssaInstr "a4.isErr" (ty/tyI1) (ty/opPrim "rawNeI32" (list "a4.ret" "a4.zero")))
        (ty/ssaInstr "a4.ret64" (ty/tyI64) (ty/opPrim "rawWidenI32" (list "a4.ret"))))
      (ty/termBranch "a4.isErr" (ty/ssaEdge "errFinal" (list "a4.ret64")) (sys/edgeTo "closeOutWrite")))
    (sys/block "closeOutWrite"
      (list
        (sys/callInstr "a5.ret" (ty/tyI32) "posix_spawn_file_actions_addclose" (list "actionsBuf" "outWriteFd"))
        (sys/int32Const "a5.zero" 0) (ty/ssaInstr "a5.isErr" (ty/tyI1) (ty/opPrim "rawNeI32" (list "a5.ret" "a5.zero")))
        (ty/ssaInstr "a5.ret64" (ty/tyI64) (ty/opPrim "rawWidenI32" (list "a5.ret"))))
      (ty/termBranch "a5.isErr" (ty/ssaEdge "errFinal" (list "a5.ret64")) (sys/edgeTo "closeErrWrite")))
    (sys/block "closeErrWrite"
      (list
        (sys/callInstr "a6.ret" (ty/tyI32) "posix_spawn_file_actions_addclose" (list "actionsBuf" "errWriteFd"))
        (sys/int32Const "a6.zero" 0) (ty/ssaInstr "a6.isErr" (ty/tyI1) (ty/opPrim "rawNeI32" (list "a6.ret" "a6.zero")))
        (ty/ssaInstr "a6.ret64" (ty/tyI64) (ty/opPrim "rawWidenI32" (list "a6.ret"))))
      (ty/termBranch "a6.isErr" (ty/ssaEdge "errFinal" (list "a6.ret64")) (sys/edgeTo "allocPid")))
    (sys/block "allocPid"
      (list
        (sys/int64Const "pidBufSize" 4)
        (sys/callInstr "pidBuf" (ty/tyPtr) "malloc" (list "pidBufSize"))
        (ty/ssaInstr "pidBuf.isNull" (ty/tyI1) (ty/opPrim "rawPtrIsNull" (list "pidBuf"))))
      (ty/termBranch "pidBuf.isNull" (sys/edgeTo "errPidAlloc") (sys/edgeTo "spawnCall")))
    (sys/block "spawnCall"
