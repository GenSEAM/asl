              (sys/block "any.afterNow"
                (list (ty/ssaInstr "any.expired" (ty/tyI1) (ty/opPrim "geInt" (list "any.checkTimeout.nowNanos" "any.deadline"))))
                (ty/termBranch "any.expired" (sys/edgeTo "any.timeout") (sys/edgeTo "any.sleep")))
              (sys/block "any.timeout"
                (list
                  (freeInstr "any.timeout.freed" "any.statusBuf")
                  (sys/int64Const "any.zIdx" 0) (sys/int64Const "any.zPid" 0) (sys/int64Const "any.zStatus" 0) (sys/int64Const "any.oneTimedOut" 1)
                  (ty/ssaInstr "any.zIdxBox" (ty/tyVal) (ty/opBox "any.zIdx"))
                  (ty/ssaInstr "any.zPidBox" (ty/tyVal) (ty/opBox "any.zPid"))
                  (ty/ssaInstr "any.zStatusBox" (ty/tyVal) (ty/opBox "any.zStatus"))
                  (ty/ssaInstr "any.oneTimedOutBox" (ty/tyVal) (ty/opBox "any.oneTimedOut"))
                  (ty/ssaInstr "any.timeoutRec" (ty/tyVal) (ty/opRecord "ProcWaitAnyResult" (list "index" "pid" "status" "timedOut") (list "any.zIdxBox" "any.zPidBox" "any.zStatusBox" "any.oneTimedOutBox")))
                  (constructResult "any.timeoutOkv" "ok" "any.timeoutRec"))
                (ty/termReturn "any.timeoutOkv"))
              (sys/block "any.sleep"
                (list
                  (sys/int64Const "any.sleepSec" 0) (sys/int64Const "any.sleepNanos" 10000000)
                  (sys/callInstr "any.sleepRes" (ty/tyVal) "sysNanosleep" (list "any.sleepSec" "any.sleepNanos")))
                (ty/termSwitch "any.sleepRes" "Result"
                  (list (ty/ssaCase "ok" (ty/ssaEdge "any.pollLoop" (list "any.deadline"))) (ty/ssaCase "err" (ty/ssaEdge "any.pollLoop" (list "any.deadline"))))
                  (none))))))))))))))

fn procKillFn facts: libc/TripleFacts -> (Result ty/SsaFunction String)
  (mt (requireConst facts "EINVAL")
    ((err e) (err e))
    ((ok einval)
     (ok (ty/ssaFunction "procKill" (list) (list (ty/ssaParam "pid" (ty/tyI64)) (ty/ssaParam "sig" (ty/tyI64))) (ty/tyVal)
      (appendAll (list
        (onePidGuard "pid" "entry" einval)
        (list
          (sys/block "entry"
            (list
              (ty/ssaInstr "pid32" (ty/tyI32) (ty/opPrim "rawNarrowI32" (list "pid")))
              (ty/ssaInstr "sig32" (ty/tyI32) (ty/opPrim "rawNarrowI32" (list "sig")))
              (sys/callInstr "killRes" (ty/tyVal) "sysKill" (list "pid32" "sig32")))
            (ty/termReturn "killRes")))))))))

fn procSelfFn -> ty/SsaFunction
  (ty/ssaFunction "procSelf" (list) (list) (ty/tyI64)
    (list (sys/block "entry"
            (list (sys/callInstr "pid32" (ty/tyI32) "sysGetpid" (list))
                  (ty/ssaInstr "pid" (ty/tyI64) (ty/opPrim "rawWidenI32" (list "pid32"))))
            (ty/termReturn "pid"))))

fn procAliveFn facts: libc/TripleFacts -> (Result ty/SsaFunction String)
  (mt (requireConst facts "EINVAL")
    ((err e) (err e))
    ((ok einval)
     (mt (requireConst facts "ESRCH")
    ((err e) (err e))
    ((ok esrch)
     (ok (ty/ssaFunction "procAlive" (list) (list (ty/ssaParam "pid" (ty/tyI64))) (ty/tyVal)
       (appendAll (list
         (onePidGuard "pid" "entry" einval)
         (list
         (sys/block "entry"
           (list
             (ty/ssaInstr "pid32" (ty/tyI32) (ty/opPrim "rawNarrowI32" (list "pid")))
             (sys/int32Const "sig0" 0)
             (sys/callInstr "killRes" (ty/tyVal) "sysKill" (list "pid32" "sig0")))
           (ty/termSwitch "killRes" "Result" (list (ty/ssaCase "ok" (sys/edgeTo "alive.yes")) (ty/ssaCase "err" (sys/edgeTo "alive.checkErr"))) (none)))
         (sys/block "alive.yes"
           (list (sys/int32Const "trueI1Src" 1) (ty/ssaInstr "trueI1" (ty/tyI1) (ty/opPrim "rawNeI32" (list "trueI1Src" "sig0")))
                 (ty/ssaInstr "trueBox" (ty/tyVal) (ty/opBox "trueI1")) (constructResult "yesOkv" "ok" "trueBox"))
           (ty/termReturn "yesOkv"))
         (sys/block "alive.checkErr"
           (list
             (ty/ssaInstr "alive.errBox" (ty/tyVal) (ty/opVariantField "killRes" 0))
             (ty/ssaInstr "alive.errVal" (ty/tyI64) (ty/opUnbox "alive.errBox"))
             (sys/int64Const "esrchConst" esrch)
             (ty/ssaInstr "alive.isEsrch" (ty/tyI1) (ty/opPrim "eqInt" (list "alive.errVal" "esrchConst"))))
           (ty/termBranch "alive.isEsrch" (sys/edgeTo "alive.no") (sys/edgeTo "alive.propagate")))
         (sys/block "alive.no"
           (list (sys/int32Const "falseI1Src" 0) (ty/ssaInstr "falseI1" (ty/tyI1) (ty/opPrim "rawNeI32" (list "falseI1Src" "falseI1Src")))
                 (ty/ssaInstr "falseBox" (ty/tyVal) (ty/opBox "falseI1")) (constructResult "noOkv" "ok" "falseBox"))
           (ty/termReturn "noOkv"))
         (sys/block "alive.propagate" (list) (ty/termReturn "killRes")))))))))))

fn sysProcExterns facts: libc/TripleFacts -> (List ty/SsaExtern)
  (listAppend
    (list (pipeExtern) (waitpidExtern)
          (posixSpawnFileActionsInitExtern) (posixSpawnFileActionsAddDup2Extern)
          (posixSpawnFileActionsAddCloseExtern) (posixSpawnFileActionsDestroyExtern)
          (posixSpawnExtern))
    (if (stringStartsWith? facts.triple "darwin") (list (nsGetEnvironExtern)) (list)))

fn sysProcFunctions facts: libc/TripleFacts -> (Result (List ty/SsaFunction) String)
  (mt (procSpawnFn facts)
    ((err e) (err e))
    ((ok spawnFn)
     (mt (procWaitFn facts)
       ((err e) (err e))
       ((ok waitFn)
        (mt (procWaitAnyFn facts)
          ((err e) (err e))
          ((ok waitAnyFn)
           (mt (procAliveFn facts)
             ((err e) (err e))
             ((ok aliveFn)
              (mt (procKillFn facts)
                ((err e) (err e))
                ((ok killFn)
                 (ok (list spawnFn waitFn waitAnyFn aliveFn killFn (procSelfFn)))))))))))))

fn sysProcRecords -> (List ty/SsaRecordDecl)
  (list
    (ty/ssaRecordDecl "ProcSpawnResult" (list "pid" "outFd" "errFd"))
    (ty/ssaRecordDecl "ProcWaitResult" (list "status" "timedOut"))
    (ty/ssaRecordDecl "ProcWaitAnyResult" (list "index" "pid" "status" "timedOut")))

fn rn name: String -> String
  (str "asl-target-llvm/sysRoute." name)

fn rI dest: String n: Int64 -> ty/SsaInstr
  (sys/int64Const dest n)

fn rI32 dest: String n: Int64 -> ty/SsaInstr
  (sys/int32Const dest n)

fn rP dest: String t: ty/SsaTy name: String args: (List String) -> ty/SsaInstr
  (sys/primInstr dest t name args)

fn rC dest: String t: ty/SsaTy callee: String args: (List String) -> ty/SsaInstr
  (sys/callInstr dest t callee args)

fn rH dest: String t: ty/SsaTy helper: String args: (List String) -> ty/SsaInstr
  (sys/callInstr dest t (rn helper) args)

fn rV dest: String op: ty/SsaOp -> ty/SsaInstr
  (ty/ssaInstr dest (ty/tyVal) op)

fn rE dest: String t: ty/SsaTy name: String args: (List String) -> ty/SsaInstr
  (sys/entryInstr dest t name args)

fn rB label: String instrs: (List ty/SsaInstr) term: ty/SsaTerm -> ty/SsaBlock
  (sys/block label instrs term)

fn rBP label: String params: (List ty/SsaParam) instrs: (List ty/SsaInstr) term: ty/SsaTerm -> ty/SsaBlock
  (ty/ssaBlock label params instrs term)

fn pI name: String -> ty/SsaParam
  (ty/ssaParam name (ty/tyI64))

fn pV name: String -> ty/SsaParam
  (ty/ssaParam name (ty/tyVal))

fn rJ label: String args: (List String) -> ty/SsaTerm
  (ty/termJump (ty/ssaEdge label args))

fn rBr c: String yes: String no: String -> ty/SsaTerm
  (ty/termBranch c (sys/edgeTo yes) (sys/edgeTo no))

fn rBrA c: String yes: String yesArgs: (List String) no: String noArgs: (List String) -> ty/SsaTerm
  (ty/termBranch c (ty/ssaEdge yes yesArgs) (ty/ssaEdge no noArgs))

fn rRet v: String -> ty/SsaTerm
  (ty/termReturn v)

fn rFn name: String params: (List ty/SsaParam) retTy: ty/SsaTy blocks: (List ty/SsaBlock) -> ty/SsaFunction
  (ty/ssaFunction (rn name) (list) params retTy blocks)

fn rOptSwitch v: String someLabel: String noneLabel: String -> ty/SsaTerm
  (ty/termSwitch v "Option" (list (ty/ssaCase "some" (sys/edgeTo someLabel)) (ty/ssaCase "none" (sys/edgeTo noneLabel))) (none))

fn rResSwitch v: String okLabel: String errLabel: String -> ty/SsaTerm
  (ty/termSwitch v "Result" (list (ty/ssaCase "ok" (sys/edgeTo okLabel)) (ty/ssaCase "err" (sys/edgeTo errLabel))) (none))

fn ptrOf dest: String i: String -> ty/SsaInstr
  (rP dest (ty/tyPtr) "rawIntToPtr" (list i))

fn intOfPtr dest: String p: String -> ty/SsaInstr
  (rP dest (ty/tyI64) "rawPtrToInt" (list p))

fn addrAt dest: String base: String off: String -> (List ty/SsaInstr)
  (list (rP (str dest ".i") (ty/tyI64) "addInt" (list base off)) (ptrOf dest (str dest ".i")))

fn ld64 dest: String p: String off: String -> ty/SsaInstr
  (rP dest (ty/tyI64) "rawLoadI64" (list p off))

fn ld32 dest: String p: String off: String -> (List ty/SsaInstr)
  (list (rP (str dest ".w") (ty/tyI32) "rawLoadI32" (list p off)) (rP dest (ty/tyI64) "rawWidenI32" (list (str dest ".w"))))

fn ld8 dest: String p: String off: String -> (List ty/SsaInstr)
  (list (rP (str dest ".w") (ty/tyI32) "rawLoadI8" (list p off)) (rP dest (ty/tyI64) "rawWidenI32" (list (str dest ".w"))))

fn st64 dest: String p: String off: String v: String -> ty/SsaInstr
  (rP dest (ty/tyI1) "rawStoreI64" (list p off v))

fn st32 dest: String p: String off: String v: String -> (List ty/SsaInstr)
  (list (rP (str dest ".n") (ty/tyI32) "rawNarrowI32" (list v)) (rP dest (ty/tyI1) "rawStoreI32" (list p off (str dest ".n"))))

fn st8 dest: String p: String off: String v: String -> (List ty/SsaInstr)
  (list (rP (str dest ".n") (ty/tyI32) "rawNarrowI32" (list v)) (rP dest (ty/tyI1) "rawStoreI8" (list p off (str dest ".n"))))

fn narrow dest: String v: String -> ty/SsaInstr
  (rP dest (ty/tyI32) "rawNarrowI32" (list v))

fn widen dest: String v: String -> ty/SsaInstr
  (rP dest (ty/tyI64) "rawWidenI32" (list v))

fn errnoInstr dest: String -> ty/SsaInstr
  (rC dest (ty/tyI64) "sysErrnoValue" (list))

fn retConst label: String n: Int64 -> ty/SsaBlock
  (rB label (list (rI (str label ".n") n)) (rRet (str label ".n")))

fn retNeg label: String n: Int64 -> ty/SsaBlock
  (retConst label (- 0 n))

fn poolText pool: (Map String Int64) dest: String text: String -> ty/SsaInstr
  (rV dest (ty/opConst (ty/constStr (optionOr (mapGet pool text) -1))))

fn errTextB pool: (Map String Int64) label: String pre: (List ty/SsaInstr) text: String -> ty/SsaBlock
  (rB label (listAppend pre (list (poolText pool (str label ".t") text) (rV (str label ".v") (ty/opConstruct "Result" "err" (list (str label ".t"))))))
    (rRet (str label ".v")))

fn errnoB label: String pre: (List ty/SsaInstr) code: String -> ty/SsaBlock
  (rB label (listAppend pre (list (rH (str label ".v") (ty/tyVal) "errnoErr" (list code)))) (rRet (str label ".v")))

fn errnoConstB label: String pre: (List ty/SsaInstr) code: Int64 -> ty/SsaBlock
  (errnoB label (cons (rI (str label ".c") code) pre) (str label ".c"))

fn freeI dest: String addr: String -> (List ty/SsaInstr)
  (list (ptrOf (str dest ".p") addr) (rC dest (ty/tyI64) "free" (list (str dest ".p"))))

fn align8 n: Int64 -> Int64
  (if (= (mod n 8) 0) n (+ n (- 8 (mod n 8))))

fn wrap32 n: Int64 -> Int64
  (let [(low (mod n 4294967296))]
    (if (> low 2147483647) (- low 4294967296) low))

fn darwin? facts: libc/TripleFacts -> Bool
  (stringStartsWith? facts.triple "darwin")

fn procFactNames facts: libc/TripleFacts -> (List String)
  (listAppend
    (list "EINVAL" "ENOMEM" "EINTR" "ESRCH" "ECHILD" "ENOSYS" "ENOENT" "EACCES" "EPERM" "EROFS" "EEXIST" "ENOTEMPTY" "ENOTDIR" "EISDIR" "ENAMETOOLONG" "ELOOP" "WNOHANG" "F_SETFD" "FD_CLOEXEC" "F_DUPFD_CLOEXEC"
          "SIGPIPE" "SIG_DFL" "SIG_IGN" "SIG_BLOCK" "SIG_SETMASK" "SIGINT" "SIGTERM" "SIGHUP" "SIGKILL" "O_RDONLY" "SEEK_SET"
          "POLLIN" "POLLOUT" "POLLPRI" "POLLERR" "POLLHUP" "POLLNVAL" "P_PID" "WEXITED" "WNOWAIT" "CLOCK_MONOTONIC"
          "RUSAGE_SELF" "RUSAGE_CHILDREN"
          "pollfd.size" "pollfd.fd" "pollfd.events" "pollfd.revents" "siginfo_t.size" "siginfo_t.si_pid"
          "sigaction.size" "sigaction.sa_handler" "sigset_t.size" "timespec.size" "timespec.tv_sec" "timespec.tv_nsec"
          "rusage.size" "rusage.ru_utime" "rusage.ru_stime" "rusage.ru_maxrss" "timeval.tv_sec" "timeval.tv_usec"
          "stat.size" "stat.st_size")
    (if (darwin? facts)
      (list "EVFILT_PROC" "EVFILT_SIGNAL" "NOTE_EXIT" "EV_ADD" "EV_ONESHOT" "EV_ERROR"
            "kevent.size" "kevent.ident" "kevent.filter" "kevent.flags" "kevent.fflags" "kevent.data" "kevent.udata")
      (list "SYS_pidfd_open" "SFD_CLOEXEC" "signalfd_siginfo.size" "signalfd_siginfo.ssi_signo")))

fn procFactOf facts: libc/TripleFacts n: String -> (Option Int64)
  (let [(parts (stringSplit n "."))]
    (if (= (listLength parts) 2)
      (let [(sname (optionOr (listGet parts 0) "")) (field (optionOr (listGet parts 1) ""))]
        (if (= field "size")
          (libc/structSize facts sname)
          (mt (libc/pairFind facts.structs sname)
            ((none) (none))
            ((some sf) (libc/structFieldOffset sf field)))))
      (libc/libcConst facts n)))

fn procFacts facts: libc/TripleFacts -> (Result (Map String Int64) String)
  (let [(resolved (fold (fn [(acc (Result (Map String Int64) String)) (n String)] -> (Result (Map String Int64) String)
                          (mt acc
                            ((err e) (err e))
                            ((ok m) (mt (procFactOf facts n)
                                      ((none) (err (str "no " n " fact for triple " facts.triple)))
                                      ((some x) (ok (mapSet m n x)))))))
                        (ok (mapEmpty)) (procFactNames facts)))]
    (mt resolved
      ((err e) (err e))
      ((ok m) (cond ((not (= (kf m "pollfd.revents") (+ (kf m "pollfd.events") 2))) (err (str "pollfd revents is not 2 bytes after events on " facts.triple)))
                    ((and (darwin? facts) (not (= (kf m "kevent.flags") (+ (kf m "kevent.filter") 2)))) (err (str "kevent flags is not 2 bytes after filter on " facts.triple)))
                    (else (ok m))))))

fn kf k: (Map String Int64) name: String -> Int64
  (optionOr (mapGet k name) 0)

fn exitCodeFn -> ty/SsaFunction
  (rFn "procExitCode" (list (pI "st")) (ty/tyI64)
    (list
      (rB "entry" (list (rI "c7f" 127) (rP "sig" (ty/tyI64) "rawAndI64" (list "st" "c7f")) (rI "z" 0) (rP "exited" (ty/tyI1) "eqInt" (list "sig" "z")))
        (rBr "exited" "normal" "signalled"))
      (rB "normal" (list (rI "c8" 8) (rP "sh" (ty/tyI64) "rawLshrI64" (list "st" "c8")) (rI "cff" 255) (rP "code" (ty/tyI64) "rawAndI64" (list "sh" "cff")))
        (rRet "code"))
      (rB "signalled" (list (rP "neg" (ty/tyI64) "subInt" (list "z" "sig"))) (rRet "neg"))))

fn monoFn k: (Map String Int64) -> ty/SsaFunction
  (rFn "procMono" (list (pI "ts")) (ty/tyI64)
    (list
      (rB "entry"
        (list (ptrOf "tp" "ts") (rI32 "clk" (kf k "CLOCK_MONOTONIC")) (rC "rc" (ty/tyI32) "clock_gettime" (list "clk" "tp"))
              (rI "secOff" (kf k "timespec.tv_sec")) (ld64 "sec" "tp" "secOff") (rI "nsecOff" (kf k "timespec.tv_nsec")) (ld64 "nsec" "tp" "nsecOff")
              (rI "thousand" 1000) (rI "million" 1000000) (rP "secMs" (ty/tyI64) "mulInt" (list "sec" "thousand"))
              (rP "nsecMs" (ty/tyI64) "quotInt" (list "nsec" "million")) (rP "ms" (ty/tyI64) "addInt" (list "secMs" "nsecMs")))
        (rRet "ms"))))

fn strvFn k: (Map String Int64) -> ty/SsaFunction
  (rFn "procStrv" (list (pV "l")) (ty/tyI64)
    (list
      (rB "entry" (list (rH "isL" (ty/tyI1) "isList" (list "l")) (rI "z" 0) (rI "one" 1) (rI "eight" 8)) (rBr "isL" "count0" "inval"))
      (rB "count0" (list) (rJ "count" (list "z" "l")))
      (rBP "count" (list (pI "n") (pV "xs")) (list (rE "ended" (ty/tyI1) "listEmpty?" (list "xs"))) (rBr "ended" "alloc" "countStep"))
      (rB "countStep" (list (rE "xsRest" (ty/tyVal) "@listRest" (list "xs")) (rP "n1" (ty/tyI64) "addInt" (list "n" "one"))) (rJ "count" (list "n1" "xsRest")))
      (rB "alloc"
        (list (rI "two" 2) (rP "slots" (ty/tyI64) "addInt" (list "n" "two")) (rP "bytes" (ty/tyI64) "mulInt" (list "slots" "eight"))
              (rC "v" (ty/tyPtr) "malloc" (list "bytes")) (rP "vNull" (ty/tyI1) "rawPtrIsNull" (list "v")))
        (rBr "vNull" "nomem" "ready"))
      (rB "ready" (list (intOfPtr "vI" "v") (rP "nPlus" (ty/tyI64) "addInt" (list "n" "one")) (rP "lenOff" (ty/tyI64) "mulInt" (list "nPlus" "eight"))
                        (rP "lenAt" (ty/tyI64) "addInt" (list "vI" "lenOff")) (ptrOf "lenP" "lenAt"))
        (rJ "fill" (list "z" "l")))
      (rBP "fill" (list (pI "i") (pV "ys")) (list (rE "filled" (ty/tyI1) "listEmpty?" (list "ys"))) (rBr "filled" "finish" "item"))
      (rB "item" (list (rE "it" (ty/tyVal) "@listFirst" (list "ys")) (rH "isS" (ty/tyI1) "isStr" (list "it"))) (rBr "isS" "conv" "badItem"))
      (rB "conv"
        (list (rI32 "repr0" 0) (rC "cs" (ty/tyPtr) "valToCStrN" (list "it" "repr0" "lenP")) (ld64 "len" "v" "lenOff")
              (rC "sl" (ty/tyI64) "strlen" (list "cs")) (rP "whole" (ty/tyI1) "eqInt" (list "sl" "len")))
        (rBr "whole" "store" "badNul"))
      (rB "store"
        (list (rP "off" (ty/tyI64) "mulInt" (list "i" "eight")) (intOfPtr "csI" "cs") (st64 "stored" "v" "off" "csI")
              (rP "i1" (ty/tyI64) "addInt" (list "i" "one")) (rE "ysRest" (ty/tyVal) "@listRest" (list "ys")))
        (rJ "fill" (list "i1" "ysRest")))
      (rB "badNul" (list (rC "csFree" (ty/tyI64) "free" (list "cs"))) (rJ "badAt" (list "i")))
      (rB "badItem" (list) (rJ "badAt" (list "i")))
      (rBP "badAt" (list (pI "at"))
        (list (rP "atOff" (ty/tyI64) "mulInt" (list "at" "eight")) (st64 "cut" "v" "atOff" "z") (rH "freed" (ty/tyI64) "procFreeStrv" (list "vI")))
        (rJ "inval" (list)))
      (rB "finish" (list (rP "endOff" (ty/tyI64) "mulInt" (list "n" "eight")) (st64 "ended0" "v" "endOff" "z")) (rRet "vI"))
      (retNeg "nomem" (kf k "ENOMEM"))
      (retNeg "inval" (kf k "EINVAL"))))

fn freeStrvFn -> ty/SsaFunction
  (rFn "procFreeStrv" (list (pI "p")) (ty/tyI64)
    (list
      (rB "entry" (list (rI "z" 0) (rI "one" 1) (rI "eight" 8) (rP "isNull" (ty/tyI1) "eqInt" (list "p" "z"))) (rBr "isNull" "done" "start"))
      (rB "start" (list (ptrOf "pp" "p")) (rJ "loop" (list "z")))
      (rBP "loop" (list (pI "i")) (list (rP "off" (ty/tyI64) "mulInt" (list "i" "eight")) (ld64 "e" "pp" "off") (rP "end" (ty/tyI1) "eqInt" (list "e" "z")))
        (rBr "end" "fin" "item"))
      (rB "item" (listAppend (freeI "eFree" "e") (list (rP "i1" (ty/tyI64) "addInt" (list "i" "one")))) (rJ "loop" (list "i1")))
      (rB "fin" (list (rC "ppFree" (ty/tyI64) "free" (list "pp"))) (rRet "z"))
      (rB "done" (list) (rRet "z"))))

fn envArgFn k: (Map String Int64) -> ty/SsaFunction
  (rFn "procEnvArg" (list (pV "o")) (ty/tyI64)
    (list
      (rB "entry" (list (rH "kind" (ty/tyI64) "optionArg" (list "o")) (rI "m1" -1) (rI "z" 0) (rI "one" 1) (rP "bad" (ty/tyI1) "eqInt" (list "kind" "m1")))
        (rBr "bad" "inval" "which"))
      (rB "which" (list (rP "isNone" (ty/tyI1) "eqInt" (list "kind" "z"))) (rBr "isNone" "none" "some"))
      (rB "none" (list) (rRet "z"))
      (rB "some" (list (rV "inner" (ty/opVariantField "o" 0)) (rH "v" (ty/tyI64) "procStrv" (list "inner")) (rP "failed" (ty/tyI1) "ltInt" (list "v" "z")))
        (rBr "failed" "fail" "scan"))
      (rB "fail" (list) (rRet "v"))
      (rB "scan" (list (ptrOf "vp" "v") (rI "eight" 8)) (rJ "loop" (list "z")))
      (rBP "loop" (list (pI "i")) (list (rP "off" (ty/tyI64) "mulInt" (list "i" "eight")) (ld64 "e" "vp" "off") (rP "end" (ty/tyI1) "eqInt" (list "e" "z")))
