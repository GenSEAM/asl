                      (ty/ssaInstr "any.p2isErr" (ty/tyI1) (ty/opPrim "ltInt" (list "any.p2n" "any.zero"))))
                (ty/termBranch "any.p2isErr" (sys/edgeTo "any.p2Err") (sys/edgeTo "any.p2Check")))
              (errnoErrBlock "any.p2Err" (list (freeInstr "any.p2Err.freed" "any.statusBuf")) "any.p2ErrFin")
