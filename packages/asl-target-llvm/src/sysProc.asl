            (pipeExtern) (waitpidExtern) (t "waitid" (list i32 i32 p i32) i32) (t "fork" (list) i32) (t "execvp" (list p p) i32)
      (t "dup2" (list i32 i32) i32) (t "chdir" (list p) i32) (t "setpgid" (list i32 i32) i32) (t "signal" (list i32 p) p)
      (t "_exit" (list i32) i64) (t "aslLogSpawn" (list p) i64) (t "fflush" (list p) i32) (t "raise" (list i32) i32)
            (t "open_memstream" (list p p) p) (t "fwrite" (list p i64 i64 p) i64) (t "fclose" (list p) i32)
            (t "strerror" (list i32) p) (ty/ssaExternVariadic "aslError" (list p p) i64)
      (t "malloc" (list i64) p) (t "free" (list p) i64) (t "read" (list i32 p i64) i64) (t "close" (list i32) i32)
            (t "mkStr" (list p i64) (ty/tyVal))
            (t "mkstemp" (list p) i32) (t "unlink" (list p) i32)
            (t "lseek" (list i32 i64 i32) i64) (t "fstat" (list i32 p) i32)
      (ty/ssaExternVariadic "execl" (list p p) i32)
            (ty/ssaExternVariadic "fcntl" (list i32 i32) i32) (ty/ssaExternVariadic "open" (list p i32) i32)
            (t "sigemptyset" (list p) i32) (t "sigaddset" (list p i32) i32) (t "sigaction" (list i32 p p) i32) (t "sigprocmask" (list i32 p p) i32))
