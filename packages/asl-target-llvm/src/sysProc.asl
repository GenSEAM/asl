  (list (rI (str pre ".oi") (kf k "kevent.ident")) (st64 (str pre ".si") evp (str pre ".oi") ident)
        (rI (str pre ".of") (kf k "kevent.filter")) (rI32 (str pre ".word") (wrap32 (+ (wrap16 filter) (* (wrap16 flags) 65536))))
        (rP (str pre ".sw") (ty/tyI1) "rawStoreI32" (list evp (str pre ".of") (str pre ".word")))
        (rI (str pre ".off") (kf k "kevent.fflags")) (rI32 (str pre ".ff") (wrap32 fflags))
        (rP (str pre ".sf") (ty/tyI1) "rawStoreI32" (list evp (str pre ".off") (str pre ".ff")))
        (rI (str pre ".z") 0) (rI (str pre ".od") (kf k "kevent.data")) (st64 (str pre ".sd") evp (str pre ".od") (str pre ".z"))
        (rI (str pre ".ou") (kf k "kevent.udata")) (st64 (str pre ".su") evp (str pre ".ou") (str pre ".z")))

fn fwdSignalNames -> (List String)
  (list "SIGINT" "SIGTERM" "SIGHUP")

fn fwdSigBlocks k: (Map String Int64) darwin: Bool -> (List ty/SsaBlock)
  (let [(names (fwdSignalNames)) (count (listLength names))
        (lbl (fn [(i Int64)] -> String (if (>= i count) "mask" (str "sig" i))))]
    (fold (fn [(acc (List ty/SsaBlock)) (i Int64)] -> (List ty/SsaBlock)
            (let [(sig (kf k (optionOr (listGet names i) ""))) (s (str "s" i)) (next (lbl (+ i 1)))]
              (listAppend acc
                (listAppend
                  (list (rB (lbl i) (list (rI32 (str s ".n") sig) (rC (str s ".r") (ty/tyI32) "sigaction" (list (str s ".n") "nullp" "saP")) (rP (str s ".ok") (ty/tyI1) "rawEqI32" (list (str s ".r") "z32")))
                          (rBr (str s ".ok") (str "dfl" i) next))
                        (rB (str "dfl" i) (list (rI (str s ".ho") (kf k "sigaction.sa_handler")) (ld64 (str s ".h") "saP" (str s ".ho")) (rI (str s ".dfl") (kf k "SIG_DFL"))
                                                (rP (str s ".isDfl") (ty/tyI1) "eqInt" (list (str s ".h") (str s ".dfl"))))
                          (if darwin (rBr (str s ".isDfl") (str "kq" i) next) (rBr (str s ".isDfl") (str "add" i) next)))
                        (rB (str "add" i) (list (rC (str s ".added") (ty/tyI32) "sigaddset" (list "setP" (str s ".n")))) (rJ next (list))))
                  (if darwin
                    (list (rB (str "kq" i) (list) (rBr "kqOk" (str "reg" i) next))
                          (rB (str "reg" i) (listAppend (listAppend (list (rI (str s ".id") sig)) (kevSetInstrs k (str s ".ev") "evP" (str s ".id") (kf k "EVFILT_SIGNAL") (kf k "EV_ADD") 0))
                                                        (list (rC (str s ".kr") (ty/tyI32) "kevent" (list "kq" "evP" "one32" "nullp" "z32" "nullp")) (rP (str s ".krOk") (ty/tyI1) "rawGeI32" (list (str s ".kr") "z32"))))
                            (rBr (str s ".krOk") (str "add" i) next)))
                    (list))))))
          (list) (range 0 count)))

