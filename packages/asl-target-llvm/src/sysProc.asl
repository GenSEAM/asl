fn procSpawnErrBlocks -> (List ty/SsaBlock)
  (appendAll (list
    (list
      (errnoErrBlock "errOutPipeAlloc" (list) "freeCommon")
      (errnoErrBlock "errPipe1" (list (freeInstr "errPipe1.freed" "outPipeBuf")) "freeCommon")
