  (let [(t (fn [(name String) (params (List ty/SsaTy)) (ret ty/SsaTy)] -> ty/SsaExtern (ty/ssaExternTyped name params ret)))
        (i32 (ty/tyI32)) (i64 (ty/tyI64)) (p (ty/tyPtr))]
