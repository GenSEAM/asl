        (ty/termReturn "finishErr.errv")))))

fn procSpawnFn facts: libc/TripleFacts -> (Result ty/SsaFunction String)
  (mt (spawnFileActionsSize facts)
    ((err e) (err e))
    ((ok actionsSize)
     (mt (requireConst facts "FD_CLOEXEC")
       ((err e) (err e))
       ((ok fdCloexec)
        (mt (requireConst facts "F_SETFD")
          ((err e) (err e))
          ((ok setfd)
           (ok (ty/ssaFunction "procSpawn" (list)
             (list (ty/ssaParam "path" (ty/tyVal)) (ty/ssaParam "argv" (ty/tyVal)) (ty/ssaParam "envp" (ty/tyVal)) (ty/ssaParam "inheritEnv" (ty/tyI32)))
             (ty/tyVal)
             (appendAll (list
               (procSpawnEntryBlocks facts)
               (ptrArrayBlocks "envp" "envp" "envpReadyJump" "errEnvpAlloc")
               (ptrArrayBlocks "argv" "argv" "spawnBody" "envpFreeArgvErr.free.setup")
               (freePtrArrayBlocks "envpFreeArgvErr" "env.ptr" "env.n" "errArgvAllocErrno")
               (list (errnoErrBlock "errArgvAllocErrno" (list) "finishErrArgvAlloc")
                     (errnoFinBlock "finishErrArgvAlloc"))
               (procSpawnBodyBlocks setfd fdCloexec actionsSize)
               (procSpawnOkTailBlocks)
               (procSpawnErrBlocks)))))))))))

fn procWaitDeadlineBlocks nextLabel: String preFrees: (List ty/SsaInstr) -> (List ty/SsaBlock)
  (list
    (sys/block "deadline.check"
      (list (sys/int64Const "deadline.zero" 0) (ty/ssaInstr "deadline.isNeg" (ty/tyI1) (ty/opPrim "ltInt" (list "timeoutMs" "deadline.zero"))))
      (ty/termBranch "deadline.isNeg" (sys/edgeTo "deadline.inf") (sys/edgeTo "deadline.real")))
    (sys/block "deadline.inf"
      (list (sys/int64Const "deadline.infV" 9223372036854775807))
      (ty/termJump (ty/ssaEdge nextLabel (list "deadline.infV"))))
    (sys/block "deadline.real"
      (list (sys/callInstr "deadline.clock" (ty/tyVal) "sysClockGettime" (list "clockConst")))
      (ty/termSwitch "deadline.clock" "Result" (list (ty/ssaCase "ok" (sys/edgeTo "deadline.unpack")) (ty/ssaCase "err" (sys/edgeTo "deadline.clockErr"))) (none)))
    (sys/block "deadline.unpack"
      (list
        (ty/ssaInstr "deadline.pair" (ty/tyVal) (ty/opVariantField "deadline.clock" 0))
        (sys/entryInstr "deadline.secValBox" (ty/tyVal) "@listFirst" (list "deadline.pair"))
        (sys/entryInstr "deadline.restBox" (ty/tyVal) "@listRest" (list "deadline.pair"))
        (sys/entryInstr "deadline.nsecValBox" (ty/tyVal) "@listFirst" (list "deadline.restBox"))
        (ty/ssaInstr "deadline.sec" (ty/tyI64) (ty/opUnbox "deadline.secValBox"))
        (ty/ssaInstr "deadline.nsec" (ty/tyI64) (ty/opUnbox "deadline.nsecValBox"))
        (sys/int64Const "deadline.billion" 1000000000)
        (ty/ssaInstr "deadline.secNanos" (ty/tyI64) (ty/opPrim "mulInt" (list "deadline.sec" "deadline.billion")))
        (ty/ssaInstr "deadline.now" (ty/tyI64) (ty/opPrim "addInt" (list "deadline.secNanos" "deadline.nsec")))
        (sys/int64Const "deadline.maxI64" 9223372036854775807)
        (ty/ssaInstr "deadline.headroom" (ty/tyI64) (ty/opPrim "subInt" (list "deadline.maxI64" "deadline.now")))
        (sys/int64Const "deadline.million" 1000000)
        (ty/ssaInstr "deadline.maxTimeoutMs" (ty/tyI64) (ty/opPrim "quotInt" (list "deadline.headroom" "deadline.million")))
        (ty/ssaInstr "deadline.tooLarge" (ty/tyI1) (ty/opPrim "gtInt" (list "timeoutMs" "deadline.maxTimeoutMs"))))
      (ty/termBranch "deadline.tooLarge" (sys/edgeTo "deadline.inf") (sys/edgeTo "deadline.addNanos")))
    (sys/block "deadline.addNanos"
      (list
        (ty/ssaInstr "deadline.timeoutNanos" (ty/tyI64) (ty/opPrim "mulInt" (list "timeoutMs" "deadline.million")))
        (ty/ssaInstr "deadline.realV" (ty/tyI64) (ty/opPrim "addInt" (list "deadline.now" "deadline.timeoutNanos"))))
      (ty/termJump (ty/ssaEdge nextLabel (list "deadline.realV"))))
    (sys/block "deadline.clockErr"
      (listAppend preFrees (list (ty/ssaInstr "deadline.clockErrv" (ty/tyVal) (ty/opVariantField "deadline.clock" 0))))
      (ty/termReturn "deadline.clockErrv")))

fn nowNanosBlocks label: String okLabel: String preFrees: (List ty/SsaInstr) -> (List ty/SsaBlock)
  (list
    (sys/block (str label ".call")
      (list (sys/callInstr (str label ".clock") (ty/tyVal) "sysClockGettime" (list "clockConst")))
      (ty/termSwitch (str label ".clock") "Result" (list (ty/ssaCase "ok" (sys/edgeTo (str label ".ok"))) (ty/ssaCase "err" (sys/edgeTo (str label ".err")))) (none)))
    (sys/block (str label ".ok")
      (list
        (ty/ssaInstr (str label ".pair") (ty/tyVal) (ty/opVariantField (str label ".clock") 0))
        (sys/entryInstr (str label ".secValBox") (ty/tyVal) "@listFirst" (list (str label ".pair")))
        (sys/entryInstr (str label ".restBox") (ty/tyVal) "@listRest" (list (str label ".pair")))
        (sys/entryInstr (str label ".nsecValBox") (ty/tyVal) "@listFirst" (list (str label ".restBox")))
        (ty/ssaInstr (str label ".sec") (ty/tyI64) (ty/opUnbox (str label ".secValBox")))
        (ty/ssaInstr (str label ".nsec") (ty/tyI64) (ty/opUnbox (str label ".nsecValBox")))
        (sys/int64Const (str label ".billion") 1000000000)
        (ty/ssaInstr (str label ".secNanos") (ty/tyI64) (ty/opPrim "mulInt" (list (str label ".sec") (str label ".billion"))))
        (ty/ssaInstr (str label ".nowNanos") (ty/tyI64) (ty/opPrim "addInt" (list (str label ".secNanos") (str label ".nsec")))))
      (ty/termJump (ty/ssaEdge okLabel (list))))
    (sys/block (str label ".err")
      (listAppend preFrees (list (ty/ssaInstr (str label ".errv") (ty/tyVal) (ty/opVariantField (str label ".clock") 0))))
      (ty/termReturn (str label ".errv"))))

fn procWaitFn facts: libc/TripleFacts -> (Result ty/SsaFunction String)
  (mt (requireConst facts "EINVAL")
    ((err e) (err e))
    ((ok einval)
     (mt (requireConst facts "WNOHANG")
    ((err e) (err e))
    ((ok wnohang)
     (mt (requireConst facts "CLOCK_MONOTONIC")
       ((err e) (err e))
       ((ok clockMonotonic)
        (ok (ty/ssaFunction "procWait" (list)
          (list (ty/ssaParam "pid" (ty/tyI64)) (ty/ssaParam "timeoutMs" (ty/tyI64))) (ty/tyVal)
          (appendAll (list
            (onePidGuard "pid" "entry" einval)
            (list
              (sys/block "entry"
                (list
                  (ty/ssaInstr "pid32" (ty/tyI32) (ty/opPrim "rawNarrowI32" (list "pid")))
                  (sys/int64Const "statusBufSize" 4)
                  (sys/callInstr "statusBuf" (ty/tyPtr) "malloc" (list "statusBufSize"))
                  (ty/ssaInstr "statusBuf.isNull" (ty/tyI1) (ty/opPrim "rawPtrIsNull" (list "statusBuf")))
                  (sys/int32Const "wnohangConst" wnohang)
                  (sys/int32Const "clockConst" clockMonotonic))
                (ty/termBranch "statusBuf.isNull" (sys/edgeTo "errAlloc") (sys/edgeTo "deadline.check"))))
            (list
              (errnoErrBlock "errAlloc" (list) "errAllocFin")
              (errnoFinBlock "errAllocFin"))
            (procWaitDeadlineBlocks "pollLoop" (list (freeInstr "deadline.clockErr.freed" "statusBuf")))
            (list
              (ty/ssaBlock "pollLoop" (list (ty/ssaParam "deadline" (ty/tyI64)))
                (list
                  (sys/callInstr "poll.ret" (ty/tyI32) "waitpid" (list "pid32" "statusBuf" "wnohangConst"))
                  (ty/ssaInstr "poll.n" (ty/tyI64) (ty/opPrim "rawWidenI32" (list "poll.ret")))
                  (sys/int64Const "poll.zero" 0)
                  (ty/ssaInstr "poll.isErr" (ty/tyI1) (ty/opPrim "ltInt" (list "poll.n" "poll.zero"))))
                (ty/termBranch "poll.isErr" (sys/edgeTo "pollErr") (sys/edgeTo "pollCheckDone")))
              (sys/block "pollCheckDone"
                (list (ty/ssaInstr "pollDone" (ty/tyI1) (ty/opPrim "eqInt" (list "poll.n" "pid"))))
                (ty/termBranch "pollDone" (sys/edgeTo "pollDoneBlk") (sys/edgeTo "pollCheckTimeout.call")))
              (errnoErrBlock "pollErr" (list (freeInstr "pollErr.freed" "statusBuf")) "pollErrFin")
              (errnoFinBlock "pollErrFin")
              (sys/block "pollDoneBlk"
                (list
                  (sys/int64Const "pollDoneBlk.off0" 0)
                  (ty/ssaInstr "status32" (ty/tyI32) (ty/opPrim "rawLoadI32" (list "statusBuf" "pollDoneBlk.off0")))
                  (ty/ssaInstr "status64" (ty/tyI64) (ty/opPrim "rawWidenI32" (list "status32")))
                  (freeInstr "pollDoneBlk.freed" "statusBuf")
                  (ty/ssaInstr "statusBox" (ty/tyVal) (ty/opBox "status64"))
                  (sys/int64Const "notTimedOut" 0)
                  (ty/ssaInstr "notTimedOutBox" (ty/tyVal) (ty/opBox "notTimedOut"))
                  (ty/ssaInstr "doneRec" (ty/tyVal) (ty/opRecord "ProcWaitResult" (list "status" "timedOut") (list "statusBox" "notTimedOutBox")))
                  (constructResult "doneOkv" "ok" "doneRec"))
                (ty/termReturn "doneOkv")))
            (nowNanosBlocks "pollCheckTimeout" "pollAfterNow" (list (freeInstr "pollCheckTimeout.err.freed" "statusBuf")))
            (list
              (sys/block "pollAfterNow"
                (list (ty/ssaInstr "pollExpired" (ty/tyI1) (ty/opPrim "geInt" (list "pollCheckTimeout.nowNanos" "deadline"))))
                (ty/termBranch "pollExpired" (sys/edgeTo "pollTimeout") (sys/edgeTo "pollSleep")))
              (sys/block "pollTimeout"
                (list
                  (freeInstr "pollTimeout.freed" "statusBuf")
                  (sys/int64Const "timeoutStatus" 0)
                  (ty/ssaInstr "timeoutStatusBox" (ty/tyVal) (ty/opBox "timeoutStatus"))
                  (sys/int64Const "timedOutOne" 1)
                  (ty/ssaInstr "timedOutOneBox" (ty/tyVal) (ty/opBox "timedOutOne"))
                  (ty/ssaInstr "timeoutRec" (ty/tyVal) (ty/opRecord "ProcWaitResult" (list "status" "timedOut") (list "timeoutStatusBox" "timedOutOneBox")))
                  (constructResult "timeoutOkv" "ok" "timeoutRec"))
                (ty/termReturn "timeoutOkv"))
              (sys/block "pollSleep"
                (list
                  (sys/int64Const "sleepSec" 0) (sys/int64Const "sleepNanos" 10000000)
                  (sys/callInstr "sleepRes" (ty/tyVal) "sysNanosleep" (list "sleepSec" "sleepNanos")))
                (ty/termSwitch "sleepRes" "Result" (list (ty/ssaCase "ok" (ty/ssaEdge "pollLoop" (list "deadline"))) (ty/ssaCase "err" (ty/ssaEdge "pollLoop" (list "deadline")))) (none))))))))))))))

