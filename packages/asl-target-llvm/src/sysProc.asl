fn procRouteFunctions facts: libc/TripleFacts pool: (Map String Int64) -> (Result (List ty/SsaFunction) String)
  (mt (procFacts facts)
    ((err e) (err e))
    ((ok k0)
      (let [(k (wsLayout facts (fwdLayout facts k0)))]
        (ok (list (exitCodeFn) (monoFn k) (strvFn k) (freeStrvFn) (envArgFn k) (envSlotFn facts pool) (highCloexecFn k) (pipeHighFn) (closeAllFn)
                  (if (darwin? facts) (waitFwdDarwinFn k) (waitFwdLinuxFn k))
                  (pidsCountFn) (pidsFillFn) (wsAllocFn k) (wsFreeFn k) (watchOpenFn facts k) (watchCloseFn k) (watchDrainFn facts k) (exitScanFn k) (reapFn k) (waitSetFn k)
                  (processHandleStateInitFn) (processFormatErrFn pool) (processIoErrFn k pool) (processIsIntFn)
                  (processRunFn facts k pool) (processSpawnFn facts k pool) (processWaitFn facts k pool)
                  (spawnFn k pool) (waitPidFn k pool) (waitAnyFn k pool) (pollFn k pool) (rusageFn facts k) (execvFn k pool))))))
