fn rusageFields -> (List String)
  (list "selfMaxRssKb" "selfUserUs" "selfSysUs" "childrenMaxRssKb" "childrenUserUs" "childrenSysUs")

fn rusageDecode k: (Map String Int64) unit: Int64 tag: String base: Int64 -> (List ty/SsaInstr)
  (let [(t (fn [(n String)] -> String (str tag "." n)))
        (cpu (fn [(name String) (off Int64)] -> (List ty/SsaInstr)
               (appendAll (list (list (rI (t (str name ".so")) (+ base (+ off (kf k "timeval.tv_sec")))) (ld64 (t (str name ".sec")) "up" (t (str name ".so")))
                                      (rI (t (str name ".uo")) (+ base (+ off (kf k "timeval.tv_usec")))))
                                (ld32 (t (str name ".usec")) "up" (t (str name ".uo")))
                                (list (rP (t (str name ".secUs")) (ty/tyI64) "mulInt" (list (t (str name ".sec")) "million"))
                                      (rP (t (str name ".us")) (ty/tyI64) "addInt" (list (t (str name ".secUs")) (t (str name ".usec"))))
                                      (sys/boxInstr (t name) (t (str name ".us"))))))))]
    (appendAll (list (list (rI (t "rssO") (+ base (kf k "rusage.ru_maxrss"))) (ld64 (t "rssRaw") "up" (t "rssO")) (rI (t "unit") unit)
                           (rP (t "rssKb") (ty/tyI64) "quotInt" (list (t "rssRaw") (t "unit"))) (sys/boxInstr (t "rss") (t "rssKb")))
                     (cpu "user" (kf k "rusage.ru_utime"))
                     (cpu "sys" (kf k "rusage.ru_stime")))))

fn rusageFn facts: libc/TripleFacts k: (Map String Int64) -> ty/SsaFunction
  (let [(size (kf k "rusage.size")) (unit (libc/rusageMaxRssUnit facts.triple))]
    (wrapperP "procRusage" (list)
      (list
        (rB "entry" (list (rI "two" (* 2 size)) (rC "up" (ty/tyPtr) "malloc" (list "two")) (rP "upNull" (ty/tyI1) "rawPtrIsNull" (list "up"))) (rBr "upNull" "nomem" "selfB"))
        (errnoConstB "nomem" (list) (kf k "ENOMEM"))
        (rB "selfB" (list (rI32 "z32" 0) (rI32 "who0" (kf k "RUSAGE_SELF")) (rC "r0" (ty/tyI32) "getrusage" (list "who0" "up")) (rP "r0Neg" (ty/tyI1) "rawLtI32" (list "r0" "z32")))
          (rBr "r0Neg" "fail" "kidsB"))
        (rB "kidsB" (listAppend (list (intOfPtr "upI" "up") (rI "kidsOff" size)) (listAppend (addrAt "kp" "upI" "kidsOff")
                      (list (rI32 "who1" (kf k "RUSAGE_CHILDREN")) (rC "r1" (ty/tyI32) "getrusage" (list "who1" "kp")) (rP "r1Neg" (ty/tyI1) "rawLtI32" (list "r1" "z32")))))
          (rBr "r1Neg" "fail" "build"))
        (rB "fail" (list (errnoInstr "e") (rC "upFree0" (ty/tyI64) "free" (list "up")) (rH "eV" (ty/tyVal) "errnoErr" (list "e"))) (rRet "eV"))
        (rB "build" (appendAll (list (list (rI "million" 1000000)) (rusageDecode k unit "s" 0) (rusageDecode k unit "c" size)
                                     (list (rC "upFree1" (ty/tyI64) "free" (list "up"))
                                           (rV "rec" (ty/opRecord "Rusage" (rusageFields) (list "s.rss" "s.user" "s.sys" "c.rss" "c.user" "c.sys")))
                                           (rV "okRec" (ty/opConstruct "Result" "ok" (list "rec"))))))
          (rRet "okRec")))))

