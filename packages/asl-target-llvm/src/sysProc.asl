fn processIoErrFn k: (Map String Int64) pool: (Map String Int64) -> ty/SsaFunction
  (rFn "procIoErr" (list (pV "path") (pI "code")) (ty/tyVal)
    (list
      (rB "entry" (list (poolText pool "sep" ": ")
                         (narrow "code32" "code")
                         (rC "reasonPtr" (ty/tyPtr) "strerror" (list "code32"))
                         (rC "reasonLen" (ty/tyI64) "strlen" (list "reasonPtr"))
                         (rC "reason" (ty/tyVal) "mkStr" (list "reasonPtr" "reasonLen"))
                         (rI "enoent" (kf k "ENOENT")) (rP "isNoent" (ty/tyI1) "eqInt" (list "code" "enoent")))
        (rBr "isNoent" "kindNotFound" "kindPermissionCheck"))
      (rB "kindPermissionCheck" (list (rI "eacces" (kf k "EACCES")) (rI "eperm" (kf k "EPERM")) (rI "erofs" (kf k "EROFS"))
                                        (rP "isEacces" (ty/tyI1) "eqInt" (list "code" "eacces"))
                                        (rP "isEperm" (ty/tyI1) "eqInt" (list "code" "eperm"))
                                        (rP "isErofs" (ty/tyI1) "eqInt" (list "code" "erofs"))
                                        (rP "permA" (ty/tyI1) "orBool" (list "isEacces" "isEperm"))
                                        (rP "permission" (ty/tyI1) "orBool" (list "permA" "isErofs")))
        (rBr "permission" "kindPermission" "kindExistsCheck"))
      (rB "kindExistsCheck" (list (rI "eexist" (kf k "EEXIST")) (rI "enotempty" (kf k "ENOTEMPTY"))
                                    (rP "isEexist" (ty/tyI1) "eqInt" (list "code" "eexist"))
                                    (rP "isEnotempty" (ty/tyI1) "eqInt" (list "code" "enotempty"))
                                    (rP "existsError" (ty/tyI1) "orBool" (list "isEexist" "isEnotempty")))
        (rBr "existsError" "kindAlreadyExists" "kindInvalidCheck"))
      (rB "kindInvalidCheck" (list (rI "enotdir" (kf k "ENOTDIR")) (rI "eisdir" (kf k "EISDIR")) (rI "enametoolong" (kf k "ENAMETOOLONG"))
                                    (rI "eloop" (kf k "ELOOP")) (rI "einval" (kf k "EINVAL"))
                                    (rP "invalid0" (ty/tyI1) "eqInt" (list "code" "enotdir"))
                                    (rP "invalid1" (ty/tyI1) "eqInt" (list "code" "eisdir"))
                                    (rP "invalid2" (ty/tyI1) "eqInt" (list "code" "enametoolong"))
                                    (rP "invalid3" (ty/tyI1) "eqInt" (list "code" "eloop"))
                                    (rP "invalid4" (ty/tyI1) "eqInt" (list "code" "einval"))
                                    (rP "invalidA" (ty/tyI1) "orBool" (list "invalid0" "invalid1"))
                                    (rP "invalidB" (ty/tyI1) "orBool" (list "invalid2" "invalid3"))
