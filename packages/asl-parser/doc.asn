(:doc :symbol "asl/packages/asl-parser/src/fnHeader.asl#stripCrLine" :text "a line read from a CRLF file keeps its trailing \\r; stripping it before a header line is used as a join accumulator keeps that \\r from landing mid-token in the joined line")
