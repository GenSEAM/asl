(:doc :symbol "asl/packages/asl-parser/tests/roundtripPropertyTest.asl#" :text "Property test verifying read(print(t)) == t round-trip preservation across ASTs.")
(:doc :symbol "asl/packages/asl-parser/tests/selfParseTest.asl#" :text "Gate test for Unit P1 (parser parity): verifies self-parsing of the 20 compiler closure modules with form counts matching asl-host parse, plus focused regressions for <=, >=, multi-line let/do, record constructors, parameter types, mt preservation, and bodyPos positions. Counts are read at test time from asl/host/out/asl-host parse via processRun; the live compiler closure is gated by tests/conformance/bootstrap/selfParseClosureTest.")
(:doc :symbol "asl/packages/asl-parser/tests/selfParseTest.asl#ClosureModule.path" :text "module file relative to workspace root")
(:doc :symbol "asl/packages/asl-parser/tests/stage1FrontEndTest.asl#" :text "Indent-dialect forms of the compiler closure read as the host reads them: parenthesized enum cases with typed fields, names ending in ?, function-typed parameters, and braces inside string literals, and string escapes decoded as the host reader decodes them.")
(:doc :symbol "asl/packages/asl-parser/tests/stage1FrontEndTest.asl#testNoArrowFnRendersWithoutSentinel" :text "PARSER-inferredUnitConsumers: ast.asl's renderDefun must not leak indentParser.asl's :inferredUnit sentinel for a no-arrow fn header")
(:doc :symbol "asl/packages/asl-parser/tests/tailrecHeaderNormalizationTest.asl#" :text "Regression for tailrec header normalization used by ast lifting.")
(:doc :symbol "asl/packages/asl-parser/tests/tryOperatorTest.asl#" :text "Falsifiable test suite for Task 52601 Error Propagation Operator '?' Desugaring and Single-Line Syntax.")
(:doc :symbol "asl/packages/asl-parser/tests/checkSpeedParseTest.asl#" :text "INDENT-ALLOC and DEPTHSCAN-LAZY gate: parser edge-case samples, every src and corpus file whose source equals base, and the diagnostics over corpus/invalid parse to their base digests, and parsing asl1.asl's import closure in a bounded child allocates under the per-source-byte limit.")
