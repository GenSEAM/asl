(:doc :symbol "asl/packages/asl-parser/src/ast.asl#lowerTopNodesLoop" :text "lower top-level elements loop")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#skipTrivia" :text "skip trivia whitespace and comments")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#scanParenEnd" :text "find byte offset after closing paren delimiter")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#scanDeclEnd" :text "find byte offset after indented declaration body")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#scanDeclsLoop" :text "scan top-level declarations into CST elements")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#scanDecls" :text "scan declarations of source bytes")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#parseCstKidForms" :text "parse indented source through CST lowering")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#parseIndentedToModule" :text "parse indented forms through CST lowering")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#isIndentedSource?" :text "check whether source uses indented declaration heads")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#parseWithFallback" :text "fallback never masks the primary dialect error")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#kidFormsFor" :text "same dialect fallback as parseWithFallback, so kids and tops always pair")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#typeNodeVect" :text "indent bodies read [T] as (list T)")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#isTypeConstructor?" :text "recognize generic type constructors")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#isInlineBodyCandidate?" :text "check if node holds inline return and body")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#vectItems" :text "fn parser writes vector as list")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#renderDefun" :text "PARSER-inferredUnitConsumers: a no-arrow fn header (indentParser.asl's parseFnParamsAndReturn marks it with the :inferredUnit sentinel, since the host infers the real return type from the body) renders with no arrow either, matching astPrinter.asl's printTopDefun, instead of a literal -> :inferredUnit that leaks the sentinel and fails asl-host check")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#" :text "Bidirectional AST Converter and Roundtrip Equivalence between generic S-expressions and Typed AST.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#lowerPattern" :text "Lowers an AST pattern to its S-expression representation.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#liftPattern" :text "Lifts an S-expression into an AST pattern.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#lowerType" :text "Lowers an AST type annotation to an S-expression.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#liftType" :text "Lifts an S-expression into an AST type annotation.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#lowerBindingValue" :text "A :typed marker call (from liftBindingPair) splices its type and value back after the pattern; any other value lowers as itself.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#lowerExpr" :text "Lowers an AST expression into an S-expression.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#astToSexpr" :text "Converts an AST expression into an S-expression.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#lower" :text "Lowers an AST expression into an S-expression.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#liftBindingPair" :text "A binding (pat expr) keeps expr as its value; a typed binding (pat Type expr) keeps every item after the pattern as a :typed marker call, which lowerBindingValue splices back.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#liftExpr" :text "Lifts an S-expression into an AST expression.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#sexprToAst" :text "Converts an S-expression into an AST expression.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#lift" :text "Lifts an S-expression into an AST expression.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#sexprToTopForm" :text "Parses a declaration S-expression into a top-level AST form.")
(:doc :symbol "asl/packages/asl-parser/src/astConverter.asl#topFormToSexpr" :text "Converts a top-level AST form into an S-expression.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#" :text "Typed AST printer: top forms and modules in the host dialect, expressions in the canonical indented form.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printAst" :text "Pretty prints an AST expression as formatted source code.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#formatFloat64" :text "stringFromFloat64 (host builtin, out of this unit's owns) renders an extreme-magnitude value in bare exponent form with no decimal point, e.g. 1e-12, and a whole-number value with no fraction at all, e.g. 2 or -7; the reader's number lexer then misreads either bare form as an Int64 (or, for the exponent case, as 0), so a dotless exponent is rewritten to 1.0e-12 and a dotless whole number to 2.0 before either is ever printed. nan/inf/-inf carry no digits and are left untouched.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printAstPattern" :text "Formats an AST pattern to its string representation.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printAstType" :text "Formats an AST type annotation to its string representation.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#isBlockExpr?" :text "True when e must print on its own indented line(s) rather than glued inline after other text.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#isMarkerCtorName?" :text "Internal binding-shape markers astConverter's liftExpr attaches to a let binding's first pattern (:empty-list, :empty-vect, :empty-paren, :flat, :nested-list, :vect); these name a wrapper shape for lowerExpr to reconstruct, never real source text, so a binding carrying one cannot go through the indented pretty printer.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#anyMarkerBinding?" :text "A marker pattern or a typed binding (astConverter's :typed value marker) has no indented let line; both go through the canonical form.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#soleBindingIsUnmarkedSimple?" :text "A lone binding with no destructuring pattern and no :vect marker came from a bare paren wrapper ((x v)); the indented let line this unit prints for it always desugars back to a [(x v)] vect wrapper on reparse, a different S-expression, so it too must go through the canonical form.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#needsCanonicalLet?" :text "More than one binding has no marker distinguishing a flat multi-binding paren form ((a 1) (b 2)) from a :vect or :nested-list wrapper; printing each as its own let line would desugar back as nested single-binding lets, not one flat binding group, so it must go through the canonical form instead.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#isEmptyElse?" :text "True for the sentinel liftExpr uses when a 2-arg if had no else clause at all; never printed as text.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#ifBranchNeedsCanonical?" :text "A record branch printed on its own indented line, inside the bare if/else keyword block form, is a bare { ... } (or a wrapped (...) around it) either way subject to the indented reader's per-line token grouping (out of this unit's owns); neither choice reparses back to the original's brace span spliced flat into the if call's own arguments, so the whole if must go canonical instead.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printCallBody" :text "The function position is printed the same way an argument would be, since a compound function position, such as calling the result of another call, needs the same disambiguating parens an argument needs; a bare identifier or member chain prints exactly as before.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#dotlessExponentAtom?" :text "A bare atom shaped like 1e-09 (astConverter's lowerLit, out of this unit's owns, can emit this for an extreme-magnitude float): digits, then e/E, then a signed digit run, with no decimal point anywhere.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#fixDotlessExponents" :text "Rewrites a bare 1e-09-shaped float atom in rendered code text to 1.0e-09, outside quoted strings, so the reader's number lexer (out of this unit's owns) does not misread it as 0.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printAstCanonical" :text "Renders an AST expression through its canonical lowered S-expression; correct wherever indentation-based printing is not, since it never depends on column position.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printSafeInline" :text "Prints e bare at indent 0 when that is safe (single physical line), else falls back to its canonical S-expression; used where e occupies the rest of a line (a let value, a match arm body) and no wrapping parens are needed either way.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printRecordBraces" :text "A record literal used as one argument among several, such as a call argument, is a flat { ... } token span spliced into the parent's item list with no wrapping parens of its own (astConverter's lowerSpliced, out of this unit's owns, treats it the same way); used only where that splicing applies. At statement position a record must still get its own parens (printAstExpr's exprRecord case), since a bare { ... } line, unlike (...) or [...], is not self-delimiting to the indented-dialect line reader and would be wrapped in an extra list on reparse regardless.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#simpleMemberBase?" :text "The dot-chain desugarer (indentParser.asl, out of this unit's owns) only correctly rewrites a chain rooted in a bare identifier, such as user.name; a chain rooted in a call result, such as (foo a).bar, silently misparses, so that shape must go through the canonical form instead.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printIfExpr" :text "An empty-else sentinel prints nothing for the else part; a block-worthy branch gets its own indented line(s) after a literal else keyword, since the indented-dialect block reader looks for that keyword to split the then and else blocks.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printBodyListItem" :text "Prints one item of a body-forms list (a defun body or a let body), where each item must round-trip as exactly one form; an item that is itself an explicit (do ...) block prints canonically so it reparses back to one form, not several.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#safeguardBareKeyword" :text "A bare if/else, match or let header line loses a standalone \":\" string-literal argument to the indented-dialect reader's colon-punctuation strip (out of this unit's owns, in indentParser.asl); when the pretty rendering could hit that, fall back to the canonical parenthesized form, which the same reader parses generically and correctly.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printAstExpr" :text "Formats an AST expression with the given indentation level.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#hostSexpr" :text "Rewrites a reader body form into the host dialect: brackets back in let binding and fn parameter slots, a ?-suffixed keyword back from its try desugaring, everything else as read.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printTopDefun" :text "One fn header line in the corpus signature form, an optional :d line, then one parenthesized body form per line; a source fn header with no -> at all (indentParser.asl's parseFnParamsAndReturn marks this with the :inferredUnit sentinel, since the host infers the real return type from the body) prints with no arrow either, instead of a false -> Unit that can fail asl-host check against a non-Unit body.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printModuleHeader" :text "The module header with the :d :x :i keys the corpus writes; the whole-word key rename is a later codemod.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printTopForm" :text "Formats a top-level AST declaration form to host-dialect source.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#printAstModule" :text "Formats a module node and its top-level declarations as host-dialect source.")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#fixExponentsLoop" :text "walk rendered sexpr text, atom by atom, skipping quoted-string content, fixing a dotless float exponent")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#listHeadedItems" :text "the reader keeps a [ ] vector as a list headed by the atom list; the host binds that head as a name, so the binding and parameter slots of let and fn must be brackets again")
(:doc :symbol "asl/packages/asl-parser/src/astPrinter.asl#keywordTryName" :text "indentParser merges a trailing ? into a symbol but desugars it after a keyword, so :balanced? reads as a try on :balanced, and the reader SExpr carries no desugared mark; the one misread is literal user code (mt :k ((ok __v) __v) ((err __e) (err __e))), which checks but fails at run time with ERR_MATCH_NONEXHAUSTIVE and would print as the keyword :k?, a change of meaning accepted for that never-working form")
(:doc :symbol "asl/packages/asl-parser/src/balance.asl#" :text "Pure AgentSlang delimiter balance and structural paren/bracket/brace validation engine.")
(:doc :symbol "asl/packages/asl-parser/src/balance.asl#BalanceResult.balanced" :text "True if all delimiters are balanced and properly nested")
(:doc :symbol "asl/packages/asl-parser/src/balance.asl#BalanceResult.openParens" :text "Remaining unclosed parentheses")
(:doc :symbol "asl/packages/asl-parser/src/balance.asl#BalanceResult.openBrackets" :text "Remaining unclosed square brackets")
(:doc :symbol "asl/packages/asl-parser/src/balance.asl#BalanceResult.openBraces" :text "Remaining unclosed curly braces")
(:doc :symbol "asl/packages/asl-parser/src/balance.asl#BalanceScanState.stack" :text "LIFO delimiter stack")
(:doc :symbol "asl/packages/asl-parser/src/balance.asl#BalanceScanState.inQuote" :text "Currently inside a string literal")
(:doc :symbol "asl/packages/asl-parser/src/balance.asl#BalanceScanState.escape" :text "Previous character was a backslash")
