(:doc :symbol "asl/packages/asl-parser/src/ast.asl#hasTailrec?" :text "True when the token right after the fn keyword is the tailrec modifier, written as either the bare atom tailrec or the keyword :tailrec.")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#typeNodeText" :text "Canonical text of a type annotation node, reading a (list T ...) the indent reader made of [T ...] back as the vector.")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#isInlineBodyCandidate?" :text "Returns true when node is an S-expression list holding an inline return type and body.")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#renderNode" :text "Renders a top-level AST declaration back to source string.")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#fnName?" :text "the host reader accepts any symbol as name")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#offsetPosLoop" :text "find line and col from byte offset")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#offsetPos" :text "convert byte offset to 1-based line/col")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#escapeFormLoop" :text "escape newlines inside multiline string literals")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#escapeFormStringNewlines" :text "escape newlines inside multiline string literals")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#formScanMultiline" :text "scan form bytes for multiline string")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#formHasMultilineString?" :text "check if form bytes have multiline string")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#adjustKidPos" :text "adjust kid position by top-level form line/col")
(:doc :symbol "asl/packages/asl-parser/src/ast.asl#joinFnHeader" :text "the arrow-scan/paramLine/headerJoin/tailrec-strip primitives moved to asl-parser/fnHeader so indentParser.asl can share them without a cycle (fnHeader imports neither ast nor indentParser); this is a thin re-export for layout.asl's a/joinFnHeader")
