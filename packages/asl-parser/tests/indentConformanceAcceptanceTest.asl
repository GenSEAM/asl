(module asl-parser/tests/indentConformanceAcceptanceTest :x [runTests RunTests! testConformanceSuiteExecution! testNegativeNumberDisambiguation testDotFieldAccessLowering testPipelineOperatorLowering testTryAndCoalescingOperators testDualPolarityRefutations!] :i [(asl-parser/indentParser :a ip) (asl-parser/indentLexer :a il) (asl-parser/reader :a rd) (asl-tools/fleet/run :a run)])

fn testConformanceSuiteExecution! -> Bool
  (let [(cRes (fileReadString "asl/packages/asl-parser/tests/conformanceTest.asl"))] (match cRes ((err e) (assert false (str "conformanceTest.asl must exist: " e))) ((ok src) (assert (> (stringLength src) 0) "conformanceTest.asl must not be empty") (assert (stringContains? src "testAdversarialCases") "Declares testAdversarialCases") (let [(res (run/runOneLimited (run/job (list "bin/asl" "test" "asl/packages/asl-parser/tests/conformanceTest.asl") "." (run/childEnv (list))) (run/limits 180 8))) (code res.exit)] (assert (= code 0) "conformanceTest suite must pass with exit code 0") (refute (!= code 0) "conformanceTest suite must not fail") true))))

fn testNegativeNumberDisambiguation -> Bool
  (let [(tokensNeg (il/tokenize "-42")) (tokensSub (il/tokenize "x - 42"))] (assert (> (listLength tokensNeg) 0) "Tokens for negative literal exist") (assert (> (listLength tokensSub) 0) "Tokens for subtraction exist") (refute (= (listLength tokensNeg) (listLength tokensSub)) "Negative literal and subtraction have distinct token counts") true)

fn testDotFieldAccessLowering -> Bool
  (let [(code "fn getName user: User -> Str\n  user.name") (parseRes (ip/parseIndentedForms code))] (assert (ok? parseRes) "Parsing dot access returns ok") (refute (err? parseRes) "Parsing dot access must not error") (let [(forms (optionOr (match parseRes ((ok f) (some f)) ((err _) (none))) (list)))] (assert (> (listLength forms) 0) "Forms count is non-zero") (refute (= (listLength forms) 0) "Forms count must refute zero") true))

fn testPipelineOperatorLowering -> Bool
  (let [(code "fn process x: Int -> Int\n  x |> double |> add(5)") (parseRes (ip/parseIndentedForms code))] (assert (ok? parseRes) "Parsing pipeline operator returns ok") (refute (err? parseRes) "Parsing pipeline operator must not error") true)

fn testTryAndCoalescingOperators -> Bool
  (let [(code "fn fetch id: Str -> Result\n  let res = try sendRequest(id)\n  let opt = res ?? fallback") (parseRes (ip/parseIndentedForms code))] (assert (ok? parseRes) "Parsing try and coalescing returns ok") (refute (err? parseRes) "Parsing try and coalescing must not error") true)

fn testDualPolarityRefutations! -> Bool
  (let [(badIdent (il/tokenize "foo?bar"))] (assert (> (listLength badIdent) 0) "Question mark in identifier is tokenized") (refute (= (listLength badIdent) 1) "Illegal identifier foo?bar must not be single token") (refute (= (listLength badIdent) 2) "Illegal identifier foo?bar must not be two tokens") (let [(cMissing (fileReadString "asl/packages/asl-parser/tests/nonexistentConformance999.asl"))] (assert (err? cMissing) "Nonexistent conformance file read errors") (refute (ok? cMissing) "Nonexistent conformance file must not return ok")) (let [(emptyParse (ip/parseIndentedForms ""))] (assert (ok? emptyParse) "Empty source returns ok empty forms") (let [(forms (optionOr (match emptyParse ((ok f) (some f)) ((err _) (none))) (list)))] (assert (= (listLength forms) 0) "Empty source has 0 forms") (refute (!= (listLength forms) 0) "Empty source must refute non-zero forms"))) (let [(t1 (il/tokenize "?")) (t2 (il/tokenize "??")) (t3 (il/tokenize "?. "))] (assert (> (listLength t1) 0) "Question mark tokenized") (assert (> (listLength t2) 0) "Coalescing tokenized") (assert (> (listLength t3) 0) "Optional chaining tokenized") (refute (= (listLength t1) 0) "Question mark refutes 0 tokens") (refute (= (listLength t2) 0) "Coalescing refutes 0 tokens") (refute (= (listLength t3) 0) "Optional chaining refutes 0 tokens")) (let [(pipeToks (il/tokenize "|>"))] (assert (> (listLength pipeToks) 0) "Pipe operator tokenized") (refute (= (listLength pipeToks) 0) "Pipe operator refutes 0 tokens")) (let [(arrowToks (il/tokenize "->"))] (assert (> (listLength arrowToks) 0) "Arrow tokenized") (refute (= (listLength arrowToks) 0) "Arrow refutes 0 tokens")) (let [(negToks (il/tokenize "-42"))] (assert (> (listLength negToks) 0) "Negative integer tokenized") (refute (= (listLength negToks) 3) "Negative integer refutes separate minus and number tokens")) (let [(subToks (il/tokenize "x - 42"))] (assert (> (listLength subToks) 0) "Subtraction tokenized") (refute (= (listLength subToks) 2) "Subtraction refutes merged token count")) true)

fn ! runTests -> Bool
  (do (assert (testConformanceSuiteExecution!) "testConformanceSuiteExecution must pass") (assert (testNegativeNumberDisambiguation) "testNegativeNumberDisambiguation must pass") (assert (testDotFieldAccessLowering) "testDotFieldAccessLowering must pass") (assert (testPipelineOperatorLowering) "testPipelineOperatorLowering must pass") (assert (testTryAndCoalescingOperators) "testTryAndCoalescingOperators must pass") (assert (testDualPolarityRefutations!) "testDualPolarityRefutations must pass") true)

fn RunTests! -> Bool
  (runTests)
