fn ! closureSources -> (List String)
  (map (fn [(p String)] -> String (resultOr (fileRead p) "")) (closureFiles))

fn formsOf src: String -> Int64
  (mt (a/parseForChecker src) ((ok fs) (listLength fs)) ((err _) -1))

fn samples -> (List (Pair String String))
  (list (pair "calls" "fn f x: Int64 -> Int64\n  g(x)(y) h (k 1) [a (b c) [d]] x? foo? (bar)? m.n(1)\n")
        (pair "escapes" "fn s -> String\n  (str \"a\\nb\\\"c\\\\d\\te\" \"plain\" \"\\x01\" \"\\u00e9\")\n")
        (pair "armSplit" "fn m x: Int64 -> Int64\n  match x\n    (fn [a] -> a) -> 1\n    _ -> 2\n")
        (pair "letLine" "fn q a: Int64 -> Int64\n  let y = (h a)? in [y (z y)]\n")
        (pair "parenModule" "(module m :x [f] :i [])\n\n(fn f [(x Int64)] -> Int64 (g (h x) [1 2] \"q\\\"r\"))\n")
        (pair "deep" (str "fn d -> Int64\n  " (stringRepeat "(" 1001) "1" (stringRepeat ")" 1001) "\n")))

fn goldenSamples -> (List (Pair String String))
  (list (pair "calls" "5438763481667693747:1147")
        (pair "escapes" "6093880271819110550:449")
        (pair "armSplit" "7415999126434123059:477")
        (pair "letLine" "-7659199021373354386:812")
        (pair "parenModule" "1404266677020221420:858")
        (pair "deep" "1652804251290068337:173"))

fn ! testSamples -> Bool
  (let [(got (map (fn [(p (Pair String String))] -> (Pair String String) (pair (pairFirst p) (digestOf (astText (pairSecond p))))) (samples)))
        (want (goldenSamples))]
    (do (assert (= got want) (str "every parser edge-case sample parses to its base digest: " (stringJoin (map (fn [(p (Pair String String))] -> String (str (pairFirst p) "=" (pairSecond p))) got) " ")))
        (assert (stringContains? (astText (optionOr (mapGet (fold (fn [(m (Map String String)) (p (Pair String String))] -> (Map String String) (mapSet m (pairFirst p) (pairSecond p))) (mapEmpty) (samples)) "deep") "")) "ERR_DEPTH expression nested deeper than 1000") "a nest past the limit still reports ERR_DEPTH")
        true))

