fn goldenInvalid -> (List (Pair String String))
  (list (pair "asl/grammar/corpus/invalid/33-notes.asl" "err 1:1 ERR_READ_BARE_TOPLEVEL a bare literal '\"A note is a string literal bound to nothing. The body position already admitted\\none; the top level did not, so a file banner or a note between declarations had\\nnowhere to live. A note is an ADDITION beside the `;` comment, not a replacement\\nfor it: the host still reads `;` as a comment to the end of the line.\"' is not a top-level form; move it into a declaration or the package's doc.asn")
        (pair "asl/grammar/corpus/invalid/bareDecimalPoint.asl" "ok")
        (pair "asl/grammar/corpus/invalid/defunListParams.asl" "err 4:18 ')' closes '[' opened at 2:8")
        (pair "asl/grammar/corpus/invalid/fnTypeparams.asl" "ok")
        (pair "asl/grammar/corpus/invalid/missingArrow.asl" "ok")
        (pair "asl/grammar/corpus/invalid/pascalFunction.asl" "ok")
        (pair "asl/grammar/corpus/invalid/unbalanced.asl" "err 2:3 unclosed '(' at end of file"))

fn pathsWith verdicts: (List (Pair String String)) v: String -> (List String)
  (map pairFirst (filter (fn [(p (Pair String String))] -> Bool (= (pairSecond p) v)) verdicts))

fn ! testDigests -> Bool
  (let [(verdicts (map (fn [(p (Pair String String))] -> (Pair String String) (pair (pairFirst p) (compareRow p))) (goldenDigests)))
        (moved (pathsWith verdicts "moved"))
        (skipped (pathsWith verdicts "skipped"))]
    (do (println (str "(:checkSpeedDigests :same " (stringFromInt64 (listLength (pathsWith verdicts "same"))) " :skipped (" (stringJoin skipped " ") "))"))
        (assert (listEmpty? moved) (str "every src and corpus file whose source equals base parses to the base AST digest; moved: " (stringJoin moved " ")))
        (assert (listContains? (pathsWith verdicts "same") "asl/packages/asl-compiler/src/asl1.asl") "the comparison covers asl1.asl, the file asl1 check parses first")
        true))

fn ! testInvalid -> Bool
  (let [(got (invalidRows))]
    (do (assert (= got (goldenInvalid)) (str "parse diagnostics over corpus/invalid are byte-identical to base: " (stringJoin (map (fn [(p (Pair String String))] -> String (str (pairFirst p) " " (pairSecond p))) got) " | ")))
        true))

fn statsLine text: String -> String
  (optionOr (listHead (filter (fn [(line String)] -> Bool (stringStartsWith? line "(:gcStats ")) (stringLines text))) "")

fn bytesAllocated line: String -> Int64
  (let [(tokens (filter (fn [(t String)] -> Bool (not (stringEmpty? t))) (stringSplit line " ")))]
    (mt (listIndexOf tokens ":bytesAllocated")
      ((some i) (optionOr (stringToInt64 (stringReplace (optionOr (listGet tokens (+ i 1)) "") ")" "")) -1))
      ((none) -1)))

fn ! allocRun mode: String -> Int64
  (let [(d (fr/runOneLimited (fr/job (list (fr/host!) "run" "asl/packages/asl-parser/tests/checkSpeedParseTest.asl" mode) "." (fr/childEnv (list "ASL_GC_STATS=1"))) (fr/limits 600 4)))]
    (do (assert (= d.exit 0) (str mode " run exits 0 (" d.verdict ")"))
        (bytesAllocated (statsLine d.out))))

fn allocLimit -> Int64
  3520

fn ! testAlloc -> Bool
  (let [(srcBytes (fold (fn [(n Int64) (s String)] -> Int64 (+ n (stringLength s))) 0 (closureSources)))
        (readBytes (allocRun "read"))
        (parseBytes (allocRun "parse"))
        (delta (- parseBytes readBytes))
        (perTenth (if (> srcBytes 0) (/ (* delta 10) srcBytes) -1))]
    (do (println (str "(:checkSpeedAlloc :read " (stringFromInt64 readBytes) " :parse " (stringFromInt64 parseBytes) " :delta " (stringFromInt64 delta) " :srcBytes " (stringFromInt64 srcBytes) " :perTenth " (stringFromInt64 perTenth) " :limit " (stringFromInt64 (allocLimit)) ")"))
        (assert (and (> readBytes 0) (and (> delta 0) (> srcBytes 0))) "both runs report bytesAllocated, parsing the closure allocates and the closure is read")
        (assert (< perTenth (allocLimit)) (str "parsing asl1.asl's closure allocates under the limit per source byte: " (stringFromInt64 perTenth) " >= " (stringFromInt64 (allocLimit))))
        true))

fn ! main args: (List String) -> (Result Int64 String)
  (let [(mode (optionOr (listGet args 0) ""))]
    (cond
      ((= mode "read") (do (println (str "read " (stringFromInt64 (listLength (closureSources))))) (ok 0)))
      ((= mode "parse") (do (println (str "parse " (stringJoin (map (fn [(s String)] -> String (stringFromInt64 (formsOf s))) (closureSources)) " "))) (ok 0)))
      ((= mode "digests") (do (map (fn [(p (Pair String String))] -> Unit (println (str "(pair \"" (pairFirst p) "\" \"" (pairSecond p) "\")"))) (digestRows)) (ok 0)))
      ((= mode "samples") (do (map (fn [(p (Pair String String))] -> Unit (println (str "(pair \"" (pairFirst p) "\" \"" (digestOf (astText (pairSecond p))) "\")"))) (samples)) (ok 0)))
      ((= mode "sampleText") (do (map (fn [(p (Pair String String))] -> Unit (println (str (pairFirst p) ": " (astText (pairSecond p))))) (samples)) (ok 0)))
      ((= mode "invalid") (do (map (fn [(p (Pair String String))] -> Unit (println (pairSecond p))) (invalidRows)) (ok 0)))
      (else (err (str "unknown mode " mode "; expected read, parse, digests or invalid")))))

fn ! runTests -> Bool
  (do (assert (testSamples) "edge-case samples equal base")
      (assert (testDigests) "AST digests equal base")
      (assert (testInvalid) "invalid corpus diagnostics equal base")
      (assert (testAlloc) "closure parse allocation under the limit")
      true)
