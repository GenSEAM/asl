(module asl-parser/tryOperatorTest :x [runTests] :i [(indentLexer :a lx) (indentParser :a ip) (reader :a rd)])

fn testLexerTryOperator -> Bool
  (let [(src "val? (foo x)? ?") (lexRes (lx/tokenizeIndented src)) (toks (pairFirst lexRes)) (diags (pairSecond lexRes))] (assert (listEmpty? diags) "Lexing try expressions should yield zero diagnostics") (let [(qName (lx/tokenTypeName (lx/tokQuestion)))] (assert (= qName "?") (str "tokenTypeName for tokQuestion must be ?, got: " qName)) (refute (= qName "QUESTION") "tokenTypeName for tokQuestion must not be verbose QUESTION")) (let [(raws (map (fn [(t lx/IndentToken)] -> String t.rawText) toks)) (allRaws (stringJoin raws " "))] (assert (stringContains? allRaws "?") "Tokens must contain '?'") (refute (stringContains? allRaws "val?") "Postfix 'val?' must separate into 'val' and '?'") (refute (stringContains? allRaws "x)?") "Postfix 'x)?' must separate into 'x', ')', and '?'") true))

fn testDirectTryDesugaringUnwrapOk -> Bool
  (let [(okNode (rd/makeList (list (rd/makeAtom "ok") (rd/makeAtom "42")))) (desugared (ip/desugarTry okNode)) (rendered (rd/renderPrefix desugared))] (assert (= rendered "(mt (ok 42) ((ok __v) __v) ((err __e) (err __e)))") (str "Must desugar (ok 42) into match form: got " rendered)) (assert (stringContains? rendered "((ok __v) __v)") "Must unwrap value in ok arm") (refute (stringContains? rendered "return") "Try lowering must not use return, which the host lacks") (refute (stringContains? rendered "err __v") "Ok binder must not be bound to err") true)

fn testDirectTryDesugaringEarlyReturnErr -> Bool
  (let [(errNode (rd/makeList (list (rd/makeAtom "err") (rd/makeAtom "\"fail\"")))) (desugared (ip/desugarTry errNode)) (rendered (rd/renderPrefix desugared))] (assert (= rendered "(mt (err \"fail\") ((ok __v) __v) ((err __e) (err __e)))") (str "Must desugar (err fail) into match form: got " rendered)) (assert (stringContains? rendered "((err __e) (err __e))") "Err arm must yield the error") (refute (stringContains? rendered "return") "Try lowering must not use return, which the host lacks") (refute (stringContains? rendered "ok __e") "Err binder must not be bound to ok") true)

fn testIndentedFunctionWithTryOperator -> Bool
  (let [(src (str "fn fetchUser id: Int64 -> Result\n" "  raw = (queryDb id)?\n" "  user = (parseUser raw)?\n" "  ok user\n")) (res (ip/parseIndented src))] (mt res ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (stringContains? r "fn fetchUser") "Must define function fetchUser") (assert (stringContains? r "[(id Int64)]") "Must parse parameter vector") (assert (stringContains? r "-> Result") "Must parse return type") (assert (stringContains? r "(mt (queryDb id) ((ok __v) __v) ((err __e) (err __e)))") "Must desugar queryDb try expression") (assert (stringContains? r "(mt (parseUser raw) ((ok __v) __v) ((err __e) (err __e)))") "Must desugar parseUser try expression") (assert (stringContains? r "(ok user)") "Must preserve trailing body form") (refute (stringContains? r "?") "Desugared function AST must not contain unexpanded question marks") (refute (stringContains? r "queryDb id?") "queryDb call must not retain unparsed try operator") true)) ((err msg) (refute true (str "Failed to parse indented function with try operator: " msg)) false)))

fn testSingleLineTryOperatorUnwrap -> Bool
  (let [(src "val = (ok 42)?\n") (res (ip/parseIndented src))] (mt res ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (stringContains? r "val =") "Must preserve assignment target") (assert (stringContains? r "(mt (ok 42) ((ok __v) __v) ((err __e) (err __e)))") "Must desugar (ok 42)? into early-return match form") (assert (stringContains? r "((ok __v) __v)") "Must unwrap value to __v") (refute (stringContains? r "(ok 42)?") "Must not leave raw (ok 42)? in AST") (refute (stringContains? r "err __v") "Value binder must not belong to err branch") true)) ((err msg) (refute true (str "Failed to parse single-line (ok 42)?: " msg)) false)))

fn testSingleLineTryOperatorEarlyReturn -> Bool
  (let [(src "val = (err \"fail\")?\n") (res (ip/parseIndented src))] (mt res ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (stringContains? r "val =") "Must preserve assignment target") (assert (stringContains? r "(mt (err \"fail\") ((ok __v) __v) ((err __e) (err __e)))") "Must desugar (err fail)? into early-return match form") (assert (stringContains? r "((err __e) (err __e))") "Must yield (err __e) from the err arm") (refute (stringContains? r "(err \"fail\")?") "Must not leave raw (err fail)? in AST") (refute (stringContains? r "ok __e") "Error binder must not belong to ok branch") true)) ((err msg) (refute true (str "Failed to parse single-line (err fail)?: " msg)) false)))

fn testNameEndingInQuestion -> Bool
  (let [(src "step?\n") (res (ip/parseIndented src))] (mt res ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (= r "step?") (str "A symbol whose name ends in ? is a name, got: " r)) (refute (stringContains? r "match") "A name ending in ? must not desugar to the try operator") true)) ((err msg) (refute true (str "Failed to parse step?: " msg)) false)))

fn testInteropWithDotAccess -> Bool
  (let [(src "val = try service.client.fetch\n") (res (ip/parseIndented src))] (mt res ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (stringContains? r "(.-fetch (.-client service))") "Must lower compound dot-access into nested property accessor") (assert (stringContains? r "(mt (.-fetch (.-client service)) ((ok __v) __v) ((err __e) (err __e)))") "Must wrap lowered dot-access in try match form") (refute (stringContains? r "service.client.fetch") "Raw dot identifier must not remain unlowered") (refute (stringContains? r "try") "Must not leave the try prefix unlowered") true)) ((err msg) (refute true (str "Failed to parse dot-access try expression: " msg)) false)))

fn testInteropWithStringInterpolation -> Bool
  (let [(src "val = \"https://api.internal/{endpoint}\"?\n") (res (ip/parseIndented src))] (mt res ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (stringContains? r "(mt \"https://api.internal/{endpoint}\" ((ok __v) __v) ((err __e) (err __e)))") (str "Must wrap the literal string, braces kept as the host reads them, in the try form: " r)) (refute (stringContains? r "(str ") "A string literal must not lower to a str call") (refute (stringContains? r "\"?") "Must not leave trailing question mark unlowered") true)) ((err msg) (refute true (str "Failed to parse string interpolation try expression: " msg)) false)))

fn testInsideParensTryOperator -> Bool
  (let [(src "(process (load val)?)\n") (res (ip/parseIndented src))] (mt res ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (stringContains? r "(mt (load val) ((ok __v) __v) ((err __e) (err __e)))") "Must desugar try expression inside parenthesized argument") (assert (stringStartsWith? r "(process") "Outer call form process must be preserved") (refute (stringContains? r ")?") "Must not leave (load val)? unlowered") true)) ((err msg) (refute true (str "Failed to parse inside parens try operator: " msg)) false)))

fn testStandaloneQuestionMark -> Bool
  (let [(src "?\n") (res (ip/parseIndented src))] (mt res ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (= r "?") "Standalone '?' must parse as atom '?'") (refute (stringContains? r "match") "Standalone '?' must not generate match form") true)) ((err msg) (refute true (str "Failed to parse standalone '?': " msg)) false)))

fn runTests -> Bool
  (do (assert (testLexerTryOperator) "testLexerTryOperator passed") (assert (testDirectTryDesugaringUnwrapOk) "testDirectTryDesugaringUnwrapOk passed") (assert (testDirectTryDesugaringEarlyReturnErr) "testDirectTryDesugaringEarlyReturnErr passed") (assert (testIndentedFunctionWithTryOperator) "testIndentedFunctionWithTryOperator passed") (assert (testSingleLineTryOperatorUnwrap) "testSingleLineTryOperatorUnwrap passed") (assert (testSingleLineTryOperatorEarlyReturn) "testSingleLineTryOperatorEarlyReturn passed") (assert (testNameEndingInQuestion) "testNameEndingInQuestion passed") (assert (testInteropWithDotAccess) "testInteropWithDotAccess passed") (assert (testInteropWithStringInterpolation) "testInteropWithStringInterpolation passed") (assert (testInsideParensTryOperator) "testInsideParensTryOperator passed") (assert (testStandaloneQuestionMark) "testStandaloneQuestionMark passed") true)
