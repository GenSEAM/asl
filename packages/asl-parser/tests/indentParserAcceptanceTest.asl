(module asl-parser/tests/indentParserAcceptanceTest :x [runTests testFnDeclarationParsing testSchemaAndEnumParsing testMatchArrowParsing testTryAndPipelineOperators testDualPolarityRefutations] :i [(indentParser :a ip) (astConverter :a cv) (asl-parser/ast :a a) (astPrinter :a ap) (asl-parser/reader :a rd)])

fn testFnDeclarationParsing -> Bool
  (do (let [(srcColon (str "fn add x: Int y: Int -> Int\n" "  add x y\n")) (resColon (ip/parseIndented srcColon))] (match resColon ((ok sexpr1) (let [(r1 (rd/renderSexpr sexpr1))] (assert (stringContains? r1 "fn add") "Must render function add with current fn syntax") (assert (stringContains? r1 "[(x Int) (y Int)]") "Must format parameter vector") (assert (stringContains? r1 "-> Int") "Must format return type") (assert (stringContains? r1 "(add x y)") "Must format body form") (let [(tfRes1 (cv/sexprToTopForm sexpr1))] (match tfRes1 ((ok tf1) (match tf1 ((a/topDefun d1) (assert (= d1.name "add") "Function name must be add") (assert (= (listLength d1.params) 2) "Add must have 2 parameters") (assert (= d1.retType "Int") "Return type must be Int") (let [(p0 (optionOr (listHead d1.params) (a/Param :name "" :type "")))] (assert (= p0.name "x") "Param 0 name must be x") (assert (= p0.type "Int") "Param 0 type must be Int")) (let [(p1 (optionOr (listGet d1.params 1) (a/Param :name "" :type "")))] (assert (= p1.name "y") "Param 1 name must be y") (assert (= p1.type "Int") "Param 1 type must be Int")) (let [(printed1 (ap/printTopForm tf1))] (assert (stringContains? printed1 "fn add") "Printer must output fn add") (assert (stringContains? printed1 "x: Int") "Printer must format x: Int") (assert (stringContains? printed1 "y: Int") "Printer must format y: Int") (assert (stringContains? printed1 "-> Int") "Printer must format -> Int") (refute (stringContains? printed1 "df add") "Surface printer must not emit legacy df keyword"))) (_ (assert false "Expected topDefun node")))) ((err msg1) (assert false (str "Failed to convert sexpr to topForm: " msg1))))))) ((err e1) (assert false (str "Failed to parse colon fn: " e1))))) (let [(srcBracket (str "fn sub [(a Int) (b Int)] -> Int\n" "  sub a b\n")) (resBracket (ip/parseIndented srcBracket))] (match resBracket ((ok sexpr2) (let [(tfRes2 (cv/sexprToTopForm sexpr2))] (match tfRes2 ((ok tf2) (match tf2 ((a/topDefun d2) (assert (= d2.name "sub") "Function name must be sub") (assert (= (listLength d2.params) 2) "Sub must have 2 parameters") (assert (= d2.retType "Int") "Sub return type must be Int") (refute (= d2.name "add") "Sub must not be confused with add")) (_ (assert false "Expected topDefun node")))) ((err msg2) (assert false (str "Failed to convert bracketed fn: " msg2)))))) ((err e2) (assert false (str "Failed to parse bracketed fn: " e2))))) (let [(srcZero (str "fn getMagic [] -> Int\n" "  42\n")) (resZero (ip/parseIndented srcZero))] (match resZero ((ok sexpr3) (let [(tfRes3 (cv/sexprToTopForm sexpr3))] (match tfRes3 ((ok tf3) (match tf3 ((a/topDefun d3) (assert (= d3.name "getMagic") "Function name must be getMagic") (assert (= (listLength d3.params) 0) "Zero-arg fn must have 0 parameters") (assert (= d3.retType "Int") "Magic return type must be Int") (refute (> (listLength d3.params) 0) "Zero-arg fn must not have params")) (_ (assert false "Expected topDefun node")))) ((err msg3) (assert false (str "Failed to convert zero-arg fn: " msg3)))))) ((err e3) (assert false (str "Failed to parse zero-arg fn: " e3))))) true)

fn testSchemaAndEnumParsing -> Bool
  (do (let [(srcBracedSchema "schema Point { x: Int y: Int }") (resBracedSchema (ip/parseIndented srcBracedSchema))] (match resBracedSchema ((ok sexpr1) (let [(r1 (rd/renderSexpr sexpr1))] (assert (stringContains? r1 "schema Point") "Must emit schema Point") (assert (stringContains? r1 "(:field x Int") "Must emit field x") (assert (stringContains? r1 "(:field y Int") "Must emit field y") (let [(tfRes1 (cv/sexprToTopForm sexpr1))] (match tfRes1 ((ok tf1) (match tf1 ((a/topSchema s1) (assert (= s1.name "Point") "Schema name must be Point") (assert (= (listLength s1.fields) 2) "Point must have 2 fields") (let [(f0 (optionOr (listHead s1.fields) (a/AstField :name "" :type "" :docstring "" :default (none) :json (none))))] (assert (= f0.name "x") "Field 0 must be x") (assert (= f0.type "Int") "Field 0 type must be Int")) (let [(f1 (optionOr (listGet s1.fields 1) (a/AstField :name "" :type "" :docstring "" :default (none) :json (none))))] (assert (= f1.name "y") "Field 1 must be y") (assert (= f1.type "Int") "Field 1 type must be Int")) (refute (= s1.name "User") "Schema name must not be User")) (_ (assert false "Expected topSchema node")))) ((err msg1) (assert false (str "Failed to convert schema to topForm: " msg1))))))) ((err e1) (assert false (str "Failed to parse braced schema: " e1))))) (let [(srcIndentedSchema (str "schema User\n" "  name: String \"user display name\"\n" "  age: Int\n")) (resIndentedSchema (ip/parseIndented srcIndentedSchema))] (match resIndentedSchema ((ok sexpr2) (let [(tfRes2 (cv/sexprToTopForm sexpr2))] (match tfRes2 ((ok tf2) (match tf2 ((a/topSchema s2) (assert (= s2.name "User") "Schema name must be User") (assert (= (listLength s2.fields) 2) "User must have 2 fields") (let [(f0 (optionOr (listHead s2.fields) (a/AstField :name "" :type "" :docstring "" :default (none) :json (none))))] (assert (= f0.name "name") "Field 0 name must be name") (assert (= f0.type "String") "Field 0 type must be String") (assert (stringContains? f0.docstring "display name") "Field 0 must preserve docstring")) (let [(f1 (optionOr (listGet s2.fields 1) (a/AstField :name "" :type "" :docstring "" :default (none) :json (none))))] (assert (= f1.name "age") "Field 1 name must be age") (assert (= f1.type "Int") "Field 1 type must be Int")) (refute (stringContains? s2.name "Point") "User schema must not contain Point")) (_ (assert false "Expected topSchema node")))) ((err msg2) (assert false (str "Failed to convert indented schema: " msg2)))))) ((err e2) (assert false (str "Failed to parse indented schema: " e2))))) (let [(srcBracedEnum "enum Color { Red Green Blue }") (resBracedEnum (ip/parseIndented srcBracedEnum))] (match resBracedEnum ((ok sexpr3) (let [(r3 (rd/renderSexpr sexpr3))] (assert (stringContains? r3 "enum Color") "Must emit enum Color") (assert (stringContains? r3 "(:case Red") "Must emit case Red") (assert (stringContains? r3 "(:case Green") "Must emit case Green") (assert (stringContains? r3 "(:case Blue") "Must emit case Blue") (let [(tfRes3 (cv/sexprToTopForm sexpr3))] (match tfRes3 ((ok tf3) (match tf3 ((a/topEnum e3) (assert (= e3.name "Color") "Enum name must be Color") (assert (= (listLength e3.cases) 3) "Color must have 3 cases") (let [(c0 (optionOr (listHead e3.cases) (a/EnumCase :name "" :fields (list) :docstring "")))] (assert (= c0.name "Red") "Case 0 must be Red")) (let [(c1 (optionOr (listGet e3.cases 1) (a/EnumCase :name "" :fields (list) :docstring "")))] (assert (= c1.name "Green") "Case 1 must be Green")) (let [(c2 (optionOr (listGet e3.cases 2) (a/EnumCase :name "" :fields (list) :docstring "")))] (assert (= c2.name "Blue") "Case 2 must be Blue")) (refute (= e3.name "Status") "Color must not be confused with Status")) (_ (assert false "Expected topEnum node")))) ((err msg3) (assert false (str "Failed to convert braced enum: " msg3))))))) ((err e3) (assert false (str "Failed to parse braced enum: " e3))))) (let [(srcIndentedEnum (str "enum Status\n" "  Active\n" "  Inactive\n")) (resIndentedEnum (ip/parseIndented srcIndentedEnum))] (match resIndentedEnum ((ok sexpr4) (let [(tfRes4 (cv/sexprToTopForm sexpr4))] (match tfRes4 ((ok tf4) (match tf4 ((a/topEnum e4) (assert (= e4.name "Status") "Enum name must be Status") (assert (= (listLength e4.cases) 2) "Status must have 2 cases") (let [(c0 (optionOr (listHead e4.cases) (a/EnumCase :name "" :fields (list) :docstring "")))] (assert (= c0.name "Active") "Case 0 must be Active")) (let [(c1 (optionOr (listGet e4.cases 1) (a/EnumCase :name "" :fields (list) :docstring "")))] (assert (= c1.name "Inactive") "Case 1 must be Inactive")) (refute (listEmpty? e4.cases) "Status enum cases must not be empty")) (_ (assert false "Expected topEnum node")))) ((err msg4) (assert false (str "Failed to convert indented enum: " msg4)))))) ((err e4) (assert false (str "Failed to parse indented enum: " e4))))) (let [(srcEnumPayload (str "enum Shape\n" "  Circle r: Float\n" "  Rect w: Float h: Float\n")) (resEnumPayload (ip/parseIndented srcEnumPayload))] (match resEnumPayload ((ok sexpr5) (let [(tfRes5 (cv/sexprToTopForm sexpr5))] (match tfRes5 ((ok tf5) (match tf5 ((a/topEnum e5) (assert (= e5.name "Shape") "Enum name must be Shape") (assert (= (listLength e5.cases) 2) "Shape must have 2 cases") (let [(c0 (optionOr (listHead e5.cases) (a/EnumCase :name "" :fields (list) :docstring "")))] (assert (= c0.name "Circle") "Case 0 must be Circle") (assert (= (listLength c0.fields) 1) "Circle must have 1 field")) (let [(c1 (optionOr (listGet e5.cases 1) (a/EnumCase :name "" :fields (list) :docstring "")))] (assert (= c1.name "Rect") "Case 1 must be Rect") (assert (= (listLength c1.fields) 2) "Rect must have 2 fields")) (refute (= (listLength e5.cases) 0) "Enum must have cases")) (_ (assert false "Expected topEnum node")))) ((err msg5) (assert false (str "Failed to convert payload enum: " msg5)))))) ((err e5) (assert false (str "Failed to parse payload enum: " e5))))) true)

fn isMatchCtor? pat: a/AstPattern wanted: String -> Bool
  (match pat
    ((a/patCtor marker inner)
      (if (= marker ":match-wrapped")
        (match inner
          ((some nested) (match nested ((a/patCtor name _) (= name wanted)) (_ false)))
          ((none) false))
        (= marker wanted)))
    (_ false))

fn testMatchArrowParsing -> Bool
  (let [(src (str "match res\n" "  ok val -> (add val 1)\n" "  err msg -> 0\n")) (res (ip/parseIndented src))] (match res ((ok sexpr) (let [(r (rd/renderSexpr sexpr))] (assert (stringContains? r "match res") "Must contain match res") (assert (stringContains? r "ok val") "Must contain Ok pattern") (assert (stringContains? r "(add val 1)") "Must contain Ok arm body") (assert (stringContains? r "err msg") "Must contain Err pattern") (assert (stringContains? r "0") "Must contain Err arm body") (let [(ast (cv/sexprToAst sexpr))] (match ast ((a/exprMatch target arms) (assert (= (listLength arms) 2) "Match must have 2 arms") (match target ((a/exprIdent v) (assert (= v "res") "Match target must be res")) (_ (assert false "Expected exprIdent target"))) (let [(arm0 (optionOr (listHead arms) (a/AstMatchArm :pat (a/patWildcard) :body (a/exprLit (a/litInt 0)))))] (assert (isMatchCtor? arm0.pat "ok") "First arm constructor must be ok")) (let [(arm1 (optionOr (listGet arms 1) (a/AstMatchArm :pat (a/patWildcard) :body (a/exprLit (a/litInt 0)))))] (assert (isMatchCtor? arm1.pat "err") "Second arm constructor must be err")) (refute (= (listLength arms) 0) "Match arms must not be empty") (refute (= (listLength arms) 1) "Match arms must not be 1") true) (_ (assert false "Expected exprMatch AST node") false))))) ((err e) (assert false (str "Failed to parse match arrow: " e)) false)))

fn testTryAndPipelineOperators -> Bool
  (do (let [(srcTry (str "fn queryUser id: Int -> Result\n" "  let user = (fetchUser id)?\n" "  ok user\n")) (resTry (ip/parseIndented srcTry))] (match resTry ((ok sexprTry) (let [(rTry (rd/renderSexpr sexprTry))] (assert (stringContains? rTry "fn queryUser") "Must render queryUser with current fn syntax") (assert (stringContains? rTry "match (fetchUser id)") "Must desugar try operator into match") (assert (stringContains? rTry "((err __e) (err __e))") "Must preserve err result on failure") (refute (stringContains? rTry "id)?") "Postfix question mark must be desugared") (refute (stringContains? rTry "undefined") "Try desugar must not emit undefined"))) ((err eTry) (assert false (str "Failed to parse try function: " eTry))))) (let [(srcPipe "sourceData |> (filterValid) |> (processItem)\n") (resPipe (ip/parseIndented srcPipe))] (match resPipe ((ok sexprPipe) (let [(rPipe (rd/renderSexpr sexprPipe))] (assert (stringContains? rPipe "|>") "S-expression must contain pipeline head") (assert (stringContains? rPipe "sourceData") "Pipeline must contain source") (assert (stringContains? rPipe "filterValid") "Pipeline must contain stage 1") (assert (stringContains? rPipe "processItem") "Pipeline must contain stage 2") (let [(ast (cv/sexprToAst sexprPipe))] (match ast ((a/exprCall outerF outerArgs) (match outerF ((a/exprIdent vOuter) (assert (= vOuter "processItem") "Outer pipeline call must be processItem") (assert (= (listLength outerArgs) 1) "Outer call must have 1 piped argument") (let [(innerArg (optionOr (listHead outerArgs) (a/exprLit (a/litUnit))))] (match innerArg ((a/exprCall innerF innerArgs) (match innerF ((a/exprIdent vInner) (assert (= vInner "filterValid") "Inner pipeline call must be filterValid") (assert (= (listLength innerArgs) 1) "Inner call must have 1 piped argument") (let [(innermost (optionOr (listHead innerArgs) (a/exprLit (a/litUnit))))] (match innermost ((a/exprIdent vSrc) (assert (= vSrc "sourceData") "Innermost argument must be sourceData")) (_ (assert false "Expected sourceData variable"))))) (_ (assert false "Expected inner exprIdent")))) (_ (assert false "Expected inner exprCall"))))) (_ (assert false "Expected outer exprIdent"))) (refute (listEmpty? outerArgs) "Pipeline outer call must not be zero-arg") true) (_ (assert false "Expected exprCall AST tree for folded pipeline") false))))) ((err ePipe) (assert false (str "Failed to parse pipeline: " ePipe)) false))))

fn testDualPolarityRefutations -> Bool
  (do (let [(r1 (ip/parseIndented "fn"))] (match r1 ((ok sexpr) (refute (stringContains? (rd/renderSexpr sexpr) "[(x") "Empty fn must not hallucinate parameters") (refute (stringContains? (rd/renderSexpr sexpr) "-> Int") "Empty fn must not hallucinate return type")) ((err _) ()))) (let [(r2 (ip/parseIndented "schema"))] (match r2 ((ok sexpr) (refute (stringContains? (rd/renderSexpr sexpr) "(:field") "Empty schema must not hallucinate fields") (refute (stringContains? (rd/renderSexpr sexpr) "enum") "Schema must not emit defenum")) ((err _) ()))) (let [(r3 (ip/parseIndented "enum"))] (match r3 ((ok sexpr) (refute (stringContains? (rd/renderSexpr sexpr) "(:case") "Empty enum must not hallucinate cases") (refute (stringContains? (rd/renderSexpr sexpr) "schema") "Enum must not emit defschema")) ((err _) ()))) (let [(r4 (ip/parseIndented "let x = 100\n"))] (match r4 ((ok sexpr) (let [(r (rd/renderSexpr sexpr))] (refute (stringContains? r "let x = 100") "Surface '=' must be desugared out of canonical S-expr") (refute (stringContains? r "==") "Must not confuse assignment with equality") (assert (stringContains? r "let") "Must contain let") (assert (stringContains? r "100") "Must contain 100"))) ((err _) (refute true "Valid bracket-free let must not fail")))) (let [(r5 (ip/parseIndented "let {a b} = point\n"))] (match r5 ((ok sexpr) (let [(r (rd/renderSexpr sexpr))] (assert (stringContains? r "point.a") "Record destructuring must emit point.a") (assert (stringContains? r "point.b") "Record destructuring must emit point.b") (refute (stringContains? r "listGet") "Record destructuring must not use listGet") (refute (stringContains? r "undefined") "Destructuring must not emit undefined"))) ((err _) (refute true "Valid record destructuring must not fail")))) (let [(r6 (ip/parseIndented "let [first second] = items\n"))] (match r6 ((ok sexpr) (let [(r (rd/renderSexpr sexpr))] (assert (stringContains? r "listGet") "List destructuring must emit listGet") (refute (stringContains? r ".-first") "List destructuring must not use record dot accessor") (refute (stringContains? r ".-second") "List destructuring must not use record dot accessor"))) ((err _) (refute true "Valid list destructuring must not fail")))) (let [(r7 (ip/desugarTry (rd/makeAtom "callExpr")))] (let [(r (rd/renderSexpr r7))] (refute (stringContains? r "(return (ok") "Try desugaring must never return ok on error arm") (refute (stringContains? r "ok __e") "Error binding must never bind ok") (assert (stringContains? r "((err __e) (err __e))") "Error arm must preserve err result"))) (let [(badSchemaNode (cv/sexprToTopForm (rd/makeList (list (rd/makeAtom "schema")))))] (match badSchemaNode ((ok _) (refute true "Schema with missing name must fail")) ((err msg) (assert (stringContains? msg "missing schema name") "Must reject schema without name") (refute (stringEmpty? msg) "Error message must not be empty")))) (let [(badEnumNode (cv/sexprToTopForm (rd/makeList (list (rd/makeAtom "enum")))))] (match badEnumNode ((ok _) (refute true "Enum with missing name must fail")) ((err msg) (assert (stringContains? msg "missing enum name") "Must reject enum without name") (refute (stringEmpty? msg) "Error message must not be empty")))) true)

fn runTests -> Bool
  (do (assert (testFnDeclarationParsing) "testFnDeclarationParsing passed") (assert (testSchemaAndEnumParsing) "testSchemaAndEnumParsing passed") (assert (testMatchArrowParsing) "testMatchArrowParsing passed") (assert (testTryAndPipelineOperators) "testTryAndPipelineOperators passed") (assert (testDualPolarityRefutations) "testDualPolarityRefutations passed") true)
