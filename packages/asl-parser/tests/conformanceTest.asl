(module asl-parser/conformanceTest :x [runTests RunTests testAdversarialCases testDualPolarityRefutations] :i [(asl-parser/indentParser :a ip) (asl-parser/indentLexer :a il) (asl-parser/reader :a rd)])

fn testAdversarialCases -> Bool
  (do (let [(t1 (il/tokenize "-42")) (t2 (il/tokenize "-1")) (t3 (il/tokenize "-100"))] (assert (> (listLength t1) 0) "Case 1: -42 tokenized") (assert (> (listLength t2) 0) "Case 1: -1 tokenized") (assert (> (listLength t3) 0) "Case 1: -100 tokenized") (mt (listHead t1) ((some tk) (mt tk.kind ((tokInt n) (assert (= n -42) "Case 1: parses as int -42")) (_ (assert false "Case 1: must be tokInt")))) ((none) (assert false "Case 1: token missing")))) (let [(tf1 (il/tokenize "-3.14")) (tf2 (il/tokenize "-0.5"))] (assert (> (listLength tf1) 0) "Case 2: -3.14 tokenized") (assert (> (listLength tf2) 0) "Case 2: -0.5 tokenized") (mt (listHead tf1) ((some tk) (mt tk.kind ((tokFloat f) (assert (> (stringLength tk.rawText) 0) "Case 2: parses as float")) (_ (assert false "Case 2: must be tokFloat")))) ((none) (assert false "Case 2: token missing")))) (let [(tsub (il/tokenize "x - 42"))] (assert (= (listLength tsub) 4) "Case 3: x - 42 token count is 4") (mt (listGet tsub 1) ((some tk) (mt tk.kind ((tokSymbol s) (assert (= s "-") "Case 3: subtraction token is symbol -")) (_ (assert false "Case 3: subtraction must be tokSymbol")))) ((none) (assert false "Case 3: token missing")))) (let [(tparen (il/tokenize "(- 100 42)"))] (assert (> (listLength tparen) 4) "Case 4: (- 100 42) tokenized") (let [(parsed (ip/parseIndented "(- 100 42)\n"))] (assert (ok? parsed) "Case 4: (- 100 42) parses ok"))) (let [(tq (il/tokenize "?"))] (assert (> (listLength tq) 0) "Case 5: ? tokenized") (mt (listHead tq) ((some tk) (mt tk.kind ((tokQuestion) (assert (= tk.rawText "?") "Case 5: tokQuestion rawText is ?")) (_ (assert false "Case 5: must be tokQuestion")))) ((none) (assert false "Case 5: token missing")))) (let [(tqq (il/tokenize "??"))] (assert (> (listLength tqq) 0) "Case 6: ?? tokenized") (mt (listHead tqq) ((some tk) (mt tk.kind ((tokCoalesce) (assert (= tk.rawText "??") "Case 6: tokCoalesce rawText is ??")) (_ (assert false "Case 6: must be tokCoalesce")))) ((none) (assert false "Case 6: token missing")))) (let [(tqc (il/tokenize "?."))] (assert (> (listLength tqc) 0) "Case 7: ?. tokenized") (mt (listHead tqc) ((some tk) (mt tk.kind ((tokOptChain) (assert (= tk.rawText "?.") "Case 7: tokOptChain rawText is ?.")) (_ (assert false "Case 7: must be tokOptChain")))) ((none) (assert false "Case 7: token missing")))) (let [(tpipe (il/tokenize "|>"))] (assert (> (listLength tpipe) 0) "Case 8: |> tokenized") (mt (listHead tpipe) ((some tk) (mt tk.kind ((tokPipe) (assert (= tk.rawText "|>") "Case 8: tokPipe rawText is |>")) (_ (assert false "Case 8: must be tokPipe")))) ((none) (assert false "Case 8: token missing")))) (let [(tarr (il/tokenize "->"))] (assert (> (listLength tarr) 0) "Case 9: -> tokenized") (mt (listHead tarr) ((some tk) (mt tk.kind ((tokArrow) (assert (= tk.rawText "->") "Case 9: tokArrow rawText is ->")) (_ (assert false "Case 9: must be tokArrow")))) ((none) (assert false "Case 9: token missing")))) (let [(tbad (il/tokenize "foo?bar"))] (assert (> (listLength tbad) 2) "Case 10: foo?bar split into separate tokens")) (let [(d1 (ip/desugarDot "user.name"))] (assert (= (rd/renderPrefix d1) "(.-name user)") "Case 11: user.name lowered strictly to (.-name user)")) (let [(d2 (ip/desugarDot "user.profile.email.domain"))] (assert (= (rd/renderPrefix d2) "(.-domain (.-email (.-profile user)))") "Case 12: chained dot access lowered strictly")) (let [(p1 (ip/parseIndented "x |> double\n"))] (assert (ok? p1) "Case 13: simple pipeline parses ok") (mt p1 ((ok s) (assert (stringContains? (rd/renderPrefix s) "double") "Case 13: contains double")) ((err _) (assert false "Case 13: parse error")))) (let [(p2 (ip/parseIndented "x |> double |> add(5)\n"))] (assert (ok? p2) "Case 14: multi-stage pipeline parses ok") (mt p2 ((ok s) (let [(r (rd/renderPrefix s))] (assert (stringContains? r "double") "Case 14: contains double") (assert (stringContains? r "add") "Case 14: contains add"))) ((err _) (assert false "Case 14: parse error")))) (let [(p3 (ip/parseIndented "data |> filter(isValid) |> map(transform)\n"))] (assert (ok? p3) "Case 15: multi-arg pipeline parses ok") (mt p3 ((ok s) (let [(r (rd/renderPrefix s))] (assert (stringContains? r "filter") "Case 15: contains filter") (assert (stringContains? r "map") "Case 15: contains map"))) ((err _) (assert false "Case 15: parse error")))) (let [(tryRes (ip/desugarTry (rd/makeList (list (rd/makeAtom "ok") (rd/makeAtom "42")))))] (assert (= (rd/sexprHead tryRes) "mt") "Case 16: postfix ? lowers to the host mt form") (assert (stringContains? (rd/renderPrefix tryRes) "((err __e) (err __e))") "Case 16: postfix ? yields the error, the host has no return")) (let [(ptry (ip/parseIndented "try sendRequest(id)\n"))] (assert (ok? ptry) "Case 17: prefix try parses ok") (mt ptry ((ok s) (assert (= (rd/sexprHead s) "mt") "Case 17: prefix try lowers to the host mt form")) ((err _) (assert false "Case 17: prefix try parse failed")))) (let [(pcoal (ip/parseIndented "res ?? fallback\n"))] (assert (ok? pcoal) "Case 18: null coalescing parses ok") (mt pcoal ((ok s) (assert (= (rd/renderPrefix s) "(?? res fallback)") "Case 18: null coalescing lowers strictly")) ((err _) (assert false "Case 18: parse error")))) (let [(pif (ip/parseIndented (str "if x > 0:\n" "  1\n" "else:\n" "  0\n")))] (assert (ok? pif) "Case 19: indented if/else parses ok") (mt pif ((ok s) (assert (= (rd/sexprHead s) "if") "Case 19: lowers to if form")) ((err _) (assert false "Case 19: parse error")))) (let [(pmatch (ip/parseIndented (str "match res\n" "  Ok val ->\n" "    val\n" "  Err err ->\n" "    0\n")))] (assert (ok? pmatch) "Case 20: indented match parses ok") (mt pmatch ((ok s) (assert (= (rd/sexprHead s) "match") "Case 20: lowers to match form")) ((err _) (assert false "Case 20: parse error")))) true)

fn testDualPolarityRefutations -> Bool
  (do (refute (err? (ip/parseIndented "x |> double\n")) "Refute pipeline parsing error") (refute (err? (ip/parseIndented "res ?? fallback\n")) "Refute coalescing parsing error") (refute (err? (ip/parseIndented "try send(id)\n")) "Refute prefix try parsing error") (refute (ok? (ip/parseIndented "")) "Refute empty source ok") (refute (= (listLength (il/tokenize "foo?bar")) 1) "Refute single token for foo?bar") (refute (= (listLength (il/tokenize "-42")) 3) "Refute 3 tokens (separate minus and number) for negative integer") (refute (= (listLength (il/tokenize "-3.14")) 3) "Refute 3 tokens (separate minus and number) for negative float") (refute (= (listLength (il/tokenize "x - 42")) 2) "Refute 2 tokens for subtraction with spaces") (refute (= (listLength (il/tokenize "??")) 3) "Refute 3 tokens (separate questions) for coalescing operator") (refute (= (listLength (il/tokenize "?.")) 3) "Refute 3 tokens for optchain operator") (refute (= (listLength (il/tokenize "|>")) 3) "Refute 3 tokens for pipe operator") (refute (= (listLength (il/tokenize "->")) 3) "Refute 3 tokens for arrow operator") (refute (rd/isAtom? (ip/desugarDot "user.name")) "Refute atom result for dot projection") (refute (stringContains? (rd/renderPrefix (ip/desugarDot "a.b.c")) "a.b") "Refute unlowered dot notation") (refute (stringContains? (rd/renderPrefix (ip/desugarTry (rd/makeAtom "x"))) "undefined") "Refute undefined in try desugar") (refute (err? (ip/parseIndented (str "if a:\n  1\nelse:\n  2\n"))) "Refute if/else block parse error") true)

fn runTests -> Bool
  (do (assert (testAdversarialCases) "testAdversarialCases must pass") (assert (testDualPolarityRefutations) "testDualPolarityRefutations must pass") true)

fn RunTests -> Bool
  (runTests)
