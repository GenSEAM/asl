(module asl-parser/tests/indentAstMigrationAcceptanceTest :x [runTests testTryOperatorExecutionAndDesugaring testPatternDestructuring testTypedAstHierarchyAndBidirectionalRoundtrip testAstPrinterAndIndentedFormatting testAutomatedMigrationSafetyInvariants!] :i [(indentLexer :a lx) (indentParser :a ip) (asl-parser/ast :a a) (astConverter :a cv) (astPrinter :a ap) (asl-cli/migrate :a mig) (asl-parser/reader :a rd)])

fn executeTryPropagation step1: (Result Int64 String) step2: (Result Int64 String) -> (Result Int64 String)
  (match step1 ((err e1) (err e1)) ((ok v1) (match step2 ((err e2) (err e2)) ((ok v2) (ok (+ v1 v2))))))

fn testTryOperatorExecutionAndDesugaring -> Bool
  (let [(okNode (rd/makeList (list (rd/makeAtom "ok") (rd/makeAtom "42")))) (desugaredOk (ip/desugarTry okNode)) (renderedOk (rd/renderPrefix desugaredOk)) (errNode (rd/makeList (list (rd/makeAtom "err") (rd/makeAtom "\"failure\"")))) (desugaredErr (ip/desugarTry errNode)) (renderedErr (rd/renderPrefix desugaredErr))] (assert (= renderedOk "(match (ok 42) ((ok __v) __v) ((err __e) (err __e)))") "ip/desugarTry lowers (ok 42) into early-return match form") (assert (stringContains? renderedOk "((ok __v) __v)") "Ok arm unwraps value binder __v") (assert (stringContains? renderedOk "((err __e) (err __e))") "Err arm re-wraps the error") (refute (stringContains? renderedOk "(return (ok") "Ok arm must not return error") (refute (stringContains? renderedOk "err __v") "Value binder must refute err pattern") (assert (= renderedErr "(match (err \"failure\") ((ok __v) __v) ((err __e) (err __e)))") "ip/desugarTry lowers (err failure) into early-return match form") (refute (stringContains? renderedErr "(return (ok") "Err arm must refute returning ok") (refute (stringContains? renderedErr "ok __e") "Error binder must refute ok pattern") (let [(lexRes (lx/tokenizeIndented "step?")) (toks (pairFirst lexRes)) (diags (pairSecond lexRes))] (assert (listEmpty? diags) "Lexing step? yields zero diagnostics") (refute (not (listEmpty? diags)) "Lexing step? refutes presence of diagnostics") (assert (= (lx/tokenTypeName (lx/tokQuestion)) "?") "tokenTypeName for tokQuestion is ?") (refute (= (lx/tokenTypeName (lx/tokQuestion)) "QUESTION") "tokenTypeName refutes verbose QUESTION") (let [(raws (map (fn [(t lx/IndentToken)] -> String t.rawText) toks)) (joined (stringJoin raws " "))] (assert (stringContains? joined "?") "Tokens must isolate question mark") (refute (stringContains? joined "step?") "Postfix 'step?' must split into 'step' and '?'"))) (let [(src "val = (ok 100)?\n") (parsed (ip/parseIndented src))] (match parsed ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (stringContains? r "val =") "Assignment target val is preserved") (assert (stringContains? r "(match (ok 100) ((ok __v) __v) ((err __e) (err __e)))") "Parsed ? desugars into canonical match form") (refute (stringContains? r "100?") "Tokens must not bleed question mark into number literal") (refute (stringContains? r "(ok 100)?") "AST must refute unlowered ? operator"))) ((err msg) (assert false (str "Failed to parse (ok 100)?: " msg))))) (let [(rOk (executeTryPropagation (ok 10) (ok 25))) (rErr1 (executeTryPropagation (err "first-error") (ok 25))) (rErr2 (executeTryPropagation (ok 10) (err "second-error")))] (assert (ok? rOk) "Runtime try chain on ok inputs must succeed") (assert (= rOk (ok 35)) "Runtime try chain unwraps values and computes sum") (refute (err? rOk) "Runtime try chain on ok inputs must refute error") (refute (!= rOk (ok 35)) "Runtime try chain must refute incorrect sum") (assert (err? rErr1) "First step error must trigger early exit") (assert (= rErr1 (err "first-error")) "Original error from first step is preserved") (refute (ok? rErr1) "Error on first step must refute ok result") (refute (= rErr1 (err "swallowed")) "Error must refute swallowing or replacement") (assert (err? rErr2) "Second step error must trigger early exit") (assert (= rErr2 (err "second-error")) "Original error from second step is preserved") (refute (ok? rErr2) "Error on second step must refute ok result") true))

fn testPatternDestructuring -> Bool
  (do (let [(srcPair (str "let [a b] = pair\n" "  (+ a b)\n")) (resPair (ip/parseIndented srcPair))] (match resPair ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (= r "(let [(a (match (listGet pair 0) ((some a) a))) (b (match (listGet pair 1) ((some b) b)))] (+ a b))") "Pair destructuring desugars into sequential listGet bindings") (assert (stringContains? r "(a (match (listGet pair 0) ((some a) a)))") "Binding a maps to index 0") (assert (stringContains? r "(b (match (listGet pair 1) ((some b) b)))") "Binding b maps to index 1") (refute (stringContains? r "(a (match (listGet pair 1) ((some a) a)))") "Binding a must refute inverted index 1") (refute (stringContains? r "(b (match (listGet pair 0) ((some b) b)))") "Binding b must refute inverted index 0") (refute (stringContains? r "[a b] =") "Desugared form must refute raw bracket pattern"))) ((err msg) (assert false (str "Failed to parse [a b] = pair: " msg))))) (let [(srcTriple (str "let [x y z] = coords\n" "  (+ x y z)\n")) (resTriple (ip/parseIndented srcTriple))] (match resTriple ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (= r "(let [(x (match (listGet coords 0) ((some x) x))) (y (match (listGet coords 1) ((some y) y))) (z (match (listGet coords 2) ((some z) z)))] (+ x y z))") "Triple destructuring desugars into sequential listGet bindings 0, 1, 2") (assert (stringContains? r "(x (match (listGet coords 0) ((some x) x)))") "Binding x maps to index 0") (assert (stringContains? r "(y (match (listGet coords 1) ((some y) y)))") "Binding y maps to index 1") (assert (stringContains? r "(z (match (listGet coords 2) ((some z) z)))") "Binding z maps to index 2") (refute (stringContains? r "(x (match (listGet coords 2) ((some x) x)))") "Binding x must refute inverted index 2") (refute (stringContains? r "(z (match (listGet coords 0) ((some z) z)))") "Binding z must refute inverted index 0") (refute (stringContains? r "(y (match (listGet coords 0) ((some y) y)))") "Binding y must refute shifted index 0") (refute (stringContains? r "[x y z]") "Desugared form must refute raw triple pattern"))) ((err msg) (assert false (str "Failed to parse [x y z] = coords: " msg))))) (let [(srcRecord (str "let {x y} = point\n" "  (+ x y)\n")) (resRecord (ip/parseIndented srcRecord))] (match resRecord ((ok sexpr) (let [(r (rd/renderPrefix sexpr))] (assert (= r "(let [(x (.-x point)) (y (.-y point))] (+ x y))") "Record destructuring desugars into canonical property accessors") (assert (stringContains? r "(x (.-x point))") "Field x maps to (.-x point)") (assert (stringContains? r "(y (.-y point))") "Field y maps to (.-y point)") (refute (stringContains? r "(x (.-y point))") "Field x must refute swapped property accessor") (refute (stringContains? r "(y (.-x point))") "Field y must refute swapped property accessor") (refute (stringContains? r "{x y}") "Desugared form must refute raw brace pattern"))) ((err msg) (assert false (str "Failed to parse {x y} = point: " msg))))) (let [(directList (ip/desugarDestructuring false (list "u" "v") (rd/makeAtom "vec") (list (rd/makeAtom "ok")))) (rList (rd/renderPrefix directList)) (directRec (ip/desugarDestructuring true (list "name" "age") (rd/makeAtom "person") (list (rd/makeAtom "ok")))) (rRec (rd/renderPrefix directRec))] (assert (stringContains? rList "(u (match (listGet vec 0) ((some u) u)))") "Direct list desugar binds u to index 0") (assert (stringContains? rList "(v (match (listGet vec 1) ((some v) v)))") "Direct list desugar binds v to index 1") (refute (stringContains? rList "(u (match (listGet vec 1) ((some u) u)))") "Direct list desugar refutes inverted index") (assert (stringContains? rRec "(name (.-name person))") "Direct record desugar binds name to .-name") (assert (stringContains? rRec "(age (.-age person))") "Direct record desugar binds age to .-age") (refute (stringContains? rRec "(name (.-age person))") "Direct record desugar refutes swapped accessor") true))

fn litEqual? a: a/AstLit b: a/AstLit -> Bool
  (match a ((a/litInt ai) (match b ((a/litInt bi) (= ai bi)) (_ false))) ((a/litFloat af) (match b ((a/litFloat bf) (= af bf)) (_ false))) ((a/litString as) (match b ((a/litString bs) (= as bs)) (_ false))) ((a/litBool ab) (match b ((a/litBool bb) (= ab bb)) (_ false))) ((a/litUnit) (match b ((a/litUnit) true) (_ false))))

fn optPatternEqual? oa: (Option a/AstPattern) ob: (Option a/AstPattern) -> Bool
  (match oa ((some pa) (match ob ((some pb) (patternEqual? pa pb)) ((none) false))) ((none) (match ob ((some _) false) ((none) true))))

fn patternsEqual? as: (List a/AstPattern) bs: (List a/AstPattern) -> Bool
  (if (!= (listLength as) (listLength bs)) false (let [(len (listLength as))] (fold (fn [(acc Bool) (i Int64)] -> Bool (and acc (patternEqual? (optionOr (listGet as i) (a/patWildcard)) (optionOr (listGet bs i) (a/patWildcard))))) true (range 0 len))))

fn patFieldsEqual? as: (List (Pair String a/AstPattern)) bs: (List (Pair String a/AstPattern)) -> Bool
  (if (!= (listLength as) (listLength bs)) false (let [(len (listLength as))] (fold (fn [(acc Bool) (i Int64)] -> Bool (let [(f1 (optionOr (listGet as i) (pair "" (a/patWildcard)))) (f2 (optionOr (listGet bs i) (pair "" (a/patWildcard))))] (and acc (and (= (pairFirst f1) (pairFirst f2)) (patternEqual? (pairSecond f1) (pairSecond f2)))))) true (range 0 len))))

fn patternEqual? a: a/AstPattern b: a/AstPattern -> Bool
  (match a ((a/patWildcard) (match b ((a/patWildcard) true) (_ false))) ((a/patVar an) (match b ((a/patVar bn) (= an bn)) (_ false))) ((a/patLit al) (match b ((a/patLit bl) (litEqual? al bl)) (_ false))) ((a/patTuple ae) (match b ((a/patTuple be) (patternsEqual? ae be)) (_ false))) ((a/patRecord af) (match b ((a/patRecord bf) (patFieldsEqual? af bf)) (_ false))) ((a/patCtor an aa) (match b ((a/patCtor bn ba) (and (= an bn) (optPatternEqual? aa ba))) (_ false))))

fn typesEqual? as: (List a/AstType) bs: (List a/AstType) -> Bool
  (if (!= (listLength as) (listLength bs)) false (let [(len (listLength as))] (fold (fn [(acc Bool) (i Int64)] -> Bool (and acc (typeEqual? (optionOr (listGet as i) (a/typeNamed "")) (optionOr (listGet bs i) (a/typeNamed ""))))) true (range 0 len))))

fn typeFieldsEqual? as: (List (Pair String a/AstType)) bs: (List (Pair String a/AstType)) -> Bool
  (if (!= (listLength as) (listLength bs)) false (let [(len (listLength as))] (fold (fn [(acc Bool) (i Int64)] -> Bool (let [(f1 (optionOr (listGet as i) (pair "" (a/typeNamed "")))) (f2 (optionOr (listGet bs i) (pair "" (a/typeNamed ""))))] (and acc (and (= (pairFirst f1) (pairFirst f2)) (typeEqual? (pairSecond f1) (pairSecond f2)))))) true (range 0 len))))

fn typeEqual? a: a/AstType b: a/AstType -> Bool
  (match a ((a/typeNamed an) (match b ((a/typeNamed bn) (= an bn)) (_ false))) ((a/typeTuple ae) (match b ((a/typeTuple be) (typesEqual? ae be)) (_ false))) ((a/typeRecord af) (match b ((a/typeRecord bf) (typeFieldsEqual? af bf)) (_ false))) ((a/typeFn ap ar) (match b ((a/typeFn bp br) (and (typesEqual? ap bp) (typeEqual? ar br))) (_ false))))

fn exprsEqual? as: (List a/AstExpr) bs: (List a/AstExpr) -> Bool
  (if (!= (listLength as) (listLength bs)) false (let [(len (listLength as))] (fold (fn [(acc Bool) (i Int64)] -> Bool (and acc (exprEqual? (optionOr (listGet as i) (a/exprLit (a/litUnit))) (optionOr (listGet bs i) (a/exprLit (a/litUnit)))))) true (range 0 len))))

fn bindingsEqual? as: (List (Pair a/AstPattern a/AstExpr)) bs: (List (Pair a/AstPattern a/AstExpr)) -> Bool
  (if (!= (listLength as) (listLength bs)) false (let [(len (listLength as))] (fold (fn [(acc Bool) (i Int64)] -> Bool (let [(p1 (optionOr (listGet as i) (pair (a/patWildcard) (a/exprLit (a/litUnit))))) (p2 (optionOr (listGet bs i) (pair (a/patWildcard) (a/exprLit (a/litUnit)))))] (and acc (and (patternEqual? (pairFirst p1) (pairFirst p2)) (exprEqual? (pairSecond p1) (pairSecond p2)))))) true (range 0 len))))

fn matchArmsEqual? as: (List a/AstMatchArm) bs: (List a/AstMatchArm) -> Bool
  (if (!= (listLength as) (listLength bs)) false (let [(len (listLength as))] (fold (fn [(acc Bool) (i Int64)] -> Bool (let [(a1 (optionOr (listGet as i) (a/matchArm (a/patWildcard) (a/exprLit (a/litUnit))))) (a2 (optionOr (listGet bs i) (a/matchArm (a/patWildcard) (a/exprLit (a/litUnit)))))] (and acc (and (patternEqual? a1.pat a2.pat) (exprEqual? a1.body a2.body))))) true (range 0 len))))

fn recordFieldsEqual? as: (List (Pair String a/AstExpr)) bs: (List (Pair String a/AstExpr)) -> Bool
  (if (!= (listLength as) (listLength bs)) false (let [(len (listLength as))] (fold (fn [(acc Bool) (i Int64)] -> Bool (let [(f1 (optionOr (listGet as i) (pair "" (a/exprLit (a/litUnit))))) (f2 (optionOr (listGet bs i) (pair "" (a/exprLit (a/litUnit)))))] (and acc (and (= (pairFirst f1) (pairFirst f2)) (exprEqual? (pairSecond f1) (pairSecond f2)))))) true (range 0 len))))

fn condClausesEqual? as: (List (Pair a/AstExpr (List a/AstExpr))) bs: (List (Pair a/AstExpr (List a/AstExpr))) -> Bool
  (if (!= (listLength as) (listLength bs)) false (let [(len (listLength as))] (fold (fn [(acc Bool) (i Int64)] -> Bool (let [(c1 (optionOr (listGet as i) (pair (a/exprLit (a/litUnit)) (list)))) (c2 (optionOr (listGet bs i) (pair (a/exprLit (a/litUnit)) (list))))] (and acc (and (exprEqual? (pairFirst c1) (pairFirst c2)) (exprsEqual? (pairSecond c1) (pairSecond c2)))))) true (range 0 len))))

fn paramsEqual? as: (List a/Param) bs: (List a/Param) -> Bool
  (if (!= (listLength as) (listLength bs)) false (let [(len (listLength as))] (fold (fn [(acc Bool) (i Int64)] -> Bool (let [(p1 (optionOr (listGet as i) (a/Param :name "" :type ""))) (p2 (optionOr (listGet bs i) (a/Param :name "" :type "")))] (and acc (and (= p1.name p2.name) (= p1.type p2.type))))) true (range 0 len))))

fn optStrEqual? oa: (Option String) ob: (Option String) -> Bool
  (match oa ((some sa) (match ob ((some sb) (= sa sb)) ((none) false))) ((none) (match ob ((some _) false) ((none) true))))

fn exprEqual? a: a/AstExpr b: a/AstExpr -> Bool
  (match a ((a/exprLit al) (match b ((a/exprLit bl) (litEqual? al bl)) (_ false))) ((a/exprIdent an) (match b ((a/exprIdent bn) (= an bn)) (_ false))) ((a/exprMember at af) (match b ((a/exprMember bt bf) (and (= af bf) (exprEqual? at bt))) (_ false))) ((a/exprCall af aa) (match b ((a/exprCall bf ba) (and (exprEqual? af bf) (exprsEqual? aa ba))) (_ false))) ((a/exprLet ab aby) (match b ((a/exprLet bb bby) (and (bindingsEqual? ab bb) (exprsEqual? aby bby))) (_ false))) ((a/exprIf ac at ae) (match b ((a/exprIf bc bt be) (and (exprEqual? ac bc) (and (exprEqual? at bt) (exprEqual? ae be)))) (_ false))) ((a/exprMatch at aa) (match b ((a/exprMatch bt ba) (and (exprEqual? at bt) (matchArmsEqual? aa ba))) (_ false))) ((a/exprTry ai) (match b ((a/exprTry bi) (exprEqual? ai bi)) (_ false))) ((a/exprBlock ae) (match b ((a/exprBlock be) (exprsEqual? ae be)) (_ false))) ((a/exprRecord af ar) (match b ((a/exprRecord bf br) (and (recordFieldsEqual? af bf) (exprsEqual? ar br))) (_ false))) ((a/exprCond ac) (match b ((a/exprCond bc) (condClausesEqual? ac bc)) (_ false))) ((a/exprLambda ap art abody arp) (match b ((a/exprLambda bp brt bbody brp) (and (paramsEqual? ap bp) (and (optStrEqual? art brt) (exprsEqual? abody bbody)))) (_ false))) ((a/exprInterpolation ap) (match b ((a/exprInterpolation bp) (exprsEqual? ap bp)) (_ false))))

fn testTypedAstHierarchyAndBidirectionalRoundtrip -> Bool
  (do (let [(lInt (a/litInt 42)) (lFloat (a/litFloat 3.14)) (lStr (a/litString "canonical")) (lBool (a/litBool true)) (lUnit (a/litUnit))] (assert (litEqual? lInt lInt) "lInt is self-equivalent") (assert (litEqual? lFloat lFloat) "lFloat is self-equivalent") (assert (litEqual? lStr lStr) "lStr is self-equivalent") (assert (litEqual? lBool lBool) "lBool is self-equivalent") (assert (litEqual? lUnit lUnit) "lUnit is self-equivalent") (refute (litEqual? lInt (a/litInt 43)) "lInt refutes altered integer value") (refute (litEqual? lBool (a/litBool false)) "lBool refutes false") (refute (litEqual? lStr (a/litString "corrupted")) "lStr refutes corrupted text")) (let [(pWild (a/patWildcard)) (pVar (a/patVar "userName")) (pLit (a/patLit (a/litInt 10))) (pTup (a/patTuple (list (a/patVar "x") (a/patVar "y")))) (pRec (a/patRecord (list (pair "key" (a/patVar "val"))))) (pCtor (a/patCtor "Some" (some (a/patVar "val"))))] (assert (patternEqual? pWild pWild) "pWild is self-equivalent") (assert (patternEqual? pVar pVar) "pVar is self-equivalent") (assert (patternEqual? pLit pLit) "pLit is self-equivalent") (assert (patternEqual? pTup pTup) "pTup is self-equivalent") (assert (patternEqual? pRec pRec) "pRec is self-equivalent") (assert (patternEqual? pCtor pCtor) "pCtor is self-equivalent") (refute (patternEqual? pVar (a/patVar "otherName")) "pVar refutes altered identifier") (refute (patternEqual? pWild pVar) "pWild refutes pVar")) (let [(tName (a/typeNamed "Int64")) (tTup (a/typeTuple (list (a/typeNamed "Int64") (a/typeNamed "String")))) (tRec (a/typeRecord (list (pair "id" (a/typeNamed "Int64"))))) (tFn (a/typeFn (list (a/typeNamed "Int64")) (a/typeNamed "Bool")))] (assert (typeEqual? tName tName) "tName is self-equivalent") (assert (typeEqual? tTup tTup) "tTup is self-equivalent") (assert (typeEqual? tRec tRec) "tRec is self-equivalent") (assert (typeEqual? tFn tFn) "tFn is self-equivalent") (refute (typeEqual? tName (a/typeNamed "Float64")) "tName refutes altered type name") (refute (typeEqual? tFn (a/typeFn (list (a/typeNamed "Int64")) (a/typeNamed "String"))) "tFn refutes altered return type")) (let [(callExpr (a/exprCall (a/exprIdent "add") (list (a/exprIdent "x") (a/exprLit (a/litInt 1))))) (memberExpr (a/exprMember (a/exprIdent "user") "profile")) (letExpr (a/exprLet (list (pair (a/patVar "a") (a/exprLit (a/litInt 10)))) (list (a/exprCall (a/exprIdent "+") (list (a/exprIdent "a") (a/exprLit (a/litInt 5))))))) (matchExpr (a/exprMatch (a/exprIdent "status") (list (a/matchArm (a/patVar "ok") (a/exprLit (a/litInt 0))) (a/matchArm (a/patWildcard) (a/exprLit (a/litInt 1)))))) (blockExpr (a/exprBlock (list (a/exprLit (a/litInt 100)) (a/exprLit (a/litInt 200)))))] (let [(rtCall (cv/sexprToAst (cv/astToSexpr callExpr))) (rtMember (cv/sexprToAst (cv/astToSexpr memberExpr))) (rtLet (cv/sexprToAst (cv/astToSexpr letExpr))) (rtMatch (cv/sexprToAst (cv/astToSexpr matchExpr))) (rtBlock (cv/sexprToAst (cv/astToSexpr blockExpr)))] (assert (exprEqual? rtCall callExpr) "Call expression roundtrip identity holds") (assert (exprEqual? rtMember memberExpr) "Member expression roundtrip identity holds") (assert (exprEqual? rtLet letExpr) "Let expression roundtrip identity holds") (assert (exprEqual? rtMatch matchExpr) "Match expression roundtrip identity holds") (assert (exprEqual? rtBlock blockExpr) "Block expression roundtrip identity holds") (let [(corruptedCall (a/exprCall (a/exprIdent "sub") (list (a/exprIdent "x") (a/exprLit (a/litInt 1))))) (corruptedMember (a/exprMember (a/exprIdent "user") "settings")) (corruptedLet (a/exprLet (list (pair (a/patVar "b") (a/exprLit (a/litInt 10)))) (list (a/exprIdent "b")))) (corruptedMatch (a/exprMatch (a/exprIdent "other") (list))) (corruptedBlock (a/exprBlock (list (a/exprLit (a/litInt 999)))))] (refute (exprEqual? rtCall corruptedCall) "Call roundtrip refutes altered function symbol") (refute (exprEqual? rtMember corruptedMember) "Member roundtrip refutes altered member field") (refute (exprEqual? rtLet corruptedLet) "Let roundtrip refutes altered variable pattern") (refute (exprEqual? rtMatch corruptedMatch) "Match roundtrip refutes altered target node") (refute (exprEqual? rtBlock corruptedBlock) "Block roundtrip refutes altered block contents") true))))

fn testAstPrinterAndIndentedFormatting -> Bool
  (do (let [(strExpr (a/exprLit (a/litString "hello world"))) (intExpr (a/exprLit (a/litInt 42))) (identExpr (a/exprIdent "resultVar")) (callExpr (a/exprCall (a/exprIdent "compute") (list (a/exprIdent "x") (a/exprIdent "y")))) (memExpr (a/exprMember (a/exprIdent "client") "timeout"))] (let [(sStr (ap/printAstExpr strExpr 0)) (sInt (ap/printAstExpr intExpr 0)) (sIdent (ap/printAstExpr identExpr 0)) (sCall (ap/printAstExpr callExpr 0)) (sMem (ap/printAstExpr memExpr 0))] (assert (= sStr "\"hello world\"") "String literal is formatted with enclosing double quotes") (refute (= sStr "hello world") "String literal refutes unquoted string representation") (refute (not (stringStartsWith? sStr "\"")) "String literal refutes missing leading quote") (refute (not (stringEndsWith? sStr "\"")) "String literal refutes missing trailing quote") (assert (= sInt "42") "Integer literal is formatted as 42") (refute (= sInt "0") "Integer literal refutes wrong number") (assert (= sIdent "resultVar") "Identifier is formatted cleanly") (refute (stringEmpty? sIdent) "Identifier print refutes empty string") (refute (!= sIdent "resultVar") "Identifier print refutes name deviation") (assert (= sCall "compute x y") "Top-level call is formatted without outer parens") (refute (stringStartsWith? sCall "(") "Top-level call refutes leading paren") (refute (stringEndsWith? sCall ")") "Top-level call refutes trailing paren") (assert (= sMem "client.timeout") "Member access is formatted with dot-notation") (refute (stringContains? sMem ".-") "Member access refutes legacy .- accessor"))) (let [(fnNode (a/DefunNode :name "calculateSum" :typeVars (list) :isExported true :effect false :params (list (a/Param :name "a" :type "Int64") (a/Param :name "b" :type "Int64")) :retType "Int64" :docstring "\"Calculates sum of two integers\"" :body (list (rd/makeList (list (rd/makeAtom "+") (rd/makeAtom "a") (rd/makeAtom "b")))) :bodyPos (list))) (tfFn (a/topDefun fnNode)) (modNode (a/ModuleNode :path "math/sumService" :docstring "\"Sum service module\"" :exported (list "calculateSum") :imports (list (pair "core/math" "cm")) :defs (list tfFn))) (modText (ap/printAstModule modNode))] (assert (stringContains? modText "module math/sumService") "Module text contains module header") (assert (stringContains? modText "fn calculateSum a: Int64 b: Int64 -> Int64") "Module text contains fn calculateSum signature") (assert (stringContains? modText "\n  (+ a b)") "Module text contains 2-space indented fn body") (assert (stringContains? modText ":x [calculateSum]") "Module text contains exports vector") (assert (stringContains? modText "(core/math :a cm)") "Module text contains imports") (refute (stringContains? modText "(df calculateSum") "Module text refutes legacy df syntax") (refute (stringContains? modText "(defun calculateSum") "Module text refutes legacy defun syntax") (refute (not (stringContains? modText "calculateSum")) "Module text refutes missing function identifier") (match (ip/parseIndentedForms modText) ((err e) (assert false (str "Reparsing printed module text failed: " e))) ((ok forms) (assert (>= (listLength forms) 2) "Reparsed module must produce at least 2 top-level forms") (refute (listEmpty? forms) "Reparsed forms must refute empty list") (let [(f0 (optionOr (listGet forms 0) (rd/makeAtom ""))) (f1 (optionOr (listGet forms 1) (rd/makeAtom "")))] (assert (= (rd/sexprHead f0) "module") "First reparsed form is module") (assert (= (rd/sexprHead f1) "fn") "Second reparsed form is fn") (refute (!= (rd/sexprHead f0) "module") "First form refutes non-module") (refute (!= (rd/sexprHead f1) "fn") "Second form refutes non-df") true)))))

fn testAutomatedMigrationSafetyInvariants! -> Bool
  (let [(_ (dirCreate "tmp")) (sampleSrc (str "(module demo/safety\n" "  :x [multiply]\n" "  :i [(reader :a rd)])\n\n" "(df multiply [(x Int64) (y Int64)] -> Int64\n" "  (* x y))\n")) (checkPath "tmp/safety_check_fixture.asl") (dryPath "tmp/safety_dryrun_fixture.asl") (abortPath "tmp/safety_abort_fixture.asl") (abortSentinel "ORIGINAL_SAFE_CONTENT_STAYS_INTACT")] (match (fileWrite checkPath sampleSrc) ((err e) (assert false (str "Failed to write check fixture: " e))) ((ok _) (let [(resCheck (mig/migrateSource sampleSrc checkPath false true))] (match resCheck ((err emsg) (assert false (str "Check mode should succeed, got: " emsg))) ((ok msg) (assert (stringContains? msg "Validated migratable") "Check confirms migratable status") (match (fileReadString checkPath) ((err _) (assert false "Failed to re-read check fixture")) ((ok diskCheck) (assert (= diskCheck sampleSrc) "Check mode leaves disk content strictly identical") (refute (!= diskCheck sampleSrc) "Check mode refutes disk modification") (refute (stringContains? diskCheck "fn multiply") "Check mode refutes writing migrated fn to disk")))))))) (match (fileWrite dryPath sampleSrc) ((err _) (assert false "Failed to write dry-run fixture")) ((ok _) (let [(resDry (mig/migrateSource sampleSrc dryPath true false))] (match resDry ((err emsg) (assert false (str "Dry-run should succeed, got: " emsg))) ((ok indented) (assert (stringContains? indented "fn multiply x: Int64 y: Int64 -> Int64") "Dry-run output contains fn signature") (assert (stringContains? indented "module demo/safety") "Dry-run output contains module header") (refute (stringContains? indented "(df multiply") "Dry-run output refutes legacy df syntax") (match (fileReadString dryPath) ((err _) (assert false "Failed to re-read dry-run fixture")) ((ok diskDry) (assert (= diskDry sampleSrc) "Dry-run leaves disk content strictly identical") (refute (!= diskDry sampleSrc) "Dry-run refutes disk modification") (refute (= diskDry indented) "Dry-run refutes writing indented text to disk")))))))) (match (fileWrite abortPath abortSentinel) ((err _) (assert false "Failed to write abort fixture")) ((ok _) (let [(corruptSrc "(module broken/syntax (df unclosed [(x Int64] (* x 2)))") (resAbort (mig/migrateSource corruptSrc abortPath false false))] (match resAbort ((ok _) (assert false "Malformed/divergent source must not succeed in migration")) ((err emsg) (assert (stringContains? emsg "semantic divergence detected") "Abort error confirms divergence detection") (refute (stringContains? emsg "Successfully migrated") "Abort error refutes success message") (match (fileReadString abortPath) ((err _) (assert false "Failed to re-read abort fixture")) ((ok diskAbort) (assert (= diskAbort abortSentinel) "Disk content strictly preserved upon divergence abort") (refute (!= diskAbort abortSentinel) "Disk content refutes corruption upon divergence abort")))))))) true)

fn ! runTests -> Bool
  (and (testTryOperatorExecutionAndDesugaring) (and (testPatternDestructuring) (and (testTypedAstHierarchyAndBidirectionalRoundtrip) (and (testAstPrinterAndIndentedFormatting) (testAutomatedMigrationSafetyInvariants!)))))
