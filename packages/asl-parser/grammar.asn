(:grammar
  :package asl-parser
  :version "0.1.0"
  :tokensBaseline 1
  :symbols [
    (:sym :name "AstField" :kind :type :tokens 1)
    (:sym :name "BalanceResult" :kind :type :tokens 1)
    (:sym :name "ClosureHeads" :kind :type :tokens 1)
    (:sym :name "DefunNode" :kind :type :tokens 1)
    (:sym :name "EnumCase" :kind :type :tokens 1)
    (:sym :name "EnumNode" :kind :type :tokens 1)
    (:sym :name "GrammarTrieNode" :kind :type :tokens 1)
    (:sym :name "ModuleNode" :kind :type :tokens 1)
    (:sym :name "OutlineItem" :kind :type :tokens 1)
    (:sym :name "Param" :kind :type :tokens 1)
    (:sym :name "ParseError" :kind :type :tokens 1)
    (:sym :name "SExpr" :kind :type :tokens 1)
    (:sym :name "SchemaNode" :kind :type :tokens 1)
    (:sym :name "Token" :kind :type :tokens 1)
    (:sym :name "TokenType" :kind :type :tokens 1)
    (:sym :name "TopForm" :kind :type :tokens 1)

    (:sym :name "closureHeads" :kind :fn :tokens 2)
    (:sym :name "detectLang" :kind :fn :tokens 2)
    (:sym :name "dump" :kind :fn :tokens 1)
    (:sym :name "formatOutline" :kind :fn :tokens 2)
    (:sym :name "isAtom?" :kind :fn :tokens 2)
    (:sym :name "isDelimiter" :kind :fn :tokens 2)
    (:sym :name "isList?" :kind :fn :tokens 2)
    (:sym :name "isVect?" :kind :fn :tokens 2)
    (:sym :name "isWhitespace" :kind :fn :tokens 2)
    (:sym :name "lenList" :kind :fn :tokens 2)
    (:sym :name "makeAtom" :kind :fn :tokens 2)
    (:sym :name "makeList" :kind :fn :tokens 2)
    (:sym :name "makeToken" :kind :fn :tokens 2)
    (:sym :name "makeVect" :kind :fn :tokens 2)
    (:sym :name "parse" :kind :fn :tokens 1)
    (:sym :name "projDefun" :kind :fn :tokens 2)
    (:sym :name "projEnum" :kind :fn :tokens 2)
    (:sym :name "projHeads" :kind :fn :tokens 2)
    (:sym :name "projModule" :kind :fn :tokens 2)
    (:sym :name "projParse" :kind :fn :tokens 2)
    (:sym :name "projSchema" :kind :fn :tokens 2)
    (:sym :name "projTopform" :kind :fn :tokens 2)
    (:sym :name "renderAll" :kind :fn :tokens 2)
    (:sym :name "renderCompound" :kind :fn :tokens 2)
    (:sym :name "renderNode" :kind :fn :tokens 2)
    (:sym :name "renderSexpr" :kind :fn :tokens 2)
    (:sym :name "runSmoke" :kind :fn :tokens 2)
    (:sym :name "runTokenize" :kind :fn :tokens 2)
    (:sym :name "scanOutline" :kind :fn :tokens 2)
    (:sym :name "sexprHead" :kind :fn :tokens 2)
    (:sym :name "tokenKind" :kind :fn :tokens 2)
    (:sym :name "tokenize" :kind :fn :tokens 1)

    (:sym :name "buildGrammarTrie" :kind :fn :tokens 3
          :rationale "Builds in-memory grammar trie state machine from structured ASN grammar rules for constrained decoding")
    (:sym :name "computeValidTokens" :kind :fn :tokens 3
          :rationale "Computes exact legal next token set admitted by grammar trie given current prefix")
    (:sym :name "isHeadMatch?" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'head-match?': question mark predicate form requires full verb phrase to avoid collision with pattern matching macros")
    (:sym :name "tokenTypeName" :kind :fn :tokens 3
          :rationale "Cannot be reduced to 'token-name': disambiguates lexer token category names from identifier token literal strings")
    (:sym :name "validateTokenSequence" :kind :fn :tokens 3
          :rationale "Validates whether sequential token stream satisfies grammar trie transition constraints to terminal state")
    (:sym :name "checkDelimiterBalance" :kind :fn :tokens 3
          :rationale "Computes structural delimiter balance and nesting across parens brackets and braces")
    (:sym :name "isDelimiterBalanced?" :kind :fn :tokens 3
          :rationale "Convenience predicate checking if source code has perfectly balanced delimiters")
    (:sym :name "countUnclosedParens" :kind :fn :tokens 3
          :rationale "Returns count of unclosed open parentheses in source string for auto-repair and delimiter balancing")
    (:sym :name "balanceDelimiters" :kind :fn :tokens 2
          :rationale "Balances unclosed parentheses in source code with quote and escape awareness")
  ])
