(:seeds :v 1 :format "whole-program LLVM IR of asl/packages/asl-compiler/src/asl1.asl, gzip -9 -n, one per triple; sha256/bytes of the .gz, llSha256/llBytes of the IR" :regen "bin/asl run tools/seed.asl regen" :link "gzip -dc asl1.ll.gz > asl1.ll; clang -x ir asl1.ll -x none asl/host/out/libaslrt.a -lm" :runtime "libaslrt.a holds rtFloor.o, rtAbi.o and gcAsl.o, all emitted from ASL by build.sh (RT-FLOOR)" :policy "regenerate only when seedFixpointTest needs it (stage2.ll differs from stage3.ll) or at a release, never per commit; tools/seed.asl check compares sourceDigest (sha256 over the asl1 import closure and the prelude) with the tree and rewrites nothing"
