(defun ! main [(args (List String))] -> (Result Unit IoError)
  (println (num 7 2))
  (println (num 7 0))
  (println (fnum 7 2))
  (println (fnum 7 0))
  (println (narrow 2147483647))
  (println (minmax "7" "2"))
  (println (edge 1))
  (println (from-float "7"))
  (println (string-from-int64 (wrap-mod))))
