(:publishedClaims
  :version "1.2"
  :reviewed "2026-11-13"
  :d "Every figure the project publishes, with what stands behind it. :status says how far to trust it: :measured has a dated count recorded in a tracked file; :measuredUntracked has a dated count whose record is not in this repository; :budget is a target the recorded counts can be checked against; :specConstant is a value fixed by an external standard; :unmeasured has no measurement in the tree and must not be cited as a result. The metric strings must match standardClaims in asl/packages/asl-gates/src/siteClaims.asl, which gate3Grounding compares them against; that comparison checks the list, not the evidence. :recounts holds the figures README.md and the site print since 2026-11-13; its rows are (:figure ...) forms, outside that list, and each names tokenizer, method, scope and date."
  :standards [
    (:claim :metric "57%-65%" :category "token_compression" :status :unmeasured :source "none" :seenIn "no tracked page on 2026-11-13; formerly AGENTS.md (50%-65%) and asl/web/content/blog/token-economy-and-structural-compression.md (40% to 65%), which now gives 40.0% to 64.7% against spaced keyed JSON with the minified baselines beside it" :desc "Structural token reduction of ASN against JSON. The lock file once cited for it, asl/bench/asn_tokens.lock, is not in the repository or its history.")
    (:claim :metric "-64.7%" :category "token_compression" :status :measured :source "asl/README.md" :evidence "README.md, section What is measured and what is not: one pretty-printed keyed JSON tool call counts 51 cl100k_base tokens and the positional frame 18 (tiktoken, 2026-09-24, recounted 2026-11-13); 1 - 18/51 = 0.6471" :desc "Token reduction for one agent tool frame against pretty-printed keyed JSON only; against minified JSON it is 40% and a JSON positional array is 1 token smaller (see :recounts). A single example, not a benchmark; the lock file it was first sourced to, bench/token_frames.lock, is untracked.")
    (:claim :metric "1.90%" :category "token_compression" :status :measuredUntracked :source "workspace ledger .asl/mem/principles.asn (CamelCaseCorpusSaving), not in this repository" :evidence "2964 tracked .asl and .asn files, 169852 identifiers rewritten to kebab-case and counted, 2026-09-22" :desc "camelCase saving against kebab-case on o200k_base.")
    (:claim :metric "1.68%" :category "token_compression" :status :measuredUntracked :source "workspace ledger .asl/mem/principles.asn (CamelCaseCorpusSaving), not in this repository" :evidence "same corpus and date as the 1.90% claim" :desc "camelCase saving against kebab-case on cl100k_base.")
    (:claim :metric "<100ms" :category "cold_start" :status :unmeasured :source "none" :desc "Agent launch cold start latency. asl/bench/launchStability.asl, once cited, checks prompt-prefix stability and cache cost arithmetic and times nothing.")
    (:claim :metric "24MB" :category "memory_rss" :status :unmeasured :source "none" :desc "Peak RSS memory. asl/bench/tierBudget.asl, once cited, checks a token budget (maxMinimalTokens 1000) and measures no memory.")
    (:claim :metric "<=2 tokens" :category "primitive_cost" :status :budget :source "asl/grammar/grammar.asn" :evidence ":tokensBaseline 2; per-symbol :tokens counts for 48 core symbols (o200k_base, tiktoken 0.12.0, bare name, 2026-09-24): 34 at 1 token, 8 at 2, 6 at 3 to 5, each of the 6 carrying a :rationale. The counts are of the kebab-case spellings grammar.asn records, not of the camelCase builtin names in use now." :desc "Token budget per core symbol, met by 42 of 48 recorded symbols.")
    (:claim :metric "107/107" :category "vocab_coverage" :status :unmeasured :source "none" :desc "Executed vocabulary coverage. The lock file once cited, asl/prelude/coverage.lock, is not in the repository or its history.")
    (:claim :metric "0.038ms" :category "wasm_launch" :status :unmeasured :source "none" :seenIn "asl/packages/asl-mem/README.md, as a search latency for 5,000 vectors" :desc "Wasm launch time. Previously sourced to asl/packages/asl-target-wat/manifest.asn, which records no timing.")
    (:claim :metric "<0.04ms" :category "bus_latency" :status :unmeasured :source "none" :seenIn "enum case docs in asl/packages/asl-agent/src/eddie.asl and asl/packages/asl-mem/src/paged.asl" :desc "Agent bus message dispatch. Previously sourced to asl/packages/asl-agent-bus/manifest.asn, which records no timing; the package is pure functions with no socket I/O to time.")
    (:claim :metric "64KB" :category "wasm_memory" :status :specConstant :source "asl/grammar/wasm.asn" :evidence "pageSizeBytes 65536, the WebAssembly page size" :desc "WebAssembly linear memory page size, a spec constant, not a measurement.")
    (:claim :metric "-75%" :category "vdom_reduction" :status :unmeasured :source "none" :desc "DOM downsampling token reduction. Previously sourced to asl/packages/asl-vdom/manifest.asn, which records no measurement.")
  ]
  :recounts [
    (:figure :value "30" :category "token_compression" :status :measured :date "2026-11-13" :tokenizer "tiktoken 0.12.0 encode_ordinary, cl100k_base (o200k_base: 32)" :scope "one tool call, the JSON object printed in README.md" :method "json.dumps(obj, separators=(',', ':')) of that object, token count" :desc "Minified keyed JSON for the README frame; the pretty-printed form is 51 on both vocabularies.")
    (:figure :value "17" :category "token_compression" :status :measured :date "2026-11-13" :tokenizer "tiktoken 0.12.0 encode_ordinary, cl100k_base and o200k_base" :scope "the same tool call" :method "token count of the string [\"cmd\",\"git\",[\"status\",\"--short\"],\"/app\",5000]" :desc "JSON positional array of the same call: 1 token fewer than the ASL positional frame (18).")
    (:figure :value "40%" :category "token_compression" :status :measured :date "2026-11-13" :tokenizer "tiktoken 0.12.0, cl100k_base" :scope "the same tool call" :method "1 - 18/30, ASL positional frame against minified keyed JSON" :desc "Saving of the positional frame against minified JSON; it comes from dropping keys, which a JSON array does as well.")
    (:figure :value "28" :category "token_compression" :status :measuredUntracked :date "2026-11-13" :tokenizer "tiktoken 0.12.0, cl100k_base and o200k_base" :scope "the same tool call as a keyed ASN frame" :method "token count by the language audit of 2026-11-13; the audit record and the exact frame text are in the workspace ledger, not in this repository" :desc "Keyed ASN against 30 (cl100k) or 32 (o200k) for minified keyed JSON.")
    (:figure :value "13.6%" :category "token_compression" :status :measuredUntracked :date "2026-11-13" :tokenizer "tiktoken 0.12.0, cl100k_base" :scope "the table sample in asl/web/content/blog/token-economy-and-structural-compression.md" :method "1 - 51/59, ASN table against minified JSON of the same rows (spaced keyed JSON 85, columnar minified JSON 49); recounted by the grader of the site change, record in the workspace ledger" :desc "ASN table against minified JSON on one small sample; columnar JSON is 2 tokens smaller than the ASN table.")
    (:figure :value "9%-17%" :category "token_compression" :status :measuredUntracked :date "2026-11-13" :tokenizer "tiktoken 0.12.0, o200k_base" :scope "100 generated records of 5 fields (id name role active score), seed 7; fixture and generator not in this repository" :method "keyed ASN records 2669 tokens (2469 on single lines without head) against minified JSON 2271: +17.5% and +8.7%; language audit of 2026-11-13" :desc "Keyed ASN is larger than minified keyed JSON on this fixture. On the same data columnar minified JSON is 1287, ASN rows with a column header 1480, CSV 1158.")
    (:figure :value "0.46%" :category "token_compression" :status :measuredUntracked :date "2026-10-09" :tokenizer "tiktoken, o200k_base" :scope "7190 real agent receipts" :method "ASN against minified JSON of the same receipts; workspace ledger .asl/mem/work/LANG/tokenEfficiency-20261009.asn, not in this repository" :desc "ASN smaller than minified JSON by this much on real receipts.")
    (:figure :value "1.84" :category "code_tokens" :status :measuredUntracked :date "2026-10-09" :tokenizer "tiktoken, o200k_base" :scope "9 module pairs, ASL 12037 tokens against typed Python 6547" :method "token ratio ASL over Python; workspace ledger .asl/mem/work/LANG/tokenEfficiency-20261009.asn; the Python sides were not executed against the ASL tests" :desc "ASL costs more tokens than typed Python on algorithmic code. Single files recounted 2026-11-13 range from 1.34 (examples/fib.asl) to 1.84 (bench/algo/histogram.asl), which is the 1.3 to 1.8 the README prints; the README shapes example is 0.88 (102 against 116).")
    (:figure :value "145/462" :category "generation" :status :measuredUntracked :date "2026-10-15" :tokenizer "none" :scope "462 trials of one parametric arithmetic task family, free models, no comparator language" :method "bin/asl check and test of each generation, raw and after the asl-forms heal pass; workspace ledger .asl/mem/principles.asn (MechanicalHealRecoversGeneratedAsl)" :desc "Raw pass 145 (31%), 420 after heal; all 38 remaining check failures lack a function header. Not a comparison with any other language; EXPERIMENT.md is the protocol for one.")
  ]
  :peripheralScopes [
    (:scope
      :package "asl-voice"
      :status "conceptual-schema"
      :driver "none"
      :falsifiable false
      :desc "Streaming audio chunk, voice intent, and speech synthesis records scoped as conceptual data protocols; no live OS microphone or speaker drivers.")
  ]
)
