(:mutationCorpus
  :version "1.0"
  :packages [
    (:package :name "asl-gates" :tier :core :path "asl/packages/asl-gates")
    (:package :name "asl-bench" :tier :bench :path "asl/bench")
  ]
  :mutants [
    (:mutant
      :id "mut-kill-01"
      :package "asl-gates"
      :symbol "assert-equal"
      :category :relational
      :original "(= a b)"
      :mutated "(!= a b)"
      :expectedOutcome :killed
      :testRef "asl/packages/asl-gates/tests/gates_test.asl")
    (:mutant
      :id "mut-equiv-01"
      :package "asl-bench"
      :symbol "is-under-budget?"
      :category :equivalent
      :original "(<= token-count budget)"
      :mutated "(or (< token-count budget) (= token-count budget))"
      :expectedOutcome :equivalent
      :justification "Logical equivalence: (<= a b) is logically identical to (or (< a b) (= a b)) across all integers; leaves program semantics unchanged")
  ]
)
