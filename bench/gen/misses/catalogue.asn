(:missCatalogue :unit MISS-ABSORB :date "2026-11-13" :source "asl/bench/gen/results/2026-11-13/*.asn" :method "asl run asl/bench/gen/misses/replay.asl: every ASL reply the bench graded as failing is rebuilt into its harness, checked, healed, checked and tested; a reply takes the first class below whose mark its raw check output holds" :decisions "accept: the reader takes the spelling; heal: asl heal rewrites it; turn: a model turn, the diagnostic names the fix")
(:class :id "eqEq" :prior true :decision "accept" :marks ("(== a b) is retired") :why "every model writes it, the meaning is not in doubt; the reader reads it as (= a b), heal rewrites the stored text")
(:class :id "delimiters" :prior true :decision "heal" :marks ("unmatched ')'" "unclosed '('" "ERR_UNBALANCED") :why "a header-style fn has no outer paren, models close one anyway; unique by indentation")
(:class :id "headerShape" :prior true :decision "heal" :marks ("defun parameters must be a [ ] vector" "ERR_UNKNOWN_TYPE : in function" "ERR_UNKNOWN_TYPE ( in function") :why "wrapped or parenthesised parameters rewrite to the header line; a curried header with unnamed parameters is a model turn")
(:class :id "bareBody" :prior true :decision "heal" :marks ("unbound symbol: cond" "unbound symbol: match" "unbound symbol: let\n" "unbound symbol: else" "mt arm has an invalid pattern head" "it is a Bool value, not a function") :why "the body continues the paren-free header style with indentation as structure; the indentation states the parens")
(:class :id "percent" :prior true :decision "accept" :marks ("unbound symbol: %") :why "read as (mod a b), heal rewrites the stored text")
(:class :id "foreignName" :prior true :decision "heal" :marks ("unbound symbol: listCons" "unbound symbol: listConcat" "unbound symbol: intMod" "unbound symbol: stringEq" "unbound symbol: intToString" "unbound symbol: stringToList" "unbound symbol: listNew" "unbound symbol: mapNew" "unbound symbol: listPush" "unbound symbol: letrec" "nil is not a case") :why "a rename from the prior table is kept when the check improves; a name with no one-for-one canonical form gets a :fix in its diagnostic")
(:class :id "appendElement" :prior true :decision "heal" :marks ("argument to listAppend: expected (List") :why "(listAppend xs x) with an element: the element is wrapped as (list x)")
(:class :id "optionAsList" :prior true :decision "heal" :marks ("found (Option (List") :why "(listTail xs) passed as a list, the cdr and xs[1:] prior: (optionOr (listTail xs) (list))")
(:class :id "plusOnString" :prior true :decision "heal" :marks ("argument to +: expected a number, found String") :why "(+ a b) over strings becomes (str a b)")
(:class :id "missingType" :prior false :decision "turn" :marks ("is not a record type in this module" "neither a known type") :why "the reply uses a record the task names without declaring it; no text to repair from")
