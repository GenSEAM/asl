fn indexOf xs: (List Int64) target: Int64 -> (Option Int64)
  (match (listHead xs)
      ((none) (none))
      ((some h)
        (if (= h target)
          (some 0)
          (match (indexOf (optionOr (listTail xs) (list)) target)
            ((none) (none))
            ((some i) (some (+ i 1)))))))
