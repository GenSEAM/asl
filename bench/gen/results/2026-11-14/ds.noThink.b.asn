pty) pairs)\n```" "```asl\nfn histogram text: String -> (Map String Int64)\n  let [words (stringSplit text \" \")]\n    let [letters (filter (fn [w] (not (= w \"\"))) words)]\n      let [counts (fold (fn [acc w]\n        match (mapGet acc w)\n          ((some n) (mapSet acc w (+ n 1)))\n          ((none) (mapSet acc w 1))) (mapEmpty) letters)]\n        let [pairs (mapPairs counts)]\n          let [maxCount (fold (fn [m p]\n            match p\n              ((pair k v) (if (> v m) v m))) 0 pairs)]\n            if (= maxCount 0)\n              (mapEmpty)\n              (fold (fn [acc p]\n                match p\n                  ((pair k v) (if (= v maxCount) (mapSet acc k v) acc))) (mapEmpty) pairs)\n```" "```asl\nfn histogram text: String -> (Map String Int64)\n  let [words (stringSplit text \" \")]\n    let [letters (filter (fn [w] (not (= w \"\"))) words)]\n      let [counts (fold (fn [acc w]\n        match (mapGet acc w)\n          ((some n) (mapSet acc w (+ n 1)))\n          ((none) (mapSet acc w 1))) (mapEmpty) letters)]\n        let [pairs (mapPairs counts)]\n          let [maxCount (fold (fn [m p]\n            match p\n              ((pair k v) (if (> v m) v m))) 0 pairs)]\n            if (= maxCount 0)\n              (mapEmpty)\n              (fold (fn [acc p]\n                match p\n                  ((pair k v) (if (= v maxCount) (mapSet acc k v) acc))) (mapEmpty) pairs)\n```"))
