d\n\nfn splitWords text: String start: Int64 end: Int64 acc: (List String) -> (List String)\n  if (>= start end)\n    acc\n    if (= (stringCharAt text start) \" \")\n      splitWords text (+ start 1) end acc\n      let [next (findSpace text start end)]\n        splitWords text next end (listAppend acc (stringSlice text start next))\n\nfn reverseList xs: (List String) acc: (List String) -> (List String)\n  if (listLength xs)\n    reverseList (listTail xs) (listPrepend acc (listHead xs))\n    acc\n\nfn joinWords xs: (List String) acc: String first: Bool -> String\n  if (listLength xs)\n    if first\n      joinWords (listTail xs) (listHead xs) false\n      joinWords (listTail xs) (stringConcat acc (stringConcat \" \" (listHead xs))) false\n    acc\n\nfn reverseWords text: String -> String\n  joinWords (reverseList (splitWords text 0 (stringLength text) (list)) (list)) \"\" true\n```" "```asl\nfn findSpace text: String start: Int64 end: Int64 -> Int64\n  if (>= start end)\n    end\n    if (= (stringCharAt text start) \" \")\n      start\n      findSpace text (+ start 1) end\n\nfn splitWords text: String start: Int64 end: Int64 acc: (List String) -> (List String)\n  if (>= start end)\n    acc\n    if (= (stringCharAt text start) \" \")\n      splitWords text (+ start 1) end acc\n      let [next (findSpace text start end)]\n        splitWords text next end (listAppend acc (stringSlice text start next))\n\nfn reverseList xs: (List String) acc: (List String) -> (List String)\n  if (> (listLength xs) 0)\n    reverseList (listTail xs) (listAppend acc (listHead xs))\n    acc\n\nfn joinWords xs: (List String) acc: String first: Bool -> String\n  if (> (listLength xs) 0)\n    if first\n      joinWords (listTail xs) (listHead xs) false\n      joinWords (listTail xs) (stringConcat acc (stringConcat \" \" (listHead xs))) false\n    acc\n\nfn reverseWords text: String -> String\n  joinWords (reverseList (splitWords text 0 (stringLength text) (list)) (list)) \"\" true\n```"))
