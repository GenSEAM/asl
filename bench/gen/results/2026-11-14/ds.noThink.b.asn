gram text: String -> (Map String Int64)\n  let [words (stringSplit text \" \")]\n    let [letters (filter (fn [w] (not (= w \"\"))) words)]\n      let [counts (fold (fn [acc w] (mapSet acc w (+ (optionOr (mapGet acc w) 0) 1))) (mapEmpty) letters)]\n        let [maxCount (fold (fn [m v] (if (> v m) v m)) 0 (mapValues counts))]\n          (cond\n            ((= maxCount 0) (mapEmpty))\n            (else (mapFilter counts (fn [k v] (= v maxCount)))))\n```"))
