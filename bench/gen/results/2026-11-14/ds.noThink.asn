st (Pair String Int64))\n  (match rest\n    ((nil) (list (pair c count)))\n    ((cons d tail)\n      (if (= c d)\n        (encodeRun c (+ count 1) tail)\n        (cons (pair c count) (encodeRun d 1 tail)))))\n```" "```asl\nfn runLengthEncode text: String -> (List (Pair String Int64))\n  (let [(cs (chars text))]\n    (encodeChars cs))\n\nfn encodeChars cs: (List String) -> (List (Pair String Int64))\n  (match cs\n    ((cons c rest) (encodeRun c 1 rest))\n    ((else) (list)))\n\nfn encodeRun c: String count: Int64 rest: (List String) -> (List (Pair String Int64))\n  (match rest\n    ((cons d tail)\n      (if (= c d)\n        (encodeRun c (+ count 1) tail)\n        (cons (pair c count) (encodeRun d 1 tail))))\n    ((else) (list (pair c count))))\n```"))
