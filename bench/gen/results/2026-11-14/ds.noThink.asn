))))]\n        (go 0 (list)))))\n```" "```asl\nfn runLengthEncode text: String -> (List (Pair String Int64))\n  (let [(n (stringLength text))]\n    (let [(cs (chars text))]\n      (encodeGo cs n 0 (list))))\n\nfn encodeGo cs: (List String) n: Int64 i: Int64 acc: (List (Pair String Int64)) -> (List (Pair String Int64))\n  (if (>= i n)\n    (listReverse acc)\n    (let [(c (optionOr (listGet cs i) \"\"))]\n      (let [(end (runEnd cs n c i))]\n        (encodeGo cs n end (cons (pair c (- end i)) acc))))))\n\nfn runEnd cs: (List String) n: Int64 c: String j: Int64 -> Int64\n  (if (and (< j n) (= (optionOr (listGet cs j) \"\") c))\n    (runEnd cs n c (+ j 1))\n    j))\n```" "```asl\nfn runLengthEncode text: String -> (List (Pair String Int64))\n  (let [(n (stringLength text))]\n    (let [(cs (chars text))]\n      (encodeGo cs n 0 (list))))\n\nfn encodeGo cs: (List String) n: Int64 i: Int64 acc: (List (Pair String Int64)) -> (List (Pair String Int64))\n  (if (>= i n)\n    (listReverse acc)\n    (let [(c (optionOr (listGet cs i) \"\"))]\n      (let [(end (runEnd cs n c i))]\n        (encodeGo cs n end (cons (pair c (- end i)) acc))))))\n\nfn runEnd cs: (List String) n: Int64 c: String j: Int64 -> Int64\n  (if (and (< j n) (= (optionOr (listGet cs j) \"\") c))\n    (runEnd cs n c (+ j 1))\n    j))\n```"))
