pair cur count)\n          (cond\n            ((stringEmpty? cur) out)\n            (else (listConcat out [(pair cur count)]))))))))\n```" "```asl\nfn rleStep acc: (Pair (List (Pair String Int64)) (Pair String Int64)) c: String -> (Pair (List (Pair String Int64)) (Pair String Int64))\n  (match acc\n    ((pair out rest)\n      (match rest\n        ((pair cur count)\n          (cond\n            ((stringEmpty? cur) (pair out (pair c 1)))\n            ((stringContains? cur c) (pair out (pair cur (+ count 1))))\n            (else (pair (listConcat out [(pair cur count)]) (pair c 1))))))))\n\nfn runLengthEncode text: String -> (List (Pair String Int64))\n  (match (fold rleStep (pair [] (pair \"\" 0)) (stringChars text))\n    ((pair out rest)\n      (match rest\n        ((pair cur count)\n          (cond\n            ((stringEmpty? cur) out)\n            (else (listConcat out [(pair cur count)])))))))\n```" "```asl\nfn rleStep acc: (Pair (List (Pair String Int64)) (Pair String Int64)) c: String -> (Pair (List (Pair String Int64)) (Pair String Int64))\n  (match acc\n    ((pair out rest)\n      (match rest\n        ((pair cur count)\n          (cond\n            ((stringEmpty? cur) (pair out (pair c 1)))\n            ((stringContains? cur c) (pair out (pair cur (+ count 1))))\n            (else (pair (listAppend out [(pair cur count)]) (pair c 1))))))))\n\nfn runLengthEncode text: String -> (List (Pair String Int64))\n  (match (fold rleStep (pair [] (pair \"\" 0)) (stringChars text))\n    ((pair out rest)\n      (match rest\n        ((pair cur count)\n          (cond\n            ((stringEmpty? cur) out)\n            (else (listAppend out [(pair cur count)]))))))))\n```"))
