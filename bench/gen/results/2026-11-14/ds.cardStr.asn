own)))))\n```" "" "```asl\nenum Token (number value: Int64) (word text: String) (symbol text: String) (unknown)\n\nfn digitChar c: String -> Bool\n  (let [(n (charCode c))]\n    (and (>= n 48) (<= n 57)))\n\nfn letterChar c: String -> Bool\n  (let [(n (charCode c))]\n    (or (and (>= n 65) (<= n 90))\n        (and (>= n 97) (<= n 122))))\n\nfn spaceChar c: String -> Bool\n  (= (charCode c) 32)\n\nfn allDigits text: String i: Int64 n: Int64 -> Bool\n  (cond\n    ((>= i n) true)\n    (else\n      (match (listGet (stringChars text) i)\n        ((some c) (and (digitChar c) (allDigits text (+ i 1) n)))\n        ((none) false))))\n\nfn allLetters text: String i: Int64 n: Int64 -> Bool\n  (cond\n    ((>= i n) true)\n    (else\n      (match (listGet (stringChars text) i)\n        ((some c) (and (letterChar c) (allLetters text (+ i 1) n)))\n        ((none) false))))\n\nfn symbolChar text: String -> Bool\n  (match (listGet (stringChars text) 0)\n    ((some c) (and (not (letterChar c)) (and (not (digitChar c)) (not (spaceChar c)))))\n    ((none) false))\n\nfn classifyToken text: String -> Token\n  (let [(n (stringLength text))]\n    (cond\n      ((and (> n 0) (and (<= n 15) (allDigits text 0 n)))\n        (match (stringToInt64 text)\n          ((some v) (number v))\n          ((none) (unknown))))\n      ((and (> n 0) (allLetters text 0 n))\n        (word text))\n      ((and (= n 1) (symbolChar text))\n        (symbol text))\n      (else (unknown))))\n```"))
