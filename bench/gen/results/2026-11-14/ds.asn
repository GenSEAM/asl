text i (+ i 1))\n    ((some c) (parseDigits text (+ i 1) (+ (* acc 10) (digitValue c))))\n    ((none) acc))\n\nfn isSymbol text: String -> Bool\n  (match (stringSlice text 0 1)\n    ((some c)\n      (match (stringSlice text 1 2)\n        ((some d) false)\n        ((none) (and (not (isLetterChar c)) (and (not (isDigitChar c)) (not (= c \" \")))))))\n    ((none) false))\n\nfn classifyNonEmpty text: String -> Token\n  (cond\n    ((allDigits text) (number (parseDigits text 0 0)))\n    ((allLetters text) (word text))\n    ((isSymbol text) (symbol text))\n    (else (unknown)))\n\nfn classifyToken text: String -> Token\n  (match (stringSlice text 0 1)\n    ((none) (unknown))\n    ((some c) (classifyNonEmpty text)))\n```"))
