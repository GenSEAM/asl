(:trial :key "py|powMod|synDs41Flash|1" :arm "py" :task "powMod" :family "A" :model "synDs41Flash" :served "deepseek-ai/DeepSeek-V4.1-Flash-1017" :rep 1 :rawPass true :healedPass true :solved true :calls 1 :repairTurns 0 :firstFail "ok" :stages ("ok") :tokIn (245) :tokOut (472) :tokInSum 245 :tokOutSum 472 :tokToGreen 717 :sysTok 17 :costPico 319950000 :wallMs 3965 :headerStripped false :promptSha "63af1a036cdbf80311f6ce906b5b03c0df42d4db0416ce68e2e7cc1e14af40b3" :replies ("```python\ndef pow_mod(base: int, exponent: int, modulus: int) -> int:\n    result = 1 % modulus\n    base %= modulus\n\n    while exponent > 0:\n        if exponent & 1:\n            result = (result * base) % modulus\n        base = (base * base) % modulus\n        exponent >>= 1\n\n    return result\n```"))
