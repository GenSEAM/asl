(:trial :key "aslParen|histogram|synDs41Flash|1" :arm "aslParen" :task "histogram" :family "B" :model "synDs41Flash" :served "truncatedAtMaxTokens" :rep 1 :rawPass false :healedPass false :solved false :calls 4 :repairTurns 3 :firstFail "extract" :stages ("extract" "check" "extract" "extract") :tokIn (1 1159 1 1) :tokOut (8000 6881 8000 8000) :tokInSum 1162 :tokOutSum 30881 :tokToGreen 0 :sysTok 810 :costPico 18702900000 :wallMs 215144 :headerStripped false :promptSha "c9a1c781333bc7c13ea11af9d663464d2d40fead01a96025f814c09b05b57516" :replies ("" "```asl\nfn countWords words: (List String) counts: (Map String Int64) -> (Map String Int64)\n  match (listHead words)\n    ((some w)\n      (cond\n        ((> (stringLength w) 0)\n          (let ((c (optionOr (mapGet counts w) 0)))\n            (countWords (optionOr (listTail words) (list)) (mapSet counts w (+ c 1)))))\n        (else\n          (countWords (optionOr (listTail words) (list)) counts))))\n    ((none) counts)\n\nfn maxCount keys: (List String) counts: (Map String Int64) current: Int64 -> Int64\n  match (listHead keys)\n    ((some k)\n      (let ((v (optionOr (mapGet counts k) 0)))\n        (maxCount (optionOr (listTail keys) (list)) counts\n          (cond ((> v current) v) (else current)))))\n    ((none) current)\n\nfn keepMax keys: (List String) counts: (Map String Int64) max: Int64 result: (Map String Int64) -> (Map String Int64)\n  match (listHead keys)\n    ((some k)\n      (let ((v (optionOr (mapGet counts k) 0)))\n        (keepMax (optionOr (listTail keys) (list)) counts max\n          (cond ((= v max) (mapSet result k v)) (else result)))))\n    ((none) result)\n\nfn histogram text: String -> (Map String Int64)\n  (let ((words (stringSplit text \" \")))\n    (let ((counts (countWords words (mapFromPairs (list)))))\n      (let ((keys (mapKeys counts)))\n        (let ((m (maxCount keys counts 0)))\n          (keepMax keys counts m (mapFromPairs (list)))))))\n```" "" ""))
(:trial :key "aslParen|histogram|synDs41Flash|2" :arm "aslParen" :task "histogram" :family "B" :model "synDs41Flash" :served "truncatedAtMaxTokens" :rep 2 :rawPass false :healedPass true :solved false :calls 4 :repairTurns 3 :firstFail "parse" :stages ("parse" "extract" "extract" "extract") :tokIn (1115 1 1 1) :tokOut (7834 8000 8000 8000) :tokInSum 1118 :tokOutSum 31834 :tokToGreen 0 :sysTok 810 :costPico 19268100000 :wallMs 220816 :headerStripped false :promptSha "c9a1c781333bc7c13ea11af9d663464d2d40fead01a96025f814c09b05b57516" :replies ("```asl\nfn countTokens tokens: (List String) counts: (Map String Int64) -> (Map String Int64)\n  (cond\n    ((= (listLength tokens) 0) counts)\n    (else\n      (match (listHead tokens)\n        ((some tok)\n          (match (listTail tokens)\n            ((some rest)\n              (cond\n                ((= tok \"\") (countTokens rest counts))\n                (else\n                  (match (mapGet counts tok)\n                    ((some c) (countTokens rest (mapSet counts tok (+ c 1))))\n                    ((none) (countTokens rest (mapSet counts tok 1)))))))\n            ((none) counts)))\n        ((none) counts))))\n\nfn maxCount keys: (List String) counts: (Map String Int64) best: Int64 -> Int64\n  (cond\n    ((= (listLength keys) 0) best)\n    (else\n      (match (listHead keys)\n        ((some k)\n          (match (listTail keys)\n            ((some rest)\n              (match (mapGet counts k)\n                ((some c) (maxCount rest counts (cond ((> c best) c) (else best))))\n                ((none) (maxCount rest counts best))))\n            ((none) best)))\n        ((none) best))))\n\nfn keepMax keys: (List String) counts: (Map String Int64) best: Int64 out: (Map String Int64) -> (Map String Int64)\n  (cond\n    ((= (listLength keys) 0) out)\n    (else\n      (match (listHead keys)\n        ((some k)\n          (match (listTail keys)\n            ((some rest)\n              (match (mapGet counts k)\n                ((some c)\n                  (keepMax rest counts best\n                    (cond ((= c best) (mapSet out k c)) (else out))))\n                ((none) (keepMax rest counts best out))))\n            ((none) out)))\n        ((none) out))))\n\nfn histogram text: String -> (Map String Int64)\n  (let ((counts (countTokens (stringSplit text \" \") (mapFromPairs (list)))))\n    (let ((best (maxCount (mapKeys counts) counts 0)))\n      (keepMax (mapKeys counts) counts best (mapFromPairs (list))))))\n```" "" "" ""))
