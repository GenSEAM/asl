Count (optionOr (listTail ks) (list)) m (if (> v best) v best))))\n    ((none) best)))\n\n(fn histogram [text: String] -> (Map String Int64)\n  (let [(words (filter (fn [w] (not (== w \"\"))) (stringSplit text \" \")))\n        (counts (countWords words (mapFromPairs (list))))\n        (ks (mapKeys counts))\n        (mx (maxCount ks counts 0))]\n    (mapFromPairs (map (fn [k] (pair k (optionOr (mapGet counts k) 0)))\n                       (filter (fn [k] (== (optionOr (mapGet counts k) 0) mx)) ks)))))\n```"))
