n                    ((none) (err \"stack underflow\")))\n                ((none) (err \"stack underflow\")))\n            ((none) (err \"stack underflow\")))\n        ((dup)\n          match (listHead stack)\n            ((some a)\n              (run (optionOr (listTail program) (list)) (pushVal a stack)))\n            ((none) (err \"stack underflow\")))\n        ((swap)\n          match (listHead stack)\n            ((some a)\n              match (listTail stack)\n                ((some rest1)\n                  match (listHead rest1)\n                    ((some b)\n                      match (listTail rest1)\n                        ((some rest2)\n                          (run (optionOr (listTail program) (list)) (pushVal b (pushVal a rest2))))\n                        ((none) (err \"stack underflow\")))\n                    ((none) (err \"stack underflow\")))\n                ((none) (err \"stack underflow\")))\n            ((none) (err \"stack underflow\")))))\n    ((none)\n      match (listHead stack)\n        ((some v) (ok v))\n        ((none) (err \"empty stack\"))))\n\nfn stackMachine program: (List Instr) -> (Result Int64 String)\n  (run program (list))\n```" "" "" ""))
