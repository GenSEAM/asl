LengthEncode [text: String] -> (List (Pair String Int64))\n  (let [(n (stringLength text))]\n    (cond\n      ((= n 0) (list))\n      (else (rleFrom text (- n 1) \"\" 0 (list))))))\n```" "```\n(fn rleFrom [text: String i: Int64 current: String runLen: Int64 acc: (List (Pair String Int64))] -> (List (Pair String Int64))\n  (cond\n    ((< i 0)\n      (cond\n        ((= current \"\") acc)\n        (else (listAppend (list (pair current runLen)) acc))))\n    (else\n      (match (stringSlice text i (+ i 1))\n        ((some c)\n          (cond\n            ((= current \"\") (rleFrom text (- i 1) c 1 acc))\n            ((= c current) (rleFrom text (- i 1) current (+ runLen 1) acc))\n            (else (rleFrom text (- i 1) c 1 (listAppend (list (pair current runLen)) acc)))))\n        ((none) acc)))))\n\n(fn runLengthEncode [text: String] -> (List (Pair String Int64))\n  (let [(n (stringLength text))]\n    (cond\n      ((= n 0) (list))\n      (else (rleFrom text (- n 1) \"\" 0 (list))))))\n```"))
