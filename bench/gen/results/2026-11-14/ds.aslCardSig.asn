t: String -> Bool\n  (and (> (stringLength text) 0)\n       (allIn \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\" text))\n\nfn isSymbol text: String -> Bool\n  (and (= (stringLength text) 1)\n       (and (not (stringContains? \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\" text))\n            (and (not (stringContains? \"0123456789\" text))\n                 (not (stringContains? \" \" text)))))\n\nfn classifyToken text: String -> Token\n  (cond\n    ((isDigits text)\n     (match (stringToInt64 text)\n       ((some v) (number v))\n       ((none) (unknown))))\n    ((isLetters text) (word text))\n    ((isSymbol text) (symbol text))\n    (else (unknown)))\n```"))
