(module aslBench/gen/tests/genRunnerTest
  :x [runTests]
  :i [(aslBench/gen/core :a gc)
      (aslBench/gen/score :a sc)])

; (:m :ref FABLE-LANG-01 :do "dry run of the bench end to end on three tasks and two arms with a fake model: a raw pass, a pass only after heal, a pass after one repair turn and an exhausted trial each land in their row, the budget stop fires before the first call, and the scorer refuses a comparison on missing trials")

fn rowFor rows: (List sc/Row) key: String -> sc/Row
  (optionOr (listFind (fn [(r sc/Row)] -> Bool (= r.key key)) rows)
            (sc/Row :key "" :arm "" :task "" :model "" :rep 0 :rawPass false :healedPass false :solved false :calls 0 :tokens 0 :sysTok 0 :firstFail ""))

fn statFor stats: (List sc/ArmStat) arm: String -> sc/ArmStat
  (optionOr (sc/statOf stats "fake" arm)
            (sc/ArmStat :model "" :arm "" :trials 0 :expected 0 :missing 0 :rawPass 0 :healedPass 0 :solved 0 :tokens 0 :tokensNoCard 0 :repairTurns 0 :greens (list) :stages (list)))

fn rowsOf text: String -> (List sc/Row)
  (match (gc/readForms text)
    ((err _) (list))
    ((ok forms) (map (fn [(f gc/Sx)] -> sc/Row (sc/rowOf (gc/sxItems f))) (filter (fn [(f gc/Sx)] -> Bool (= (gc/headOf f) ":trial")) forms))))

fn ! testPure -> Bool
  (let [(value (match (gc/readSx "(list (variant setEmail (email \"a\\\"b\")) (record Item (unitPrice -3)) (tag Light red) (none) (dict (\"k\" (tuple 1 true))))" 0)
                 ((ok p) (pairFirst p))
                 ((err _) (gc/sxAtom "unread"))))
        (wrapped (gc/toWrapFn "enum Light (red) (green)\n\nfn gcd a: Int64 b: Int64 -> Int64\n  (if (= b 0) a (gcd b (mod a b)))\n"))
        (lambdaCode "fn f xs: (List Int64) -> Int64\n  (let [(ys (map (fn [x] (* x 2)) xs))] (listSum ys))\n")]
    (assert (= (gc/renderPy value) "[SetEmail(email=\"a\\\"b\"), Item(unit_price=-3), Light.RED, None, {\"k\": (1, True)}]") "python rendering of a neutral value")
    (assert (= (gc/renderTs value) "[{ kind: \"setEmail\", email: \"a\\\"b\" }, { unitPrice: -3 }, \"red\", undefined, new Map([[\"k\", [1, true]]])]") "typescript rendering of a neutral value")
    (assert (= (gc/renderAsl value) "(list (setEmail \"a\\\"b\") (Item :unitPrice -3) (red) (none) (mapFromPairs (list (pair \"k\" (pair 1 true)))))") "asl rendering of a neutral value")
    (assert (= (gc/extractCode "text\n```python\ndef f():\n    return 1\n```\nmore") (some "def f():\n    return 1\n")) "the first fenced block is extracted")
    (assert (= (gc/extractCode "no code here") (none)) "a reply without a fence yields no code")
    (assert (stringContains? wrapped "(fn gcd [a: Int64 b: Int64] -> Int64\n  (if (= b 0) a (gcd b (mod a b))))") "the wrapped spelling closes the form after the body")
    (assert (= (gc/fromWrapFn wrapped) "enum Light (red) (green)\n\nfn gcd a: Int64 b: Int64 -> Int64\n  (if (= b 0) a (gcd b (mod a b)))\n") "the wrapped spelling normalises back to the bare header")
    (assert (not (stringContains? (gc/bracketToParen lambdaCode) "[")) "the paren spelling holds no square bracket")
    (assert (= (gc/parenToBracket (gc/bracketToParen lambdaCode)) lambdaCode) "the paren spelling normalises back to brackets")
    (assert (= (gc/stripModuleHeader "(module cand :x [f])\n\nfn f -> Int64\n  1\n") (pair "fn f -> Int64\n  1\n" true)) "a leading module header is stripped and reported")
    (assert (= (gc/usdToMicro "0.15") (some 150000)) "a decimal price parses to micro dollars")
    (assert (= (gc/usdToMicro "abc") (none)) "a malformed price is rejected")
    (assert (= (gc/dateOf 1794528000000000000) "2026-11-13") "epoch nanoseconds map to the civil date")
    (assert (= (sc/wilson 10 10) (pair 722 1000)) "the Wilson interval of 10 out of 10")
    (assert (= (sc/pctText (sc/permille 2 3)) "66.7") "a rate prints with one decimal")
    true)

fn ! testDryRun root: String -> Bool
  (let [(work (resultOr (realPath (let [(d (str (optionOr (envGet "TMPDIR") "/tmp") "/aslBenchGenTest-" (stringFromInt64 (nowNs))))
                                        (made (dirCreate d))]
                                    d))
                        ""))
        (tasks (filter (fn [(t gc/Task)] -> Bool (listContains? (list "gcd" "maxOf" "inventoryTotal") t.id)) (resultOr (gc/loadTasks root) (list))))
        (cards (resultOr (gc/loadCards root) (list)))
        (arms (list "py" "asl"))
        (models (list "fake"))
        (plan (list (pair "py|gcd" "good=def gcd(a: int, b: int) -> int:\n    while b != 0:\n        a, b = b, a % b\n    return a\n")
                    (pair "py|maxOf" "good=def max_of(xs: list[int]) -> int | None:\n    return max(xs) if xs else None\n")
                    (pair "py|inventoryTotal" "fixed=from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Item:\n    name: str\n    qty: int\n    unit_price: int\n\ndef inventory_total(items: list[Item]) -> int:\n    return sum(it.qty * it.unit_price for it in items)\n")
                    (pair "asl|gcd" "heal") (pair "asl|maxOf" "fixed") (pair "asl|inventoryTotal" "never")))
        (cfg (gc/Config :root root :aslBin (str root "/bin/asl") :work work :out (str work "/trials.asn") :repairs 1 :maxTokens 1200
                        :priceIn 150000 :priceOut 600000 :capPico 1000000000000 :checkFirst true))
        (trials (gc/planTrials models arms tasks 1 7))
        (header (gc/headerRow "test" models arms tasks 1 7 cfg cards (list) "2026-11-13" "genRunnerTest"))
        (wroteHeader (fileWrite cfg.out (str header "\n")))
        (ran (pairSecond (gc/runAll! cfg cards trials "" 0 (gc/fakeCaller root plan) 0)))
        (text (resultOr (fileReadString cfg.out) ""))
        (rows (rowsOf text))
        (scored (sc/scoreText text))
        (py (statFor scored.stats "py"))
        (asl (statFor scored.stats "asl"))
        (tight (with cfg :out (str work "/budget.asn") :capPico 1000))
        (wroteTight (fileWrite tight.out (str header "\n")))
        (stopped (pairSecond (gc/runAll! tight cards trials "" 0 (gc/fakeCaller root plan) 0)))
        (tightText (resultOr (fileReadString tight.out) ""))
        (refused (sc/scoreText tightText))
        (cleaned (gc/removeDir! work))]
    (assert (and (= (listLength tasks) 3) (= (listLength cards) 5)) "three tasks and five cards load")
    (assert (= (listLength trials) 6) "two arms times three tasks plan six trials")
    (assert (and (= ran.done 6) (stringEmpty? ran.stopped)) "the dry run finishes every trial")
    (assert (> ran.spent 0) "fake usage is priced into the spend")
    (assert (= (listLength rows) 6) "one row per trial is written")
    (assert (and (rowFor rows "py|gcd|fake|1").rawPass (= (rowFor rows "py|gcd|fake|1").calls 1)) "a correct first reply is a raw pass in one call")
    (assert (and (rowFor rows "py|maxOf|fake|1").rawPass (rowFor rows "py|maxOf|fake|1").solved) "the second correct reply is a raw pass too")
    (assert (and (not (rowFor rows "py|inventoryTotal|fake|1").rawPass) (rowFor rows "py|inventoryTotal|fake|1").solved) "a wrong then fixed python reply is solved without a raw pass")
    (assert (= (rowFor rows "py|inventoryTotal|fake|1").firstFail "correct") "a wrong python answer fails at the correct stage")
    (assert (and (not (rowFor rows "asl|gcd|fake|1").rawPass) (rowFor rows "asl|gcd|fake|1").healedPass) "a body at column 0 fails raw and passes after heal")
    (assert (and (not (rowFor rows "asl|maxOf|fake|1").healedPass) (and (rowFor rows "asl|maxOf|fake|1").solved (= (rowFor rows "asl|maxOf|fake|1").calls 2))) "an unknown symbol is not healed and is solved by the repair turn")
    (assert (= (rowFor rows "asl|maxOf|fake|1").firstFail "check") "an unknown symbol fails at the check stage")
    (assert (and (not (rowFor rows "asl|inventoryTotal|fake|1").solved) (= (rowFor rows "asl|inventoryTotal|fake|1").calls 2)) "a never fixed reply is exhausted after the repair turn")
    (assert scored.complete "the scorer sees every planned trial")
    (assert (and (= py.rawPass 2) (and (= py.healedPass 2) (= py.solved 3))) "python arm counts: 2 raw, 3 solved")
    (assert (and (= asl.rawPass 0) (and (= asl.healedPass 1) (= asl.solved 2))) "asl arm counts: 0 raw, 1 healed, 2 solved")
    (assert (and (= asl.trials 3) (= asl.missing 0)) "asl arm holds its three trials")
    (assert (> asl.tokens asl.tokensNoCard) "the card is counted in the asl token total")
    (assert (listAny? (fn [(l String)] -> Bool (stringStartsWith? l "(:compare :h \"H1\"")) scored.lines) "a complete table prints the H1 comparison")
    (assert (and (= stopped.stopped "budget") (= stopped.done 0)) "a cap below one call stops the run before the first call")
    (assert (stringContains? tightText "(:stopped :reason \"budget\"") "the budget stop is recorded as a row")
    (assert (not refused.complete) "a stopped run is incomplete")
    (assert (and (listAny? (fn [(l String)] -> Bool (stringStartsWith? l "(:score :status :refused")) refused.lines)
                 (not (listAny? (fn [(l String)] -> Bool (stringStartsWith? l "(:compare")) refused.lines)))
            "missing trials print a refusal and no comparison")
    (assert cleaned "the work directory is removed")
    true)

fn ! runTests -> Bool
  (let [(given (optionOr (envGet "ASL_CLI_ROOT") "."))
        (root (resultOr (realPath given) given))]
    (and (testPure) (testDryRun root)))
