(:item :task "indexOf" :lang "ts" :calls ("indexOf([], 1)" "indexOf([4, 4, 4], 4)") :wants ("undefined" "0") :bug "" :line 0 :program "function indexOf(xs: number[], target: number): number | undefined {\n  const i = xs.indexOf(target);\n  return i < 0 ? undefined : i;\n}" :mutant "")
(:item :task "inventoryTotal" :lang "asl" :calls ("(inventoryTotal (list (Item :name \"pen\" :qty 2 :unitPrice 150) (Item :name \"book\" :qty 1 :unitPrice 1200)))" "(inventoryTotal (list (Item :name \"ghost\" :qty 0 :unitPrice 999)))") :wants ("1500" "0") :bug "times" :line 4 :program "schema Item { name: String qty: Int64 unitPrice: Int64 }\n\nfn inventoryTotal items: (List Item) -> Int64\n  (listSum (map (fn [it] (* it.qty it.unitPrice)) items))" :mutant "schema Item { name: String qty: Int64 unitPrice: Int64 }\n\nfn inventoryTotal items: (List Item) -> Int64\n  (listSum (map (fn [it] (+ it.qty it.unitPrice)) items))")
(:item :task "inventoryTotal" :lang "py" :calls ("inventory_total([Item(name=\"pen\", qty=2, unit_price=150), Item(name=\"book\", qty=1, unit_price=1200)])" "inventory_total([Item(name=\"ghost\", qty=0, unit_price=999)])") :wants ("1500" "0") :bug "times" :line 10 :program "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Item:\n    name: str\n    qty: int\n    unit_price: int\n\ndef inventory_total(items: list[Item]) -> int:\n    return sum(it.qty * it.unit_price for it in items)" :mutant "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Item:\n    name: str\n    qty: int\n    unit_price: int\n\ndef inventory_total(items: list[Item]) -> int:\n    return sum(it.qty + it.unit_price for it in items)")
(:item :task "inventoryTotal" :lang "ts" :calls ("inventoryTotal([{ name: \"pen\", qty: 2, unitPrice: 150 }, { name: \"book\", qty: 1, unitPrice: 1200 }])" "inventoryTotal([{ name: \"ghost\", qty: 0, unitPrice: 999 }])") :wants ("1500" "0") :bug "times" :line 4 :program "type Item = { name: string; qty: number; unitPrice: number };\n\nfunction inventoryTotal(items: Item[]): number {\n  return items.reduce((total, it) => total + it.qty * it.unitPrice, 0);\n}" :mutant "type Item = { name: string; qty: number; unitPrice: number };\n\nfunction inventoryTotal(items: Item[]): number {\n  return items.reduce((total, it) => total + it.qty + it.unitPrice, 0);\n}")
(:item :task "isPrime" :lang "asl" :calls ("(isPrime 1)" "(isPrime 2)") :wants ("false" "true") :bug "lt" :line 8 :program "fn hasDivisorFrom n: Int64 d: Int64 -> Bool\n  (cond\n    ((> (* d d) n) false)\n    ((= (mod n d) 0) true)\n    (else (hasDivisorFrom n (+ d 1))))\n\nfn isPrime n: Int64 -> Bool\n  (if (< n 2) false (not (hasDivisorFrom n 2)))" :mutant "fn hasDivisorFrom n: Int64 d: Int64 -> Bool\n  (cond\n    ((> (* d d) n) false)\n    ((= (mod n d) 0) true)\n    (else (hasDivisorFrom n (+ d 1))))\n\nfn isPrime n: Int64 -> Bool\n  (if (<= n 2) false (not (hasDivisorFrom n 2)))")
(:item :task "isPrime" :lang "py" :calls ("is_prime(1)" "is_prime(2)") :wants ("False" "True") :bug "lt" :line 2 :program "def is_prime(n: int) -> bool:\n    if n < 2:\n        return False\n    d = 2\n    while d * d <= n:\n        if n % d == 0:\n            return False\n        d += 1\n    return True" :mutant "def is_prime(n: int) -> bool:\n    if n <= 2:\n        return False\n    d = 2\n    while d * d <= n:\n        if n % d == 0:\n            return False\n        d += 1\n    return True")
(:item :task "isPrime" :lang "ts" :calls ("isPrime(1)" "isPrime(2)") :wants ("false" "true") :bug "lt" :line 2 :program "function isPrime(n: number): boolean {\n  if (n < 2) return false;\n  for (let d = 2; d * d <= n; d++) {\n    if (n % d === 0) return false;\n  }\n  return true;\n}" :mutant "function isPrime(n: number): boolean {\n  if (n <= 2) return false;\n  for (let d = 2; d * d <= n; d++) {\n    if (n % d === 0) return false;\n  }\n  return true;\n}")
(:item :task "lookupChain" :lang "asl" :calls ("(lookupChain (mapEmpty) \"a\")" "(lookupChain (mapFromPairs (list (pair \"a\" \"b\"))) \"a\")") :wants ("(none)" "(some \"b\")") :bug "" :line 0 :program "fn follow table: (Map String String) name: String -> String\n  (match (mapGet table name)\n    ((none) name)\n    ((some next) (follow table next)))\n\nfn lookupChain table: (Map String String) start: String -> (Option String)\n  (optionMap (fn [next] (follow table next)) (mapGet table start))" :mutant "")
(:item :task "lookupChain" :lang "py" :calls ("lookup_chain({}, \"a\")" "lookup_chain({\"a\": \"b\"}, \"a\")") :wants ("None" "\"b\"") :bug "" :line 0 :program "def lookup_chain(table: dict[str, str], start: str) -> str | None:\n    if start not in table:\n        return None\n    current = table[start]\n    while current in table:\n        current = table[current]\n    return current" :mutant "")
(:item :task "lookupChain" :lang "ts" :calls ("lookupChain(new Map(), \"a\")" "lookupChain(new Map([[\"a\", \"b\"]]), \"a\")") :wants ("undefined" "\"b\"") :bug "" :line 0 :program "function lookupChain(table: Map<string, string>, start: string): string | undefined {\n  let current = table.get(start);\n  if (current === undefined) return undefined;\n  for (;;) {\n    const next = table.get(current);\n    if (next === undefined) return current;\n    current = next;\n  }\n}" :mutant "")
