(:item :task "maxOf" :lang "ts" :calls ("maxOf([-5, -2, -9])" "maxOf([7])") :wants ("-2" "7") :bug "" :line 0 :program "function maxOf(xs: number[]): number | undefined {\n  return xs.length === 0 ? undefined : Math.max(...xs);\n}" :mutant "")
(:item :task "mergeSorted" :lang "asl" :calls ("(mergeSorted (list) (list))" "(mergeSorted (list 1 1) (list 1))") :wants ("(list)" "(list 1 1 1)") :bug "" :line 0 :program "fn mergeSorted a: (List Int64) b: (List Int64) -> (List Int64)\n  (listSort (listAppend a b))" :mutant "")
(:item :task "mergeSorted" :lang "py" :calls ("merge_sorted([], [])" "merge_sorted([1, 1], [1])") :wants ("[]" "[1, 1, 1]") :bug "" :line 0 :program "def merge_sorted(a: list[int], b: list[int]) -> list[int]:\n    return sorted(a + b)" :mutant "")
(:item :task "mergeSorted" :lang "ts" :calls ("mergeSorted([], [])" "mergeSorted([1, 1], [1])") :wants ("[]" "[1, 1, 1]") :bug "" :line 0 :program "function mergeSorted(a: number[], b: number[]): number[] {\n  return [...a, ...b].sort((x, y) => x - y);\n}" :mutant "")
(:item :task "parseCommand" :lang "asl" :calls ("(parseCommand \"pick lamp\")" "(parseCommand \"look\")") :wants ("(ok (pick \"lamp\"))" "(ok (look))") :bug "" :line 0 :program "enum Command (go direction: String) (pick item: String) (look) (quit)\n\nfn parseCommand line: String -> (Result Command String)\n  (let [(words (stringSplit line \" \"))\n        (verb (optionOr (listHead words) \"\"))\n        (arg (optionOr (listGet words 1) \"\"))\n        (two (and (= (listLength words) 2) (not (stringEmpty? arg))))]\n    (cond\n      ((= line \"look\") (ok (look)))\n      ((= line \"quit\") (ok (quit)))\n      ((and two (and (= verb \"go\") (listContains? (list \"north\" \"south\" \"east\" \"west\") arg))) (ok (go arg)))\n      ((and two (= verb \"pick\")) (ok (pick arg)))\n      (else (err (str \"unknown command: \" line)))))" :mutant "")
(:item :task "parseCommand" :lang "py" :calls ("parse_command(\"pick lamp\")" "parse_command(\"look\")") :wants ("Pick(item=\"lamp\")" "Look()") :bug "" :line 0 :program "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Go:\n    direction: str\n\n@dataclass(frozen=True)\nclass Pick:\n    item: str\n\n@dataclass(frozen=True)\nclass Look:\n    pass\n\n@dataclass(frozen=True)\nclass Quit:\n    pass\n\nCommand = Go | Pick | Look | Quit\n\ndef parse_command(line: str) -> Command:\n    if line == \"look\":\n        return Look()\n    if line == \"quit\":\n        return Quit()\n    words = line.split(\" \")\n    if len(words) == 2 and words[1]:\n        if words[0] == \"go\" and words[1] in (\"north\", \"south\", \"east\", \"west\"):\n            return Go(words[1])\n        if words[0] == \"pick\":\n            return Pick(words[1])\n    raise ValueError(\"unknown command: \" + line)" :mutant "")
(:item :task "parseCommand" :lang "ts" :calls ("parseCommand(\"pick lamp\")" "parseCommand(\"look\")") :wants ("{ kind: \"pick\", item: \"lamp\" }" "{ kind: \"look\" }") :bug "" :line 0 :program "type Command =\n  | { kind: \"go\"; direction: string }\n  | { kind: \"pick\"; item: string }\n  | { kind: \"look\" }\n  | { kind: \"quit\" };\n\nfunction parseCommand(line: string): Command {\n  if (line === \"look\") return { kind: \"look\" };\n  if (line === \"quit\") return { kind: \"quit\" };\n  const words = line.split(\" \");\n  if (words.length === 2 && words[1].length > 0) {\n    if (words[0] === \"go\" && [\"north\", \"south\", \"east\", \"west\"].includes(words[1])) {\n      return { kind: \"go\", direction: words[1] };\n    }\n    if (words[0] === \"pick\") return { kind: \"pick\", item: words[1] };\n  }\n  throw new Error(\"unknown command: \" + line);\n}" :mutant "")
(:item :task "pointInRect" :lang "asl" :calls ("(pointInRect (Point :x 2 :y 2) (Rect :left 0 :top 0 :width 2 :height 2))" "(pointInRect (Point :x 0 :y 0) (Rect :left 0 :top 0 :width 2 :height 2))") :wants ("true" "true") :bug "le" :line 6 :program "schema Point { x: Int64 y: Int64 }\n\nschema Rect { left: Int64 top: Int64 width: Int64 height: Int64 }\n\nfn pointInRect p: Point r: Rect -> Bool\n  (and (and (>= p.x r.left) (<= p.x (+ r.left r.width)))\n       (and (>= p.y r.top) (<= p.y (+ r.top r.height))))" :mutant "schema Point { x: Int64 y: Int64 }\n\nschema Rect { left: Int64 top: Int64 width: Int64 height: Int64 }\n\nfn pointInRect p: Point r: Rect -> Bool\n  (and (and (>= p.x r.left) (< p.x (+ r.left r.width)))\n       (and (>= p.y r.top) (<= p.y (+ r.top r.height))))")
(:item :task "pointInRect" :lang "py" :calls ("point_in_rect(Point(x=2, y=2), Rect(left=0, top=0, width=2, height=2))" "point_in_rect(Point(x=0, y=0), Rect(left=0, top=0, width=2, height=2))") :wants ("True" "True") :bug "le" :line 16 :program "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Point:\n    x: int\n    y: int\n\n@dataclass(frozen=True)\nclass Rect:\n    left: int\n    top: int\n    width: int\n    height: int\n\ndef point_in_rect(p: Point, r: Rect) -> bool:\n    return r.left <= p.x <= r.left + r.width and r.top <= p.y <= r.top + r.height" :mutant "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Point:\n    x: int\n    y: int\n\n@dataclass(frozen=True)\nclass Rect:\n    left: int\n    top: int\n    width: int\n    height: int\n\ndef point_in_rect(p: Point, r: Rect) -> bool:\n    return r.left < p.x <= r.left + r.width and r.top <= p.y <= r.top + r.height")
(:item :task "pointInRect" :lang "ts" :calls ("pointInRect({ x: 2, y: 2 }, { left: 0, top: 0, width: 2, height: 2 })" "pointInRect({ x: 0, y: 0 }, { left: 0, top: 0, width: 2, height: 2 })") :wants ("true" "true") :bug "le" :line 6 :program "type Point = { x: number; y: number };\n\ntype Rect = { left: number; top: number; width: number; height: number };\n\nfunction pointInRect(p: Point, r: Rect): boolean {\n  return p.x >= r.left && p.x <= r.left + r.width && p.y >= r.top && p.y <= r.top + r.height;\n}" :mutant "type Point = { x: number; y: number };\n\ntype Rect = { left: number; top: number; width: number; height: number };\n\nfunction pointInRect(p: Point, r: Rect): boolean {\n  return p.x >= r.left && p.x < r.left + r.width && p.y >= r.top && p.y <= r.top + r.height;\n}")
(:item :task "powMod" :lang "asl" :calls ("(powMod 7 1 1)" "(powMod 0 0 5)") :wants ("0" "1") :bug "" :line 0 :program "fn powMod base: Int64 exponent: Int64 modulus: Int64 -> Int64\n  (cond\n    ((= exponent 0) (mod 1 modulus))\n    ((= (mod exponent 2) 0)\n      (let [(half (powMod base (/ exponent 2) modulus))]\n        (mod (* half half) modulus)))\n    (else (mod (* (mod base modulus) (powMod base (- exponent 1) modulus)) modulus)))" :mutant "")
(:item :task "powMod" :lang "py" :calls ("pow_mod(7, 1, 1)" "pow_mod(0, 0, 5)") :wants ("0" "1") :bug "" :line 0 :program "def pow_mod(base: int, exponent: int, modulus: int) -> int:\n    return pow(base, exponent, modulus)" :mutant "")
(:item :task "powMod" :lang "ts" :calls ("powMod(7, 1, 1)" "powMod(0, 0, 5)") :wants ("0" "1") :bug "" :line 0 :program "function powMod(base: number, exponent: number, modulus: number): number {\n  let result = 1 % modulus;\n  let b = base % modulus;\n  let e = exponent;\n  while (e > 0) {\n    if (e % 2 === 1) result = (result * b) % modulus;\n    b = (b * b) % modulus;\n    e = Math.floor(e / 2);\n  }\n  return result;\n}" :mutant "")
(:item :task "reverseWords" :lang "asl" :calls ("(reverseWords \"\")" "(reverseWords \"  lead and trail  \")") :wants ("\"\"" "\"trail and lead\"") :bug "" :line 0 :program "fn reverseWords text: String -> String\n  (stringJoin (listReverse (filter (fn [w] (not (stringEmpty? w))) (stringSplit text \" \"))) \" \")" :mutant "")
(:item :task "reverseWords" :lang "py" :calls ("reverse_words(\"\")" "reverse_words(\"  lead and trail  \")") :wants ("\"\"" "\"trail and lead\"") :bug "" :line 0 :program "def reverse_words(text: str) -> str:\n    return \" \".join(reversed([w for w in text.split(\" \") if w]))" :mutant "")
(:item :task "reverseWords" :lang "ts" :calls ("reverseWords(\"\")" "reverseWords(\"  lead and trail  \")") :wants ("\"\"" "\"trail and lead\"") :bug "" :line 0 :program "function reverseWords(text: string): string {\n  return text.split(\" \").filter((w) => w.length > 0).reverse().join(\" \");\n}" :mutant "")
(:item :task "romanNumeral" :lang "asl" :calls ("(romanNumeral 1)" "(romanNumeral 3999)") :wants ("\"I\"" "\"MMMCMXCIX\"") :bug "ge" :line 5 :program "fn romanFrom n: Int64 table: (List (Pair Int64 String)) -> String\n  (match (listHead table)\n    ((none) \"\")\n    ((some p)\n      (if (>= n (pairFirst p))\n        (str (pairSecond p) (romanFrom (- n (pairFirst p)) table))\n        (romanFrom n (listDrop table 1)))))\n\nfn romanNumeral n: Int64 -> String\n  (romanFrom n (list (pair 1000 \"M\") (pair 900 \"CM\") (pair 500 \"D\") (pair 400 \"CD\") (pair 100 \"C\") (pair 90 \"XC\") (pair 50 \"L\") (pair 40 \"XL\") (pair 10 \"X\") (pair 9 \"IX\") (pair 5 \"V\") (pair 4 \"IV\") (pair 1 \"I\")))" :mutant "fn romanFrom n: Int64 table: (List (Pair Int64 String)) -> String\n  (match (listHead table)\n    ((none) \"\")\n    ((some p)\n      (if (> n (pairFirst p))\n        (str (pairSecond p) (romanFrom (- n (pairFirst p)) table))\n        (romanFrom n (listDrop table 1)))))\n\nfn romanNumeral n: Int64 -> String\n  (romanFrom n (list (pair 1000 \"M\") (pair 900 \"CM\") (pair 500 \"D\") (pair 400 \"CD\") (pair 100 \"C\") (pair 90 \"XC\") (pair 50 \"L\") (pair 40 \"XL\") (pair 10 \"X\") (pair 9 \"IX\") (pair 5 \"V\") (pair 4 \"IV\") (pair 1 \"I\")))")
(:item :task "romanNumeral" :lang "py" :calls ("roman_numeral(1)" "roman_numeral(3999)") :wants ("\"I\"" "\"MMMCMXCIX\"") :bug "ge" :line 6 :program "def roman_numeral(n: int) -> str:\n    table = [(1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"), (100, \"C\"), (90, \"XC\"),\n             (50, \"L\"), (40, \"XL\"), (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\")]\n    out = \"\"\n    for value, digits in table:\n        while n >= value:\n            out += digits\n            n -= value\n    return out" :mutant "def roman_numeral(n: int) -> str:\n    table = [(1000, \"M\"), (900, \"CM\"), (500, \"D\"), (400, \"CD\"), (100, \"C\"), (90, \"XC\"),\n             (50, \"L\"), (40, \"XL\"), (10, \"X\"), (9, \"IX\"), (5, \"V\"), (4, \"IV\"), (1, \"I\")]\n    out = \"\"\n    for value, digits in table:\n        while n > value:\n            out += digits\n            n -= value\n    return out")
(:item :task "romanNumeral" :lang "ts" :calls ("romanNumeral(1)" "romanNumeral(3999)") :wants ("\"I\"" "\"MMMCMXCIX\"") :bug "ge" :line 9 :program "function romanNumeral(n: number): string {\n  const table: Array<[number, string]> = [\n    [1000, \"M\"], [900, \"CM\"], [500, \"D\"], [400, \"CD\"], [100, \"C\"], [90, \"XC\"],\n    [50, \"L\"], [40, \"XL\"], [10, \"X\"], [9, \"IX\"], [5, \"V\"], [4, \"IV\"], [1, \"I\"],\n  ];\n  let rest = n;\n  let out = \"\";\n  for (const [value, digits] of table) {\n    while (rest >= value) {\n      out += digits;\n      rest -= value;\n    }\n  }\n  return out;\n}" :mutant "function romanNumeral(n: number): string {\n  const table: Array<[number, string]> = [\n    [1000, \"M\"], [900, \"CM\"], [500, \"D\"], [400, \"CD\"], [100, \"C\"], [90, \"XC\"],\n    [50, \"L\"], [40, \"XL\"], [10, \"X\"], [9, \"IX\"], [5, \"V\"], [4, \"IV\"], [1, \"I\"],\n  ];\n  let rest = n;\n  let out = \"\";\n  for (const [value, digits] of table) {\n    while (rest > value) {\n      out += digits;\n      rest -= value;\n    }\n  }\n  return out;\n}")
(:item :task "runLengthEncode" :lang "asl" :calls ("(runLengthEncode \"a\")" "(runLengthEncode \"abc\")") :wants ("(list (pair \"a\" 1))" "(list (pair \"a\" 1) (pair \"b\" 1) (pair \"c\" 1))") :bug "eq" :line 5 :program "fn rleStep acc: (List (Pair String Int64)) c: String -> (List (Pair String Int64))\n  (match (listLast acc)\n    ((none) (list (pair c 1)))\n    ((some p)\n      (if (= (pairFirst p) c)\n        (listAppend (listTake acc (- (listLength acc) 1)) (list (pair c (+ (pairSecond p) 1))))\n        (listAppend acc (list (pair c 1))))))\n\nfn runLengthEncode text: String -> (List (Pair String Int64))\n  (fold rleStep (list) (stringChars text))" :mutant "fn rleStep acc: (List (Pair String Int64)) c: String -> (List (Pair String Int64))\n  (match (listLast acc)\n    ((none) (list (pair c 1)))\n    ((some p)\n      (if (!= (pairFirst p) c)\n        (listAppend (listTake acc (- (listLength acc) 1)) (list (pair c (+ (pairSecond p) 1))))\n        (listAppend acc (list (pair c 1))))))\n\nfn runLengthEncode text: String -> (List (Pair String Int64))\n  (fold rleStep (list) (stringChars text))")
(:item :task "runLengthEncode" :lang "py" :calls ("run_length_encode(\"a\")" "run_length_encode(\"abc\")") :wants ("[(\"a\", 1)]" "[(\"a\", 1), (\"b\", 1), (\"c\", 1)]") :bug "eq" :line 4 :program "def run_length_encode(text: str) -> list[tuple[str, int]]:\n    runs: list[tuple[str, int]] = []\n    for c in text:\n        if runs and runs[-1][0] == c:\n            runs[-1] = (c, runs[-1][1] + 1)\n        else:\n            runs.append((c, 1))\n    return runs" :mutant "def run_length_encode(text: str) -> list[tuple[str, int]]:\n    runs: list[tuple[str, int]] = []\n    for c in text:\n        if runs and runs[-1][0] != c:\n            runs[-1] = (c, runs[-1][1] + 1)\n        else:\n            runs.append((c, 1))\n    return runs")
(:item :task "runLengthEncode" :lang "ts" :calls ("runLengthEncode(\"a\")" "runLengthEncode(\"abc\")") :wants ("[[\"a\", 1]]" "[[\"a\", 1], [\"b\", 1], [\"c\", 1]]") :bug "eq" :line 5 :program "function runLengthEncode(text: string): Array<[string, number]> {\n  const runs: Array<[string, number]> = [];\n  for (const c of text) {\n    const last = runs[runs.length - 1];\n    if (last !== undefined && last[0] === c) {\n      last[1] += 1;\n    } else {\n      runs.push([c, 1]);\n    }\n  }\n  return runs;\n}" :mutant "function runLengthEncode(text: string): Array<[string, number]> {\n  const runs: Array<[string, number]> = [];\n  for (const c of text) {\n    const last = runs[runs.length - 1];\n    if (last !== undefined && last[0] !== c) {\n      last[1] += 1;\n    } else {\n      runs.push([c, 1]);\n    }\n  }\n  return runs;\n}")
(:item :task "secondLargest" :lang "asl" :calls ("(secondLargest (list 4 4 4))" "(secondLargest (list 2 2 1))") :wants ("(none)" "(some 1)") :bug "" :line 0 :program "fn secondLargest xs: (List Int64) -> (Option Int64)\n  (match (listMax xs)\n    ((none) (none))\n    ((some top) (listMax (filter (fn [x] (< x top)) xs))))" :mutant "")
(:item :task "secondLargest" :lang "py" :calls ("second_largest([4, 4, 4])" "second_largest([2, 2, 1])") :wants ("None" "1") :bug "" :line 0 :program "def second_largest(xs: list[int]) -> int | None:\n    distinct = sorted(set(xs))\n    return distinct[-2] if len(distinct) >= 2 else None" :mutant "")
(:item :task "secondLargest" :lang "ts" :calls ("secondLargest([4, 4, 4])" "secondLargest([2, 2, 1])") :wants ("undefined" "1") :bug "" :line 0 :program "function secondLargest(xs: number[]): number | undefined {\n  if (xs.length === 0) return undefined;\n  const top = Math.max(...xs);\n  const rest = xs.filter((x) => x < top);\n  return rest.length === 0 ? undefined : Math.max(...rest);\n}" :mutant "")
(:item :task "shapeArea" :lang "asl" :calls ("(shapeArea (square 5))" "(shapeArea (triangle 3 5))") :wants ("25" "7") :bug "times" :line 5 :program "enum Shape (circle r: Int64) (rect w: Int64 h: Int64) (square side: Int64) (triangle b: Int64 h: Int64)\n\nfn shapeArea s: Shape -> Int64\n  (match s\n    ((circle r) (* 3 (* r r)))\n    ((rect w h) (* w h))\n    ((square side) (* side side))\n    ((triangle b h) (/ (* b h) 2)))" :mutant "enum Shape (circle r: Int64) (rect w: Int64 h: Int64) (square side: Int64) (triangle b: Int64 h: Int64)\n\nfn shapeArea s: Shape -> Int64\n  (match s\n    ((circle r) (+ 3 (* r r)))\n    ((rect w h) (* w h))\n    ((square side) (* side side))\n    ((triangle b h) (/ (* b h) 2)))")
(:item :task "shapeArea" :lang "py" :calls ("shape_area(Square(side=5))" "shape_area(Triangle(b=3, h=5))") :wants ("25" "7") :bug "times" :line 26 :program "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Circle:\n    r: int\n\n@dataclass(frozen=True)\nclass Rect:\n    w: int\n    h: int\n\n@dataclass(frozen=True)\nclass Square:\n    side: int\n\n@dataclass(frozen=True)\nclass Triangle:\n    b: int\n    h: int\n\nShape = Circle | Rect | Square | Triangle\n\ndef shape_area(s: Shape) -> int:\n    match s:\n        case Circle(r):\n            return 3 * r * r\n        case Rect(w, h):\n            return w * h\n        case Square(side):\n            return side * side\n        case Triangle(b, h):\n            return (b * h) // 2" :mutant "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Circle:\n    r: int\n\n@dataclass(frozen=True)\nclass Rect:\n    w: int\n    h: int\n\n@dataclass(frozen=True)\nclass Square:\n    side: int\n\n@dataclass(frozen=True)\nclass Triangle:\n    b: int\n    h: int\n\nShape = Circle | Rect | Square | Triangle\n\ndef shape_area(s: Shape) -> int:\n    match s:\n        case Circle(r):\n            return 3 + r * r\n        case Rect(w, h):\n            return w * h\n        case Square(side):\n            return side * side\n        case Triangle(b, h):\n            return (b * h) // 2")
(:item :task "shapeArea" :lang "ts" :calls ("shapeArea({ kind: \"square\", side: 5 })" "shapeArea({ kind: \"triangle\", b: 3, h: 5 })") :wants ("25" "7") :bug "times" :line 10 :program "type Shape =\n  | { kind: \"circle\"; r: number }\n  | { kind: \"rect\"; w: number; h: number }\n  | { kind: \"square\"; side: number }\n  | { kind: \"triangle\"; b: number; h: number };\n\nfunction shapeArea(s: Shape): number {\n  switch (s.kind) {\n    case \"circle\":\n      return 3 * s.r * s.r;\n    case \"rect\":\n      return s.w * s.h;\n    case \"square\":\n      return s.side * s.side;\n    case \"triangle\":\n      return Math.floor((s.b * s.h) / 2);\n  }\n}" :mutant "type Shape =\n  | { kind: \"circle\"; r: number }\n  | { kind: \"rect\"; w: number; h: number }\n  | { kind: \"square\"; side: number }\n  | { kind: \"triangle\"; b: number; h: number };\n\nfunction shapeArea(s: Shape): number {\n  switch (s.kind) {\n    case \"circle\":\n      return 3 + s.r * s.r;\n    case \"rect\":\n      return s.w * s.h;\n    case \"square\":\n      return s.side * s.side;\n    case \"triangle\":\n      return Math.floor((s.b * s.h) / 2);\n  }\n}")
(:item :task "stackMachine" :lang "asl" :calls ("(stackMachine (list (push 4) (dup) (mul)))" "(stackMachine (list (push 1) (push 2) (swap)))") :wants ("(ok 16)" "(ok 1)") :bug "plus" :line 18 :program "enum Instr (push n: Int64) (add) (mul) (dup) (swap)\n\nfn topTwo stack: (List Int64) -> (Option (Pair Int64 Int64))\n  (match (listGet stack 1)\n    ((none) (none))\n    ((some second) (some (pair (optionOr (listHead stack) 0) second))))\n\nfn applyInstr stack: (List Int64) ins: Instr -> (Result (List Int64) String)\n  (match ins\n    ((push n) (ok (listAppend (list n) stack)))\n    ((dup)\n      (match (listHead stack)\n        ((none) (err \"stack underflow\"))\n        ((some x) (ok (listAppend (list x) stack)))))\n    ((add)\n      (match (topTwo stack)\n        ((none) (err \"stack underflow\"))\n        ((some p) (ok (listAppend (list (+ (pairFirst p) (pairSecond p))) (listDrop stack 2))))))\n    ((mul)\n      (match (topTwo stack)\n        ((none) (err \"stack underflow\"))\n        ((some p) (ok (listAppend (list (* (pairFirst p) (pairSecond p))) (listDrop stack 2))))))\n    ((swap)\n      (match (topTwo stack)\n        ((none) (err \"stack underflow\"))\n        ((some p) (ok (listAppend (list (pairSecond p) (pairFirst p)) (listDrop stack 2)))))))\n\nfn runFrom stack: (List Int64) program: (List Instr) -> (Result (List Int64) String)\n  (match (listHead program)\n    ((none) (ok stack))\n    ((some ins)\n      (match (applyInstr stack ins)\n        ((err e) (err e))\n        ((ok next) (runFrom next (listDrop program 1))))))\n\nfn stackMachine program: (List Instr) -> (Result Int64 String)\n  (match (runFrom (list) program)\n    ((err e) (err e))\n    ((ok stack) (optionToResult (listHead stack) \"empty stack\")))" :mutant "enum Instr (push n: Int64) (add) (mul) (dup) (swap)\n\nfn topTwo stack: (List Int64) -> (Option (Pair Int64 Int64))\n  (match (listGet stack 1)\n    ((none) (none))\n    ((some second) (some (pair (optionOr (listHead stack) 0) second))))\n\nfn applyInstr stack: (List Int64) ins: Instr -> (Result (List Int64) String)\n  (match ins\n    ((push n) (ok (listAppend (list n) stack)))\n    ((dup)\n      (match (listHead stack)\n        ((none) (err \"stack underflow\"))\n        ((some x) (ok (listAppend (list x) stack)))))\n    ((add)\n      (match (topTwo stack)\n        ((none) (err \"stack underflow\"))\n        ((some p) (ok (listAppend (list (- (pairFirst p) (pairSecond p))) (listDrop stack 2))))))\n    ((mul)\n      (match (topTwo stack)\n        ((none) (err \"stack underflow\"))\n        ((some p) (ok (listAppend (list (* (pairFirst p) (pairSecond p))) (listDrop stack 2))))))\n    ((swap)\n      (match (topTwo stack)\n        ((none) (err \"stack underflow\"))\n        ((some p) (ok (listAppend (list (pairSecond p) (pairFirst p)) (listDrop stack 2)))))))\n\nfn runFrom stack: (List Int64) program: (List Instr) -> (Result (List Int64) String)\n  (match (listHead program)\n    ((none) (ok stack))\n    ((some ins)\n      (match (applyInstr stack ins)\n        ((err e) (err e))\n        ((ok next) (runFrom next (listDrop program 1))))))\n\nfn stackMachine program: (List Instr) -> (Result Int64 String)\n  (match (runFrom (list) program)\n    ((err e) (err e))\n    ((ok stack) (optionToResult (listHead stack) \"empty stack\")))")
(:item :task "stackMachine" :lang "py" :calls ("stack_machine([Push(n=4), Dup(), Mul()])" "stack_machine([Push(n=1), Push(n=2), Swap()])") :wants ("16" "1") :bug "plus" :line 39 :program "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Push:\n    n: int\n\n@dataclass(frozen=True)\nclass Add:\n    pass\n\n@dataclass(frozen=True)\nclass Mul:\n    pass\n\n@dataclass(frozen=True)\nclass Dup:\n    pass\n\n@dataclass(frozen=True)\nclass Swap:\n    pass\n\nInstr = Push | Add | Mul | Dup | Swap\n\ndef stack_machine(program: list[Instr]) -> int:\n    stack: list[int] = []\n\n    def pop() -> int:\n        if not stack:\n            raise ValueError(\"stack underflow\")\n        return stack.pop()\n\n    for ins in program:\n        match ins:\n            case Push(n):\n                stack.append(n)\n            case Add():\n                a, b = pop(), pop()\n                stack.append(a + b)\n            case Mul():\n                a, b = pop(), pop()\n                stack.append(a * b)\n            case Dup():\n                a = pop()\n                stack.extend([a, a])\n            case Swap():\n                a, b = pop(), pop()\n                stack.extend([a, b])\n    return pop()" :mutant "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Push:\n    n: int\n\n@dataclass(frozen=True)\nclass Add:\n    pass\n\n@dataclass(frozen=True)\nclass Mul:\n    pass\n\n@dataclass(frozen=True)\nclass Dup:\n    pass\n\n@dataclass(frozen=True)\nclass Swap:\n    pass\n\nInstr = Push | Add | Mul | Dup | Swap\n\ndef stack_machine(program: list[Instr]) -> int:\n    stack: list[int] = []\n\n    def pop() -> int:\n        if not stack:\n            raise ValueError(\"stack underflow\")\n        return stack.pop()\n\n    for ins in program:\n        match ins:\n            case Push(n):\n                stack.append(n)\n            case Add():\n                a, b = pop(), pop()\n                stack.append(a - b)\n            case Mul():\n                a, b = pop(), pop()\n                stack.append(a * b)\n            case Dup():\n                a = pop()\n                stack.extend([a, a])\n            case Swap():\n                a, b = pop(), pop()\n                stack.extend([a, b])\n    return pop()")
(:item :task "stackMachine" :lang "ts" :calls ("stackMachine([{ kind: \"push\", n: 4 }, { kind: \"dup\" }, { kind: \"mul\" }])" "stackMachine([{ kind: \"push\", n: 1 }, { kind: \"push\", n: 2 }, { kind: \"swap\" }])") :wants ("16" "1") :bug "plus" :line 23 :program "type Instr =\n  | { kind: \"push\"; n: number }\n  | { kind: \"add\" }\n  | { kind: \"mul\" }\n  | { kind: \"dup\" }\n  | { kind: \"swap\" };\n\nfunction stackMachine(program: Instr[]): number {\n  const stack: number[] = [];\n  const pop = (): number => {\n    const v = stack.pop();\n    if (v === undefined) throw new Error(\"stack underflow\");\n    return v;\n  };\n  for (const ins of program) {\n    switch (ins.kind) {\n      case \"push\":\n        stack.push(ins.n);\n        break;\n      case \"add\": {\n        const a = pop();\n        const b = pop();\n        stack.push(a + b);\n        break;\n      }\n      case \"mul\": {\n        const a = pop();\n        const b = pop();\n        stack.push(a * b);\n        break;\n      }\n      case \"dup\": {\n        const a = pop();\n        stack.push(a, a);\n        break;\n      }\n      case \"swap\": {\n        const a = pop();\n        const b = pop();\n        stack.push(a, b);\n        break;\n      }\n    }\n  }\n  return pop();\n}" :mutant "type Instr =\n  | { kind: \"push\"; n: number }\n  | { kind: \"add\" }\n  | { kind: \"mul\" }\n  | { kind: \"dup\" }\n  | { kind: \"swap\" };\n\nfunction stackMachine(program: Instr[]): number {\n  const stack: number[] = [];\n  const pop = (): number => {\n    const v = stack.pop();\n    if (v === undefined) throw new Error(\"stack underflow\");\n    return v;\n  };\n  for (const ins of program) {\n    switch (ins.kind) {\n      case \"push\":\n        stack.push(ins.n);\n        break;\n      case \"add\": {\n        const a = pop();\n        const b = pop();\n        stack.push(a - b);\n        break;\n      }\n      case \"mul\": {\n        const a = pop();\n        const b = pop();\n        stack.push(a * b);\n        break;\n      }\n      case \"dup\": {\n        const a = pop();\n        stack.push(a, a);\n        break;\n      }\n      case \"swap\": {\n        const a = pop();\n        const b = pop();\n        stack.push(a, b);\n        break;\n      }\n    }\n  }\n  return pop();\n}")
(:item :task "sumDigits" :lang "asl" :calls ("(sumDigits 9)" "(sumDigits 1005)") :wants ("9" "6") :bug "" :line 0 :program "fn sumDigits n: Int64 -> Int64\n  (if (< n 10) n (+ (mod n 10) (sumDigits (/ n 10))))" :mutant "")
(:item :task "sumDigits" :lang "py" :calls ("sum_digits(9)" "sum_digits(1005)") :wants ("9" "6") :bug "" :line 0 :program "def sum_digits(n: int) -> int:\n    return sum(int(d) for d in str(n))" :mutant "")
(:item :task "sumDigits" :lang "ts" :calls ("sumDigits(9)" "sumDigits(1005)") :wants ("9" "6") :bug "" :line 0 :program "function sumDigits(n: number): number {\n  let total = 0;\n  let rest = n;\n  while (rest > 0) {\n    total += rest % 10;\n    rest = Math.floor(rest / 10);\n  }\n  return total;\n}" :mutant "")
(:item :task "trafficLightNext" :lang "asl" :calls ("(trafficLightNext (green) 1)" "(trafficLightNext (red) 0)") :wants ("(yellow)" "(red)") :bug "" :line 0 :program "enum Light (red) (green) (yellow)\n\nfn changeOnce light: Light -> Light\n  (match light\n    ((red) (green))\n    ((green) (yellow))\n    ((yellow) (red)))\n\nfn trafficLightNext light: Light steps: Int64 -> Light\n  (if (= steps 0) light (trafficLightNext (changeOnce light) (- steps 1)))" :mutant "")
(:item :task "trafficLightNext" :lang "py" :calls ("traffic_light_next(Light.GREEN, 1)" "traffic_light_next(Light.RED, 0)") :wants ("Light.YELLOW" "Light.RED") :bug "" :line 0 :program "from enum import Enum\n\n\nclass Light(Enum):\n    RED = \"red\"\n    GREEN = \"green\"\n    YELLOW = \"yellow\"\n\n\ndef traffic_light_next(light: Light, steps: int) -> Light:\n    order = [Light.RED, Light.GREEN, Light.YELLOW]\n    return order[(order.index(light) + steps) % 3]" :mutant "")
(:item :task "trafficLightNext" :lang "ts" :calls ("trafficLightNext(\"green\", 1)" "trafficLightNext(\"red\", 0)") :wants ("\"yellow\"" "\"red\"") :bug "" :line 0 :program "type Light = \"red\" | \"green\" | \"yellow\";\n\nfunction trafficLightNext(light: Light, steps: number): Light {\n  const order: Light[] = [\"red\", \"green\", \"yellow\"];\n  return order[(order.indexOf(light) + steps) % 3];\n}" :mutant "")
(:item :task "updateUser" :lang "asl" :calls ("(updateUser (User :name \"rob\" :age 41 :email (none)) (rename \"bob\"))" "(updateUser (User :name \"cy\" :age 20 :email (some \"cy@example.org\")) (clearEmail))") :wants ("(User :name \"bob\" :age 41 :email (none))" "(User :name \"cy\" :age 20 :email (none))") :bug "plus" :line 8 :program "schema User { name: String age: Int64 email: (Option String) }\n\nenum Change (rename newName: String) (birthday) (setEmail email: String) (clearEmail)\n\nfn updateUser user: User change: Change -> User\n  (match change\n    ((rename newName) (with user :name newName))\n    ((birthday) (with user :age (+ user.age 1)))\n    ((setEmail email) (with user :email (some email)))\n    ((clearEmail) (with user :email (none))))" :mutant "schema User { name: String age: Int64 email: (Option String) }\n\nenum Change (rename newName: String) (birthday) (setEmail email: String) (clearEmail)\n\nfn updateUser user: User change: Change -> User\n  (match change\n    ((rename newName) (with user :name newName))\n    ((birthday) (with user :age (- user.age 1)))\n    ((setEmail email) (with user :email (some email)))\n    ((clearEmail) (with user :email (none))))")
(:item :task "updateUser" :lang "py" :calls ("update_user(User(name=\"rob\", age=41, email=None), Rename(new_name=\"bob\"))" "update_user(User(name=\"cy\", age=20, email=\"cy@example.org\"), ClearEmail())") :wants ("User(name=\"bob\", age=41, email=None)" "User(name=\"cy\", age=20, email=None)") :bug "plus" :line 32 :program "from dataclasses import dataclass, replace\n\n@dataclass(frozen=True)\nclass User:\n    name: str\n    age: int\n    email: str | None\n\n@dataclass(frozen=True)\nclass Rename:\n    new_name: str\n\n@dataclass(frozen=True)\nclass Birthday:\n    pass\n\n@dataclass(frozen=True)\nclass SetEmail:\n    email: str\n\n@dataclass(frozen=True)\nclass ClearEmail:\n    pass\n\nChange = Rename | Birthday | SetEmail | ClearEmail\n\ndef update_user(user: User, change: Change) -> User:\n    match change:\n        case Rename(new_name):\n            return replace(user, name=new_name)\n        case Birthday():\n            return replace(user, age=user.age + 1)\n        case SetEmail(email):\n            return replace(user, email=email)\n        case ClearEmail():\n            return replace(user, email=None)" :mutant "from dataclasses import dataclass, replace\n\n@dataclass(frozen=True)\nclass User:\n    name: str\n    age: int\n    email: str | None\n\n@dataclass(frozen=True)\nclass Rename:\n    new_name: str\n\n@dataclass(frozen=True)\nclass Birthday:\n    pass\n\n@dataclass(frozen=True)\nclass SetEmail:\n    email: str\n\n@dataclass(frozen=True)\nclass ClearEmail:\n    pass\n\nChange = Rename | Birthday | SetEmail | ClearEmail\n\ndef update_user(user: User, change: Change) -> User:\n    match change:\n        case Rename(new_name):\n            return replace(user, name=new_name)\n        case Birthday():\n            return replace(user, age=user.age - 1)\n        case SetEmail(email):\n            return replace(user, email=email)\n        case ClearEmail():\n            return replace(user, email=None)")
(:item :task "updateUser" :lang "ts" :calls ("updateUser({ name: \"rob\", age: 41, email: undefined }, { kind: \"rename\", newName: \"bob\" })" "updateUser({ name: \"cy\", age: 20, email: \"cy@example.org\" }, { kind: \"clearEmail\" })") :wants ("{ name: \"bob\", age: 41, email: undefined }" "{ name: \"cy\", age: 20, email: undefined }") :bug "plus" :line 14 :program "type User = { name: string; age: number; email: string | undefined };\n\ntype Change =\n  | { kind: \"rename\"; newName: string }\n  | { kind: \"birthday\" }\n  | { kind: \"setEmail\"; email: string }\n  | { kind: \"clearEmail\" };\n\nfunction updateUser(user: User, change: Change): User {\n  switch (change.kind) {\n    case \"rename\":\n      return { ...user, name: change.newName };\n    case \"birthday\":\n      return { ...user, age: user.age + 1 };\n    case \"setEmail\":\n      return { ...user, email: change.email };\n    case \"clearEmail\":\n      return { ...user, email: undefined };\n  }\n}" :mutant "type User = { name: string; age: number; email: string | undefined };\n\ntype Change =\n  | { kind: \"rename\"; newName: string }\n  | { kind: \"birthday\" }\n  | { kind: \"setEmail\"; email: string }\n  | { kind: \"clearEmail\" };\n\nfunction updateUser(user: User, change: Change): User {\n  switch (change.kind) {\n    case \"rename\":\n      return { ...user, name: change.newName };\n    case \"birthday\":\n      return { ...user, age: user.age - 1 };\n    case \"setEmail\":\n      return { ...user, email: change.email };\n    case \"clearEmail\":\n      return { ...user, email: undefined };\n  }\n}")
