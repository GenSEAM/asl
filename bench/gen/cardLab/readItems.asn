(:readItems :id "CARD-LAB" :date "2026-11-13" :method "asl run asl/bench/gen/cardLab/readProbe.asl gen: calls are the first two graded cases that do not fail; the mutant replaces the first occurrence of the first class of classes whose pattern occurs in all three references and whose three mutants all compile and fail a graded case")
(:item :task "accountApply" :lang "asl" :calls ("(accountApply (Account :balance 100 :frozen false) (withdraw 100))" "(accountApply (Account :balance 100 :frozen false) (freeze))") :wants ("(ok (Account :balance 0 :frozen false))" "(ok (Account :balance 100 :frozen true))") :bug "gt" :line 16 :program "schema Account { balance: Int64 frozen: Bool }\n\nenum Op (deposit amount: Int64) (withdraw amount: Int64) (freeze) (unfreeze)\n\nfn accountApply acct: Account op: Op -> (Result Account String)\n  (match op\n    ((freeze) (ok (with acct :frozen true)))\n    ((unfreeze) (ok (with acct :frozen false)))\n    ((deposit amount)\n      (if acct.frozen\n        (err \"account is frozen\")\n        (ok (with acct :balance (+ acct.balance amount)))))\n    ((withdraw amount)\n      (cond\n        (acct.frozen (err \"account is frozen\"))\n        ((> amount acct.balance) (err \"insufficient funds\"))\n        (else (ok (with acct :balance (- acct.balance amount)))))))" :mutant "schema Account { balance: Int64 frozen: Bool }\n\nenum Op (deposit amount: Int64) (withdraw amount: Int64) (freeze) (unfreeze)\n\nfn accountApply acct: Account op: Op -> (Result Account String)\n  (match op\n    ((freeze) (ok (with acct :frozen true)))\n    ((unfreeze) (ok (with acct :frozen false)))\n    ((deposit amount)\n      (if acct.frozen\n        (err \"account is frozen\")\n        (ok (with acct :balance (+ acct.balance amount)))))\n    ((withdraw amount)\n      (cond\n        (acct.frozen (err \"account is frozen\"))\n        ((>= amount acct.balance) (err \"insufficient funds\"))\n        (else (ok (with acct :balance (- acct.balance amount)))))))")
(:item :task "accountApply" :lang "py" :calls ("account_apply(Account(balance=100, frozen=False), Withdraw(amount=100))" "account_apply(Account(balance=100, frozen=False), Freeze())") :wants ("Account(balance=0, frozen=False)" "Account(balance=100, frozen=True)") :bug "gt" :line 39 :program "from dataclasses import dataclass, replace\n\n@dataclass(frozen=True)\nclass Account:\n    balance: int\n    frozen: bool\n\n@dataclass(frozen=True)\nclass Deposit:\n    amount: int\n\n@dataclass(frozen=True)\nclass Withdraw:\n    amount: int\n\n@dataclass(frozen=True)\nclass Freeze:\n    pass\n\n@dataclass(frozen=True)\nclass Unfreeze:\n    pass\n\nOp = Deposit | Withdraw | Freeze | Unfreeze\n\ndef account_apply(acct: Account, op: Op) -> Account:\n    match op:\n        case Freeze():\n            return replace(acct, frozen=True)\n        case Unfreeze():\n            return replace(acct, frozen=False)\n        case Deposit(amount):\n            if acct.frozen:\n                raise ValueError(\"account is frozen\")\n            return replace(acct, balance=acct.balance + amount)\n        case Withdraw(amount):\n            if acct.frozen:\n                raise ValueError(\"account is frozen\")\n            if amount > acct.balance:\n                raise ValueError(\"insufficient funds\")\n            return replace(acct, balance=acct.balance - amount)" :mutant "from dataclasses import dataclass, replace\n\n@dataclass(frozen=True)\nclass Account:\n    balance: int\n    frozen: bool\n\n@dataclass(frozen=True)\nclass Deposit:\n    amount: int\n\n@dataclass(frozen=True)\nclass Withdraw:\n    amount: int\n\n@dataclass(frozen=True)\nclass Freeze:\n    pass\n\n@dataclass(frozen=True)\nclass Unfreeze:\n    pass\n\nOp = Deposit | Withdraw | Freeze | Unfreeze\n\ndef account_apply(acct: Account, op: Op) -> Account:\n    match op:\n        case Freeze():\n            return replace(acct, frozen=True)\n        case Unfreeze():\n            return replace(acct, frozen=False)\n        case Deposit(amount):\n            if acct.frozen:\n                raise ValueError(\"account is frozen\")\n            return replace(acct, balance=acct.balance + amount)\n        case Withdraw(amount):\n            if acct.frozen:\n                raise ValueError(\"account is frozen\")\n            if amount >= acct.balance:\n                raise ValueError(\"insufficient funds\")\n            return replace(acct, balance=acct.balance - amount)")
(:item :task "accountApply" :lang "ts" :calls ("accountApply({ balance: 100, frozen: false }, { kind: \"withdraw\", amount: 100 })" "accountApply({ balance: 100, frozen: false }, { kind: \"freeze\" })") :wants ("{ balance: 0, frozen: false }" "{ balance: 100, frozen: true }") :bug "gt" :line 20 :program "type Account = { balance: number; frozen: boolean };\n\ntype Op =\n  | { kind: \"deposit\"; amount: number }\n  | { kind: \"withdraw\"; amount: number }\n  | { kind: \"freeze\" }\n  | { kind: \"unfreeze\" };\n\nfunction accountApply(acct: Account, op: Op): Account {\n  switch (op.kind) {\n    case \"freeze\":\n      return { ...acct, frozen: true };\n    case \"unfreeze\":\n      return { ...acct, frozen: false };\n    case \"deposit\":\n      if (acct.frozen) throw new Error(\"account is frozen\");\n      return { ...acct, balance: acct.balance + op.amount };\n    case \"withdraw\":\n      if (acct.frozen) throw new Error(\"account is frozen\");\n      if (op.amount > acct.balance) throw new Error(\"insufficient funds\");\n      return { ...acct, balance: acct.balance - op.amount };\n  }\n}" :mutant "type Account = { balance: number; frozen: boolean };\n\ntype Op =\n  | { kind: \"deposit\"; amount: number }\n  | { kind: \"withdraw\"; amount: number }\n  | { kind: \"freeze\" }\n  | { kind: \"unfreeze\" };\n\nfunction accountApply(acct: Account, op: Op): Account {\n  switch (op.kind) {\n    case \"freeze\":\n      return { ...acct, frozen: true };\n    case \"unfreeze\":\n      return { ...acct, frozen: false };\n    case \"deposit\":\n      if (acct.frozen) throw new Error(\"account is frozen\");\n      return { ...acct, balance: acct.balance + op.amount };\n    case \"withdraw\":\n      if (acct.frozen) throw new Error(\"account is frozen\");\n      if (op.amount >= acct.balance) throw new Error(\"insufficient funds\");\n      return { ...acct, balance: acct.balance - op.amount };\n  }\n}")
(:item :task "chunk" :lang "asl" :calls ("(chunk (list 1 2 3) 3)" "(chunk (list 1 2 3) 1)") :wants ("(list (list 1 2 3))" "(list (list 1) (list 2) (list 3))") :bug "" :line 0 :program "fn chunk xs: (List Int64) size: Int64 -> (List (List Int64))\n  (if (listEmpty? xs)\n    (list)\n    (listAppend (list (listTake xs size)) (chunk (listDrop xs size) size)))" :mutant "")
(:item :task "chunk" :lang "py" :calls ("chunk([1, 2, 3], 3)" "chunk([1, 2, 3], 1)") :wants ("[[1, 2, 3]]" "[[1], [2], [3]]") :bug "" :line 0 :program "def chunk(xs: list[int], size: int) -> list[list[int]]:\n    return [xs[i:i + size] for i in range(0, len(xs), size)]" :mutant "")
(:item :task "chunk" :lang "ts" :calls ("chunk([1, 2, 3], 3)" "chunk([1, 2, 3], 1)") :wants ("[[1, 2, 3]]" "[[1], [2], [3]]") :bug "" :line 0 :program "function chunk(xs: number[], size: number): number[][] {\n  const out: number[][] = [];\n  for (let i = 0; i < xs.length; i += size) {\n    out.push(xs.slice(i, i + size));\n  }\n  return out;\n}" :mutant "")
(:item :task "clampInt" :lang "asl" :calls ("(clampInt 15 0 10)" "(clampInt 0 0 0)") :wants ("10" "0") :bug "" :line 0 :program "fn clampInt x: Int64 lo: Int64 hi: Int64 -> Int64\n  (if (< x lo) lo (if (> x hi) hi x))" :mutant "")
(:item :task "clampInt" :lang "py" :calls ("clamp_int(15, 0, 10)" "clamp_int(0, 0, 0)") :wants ("10" "0") :bug "" :line 0 :program "def clamp_int(x: int, lo: int, hi: int) -> int:\n    return max(lo, min(x, hi))" :mutant "")
(:item :task "clampInt" :lang "ts" :calls ("clampInt(15, 0, 10)" "clampInt(0, 0, 0)") :wants ("10" "0") :bug "" :line 0 :program "function clampInt(x: number, lo: number, hi: number): number {\n  return Math.max(lo, Math.min(x, hi));\n}" :mutant "")
(:item :task "classifyToken" :lang "asl" :calls ("(classifyToken \"+\")" "(classifyToken \"\")") :wants ("(symbol \"+\")" "(unknown)") :bug "eq" :line 10 :program "enum Token (number value: Int64) (word text: String) (symbol text: String) (unknown)\n\nfn allIn? text: String alphabet: String -> Bool\n  (and (not (stringEmpty? text)) (listAll? (fn [c] (stringContains? alphabet c)) (stringChars text)))\n\nfn classifyToken text: String -> Token\n  (cond\n    ((allIn? text \"0123456789\") (number (optionOr (stringToInt64 text) 0)))\n    ((allIn? text \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") (word text))\n    ((and (= (stringLength text) 1) (!= text \" \")) (symbol text))\n    (else (unknown)))" :mutant "enum Token (number value: Int64) (word text: String) (symbol text: String) (unknown)\n\nfn allIn? text: String alphabet: String -> Bool\n  (and (not (stringEmpty? text)) (listAll? (fn [c] (stringContains? alphabet c)) (stringChars text)))\n\nfn classifyToken text: String -> Token\n  (cond\n    ((allIn? text \"0123456789\") (number (optionOr (stringToInt64 text) 0)))\n    ((allIn? text \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") (word text))\n    ((and (!= (stringLength text) 1) (!= text \" \")) (symbol text))\n    (else (unknown)))")
(:item :task "classifyToken" :lang "py" :calls ("classify_token(\"+\")" "classify_token(\"\")") :wants ("Symbol(text=\"+\")" "Unknown()") :bug "eq" :line 26 :program "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Number:\n    value: int\n\n@dataclass(frozen=True)\nclass Word:\n    text: str\n\n@dataclass(frozen=True)\nclass Symbol:\n    text: str\n\n@dataclass(frozen=True)\nclass Unknown:\n    pass\n\nToken = Number | Word | Symbol | Unknown\n\ndef classify_token(text: str) -> Token:\n    if text and all(c in \"0123456789\" for c in text):\n        return Number(int(text))\n    if text and all(c in \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\" for c in text):\n        return Word(text)\n    if len(text) == 1 and text != \" \":\n        return Symbol(text)\n    return Unknown()" :mutant "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Number:\n    value: int\n\n@dataclass(frozen=True)\nclass Word:\n    text: str\n\n@dataclass(frozen=True)\nclass Symbol:\n    text: str\n\n@dataclass(frozen=True)\nclass Unknown:\n    pass\n\nToken = Number | Word | Symbol | Unknown\n\ndef classify_token(text: str) -> Token:\n    if text and all(c in \"0123456789\" for c in text):\n        return Number(int(text))\n    if text and all(c in \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\" for c in text):\n        return Word(text)\n    if len(text) != 1 and text != \" \":\n        return Symbol(text)\n    return Unknown()")
(:item :task "classifyToken" :lang "ts" :calls ("classifyToken(\"+\")" "classifyToken(\"\")") :wants ("{ kind: \"symbol\", text: \"+\" }" "{ kind: \"unknown\" }") :bug "eq" :line 10 :program "type Token =\n  | { kind: \"number\"; value: number }\n  | { kind: \"word\"; text: string }\n  | { kind: \"symbol\"; text: string }\n  | { kind: \"unknown\" };\n\nfunction classifyToken(text: string): Token {\n  if (/^[0-9]+$/.test(text)) return { kind: \"number\", value: Number(text) };\n  if (/^[A-Za-z]+$/.test(text)) return { kind: \"word\", text };\n  if (text.length === 1 && text !== \" \") return { kind: \"symbol\", text };\n  return { kind: \"unknown\" };\n}" :mutant "type Token =\n  | { kind: \"number\"; value: number }\n  | { kind: \"word\"; text: string }\n  | { kind: \"symbol\"; text: string }\n  | { kind: \"unknown\" };\n\nfunction classifyToken(text: string): Token {\n  if (/^[0-9]+$/.test(text)) return { kind: \"number\", value: Number(text) };\n  if (/^[A-Za-z]+$/.test(text)) return { kind: \"word\", text };\n  if (text.length !== 1 && text !== \" \") return { kind: \"symbol\", text };\n  return { kind: \"unknown\" };\n}")
(:item :task "collatzSteps" :lang "asl" :calls ("(collatzSteps 2)" "(collatzSteps 7)") :wants ("1" "16") :bug "zero" :line 3 :program "fn collatzSteps n: Int64 -> Int64\n  (cond\n    ((= n 1) 0)\n    ((= (mod n 2) 0) (+ 1 (collatzSteps (/ n 2))))\n    (else (+ 1 (collatzSteps (+ (* 3 n) 1)))))" :mutant "fn collatzSteps n: Int64 -> Int64\n  (cond\n    ((= n 1) 1)\n    ((= (mod n 2) 0) (+ 1 (collatzSteps (/ n 2))))\n    (else (+ 1 (collatzSteps (+ (* 3 n) 1)))))")
(:item :task "collatzSteps" :lang "py" :calls ("collatz_steps(2)" "collatz_steps(7)") :wants ("1" "16") :bug "zero" :line 2 :program "def collatz_steps(n: int) -> int:\n    steps = 0\n    while n != 1:\n        n = n // 2 if n % 2 == 0 else 3 * n + 1\n        steps += 1\n    return steps" :mutant "def collatz_steps(n: int) -> int:\n    steps = 1\n    while n != 1:\n        n = n // 2 if n % 2 == 0 else 3 * n + 1\n        steps += 1\n    return steps")
(:item :task "collatzSteps" :lang "ts" :calls ("collatzSteps(2)" "collatzSteps(7)") :wants ("1" "16") :bug "zero" :line 2 :program "function collatzSteps(n: number): number {\n  let steps = 0;\n  let x = n;\n  while (x !== 1) {\n    x = x % 2 === 0 ? x / 2 : 3 * x + 1;\n    steps += 1;\n  }\n  return steps;\n}" :mutant "function collatzSteps(n: number): number {\n  let steps = 1;\n  let x = n;\n  while (x !== 1) {\n    x = x % 2 === 0 ? x / 2 : 3 * x + 1;\n    steps += 1;\n  }\n  return steps;\n}")
(:item :task "countVowels" :lang "asl" :calls ("(countVowels \"\")" "(countVowels \"AEIOU\")") :wants ("0" "5") :bug "" :line 0 :program "fn countVowels text: String -> Int64\n  (listCount (fn [c] (stringContains? \"aeiou\" c)) (stringChars (stringLower text)))" :mutant "")
(:item :task "countVowels" :lang "py" :calls ("count_vowels(\"\")" "count_vowels(\"AEIOU\")") :wants ("0" "5") :bug "" :line 0 :program "def count_vowels(text: str) -> int:\n    return sum(1 for c in text.lower() if c in \"aeiou\")" :mutant "")
(:item :task "countVowels" :lang "ts" :calls ("countVowels(\"\")" "countVowels(\"AEIOU\")") :wants ("0" "5") :bug "" :line 0 :program "function countVowels(text: string): number {\n  return [...text.toLowerCase()].filter((c) => \"aeiou\".includes(c)).length;\n}" :mutant "")
(:item :task "dedupeKeepOrder" :lang "asl" :calls ("(dedupeKeepOrder (list 5 5 5))" "(dedupeKeepOrder (list 3 1 3 1 2))") :wants ("(list 5)" "(list 3 1 2)") :bug "" :line 0 :program "fn dedupeKeepOrder xs: (List Int64) -> (List Int64)\n  (fold (fn [acc x] (if (listContains? acc x) acc (listAppend acc (list x)))) (list) xs)" :mutant "")
(:item :task "dedupeKeepOrder" :lang "py" :calls ("dedupe_keep_order([5, 5, 5])" "dedupe_keep_order([3, 1, 3, 1, 2])") :wants ("[5]" "[3, 1, 2]") :bug "" :line 0 :program "def dedupe_keep_order(xs: list[int]) -> list[int]:\n    return list(dict.fromkeys(xs))" :mutant "")
(:item :task "dedupeKeepOrder" :lang "ts" :calls ("dedupeKeepOrder([5, 5, 5])" "dedupeKeepOrder([3, 1, 3, 1, 2])") :wants ("[5]" "[3, 1, 2]") :bug "" :line 0 :program "function dedupeKeepOrder(xs: number[]): number[] {\n  return [...new Set(xs)];\n}" :mutant "")
(:item :task "exprEval" :lang "asl" :calls ("(exprEval (num 0))" "(exprEval (mul (add (num 1) (num 2)) (num 4)))") :wants ("0" "12") :bug "plus" :line 6 :program "enum Expr (num n: Int64) (add l: Expr r: Expr) (mul l: Expr r: Expr) (neg e: Expr)\n\nfn exprEval e: Expr -> Int64\n  (match e\n    ((num n) n)\n    ((add l r) (+ (exprEval l) (exprEval r)))\n    ((mul l r) (* (exprEval l) (exprEval r)))\n    ((neg inner) (- 0 (exprEval inner))))" :mutant "enum Expr (num n: Int64) (add l: Expr r: Expr) (mul l: Expr r: Expr) (neg e: Expr)\n\nfn exprEval e: Expr -> Int64\n  (match e\n    ((num n) n)\n    ((add l r) (- (exprEval l) (exprEval r)))\n    ((mul l r) (* (exprEval l) (exprEval r)))\n    ((neg inner) (- 0 (exprEval inner))))")
(:item :task "exprEval" :lang "py" :calls ("expr_eval(Num(n=0))" "expr_eval(Mul(l=Add(l=Num(n=1), r=Num(n=2)), r=Num(n=4)))") :wants ("0" "12") :bug "plus" :line 28 :program "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Num:\n    n: int\n\n@dataclass(frozen=True)\nclass Add:\n    l: \"Expr\"\n    r: \"Expr\"\n\n@dataclass(frozen=True)\nclass Mul:\n    l: \"Expr\"\n    r: \"Expr\"\n\n@dataclass(frozen=True)\nclass Neg:\n    e: \"Expr\"\n\nExpr = Num | Add | Mul | Neg\n\ndef expr_eval(e: Expr) -> int:\n    match e:\n        case Num(n):\n            return n\n        case Add(l, r):\n            return expr_eval(l) + expr_eval(r)\n        case Mul(l, r):\n            return expr_eval(l) * expr_eval(r)\n        case Neg(inner):\n            return -expr_eval(inner)" :mutant "from dataclasses import dataclass\n\n@dataclass(frozen=True)\nclass Num:\n    n: int\n\n@dataclass(frozen=True)\nclass Add:\n    l: \"Expr\"\n    r: \"Expr\"\n\n@dataclass(frozen=True)\nclass Mul:\n    l: \"Expr\"\n    r: \"Expr\"\n\n@dataclass(frozen=True)\nclass Neg:\n    e: \"Expr\"\n\nExpr = Num | Add | Mul | Neg\n\ndef expr_eval(e: Expr) -> int:\n    match e:\n        case Num(n):\n            return n\n        case Add(l, r):\n            return expr_eval(l) - expr_eval(r)\n        case Mul(l, r):\n            return expr_eval(l) * expr_eval(r)\n        case Neg(inner):\n            return -expr_eval(inner)")
(:item :task "exprEval" :lang "ts" :calls ("exprEval({ kind: \"num\", n: 0 })" "exprEval({ kind: \"mul\", l: { kind: \"add\", l: { kind: \"num\", n: 1 }, r: { kind: \"num\", n: 2 } }, r: { kind: \"num\", n: 4 } })") :wants ("0" "12") :bug "plus" :line 12 :program "type Expr =\n  | { kind: \"num\"; n: number }\n  | { kind: \"add\"; l: Expr; r: Expr }\n  | { kind: \"mul\"; l: Expr; r: Expr }\n  | { kind: \"neg\"; e: Expr };\n\nfunction exprEval(e: Expr): number {\n  switch (e.kind) {\n    case \"num\":\n      return e.n;\n    case \"add\":\n      return exprEval(e.l) + exprEval(e.r);\n    case \"mul\":\n      return exprEval(e.l) * exprEval(e.r);\n    case \"neg\":\n      return 0 - exprEval(e.e);\n  }\n}" :mutant "type Expr =\n  | { kind: \"num\"; n: number }\n  | { kind: \"add\"; l: Expr; r: Expr }\n  | { kind: \"mul\"; l: Expr; r: Expr }\n  | { kind: \"neg\"; e: Expr };\n\nfunction exprEval(e: Expr): number {\n  switch (e.kind) {\n    case \"num\":\n      return e.n;\n    case \"add\":\n      return exprEval(e.l) - exprEval(e.r);\n    case \"mul\":\n      return exprEval(e.l) * exprEval(e.r);\n    case \"neg\":\n      return 0 - exprEval(e.e);\n  }\n}")
(:item :task "firstFailure" :lang "asl" :calls ("(firstFailure (list))" "(firstFailure (list (pair \"x\" false)))") :wants ("(none)" "(some \"x\")") :bug "" :line 0 :program "fn firstFailure checks: (List (Pair String Bool)) -> (Option String)\n  (optionMap pairFirst (listFind (fn [c] (not (pairSecond c))) checks))" :mutant "")
(:item :task "firstFailure" :lang "py" :calls ("first_failure([])" "first_failure([(\"x\", False)])") :wants ("None" "\"x\"") :bug "" :line 0 :program "def first_failure(checks: list[tuple[str, bool]]) -> str | None:\n    for name, passed in checks:\n        if not passed:\n            return name\n    return None" :mutant "")
(:item :task "firstFailure" :lang "ts" :calls ("firstFailure([])" "firstFailure([[\"x\", false]])") :wants ("undefined" "\"x\"") :bug "" :line 0 :program "function firstFailure(checks: Array<[string, boolean]>): string | undefined {\n  const hit = checks.find(([, passed]) => !passed);\n  return hit === undefined ? undefined : hit[0];\n}" :mutant "")
(:item :task "fizzbuzzLine" :lang "asl" :calls ("(fizzbuzzLine 5)" "(fizzbuzzLine 15)") :wants ("\"Buzz\"" "\"FizzBuzz\"") :bug "eq" :line 3 :program "fn fizzbuzzLine n: Int64 -> String\n  (cond\n    ((= (mod n 15) 0) \"FizzBuzz\")\n    ((= (mod n 3) 0) \"Fizz\")\n    ((= (mod n 5) 0) \"Buzz\")\n    (else (stringFromInt64 n)))" :mutant "fn fizzbuzzLine n: Int64 -> String\n  (cond\n    ((!= (mod n 15) 0) \"FizzBuzz\")\n    ((= (mod n 3) 0) \"Fizz\")\n    ((= (mod n 5) 0) \"Buzz\")\n    (else (stringFromInt64 n)))")
(:item :task "fizzbuzzLine" :lang "py" :calls ("fizzbuzz_line(5)" "fizzbuzz_line(15)") :wants ("\"Buzz\"" "\"FizzBuzz\"") :bug "eq" :line 2 :program "def fizzbuzz_line(n: int) -> str:\n    if n % 15 == 0:\n        return \"FizzBuzz\"\n    if n % 3 == 0:\n        return \"Fizz\"\n    if n % 5 == 0:\n        return \"Buzz\"\n    return str(n)" :mutant "def fizzbuzz_line(n: int) -> str:\n    if n % 15 != 0:\n        return \"FizzBuzz\"\n    if n % 3 == 0:\n        return \"Fizz\"\n    if n % 5 == 0:\n        return \"Buzz\"\n    return str(n)")
(:item :task "fizzbuzzLine" :lang "ts" :calls ("fizzbuzzLine(5)" "fizzbuzzLine(15)") :wants ("\"Buzz\"" "\"FizzBuzz\"") :bug "eq" :line 2 :program "function fizzbuzzLine(n: number): string {\n  if (n % 15 === 0) return \"FizzBuzz\";\n  if (n % 3 === 0) return \"Fizz\";\n  if (n % 5 === 0) return \"Buzz\";\n  return String(n);\n}" :mutant "function fizzbuzzLine(n: number): string {\n  if (n % 15 !== 0) return \"FizzBuzz\";\n  if (n % 3 === 0) return \"Fizz\";\n  if (n % 5 === 0) return \"Buzz\";\n  return String(n);\n}")
(:item :task "gcd" :lang "asl" :calls ("(gcd 0 0)" "(gcd 17 5)") :wants ("0" "1") :bug "" :line 0 :program "fn gcd a: Int64 b: Int64 -> Int64\n  (if (= b 0) a (gcd b (mod a b)))" :mutant "")
(:item :task "gcd" :lang "py" :calls ("gcd(0, 0)" "gcd(17, 5)") :wants ("0" "1") :bug "" :line 0 :program "def gcd(a: int, b: int) -> int:\n    while b != 0:\n        a, b = b, a % b\n    return a" :mutant "")
(:item :task "gcd" :lang "ts" :calls ("gcd(0, 0)" "gcd(17, 5)") :wants ("0" "1") :bug "" :line 0 :program "function gcd(a: number, b: number): number {\n  let x = a;\n  let y = b;\n  while (y !== 0) {\n    [x, y] = [y, x % y];\n  }\n  return x;\n}" :mutant "")
(:item :task "histogram" :lang "asl" :calls ("(histogram \"a b c a b\")" "(histogram \"b b b b a\")") :wants ("(mapFromPairs (list (pair \"a\" 2) (pair \"b\" 2)))" "(mapFromPairs (list (pair \"b\" 4)))") :bug "eq" :line 9 :program "fn tally counts: (Map String Int64) w: String -> (Map String Int64)\n  (mapSet counts w (+ (mapGetOr counts w 0) 1))\n\nfn histogram text: String -> (Map String Int64)\n  (let [(words (filter (fn [w] (not (stringEmpty? w))) (stringSplit text \" \")))\n        (counts (fold tally (mapEmpty) words))]\n    (match (listMax (mapValues counts))\n      ((none) (mapEmpty))\n      ((some top) (mapFromPairs (filter (fn [p] (= (pairSecond p) top)) (mapPairs counts))))))" :mutant "fn tally counts: (Map String Int64) w: String -> (Map String Int64)\n  (mapSet counts w (+ (mapGetOr counts w 0) 1))\n\nfn histogram text: String -> (Map String Int64)\n  (let [(words (filter (fn [w] (not (stringEmpty? w))) (stringSplit text \" \")))\n        (counts (fold tally (mapEmpty) words))]\n    (match (listMax (mapValues counts))\n      ((none) (mapEmpty))\n      ((some top) (mapFromPairs (filter (fn [p] (!= (pairSecond p) top)) (mapPairs counts))))))")
(:item :task "histogram" :lang "py" :calls ("histogram(\"a b c a b\")" "histogram(\"b b b b a\")") :wants ("{\"a\": 2, \"b\": 2}" "{\"b\": 4}") :bug "eq" :line 6 :program "def histogram(text: str) -> dict[str, int]:\n    counts: dict[str, int] = {}\n    for w in text.split():\n        counts[w] = counts.get(w, 0) + 1\n    top = max(counts.values(), default=0)\n    return {k: v for k, v in counts.items() if v == top}" :mutant "def histogram(text: str) -> dict[str, int]:\n    counts: dict[str, int] = {}\n    for w in text.split():\n        counts[w] = counts.get(w, 0) + 1\n    top = max(counts.values(), default=0)\n    return {k: v for k, v in counts.items() if v != top}")
(:item :task "histogram" :lang "ts" :calls ("histogram(\"a b c a b\")" "histogram(\"b b b b a\")") :wants ("new Map([[\"a\", 2], [\"b\", 2]])" "new Map([[\"b\", 4]])") :bug "eq" :line 9 :program "function histogram(text: string): Map<string, number> {\n  const counts = new Map<string, number>();\n  for (const w of text.split(\" \")) {\n    if (w.length > 0) counts.set(w, (counts.get(w) ?? 0) + 1);\n  }\n  const top = Math.max(0, ...counts.values());\n  const out = new Map<string, number>();\n  for (const [k, v] of counts) {\n    if (v === top) out.set(k, v);\n  }\n  return out;\n}" :mutant "function histogram(text: string): Map<string, number> {\n  const counts = new Map<string, number>();\n  for (const w of text.split(\" \")) {\n    if (w.length > 0) counts.set(w, (counts.get(w) ?? 0) + 1);\n  }\n  const top = Math.max(0, ...counts.values());\n  const out = new Map<string, number>();\n  for (const [k, v] of counts) {\n    if (v !== top) out.set(k, v);\n  }\n  return out;\n}")
