enum Instr (push n: Int64) (add) (mul) (dup) (swap)

fn topTwo stack: (List Int64) -> (Option (Pair Int64 Int64))
  (match (listGet stack 1)
    ((none) (none))
    ((some second) (some (pair (optionOr (listHead stack) 0) second))))

fn applyInstr stack: (List Int64) ins: Instr -> (Result (List Int64) String)
  (match ins
    ((push n) (ok (listAppend (list n) stack)))
    ((dup)
      (match (listHead stack)
        ((none) (err "stack underflow"))
        ((some x) (ok (listAppend (list x) stack)))))
    ((add)
      (match (topTwo stack)
        ((none) (err "stack underflow"))
        ((some p) (ok (listAppend (list (+ (pairFirst p) (pairSecond p))) (listDrop stack 2))))))
    ((mul)
      (match (topTwo stack)
        ((none) (err "stack underflow"))
        ((some p) (ok (listAppend (list (* (pairFirst p) (pairSecond p))) (listDrop stack 2))))))
    ((swap)
      (match (topTwo stack)
        ((none) (err "stack underflow"))
        ((some p) (ok (listAppend (list (pairSecond p) (pairFirst p)) (listDrop stack 2)))))))

fn runFrom stack: (List Int64) program: (List Instr) -> (Result (List Int64) String)
  (match (listHead program)
    ((none) (ok stack))
    ((some ins)
      (match (applyInstr stack ins)
        ((err e) (err e))
        ((ok next) (runFrom next (listDrop program 1))))))

fn stackMachine program: (List Instr) -> (Result Int64 String)
  (match (runFrom (list) program)
    ((err e) (err e))
    ((ok stack) (optionToResult (listHead stack) "empty stack")))
