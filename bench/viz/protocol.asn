(:vizProtocol :v 1 :id FABLE-VIZ-02 :date "2026-11-13" :questions "asl/bench/viz/questions.asn" :goal "measure whether a view lets a reader answer questions about the system without reading code; the unit is one question answered by one reader in one arm")
(:arm :id code :name "read code" :allowed "file reads, grep, awk, git log over the tree and ledgers" :forbidden "asl forms, know cards, the map" :stands "a reader with no views at all")
(:arm :id views :name "current agent views" :allowed "asl forms and commands that exist on the rev: (:intel ...), (:observe ...), (:tree), know index and cards, asl test --changed --dry-run, git log" :forbidden "reading source files, the map; grep or awk over a ledger counts as leaving the arm and is recorded as :left true" :stands "what an agent has today")
(:arm :id map :name "map" :allowed "the page written by asl run tools/map/map.asl for the same rev: the map, the package panel, the three tabs, the table; and map.asn beside it for an agent reader" :forbidden "everything else" :stands "FABLE-VIZ-01")
(:metric :id bytes :unit "bytes" :do "sum of the bytes the reader had to take in to answer: tool output for an agent; for the map the visible text of the panel or tab opened, measured as the text content of that element in the rendered page" :tokens "bytes divided by 4, an estimate; replace by (:observe :dim tokenCost) when it accepts arbitrary text")
(:metric :id steps :unit "count" :do "tool calls for an agent; clicks and tab switches for a person on the map; a search typed into the find box is one step")
(:metric :id correct :unit "right | partly | wrong" :do "graded against :pass of the question by someone other than the reader; partly means one half of a two-part question")
(:metric :id wall :unit "seconds" :optional true :do "from question shown to answer written; recorded for people, left out for agents under machine load")
(:run :order "every reader answers every question in one arm only, or the arms are taken in the order code, views, map with different questions per arm, so a reader never answers a question they already know" :readers "at least 3 per arm for a claim; one reader is a pilot and is labelled so" :record "one (:r :q ID :arm ARM :reader R :bytes N :steps N :correct C :left BOOL :how \"...\") row per answer in results-DATE.asn, with :rev and :date in the file header" :stat "median bytes and steps per arm over questions answered right; intervals from asl-stats bootstrap once there are 3 readers")
(:gate :do "the map arm cuts median bytes-to-right-answer by at least half against the views arm over the questions marked :map yes, and loses no question the views arm gets right; otherwise the map is changed" :not "a question is never rewritten to fit a view")
