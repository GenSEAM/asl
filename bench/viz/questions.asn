(:vizBench :v 1 :id FABLE-VIZ-02 :date "2026-11-13" :rev "d9a93b47d" :window "commits of the 7 days before 2026-11-13 20:11 local, reachable from d9a93b47d" :src ".asl/mem/audits/fable-20261113/visualization.asn VZ-17" :protocol "asl/bench/viz/protocol.asn" :results "asl/bench/viz/results-20261113.asn" :rule "questions and truths are fixed; when an arm scores badly the view is changed, never the question; a truth is re-derived by its :method when the rev moves and the row gets a new :rev and :date" :classes ((:id package :n 3 :ask "what does package P do and who uses it") (:id impact :n 3 :ask "what breaks if X changes") (:id gateTime :n 3 :ask "where does gate time go") (:id change :n 3 :ask "what changed this week and is it tested")))
(:q :id A1 :class package :ask "What does asl-gateway do, in one sentence, and which packages use it?" :truth "it is the single entry point to language models: it takes a request, chooses provider and model, enforces budgets and rate limits, retries and records usage; used by asl-agent and asl-forms (2 packages, both declare and import it)" :pass "names model routing or provider dispatch as the job and lists exactly asl-agent and asl-forms" :method "users: grep -rlE '\\((aslGateway|asl-gateway)[/ ]' asl/packages/*/src | cut -d/ -f3 | sort -u, minus asl-gateway itself; purpose: asl/packages/asl-gateway/src/gateway.asl and dispatch.asl module docs in doc.asn" :rev "d9a93b47d" :date "2026-11-13" :map yes)
(:q :id A2 :class package :ask "What is asl-html for and who uses it?" :truth "it builds HTML pages, CSS and SVG as typed values that are escaped on output; one package imports it: asl-forms" :pass "says typed or escaped HTML/CSS/SVG construction and lists exactly asl-forms" :method "grep -rlE '\\(asl-html[/ ]' asl/packages/*/src | cut -d/ -f3 | sort -u, minus asl-html; purpose: asl/packages/asl-html/README.md" :rev "d9a93b47d" :date "2026-11-13" :map yes)
(:q :id A3 :class package :ask "Which packages start child processes through asl-proc, and how many of them do not declare that in their manifest?" :truth "11 packages import it: asl-agent asl-conform asl-crawler asl-engine asl-forms asl-gates asl-gateway asl-harness asl-http asl-pack asl-parquet; 7 of them do not declare it: asl-conform asl-crawler asl-engine asl-gates asl-harness asl-http asl-parquet; asl-checker declares it and does not import it" :pass "the 11 importers, and 7 undeclared" :method "importers: grep -rlE '\\((aslProc|asl-proc)[/ ]' asl/packages/*/src | cut -d/ -f3 | sort -u, minus asl-proc; declared: grep -l 'asl-proc' asl/packages/*/manifest.asn" :rev "d9a93b47d" :date "2026-11-13" :map yes)
(:q :id B1 :class impact :ask "What can break if asl-parser changes: how many packages depend on it directly, how many in total, and is it part of a dependency cycle?" :truth "22 packages depend on it directly (19 import it, 3 more only declare it: asl-codegen asl-plugin asl-sql); 32 of the other 68 packages reach it through dependencies; it is on a cycle: asl-parser imports asl-syntax and asl-syntax imports asl-parser, both undeclared" :pass "direct count 19 to 22 with the import or declared split stated, total 32, and the parser and syntax cycle named" :method "direct: the A1 grep for asl-parser plus grep -l '\"asl-parser\"' asl/packages/*/manifest.asn; total: reverse reachability over the union of manifest :dependencies and module-header imports of every src file; cycle: asl/packages/asl-parser/src/fsmOutline.asl line 1 imports asl-syntax/asl/symbols, asl/packages/asl-syntax/src imports asl-parser (ecosystem.asn E-01)" :rev "d9a93b47d" :date "2026-11-13" :map yes)
(:q :id B2 :class impact :ask "Which packages use asl-json directly, and how many packages sit above it in total?" :truth "9 direct: asl-agent asl-crawler asl-engine asl-forms asl-gateway asl-harness asl-know asl-media asl-syntax; 37 packages reach it in total" :pass "the 9 names and a total of 37" :method "as B1 with asl-json" :rev "d9a93b47d" :date "2026-11-13" :map yes)
(:q :id B3 :class impact :ask "Which production code calls the function dispatchGatewayRequest?" :truth "none outside its own file: it is defined in asl/packages/asl-gateway/src/gateway.asl and named only by gatewayTest.asl and gatewayAcceptanceTest.asl" :pass "says no production caller, only two test suites" :method "grep -rln dispatchGatewayRequest asl harness tools --include='*.asl'" :rev "d9a93b47d" :date "2026-11-13" :map no :note "symbol level: the package map is not expected to answer it; it stays in the set so the map arm cannot score 12 of 12 by construction")
(:q :id C1 :class gateTime :ask "Which three test suites take the most gate time, and does each still exist?" :truth "asl/agentLoop/tests/execParityTest.asl 1949 s (file gone), asl/packages/asl-forms/tests/evalTimeoutTest.asl 1520 s (exists), tests/acceptance/engineLifetimeTest.asl 1024 s (exists)" :pass "the three suites in order with seconds within 1 percent and the first one flagged as no longer existing" :method "awk over ~/.asl/run/gateTimes.asn printing :ms and :suite, sort -rn, head -3; test -e on each path" :rev "d9a93b47d" :date "2026-11-13" :map yes)
(:q :id C2 :class gateTime :ask "How long does every suite in a row take, and what share of that is in the 20 slowest suites?" :truth "26462 s (7.4 hours) over 1509 timed suites; the 20 slowest take 12304 s, 46 percent" :pass "26462 s within 1 percent and 46 percent within 1 point" :method "awk sum of :ms over ~/.asl/run/gateTimes.asn; sum of the first 20 after sort -rn" :rev "d9a93b47d" :date "2026-11-13" :map yes)
(:q :id C3 :class gateTime :ask "Which package's own suites cost the most gate time, and how much recorded time belongs to suites whose file no longer exists?" :truth "asl-cli, 3213 s, then asl-parser 2817 s and asl-target-llvm 2817 s; 69 timed suites no longer exist and hold 3157 s" :pass "asl-cli with 3213 s within 1 percent; 69 rows and 3157 s within 1 percent" :method "awk grouping :ms by the third path segment of suites under asl/packages; a shell loop with test -e over every suite path" :rev "d9a93b47d" :date "2026-11-13" :map yes)
(:q :id D1 :class change :ask "What changed in the gateway area this week, and is it tested?" :truth "26 commits name area gateway (or gateway/...); all 26 name a gate and 25 of them change a test file; the main themes are a stale configuration made loud, adaptive admission after 429 replies and the order of search engines, with staleLoudTest and hubStatusStaleTest among the named gates" :pass "26 commits, 25 or 26 tested, and one named theme with its gate" :method "git log d9a93b47d --since='2026-11-06 20:11' --format=%s | grep -E '^\\(:c :a gateway[ /]' counted, then grep ' :g '; git show --name-only per hash filtered by /tests/ or Test.asl" :rev "d9a93b47d" :date "2026-11-13" :map yes)
(:q :id D2 :class change :ask "Which package had the most commits this week and which came second and third?" :truth "asl-agent 108 commits, asl-cli 46, asl-gateway 40 (asl-know 31 is fourth)" :pass "the three names in order with counts within 2" :method "git log d9a93b47d --since='2026-11-06 20:11' --oneline -- asl/packages/P | wc -l for every package" :rev "d9a93b47d" :date "2026-11-13" :map yes)
(:q :id D3 :class change :ask "Did asl-parser change this week, and which gates do those commits name?" :truth "7 commits touched it; named gates include schemaDefaultTest (2 commits), indentParserTest, selfParseTest, printHostValidShard1Test, unknownTypeSignatureTest and noSelfHostTest; every one of the 7 names a gate" :pass "7 commits, all gated, and at least three of the gate names" :method "git log d9a93b47d --since='2026-11-06 20:11' --format='%h %s' -- asl/packages/asl-parser" :rev "d9a93b47d" :date "2026-11-13" :map yes)
