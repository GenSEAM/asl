(:effects :id agentLoopMvp :version "1.0"
  :doc "Effect classification for agent loop operations. Each op has a class: :local (runs freely), :outward or :needsConfirm (not executed: answered with a :needsConfirm receipt, the run goes on). Ops not listed here produce ERR_EFFECT_UNDECLARED."
  :entries (
    (:effect :op "read" :class :local :doc "Read file content")
    (:effect :op "query" :class :local :doc "Search workspace")
    (:effect :op "write" :class :local :doc "Write a file at once inside :owns, as one (:txn)")
    (:effect :op "edit" :class :local :doc "Replace a string in a file at once inside :owns, as one (:txn)")
    (:effect :op "check" :class :local :doc "Check delimiter balance")
    (:effect :op "diff" :class :local :doc "Show the session's staged changes (a write or edit step stages none)")
    (:effect :op "flush" :class :local :doc "Persist staged changes; a no-op after write and edit steps, which persist at once")
    (:effect :op "discard" :class :local :doc "Drop staged changes; a written or edited file is not restored by it")
    (:effect :op "test" :class :local :doc "Run ASL test")
    (:effect :op "tree" :class :local :doc "List directory tree")
    (:effect :op "observe" :class :local :doc "Read-only projection through bin/asl (:observe :dim d): callers, status, coverage, tokenCost, memory or session")
    (:effect :op "outline" :class :local :doc "A file's defs and classes with line spans, through (:intel :op outline)")
    (:effect :op "intel" :class :local :doc "Read-only code intelligence (:intel :op outline|impact|coupling|graph|deadcode|complexity|stubs|query); trace and vitality are not offered")
    (:effect :op "fix" :class :local :doc "Propose delimiter repair")
    (:effect :op "txn" :class :local :doc "Transactional edits inside :owns")
    (:effect :op "tools" :class :local :doc "Introspect tool registry")
    (:effect :op "help" :class :local :doc "Show op help")
    (:effect :op "findings" :class :local :doc "Scout findings reply")
    (:effect :op "step" :class :local :doc "Generic step wrapper")
    (:effect :op "evidence" :class :local :doc "Evidence claim")
    (:effect :op "escalate" :class :local :doc "Escalation signal")
    (:effect :op "done" :class :local :doc "Terminal done signal")
    (:effect :op "gitDiff" :class :local :doc "Show git diff for path against base rev or working tree")
    (:effect :op "gitLog" :class :local :doc "Show git commit log")
    (:effect :op "gitShow" :class :local :doc "Show git object or commit at rev")
    (:effect :op "note" :class :local :doc "Replace the session note, sent whole in every message; over the cap it is rejected and unchanged")
    (:effect :op "delete" :class :local :doc "Remove a file inside :owns; kept for hand-back like a write, so a run that does not end :ok restores it")
    (:effect :op "run" :class :local :doc "Run a command through sh -c in the workspace, bounded by the step timeout; paths it changes outside :owns are restored; push, publish, request bodies and rm/mv outside :owns answer needsConfirm")
    (:effect :op "gate" :class :local :doc "Run the principal-declared gate commands (all, or :n i from 1) with the end-of-run env and timeout; answers exit and output tail, never ends the run")
    (:effect :op "push" :class :needsConfirm :doc "Git push — outward, irreversible")
    (:effect :op "search" :class :local :doc "Web search — observational")
    (:effect :op "research" :class :local :doc "Deep research — observational")
    (:effect :op "crawl" :class :local :doc "Web crawl — observational")
    (:effect :op "manage" :class :local :doc "This run's processes through the engine: spawn in the workspace, poll, tail, send to stdin, kill, list; changes outside :owns are restored when a process is seen finished and at turn end; every process is killed when the run ends")
    (:effect :op "engine" :class :needsConfirm :doc "Engine control — outward")
    (:effect :op "job" :class :needsConfirm :doc "Job dispatch — outward")
    (:effect :op "agent" :class :needsConfirm :doc "Nested agent dispatch — outward")
  )
)
