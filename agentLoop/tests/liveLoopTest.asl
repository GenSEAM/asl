(module asl/agentLoop/tests/liveLoopTest
  :x [runTests]
  :i [(asl/agentLoop/core :a c)])

fn shellQuote s: String -> String
  (str "'" (stringReplace s "'" "'\\''") "'")

fn ! resolveHost hOpt: (Option String) defaultRel: String -> (Option String)
  (match hOpt
    ((some h) (if (fileExists? h)
                (some (resultOr (realPath h) h))
                (do (println (str "invalid environment variable: ASL_HOST path does not exist: " h))
                    (assert false (str "invalid environment variable: ASL_HOST path does not exist: " h))
                    (none))))
    ((none) (let [p (resultOr (realPath defaultRel) defaultRel)]
              (if (fileExists? p)
                (some p)
                (do (println (str "the stage-0 host is absent at " p "; build it with sh asl/host/build.sh or set ASL_HOST"))
                    (assert false (str "the stage-0 host is absent at " p "; build it with sh asl/host/build.sh or set ASL_HOST"))
                    (none))))))

fn ! host -> (Option String)
  (resolveHost (envGet "ASL_HOST") "bin/asl")

fn ! tempDir -> String
  (stringTrim (processRun "mktemp -d /tmp/asl-live-loop-XXXXXX").stdout)

fn ! write path: String text: String -> Bool
  (ok? (fileWrite path text))

fn ! readOr path: String -> String
  (resultOr (fileReadString path) "")

fn attemptNsAt text: String from: Int64 -> Int64
  (let [tail (optionOr (stringSlice text from (stringLength text)) "")
        marker (stringIndexOf tail ":ns ")]
    (match marker
      ((none) 0)
      ((some at)
        (let [nums (optionOr (stringSlice tail (+ at 4) (stringLength tail)) "")
              end (optionOr (stringIndexOf nums ")") (stringLength nums))]
          (optionOr (stringToInt64 (optionOr (stringSlice nums 0 end) "")) 0)))))

fn ! stageFixture root: String name: String -> Bool
  (let [fixture (str "asl/agentLoop/tests/fixtures/liveLoop/" name ".asn")
        target (str root "/tests/fixtures/agentLoop/mvp/" name ".asn")]
    (match (fileReadString fixture)
      ((err _) false)
      ((ok text) (write target text))))

fn ! initCommitRepo root: String initial: String -> Bool
  (and (write (str root "/subject.txt") initial)
    (and (= (processRun (str "git -C " (shellQuote root) " init -q -b main")).exitCode 0)
      (and (= (processRun (str "git -C " (shellQuote root) " config user.name liveLoop")).exitCode 0)
        (and (= (processRun (str "git -C " (shellQuote root) " config user.email live-loop@example.invalid")).exitCode 0)
          (and (= (processRun (str "git -C " (shellQuote root) " add -- subject.txt")).exitCode 0)
            (and (= (processRun (str "git -C " (shellQuote root) " commit -q -m initial")).exitCode 0)
              (write (str root "/unrelated.txt") "outside\n")))))))

fn ! initGateScript root: String -> Bool
  (and (write (str root "/test.sh") "#!/bin/sh\ngrep -qx green subject.txt\n")
    (and (= (processRun (str "chmod +x " (shellQuote (str root "/test.sh")))).exitCode 0)
      (and (= (processRun (str "git -C " (shellQuote root) " add -- test.sh")).exitCode 0)
        (= (processRun (str "git -C " (shellQuote root) " commit -q -m gate")).exitCode 0))))

fn fieldAfter text: String key: String -> String
  (match (stringIndexOf text key)
    ((none) "")
    ((some at)
      (let [start (+ at (stringLength key))
            rest (c/sliceOf text start (stringLength text))]
        (match (stringIndexOf rest "\"") ((some e) (c/sliceOf rest 0 e)) ((none) "")))))

fn ! runMain root: String task: String backend: String extra: String -> ProcessOutput
  (match (host)
    ((none) (processRun "exit 127"))
    ((some h)
     (let [form (str "(:agent :task \"" task "\" :backend \"script/" backend "\" :root \"" root "\" " extra ")")
           prefix (str "ASL_HOST=" (shellQuote h) " ASL_ROOT_DIR=" (shellQuote (resultOr (realPath ".") ".")) " ")
           driver (resultOr (realPath "asl/agentLoop/tests/mainDriver.asl") "asl/agentLoop/tests/mainDriver.asl")
           args (str (shellQuote h) " run " (shellQuote driver) " " (shellQuote form))
           niceProbe (processRun "nice -n 15 true 2>&1")
           niceOk (and (= niceProbe.exitCode 0)
                       (not (stringContains? (str niceProbe.stdout niceProbe.stderr) "Operation not permitted")))]
       (processRun (str prefix (if niceOk (str "nice -n 15 " args) args))))))

fn ! runTests -> Bool
  (match (host)
    ((none) false)
    ((some _)
  (let [oneRoot (tempDir)
        editRoot (tempDir)
        capRoot (tempDir)
        redRoot (tempDir)
        emptyRoot (tempDir)
        commitRoot (tempDir)
        integrityRoot (tempDir)
        findingsRoot (tempDir)
        rejectedRoot (tempDir)
        confirmRoot (tempDir)
        threeRoot (tempDir)
        taskCommitRoot (tempDir)
        baselineReadRoot (tempDir)
        fixtureDirs (and (ok? (dirCreate (str oneRoot "/tests/fixtures/agentLoop/mvp")))
          (and (ok? (dirCreate (str editRoot "/tests/fixtures/agentLoop/mvp")))
            (and (ok? (dirCreate (str capRoot "/tests/fixtures/agentLoop/mvp")))
              (and (ok? (dirCreate (str redRoot "/tests/fixtures/agentLoop/mvp")))
                (and (ok? (dirCreate (str emptyRoot "/tests/fixtures/agentLoop/mvp")))
                  (and (ok? (dirCreate (str commitRoot "/tests/fixtures/agentLoop/mvp")))
                    (and (ok? (dirCreate (str integrityRoot "/tests/fixtures/agentLoop/mvp")))
                      (and (ok? (dirCreate (str findingsRoot "/tests/fixtures/agentLoop/mvp")))
                        (and (ok? (dirCreate (str rejectedRoot "/tests/fixtures/agentLoop/mvp")))
                             (and (ok? (dirCreate (str confirmRoot "/tests/fixtures/agentLoop/mvp")))
                             (ok? (dirCreate (str threeRoot "/tests/fixtures/agentLoop/mvp")))))))))))))
        taskCommitDir (ok? (dirCreate (str taskCommitRoot "/tests/fixtures/agentLoop/mvp")))
        baselineReadDir (ok? (dirCreate (str baselineReadRoot "/tests/fixtures/agentLoop/mvp")))
        fixtures (and (stageFixture oneRoot "one")
          (and (stageFixture editRoot "edit") (and (stageFixture capRoot "cap")
            (and (stageFixture redRoot "red") (and (stageFixture emptyRoot "empty")
              (and (stageFixture commitRoot "commit")
                (and (stageFixture integrityRoot "integrity")
                  (and (stageFixture findingsRoot "findings")
                    (and (stageFixture rejectedRoot "rejected") (and (stageFixture confirmRoot "confirm")
                      (and (stageFixture threeRoot "three")
                          (and (stageFixture threeRoot "retryTiming")
                          (and (stageFixture threeRoot "missingReviewer")
                            (and (stageFixture threeRoot "missingAdvisor")
                            (write (str threeRoot "/tests/fixtures/agentLoop/mvp/retryTiming.asn.attempts") "")))))))))))))))
        extraFixtures (and taskCommitDir (and baselineReadDir
          (and (write (str taskCommitRoot "/tests/fixtures/agentLoop/mvp/taskCommit.asn")
                     "(:script :id \"liveLoopTaskCommit\" :mode :implement\n  :turns (\n    (:turn :num 1 :reply \"(:step :op \\\"write\\\" :file \\\"subject.txt\\\" :content \\\"green\\\\n\\\")\")\n    (:turn :num 2 :reply \"(:step :op \\\"write\\\" :file \\\"subject.txt\\\" :content \\\"green\\\\n\\\") (:done :commit \\\"(:c :a agentLoop :do \\\\\\\"live commit\\\\\\\" :g \\\\\\\"liveLoopTest 15 assertions\\\\\\\")\\\")\")\n  )\n)\n")
            (write (str baselineReadRoot "/tests/fixtures/agentLoop/mvp/baselineGreenRead.asn")
                   "(:script :id \"liveLoopBaselineGreenRead\" :mode :implement\n  :turns (\n    (:turn :num 1 :reply \"(:step :op \\\"read\\\" :file \\\"subject.txt\\\")\")\n    (:turn :num 2 :reply \"(:done)\")\n  )\n)\n"))))
        cfgOff (fold (fn [acc r] (and acc (write (str r "/.asl.config.asn") "(:aslConfig :agentLoop (:specCheck false))\n")))
                 true (list oneRoot editRoot capRoot redRoot emptyRoot commitRoot integrityRoot findingsRoot rejectedRoot confirmRoot threeRoot taskCommitRoot baselineReadRoot))
        editReady (and cfgOff (and fixtures (initCommitRepo editRoot "before\n")))
        redReady (and fixtures (initCommitRepo redRoot "before\n"))
        threeReady (and fixtures (initCommitRepo threeRoot "before\n"))
        commitReady (and fixtures (initCommitRepo commitRoot "before\n"))
        integrityReady (and fixtures (and (initCommitRepo integrityRoot "green\n") (initGateScript integrityRoot)))
        successfulOne (runMain oneRoot "one-turn answer" "one" "")
        findings (runMain findingsRoot "report findings" "findings" ":mode \"scout\"")
        rejected (runMain rejectedRoot "reject an owned harness-path write" "rejected" ":mode \"implement\" :owns (\"subject.txt\" \".asl/run/**\") :budget 1")
        rejectedSession (fieldAfter rejected.stdout ":session \"")
        rejectedJournal (readOr (str rejectedRoot "/.asl/run/agentLoop/" rejectedSession ".journal"))
        outsideFixture (write (str rejectedRoot "/tests/fixtures/agentLoop/mvp/rejected.asn")
          "(:script :id \"liveLoopRejectedOutside\" :mode :implement\n  :turns ((:turn :num 1 :reply \"(:step :op \\\"write\\\" :file \\\"outside-secret.txt\\\" :content \\\"bad\\\\n\\\") (:done)\"))\n)\n")
        outside (runMain rejectedRoot "reject a write outside owns" "rejected" ":mode \"implement\" :owns (\"subject.txt\") :budget 1")
        confirm (runMain confirmRoot "request confirmation for outward effect" "confirm" ":mode \"implement\" :budget 1")
        one (runMain oneRoot "patch delivery needs a write" "one" ":mode \"implement\" :budget 1 :plan true")
        oneSession (fieldAfter one.stdout ":session \"")
        oneJournal (readOr (str oneRoot "/.asl/run/agentLoop/" oneSession ".journal"))
        edited (runMain editRoot "write then gate" "edit" ":mode \"implement\" :owns (\"subject.txt\") :gates (\"grep -qx green subject.txt\")")
        editSession (fieldAfter edited.stdout ":session \"")
        editJournal (readOr (str editRoot "/.asl/run/agentLoop/" editSession ".journal"))
        red (runMain redRoot "red gate" "red" ":mode \"implement\" :owns (\"subject.txt\") :gates (\"grep -qx green subject.txt\") :budget 1")
        redSession (fieldAfter red.stdout ":session \"")
        redJournal (readOr (str redRoot "/.asl/run/agentLoop/" redSession ".journal"))
        wallRoot (tempDir)
        wallSetup (and (ok? (dirCreate (str wallRoot "/tests/fixtures/agentLoop/mvp")))
                    (and (stageFixture wallRoot "edit")
                      (and (write (str wallRoot "/.asl.config.asn") "(:aslConfig :agentLoop (:specCheck false :baseline false :wallReserveSec 60 :wallGateMinSec 50))\n")
                        (initCommitRepo wallRoot "before\n"))))
        wallRun (runMain wallRoot "stop before a gate the wall cannot hold" "edit" ":mode \"implement\" :owns (\"subject.txt\") :gates (\"touch gate.ran && grep -qx green subject.txt\") :wallBudget 100")
        wallGateRan (fileExists? (str wallRoot "/gate.ran"))
        wallJournal (readOr (str wallRoot "/.asl/run/agentLoop/" (fieldAfter wallRun.stdout ":session \"") ".journal"))
        gateOpFixture (write (str wallRoot "/tests/fixtures/agentLoop/mvp/wallGateOp.asn")
                        "(:script :id \"liveLoopWallGateOp\" :mode :implement\n  :turns (\n    (:turn :num 1 :reply \"(:step :op \\\"gate\\\")\")\n  )\n)\n")
        gateOpRun (runMain wallRoot "a gate op the wall cannot hold" "wallGateOp" ":mode \"implement\" :owns (\"subject.txt\") :gates (\"touch gate.ran && grep -qx green subject.txt\") :wallBudget 100")
        gateOpRan (fileExists? (str wallRoot "/gate.ran"))
        gateOpJournal (readOr (str wallRoot "/.asl/run/agentLoop/" (fieldAfter gateOpRun.stdout ":session \"") ".journal"))
        wallCleaned (ok? (pathRemove wallRoot))
        empty (runMain emptyRoot "retry an empty parsed reply" "empty" ":mode \"implement\" :owns (\"subject.txt\") :budget 3")
        emptySession (fieldAfter empty.stdout ":session \"")
        emptyJournal (readOr (str emptyRoot "/.asl/run/agentLoop/" emptySession ".journal"))
        parseFixture (write (str emptyRoot "/tests/fixtures/agentLoop/mvp/parseStop.asn")
                       (str "(:script :id \"liveLoopParseStop\" :mode :implement\n  :turns (\n"
                            (stringJoin (map (fn [n] (str "    (:turn :num " (stringFromInt64 n) " :reply \"\")\n")) (range 1 13)) "")
                            "  )\n)\n"))
        parseStop (runMain emptyRoot "stop on repeated parse defects" "parseStop" ":mode \"implement\" :owns (\"subject.txt\") :budget 20")
        committed (runMain commitRoot "commit only the live write" "commit" ":mode \"implement\" :owns (\"subject.txt\")")
        commitSession (fieldAfter committed.stdout ":session \"")
        commitJournal (readOr (str commitRoot "/.asl/run/agentLoop/" commitSession ".journal"))
        commitFiles (processRun (str "git -C " (shellQuote commitRoot) " show --pretty=format: --name-only HEAD")).stdout
        commitStatus (processRun (str "git -C " (shellQuote commitRoot) " status --short")).stdout
        integrity (runMain integrityRoot "reject gate that stays green after reverting the patch" "integrity" ":mode \"implement\" :owns (\"subject.txt\") :gates (\"./test.sh\")")
        three (runMain threeRoot "three turns keep the transcript" "three" ":mode \"implement\" :owns (\"subject.txt\") :gates (\"grep -qx green subject.txt\")")
        timing (runMain threeRoot "retry timing" "retryTiming" ":mode \"implement\" :budget 2")
        timingLog (readOr (str threeRoot "/tests/fixtures/agentLoop/mvp/retryTiming.asn.attempts"))
        timingFirstMarker (optionOr (stringIndexOf timingLog "(:attempt") 0)
        timingRest (optionOr (stringSlice timingLog (+ timingFirstMarker 1) (stringLength timingLog)) "")
        timingSecondOffset (optionOr (stringIndexOf timingRest "(:attempt") 0)
        timingFirstNs (attemptNsAt timingLog timingFirstMarker)
        timingSecondNs (attemptNsAt timingRest timingSecondOffset)
        missingReviewer (runMain threeRoot "reviewer result required" "missingReviewer" ":mode \"review\" :intent \"reinforce\"")
        missingReviewerSession (fieldAfter missingReviewer.stdout ":session \"")
        missingReviewerJournal (readOr (str threeRoot "/.asl/run/agentLoop/" missingReviewerSession ".journal"))
        missingAdvisor (runMain threeRoot "advisor result required" "missingAdvisor" ":mode \"review\" :intent \"reinforce\"")
        missingAdvisorSession (fieldAfter missingAdvisor.stdout ":session \"")
        missingAdvisorJournal (readOr (str threeRoot "/.asl/run/agentLoop/" missingAdvisorSession ".journal"))
        threeSession (fieldAfter three.stdout ":session \"")
        threeJournal (readOr (str threeRoot "/.asl/run/agentLoop/" threeSession ".journal"))
        threeFile (readOr (str threeRoot "/subject.txt"))
        threeSent3 (match (stringIndexOf threeJournal "(:turn 3 :sent ") ((some at) (c/sliceOf threeJournal at (stringLength threeJournal))) ((none) ""))
        threeSent2 (match (stringIndexOf threeJournal "(:turn 2 :sent ") ((some at) (c/sliceOf threeJournal at (stringLength threeJournal))) ((none) ""))
        cap (runMain capRoot "budget boundary" "cap" ":budget 1")
        capSession (fieldAfter cap.stdout ":session \"")
        capJournal (readOr (str capRoot "/.asl/run/agentLoop/" capSession ".journal"))
        editedFile (readOr (str editRoot "/subject.txt"))
        closeRoot (tempDir)
        closeFixtureDir (and (ok? (dirCreate (str closeRoot "/tests/fixtures/agentLoop/mvp"))) (write (str closeRoot "/.asl.config.asn") "(:aslConfig :agentLoop (:specCheck false))\n"))
        closeFixtureStaged (and closeFixtureDir (stageFixture closeRoot "closeOnGreen"))
        closeReady (and closeFixtureStaged (initCommitRepo closeRoot "before\n"))
        close (runMain closeRoot "close on green gate without an explicit done" "closeOnGreen"
          ":mode \"implement\" :owns (\"subject.txt\") :gates (\"grep -qx green subject.txt\") :budget 5")
        closeSession (fieldAfter close.stdout ":session \"")
        closeJournal (readOr (str closeRoot "/.asl/run/agentLoop/" closeSession ".journal"))
        closeFile (readOr (str closeRoot "/subject.txt"))
        taskCommitReady (and extraFixtures (initCommitRepo taskCommitRoot "before\n"))
        taskCommit (runMain taskCommitRoot "fix add and COMMIT" "taskCommit"
          ":mode \"implement\" :owns (\"subject.txt\") :gates (\"grep -qx green subject.txt\") :budget 5 :commit true")
        taskCommitSession (fieldAfter taskCommit.stdout ":session \"")
        taskCommitJournal (readOr (str taskCommitRoot "/.asl/run/agentLoop/" taskCommitSession ".journal"))
        taskCommitFiles (processRun (str "git -C " (shellQuote taskCommitRoot) " show --pretty=format: --name-only HEAD")).stdout
        taskCommitSubject (processRun (str "git -C " (shellQuote taskCommitRoot) " log -1 --format=%s")).stdout
        baselineReadReady (and extraFixtures (initCommitRepo baselineReadRoot "green\n"))
        baselineRead (runMain baselineReadRoot "read green baseline" "baselineGreenRead"
          ":mode \"implement\" :owns (\"subject.txt\") :gates (\"grep -qx green subject.txt\") :budget 1")
        baselineReadSession (fieldAfter baselineRead.stdout ":session \"")
        baselineReadJournal (readOr (str baselineReadRoot "/.asl/run/agentLoop/" baselineReadSession ".journal"))
        capsRoot (tempDir)
        capsDir (and (ok? (dirCreate (str capsRoot "/tests/fixtures/agentLoop/mvp"))) (write (str capsRoot "/.asl.config.asn") "(:aslConfig :agentLoop (:specCheck false))\n"))
        capsFixtures (and capsDir
          (and (write (str capsRoot "/tests/fixtures/agentLoop/mvp/retryEmpty.asn")
                 "(:script :id \"liveLoopRetryEmpty\" :mode :implement :attemptLog \"enabled\"\n  :turns (\n    (:turn :num 1 :error \"ERR_NO_REPLY\")\n    (:turn :num 2 :reply \"(:done)\")\n  )\n)\n")
            (and (write (str capsRoot "/tests/fixtures/agentLoop/mvp/retryEmpty.asn.attempts") "")
              (and (write (str capsRoot "/tests/fixtures/agentLoop/mvp/retryPermanent.asn")
                     "(:script :id \"liveLoopRetryPermanent\" :mode :implement :attemptLog \"enabled\"\n  :turns (\n    (:turn :num 1 :error \"ERR_BAD_REQUEST\")\n    (:turn :num 2 :reply \"(:done)\")\n  )\n)\n")
                (write (str capsRoot "/tests/fixtures/agentLoop/mvp/retryPermanent.asn.attempts") "")))))
        capsReady (and capsFixtures (initCommitRepo capsRoot "before\n"))
        capsEmpty (runMain capsRoot "empty body is transient" "retryEmpty" ":mode \"implement\" :budget 2")
        capsEmptySession (fieldAfter capsEmpty.stdout ":session \"")
        capsEmptyJournal (readOr (str capsRoot "/.asl/run/agentLoop/" capsEmptySession ".journal"))
        capsPermanent (runMain capsRoot "bad request is permanent" "retryPermanent" ":mode \"implement\" :budget 2")
        capsPermanentSession (fieldAfter capsPermanent.stdout ":session \"")
        capsPermanentJournal (readOr (str capsRoot "/.asl/run/agentLoop/" capsPermanentSession ".journal"))
        capsPermanentAttempts (readOr (str capsRoot "/tests/fixtures/agentLoop/mvp/retryPermanent.asn.attempts"))
        cleaned (listAll? (fn [r] (ok? (pathRemove r)))
          (list oneRoot editRoot capRoot redRoot emptyRoot commitRoot integrityRoot findingsRoot rejectedRoot confirmRoot threeRoot closeRoot taskCommitRoot baselineReadRoot capsRoot))]
    (do
      (assert fixtureDirs "temporary roots have the recorded-provider fixture directory")
      (assert fixtures "all deterministic provider recordings are installed")
      (assert editReady "the live gate scenario has a tracked baseline")
      (assert redReady "the red-gate scenario has a tracked non-green baseline")
      (assert commitReady "the live commit scenario has a baseline and unrelated untracked file")
      (assert integrityReady "the gate-integrity scenario has a tracked green baseline")
      (assert (and (= red.exitCode 1) (stringContains? red.stdout ":status :escalated")
                   (not (stringContains? redJournal "(:gateIntegrity :ok"))
                   (stringContains? redJournal "(:gate :cmd \"grep -qx green subject.txt\" :exit 1)\n"))
              "done cannot succeed while a declared gate is red")
      (assert (and (= successfulOne.exitCode 0) (stringContains? successfulOne.stdout ":status :ok")
                   (stringContains? successfulOne.stdout ":turns 1"))
              "a successful one-turn answer is terminal")
      (assert (and (= findings.exitCode 0) (stringContains? findings.stdout ":status :ok")
                   (stringContains? findings.stdout ":findings ((:findings")
                   (stringContains? findings.stdout ":turns 1"))
              "a scout findings reply completes and appears in the receipt")
      (assert (and (= rejected.exitCode 1) (stringContains? rejected.stdout ":status :escalated")
                   (stringContains? rejectedJournal ".asl/run/agentLoop/intruder.txt")
                   (not (stringContains? rejected.stdout ":written (\".asl/run/agentLoop/intruder.txt\")"))
                   (not (fileExists? (str rejectedRoot "/.asl/run/agentLoop/intruder.txt"))))
              "the live provider's harness-path write attempt is preserved and never persists")
      (assert (and outsideFixture (= outside.exitCode 1) (stringContains? outside.stdout ":status :escalated")
                   (not (stringContains? outside.stdout ":written (\"outside-secret.txt\")"))
                   (stringContains? outside.stdout ":ownsRejected ((:turn 1 :op \"write\" :file \"outside-secret.txt\" :error ERR_OWNS))")
                   (= (readOr (str rejectedRoot "/outside-secret.txt")) ""))
              "a live scripted out-of-owns write is rejected, structured and not persisted")
      (assert (and (= confirm.exitCode 1) (stringContains? confirm.stdout ":needsConfirm ((:op \"push\" :blocked true))"))
              "a live receipt retains the confirmation requirement from its real op result")
      (assert (and (= one.exitCode 1) (stringContains? one.stdout ":status :escalated")
                   (stringContains? one.stdout ":deliver :patch"))
              "patch delivery cannot succeed without a persisted write")
      (assert (stringContains? one.stdout ":plan (:steps 1 :done 0 :dropped 0 :revisions 0)")
              "plan state returned by the scripted live provider reaches the receipt")
      (assert (and (stringContains? one.stdout ":phases () :session \"")
                   (stringContains? one.stdout ":journal \".asl/run/agentLoop/")
                   (stringContains? one.stdout ":unbacked 0 :contextTokens ")
                   (stringContains? one.stdout ":turns 1")
                   (stringContains? one.stdout ":findings () :batching ("))
              "failed patch receipt retains main's session, journal, accounting and result fields")
      (assert (and (stringContains? one.stdout ":turns 1")
                   (stringContains? oneJournal "(:turn 1 :reply")
                   (stringContains? oneJournal "(:result :status :escalated"))
              "unwritten patch run journals its reply and escalated result")
      (assert (and (= edited.exitCode 0) (stringContains? edited.stdout ":status :ok"))
              "two-turn write and passing gate reaches a successful live receipt")
      (assert (and (= editedFile "green\n")
                   (stringContains? edited.stdout ":turns 2")
                   (stringContains? editJournal "(:turn 1 :reply")
                   (stringContains? editJournal "(:turn 2 :reply")
                   (stringContains? editJournal "(:gate :cmd \"grep -qx green subject.txt\" :exit 1)\n")
                   (stringContains? editJournal "(:gate :cmd \"grep -qx green subject.txt\" :exit 0)\n")
                   (stringContains? editJournal "(:result :status :ok"))
              "two-turn run persists the asl write, records both replies and the passing gate")
      (assert (stringContains? editJournal " :got") "the second provider turn receives the prior turn transcript")
      (assert (stringContains? editJournal "(:receipt :id") "the second provider turn receives the prior operation receipt")
      (assert (stringContains? edited.stdout ":written (\"subject.txt\")") "the live receipt reports its snapshotted file write")
      (assert (and (= committed.exitCode 0) (stringContains? committed.stdout ":status :ok")
                   (stringContains? commitFiles "subject.txt") (not (stringContains? commitFiles "unrelated.txt"))
                   (stringContains? commitStatus "?? unrelated.txt")
                   (stringContains? commitJournal "(:commit "))
              "live commit includes only the written path and preserves unrelated work")
      (assert (and (= integrity.exitCode 1) (not (stringContains? integrity.stdout ":status :ok")))
              "gate integrity rejects a green verdict that remains green after reverting the write")
      (assert (and (= empty.exitCode 0) (stringContains? empty.stdout ":status :ok")
                   (stringContains? empty.stdout ":turns 2")
                   (stringContains? emptyJournal "(:turn 1 :parse-defect true)")
                   (stringContains? emptyJournal "retry with a valid operation"))
              "an empty operations reply is journalled as a parse defect and retried")
      (assert (and (= cap.exitCode 1) (stringContains? cap.stdout ":status :escalated"))
              "explicit budget one exhausts the live turn boundary")
      (assert threeReady "the three-turn scenario has a tracked baseline")
      (assert (and (= three.exitCode 0) (stringContains? three.stdout ":status :ok")
                   (stringContains? three.stdout ":turns 3")
                   (= threeFile "green\n"))
              "a three-turn run completes with the final write on disk")
      (assert (>= (- timingSecondNs timingFirstNs) 1000000000)
              "timestamps inside the scripted provider show the configured one-second retry wait")
      (assert (and (= missingAdvisor.exitCode 1)
                   (stringContains? missingAdvisor.stdout ":status :failed")
                   (stringContains? missingAdvisorJournal
                     "(:liveHook :turn 1 :name \"advisor\" :error \"ERR_NO_ADVISOR_CHANNEL provider has no advisor channel\")"))
              "a missing advisor result is a typed journal error and fails the live receipt")
      (assert (and (= missingReviewer.exitCode 1)
                   (stringContains? missingReviewer.stdout ":status :failed")
                   (stringContains? missingReviewerJournal
                     "(:liveHook :turn 1 :name \"reviewer\" :error \"ERR_NO_REVIEWER_CHANNEL provider has no reviewer channel\")"))
              "a missing reviewer result is a typed journal error and fails the live receipt")
      (assert (stringContains? threeSent2 "(:turn 1 :sent \\\"Task")
              "turn 2 is sent the transcript holding turn 1")
      (assert (and (stringContains? threeSent3 "(:turn 1 :sent \\\"Task") (stringContains? threeSent3 "(:turn 2 :sent \\\"Task"))
              "turn 3 is still sent the transcript holding both turn 1 and turn 2")
      (assert (and (stringContains? cap.stdout ":turns 2")
                   (not (stringContains? cap.stdout ":turns 1 "))
                   (stringContains? cap.stdout "budget exhausted after 1 turns"))
              "budget exhaustion reports Python's budget plus one in :turns and the reason")
      (assert (and (stringContains? cap.stdout ":status :escalated")
                   (stringContains? capJournal "(:turn 1 :reply")
                   (not (stringContains? capJournal "(:turn 2 :reply"))
                   (stringContains? capJournal "(:result :status :escalated"))
              "turn-cap exhaustion preserves its final turn and terminal journal row")
      (assert (and (stringContains? cap.stdout ":status :escalated :stop turnBudget")
                   (stringContains? cap.stdout ":lastStep (:turn 1 :op \"note\")"))
              (str "a session ended by its turn budget carries :stop turnBudget and its last step: " cap.stdout))
      (assert (and parseFixture (stringContains? parseStop.stdout ":stop parseDefect")
                   (stringContains? parseStop.stdout ":op \"empty\")"))
              (str "a session ended by parse defects carries :stop parseDefect: " parseStop.stdout))
      (assert (and wallSetup (and (stringContains? wallRun.stdout ":status :escalated :stop wallBudget")
                   (and (stringContains? wallJournal "(:turn 1 :signal :wallBudget")
                        (and (not (stringContains? wallJournal "(:gate :cmd")) (not wallGateRan)))))
              (str "with :wallReserveSec 60 of a 100 s wall and :wallGateMinSec 50 the run ends with :stop wallBudget before its gate: " wallRun.stdout))
      (assert (and gateOpFixture (and (stringContains? gateOpRun.stdout ":stop wallBudget")
                   (and (stringContains? gateOpJournal "(:turn 1 :signal :wallBudget") (not gateOpRan))))
              (str "the model's own gate op under the same wall rule is not started and the run ends with :stop wallBudget: " gateOpRun.stdout))
      (assert wallCleaned "the wall scenario root is removed")
      (assert closeReady "the close-on-green scenario has a tracked baseline")
      (assert (and (= close.exitCode 0) (stringContains? close.stdout ":status :ok"))
              "a patch whose declared gate goes green closes ok without an explicit (:done)")
      (assert (and (stringContains? close.stdout ":turns 2") (= closeFile "green\n"))
              "closing on green stops at the first green-after-deliver turn and never spends the rest of the budget")
      (assert (and (stringContains? closeJournal "(:gate :cmd \"grep -qx green subject.txt\" :exit 1)\n")
                   (stringContains? closeJournal "(:gate :cmd \"grep -qx green subject.txt\" :exit 0)\n")
                   (not (stringContains? closeJournal "(:turn 3 :reply"))
                   (not (stringContains? closeJournal "(:escalate")))
              "closing on green never reaches a third turn and never escalates")
      (assert (not (stringContains? close.stdout ":restored"))
              "closing on green keeps the written patch instead of handing back a restore")
      (assert taskCommitReady "the task-requested commit scenario has a tracked baseline and fixtures")
      (assert (and (= taskCommit.exitCode 0) (stringContains? taskCommit.stdout ":status :ok")
                   (stringContains? taskCommit.stdout ":turns 2")
                   (stringContains? taskCommitJournal "(:turn 1 :reply")
                   (stringContains? taskCommitJournal "(:turn 2 :reply")
                   (stringContains? taskCommitJournal "(:commit ")
                   (stringContains? taskCommitFiles "subject.txt")
                   (not (stringContains? taskCommitFiles "unrelated.txt"))
                   (stringContains? taskCommitSubject "live commit"))
              "a task requesting commit stays open after its edit's green gate, then closes after the later successful commit")
      (assert baselineReadReady "the baseline-green no-write scenario has its staged read fixture")
      (assert (and (= baselineRead.exitCode 1)
                   (not (stringContains? baselineRead.stdout ":status :ok"))
                   (stringContains? baselineRead.stdout ":turns 2")
                   (stringContains? baselineReadJournal "(:turn 1 :reply")
                   (not (stringContains? baselineRead.stdout ":written (\"subject.txt\")")))
              "a baseline-green gate and read-only turn cannot deliver a patch")
      (assert (and capsReady (stringContains? editJournal "(:baseline :green () :red (\"grep -qx green subject.txt\"))")
                   (not (stringContains? edited.stdout ":vacuousGates")))
              "a gate red before any edit is recorded red at baseline and is not marked vacuous")
      (assert (and (stringContains? baselineRead.stdout ":vacuousGates (\"grep -qx green subject.txt\")")
                   (stringContains? baselineReadJournal "(:baseline :green (\"grep -qx green subject.txt\") :red ())")
                   (stringContains? baselineReadJournal " :vacuousGates (\"grep -qx green subject.txt\")"))
              "a gate already green before any edit is marked vacuous in the receipt and the journal result")
      (assert (stringContains? editJournal "(:turn 1 :sent \"Task: write then gate\\n\\nprefetched")
              "the first turn carries the prefetch block computed in setup")
      (assert (and (stringContains? editJournal "(:prefetch (:file \\\"subject.txt\\\"")
                   (stringContains? editJournal "before"))
              "the prefetch block holds the owned file's content")
      (assert (and (stringContains? capsEmptyJournal "(:retry :turn 1 :attempt 1)")
                   (stringContains? capsEmptyJournal "(:turn 1 :reply"))
              "an empty-body provider error is retried and the run continues")
      (assert (and (stringContains? capsPermanentJournal "(:err :turn 1 :class :permanent :code :ERR_BAD_REQUEST :retries 0")
                   (not (stringContains? capsPermanentJournal "(:retry "))
                   (= (- (listLength (stringSplit capsPermanentAttempts "(:attempt")) 1) 1))
              "a permanent provider error is surfaced as (:err ...) after one attempt")
      (assert cleaned "live-loop temporary roots are removed")
      true))))
