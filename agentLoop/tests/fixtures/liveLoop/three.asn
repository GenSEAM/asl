(:script :id "liveLoopThree" :mode :implement
  :turns (
    (:turn :num 1 :reply "(:step :op \"write\" :file \"subject.txt\" :content \"blue\\n\")")
    (:turn :num 2 :reply "(:step :op \"write\" :file \"subject.txt\" :content \"red\\n\")")
    (:turn :num 3 :reply "(:step :op \"write\" :file \"subject.txt\" :content \"green\\n\") (:done)")
  )
)
