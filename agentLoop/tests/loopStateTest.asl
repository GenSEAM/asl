(module asl/agentLoop/tests/loopStateTest
  :x [runTests]
  :i [(asl/agentLoop/loopState :a s) (asl/agentLoop/exec :a x)
      (asl/agentLoop/gates :a g) (asl/agentLoop/gitOps :a go)
      (asl/agentLoop/claims :a cl) (asl/agentLoop/retry :a rt)
      (asl/agentLoop/runOps :a ro) (asl/agentLoop/txn :a tx)
      (asl-json/json :a j)])

fn runTests -> Bool
  (let [execVals (list (pair "str" (x/vStr "text")) (pair "int" (x/vInt 7))
          (pair "bool" (x/vBool true)) (pair "strings" (x/vStrs (list "a" "b")))
          (pair "pair" (x/vPair 2 9)) (pair "none" (x/vNone))
          (pair "nested" (x/vRecs (list (list (pair "inside" (x/vBool false)))))))
        claimsWithExit (s/claimsReceiptJson (cl/receiptOf "r1" "true" "step" "ok" "" false true 17 (list) false 0 0 ""))
        claimsNoExit (s/claimsReceiptJson (cl/receiptOf "r2" "" "cmd" "missing" "" false false 17 (list) false 0 0 ""))
        plan (s/planReceiptJson "r1" "step" "ok" (some 17) "true")
        retry (s/retryReceiptJson (rt/receiptRec "r1" (some "step") none (some "true") none none none none none none none (some 17) (some "ok") none none))
        retryMissing (s/retryReceiptJson (rt/receiptRec "r2" none none none none none none none none none none none none none none))
        gitValues (list (s/gitRValJson (go/rStr "git text")) (s/gitRValJson (go/rInt 12))
          (s/gitRValJson (go/rBool true)) (s/gitRValJson go/rNull) (s/gitRValJson (go/rPair 3 6)))
        runValues (list (s/runRValJson (ro/rStr "run text")) (s/runRValJson (ro/rInt 13))
          (s/runRValJson (ro/rBool false)) (s/runRValJson (ro/rList (list "one" "two"))))
        txnValues (list (s/txnRValJson (tx/rStr "txn text")) (s/txnRValJson (tx/rInt 14))
          (s/txnRValJson (tx/rBool true)) (s/txnRValJson (tx/rList (list "left" "right")))
          (s/txnRValJson tx/rNone))
        gate (g/makeGateResult "verify" 23 "captured stdout" "captured stderr" true 8)
        gateRec (s/gateResult gate)
        gateMap (s/lastGatesJson (mapFromPairs (list (pair "verify" (pair 4 gate)))))]
    (do
      (assert (= (j/jsonEmit (s/execRecJson execVals)) "{\"str\":\"text\",\"int\":7,\"bool\":true,\"strings\":[\"a\",\"b\"],\"pair\":[2,9],\"none\":null,\"nested\":[{\"inside\":false}]}") "execValJson covers all value variants including nested records")
      (assert (= (j/jsonEmit claimsWithExit) "{\"id\":\"r1\",\"op\":\"step\",\"status\":\"ok\",\"exit\":17,\"cmd\":\"true\"}") "claims receipt preserves present exit")
      (assert (= (j/jsonEmit claimsNoExit) "{\"id\":\"r2\",\"op\":\"cmd\",\"status\":\"missing\",\"exit\":null,\"cmd\":\"\"}") "claims receipt maps absent exit to null")
      (assert (= (j/jsonEmit plan) "{\"id\":\"r1\",\"op\":\"step\",\"status\":\"ok\",\"exit\":17,\"cmd\":\"true\"}") "plan receipt preserves its fields")
      (assert (= (j/jsonEmit retry) "{\"id\":\"r1\",\"op\":\"step\",\"status\":\"ok\",\"exit\":17,\"cmd\":\"true\"}") "retry receipt preserves its optional fields")
      (assert (= (j/jsonEmit retryMissing) "{\"id\":\"r2\",\"op\":null,\"status\":null,\"exit\":null,\"cmd\":null}") "retry receipt maps absent optional fields to null")
      (assert (= (j/jsonEmit (j/jarr gitValues)) "[\"git text\",12,true,null,[3,6]]") "git RVal preserves each variant")
      (assert (= (j/jsonEmit (j/jarr runValues)) "[\"run text\",13,false,[\"one\",\"two\"]]") "run RVal preserves each variant")
      (assert (= (j/jsonEmit (j/jarr txnValues)) "[\"txn text\",14,true,[\"left\",\"right\"],null]") "txn RVal preserves each variant including none")
      (assert (= (j/jsonEmit (s/gateJson gate)) "{\"cmd\":\"verify\",\"exit\":23,\"stdout\":\"captured stdout\",\"stderr\":\"captured stderr\",\"timeout\":true,\"seconds\":8}") "gate JSON preserves output timeout and duration")
      (assert (= (j/jsonEmit (s/gateRecJson gateRec)) "{\"cmd\":\"verify\",\"exit\":23,\"stdout\":\"captured stdout\",\"stderr\":\"captured stderr\",\"timeout\":true,\"seconds\":8}") "gate record preserves output timeout and duration")
      (assert (= (j/jsonEmit (s/gateRecJson (s/gateResult gate))) (j/jsonEmit (s/gateJson gate))) "gate result and record adapters agree")
      (assert (= (j/jsonEmit gateMap) "{\"verify\":[4,{\"cmd\":\"verify\",\"exit\":23,\"stdout\":\"captured stdout\",\"stderr\":\"captured stderr\",\"timeout\":true,\"seconds\":8}]}") "lastGatesJson retains the index and gate fields")
      true))
