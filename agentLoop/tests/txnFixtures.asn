(:txn :id "editNotFound" :form "(:txn :owns (\"a.txt\") (:edit :file \"a.txt\" :old \"nothere\" :new \"2\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 1 :stdout "(:txn :error ERR_TXN_FLUSH_FAILED :message \"line 1\")" :stderr "" :sent "(:txn :owns (\"a.txt\") (:edit :file \"a.txt\" :old \"nothere\" :new \"2\"))" :ran true :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (owns (list \"a.txt\")) (flushed (list)) (error \"ERR_TXN_FLUSH_FAILED\") (message \"line 1\") (cmd \"asl txn (\\\"a.txt\\\")\") (exit 1) (stdout \"(:txn :error ERR_TXN_FLUSH_FAILED :message \\\"line 1\\\")\") (persisted false) (hint \"(:step :op \\\"write\\\" :file \\\"a.txt\\\" :content :raw)\"))")
(:txn :id "dirTarget" :form "(:txn :owns (\"adir\") (:edit :file \"adir\" :old \"\" :new \"(z\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 1 :stdout "(:txn :error ERR_TXN_FLUSH_FAILED :message \"line 1\")" :stderr "" :sent "(:txn :owns (\"adir\") (:edit :file \"adir\" :old \"\" :new \"(z\"))" :ran true :snaps "(:o :p \"adir\")" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (owns (list \"adir\")) (flushed (list)) (error \"ERR_TXN_FLUSH_FAILED\") (message \"line 1\") (cmd \"asl txn (\\\"adir\\\")\") (balance \"line 1 opens a ( that is never closed: 1 closer missing; its top-level form starts at line 1 ((z)\") (exit 1) (stdout \"(:txn :error ERR_TXN_FLUSH_FAILED :message \\\"line 1\\\")\") (persisted false) (hint \"(:step :op \\\"write\\\" :file \\\"adir\\\" :content :raw)\"))")
(:txn :id "crlfTarget" :form "(:txn :owns (\"crlf.txt\") (:edit :file \"crlf.txt\" :old \"two\\n\" :new \"2\\n\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 1 :stdout "(:txn :error ERR_TXN_ABORTED :message \":line 2\")" :stderr "" :sent "(:txn :owns (\"crlf.txt\") (:edit :file \"crlf.txt\" :old \"two\\n\" :new \"2\\n\"))" :ran true :snaps "(:o :p \"crlf.txt\")" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (owns (list \"crlf.txt\")) (flushed (list)) (error \"ERR_TXN_ABORTED\") (message \":line 2\") (cmd \"asl txn (\\\"crlf.txt\\\")\") (exit 1) (stdout \"(:txn :error ERR_TXN_ABORTED :message \\\":line 2\\\")\") (persisted false) (line 2) (arrived \"2\") (hint \"this is the text as decoded from your reply; in ASN strings a backslash is written \\\\\\\\ and a double quote \\\\\\\"; (:step :op \\\"write\\\" :file \\\"crlf.txt\\\" :content :raw)\"))")
(:txn :id "newFileAborted" :form "(:txn :owns (\"new.txt\") (:write :file \"new.txt\" :content \"(a\\n b\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 1 :stdout "(:txn :error ERR_TXN_ABORTED :message \"at line 2\")" :stderr "" :sent "(:txn :owns (\"new.txt\") (:write :file \"new.txt\" :content \"(a\\n b\"))" :ran true :snaps "(:o :p \"new.txt\")" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (owns (list \"new.txt\")) (flushed (list)) (error \"ERR_TXN_ABORTED\") (message \"at line 2\") (cmd \"asl txn (\\\"new.txt\\\")\") (exit 1) (stdout \"(:txn :error ERR_TXN_ABORTED :message \\\"at line 2\\\")\") (persisted false) (line 2) (arrived \" b\") (hint \"this is the text as decoded from your reply; in ASN strings a backslash is written \\\\\\\\ and a double quote \\\\\\\"; (:step :op \\\"write\\\" :file \\\"new.txt\\\" :content :raw)\"))")
(:txn :id "unbalancedMsgExtra" :form "(:txn :owns (\"a.txt\") (:write :file \"a.txt\" :content \"z\\n\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 1 :stdout "(:txn :message \"the delimiters ( ) [ ] { } and quotes do not balance at line 1\")" :stderr "" :sent "(:txn :owns (\"a.txt\") (:write :file \"a.txt\" :content \"z\\n\"))" :ran true :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (owns (list \"a.txt\")) (flushed (list)) (error \"ERR_TXN_FAILED\") (message \"the delimiters ( ) [ ] { } and quotes do not balance at line 1\") (cmd \"asl txn (\\\"a.txt\\\")\") (exit 1) (stdout \"(:txn :message \\\"the delimiters ( ) [ ] { } and quotes do not balance at line 1\\\")\") (persisted false) (line 1) (arrived \"z\") (hint \"this is the text as decoded from your reply; in ASN strings a backslash is written \\\\\\\\ and a double quote \\\\\\\"; write a large file in parts: the first part with write, the rest with edit ops anchored on its last line\"))")
(:txn :id "absOwnsPath" :form "(:txn :owns (\"@ROOT@/a.txt\") (:write :file \"@ROOT@/a.txt\" :content \"x\"))" :owns "(:o :p \"a.txt\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "" :ran false :snaps "" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (error \"ERR_OWNS\") (file \"@ROOT@/a.txt\") (owns (list \"@ROOT@/a.txt\")) (message \"'@ROOT@/a.txt' is outside :owns; nothing in this step was written; the run goes on\"))")
(:txn :id "realPathTarget" :form "(:txn :owns (\"a.txt\") (:write :file \"@REAL@/a.txt\" :content \"x\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "" :ran false :snaps "" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (error \"ERR_OWNS\") (file \"@REAL@/a.txt\") (owns (list \"a.txt\" \"b.asl\" \"crlf.txt\" \"sub/\" \"adir\" \"uni.txt\" \"new.txt\" \"n.txt\")) (message \"'@REAL@/a.txt' is outside :owns; nothing in this step was written; the run goes on\"))")
(:txn :id "timeoutRun" :form "(:txn :owns (\"a.txt\") (:write :file \"a.txt\" :content \"x\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 1 :stdout "" :stderr "killed after 300 s (:timeout true :seconds 300)\n" :sent "(:txn :owns (\"a.txt\") (:write :file \"a.txt\" :content \"x\"))" :ran true :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (owns (list \"a.txt\")) (flushed (list)) (error \"ERR_TXN_FAILED\") (message \"killed after 300 s (:timeout true :seconds 300)\\n\") (cmd \"asl txn (\\\"a.txt\\\")\") (exit 1) (stdout \"\") (persisted false))")
