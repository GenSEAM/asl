(:effects :id "base" :missing false :text "(:effects :id agentLoopMvp :version \"1.0\"\n  :doc \"Effect classification for agent loop operations. Each op has a class: :local (runs freely), :outward or :needsConfirm (not executed: answered with a :needsConfirm receipt, the run goes on). Ops not listed here produce ERR_EFFECT_UNDECLARED.\"\n  :entries (\n    (:effect :op \"read\" :class :local :doc \"Read file content\")\n    (:effect :op \"query\" :class :local :doc \"Search workspace\")\n    (:effect :op \"write\" :class :local :doc \"Write a file at once inside :owns, as one (:txn)\")\n    (:effect :op \"edit\" :class :local :doc \"Replace a string in a file at once inside :owns, as one (:txn)\")\n    (:effect :op \"check\" :class :local :doc \"Check delimiter balance\")\n    (:effect :op \"diff\" :class :local :doc \"Show the session's staged changes (a write or edit step stages none)\")\n    (:effect :op \"flush\" :class :local :doc \"Persist staged changes; a no-op after write and edit steps, which persist at once\")\n    (:effect :op \"discard\" :class :local :doc \"Drop staged changes; a written or edited file is not restored by it\")\n    (:effect :op \"test\" :class :local :doc \"Run ASL test\")\n    (:effect :op \"tree\" :class :local :doc \"List directory tree\")\n    (:effect :op \"observe\" :class :local :doc \"Read-only projection through bin/asl (:observe :dim d): callers, status, coverage, tokenCost, memory or session\")\n    (:effect :op \"outline\" :class :local :doc \"A file's defs and classes with line spans, through (:intel :op outline)\")\n    (:effect :op \"intel\" :class :local :doc \"Read-only code intelligence (:intel :op outline|impact|coupling|graph|deadcode|complexity|stubs|query); trace and vitality are not offered\")\n    (:effect :op \"fix\" :class :local :doc \"Propose delimiter repair\")\n    (:effect :op \"txn\" :class :local :doc \"Transactional edits inside :owns\")\n    (:effect :op \"tools\" :class :local :doc \"Introspect tool registry\")\n    (:effect :op \"help\" :class :local :doc \"Show op help\")\n    (:effect :op \"findings\" :class :local :doc \"Scout findings reply\")\n    (:effect :op \"step\" :class :local :doc \"Generic step wrapper\")\n    (:effect :op \"evidence\" :class :local :doc \"Evidence claim\")\n    (:effect :op \"escalate\" :class :local :doc \"Escalation signal\")\n    (:effect :op \"done\" :class :local :doc \"Terminal done signal\")\n    (:effect :op \"gitDiff\" :class :local :doc \"Show git diff for path against base rev or working tree\")\n    (:effect :op \"gitLog\" :class :local :doc \"Show git commit log\")\n    (:effect :op \"gitShow\" :class :local :doc \"Show git object or commit at rev\")\n    (:effect :op \"note\" :class :local :doc \"Replace the session note, sent whole in every message; over the cap it is rejected and unchanged\")\n    (:effect :op \"delete\" :class :local :doc \"Remove a file inside :owns; kept for hand-back like a write, so a run that does not end :ok restores it\")\n    (:effect :op \"run\" :class :local :doc \"Run a command through sh -c in the workspace, bounded by the step timeout; paths it changes outside :owns are restored; push, publish, request bodies and rm/mv outside :owns answer needsConfirm\")\n    (:effect :op \"gate\" :class :local :doc \"Run the principal-declared gate commands (all, or :n i from 1) with the end-of-run env and timeout; answers exit and output tail, never ends the run\")\n    (:effect :op \"push\" :class :needsConfirm :doc \"Git push — outward, irreversible\")\n    (:effect :op \"search\" :class :local :doc \"Web search — observational\")\n    (:effect :op \"research\" :class :local :doc \"Deep research — observational\")\n    (:effect :op \"crawl\" :class :local :doc \"Web crawl — observational\")\n    (:effect :op \"manage\" :class :local :doc \"This run's processes through the engine: spawn in the workspace, poll, tail, send to stdin, kill, list; changes outside :owns are restored when a process is seen finished and at turn end; every process is killed when the run ends\")\n    (:effect :op \"engine\" :class :needsConfirm :doc \"Engine control — outward\")\n    (:effect :op \"job\" :class :needsConfirm :doc \"Job dispatch — outward\")\n    (:effect :op \"agent\" :class :needsConfirm :doc \"Nested agent dispatch — outward\")\n  )\n)\n" :table "(:t :op \"read\" :class \"local\")(:t :op \"query\" :class \"local\")(:t :op \"write\" :class \"local\")(:t :op \"edit\" :class \"local\")(:t :op \"check\" :class \"local\")(:t :op \"diff\" :class \"local\")(:t :op \"flush\" :class \"local\")(:t :op \"discard\" :class \"local\")(:t :op \"test\" :class \"local\")(:t :op \"tree\" :class \"local\")(:t :op \"observe\" :class \"local\")(:t :op \"outline\" :class \"local\")(:t :op \"intel\" :class \"local\")(:t :op \"fix\" :class \"local\")(:t :op \"txn\" :class \"local\")(:t :op \"tools\" :class \"local\")(:t :op \"help\" :class \"local\")(:t :op \"findings\" :class \"local\")(:t :op \"step\" :class \"local\")(:t :op \"evidence\" :class \"local\")(:t :op \"escalate\" :class \"local\")(:t :op \"done\" :class \"local\")(:t :op \"gitDiff\" :class \"local\")(:t :op \"gitLog\" :class \"local\")(:t :op \"gitShow\" :class \"local\")(:t :op \"note\" :class \"local\")(:t :op \"delete\" :class \"local\")(:t :op \"run\" :class \"local\")(:t :op \"gate\" :class \"local\")(:t :op \"push\" :class \"needsConfirm\")(:t :op \"search\" :class \"local\")(:t :op \"research\" :class \"local\")(:t :op \"crawl\" :class \"local\")(:t :op \"manage\" :class \"local\")(:t :op \"engine\" :class \"needsConfirm\")(:t :op \"job\" :class \"needsConfirm\")(:t :op \"agent\" :class \"needsConfirm\")" :want "(:e :op \"read\" :allowed true :err \"\" :confirm false)(:e :op \"push\" :allowed false :err \"\" :confirm true)(:e :op \"agent\" :allowed false :err \"\" :confirm true)(:e :op \"nope\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"a\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"b\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"c\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"d\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"e\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"f\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)")
(:effects :id "synthetic" :missing false :text ":op \"a\" :class :local\n:op \"b\" :class :outward\n:op \"c\" :class :irreversible\n:op \"d\" :class :needsConfirm\n:op \"a\" :class :outward\n:op  \"e\"\t:class :weird\n:op \"f\" :class local\n" :table "(:t :op \"a\" :class \"outward\")(:t :op \"b\" :class \"outward\")(:t :op \"c\" :class \"irreversible\")(:t :op \"d\" :class \"needsConfirm\")(:t :op \"e\" :class \"weird\")" :want "(:e :op \"read\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"push\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"agent\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"nope\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"a\" :allowed false :err \"\" :confirm true)(:e :op \"b\" :allowed false :err \"\" :confirm true)(:e :op \"c\" :allowed false :err \"\" :confirm true)(:e :op \"d\" :allowed false :err \"\" :confirm true)(:e :op \"e\" :allowed true :err \"\" :confirm false)(:e :op \"f\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)")
(:effects :id "missing" :missing true :text "" :table "" :want "(:e :op \"read\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"push\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"agent\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"nope\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"a\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"b\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"c\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"d\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"e\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"f\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)(:e :op \"\" :allowed false :err \"ERR_EFFECT_UNDECLARED\" :confirm false)")
(:inside :id "a.txt" :path "a.txt" :want true)
(:inside :id "empty" :path "" :want true)
(:inside :id " " :path " " :want true)
(:inside :id "../x" :path "../x" :want false)
(:inside :id ".." :path ".." :want false)
(:inside :id "a/../../x" :path "a/../../x" :want false)
(:inside :id "a/../b" :path "a/../b" :want true)
(:inside :id ".git/config" :path ".git/config" :want false)
(:inside :id ".git" :path ".git" :want false)
(:inside :id ".gitignore" :path ".gitignore" :want true)
(:inside :id "/etc/passwd" :path "/etc/passwd" :want false)
(:inside :id "@ROOT@/a.txt" :path "@ROOT@/a.txt" :want true)
(:inside :id "@REAL@/a.txt" :path "@REAL@/a.txt" :want true)
(:inside :id "@REAL@/../x" :path "@REAL@/../x" :want false)
(:inside :id "./a/./b" :path "./a/./b" :want true)
(:inside :id "a//b" :path "a//b" :want true)
(:inside :id "sub/../.git/x" :path "sub/../.git/x" :want false)
(:inside :id "//a" :path "//a" :want false)
(:inside :id "@ROOT@" :path "@ROOT@" :want true)
(:inside :id "new/deep/file.txt" :path "new/deep/file.txt" :want true)
(:inside :id " ../x" :path " ../x" :want false)
(:txn :id "noOwns" :form "(:txn (:write :file \"a.txt\" :content \"x\"))" :owns "" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "" :ran false :snaps "" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (error \"ERR_OWNS\") (message \"Transaction rejected: no :owns\"))")
(:txn :id "txnOwnsOutsideRun" :form "(:txn :owns (\"zz.txt\") (:write :file \"zz.txt\" :content \"x\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "" :ran false :snaps "" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (error \"ERR_OWNS\") (file \"zz.txt\") (owns (list \"a.txt\" \"b.asl\" \"crlf.txt\" \"sub/\" \"adir\" \"uni.txt\" \"new.txt\" \"n.txt\")) (message \"'zz.txt' is outside :owns; nothing in this step was written; the run goes on\"))")
(:txn :id "txnOwnsBare" :form "(:txn :owns (a.txt 'b.asl') (:write :file \"b.asl\" :content \"x\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "(:txn :owns (\"a.txt\" \"b.asl\") (:write :file \"b.asl\" :content \"x\"))" :ran true :snaps "(:o :p \"b.asl\")" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"ok\") (owns (list \"a.txt\" \"b.asl\")) (flushed (list \"a.txt\" \"b.asl\")) (error null) (message null) (cmd \"asl txn (\\\"a.txt\\\" \\\"b.asl\\\")\") (exit 0) (stdout \"(:txn :status :ok)\\n\") (persisted true))")
(:txn :id "txnOwnsEmpty" :form "(:txn :owns () (:write :file \"a.txt\" :content \"x\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "" :ran false :snaps "" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (error \"ERR_OWNS\") (file \"a.txt\") (owns (list)) (message \"'a.txt' is outside :owns; nothing in this step was written; the run goes on\"))")
(:txn :id "writeOk" :form "(:txn :owns (\"a.txt\") (:step :op \"write\" :file \"a.txt\" :content \"new \\\"q\\\"\\nline\") (:step :op \"flush\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "(:txn :owns (\"a.txt\") (:write :file \"a.txt\" :content \"new \\\"q\\\"\\nline\"))" :ran true :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"ok\") (owns (list \"a.txt\")) (flushed (list \"a.txt\")) (error null) (message null) (cmd \"asl txn (\\\"a.txt\\\")\") (exit 0) (stdout \"(:txn :status :ok)\\n\") (persisted true))")
(:txn :id "editOk" :form "(:txn :owns (\"a.txt\") (:edit :file \"a.txt\" :old \"one\" :new \"1\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "(:txn :owns (\"a.txt\") (:edit :file \"a.txt\" :old \"one\" :new \"1\"))" :ran true :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"ok\") (owns (list \"a.txt\")) (flushed (list \"a.txt\")) (error null) (message null) (cmd \"asl txn (\\\"a.txt\\\")\") (exit 0) (stdout \"(:txn :status :ok)\\n\") (persisted true))")
(:txn :id "mixedMapped" :form "(:txn :owns (\"a.txt\" \"sub/c.txt\") (:read :file \"a.txt\") (:check :file \"sub/c.txt\") (:diff) (:write :file \"sub/c.txt\" :content \"c2\" :force true) (:flush))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "(:txn :owns (\"a.txt\" \"sub/c.txt\") (:read :file \"a.txt\") (:check :file \"sub/c.txt\") (:diff) (:write :file \"sub/c.txt\" :content \"c2\" :force true))" :ran true :snaps "(:o :p \"sub/c.txt\")" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"ok\") (owns (list \"a.txt\" \"sub/c.txt\")) (flushed (list \"a.txt\" \"sub/c.txt\")) (error null) (message null) (cmd \"asl txn (\\\"a.txt\\\" \\\"sub/c.txt\\\")\") (exit 0) (stdout \"(:txn :status :ok)\\n\") (persisted true))")
(:txn :id "noOwnsKeyword" :form "(:txn (:write :file \"b.asl\" :content \"y\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "(:txn :owns (\"a.txt\" \"b.asl\") (:write :file \"b.asl\" :content \"y\"))" :ran true :snaps "(:o :p \"b.asl\")" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"ok\") (owns (list \"a.txt\" \"b.asl\")) (flushed (list \"a.txt\" \"b.asl\")) (error null) (message null) (cmd \"asl txn (\\\"a.txt\\\" \\\"b.asl\\\")\") (exit 0) (stdout \"(:txn :status :ok)\\n\") (persisted true))")
(:txn :id "subDirOwnsRejected" :form "(:txn :owns (\"sub/\") (:write :file \"sub/c.txt\" :content \"y\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "" :ran false :snaps "" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"rejected\") (error \"ERR_OWNS\") (file \"sub/\") (owns (list \"a.txt\" \"b.asl\" \"crlf.txt\" \"sub/\" \"adir\" \"uni.txt\" \"new.txt\" \"n.txt\")) (message \"'sub/' is outside :owns; nothing in this step was written; the run goes on\"))")
(:txn :id "onlyLocal" :form "(:txn :owns (\"a.txt\") (:query :query \"x\") (:step :op \"flush\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "" :ran false :snaps "" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"ok\") (owns (list \"a.txt\")) (flushed (list)) (exit 0) (persisted false))")
(:txn :id "onlyReadMapped" :form "(:txn :owns (\"a.txt\") (:read :file \"a.txt\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 0 :stdout "" :stderr "" :sent "(:txn :owns (\"a.txt\") (:read :file \"a.txt\"))" :ran true :snaps "" :want "(receipt (id \"rid0001\") (op \"txn\") (status \"ok\") (owns (list \"a.txt\")) (flushed (list \"a.txt\")) (error null) (message null) (cmd \"asl txn (\\\"a.txt\\\")\") (exit 0) (stdout \"\") (persisted true))")
(:txn :id "pushConfirm" :form "(:txn :owns (\"a.txt\") (:push :remote \"o\"))" :owns "(:o :p \"a.txt\")(:o :p \"b.asl\")(:o :p \"crlf.txt\")(:o :p \"sub/\")(:o :p \"adir\")(:o :p \"uni.txt\")(:o :p \"new.txt\")(:o :p \"n.txt\")" :exit 0 :stdout "(:txn :status :ok)\n" :stderr "" :sent "" :ran false :snaps "" :want "(receipt (id \"rid0002\") (op \"push\") (status \"needsConfirm\") (needsConfirm true) (message \"not executed: 'push' is an outward effect that needs the principal's confirmation; the run goes on\"))")
