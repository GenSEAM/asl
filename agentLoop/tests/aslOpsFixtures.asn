(:execCase :id "readWithSymbol" :op "(:step :op \"read\" :file \"sample.asl\" :symbol \"foo\")" :owns "" :runExit 0 :runStdout "(:read :file \"sample.asl\" :start 3 :end 5 :content \"fn foo x: Int64 -> Int64\\n  (+ x 1)\")" :runStderr "" :readCap 8000 :budget "none" :sentForm "(:read :file \"sample.asl\" :symbol \"foo\")" :snaps "" :want "(receipt (id \"testId123456\") (op \"read\") (file \"sample.asl\") (span (3 4)) (content \"fn foo x: Int64 -> Int64\\n  (+ x 1)\") (status \"ok\") (error none) (message none) (cmd \"asl read sample.asl\") (exit 0) (stdout \"(:read :file \\\"sample.asl\\\" :start 3 :end 5 :content \\\"fn foo x: Int64 -> Int64\\\\n  (+ x 1)\\\")\"))")
