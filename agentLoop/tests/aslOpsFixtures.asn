(:execCase :id "writeOk" :op "(:step :op \"write\" :file \"a.txt\" :content \"fn f -> Int64\\n  42\\n\")" :owns "(:o :p \"a.txt\")" :runExit 0 :runStdout "" :runStderr "" :readCap 8000 :budget "none" :sentForm "(:txn :owns (\"a.txt\") (:write :file \"a.txt\" :content \"fn f -> Int64\\n  42\\n\"))" :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"testId123456\") (op \"write\") (file \"a.txt\") (status \"ok\") (error none) (message none) (cmd \"asl txn write a.txt\") (exit 0) (stdout \"\") (persisted true))")
(:execCase :id "writePlaceholder" :op "(:step :op \"write\" :file \"a.txt\" :content \"assert false\")" :owns "(:o :p \"a.txt\")" :runExit 0 :runStdout "" :runStderr "" :readCap 8000 :budget "none" :sentForm "(:txn :owns (\"a.txt\") (:write :file \"a.txt\" :content \"assert false\"))" :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"testId123456\") (op \"write\") (file \"a.txt\") (status \"ok\") (error none) (message none) (cmd \"asl txn write a.txt\") (exit 0) (stdout \"\") (persisted true) (warning \"placeholder assert: red-first needs a real assertion on the missing behaviour\"))")
(:execCase :id "writeOwns" :op "(:step :op \"write\" :file \"a.txt\" :content \"x\")" :owns "(:o :p \"a.txt\")" :runExit 1 :runStdout "(:txn :error ERR_OWNS)" :runStderr "" :readCap 8000 :budget "none" :sentForm "(:txn :owns (\"a.txt\") (:write :file \"a.txt\" :content \"x\"))" :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"testId123456\") (op \"write\") (file \"a.txt\") (status \"rejected\") (error \"ERR_OWNS\") (message \"ERR_WRITE_FAILED: (:txn :error ERR_OWNS)\") (cmd \"asl txn write a.txt\") (exit 1) (stdout \"(:txn :error ERR_OWNS)\") (persisted false))")
(:execCase :id "writeFlushFailed" :op "(:step :op \"write\" :file \"a.txt\" :content \"(\\n(open\\n\")" :owns "(:o :p \"a.txt\")" :runExit 1 :runStdout "(:txn :error ERR_TXN_FLUSH_FAILED)" :runStderr "" :readCap 8000 :budget "none" :sentForm "(:txn :owns (\"a.txt\") (:write :file \"a.txt\" :content \"(\\n(open\\n\"))" :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"testId123456\") (op \"write\") (file \"a.txt\") (status \"rejected\") (error \"ERR_TXN_FLUSH_FAILED\") (message \"ERR_WRITE_FAILED: (:txn :error ERR_TXN_FLUSH_FAILED)\") (cmd \"asl txn write a.txt\") (balance \"line 1 opens a ( that is never closed: 1 closer missing before line 2; its top-level form starts at line 1 (()\") (exit 1) (stdout \"(:txn :error ERR_TXN_FLUSH_FAILED)\") (persisted false) (hint \"(:step :op \\\"write\\\" :file \\\"a.txt\\\" :content :raw)\"))")
(:execCase :id "writeAborted" :op "(:step :op \"write\" :file \"a.txt\" :content \"x\")" :owns "(:o :p \"a.txt\")" :runExit 1 :runStdout "(:txn :error ERR_TXN_ABORTED)" :runStderr "" :readCap 8000 :budget "none" :sentForm "(:txn :owns (\"a.txt\") (:write :file \"a.txt\" :content \"x\"))" :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"testId123456\") (op \"write\") (file \"a.txt\") (status \"rejected\") (error \"ERR_TXN_ABORTED\") (message \"ERR_WRITE_FAILED: (:txn :error ERR_TXN_ABORTED)\") (cmd \"asl txn write a.txt\") (exit 1) (stdout \"(:txn :error ERR_TXN_ABORTED)\") (persisted false) (hint \"(:step :op \\\"write\\\" :file \\\"a.txt\\\" :content :raw)\"))")
(:execCase :id "writeDelimUnbal" :op "(:step :op \"write\" :file \"a.txt\" :content \"(\\n(\\n\")" :owns "(:o :p \"a.txt\")" :runExit 1 :runStdout "(:txn :error ERR_UNBALANCED :balanced false :byte 2)" :runStderr "" :readCap 8000 :budget "none" :sentForm "(:txn :owns (\"a.txt\") (:write :file \"a.txt\" :content \"(\\n(\\n\"))" :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"testId123456\") (op \"write\") (file \"a.txt\") (status \"rejected\") (error \"ERR_TXN_FLUSH_FAILED\") (message \"refused: the delimiters ( ) [ ] { } and quotes do not balance at byte 2 (line 2 of :content); nothing was written\") (cmd \"asl txn write a.txt\") (balance \"line 1 opens a ( that is never closed: 1 closer missing before line 2; its top-level form starts at line 1 (()\") (exit 1) (stdout \"(:txn :error ERR_UNBALANCED :balanced false :byte 2)\") (persisted false) (line 2) (arrived \"(\") (hint \"this is the text as decoded from your reply; in ASN strings a backslash is written \\\\\\\\ and a double quote \\\\\\\"; write a large file in parts: the first part with write, the rest with edit ops anchored on its last line; (:step :op \\\"write\\\" :file \\\"a.txt\\\" :content :raw)\"))")
