(:liveCase :id "liveWriteOk" :binKind "link:stubEcho" :op "(:step :op \"write\" :file \"a.txt\" :content \"x\\n\")" :owns "(:o :p \"a.txt\")" :runTimeout 300 :deadlineIn "none" :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"liveId000001\") (op \"write\") (file \"a.txt\") (status \"ok\") (error none) (message none) (cmd \"asl txn write a.txt\") (exit 0) (stdout \"stub out: (:txn :owns (\\\"a.txt\\\") (:write :file \\\"a.txt\\\" :content \\\"x\\n\\\")) root=@ROOT@\\n\") (persisted true))")
(:liveCase :id "liveWriteErr" :binKind "link:stubErr" :op "(:step :op \"write\" :file \"a.txt\" :content \"y\")" :owns "(:o :p \"a.txt\")" :runTimeout 300 :deadlineIn "none" :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"liveId000001\") (op \"write\") (file \"a.txt\") (status \"rejected\") (error \"ERR_WRITE_FAILED\") (message \"stub err: (:txn :owns (\\\"a.txt\\\") (:write :file \\\"a.txt\\\" :content \\\"y\\\"))\") (cmd \"asl txn write a.txt\") (exit 2) (stdout \"\") (persisted false))")
