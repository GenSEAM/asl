(:execCase :id "editFlushFailed" :op "(:step :op \"edit\" :file \"target.txt\" :old \"hello\" :new \"(\")" :owns "(:o :p \"target.txt\")" :runExit 1 :runStdout "(:txn :error ERR_TXN_FLUSH_FAILED)" :runStderr "" :readCap 8000 :budget "none" :sentForm "(:txn :owns (\"target.txt\") (:edit :file \"target.txt\" :old \"hello\" :new \"(\"))" :snaps "(:o :p \"target.txt\")" :want "(receipt (id \"testId123456\") (op \"edit\") (file \"target.txt\") (status \"rejected\") (error \"ERR_TXN_FLUSH_FAILED\") (message \"ERR_EDIT_FAILED: (:txn :error ERR_TXN_FLUSH_FAILED)\") (cmd \"asl txn edit target.txt\") (balance \"line 1 opens a ( that is never closed: 1 closer missing before line 2; its top-level form starts at line 1 (( world)\") (exit 1) (stdout \"(:txn :error ERR_TXN_FLUSH_FAILED)\") (persisted false) (hint \"(:step :op \\\"write\\\" :file \\\"target.txt\\\" :content :raw)\"))")
(:execCase :id "editAborted" :op "(:step :op \"edit\" :file \"a.txt\" :old \"a\" :new \"b\")" :owns "(:o :p \"a.txt\")" :runExit 1 :runStdout "(:txn :error ERR_TXN_ABORTED)" :runStderr "" :readCap 8000 :budget "none" :sentForm "(:txn :owns (\"a.txt\") (:edit :file \"a.txt\" :old \"a\" :new \"b\"))" :snaps "(:o :p \"a.txt\")" :want "(receipt (id \"testId123456\") (op \"edit\") (file \"a.txt\") (status \"rejected\") (error \"ERR_TXN_ABORTED\") (message \"ERR_EDIT_FAILED: (:txn :error ERR_TXN_ABORTED)\") (cmd \"asl txn edit a.txt\") (exit 1) (stdout \"(:txn :error ERR_TXN_ABORTED)\") (persisted false) (hint \"(:step :op \\\"write\\\" :file \\\"a.txt\\\" :content :raw)\"))")
