(module asl/agentLoop/tests/leonServeSocketTest
  :x [runTests]
  :i [(asl/agentLoop/leonServe :a ls)])

; (:m :ref LEONSERVE-STALE-SOCKET :do "fill connects until one fails and returns the held fds with the error that ended it, empty when n connects all succeeded, so the busy asserts can require that a busy state was really reached")
fn ! fill! n: Int64 ctl: String held: (List Int64) -> (Pair (List Int64) String)
  (if (<= n 0) (pair held "")
    (match (unixConnect ctl)
      ((ok fd) (fill! (- n 1) ctl (cons fd held)))
      ((err e) (pair held e))))

fn ! closeAll! fds: (List Int64) -> Bool
  (match (listHead fds)
    ((none) true)
    ((some f) (do (fdClose f) (closeAll! (listDrop fds 1)))))

fn errHas? r: (Result Unit String) needle: String -> Bool
  (match r ((err e) (stringContains? e needle)) ((ok _) false))

; (:m :ref LEONSERVE-STALE-SOCKET :do "freeCtl! on every state of the control path: nothing there; the residue of a killed listener (removed, so the next unixListen binds); a live listener (refused, file kept); a listener whose backlog is full with a filled backlog of pending connects (refused as busy, file kept: only a refused connect proves a file stale); a directory and a regular file at the path (refused as ctlNotSocket and left intact); and the starter lock: a live holder refuses, a dead holder's lock is replaced")
fn ! runTests -> Bool
  (let [(temp (str (resultOr (realPath ".") ".") "/.asl/cache/leonServeSocketTest-" (stringFromInt64 (procSelf))))
        (made (ok? (dirCreate temp)))
        (ctl (str temp "/ctl.sock"))
        (none (ls/freeCtl! ctl 5 100))
        (dead (resultOr (unixListen ctl) -1))
        (_ (fdClose dead))
        (residue (ok? (fileLstat ctl)))
        (blocked (resultOr (unixListen ctl) -1))
        (freed (ls/freeCtl! ctl 5 100))
        (gone (not (ok? (fileLstat ctl))))
        (rebound (resultOr (unixListen ctl) -1))
        (live (ls/freeCtl! ctl 5 100))
        (kept (ok? (fileLstat ctl)))
        (filled (fill! 20000 ctl (list)))
        (pending (pairFirst filled))
        (reached (pairSecond filled))
        (busy (ls/freeCtl! ctl 5 100))
        (busyKept (ok? (fileLstat ctl)))
        (t0 (/ (monotonicNs) 1000000))
        (slow (ls/probeCtl! ctl 3 200))
        (waited (- (/ (monotonicNs) 1000000) t0))
        (cfgText ":leonPool (:ctlProbeRetries 7 :ctlProbeDelayMs 250)")
        (_ (closeAll! pending))
        (_ (fdClose rebound))
        (dir (str temp "/dirctl"))
        (_ (dirCreate dir))
        (_ (fileWrite (str dir "/inner") "x"))
        (isDir (ls/freeCtl! dir 5 100))
        (dirKept (ok? (fileLstat (str dir "/inner"))))
        (reg (str temp "/regctl"))
        (_ (fileWrite reg "x"))
        (isReg (ls/freeCtl! reg 5 100))
        (regKept (ok? (fileLstat reg)))
        (lockPath (str temp "/lk.sock"))
        (first (ls/lockCtl! lockPath))
        (second (ls/lockCtl! lockPath))
        (_ (pathRemove (str lockPath ".lock")))
        (_ (fileWrite (str lockPath ".lock") "999999\n"))
        (taken (ls/lockCtl! lockPath))
        (_ (pathRemove (str lockPath ".lock")))
        (bound (ls/bindCtl! lockPath 5 100))
        (lockGone (not (ok? (fileLstat (str lockPath ".lock")))))
        (_ (match bound ((ok l) (fdClose l)) ((err _) (ok ()))))
        (cleaned (ok? (pathRemove temp)))]
    (do
      (assert (and made (ok? none)) "an absent control path needs nothing")
      (assert (and residue (< blocked 0)) "the residue of a killed listener exists and blocks a new bind")
      (assert (and (ok? freed) gone) "a socket nobody answers on is removed")
      (assert (>= rebound 0) "the next unixListen binds the path")
      (assert (errHas? live "another pool answers") "a live listener is refused, not taken over")
      (assert kept "the live listener's socket file stays")
      (assert (and (not (stringEmpty? reached)) (not (ls/ctlStaleError? reached))) (str "the fill ended on a connect error that is not a refusal, so the listener is busy: " reached " after " (stringFromInt64 (listLength pending)) " pending"))
      (assert (errHas? busy "busy") "a listener with a full backlog is refused as busy, not as live and not taken over")
      (assert (and (ls/ctlStaleError? "io:111") (ls/ctlStaleError? "io:61") (ls/ctlStaleError? "io:2") (not (ls/ctlStaleError? "io:11")) (not (ls/ctlStaleError? "io:4")) (not (ls/ctlStaleError? "io:24")) (not (ls/ctlStaleError? "io:104"))) "only a refused connect or a missing file is stale; EAGAIN, EINTR, EMFILE and a reset are not")
      (assert busyKept "a busy listener's socket file stays")
      (assert (and (= slow "busy") (>= waited 400)) (str "probeCtl! sleeps the delay it is given between its tries: " slow " " (stringFromInt64 waited)))
      (assert (and (= (ls/cfgInt cfgText "ctlProbeRetries" 5) 7) (= (ls/cfgInt cfgText "ctlProbeDelayMs" 100) 250) (= (ls/cfgInt "" "ctlProbeRetries" 5) 5)) "the probe settings are read from the :leonPool config row, default when absent")
      (assert (errHas? isDir "ctlNotSocket") "a directory at the path is refused")
      (assert dirKept "a directory at the path and its content stay")
      (assert (errHas? isReg "ctlNotSocket") "a regular file at the path is refused")
      (assert regKept "a regular file at the path stays")
      (assert (ok? first) "the first starter takes the lock")
      (assert (match second ((err e) (stringContains? e "another pool is starting")) ((ok _) false)) "a live holder refuses a second starter")
      (assert (ok? taken) "a lock held by a dead pid is replaced")
      (assert (and (ok? bound) lockGone) "bindCtl! binds and releases the lock")
      (assert cleaned "scratch removed")
      true))
