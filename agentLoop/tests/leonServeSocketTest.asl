(module asl/agentLoop/tests/leonServeSocketTest
  :x [runTests]
  :i [(asl/agentLoop/leonServe :a ls)])

; (:m :ref LEONSERVE-STALE-SOCKET :do "fill connects until one fails and returns the held fds with the error that ended it, empty when n connects all succeeded; the error is the platform's own (EMFILE of the test process on Linux, ECONNREFUSED on macOS at a full backlog), whichever it is the pool must keep its socket")
fn ! fill! n: Int64 ctl: String held: (List Int64) -> (Pair (List Int64) String)
  (if (<= n 0) (pair held "")
    (match (unixConnect ctl)
      ((ok fd) (fill! (- n 1) ctl (cons fd held)))
      ((err e) (pair held e))))

fn ! closeAll! fds: (List Int64) -> Bool
  (match (listHead fds)
    ((none) true)
    ((some f) (do (fdClose f) (closeAll! (listDrop fds 1)))))

fn errHas? r: (Result Unit String) needle: String -> Bool
  (match r ((err e) (stringContains? e needle)) ((ok _) false))

fn ! residue! path: String -> Bool
  (match (unixListen path) ((ok fd) (do (fdClose fd) (ok? (fileLstat path)))) ((err _) false))

fn ! deadPid -> Int64
  (optionOr (listFind (fn [(n Int64)] -> Bool (not (resultOr (procAlive? n) true))) (range 90000 99900)) 0)

fn ownerRec pid: Int64 start: String -> String
  (str "(:owner :pid " (stringFromInt64 pid) " :start \"" start "\")\n")

fn ! hostName -> String
  (match (platformInfo) ((ok p) p.os) ((err _) ""))

; (:m :ref LEONSERVE-STALE-SOCKET :do "freeCtl! on every state of the control path: nothing there; a refused connect with no owner record (kept, refused), with a dead owner (removed with its record), with a live owner (kept, which is what a live pool with a full backlog looks like on macOS), with the owner's pid reused by another process (removed); a live listener and a listener with a filled backlog (kept); a directory and a regular file (ctlNotSocket, intact); errno naming per platform; the :leonPool group scope; the starter lock and the owner record bindCtl! writes")
fn ! runTests -> Bool
  (let [(temp (str (resultOr (realPath ".") ".") "/.asl/cache/leonServeSocketTest-" (stringFromInt64 (procSelf))))
        (made (ok? (dirCreate temp)))
        (ctl (str temp "/ctl.sock"))
        (ownerFile (str ctl ".pid"))
        (me (procSelf))
        (os (hostName))
        (cross (if (= os "Darwin") "Linux" "Darwin"))
        (dpid (deadPid))
        (none (ls/freeCtl! ctl 5 100))
        (res1 (residue! ctl))
        (noOwner (ls/freeCtl! ctl 5 100))
        (kept1 (ok? (fileLstat ctl)))
        (staleOwn (ls/probeCtl! ctl 1 1 os))
        (t0 (/ (monotonicNs) 1000000))
        (slow (ls/probeCtl! ctl 3 200 cross))
        (waited (- (/ (monotonicNs) 1000000) t0))
        (_ (fileWrite ownerFile (ownerRec dpid "Thu Jan  1 00:00:00 1970")))
        (stOwnerGone (ls/ownerState! ctl))
        (freed (ls/freeCtl! ctl 5 100))
        (gone (not (ok? (fileLstat ctl))))
        (recGone (not (ok? (fileLstat ownerFile))))
        (res2 (residue! ctl))
        (_ (fileWrite ownerFile (ownerRec me (ls/startOf! me))))
        (stOwnerAlive (ls/ownerState! ctl))
        (aliveRes (ls/freeCtl! ctl 5 100))
        (kept2 (ok? (fileLstat ctl)))
        (_ (fileWrite ownerFile (ownerRec me "Thu Jan  1 00:00:00 1970")))
        (reused (ls/freeCtl! ctl 5 100))
        (gone3 (not (ok? (fileLstat ctl))))
        (rebound (resultOr (unixListen ctl) -1))
        (_ (fileWrite ownerFile (ownerRec me (ls/startOf! me))))
        (live (ls/freeCtl! ctl 5 100))
        (kept4 (ok? (fileLstat ctl)))
        (filled (fill! 20000 ctl (list)))
        (pending (pairFirst filled))
        (reached (pairSecond filled))
        (busy (ls/freeCtl! ctl 5 100))
        (busyKept (ok? (fileLstat ctl)))
        (_ (closeAll! pending))
        (_ (fdClose rebound))
        (dir (str temp "/dirctl"))
        (_ (dirCreate dir))
        (_ (fileWrite (str dir "/inner") "x"))
        (isDir (ls/freeCtl! dir 5 100))
        (dirKept (ok? (fileLstat (str dir "/inner"))))
        (reg (str temp "/regctl"))
        (_ (fileWrite reg "x"))
        (isReg (ls/freeCtl! reg 5 100))
        (regKept (ok? (fileLstat reg)))
        (lockPath (str temp "/lk.sock"))
        (first (ls/lockCtl! lockPath))
        (second (ls/lockCtl! lockPath))
        (_ (pathRemove (str lockPath ".lock")))
        (_ (fileWrite (str lockPath ".lock") (str (stringFromInt64 dpid) "\n")))
        (taken (ls/lockCtl! lockPath))
        (_ (pathRemove (str lockPath ".lock")))
        (bound (ls/bindCtl! lockPath 5 100))
        (lockGone (not (ok? (fileLstat (str lockPath ".lock")))))
        (boundOwner (ls/ownerState! lockPath))
        (_ (match bound ((ok l) (fdClose l)) ((err _) (ok ()))))
        (noRecord (ls/ownerState! (str temp "/never.sock")))
        (scoped ":nativeCli (:ctlProbeRetries 9) :leonPool (:ctlProbeRetries 7 :ctlProbeDelayMs 250)")
        (cleaned (ok? (pathRemove temp)))]
    (do
      (assert (and made (ok? none)) "an absent control path needs nothing")
      (assert res1 "the residue of a killed listener exists")
      (assert (and (errHas? noOwner "ctlNoOwner") kept1) "a refused connect with no owner record is refused and the socket kept")
      (assert (= staleOwn "stale") "a closed listener's refusal is stale in the platform's own errno")
      (assert (and (= slow "busy") (>= waited 400)) (str "probeCtl! sleeps the delay it is given between its tries: " slow " " (stringFromInt64 waited)))
      (assert (= stOwnerGone "gone") "a recorded pid that does not run is a gone owner")
      (assert (and (ok? freed) gone recGone) "a refused connect with a gone owner removes the socket and the record")
      (assert (and res2 (= stOwnerAlive "alive")) "the record of this live process reads alive")
      (assert (and (errHas? aliveRes "ctlOwnerAlive") kept2) "a refused connect with a live owner keeps the socket: a live pool at a full backlog is refused too on macOS")
      (assert (and (ok? reused) gone3) "an owner pid reused by another process (other start time) is gone, the socket is removed")
      (assert (>= rebound 0) "the next unixListen binds the path")
      (assert (and (errHas? live "another pool answers") kept4) "a live listener is refused, not taken over, and its socket stays")
      (assert (not (stringEmpty? reached)) (str "the fill ended on a connect error: " reached " after " (stringFromInt64 (listLength pending)) " pending"))
      (assert (and (not (ok? busy)) busyKept) (str "a listener at its limit is refused and its socket stays, whichever error the platform gave: " reached))
      (assert (and (ls/ctlStaleError? "Darwin" "io:61") (not (ls/ctlStaleError? "Linux" "io:61")) (ls/ctlStaleError? "Linux" "io:111") (not (ls/ctlStaleError? "Darwin" "io:111")) (ls/ctlStaleError? "Linux" "io:2") (ls/ctlStaleError? "Darwin" "io:2")) "ECONNREFUSED is named per platform (61 on macOS, 111 on Linux where 61 is ENODATA); a missing file is stale on both")
      (assert (not (or (ls/ctlStaleError? "Linux" "io:11") (ls/ctlStaleError? "Darwin" "io:11") (ls/ctlStaleError? "Linux" "io:4") (ls/ctlStaleError? "Linux" "io:24") (ls/ctlStaleError? "Darwin" "io:24") (ls/ctlStaleError? "Linux" "io:104"))) "EAGAIN, EINTR, EMFILE and a reset are never stale")
      (assert (and (= (ls/cfgInt (ls/groupText scoped "leonPool") "ctlProbeRetries" 5) 7) (= (ls/cfgInt (ls/groupText scoped "leonPool") "ctlProbeDelayMs" 100) 250)) "the probe settings are read from the :leonPool group")
      (assert (= (ls/cfgInt (ls/groupText ":nativeCli (:ctlProbeRetries 9)" "leonPool") "ctlProbeRetries" 5) 5) "a same-named key of another group is not read")
      (assert (errHas? isDir "ctlNotSocket") "a directory at the path is refused")
      (assert dirKept "a directory at the path and its content stay")
      (assert (errHas? isReg "ctlNotSocket") "a regular file at the path is refused")
      (assert regKept "a regular file at the path stays")
      (assert (ok? first) "the first starter takes the lock")
      (assert (match second ((err e) (stringContains? e "another pool is starting")) ((ok _) false)) "a live holder refuses a second starter")
      (assert (ok? taken) "a lock held by a dead pid is replaced")
      (assert (and (ok? bound) lockGone (= boundOwner "alive")) "bindCtl! binds, writes the owner record of this process and releases the lock")
      (assert (= noRecord "unknown") "a missing record reads unknown")
      (assert cleaned "scratch removed")
      true))
