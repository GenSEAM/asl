(module asl/agentLoop/tests/loopRunFixtureTest
  :x [runTests]
  :i [(asl/agentLoop/tests/loopRunFixture :a f) (asl/agentLoop/plan :a p) (asl-proc/coreProcess :a cp)])

fn ! rootFor i: Int64 -> String
  (let [base (optionOr (envGet "TMPDIR") "/tmp")]
    (str base "/loopRunFixture_" (stringFromInt64 (procSelf)) "_" (stringFromInt64 i)))

fn ! repoHasHead! root: String -> Bool
  (mt (cp/exec! (cp/cmd "git" (list "-C" root "rev-parse" "HEAD")))
    ((ok o) (= o.exitCode 0))
    ((err _) false))

fn ! runTests -> Bool
  (let [path "asl/agentLoop/tests/loopRunFixtures.asn"
        lines (f/scenarioLines! path)
        n (f/scenarioCount! path)
        expected (list "budget0" "preflightReject" "resumePatchReject" "escalate" "readThenDone" "writeGreenGate"
                       "redGateRetryExhausted" "parseDefect" "echoForm" "degenerateCut" "toolCall" "vendorErrorThenOk"
                       "unbackedClaimsBrief" "findingsPossibleNotice" "placeholder" "planSteps" "commitMessage"
                       "sameFailureCycle" "readStreak" "noWriteTurns" "specCheckMet" "specCheckRetry")
        expectedResults (list (pair "budget0" (pair "escalated" "nil"))
                              (pair "preflightReject" (pair "rejected" "ERR_GATE_UNPARSABLE"))
                              (pair "resumePatchReject" (pair "rejected" "ERR_RESUME_PATCH"))
                              (pair "escalate" (pair "escalated" "nil"))
                              (pair "readThenDone" (pair "ok" "nil"))
                              (pair "writeGreenGate" (pair "ok" "nil"))
                              (pair "redGateRetryExhausted" (pair "escalated" "nil"))
                              (pair "parseDefect" (pair "ok" "nil"))
                              (pair "echoForm" (pair "ok" "nil"))
                              (pair "degenerateCut" (pair "failed" "nil"))
                              (pair "toolCall" (pair "escalated" "nil"))
                              (pair "vendorErrorThenOk" (pair "ok" "nil"))
                              (pair "unbackedClaimsBrief" (pair "ok" "nil"))
                              (pair "findingsPossibleNotice" (pair "failed" "nil"))
                              (pair "placeholder" (pair "ok" "nil"))
                              (pair "planSteps" (pair "ok" "nil"))
                              (pair "commitMessage" (pair "ok" "nil"))
                              (pair "sameFailureCycle" (pair "escalated" "nil"))
                              (pair "readStreak" (pair "escalated" "nil"))
                              (pair "noWriteTurns" (pair "escalated" "nil"))
                              (pair "specCheckMet" (pair "ok" "nil"))
                              (pair "specCheckRetry" (pair "ok" "nil")))
        sampleLine (optionOr (listHead (filter (fn [line] (= (f/scenarioId line) "readThenDone")) lines)) "")
        sampleNode (mt (p/planTree sampleLine) ((ok ns) (optionOr (listHead ns) (p/sexpAtom "nil"))) ((err _) (p/sexpAtom "nil")))
        sampleJournal (f/maskJournal "<root>" (map f/argStr (f/listOf (f/field sampleNode ":journal"))))
        selectedRows (f/turnRows sampleJournal 1 (list ":reply"))
        readLine (optionOr (listHead (filter (fn [line] (= (f/scenarioId line) "readThenDone")) lines)) "")
        writeLine (optionOr (listHead (filter (fn [line] (= (f/scenarioId line) "writeGreenGate")) lines)) "")
        writeNode (mt (p/planTree writeLine) ((ok ns) (optionOr (listHead ns) (p/sexpAtom "nil"))) ((err _) (p/sexpAtom "nil")))
        writeJournal (f/maskJournal "<root>" (map f/argStr (f/listOf (f/field writeNode ":journal"))))
        writeTurnRows (f/turnRows writeJournal 1 (list))
        specMetLine (optionOr (listHead (filter (fn [line] (= (f/scenarioId line) "specCheckMet")) lines)) "")
        specRetryLine (optionOr (listHead (filter (fn [line] (= (f/scenarioId line) "specCheckRetry")) lines)) "")
        maskProbe (f/maskJournal "/fixture-root" (list "(:coreHost :built 0)" "/fixture-root/loop.asn"))]
    (do
      (assert (> n 0) "fixture declares at least one run_loop scenario")
      (assert (= (listLength lines) n) "scenario count equals fixture header")
      (assert (= n (listLength expected)) "fixture scenario count equals the requested scenario set")
      (fold (fn [acc id]
              (do (assert (listAny? (fn [line] (= (f/scenarioId line) id)) lines) (str "fixture records " id)) acc))
            true expected)
      (assert (= (listLength selectedRows) 1) "turnRows excludes other keys in the selected turn")
      (assert (stringContains? (optionOr (listHead selectedRows) "") ":reply") "turnRows retains the requested reply row")
      (assert (= (listLength maskProbe) 1) "maskJournal removes coreHost rows")
      (assert (= (optionOr (listHead maskProbe) "") "<root>/loop.asn") "maskJournal replaces the supplied root")
      (assert (not (stringContains? readLine "PermissionError")) "readThenDone recording has no sandbox error")
      (assert (not (stringContains? writeLine "ERR_WRITE_FAILED")) "writeGreenGate recording contains a successful write")
      (assert (stringContains? readLine ":result :status :ok") "readThenDone preserves its successful terminal status")
      (assert (and (stringContains? readLine ":result :status :ok")
                   (stringContains? readLine "(\"status\" \"ok\")"))
              "readThenDone fixture result and journal both remain successful")
      (assert (and (stringContains? writeLine ":result :status :ok")
                   (stringContains? writeLine "(\"status\" \"ok\")")
                   (stringContains? writeLine "grep -q green subject.txt")
                   (stringContains? writeLine ":exit 0"))
              "writeGreenGate records its successful gate and result status")
      (assert (= (listLength writeTurnRows) 3) "writeGreenGate records exactly three turn-one rows")
      (assert (fold (fn [all row] (and all (stringStartsWith? row "(:turn 1 "))) true writeTurnRows)
              "writeGreenGate keeps its journal events in turn one")
      (assert (stringContains? specMetLine ":reviewerReplies (l \"(:verdict :met true)\")")
              "specCheckMet records the independent met verdict")
      (assert (stringContains? specMetLine ":specCheck :met true") "specCheckMet reaches the reviewer check")
      (assert (stringContains? specRetryLine ":reviewerReplies (l \"(:verdict :met false")
              "specCheckRetry records the missing-requirement verdict")
      (assert (stringContains? specRetryLine ":specRetry") "specCheckRetry gives the model its retry turn")
      (assert (stringContains? specRetryLine ":specCheck :met true") "specCheckRetry completes with a successful review")
      (assert (fold (fn [clean line] (and clean (not (stringContains? line "ERR_CORE_HOST_ABSENT"))
                                             (not (stringContains? line "PermissionError"))
                                             (not (stringContains? line "scratch-writer-root-path"))))
                    true lines) "recorded scenarios exclude host failures, sandbox errors, and writer paths")
      (fold (fn [acc item]
              (let [i (pairFirst item)
                    line (pairSecond item)
                    id (f/scenarioId line)
                    repo (f/repoFiles line)
                    scenario (mt (p/planTree line) ((ok ns) (optionOr (listHead ns) (p/sexpAtom "nil"))) ((err _) (p/sexpAtom "nil")))
                    journal (map f/argStr (f/listOf (f/field scenario ":journal")))
                    masked (f/maskJournal "<root>" journal)
                    expectedResult (optionOr (listGet expectedResults i) (pair "" (pair "" "")))
                    resultEnd (optionOr (listGet masked (- (listLength masked) 1)) "")
                    root (rootFor i)
                    built (f/buildScenarioRepo! root line)
                    taskTempPathSafe (stringContains? root "/loopRunFixture_")]
                (do
                  (assert (not (stringEmpty? id)) "scenario decodes an id")
                  (assert (> (listLength repo) 0) (str id " decodes repo files"))
                  (assert (> (listLength (f/listOf (f/field scenario ":args"))) 0) (str id " records run_loop args"))
                  (assert (> (listLength (f/listOf (f/field scenario ":result"))) 0) (str id " records the result dictionary"))
                  (assert built (str id " builds its recorded repo"))
                  (assert (repoHasHead! root) (str id " rebuilt repo has a resolvable HEAD"))
                  (assert (fold (fn [matches entry]
                                  (and matches
                                       (= (resultOr (fileReadString (str root "/" (pairFirst entry))) "")
                                          (pairSecond entry))))
                                true repo) (str id " rebuilt files match recorded contents"))
                  (assert (= id (pairFirst expectedResult)) (str id " expected result row is aligned"))
                  (assert (stringContains? line (str "(\"status\" \"" (pairFirst (pairSecond expectedResult)) "\")"))
                          (str id " records its expected result status"))
                  (assert (stringContains? line
                                          (if (= (pairSecond (pairSecond expectedResult)) "nil")
                                              "(\"error\" nil)"
                                              (str "(\"error\" \"" (pairSecond (pairSecond expectedResult)) "\")")))
                          (str id " records its expected result error"))
                  (assert (stringStartsWith? resultEnd "(:result ") (str id " masked journal ends in result"))
                  (assert (and taskTempPathSafe (ok? (pathRemove root))) (str id " removes its temporary repo"))
                  (+ acc 1))))
            0 (map (fn [i] (pair i (optionOr (listGet lines i) ""))) (range 0 n)))
      true))
