(module asl/agentLoop/tests/inProcessOpsTest
  :x [runTests]
  :i [(asl/agentLoop/aslOps :a o) (asl/agentLoop/core :a c)])

fn ! writeOk path: String text: String -> Bool
  (ok? (fileWrite path text))

fn shellQuote s: String -> String
  (str "'" (stringReplace s "'" "'\\''") "'")

fn insert n: Int64 xs: (List Int64) -> (List Int64)
  (mt (listHead xs)
    ((none) (list n))
    ((some h) (if (<= n h) (cons n xs) (cons h (insert n (optionOr (listTail xs) (list)))))))

fn sort xs: (List Int64) -> (List Int64)
  (fold (fn [(acc (List Int64)) (n Int64)] -> (List Int64) (insert n acc)) (list) xs)

fn median xs: (List Int64) -> Int64
  (optionOr (listGet (sort xs) 10) 0)

fn ! elapsedNs repo: String root: String mode: String form: String -> Int64
  (let [(started (monotonicNs))
        (result (o/runAsl repo form root (if (= mode "subprocess") 120 10) (none) mode))]
    (do (assert (= (o/runExit result) 0) (str mode " read completed"))
        (- (monotonicNs) started)))

fn ! runTests -> Bool
  (do
   (assert (= (pairFirst (o/chooseTransport "inProcess" "")) "inProcess") "chooseTransport honors explicit inProcess before any new behavior checks")
   (assert (= (pairFirst (o/chooseTransport "socket" "")) "socket") "explicit socket transport stays selected without an available socket")
   (let [(tmp (stringTrim (processRun "mktemp -d /tmp/asl-inproc.XXXXXX").stdout))
        (root (str tmp "/ws"))
        (repo (resultOr (realPath ".") "."))
        (file (str root "/target.txt"))
        (made (and (!= tmp "") (ok? (dirCreate root)) (ok? (dirCreate (str root "/.asl/vfs"))) (writeOk file "base\n")
                   (= (processRun (str "git -C " (shellQuote root) " init -q")).exitCode 0)))
        (fixtureRel "asl/agentLoop/tests/fixtures/inproc/tinyTest.asl")
        (fixtureCopy (processRun (str "mkdir -p " (shellQuote (str root "/asl/agentLoop/tests/fixtures/inproc"))
                                 " && cp " (shellQuote (str repo "/" fixtureRel)) " " (shellQuote (str root "/" fixtureRel)))))
        (slowRepo (str root "/slowRepo"))
        (slowBin (str slowRepo "/bin/asl"))
        (slowToolReady (and (ok? (dirCreate (str slowRepo "/bin")))
                            (writeOk slowBin "#!/bin/sh\nsleep 5\n")
                            (= (processRun (str "chmod +x " (shellQuote slowBin))).exitCode 0)))
        (form (str "(:read :file \"target.txt\")"))
        (defaultRead (o/runAsl (str root "/no-tool") form root 10 (none) ""))
        (socketEnv (o/runAsl (str root "/no-tool") form root 10
                    (some (list (str "PATH=" (optionOr (envGet "PATH") "")) "ASL_TRANSPORT=socket")) ""))
        (inRead (o/runAsl repo form root 10 (none) ""))
        (subRead (o/runAsl repo form root 120 (none) "subprocess"))
        (receiptOp (c/parseKv "(:read :file \"target.txt\")"))
        (receiptIn (o/execAslOp! receiptOp (list) root repo "inProcess" (none) (fn [] "stableReceiptId") (fn [f] true) 8000 10 (none)))
        (receiptSub (o/execAslOp! receiptOp (list) root repo "subprocess" (none) (fn [] "stableReceiptId") (fn [f] true) 8000 120 (none)))
        (receiptEqual (= (o/serReceipt receiptIn) (o/serReceipt receiptSub)))
        (tinyTestForm (str "(:test :file \"" fixtureRel "\")"))
        (tinyTest (o/runAsl repo tinyTestForm repo 120 (none) ""))
        (nonOutlineIntel (o/runAsl slowRepo "(:intel :op graph)" root 1 (none) ""))
        (editIn "(:edit :file \"target.txt\" :old \"base\" :new \"from-in-process\")")
        (editSub "(:edit :file \"target.txt\" :old \"from-in-process\" :new \"from-subprocess\")")
        (stagedIn (o/runAsl repo editIn root 10 (none) "inProcess"))
        (flushSub (o/runAsl repo "(:flush)" root 120 (none) "subprocess"))
        (afterIn (resultOr (fileReadString file) ""))
        (stagedSub (o/runAsl repo editSub root 120 (none) "subprocess"))
        (flushIn (o/runAsl repo "(:flush)" root 10 (none) "inProcess"))
        (afterSub (resultOr (fileReadString file) ""))
        (envOverride (some (list (str "PATH=" (optionOr (envGet "PATH") "")) "ASL_TRANSPORT=inProcess" "ASL_SESSION=env-override" (str "ASL_VFS_DIR=" root "/override-vfs"))))
        (editEnv "(:edit :file \"target.txt\" :old \"from-subprocess\" :new \"from-env-override\")")
        (stagedEnv (o/runAsl repo editEnv root 10 envOverride "inProcess"))
        (flushEnv (o/runAsl repo "(:flush)" root 120 envOverride "subprocess"))
        (afterEnv (resultOr (fileReadString file) ""))
        (sameReceipt (and (= (o/runExit inRead) (o/runExit subRead))
                          (= (o/runStdout inRead) (o/runStdout subRead))
                          (= (o/runStderr inRead) (o/runStderr subRead))
                          (= (o/runTimedOut inRead) (o/runTimedOut subRead))))
        (inTimes (map (fn [i] (elapsedNs repo root "" form)) (range 0 20)))
        (subTimes (map (fn [i] (elapsedNs repo root "subprocess" form)) (range 0 20)))
        (inMedian (median inTimes))
        (subMedian (median subTimes))
        (cleaned (= (processRun (str "rm -rf " (shellQuote tmp))).exitCode 0))]
    (do
      (assert made "temporary git workspace created")
      (assert (= fixtureCopy.exitCode 0) "tiny fixture copied into subprocess workspace")
      (assert (and (= (o/runExit defaultRead) 0) (stringContains? (o/runStdout defaultRead) "base"))
        (str "default safe read runs in-process without a subprocess binary: exit=" (stringFromInt64 (o/runExit defaultRead)) " stderr=" (o/runStderr defaultRead)))
      (assert (!= (o/runFellBack socketEnv) "")
        (str "explicit ASL_TRANSPORT=socket from runAsl env is honored for a safe read: fallback=" (o/runFellBack socketEnv)))
      (assert (= (o/runExit inRead) 0) "in-process read succeeds")
      (assert (not (o/runTimedOut inRead)) "in-process read does not acquire a subprocess timeout")
      (assert sameReceipt "read stdout and exit receipt match subprocess")
      (assert receiptEqual "serialized op receipts are byte-equal across transports")
      (assert (= (o/runExit tinyTest) 0) (str "tiny fixture test completes through the existing test entry point: exit=" (stringFromInt64 (o/runExit tinyTest)) " out=" (o/runStdout tinyTest) " err=" (o/runStderr tinyTest)))
      (assert slowToolReady "slow subprocess fixture is executable")
      (assert (o/runTimedOut nonOutlineIntel) "non-outline intel remains on the killable subprocess path")
      (assert (= (o/runExit nonOutlineIntel) 1) "timed-out intel child reports failure")
      (assert (= (o/runStdout nonOutlineIntel) "") "timed-out intel child output is drained without invented stdout")
      (assert (!= (o/runStderr nonOutlineIntel) "") "timed-out intel child stderr is drained")
      (assert (= (o/runSeconds nonOutlineIntel) 1) "timed-out intel child records its configured bound")
      (assert (= (o/runFellBack nonOutlineIntel) "") "non-socket intel timeout does not claim a fallback")
      (assert (and (= (o/runExit stagedEnv) 0) (= (o/runExit flushEnv) 0) (= afterEnv "from-env-override\n"))
        (str "custom child environment honors session and VFS overrides: edit=" (o/runStdout stagedEnv) " flush=" (o/runStdout flushEnv) " file=" afterEnv))
      (assert (and (= (o/runExit stagedIn) 0) (= (o/runExit flushSub) 0) (= afterIn "from-in-process\n"))
        (str "in-process edit flushes in subprocess: edit=" (o/runStdout stagedIn) " flush=" (o/runStdout flushSub) " file=" afterIn))
      (assert (and (= (o/runExit stagedSub) 0) (= (o/runExit flushIn) 0) (= afterSub "from-subprocess\n")) "subprocess edit flushes in process")
      (assert (> inMedian 0) "in-process timing median was measured")
      (assert (> subMedian inMedian)
        (str "in-process median is faster than subprocess: in=" (stringFromInt64 inMedian) " subprocess=" (stringFromInt64 subMedian)))
      (assert cleaned "temporary workspace removed")
      (println (str "(:timing :inProcessMedianNs " (stringFromInt64 inMedian) " :subprocessMedianNs " (stringFromInt64 subMedian) " :calls 20)"))
      true)))
