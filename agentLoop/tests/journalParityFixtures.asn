(:case :id "hl_plain_git" :fn "harnessLayers" :args (l (l (l "file" "repo/asl/grammar/harness.asn" "; a synthetic harness\n(:harness :v 1\n  :layers (\n    (:layer :id intro :text \"cwd {cwd}; git {git}; dir {promptDir}; note {note}; shell {shell}; sub {subagent}; more {aslMore}; keep {nope} {{x} {}\")\n    (:layer :id impl :when (implement) :unless (agy) :text \"implementing; run asl-host or asl/host/out/asl-host, not x-asl-host, asl-hostx, /asl-host or asl-host-2\")\n    (:layer :id scoutOnly :when (distill) :text \"distilling\")\n    (:layer :id neg :unless (git) :text \"no git here\")\n    (:layer :id lang :when (aslProject) :from language)\n    (:layer :id langTools :from languageTools)\n    (:layer :id att :from attractors))\n  :attractors (:intro \"attractors:\" :items ((:attractor :id a1 :goal \"finish\" :shadow \"rush\") (:attractor :id a2 :goal \"check\" :shadow \"stall\"))\n    :modes ((:mode :id implement :attractors (a1 a2)) (:mode :id grade :attractors (a2)))))\n") (l "file" "repo/asl/grammar/clients.asn" "(:clients :v 1 :clients ((:client :id leon :layers \"intro, impl ,scoutOnly,neg,lang,langTools,att\") (:client :id other :layers \"\")))") (l "file" "repo/asl/grammar/tools.asn" "(:tools :topics ((:topic :name :language :text \"LANG \\\"text\\\"\" :tools \"TOOLS text\")) :entries ((:op :brief \"b1\") (:op :brief \"b2\") (:op :name x)))") (l "dir" "w") (l "git" "w" "init" "-q") (l "file" "w/x.txt" "x\n") (l "git" "w" "add" "-A") (l "git" "w" "commit" "-q" "-m" "c0")) "@ROOT@/w" "implement" "@ROOT@/repo") :out (d ("ret" "cwd @ROOT@/w; git @ROOT@/w on main; dir the prompt dir; note note.md; shell shell; sub a subagent tool; more b1; b2; keep {nope} {{x} {}\nimplementing; run @ROOT@/repo/asl/host/out/asl-host or @ROOT@/repo/asl/host/out/asl-host, not x-asl-host, asl-hostx, /asl-host or asl-host-2\nTOOLS text\nattractors: a1: finish, overdone: rush; a2: check, overdone: stall")))
(:case :id "hl_detached" :fn "harnessLayers" :args (l (l (l "file" "repo/asl/grammar/harness.asn" "; a synthetic harness\n(:harness :v 1\n  :layers (\n    (:layer :id intro :text \"cwd {cwd}; git {git}; dir {promptDir}; note {note}; shell {shell}; sub {subagent}; more {aslMore}; keep {nope} {{x} {}\")\n    (:layer :id impl :when (implement) :unless (agy) :text \"implementing; run asl-host or asl/host/out/asl-host, not x-asl-host, asl-hostx, /asl-host or asl-host-2\")\n    (:layer :id scoutOnly :when (distill) :text \"distilling\")\n    (:layer :id neg :unless (git) :text \"no git here\")\n    (:layer :id lang :when (aslProject) :from language)\n    (:layer :id langTools :from languageTools)\n    (:layer :id att :from attractors))\n  :attractors (:intro \"attractors:\" :items ((:attractor :id a1 :goal \"finish\" :shadow \"rush\") (:attractor :id a2 :goal \"check\" :shadow \"stall\"))\n    :modes ((:mode :id implement :attractors (a1 a2)) (:mode :id grade :attractors (a2)))))\n") (l "file" "repo/asl/grammar/clients.asn" "(:clients :v 1 :clients ((:client :id leon :layers \"intro, impl ,scoutOnly,neg,lang,langTools,att\") (:client :id other :layers \"\")))") (l "file" "repo/asl/grammar/tools.asn" "(:tools :topics ((:topic :name :language :text \"LANG \\\"text\\\"\" :tools \"TOOLS text\")) :entries ((:op :brief \"b1\") (:op :brief \"b2\") (:op :name x)))") (l "dir" "w") (l "git" "w" "init" "-q") (l "file" "w/m.asl" "(module w/m)\n") (l "git" "w" "add" "-A") (l "git" "w" "commit" "-q" "-m" "c0") (l "git" "w" "checkout" "-q" "--detach")) "@ROOT@/w" "implement" "@ROOT@/repo") :out (d ("ret" "cwd @ROOT@/w; git @ROOT@/w on detached HEAD; dir the prompt dir; note note.md; shell shell; sub a subagent tool; more b1; b2; keep {nope} {{x} {}\nimplementing; run @ROOT@/repo/asl/host/out/asl-host or @ROOT@/repo/asl/host/out/asl-host, not x-asl-host, asl-hostx, /asl-host or asl-host-2\nLANG \"text\"\nTOOLS text\nattractors: a1: finish, overdone: rush; a2: check, overdone: stall")))
(:case :id "hl_base_grammar_asl_project" :fn "harnessLayers" :args (l (l (l "base" "repo/asl/grammar/harness.asn" "asl/grammar/harness.asn") (l "base" "repo/asl/grammar/clients.asn" "asl/grammar/clients.asn") (l "base" "repo/asl/grammar/tools.asn" "asl/grammar/tools.asn") (l "base" "repo/scripts/agentLoop/effects.asn" "scripts/agentLoop/effects.asn") (l "dir" "w") (l "git" "w" "init" "-q") (l "file" "w/m.asl" "(module w/m)\n") (l "git" "w" "add" "-A") (l "git" "w" "commit" "-q" "-m" "c0")) "@ROOT@/w" "implement" "@ROOT@/repo") :out (d ("ret" "An ASL file is a module header, then items starting in column 0: (module ws/name :d \"doc\" :x [exported names] :i [(other/module :a alias)]). Imports name the module a file declares, not its path. A function is a bare line, fn name a: Int64 b: String -> Bool, with its body indented below; that line is not a form, so the body closes only its own parentheses. Each bracket kind pairs exactly: ( ) forms, [ ] lists, { } records. enum Shape (circle r: Int64) (square side: Int64) makes positional constructors, taken apart by (mt s ((circle r) ...) ((square a) ...)); patterns nest one level. (let [(a 1) (b (+ a 1))] body) binds in sequence; (fn [x] body) is a value; cond ends with (else v). Conditions, and, or, not and assert take only true or false. Int and Float never mix; overflow and division by zero trap. There is no nil, exception or try: listHead, listTail, listGet, listSlice, stringSlice and mapGet return (some v) or (none), failures are (err e), unwrapped by mt, optionOr or resultOr. Builtins are camelCase like user names, predicates end in ?: listLength, stringContains?, some?; len and head do not exist; + is not a value. A test exports runTests, returning true after at least one (assert cond \"msg\") or refute. The stage-0 host @ROOT@/repo/asl/host/out/asl-host enforces all this before running, and (:test), (:check), asl test and asl check of an .asl file and asl eval run on it (asl eval prints a keyword-headed form back as ASN data); a bare asl test or asl check sweeps every discovered suite or tracked file on it, and the lenient asl-core runner is retired.\na claim holds when a tool result in this session shows it; another agent's report, a status file and a README are claims until a check reruns them; a passing suite covers only what its assertions exercise; done is a path from an entry point to its effect that a check executed, and a stub, a TODO, a flag nothing reads or a function nothing calls is not done; a feature missing a dependency does not work however complete the rest is; the reader tells done from claimed and known from unknown only by what the reply shows: the command, its exit code, the assertions it ran and what stayed unverified, and a total it states is computed from the results it lists\nan answer about a whole (every caller, requirement or site) covers what was searched, and aliases, re-exports, string dispatch and tests are places a name also lives; a reply lists the places asked for, and a place named to rule it out is named without its line; a count, list or figure is exact for the scope, method and date that produced it, and without them it is an estimate")))
(:case :id "hl_base_grammar_plain" :fn "harnessLayers" :args (l (l (l "base" "repo/asl/grammar/harness.asn" "asl/grammar/harness.asn") (l "base" "repo/asl/grammar/clients.asn" "asl/grammar/clients.asn") (l "base" "repo/asl/grammar/tools.asn" "asl/grammar/tools.asn") (l "base" "repo/scripts/agentLoop/effects.asn" "scripts/agentLoop/effects.asn") (l "dir" "plain")) "@ROOT@/plain" "implement" "@ROOT@/repo") :out (d ("ret" "a claim holds when a tool result in this session shows it; another agent's report, a status file and a README are claims until a check reruns them; a passing suite covers only what its assertions exercise; done is a path from an entry point to its effect that a check executed, and a stub, a TODO, a flag nothing reads or a function nothing calls is not done; a feature missing a dependency does not work however complete the rest is; the reader tells done from claimed and known from unknown only by what the reply shows: the command, its exit code, the assertions it ran and what stayed unverified, and a total it states is computed from the results it lists\nan answer about a whole (every caller, requirement or site) covers what was searched, and aliases, re-exports, string dispatch and tests are places a name also lives; a reply lists the places asked for, and a place named to rule it out is named without its line; a count, list or figure is exact for the scope, method and date that produced it, and without them it is an estimate")))
(:case :id "bsp_minimal_no_effects" :fn "buildSystemPrompt" :args (l (l (l "file" "repo/asl/grammar/harness.asn" "; a synthetic harness\n(:harness :v 1\n  :layers (\n    (:layer :id intro :text \"cwd {cwd}; git {git}; dir {promptDir}; note {note}; shell {shell}; sub {subagent}; more {aslMore}; keep {nope} {{x} {}\")\n    (:layer :id impl :when (implement) :unless (agy) :text \"implementing; run asl-host or asl/host/out/asl-host, not x-asl-host, asl-hostx, /asl-host or asl-host-2\")\n    (:layer :id scoutOnly :when (distill) :text \"distilling\")\n    (:layer :id neg :unless (git) :text \"no git here\")\n    (:layer :id lang :when (aslProject) :from language)\n    (:layer :id langTools :from languageTools)\n    (:layer :id att :from attractors))\n  :attractors (:intro \"attractors:\" :items ((:attractor :id a1 :goal \"finish\" :shadow \"rush\") (:attractor :id a2 :goal \"check\" :shadow \"stall\"))\n    :modes ((:mode :id implement :attractors (a1 a2)) (:mode :id grade :attractors (a2)))))\n") (l "file" "repo/asl/grammar/clients.asn" "(:clients :v 1 :clients ((:client :id leon :layers \"intro, impl ,scoutOnly,neg,lang,langTools,att\") (:client :id other :layers \"\")))") (l "file" "repo/asl/grammar/tools.asn" "(:tools :topics ((:topic :name :language :text \"LANG \\\"text\\\"\" :tools \"TOOLS text\")) :entries ((:op :brief \"b1\") (:op :brief \"b2\") (:op :name x)))") (l "dir" "w") (l "git" "w" "init" "-q") (l "file" "w/m.asl" "(module w/m)\n") (l "git" "w" "add" "-A") (l "git" "w" "commit" "-q" "-m" "c0")) "" "@ROOT@/w" nil nil nil false "@ROOT@/repo") :out (d ("ret" "answer contract: a program reads the reply as ASN forms; several forms in one reply run in order; an unbalanced form or over 40 words outside the forms is a parse defect; fenced forms are read\n\ngrounding: a claim holds when a receipt or the given context shows it; what the context and receipts do not show is unknown; (:escalate :reason s) or a (:findings ...) claim naming what is needed carries it to the reader\n\ntools: the step forms below are executed in the workspace by the program that reads your reply, and each receipt comes back next turn; a write or edit step is applied to the file at once inside :owns; a later edit is the only undo; a run that does not end with green gates is handed back as a patch and the files are restored; quote an :old only from text a receipt still shows whole; before a cut can take them, copy the lines you will edit into (:note ...); after a cut re-read only the lines one edit needs, once\n\nscope: paths resolve against the workspace root; a read outside the workspace answers ERR_BOUNDARY_VIOLATION\n\ndone by escalating: when a receipt shows the cause in a file outside :owns, (:escalate :reason s) naming that file and the receipt :id is the finished answer\n\nevidence: (:evidence (:receipt id)) runs nothing; it cites the :id of a receipt already in the context; a command exit counts as evidence only through a run or gate receipt\n\nthe task decides the phases, and you choose them in any order, each as often as needed: scout reads and searches and reports (:findings ...); plan sets the plan as the session (:note ...); implement writes inside :owns, or anywhere inside the workspace root when no :owns is given; grade runs the declared gates with (:step :op \"gate\") and cites their receipts; the run ends with (:done), (:findings ...) or (:escalate :reason s); (:done :commit s) commits the written paths when the task asks for a commit; code it writes catches the specific error and handles or reports it; it never writes a bare except or except Exception followed by pass\n\nfirst state what the task asks you to deliver as (:intent :deliver findings|patch|plan|verdict :why s); findings that need web or document research add :kind research, and a turn after a search or research step is served by a research model; a later (:intent ...) restates it; findings are done with (:findings ...) claims that receipts back; findings accumulate across turns, a claim with the same :file and :anchor replaces the earlier one, and (:retract :file f :anchor a) inside (:findings ...) drops one; a patch is done once a write is applied and the declared gates pass; a plan is done with (:note ...) and (:done); a verdict is done with (:findings ...) citing gate receipts\n\nbatching: a turn costs a whole model call and a wrong guess costs one receipt, so each reply carries every independent read, query, edit and gate step you can foresee; only a step that needs a receipt not yet seen waits for the next turn, where you recalibrate; a reply has no limit on steps; three steps in one reply, the edit quoting lines an earlier receipt showed: (:step :op \"edit\" :file \"src/ring.py\" :old \"return xs[len(xs)]\" :new \"return xs[len(xs) - 1]\") (:step :op \"read\" :file \"tests/ringTest.sh\" :start 1 :end 60) (:step :op \"gate\" :n 1); once the lines to change are seen, the next reply carries the edit\n\nan outline step lists a file's defs and classes with their line spans, cheaper than reading it; every call site of a function, through aliases and modules: the observe step with :dim callers :symbol s\n\neach (:step ...) runs in the workspace; the next message carries the task, each earlier turn as (:turn n :sent <your forms> :got <its receipts>), and last (:now ...) with the files written, the newest gate runs and :last, the newest turn\n\na window cut drops older receipts; a (:note ...) survives it, sent whole in every message: keep in it the decisions, the target file and span, and the next write")))
(:case :id "bsp_synthetic_effects" :fn "buildSystemPrompt" :args (l (l (l "file" "repo/asl/grammar/harness.asn" "; a synthetic harness\n(:harness :v 1\n  :layers (\n    (:layer :id intro :text \"cwd {cwd}; git {git}; dir {promptDir}; note {note}; shell {shell}; sub {subagent}; more {aslMore}; keep {nope} {{x} {}\")\n    (:layer :id impl :when (implement) :unless (agy) :text \"implementing; run asl-host or asl/host/out/asl-host, not x-asl-host, asl-hostx, /asl-host or asl-host-2\")\n    (:layer :id scoutOnly :when (distill) :text \"distilling\")\n    (:layer :id neg :unless (git) :text \"no git here\")\n    (:layer :id lang :when (aslProject) :from language)\n    (:layer :id langTools :from languageTools)\n    (:layer :id att :from attractors))\n  :attractors (:intro \"attractors:\" :items ((:attractor :id a1 :goal \"finish\" :shadow \"rush\") (:attractor :id a2 :goal \"check\" :shadow \"stall\"))\n    :modes ((:mode :id implement :attractors (a1 a2)) (:mode :id grade :attractors (a2)))))\n") (l "file" "repo/asl/grammar/clients.asn" "(:clients :v 1 :clients ((:client :id leon :layers \"intro, impl ,scoutOnly,neg,lang,langTools,att\") (:client :id other :layers \"\")))") (l "file" "repo/asl/grammar/tools.asn" "(:tools :topics ((:topic :name :language :text \"LANG \\\"text\\\"\" :tools \"TOOLS text\")) :entries ((:op :brief \"b1\") (:op :brief \"b2\") (:op :name x)))") (l "file" "repo/scripts/agentLoop/effects.asn" "(:effects (:op \"read\" :class :local) (:op \"write\" :class :local) (:op \"diff\" :class :local)\n (:op \"step\" :class :local) (:op \"push\" :class :outward) (:op  \"rm\"\n :class   :irreversible)\n (:op \"ask\" :class :needsConfirm) (:op \"nope\" :class :other) (:op \"read\" :class :local) (:ops \"x\" :class :local)\n (:op \"gate\" :class :local) (:op \"unknownShape\" :class :local) (:op \"\" :class :local))") (l "dir" "w") (l "git" "w" "init" "-q") (l "file" "w/m.asl" "(module w/m)\n") (l "git" "w" "add" "-A") (l "git" "w" "commit" "-q" "-m" "c0")) "fix \"it\"" "@ROOT@/w" "main" (l "sh a.sh" "echo \"q\"\\n") 7999 true "@ROOT@/repo") :out (d ("ret" (h 5126 "c2223dd2600d970cbbbd7ab20c8844027df9f61e3d9c7cce3f4d0d09062c737f"))))
(:case :id "bsp_ctx_layers" :fn "buildSystemPrompt" :args (l (l (l "file" "repo/asl/grammar/harness.asn" "; a synthetic harness\n(:harness :v 1\n  :layers (\n    (:layer :id intro :text \"cwd {cwd}; git {git}; dir {promptDir}; note {note}; shell {shell}; sub {subagent}; more {aslMore}; keep {nope} {{x} {}\")\n    (:layer :id impl :when (implement) :unless (agy) :text \"implementing; run asl-host or asl/host/out/asl-host, not x-asl-host, asl-hostx, /asl-host or asl-host-2\")\n    (:layer :id scoutOnly :when (distill) :text \"distilling\")\n    (:layer :id neg :unless (git) :text \"no git here\")\n    (:layer :id lang :when (aslProject) :from language)\n    (:layer :id langTools :from languageTools)\n    (:layer :id att :from attractors))\n  :attractors (:intro \"attractors:\" :items ((:attractor :id a1 :goal \"finish\" :shadow \"rush\") (:attractor :id a2 :goal \"check\" :shadow \"stall\"))\n    :modes ((:mode :id implement :attractors (a1 a2)) (:mode :id grade :attractors (a2)))))\n") (l "file" "repo/asl/grammar/clients.asn" "(:clients :v 1 :clients ((:client :id leon :layers \"intro, impl ,scoutOnly,neg,lang,langTools,att\") (:client :id other :layers \"\")))") (l "file" "repo/asl/grammar/tools.asn" "(:tools :topics ((:topic :name :language :text \"LANG \\\"text\\\"\" :tools \"TOOLS text\")) :entries ((:op :brief \"b1\") (:op :brief \"b2\") (:op :name x)))") (l "file" "repo/scripts/agentLoop/effects.asn" "(:effects (:op \"read\" :class :local) (:op \"write\" :class :local) (:op \"diff\" :class :local)\n (:op \"step\" :class :local) (:op \"push\" :class :outward) (:op  \"rm\"\n :class   :irreversible)\n (:op \"ask\" :class :needsConfirm) (:op \"nope\" :class :other) (:op \"read\" :class :local) (:ops \"x\" :class :local)\n (:op \"gate\" :class :local) (:op \"unknownShape\" :class :local) (:op \"\" :class :local))") (l "dir" "w") (l "git" "w" "init" "-q") (l "file" "w/m.asl" "(module w/m)\n") (l "git" "w" "add" "-A") (l "git" "w" "commit" "-q" "-m" "c0")) "t" "@ROOT@/w" nil (l) 8000 false "@ROOT@/repo") :out (d ("ret" (h 4740 "204db3cb243959c8d6b713a274acd123cf3a58e4ef0035b416baf9797613be17"))))
(:case :id "bsp_ctx_layers_error" :fn "buildSystemPrompt" :args (l (l (l "file" "repo/asl/grammar/harness.asn" "; a synthetic harness\n(:harness :v 1\n  :layers (\n    (:layer :id intro :text \"cwd {cwd}; git {git}; dir {promptDir}; note {note}; shell {shell}; sub {subagent}; more {aslMore}; keep {nope} {{x} {}\")\n    (:layer :id impl :when (implement) :unless (agy) :text \"implementing; run asl-host or asl/host/out/asl-host, not x-asl-host, asl-hostx, /asl-host or asl-host-2\")\n    (:layer :id scoutOnly :when (distill) :text \"distilling\")\n    (:layer :id neg :unless (git) :text \"no git here\")\n    (:layer :id lang :when (aslProject) :from language)\n    (:layer :id langTools :from languageTools)\n    (:layer :id att :from attractors))\n  :attractors (:intro \"attractors:\" :items ((:attractor :id a1 :goal \"finish\" :shadow \"rush\") (:attractor :id a2 :goal \"check\" :shadow \"stall\"))\n    :modes ((:mode :id implement :attractors (a1 a2)) (:mode :id grade :attractors (a2)))))\n") (l "file" "repo/asl/grammar/clients.asn" "(:clients :clients ())") (l "file" "repo/asl/grammar/tools.asn" "(:tools :topics ((:topic :name :language :text \"LANG \\\"text\\\"\" :tools \"TOOLS text\")) :entries ((:op :brief \"b1\") (:op :brief \"b2\") (:op :name x)))") (l "file" "repo/scripts/agentLoop/effects.asn" "(:effects (:op \"read\" :class :local) (:op \"write\" :class :local) (:op \"diff\" :class :local)\n (:op \"step\" :class :local) (:op \"push\" :class :outward) (:op  \"rm\"\n :class   :irreversible)\n (:op \"ask\" :class :needsConfirm) (:op \"nope\" :class :other) (:op \"read\" :class :local) (:ops \"x\" :class :local)\n (:op \"gate\" :class :local) (:op \"unknownShape\" :class :local) (:op \"\" :class :local))") (l "dir" "w") (l "git" "w" "init" "-q") (l "file" "w/m.asl" "(module w/m)\n") (l "git" "w" "add" "-A") (l "git" "w" "commit" "-q" "-m" "c0")) "t" "@ROOT@/w" nil nil 9000 false "@ROOT@/repo") :out (d ("raise" "RuntimeError: ERR_HARNESS: asl/grammar/clients.asn has no (:client :id leon :layers ...)")))
(:case :id "bsp_effects_only_confirm" :fn "buildSystemPrompt" :args (l (l (l "file" "repo/asl/grammar/harness.asn" "; a synthetic harness\n(:harness :v 1\n  :layers (\n    (:layer :id intro :text \"cwd {cwd}; git {git}; dir {promptDir}; note {note}; shell {shell}; sub {subagent}; more {aslMore}; keep {nope} {{x} {}\")\n    (:layer :id impl :when (implement) :unless (agy) :text \"implementing; run asl-host or asl/host/out/asl-host, not x-asl-host, asl-hostx, /asl-host or asl-host-2\")\n    (:layer :id scoutOnly :when (distill) :text \"distilling\")\n    (:layer :id neg :unless (git) :text \"no git here\")\n    (:layer :id lang :when (aslProject) :from language)\n    (:layer :id langTools :from languageTools)\n    (:layer :id att :from attractors))\n  :attractors (:intro \"attractors:\" :items ((:attractor :id a1 :goal \"finish\" :shadow \"rush\") (:attractor :id a2 :goal \"check\" :shadow \"stall\"))\n    :modes ((:mode :id implement :attractors (a1 a2)) (:mode :id grade :attractors (a2)))))\n") (l "file" "repo/asl/grammar/clients.asn" "(:clients :v 1 :clients ((:client :id leon :layers \"intro, impl ,scoutOnly,neg,lang,langTools,att\") (:client :id other :layers \"\")))") (l "file" "repo/asl/grammar/tools.asn" "(:tools :topics ((:topic :name :language :text \"LANG \\\"text\\\"\" :tools \"TOOLS text\")) :entries ((:op :brief \"b1\") (:op :brief \"b2\") (:op :name x)))") (l "file" "repo/scripts/agentLoop/effects.asn" "(:op \"push\" :class :outward)") (l "dir" "w") (l "git" "w" "init" "-q") (l "file" "w/m.asl" "(module w/m)\n") (l "git" "w" "add" "-A") (l "git" "w" "commit" "-q" "-m" "c0")) "t" "@ROOT@/w" "b" nil nil false "@ROOT@/repo") :out (d ("ret" "answer contract: a program reads the reply as ASN forms; several forms in one reply run in order; an unbalanced form or over 40 words outside the forms is a parse defect; fenced forms are read\n\ngrounding: a claim holds when a receipt or the given context shows it; what the context and receipts do not show is unknown; (:escalate :reason s) or a (:findings ...) claim naming what is needed carries it to the reader\n\ntools: the step forms below are executed in the workspace by the program that reads your reply, and each receipt comes back next turn; a write or edit step is applied to the file at once inside :owns; a later edit is the only undo; a run that does not end with green gates is handed back as a patch and the files are restored; quote an :old only from text a receipt still shows whole; before a cut can take them, copy the lines you will edit into (:note ...); after a cut re-read only the lines one edit needs, once\n\nscope: paths resolve against the workspace root; a read outside the workspace answers ERR_BOUNDARY_VIOLATION\n\ndone by escalating: when a receipt shows the cause in a file outside :owns, (:escalate :reason s) naming that file and the receipt :id is the finished answer\n\nevidence: (:evidence (:receipt id)) runs nothing; it cites the :id of a receipt already in the context; a command exit counts as evidence only through a run or gate receipt\n\nthe task decides the phases, and you choose them in any order, each as often as needed: scout reads and searches and reports (:findings ...); plan sets the plan as the session (:note ...); implement writes inside :owns, or anywhere inside the workspace root when no :owns is given; grade runs the declared gates with (:step :op \"gate\") and cites their receipts; the run ends with (:done), (:findings ...) or (:escalate :reason s); (:done :commit s) commits the written paths when the task asks for a commit; code it writes catches the specific error and handles or reports it; it never writes a bare except or except Exception followed by pass\n\nfirst state what the task asks you to deliver as (:intent :deliver findings|patch|plan|verdict :why s); findings that need web or document research add :kind research, and a turn after a search or research step is served by a research model; a later (:intent ...) restates it; findings are done with (:findings ...) claims that receipts back; findings accumulate across turns, a claim with the same :file and :anchor replaces the earlier one, and (:retract :file f :anchor a) inside (:findings ...) drops one; a patch is done once a write is applied and the declared gates pass; a plan is done with (:note ...) and (:done); a verdict is done with (:findings ...) citing gate receipts\n\nbatching: a turn costs a whole model call and a wrong guess costs one receipt, so each reply carries every independent read, query, edit and gate step you can foresee; only a step that needs a receipt not yet seen waits for the next turn, where you recalibrate; a reply has no limit on steps; three steps in one reply, the edit quoting lines an earlier receipt showed: (:step :op \"edit\" :file \"src/ring.py\" :old \"return xs[len(xs)]\" :new \"return xs[len(xs) - 1]\") (:step :op \"read\" :file \"tests/ringTest.sh\" :start 1 :end 60) (:step :op \"gate\" :n 1); once the lines to change are seen, the next reply carries the edit\n\nan outline step lists a file's defs and classes with their line spans, cheaper than reading it; every call site of a function, through aliases and modules: the observe step with :dim callers :symbol s\n\nnot run, answered with a needsConfirm receipt: push\n\neach (:step ...) runs in the workspace; the next message carries the task, each earlier turn as (:turn n :sent <your forms> :got <its receipts>), and last (:now ...) with the files written, the newest gate runs and :last, the newest turn\n\na window cut drops older receipts; a (:note ...) survives it, sent whole in every message: keep in it the decisions, the target file and span, and the next write\n\nTask: t\n\nBase: b")))
(:case :id "bsp_base_grammar_full" :fn "buildSystemPrompt" :args (l (l (l "base" "repo/asl/grammar/harness.asn" "asl/grammar/harness.asn") (l "base" "repo/asl/grammar/clients.asn" "asl/grammar/clients.asn") (l "base" "repo/asl/grammar/tools.asn" "asl/grammar/tools.asn") (l "base" "repo/scripts/agentLoop/effects.asn" "scripts/agentLoop/effects.asn") (l "dir" "w") (l "git" "w" "init" "-q") (l "file" "w/m.asl" "(module w/m)\n") (l "git" "w" "add" "-A") (l "git" "w" "commit" "-q" "-m" "c0")) "port the loop" "@ROOT@/w" "02aff5d0" (l "./bin/asl test x") 32000 true "@ROOT@/repo") :out (d ("ret" (h 8858 "d155751d37b9fcdd27448cc311752797bfa2b890cde57aa3b3b50a81b048d5fe"))))
(:case :id "bsp_base_grammar_small" :fn "buildSystemPrompt" :args (l (l (l "base" "repo/asl/grammar/harness.asn" "asl/grammar/harness.asn") (l "base" "repo/asl/grammar/clients.asn" "asl/grammar/clients.asn") (l "base" "repo/asl/grammar/tools.asn" "asl/grammar/tools.asn") (l "base" "repo/scripts/agentLoop/effects.asn" "scripts/agentLoop/effects.asn") (l "dir" "w") (l "git" "w" "init" "-q") (l "file" "w/m.asl" "(module w/m)\n") (l "git" "w" "add" "-A") (l "git" "w" "commit" "-q" "-m" "c0")) "small" "@ROOT@/w" nil nil 4000 false "@ROOT@/repo") :out (d ("ret" (h 5482 "ba58595caf1aed5b6fc61dc5fb49b4c33725207ca96ab3f200d55ed189d9d254"))))
