(fmt "fmtErrorColon" 8000 (r (id "e1") (op "edit") (status "rejected") (error ":ERR_NO_MATCH") (warning "w\n\"q\"") (line 7) (arrived "(:edit") (hint "h") (balance "b") (nearest "near") (terminal ("(:done)" "(:escalate :reason s)")) (restored ("x.txt")) (owns ("a" "b\"c")) (flushed ("f"))) (want "(:receipt :id \"e1\" :op \"edit\" :status :rejected :owns (\"a\" \"b\\\"c\") :flushed (\"f\") :error :ERR_NO_MATCH :warning \"w\\n\\\"q\\\"\" :line 7 :arrived \"(:edit\" :hint \"h\" :balance \"b\" :nearest \"near\" :terminal (\"(:done)\" \"(:escalate :reason s)\") :restored (\"x.txt\"))"))
(fmt "fmtRunExit" 8000 (r (id "u1") (op "run") (status "failed") (cmd "make \"x\"") (exit 2)) (want "(:receipt :id \"u1\" :op \"run\" :status :failed :cmd \"make \\\"x\\\"\" :exit 2)"))
(fmt "fmtManage" 8000 (r (id "m1") (op "manage") (status "ok") (action "poll") (exit 0) (path "p1")) (want "(:receipt :id \"m1\" :op \"manage\" :status :ok :path \"p1\" :action :poll :exit 0)"))
(fmt "fmtManageNoExit" 8000 (r (id "m2") (op "manage") (status "rejected")) (want "(:receipt :id \"m2\" :op \"manage\" :status :rejected :action :)"))
(fmt "fmtNoStatus" 8000 (r (op "x")) (want "(:receipt :id \"\" :op \"x\" :status :ok)"))
(fmt "fmtGateRuns" 8000 (r (id "t1") (op "gate") (status "failed") (gateRuns ((r (id "a") (cmd "sh t.sh") (exit 1) (stdout "o0\no1\no2\no3\no4\no5\no6\no7\no8\no9\no10\no11\no12\no13\no14\no15\no16\no17\no18\no19\no20\no21\no22\no23\no24\no25\no26\no27\no28\no29") (stderr "bad") (n 1)) (r (id "b") (cmd "sleep 9") (exit none) (stdout "") (stderr "") (timeout true) (seconds 5)) (r (id "c") (cmd "true") (exit 0) (stdout "") (stderr ""))))) (want "(:receipt :id \"t1\" :op \"gate\" :status :failed :gates ((:n 1 :cmd \"sh t.sh\" :exit 1 :tail \"o11\\no12\\no13\\no14\\no15\\no16\\no17\\no18\\no19\\no20\\no21\\no22\\no23\\no24\\no25\\no26\\no27\\no28\\no29\\nbad\") (:cmd \"sleep 9\" :timeout true :seconds 5 :tail \"\") (:cmd \"true\" :exit 0 :tail \"\")))"))
(fmt "fmtEmptyValues" 8000 (r (id "z1") (op "read") (status "ok") (file "") (path "") (owns ()) (flushed ()) (error "") (message "") (nearest "") (terminal ()) (restored ()) (content none) (hits none) (diff none) (line none) (hint none)) (want "(:receipt :id \"z1\" :op \"read\" :status :ok)"))
(shape "write" (want "(:step :op \"write\" :file f :content :raw|s)"))
(shape "edit" (want "(:step :op \"edit\" :file f :old :raw|s :new :raw|s)"))
(shape "read" (want "(:step :op \"read\" :file f [:symbol name] [:anchor s] [:start n :end m])"))
(shape "query" (want "(:step :op \"query\" :query s [:in code|text|all] [:limit n])"))
(shape "outline" (want "(:step :op \"outline\" :file f)"))
(shape "check" (want "(:step :op \"check\" :file f)"))
(shape "diff" (want "(:step :op \"diff\")"))
(shape "flush" (want "(:step :op \"flush\")"))
(shape "discard" (want "(:step :op \"discard\")"))
(shape "test" (want "(:step :op \"test\" :file f)"))
(shape "tree" (want "(:step :op \"tree\" :path p)"))
(shape "fix" (want "(:step :op \"fix\" :file f)"))
(shape "txn" (want "(:txn :owns (f ...) ...)"))
(shape "tools" (want "(:step :op \"tools\")"))
(shape "help" (want "(:step :op \"help\" :name op)"))
(shape "findings" (want "(:findings (:claim s :file f))"))
(shape "evidence" (want "(:evidence (:receipt id [:exit n]))"))
(shape "escalate" (want "(:escalate :reason s)"))
(shape "done" (want "(:done [:commit s])"))
(shape "gitDiff" (want "(:step :op \"gitDiff\" :path p :base rev [:start n :end m])"))
(shape "gitLog" (want "(:step :op \"gitLog\" :path p :limit n [:start n :end m])"))
(shape "gitShow" (want "(:step :op \"gitShow\" :rev rev :path p [:start n :end m])"))
(shape "gate" (want "(:step :op \"gate\" [:n i])"))
(shape "run" (want "(:step :op \"run\" :argv \"cmd\")"))
(shape "delete" (want "(:step :op \"delete\" :file f)"))
(shape "manage" (want "(:step :op \"manage\" :action spawn|poll|tail|send|kill|list :id name [:cmd c] [:text s])"))
(shape "note" (want "(:step :op \"note\" :text s)"))
(shape "observe" (want "(:step :op \"observe\" :dim callers|status|coverage|tokenCost|memory|session [:symbol s] [:path p] [:spec p])"))
(shape "search" (want "(:step :op \"search\" :query s [:limit n])"))
(shape "research" (want "(:step :op \"research\" :topic s [:depth flash|deep|exhaustive])"))
(shape "crawl" (want "(:step :op \"crawl\" :url u [:distill text|asn] [:limit n])"))
(accepted "scout" (want "(\"read\" \"query\" \"check\" \"diff\" \"test\" \"tree\" \"observe\" \"outline\" \"intel\" \"tools\" \"help\" \"findings\" \"evidence\" \"escalate\" \"done\" \"gitDiff\" \"gitLog\" \"gitShow\" \"note\" \"search\" \"research\" \"crawl\")"))
(accepted "implement" (want "(\"read\" \"query\" \"write\" \"edit\" \"check\" \"diff\" \"flush\" \"discard\" \"test\" \"tree\" \"observe\" \"outline\" \"intel\" \"fix\" \"txn\" \"tools\" \"help\" \"evidence\" \"escalate\" \"done\" \"gitDiff\" \"gitLog\" \"gitShow\" \"note\" \"delete\" \"run\" \"gate\" \"search\" \"research\" \"crawl\" \"manage\")"))
(accepted "auto" (want "(\"read\" \"query\" \"write\" \"edit\" \"check\" \"diff\" \"flush\" \"discard\" \"test\" \"tree\" \"observe\" \"outline\" \"intel\" \"fix\" \"txn\" \"tools\" \"help\" \"findings\" \"evidence\" \"escalate\" \"done\" \"gitDiff\" \"gitLog\" \"gitShow\" \"note\" \"delete\" \"run\" \"gate\" \"search\" \"research\" \"crawl\" \"manage\")"))
(accepted "plan" (want "(\"read\" \"query\" \"write\" \"edit\" \"check\" \"diff\" \"flush\" \"discard\" \"test\" \"tree\" \"observe\" \"outline\" \"intel\" \"fix\" \"txn\" \"tools\" \"help\" \"evidence\" \"escalate\" \"done\" \"gitDiff\" \"gitLog\" \"gitShow\" \"note\" \"delete\" \"run\" \"gate\" \"search\" \"research\" \"crawl\" \"manage\")"))
(accepted "grade" (want "(\"read\" \"query\" \"write\" \"edit\" \"check\" \"diff\" \"flush\" \"discard\" \"test\" \"tree\" \"observe\" \"outline\" \"intel\" \"fix\" \"txn\" \"tools\" \"help\" \"evidence\" \"escalate\" \"done\" \"gitDiff\" \"gitLog\" \"gitShow\" \"note\" \"delete\" \"run\" \"gate\" \"search\" \"research\" \"crawl\" \"manage\")"))
(terminal "scout" (want "(\"(:findings (:claim s :file f))\" \"(:escalate :reason s)\")"))
(terminal "implement" (want "(\"(:done)\" \"(:escalate :reason s)\")"))
(terminal "auto" (want "(\"(:done)\" \"(:escalate :reason s)\" \"(:findings (:claim s :file f))\")"))
(undeclared "reed" "scout" (want "(r (nearest \"read\"))"))
(undeclared "append" "implement" (want "(r (nearest \"write\"))"))
(undeclared "xyzzy" "scout" (want "(r (terminal (\"(:findings (:claim s :file f))\" \"(:escalate :reason s)\")))"))
(undeclared "xyzzy" "implement" (want "(r (terminal (\"(:done)\" \"(:escalate :reason s)\")))"))
(undeclared "xyzzy" "auto" (want "(r (terminal (\"(:done)\" \"(:escalate :reason s)\" \"(:findings (:claim s :file f))\")))"))
(undeclared "gitdiff" "scout" (want "(r (nearest \"gitDiff\"))"))
(undeclared "write" "scout" (want "(r (terminal (\"(:findings (:claim s :file f))\" \"(:escalate :reason s)\")))"))
(undeclared "  Delete " "implement" (want "(r (nearest \"delete\"))"))
(undeclared "findings" "implement" (want "(r (terminal (\"(:done)\" \"(:escalate :reason s)\")))"))
(undeclared "finding" "scout" (want "(r (nearest \"findings\"))"))
(prose "proseClaim" "(:findings (:claim \"the loop never ends\" :file \"src/ring.py\"))" false false false ("earlier") (want "(\"earlier\" \"the loop never ends\")"))
(prose "proseEvidence" "(:evidence (:receipt \"x1\" :cmd \"make\" :why \"it passed\"))" false false false () (want "()"))
(prose "proseInEvidence" "(:claim \"inside evidence\")" true false false () (want "()"))
(prose "proseNote" "(:note \"working memory only\")" false false false () (want "()"))
(prose "proseNoteStep" "(:step :op \"note\" :text \"a note step\")" false false false () (want "()"))
(prose "proseIntent" "(:intent :deliver patch :why \"because\")" false false false () (want "()"))
(prose "prosePlanOn" "(:plan (:step :id s1 :do \"read the file\" :check \"it reads\"))" false false true () (want "()"))
(prose "prosePlanOff" "(:plan (:step :id s1 :do \"read the file\" :check \"it reads\"))" false false false () (want "(\"read the file\" \"it reads\")"))
(prose "proseOldKeys" "(:findings (:claim \"old keys drop the claim text\" :commit \"c1\"))" false true false () (want "(\"c1\")"))
(prose "proseNewKeys" "(:findings (:claim \"new keys keep the claim text\" :commit \"c1\"))" false false false () (want "(\"new keys keep the claim text\")"))
(prose "proseStep" "(:step :op \"edit\" :file \"a.txt\" :old \"x\" :new \"y\" :why \"fixes the \\\"bug\\\"\")" false false false () (want "(\"fixes the \\\\\\\"bug\\\\\\\"\")"))
(prose "proseDone" "(:done :commit \"(:c :a x)\" :summary \"all gates pass\")" false false false ("a" "b") (want "(\"a\" \"b\" \"all gates pass\")"))
