(:case :id "guard0" :fn "guard" :cmd "git status" :want "nil")
(:case :id "guard1" :fn "guard" :cmd "git reset --hard" :want "(refuse \"git reset\" \"edit or write ops for files\")")
(:case :id "guard2" :fn "guard" :cmd "git reset" :want "(refuse \"git reset\" \"edit or write ops for files\")")
(:case :id "guard3" :fn "guard" :cmd "git restore a.txt" :want "(refuse \"git restore\" \"edit or write ops for files\")")
(:case :id "guard4" :fn "guard" :cmd "git clean -fd" :want "(refuse \"git clean\" \"edit or write ops for files\")")
(:case :id "guard5" :fn "guard" :cmd "git checkout main" :want "(refuse \"git checkout\" \"edit or write ops for files\")")
(:case :id "guard6" :fn "guard" :cmd "git checkout -b topic" :want "nil")
(:case :id "guard7" :fn "guard" :cmd "git checkout -B topic" :want "nil")
(:case :id "guard8" :fn "guard" :cmd "git checkout" :want "nil")
(:case :id "guard9" :fn "guard" :cmd "git checkout -- a.txt" :want "(refuse \"git checkout\" \"edit or write ops for files\")")
(:case :id "guard10" :fn "guard" :cmd "git checkout -f" :want "(refuse \"git checkout\" \"edit or write ops for files\")")
(:case :id "guard11" :fn "guard" :cmd "git checkout --force" :want "(refuse \"git checkout\" \"edit or write ops for files\")")
(:case :id "guard12" :fn "guard" :cmd "git checkout -q" :want "nil")
(:case :id "guard13" :fn "guard" :cmd "git stash" :want "(refuse \"git stash\" \"edit or write ops for files\")")
(:case :id "guard14" :fn "guard" :cmd "git stash list" :want "nil")
(:case :id "guard15" :fn "guard" :cmd "git stash show -p" :want "nil")
(:case :id "guard16" :fn "guard" :cmd "git stash pop" :want "(refuse \"git stash\" \"edit or write ops for files\")")
(:case :id "guard17" :fn "guard" :cmd "git stash -p" :want "(refuse \"git stash\" \"edit or write ops for files\")")
(:case :id "guard18" :fn "guard" :cmd "git apply x.patch" :want "(refuse \"git apply\" \"edit or write ops for files\")")
(:case :id "guard19" :fn "guard" :cmd "git apply --check x.patch" :want "nil")
(:case :id "guard20" :fn "guard" :cmd "git apply --stat x.patch" :want "nil")
(:case :id "guard21" :fn "guard" :cmd "git apply --summary x.patch" :want "nil")
(:case :id "guard22" :fn "guard" :cmd "git apply --numstat x.patch" :want "nil")
(:case :id "guard23" :fn "guard" :cmd "git commit -m x" :want "(refuse \"git commit\" \"(:done :commit msg) for commits\")")
(:case :id "guard24" :fn "guard" :cmd "git merge topic" :want "(refuse \"git merge\" \"(:done :commit msg) for commits\")")
(:case :id "guard25" :fn "guard" :cmd "git rebase main" :want "(refuse \"git rebase\" \"(:done :commit msg) for commits\")")
(:case :id "guard26" :fn "guard" :cmd "git cherry-pick abc" :want "(refuse \"git cherry-pick\" \"(:done :commit msg) for commits\")")
(:case :id "guard27" :fn "guard" :cmd "git revert abc" :want "(refuse \"git revert\" \"(:done :commit msg) for commits\")")
(:case :id "guard28" :fn "guard" :cmd "git tag v1" :want "(refuse \"git tag\" \"(:done :commit msg) for commits\")")
(:case :id "guard29" :fn "guard" :cmd "git branch topic" :want "nil")
(:case :id "guard30" :fn "guard" :cmd "git branch -d topic" :want "(refuse \"git branch -d/-D\" \"(:done :commit msg) for commits\")")
(:case :id "guard31" :fn "guard" :cmd "git branch -D topic" :want "(refuse \"git branch -d/-D\" \"(:done :commit msg) for commits\")")
(:case :id "guard32" :fn "guard" :cmd "git branch --delete topic" :want "(refuse \"git branch -d/-D\" \"(:done :commit msg) for commits\")")
(:case :id "guard33" :fn "guard" :cmd "git update-ref HEAD x" :want "(refuse \"git update-ref\" \"(:done :commit msg) for commits\")")
(:case :id "guard34" :fn "guard" :cmd "git am x" :want "(refuse \"git am\" \"(:done :commit msg) for commits\")")
(:case :id "guard35" :fn "guard" :cmd "git" :want "nil")
(:case :id "guard36" :fn "guard" :cmd "git -C sub reset" :want "nil")
(:case :id "guard37" :fn "guard" :cmd "git --no-pager log" :want "nil")
(:case :id "guard38" :fn "guard" :cmd "echo ok; git reset --hard" :want "(refuse \"git reset\" \"edit or write ops for files\")")
(:case :id "guard39" :fn "guard" :cmd "echo git reset" :want "(refuse \"git reset\" \"edit or write ops for files\")")
(:case :id "guard40" :fn "guard" :cmd "true && git commit -am x" :want "(refuse \"git commit\" \"(:done :commit msg) for commits\")")
(:case :id "guard41" :fn "guard" :cmd "false || git merge x" :want "(refuse \"git merge\" \"(:done :commit msg) for commits\")")
(:case :id "guard42" :fn "guard" :cmd "ls | git apply" :want "(refuse \"git apply\" \"edit or write ops for files\")")
(:case :id "guard43" :fn "guard" :cmd "sleep 1 & git clean -x" :want "(refuse \"git clean\" \"edit or write ops for files\")")
(:case :id "guard44" :fn "guard" :cmd "(git reset)" :want "(refuse \"git reset\" \"edit or write ops for files\")")
(:case :id "guard45" :fn "guard" :cmd "git log;git reset" :want "(refuse \"git reset\" \"edit or write ops for files\")")
(:case :id "guard46" :fn "guard" :cmd "sh -c 'git reset --hard'" :want "(refuse \"git reset\" \"edit or write ops for files\")")
(:case :id "guard47" :fn "guard" :cmd "bash -lc \"git commit -m x\"" :want "nil")
(:case :id "guard48" :fn "guard" :cmd "zsh -e -c 'git status'" :want "nil")
(:case :id "guard49" :fn "guard" :cmd "dash -c 'echo hi'" :want "nil")
(:case :id "guard50" :fn "guard" :cmd "sh -x 'git reset'" :want "nil")
(:case :id "guard51" :fn "guard" :cmd "sh -c" :want "nil")
(:case :id "guard52" :fn "guard" :cmd "sh" :want "nil")
