(:case :id "readOnly0" :fn "readOnly" :cmd "ls" :want "true")
(:case :id "readOnly1" :fn "readOnly" :cmd "ls -la && cat a.txt" :want "true")
(:case :id "readOnly2" :fn "readOnly" :cmd "git status" :want "true")
(:case :id "readOnly3" :fn "readOnly" :cmd "git log -n 3" :want "true")
(:case :id "readOnly4" :fn "readOnly" :cmd "git push" :want "false")
(:case :id "readOnly5" :fn "readOnly" :cmd "cat a > b" :want "false")
(:case :id "readOnly6" :fn "readOnly" :cmd "grep x | wc -l" :want "true")
(:case :id "readOnly7" :fn "readOnly" :cmd "rm a.txt" :want "false")
(:case :id "readOnly8" :fn "readOnly" :cmd "" :want "false")
(:case :id "readOnly9" :fn "readOnly" :cmd "echo 'open" :want "false")
(:case :id "readOnly10" :fn "readOnly" :cmd "find . -name x" :want "true")
(:case :id "readOnly11" :fn "readOnly" :cmd "find . -delete" :want "false")
(:case :id "readOnly12" :fn "readOnly" :cmd "head -n 3 a.txt; tail a.txt" :want "true")
(:case :id "outward0" :fn "outward" :cmd "git push origin main" :root "@BASE@/o1" :no 1 :o0 "keep/**" :want "(why \"it pushes\")")
(:case :id "outward1" :fn "outward" :cmd "echo git push" :root "@BASE@/o1" :no 1 :o0 "keep/**" :want "nil")
(:case :id "outward2" :fn "outward" :cmd "npm publish" :root "@BASE@/o1" :no 0 :want "(why \"it publishes\")")
(:case :id "outward3" :fn "outward" :cmd "rm a.txt" :root "@BASE@/o1" :no 1 :o0 "keep/**" :want "(why \"rm of a.txt, outside :owns\")")
(:case :id "outward4" :fn "outward" :cmd "rm keep/k.txt" :root "@BASE@/o1" :no 1 :o0 "keep/**" :want "nil")
(:case :id "outward5" :fn "outward" :cmd "mv a.txt b.txt" :root "@BASE@/o1" :no 1 :o0 "a.txt" :want "(why \"mv of b.txt, outside :owns\")")
(:case :id "outward6" :fn "outward" :cmd "curl -d x http://example.invalid" :root "@BASE@/o1" :no 0 :want "(why \"curl sends a request body or method\")")
(:case :id "outward7" :fn "outward" :cmd "curl http://example.invalid" :root "@BASE@/o1" :no 0 :want "nil")
(:case :id "outward8" :fn "outward" :cmd "wget --post-data=x http://example.invalid" :root "@BASE@/o1" :no 0 :want "(why \"wget sends a request body or method\")")
(:case :id "outward9" :fn "outward" :cmd "echo 'open" :root "@BASE@/o1" :no 0 :want "(error \"No closing quotation\")")
(:case :id "outward10" :fn "outward" :cmd "ls; rm -rf sub" :root "@BASE@/o1" :no 1 :o0 "keep/**" :want "(why \"rm of sub, outside :owns\")")
(:case :id "outward11" :fn "outward" :cmd "twine upload dist/x" :root "@BASE@/o1" :no 0 :want "(why \"it publishes\")")
(:case :id "outward12" :fn "outward" :cmd "echo hi" :root "@BASE@/o1" :no 0 :want "nil")
(:case :id "hidden0" :fn "hidden" :text "" :want "(vars)")
(:case :id "hidden1" :fn "hidden" :text "HOME" :want "(vars \"HOME\")")
(:case :id "hidden2" :fn "hidden" :text "HOME  SECRET_X 1bad a-b _ok9" :want "(vars \"HOME\" \"SECRET_X\" \"_ok9\")")
(:case :id "hidden3" :fn "hidden" :text "\tA\nB " :want "(vars \"A\" \"B\")")
(:case :id "tail0" :fn "tail" :text "" :lines 20 :cap 2000 :want "\"\"")
(:case :id "tail1" :fn "tail" :text "one" :lines 20 :cap 2000 :want "\"one\"")
(:case :id "tail2" :fn "tail" :text "a\nb\n" :lines 20 :cap 2000 :want "\"a\\nb\"")
(:case :id "tail3" :fn "tail" :text "a\nbc\n\n" :lines 20 :cap 2000 :want "\"a\\nb\\nc\\n\"")
