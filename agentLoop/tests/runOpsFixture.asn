(:case :id "deleteOps" :fn "scenario" :root "@BASE@/s7" :session "leon" :t 20 :hidden "" :steps 13 :no 3 :o0 "keep/**" :o1 "gone.txt" :o2 "sub" :k0 "delete" :k1 "delete" :k2 "delete" :k3 "delete" :k4 "delete" :k5 "delete" :k6 "delete" :k7 "delete" :k8 "delete" :k9 "delete" :k10 "delete" :k11 "delete" :k12 "delete" :f0 "(:step :op \"delete\")" :f1 "(:step :op \"delete\" :file \"../outside.txt\")" :f2 "(:step :op \"delete\" :file \"/etc/hosts\")" :f3 "(:step :op \"delete\" :file \".git/config\")" :f4 "(:step :op \"delete\" :file \"keep/../.git/HEAD\")" :f5 "(:step :op \"delete\" :file \"a.txt\")" :f6 "(:step :op \"delete\" :file \"keep/missing.txt\")" :f7 "(:step :op \"delete\" :file \"keep\")" :f8 "(:step :op \"delete\" :file \"keep/k.txt\")" :f9 "(:step :op \"delete\" :path \"gone.txt\")" :f10 "(:step :op \"delete\" :file \"keep/sub.txt\" :path \"a.txt\")" :f11 "(:step :op \"delete\" :file \" keep/k.txt\")" :f12 "(:step :op \"delete\" :file \"sub\")" :want "(step 0 (r (id \"r0\") (op \"delete\") (status \"rejected\") (error \"ERR_MISSING_ARG\") (message \"delete needs :file\"))) (step 1 (r (id \"r1\") (op \"delete\") (status \"rejected\") (error \"ERR_ROOT\") (file \"../outside.txt\") (message \"'../outside.txt' is outside :root; nothing in this step was written; the run goes on\"))) (step 2 (r (id \"r2\") (op \"delete\") (status \"rejected\") (error \"ERR_ROOT\") (file \"/etc/hosts\") (message \"'/etc/hosts' is outside :root; nothing in this step was written; the run goes on\"))) (step 3 (r (id \"r3\") (op \"delete\") (status \"rejected\") (error \"ERR_ROOT\") (file \".git/config\") (message \"'.git/config' is outside :root; nothing in this step was written; the run goes on\"))) (step 4 (r (id \"r4\") (op \"delete\") (status \"rejected\") (error \"ERR_ROOT\") (file \"keep/../.git/HEAD\") (message \"'keep/../.git/HEAD' is outside :root; nothing in this step was written; the run goes on\"))) (step 5 (r (id \"r5\") (op \"delete\") (status \"rejected\") (error \"ERR_OWNS\") (file \"a.txt\") (owns (\"keep/**\" \"gone.txt\" \"sub\")) (message \"'a.txt' is outside :owns; nothing in this step was written; the run goes on\"))) (step 6 (r (id \"r6\") (op \"delete\") (status \"rejected\") (error \"ERR_NOT_FOUND\") (file \"keep/missing.txt\") (message \"no file keep/missing.txt\"))) (step 7 (r (id \"r7\") (op \"delete\") (status \"rejected\") (error \"ERR_OWNS\") (file \"keep\") (owns (\"keep/**\" \"gone.txt\" \"sub\")) (message \"'keep' is outside :owns; nothing in this step was written; the run goes on\"))) (step 8 (r (id \"r8\") (op \"delete\") (status \"ok\") (file \"keep/k.txt\") (exit 0) (flushed (\"keep/k.txt\")) (persisted true))) (step 9 (r (id \"r9\") (op \"delete\") (status \"ok\") (file \"gone.txt\") (exit 0) (flushed (\"gone.txt\")) (persisted true))) (step 10 (r (id \"r10\") (op \"delete\") (status \"ok\") (file \"keep/sub.txt\") (exit 0) (flushed (\"keep/sub.txt\")) (persisted true))) (step 11 (r (id \"r11\") (op \"delete\") (status \"rejected\") (error \"ERR_OWNS\") (file \" keep/k.txt\") (owns (\"keep/**\" \"gone.txt\" \"sub\")) (message \"' keep/k.txt' is outside :owns; nothing in this step was written; the run goes on\"))) (step 12 (r (id \"r12\") (op \"delete\") (status \"rejected\") (error \"ERR_NOT_FOUND\") (file \"sub\") (message \"no file sub\"))) (tree (f \".gitignore\" \"ignored.log\\n\") (f \"a.txt\" \"alpha dirty\\n\") (f \"crlf.txt\" \"one\\r\\ntwo\\r\\n\") (f \"sub/c.txt\" \"charlie\\n\") (f \"u.txt\" \"untracked\\n\")) (journal (j \"keep/k.txt\" \"k\\n\" 420) (j \"gone.txt\" \"gone\\n\" 420) (j \"keep/sub.txt\" \"sub\\n\" 420))")
(:case :id "sessionOdd" :fn "scenario" :root "@BASE@/s8" :session "my-sess" :t 20 :hidden "" :steps 3 :no 1 :o0 "keep/**" :k0 "manage" :k1 "manage" :k2 "kill" :f0 "(:step :op \"manage\" :action \"spawn\" :id \"x\" :cmd \"sleep 30\")" :f1 "(:step :op \"manage\" :action \"list\")" :f2 "" :want "(step 0 (r (id \"r0\") (op \"manage\") (action \"spawn\") (path \"x\") (status \"ok\"))) (step 1 (r (id \"r1\") (op \"manage\") (action \"list\") (status \"ok\") (stdout \"sess-x running\"))) (killed (\"my-sess-x\") () ()) (tree (f \".gitignore\" \"ignored.log\\n\") (f \"a.txt\" \"alpha dirty\\n\") (f \"crlf.txt\" \"one\\r\\ntwo\\r\\n\") (f \"keep/k.txt\" \"k\\n\") (f \"sub/c.txt\" \"charlie\\n\") (f \"u.txt\" \"untracked\\n\")) (journal)")
(:case :id "sessionBad" :fn "scenario" :root "@BASE@/s8" :session "bad/name" :t 20 :hidden "" :steps 5 :no 1 :o0 "keep/**" :k0 "run" :k1 "manage" :k2 "manage" :k3 "manage" :k4 "kill" :f0 "(:step :op \"run\" :cmd \"echo hi\")" :f1 "(:step :op \"manage\" :action \"spawn\" :id \"x\" :cmd \"echo hi\")" :f2 "(:step :op \"manage\" :action \"poll\" :id \"x\")" :f3 "(:step :op \"manage\" :action \"tail\" :id \"x\")" :f4 "" :want "(step 0 (r (id \"r0\") (op \"run\") (status \"rejected\") (error \"ERR_ENGINE\") (cmd \"echo hi\") (message \"(:error :code ERR_BAD_SESSION :message \\\"ASL_SESSION must match [A-Za-z0-9._-]+ without ..\\\")\"))) (step 1 (r (id \"r1\") (op \"manage\") (action \"spawn\") (path \"x\") (status \"rejected\") (error \"ERR_ENGINE\") (message \"(:error :code ERR_BAD_SESSION :message \\\"ASL_SESSION must match [A-Za-z0-9._-]+ without ..\\\")\"))) (step 2 (r (id \"r2\") (op \"manage\") (action \"poll\") (path \"x\") (status \"rejected\") (message \"state None\"))) (step 3 (r (id \"r3\") (op \"manage\") (action \"tail\") (path \"x\") (status \"rejected\") (stdout \"\"))) (killed () () ()) (tree (f \".gitignore\" \"ignored.log\\n\") (f \"a.txt\" \"alpha dirty\\n\") (f \"crlf.txt\" \"one\\r\\ntwo\\r\\n\") (f \"keep/k.txt\" \"k\\n\") (f \"sub/c.txt\" \"charlie\\n\") (f \"u.txt\" \"untracked\\n\")) (journal)")
(:case :id "sessionIds" :fn "scenario" :root "@BASE@/s8" :session "" :t 20 :hidden "HOME" :steps 5 :no 1 :o0 "keep/**" :k0 "manage" :k1 "manage" :k2 "manage" :k3 "run" :k4 "kill" :f0 "(:step :op \"manage\" :action \"spawn\" :id \"..\" :cmd \"echo hi\")" :f1 "(:step :op \"manage\" :action \"poll\" :id \"..\")" :f2 "(:step :op \"manage\" :action \"tail\" :id \"a..b\")" :f3 "(:step :op \"run\" :cmd \"echo \\\"[${HOME-unset}]\\\"\")" :f4 "" :want "(step 0 (r (id \"r0\") (op \"manage\") (action \"spawn\") (path \"..\") (status \"rejected\") (error \"ERR_ENGINE\") (message \"(:manage :status :rejected :error ERR_ENGINE_REJECTED :receipt (:receipt :status :error :errorCode \\\":ERR_INVALID_ID\\\" :id \\\"leon-..\\\" :message \\\"Session id must match [A-Za-z0-9._-]{1,128} and must not contain ..\\\") :see \\\"(:help :op manage)\\\")\"))) (step 1 (r (id \"r1\") (op \"manage\") (action \"poll\") (path \"..\") (status \"rejected\") (message \"state None\"))) (step 2 (r (id \"r2\") (op \"manage\") (action \"tail\") (path \"a..b\") (status \"rejected\") (stdout \"\"))) (step 3 (r (id \"r3\") (op \"run\") (status \"ok\") (cmd \"echo \\\"[${HOME-unset}]\\\"\") (exit 0) (stdout \"[unset]\") (restored ()) (flushed ()) (persisted false))) (killed () () ()) (tree (f \".gitignore\" \"ignored.log\\n\") (f \"a.txt\" \"alpha dirty\\n\") (f \"crlf.txt\" \"one\\r\\ntwo\\r\\n\") (f \"keep/k.txt\" \"k\\n\") (f \"sub/c.txt\" \"charlie\\n\") (f \"u.txt\" \"untracked\\n\")) (journal)")
(:case :id "sessionLong" :fn "scenario" :root "@BASE@/s8" :session "ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss" :t 20 :hidden "" :steps 2 :no 1 :o0 "keep/**" :k0 "manage" :k1 "run" :f0 "(:step :op \"manage\" :action \"spawn\" :id \"abcdefghij\" :cmd \"echo hi\")" :f1 "(:step :op \"run\" :cmd \"echo long\")" :want "(step 0 (r (id \"r0\") (op \"manage\") (action \"spawn\") (path \"abcdefghij\") (status \"rejected\") (error \"ERR_ENGINE\") (message \"t (:receipt :status :error :errorCode \\\":ERR_INVALID_ID\\\" :id \\\"ssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssssss-abcdefghij\\\" :message \\\"Session id must match [A-Za-z0-9._-]{1,128} and must not contain ..\\\") :see \\\"(:help :op manage)\\\")\"))) (step 1 (r (id \"r1\") (op \"run\") (status \"ok\") (cmd \"echo long\") (exit 0) (stdout \"long\") (restored ()) (flushed ()) (persisted false))) (tree (f \".gitignore\" \"ignored.log\\n\") (f \"a.txt\" \"alpha dirty\\n\") (f \"crlf.txt\" \"one\\r\\ntwo\\r\\n\") (f \"keep/k.txt\" \"k\\n\") (f \"sub/c.txt\" \"charlie\\n\") (f \"u.txt\" \"untracked\\n\")) (journal)")
(:case :id "killRebase" :fn "scenario" :root "@BASE@/s9" :session "leon" :t 20 :hidden "" :steps 9 :no 1 :o0 "keep/**" :k0 "manage" :k1 "write" :k2 "unlink" :k3 "write" :k4 "manage" :k5 "wait" :k6 "kill" :k7 "kill" :k8 "run" :f0 "(:step :op \"manage\" :action \"spawn\" :id \"p1\" :cmd \"sleep 30\")" :f1 "(:w :path \"a.txt\" :text \"written by leon\\n\")" :f2 "u.txt" :f3 "(:w :path \"keep/lw.txt\" :text \"leon keep\\n\")" :f4 "(:step :op \"manage\" :action \"spawn\" :id \"p2\" :cmd \"echo p2 > p2.txt; echo side > u.txt; echo kk > keep/k.txt\")" :f5 "1000" :f6 "" :f7 "" :f8 "(:step :op \"run\" :cmd \"cat a.txt keep/lw.txt\")" :want "(step 0 (r (id \"r0\") (op \"manage\") (action \"spawn\") (path \"p1\") (status \"ok\"))) (rebased) (rebased) (rebased) (step 4 (r (id \"r4\") (op \"manage\") (action \"spawn\") (path \"p2\") (status \"ok\"))) (killed (\"leon-p1\" \"leon-p2\") (\"p2.txt\" \"u.txt\") (\"keep/k.txt\")) (killed () () ()) (step 8 (r (id \"r8\") (op \"run\") (status \"ok\") (cmd \"cat a.txt keep/lw.txt\") (exit 0) (stdout \"written by leon\\nleon keep\") (restored ()) (flushed ()) (persisted false))) (tree (f \".gitignore\" \"ignored.log\\n\") (f \"a.txt\" \"written by leon\\n\") (f \"crlf.txt\" \"one\\r\\ntwo\\r\\n\") (f \"keep/k.txt\" \"kk\\n\") (f \"keep/lw.txt\" \"leon keep\\n\") (f \"sub/c.txt\" \"charlie\\n\")) (journal (j \"keep/k.txt\" \"k\\n\" 420))")
(:case :id "emptyOwns" :fn "scenario" :root "@BASE@/s10" :session "leon" :t 20 :hidden "" :steps 2 :no 0 :k0 "run" :k1 "delete" :f0 "(:step :op \"run\" :cmd \"echo n > anywhere.txt; echo m > a.txt\")" :f1 "(:step :op \"delete\" :file \"crlf.txt\")" :want "(step 0 (r (id \"r0\") (op \"run\") (status \"ok\") (cmd \"echo n > anywhere.txt; echo m > a.txt\") (exit 0) (stdout \"\") (restored (\"a.txt\" \"anywhere.txt\")) (flushed ()) (persisted false))) (step 1 (r (id \"r1\") (op \"delete\") (status \"rejected\") (error \"ERR_OWNS\") (file \"crlf.txt\") (owns ()) (message \"'crlf.txt' is outside :owns; nothing in this step was written; the run goes on\"))) (tree (f \".gitignore\" \"ignored.log\\n\") (f \"a.txt\" \"alpha dirty\\n\") (f \"crlf.txt\" \"one\\r\\ntwo\\r\\n\") (f \"keep/k.txt\" \"k\\n\") (f \"sub/c.txt\" \"charlie\\n\") (f \"u.txt\" \"untracked\\n\")) (journal)")
