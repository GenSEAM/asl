(:fixture :name "gateIntegrity" :base "worktree" :loopPy "bac4cbe7b35dd763bc06b9fbfea84e9f64bab5e9" :cases 13)
(:case :id "fields" :want "sh gate.sh\n3\nout\nerr\n1\n4")
(:case :id "green" :want "false")
(:case :id "cutUtf8" :want "é")
(:case :id "evidenceReceipt" :want "(:evidence (:receipt \"git \\\"show\\\" λ\" :exit 7))")
(:case :id "unbacked" :want "visible text\n(:evidence (:receipt \"receipt\" :exit 0))")
(:case :id "noteUnbacked" :want "visible text\n(:evidence (:receipt \"receipt\" :exit 0))")
(:case :id "vacuous" :want "false\ngate \"sh gate.sh\" is :vacuous: it reports no (:gate ... :asserts n :failed 0) with n > 0")
(:case :id "onlyGateFiles" :want "true\nrevertCheck skipped: the change is only the gate files")
(:case :id "redOnHead" :want "true\nrevertCheck: sh gate.sh :failsOnRevert :exit 1")
(:case :id "newFileRevert" :want "false\nno gate reports a failed assertion with added.txt reverted to HEAD: sh gate.sh :passesOnRevert :exit 0")
(:case :id "mixedKeptNew" :want "true\nrevertCheck (kept added.txt): sh gate.sh :failsOnRevert :exit 1")
(:case :id "gateNeedsNewFile" :want "true\nrevertCheck: sh gate.sh :failsOnRevert :exit 1")
(:case :id "scanSwallowed" :want "3")
