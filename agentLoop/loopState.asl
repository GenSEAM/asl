(module asl/agentLoop/loopState
  :x [LoopEnv LoopState TurnCtx Step RunResult ReceiptAdapter execValJson execRecJson
      claimsReceiptJson planReceiptJson retryReceiptJson gitRValJson runRValJson txnRValJson
      gateJson gateRecJson gateResult lastGatesJson]
  :i [(asl/agentLoop/providers :a pv) (asl/agentLoop/exec :a x)
      (asl/agentLoop/claims :a cl) (asl/agentLoop/retry :a rt)
      (asl/agentLoop/gates :a g) (asl/agentLoop/gitOps :a go)
      (asl/agentLoop/runOps :a ro) (asl/agentLoop/txn :a tx)
      (asl-json/json :a j)])

schema LoopEnv
  (:f provider (fn [String String] -> pv/Turn))
  (:f task String) (:f modeHint (Option String)) (:f owns (List String)) (:f gates (List String))
  (:f rootDir String) (:f budget Int64) (:f journalPath String) (:f maxRetries Int64)
  (:f sessionId (Option String)) (:f base (Option String)) (:f contextTokens (Option Int64))
  (:f model (Option String)) (:f gateTimeout (Option Int64)) (:f wallBudget (Option Int64))
  (:f resume (Option j/Json)) (:f intent (Option String)) (:f plan Bool) (:f specCheck Bool)
  (:f next (fn [String String] -> pv/Turn))
  (:f advise (fn [String String] -> (Result (Option String) String)))
  (:f review (fn [String String] -> (Result (Option String) String)))
  (:f newId (fn [] -> String)) (:f now (fn [] -> Float64)) (:f sleep (fn [Int64] -> Bool))

schema LoopState
  (:f turn Int64) (:f contextTokens (Option Int64)) (:f core j/Json) (:f wallBudget (Option Int64))
  (:f intent (Option String)) (:f plan j/Json) (:f mode String) (:f sizingModel String)
  (:f explicitContext Bool) (:f transcriptChars Int64) (:f readCap Int64) (:f startHead String)
  (:f turnsWithoutEvidence Int64) (:f readStreak Int64) (:f phases (List String)) (:f deliver (Option String))
  (:f gatewayIntent String) (:f researchKind Bool) (:f turnFacts j/Json) (:f reinforceWhy (Option String))
  (:f advisorCalls Int64) (:f advisorAsked Bool) (:f gateSigHistory (List j/Json))
  (:f executedSteps (Map String j/Json)) (:f workspaceGen Int64) (:f failureCounts (Map String Int64))
  (:f ownsRejections (List j/Json)) (:f scope (List String)) (:f signalName (Option String)) (:f runStarted Float64)
  (:f vendorRetryCount Int64) (:f vendorWaitUsed Bool) (:f seenEvidence (Map String j/Json))
  (:f turnEvidence (Map String j/Json)) (:f writeTurn (Map String Int64)) (:f coverage (Map String j/Json))
  (:f writesPersisted Bool) (:f wroteSinceGate Bool) (:f allReceipts (List x/Val))
  (:f allGateResults (List g/GateResult)) (:f needsConfirmList (List j/Json))
  (:f escalateReceipt (Option String)) (:f findingsList (List j/Json)) (:f possibleOpen (Map String Bool))
  (:f possibleNotices Int64) (:f status String) (:f error (Option String))
  (:f totalQueueWaitSec Float64) (:f totalExecSec Float64) (:f usageTotals j/Json)
  (:f batching j/Json) (:f hasTiming Bool) (:f basePrompt String) (:f briefCount Int64)
  (:f code String) (:f commitRequested Bool) (:f declaredOps (List String)) (:f fetched j/Json)
  (:f header String) (:f history (List j/Json)) (:f lastGates (Map String j/Json))
  (:f missingGateIntro (List String)) (:f patchErr (Option String))
  (:f placeholderBriefs (Map String Int64)) (:f prefetch String) (:f priorIds (List String))
  (:f resumePatchPath (Option String)) (:f retries j/Json) (:f runUnbackedClaims (List j/Json))
  (:f specChecksDone Int64) (:f startTurn Int64) (:f taskLines String) (:f unparsable j/Json)
  (:f vendorBounds j/Json) (:f window j/Json) (:f writtenFiles (List String))

