def cmd_loom(args) -> int:
    """SkyLoom: Resilient Inter-Agent Communication Protocol & Mesh."""
    from tools.skyloom_cli import list_peers, send_message, mailbox_status, primer, demo, doctor, run_mcp_server
    json_mode = getattr(args, "json", False)
    if getattr(args, "demo", False) or getattr(args, "action", "") == "demo":
        return demo(json_mode=json_mode)
    action = getattr(args, "action", "peers")
    if action == "doctor":
        return doctor(json_mode=json_mode)
    elif action == "mcp":
        return run_mcp_server()
    elif action == "send":
        return send_message(
            to=getattr(args, "target", "agent-planner"),
            message=getattr(args, "message", "execute_task"),
            from_peer=getattr(args, "from_peer", "agent-orchestrator"),
            channel=getattr(args, "channel", None),
            dialect=getattr(args, "dialect", "auto"),
            json_mode=json_mode,
        )
    elif action == "mailbox":
        return mailbox_status(peer_id=getattr(args, "target", "agent-lonely-sub"), json_mode=json_mode)
    elif action == "primer":
        return primer(target_peer=getattr(args, "target", "vanilla-llm"), sender=getattr(args, "from_peer", "orchestrator"), json_mode=json_mode)
    elif action == "handoff":
        from tools.skyloom_cli import handoff
        _csv = lambda v: [x.strip() for x in v.split(",") if x.strip()] if isinstance(v, str) else (v or [])
        return handoff(
            to=getattr(args, "target", "agent-coder"),
            task=getattr(args, "task", "execute_task"),
            cwd=getattr(args, "cwd", "."),
            owns=_csv(getattr(args, "owns", None)),
            frozen=_csv(getattr(args, "frozen", None)),
            gate=getattr(args, "gate", None),
            budget=getattr(args, "budget", 5000),
            from_peer=getattr(args, "from_peer", "agent-orchestrator"),
            json_mode=json_mode,
        )
    elif action == "yield":
        from tools.skyloom_cli import yield_task
        _csv = lambda v: [x.strip() for x in v.split(",") if x.strip()] if isinstance(v, str) else (v or [])
        return yield_task(
            to=getattr(args, "target", "agent-orchestrator"),
            reply_to=getattr(args, "reply_to", "handoff-0001"),
            status=getattr(args, "status", "ok"),
            verdict=getattr(args, "verdict", None),
            artifacts=_csv(getattr(args, "artifacts", None)),
            error=getattr(args, "error", None),
            from_peer=getattr(args, "from_peer", "agent-coder"),
            json_mode=json_mode,
        )
    elif action == "spawn":
        from tools.skyloom_cli import spawn
        return spawn(
            agent=getattr(args, "target", "agent-worker"),
            cwd=getattr(args, "cwd", "."),
            cmd=getattr(args, "cmd", None),
            json_mode=json_mode,
        )
    elif action == "transcode":
        from tools.skyloom_cli import transcode
        raw_frame = getattr(args, "frame", None) or getattr(args, "message", "")
        return transcode(
            input_frame=raw_frame,
            to_dialect=getattr(args, "to_dialect", "nano"),
            json_mode=json_mode,
        )
    return list_peers(json_mode=json_mode)


