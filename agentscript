#!/usr/bin/env python3
"""One entry point over the AgentScript toolchain.

The working loop was four scripts with four calling conventions, and an agent that
had to remember which of them takes a directory, which takes a file, and which one
answers in JSON. Everything here delegates: `check` is `checker/resolve.check_file`, `build`
is `backend/to_*.py`, `ambiguity` is `grammar/ambiguity_audit.py`, `tokens` is
`prelude/budget.py`, `fmt` is `tools/fmt/fmt.py`, and `ast`/`search`/`edit` are the
tree-sitter surface in `tools/tsutil.py`.

Two things are uniform across every subcommand, because they are the part a caller
writes code against:

  * `--json` emits the toolchain's diagnostic shape, `{file, line, col, code,
    message}`, the one `checker/resolve.py` defines (the checker's `code` field is
    the former `rule`, now a string).
  * the exit code is the number of problems — 0 when there are none.
"""
import argparse
import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).parent

# `checker/resolve.py` imports its siblings (`collect`, `types_`) flat, so its
# directory has to be on the path; `checker/check.py` and the gates do the same.
sys.path.insert(0, str(ROOT / "checker"))

from resolve import Diagnostic, check_file  # noqa: E402
from tools import tsutil  # noqa: E402
from tools.fmt import fmt  # noqa: E402

BACKENDS = {"py": "to_python.py", "rs": "to_rust.py", "ts": "to_typescript.py", "go": "to_go.py", "wasm": "wasm"}
TREE_SITTER = ROOT / "node_modules" / ".bin" / "tree-sitter"
GRAMMAR_DIR = ROOT / "grammar" / "tree-sitter-agentscript"
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


class BadInput(Exception):
    """A usage error: no sources, or a path that is not there."""


def sources(paths: list[Path]) -> list[Path]:
    out: list[Path] = []
    for p in paths:
        if not p.exists():
            raise BadInput(f"{p}: no such file or directory")
        out += sorted(p.rglob("*.agentscript")) if p.is_dir() else [p]
    if not out:
        raise BadInput("no .agentscript files given")
    return out


def diag(file, code: str, message: str) -> Diagnostic:
    """One diagnostic in the toolchain's shape, for a failure with no position.

    `code` is the checker's `code` field (a string such as "build" or "internal");
    the distributor's former numeric `rule` argument is gone with the rename to
    `code: str`.
    """
    return Diagnostic(code, message, 1, 1, str(file))


def diag_as_dict(d: Diagnostic) -> dict:
    return {"file": d.path, "line": d.line, "col": d.col,
            "code": d.code, "message": d.message}


def report(diags: list[Diagnostic], as_json: bool, subject: str) -> int:
    if as_json:
        print(json.dumps([diag_as_dict(d) for d in diags], indent=1))
    else:
        for d in diags:
            print(d)
        print(f"\n{len(diags)} {subject}")
    return len(diags)


# ---------- subcommands ----------

def cmd_check(args) -> int:
    """Run the semantic checker in-process (`checker/resolve.check_file`)."""
    files = sources(args.paths)
    # The corpus's search-path modules live under grammar/corpus/modules; the
    # checker gate resolves against them, so the distributor must too.
    roots = [ROOT / "grammar" / "corpus" / "modules"]
    diags: list[Diagnostic] = []
    for f in files:
        diags += check_file(f, roots)
    diags.sort(key=lambda d: (d.path, d.line, d.col, d.code))
    return report(diags, args.json, f"diagnostic(s) across {len(files)} file(s)")


sys.path.insert(0, str(ROOT / "backend"))


def cmd_build(args) -> int:
    if getattr(args, "watch", False):
        from tools.project import watch_project
        watch_project(getattr(args, "file", None) if getattr(args, "file", None) and getattr(args, "file").is_dir() else Path.cwd())
        return 0

    if not getattr(args, "file", None) or (args.file and args.file.is_dir()):
        from tools.project import build_project
        code, results = build_project(getattr(args, "file", None) or Path.cwd())
        if getattr(args, "json", False):
            print(json.dumps(results, indent=2))
        else:
            for r in results:
                status = "✓" if r["ok"] else "✗"
                print(f"{status} [{r['target']}] -> {r['output']} ({r['duration_ms']:.1f}ms)")
        return code

    if not args.file.is_file():
        return report([diag(args.file, "build", "no such file")], args.json, "diagnostic(s)")
    if args.target == "wasm":
        import tempfile
        from to_rust import ToRust
        roots = [ROOT / "grammar" / "corpus" / "modules"]
        try:
            rs_src = ToRust().transpile(args.file.read_text(), path=args.file, roots=roots)
            with tempfile.TemporaryDirectory(dir="/tmp") as d:
                (Path(d) / "rt.rs").write_text((ROOT / "backend" / "rust" / "rt.rs").read_text())
                (Path(d) / "main.rs").write_text(rs_src)
                out_wasm = Path(d) / "out.wasm"
                is_prog = "pub fn main_(" in rs_src or "fn main()" in rs_src
                target_flag = ["--target", "wasm32-wasip1"] if is_prog else ["--target", "wasm32-unknown-unknown", "--crate-type=cdylib"]
                c = subprocess.run(["rustup", "run", "stable", "rustc", *target_flag,
                                    "-O", "--edition", "2021", "main.rs", "-o", str(out_wasm)],
                                   cwd=d, capture_output=True, text=True)
                if c.returncode != 0:
                    message = last_line(c.stderr) or "rustc wasm build failed"
                    return report([diag(args.file, "build", message)], args.json, "diagnostic(s)")
                wasm_bytes = out_wasm.read_bytes()
                if getattr(args, "output", None):
                    args.output.write_bytes(wasm_bytes)
                else:
                    sys.stdout.buffer.write(wasm_bytes)
                return 0
        except Exception as exc:
            return report([diag(args.file, "build", str(exc))], args.json, "diagnostic(s)")

    script = ROOT / "backend" / BACKENDS[args.target]
    run = subprocess.run([sys.executable, str(script), str(args.file),
                         "--root", str(ROOT / "grammar" / "corpus" / "modules")],
                         capture_output=True, text=True)
    if run.returncode == 0:
        if getattr(args, "output", None):
            args.output.write_text(run.stdout)
        else:
            sys.stdout.write(run.stdout)
        return 0
    # The backends refuse a module written for another ecosystem by name, and that
    # refusal is a result rather than a crash. It is reported as one diagnostic.
    message = last_line(run.stderr) or "build failed"
    code = "target-mismatch" if message.startswith("TargetMismatch") else "build"
    return report([diag(args.file, code, message)], args.json, "diagnostic(s)")


def cmd_watch(args) -> int:
    """Hot-reload file watcher and incremental multi-target compiler."""
    from tools.project import watch_project
    watch_project(getattr(args, "directory", None) or Path.cwd())
    return 0


def last_line(stderr: str) -> str:
    """The final line of a delegate's stderr, stripped of terminal colouring."""
    text = ANSI.sub("", stderr).strip()
    return text.splitlines()[-1] if text else ""


def cmd_fmt(args) -> int:
    files = sources(args.paths)
    diags, changed = [], []
    for f in files:
        did, ds = fmt.format_file(f, write=not args.check)
        diags += ds
        if did and not ds:
            changed.append(f)
    if args.check:
        return report(diags, args.json, f"file(s) to reformat, of {len(files)}")
    for f in changed:
        print(f"formatted {f}", file=sys.stderr)
    return report(diags, args.json, f"file(s) refused, {len(changed)} rewritten")


def cmd_ambiguity(args) -> int:
    """Runs the Earley ambiguity audit; `--check` ratchets against the lock."""
    run = ["--write"] if args.write else (["--check"] if args.check else [])
    return subprocess.run(
        [sys.executable, str(ROOT / "grammar" / "ambiguity_audit.py"), *run],
        cwd=ROOT).returncode


def cmd_tokens(args) -> int:
    """The token-budget ratchet over `prelude/HANDBOOK.md`."""
    run = ["--write"] if args.write else (["--check"] if args.check else [])
    return subprocess.run(
        [sys.executable, str(ROOT / "prelude" / "budget.py"), *run],
        cwd=ROOT).returncode


def cmd_ast(args) -> int:
    try:
        print(json.dumps(tsutil.ast_json(args.file), indent=1))
        return 0
    except Exception as exc:
        return report([diag(args.file, "internal", str(exc))], args.json, "diagnostic(s)")


def cmd_search(args) -> int:
    query = Path(args.query).read_text()
    try:
        print(json.dumps(tsutil.search_json(args.file, query), indent=1))
        return 0
    except Exception as exc:
        return report([diag(args.file, "internal", str(exc))], args.json, "diagnostic(s)")


def cmd_websearch(args) -> int:
    """Metasearch aggregator via SearXNG with proxy pool support."""
    from tools.search import query_searxng, format_results_markdown
    items = query_searxng(args.query, instance_url=getattr(args, "instance", None), proxy=getattr(args, "proxy", None))
    if getattr(args, "json", False):
        print(json.dumps([item.__dict__ for item in items], indent=2))
    else:
        print(format_results_markdown(args.query, items))
    return 0


def cmd_get(args) -> int:
    """Download and record a remote package from GitHub/Git (Go-style)."""
    from tools.pkg import add_package
    return add_package(args.package, local=not getattr(args, "global_pkg", False))


def cmd_remove(args) -> int:
    """Remove a package dependency from asl.json and local modules."""
    from tools.pkg import remove_package
    return remove_package(args.package)


def cmd_list_pkg(args) -> int:
    """List dependencies declared in asl.json."""
    from tools.pkg import list_packages
    return list_packages(json_mode=getattr(args, "json", False))


def cmd_link(args) -> int:
    """Link a local directory as a package for monorepo development."""
    from tools.pkg import link_package
    return link_package(args.package, args.path)


def cmd_install(args) -> int:
    """Restore all packages declared in asl.json."""
    from tools.pkg import install_all_packages
    return install_all_packages()


def cmd_edit(args) -> int:
    try:
        receipt = tsutil.edit(args.file, args.op, args.range or args.at, args.text or "")
        print(json.dumps(receipt))
        return 0
    except Exception as exc:
        payload = {"file": str(args.file), "op": args.op, "error": str(exc)}
        print(json.dumps(payload))
        return 1


def cmd_bindgen(args) -> int:
    """Foreign declarations from a Python type stub (`tools/bindgen/from_pyi.py`)."""
    run = subprocess.run(
        [sys.executable, str(ROOT / "tools" / "bindgen" / "from_pyi.py"),
         str(args.stub), "--module", args.module, "--package", args.package,
         "--alias", args.alias, "--target", args.target],
        capture_output=True, text=True)
    sys.stdout.write(run.stdout)
    if run.returncode == 0:
        return 0
    sys.stderr.write(run.stderr)
    return 1


def cmd_grammar(args) -> int:
    """Print language grammar rules or LLM reference sheet to stdout."""
    if getattr(args, "lark", False):
        lark_file = ROOT / "grammar" / "agentscript.lark"
        sys.stdout.write(lark_file.read_text())
        return 0
    if getattr(args, "full", False):
        handbook_file = ROOT / "prelude" / "HANDBOOK.md"
        sys.stdout.write(handbook_file.read_text())
        return 0
    # Default: ultra-compact ~500-token LLM cheat sheet (llms.txt)
    llms_file = ROOT / "llms.txt"
    if llms_file.exists():
        sys.stdout.write(llms_file.read_text())
    else:
        sys.stdout.write((ROOT / "skills" / "asl" / "SKILL.md").read_text())
    return 0


def cmd_init(args) -> int:
    """Scaffold a new AgentScript project with AGENTS.md, CLAUDE.md, and starter code."""
    from tools.scaffold import scaffold_project
    res = scaffold_project(args.directory, template=args.template, embed_skill=not args.no_skill)
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        print(f"✓ Initialized AgentScript project '{res['project']}' in {res['directory']}")
        for f in res["created_files"]:
            print(f"  + {f}")
        print("\nNext steps:")
        print(f"  cd {args.directory}")
        print("  agentscript check src/main.agentscript")
        print("  agentscript build src/main.agentscript --target wasm")
    return 0


def cmd_skill(args) -> int:
    """Manage and install the ASL skill for AI agent harnesses (Claude, Cursor, Antigravity)."""
    skill_src = ROOT / "skills" / "asl" / "SKILL.md"
    if not skill_src.exists():
        skill_src = ROOT / "skills" / "agentscript" / "SKILL.md"

    if getattr(args, "install", None):
        target = args.install
        if target == "global":
            dest_dir = Path.home() / ".gemini" / "config" / "skills" / "asl"
        elif target == "local":
            dest_dir = Path.cwd() / ".skills" / "asl"
        else:
            dest_dir = Path(target)
        dest_dir.mkdir(parents=True, exist_ok=True)
        dest_file = dest_dir / "SKILL.md"
        dest_file.write_text(skill_src.read_text())
        print(f"✓ Installed ASL skill to {dest_file}")
        return 0

    # Print setup recommendations and config snippets
    print("# ASL AI Agent Setup & Skill Integration\n")
    print("## 1. Install Skill into Agent Harness")
    print("  • Global install:  asl skill --install global  (~/.gemini/config/skills/asl)")
    print("  • Local install:   asl skill --install local   (./.skills/asl)\n")
    print("## 2. Cursor / Claude Desktop / Windsurf Config (`mcpServers`)")
    server_path = str((ROOT / "tools" / "mcp" / "server.py").resolve())
    mcp_config = {
        "mcpServers": {
            "asl": {
                "command": "python3",
                "args": [server_path]
            }
        }
    }
    print(json.dumps(mcp_config, indent=2))
    print("\n## 3. Direct System Prompt Injection")
    print("  • Run: `asl ref` or include `llms.txt` (~500 tokens).")
    return 0


def cmd_version(args) -> int:
    """Show current ASL version and check for updates."""
    from tools.upgrade import get_current_version, check_latest_version
    cur = get_current_version()
    print(f"asl (AgentScript Language) v{cur}")
    print("Main Target: wasm32-wasip1 | Bridges: ts, rs, go, py | URL: https://aslang.dev")
    latest = check_latest_version(timeout=1.0)
    if latest and latest.get("version") and latest["version"] != cur:
        print(f"\n💡 A new release is available: v{latest['version']} (current: v{cur})")
        print("   Run 'asl upgrade' to update to the latest release.")
    return 0


def cmd_upgrade(args) -> int:
    """Upgrade ASL toolchain to the latest release."""
    from tools.upgrade import run_upgrade
    return run_upgrade(verbose=True)


# ---------- driver ----------

def main() -> int:
    ap = argparse.ArgumentParser(prog="agentscript", description=__doc__.splitlines()[0])
    ap.add_argument("--version", "-v", action="store_true", help="show version information")
    ap.add_argument("--json", action="store_true",
                    help="emit diagnostics as {file, line, col, code, message}")
    ap.add_argument("--grammar", "--ref", action="store_true",
                    help="print language grammar rules and LLM cheat sheet")
    sub = ap.add_subparsers(dest="command", required=False)

    p = sub.add_parser("version", help="show version and check for updates")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_version)

    p = sub.add_parser("upgrade", aliases=["update"], help="upgrade ASL to the latest release")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_upgrade)

    p = sub.add_parser("get", aliases=["add"], help="download and record a remote package (Go-style)")
    p.add_argument("package", help="package URL or identifier, e.g. github.com/genseam/search@v1.0.0")
    p.add_argument("--global", dest="global_pkg", action="store_true", help="install into global cache")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_get)

    p = sub.add_parser("remove", aliases=["rm"], help="remove a package dependency from asl.json")
    p.add_argument("package", help="package identifier to remove")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_remove)

    p = sub.add_parser("list", aliases=["deps"], help="list dependencies declared in asl.json")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_list_pkg)

    p = sub.add_parser("link", help="link a local directory as a package for monorepo development")
    p.add_argument("package", help="package identifier, e.g. github.com/genseam/search")
    p.add_argument("path", help="local filesystem path to the module")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_link)

    p = sub.add_parser("install", aliases=["pkg"], help="restore all packages declared in asl.json")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_install)

    p = sub.add_parser("grammar", aliases=["ref", "cheat", "llms"],
                       help="print language grammar rules and LLM reference sheet")
    p.add_argument("--lark", action="store_true", help="emit raw EBNF Lark grammar")
    p.add_argument("--full", action="store_true", help="emit full standard library handbook")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_grammar)

    p = sub.add_parser("skill", aliases=["setup", "config"],
                       help="manage and install the ASL skill for AI agent harnesses")
    p.add_argument("--install", choices=["global", "local"], help="install skill directory")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_skill)

    p = sub.add_parser("init", help="scaffold a new AgentScript project with AGENTS.md and CLAUDE.md")
    p.add_argument("directory", type=Path, help="directory to initialize")
    p.add_argument("--template", choices=["cli", "wasm", "web", "lib"], default="cli", help="project template")
    p.add_argument("--no-skill", action="store_true", help="do not embed local .skills directory")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_init)

    p = sub.add_parser("check", help="the §9 rules a grammar cannot express")
    p.add_argument("paths", nargs="*", type=Path)
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_check)

    p = sub.add_parser("build", help="transpile project or single module to target(s)")
    p.add_argument("file", nargs="?", type=Path, help="source file to build (or builds all in asl.json)")
    p.add_argument("--target", choices=sorted(BACKENDS), help="target backend (optional if defined in asl.json)")
    p.add_argument("-o", "--output", type=Path, help="write output artifact to file path")
    p.add_argument("--watch", "-w", action="store_true", help="watch for file changes and recompile")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_build)

    p = sub.add_parser("watch", help="hot-reload file watcher and incremental multi-target compiler")
    p.add_argument("directory", nargs="?", type=Path, help="project directory to watch")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_watch)

    p = sub.add_parser("fmt", help="print canonically, in place")
    p.add_argument("paths", nargs="*", type=Path)
    p.add_argument("--check", action="store_true",
                   help="report what would change instead of changing it")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_fmt)

    p = sub.add_parser("ambiguity", help="Earley ambiguity count over the corpus")
    p.add_argument("--check", action="store_true")
    p.add_argument("--write", action="store_true")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_ambiguity)

    p = sub.add_parser("tokens", help="token-budget ratchet over HANDBOOK.md")
    p.add_argument("--check", action="store_true")
    p.add_argument("--write", action="store_true")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_tokens)

    p = sub.add_parser("ast", help="dump the tree-sitter JSON AST of a module")
    p.add_argument("file", type=Path)
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_ast)

    p = sub.add_parser("search", help="run a tree-sitter query over a module")
    p.add_argument("file", type=Path)
    p.add_argument("-q", "--query", required=True, help="a .scm query file")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_search)

    p = sub.add_parser("websearch", aliases=["searxng", "find"],
                       help="metasearch aggregator via SearXNG with proxy pool support")
    p.add_argument("query", help="search query text")
    p.add_argument("--instance", help="custom SearXNG instance URL")
    p.add_argument("--proxy", help="proxy URL (http://... or socks5://...)")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_websearch)

    p = sub.add_parser("edit", help="a structured byte-range edit")
    p.add_argument("op", choices=["replace", "delete", "insert"])
    p.add_argument("file", type=Path)
    p.add_argument("--range", help="<l>:<c>-<l>:<c> for replace/delete")
    p.add_argument("--at", help="<l>:<c> for insert")
    p.add_argument("--text", help="replacement / inserted text")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_edit)

    p = sub.add_parser("bindgen",
                       help="foreign declarations from a Python type stub")
    p.add_argument("stub", type=Path)
    p.add_argument("--module", required=True)
    p.add_argument("--package", required=True)
    p.add_argument("--alias", required=True)
    p.add_argument("--target", default="py")
    p.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    p.set_defaults(fn=cmd_bindgen)

    args = ap.parse_args()
    if getattr(args, "version", False):
        return cmd_version(args)
    if getattr(args, "grammar", False) or getattr(args, "ref", False):
        return cmd_grammar(args)
    if not hasattr(args, "fn"):
        ap.print_help()
        return 0
    try:
        return args.fn(args)
    except BadInput as exc:
        print(exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
