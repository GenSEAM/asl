def cmd_build(args) -> int:
    if getattr(args, "watch", False):
        from tools.project import watch_project
        watch_project(getattr(args, "file", None) if getattr(args, "file", None) and getattr(args, "file").is_dir() else Path.cwd())
        return 0

    if not getattr(args, "file", None) or (args.file and args.file.is_dir()):
        from tools.project import build_project
        code, results = build_project(getattr(args, "file", None) or Path.cwd())
        if getattr(args, "json", False):
            print(json.dumps(results, indent=2))
        else:
            for r in results:
                status = "✓" if r["ok"] else "✗"
                print(f"{status} [{r['target']}] -> {r['output']} ({r['duration_ms']:.1f}ms)")
        return code

    if not args.file.is_file():
        return report([diag(args.file, "build", "no such file")], args.json, "diagnostic(s)")
    if args.target == "wasm":
        import tempfile
        from to_rust import ToRust
        roots = [ROOT / "grammar" / "corpus" / "modules"]
        try:
            rs_src = ToRust().transpile(args.file.read_text(), path=args.file, roots=roots)
            with tempfile.TemporaryDirectory(dir="/tmp") as d:
                (Path(d) / "rt.rs").write_text((ROOT / "backend" / "rust" / "rt.rs").read_text())
                (Path(d) / "main.rs").write_text(rs_src)
                out_wasm = Path(d) / "out.wasm"
                is_prog = "pub fn main_(" in rs_src or "fn main()" in rs_src
                target_flag = ["--target", "wasm32-wasip1"] if is_prog else ["--target", "wasm32-unknown-unknown", "--crate-type=cdylib"]
                c = subprocess.run(["rustup", "run", "stable", "rustc", *target_flag,
                                    "-O", "--edition", "2021", "main.rs", "-o", str(out_wasm)],
                                   cwd=d, capture_output=True, text=True)
                if c.returncode != 0:
                    message = last_line(c.stderr) or "rustc wasm build failed"
                    return report([diag(args.file, "build", message)], args.json, "diagnostic(s)")
                wasm_bytes = out_wasm.read_bytes()
                if getattr(args, "output", None):
                    args.output.write_bytes(wasm_bytes)
                else:
                    sys.stdout.buffer.write(wasm_bytes)
                return 0
        except Exception as exc:
            return report([diag(args.file, "build", str(exc))], args.json, "diagnostic(s)")

    script = ROOT / "backend" / BACKENDS[args.target]
    run = subprocess.run([sys.executable, str(script), str(args.file),
                         "--root", str(ROOT / "grammar" / "corpus" / "modules")],
                         capture_output=True, text=True)
    if run.returncode == 0:
        if getattr(args, "output", None):
            args.output.write_text(run.stdout)
        else:
            sys.stdout.write(run.stdout)
        return 0
    # The backends refuse a module written for another ecosystem by name, and that
    # refusal is a result rather than a crash. It is reported as one diagnostic.
    message = last_line(run.stderr) or "build failed"
    code = "target-mismatch" if message.startswith("TargetMismatch") else "build"
    return report([diag(args.file, code, message)], args.json, "diagnostic(s)")


