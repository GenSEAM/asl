def cmd_check(args) -> int:
    """Run the semantic checker in-process (`checker/resolve.check_file`)."""
    files = sources(args.paths)
    roots = [ROOT / "grammar" / "corpus" / "modules"]

    if getattr(args, "fix", False):
        from tools.heal import heal_file
        for f in files:
            heal_file(f, apply_fix=True)

    if getattr(args, "machine", False):
        from tools.heal import machine_diagnostics_report
        reports = [machine_diagnostics_report(f) for f in files]
        print(json.dumps(reports[0] if len(reports) == 1 else reports, indent=2))
        return 0 if all(r["valid"] for r in reports) else 1

    diags: list[Diagnostic] = []
    for f in files:
        diags += check_file(f, roots)
    diags.sort(key=lambda d: (d.path, d.line, d.col, d.code))
    return report(diags, getattr(args, "json", False), f"diagnostic(s) across {len(files)} file(s)")


def cmd_heal(args) -> int:
    """Diagnose and auto-repair rule violations in ASL files."""
    from tools.heal import heal_file, machine_diagnostics_report
    files = sources(args.paths)
    all_patches = []
    for f in files:
        if getattr(args, "json", False) or getattr(args, "machine", False):
            print(json.dumps(machine_diagnostics_report(f), indent=2))
        else:
            patches = heal_file(f, apply_fix=not getattr(args, "dry_run", False))
            for p in patches:
                status = "✓ Repaired" if p.applied else "→ Suggested"
                print(f"{status} [{p.rule}] in {p.file}: {p.description}")
            all_patches.extend(patches)
    return 0


