(:harness :v 5 :level L2 :date "2026-10-23" :status draft :ev ASN-ONLY-PROGRAMME-20261023
  :supersedes "asl/grammar/harness.asn" :adoptGate HRN-MEASURE-ARMS
  :vocab "asl/grammar/terms.asn" :schema "asl/grammar/terms.schema.asn" :clients "asl/grammar/clients.asn"
  :fills (cwd git platform date shell asl promptDir aslMore subagentTool note outputCut waitLimit)
  :literals (
    (:literal :id capabilitiesPath :kind path :text "asl/grammar/capabilities.asn")
    (:literal :id clientsPath :kind path :text "asl/grammar/clients.asn")
    (:literal :id languageTopic :kind path :text "asl/grammar/tools.asn")
    (:literal :id aslExample :kind exemplar :text "asl '(:read :file \"src/app.py\" :symbol \"greet\") (:edit :file \"src/app.py\" :old \"return 1\" :new \"return 2\") (:flush)'")
    (:literal :id aslHeredoc :kind command :text "asl - <<'EOF'")
    (:literal :id aslFile :kind command :text "asl -f F")
    (:literal :id abstainForm :kind exemplar :text "(:outcome :abstained :reason :evidenceDeficit :unresolvedHypotheses N :escalationTarget T)")
    (:literal :id witnessForm :kind exemplar :text "(:witness :hash H :errorClass E :gateId G :hunkDigest D :attemptCount 3)")
    (:literal :id pagerCat :kind command :text "PAGER=cat")
    (:literal :id gitLogN :kind command :text "git log -n N")
    (:literal :id errStagedBy :kind name :text "ERR_STAGED_BY")
    (:literal :id codexExec :kind exemplar :text "exec takes raw JavaScript; call a tool as await tools.name(args)")
    (:literal :id codexBatch :kind exemplar :text "await Promise.allSettled([tools.a(x), tools.b(y)])")
    (:literal :id patchForm :kind exemplar :text "*** Begin Patch / *** Update File: path / @@ / -old / +new / *** End Patch")
    (:literal :id rgCmd :kind command :text "rg"))
  :static (
    (:layer :id orient
      (:splitsInto orient (denoise atomize ground))
      (:yields atomize sMap)
      (:has intentAtom (verb object constraint provenance))
      (:dominates groundFact prior)
      (:before orient (plan implement)))
    (:layer :id authority :unless (chat)
      (:decides principal request)
      (:isA (push delete publish send spend) outward)
      (:awaits outward consent :in thisSession)
      (:covers consent (action scope))
      (:blocks openQuestion dependentWork)
      (:dominates newestMessage earlierObjective)
      (:holdsWhen earlierObjective notCancelled))
    (:layer :id values :unless (asex)
      (:is valueOrder (principalAuthority invariants statedIntent falsifiableEvidence minimalCausalSurface signalOverNoise velocity))
      (:not (:dominates proxy invariants))
      (:via reversible (stage commit))
      (:via costlyReversible (downMigration snapshot))
      (:awaits irreversible consent))
    (:layer :id evidence
      (:holdsWhen claim toolResult :in thisSession)
      (:isA (report statusFile readme) claim :until rerun)
      (:covers suite executedAsserts)
      (:holdsWhen done (executed entryPoint effect))
      (:not done (stub todo deadFlag uncalledFn missingDependency))
      (:needs notDone (:each (stub deadFlag missingDependency)))
      (:needs verdictNo (:each blocker))
      (:needs claim anchor :from toolResult))
    (:layer :id reply :when (shell)
      (:splitsInto reply (done claimed unverified))
      (:has reply (command exitCode executedAsserts))
     
      (:holdsWhen methodClaim commandResult)
      (:not announcedStep executed))
    (:layer :id scope
      (:covers scope searched)
      (:covers resolution (alias reExport tableEntry storedFn test recursion forwarder))
      (:not mention use)
      (:needs exact (scope method date))
      (:needs exact scope :for (:each figure))
      (:covers enumeration (:all searched))
      (:needs generalization (:each searchedSite))
      (:covers mockTest mock)
      (:holdsWhen measurement inputsRan)
      (:needs ruledOutSite siteName)
      (:not (:dominates signalOverNoise completeness))
      (:refutedBy generalization counterexample))
    (:layer :id abstain :when (shell)
      (:prefers abstain guess :when evidenceDeficit)
      (:has abstention (evidenceDeficit unresolvedHypotheses escalationTarget) :lit abstainForm)
      (:not edit :when gateUnrunnable))
    (:layer :id breaker :when (shell)
      (:yields sameFailure3 witness :lit witnessForm)
      (:yields witness (newHypothesis escalate))
      (:has escalate (seen tried fork resolves))
      (:is progress newEvidence))
    (:layer :id capabilities :when (asl)
      (:is capabilityStatus (works partial absent lies) :from capabilitiesPath)
      (:replaces absent fallback)
      (:replaces lies fallback)
     )
    (:layer :id task :unless (chat)
      (:is request principalMessage)
      (:isA diskTask data)
      (:not otherTree workspace)
      (:not data instruction))
    (:layer :id chat :unless (tools)
      (:holdsWhen claim principalMessage)
      (:not announcedStep executed)
      (:is finalMessage reply))
    (:layer :id attractors :from taskKind
      (:yields taskKind attractorSet)
      (:has implement (verification simplicity convergence))
      (:has scout (verification attentionDensity simplicity completeness))
      (:has grade (verification nonVacuity convergence))
      (:has distill (fidelity compression verification)))
    (:layer :id work :unless (chat)
      (:keeps toolResult :until newEvidence)
      (:costs batch roundTrip :count 1)
      (:prefers smallestDiff :for verifyCost)
      (:holdsWhen effort taskNeed)
      (:not (:dominates effort claim)))
    (:layer :id memory :unless (chat once)
      (:keeps compaction recentTurns)
      (:fadesUnless (decision namesAdded claimsMade) workingNote)
      (:after workingNote (step compaction))
      (:yields command reconstructible))
    (:layer :id asl :when (shell asl git)
      (:has asl (read query observe edit write flush discard batch))
      (:via asl shell)
      (:costs wholeLargeFile 13000 :unit tokens :for 53000)
      (:costs symbol 150 :unit tokens)
      (:covers observe resolution)
      (:yields edit (staged parseStatus))
      (:is exitCode (allRan rejectedForm syntaxError))
      (:via asl (aslHeredoc aslFile) :for shellQuoting)
      (:has asl aslMore :lit aslExample))
    (:layer :id language :when (aslProject implement)
      (:has asl code :lit languageTopic))
    (:layer :id shell :when (shell)
      (:is shellQuoting code)
      (:has shell (headlessNoInput pipeExit truncation cwdReset) :lit pagerCat :lit gitLogN)
      (:is pipeExit lastCommand)
      (:prefers absolutePath :for cwdReset))
    (:layer :id git :when (git) :unless (chat)
      (:keeps writer otherWritersChanges)
      (:isA destructiveGit irreversible)
      (:is stash shared)
      (:needs commit namedPaths))
    (:layer :id gates :when (implement) :unless (chat asex)
      (:holdsWhen gate threePointCausality)
      (:is threePointCausality (red green redOnRevert))
      (:needs gate mutant))
    (:layer :id delegate :when (subagent)
      (:via delegate subagentTool)
      (:needs delegate (brief owns))
      (:keeps writer ownedPaths)
      (:yields delegate report)
      (:avoids delegate duplication))
    (:layer :id clientRules :when (tools) :from clientRules)
    (:layer :id agyReach :when (agy)
      (:covers declaredTools action :from clientsPath)
      (:yields backgroundCommand unattended :after finalMessage))
    (:layer :id agyOnce :when (agy subagent once)
      (:has agy waitLimit :from clientsPath)
      (:yields subagent report :before finalMessage))
    (:layer :id codexCut :when (codex shell)
      (:has codex outputCut :from clientsPath))
    (:layer :id parallel :when (session)
      (:keeps writer ownedPaths :lit errStagedBy)
      (:avoids delegate duplication))
    (:layer :id foreign :when (foreign)
      (:holdsWhen instruction (request governingFile))
      (:prefers existingPatterns))
    (:layer :id distill :when (distill)
      (:keeps distill (fact relation unit source))
      (:prefers distill statedOnce)
      (:refutedBy generalization counterexample)))
  :volatile (
    (:layer :id env :unless (chat)
      (:fill cwd) (:fill git) (:fill platform) (:fill date)
      (:avoids query otherTree))
    (:layer :id chatDate :unless (tools)
      (:fill date))
    (:layer :id agyPromptDir :when (agy)
      (:fill promptDir)
      (:not promptDir workspace))
    (:layer :id agyNote :when (agy) :unless (once)
      (:fill note)))
  :cut ((:cutRow reasoning (:by measurement)) (:cutRow ledger (:by duplication)) (:cutRow turn (:to reply)) (:cutRow delegate (:to ownedPaths)))
  :merged ((:cutRow gates (:to rules)) (:cutRow agyNote (:to volatile)) (:cutRow env (:to volatile))))
