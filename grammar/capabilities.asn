(:capabilities :v 1 :src ADR0081
  :note "Situation-keyed capability registry. Declared here; :status is NOT written by hand, it is measured by asl doctor into capabilities.lock and joined at render time. A capability whose measured status contradicts this file fails gate 7."
  :statusValues [:works :partial :absent :lies]
  :supportedLanguages [:asl :asn :ts :tsx :js :py :go :rs :php :md :c]
  :canonicalMemoryMatrix [
    (:verb "query" :tool "asl mem query <text>" :contract "vector semantic search AST" :tier [:turn0 :jit] :status :works)
    (:verb "edit" :tool "asl mem edit <file> <old> <new>" :contract "stage atomic string replacement" :tier [:turn0 :jit] :status :works)
    (:verb "diff" :tool "asl mem diff" :contract "inspect staged RAM diffs" :tier [:turn0 :jit] :status :works)
    (:verb "flush" :tool "asl mem flush" :contract "persist staged edits disk" :tier [:turn0 :jit] :status :works)
    (:verb "discard" :tool "asl mem discard" :contract "clear staged RAM buffers" :tier [:turn0 :jit] :status :works)
    (:verb "doc" :tool "asl mem doc <file> <heading>" :contract "read section without disk" :tier [:turn0 :jit] :status :works)
    (:verb "tree" :tool "asl mem tree [path]" :contract "render dense structural hierarchy" :tier [:turn0 :jit] :status :works)
  ]
  :situations [
    (:situation :id orient :pack [:audit :research :development :design] :question "Where am I and what is the current step?"
      :caps [
        (:cap :id sessionLedger :use "(:plan) once, then (:where) before every mutation" :status :absent :quarantine true :agentView :hidden :fallback "read the phase file in .asl/mem/tasks and restate the step" :task Task44101 :tier [:minimal :full])
        (:cap :id rulesSlice :use "(:context :mode m) returns only the rules whose :when matches the mode" :status :absent :quarantine true :agentView :hidden :fallback "read the rules block in AGENTS.md once, do not re-read it per turn" :task Task44102 :tier [:minimal :full])
        (:cap :id treeHealth :use "asl watch reports a red baseline before you build on it" :status :absent :quarantine true :agentView :hidden :fallback "asl check on the files you are about to touch" :task Task44206 :tier [:full])])
    (:situation :id find :pack [:development :research] :question "Where is this symbol, file or text?"
      :caps [
        (:cap :id symbolLookup :use "(:query \"name\") lists definition sites under :defs as path#symbol" :status :works :probe "(:query \"sexprHead\" :limit 3)" :expect "\"asl/packages/asl-parser/src/reader.asl#sexprHead\"" :supportedLanguages [:asl :asn :ts :tsx :js :py :go :rs :php :md :c] :fallback "" :task "" :tier [:minimal :full])
        (:cap :id fileGlob :use "(:find \"*glob*\") matches file NAMES only" :status :absent :probe "(:find \"*dyck*\")" :expect "dyck.py" :supportedLanguages [:all] :fallback "(:tree \"dir\") lists the files under a directory; names are matched by the reader" :task "" :tier [:full])
        (:cap :id contentSearch :use "(:query \"text\") lists file CONTENTS hits under :hits as path then excerpts, each usable as (:read :file path :anchor excerpt)" :status :works :probe "(:query \"sexprHead\" :limit 3)" :expect ":hits (\"" :supportedLanguages [:all] :fallback "" :task Task43804 :tier [:minimal :full])
        (:cap :id semanticRecall :use "(:q \"query\" :scope :decisions) ranks prior ADRs and tasks" :status :lies :quarantine true :agentView :hidden :fallback "read .asl/mem/decisions/ index by filename before authoring a new decision" :task Task44205 :tier [:full])])
    (:situation :id read :pack [:development :research :design] :question "What does this file or section contain?"
      :caps [
        (:cap :id slice :use "(:read :file \"f\" :start a :end b) returns a line range; positional start and end are ignored" :status :works :probe "(:read :file \"scripts/audit/dyck.py\" :start 2 :end 2)" :expect ":start 2 :end 2 :content \"# scripts/audit/dyck.py" :supportedLanguages [:all] :fallback "" :task "" :tier [:minimal :full])
        (:cap :id outline :use "(:intel :op \"outline\" :file \"f\") returns the named definitions of a file with line ranges" :status :works :probe "(:intel :op \"outline\" :file \"scripts/audit/dyck.py\")" :expect "(:item :name \"check\"" :supportedLanguages [:asl :asn :ts :tsx :js :py :go :rs :php :md :c] :fallback "" :task "" :tier [:minimal :full])
        (:cap :id section :use "(:sec \"f.md\" \"heading\") returns one markdown section" :status :absent :probe "(:sec \"README.md\" \"Overview\")" :expect ":content" :supportedLanguages [:md] :fallback "(:read :file \"f.md\" :anchor \"## heading\" :limit n) returns n characters from the heading line" :task "" :tier [:full])
        (:cap :id boundedRead :use "every read carries :limit and continues with :more" :status :works :quarantine true :agentView :hidden :fallback "choose a narrow line range yourself; never request a whole large file" :evidence "asl '(:read :file bin/asl :limit 25)' returned :truncated true and :more (:start 26 :end 29) (2026-10-11)" :task Task44103 :tier [:minimal :full])
        (:cap :id commonCrawl :use "Common Crawl CDX lookup and WARC range read with quote verification" :status :partial :fallback "hermetic tests only; live CDX lookup unverified (commonCrawlLiveTest needs network)" :task "" :tier [:full])])
    (:situation :id understand :pack [:development :audit] :question "What depends on this, and what breaks if I change it?"
      :caps [
        (:cap :id callers :use "(:intel :op \"impact\" :symbol \"name\") lists the files that call name under :directCallers" :status :works :probe "(:intel :op \"impact\" :symbol \"sexprHead\")" :expect "asl/packages/asl-compiler/src/optFold.asl" :supportedLanguages [:asl :asn] :fallback "" :task "" :tier [:full])
        (:cap :id impact :use "(:intel :op \"impact\" :symbol \"name\") reports :blastRadius, direct callers and test callers" :status :works :probe "(:intel :op \"impact\" :symbol \"sexprHead\")" :expect ":testCallersCount" :supportedLanguages [:asl :asn] :fallback "" :task "" :tier [:full])
        (:cap :id coverageMap :use "asl coverage says which symbols have tests and which case kinds" :status :absent :quarantine true :agentView :hidden :fallback "assume nothing is covered until measured" :task Task44208 :tier [:full])])
    (:situation :id plan :pack [:audit :development] :question "Is this plan sound before I start?"
      :caps [
        (:cap :id planVerify :use "asl plan verify: unique ids, acyclic DAG, resolvable contracts, every gate fails on baseline" :status :absent :quarantine true :agentView :hidden :fallback "run each gate by hand and require a non-zero exit before accepting the task" :task Task44204 :tier [:full])
        (:cap :id consistency :use "asl audit consistency over ADR, tasks, intent, roadmap" :status :works :fallback "" :task Task43904 :tier [:full])])
    (:situation :id change :pack [:development :design] :question "How do I modify a file safely?"
      :caps [
        (:cap :id immediateEdit :use "(:edit \"f\" \"old\" \"new\") writes to disk at once" :status :absent :fallback "(:edit) stages the replacement in RAM since T2; (:flush) in the same batch writes it, (:discard) drops it" :task "" :tier [:minimal :full])
        (:cap :id stagedEdit :use "stage, review with (:diff), commit with (:flush) or drop with (:discard)" :status :works :fallback "" :task Task43805 :tier [:minimal :full])
        (:cap :id massRefactor :use "(:repl old new :scope pkg) and (:patch f sym form)" :status :absent :quarantine true :agentView :hidden :fallback "one file at a time" :task Task43808 :tier [:full])
        (:cap :id sequencedBatch :use "(:batch :seq true ...) runs steps in order and short-circuits" :status :works :fallback "" :task Task43805 :tier [:minimal :full])
        (:cap :id writeLarge :use "(:write f content) for content beyond a few kilobytes" :status :lies :quarantine true :agentView :hidden :fallback "content over roughly 1KB is silently truncated and reported ok; write via a host heredoc instead" :task Task44103 :tier [:minimal :full])
        (:cap :id lease :use "(:claim paths) before writing where another agent may be active" :status :absent :quarantine true :agentView :hidden :fallback "check mtime before and after; announce the files you are taking" :task Task44203 :tier [:full])
        (:cap :id pathBoundary :use "paths are canonicalised and checked against workspace, worktrees and scratch roots" :status :works :fallback "" :task Task43809 :tier [:full])
        (:cap :id c11Target :use "asl-target-c emitC11Source lowers ASL source to C11" :status :absent :quarantine true :agentView :hidden :fallback "asl-codegen c99: compile with target c99; emitC11Source returns err" :task "" :tier [:full])
        (:cap :id llvmTarget :use "asl-target-llvm emitLlvmSource lowers ASL source to LLVM IR" :status :partial :quarantine true :agentView :hidden :fallback "stdout matches asl-host run; asl-codegen c99 output does not compile, so there is no fallback target: run on asl-host" :evidence "survey-1e 2026-09-26, sample.asl (enum mt cond fib) emitted, built, run and diffed against asl-host run" :task "syntax plan RP1" :tier [:full])
        (:cap :id tsTarget :use "asl-target-ts emits TypeScript" :status :partial :quarantine true :agentView :hidden :fallback "run on asl-host: tsc fails on unbound match-arm variables and bigint/number mixing, node lacks stringFromInt64" :evidence "survey-1e 2026-09-26, sample.asl (enum mt cond fib) emitted, built, run and diffed against asl-host run" :task "syntax plan RP2" :tier [:full])
        (:cap :id pyTarget :use "asl-target-py emits Python" :status :absent :quarantine true :agentView :hidden :fallback "run on asl-host: emitPy.asl fails to load" :evidence "survey-1e 2026-09-26, sample.asl (enum mt cond fib) emitted, built, run and diffed against asl-host run" :task "" :tier [:full])
        (:cap :id goTarget :use "asl-target-go emits Go" :status :absent :quarantine true :agentView :hidden :fallback "run on asl-host: no AST input path" :evidence "survey-1e 2026-09-26, sample.asl (enum mt cond fib) emitted, built, run and diffed against asl-host run" :task "" :tier [:full])
        (:cap :id watTarget :use "asl-target-wat emits WebAssembly text" :status :absent :quarantine true :agentView :hidden :fallback "run on asl-host: no AST input path" :evidence "survey-1e 2026-09-26, sample.asl (enum mt cond fib) emitted, built, run and diffed against asl-host run" :task "" :tier [:full])
        (:cap :id rsTarget :use "asl-target-rs emits Rust" :status :lies :quarantine true :agentView :hidden :fallback "its unit tests are green but the emitter crashes on listAppend of a record (emitRust.asl); run on asl-host until the run-parity gate passes" :evidence "survey-1e 2026-09-26, sample.asl (enum mt cond fib) emitted, built, run and diffed against asl-host run" :task "syntax plan RP3" :tier [:full])
        (:cap :id shTarget :use "asl-target-sh emits POSIX shell" :status :lies :quarantine true :agentView :hidden :fallback "its unit tests are green but it emits only main and the script exits 127; run on asl-host until the run-parity gate passes" :evidence "survey-1e 2026-09-26, sample.asl (enum mt cond fib) emitted, built, run and diffed against asl-host run" :task "" :tier [:full])
        (:cap :id swiftTarget :use "asl-target-swift emits Swift" :status :lies :quarantine true :agentView :hidden :fallback "its unit tests are green but function bodies are emitted as raw ASL text (emitSwift.asl); run on asl-host until the run-parity gate passes" :evidence "survey-1e 2026-09-26, sample.asl (enum mt cond fib) emitted, built, run and diffed against asl-host run" :task "" :tier [:full])])
    (:situation :id verify :pack [:audit :development] :question "Did it actually work?"
      :caps [
        (:cap :id syntaxCheck :use "asl check and asl lint; both exit 1 on violation" :status :works :fallback "" :task "" :tier [:minimal :full])
        (:cap :id runCommand :use "(:run cmd) returns real exit, stdout, stderr" :status :absent :quarantine true :agentView :hidden :fallback "(:eval :code ...) for ASL code; asl run FILE from the host shell for a file; for a shell command run it WITHOUT a pipe: cmd >/dev/null 2>&1; echo $? . A pipe reports the pipe status" :task Task44202 :tier [:minimal :full])
        (:cap :id executeTests :use "asl test executes assertions" :status :partial :fallback "it checks delimiters and only reached assertions; an unbound symbol abandons the body at exit 0, so green does not mean executed" :task Task43601 :tier [:minimal :full])
        (:cap :id gateSuite :use "asl audit gates runs the seven gates" :status :partial :fallback "gate 3 audits a list against itself, gate 4 excludes tools, gate 5 counts substrings; read a pass as syntax-level only" :task Task43605 :tier [:full])
        (:cap :id mutationScore :use "asl test --strict-falsify reports fault-detection power" :status :absent :fallback "asl test FILE on the strict host: zero asserts, a false runTests or an unknown name fail; mutation scoring does not exist" :task Task43901 :tier [:full])
        (:cap :id boundReceipt :use "(:step-done N) advances on a runner-issued receipt bound to a digest" :status :absent :quarantine true :agentView :hidden :fallback "record the command and its exit code in your own report; do not claim verification without one" :task Task44101 :tier [:minimal :full])])
    (:situation :id recover :pack [:development :audit] :question "Something failed or I am off-plan."
      :caps [
        (:cap :id rollback :use "(:discard) reverts staged edits" :status :works :fallback "" :task Task43805 :tier [:minimal :full])
        (:cap :id edgeProcedure :use "recognize, preserve optionality, contain, refute, escalate" :status :partial :fallback "the procedure applies now; (:escalate) as an op does not exist, so escalate in your reply to the principal" :task Task44108 :tier [:minimal :full])
        (:cap :id failureExplain :use "asl reflect compares declared outcomes against the observed trace" :status :absent :quarantine true :agentView :hidden :fallback "re-read the task :outcomes and check each against what you actually changed" :task Task44209 :tier [:full])])
    (:situation :id handoff :pack [:development :audit] :question "My context is filling or I am handing over."
      :caps [
        (:cap :id snapshot :use "(:handoff :phase id) writes step, done, open, next, gates and risks to .asl/mem/work/<id>/handoff.asn; (:where :phase id) returns it" :status :absent :quarantine true :agentView :hidden :fallback "write the state into the task file before the context resets" :task Task44104 :tier [:full])])
    (:situation :id observe :pack [:research :audit] :question "What actually happened in this session?"
      :caps [
        (:cap :id trace :use "(:trace) returns the append-only log of ops, gates and mutations with digests" :status :absent :quarantine true :agentView :hidden :fallback "your own transcript is the only record; state uncertainty about anything you did not just measure" :task Task44207 :tier [:full])
        (:cap :id environmentTrust :use "asl doctor verifies the host tools and every RPC op against known answers" :status :partial :fallback "run asl doctor manually and compare digests before trusting the environment" :evidence "asl '(:doctor)' returned :rejected/:degraded with :unprobed :count 37 (2026-10-11)" :task Task44201 :tier [:minimal :full])])
  :externalTools [
    (:tool :id git :use "version control reads and writes (log diff merge-tree worktree update-ref)" :via "procSpawnv argv" :status :works :fallback "report ERR_TOOL_ABSENT naming git" :src D155)
    (:tool :id curl :use "HTTPS requests; request body and headers through curl --config - on stdin, never argv" :via "procSpawnv argv" :status :works :fallback "report ERR_TOOL_ABSENT; moves in-process when TLS lands (P0c CC3)" :src D155)
    (:tool :id iconv :use "decode fetched pages in charsets without a native table (windows-1251, Shift_JIS, ...); charset name checked against [A-Za-z0-9._:-] before argv, invalid bytes dropped (-c)" :via "procSpawnv argv" :status :works :fallback "ERR_TOOL_ABSENT; the page is reported crawled false, as an undecodable page" :src D155)
    (:tool :id clang :use "link LLVM IR with libaslrt.a into native binaries" :via "procSpawnv argv" :status :works :fallback "run on asl-host" :src D155)
    (:tool :id docker :use "container builds and isolated runs" :via "procSpawnv argv" :status :partial :fallback "report ERR_TOOL_ABSENT" :src D155)
    (:tool :id sqlite3 :use "local SQL stores (cockpit, telemetry)" :via "procSpawnv argv" :status :works :fallback "report ERR_TOOL_ABSENT" :src D155)
    (:tool :id providerClis :names ["agy" "codex" "claude"] :use "model provider CLIs driven by the gateway and Leon" :via "procSpawnv argv" :status :works :fallback "gateway reports the provider unhealthy" :src D155)
    (:tool :id sh :names ["sh" "bash"] :use "gate commands and existing .sh test scripts; never to compose our own argv" :via "procSpawnv [\"sh\" \"-c\" cmd]" :status :works :fallback "none" :src D155)
    (:tool :id posixUtils :names ["uname" "date" "ps" "getconf" "chmod" "ln" "tar" "cp" "find"] :use "temporary platform facts, test setup, pack archiving and the readdir-order walk asl-intel needs for os.walk and glob parity until host builtins land (plan HB1: platformInfo localDate procAlive cpuCount fileChmod pathSymlink; tar until asl-zip covers tar)" :via "procSpawnv argv" :status :works :fallback "report ERR_TOOL_ABSENT" :src D155)
    (:tool :id subjectCheckers :names ["node" "tsc" "go" "rustc" "python3"] :use "checkers for foreign-language subject code and target parity only; never part of our own toolchain" :via "procSpawnv argv" :status :partial :fallback "the check reports the checker absent and is skipped as :absent, never passed" :src D155)
  ]
  :extensionCapabilities [
    (:contract :id declaredRequirements
      :rule "An extension declares the host capabilities it requires; loading against a host that lacks a declared capability fails at load-time, naming both extension and capability."
      :enforcement "load-time"
      :failureCode "ERR_UNSATISFIED_HOST_CAPABILITY")
    (:contract :id actualUsageVerification
      :rule "Extension capability declarations are verified bidirectionally against actual AST form usage; undeclared capability use is rejected and superfluous declarations are flagged."
      :enforcement "bidirectional-verification"
      :failureCode "ERR_UNDECLARED_CAPABILITY_USE")
  ]])
