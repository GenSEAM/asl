(:grammar :name "asl.v04" :version "0.4.0"
  :d
  "Formal ASL v0.4+ clean-break grammar specification"
  :status :history :written "2026-09-17"
  :superseded "The offside surface below was not adopted: the dialect converges on parentheses only. Each schema's :today states what asl/host/out/asl-host accepts as of 2026-09-24."
  :schemas [
    (:schema v04Grammar
      :d
      "Root specification for ASL v0.4 language substrate"
      :fields [
        (:field :name :version :type :string :default "0.4.0")
        (:field :name :layout :type :keyword :allowed [:indentation :offside])
        (:field :name :docPolicy :type :keyword :allowed [:externalized :memoryOnly])
        (:field :name :cleanBreak :type :bool :default true)
      ])

    (:schema ModuleHeader
      :today "the header is a form, (module path :d \"doc\" :x [exports] :i [(other/module :a alias)]); there is no import statement"
      :d
      "Clean module header declaration without parentheses or legacy sigils"
      :fields [
        (:field :name :form :type :string :default "module")
        (:field :name :syntax :type :string :default "module <ModulePath> [<Exports...>]")
        (:field :name :imports :type :string :default "import <Path> as <Alias>")
      ])

    (:schema FunctionDeclaration
      :today "a fn header is a bare column-0 line, fn name a: Int64 -> Int64, with the body below; fn name(a: Int64) -> Int64: fails with ERR_UNKNOWN_SYMBOL a:"
      :d
      "Clean fn declaration with typed parameters and return type"
      :fields [
        (:field :name :keyword :type :string :default "fn")
        (:field :name :syntax :type :string :default "fn <name>(<param>: <Type>, ...) -> <ReturnType>:")
        (:field :name :semantics :type :string :default "lexical closure with typed signatures")
      ])

    (:schema DotFieldAccess
      :today "record.field is ERR_UNKNOWN_SYMBOL; a field is read with the call .-field applied to the record"
      :d
      "Direct dot field navigation on record structures"
      :fields [
        (:field :name :syntax :type :string :default "<record>.<field>")
        (:field :name :chaining :type :string :default "<record>.<field1>.<field2>")
        (:field :name :semantics :type :string :default "direct zero-cost record property projection")
      ])

    (:schema PipelineOperator
      :today "|> is ERR_UNKNOWN_SYMBOL"
      :d
      "Forward dataflow pipeline operator |>"
      :fields [
        (:field :name :operator :type :string :default "|>")
        (:field :name :syntax :type :string :default "<expression> |> <function>(<extraArgs...>)")
        (:field :name :lowering :type :string :default "first argument thread transform")
      ])

    (:schema TryOperator
      :today "try and ? are absent; a Result is taken apart with mt or resultOr"
      :d
      "Prefix try and postfix ? error propagation operators"
      :fields [
        (:field :name :prefixOp :type :string :default "try")
        (:field :name :postfixOp :type :string :default "?")
        (:field :name :syntax :type :string :default "try <expression> or <expression>?")
        (:field :name :lowering :type :string :default "monadic bind over remainder of enclosing block")
      ])

    (:schema NullCoalescing
      :today "?? is ERR_UNKNOWN_SYMBOL; optionOr gives a fallback for none"
      :d
      "Null/None coalescing fallback operator ??"
      :fields [
        (:field :name :operator :type :string :default "??")
        (:field :name :syntax :type :string :default "<primary> ?? <fallback>")
        (:field :name :semantics :type :string :default "evaluate fallback when primary evaluates to none or nil")
      ])

    (:schema SequentialLet
      :today "let takes a binding vector, (let [a 1 b (+ a 1)] body); let a = 1 fails with ERR_BAD_LET"
      :d
      "Bracket-free sequential let binding"
      :fields [
        (:field :name :keyword :type :string :default "let")
        (:field :name :syntax :type :string :default "let <binding> = <expression>")
        (:field :name :scoping :type :string :default "sequential scope across subsequent block statements")
      ])

    (:schema MatchExpression
      :today "mt (alias match) takes parenthesized arms, (mt s ((circle r) body) ((square a) body)); there are no arrow arms"
      :d
      "Pattern matching with arrow arms pat -> body"
      :fields [
        (:field :name :keyword :type :string :default "match")
        (:field :name :syntax :type :string :default "match <expression>:\n    <pattern> -> <body>")
        (:field :name :operator :type :string :default "->")
      ])

    (:schema TypeAnnotation
      :today "name: Type and -> Type appear in fn headers; annotations are not checked, so [Int64] and Int64? load as well"
      :d
      "Colon-annotated type signatures"
      :fields [
        (:field :name :syntax :type :string :default "<identifier>: <Type>")
        (:field :name :returnSyntax :type :string :default "-> <Type>")
        (:field :name :listType :type :string :default "[<Type>]")
        (:field :name :optionalType :type :string :default "<Type>?")
      ])

    (:schema TailRecursion
      :today "(fn tailrec f ...) declares a function whose direct self-calls must occur in tail position; violations fail with ERR_NOT_TAIL"
      :d
      "Explicit self-tail-recursion declaration and tail-position contract"
      :fields [
        (:field :name :syntax :type :string :default "(fn tailrec <name> <params> <returnType> <body>)")
        (:field :name :tailPositions :type :string :default "The last form of a function body; each if arm body; each cond result arm including else but not a test clause; each mt arm body; and the last form of let and do bodies.")
        (:field :name :notTail :type :string :default "Lambda bodies are not tail relative to the enclosing function; call arguments and let binding values are not tail. A direct self-call in any such non-tail position is ERR_NOT_TAIL.")
      ])
  ]
)
