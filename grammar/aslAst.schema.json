          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "exprLambda"
              ]
            },
            "params": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Param"
              }
            },
            "retType": {
              "type": [
                "string",
                "null"
              ]
            },
            "body": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AstExpr"
              }
            }
          },
          "required": [
            "kind",
            "params",
            "retType",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "exprInterpolation"
              ]
            },
            "parts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AstExpr"
              }
            }
          },
          "required": [
            "kind",
            "parts"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AstType": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
