(:bootstrapContract :v 1 :src ADR0081
  :summary "Bootstrap generations, toolchain progression, and closure invariants for autonomous self-hosted ASL."
  :stages [
    (:stage :id 0 :name "seed" :toolchain "engine/asl.c" :output "bin/asl" :desc "Owned C bootstrap interpreter seed")
    (:stage :id 1 :name "stage1" :toolchain "asl-compiler" :output "asl/bin/asl-stage1" :desc "First-generation compiler built using seed")
    (:stage :id 2 :name "stage2" :toolchain "asl-stage1" :output "asl/bin/asl-self" :desc "Second-generation autonomous self-compiled binary")
    (:stage :id "c11" :name "c11-bootstrap" :toolchain "asl-target-c" :output "asl/bin/asl-c11" :desc "Verified C11 native backend with ASL runtime under UBSan/ASan")
    (:stage :id "wasm" :name "wasm32-wasi" :toolchain "asl-target-wat" :output "asl/bin/asl-self.wasm" :desc "Portable WASM artifact")
  ]
  :closureCriteria [
    "Autonomous compiler rebuild closure without external ecosystem dependencies"
    "Explicit declared host boundaries and zero runtime dependencies"
    "Semantic equivalence across bootstrap stages"
  ]
)
