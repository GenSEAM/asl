(:tokenEconomics
  :doc "Canonical Autonomous Agent Token Economics, Sub-Token BPE Physics, Attention Concentration Laws, and Operational Compaction Invariants"

  ;; =========================================================================
  ;; 1. PHYSICAL ATTENTION LAW (Neural Transformer Foundations)
  ;; Token efficiency is not an economic budget trick. It is the direct physical
  ;; determinant of attention mass concentration in neural transformer architectures.
  ;; In self-attention: Attention(Q, K, V) = softmax(Q * K^T / sqrt(d_k)) * V
  ;; Every redundant token dilutes the softmax denominator and reduces probability
  ;; mass allocated to constitutional invariants and verified constraints.
  ;; =========================================================================
  (:attentionPhysics
    :formula "AttentionDensity(Invariants) = Sum_{i in Invariants}(Softmax(Q * K_i^T / sqrt(d_k))) / TotalTokens"
    :lawOfDilution "Noise tokens exponentially increase attention entropy, accelerating hallucination and constraint drift."
    :lexicalSnrTarget 0.85
    :principles [
      (:principle :attentionPreservation
        :statement "Tokens squandered on conversational filler or syntax decoration directly reduce reasoning capacity.")
      (:principle :entropyMinimization
        :statement "Homoiconic balanced S-expressions maximize information density per embedding vector.")
      (:principle :kvCacheLocality
        :statement "Prefix byte stability preserves KV cache hits, reducing time-to-first-token and compute waste.")
    ])

  ;; =========================================================================
  ;; 2. THE SIX OPERATIONAL LEVERS OF TOKEN EFFICIENCY IN ASL
  ;; =========================================================================
  (:operationalLevers

    ;; Lever 1: Homoiconic ASN vs JSON/YAML Syntactic Tax (-55% to -75%)
    (:lever :id :homoiconicSexprBasis
      :mechanism "Balanced parenthesis AST with tagged keywords (:key val)"
      :eliminatedTax ["repeated string keys in JSON objects" "arbitrary whitespace/indentation tokens in YAML" "closing tags in XML/HTML"]
      :measuredSavings "-55% to -75% context tokens across schema and tool payloads"
      :example {:json "{\"task\": {\"id\": \"t1\", \"status\": \"running\", \"owns\": [\"core.asl\"]}}"
                :asn "(:task :id t1 :status :running :owns [\"core.asl\"])"})

    ;; Lever 2: Sub-Token BPE Morphology & Casing (-44% on identifiers)
    (:lever :id :subtokenBpeMorphology
      :mechanism "CamelCase composite identifiers and single-token morphemes"
      :empiricalEvidence "cl100k and o200k tokenizers split snake_case into separate underscore tokens; CamelCase merges naturally"
      :measuredSavings "-44% to -50% per composite identifier; -3.06% across entire multi-thousand-file codebases"
      :vocabulary [
        (:token "txt" :cost 1)
        (:token "buf" :cost 1)
        (:token "fmt" :cost 1)
        (:token "msg" :cost 1)
        (:token "ast" :cost 1)
        (:token "eval" :cost 1)
        (:token "gate" :cost 1)
        (:token "norm" :cost 1)
        (:token "hash" :cost 1)
        (:token "diff" :cost 1)
      ])

    ;; Lever 3: Implicit Parallel Batching (Amortized Prefix Overhead)
    (:lever :id :implicitParallelBatching
      :mechanism "Batch multiple S-expressions in one turn: asl '(:query \"A\") (:read :file \"B\")'"
      :costEquation "Cost(Sequential) = N * (PromptPrefix + ToolDef) + Sum(Steps); Cost(Batch) = 1 * (PromptPrefix + ToolDef) + Sum(Steps)"
      :measuredSavings "Reduces multi-step prompt re-evaluations by up to 80% on long workflows"
      :concurrency :defaultParallel)

    ;; Lever 4: Progressive Disclosure & Bounded Symbol Retrieval
    (:lever :id :boundedProgressiveDisclosure
      :mechanism "Address by symbol and bounded slice (:read :file ?f :symbol ?s) instead of full-file dumps"
      :directives [
        (:directive :mandatoryLimit "every exploration command carries :limit (default <= 50)")
        (:directive :symbolAddressing "cite path and symbol anchor, zero raw line numbers")
        (:directive :refuseWholeFileReads "reject reading files > 300 lines in single turn without prior symbol localization")
      ]
      :measuredSavings "-85% input context per code inspection step")

    ;; Lever 5: Epistemic Observation Masking & Typed Receipts
    (:lever :id :observationMaskingAndReceipts
      :mechanism "Transform 500-line compiler/test logs into compact typed receipts"
      :receiptFormat "(:receipt :status :passed :asserts 27 :mutantsKilled 3 :digest \"sha256:...\")"
      :rule "Transient execution logs remain in ephemeral RAM; only the typed receipt enters durable history"
      :measuredSavings "-92% token retention on verification steps")

    ;; Lever 6: KV-Cache Byte-Stability & Static Prefix Pinning
    (:lever :id :kvCacheByteStability
      :mechanism "Keep tool definitions, system contracts, and invariant rules strictly byte-stable across sessions"
      :rule "Zero mid-session tool signature modifications; dynamic state is delivered via runtime gating"
      :measuredSavings "Enables 90% discount on prompt-cached tokens across frontier LLM providers")

    ;; Lever 7: Context Stratification & Budget Ledgers (Micro-Tier 1k-2k vs Full-Tier)
    (:lever :id :contextStratificationAndBudgetLedgers
      :mechanism "Compile SSOT into stratified tiers; allocate Micro-Tier ledger: 100 role, 180 imperatives, 220 pruned tools, 400 exemplar, 300 task, 300 output"
      :rule "Small models receive concrete exemplars and flat compiled imperatives; frontier models receive full attractor potential fields"
      :measuredSavings "Enables edge SLMs (1B-8B) to execute verified agentic tasks within 1.5k context ceiling with zero attention degradation")

    ;; Lever 8: Passive Event-Driven Invalidation & Validity Anchors
    (:lever :id :passiveEventDrivenInvalidation
      :mechanism "Replace active token polling for rationale expiration with content-addressed anchors (:validityAnchor) and O(1) substrate event emission"
      :rule "Zero tokens wasted on polling loops; staleness bitmask is evaluated passively by substrate engine during doctor and audit commands"
      :measuredSavings "Eliminates 100% of periodic token burn on justification re-checking")
  )

  ;; =========================================================================
  ;; 3. ANTI-GOODHART INVARIANTS (Quality & Falsifiability Dominance)
  ;; Token compaction must NEVER degrade semantic fidelity or verification rigour.
  ;; =========================================================================
  (:antiGoodhartInvariants
    (:invariant :losslessReversibility
      :rule "Compaction must be mathematically lossless and reversible; never drop evidence or constraints.")
    (:invariant :zeroDisemvoweling
      :rule "Arbitrary vowel stripping (e.g. 'usr_auth_mgr') breaks sub-token embedding coherence and is strictly forbidden.")
    (:invariant :truthOverCompactness
      :rule "If a compact notation loses benchmark accuracy or reasoning ability, reject it (Notation Matters principle).")
    (:invariant :nonVacuousDensity
      :rule "True density is measured by verified constraints per token (SUD = Constraints / Tokens), not character count.")
  )

  ;; =========================================================================
  ;; 4. OPERATIONAL CODE OF CONDUCT FOR AUTONOMOUS AGENTS
  ;; =========================================================================
  (:agentCodeOfConduct
    :turn0Directive "Think in pure S-expressions. Do not emit conversational preamble ('Sure, I can help with that...')."
    :queryDiscipline "Formulate precise symbol queries rather than scanning directory trees."
    :editDiscipline "Stage minimal surgical replacements in RAM VFS; do not rewrite entire files to change three lines."
    :testDiscipline "Run targeted falsifiable test gates; report exact assert counts and killed mutants in receipt format."
    :memoryDiscipline "Write to durable memory only what cannot be reconstructed from code, git, or compiler output."
  )
)
