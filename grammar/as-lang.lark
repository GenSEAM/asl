// AgentScript Core v0.3 — Lark grammar (Earley).
// Normative source: AGENT_SPEC_CORE.md
//
// Earley is chosen to match llguidance, which the constrained-decoding arm
// (EXPERIMENT.md arm C) uses, so a grammar accepted here is convertible without
// re-deriving parse behavior under a different algorithm.
//
// Scope: this grammar enforces STRUCTURE (delimiters, declaration shapes, token
// classes). It deliberately does NOT enforce types, arity, exhaustiveness, or
// scope — those are not context-free. See RESEARCH_REPORT.md §5: a CFG reaches
// only the syntactic slice of the error surface, and the type layer is where the
// leverage is. Over-tightening here would reject valid programs while buying
// none of that.

start: toplevel*

toplevel: module_decl
        | defschema
        | defun
        | defenum
        | defentry
        | defextern
        | defopaque

// ---------- module header (v0.2, :extern added in v0.3) ----------

module_decl: "(" MODULE mod_path module_opt* ")"
module_opt: DOC_KW STRING
          | EXPORT_KW "[" IDENT* "]"
          | IMPORT_KW "[" import_spec* "]"
          | EXTERN_KW "[" extern_spec* "]"
import_spec: "(" mod_path AS_KW IDENT ")"
// The host package name appears here and nowhere else, so a module's foreign
// dependencies are extractable without reading its body.
extern_spec: "(" IDENT STRING AS_KW IDENT ")"
mod_path: MOD_PATH | IDENT

// Type parameters are bound explicitly, so a name is a type variable because it
// was declared one, never because of its spelling.
type_params: "{" TYPE_NAME* "}"

// ---------- declarations ----------

defschema: "(" DEFSCHEMA type_params? TYPE_NAME field+ ")"

field: "(" FIELD_KW IDENT type STRING field_opt* ")"

field_opt: DEFAULT_KW literal
         | JSON_KW STRING

defun: "(" DEFUN type_params? IDENT params ARROW type decl_opt* expr+ ")"
decl_opt: DOC_KW STRING
        | EFFECTS_KW "[" IDENT* "]"

// Exactly one per program. Unnamed, because an entry point declared by spelling
// would make `main` magic in a language where nothing else is.
defentry: "(" DEFENTRY params ARROW type decl_opt* expr+ ")"

// A host type the language passes but cannot inspect. Without it, binding
// generation would stall on the first type the host does not share.
defopaque: "(" DEFOPAQUE TYPE_NAME DOC_KW STRING ")"

// The declared type is the SUCCESS type: every call site sees (Result T String).
// The name is kebab-case like every other identifier and reaches the host through
// §8 mangling; :symbol overrides that for the names mangling cannot reproduce.
defextern: "(" DEFEXTERN QUALIFIED params ARROW type extern_opt* ")"
extern_opt: DOC_KW STRING
          | TARGET_KW KEYWORD
          | SYMBOL_KW STRING

defenum: "(" DEFENUM type_params? TYPE_NAME enum_case+ ")"
enum_case: "(" CASE_KW IDENT "[" param* "]" STRING ")"

params: "[" param* "]"
param: "(" IDENT type ")"

// ---------- types ----------

type: TYPE_NAME
    | "(" TYPE_NAME type+ ")"

// ---------- expressions ----------

expr: literal
    | IDENT
    | QUALIFIED
    | OPERATOR
    | let_form
    | if_form
    | cond_form
    | match_form
    | try_form
    | fn_form
    | ctor
    | field_access
    | call

let_form: "(" LET "[" binding* "]" expr+ ")"
binding: "(" IDENT expr ")"

if_form: "(" IF expr expr expr ")"

cond_form: "(" COND cond_clause+ else_clause ")"
cond_clause: "(" expr expr+ ")"
else_clause: "(" ELSE_KW expr+ ")"

match_form: "(" MATCH expr match_arm+ ")"
match_arm: "(" pattern expr+ ")"

pattern: "(" IDENT pattern* ")"     -> enum_pattern
       | "(" OK pattern ")"
       | "(" ERR pattern ")"
       | "(" SOME pattern ")"
       | "(" NONE ")"
       | "(" LIST ")"
       | "(" CONS pattern pattern ")"
       | "(" PAIR pattern pattern ")"
       | literal
       | IDENT
       | WILDCARD

try_form: "(" TRY expr ")"

fn_form: "(" FN params ARROW type expr+ ")"

// A PascalCase head is record construction: (Point :x 3 :y 4)
ctor: "(" TYPE_NAME ctor_arg* ")"
ctor_arg: KEYWORD expr

// (.-field record)
field_access: "(" FIELD_REF expr ")"

// Any other application, including all builtins from AGENT_SPEC_CORE.md §6.
call: "(" expr expr* ")"

// ---------- literals ----------

literal: INT
       | FLOAT
       | STRING
       | BOOL
       | UNIT

// ---------- terminals ----------
// Keyword terminals are declared before IDENT so Earley prefers them; they are
// still valid IDENT shapes, which is intentional — Core has no reserved words at
// the lexical level, only positionally significant heads.

DEFSCHEMA: "defschema"
DEFUN: "defun"
LET: "let"
IF: "if"
COND: "cond"
MATCH: "match"
TRY: "try"
FN: "fn"
OK: "ok"
ERR: "err"
SOME: "some"
NONE: "none"
LIST: "list"
CONS: "cons"
PAIR: "pair"

MODULE: "module"
DEFENUM: "defenum"
DEFENTRY: "defentry"
DEFEXTERN: "defextern"
DEFOPAQUE: "defopaque"
DOC_KW: ":doc"
EXPORT_KW: ":export"
IMPORT_KW: ":import"
AS_KW: ":as"
CASE_KW: ":case"

EXTERN_KW: ":extern"
EFFECTS_KW: ":effects"
TARGET_KW: ":target"
SYMBOL_KW: ":symbol"

FIELD_KW: ":field"
DEFAULT_KW: ":default"
JSON_KW: ":json"
ELSE_KW: ":else"

ARROW: "->"
WILDCARD: "_"

// §6.1/§6.2 operators are ordinary identifiers in call position. Declared as
// explicit alternatives rather than a regex so that "->" (longer literal) always
// out-prioritises "-" and never lexes as an operator inside a defun signature.
OPERATOR: "!=" | "<=" | ">=" | "+" | "*" | "/" | "=" | "<" | ">" | "-"

// (.-field x) — the Clojure-precedent field accessor. FFI's (.method x) is not
// in Core; reserving this shape now keeps its later addition additive.
FIELD_REF: /\.-[a-z][a-z0-9-]*/

BOOL: "true" | "false"
UNIT: "()"

TYPE_NAME: /[A-Z][A-Za-z0-9]*/
IDENT: /[a-z][a-z0-9]*(-[a-z0-9]+)*[?!]?/
KEYWORD: /:[a-z][a-z0-9]*(-[a-z0-9]+)*/

// alias/member and a/b/c module paths share a shape; position disambiguates.
// Bare "/" stays the division operator: it is separator-delimited, a qualified
// name never is.
//
// The priority is load-bearing, not cosmetic. Under the dynamic lexer both
// `s/concat` and `s`,`/`,`concat` are valid tokenizations, and in CALL-HEAD
// position Earley resolved the ambiguity the wrong way: `(s/concat a b)` parsed
// as a four-argument call to `s`. The same name in argument position parsed
// correctly, so the defect was invisible in every fixture that only passed
// qualified names as arguments — and the tooling grammar always got it right,
// which meant the two grammars silently enforced different languages.
QUALIFIED.2: /[a-z][a-z0-9]*(-[a-z0-9]+)*\/[a-z][a-z0-9]*(-[a-z0-9]+)*[?!]?/
MOD_PATH: /[a-z][a-z0-9]*(-[a-z0-9]+)*(\/[a-z][a-z0-9]*(-[a-z0-9]+)*)+/

INT: /-?[0-9]+/
FLOAT: /-?[0-9]+\.[0-9]+/
STRING: /"([^"\\]|\\.)*"/

COMMENT: /;[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
