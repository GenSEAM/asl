(:clients :v 1 :src launch
  :note "adapters for third-party agent clients: how asl launch (interactive, and later its proxy mode) and bin/asl-gateway start each CLI. Not part of the harness, which is model-facing knowledge (asl/grammar/harness.asn). Fields: :shell the client's shell tool (a harness fact), :lean and :coord claude tool sets for --lean and --lean --coord, :tools the tool list an agy agent file declares (without it agy gets neither run_command nor edit tools; kept first after :id because bin/asl-gateway reads it there), :subagent the tool that starts a subagent (renders the delegate layer), :auto the permission flags asl launch passes by default (principal 2026-09-24: agy skips permissions, claude and codex run their auto modes; --ask keeps the client prompting)"
  :clients (
    (:client :id claude :lean "Bash,Read,Edit,Write,Grep,Glob,Agent" :coord "ListAgents,SendMessage" :shell "Bash" :subagent "Agent" :auto "--permission-mode auto")
    (:client :id codex :shell "exec_command" :subagent "spawn_agent" :auto "--approve-for-me" :agentMode "sub-agents may be spawned without an explicit request: independent reads, searches, reviews and checks over separate areas run in parallel sub-agents and return their conclusions, while steps that depend on each other stay in this agent")
    (:client :id leon :layers "evidence,scope,language" :note "Leon, the asl agent loop (scripts/agentLoop): no shell, its ops are ASN steps; its own prompt carries the loop mechanics, and it renders these harness layers at 8k context and above through launch.render(cwd, \"leon\", mode, only=...)")
    (:client :id agy :tools "run_command,invoke_subagent,send_message,manage_subagents,wait" :subagent "invoke_subagent" :shell "run_command" :auto "--dangerously-skip-permissions")))
