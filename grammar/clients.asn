(:clients :v 1 :src launch
  :note "adapters for third-party agent clients: how asl launch (interactive, and later its proxy mode) and bin/asl-gateway start each CLI. Not part of the harness, which is model-facing knowledge (asl/grammar/harness.asn). Fields: :shell the client's shell tool (a harness fact), :lean and :coord claude tool sets for --lean and --lean --coord, :tools the tool list an agy agent file declares (without it agy gets neither run_command nor edit tools; kept first after :id because bin/asl-gateway reads it there), :subagent the tool that starts a subagent (renders the delegate layer), :workerWait (agy) and :outputCut (codex) fill {agyWorkerWait} and {codexOutputCut} in the harness layers, :auto the permission flags asl launch passes by default (principal 2026-09-24: agy skips permissions, claude and codex run their auto modes; --ask keeps the client prompting)"
  :clients (
    (:client :id claude :lean "Bash,Read,Edit,Write,Grep,Glob,Agent" :coord "ListAgents,SendMessage" :shell "Bash" :subagent "Agent" :auto "--permission-mode auto"
      :rules ((:prefers dedicatedTools shell :for files) (:via independentCalls parallelCalls) (:isA systemReminder applicationText) (:not applicationText instruction)))
    (:client :id codex :outputCut "10k tokens" :shell "exec_command" :subagent "spawn_agent" :auto "--approve-for-me" :agentMode "sub-agents may be spawned without an explicit request: independent reads, searches, reviews and checks over separate areas run in parallel sub-agents and return their conclusions, while steps that depend on each other stay in this agent"
      :rules ((:via toolCall execTool :lit codexExec) (:prefers allSettled sequential :for independentCalls :lit codexBatch) (:via edit applyPatch :lit patchForm) (:prefers rg grep :for search :lit rgCmd) (:avoids echoSeparators) (:avoids sleep :at 60 :unit seconds) (:splitsInto channel (commentary final)) (:is finalMessage final) (:holdsWhen persist requestResolved)))
    (:client :id leon :note "Leon, the asl agent loop (asl/packages/asl-agent): no shell, its ops are ASN steps; journal.asl buildSystemPrompt renders harness5.asn for this client through asl-harness/launch renderAsnFor (mode implement: the loop runs every phase and the task text picks them) and appends the dynamic rows (:ops :gates :needsConfirm :plan :task :base); the rules below are the loop protocol"
      :rules (
        (:is reply asnForms)
        (:runs forms inOrder)
        (:isA unbalancedForm parseDefect)
        (:isA (:over 40 words) parseDefect :for outsideForms)
        (:via step programRuns :in workspace)
        (:yields step receipt :at nextTurn)
        (:resolves path workspaceRoot)
        (:yields readOutsideWorkspace ERR_BOUNDARY_VIOLATION)
        (:yields (write edit) appliedAtOnce :inside owns)
        (:yields laterEdit undo)
        (:yields (run :unless greenGates) (patch restoredFiles))
        (:needs old (:whole receipt))
        (:needs windowCut (:copy editLines workingNote))
        (:after windowCut (:reread editLines :once))
        (:keeps workingNote whole :in everyMessage)
        (:exit (:done :when (written gatesPass)) (:escalate :reason s :seen s :tried s :names (file receiptId) :when outsideOwns :preempts (repeatFailure readStreak noWriteTurns wallBudget tokenBudget)) (:yields sameFailure3 (newHypothesis escalate)) (:prefers escalate guess) (:is progress newEvidence))
        (:covers (:evidence (:receipt id)) citation :runs nothing)
        (:holdsWhen exit evidence :via (run gate))
        (:ends run (done findings escalate))
        (:prefers (:txn :owns files) batchedEdits)
        (:has first reply (:intent :deliver (findings patch plan verdict) :why s))
        (:has intent :kind research :when (web document) :yields searchStep researchModel)
        (:keeps findings acrossTurns :replacedBy (file anchor))
        (:yields (:retract :file f :anchor a) dropsClaim :in findings)
        (:holdsWhen patch (written gatesPass))
        (:holdsWhen plan (note done))
        (:holdsWhen verdict (findings :citing gateReceipts))
        (:costs turn modelCall)
        (:prefers (every independentStep) oneReply)
        (:holdsWhen step waits :until receiptNeeded)
        (:has outline (defs classes spans) :costs cheaperThanRead)
        (:yields (:step :op observe :dim callers :symbol s) callSites)
        (:has message (task turns now))
        (:has turn (sent got))
        (:has now (written gateRuns last))))
    (:client :id agy :tools "run_command,invoke_subagent,send_message,manage_subagents,wait" :workerWait "30 minutes" :subagent "invoke_subagent" :shell "run_command" :auto "--dangerously-skip-permissions"
      :rules ((:is reach declaredTools) (:via edit (writeToFile replaceFileContent)) (:avoids mcpProbe)))))
