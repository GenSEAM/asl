(:sanitizer
  :doc "Ingress Natural-Language-to-ASN Prompt Sanitizer, Conversational Denoising, and Canonical Intent Compiler"

  ;; =========================================================================
  ;; 1. INGRESS DENOISING FILTER: Elimination of Conversational Noise
  ;; Filters polite filler, greetings, epistemic hedges, and conversational pleasantries.
  ;; Preserves 100% of domain constraints, targets, exception classes, and invariants.
  ;; Target Token Compression: 60% - 75% reduction in total token length.
  ;; Semantic Utility Density: SUD increases from ~0.10 (NL) to >= 0.75 (ASN).
  ;; =========================================================================
  (:denoiser
    :phaticLexicon [
      (:category :greeting
        :tokens ["привет" "здравствуй" "здравствуйте" "добрый день" "hey" "hello" "hi" "good morning"])
      (:category :politeRequest
        :tokens ["пожалуйста" "будь добр" "не мог бы ты" "сделай пожалуйста" "could you please" "please" "kindly" "i would like you to"])
      (:category :gratitude
        :tokens ["спасибо" "спасибо большое" "благодарю" "заранее спасибо" "thanks" "thank you" "thanks in advance"])
      (:category :epistemicHedge
        :tokens ["кажется" "вроде бы" "похоже что" "наверное" "как мне кажется" "maybe" "perhaps" "it seems that" "i think that"])
      (:category :conversationalFiller
        :tokens ["слушай" "короче" "в общем" "как бы" "ну" "так вот" "look" "well" "basically" "so" "you know"])
    ]
    :retentionRules [
      (:rule :preserveCodeIdentifiers :regex "[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)*")
      (:rule :preserveFilePaths :regex "[a-zA-Z0-9_/-]+\\.[a-zA-Z0-9]+")
      (:rule :preserveExceptionClasses :regex "[A-Z][a-zA-Z0-9]*(Error|Exception|Panic)")
      (:rule :preserveNumericalBounds :regex "([0-9]+(\\.[0-9]+)?(%|ms|s|MB|GB|KB|px)?)")
      (:rule :preserveActionVerbs :verbs [:fix :validate :implement :refactor :optimize :test :patch :reproduce])
      (:rule :preservePolarityAndNegation
        :tokens ["не" "нет" "ни" "без" "not" "never" "no" "without" "prevent" "avoid" "prohibit"]
        :action :bindPolarityModifier
        :doc "Guarantees zero silent negation drop or polarity inversion in intent compilation")
      (:rule :quarantineCodeFences
        :regex "(`[^`]+`|\"\"\"[^\"]+\"\"\"|\"[^\"]+\")"
        :action :preserveVerbatim
        :doc "Isolates string literals and code fences from phatic token stripping")
      (:rule :hallucinationFreedomThreshold
        :theta 0.85
        :doc "Minimum semantic support ratio in prompt union repository")
    ])

  ;; =========================================================================
  ;; 2. CANONICAL INTENT S-EXPRESSION SCHEMA (:intent ...)
  ;; The structured machine-reasoning representation emitted by the sanitizer.
  ;; Downstream agents receive ONLY this high-SNR representation.
  ;; =========================================================================
  (:intentSchema
    :fields [
      (:id :type :keyword :doc "Unique intent identifier e.g. :i1")
      (:domain :type :keyword :doc "Target domain e.g. :billing, :vfs, :ui, :auth, :network")
      (:action :type :keyword :doc "Primary action e.g. :fixAnomaly, :implementFeature, :refactorModule")
      (:polarity :type :keyword :values [:affirmative :negative :conditional] :default :affirmative)
      (:targets :type :vector :doc "Target files, symbols, or modules")
      (:anomaly
        :type :record
        :optional true
        :doc "Observed defect symptoms, exceptions, and trigger conditions"
        :fields [:symptom :exceptions :triggers])
      (:remediation
        :type :record
        :doc "Concrete remediation requirements, validations, and behavioral changes"
        :fields [:action :validations :raiseExceptions :expectedBehavior])
      (:falsification
        :type :record
        :doc "Pre-registered verification tests and falsification criteria"
        :fields [:gates :testFiles :cases])
      (:invariants
        :type :vector
        :doc "Core invariants that must not be violated during remediation")
      (:entropyBudget
        :type :keyword
        :doc "Diff surface budget: :minimal | :scoped | :broad")
    ])

  ;; =========================================================================
  ;; 3. COMPILATION EXAMPLE: Verbose Human Prompt -> Pure-ASN Intent
  ;; Input Prompt (150 words Russian/English):
  ;; 'Привет, слушай, у нас в функции calculate_discount в модуле billing/pricing.py
  ;;  какой-то баг, кажется когда передаем отрицательные числа или когда скидка больше 100%,
  ;;  приложение крашится с ZeroDivisionError или AssertionError. Сделай пожалуйста чтобы
  ;;  оно не крашилось, а валидировало входные данные, бросало InvalidDiscountException
  ;;  и обязательно добавь тесты на это дело, спасибо большое!'
  ;; Output: The 42-token delimiter-balanced S-expression below.
  ;; =========================================================================
  (:example
    :rawPrompt "Привет, слушай, у нас в функции calculate_discount в модуле billing/pricing.py какой-то баг, кажется когда передаем отрицательные числа или когда скидка больше 100%, приложение крашится с ZeroDivisionError или AssertionError. Сделай пожалуйста чтобы оно не крашилось, а валидировало входные данные, бросало InvalidDiscountException и обязательно добавь тесты на это дело, спасибо большое!"
    :compiledIntent (
      :intent
        :id :i1
        :domain :billing
        :action :fixAnomaly
        :targets ["billing/pricing.py:calculate_discount"]
        :anomaly (
          :symptom :crash
          :exceptions ["ZeroDivisionError" "AssertionError"]
          :triggers [(:negativeInput) (:exceedsMaxPercent 100)])
        :remediation (
          :action :validateInputs
          :raiseExceptions ["InvalidDiscountException"]
          :preventCrash true)
        :falsification (
          :testFiles ["tests/test_pricing.py"]
          :cases [:negativeDiscount :exceeds100Percent :validRange])
        :invariants [:failFastOnInvalid :noSilentDefault]
        :entropyBudget :minimal)
    :metrics [
      (:metric :rawCharLength 442)
      (:metric :rawTokenCount 118)
      (:metric :compiledTokenCount 42)
      (:metric :tokenSavingsPercent 64.4)
      (:metric :rawSud 0.09)
      (:metric :compiledSud 0.81)
      (:metric :sudMultiplier 9.0)
    ])

  ;; =========================================================================
  ;; 4. ASR & VOICE INPUT PHONETIC / LEVENSHTEIN ERROR REPAIR
  ;; Compensates for acoustic mishearings, dictation pauses, and homophone collisions.
  ;; Bridges messy spoken natural language to canonical repository entities.
  ;; =========================================================================
  (:asrRepair
    :homophoneTable [
      (:spoken ["вог" "vog" "асн" "аес" "аэс" "ог"] :canonical "ASN")
      (:spoken ["асел" "асил" "асеэль" "эйсел"] :canonical "ASL")
      (:spoken ["edgends" "edgendс" "эджендс" "агендс" "агенты"] :canonical "agents")
      (:spoken ["тоузловины" "тоу зловины" "тулзовины" "тулзбелт" "тулс"] :canonical "tools")
      (:spoken ["клотку" "клод" "клоуд"] :canonical "claude")
      (:spoken ["села и" "селай" "сила и"] :canonical "cli")
      (:spoken ["search-пати" "серч пати" "серч-пати"] :canonical "third-party")
      (:spoken ["хайнесс" "ханес" "хайнес" "харнесс"] :canonical "harness")
      (:spoken ["мультиленс" "мульти ленс" "мульти-ленс"] :canonical "multilens")
    ]
    :dictationHesitationRules [
      (:rule :stripSpuriousPeriod :regex "([a-zA-Zа-яА-Я])\\s*\\.\\s*([a-zA-Zа-яА-Я])" :replace "$1 $2")
      (:rule :repairGluedPrefix :regex "\\b(в|на|из|к)\\.([a-zA-Z0-9_]+)" :replace "$1 .$2")
      (:rule :stripAcousticFillers :tokens ["бо что" "ну и" "вот это вот все" "как бы" "короче" "я не знаю"])
    ]
    :fuzzyMatching [
      (:metric :levenshtein :maxDistance 2 :normalizedThreshold 0.30)
      (:targetLexicons [:astSymbols :filePaths :toolSignatures :invariants])
    ])
)

