(:schema :id terms :v 1 :level L3 :date "2026-10-23" :status draft :ev ASN-ONLY-PROGRAMME-20261023
  :validates ("asl/grammar/terms.asn" "asl/grammar/harness5.asn")
  :validator (:module "asl-codec/schema" :fn "validate" :cli "./bin/asl audit terms" :exit ((:code 0 :means valid) (:code 1 :means diagnostics) (:code 2 :means unbalanced)))
  :kindEnum (actor value attractor mode step stage claim artifact action capability status fact metric relation property tier format)
  :factEnum (subagent tools aslProject chat agy codex once shell asl git asex foreign session implement grade scout distill)
  :ordEnum (V0 V1 V2 V3 V4 V5 V6)
  :literalKinds (path command exemplar name number)
  :modifierKeys (for when until unless by of as to in with from at after before fill ref lit ord count unit)
  :layerKeys (id when unless from ref)
  :forms (
    (:form :head terms :required (v level schema kinds sources items) :optional (date ev) :items term)
    (:form :head src :positional (id path) :types ((:at 1 :type symbol :unique true) (:at 2 :type string :literal path)))
    (:form :head term :required (id kind) :optional (def src ord)
      :types ((:key id :type symbol :unique true :case camel :resolves none)
              (:key kind :type enum :enum kindEnum)
              (:key def :type stmtList)
              (:key src :type symbol :resolves sources)
              (:key ord :type enum :enum ordEnum :onlyKind value)))
    (:form :head harness :required (v level vocab schema clients fills literals static volatile) :optional (date ev supersedes status adoptGate cut merged)
      :types ((:key fills :type symbolList :resolves termId)
              (:key literals :type formList :items literal)
              (:key static :type formList :items layer)
              (:key volatile :type formList :items layer :after static)
              (:key cut :type formList :items cutRow)
              (:key merged :type formList :items cutRow)))
    (:form :head literal :required (id kind text) :optional (bytes)
      :types ((:key id :type symbol :unique true) (:key kind :type enum :enum literalKinds) (:key text :type string)))
    (:form :head layer :required (id) :optional (when unless from ref) :body stmtList
      :types ((:key id :type symbol :unique true) (:key when :type symbolList :enum factEnum) (:key unless :type symbolList :enum factEnum) (:key from :type symbol :resolves termId) (:key ref :type string :literal path)))
    (:form :head cutRow :positional (layer reason) :types ((:at 1 :type symbol) (:at 2 :type stmt))))
  :stmt (:head (or relationTerm modifierKey)
    :args (or termId factId literalId number stmt (:list (or termId factId literalId number stmt)))
    :modifiers modifierKeys
    :strings never
    :exceptIn (literal src validator quote))
  :resolve (
    (:check :subject bareSymbol :resolvesTo (termId factEnum literalId) :else ERR_UNKNOWN_TERM)
    (:check :subject stmtHead :resolvesTo (relationTerm modifierKeys) :else ERR_UNKNOWN_RELATION)
    (:check :subject stmtKey :resolvesTo (modifierKeys) :else ERR_UNKNOWN_KEY)
    (:check :subject formKey :resolvesTo (required optional) :else ERR_UNKNOWN_KEY)
    (:check :subject requiredKey :resolvesTo (present) :else ERR_MISSING_KEY)
    (:check :subject termId :resolvesTo (unique camelCase) :else ERR_DUP_TERM)
    (:check :subject string :resolvesTo (exceptIn) :else ERR_PLAINTEXT))
  :diagnostics (
    (:err ERR_UNBALANCED :exit 2)
    (:err ERR_BRACKET :exit 2 :rule dialect)
    (:err ERR_DUP_TERM :exit 1)
    (:err ERR_ENUM :exit 1)
    (:err ERR_MISSING_KEY :exit 1)
    (:err ERR_UNKNOWN_KEY :exit 1)
    (:err ERR_UNKNOWN_TERM :exit 1)
    (:err ERR_UNKNOWN_RELATION :exit 1)
    (:err ERR_FACT :exit 1)
    (:err ERR_SRC :exit 1)
    (:err ERR_PLAINTEXT :exit 1 :check string)
    (:err ERR_ORDER :exit 1 :check volatileAfterStatic))
  :receipt "(:audit :sub terms :file F :status (passed failed) :terms N :unique N :errors ((:err CODE :at ID :got X)))")
