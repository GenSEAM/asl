// AgentScript v0.1 — Lark grammar (Earley).
// Normative source: AGENT_SPEC_CORE.md
//
// Earley is chosen to match llguidance, which the constrained-decoding arm
// (EXPERIMENT.md arm C) uses, so a grammar accepted here is convertible without
// re-deriving parse behavior under a different algorithm.
//
// Scope: this grammar enforces STRUCTURE (delimiters, declaration shapes, token
// classes). It deliberately does NOT enforce types, arity, exhaustiveness, or
// scope — those are not context-free. See RESEARCH_REPORT.md §5: a CFG reaches
// only the syntactic slice of the error surface, and the type layer is where the
// leverage is. Over-tightening here would reject valid programs while buying
// none of that.

start: toplevel*

toplevel: module_decl
        | defschema
        | defun
        | defenum

// ---------- module header (v0.2) ----------

module_decl: "(" MODULE mod_path module_opt* ")"
module_opt: DOC_KW STRING
          | EXPORT_KW "[" (IDENT|TYPE_NAME)* "]"
          | IMPORT_KW "[" import_spec* "]"
import_spec: "(" mod_path AS_KW IDENT ")"
mod_path: MOD_PATH | IDENT

// Type parameters are bound explicitly, so a name is a type variable because it
// was declared one, never because of its spelling.
type_params: "{" TYPE_NAME* "}"

// ---------- declarations ----------

defschema: "(" DEFSCHEMA type_params? TYPE_NAME field+ ")"

field: "(" FIELD_KW IDENT type STRING field_opt* ")"

field_opt: DEFAULT_KW literal
         | JSON_KW STRING

// The `!` marks a declaration that touches the world. It is inferred inside a
// body but mandatory here, because the signature is the module surface and a
// caller must see an effect without reading the body (PCP d-f99b).
defun: "(" DEFUN BANG? type_params? IDENT params ARROW type doc_opt? expr+ ")"
doc_opt: DOC_KW STRING

defenum: "(" DEFENUM type_params? TYPE_NAME enum_case+ ")"
enum_case: "(" CASE_KW IDENT "[" param* "]" STRING ")"

params: "[" param* "]"
param: "(" IDENT type ")"

// ---------- types ----------

type: TYPE_NAME
    | QUALIFIED_TYPE
    | "(" (TYPE_NAME|QUALIFIED_TYPE) type+ ")"

// ---------- expressions ----------

expr: literal
    | IDENT
    | QUALIFIED
    | OPERATOR
    | let_form
    | if_form
    | cond_form
    | match_form
    | try_form
    | fn_form
    | ctor
    | field_access
    | call

let_form: "(" LET "[" binding* "]" expr+ ")"
binding: "(" IDENT expr ")"

if_form: "(" IF expr expr expr ")"

cond_form: "(" COND cond_clause+ else_clause ")"
cond_clause: "(" expr expr+ ")"
else_clause: "(" ELSE_KW expr+ ")"

match_form: "(" MATCH expr match_arm+ ")"
match_arm: "(" pattern expr+ ")"

pattern: "(" (IDENT|QUALIFIED) pattern* ")"     -> enum_pattern
       | literal
       | IDENT
       | WILDCARD

try_form: "(" TRY expr ")"

// A lambda's parameter and return types are optional: where it is passed to a
// callee whose signature fixes them, an annotation cannot differ from what the
// position implies, and writing it costs the budget the language exists to spend
// on problem-solving (PCP r-a624). Named declarations keep theirs — they are the
// module surface, read without the body — so `params` stays strict.
fn_form: "(" FN BANG? fn_params (ARROW type)? expr+ ")"
fn_params: "[" fn_param* "]"
fn_param: IDENT
        | "(" IDENT type ")"

// A PascalCase head is record construction: (Point :x 3 :y 4)
ctor: "(" (TYPE_NAME|QUALIFIED_TYPE) ctor_arg* ")"
ctor_arg: KEYWORD expr

// (.-field record)
field_access: "(" FIELD_REF expr ")"

// Any other application, including all builtins from AGENT_SPEC_CORE.md §6.
call: "(" expr expr* ")"

// ---------- literals ----------

literal: INT
       | FLOAT
       | STRING
       | BOOL
       | UNIT

// ---------- terminals ----------
// Keyword terminals are declared before IDENT so Earley prefers them; they are
// still valid IDENT shapes, which is intentional — Core has no reserved words at
// the lexical level, only positionally significant heads.

DEFSCHEMA: "defschema" | "schema" | "dfs"
DEFUN: "defun" | "def" | "df"
LET: "let"
IF: "if"
COND: "cond"
MATCH: "match"
TRY: "try"
FN: "fn"
OK: "ok"
ERR: "err"
SOME: "some"
NONE: "none"
LIST: "list"
CONS: "cons"
PAIR: "pair"

MODULE: "module"
DEFENUM: "defenum" | "enum" | "dfe"
DOC_KW: ":doc"
EXPORT_KW: ":export"
IMPORT_KW: ":import"
AS_KW: ":as"
CASE_KW: ":case"

FIELD_KW: ":field"
DEFAULT_KW: ":default"
JSON_KW: ":json"
ELSE_KW: ":else"

ARROW: "->"
// Standalone: no identifier starts with it and the only operator containing it
// is the longer "!=", so the literal cannot be re-lexed into one.
BANG: "!"
WILDCARD: "_"

// §6.1/§6.2 operators are ordinary identifiers in call position. Declared as
// explicit alternatives rather than a regex so that "->" (longer literal) always
// out-prioritises "-" and never lexes as an operator inside a defun signature.
// The lookahead on "-" is what makes a sign bind to the digits after it: without
// it the Earley lexer could read `-1` as subtraction applied to `1`, which is a
// legal parse, and the resolver chose it — so `(+ x -1)` lost its literal.
OPERATOR: "!=" | "<=" | ">=" | "+" | "*" | "/" | "=" | "<" | ">" | /-(?![0-9])/

// (.-field x) — the Clojure-precedent field accessor. FFI's (.method x) is not
// in Core; reserving this shape now keeps its later addition additive.
FIELD_REF: /\.-[a-z][a-z0-9-]*/

BOOL: "true" | "false"
UNIT: "()"

TYPE_NAME: /[A-Z][A-Za-z0-9]*/
IDENT: /[a-z][a-z0-9]*(-[a-z0-9]+)*[?!]?/
KEYWORD: /:[a-z][a-z0-9]*(-[a-z0-9]+)*/

// alias/member and a/b/c module paths share a shape; position disambiguates.
// Bare "/" stays the division operator: it is separator-delimited, a qualified
// name never is. The priority is load-bearing: without it the dynamic lexer
// splits a qualified name in head position into `alias / member`, which is a
// legal division call, so (s/concat x) silently became a call to `s`.
QUALIFIED.2: /[a-z][a-z0-9]*(-[a-z0-9]+)*\/[a-z][a-z0-9]*(-[a-z0-9]+)*[?!]?/
// The uppercase tail makes this lexically disjoint from QUALIFIED, MOD_PATH
// and TYPE_NAME, so an imported type is one token wherever it can appear.
QUALIFIED_TYPE.2: /[a-z][a-z0-9]*(-[a-z0-9]+)*\/[A-Z][A-Za-z0-9]*/
MOD_PATH: /[a-z][a-z0-9]*(-[a-z0-9]+)*(\/[a-z][a-z0-9]*(-[a-z0-9]+)*)+/

INT: /-?[0-9]+/
FLOAT: /-?[0-9]+\.[0-9]+/
STRING: /"([^"\\]|\\.)*"/

COMMENT: /;[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
