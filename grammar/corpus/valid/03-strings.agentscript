; String builtins, let bindings, try propagation.
;
; run: [shout("  hi "), initials("ada lovelace"), parse_pair(" 21 "), evens_below(6), total([1, 2, 3])] == ["HI!", "A.L", ("ok", 42), [0, 2, 4], 6]

(defun shout [(s String)] -> String
  (str (string-upper (string-trim s)) "!"))

(defun initials [(full String)] -> String
  (let [(parts (string-split full " "))
        (heads (map (fn [(w String)] -> String
                      (match (string-slice w 0 1)
                        ((some c) (string-upper c))
                        ((none)   "")))
                    parts))]
    (string-join heads ".")))

(defun parse-pair [(s String)] -> (Result Int64 String)
  (let [(trimmed (string-trim s))
        (n (try (option-to-result (string-to-int64 trimmed) "not a number")))]
    (ok (* n 2))))

(defun evens-below [(limit Int64)] -> (List Int64)
  (filter (fn [(n Int64)] -> Bool (= (mod n 2) 0))
          (range 0 limit)))

(defun total [(xs (List Int64))] -> Int64
  (fold (fn [(acc Int64) (x Int64)] -> Int64 (+ acc x)) 0 xs))
