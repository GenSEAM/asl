; Reshaping a list, with the composed return shapes the differential harness has
; to encode: `(Option (List T))` and `(List (Pair A B))`. The slice cases sit on
; both ends of the half-open interval, and `list-get` reads index 1 — neither the
; head nor the last element, so an off-by-one is visible.
;
; run: reshape(4) == "[9,0,1,2,3]|[0,1,2,3,100,200,300]|[3,2,1,0]|some [1,2,3]|some 0|some 1"

(module list/reshape
  :doc "Reshape a range and report every result."
  :export [reshape window pairs])

(defun show-list [(xs (List Int64))] -> String
  :doc "A list of integers, bracketed and comma separated."
  (str "[" (string-join (map (fn [v] (string-from-int64 v)) xs) ",") "]"))

(defun show-opt [(o (Option Int64))] -> String
  :doc "An optional integer, so `none` is distinguishable from zero."
  (match o
    ((some n) (str "some " (string-from-int64 n)))
    ((none)   "none")))

(defun show-opt-list [(o (Option (List Int64)))] -> String
  :doc "An optional list, so `none` is distinguishable from the empty list."
  (match o
    ((some xs) (str "some " (show-list xs)))
    ((none)    "none")))

(defun reshape [(n Int64)] -> String
  :doc "cons, append, reverse, tail, head and an indexed read of (range 0 n)."
  (let [(xs (range 0 n))
        (ys (list 100 200 300))]
    (string-join (list (show-list (list-cons 9 xs))
                       (show-list (list-append xs ys))
                       (show-list (list-reverse xs))
                       (show-opt-list (list-tail xs))
                       (show-opt (list-head xs))
                       (show-opt (list-get xs 1)))
                 "|")))

(defun window [(n Int64) (a Int64) (b Int64)] -> (Option (List Int64))
  :doc "The half-open slice [a, b) of (range 0 n), or none when out of range."
  (list-slice (range 0 n) a b))

(defun pairs [(n Int64)] -> (List (Pair Int64 String))
  :doc "Indices paired with labels, truncated to whichever list is shorter."
  (zip (range 0 n) (list "a" "b" "c")))
