; Search-path companion for corpus/valid/06-module.agents, which imports it.
; It is not a gate case: it exists so rule 9 has a real export list to check a
; qualified name against, which no fixture could do while the module was absent.

(module core/strings
  :doc "String helpers reached by the module fixture through an alias."
  :export [concat upper])

(defun concat [(a String) (b String)] -> String
  :doc "Join two strings end to end."
  (str a b))

(defun upper [(s String)] -> String
  :doc "Uppercase every character."
  (string-upper s))
