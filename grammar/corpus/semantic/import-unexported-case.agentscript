; expect-only: rule-9
; `secret` is a case of core/private's Hidden, which is not exported. A case is
; public exactly when its type is, so reaching one of an unexported union is the
; same violation as naming the union.
(module text/pry
  :doc "Constructs a case of a union its import keeps private."
  :export [make]
  :import [(core/private :as p)])

(defun make [] -> String
  :doc "Reach for a constructor the import does not publish."
  (p/secret "x"))
