"expect-only: rule-9"
"`q` is bound by no :import entry, so q/Shape names no module at all. Without a"
"pass that scans type position, nothing looks at this token."
(module text/stray
  :doc "Names a type through an alias it never imported."
  :export [tag]
  :import [(core/shapes :as s)])

(defun tag [(x q/Shape)] -> String
  :doc "Name a shape through an unbound alias."
  "shape")
