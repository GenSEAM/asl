;; Canonical Batch RPC Operations Registry (Single Source of Truth)
(:rpc-registry
  :version "1.0.0"
  :rejectionCode ":ERR_UNIMPLEMENTED"
  :rejectionPolicy "Unrecognized or unimplemented operations are rejected with status rejected and error-code :ERR_UNIMPLEMENTED."
  :operations [
    ;; === Reading & Progressive Disclosure ===
    (:op :id "asl-intel-ast"
         :cmd "asl rpc '(:batch (:out \"...\") (:sym \"...\"))'"
         :category "reading"
         :purpose "Polyglot AST outline extraction and precise symbol definition lookup without reading full files"
         :savings "94%")

    (:op :id "asl-intel-read"
         :cmd "asl rpc '(:batch (:read \"...\" <start> <end>))'"
         :category "reading"
         :purpose "Targeted line-range slice read avoiding full-file dumps and context bloat"
         :savings "90%")

    (:op :id "asl-intel-sec"
         :cmd "asl rpc '(:batch (:sec \"...\" \"<heading>\"))'"
         :category "reading"
         :purpose "Targeted markdown section extraction without whole-file dump"
         :savings "92%")

    (:op :id "asl-intel-ls"
         :cmd "asl rpc '(:batch (:ls \"...\"))'"
         :category "reading"
         :purpose "Fast directory listing and file sizing metadata in resident memory"
         :savings "85%")

    ;; === Search & Code Intelligence ===
    (:op :id "asl-engine"
         :cmd "asl rpc '(:batch (:engine :query \"...\" [:tier \"all\"|\"tier-0-ast\"|\"tier-1-mem\"|\"tier-2-web\"]))'"
         :category "search"
         :purpose "Unified tripartite engine gateway dispatching across AST (Tier 0), Resident Memory (Tier 1), and Web (Tier 2)"
         :savings "90%")

    (:op :id "asl-intel-impact"
         :cmd "asl rpc '(:batch (:callers \"...\") (:impact \"...\"))'"
         :category "search"
         :purpose "Call graph tracing and blast-radius impact analysis across workspace before code changes"
         :savings "88%")

    (:op :id "asl-mem-search"
         :cmd "asl rpc '(:batch (:find \"...\" [:ext \"...\"]))'"
         :category "search"
         :purpose "Instant resident-memory grep (<15ms) and vector semantic search across docstrings and comments"
         :savings "90%")

    (:op "grep"
         :id "asl-grep"
         :cmd "asl rpc '(:batch (:grep \"...\" [:file \"...\" | :dir \"...\"]))' or asl grep <pattern> [path]"
         :category "search"
         :purpose "Substring line search across text files returning 1-indexed line numbers, file paths, and line text"
         :savings "90%")

    (:op "q"
         :id "asl-q"
         :cmd "asl rpc '(:batch (:q :query \"...\" [:scope \"decisions\"|\"tasks\"|\"code\"] [:limit <n>]))'"
         :category "search"
         :purpose "Semantic recall and ranked Okapi BM25 retrieval over .asl/mem ledgers and codebase"
         :savings "90%")

    ;; === Editing & Agentic IDE Refactoring ===
    (:op :id "asl-mem-edit"
         :cmd "asl rpc '(:batch (:edit \"...\" \"old\" \"new\"))'"
         :category "editing"
         :mode "immediate"
         :purpose "Immediate text replacement writing directly to disk; returns :mode \"immediate\""
         :savings "85%")

    (:op :id "asl-mem-patch"
         :cmd "asl rpc '(:batch (:patch \"...\" \"<sym>\" \"new\") (:diff) (:flush))'"
         :category "editing"
         :purpose "AST-level function/struct form replacement: scoped refactoring in resident memory"
         :savings "88%")

    (:op :id "asl-mem-repl"
         :cmd "asl rpc '(:batch (:repl \"old\" \"new\" [:ext \"...\"]) (:diff) (:flush))'"
         :category "editing"
         :purpose "In-memory mass refactoring and symbol replacement across repository files"
         :savings "90%")

    ;; === Git-Native Memory & Trajectory Continuity ===
    (:op "mem"
         :id "asl-mem"
         :cmd "asl rpc '(:batch (:mem :query \"...\") | (:mem :write :kind \"...\" :content \"...\" :closure \"...\") | (:mem :promote :id \"...\" :to \"...\"))' or asl mem <query|write|promote>"
         :category "memory"
         :purpose "Unified memory query and write surface across intents, goals, practices and notes with path-independent search and lineage preservation"
         :savings "92%")

    (:op :id "asl-mem-intent"
         :cmd "asl rpc '(:batch (:sec \".asl/mem/intent.asn\" \"<section>\"))'"
         :category "memory"
         :purpose "Query Git-native intent, axioms, constraints, and architecture decisions"
         :savings "95%")

    (:op :id "asl-mem-task"
         :cmd "asl rpc '(:batch (:read \".asl/mem/tasks/<task-id>.asn\" 1 50))'"
         :category "memory"
         :purpose "Inspect task execution state, baseline gates, and physical verification receipts"
         :savings "90%")

    (:op :id "asl-mem-roadmap"
         :cmd "asl rpc '(:batch (:read \".asl/mem/roadmap.asn\" 1 60))'"
         :category "memory"
         :purpose "Inspect active waves, dependency ordering, and phase completion roadmap"
         :savings "92%")

    (:op :id "asl-storage"
         :cmd "asl rpc '(:batch (:storage :mode \"git-native\"|\"ephemeral\" [:path \"...\"]))'"
         :category "memory"
         :purpose "Configures memory storage tier: default Git-native (.asl/mem/), 100% ephemeral in-RAM, or external custom path"
         :savings "92%")

    (:op :id "asl-mem-write"
         :cmd "asl rpc '(:batch (:write \"...\" \"content\") (:flush))'"
         :category "editing"
         :purpose "Direct virtual file creation and atomic overwrite in resident RAM VFS"
         :savings "85%")

    (:op :id "asl-mem-staging"
         :cmd "asl rpc '(:batch (:diff) (:stage \"...\") (:discard) (:flush))'"
         :category "editing"
         :status :active
         :purpose "In-memory review staging allowing diff, stage, discard, and flush operations before writing to disk"
         :savings "90%")

    ;; === DAG Execution Combinators & Parallelism ===
    (:op :id "asl-batch-par"
         :cmd "asl rpc '(:batch (:par (:read \"...\") (:sym \"...\")))'"
         :category "concurrency"
         :purpose "Parallel execution block running child operations concurrently across thread pool without graph bookkeeping"
         :savings "80%")

    (:op :id "asl-batch-seq"
         :cmd "asl rpc '(:batch (:seq (:edit \"...\") (:flush) (:chk)))'"
         :category "concurrency"
         :purpose "Sequential execution block with fail-fast abort on error preventing corrupted dirty flushes"
         :savings "85%")

    (:op :id "asl-batch-wave"
         :cmd "asl rpc '(:batch (:wave (:read \"a\") (:read \"b\")) (:wave (:edit \"a\" ...) (:flush)))'"
         :category "concurrency"
         :purpose "Topological wave execution: atomic parallel phases where subsequent waves wait or skip on failure"
         :savings "90%")

    (:op :id "asl-claim"
         :cmd "asl rpc '(:batch (:claim :path \"...\" [:sessionId \"...\"] [:ttl-ms <ms>]))'"
         :category "concurrency"
         :purpose "Acquire path lease with on-disk digest preventing concurrent writer collision and dirty overwrites"
         :savings "85%")

    (:op :id "asl-leases"
         :cmd "asl rpc '(:batch (:leases))'"
         :category "concurrency"
         :purpose "Inspect active writer claims and path digests in resident memory ledger"
         :savings "90%")

    ;; === Supervised Execution & Git ===
    (:op :id "asl-run"
         :cmd "asl rpc '(:batch (:run :cmd \"...\" [:cwd \"...\"] [:timeout-ms <ms>] [:limit <bytes>]))'"
         :category "execution"
         :purpose "Structured supervised execution under watchdog with exit code, duration, separated stdout/stderr, and bounded output"
         :savings "85%")

    (:op :id "asl-git"
         :cmd "asl git <subcmd> or asl rpc '(:batch (:git :op \"where\"|\"branches\"|\"compare\"|\"search\"|\"show\"|\"log\"|\"worktrees\"|\"diff\"))'"
         :category "git"
         :purpose "Git topology orientation, branch tracking, token-compacted compare, cross-branch search without checkout, and worktree steering"
         :savings "95%")

    (:op :id "asl-github"
         :cmd "asl github <subcmd> or asl rpc '(:batch (:github :op \"pr\"|\"issue\"|\"ci\"|\"diff\"))'"
         :category "github"
         :purpose "GitHub PR and issue projections, aggregate CI rollup verdicts, and token-compacted PR diffs"
         :savings "85%")

    ;; === Codec, Pointers & Zero-JSON ===
    (:op :id "asl-toolcall"
         :cmd "asl rpc '(:batch (:call :tool \"...\" ...))'"
         :category "codec"
         :purpose "Zero-JSON S-expression tool invocation and transpilation with strict schema validation"
         :savings "75%")

    (:op :id "asl-codec"
         :cmd "asl rpc '(:batch (:codec :from \"json\" :to \"asn\" :data \"...\"))'"
         :category "codec"
         :purpose "Universal bidirectional format transpiler between JSON, YAML, HTML, and compact ASN S-expressions"
         :savings "70%")

    (:op :id "asl-pointer"
         :cmd "asl rpc '(:batch (:ptr :action \"offload\" :data \"...\"))'"
         :category "codec"
         :purpose "Perceptual pointer offloading to store heavy data in memory and retain context economy"
         :savings "95%")

    ;; === Interactive Process & Spool Navigation ===
    (:op :id "asl-proc-spawn"
         :cmd "asl rpc '(:batch (:proc-spawn :cmd \"...\" [:args [...]] [:timeout-ms <ms>] [:daemon true]))'"
         :category "process"
         :purpose "Spawns an interactive managed process session in resident memory with streaming channels, 15m autonomous default, and daemon mode"
         :savings "80%")

    (:op :id "asl-proc-input"
         :cmd "asl rpc '(:batch (:proc-input :id \"...\" :data \"...\"))'"
         :category "process"
         :purpose "Injects streaming input into an active process stdin channel without hanging on prompts"
         :savings "85%")

    (:op :id "asl-proc-timeout"
         :cmd "asl rpc '(:batch (:proc-timeout :id \"...\" :extend-ms <ms>))' or (:batch (:proc-timeout :id \"...\" :timeout-ms <ms>))"
         :category "process"
         :purpose "Dynamically extends or updates process watchdog timeout when observing active forward progress"
         :savings "88%")

    (:op :id "asl-proc-skeleton"
         :cmd "asl rpc '(:batch (:proc-skeleton :id \"...\"))'"
         :category "process"
         :purpose "Extracts compact structural output skeleton and error coordinates (<80 tokens) before whole-log dumps"
         :savings "92%")

    (:op :id "asl-proc-read"
         :cmd "asl rpc '(:batch (:proc-read :id \"...\" :start <start> :end <end>))'"
         :category "process"
         :purpose "Reads narrow line range from process spool buffer without loading full log"
         :savings "90%")

    (:op :id "asl-proc-find"
         :cmd "asl rpc '(:batch (:proc-find :id \"...\" :query \"...\" [:top-k <k>]))'"
         :category "process"
         :purpose "Executes sub-millisecond in-memory BM25 query over process spool to retrieve ranked matching lines"
         :savings "94%")

    (:op :id "asl-proc-signal"
         :cmd "asl rpc '(:batch (:proc-signal :id \"...\" :sig \"KILL\"))'"
         :category "process"
         :purpose "Dispatches POSIX signal to terminate or interrupt running process session"
         :savings "80%")

    ;; === Verification & Onboarding ===
    (:op :id "asl-gate-chk"
         :cmd "asl rpc '(:batch (:chk))' or asl gate"
         :category "verification"
         :purpose "Complete 7-tier verification gate across all packages, manifests, forms, tests, and skills"
         :savings "95%")

    (:op :id "asl-onboard"
         :cmd "asl rpc '(:batch (:onboard))' or asl gate"
         :category "verification"
         :purpose "Instant workspace onboarding, topology discovery, active wave inspection, and gate verification"
         :savings "95%")

    ;; === Token Economy & Lexical Profiling ===
    (:op :id "asl-tokens"
         :cmd "asl rpc '(:batch (:tokens :input \"...\" [:top <n>]))' or asl tokens <input>"
         :category "token-economy"
         :purpose "Hierarchical token counting, category breakdown, SNR calculation, and ranked frequency decomposition"
         :savings "90%")

    ;; === Architectural Decisions & Governance ===
    (:op :id "asl-adr"
         :cmd "asl rpc '(:batch (:adr [:id \"...\"] [:shortcode \"...\"] [:cluster \"...\"] [:format \"asn\"|\"md\"]))' or asl adr show <id>"
         :category "governance"
         :purpose "Deterministic architectural decision querying, sub-200 token AST retrieval, and dual-projection Markdown export"
         :savings "80%")

    ;; === Machine Notes & Observations ===
    (:op "note"
         :id "asl-note"
         :cmd "asl rpc '(:batch (:note :write \"...\" | :query \"...\" | :list))' or asl note list"
         :category "memory"
         :purpose "Deterministic machine-native notes querying, keyword search, and dual-projection Markdown export"
         :savings "85%")

    (:op "trace"
         :id "asl-trace"
         :cmd "asl rpc '(:batch (:trace [:since <timestamp>] [:op <op>] [:limit <n>]))'"
         :category "observability"
         :purpose "Append-only session trace querying over RPC operations, mutations and gate runs with before/after digests"
         :savings "88%")

    ;; === Task Management & Lifecycle ===
    (:op "task"
         :id "asl-task"
         :cmd "asl rpc '(:batch (:task :claim \"...\" | :recover \"...\" | :list))' or asl task list"
         :category "memory"
         :purpose "Task session claim, recovery, and listing via InFlight.asn and tasks.asl"
         :savings "85%")

    ;; === Session Trace ===
    (:op "trace"
         :id "asl-trace"
         :cmd "asl rpc '(:batch (:trace [:since <ms>] [:op \"...\"] [:limit <n>]))'"
         :category "memory"
         :purpose "Inspect append-only session trace of operations, mutations, and before/after digests"
         :savings "85%")

    ;; === Post Action Queue ===
    (:op "queue"
         :id "asl-queue"
         :cmd "asl rpc '(:batch (:queue :enqueue \"...\" | :drain))' or asl queue drain"
         :category "memory"
         :purpose "Post action queue enqueue and drain"
         :savings "80%")

    ;; === Resident Prompt Translation & Multilingual Normalization ===
    (:op :id "asl-translate"
         :cmd "asl rpc '(:batch (:translate :input \"...\" [:model \"...\"] [:formalize true]))' or asl translate <input>"
         :category "translation"
         :purpose "Resident ASN Prompt Translator: converts user prompts into structured ASN with formal reasoning and safe fallback"
         :savings "40%")

    ;; === Ad Hoc Composition & Pipeline Reduction ===
    (:op "compose"
         :id "asl-rpc-compose"
         :cmd "asl rpc '(:batch (:compose [:bound <bytes>] ...))'"
         :category "pipeline"
         :purpose "Ad hoc RPC composition and reduction outside the model with bounded output and unreduced log refusal"
         :savings "85%")
  ]
)
