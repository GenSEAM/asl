(:languageSemantics :v 1 :src ADR-0081
  :summary "Canonical language semantics contract for module imports, symbol resolution, and evaluator failures."
  :semantics [
    (:semantic :id moduleImportResolution
      :rule "Module imports resolve relative to the outermost monorepo workspace root."
      :failureCode "ERR_UNRESOLVED_IMPORT"
      :exitCode 1)
    (:semantic :id duplicateModule
      :rule "Duplicate module declarations across multiple source files fail loudly."
      :failureCode "ERR_DUPLICATE_MODULE"
      :exitCode 1)
    (:semantic :id unknownSymbolFailure
      :rule "Evaluation of unbound symbols or missing definitions produces loud typed errors and non-zero exit code."
      :failureCode "ERR_UNBOUND_SYMBOL"
      :exitCode 1)
    (:semantic :id aliasCollision
      :rule "Duplicate module import aliases within a single module trigger loud failure."
      :failureCode "ERR_ALIAS_COLLISION"
      :exitCode 1)
    (:semantic :id booleanTestResults
      :rule "Test entry points (run-tests, run-wire-tests, main, test-*) must strictly return boolean true."
      :failureCode "ERR_TEST_RESULT_NOT_TRUE"
      :exitCode 1)
    (:semantic :id assertionSiteAccounting
      :rule "Distinct assertion sites are accounted stably by AST node location separately from dynamic execution counts."
      :failureCode ""
      :exitCode 0)
    (:semantic :id predicateNaming
      :rule "A predicate ends in a question mark (?) and must never begin with is or is- (e.g. empty?, not is-empty or is-empty?)."
      :failureCode "ERR_RETIRED_PREDICATE_FORM"
      :exitCode 1)
    (:semantic :id constructorNaming
      :rule "A constructor is make followed by the type or construct name (e.g. make-node, not create-node, build-node, or new-node)."
      :failureCode "ERR_RETIRED_CONSTRUCTOR_FORM"
      :exitCode 1)
    (:semantic :id conversionNaming
      :rule "A type conversion is source-to-target (e.g. int-to-string, not int-from-string, to-string, or as-string)."
      :failureCode "ERR_RETIRED_CONVERSION_FORM"
      :exitCode 1)
    (:semantic :id expensiveBuiltinsRenamed
      :rule "The 14 measured expensive multi-token builtins (including string-contains?, string-starts-with?, string-from-int64, string-replace, list-length) are renamed to their shortest unambiguous form; usage of retired spellings fails loudly."
      :failureCode "ERR_RETIRED_BUILTIN"
      :exitCode 1)
    (:semantic :id zeroCompatibilityAliases
      :rule "Retired built-in identifiers must be completely removed with zero backward-compatibility aliases left behind, preventing fragmented parallel spellings."
      :failureCode "ERR_RETIRED_ALIAS"
      :exitCode 1)
    (:semantic :id assertionParityAcrossTransformations
      :rule "Executed assertion counts must remain exactly preserved and non-vacuous across mechanical CamelCase and identifier renames; any silent unbinding or assertion loss triggers loud failure."
      :failureCode "ERR_UNBOUND_IDENTIFIER_MUTATION"
      :exitCode 1)
    (:semantic :id stringLiteralPreservation
      :rule "Mechanical identifier renames and CamelCase transformations must strictly preserve string literals without rewriting substrings within quotes."
      :failureCode "ERR_MUTATED_STRING_LITERAL"
      :exitCode 1)
    (:semantic :id legibleAliasLength
      :rule "Module import aliases must be legible and at least three characters in length; single- and two-character aliases are rejected."
      :failureCode "ERR_OPAQUE_ALIAS"
      :exitCode 1)
    (:semantic :id globalPrefixUniqueness
      :rule "A qualified prefix must unambiguously map to exactly one module across the whole monorepo; binding one prefix to two different modules is rejected."
      :failureCode "ERR_AMBIGUOUS_PREFIX"
      :exitCode 1)
    (:semantic :id selfContainedSliceResolution
      :rule "Qualified uses in retrieved slices must resolve unambiguously from the prefix without requiring file headers to be read."
      :failureCode "ERR_UNRESOLVED_QUALIFIED_USE"
      :exitCode 1)
    (:semantic :id symbolSurfaceTracking
      :rule "Distinct symbol surface is tracked in the same inventory alongside token count; proposals reducing tokens while increasing distinct symbol surface or distance between binding and uses are rejected without measured accuracy evidence."
      :failureCode "ERR_SURFACE_EXPANSION_WITHOUT_EVIDENCE"
      :exitCode 1)
    (:semantic :id symbolSurfaceRatchet
      :rule "Adding a synonym or duplicate spelling for an existing primitive expands the distinct symbol surface and fails the ratchet check."
      :failureCode "ERR_SYMBOL_SURFACE_RATCHET_VIOLATION"
      :exitCode 1)
    (:semantic :id dualQuantityInventory
      :rule "Language telemetry inventories must report both total token count and distinct head symbol surface in a single run."
      :failureCode "ERR_MISSING_DUAL_INVENTORY"
      :exitCode 1)
    (:semantic :id groundedNumericClaims
      :rule "Every numeric claim in conventions, rules, and documentation must state its scope, method, and empirical measurement date; ungrounded or out-of-scope claims are rejected."
      :failureCode "ERR_UNGROUNDED_NUMERIC_CLAIM"
      :exitCode 1)
    (:semantic :id dualScopeCompactionReport
      :rule "Naming convention compaction figures must report both the per-long-identifier saving (44 to 50 percent) and the corpus-wide saving (3.06 percent on 888 files under cl100k)."
      :failureCode "ERR_PARTIAL_SCOPE_CLAIM"
      :exitCode 1)
    (:semantic :id schemeCoreFormsAlignment
      :rule "Core forms align with Scheme and Racket spellings where measured token cost is zero (define, struct, enum, lambda, match, begin, provide, require, field, string, null); abbreviated forms are retired."
      :failureCode "ERR_RETIRED_ABBREVIATED_FORM"
      :exitCode 1)
    (:semantic :id zeroCostAbbreviationRetirement
      :rule "Retired abbreviated core forms are removed cleanly with zero backward-compatibility aliases left behind."
      :failureCode "ERR_ABBREVIATION_ALIAS_FORBIDDEN"
      :exitCode 1)
    (:semantic :id racketBindingShape
      :rule "Local binding forms adopt Racket's canonical parenthesized pairs syntax (let ([a 1] [b 2]) body); malformed or legacy binding shapes trigger reader and evaluation failure."
      :failureCode "ERR_INVALID_BINDING_SHAPE"
      :exitCode 1)
    (:semantic :id clojureBindingShapeRejection
      :rule "Flat vector-style Clojure bindings (let [a 1 b 2] body) are rejected despite saving 0.69 percent tokens, maintaining single-reference alignment with Scheme/Racket."
      :failureCode "ERR_UNALIGNED_BINDING_SHAPE"
      :exitCode 1)
    (:semantic :id racketModuleResolution
      :rule "A module path denotes a module resolved by a module name resolver against declared collection roots with zero positional guessing; resolution failure is a compile-time error at the requiring site."
      :failureCode "ERR_MODULE_NOT_FOUND"
      :exitCode 1)
    (:semantic :id moduleCycleDetection
      :rule "Cyclic require dependencies are detected and reported as a fatal cycle naming the offending path, rather than being silently truncated by a loading set."
      :failureCode "ERR_MODULE_CYCLE_DETECTED"
      :exitCode 1)
    (:semantic :id singleModuleInstantiation
      :rule "A module is instantiated exactly once per resolved path and cached across requiring sites, ensuring consistent binding sharing."
      :failureCode "ERR_MULTIPLE_INSTANTIATION"
      :exitCode 1)
    (:semantic :id syntaxObjectSourceLocation
      :rule "The reader attaches source file, line, column, and span to every form as a syntax object; the evaluator preserves them through binding and application, and every diagnostic quotes the position of the responsible form."
      :failureCode "ERR_MISSING_SOURCE_LOCATION"
      :exitCode 1)
    (:semantic :id dualPositionDiagnostic
      :rule "An error inside a function called from another module quotes both the definition site and the call site rather than truncating to one of them."
      :failureCode "ERR_TRUNCATED_ERROR_SITE"
      :exitCode 1)
    (:semantic :id syntaxPositionPreservation
      :rule "Syntax object position metadata survives higher-order function passing, ensuring static analysis and runtime error reporting identify the same source line for the same defect."
      :failureCode "ERR_SYNTAX_POSITION_LOST"
      :exitCode 1)
    (:semantic :id sourceLocationPreservation
      :rule "Every parsed S-expression form carries source location metadata (source path, line number, column, and span) through reading, macro expansion, and evaluation, mirroring Racket syntax objects."
      :failureCode "ERR_SOURCE_LOCATION_MISSING"
      :exitCode 1)
    (:semantic :id diagnosticPositionQuoting
      :rule "Compiler and runtime error diagnostics quote the exact source, line, and column of the responsible form rather than detached downstream call sites."
      :failureCode "ERR_UNLOCATED_DIAGNOSTIC"
      :exitCode 1)
    (:semantic :id contractBlameAttribution
      :rule "Function and module boundaries carry contracts with blame: a violated precondition blames the caller, a violated postcondition blames the definition, and deferred checks are reported as unchecked rather than satisfied."
      :failureCode "ERR_CONTRACT_BLAME_VIOLATION"
      :exitCode 1)
    (:semantic :id racketReferenceBoundary
      :rule "Racket is an architectural and semantic reference design and optional development-time differential oracle, but is strictly excluded from deployed runtime dependencies."
      :failureCode "ERR_FORBIDDEN_DEPLOYMENT_DEPENDENCY"
      :exitCode 1)
    (:semantic :id zeroExtensionKnowledgeInCore
      :rule "The core reader, evaluator, and host contain zero names of any extension package, product, directory, or domain; resolution occurs strictly via the declared module graph."
      :failureCode "ERR_CORE_EXTENSION_CONTAMINATION"
      :exitCode 1)
    (:semantic :id syntaxExtensionHygienic
      :rule "Libraries define domain syntactic forms hygienically without engine modification; macro expansion preserves source positions and prevents accidental binding capture."
      :failureCode "ERR_UNHYGIENIC_EXPANSION"
      :exitCode 1)
    (:semantic :id domainAsLibrary
      :rule "Database, view, and query syntax constructs are authored as libraries over core syntax extension rather than embedded in the core evaluator."
      :failureCode "ERR_DOMAIN_VOCABULARY_IN_CORE"
      :exitCode 1)
    (:semantic :id interchangeableEngineInterface
      :rule "The language specification names zero concrete engines; execution relies on one host interface satisfied by at least two conforming engines running one unchanged suite."
      :failureCode "ERR_CONCRETE_ENGINE_COUPLING"
      :exitCode 1)
    (:semantic :id extensionDeclaredCapabilities
      :rule "An extension declares the host capabilities it requires; loading against a host that lacks a declared capability fails at load-time, naming both extension and capability."
      :failureCode "ERR_UNSATISFIED_HOST_CAPABILITY"
      :exitCode 1)
    (:semantic :id twoStrikesAdapterAdmission
      :rule "Data and view adapters reside in extension packages; no shared interface is extracted before observing two concrete implementations with identical semantic contracts."
      :failureCode "ERR_PREMATURE_GENERALIZATION"
      :exitCode 1)
    (:semantic :id unidirectionalDependencyDirection
      :rule "Dependency direction is strictly unidirectional: extensions depend on core surfaces, and core modules never depend on extensions or require specific extensions to be present."
      :failureCode "ERR_INVERTED_CORE_DEPENDENCY"
      :exitCode 1)
    (:semantic :id measuredTokenCostSelectionRule
      :rule "Among candidate names that carry intended meaning, take the measured minimum token count; length, devowelling, and family uniformity are explicitly refuted as selection criteria."
      :failureCode "ERR_SPECULATIVE_NAME_CHOICE"
      :exitCode 1)
    (:semantic :id symbolAdmissionMeasuredCostRule
      :rule "No symbol enters the grammar unmeasured: every symbol record must declare measured token count and considered alternatives; checks recompute counts rather than trusting declarations."
      :failureCode "ERR_UNMEASURED_SYMBOL_ADMISSION"
      :exitCode 1)
    (:semantic :id closedSetSingleTokenKeywordRule
      :rule "The closed set of core forms and keywords must measure one token throughout under the production tokenizer; the open set of compound names adopts the measured minimum CamelCase spelling."
      :failureCode "ERR_MULTI_TOKEN_CLOSED_KEYWORD"
      :exitCode 1)
  ]
)
