(:languageSemantics :v 1 :src ADR-0081
  :summary "Canonical language semantics contract for module imports, symbol resolution, and evaluator failures."
  :semantics [
    (:semantic :id moduleImportResolution
      :rule "Module imports resolve relative to the outermost monorepo workspace root."
      :failureCode "ERR_UNRESOLVED_IMPORT"
      :exitCode 1)
    (:semantic :id duplicateModule
      :rule "Duplicate module declarations across multiple source files fail loudly."
      :failureCode "ERR_DUPLICATE_MODULE"
      :exitCode 1)
    (:semantic :id unknownSymbolFailure
      :rule "Evaluation of unbound symbols or missing definitions produces loud typed errors and non-zero exit code."
      :failureCode "ERR_UNBOUND_SYMBOL"
      :exitCode 1)
    (:semantic :id aliasCollision
      :rule "Duplicate module import aliases within a single module trigger loud failure."
      :failureCode "ERR_ALIAS_COLLISION"
      :exitCode 1)
    (:semantic :id booleanTestResults
      :rule "Test entry points (run-tests, run-wire-tests, main, test-*) must strictly return boolean true."
      :failureCode "ERR_TEST_RESULT_NOT_TRUE"
      :exitCode 1)
    (:semantic :id assertionSiteAccounting
      :rule "Distinct assertion sites are accounted stably by AST node location separately from dynamic execution counts."
      :failureCode ""
      :exitCode 0)
    (:semantic :id predicateNaming
      :rule "A predicate ends in a question mark (?) and must never begin with is or is- (e.g. empty?, not is-empty or is-empty?)."
      :failureCode "ERR_RETIRED_PREDICATE_FORM"
      :exitCode 1)
    (:semantic :id constructorNaming
      :rule "A constructor is make followed by the type or construct name (e.g. make-node, not create-node, build-node, or new-node)."
      :failureCode "ERR_RETIRED_CONSTRUCTOR_FORM"
      :exitCode 1)
    (:semantic :id conversionNaming
      :rule "A type conversion is source-to-target (e.g. int-to-string, not int-from-string, to-string, or as-string)."
      :failureCode "ERR_RETIRED_CONVERSION_FORM"
      :exitCode 1)
    (:semantic :id expensiveBuiltinsRenamed
      :rule "The 14 measured expensive multi-token builtins (including string-contains?, string-starts-with?, string-from-int64, string-replace, list-length) are renamed to their shortest unambiguous form; usage of retired spellings fails loudly."
      :failureCode "ERR_RETIRED_BUILTIN"
      :exitCode 1)
    (:semantic :id zeroCompatibilityAliases
      :rule "Retired built-in identifiers must be completely removed with zero backward-compatibility aliases left behind, preventing fragmented parallel spellings."
      :failureCode "ERR_RETIRED_ALIAS"
      :exitCode 1)
    (:semantic :id assertionParityAcrossTransformations
      :rule "Executed assertion counts must remain exactly preserved and non-vacuous across mechanical CamelCase and identifier renames; any silent unbinding or assertion loss triggers loud failure."
      :failureCode "ERR_UNBOUND_IDENTIFIER_MUTATION"
      :exitCode 1)
    (:semantic :id stringLiteralPreservation
      :rule "Mechanical identifier renames and CamelCase transformations must strictly preserve string literals without rewriting substrings within quotes."
      :failureCode "ERR_MUTATED_STRING_LITERAL"
      :exitCode 1)
    (:semantic :id legibleAliasLength
      :rule "Module import aliases must be legible and at least three characters in length; single- and two-character aliases are rejected."
      :failureCode "ERR_OPAQUE_ALIAS"
      :exitCode 1)
    (:semantic :id globalPrefixUniqueness
      :rule "A qualified prefix must unambiguously map to exactly one module across the whole monorepo; binding one prefix to two different modules is rejected."
      :failureCode "ERR_AMBIGUOUS_PREFIX"
      :exitCode 1)
    (:semantic :id selfContainedSliceResolution
      :rule "Qualified uses in retrieved slices must resolve unambiguously from the prefix without requiring file headers to be read."
      :failureCode "ERR_UNRESOLVED_QUALIFIED_USE"
      :exitCode 1)
  ]
)
