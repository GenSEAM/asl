(:rules :v 10 :src D81 :wsSrc ".asl/rules.asn" :basis ".asl/mem/principles.asn" :glossary ".asl/mem/principles.asn :glossary"
  :form "a rule is a goal, the question that refutes it, and its check; :invariant only where :enforcedBy exits non-zero on violation; :core true loads every session; :when lists phases, absent means all"
  (:rule :id ssot :force :invariant :core true
    :do "rules live only in asl/grammar/rules.asn and, when present, the workspace rules file named by :wsSrc; every other surface is a rendering of their union"
    :refute "does any rendered surface differ from the union of rules.asn and the workspace file, when present?"
    :enforcedBy "./scripts/install.sh --check-rules" :basis (DocumentationThatMisdirectsIsWorseThanNone))
  (:rule :id syntax :force :invariant :core true
    :do "every tracked ASL and ASN file has balanced delimiters"
    :refute "is any tracked .asl or .asn file unbalanced?"
    :enforcedBy "./bin/asl audit consistency" :basis (FailLoudlyAndInThePlaceResponsible))
  (:rule :id semantics :force :invariant :core true
    :do "every gate suite executes more than zero assertions and declared assertions equal executed ones and no assertion condition is constant (D152); a violation is red unless listed with its digest in .asl/mem/knownRed.asn, which only shrinks"
    :refute "does a suite pass with zero executed assertions, or declare one it never reaches?"
    :enforcedBy "./bin/asl audit gates --full --sync" :basis (AGateThatCannotFailIsNotAGate GroundTruthOverReport))
  (:rule :id evaluator :force :orientation :when (implement grade)
    :do "goal of phase R1: imports bind, an unknown symbol is an error, zero truthiness, and a test passes only by returning true"
    :refute "does an unbound symbol exit 0, (if 0 1 2) yield 1, or a false-returning test pass?"
    :enforcedBy :none :basis (DeclaredIsNotWorking))
  (:rule :id dialect :force :orientation :when (implement)
    :do "ASN and ASL converge on parens only, camelCase keywords and symbols, single-line wire frames"
    :refute "how many bracket and brace opens remain outside strings?"
    :enforcedBy :none :basis (D140 StructuralTaxIsNotOverhead))
  (:rule :id tools :force :affordance :when (scout plan implement)
    :do "asl forms, catalogued by (:tools), pay on large files, symbol lookups and edits that must land together, and on a small file native tools cost about the same; in a project being ported to ASL foreign code is reasoned as ASL and lowered to native diffs, and in any other project it keeps its own patterns and tools; host C stays at the ASL-first floor"
    :refute "was a large file read whole, or a symbol edit across files made by hand, where an asl form gave the same for less?"
    :enforcedBy :none :basis (CoreKnowsNoExtension))
  (:rule :id capabilities :force :affordance
    :do "asl/grammar/capabilities.asn marks each capability works, partial, absent or lies, with a fallback; an absent one is replaced by its fallback and the report says so"
    :refute "was a fallback result presented as the capability itself?"
    :enforcedBy :none :basis (DeclaredIsNotWorking))
  (:rule :id output :force :orientation :core true
    :do "receipts are ASN; receipts, commands and patches address code by path and symbol or content anchor; evidence and constraints stay whole"
    :refute "does a receipt, command or patch rely on a line number, or was evidence dropped?"
    :enforcedBy :none :basis (OutputStatesOnlyWhatWasComputed FailLoudlyAndInThePlaceResponsible))
  (:rule :id context :force :orientation :when (scout implement)
    :do "reads load by symbol and bounded slice, the prefix stays byte-stable, independent forms share a batch, compaction shortens structure and keeps whole words"
    :refute "was a whole file loaded where a slice would do, or a word shortened?"
    :enforcedBy :none :basis (ReadBySymbolAndSlice CompressStructureNeverSpelling))
  (:rule :id names :force :orientation :when (implement)
    :do "camelCase whole words; among names that carry the meaning, the measured cheapest wins"
    :refute "was a name chosen by length or looks over meaning and measured cost?"
    :enforcedBy :none :basis (MeasuredCostDecidesTheName CamelCaseCorpusSaving))
  (:pack :id architecture
    :outcomes ("minimal causal surface" "one-way dependency DAG" "host independence")
    :affordances ("./bin/asl audit consistency" "./bin/asl audit foreign")))
