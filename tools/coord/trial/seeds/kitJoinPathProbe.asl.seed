(module asl-utils/tests/kitJoinPathProbe
  :x [runTests]
  :i [(asl-utils/kit :a kit)])

fn ! runTests -> Bool
  (do (assert (= (kit/joinPath "a" "b") "a/b") "joinPath joins two parts with one slash")
      (assert (= (kit/joinPath "a/" "b") "a/b") "joinPath does not add a second slash when the left part already ends in one")
      true)
