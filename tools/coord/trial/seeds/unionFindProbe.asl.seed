(module asl-utils/tests/unionFindProbe
  :x [runTests]
  :i [(asl-utils/unionFind :a uf)])

fn ! runTests -> Bool
  (let [(m (uf/union (uf/union (mapEmpty) 1 2) 2 3))]
    (do (assert (uf/same? m 1 3) "one and three are joined through two")
        (assert (not (uf/same? (uf/union (mapEmpty) 1 2) 1 9)) "nine is not joined by an unrelated union")
        true))
