(module asl-tools/coord/tests/vacuousRetryTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/fleet/run :a fr) (asl-tools/coord/tests/fixtures/pipeFix :a pf) (asl-tools/vcs/vcs :a v)])

; (:m :ref COND-VACUOUS-GATE-ROWS :do "the vacuous retry is not repeated on the state that gave the verdict: a write that ends vacuousGate leaves runs/UNIT-vacuous.txt with the gate, the base head and the branch head, and transientWhy! gives vacuous for a blocked unit with commits past its base only while those differ, so a retry on the same gate, base and tree is refused and a new commit or a moved base allows it again")
fn ctxOf dir: String -> cd/Ctx
  (cd/Ctx :dir dir :holder "vacuousRetryTest" :ttlMs 600000 :maxWait 0 :maxSame 3 :stageSec 60 :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "/usr/bin/true")) :pace (cd/fixedPace 8 8))

fn resOf sig: String -> cd/Res
  (cd/Res :tiers "" :ok 0 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig sig :ms 0 :exit 0 :asserts 0 :verdict "")

fn ! runTests -> Bool
  (let [(root (pf/scratch "vacuousRetry" "w"))
        (_ (pf/cleanup root))
        (repo (pf/repoIn root))
        (store (str root "/store"))
        (u (pf/unitIn "V1" "g"))
        (wt (pf/seedUnit! root u "writing" "impl.txt"))
        (_ (fileWrite (cd/repoPath store) repo))
        (_ (fileWrite (cd/worktreesPath store) (str root "/wts")))
        (ctx (ctxOf store))
        (sig "vacuousGate: g")
        (epoch (match (st/claim! store "V1" "vacuousRetryTest" 600000) ((ok t) (match (st/parseLease t) ((ok l) l.epoch) ((err _) 0))) ((err _) 0)))
        (cw (with (pf/cuIn "V1" "writing" wt "sh/V1") :epoch epoch :launched 1))
        (_ (cd/writeCUnit! store cw))
        (_ (cd/finish! ctx u cw (resOf sig)))
        (afterFinish (cd/transientWhy! ctx u (with cw :st "blocked" :sig sig) (list) 0))
        (markRaw (stringTrim (resultOr (fileReadString (cd/vacuousMarkPath store "V1")) "")))
        (blockedFirst (with cw :st "blocked" :sig sig))
        (_ (ok? (pathRemove (cd/vacuousMarkPath store "V1"))))
        (noMark (cd/transientWhy! ctx u blockedFirst (list) 0))
        (_ (cd/vacuousMark! ctx u blockedFirst))
        (same (cd/transientWhy! ctx u blockedFirst (list) 0))
        (key (cd/vacuousKey! ctx u blockedFirst))
        (parts (stringSplit key " | "))
        (gate (optionOr (listGet parts 0) ""))
        (base (optionOr (listGet parts 1) ""))
        (head (optionOr (listGet parts 2) ""))
        (_ (fileWrite (str wt "/more.txt") "more\n"))
        (movedHead (v/commit! wt wt (list "more.txt") "(:c :a t :do \"more\" :g none :ev (V1))" "warn"))
        (newCommit (cd/transientWhy! ctx u blockedFirst (list) 0))
        (_ (cd/vacuousMark! ctx u blockedFirst))
        (sameAgain (cd/transientWhy! ctx u blockedFirst (list) 0))
        (_ (fileWrite (str repo "/b.txt") "b\n"))
        (movedBase (v/commit! repo repo (list "b.txt") "(:c :a t :do \"base\" :g none :ev (V1))" "warn"))
        (baseMoved (cd/transientWhy! ctx u blockedFirst (list) 0))
        (_ (cd/vacuousMark! ctx u blockedFirst))
        (_ (fileWrite (cd/vacuousMarkPath store "V1") (str "other gate | " (optionOr (listGet (stringSplit (cd/vacuousKey! ctx u blockedFirst) " | ") 1) "") " | " (optionOr (listGet (stringSplit (cd/vacuousKey! ctx u blockedFirst) " | ") 2) "") "\n")))
        (gateMoved (cd/transientWhy! ctx u blockedFirst (list) 0))
        (_ (pf/cleanup root))
        (stubGone (fr/stubRemove!))]
    (do (assert (and (not (stringEmpty? repo)) (not (stringEmpty? wt))) "fixture: repo and a unit worktree with a commit past its base")
        (assert (stringContains? markRaw "g | ") (str "the vacuous finish leaves the gate, base head and branch head: " markRaw))
        (assert (= afterFinish "") (str "the same state after the vacuous verdict is not retried: " afterFinish))
        (assert (= noMark "vacuous") (str "with no record the vacuous retry is as before: " noMark))
        (assert (= same "") (str "the recorded gate, base and tree are not retried: " same))
        (assert (= newCommit "vacuous") (str "a branch head other than the recorded one allows the retry: " newCommit))
        (assert (and (= movedHead.code 0) (= movedBase.code 0)) "fixture: the branch head and the base head really moved")
        (assert (= sameAgain "") (str "the new state, once recorded, is not retried: " sameAgain))
        (assert (= gateMoved "vacuous") (str "another gate allows the retry: " gateMoved))
        (assert (and (= (listLength parts) 3) (and (= gate "g") (and (not (stringEmpty? base)) (not (stringEmpty? head))))) (str "the key is gate, base head and branch head: " key))
        (assert (= baseMoved "vacuous") (str "a base head other than the recorded one allows the retry: " baseMoved))
        (assert stubGone "the stand-in host dir of this run is removed")
        true))
