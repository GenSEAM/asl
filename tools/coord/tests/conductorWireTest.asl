(module asl-tools/coord/tests/conductorWireTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/reviewStage :a rs) (asl-tools/coord/ladder :a l) (asl-tools/coord/store :a st)
      (asl-tools/coord/conductorService :a cs) (asl-json/json :a j) (aslGateway/subPace :a sp) (aslGateway/localTime :a lt) (asl-tools/fleet/run :a fr) (aslAgent/gateIntegrity :a gi) (aslAgent/gates :a ag) (asl-tools/coord/worktree :a w) (asl-tools/coord/stall :a stl)])

; (:m :ref COND3 :do "fakes only: gateway text, lane table, subscription text and a fake model call; no ~/.asl read, no network, store dirs are scratch dirs under this worktree's .asl/cache")
fn ! scratch name: String -> String
  (str (resultOr (realPath ".") ".") "/.asl/cache/conductorWireTest-" (stringFromInt64 (procSelf)) "-" name)

fn ! cleanup dir: String -> Unit
  (let [(_ (fr/runOneLimited (fr/job (list "rm" "-rf" dir) "." (fr/childEnv (list))) (fr/limits 60 4)))] ())

fn gatewayText -> String
  (str "(:gateway :v 2 :models ("
       "(:model :id flashLow :provider agy :name \"g\") (:model :id orNemotronUltraFree :provider openrouter :name \"n\") (:model :id ocLongcat :provider okSub :name \"l\")"
       "(:model :id ocDeepseekFlash :provider midSub :name \"d\") (:model :id kmK31Pro :provider kimiCode :name \"k\") (:model :id zzNewModel :provider x :name \"z\")))")

fn lanesText unknown: String -> String
  (str "(:reviewLanes :v 1 :familyExtra \"(:f :match km :family moonshot)\" :unknown (" unknown ") :lanes ("
       "(:lane :alias flashLow :tier free :quality 0 :allowance 5) (:lane :alias orNemotronUltraFree :tier free :quality 0 :allowance 3)"
       "(:lane :alias ocLongcat :tier free :quality 0 :allowance 3) (:lane :alias ocDeepseekFlash :tier paid :quality 0 :allowance 5)"
       "(:lane :alias kmK31Pro :tier strong :quality 0 :allowance 3)))")

fn subsText used: String -> String
  (str "(:subscriptions :v 1 :updated \"2026-10-28\" :src \"fixture\"\n"
       "  (:sub :id midSub :renews \"2026-11-13\" :windows ((:monthly :resets \"2026-11-13\" :usedPercent " used " :src opencodeApi :at \"2026-10-28 11:50\")))\n"
       "  (:sub :id okSub :renews \"2026-11-13\" :windows ((:monthly :resets \"2026-11-13\" :usedPercent 20 :src opencodeApi :at \"2026-10-28 11:50\"))))\n")

fn ! pacesAt used: String -> (List sp/SubPace)
  (sp/paceSubs (lt/utcZone) (subsText used) "" (sp/parseTimeMs "2026-10-28 12:00"))

fn ! realCfgIn home: String lanes: String -> cd/RealCfg
  (cd/realCfg (list "--repo" "." "--home" home "--lanes" lanes) home)

; (:m :ref COND3 :do "coverage refusal: an alias with no family that the lane table does not list unknown is a startup problem; listing it clears the problem; a lane naming a missing alias or an alias without family is a problem; the run command refuses to start and exits 1")
fn ! testCoverage -> Bool
  (let [(refused (rs/startupProblems (gatewayText) (lanesText "")))
        (cleared (rs/startupProblems (gatewayText) (lanesText "zzNewModel")))
        (noKm (rs/startupProblems (gatewayText) (stringReplace (lanesText "zzNewModel") "(:f :match km :family moonshot)" "")))
        (badLane (rs/startupProblems (gatewayText) (stringReplace (lanesText "zzNewModel") "alias ocLongcat " "alias noSuchAlias ")))
        (home (scratch "home"))
        (_ (cleanup home))
        (_ (dirCreate (str home "/.asl")))
        (_ (fileWrite (str home "/.asl/gateway.asn") (gatewayText)))
        (_ (fileWrite (str home "/lanes.asn") (lanesText "")))
        (viaCfg (cd/startupProblemsFor (realCfgIn home (str home "/lanes.asn"))))
        (run (fr/runOneLimited (fr/job (list (fr/nativeCli!) "run" "asl/tools/coord/conductor.asl" "run" "--store" (str home "/store") "--repo" "." "--home" home "--lanes" (str home "/lanes.asn") "--refresh-min" "600") "." (fr/childEnv (list)))
                                   (fr/limits 150 64)))
        (_ (cleanup home))]
    (do (assert (stringContains? (stringJoin refused "|") "zzNewModel: no family and not listed unknown") (str "unlisted unknown alias is a problem: " (stringJoin refused "|")))
        (assert (listEmpty? cleared) (str "listing it unknown clears it: " (stringJoin cleared "|")))
        (assert (stringContains? (stringJoin noKm "|") "kmK31Pro") (str "without the km family row kmK31Pro has no family: " (stringJoin noKm "|")))
        (assert (stringContains? (stringJoin badLane "|") "noSuchAlias: not a gateway alias") (str "a lane must be a gateway alias: " (stringJoin badLane "|")))
        (assert (stringContains? (stringJoin viaCfg "|") "zzNewModel") "startupProblemsFor reads the home's gateway.asn and the lane file")
        (assert (and (= run.exit 1) (stringContains? run.out ":refuse")) (str "run refuses to start: exit " (stringFromInt64 run.exit) " " run.out))
        true))

; (:m :ref COND3 :do "allowances come from subPace: midSub at 58 percent is over its pace, at 20 it is under; a lane on okSub is under pace; the lane without a subscription keeps its default; a raised allowance is a rising lane")
fn ! testAllowance -> Bool
  (let [(over (rs/allowanceMap (gatewayText) (lanesText "zzNewModel") (pacesAt "58")))
        (under (rs/allowanceMap (gatewayText) (lanesText "zzNewModel") (pacesAt "20")))
        (get (fn [(m (List (Pair String Int64))) (a String)] -> Int64 (pairSecond (optionOr (listFind (fn [(p (Pair String Int64))] -> Bool (= (pairFirst p) a)) m) (pair "" -1)))))
        (rising (rs/risingLanes over under))
        (flat (rs/risingLanes under under))]
    (do (assert (< (get over "ocDeepseekFlash") (get under "ocDeepseekFlash")) (str "midSub over pace gives fewer calls than under pace: " (stringFromInt64 (get over "ocDeepseekFlash")) " vs " (stringFromInt64 (get under "ocDeepseekFlash"))))
        (assert (> (get under "ocLongcat") 0) "okSub lane has allowance")
        (assert (= (get over "flashLow") 5) "a lane whose provider has no usable subscription keeps its default")
        (assert (= rising (list "ocDeepseekFlash")) (str "only the lane whose allowance rose is rising: " (stringJoin rising ",")))
        (assert (listEmpty? flat) "an unchanged allowance wakes nothing")
        true))

fn ! park dir: String id: String lane: String await: String -> Unit
  (let [(_ (cd/writeCUnit! dir (cd/CUnit :id id :st "awaitReview" :lane lane :fails 0 :sig "" :waited 0 :parked 1 :epoch 0 :branch "" :wt "" :model "" :tokens 0 :costMicro 0 :esc 0 :launched 0 :await await)))] ())

fn ! snapAfter marker: String -> (fn [] -> (List (Pair String Int64)))
  (fn [] -> (List (Pair String Int64))
    (if (fileExists? marker) (list (pair "kmK31Pro" 5) (pair "ocDeepseekFlash" 0) (pair "strong" 5) (pair "paid" 0))
      (list (pair "kmK31Pro" 0) (pair "ocDeepseekFlash" 0) (pair "strong" 0) (pair "paid" 0))))

; (:m :ref COND3 :do "wake on refresh: a refresh that raises kmK31Pro and the strong tier wakes the units parked on either and leaves a unit parked on a lane that did not rise; a second refresh that changes nothing wakes nobody; the refresh itself is called exactly once per round")
fn ! testRefreshWake -> Bool
  (let [(dir (scratch "wake"))
        (_ (cleanup dir))
        (_ (dirCreate dir))
        (_ (park dir "P1" "review" "kmK31Pro")) (_ (park dir "P2" "review" "strong")) (_ (park dir "P3" "review" "ocDeepseekFlash"))
        (marker (str dir "/refreshed"))
        (ctx (cd/Ctx :dir dir :holder "t" :ttlMs 1000 :maxWait 5 :maxSame 3 :stageSec 5 :maxDesc 5
                     :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list)) :pace (cd/fixedPace 1 1)))
        (calls (str dir "/calls"))
        (refresh (fn [] -> Unit (let [(_ (fileWrite marker "1")) (_ (fileAppend calls "r\n"))] ())))
        (woken (cd/refreshWake! ctx (snapAfter marker) refresh))
        (parkedAfter (map (fn [(id String)] -> Int64 (let [(c (optionOr (listFind (fn [(x cd/CUnit)] -> Bool (= x.id id)) (cd/readCUnits! dir)) (cd/CUnit :id "" :st "" :lane "" :fails 0 :sig "" :waited 0 :parked -1 :epoch 0 :branch "" :wt "" :model "" :tokens 0 :costMicro 0 :esc 0 :launched 0 :await "")))] c.parked)) (list "P1" "P2" "P3")))
        (again (cd/refreshWake! ctx (snapAfter marker) refresh))
        (refreshes (resultOr (fileReadString calls) ""))
        (_ (cleanup dir))]
    (do (assert (= woken 2) (str "two units woken: " (stringFromInt64 woken)))
        (assert (= parkedAfter (list 0 0 1)) (str "P1 and P2 unparked, P3 still parked: " (stringJoin (map stringFromInt64 parkedAfter) ",")))
        (assert (= again 0) "a refresh that changes nothing wakes nobody")
        (assert (= refreshes "r\nr\n") (str "refresh called once per round: " refreshes))
        true))

fn passCall alias: String prompt: String -> (Result String String)
  (ok "(:verdict :pass :defects () :model m)")

fn ! unit -> l/ReviewUnit
  (l/ReviewUnit :id "U1" :task "doc line" :risk "low" :closureChanged false :writerAlias "flashHigh" :writerChannel "agy" :startRung "" :fixesUsed 0 :prior (list))

; (:m :ref COND3 :do "the ladder through the stage wiring with a fake model call: with a red-before receipt two free lanes of two families merge; without a redBefore row it does not merge; with every free lane out of allowance the ruling awaits and carries the lane to wake")
fn ! testLadderWiring -> Bool
  (let [(good "(:receipt U1 :gates ((:gate g :exit 0 :executed 3)) :redBefore ((:gate g :exit 1 :executed 0)))")
        (bad "(:receipt U1 :gates ((:gate g :exit 0 :executed 3)))")
        (call (fn [(a String) (p String)] -> (Result String String) (passCall a p)))
        (merged (rs/reviewUnit! (gatewayText) (lanesText "zzNewModel") (pacesAt "20") "." "/nonexistent" (unit) "+ a" good call))
        (nored (rs/reviewUnit! (gatewayText) (lanesText "zzNewModel") (pacesAt "20") "." "/nonexistent" (unit) "+ a" bad call))
        (zero (stringReplace (lanesText "zzNewModel") ":allowance 5" ":allowance 0"))
        (zeroFree (stringReplace (stringReplace (stringReplace zero ":alias orNemotronUltraFree :tier free :quality 0 :allowance 3" ":alias orNemotronUltraFree :tier free :quality 0 :allowance 0") ":alias ocLongcat :tier free :quality 0 :allowance 3" ":alias ocLongcat :tier free :quality 0 :allowance 0") "x" "x"))
        (awaiting (rs/reviewUnit! (gatewayText) zeroFree (list) "." "/nonexistent" (unit) "+ a" good call))]
    (do (assert (match merged ((ok r) (= r.action "merge")) ((err _) false)) (str "two free reviewers pass with a redBefore receipt: " (match merged ((ok r) r.action) ((err e) e))))
        (assert (match merged ((ok r) (and (stringContains? r.models "+") (not (listEmpty? r.rows)))) ((err _) false)) "two models reviewed and a grade row came back")
        (assert (match nored ((ok r) (!= r.action "merge")) ((err _) true)) "without a redBefore row the ladder does not merge")
        (assert (match awaiting ((ok r) (and (= r.action "await") (not (stringEmpty? r.sig)))) ((err _) false)) (str "out-of-allowance free lanes await and name the lane: " (match awaiting ((ok r) (str r.action " " r.sig)) ((err e) e))))
        (assert (and (= (cd/rulingVerdict "merge") "pass") (= (cd/rulingVerdict "await") "defer")) "ruling maps to review verdicts")
        true))

; (:m :ref COND3 :do "the service unit runs the main worktree's conductor with the store and the dev repo, stops cooperatively and keeps stage children across a restart; the dev repo is cloned only when absent and the clone never touches the source checkout")
fn ! testService -> Bool
  (let [(lay (cs/layoutOf "/h"))
        (u (cs/unitText lay (cs/noConfig)))
        (full (cs/unitText lay (cs/ServiceConfig :lanes "/l.asn" :profile "strong" :keys "/k.asn" :ledger "/led" :ledgerBase "main")))
        (fromRow (cs/configOf (list "install" "--profile" "q") "(:conductorService :lanes \"/a.asn\" :profile \"p\" :ledgerBase \"origin/main\")"))
        (noRow (cs/configOf (list "install") "garbage ("))
        (root (scratch "svc"))
        (_ (cleanup root))
        (_ (dirCreate (str root "/asex-dev/.git")))
        (have (cs/devRepoSteps (cs/Layout :home root :repo (str root "/wt/main") :devRepo (str root "/asex-dev") :store (str root "/s") :source (str root "/asex"))))
        (_ (cleanup root))
        (missing (cs/devRepoSteps lay))]
    (do (assert (stringContains? u "ExecStart=/usr/bin/nice -n 10 /h/wt/main/bin/asl run asl/tools/coord/conductor.asl run --store /h/.asl/run/conductor --repo /h/wt/main --dev-repo /h/asex-dev --dev dev") (str "ExecStart: " u))
        (assert (stringContains? u "ExecStop=/h/wt/main/bin/asl run asl/tools/coord/conductor.asl stop --store /h/.asl/run/conductor") "ExecStop writes the stop file")
        (assert (and (stringContains? u "KillMode=process") (stringContains? u "Restart=always") (stringContains? u "WantedBy=default.target")) "service keeps children and restarts")
        (assert (stringContains? u "--dev dev\nExecStop=") "no config values: ExecStart ends at --dev dev as before")
        (assert (and (stringContains? full " --lanes /l.asn") (stringContains? full " --profile strong") (stringContains? full " --keys /k.asn") (stringContains? full " --ledger /led") (stringContains? full " --ledger-base main") (stringContains? full " --dev dev --lanes /l.asn --profile strong --keys /k.asn --ledger /led --ledger-base main\nExecStop=")) (str "all four values and the base reach ExecStart: " full))
        (assert (and (= fromRow.lanes "/a.asn") (= fromRow.profile "q") (= fromRow.keys "") (= fromRow.ledgerBase "origin/main")) "config row fills, an install flag overrides it")
        (assert (= noRow (cs/noConfig)) "an unreadable config row means no values")
        (assert (listEmpty? have) "an existing dev repo is not cloned again")
        (assert (= (map (fn [(s (List String))] -> String (stringJoin s " ")) missing) (list "git clone --quiet /h/asex /h/asex-dev" "git -C /h/asex-dev checkout --quiet -b dev origin/main")) "a missing dev repo is cloned from the source and branched dev")
        true))

; (:m :ref COND3 :do "failure signatures ignore ids: the same agent failure with two session ids has one key (so three such failures escalate, found by the VPS e2e where each retry had a fresh session id), a different failure has another")
fn testSigKey -> Bool
  (let [(a (cd/sigKey "(:agent :status :failed :session \"549dd31a29a9e6d1\" :journal \".asl/run/agentLoop/549dd31a29a9e6d1.journal\")"))
        (b (cd/sigKey "(:agent :status :failed :session \"0ca65e792b00a908\" :journal \".asl/run/agentLoop/0ca65e792b00a908.journal\")"))
        (c (cd/sigKey "(:agent :status :failed :session \"0ca65e792b00a908\" :reason timeout)"))]
    (do (assert (= a b) (str "two session ids, one key: " a " | " b))
        (assert (!= a c) "a different failure has a different key")
        (assert (stringContains? a "agent status failed") (str "the words stay: " a))
        true))

fn ! git dir: String argv: (List String) -> fr/Done
  (fr/runOne (fr/job (listAppend (list "git" "-C" dir) argv) dir (fr/childEnv (list))))

; (:m :ref COND3 :do "a branch sh/UNIT left behind without a worktree is checked out again by the retried write; without the fix the retry fails on the existing branch three times and escalates")
fn ! testAttach -> Bool
  (let [(root (scratch "attach"))
        (repo (str root "/repo"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (_ (dirCreate repo))
        (i (git repo (list "init" "--quiet")))
        (c (git repo (list "-c" "user.name=t" "-c" "user.email=t@t" "commit" "--quiet" "--allow-empty" "-m" "x")))
        (b (git repo (list "branch" "sh/U1")))
        (rc (cd/realCfg (list "--repo" repo "--worktrees" (str root "/wts")) root))
        (u (st/Task :id "U1" :owns (list) :reads (list) :gate "" :channel "free" :model "" :base "HEAD" :after (list) :st "queued" :epoch 0 :receipt ""))
        (r (cd/attachOrAdd rc u (str root "/wts/U1")))
        (_ (cleanup root))]
    (do (assert (ok? r) (str "attach existing branch: " r))
        true))

; (:m :ref COND3 :do "a worktree directory deleted behind git's back leaves a registration; the retried write prunes it and attaches again instead of failing on 'missing but already registered'")
fn ! testAttachMissing -> Bool
  (let [(root (scratch "attachMissing"))
        (repo (str root "/repo"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (_ (dirCreate repo))
        (i (git repo (list "init" "--quiet")))
        (c (git repo (list "-c" "user.name=t" "-c" "user.email=t@t" "commit" "--quiet" "--allow-empty" "-m" "x")))
        (rc (cd/realCfg (list "--repo" repo "--worktrees" (str root "/wts")) root))
        (u (st/Task :id "U1" :owns (list) :reads (list) :gate "" :channel "free" :model "" :base "HEAD" :after (list) :st "queued" :epoch 0 :receipt ""))
        (first (cd/attachOrAdd rc u (str root "/wts/x")))
        (gone (fr/runOne (fr/job (list "rm" "-rf" (resultOr first "?")) root (fr/childEnv (list)))))
        (again (cd/attachOrAdd rc u (resultOr first "")))
        (_ (cleanup root))]
    (do (assert (ok? first) (str "first attach: " first))
        (assert (and (= gone.exit 0) (ok? again)) (str "attach after the directory vanished: " again))
        true))

; (:m :ref REPO-HEALTH :do "a unit directory that exists without its own .git (an orphan write recreated it after the repo vanished) is moved aside to base/orphan-ID-MS and the worktree added again; a valid worktree is reused in place")
fn ! testOrphanWt -> Bool
  (let [(root (scratch "orphanWt"))
        (repo (str root "/repo"))
        (wts (str root "/wts"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (_ (dirCreate repo))
        (_ (dirCreate wts))
        (rc (cd/realCfg (list "--repo" repo "--worktrees" wts) root))
        (path (str wts "/" rc.wt.prefix "U1"))
        (_ (dirCreate path))
        (_ (fileWrite (str path "/stray.txt") "stray"))
        (i (git repo (list "init" "--quiet")))
        (c (git repo (list "-c" "user.name=t" "-c" "user.email=t@t" "commit" "--quiet" "--allow-empty" "-m" "x")))
        (u (st/Task :id "U1" :owns (list) :reads (list) :gate "" :channel "free" :model "" :base "HEAD" :after (list) :st "queued" :epoch 0 :receipt ""))
        (r (cd/settleWt! rc root u path))
        (entries (resultOr (dirList wts) (list)))
        (aside (optionOr (listHead (filter (fn [(n String)] -> Bool (stringStartsWith? n "orphan-U1-")) entries)) ""))
        (journal (resultOr (fileReadString (str root "/journal.asn")) ""))
        (valid (cd/worktreeValid? path))
        (again (cd/settleWt! rc root u path))
        (entriesAfter (resultOr (dirList wts) (list)))
        (_ (cleanup root))]
    (do (assert (ok? r) (str "orphan dir replaced by a worktree: " r))
        (assert valid "the unit path is a valid worktree afterwards")
        (assert (not (stringEmpty? aside)) "the orphan dir was moved aside")
        (assert (stringContains? journal "(:orphan :unit \"U1\"") (str "orphan journaled: " journal))
        (assert (ok? again) (str "valid worktree reused: " again))
        (assert (= (listLength entriesAfter) (listLength entries)) "a valid worktree is not moved aside")
        true))

; (:m :ref COND-TASK-SPEC :do "the writer's brief carries each owned path's state at claim (missing: create it with one write; the module name of an asl-utils unit is asl-utils/NAME) and loses the size advice when a file is missing; the stored task text stays as it was")
fn ! testBriefTask -> Bool
  (let [(root (scratch "briefTask"))
        (wt (str root "/wt"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (_ (dirCreate (str root "/tasks")))
        (_ (dirCreate wt))
        (_ (dirCreate (str wt "/asl")))
        (_ (fileWrite (str root "/tasks/U1.txt") "Build it.\nSMALL EDITS ONLY in large files.\nGate: x"))
        (_ (fileWrite (str wt "/asl/have.asl") "(module m)\n(x)"))
        (u (st/Task :id "U1" :owns (list "asl/have.asl" "asl/packages/asl-utils/src/textdiff.asl" "asl/dir/") :reads (list) :gate "" :channel "free" :model "" :base "HEAD" :after (list) :st "queued" :epoch 0 :receipt ""))
        (b (cd/briefTask! wt root u ""))
        (stored (resultOr (fileReadString (str root "/tasks/U1.txt")) ""))
        (_ (cleanup root))]
    (do (assert (stringContains? b "asl/have.asl: exists (2 lines)") (str "existing owned file: " b))
        (assert (stringContains? b "asl/packages/asl-utils/src/textdiff.asl: missing, create it with one write; module asl-utils/textdiff") (str "missing owned file: " b))
        (assert (not (stringContains? b "SMALL EDITS ONLY")) "size advice dropped for the missing file")
        (assert (not (stringContains? b "asl/dir/")) "directory entries are not listed")
        (assert (stringContains? stored "SMALL EDITS ONLY") "the stored task text is untouched")
        true))

; (:m :ref COND-TASK-SPEC :do "the write stage builds the writer's task through briefTask!: a fake Leon run records the task text it is handed; the owned-paths block (exists and missing) is in it and the size advice is not, and the prior note follows; reverting writeResWith's task line to the stored text turns this red")
fn ! testWriteResBrief -> Bool
  (let [(root (scratch "writeBrief"))
        (repo (str root "/repo"))
        (dir (str root "/store"))
        (home (str root "/home"))
        (sh (fn [(c String)] -> String (resultOr (fr/shellOut c 60000) "")))
        (_ (cleanup root))
        (_ (dirCreate root))
        (made (sh (str "mkdir -p " repo " " dir "/tasks " home " && cd " repo " && git init -q -b main && git config user.email t@example.invalid && git config user.name t && mkdir -p asl && printf 'a\\nb\\n' > asl/have.asl && git add -A && git commit -qm a && echo madeOk")))
        (rc (cd/realCfg (list "--repo" repo "--home" home "--worktrees" (str root "/wts")) dir))
        (_ (fileWrite (str dir "/tasks/U1.txt") "Build it.\nSMALL EDITS ONLY in large files."))
        (u (st/Task :id "U1" :owns (list "asl/have.asl" "asl/packages/asl-utils/src/textdiff.asl") :reads (list) :gate "" :channel "free" :model "" :base "main" :after (list) :st "queued" :epoch 0 :receipt ""))
        (c (cd/CUnit :id "U1" :st "ready" :lane "free" :fails 0 :sig "" :waited 0 :parked 0 :epoch 0 :branch "" :wt "" :model "" :tokens 0 :costMicro 0 :esc 0 :launched 0 :await ""))
        (seen (str root "/seenTask"))
        (run (fn [(rcx cd/RealCfg) (lane String) (id String) (prof String) (p String) (task String) (owns (List String)) (gates (List String)) (extra String)] -> fr/Done
               (let [(_ (fileWrite seen task))] (fr/Done :idx 0 :exit 0 :out "" :ms 0 :verdict "exit"))))
        (res (cd/writeResWith run rc dir u c))
        (task (resultOr (fileReadString seen) "NOTASK"))
        (_ (cleanup root))]
    (do (assert (stringContains? made "madeOk") "the fixture repo exists")
        (assert (stringContains? task "- asl/have.asl: exists (") (str "existing owned path reaches the writer task: " task))
        (assert (stringContains? task "asl/packages/asl-utils/src/textdiff.asl: missing, create it with one write; module asl-utils/textdiff") (str "missing owned path reaches the writer task: " task))
        (assert (not (stringContains? task "SMALL EDITS ONLY")) (str "size advice stripped from the writer task: " task))
        (assert (= (listLength (stringSplit task "Owned paths at claim")) 2) "exactly one owned-paths block")
        (assert (stringContains? task "Build it.") "the stored task text is still the base of the brief")
        true))

; (:m :ref COND3 :do "a dev clone made by git clone lists origin and the train's audit consistency is red on that (workspaceIsolation), so the VPS merge never passed; the conductor drops the dev repo's remotes before the train")
fn ! testDropRemotes -> Bool
  (let [(root (scratch "dropRemotes"))
        (src (str root "/src"))
        (dev (str root "/dev"))
        (_ (cleanup root))
        (_ (dirCreate src))
        (i (git src (list "init" "--quiet")))
        (c (git src (list "-c" "user.name=t" "-c" "user.email=t@t" "commit" "--quiet" "--allow-empty" "-m" "x")))
        (cl (fr/runOne (fr/job (list "git" "clone" "--quiet" src dev) root (fr/childEnv (list)))))
        (before (stringTrim (git dev (list "remote")).out))
        (n (cd/dropRemotes! dev))
        (after (stringTrim (git dev (list "remote")).out))
        (_ (cleanup root))]
    (do (assert (= before "origin") (str "a clone has origin: " before))
        (assert (and (= n 1) (stringEmpty? after)) (str "no remote after: " after))
        true))

; (:m :ref COND3 :do "spend is wired from the gateway replies: the provider's usage keys (inputTokens, cachedTokens, outputTokens) sum to the review's tokens and Leon's :usage row sums to the write's; both were 0 for every journal row of the VPS e2e")
fn ! testSpend -> Bool
  (let [(usage (list (pair "inputTokens" (j/jint 100)) (pair "cachedTokens" (j/jint 60)) (pair "outputTokens" (j/jint 20))))]
    (do (assert (= (rs/tokenSum usage) 120) (str "review tokens: " (stringFromInt64 (rs/tokenSum usage))))
        (assert (= (cd/leonTokens "(:agent :done true :usage (:input 1000 :cached 400 :output 50) :batching (:turns 2))") 1050) "write tokens from Leon's usage row")
        (assert (= (cd/leonTokens "(:agent :done true)") 0) "no usage row, no spend")
        true))

; (:m :ref COND3 :do "the merge train's env pins ASL_E2E=0 even when the conductor itself runs under ASL_E2E=1")
fn ! testMergeEnv -> Bool
  (let [(env (cd/mergeEnv))]
    (do (assert (listContains? env "ASL_E2E=0") "ASL_E2E=0 is in the train env")
        (assert (not (listContains? env "ASL_E2E=1")) "no inherited ASL_E2E=1")
        true))

; (:m :ref COND4 :do "costUsd comes from the gateway rows' :costMicros per call: a priced alias costs its price per call, any unpriced call makes the cost -1 (the journal prints :priced false and adds 0)")
fn ! testCost -> Bool
  (let [(gw "(:gateway :models ((:model :id paidA :provider p :name \"vendor/a\" :costMicros 1000) (:model :id freeB :provider q :name \"b\" :tier free) (:model :id orNemotronUltraFree :provider r) (:model :id ocDeepseekFlash :provider o)))")
        (prices (rs/costRows gw (lanesText "zz")))
        (priced (rs/usageCost "(:usage :alias paidA :tokens 5 :costMicros 1000)\n(:usage :alias paidA :tokens 5 :costMicros 1000)\n"))
        (mixed (rs/usageCost "(:usage :alias paidA :tokens 5 :costMicros 1000)\n(:usage :alias freeB :tokens 5 :costMicros -1)\n"))]
    (do (assert (= (rs/usageCost "") 0) "no calls cost nothing")
        (assert (= priced 2000) (str "two priced calls: " (stringFromInt64 priced)))
        (assert (= mixed -1) "one unpriced call makes the cost unknown")
        (assert (and (listContains? prices (pair "paidA" 1000)) (listContains? prices (pair "vendor/a" 1000)) (listContains? prices (pair "freeB" 0))) "price rows by id and by name")
        (assert (= (cd/leonCost "(:agent :batching (:turns 4 :ops 5))" prices "vendor/a") 4000) "write cost = turns x price")
        (assert (= (cd/leonCost "(:agent :batching (:turns 4 :ops 5))" prices "b") 0) "a free-tier writer model costs 0, priced")
        (assert (and (listContains? prices (pair "orNemotronUltraFree" 0)) (listContains? prices (pair "ocDeepseekFlash" -1))) "free by the lane table is 0; a paid alias without a price stays unknown")
        (assert (= (cd/leonCost "(:agent)" prices "vendor/a") -1) "no turns is unknown")
        true))

; (:m :ref CONDUCTOR-VACUOUS-GATE :do "a Leon receipt whose :vacuousGates lists the unit gate makes the write vacuous unless the task says the gate is a regression guard")
fn testVacuousWrite -> Bool
  (let [(gate "./bin/asl test a/bTest.asl")
        (out (str "(:agent :status :ok :receipt (:agentReceipt :status :ok :phases (scout) :vacuousGates (\"" gate "\") :usage (:input 1)))"))
        (other "(:agent :status :ok :receipt (:agentReceipt :status :ok :vacuousGates (\"./bin/asl test c/dTest.asl\")))")]
    (do (assert (cd/vacuousWrite? out gate "add a flag") "the gate listed in :vacuousGates is vacuous")
        (assert (not (cd/vacuousWrite? other gate "add a flag")) "another gate listed is not this unit's")
        (assert (not (cd/vacuousWrite? "(:agent :status :ok :receipt (:agentReceipt :status :ok))" gate "add a flag")) "no :vacuousGates, not vacuous")
        (assert (not (cd/vacuousWrite? out gate "keep the gate green: it is a Regression Guard")) "a regression guard task may keep a green gate")
        (assert (not (cd/vacuousWrite? out "" "add a flag")) "no gate, nothing to call vacuous")
        (assert (cd/vacuousSig? (cd/vacuousSig gate)) "the vacuous signature is recognised")
        (assert (not (cd/vacuousSig? "noEdit")) "other write signatures are not")
        true))

fn ! commitFile repo: String file: String text: String msg: String -> Unit
  (let [(_ (fileWrite (str repo "/" file) text))
        (_ (git repo (list "add" file)))
        (_ (git repo (list "-c" "user.name=t" "-c" "user.email=t@t" "commit" "--quiet" "-m" msg)))]
    ())

; (:m :ref COND3 :do "a re-run unit's leftover sh/UNIT with an old base is rebased onto the unit's base when that is clean, and renamed -stale and recreated from the base when it conflicts; the work is never lost")
fn ! testStaleBranch -> Bool
  (let [(root (scratch "stale"))
        (_ (cleanup root))
        (repoA (str root "/a"))
        (repoB (str root "/b"))
        (_ (dirCreate repoA))
        (_ (dirCreate repoB))
        (mk (fn [(r String)] -> String
              (let [(_ (git r (list "init" "--quiet" "-b" "main")))
                    (_ (commitFile r "f.txt" "base\n" "c0"))
                    (_ (git r (list "branch" "sh/U1")))]
                r)))
        (_ (mk repoA))
        (_ (mk repoB))
        (u (st/Task :id "U1" :owns (list) :reads (list) :gate "" :channel "free" :model "" :base "main" :after (list) :st "queued" :epoch 0 :receipt ""))
        (_ (git repoA (list "checkout" "--quiet" "sh/U1")))
        (_ (commitFile repoA "g.txt" "g\n" "old work"))
        (_ (git repoA (list "checkout" "--quiet" "main")))
        (_ (commitFile repoA "h.txt" "h\n" "main moves"))
        (rcA (cd/realCfg (list "--repo" repoA "--worktrees" (str root "/wtsA")) root))
        (ra (cd/attachOrAdd rcA u (str root "/wtsA/x")))
        (pa (resultOr ra ""))
        (ancA (git pa (list "merge-base" "--is-ancestor" "main" "HEAD")))
        (hasG (fileExists? (str pa "/g.txt")))
        (_ (git repoB (list "checkout" "--quiet" "sh/U1")))
        (_ (commitFile repoB "f.txt" "old\n" "old work"))
        (_ (git repoB (list "checkout" "--quiet" "main")))
        (_ (commitFile repoB "f.txt" "main\n" "main edit"))
        (rcB (cd/realCfg (list "--repo" repoB "--worktrees" (str root "/wtsB")) root))
        (rb (cd/attachOrAdd rcB u (str root "/wtsB/x")))
        (pb (resultOr rb ""))
        (ancB (git pb (list "merge-base" "--is-ancestor" "main" "HEAD")))
        (branches (git repoB (list "branch" "--list" "sh/U1-stale-*")))
        (cleanB (git pb (list "status" "--porcelain")))
        (_ (cleanup root))]
    (do (assert (ok? ra) (str "attach A: " ra))
        (assert (and (= ancA.exit 0) hasG) "A: rebased onto main and the old work is kept")
        (assert (ok? rb) (str "attach B: " rb))
        (assert (= ancB.exit 0) "B: recreated from main")
        (assert (stringContains? branches.out "sh/U1-stale-") (str "B: the old branch is kept as -stale: " branches.out))
        (assert (stringEmpty? (stringTrim cleanB.out)) (str "B: no rebase left half done: " cleanB.out))
        true))

; (:m :ref CONDUCTOR-ZERO-MERGE :do "the write-progress check sees only owned changes: driver debris .asl/gatewayProfilePin.asn made a no-op write count as written and its review diff came out empty; an owned file the writer never created must not stop the commit of the one it changed")
fn ! testWriteProgress -> Bool
  (let [(root (scratch "progress"))
        (repo (str root "/r"))
        (_ (cleanup root))
        (_ (dirCreate repo))
        (_ (git repo (list "init" "--quiet" "-b" "main")))
        (_ (git repo (list "config" "user.name" "t")))
        (_ (git repo (list "config" "user.email" "t@t")))
        (_ (commitFile repo "a.txt" "a\n" "c0"))
        (_ (git repo (list "checkout" "--quiet" "-b" "sh/U1")))
        (owns (list "a.txt" "t/newTest.asl"))
        (_ (dirCreate (str repo "/.asl")))
        (_ (fileWrite (str repo "/.asl/gatewayProfilePin.asn") "(:pin :profile free)\n"))
        (debrisOnly (cd/noEdits? repo "main" owns))
        (debrisCommit (cd/commitWrite! repo owns "U1" "m"))
        (countDebris (stringTrim (git repo (list "rev-list" "--count" "main..HEAD")).out))
        (_ (fileWrite (str repo "/a.txt") "a2\n"))
        (changed (cd/ownedChanges! repo owns))
        (edited (cd/noEdits? repo "main" owns))
        (committed (cd/commitWrite! repo owns "U1" "m"))
        (countAfter (stringTrim (git repo (list "rev-list" "--count" "main..HEAD")).out))
        (names (git repo (list "show" "--name-only" "--format=" "HEAD")))
        (_ (git repo (list "checkout" "--quiet" "-b" "sh/U2" "main")))
        (blankBefore (cd/blankSlate? repo "main" owns))
        (_ (commitFile repo "a.txt" "a3\n" "(:c :a wip :do \"unit U2 stopped: leaseLost\" :g none :ev (U2))"))
        (wipOnly (cd/noEdits? repo "main" owns))
        (wipBlank (cd/blankSlate? repo "main" owns))
        (vgate "./bin/asl test a/bTest.asl")
        (vout (str "(:agent :status :ok :receipt (:agentReceipt :status :ok :vacuousGates (\"" vgate "\") :usage (:input 1)))"))
        (vrun (fn [] -> fr/Done (fr/Done :idx 0 :exit 0 :out vout :ms 0 :verdict "exit")))
        (wipVerdict (cd/vacuousAround! repo "main" owns vgate "add a flag" vrun))
        (_ (git repo (list "checkout" "--quiet" "-b" "sh/U3" "main")))
        (blankVerdict (cd/vacuousAround! repo "main" owns vgate "add a flag" vrun))
        (_ (cleanup root))]
    (do (assert (and blankBefore (not wipBlank)) "a branch with a wip commit past its base is not a blank slate, so a green gate there is not vacuous")
        (assert wipOnly "while a wip commit alone is still no landed progress")
        (assert (not (pairSecond wipVerdict)) "a retained wip-only branch with a green gate is not vacuous: it reaches gating")
        (assert (pairSecond blankVerdict) "the same green gate on a blank slate is vacuous")
        (assert (= (pairFirst wipVerdict).exit 0) "the writer's result is passed through")
        (assert debrisOnly "untracked driver debris outside :owns is no edit")
        (assert (not debrisCommit) "nothing owned changed, so no driver commit")
        (assert (= countDebris "0") (str "no commit past base after a debris-only write: " countDebris))
        (assert (= changed (list "a.txt")) (str "the changed owned path is listed: " changed))
        (assert (not edited) "an owned edit is progress")
        (assert (and committed (= countAfter "1")) (str "the owned edit is committed although t/newTest.asl was never created: " countAfter))
        (assert (and (stringContains? names.out "a.txt") (not (stringContains? names.out "gatewayProfilePin"))) (str "the commit holds the owned file only: " names.out))
        true))

; (:m :ref CONDUCTOR-ZERO-MERGE :do "a reused unit worktree with no tracked change comes onto the moved base, and the receipt's base note says how far behind it was")
fn ! testReuseFresh -> Bool
  (let [(root (scratch "reuse"))
        (repo (str root "/r"))
        (_ (cleanup root))
        (_ (dirCreate repo))
        (_ (git repo (list "init" "--quiet" "-b" "main")))
        (_ (commitFile repo "a.txt" "a\n" "c0"))
        (rc (cd/realCfg (list "--repo" repo "--worktrees" (str root "/wts")) root))
        (u (st/Task :id "U1" :owns (list "a.txt") :reads (list) :gate "" :channel "free" :model "" :base "main" :after (list) :st "queued" :epoch 0 :receipt ""))
        (p (resultOr (cd/attachOrAdd rc u (str root "/wts/asex-U1")) ""))
        (_ (commitFile repo "b.txt" "b\n" "main moves"))
        (noteBefore (cd/baseNote! p "main"))
        (r (cd/reuseWt! rc u p))
        (onBase (git p (list "merge-base" "--is-ancestor" "main" "HEAD")))
        (noteAfter (cd/baseNote! p "main"))
        (_ (cleanup root))]
    (do (assert (not (stringEmpty? p)) "the unit worktree was made")
        (assert (stringContains? noteBefore ":behind 1)") (str "the note counts the commit the tree lacks: " noteBefore))
        (assert (and (ok? r) (= onBase.exit 0)) (str "the reused worktree is brought onto main: " r))
        (assert (stringContains? noteAfter ":behind 0)") (str "and is current after: " noteAfter))
        true))

; (:m :ref CONDUCTOR-ZERO-MERGE :do "main comes into dev before a train: fast-forward, merge when dev has its own commit, current when nothing is new")
fn ! testDevPromote -> Bool
  (let [(root (scratch "promote"))
        (src (str root "/src"))
        (dev (str root "/dev"))
        (_ (cleanup root))
        (_ (dirCreate src))
        (_ (git src (list "init" "--quiet" "-b" "main")))
        (_ (commitFile src "a.txt" "a\n" "c0"))
        (cl (fr/runOne (fr/job (list "git" "clone" "--quiet" src dev) root (fr/childEnv (list)))))
        (_ (git dev (list "checkout" "--quiet" "-b" "dev")))
        (_ (git dev (list "config" "user.name" "t")))
        (_ (git dev (list "config" "user.email" "t@t")))
        (rc (cd/realCfg (list "--repo" src "--dev-repo" dev "--dev" "dev") root))
        (_ (commitFile src "b.txt" "b\n" "c1"))
        (ff (cd/promoteDev! rc))
        (hasB (fileExists? (str dev "/b.txt")))
        (again (cd/promoteDev! rc))
        (_ (commitFile dev "d.txt" "d\n" "dev own"))
        (_ (commitFile src "c.txt" "c\n" "c2"))
        (merged (cd/promoteDev! rc))
        (both (and (fileExists? (str dev "/c.txt")) (fileExists? (str dev "/d.txt"))))
        (_ (cleanup root))]
    (do (assert (= cl.exit 0) "dev clone made")
        (assert (and (= ff "fastForward") hasB) (str "dev fast-forwards to main: " ff))
        (assert (= again "current") (str "nothing new is current: " again))
        (assert (and (= merged "merged") both) (str "dev with its own commit merges main: " merged))
        true))

; (:m :ref COND5 :do "a failure signature is the first error-looking line, never a (:gateway :usage ...) accounting line (run5 of the VPS e2e took the trailing usage line as the signature)")
fn ! testGateSig -> Bool
  (let [(usage "(:gateway :usage :provider \"opencodeGo\" :alias \"ocBeamFree\" :outcome \"ok\")")
        (agent "(:agent :status :failed :receipt (:agentReceipt :status :needsReview))")]
    (do (assert (stringStartsWith? (cd/gateSig (str "starting\n" agent "\n" usage "\n")) "(:agent :status :failed") "the failed agent line wins over the trailing usage line")
        (assert (= (cd/gateSig (str "boom ERR_X here\n" usage "\n")) "boom ERR_X here") "ERR_ lines still come first")
        (assert (= (cd/gateSig (str "plain tail\n" usage "\n")) "plain tail") "with no error line, the last non-usage line")
        true))

; (:m :ref ORCH-NODE2-CUTOVER-BUG :do "the write stage's hub guard: no hub.asn passes any worktree, a hub.asn with a socket refuses a worktree whose providers.asl lacks the hub client with ERR_HUB_CLIENT_MISSING, and passes one that has it")
fn ! testHubGuard -> Bool
  (let [(root (scratch "hubguard"))
        (home (str root "/h"))
        (wt (str root "/w"))
        (_ (cleanup root))
        (_ (dirCreate (str home "/.asl")))
        (_ (dirCreate (str wt "/asl/packages/asl-agent/src")))
        (_ (fileWrite (str wt "/asl/packages/asl-agent/src/providers.asl") "(module p)\n"))
        (noHub (cd/hubGuard! home wt))
        (_ (fileWrite (str home "/.asl/hub.asn") "(:hub :sock \"/x/hub.sock\")\n"))
        (refused (cd/hubGuard! home wt))
        (_ (fileWrite (str wt "/asl/packages/asl-agent/src/providers.asl") "fn hubAsnPath -> String\n  \"\"\n"))
        (current (cd/hubGuard! home wt))
        (_ (cleanup root))]
    (do (assert (not (some? noHub)) "no hub.asn: nothing refused")
        (assert (match refused ((some r) (and (= r.ok 0) (stringContains? r.sig "ERR_HUB_CLIENT_MISSING"))) ((none) false)) "a worktree without the hub client is refused")
        (assert (not (some? current)) "a worktree with the hub client passes")
        true))

; (:m :ref DEV-PROMOTE-ON-DEPLOY :do "a worktree holding the deployed Leon passes; a stale clean worktree with its own commit is rebased onto the deployed main and passes with that commit kept; a stale worktree whose commit conflicts is aborted back and gets a STALE_NEEDS_REBASE result, not a failure")
fn ! testLeonGuard -> Bool
  (let [(root (scratch "leonguard"))
        (repo (str root "/repo"))
        (wt (str root "/wt"))
        (sh (fn [(c String)] -> String (resultOr (fr/shellOut c 60000) "")))
        (cfg " && git config user.email t@example.invalid && git config user.name t")
        (_ (cleanup root))
        (made (sh (str "mkdir -p " repo "/asl/packages/asl-agent/src && cd " repo " && git init -q -b main" cfg
                       " && echo a > asl/packages/asl-agent/src/a.asl && git add -A && git commit -qm a && git clone -q " repo " " wt " 2>&1 && cd " wt cfg " && echo madeOk")))
        (current (cd/leonGuard! repo wt))
        (_ (sh (str "cd " repo " && echo b > asl/packages/asl-agent/src/b.asl && git add -A && git commit -qm b && cd " wt " && echo u > u.txt && git add -A && git commit -qm unit")))
        (leonSha (stringTrim (sh (str "git -C " repo " rev-parse HEAD"))))
        (rebased (cd/leonGuard! repo wt))
        (hasLeon (stringContains? (sh (str "git -C " wt " merge-base --is-ancestor " leonSha " HEAD && echo yes")) "yes"))
        (kept (stringContains? (sh (str "git -C " wt " log --format=%s -1")) "unit"))
        (_ (sh (str "cd " repo " && echo repoSide > asl/packages/asl-agent/src/a.asl && git commit -qam repoSide && cd " wt " && echo wtSide > asl/packages/asl-agent/src/a.asl && git commit -qam wtSide")))
        (head0 (stringTrim (sh (str "git -C " wt " rev-parse HEAD"))))
        (conflict (cd/leonGuard! repo wt))
        (head1 (stringTrim (sh (str "git -C " wt " rev-parse HEAD"))))
        (clean (stringEmpty? (stringTrim (sh (str "git -C " wt " status --porcelain")))))
        (_ (cleanup root))]
    (do (assert (stringContains? made "madeOk") "the fixture repo and its clone exist")
        (assert (not (some? current)) "a worktree holding the deployed Leon passes")
        (assert (not (some? rebased)) "a stale clean worktree is rebased and passes")
        (assert (and hasLeon kept) "after the rebase the worktree holds the deployed Leon and keeps its own commit")
        (assert (match conflict ((some r) (and (cd/staleSig? r.sig) (not (stringContains? r.sig "ERR_")))) ((none) false)) "a conflicting stale worktree gets a STALE_NEEDS_REBASE result")
        (assert (and (= head0 head1) clean) "the conflicting rebase is aborted back to the unit's own head")
        true))

; (:m :ref GATE-CHECK-TIMEOUT :do "the asl check before a gate is bounded by the configured seconds and a check that hits the bound is the gateTimeout signature, not an asl check failure; a failing check and a passing one are unchanged; (:gate :checkTimeoutS N) in ladder.asn sets the bound, default 900, a row gateErrors rejects means the default")
fn ! testGateCheckTimeout -> Bool
  (let [(root (scratch "gatechk"))
        (_ (cleanup root))
        (script (fn [(name String) (body String)] -> String
                  (let [(wt (str root "/" name))
                        (_ (dirCreate root))
                        (_ (dirCreate wt))
                        (_ (dirCreate (str wt "/bin")))
                        (_ (fileWrite (str wt "/bin/asl") (str "#!/bin/sh\n" body "\n")))
                        (_ (fr/runOne (fr/job (list "chmod" "755" (str wt "/bin/asl")) wt (fr/childEnv (list)))))]
                    wt)))
        (slow (cd/checkOne! (script "slow" "sleep 30") "a.asl" 2))
        (bad (cd/checkOne! (script "bad" "echo 'ERR_X boom'; exit 1") "a.asl" 20))
        (good (cd/checkOne! (script "good" "exit 0") "a.asl" 20))
        (_ (fileWrite (str root "/ladder.asn") "(:gate :checkTimeoutS 1200)\n"))
        (set (cd/gateCheckS root))
        (_ (fileWrite (str root "/ladder.asn") "(:gate :checkTimeoutS 5)\n"))
        (low (cd/gateCheckS root))
        (_ (fileWrite (str root "/ladder.asn") "(:gate :checkTimeoutS 600 :extra 1)\n"))
        (unknown (cd/gateCheckS root))
        (_ (fileWrite (str root "/ladder.asn") "(:providerFail :backoffS 9)\n"))
        (none (cd/gateCheckS root))
        (_ (cleanup root))]
    (do (assert (and (cd/gateTimeoutSig? slow) (not (stringContains? slow "asl check failed"))) (str "a check over the bound is gateTimeout: " slow))
        (assert (and (stringContains? bad "asl check failed on a.asl") (not (cd/gateTimeoutSig? bad))) (str "a failing check keeps its signature: " bad))
        (assert (stringEmpty? good) "a passing check has no signature")
        (assert (= set 1200) (str "the configured bound is used: " (stringFromInt64 set)))
        (assert (and (= low 900) (= unknown 900) (= none 900)) "an out-of-range row, an unknown key and no row mean the 900 s default")
        (assert (not (listEmpty? (cd/gateErrors "(:gate :checkTimeoutS 5)"))) "gateErrors rejects 5 s")
        true))

; (:m :ref UNIT-AHEAD-GATING :do "fixture for the stranded-branch loop: a repo whose gate script check.sh passes when every named file holds impl; base.txt holds it on main, so a gate on base.txt is green on the base; unit worktrees come from attachOrAdd like a claim")
fn ! aheadRepo root: String -> String
  (let [(repo (str root "/repo"))
        (made (resultOr (fr/shellOut (str "mkdir -p " repo " " root "/store/tasks " root "/home && cd " repo " && git init -q -b main && git config user.email t@example.invalid && git config user.name t"
                                         " && printf 'for f in \"$@\"; do if [ \"$(cat $f 2>/dev/null)\" != impl ]; then echo \"(:gate :asserts 1 :failed 1)\"; echo \"FAIL check (1 asserts)\"; exit 1; fi; done\\necho \"(:gate :asserts 1 :failed 0)\"\\necho \"1 assertion(s) executed (1 passed)\"\\n' > check.sh"
                                         " && printf 'echo run >> ../../gateRuns\nsh check.sh impl.txt\n' > gImpl.sh && printf 'ls ../../store/runs > ../../markSeen 2>&1\nsh check.sh impl.txt\n' > gMark.sh && printf 'sh check.sh base.txt\n' > gBase.sh && printf 'sh check.sh impl.txt doc.txt\n' > gBoth.sh && printf impl > base.txt && printf a > a.txt && git add -A && git commit -qm c0 && echo madeOk") 60000) ""))]
    (if (stringContains? made "madeOk") repo ""))

fn ! aheadUnit id: String gate: String -> st/Task
  (st/Task :id id :owns (list "impl.txt" "doc.txt") :reads (list) :gate gate :channel "free" :model "" :base "main" :after (list) :st "queued" :epoch 0 :receipt "")

fn aheadCUnit id: String -> cd/CUnit
  (cd/CUnit :id id :st "writing" :lane "free" :fails 0 :sig "" :waited 0 :parked 0 :epoch 0 :branch "" :wt "" :model "" :tokens 0 :costMicro 0 :esc 0 :launched 0 :await "")

; (:m :do "the unit worktree with one earlier driver commit of file f on sh/ID, as an earlier attempt left it")
fn ! aheadWt rc: cd/RealCfg u: st/Task f: String -> String
  (let [(p (resultOr (cd/attachOrAdd rc u (w/wtPath rc.wt u.id)) ""))
        (_ (if (stringEmpty? p) () (commitFile p f "impl" "(:c :a freePool :do \"row gate passed but the agent left it uncommitted; the driver committed on its behalf\")")))]
    p)

; (:m :ref UNIT-AHEAD-GATING :do "a branch ahead of its base with a green gate reaches gating with no writer run, and the journal says why; the same branch whose gate is green on the merge-base too is the vacuous verdict and escalates; a branch whose gate is red still gets a writer")
fn ! testAheadGating -> Bool
  (let [(root (scratch "ahead"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (repo (aheadRepo root))
        (dir (str root "/store"))
        (rc (cd/realCfg (list "--repo" repo "--home" (str root "/home") "--worktrees" (str root "/wts")) dir))
        (seen (str root "/seen"))
        (run (fn [(rcx cd/RealCfg) (lane String) (id String) (prof String) (p String) (task String) (owns (List String)) (gates (List String)) (extra String)] -> fr/Done
               (let [(_ (fileAppend seen (str id "\n")))] (fr/Done :idx 0 :exit 1 :out "" :ms 0 :verdict "exit"))))
        (u1 (aheadUnit "U1" "sh gImpl.sh"))
        (p1 (aheadWt rc u1 "impl.txt"))
        (r1 (cd/writeResWith run rc dir u1 (aheadCUnit "U1")))
        (ctx (cd/Ctx :dir dir :holder "conductorWireTest" :ttlMs 600000 :maxWait 0 :maxSame 3 :stageSec 60 :maxDesc 50
                     :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "true")) :pace (cd/fixedPace 4 4)))
        (_ (cd/finish! ctx u1 (aheadCUnit "U1") r1))
        (st1 (match (listFind (fn [(c cd/CUnit)] -> Bool (= c.id "U1")) (cd/readCUnits! dir)) ((some c) c.st) ((none) "none")))
        (u2 (aheadUnit "U2" "sh gBase.sh"))
        (p2 (aheadWt rc u2 "doc.txt"))
        (r2 (cd/writeResWith run rc dir u2 (aheadCUnit "U2")))
        (u3 (aheadUnit "U3" "sh gBoth.sh"))
        (p3 (aheadWt rc u3 "impl.txt"))
        (r3 (cd/writeResWith run rc dir u3 (aheadCUnit "U3")))
        (runsBefore (listLength (stringLines (resultOr (fileReadString (str root "/gateRuns")) ""))))
        (r1again (cd/writeResWith run rc dir u1 (aheadCUnit "U1")))
        (runsAfter (listLength (stringLines (resultOr (fileReadString (str root "/gateRuns")) ""))))
        (u4 (aheadUnit "U4" "sh gImpl.sh"))
        (p4 (aheadWt rc u4 "impl.txt"))
        (_ (fileWrite (str p4 "/doc.txt") "draft"))
        (r4 (cd/writeResWith run rc dir u4 (aheadCUnit "U4")))
        (u5 (aheadUnit "U5" "sh gImpl.sh"))
        (p5 (aheadWt rc u5 "impl.txt"))
        (_ (commitFile p5 "a.txt" "outside" "touch a path outside owns"))
        (r5 (cd/writeResWith run rc dir u5 (aheadCUnit "U5")))
        (u7 (aheadUnit "U7" "sh gBase.sh"))
        (_ (fileWrite (str dir "/tasks/U7.txt") "Regression guard: keep base.txt as it is."))
        (p7 (aheadWt rc u7 "doc.txt"))
        (r7 (cd/writeResWith run rc dir u7 (aheadCUnit "U7")))
        (journal (resultOr (fileReadString (cd/journalPath dir)) ""))
        (writers (resultOr (fileReadString seen) ""))
        (_ (cleanup root))]
    (do (assert (and (not (stringEmpty? repo)) (and (not (stringEmpty? p1)) (and (not (stringEmpty? p2)) (not (stringEmpty? p3))))) "the fixture repo and unit worktrees exist")
        (assert (and (= r1.ok 1) (stringEmpty? r1.sig)) (str "an ahead branch with a green gate is written: " r1.sig))
        (assert (and (= r1.branch "sh/U1") (= r1.wt p1)) "the result names the unit branch and worktree")
        (assert (not (stringContains? writers "U1")) (str "no writer ran on the finished branch: " writers))
        (assert (= st1 "gating") (str "the finished branch goes to gating: " st1))
        (assert (stringContains? journal ":commits 1 :gateExit 0 :executed 1 :baseExit 1 :verdict gating)") (str "the journal records the ahead verdict: " journal))
        (assert (and (= r2.ok 0) (cd/vacuousSig? r2.sig)) (str "a gate green on the merge-base too is vacuous: " r2.sig))
        (assert (not (stringContains? writers "U2")) "the vacuous verdict needs no writer either")
        (assert (stringContains? writers "U3") (str "a branch whose gate is red gets a writer: " writers))
        (assert (= r3.ok 0) "and that writer's failure stays a failure")
        (assert (> runsBefore 0) (str "the gate script counts its runs: " (stringFromInt64 runsBefore)))
        (assert (= runsAfter runsBefore) (str "a second claim on the same HEAD reuses the verdict without running the gate: " (stringFromInt64 runsBefore) " -> " (stringFromInt64 runsAfter)))
        (assert (and (= r1again.ok 1) (stringEmpty? r1again.sig)) "and returns the same written result")
        (assert (and (stringContains? writers "U4") (= r4.ok 0)) (str "an uncommitted owned edit goes to the writer: " writers))
        (assert (and (stringContains? writers "U5") (= r5.ok 0)) (str "a committed path outside :owns goes to the writer: " writers))
        (assert (and (= r7.ok 1) (stringEmpty? r7.sig)) (str "a regression guard green on the base goes to gating: " r7.sig))
        (assert (not (stringContains? writers "U7")) "with no writer run")
        true))

; (:m :ref UNIT-AHEAD-GATING :do "Leon's own gate integrity check, run by the writer inside onBaseRun!, reverts against the merge-base: an earlier committed implementation fails the gate on revert (not vacuous) where the HEAD revert saw only the doc edit and passed; a gate green on the base stays vacuous; afterwards HEAD is the branch tip again and the new edit is on top of it")
fn ! testIntegrityOnBase -> Bool
  (let [(root (scratch "onBase"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (repo (aheadRepo root))
        (rc (cd/realCfg (list "--repo" repo "--home" (str root "/home") "--worktrees" (str root "/wts")) (str root "/store")))
        (owns (list "impl.txt" "doc.txt"))
        (check (fn [(p String) (gate String)] -> (Pair Bool String)
                 (let [(_ (fileWrite (str p "/doc.txt") "impl"))]
                   (gi/gateIntegrity! (list gate) owns p (list (ag/makeGateResult gate 0 "(:gate :asserts 1 :failed 0)" "" false 1)) 60 (none)))))
        (writer (fn [(p String) (gate String) (out String)] -> fr/Done
                  (let [(v (check p gate))
                        (_ (fileWrite out (str (if (pairFirst v) "honest" "vacuous") "\n" (pairSecond v))))]
                    (fr/Done :idx 0 :exit 0 :out "" :ms 0 :verdict "exit"))))
        (u1 (aheadUnit "U1" "sh gImpl.sh"))
        (p1 (aheadWt rc u1 "impl.txt"))
        (tip1 (stringTrim (git p1 (list "rev-parse" "HEAD")).out))
        (headOnly (check p1 u1.gate))
        (_ (git p1 (list "checkout" "--quiet" "--" ".")))
        (_ (pathRemove (str p1 "/doc.txt")))
        (d1 (cd/onBaseRun! "" p1 "main" "U1" (fn [] -> fr/Done (writer p1 u1.gate (str root "/v1")))))
        (v1 (resultOr (fileReadString (str root "/v1")) ""))
        (after1 (stringTrim (git p1 (list "rev-parse" "HEAD")).out))
        (status1 (stringTrim (git p1 (list "status" "--porcelain" "--" "impl.txt" "doc.txt")).out))
        (u2 (aheadUnit "U2" "sh gBase.sh"))
        (p2 (aheadWt rc u2 "doc.txt"))
        (d2 (cd/onBaseRun! "" p2 "main" "U2" (fn [] -> fr/Done (writer p2 u2.gate (str root "/v2")))))
        (v2 (resultOr (fileReadString (str root "/v2")) ""))
        (u8 (aheadUnit "U8" "sh gImpl.sh"))
        (p8 (aheadWt rc u8 "impl.txt"))
        (tip8 (stringTrim (git p8 (list "rev-parse" "HEAD")).out))
        (entered (cd/onBaseEnter! "" p8 "main" "U8"))
        (_ (fileWrite (str p8 "/doc.txt") "impl"))
        (atBase8 (stringTrim (git p8 (list "rev-parse" "HEAD")).out))
        (settled (cd/settleWt! rc (str root "/store") u8 p8))
        (after8 (stringTrim (git p8 (list "rev-parse" "HEAD")).out))
        (ref8 (git p8 (list "rev-parse" "--verify" "--quiet" "refs/asex/preOnBase/U8")))
        (status8 (stringTrim (git p8 (list "status" "--porcelain" "--" "impl.txt" "doc.txt")).out))
        (u9 (aheadUnit "U9" "sh gImpl.sh"))
        (p9 (aheadWt rc u9 "impl.txt"))
        (tip9 (stringTrim (git p9 (list "rev-parse" "HEAD")).out))
        (d9 (cd/onBaseRun! "" p9 "main" "U9" (fn [] -> fr/Done
              (let [(_ (fileWrite (str p9 "/doc.txt") "impl"))
                    (_ (git p9 (list "add" "doc.txt")))
                    (c (git p9 (list "-c" "user.name=t" "-c" "user.email=t@t" "commit" "--quiet" "-m" "writer commit" "--" "doc.txt")))]
                (fr/Done :idx 0 :exit c.exit :out "" :ms 0 :verdict "exit")))))
        (parent9 (stringTrim (git p9 (list "rev-parse" "HEAD^")).out))
        (files9 (git p9 (list "ls-tree" "--name-only" "HEAD")))
        (msg9 (stringTrim (git p9 (list "log" "-1" "--format=%s")).out))
        (owned9 (cd/ownedChanges! p9 owns))
        (_ (cleanup root))]
    (do (assert (not (pairFirst headOnly)) (str "control: reverting to HEAD calls the doc-only edit vacuous: " (pairSecond headOnly)))
        (assert (stringStartsWith? v1 "honest") (str "measured against the merge-base the earlier implementation fails the gate on revert: " v1))
        (assert (stringContains? v1 "failsOnRevert") (str "the verdict is failsOnRevert: " v1))
        (assert (and (= d1.exit 0) (= after1 tip1)) (str "HEAD is the branch tip again: " after1 " vs " tip1))
        (assert (= status1 "?? doc.txt") (str "only the new edit is left on top of the tip: " status1))
        (assert (stringStartsWith? v2 "vacuous") (str "a gate green on the base stays vacuous: " v2))
        (assert (= d2.exit 0) "the writer's result is passed through")
        (assert (and (some? entered) (!= atBase8 tip8)) "the writer stage moved HEAD to the merge-base")
        (assert (ok? settled) (str "the next claim settles the worktree: " settled))
        (assert (= after8 tip8) (str "a writer killed mid-run leaves the old tip restored on the next claim: " after8 " vs " tip8))
        (assert (!= ref8.exit 0) "the saved tip ref is dropped once restored")
        (assert (= status8 "?? doc.txt") (str "the killed writer's edit stays on top: " status8))
        (assert (= d9.exit 0) "the committing writer ran")
        (assert (= parent9 tip9) (str "a writer commit is rebuilt on the old tip: " parent9 " vs " tip9))
        (assert (and (stringContains? files9.out "impl.txt") (stringContains? files9.out "doc.txt")) (str "the rebuilt commit holds the earlier and the new work: " files9.out))
        (assert (= msg9 "writer commit") (str "with the writer's message: " msg9))
        (assert (listEmpty? owned9) (str "and leaves no owned change behind: " owned9))
        true))

; (:m :ref UNIT-AHEAD-GATING :do "the saved pre-onBase state is per unit and only ever restored onto the state it was saved from: a detached worktree heals nothing of another unit's tip; a saved tip still present makes enter refuse instead of overwriting it; a worktree removed mid-writer and re-attached is healed before freshBase! rebases it; a tree recreated on a moved main is stale, journaled, and its refs are kept")
fn ! testOnBaseRefs -> Bool
  (let [(root (scratch "onBaseRefs"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (repo (aheadRepo root))
        (dir (str root "/store"))
        (rc (cd/realCfg (list "--repo" repo "--home" (str root "/home") "--worktrees" (str root "/wts")) dir))
        (headAt (fn [(p String)] -> String (stringTrim (git p (list "rev-parse" "HEAD")).out)))
        (refAt (fn [(p String) (r String)] -> String (let [(d (git p (list "rev-parse" "--verify" "--quiet" r)))] (if (= d.exit 0) (stringTrim d.out) ""))))
        (pa (str root "/wts/detA"))
        (pb (str root "/wts/detB"))
        (_ (git repo (list "worktree" "add" "--quiet" "--detach" pa "main")))
        (_ (git repo (list "worktree" "add" "--quiet" "--detach" pb "main")))
        (_ (commitFile pa "impl.txt" "impl" "A work"))
        (_ (commitFile pb "doc.txt" "impl" "B work"))
        (tipA (headAt pa))
        (tipB (headAt pb))
        (enteredA (cd/onBaseEnter! dir pa "main" "UA"))
        (healedB (cd/onBaseHeal! dir pb "main" "UB"))
        (afterB (headAt pb))
        (noId (cd/onBaseEnter! dir pb "main" ""))
        (afterNoId (headAt pb))
        (healedA (cd/onBaseHeal! dir pa "main" "UA"))
        (afterA (headAt pa))
        (u10 (aheadUnit "U10" "sh gImpl.sh"))
        (p10 (aheadWt rc u10 "impl.txt"))
        (tip10 (headAt p10))
        (_ (git p10 (list "update-ref" "refs/asex/preOnBase/U10" tipA)))
        (refused (cd/onBaseEnter! dir p10 "main" "U10"))
        (ref10 (refAt p10 "refs/asex/preOnBase/U10"))
        (after10 (headAt p10))
        (u12 (aheadUnit "U12" "sh gImpl.sh"))
        (p12 (aheadWt rc u12 "impl.txt"))
        (tip12 (headAt p12))
        (entered12 (cd/onBaseEnter! dir p12 "main" "U12"))
        (u11 (aheadUnit "U11" "sh gImpl.sh"))
        (p11 (aheadWt rc u11 "impl.txt"))
        (tip11 (headAt p11))
        (entered11 (cd/onBaseEnter! dir p11 "main" "U11"))
        (_ (git repo (list "worktree" "remove" "--force" p11)))
        (_ (commitFile repo "m.txt" "m" "main moves"))
        (main2 (headAt repo))
        (settled11 (cd/settleWt! rc dir u11 p11))
        (onMain11 (git p11 (list "merge-base" "--is-ancestor" "main" "HEAD")))
        (files11 (git p11 (list "ls-tree" "--name-only" "HEAD")))
        (ref11 (refAt p11 "refs/asex/preOnBase/U11"))
        (_ (git p12 (list "reset" "-q" "--hard" main2)))
        (healed12 (cd/onBaseHeal! dir p12 "main" "U12"))
        (after12 (headAt p12))
        (ref12 (refAt p12 "refs/asex/preOnBase/U12"))
        (journal (resultOr (fileReadString (cd/journalPath dir)) ""))
        (_ (cleanup root))]
    (do (assert (and (some? enteredA) (!= tipA tipB)) "two detached worktrees, A entered")
        (assert (and (not healedB) (= afterB tipB)) (str "a detached worktree of another unit is not healed onto A's tip: " afterB " vs " tipB))
        (assert (and (none? noId) (= afterNoId tipB)) "no unit id, no enter")
        (assert (and healedA (= afterA tipA)) (str "A itself heals back to its tip: " afterA))
        (assert (none? refused) "enter refuses while a saved tip of the unit exists")
        (assert (= ref10 tipA) (str "and keeps that saved tip: " ref10))
        (assert (= after10 tip10) (str "HEAD is left where it was: " after10))
        (assert (stringContains? journal "(:onBaseRefused :unit \"U10\"") (str "the refusal is journaled: " journal))
        (assert (and (some? entered11) (ok? settled11)) (str "a removed worktree is re-attached: " settled11))
        (assert (and (= onMain11.exit 0) (and (stringContains? files11.out "impl.txt") (stringContains? files11.out "m.txt"))) (str "healed before freshBase!: the unit work is on the moved main: " files11.out))
        (assert (stringEmpty? ref11) "and the saved tip is dropped")
        (assert (some? entered12) "U12 entered")
        (assert (and (not healed12) (= after12 main2)) (str "a tree recreated on a moved main is not rebuilt: " after12))
        (assert (= ref12 tip12) "its saved tip is kept")
        (assert (stringContains? journal "(:onBaseStale :unit \"U12\"") (str "the stale state is journaled: " journal))
        true))

; (:m :ref REVIEW-DEFER :do "the review writer: a served model name with no family (k3.1-pro) resolves to the gateway alias serving it (kmK31Pro, moonshot via familyExtra); the writer is the newest write-to-gating journal row with a model, skipping the ahead check's empty one, never the reviewer list a review left on the unit row; and a review transition no longer writes its reviewers into the unit row")
fn ! testReviewWriter -> Bool
  (let [(root (scratch "reviewWriter"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (gw "(:gateway :v 2 :models ((:model :id kmK31Pro :provider kimiCode :name \"k3.1-pro\") (:model :id ccZAiGlm53Flash :provider commandCode :name \"z-ai/glm-5.3-flash\")))")
        (lanes "(:reviewLanes :v 1 :familyExtra \"(:f :match km :family moonshot)\" :unknown () :lanes ((:lane :alias ccZAiGlm53Flash :tier free :quality 0 :allowance 1)))")
        (resolved (rs/writerAliasFor gw lanes "k3.1-pro"))
        (kept (rs/writerAliasFor gw lanes "ccZAiGlm53Flash"))
        (unknown (rs/writerAliasFor gw lanes "mystery-model"))
        (j (cd/journalPath root))
        (_ (fileWrite j (str "(:t :unit \"U1\" :from writing :to gating :stage write :model \"ccZAiGlm53Flash\" :alias \"ccZAiGlm53Flash\" :tokens 1 :costUsd 0 :verdict \"written\" :ms 1 :at 1)\n"
                             "(:t :unit \"U2\" :from writing :to gating :stage write :model \"other\" :tokens 1 :costUsd 0 :verdict \"written\" :ms 1 :at 2)\n"
                             "(:t :unit \"U1\" :from reviewing :to ready :stage review :model \"hzQwen3827bGrade+ovhGptOss120b\" :tokens 0 :costUsd 0 :verdict \"fail: x\" :ms 0 :at 3)\n"
                             "(:t :unit \"U1\" :from writing :to gating :stage write :model \"\" :tokens 0 :costUsd 0 :verdict \"written\" :ms 1 :at 4)\n")))
        (c (with (aheadCUnit "U1") :model "hzQwen3827bGrade+ovhGptOss120b"))
        (w (cd/writerOf! root c))
        (none (cd/writerOf! root (with (aheadCUnit "U9") :model "fallbackModel")))
        (ctx (cd/Ctx :dir root :holder "conductorWireTest" :ttlMs 600000 :maxWait 0 :maxSame 3 :stageSec 60 :maxDesc 50
                     :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "true")) :pace (cd/fixedPace 4 4)))
        (written (cd/moveA! ctx (aheadCUnit "U3") "gating" "write" "ccZAiGlm53Flash" "ccZAiGlm53Flash" 0 0 "written" 0))
        (reviewed (cd/move! ctx written "awaitReview" "review" "zaiGlm47Flash+kiloCohereNorthMiniCode" 0 0 "defer" 0))
        (_ (cleanup root))]
    (do (assert (= resolved "kmK31Pro") (str "a served model name resolves to its gateway alias: " resolved))
        (assert (= kept "ccZAiGlm53Flash") "an alias with a family stays")
        (assert (= unknown "mystery-model") "a name no gateway row serves stays unknown")
        (assert (= w "ccZAiGlm53Flash") (str "the writer is the last write with a model, not the reviewer list: " w))
        (assert (= none "fallbackModel") "no write row: the unit row's model")
        (assert (= written.model "ccZAiGlm53Flash") "the write stage sets the unit's model")
        (assert (= reviewed.model "ccZAiGlm53Flash") (str "a review transition keeps the writer's model: " reviewed.model))
        true))

; (:m :ref AHEAD-REVIEW-FAIL-LOOP :do "a head whose review failed or blocked it is not sent to review again by the cached green ahead verdict: the writer runs; a failure of another unit, a defer, or a fail before a later ahead row for the head does not suppress the shortcut; and a unit never reviewed keeps it")
fn ! testAheadReviewFail -> Bool
  (let [(root (scratch "aheadFail"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (repo (aheadRepo root))
        (dir (str root "/store"))
        (rc (cd/realCfg (list "--repo" repo "--home" (str root "/home") "--worktrees" (str root "/wts")) dir))
        (seen (str root "/seen"))
        (run (fn [(rcx cd/RealCfg) (lane String) (id String) (prof String) (p String) (task String) (owns (List String)) (gates (List String)) (extra String)] -> fr/Done
               (let [(_ (fileAppend seen (str id "\n")))] (fr/Done :idx 0 :exit 1 :out "" :ms 0 :verdict "exit"))))
        (j (cd/journalPath dir))
        (row (fn [(id String) (to String) (stage String)] -> String
               (str "(:t :unit \"" id "\" :from reviewing :to " to " :stage " stage " :model \"m\" :tokens 0 :costUsd 0 :verdict \"fail: x\" :ms 0 :at 3)\n")))
        (units (map (fn [(id String)] -> st/Task (aheadUnit id "sh gImpl.sh")) (list "F1" "F2" "F3" "F4" "F5")))
        (wts (map (fn [(u st/Task)] -> String (aheadWt rc u "impl.txt")) units))
        (claim (fn [(id String)] -> cd/Res (cd/writeResWith run rc dir (optionOr (listFind (fn [(u st/Task)] -> Bool (= u.id id)) units) (aheadUnit id "")) (aheadCUnit id))))
        (first (map claim (list "F1" "F2" "F3" "F4" "F5")))
        (firstWriters (resultOr (fileReadString seen) ""))
        (okAt (fn [(rs (List cd/Res)) (i Int64)] -> Int64 (match (listGet rs i) ((some r) r.ok) ((none) -1))))
        (_ (fileAppend j (str (row "F1" "ready" "review") (row "F2" "blocked" "review") (row "F3" "awaitReview" "review") (row "F4" "ready" "gates") (row "F9" "ready" "review"))))
        (again (map claim (list "F1" "F2" "F3" "F4" "F5")))
        (writers (resultOr (fileReadString seen) ""))
        (_ (cleanup root))]
    (do (assert (listAll? (fn [(r cd/Res)] -> Bool (and (= r.ok 1) (stringEmpty? r.sig))) first) "every fresh ahead branch with a green gate goes to gating")
        (assert (stringEmpty? firstWriters) (str "no writer ran on the first claims: " firstWriters))
        (assert (and (stringContains? writers "F1") (= (okAt again 0) 0)) (str "a head whose review failed gets a writer: " writers))
        (assert (stringContains? writers "F2") (str "a head whose review blocked it gets a writer: " writers))
        (assert (not (stringContains? writers "F3")) "a review defer is not a failure")
        (assert (not (stringContains? writers "F4")) "a gates failure row is not a review failure")
        (assert (and (not (stringContains? writers "F5")) (= (okAt again 4) 1)) "a unit never reviewed keeps the shortcut, whatever another unit's review did")
        true))

; (:m :ref AHEAD-WRITER-UNKNOWN :do "the writer of a unit that entered gating through the ahead check is the newest write row naming one, a failed write too; with none at all it is the unit row's model, empty when that is empty")
fn ! testWriterFromFailedWrite -> Bool
  (let [(root (scratch "writerFail"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (j (cd/journalPath root))
        (_ (fileWrite j (str "(:t :unit \"A\" :from writing :to ready :stage write :model \"ccZAiGlm53Flash\" :tokens 1 :costUsd 0 :verdict \"fail: exit\" :ms 1 :at 1)\n"
                             "(:t :unit \"A\" :from writing :to gating :stage write :model \"\" :tokens 0 :costUsd 0 :verdict \"written\" :ms 1 :at 2)\n"
                             "(:t :unit \"B\" :from writing :to blocked :stage write :model \"kmK31Pro\" :alias \"kmK31Pro\" :tokens 1 :costUsd 0 :verdict \"escalated: x\" :ms 1 :at 3)\n"
                             "(:t :unit \"B\" :from reviewing :to ready :stage review :model \"hzQwen3827bGrade\" :tokens 0 :costUsd 0 :verdict \"fail: x\" :ms 1 :at 4)\n"
                             "(:t :unit \"C\" :from writing :to gating :stage write :model \"\" :tokens 0 :costUsd 0 :verdict \"written\" :ms 1 :at 5)\n")))
        (a (cd/writerOf! root (aheadCUnit "A")))
        (b (cd/writerOf! root (aheadCUnit "B")))
        (c (cd/writerOf! root (aheadCUnit "C")))
        (_ (cleanup root))]
    (do (assert (= a "ccZAiGlm53Flash") (str "the ahead-gated unit takes the writer of its failed write row: " a))
        (assert (= b "kmK31Pro") (str "a blocked write row names the writer, not the later reviewer: " b))
        (assert (= c "") (str "no write row names a writer: empty, which the ladder reads as no writer to exclude: " c))
        true))

; (:m :ref RES-GUARD-M1 :do "with cap 0 (no slot, the disk stop level among the causes) no gate and no review launches: a written unit becomes gating with launched 0, a launch of gating or reviewing is deferred, an awaitReview unit waits in place; with cap above 0 each starts; a write launch and the stages already running are untouched")
fn ! testSlotHold -> Bool
  (let [(root (scratch "slotHold"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (repo (aheadRepo root))
        (dir (str root "/store"))
        (rc (cd/realCfg (list "--repo" repo "--home" (str root "/home") "--worktrees" (str root "/wts")) dir))
        (noRun (fn [(rcx cd/RealCfg) (lane String) (id String) (prof String) (p String) (task String) (owns (List String)) (gates (List String)) (extra String)] -> fr/Done (fr/Done :idx 0 :exit 1 :out "" :ms 0 :verdict "exit")))
        (mk (fn [(hold Bool)] -> cd/Ctx
              (cd/Ctx :dir dir :holder "conductorWireTest" :ttlMs 600000 :maxWait 0 :maxSame 3 :stageSec 60 :maxDesc 50
                      :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "true")) :pace (cd/fixedPace 4 4) :hold hold)))
        (u (aheadUnit "H1" "sh gImpl.sh"))
        (stOf (fn [(id String)] -> String (match (listFind (fn [(c cd/CUnit)] -> Bool (= c.id id)) (cd/readCUnits! dir)) ((some c) (str c.st ":" (stringFromInt64 (if (= c.launched 0) 0 1)))) ((none) "none"))))
        (gHold (cd/launch! (mk true) u (with (aheadCUnit "H1") :st "gating")))
        (gOpen (cd/launch! (mk false) u (with (aheadCUnit "H1") :st "gating")))
        (rHold (cd/launch! (mk true) u (with (aheadCUnit "H1") :st "reviewing")))
        (wHold (cd/launch! (mk true) u (with (aheadCUnit "H1") :st "writing")))
        (u2 (aheadUnit "H2" "sh gImpl.sh"))
        (p2 (aheadWt rc u2 "impl.txt"))
        (res2 (cd/writeResWith noRun rc dir u2 (aheadCUnit "H2")))
        (_ (cd/writeCUnit! dir (aheadCUnit "H2")))
        (_ (cd/finish! (mk true) u2 (aheadCUnit "H2") res2))
        (h2 (stOf "H2"))
        (u3 (aheadUnit "H3" "sh gImpl.sh"))
        (p3 (aheadWt rc u3 "impl.txt"))
        (res3 (cd/writeResWith noRun rc dir u3 (aheadCUnit "H3")))
        (_ (cd/writeCUnit! dir (aheadCUnit "H3")))
        (_ (cd/finish! (mk false) u3 (aheadCUnit "H3") res3))
        (h3 (stOf "H3"))
        (_ (cd/writeCUnit! dir (with (aheadCUnit "H4") :st "awaitReview")))
        (_ (cd/step! (mk false) (aheadUnit "H4" "sh gImpl.sh") 0))
        (h4 (stOf "H4"))
        (_ (cd/step! (mk false) (aheadUnit "H4" "sh gImpl.sh") 1))
        (h4b (stOf "H4"))
        (u5 (aheadUnit "H5" "sh gImpl.sh"))
        (_ (st/put! dir u5))
        (epoch (match (st/claim! dir "H5" "conductorWireTest" 600000) ((ok text) (match (st/parseLease text) ((ok l) l.epoch) ((err _) 0))) ((err _) 0)))
        (_ (cd/writeCUnit! dir (with (aheadCUnit "H5") :st "gating" :epoch epoch :launched 0)))
        (_ (cd/step! (mk false) u5 0))
        (h5 (stOf "H5"))
        (_ (cd/step! (mk false) u5 1))
        (h5b (stOf "H5"))
        (_ (cleanup root))]
    (do (assert (= gHold.launched 0) "a gate launch is deferred while no slot is free")
        (assert (= rHold.launched 0) "a review launch is deferred while no slot is free")
        (assert (!= gOpen.launched 0) (str "with a slot the gate launches: " (stringFromInt64 gOpen.launched)))
        (assert (!= wHold.launched 0) "a write launch is not held by this guard")
        (assert (= h2 "gating:0") (str "a written unit under hold waits in gating: " h2))
        (assert (= h3 "gating:1") (str "a written unit with a slot starts its gate: " h3))
        (assert (= h4 "awaitReview:0") (str "an awaitReview unit waits in place at cap 0: " h4))
        (assert (and (> epoch 0) (= h5 "gating:0")) (str "a gating unit with launched 0 waits at cap 0: " h5))
        (assert (= h5b "gating:1") (str "and starts at cap 1: " h5b))
        (assert (stringStartsWith? h4b "reviewing") (str "and starts at cap 1: " h4b))
        true))

; (:m :ref REVIEW-DEFER :do "a unit stored with :base HEAD is measured against main: an ahead branch with a green gate reaches gating, a writer commit is progress, not noEdit; the ahead check runs with its stall marker in place and leaves none behind, and a marked unit is not stall-probed")
fn ! testBaseHead -> Bool
  (let [(root (scratch "baseHead"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (repo (aheadRepo root))
        (dir (str root "/store"))
        (_ (fileWrite (str dir "/repo.path") repo))
        (rc (cd/realCfg (list "--repo" repo "--home" (str root "/home") "--worktrees" (str root "/wts")) dir))
        (head (fn [(u st/Task)] -> st/Task (with u :base "HEAD")))
        (seen (str root "/seen"))
        (run (fn [(rcx cd/RealCfg) (lane String) (id String) (prof String) (p String) (task String) (owns (List String)) (gates (List String)) (extra String)] -> fr/Done
               (let [(_ (fileAppend seen (str id "\n")))
                     (_ (fileWrite (str p "/doc.txt") "impl"))]
                 (fr/Done :idx 0 :exit 0 :out "" :ms 0 :verdict "exit"))))
        (u1 (head (aheadUnit "U1" "sh gMark.sh")))
        (p1 (aheadWt rc u1 "impl.txt"))
        (r1 (cd/writeResWith run rc dir u1 (aheadCUnit "U1")))
        (marks (resultOr (fileReadString (str root "/markSeen")) ""))
        (left (fileExists? (str dir "/runs/U1-ahead.run")))
        (u2 (head (aheadUnit "U2" "sh gBoth.sh")))
        (p2 (aheadWt rc u2 "impl.txt"))
        (r2 (cd/writeResWith run rc dir u2 (aheadCUnit "U2")))
        (count2 (stringTrim (git p2 (list "rev-list" "--count" "main..HEAD")).out))
        (ctx (cd/Ctx :dir dir :holder "conductorWireTest" :ttlMs 600000 :maxWait 0 :maxSame 3 :stageSec 60 :maxDesc 50
                     :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "true")) :pace (cd/fixedPace 4 4)))
        (_ (cd/writeCUnit! dir (with (aheadCUnit "U5") :launched 1)))
        (probed (listLength (filter (fn [(pr stl/Probe)] -> Bool (= pr.id "U5")) (cd/stallProbes ctx))))
        (_ (fileWrite (str dir "/runs/U5-ahead.run") (str "(:aheadCheck :untilMs " (stringFromInt64 (+ (/ (nowNs) 1000000) 600000)) ")\n")))
        (marked (listLength (filter (fn [(pr stl/Probe)] -> Bool (= pr.id "U5")) (cd/stallProbes ctx))))
        (_ (cleanup root))]
    (do (assert (and (not (stringEmpty? p1)) (not (stringEmpty? p2))) "the fixture worktrees exist")
        (assert (and (= r1.ok 1) (stringEmpty? r1.sig)) (str "a :base HEAD branch ahead of main with a green gate goes to gating: " r1.sig))
        (assert (not (stringContains? (resultOr (fileReadString seen) "") "U1")) "without a writer run")
        (assert (stringContains? marks "U1-ahead.run\n") (str "the stall marker is in place while the ahead check runs the gate: " marks))
        (assert (not left) "and gone afterwards")
        (assert (and (= r2.ok 1) (stringEmpty? r2.sig)) (str "a writer commit on a :base HEAD unit is progress, not noEdit: " r2.sig))
        (assert (= count2 "2") (str "the earlier work and the writer's commit are on the branch: " count2))
        (assert (= probed 1) "a writing unit is stall-probed")
        (assert (= marked 0) "not while its ahead check runs")
        true))

; (:m :ref REVIEW-DEFER :do "audit round: a :base HEAD unit in a repo whose branch is trunk is measured against trunk, not a literal main; a commit count never reads a plain directory's enclosing repo; a newest write row that names no known writer makes the writer unknown; a stale ahead marker is ignored and one left by a killed stage is cleared on the next write; a unit awaiting two lanes wakes on either")
fn ! testReviewDeferFix -> Bool
  (let [(root (scratch "deferFix"))
        (_ (cleanup root))
        (_ (dirCreate root))
        (repo (aheadRepo root))
        (_ (git repo (list "branch" "-m" "main" "trunk")))
        (dir (str root "/store"))
        (rc (cd/realCfg (list "--repo" repo "--home" (str root "/home") "--worktrees" (str root "/wts")) dir))
        (seen (str root "/seen"))
        (run (fn [(rcx cd/RealCfg) (lane String) (id String) (prof String) (p String) (task String) (owns (List String)) (gates (List String)) (extra String)] -> fr/Done
               (let [(_ (fileAppend seen (str id "\n")))
                     (_ (fileWrite (str p "/doc.txt") "impl"))]
                 (fr/Done :idx 0 :exit 0 :out "" :ms 0 :verdict "exit"))))
        (u1 (with (aheadUnit "U1" "sh gImpl.sh") :base "HEAD"))
        (p1 (aheadWt rc u1 "impl.txt"))
        (r1 (cd/writeResWith run rc dir u1 (aheadCUnit "U1")))
        (u2 (with (aheadUnit "U2" "sh gBoth.sh") :base "HEAD"))
        (p2 (aheadWt rc u2 "impl.txt"))
        (r2 (cd/writeResWith run rc dir u2 (aheadCUnit "U2")))
        (base1 (cd/repoBase! repo))
        (plainRepo (str root "/plainRepo"))
        (_ (dirCreate plainRepo))
        (_ (git plainRepo (list "init" "--quiet" "-b" "main")))
        (_ (commitFile plainRepo "a.txt" "a" "c0"))
        (_ (git plainRepo (list "checkout" "--quiet" "-b" "sh/X")))
        (_ (commitFile plainRepo "b.txt" "b" "ahead"))
        (_ (dirCreate (str plainRepo "/plain")))
        (plainNone (cd/noCommits? (str plainRepo "/plain") "main"))
        (repoSome (cd/noCommits? plainRepo "main"))
        (_ (git plainRepo (list "checkout" "--quiet" "main")))
        (plainPast (cd/commitsPast? (str plainRepo "/plain") "main"))
        (repoPast (cd/commitsPast? plainRepo "main"))
        (j (cd/journalPath dir))
        (_ (fileAppend j (str "(:t :unit \"W1\" :from writing :to gating :stage write :model \"ccZAiGlm53Flash\" :alias \"ccZAiGlm53Flash\" :tokens 1 :costUsd 0 :verdict \"written\" :ms 1 :at 1)\n"
                              "(:t :unit \"W1\" :from writing :to gating :stage write :model \"unknown\" :tokens 1 :costUsd 0 :verdict \"written\" :ms 1 :at 2)\n")))
        (w1 (cd/writerOf! dir (aheadCUnit "W1")))
        (ctx (cd/Ctx :dir dir :holder "conductorWireTest" :ttlMs 600000 :maxWait 0 :maxSame 3 :stageSec 60 :maxDesc 50
                     :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "true")) :pace (cd/fixedPace 4 4)))
        (_ (fileWrite (str dir "/repo.path") repo))
        (_ (cd/writeCUnit! dir (with (aheadCUnit "S1") :launched 1)))
        (_ (fileWrite (str dir "/runs/S1-ahead.run") "(:aheadCheck :unit \"S1\" :startedMs 1 :untilMs 2)\n"))
        (staleProbed (listLength (filter (fn [(pr stl/Probe)] -> Bool (= pr.id "S1")) (cd/stallProbes ctx))))
        (u3 (with (aheadUnit "U3" "sh gImpl.sh") :base "HEAD"))
        (_ (fileWrite (str dir "/runs/U3-ahead.run") (str "(:aheadCheck :unit \"U3\" :untilMs " (stringFromInt64 (+ (/ (nowNs) 1000000) 600000)) ")\n")))
        (r3 (cd/writeResWith run rc dir u3 (aheadCUnit "U3")))
        (cleared (not (fileExists? (str dir "/runs/U3-ahead.run"))))
        (_ (cd/writeCUnit! dir (with (aheadCUnit "A1") :st "awaitReview" :parked 1 :await "ocGlmFlash ocGlm53")))
        (woken (cd/wake! ctx "ocGlm53"))
        (a1 (match (listFind (fn [(c cd/CUnit)] -> Bool (= c.id "A1")) (cd/readCUnits! dir)) ((some c) c.parked) ((none) -1)))
        (writers (resultOr (fileReadString seen) ""))
        (_ (cleanup root))]
    (do (assert (= base1 "trunk") (str "HEAD resolves to the branch the repo has checked out: " base1))
        (assert (and (= r1.ok 1) (stringEmpty? r1.sig)) (str "a :base HEAD ahead branch in a trunk repo goes to gating: " r1.sig))
        (assert (not (stringContains? writers "U1")) "without a writer run")
        (assert (and (= r2.ok 1) (stringEmpty? r2.sig)) (str "a writer commit there is progress: " r2.sig))
        (assert plainNone "a plain directory inside a repo with a branch ahead has no commit count of its own")
        (assert (not repoSome) "while the repo itself counts its commit")
        (assert (and plainPast (not repoPast)) "with the repo on main: the repo counts no commit past main, the plain directory has no count, which is not a verdict")
        (assert (= w1 "unknown") (str "a newest write row with an unknown writer makes the writer unknown: " w1))
        (assert (= staleProbed 1) "a marker past its untilMs does not hide a unit from the stall probe")
        (assert cleared "a marker a killed stage left is cleared by the next write")
        (assert (stringContains? writers "U3") "and that write ran its writer (U3 was not ahead)")
        (assert (and (= woken 1) (= a1 0)) (str "a unit awaiting two lanes wakes on either: " (stringFromInt64 woken)))
        true))

fn ! runTests -> Bool
  (do (assert (testAttach) "retry attaches an existing branch")
      (assert (testAttachMissing) "a registered but missing worktree is pruned and attached")
      (assert (testOrphanWt) "an orphan unit dir is moved aside and re-added")
      (assert (testBriefTask) "the brief carries owned path states")
      (assert (testWriteResBrief) "the write stage hands the writer the brief")
      (assert (testDropRemotes) "the dev repo's remotes are dropped before a train")
      (assert (testSpend) "token spend from provider usage and Leon's usage row")
      (assert (testMergeEnv) "the train cannot start a nested e2e")
      (assert (testCost) "costUsd from gateway price rows, unpriced is -1")
      (assert (testVacuousWrite) "a gate green on the base makes the write vacuous")
      (assert (testStaleBranch) "a stale leftover branch is rebased or recreated")
      (assert (testGateSig) "gateSig ignores usage lines")
      (assert (testGateCheckTimeout) "a check over its bound is gateTimeout")
      (assert (testWriteProgress) "write progress counts owned changes and commits them")
      (assert (testReuseFresh) "a reused worktree comes onto its moved base")
      (assert (testDevPromote) "main comes into dev before a train")
      (assert (testSigKey) "signature key ignores ids")
      (assert (testAllowance) "allowances from subPace")
      (assert (testRefreshWake) "refresh wakes the lanes that rose")
      (assert (testLadderWiring) "ladder wiring")
      (assert (testService) "service unit and dev repo steps")
      (assert (testCoverage) "coverage refusal")
      (assert (testHubGuard) "the write stage refuses a worktree without the hub client")
      (assert (testLeonGuard) "the write stage refuses a worktree without the deployed Leon")
      (assert (testAheadGating) "an ahead branch with a green gate goes to gating without a writer")
      (assert (testIntegrityOnBase) "the writer integrity revert is measured against the merge-base")
      (assert (testOnBaseRefs) "saved pre-onBase state is per unit, never overwritten, healed before rebase, kept when stale")
      (assert (testReviewWriter) "the review writer is the unit's writer, resolved to an alias with a family")
      (assert (testBaseHead) "a :base HEAD unit is measured against main")
      (assert (testSlotHold) "cap 0 starts no gate and no review")
      (assert (testAheadReviewFail) "a head whose review failed is not shortcut to review again")
      (assert (testWriterFromFailedWrite) "the writer comes from a failed write row too")
      (assert (testReviewDeferFix) "base resolves to the repo branch, counts need a top level, unknown writers wait, stale markers, two-lane wake")
      true)
