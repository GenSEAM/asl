(module asl-tools/coord/tests/tickReadsTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/fleet/run :a fr) (asl-tools/coord/tests/fixtures/pipeFix :a pf)])

; (:m :ref COND-TICK-READS :do "a store read error is never an empty store: a corrupt conductor state row and an unreadable store directory each raise a lead-stream warn from the tick (deduped to one row with a count), the unreadable store shows in status! and is never settled even with no conductor rows, while a store directory that does not exist yet stays an empty settled store")
fn ctxOf dir: String -> cd/Ctx
  (cd/Ctx :dir dir :holder "tickReadsTest" :ttlMs 600000 :maxWait 0 :maxSame 3 :stageSec 60 :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "/usr/bin/touch" (str dir "/launched." u.id))) :pace (cd/fixedPace 4 4))

fn leadText root: String -> String
  (resultOr (fileReadString (str root "/lead/stream.asn")) "")

fn countIn text: String needle: String -> Int64
  (- (listLength (stringSplit text needle)) 1)

(schema ReleaseCase (:f released Bool) (:f top String) (:f rel String) (:f unique Bool) (:f top2 String) (:f rowKept Bool))
(schema ListCase (:f rowsSame Bool) (:f quarantined Bool) (:f note String))

fn ! chmodTo mode: String path: String -> Bool
  (let [(_ (fr/runOneLimited (fr/job (list "/bin/chmod" mode path) "." (fr/childEnv (list))) (fr/limits 60 4)))] true)

fn ! releaseCase root: String -> ReleaseCase
  (let [(dir (str root "/rel"))
        (_ (st/put! dir (pf/unitIn "R1" "true")))
        (bad "(:cu :id \"R1\" :st merged :lane\n")
        (_ (cd/writeCUnit! dir (pf/cuIn "R1" "queued" "" "")))
        (_ (fileWrite (cd/cuPath dir "R1") bad))
        (ctx (ctxOf dir))
        (_ (cd/surfaceReads! ctx))
        (_ (cd/writeCUnit! dir (pf/cuIn "R1" "queued" "" "")))
        (good (resultOr (fileReadString (cd/cuPath dir "R1")) ""))
        (_ (cd/surfaceReads! ctx))
        (top (stringJoin (filter (fn [(x String)] -> Bool (!= x "released")) (resultOr (dirList (cd/quarantineDir dir)) (list))) " "))
        (rel (stringJoin (resultOr (dirList (str (cd/quarantineDir dir) "/released")) (list)) " "))
        (idsAfter (cd/quarantinedIds dir))
        (_ (fileWrite (cd/cuPath dir "R1") bad))
        (_ (cd/surfaceReads! ctx))
        (_ (cd/writeCUnit! dir (pf/cuIn "R1" "queued" "" "")))
        (_ (cd/surfaceReads! ctx))
        (rel2 (resultOr (dirList (str (cd/quarantineDir dir) "/released")) (list)))
        (top2 (stringJoin rel2 " "))
        (_ (cd/step! ctx (pf/unitIn "R1" "true") 4))
        (kept (and (!= good "") (listAny? (fn [(c cd/CUnit)] -> Bool (and (= c.id "R1") (= c.st "ready"))) (cd/readCUnits! dir))))]
    (ReleaseCase :released (and (stringEmpty? top) (stringStartsWith? rel "R1.") (= (listLength idsAfter) 0)) :top top :rel rel
                 :unique (= (listLength rel2) 2) :top2 top2 :rowKept kept))

fn ! listErrorCase root: String -> ListCase
  (let [(dir (str root "/lst"))
        (_ (st/put! dir (pf/unitIn "L1" "true")))
        (_ (cd/writeCUnit! dir (pf/cuIn "L1" "queued" "" "")))
        (before (resultOr (fileReadString (cd/cuPath dir "L1")) ""))
        (ctx (ctxOf dir))
        (_ (chmodTo "000" (cd/cuPath dir "L1")))
        (_ (cd/surfaceReads! ctx))
        (_ (cd/step! ctx (pf/unitIn "L1" "true") 4))
        (_ (chmodTo "644" (cd/cuPath dir "L1")))
        (after (resultOr (fileReadString (cd/cuPath dir "L1")) ""))
        (q (fileExists? (cd/quarantineDir dir)))]
    (ListCase :rowsSame (and (not (stringEmpty? before)) (= before after)) :quarantined q :note (str "q=" (if q "yes" "no") " same=" (if (= before after) "yes" "no"))))

; (:m :ref COND-TICK-READS :do "40 quarantines of one id in a row, each row with its own bytes, inside the same milliseconds of one process: every row must be kept, in quarantine and after the release, and a second burst released into the same dir must not replace the first; the result is the bytes found, sorted")
fn ! burst! dir: String tag: String -> Bool
  (listAll? (fn [(i Int64)] -> Bool (and (ok? (fileWrite (cd/cuPath dir "B1") (str "(:cu :id \"B1\" :st merged :lane " tag (stringFromInt64 i) "\n"))) (cd/quarantineRow! dir "B1"))) (range 0 40))

fn ! bytesIn d: String -> (List String)
  (listSort (map (fn [(nm String)] -> String (stringTrim (resultOr (fileReadString (str d "/" nm)) "unreadable"))) (filter (fn [(x String)] -> Bool (!= x "released")) (resultOr (dirList d) (list)))))

fn wantBytes tags: (List String) -> (List String)
  (listSort (fold (fn [(acc (List String)) (tag String)] -> (List String) (listAppend acc (map (fn [(i Int64)] -> String (str "(:cu :id \"B1\" :st merged :lane " tag (stringFromInt64 i))) (range 0 40)))) (list) tags))

fn ! burstCase root: String -> (List String)
  (let [(dir (str root "/burst"))
        (q (cd/quarantineDir dir))
        (_ (cd/writeCUnit! dir (pf/cuIn "B1" "queued" "" "")))
        (a (burst! dir "a"))
        (inQ (bytesIn q))
        (_ (cd/writeCUnit! dir (pf/cuIn "B1" "queued" "" "")))
        (relA (cd/releaseQuarantined! dir))
        (inRelA (bytesIn (str q "/released")))
        (b (burst! dir "b"))
        (_ (cd/writeCUnit! dir (pf/cuIn "B1" "queued" "" "")))
        (relB (cd/releaseQuarantined! dir))
        (inRelB (bytesIn (str q "/released")))
        (left (bytesIn q))
        (_ (fileWrite (str q "/B1.5-1") "incoming\n"))
        (_ (fileWrite (str q "/released/B1.5-1") "resident\n"))
        (relC (cd/releaseQuarantined! dir))
        (both (filter (fn [(x String)] -> Bool (or (= x "incoming") (= x "resident"))) (bytesIn (str q "/released"))))]
    (list (if (and a b) "renamesOk" "renameFailed")
          (if (= inQ (wantBytes (list "a"))) "quarantine40" (str "quarantine " (stringFromInt64 (listLength inQ))))
          (if (and (= relA 40) (= inRelA (wantBytes (list "a")))) "released40" (str "released " (stringFromInt64 relA) " files " (stringFromInt64 (listLength inRelA))))
          (if (and (= relB 40) (= inRelB (wantBytes (list "a" "b")))) "released80" (str "released " (stringFromInt64 relB) " files " (stringFromInt64 (listLength inRelB))))
          (if (listEmpty? left) "none left" (str "left " (stringFromInt64 (listLength left))))
          (if (and (= relC 1) (= both (list "incoming" "resident"))) "sameNameKept" (str "same name in released: " (stringJoin both " ")))))

fn ! runTests -> Bool
  (let [(root (pf/scratch "tickReads" "t"))
        (_ (pf/cleanup root))
        (dir (str root "/store"))
        (_ (st/put! dir (pf/unitIn "U1" "true")))
        (_ (st/put! dir (pf/unitIn "U2" "true")))
        (_ (cd/writeCUnit! dir (pf/cuIn "U1" "merged" "" "")))
        (_ (cd/writeCUnit! dir (pf/cuIn "U2" "queued" "" "")))
        (ctx (ctxOf dir))
        (clean (cd/surfaceReads! ctx))
        (leadClean (leadText root))
        (_ (fileWrite (cd/cuPath dir "U2") "(:cu :id \"U2\" :st merged :lane\n"))
        (statusPre (cd/status! ctx))
        (_ (cd/tick! ctx))
        (_ (cd/tick! ctx))
        (_ (cd/tick! ctx))
        (qNames (resultOr (dirList (cd/quarantineDir dir)) (list)))
        (qBytes (match (listHead qNames) ((some nm) (resultOr (fileReadString (str (cd/quarantineDir dir) "/" nm)) "")) ((none) "")))
        (rowBack (fileExists? (cd/cuPath dir "U2")))
        (launched (or (fileExists? (str dir "/launched.U2")) (fileExists? (str dir "/runs/U2-write.run"))))
        (leadOne (leadText root))
        (_ (fileWrite (cd/cuPath dir "U2") "(:cu :id \"U2\" :st merged :lane\n"))
        (_ (cd/surfaceReads! ctx))
        (leadRow (leadText root))
        (statusRow (cd/status! ctx))
        (_ (pathRemove (str dir "/units")))
        (_ (fileWrite (str dir "/units") "not a directory"))
        (_ (pathRemove (cd/cuPath dir "U1")))
        (_ (pathRemove (cd/cuPath dir "U2")))
        (storeSettled (cd/settled? ctx))
        (storeStatus (cd/status! ctx))
        (storeRaised (cd/surfaceReads! ctx))
        (leadStore (leadText root))
        (fresh (ctxOf (str root "/never")))
        (freshSettled (cd/settled? fresh))
        (freshRaised (cd/surfaceReads! fresh))
        (rel (releaseCase root))
        (lst (listErrorCase root))
        (burst (burstCase root))
        (_ (pf/cleanup root))]
    (do (assert (and (= clean 0) (stringEmpty? leadClean)) (str "control: healthy rows raise nothing: " (stringFromInt64 clean) " " leadClean))
        (assert (and (= (countIn leadOne "cuUnreadable") 1) (stringContains? leadOne "\"U2\"")) (str "one tick over a corrupt state row raises one cuUnreadable lead row for its unit: " leadOne))
        (assert (= (countIn leadRow "cuUnreadable") 1) (str "a repeat is still one row: " leadRow))
        (assert (not (stringContains? leadRow ":count 1 ")) (str "the repeat bumped the count instead of adding a row: " leadRow))
        (assert (stringContains? statusPre ":id \"U2\" :st unreadable") (str "before a tick status! lists the unreadable row: " statusPre))
        (assert (and (= (listLength qNames) 1) (= qBytes "(:cu :id \"U2\" :st merged :lane\n")) (str "the corrupt row is in cond/quarantine with its original bytes: " (stringJoin qNames " ") " " qBytes))
        (assert (and (not rowBack) (not launched)) "no fresh queued row was written and the unit was not launched in three ticks")
        (assert (stringContains? statusRow "(:quarantined (\"U2\"))") (str "status! lists the quarantined unit: " statusRow))
        (assert (not storeSettled) "an unreadable store is not settled even with no conductor rows")
        (assert (stringContains? storeStatus "(:store :unreadable") (str "status! names the unreadable store: " storeStatus))
        (assert (and (>= storeRaised 1) (stringContains? leadStore "storeUnreadable")) (str "the tick raises storeUnreadable: " leadStore))
        (assert rel.released (str "a good row back at cond/ID.asn releases the quarantine: " rel.top " / " rel.rel))
        (assert rel.unique (str "a second quarantine of the same id does not collide: " rel.top2))
        (assert (= burst (list "renamesOk" "quarantine40" "released40" "released80" "none left" "sameNameKept")) (str "40 quarantines of one id in a row keep 40 rows, a release keeps them, a second burst released beside them replaces none, and a file released under a name already there keeps both: " (stringJoin burst ", ")))
        (assert rel.rowKept "the released unit proceeds (queued to ready) instead of staying frozen")
        (assert (and lst.rowsSame (not lst.quarantined)) (str "a row whose read fails (transient) is neither quarantined nor overwritten: " lst.note))
        (assert (and freshSettled (= freshRaised 0)) "a store directory that does not exist yet is an empty settled store, not an error")
        true))
