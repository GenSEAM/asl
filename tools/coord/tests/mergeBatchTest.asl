(module asl-tools/coord/tests/mergeBatchTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/fleet/run :a fr) (asl-tools/coord/tests/fixtures/pipeFix :a pf)])

; (:m :ref TRAIN-BATCH-BRANCHES :do "batch merge: a (:train :batch K) ladder row lets one train carry up to K merging units whose branches change disjoint files; a green train merges every member that is in dev afterwards, a red one branch carries alone is that unit's red and a retry for the others, a red of a combination makes every member run alone; the passengers' results reach the conductor through the leader's pass file and each passenger gets its own transition")

fn receipt red: String loss: String -> String
  (str "(:train :head \"abc\" :merged \"def\" :branches (\"sh/A\" \"sh/B\") :changed 2 :selected 2 :cached 0 :ran 2 :green 1 :invariants 0 :red (" red ") :preexisting () :assertLoss (" loss ") :baseKnown 0 :knownRed () :blocked (:fresh 1 :preexisting 0) :seconds 9)")

fn ! testRows -> Bool
  (do (assert (listEmpty? (cd/trainErrors "(:train :batch 4)")) "a batch-only train row is valid")
      (assert (listEmpty? (cd/trainErrors "(:train :jobs 6 :batch 3)")) "jobs and batch together are valid")
      (assert (not (listEmpty? (cd/trainErrors "(:train :batch 0)"))) "a batch of 0 is rejected")
      (assert (not (listEmpty? (cd/trainErrors "(:train :batch 17)"))) "a batch over 16 is rejected")
      (assert (not (listEmpty? (cd/trainErrors "(:train :batch two)"))) "a batch that is no number is rejected")
      (assert (not (listEmpty? (cd/trainErrors "(:train)"))) "a row with neither key is rejected")
      (assert (= (cd/trainBatchOf "") 1) "no row: one unit per train")
      (assert (= (cd/trainBatchOf "(:train :jobs 6)") 1) "a row without :batch: one unit per train")
      (assert (= (cd/trainBatchOf "(:train :batch 0)") 1) "a rejected row: one unit per train")
      (assert (= (cd/trainBatchOf "(:train :jobs 6 :batch 3)") 3) "a valid row sets the batch")
      (assert (= (cd/trainArgv "/d" "sh/X" "(:train :batch 3)") (list "/d/bin/asl" "train" "sh/X" "--onto" "HEAD" "--repo" "/d" "--commit")) "a batch-only row passes no -j")
      (assert (= (cd/trainArgvAll "/d" (list "sh/X" "sh/Y") "(:train :jobs 4 :batch 2)") (list "/d/bin/asl" "train" "sh/X" "sh/Y" "--onto" "HEAD" "--repo" "/d" "--commit" "-j" "4")) "every member branch goes to one train")
      true)

fn ! testPick -> Bool
  (let [(cands (list (pair "B" (some (list "b.txt"))) (pair "C" (some (list "a.txt" "c.txt"))) (pair "D" (none)) (pair "E" (some (list "e.txt"))) (pair "F" (some (list "f.txt")))))
        (three (cd/batchPick 3 (list "a.txt") cands))
        (one (cd/batchPick 1 (list "a.txt") cands))
        (shared (cd/batchPick 4 (list "a.txt") (list (pair "B" (some (list "b.txt"))) (pair "G" (some (list "b.txt"))))))
        (killed (with (pf/cuIn "K" "merging" "" "sh/K") :fails 2 :sig "killed: timeout after 3600 s :running 40 a b c"))
        (red (with (pf/cuIn "R" "merging" "" "sh/R") :fails 1 :sig "train red: a.asl"))]
    (do (assert (= three (list "B" "E")) (str "disjoint candidates in order up to K - 1, one sharing the leader's file and one with unknown files skipped: " (stringJoin three ",")))
        (assert (listEmpty? one) "a batch of 1 carries no passenger")
        (assert (= shared (list "B")) "a candidate sharing a file with an earlier pick is skipped")
        (assert (cd/batchable? (pf/cuIn "N" "merging" "" "sh/N")) "a fresh merging unit may ride")
        (assert (cd/batchable? killed) "a unit whose last train was killed may ride")
        (assert (not (cd/batchable? red)) "a unit whose last train was red runs alone")
        (assert (not (cd/batchable? (with (pf/cuIn "S" "merging" "" "sh/S") :await "solo"))) "a unit marked solo runs alone")
        (assert (not (cd/batchable? (with (pf/cuIn "L" "merging" "" "sh/L") :launched 1))) "a launched unit does not ride")
        true))

fn ! testVerdicts -> Bool
  (let [(bs (list "sh/A" "sh/B"))
        (green (cd/batchVerdicts bs 0 (receipt "" "") bs))
        (notIn (cd/batchVerdicts bs 0 (receipt "" "") (list "sh/A")))
        (oneRed (cd/batchVerdicts bs 1 (receipt "(\"b.asl\" \"sh/B\" 1 1 :kind suite :why alone)" "") (list)))
        (mixed (cd/batchVerdicts bs 1 (receipt "(\"b.asl\" \"sh/A+sh/B\" 1 1 :kind suite :why interaction)" "") (list)))
        (conflict (cd/batchVerdicts bs 1 "(:conflict :branch \"sh/A\" :files (\"x.txt\"))" (list)))
        (loss (cd/batchVerdicts bs 1 (receipt "" "\"a.asl\"") (list)))
        (killed (cd/batchVerdicts bs 124 "(:fleetRun :verdict :timeout :timeoutMs 3600000)" (list)))
        (killedLanded (cd/batchVerdicts bs 124 "(:fleetRun :verdict :timeout :timeoutMs 3600000)" (list "sh/A")))
        (base (cd/batchVerdicts bs 1 "commit failed" (list)))
        (bisect (cd/batchVerdicts (list "sh/A" "sh/B" "sh/C" "sh/D") 1 (receipt "(\"c.asl\" \"sh/C\" 1 1 :kind suite :why bisect)" "") (list)))]
    (do (assert (= green (list "merged" "merged")) (str "a green train merges every member in dev: " (stringJoin green ",")))
        (assert (= notIn (list "merged" "fail")) (str "a member not in dev after a green train is never merged: " (stringJoin notIn ",")))
        (assert (= oneRed (list "rebatch" "red")) (str "a red one branch carries alone is its red and a retry for the other: " (stringJoin oneRed ",")))
        (assert (= mixed (list "solo" "solo")) (str "a red of a combination makes every member run alone: " (stringJoin mixed ",")))
        (assert (= conflict (list "red" "rebatch")) (str "a conflict naming one branch is its failure and a retry for the other: " (stringJoin conflict ",")))
        (assert (= loss (list "solo" "solo")) (str "an assert loss no branch carries makes every member run alone: " (stringJoin loss ",")))
        (assert (= killed (list "solo" "solo")) (str "a killed batch counts against no member and sends every member to a train of its own: " (stringJoin killed ",")))
        (assert (= killedLanded (list "merged" "solo")) (str "a member whose commits landed in dev before the kill is merged: " (stringJoin killedLanded ",")))
        (assert (= base (list "fail" "fail")) (str "a failure naming no branch fails every member: " (stringJoin base ",")))
        (assert (= bisect (list "rebatch" "rebatch" "solo" "rebatch")) (str "a red a bisection names is solo for that branch, never its own red: " (stringJoin bisect ",")))
        (assert (= (cd/batchRes "rebatch" "train red: b.asl" 5).verdict "rebatch") "a retry keeps its own verdict")
        (assert (= (cd/batchRes "red" "train red: b.asl" 5).sig "train red: b.asl") "a red member carries the train signature as a single train does")
        (assert (= (cd/batchRes "merged" "" 5).ok 1) "a merged member is ok")
        true))

; (:m :do "the dev clone's stand-in train records its argv, prints .git/trainOut and exits 1 when that file exists, else merges every branch argument before --onto")
fn standIn -> String
  "#!/bin/sh\nif [ \"$1\" = audit ]; then echo \"(:audit :sub $2 :status :passed)\"; exit 0; fi\nD=$(cd \"$(dirname \"$0\")/..\" && pwd)\necho \"$@\" >> \"$D/.git/trainArgs\"\nshift\nif [ -f \"$D/.git/trainOut\" ]; then cat \"$D/.git/trainOut\"; exit 1; fi\nfor b in \"$@\"; do [ \"$b\" = --onto ] && break; git -C \"$D\" merge --no-ff -q -m \"train $b\" \"$b\" || exit 1; done\nexit 0\n"

fn stubPass rc: cd/RealCfg c: cd/CUnit base: String -> (Pair Int64 String)
  (pair 0 "(:mergeCheck :verdict pass)")

fn ctxOf dir: String -> cd/Ctx
  (cd/Ctx :dir dir :holder "mergeBatchTest" :ttlMs 600000 :maxWait 0 :maxSame 3 :stageSec 60 :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "/usr/bin/true")) :pace (cd/fixedPace 8 8))

fn ! cuOf dir: String id: String -> cd/CUnit
  (optionOr (listFind (fn [(c cd/CUnit)] -> Bool (= c.id id)) (cd/readCUnits! dir)) (pf/cuIn id "gone" "" ""))

; (:m :do "claim the unit's lease and store its conductor row merging with that epoch and the launched flag")
fn ! claimed! dir: String id: String wt: String launched: Int64 -> cd/CUnit
  (let [(epoch (match (st/claim! dir id "mergeBatchTest" 600000) ((ok t) (match (st/parseLease t) ((ok l) l.epoch) ((err _) 0))) ((err _) 0)))
        (c (with (pf/cuIn id "merging" wt (str "sh/" id)) :epoch epoch :launched launched))
        (_ (cd/writeCUnit! dir c))]
    c)

fn ! inDev? dev: String branch: String -> Bool
  (= (fr/runOneLimited (fr/job (list "git" "-C" dev "merge-base" "--is-ancestor" branch "HEAD") dev (fr/childEnv (list))) (fr/limits 60 0)).exit 0)

fn ! transitions dir: String id: String -> Int64
  (listLength (filter (fn [(l String)] -> Bool (stringContains? l (str "(:t :unit \"" id "\" "))) (pf/journalLines dir)))

; (:m :do "launch planning in the conductor: three merging units, J3 sharing J1's file; with (:train :batch 3) J1's launch writes a batch file naming J2 alone and J2, still unlaunched, does not start a train of its own; with no row no batch file is written")
fn ! testPlan root: String -> Bool
  (let [(repo (pf/repoIn root))
        (store (str root "/store"))
        (u1 (pf/unitIn "J1" "true")) (u2 (pf/unitIn "J2" "true")) (u3 (pf/unitIn "J3" "true"))
        (w1 (pf/seedUnit! root u1 "merging" "impl.txt"))
        (w2 (pf/seedUnit! root u2 "merging" "impl2.txt"))
        (w3 (pf/seedUnit! root u3 "merging" "impl.txt"))
        (_ (fileWrite (cd/repoPath store) repo))
        (ctx (ctxOf store))
        (_ (fileWrite (str store "/ladder.asn") ""))
        (plain (cd/batchPlan! ctx u1 (cuOf store "J1")))
        (plainFile (fileExists? (cd/batchPath store "J1")))
        (_ (fileWrite (str store "/ladder.asn") "(:train :batch 3)\n"))
        (c1 (cd/launch! ctx u1 (cuOf store "J1")))
        (batch (resultOr (fileReadString (cd/batchPath store "J1")) ""))
        (pass (map (fn [(p (Pair st/Task cd/CUnit))] -> String (pairFirst p).id) (cd/passengersOf! store "J1")))
        (j2 (cd/launch! ctx u2 (cuOf store "J2")))]
    (do (assert (and (not (stringEmpty? repo)) (and (not (stringEmpty? w1)) (and (not (stringEmpty? w2)) (not (stringEmpty? w3))))) "fixture: source repo and three unit branches")
        (assert (and (listEmpty? plain) (not plainFile)) "no batch row: no passenger and no batch file")
        (assert (= c1.launched 1) "the leader's merge child is launched")
        (assert (= batch "(:batch :leader \"J1\" :units (\"J2\"))\n") (str "the batch file names J2, the unit with disjoint files, and not J3: " batch))
        (assert (= pass (list "J2")) (str "the child reads J2 as the passenger: " (stringJoin pass ",")))
        (assert (and (= j2.st "merging") (= j2.launched 0)) (str "the passenger waits unlaunched while the leader's train runs: " j2.st))
        true))

; (:m :ref BATCH-AFTER-RED :do "a unit with failures may ride again once its branch head differs from the head of its last red train (it was fixed and passed gating and review again); one whose head is still that train's runs alone, and a fixed unit may also lead a batch")
fn ! testRedFixed root: String -> Bool
  (let [(repo (pf/repoIn root))
        (store (str root "/store"))
        (u1 (pf/unitIn "R1" "true")) (u2 (pf/unitIn "R2" "true")) (u3 (pf/unitIn "R3" "true"))
        (w1 (pf/seedUnit! root u1 "merging" "impl.txt"))
        (w2 (pf/seedUnit! root u2 "merging" "r2.txt"))
        (w3 (pf/seedUnit! root u3 "merging" "r3.txt"))
        (_ (fileWrite (cd/repoPath store) repo))
        (_ (fileWrite (str store "/ladder.asn") "(:train :batch 3)\n"))
        (_ (dirCreate (cd/runsDir store)))
        (redSig "train red: asl/a/aTest.asl")
        (h2 (cd/unitHead! store "R2"))
        (_ (fileWrite (cd/redTrainPath store "R2") (str "(:redTrain :unit \"R2\" :head " (st/q h2) " :base \"b0\" :sig " (st/q redSig) " :at 1)\n")))
        (_ (fileWrite (cd/redTrainPath store "R3") (str "(:redTrain :unit \"R3\" :head \"000000001\" :base \"b0\" :sig " (st/q redSig) " :at 1)\n")))
        (c2 (with (cuOf store "R2") :fails 1 :sig redSig))
        (c3 (with (cuOf store "R3") :fails 1 :sig redSig))
        (_ (cd/writeCUnit! store c2))
        (_ (cd/writeCUnit! store c3))
        (ctx (ctxOf store))
        (picked (cd/batchPlan! ctx u1 (cuOf store "R1")))
        (led (cd/batchPlan! ctx u3 c3))
        (noRecord (cd/batchableNow! store (with (pf/cuIn "R9" "merging" "" "sh/R9") :fails 1 :sig redSig)))]
    (do (assert (and (not (stringEmpty? repo)) (and (not (stringEmpty? w2)) (and (not (stringEmpty? w3)) (not (stringEmpty? h2))))) "fixture: source repo and three unit branches")
        (assert (= picked (list "R3")) (str "the unit fixed since its red rides, the unchanged one does not: " (stringJoin picked ",")))
        (refute (cd/batchable? c3) "the pure rule alone still keeps a unit with a red out")
        (assert (cd/batchableNow! store c3) "a changed head since the last red makes it batchable")
        (refute (cd/batchableNow! store c2) "the head of its last red train keeps it alone")
        (refute noRecord "failures and no red record: alone as before")
        (assert (= led (list "R1")) (str "a fixed unit may lead a batch: " (stringJoin led ",")))
        true))

; (:m :do "the merge child over a batch and the conductor applying its result: a red the stand-in train attributes to sh/B2 alone keeps both out of dev, B2 counts a merge failure, B1 is retried with its count untouched and its next launch carries no passenger, since B2's last train was red; a green batch of G1 and G2 merges both into dev and moves both to merged, each with its own transition")
fn ! testRun root: String -> Bool
  (let [(repo (pf/repoIn root))
        (store (str root "/store"))
        (_ (fileWrite (cd/repoPath store) repo))
        (dev (pf/devCloneFor! root))
        (_ (fileWrite (str dev "/bin/asl") (standIn)))
        (rc (cd/realCfg (list "--repo" (str root "/repo") "--dev-repo" dev "--dev" "dev" "--worktrees" (str root "/wts") "--home" (str root "/home")) store))
        (ctx (ctxOf store))
        (_ (fileWrite (str store "/ladder.asn") "(:train :batch 2)\n"))
        (ub1 (with (pf/unitIn "B1" "true") :owns (list "b1.txt"))) (ub2 (with (pf/unitIn "B2" "true") :owns (list "b2.txt")))
        (wb1 (pf/seedUnit! root ub1 "merging" "b1.txt"))
        (wb2 (pf/seedUnit! root ub2 "merging" "b2.txt"))
        (cb1 (claimed! store "B1" wb1 1))
        (cb2 (claimed! store "B2" wb2 0))
        (_ (dirCreate (cd/runsDir store)))
        (_ (fileWrite (cd/batchPath store "B1") "(:batch :leader \"B1\" :units (\"B2\"))\n"))
        (_ (fileWrite (str dev "/.git/trainOut") (str "(:redLive \"b.asl\" 1 1 :kind suite)\n" (stringReplace (receipt "(\"b.asl\" \"sh/B2\" 1 1 :kind suite :why alone)" "") "sh/A" "sh/B1") "\n")))
        (rRed (cd/mergeBatchWith rc store ub1 cb1 stubPass))
        (passRed (resultOr (fileReadString (cd/passPath store "B1")) ""))
        (args (resultOr (fileReadString (str dev "/.git/trainArgs")) ""))
        (redOut (and (not (inDev? dev "sh/B1")) (not (inDev? dev "sh/B2"))))
        (_ (cd/finish! ctx ub1 cb1 rRed))
        (b1 (cuOf store "B1"))
        (b2 (cuOf store "B2"))
        (b1Batch (fileExists? (cd/batchPath store "B1")))
        (_ (pathRemove (str dev "/.git/trainOut")))
        (ug1 (with (pf/unitIn "G1" "true") :owns (list "g1.txt"))) (ug2 (with (pf/unitIn "G2" "true") :owns (list "g2.txt")))
        (wg1 (pf/seedUnit! root ug1 "merging" "g1.txt"))
        (wg2 (pf/seedUnit! root ug2 "merging" "g2.txt"))
        (cg1 (claimed! store "G1" wg1 1))
        (cg2 (claimed! store "G2" wg2 0))
        (_ (fileWrite (cd/batchPath store "G1") "(:batch :leader \"G1\" :units (\"G2\"))\n"))
        (rGreen (cd/mergeBatchWith rc store ug1 cg1 stubPass))
        (greenIn (and (inDev? dev "sh/G1") (inDev? dev "sh/G2")))
        (_ (cd/finish! ctx ug1 cg1 rGreen))
        (g1 (cuOf store "G1"))
        (g2 (cuOf store "G2"))
        (passGone (not (fileExists? (cd/passPath store "G1"))))]
    (do (assert (and (not (stringEmpty? repo)) (and (not (stringEmpty? dev)) (and (not (stringEmpty? wb1)) (not (stringEmpty? wg2))))) "fixture: dev clone with the stand-in train and four unit branches")
        (assert (and (> cb1.epoch 0) (> cg2.epoch 0)) "leases claimed for the members")
        (assert (stringContains? args "train sh/B1 sh/B2 --onto HEAD") (str "one train carries both members: " args))
        (assert (= rRed.verdict "rebatch") (str "the leader B1, not named by the red, is retried: " rRed.verdict " " rRed.sig))
        (assert (stringContains? passRed "(:pass :unit \"B2\" :epoch ") (str "the pass file carries B2's row: " passRed))
        (assert (stringContains? passRed ":sig \"train red: b.asl\"") (str "B2's row is the train red: " passRed))
        (assert redOut "a red train leaves both branches out of dev")
        (assert (and (= b2.st "merging") (= b2.fails 1)) (str "B2 counts one merge failure: " b2.st " " (stringFromInt64 b2.fails)))
        (assert (= b2.sig "train red: b.asl") (str "with the train signature: " b2.sig))
        (assert (and (= b1.st "merging") (= b1.fails 0)) (str "B1 stays merging with no failure: " b1.st " " (stringFromInt64 b1.fails)))
        (assert (= b1.launched 1) "B1 is launched again")
        (assert (not b1Batch) "and its next train carries no passenger: B2's last train was red")
        (assert (and (>= (transitions store "B1") 1) (>= (transitions store "B2") 1)) "each member journals its own transition")
        (assert (= rGreen.ok 1) (str "the green batch merges the leader: " rGreen.sig))
        (assert greenIn "both green members are in dev")
        (assert (= g1.st "merged") (str "G1 is merged: " g1.st))
        (assert (= g2.st "merged") (str "G2, the passenger, is merged through the pass file: " g2.st))
        (assert passGone "the pass file is consumed")
        true))

; (:m :ref TRAIN-BATCH-BRANCHES :do "the merge-check budget of a batch: when every member's check uses all it is given, the members' grants sum to the one clamped budget for every K in 1..16, so checks plus the 3600 s train plus 60 s stay under the 5400 s stage deadline; one member gets the whole budget as a single merge does")
fn ! testBudget -> Bool
  (let [(total (cd/clampMergeCheckSec 1200 5400))
        (grants (fn [(k Int64)] -> (List Int64)
                  (pairFirst (fold (fn [(acc (Pair (List Int64) Int64)) (i Int64)] -> (Pair (List Int64) Int64)
                                     (let [(g (cd/checkBudgetLeft total (pairSecond acc)))] (pair (listAppend (pairFirst acc) (list g)) (+ (pairSecond acc) g))))
                                   (pair (list) 0) (range 0 k)))))
        (sums (map (fn [(k Int64)] -> Int64 (fold (fn [(a Int64) (g Int64)] -> Int64 (+ a g)) 0 (grants k))) (range 1 17)))]
    (do (assert (= (grants 1) (list total)) (str "one member gets the whole budget: " (stringFromInt64 total)))
        (assert (listAll? (fn [(x Int64)] -> Bool (<= (+ (+ x (cd/trainLimitSec)) 60) 5400)) sums) "checks plus train plus margin fit the stage deadline for every K")
        (assert (listAll? (fn [(x Int64)] -> Bool (= x total)) sums) "the grants of every K add up to the one budget, never more")
        (assert (= (cd/checkBudgetLeft 1200 1141) 0) "under 60 s left grants nothing")
        (assert (= (cd/checkBudgetLeft 1200 1140) 60) "60 s left is granted")
        true))

; (:m :do "the injected clock: the seconds written in HOME/clock, 0 before any check ran")
fn ! fakeClock rc: cd/RealCfg -> Int64
  (optionOr (stringToInt64 (stringTrim (resultOr (fileReadString (str rc.home "/clock")) "0"))) 0)

; (:m :do "a check stub that records the budget it was given and moves the injected clock 3 s on")
fn ! slowCheck rc: cd/RealCfg c: cd/CUnit base: String -> (Pair Int64 String)
  (let [(_ (fileAppend (str rc.home "/checks") (str c.id " " (stringFromInt64 rc.mergeCheckSec) "\n")))
        (_ (fileWrite (str rc.home "/clock") (stringFromInt64 (+ (fakeClock rc) 3))))]
    (pair 0 "(:mergeCheck :verdict pass)"))

; (:m :do "a dev clone and two merging members in a fresh root; returns the store, the RealCfg and the two units")
fn ! twoMembers! root: String a: String b: String extra: (List String) -> (Pair cd/RealCfg (Pair (Pair st/Task cd/CUnit) (Pair st/Task cd/CUnit)))
  (let [(repo (pf/repoIn root))
        (store (str root "/store"))
        (_ (fileWrite (cd/repoPath store) repo))
        (dev (pf/devCloneFor! root))
        (_ (fileWrite (str dev "/bin/asl") (standIn)))
        (rc (cd/realCfg (listAppend (list "--repo" (str root "/repo") "--dev-repo" dev "--dev" "dev" "--worktrees" (str root "/wts") "--home" (str root "/home")) extra) store))
        (ua (with (pf/unitIn a "true") :owns (list (str a ".txt")))) (ub (with (pf/unitIn b "true") :owns (list (str b ".txt"))))
        (wa (pf/seedUnit! root ua "merging" (str a ".txt")))
        (wb (pf/seedUnit! root ub "merging" (str b ".txt")))
        (ca (claimed! store a wa 1))
        (cb (claimed! store b wb 0))
        (_ (dirCreate (cd/runsDir store)))
        (_ (fileWrite (cd/batchPath store a) (str "(:batch :leader \"" a "\" :units (\"" b "\"))\n")))]
    (pair rc (pair (pair ua ca) (pair ub cb))))

; (:m :do "the shared budget in the child: with --merge-check-sec 62 the leader's check gets 62 s and spends 3, so the passenger has under 60 s left: it is not checked and is retried in a later train, and the train carries the leader alone")
fn unitRow p: (Pair st/Task cd/CUnit) -> cd/CUnit
  (pairSecond p)

fn ! testBudgetRun root: String -> Bool
  (let [(fx (twoMembers! root "C1" "C2" (list "--merge-check-sec" "62")))
        (rc (pairFirst fx)) (lead (pairFirst (pairSecond fx)))
        (r (cd/mergeBatchClocked rc (str root "/store") (pairFirst lead) (pairSecond lead) slowCheck fakeClock))
        (checks (resultOr (fileReadString (str rc.home "/checks")) ""))
        (pass (resultOr (fileReadString (cd/passPath (str root "/store") "C1")) ""))
        (args (resultOr (fileReadString (str rc.devRepo "/.git/trainArgs")) ""))]
    (do (assert (= checks "C1 62\n") (str "only the leader is checked, with the whole budget: " checks))
        (assert (stringContains? pass ":verdict \"rebatch\"") (str "the passenger with no budget left is retried: " pass))
        (assert (stringContains? args "train sh/C1 --onto HEAD") (str "the train carries the checked leader alone: " args))
        (assert (= r.ok 1) (str "the leader merges: " r.sig))
        true))

; (:m :do "the passenger's check is given what the leader left: with --merge-check-sec 200 the leader gets 200 and spends 3 on the injected clock, so the passenger gets 197")
fn ! testBudgetShare root: String -> Bool
  (let [(fx (twoMembers! root "D1" "D2" (list "--merge-check-sec" "200")))
        (rc (pairFirst fx)) (lead (pairFirst (pairSecond fx)))
        (r (cd/mergeBatchClocked rc (str root "/store") (pairFirst lead) (pairSecond lead) slowCheck fakeClock))
        (lines (filter (fn [(l String)] -> Bool (not (stringEmpty? l))) (stringLines (resultOr (fileReadString (str rc.home "/checks")) ""))))
        (second (optionOr (stringToInt64 (stringReplace (optionOr (listGet lines 1) "") "D2 " "")) 0))]
    (do (assert (= (optionOr (listHead lines) "") "D1 200") (str "the leader's check gets the whole budget: " (stringJoin lines "|")))
        (assert (= second 197) (str "the passenger's check gets the 200 s less the 3 s the leader spent: " (stringJoin lines "|")))
        (assert (= r.ok 1) (str "the batch merges: " r.sig))
        true))

; (:m :do "a killed batch: K1, already at one kill, and K2 ride one train the stand-in kills; both stay merging with their fail counts untouched and run solo from then on")
fn ! testKillSolo root: String -> Bool
  (let [(fx (twoMembers! root "K1" "K2" (list)))
        (store (str root "/store"))
        (rc (pairFirst fx)) (lead (pairFirst (pairSecond fx)))
        (c1 (with (unitRow lead) :fails 1 :sig "killed: timeout after 3600 s :running 20 a b c"))
        (_ (cd/writeCUnit! store c1))
        (_ (fileWrite (str rc.devRepo "/.git/trainOut") "(:trainRunning :items (\"a\" \"b\"))\n(:fleetRun :verdict :timeout :timeoutMs 3600000)\n"))
        (r (cd/mergeBatchWith rc store (pairFirst lead) c1 stubPass))
        (_ (cd/finish! (ctxOf store) (pairFirst lead) c1 r))
        (k1 (cuOf store "K1"))
        (k2 (cuOf store "K2"))
        (uk1 (pairFirst lead))
        (uk2 (pairFirst (pairSecond (pairSecond fx))))
        (_ (cd/finish! (ctxOf store) uk2 k2 (cd/batchRes "merged" "" 1)))
        (k2Merged (cuOf store "K2"))
        (e1 (cd/mergeFail! (ctxOf store) uk1 k1 "train red: z.asl" 1))
        (e2 (cd/mergeFail! (ctxOf store) uk1 e1 "train red: z.asl" 1))
        (e3 (cd/mergeFail! (ctxOf store) uk1 e2 "train red: z.asl" 1))]
    (do (assert (= r.verdict "solo") (str "the leader of a killed batch goes solo: " r.verdict))
        (assert (and (= k1.fails 1) (= k1.await "solo")) (str "K1 keeps its one kill and runs alone next: " (stringFromInt64 k1.fails) " " k1.await))
        (assert (and (= k2.fails 0) (= k2.await "solo")) (str "K2 is charged nothing and runs alone next: " (stringFromInt64 k2.fails) " " k2.await))
        (assert (not (cd/batchable? (with k2 :launched 0))) "a solo unit never rides again")
        (assert (and (= k2Merged.st "merged") (= k2Merged.await "")) (str "a solo unit that merges drops the mark: " k2Merged.st " " k2Merged.await))
        (assert (= e2.await "solo") "a retried solo unit keeps the mark")
        (assert (and (= e3.st "blocked") (!= e3.await "solo")) (str "a solo unit that escalates drops the mark: " e3.st " " e3.await))
        true))

; (:m :do "applyPassengers! guards: a pass row whose epoch differs from the unit's, or for a unit already launched, is journalled stale and changes nothing; rows with a verdict of their own are applied before retries, so a retried unit's next train never carries a member that just merged")
fn ! testApply root: String -> Bool
  (let [(fx (twoMembers! root "Q1" "Q2" (list)))
        (store (str root "/store"))
        (ctx (ctxOf store))
        (_ (fileWrite (str store "/ladder.asn") "(:train :batch 2)\n"))
        (q1 (unitRow (pairFirst (pairSecond fx))))
        (q2 (unitRow (pairSecond (pairSecond fx))))
        (q1Idle (with q1 :launched 0))
        (_ (cd/writeCUnit! store q1Idle))
        (red (with (cd/batchRes "red" "train red: x.asl" 1) :ms 1))
        (_ (fileWrite (cd/passPath store "L0") (str (cd/passRow "Q2" (+ q2.epoch 1) red) "\n")))
        (wrongEpoch (cd/applyPassengers! ctx (pf/cuIn "L0" "merging" "" "")))
        (afterEpoch (cuOf store "Q2"))
        (_ (cd/writeCUnit! store (with q2 :launched 1)))
        (_ (fileWrite (cd/passPath store "L0") (str (cd/passRow "Q2" q2.epoch red) "\n")))
        (launched (cd/applyPassengers! ctx (pf/cuIn "L0" "merging" "" "")))
        (afterLaunched (cuOf store "Q2"))
        (_ (cd/writeCUnit! store q2))
        (stale (listLength (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:batchStale :unit \"Q2\"")) (pf/journalLines store))))
        (_ (fileWrite (cd/passPath store "L0") (str (cd/passRow "Q1" q1.epoch (cd/batchRes "rebatch" "train red: x.asl" 1)) "\n" (cd/passRow "Q2" q2.epoch (cd/batchRes "merged" "" 1)) "\n")))
        (both (cd/applyPassengers! ctx (pf/cuIn "L0" "merging" "" "")))
        (q1After (cuOf store "Q1"))
        (q2After (cuOf store "Q2"))
        (q1Batch (fileExists? (cd/batchPath store "Q1")))]
    (do (assert (and (= wrongEpoch 0) (and (= afterEpoch.fails 0) (= afterEpoch.st "merging"))) (str "a row of another epoch is not applied: " (stringFromInt64 wrongEpoch) " " (stringFromInt64 afterEpoch.fails)))
        (assert (and (= launched 0) (= afterLaunched.fails 0)) (str "a row for a launched unit is not applied: " (stringFromInt64 launched) " " (stringFromInt64 afterLaunched.fails)))
        (assert (= stale 2) (str "each skipped row is journalled stale: " (stringFromInt64 stale)))
        (assert (= both 2) (str "both rows of the last pass file are applied: " (stringFromInt64 both)))
        (assert (= q2After.st "merged") (str "Q2 merges: " q2After.st))
        (assert (and (= q1After.st "merging") (= q1After.launched 1)) (str "Q1 is retried: " q1After.st))
        (refute q1Batch "Q1's next train carries no passenger: Q2 merged before Q1 was relaunched")
        true))

fn ! runTests -> Bool
  (let [(root (pf/scratch "mergeBatch" "w"))
        (_ (pf/cleanup root))
        (_ (dirCreate root))
        (plan (testPlan (str root "/plan")))
        (run (testRun (str root "/run")))
        (budget (testBudgetRun (str root "/budget")))
        (share (testBudgetShare (str root "/share")))
        (kill (testKillSolo (str root "/kill")))
        (apply (testApply (str root "/apply")))
        (redFixed (testRedFixed (str root "/redFixed")))
        (_ (pf/cleanup root))
        (stubGone (fr/stubRemove!))]
    (do (assert (testRows) "batch rows and train argv")
        (assert (testPick) "batch pick and eligibility")
        (assert (testVerdicts) "batch verdicts per branch")
        (assert plan "the conductor plans a batch at launch")
        (assert run "the merge child runs one train and the conductor applies every member's result")
        (assert (testBudget) "the batch merge-check budget arithmetic")
        (assert budget "the child shares the merge-check budget")
        (assert share "a passenger's check gets what the leader left")
        (assert kill "a killed batch goes solo without a count")
        (assert apply "applyPassengers! guards and order")
        (assert redFixed "a unit fixed since its red rides again")
        (assert stubGone "the stand-in host dir of this run is removed")
        true))
