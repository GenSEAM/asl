(module asl-tools/coord/tests/trainDeadlineTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/coord/tests/fixtures/pipeFix :a pf)])

; (:m :ref MERGE-SPEED-COND :do "a tiered train's heavy phase counts for a kill's :running tail and progress, and a train ended by its phase deadline (:trainDeadline) charges no unit a fail: it retries while its unfinished suites fit the train limit and progress, else blocks await trainDeadline until the limit grows; solo and batch")

fn ctxFor root: String -> cd/Ctx
  (cd/Ctx :dir (str root "/store") :holder "deadlineTest" :ttlMs 3600000 :maxWait 5 :maxSame 3 :stageSec 5400 :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "/usr/bin/true")) :pace (cd/fixedPace 8 8))

fn ! cuNow root: String id: String -> cd/CUnit
  (optionOr (listFind (fn [(x cd/CUnit)] -> Bool (= x.id id)) (cd/readCUnits! (str root "/store"))) (pf/cuIn id "absent" "" ""))

fn resOf sig: String verdict: String -> cd/Res
  (cd/Res :ok 0 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig sig :ms 0 :exit 1 :asserts 0 :verdict verdict :tiers "")

; (:m :do "the unit merging with a live lease, the fail count and signature of its last merge, then one merge result")
fn ! fin! root: String u: st/Task fails: Int64 prev: String res: cd/Res -> cd/CUnit
  (finCtx! root (ctxFor root) u fails prev res)

fn ! finCtx! root: String ctx: cd/Ctx u: st/Task fails: Int64 prev: String res: cd/Res -> cd/CUnit
  (let [(store (str root "/store"))
        (c0 (cuNow root u.id))
        (epoch (if (> c0.epoch 0) c0.epoch (match (st/claim! store u.id "deadlineTest" 3600000) ((ok t) (match (st/parseLease t) ((ok l) l.epoch) ((err _) 0))) ((err _) 0))))
        (c (with c0 :st "merging" :epoch epoch :launched 1 :fails fails :sig prev :await ""))
        (_ (cd/writeCUnit! store c))
        (_ (cd/finish! ctx u c res))]
    (cuNow root u.id))

fn ! seeded! root: String id: String -> st/Task
  (let [(u (pf/unitIn id "true"))
        (_ (pf/seedUnit! root u "merging" (str id ".txt")))]
    u)

fn ! attempt! root: String id: String sig: String out: String -> Bool
  (let [(store (str root "/store"))
        (tdir (cd/trainsDir store id))
        (_ (dirCreate (str store "/trains")))
        (_ (dirCreate tdir))]
    (ok? (fileWrite (str tdir "/000001.out")
                    (str "(:trainAttempt :unit " (st/q id) " :n 1 :branch " (st/q (str "sh/" id)) " :at 1 :exit 1 :ms 5 :verdict \"exit\" :sig " (st/q sig) ")\n" out))))

fn estimate estS: Int64 -> String
  (str "(:trainEstimate :tier (:estimateS " (n estS) " :heavyS 600 :deadlineFactorPct 150 :deadlineFloorS 300 :unknownS 60 :split true :light (:n 2 :estimateS 100 :deadlineS 300) :heavy (:n 2 :estimateS " (n (- estS 100)) " :deadlineS 900) :unrecorded 0))")

fn n i: Int64 -> String
  (stringFromInt64 i)

fn lightRows -> (List String)
  (list "(:trainRunning :items (\"a\" \"b\"))" "(:itemDone \"a\" 0)" "(:itemDone \"b\" 0)" "(:trainPhase :name \"light\" :ms 90000)")

fn deadlineOut estS: Int64 left: (List String) -> String
  (stringJoin (listAppend (cons (estimate estS) (lightRows))
                          (list "(:trainRunning :items (\"h1\" \"h2\"))" "(:itemDone \"h1\" 0)"
                                (str "(:trainDeadline :phase \"heavy\" :deadlineS 900 :elapsedS 950 :nextSuite \"h2\" :unstarted " (n (listLength left)) ")")
                                "(:trainPhase :name \"heavy\" :ms 950000)"
                                "(:train :head \"abc\" :merged \"def\" :branches (\"sh/D1\" \"sh/D2\") :changed 1 :selected 4 :cached 0 :ran 3 :green 3 :invariants 0 :red () :preexisting () :assertLoss () :baseKnown 0 :knownRed () :blocked (:fresh 0 :preexisting 0) :unrunN 1 :deadline (:unrun (\"h2\")) :seconds 990)"))
              "\n")

fn ! runTests -> Bool
  (let [(root (pf/scratch "trainDeadline" "w"))
        (_ (pf/cleanup root))
        (store (str root "/store"))
        (repo (pf/repoIn root))
        (_ (fileWrite (cd/repoPath store) repo))
        (ctx (ctxFor root))
        ; (:m :do "a kill in the heavy phase names the heavy suite it had not finished; a kill in the light phase counts the heavy tier not yet listed")
        (heavyKill (cd/trainSig (listAppend (cons (estimate 1000) (lightRows)) (list "(:trainRunning :items (\"h1\" \"h2\"))" "(:itemDone \"h1\" 0)" "(:fleetRun :verdict :timeout :timeoutMs 3600000)"))))
        (lightKill (cd/trainSig (list (estimate 1000) "(:trainRunning :items (\"a\" \"b\"))" "(:itemDone \"a\" 0)" "(:fleetRun :verdict :timeout :timeoutMs 3600000)")))
        (untiered (cd/heavyPending (list "(:trainEstimate :tier (:estimateS 50 :split false :light (:n 3 :estimateS 50 :deadlineS 300) :heavy (:n 0 :estimateS 0 :deadlineS 300)))")))
        (afterRerun (cd/stillRunning (list "(:trainRunning :items (\"a\"))" "(:itemDone \"a\" 0)" "(:trainRunning :items (\"x\"))")))
        ; (:m :do "the deadline row gives an infra signature with the unfinished tail")
        (out (deadlineOut 1001 (list "h2")))
        (sig (cd/trainSig (stringLines out)))
        (gate (cd/gateSig out))
        (bv (cd/batchVerdicts (list "sh/D1" "sh/D2") 1 out (list)))
        (bres (cd/batchRes "deadline" sig 7))
        (leftS (cd/deadlineLeftS out 1))
        ; (:m :do "solo: the unit's earlier fails stay, no new one is charged, the next train starts")
        (u1 (seeded! root "D1"))
        (_ (attempt! root "D1" sig out))
        (a1 (fin! root u1 2 "killed: timeout after 3600 s" (resOf sig "fail")))
        (j1 (stringJoin (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:trainDeadline ")) (pf/journalLines store)) "|"))
        ; (:m :do "batch: a passenger result with the deadline verdict takes the same path")
        (u2 (seeded! root "D2"))
        (_ (attempt! root "D2" sig out))
        (a2 (fin! root u2 1 "rebatch: x" bres))
        (_ (st/release! store "D2" a2.epoch))
        ; (:m :do "the same deadline again with no fewer unfinished suites blocks await trainDeadline, still with no fail")
        (a3 (fin! root u1 2 sig (resOf sig "fail")))
        (lease3 (resultOr (fileReadString (st/leasePath store "D1")) ""))
        ; (:m :do "unfinished suites over the train limit block at once")
        (_ (fileWrite (str store "/ladder.asn") "(:train :limitS 600)\n"))
        (u4 (seeded! root "D4"))
        (bigOut (deadlineOut 8001 (list "h2")))
        (bigSig (cd/trainSig (stringLines bigOut)))
        (_ (attempt! root "D4" bigSig bigOut))
        (a4 (fin! root u4 1 "killed: timeout after 3600 s" (resOf bigSig "fail")))
        (note4 (resultOr (fileReadString (cd/deadlinePath store "D4")) ""))
        (stay4 (cd/retryBlocked! ctx (list u4)))
        (still4 (cuNow root "D4"))
        ; (:m :do "a larger limit that fits wakes it back to merging")
        (_ (fileWrite (str store "/ladder.asn") "(:train :limitS 3000)\n"))
        (stay1 (cd/retryBlocked! ctx (list u1)))
        (still1 (cuNow root "D1"))
        (woke4 (cd/retryBlocked! ctx (list u4)))
        (back4 (cuNow root "D4"))
        ; (:m :do "requeue forgets the deadline note and the retry counter")
        (hadNote (and (not (stringEmpty? (resultOr (fileReadString (cd/deadlinePath store "D1")) ""))) (not (stringEmpty? (resultOr (fileReadString (cd/deadlineLeftPath store "D1")) "")))))
        (_ (cd/requeueOne! ctx (list u1) "D1"))
        (gone (or (not (stringEmpty? (resultOr (fileReadString (cd/deadlinePath store "D1")) ""))) (not (stringEmpty? (resultOr (fileReadString (cd/deadlineLeftPath store "D1")) "")))))
        ; (:m :do "one counter per unit across phases and outcome kinds: a light then a heavy deadline with fewer suites left retry, a kill between does not make the next deadline fresh, and the same count again blocks")
        (u5 (seeded! root "D5"))
        (b1 (fin! root u5 0 "" (resOf "trainDeadline: light :running 3 a" "fail")))
        (b2 (fin! root u5 b1.fails b1.sig (resOf "trainDeadline: heavy :running 2 h1" "fail")))
        (b3 (fin! root u5 b2.fails b2.sig (resOf "killed: timeout after 3600 s :running 2 h1" "fail")))
        (b4 (fin! root u5 b3.fails b3.sig (resOf "trainDeadline: light :running 2 h1" "fail")))
        ; (:m :do "light then heavy deadlines with the same count alternate without end before the counter: the second blocks")
        (u6 (seeded! root "D6"))
        (e1 (fin! root u6 0 "" (resOf "trainDeadline: light :running 2 a" "fail")))
        (e2 (fin! root u6 e1.fails e1.sig (resOf "trainDeadline: heavy :running 2 h1" "fail")))
        ; (:m :do "a train output with a red suite and a deadline: the red is charged, solo and batch")
        (redOut (stringReplace (stringReplace out ":red ()" ":red ((\"t.asl\" \"sh/D1\" 1 1 :kind suite :why alone))") "(:trainPhase :name \"heavy\"" "(:redLive \"t.asl\" 1 1 :kind suite)\n(:trainPhase :name \"heavy\""))
        (redSig (cd/trainSig (stringLines redOut)))
        (redBv (cd/batchVerdicts (list "sh/D1" "sh/D2") 1 redOut (list)))
        (u7 (seeded! root "D7"))
        (r1 (fin! root u7 0 "" (resOf redSig "fail")))
        (u8 (seeded! root "D8"))
        (r2 (fin! root u8 0 "" (cd/batchRes "red" redSig 3)))
        ; (:m :do "an assertion loss with a deadline is the train assertLoss of the solo path in a batch too: solo, no deadline")
        (lossOut (stringReplace out ":assertLoss ()" ":assertLoss (\"x.asl\")"))
        (lossSig (cd/trainSig (stringLines lossOut)))
        (lossBv (cd/batchVerdicts (list "sh/D1" "sh/D2") 1 lossOut (list)))
        ; (:m :do "the fit check and the wake read the limit the train runs with, clamped to the stage deadline")
        (_ (fileWrite (str store "/ladder.asn") "(:train :limitS 6000)\n"))
        (ctxS (with ctx :stageSec 300))
        (u9 (seeded! root "D9"))
        (_ (attempt! root "D9" sig out))
        (f1 (finCtx! root ctxS u9 0 "killed: timeout after 3600 s" (resOf sig "fail")))
        (note9 (resultOr (fileReadString (cd/deadlinePath store "D9")) ""))
        (stay9 (cd/retryBlocked! ctxS (list u9)))
        ; (:m :do "a red train and its fix round forget the counter: the next deadline with the same count retries")
        (u10 (seeded! root "D10"))
        (g1 (fin! root u10 0 "" (resOf "trainDeadline: heavy :running 10 h1" "fail")))
        (g2 (fin! root u10 g1.fails g1.sig (resOf "train red: t.asl" "fail")))
        (g3 (fin! root u10 g2.fails g2.sig (resOf "trainDeadline: heavy :running 10 h1" "fail")))
        ; (:m :do "a garbage counter reads as fresh")
        (u11 (seeded! root "D11"))
        (_ (dirCreate (cd/runsDir store)))
        (_ (fileWrite (cd/deadlineLeftPath store "D11") "garbage\n"))
        (h1 (fin! root u11 0 "" (resOf "trainDeadline: heavy :running 4 h1" "fail")))
        ; (:m :do "a base red, a commit error or a failed train with a deadline is not a deadline in a batch, as solo")
        (baseOut (stringReplace out ":preexisting ()" ":preexisting ((\"b.asl\" 1 1 :kind suite))"))
        (baseDlSig (cd/trainSig (stringLines (str "(:redLive \"b.asl\" 1 1 :kind suite)\n" baseOut))))
        (unrunOnlyOut (stringReplace (stringReplace out "(:trainDeadline :phase \"heavy\" :deadlineS 900 :elapsedS 950 :nextSuite \"h2\" :unstarted 1)\n" "") ":preexisting ()" ":preexisting ((\"b.asl\" \"base\" 1 1 :kind suite :why preexisting))"))
        (unrunDlSig (cd/trainSig (stringLines (str "(:redLive \"b.asl\" 1 1 :kind suite)\n" (stringReplace (stringReplace unrunOnlyOut ":unrunN 1" ":unrunN 2") ":deadline (:unrun (\"h2\"))" ":deadline (:unrun (\"h2\" \"h3\"))")))))
        (unrunReceiptSig (cd/trainSig (list "(:train :head \"abc\" :merged \"def\" :branches (\"sh/D1\") :red () :preexisting ((\"b.asl\" \"base\" 1 1 :kind suite)) :assertLoss () :unrunN 2 :deadline (:unrun (\"h2\" \"h3\")))" "(:redLive \"b.asl\" 1 1 :kind suite)")))
        (to124Sig (cd/trainSig (list "(:redLive \"b.asl\" 124 0 :kind suite)" "(:train :head \"abc\" :red () :preexisting ((\"b.asl\" \"base\" 124 0 :kind suite :why preexisting)) :assertLoss ())")))
        (toTimedOutSig (cd/trainSig (list "(:redLive \"c.asl\" 1 0 :kind suite :err (\"timed out after 300 s\"))" "(:train :head \"abc\" :red () :preexisting ((\"c.asl\" \"base\" 1 0 :kind suite :why preexisting)) :assertLoss ())")))
        (toWordSig (cd/trainSig (list "(:redLive \"d.asl\" 1 0 :kind suite :err (\"timeout\"))" "(:train :head \"abc\" :red () :preexisting ((\"d.asl\" \"base\" 1 0 :kind suite :why preexisting)) :assertLoss ())")))
        (notToPathSig (cd/trainSig (list "(:redLive \"asl/tests/trainTimeoutSigTest.asl\" 1 124 :kind suite :err (\"ERR_ASSERT: bad\"))" "(:train :head \"abc\" :red () :preexisting ((\"asl/tests/trainTimeoutSigTest.asl\" \"base\" 1 124 :kind suite :why preexisting)) :assertLoss ())")))
        (baseBv (cd/batchVerdicts (list "sh/D1" "sh/D2") 1 baseOut (list)))
        (commitBv (cd/batchVerdicts (list "sh/D1" "sh/D2") 1 (str out "\n(:commitError \"x\")") (list)))
        (failedBv (cd/batchVerdicts (list "sh/D1" "sh/D2") 1 (str out "\n(:train :status :failed :why x)") (list)))
        (_ (pf/cleanup root))]
    (do (assert (stringContains? heavyKill ":running 1 h2") (str "a heavy-phase kill names its unfinished heavy suite: " heavyKill))
        (assert (stringContains? lightKill ":running 3 b") (str "a light-phase kill counts the unlisted heavy tier: " lightKill))
        (assert (cd/progressed? lightKill heavyKill) "a heavy-phase kill after a light-phase kill is progress")
        (assert (= (cd/mergeFailsAfter lightKill 2 heavyKill) 2) "progress across phases charges no new fail")
        (assert (= untiered 0) "an untiered train has no pending heavy suites")
        (assert (= (stringJoin afterRerun "|") "") (str "a row after the main run that is not the heavy phase is not unfinished work: " (stringJoin afterRerun "|")))
        (assert (= sig "trainDeadline: heavy :running 1 h2") (str "the deadline signature: " sig))
        (assert (= gate sig) (str "gateSig takes the deadline signature: " gate))
        (assert (cd/deadlineSig? sig) "the signature reads as a deadline")
        (assert (= (stringJoin bv " ") "deadline deadline") (str "a batch deadline charges no member: " (stringJoin bv " ")))
        (assert (= bres.verdict "deadline") "the batch Res carries the deadline verdict")
        (assert (= leftS 251) (str "the unfinished share of the estimate, rounded up: " (n leftS)))
        (assert (= a1.st "merging") (str "solo deadline retries: " a1.st))
        (assert (= a1.fails 2) (str "solo deadline keeps the fail count: " (n a1.fails)))
        (assert (= a1.sig sig) "the unit carries the deadline signature")
        (assert (stringContains? j1 ":action retry :unit \"D1\" :why fits") (str "one retry row: " j1))
        (assert (= a2.st "merging") (str "batch deadline retries: " a2.st))
        (assert (= a2.fails 1) (str "batch deadline keeps the fail count: " (n a2.fails)))
        (assert (= a3.st "blocked") (str "a repeat without progress blocks: " a3.st))
        (assert (= a3.await "trainDeadline") (str "it waits on the deadline: " a3.await))
        (assert (= a3.fails 2) (str "the block charges no fail: " (n a3.fails)))
        (assert (stringEmpty? lease3) (str "the lease is dropped: " lease3))
        (assert (= a4.st "blocked") (str "unfinished suites over the limit block: " a4.st))
        (assert (= a4.fails 1) "the no-fit block charges no fail")
        (assert (stringContains? note4 ":why noFit :leftS 2001 :limitS 600") (str "the block note: " note4))
        (assert (= stay4 0) "the same limit does not wake it")
        (assert (= still4.st "blocked") "still blocked under the same limit")
        (assert (= woke4 1) "a larger limit wakes it")
        (assert (= back4.st "merging") (str "back to merging: " back4.st))
        (assert (> back4.epoch 0) "with its lease claimed again")
        (assert (= stay1 0) "a limit no larger than the one it was blocked under does not wake a unit whose suites fit")
        (assert (= still1.st "blocked") (str "the no-progress block stays: " still1.st))
        (assert hadNote "the block and the retry counter left files before the requeue")
        (assert (not gone) "a requeue clears the deadline note and the retry counter")
        (assert (and (= b1.st "merging") (= b2.st "merging")) (str "fewer suites left across phases retry: " b1.st " " b2.st))
        (assert (= b3.st "merging") (str "a kill after a deadline retries: " b3.st))
        (assert (and (= b4.st "blocked") (= b4.await "trainDeadline")) (str "a deadline after a kill with no fewer suites left blocks: " b4.st " " b4.await))
        (assert (= b4.fails 1) (str "no fail charged by the block: " (n b4.fails)))
        (assert (and (= e1.st "merging") (= e2.st "blocked")) (str "light then heavy with the same count: " e1.st " " e2.st))
        (assert (stringStartsWith? redSig "train red: t.asl") (str "the solo signature names the red: " redSig))
        (assert (= (stringJoin redBv " ") "red rebatch") (str "a batch red with a deadline is red for its branch: " (stringJoin redBv " ")))
        (assert (and (= r1.st "merging") (= r1.fails 1) (!= r1.await "trainDeadline")) (str "a solo red with a deadline is charged: " r1.st " " (n r1.fails)))
        (assert (and (= r2.st "merging") (= r2.fails 1) (!= r2.await "trainDeadline")) (str "a batch red with a deadline is charged: " r2.st " " (n r2.fails)))
        (assert (stringStartsWith? lossSig "train assertLoss") (str "solo: an assert loss outranks the deadline: " lossSig))
        (assert (= (stringJoin lossBv " ") "solo solo") (str "batch: an assert loss with a deadline is solo for all: " (stringJoin lossBv " ")))
        (assert (and (= f1.st "blocked") (stringContains? note9 ":why noFit :leftS 251 :limitS 180")) (str "the fit check reads the clamped limit: " f1.st " " note9))
        (assert (= stay9 0) "a limit that clamps to the same effective one does not wake")
        (assert (and (= g1.st "merging") (= g2.st "merging") (= g3.st "merging")) (str "a deadline after a red and its fix round retries: " g1.st " " g2.st " " g3.st))
        (assert (= h1.st "merging") (str "a garbage counter is fresh: " h1.st))
        (assert (cd/deadlineSig? baseDlSig) (str "trainSig checks deadline before baseRed: " baseDlSig))
        (assert (and (cd/deadlineSig? unrunDlSig) (stringStartsWith? unrunDlSig "trainDeadline: ")) (str "trainSig checks unrunN before baseRed: " unrunDlSig))
        (assert (and (stringStartsWith? unrunReceiptSig "trainDeadline: unrun") (stringContains? unrunReceiptSig ":running 2 h2 h3")) (str "trainSig synthesizes trainDeadline: unrun without a (:trainDeadline) row: " unrunReceiptSig))
        (assert (= to124Sig "train timeout: b.asl") (str "preexisting exit 124 classifies as train timeout: " to124Sig))
        (assert (= toTimedOutSig "train timeout: c.asl") (str "preexisting timed out classifies as train timeout: " toTimedOutSig))
        (assert (= toWordSig "train timeout: d.asl") (str "preexisting timeout classifies as train timeout: " toWordSig))
        (assert (= notToPathSig "train baseRed: asl/tests/trainTimeoutSigTest.asl") (str "path containing timeout with non-timeout failure stays baseRed: " notToPathSig))
        (assert (= (stringJoin baseBv " ") "fail fail") (str "batch base red outranks the deadline: " (stringJoin baseBv " ")))
        (assert (= (stringJoin commitBv " ") "fail fail") (str "batch commit error outranks the deadline: " (stringJoin commitBv " ")))
        (assert (= (stringJoin failedBv " ") "fail fail") (str "batch failed train outranks the deadline: " (stringJoin failedBv " ")))
        true))
