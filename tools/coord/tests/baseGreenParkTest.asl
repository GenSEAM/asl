(module asl-tools/coord/tests/baseGreenParkTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/fleet/run :a fr) (asl-tools/coord/tests/fixtures/pipeFix :a pf)])

; (:m :ref TLE-1-BASE-GREEN-ISSUED :do "the write stage with a counting stand-in writer on real unit worktrees. Finished work reaches gating without a writer: a branch whose only path outside :owns is the harness's own (the gateway profile pin a wip rescue commit staged), and owned edits left uncommitted. A red that is not the unit gate reaches the writer as an (:aheadRed ...) form. A blank branch whose gate is green on its base: with every :owns path present and the gate test not owned no writer runs and the unit blocks as vacuousGate, which needsPlan takes; with a missing :owns path the writer runs with a (:baseGreen ...) form, gating wants more executed asserts than the base had and a writer that changed nothing is vacuousGate. A red base, a gate with no executed assert or that cannot start, a regression guard, a fix round and (:conductor :baseGreenPark false) keep their path, and the red of the base check is the red-before the gating stage reuses")
fn n x: Int64 -> String
  (stringFromInt64 x)

fn ! readOr p: String -> String
  (resultOr (fileReadString p) "")

fn ctxFor root: String -> cd/Ctx
  (cd/Ctx :dir (str root "/store") :holder "baseGreenTest" :ttlMs 3600000 :maxWait 5 :maxSame 3 :stageSec 600 :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "/usr/bin/true")) :pace (cd/fixedPace 4 4))

fn ! cuNow root: String id: String -> cd/CUnit
  (optionOr (listFind (fn [(x cd/CUnit)] -> Bool (= x.id id)) (cd/readCUnits! (str root "/store"))) (pf/cuIn id "absent" "" ""))

fn ! linesOf path: String -> Int64
  (listLength (filter (fn [(l String)] -> Bool (not (stringEmpty? l))) (stringLines (readOr path))))

fn ! callsOf root: String id: String -> Int64
  (linesOf (str root "/calls-" id))

; (:m :do "the gate of every fixture unit: the stand-in host runs <root>/gcheck.asl in the unit checkout; it logs the run to <root>/gateRuns-<checkout dir>, prints one assert line plus one per line of asserts.txt, and is green when <root>/baseGreen exists or impl.txt holds impl")
fn gateOf root: String -> String
  (str (fr/stubHostPath) " test " root "/gcheck.asl")

fn ! gateRuns root: String id: String -> Int64
  (+ (linesOf (str root "/gateRuns-asex-" id)) (linesOf (str root "/gateRuns-asex-" id ".base")))

; (:m :do "a repo and store with the gate script beside them; green makes the gate pass on any tree, the base included")
fn ! rootFor name: String green: Bool -> String
  (let [(root (pf/scratch "baseGreen" name))
        (_ (pf/cleanup root))
        (_ (dirCreate root))
        (repo (pf/repoIn root))
        (store (str root "/store"))
        (_ (fileWrite (str root "/gcheck.asl") "d=$(dirname \"$0\")\necho x >> \"$d/gateRuns-$(basename \"$PWD\")\"\nk=1\nif [ -f asserts.txt ]; then k=$((1+$(wc -l < asserts.txt))); fi\ni=0\nwhile [ $i -lt $k ]; do i=$((i+1)); echo \"assert $i\"; done\nif [ -f \"$d/baseGreen\" ] || [ \"$(cat impl.txt 2>/dev/null)\" = impl ]; then exit 0; fi\nexit 1\n"))
        (_ (if green (fileWrite (str root "/baseGreen") "1\n") (ok ())))
        (_ (fileWrite (cd/repoPath store) repo))
        (_ (fileWrite (cd/worktreesPath store) (str root "/wts")))]
    root)

fn unitOf root: String id: String owns: (List String) -> st/Task
  (with (pf/unitIn id (gateOf root)) :owns owns)

; (:m :do "one write stage of a seeded unit with a stand-in writer that logs its call and its task and writes each of edits; out is the receipt text it returns")
fn ! write! root: String u: st/Task edits: (List String) out: String -> cd/Res
  (let [(store (str root "/store"))
        (rc (cd/realCfg (list "--repo" (str root "/repo") "--home" (str root "/home") "--worktrees" (str root "/wts")) store))
        (run (fn [(rcx cd/RealCfg) (lane String) (id String) (prof String) (p String) (task String) (owns (List String)) (gates (List String)) (extra String)] -> fr/Done
               (let [(_ (fileAppend (str root "/calls-" id) "call\n"))
                     (_ (fileWrite (str root "/task-" id) task))
                     (_ (map (fn [(f String)] -> Bool (ok? (fileWrite (str p "/" f) "impl\n"))) edits))]
                 (fr/Done :idx 0 :exit 0 :out out :ms 0 :verdict "exit"))))]
    (cd/writeResWith run rc store u (cuNow root u.id)))

; (:m :do "seed a unit worktree (one commit of file when not empty) and run one write stage")
fn ! writeOf! root: String u: st/Task file: String edits: (List String) -> cd/Res
  (let [(_ (pf/seedUnit! root u "writing" file))]
    (write! root u edits ""))

fn ! journalHas root: String part: String -> Bool
  (stringContains? (readOr (cd/journalPath (str root "/store"))) part)

fn ! escCount root: String id: String -> Int64
  (listLength (filter (fn [(l String)] -> Bool (stringStartsWith? l (str "(:escalate :unit " (st/q id) " "))) (stringLines (readOr (cd/escalationsPath (str root "/store"))))))

fn gatingRes asserts: Int64 -> cd/Res
  (cd/Res :ok 0 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig "" :ms 1 :exit 0 :asserts asserts :verdict "" :tiers "")

fn ! testPure -> Bool
  (do (assert (cd/gateInOwns? "./bin/asl test asl/packages/p/tests/aTest.asl" (list "asl/packages/p/src/a.asl" "asl/packages/p/tests/aTest.asl")) "the gate test is an owned file")
      (assert (cd/gateInOwns? "./bin/asl test ./asl/packages/p/tests/aTest.asl" (list "asl/packages/p/tests/")) "an owned directory holds the gate test")
      (assert (cd/gateInOwns? "./bin/asl test asl/t/aTest.asl && ./bin/asl test asl/t/bTest.asl" (list "asl/t/bTest.asl#runTests")) "one owned gate test of two, named with a symbol")
      (assert (not (cd/gateInOwns? "./bin/asl test asl/packages/p/tests/aTest.asl" (list "asl/packages/p/src/a.asl" "asl/packages/p/tests/aTest.aslx"))) "an owned src file is not the gate test")
      (assert (and (cd/harnessPath? ".asl/gatewayProfilePin.asn") (and (cd/harnessPath? ".asl/mem/grades.asn") (and (cd/harnessPath? "asl/packages/asl-know/missing.asn") (cd/harnessPath? "asl/packages/asl-know/cards/asl-text.asn")))) "the pin, the grade ledger, missing.asn and a know card are the harness's own paths")
      (assert (not (or (cd/harnessPath? "asl/packages/asl-text/src/ini.asl") (or (cd/harnessPath? ".asl/gateway.asn") (cd/harnessPath? "asl/packages/asl-know/src/know.asl")))) "a source file and another .asl file are not")
      true)

fn ! runTests -> Bool
  (let [; (:m :do "green base")
        (rg (rootFor "g" true))
        (storeG (str rg "/store"))
        (ctxG (ctxFor rg))
        ; (:m :do "every :owns path exists and the gate test is not owned: no writer, the vacuousGate block")
        (ua (unitOf rg "A1" (list "a.txt")))
        (resA (writeOf! rg ua "" (list "a.txt")))
        (callsA (callsOf rg "A1"))
        (gateRunsA (gateRuns rg "A1"))
        (_ (cd/finish! ctxG ua (cuNow rg "A1") resA))
        (a1 (cuNow rg "A1"))
        (escA (escCount rg "A1"))
        (rowA (journalHas rg ":gateExit 0 :executed 1 :verdict vacuous"))
        (noteA (fileExists? (cd/baseGreenPath storeG "A1")))
        (leaseA (fileExists? (st/leasePath storeG "A1")))
        (_ (fileWrite (str storeG "/ladder.asn") "(:conductor :needsPlan true)\n"))
        (_ (cd/tick! ctxG))
        (a2 (cuNow rg "A1"))
        (_ (pathRemove (str storeG "/ladder.asn")))
        ; (:m :do "an :owns path that does not exist yet: the writer runs with the form, gating wants more than the base count")
        (uw (unitOf rg "W1" (list "new.txt" "asserts.txt")))
        (resW (writeOf! rg uw "" (list "new.txt" "asserts.txt")))
        (callsW (callsOf rg "W1"))
        (taskW (readOr (str rg "/task-W1")))
        (noteW (cd/baseGreenNoteN storeG "W1" uw.gate))
        (gateRunsW (gateRuns rg "W1"))
        (hold (with ctxG :hold true))
        (_ (cd/writeCUnit! storeG (with (cuNow rg "W1") :st "gating")))
        (_ (cd/finish! hold uw (cuNow rg "W1") (gatingRes 1)))
        (w1 (cuNow rg "W1"))
        (_ (cd/writeCUnit! storeG (with (cuNow rg "W1") :st "gating" :sig "" :fails 0)))
        (_ (cd/finish! hold uw (cuNow rg "W1") (gatingRes 2)))
        (w2 (cuNow rg "W1"))
        ; (:m :do "the same weak gate and a writer that changed nothing; then one that edits while its receipt lists the gate as vacuous")
        (uw2 (unitOf rg "W2" (list "new2.txt")))
        (resW2 (writeOf! rg uw2 "" (list)))
        (callsW2 (callsOf rg "W2"))
        (uw3 (unitOf rg "W3" (list "new3.txt")))
        (_ (pf/seedUnit! rg uw3 "writing" ""))
        (resW3 (write! rg uw3 (list "new3.txt") (str "(:agent :status :ok :receipt (:agentReceipt :status :ok :vacuousGates (" (st/q uw3.gate) ") :usage (:input 1)))")))
        ; (:m :do "a gate that passes with no executed assert, one that cannot start, a regression guard, and the key off")
        (resZ (writeOf! rg (with (unitOf rg "Z1" (list "a.txt")) :gate "true") "" (list "a.txt")))
        (resY (writeOf! rg (with (unitOf rg "Y1" (list "a.txt")) :gate "/nonexistent/baseGreenGate") "" (list "a.txt")))
        (_ (fileWrite (str storeG "/tasks/G1.txt") "Keep the gate green: it is a regression guard."))
        (resGuard (writeOf! rg (unitOf rg "G1" (list "a.txt")) "" (list "a.txt")))
        (taskGuard (readOr (str rg "/task-G1")))
        (redbaseZ (fileExists? (cd/runPath storeG "Z1" "redbase" "asn")))
        (zExecuted (journalHas rg ":gate \"true\" :gateExit 0 :executed 0 :verdict writer"))
        (_ (fileWrite (str storeG "/ladder.asn") "(:conductor :baseGreenPark false)\n"))
        (keyErrors (cd/cdErrors "(:conductor :baseGreenPark false)"))
        (resOff (writeOf! rg (unitOf rg "E1" (list "a.txt")) "" (list "a.txt")))
        (gateRunsE (gateRuns rg "E1"))
        (_ (pathRemove (str storeG "/ladder.asn")))
        (cZ (callsOf rg "Z1")) (cY (callsOf rg "Y1")) (cGuard (callsOf rg "G1")) (cOff (callsOf rg "E1")) (callsW3 (callsOf rg "W3"))
        (_ (pf/cleanup rg))
        ; (:m :do "red base")
        (rr (rootFor "r" false))
        (storeR (str rr "/store"))
        (ctxR (ctxFor rr))
        (ur (unitOf rr "R1" (list "impl.txt")))
        (resR (writeOf! rr ur "" (list "impl.txt")))
        (callsR (callsOf rr "R1"))
        (baseSha (stringTrim (pf/sh (str "cd " rr "/repo && git rev-parse main"))))
        (redbaseR (readOr (cd/runPath storeR "R1" "redbase" "asn")))
        (hitR (cd/redBaseHit redbaseR baseSha ur.gate))
        (runsR1 (gateRuns rr "R1"))
        (rcR (cd/realCfg (list "--repo" (str rr "/repo") "--home" (str rr "/home") "--worktrees" (str rr "/wts")) storeR))
        (beforeR (cd/redBefore! rcR storeR ur (with (cuNow rr "R1") :wt (str rr "/wts/asex-R1"))))
        (runsR2 (gateRuns rr "R1"))
        (rowR (journalHas rr ":gateExit 1 :executed 1 :verdict writer"))
        ; (:m :do "a branch with a commit and a green gate is finished work: gating, no writer")
        (uc (unitOf rr "C1" (list "impl.txt")))
        (resC (writeOf! rr uc "impl.txt" (list)))
        (callsC (callsOf rr "C1"))
        (_ (cd/finish! (with ctxR :hold true) uc (cuNow rr "C1") resC))
        (c1 (cuNow rr "C1"))
        ; (:m :do "the same with a failed review since its writer is a fix round: the writer runs")
        (_ (fileAppend (cd/journalPath storeR) "(:t :unit \"F1\" :from reviewing :to ready :stage review :model \"m\" :tokens 0 :costUsd 0.000000 :verdict \"fail\" :ms 0 :at 1)\n"))
        (resF (writeOf! rr (unitOf rr "F1" (list "impl.txt")) "impl.txt" (list)))
        (callsF (callsOf rr "F1"))
        ; (:m :do "the wip rescue commit of the conductor stages the gateway profile pin beside the owned work: still finished work")
        (up (unitOf rr "P1" (list "impl.txt")))
        (wtP (pf/seedUnit! rr up "writing" ""))
        (_ (pf/sh (str "cd " wtP " && mkdir -p .asl && printf pin > .asl/gatewayProfilePin.asn && printf impl > impl.txt")))
        (_ (cd/wipSave! ctxR "P1" "writeFailed"))
        (pinIn (pf/sh (str "cd " wtP " && git log --format=%s --name-only -1")))
        (resP (write! rr up (list) ""))
        (callsP (callsOf rr "P1"))
        (rowP (journalHas rr "(:ahead :unit \"P1\" "))
        ; (:m :do "a tracked file outside :owns in that commit is not the harness's: the writer runs and the stop is journalled")
        (uo (unitOf rr "O1" (list "impl.txt")))
        (wtO (pf/seedUnit! rr uo "writing" ""))
        (_ (pf/sh (str "cd " wtO " && printf changed > a.txt && printf impl > impl.txt")))
        (_ (cd/wipSave! ctxR "O1" "writeFailed"))
        (resO (write! rr uo (list) ""))
        (callsO (callsOf rr "O1"))
        (rowO (journalHas rr "(:aheadSkip :unit \"O1\" "))
        ; (:m :do "owned edits left uncommitted are committed and checked")
        (ud (unitOf rr "D1" (list "impl.txt")))
        (wtD (pf/seedUnit! rr ud "writing" ""))
        (_ (pf/sh (str "cd " wtD " && printf impl > impl.txt")))
        (resD (write! rr ud (list) ""))
        (callsD (callsOf rr "D1"))
        (aheadD (stringTrim (pf/sh (str "cd " wtD " && git rev-list --count main..HEAD"))))
        (rowD (journalHas rr "(:aheadCommit :unit \"D1\" :paths 1 :exit 0 "))
        ; (:m :do "the unit gate is green and a check before it is red (an owned file lost most of its lines): the writer gets the form")
        (uh (unitOf rr "H1" (list "impl.txt" "check3.asl")))
        (wtH (pf/seedUnit! rr uh "writing" ""))
        (_ (pf/sh (str "cd " wtH " && printf impl > impl.txt && printf 'one\\n' > check3.asl")))
        (_ (cd/wipSave! ctxR "H1" "writeFailed"))
        (resH (write! rr uh (list) ""))
        (callsH (callsOf rr "H1"))
        (taskH (readOr (str rr "/task-H1")))
        (rowH (journalHas rr ":gateExit 3 :executed 0 :baseExit -1 :verdict writer :unitGateExecuted 1"))
        (taskR (readOr (str rr "/task-R1")))
        ; (:m :do "a base gate that dies twice on the native test cache answered nothing: the writer runs and no red-before is remembered")
        (ux (with (unitOf rr "X1" (list "impl.txt")) :gate "echo \"ERR_NATIVE_UNSUPPORTED: cannot write /h/b.part.o: No such file or directory\"; exit 1"))
        (resX (writeOf! rr ux "" (list "impl.txt")))
        (callsX (callsOf rr "X1"))
        (redbaseX (fileExists? (cd/runPath storeR "X1" "redbase" "asn")))
        (rowX (journalHas rr ":gateExit -1 :executed 0 :verdict writer"))
        (_ (pf/cleanup rr))
        (stubGone (fr/stubRemove!))
        (vac? (fn [(r cd/Res)] -> Bool (stringStartsWith? r.sig "vacuousGate: ")))]
    (do (assert (testPure) "gateInOwns? and harnessPath?")
        (assert (and (= callsA 0) (and (vac? resA) (= resA.ok 0))) (str "a: every :owns path present, the gate test not owned, the gate green on the blank base: no writer, vacuousGate: calls " (n callsA) " ok " (n resA.ok) " sig " resA.sig))
        (assert (and (= gateRunsA 1) (and rowA (not noteA))) (str "a: the base gate ran once, its verdict is journalled, no weak-gate note: runs " (n gateRunsA)))
        (assert (and (= a1.st "blocked") (and (stringEmpty? a1.await) (and (= a1.esc 1) (and (= escA 1) (not leaseA))))) (str "a: the ordinary block: blocked, no await, one escalation, the lease dropped: " a1.st " await " a1.await " esc " (n a1.esc) " rows " (n escA)))
        (assert (= a2.st "needsPlan") (str "a: with (:conductor :needsPlan true) the tick moves it to needsPlan: " a2.st))
        (assert (and (= callsW 1) (and (= resW.ok 1) (stringContains? taskW "(:baseGreen :executed 1 :do \"the unit gate is green on the base before any edit: first add a failing assertion"))) (str "w: an :owns path missing on the base is real work behind a weak gate, the writer runs with the form: calls " (n callsW) " ok " (n resW.ok) " " resW.sig))
        (assert (and (= noteW 1) (= gateRunsW 1)) (str "w: the base count is kept for gating and the base gate ran once: note " (n noteW) " runs " (n gateRunsW)))
        (assert (and (!= w1.st "awaitReview") (stringStartsWith? w1.sig "baseGreen: the gate executed 1 assertions, not more than the 1")) (str "w: a green gate with the base's count is a gates failure: " w1.st " " w1.sig))
        (assert (= w2.st "awaitReview") (str "w: more executed asserts than the base pass gating: " w2.st " " w2.sig))
        (assert (and (= callsW2 1) (and (vac? resW2) (= resW2.ok 0))) (str "w: a writer that changed nothing on a weak gate ends vacuousGate: calls " (n callsW2) " " resW2.sig))
        (assert (and (= callsW3 1) (and (= resW3.ok 1) (not (vac? resW3)))) (str "w: an edit counts even when the receipt lists the gate as vacuous: ok " (n resW3.ok) " " resW3.sig))
        (assert (and (= cZ 1) (and (not (vac? resZ)) zExecuted)) (str "g: a gate with exit 0 and no executed assert is not green, the writer runs: calls " (n cZ) " " resZ.sig))
        (assert (and (= cY 1) (not (vac? resY))) (str "g: a gate that cannot start is not green, the writer runs: calls " (n cY) " " resY.sig))
        (assert (not redbaseZ) "g: a base gate that answered nothing is not stored as a red-before")
        (assert (and (= cGuard 1) (and (not (vac? resGuard)) (not (stringContains? taskGuard "(:baseGreen ")))) (str "a regression guard is green on its base by design, the writer runs without the form: calls " (n cGuard) " " resGuard.sig))
        (assert (and (= cOff 1) (and (not (vac? resOff)) (and (= gateRunsE 0) (listEmpty? keyErrors)))) (str "e: (:conductor :baseGreenPark false) keeps the writer and runs no base gate: calls " (n cOff) " gate runs " (n gateRunsE) " " (stringJoin keyErrors "; ")))
        (assert (and (= callsR 1) (and (= resR.ok 1) (not (stringContains? taskR "(:baseGreen ")))) (str "b: a red base goes to the writer as before: calls " (n callsR) " ok " (n resR.ok) " " resR.sig))
        (assert (and rowR (match hitR ((some p) (and (= (pairFirst p) 1) (= (pairSecond p) 1))) ((none) false))) (str "b: the red of the base check is stored as the red-before of the base commit: " redbaseR))
        (assert (and (= runsR1 1) (and (= runsR2 1) (= (pairFirst beforeR) 1))) (str "b: the gating stage's red-before reuses it, the base gate ran once: " (n runsR1) " " (n runsR2) " exit " (n (pairFirst beforeR))))
        (assert (and (= callsC 0) (and (= resC.ok 1) (and (= c1.st "gating") (stringEmpty? c1.await)))) (str "c: a branch with its commit and a green gate goes to gating without a writer: calls " (n callsC) " ok " (n resC.ok) " " c1.st " " resC.sig))
        (assert (and (= callsF 1) (not (vac? resF))) (str "c: a fix round on a branch whose gate is green still gets its writer: calls " (n callsF) " " resF.sig))
        (assert (stringContains? pinIn ".asl/gatewayProfilePin.asn") (str "p: fixture: the wip rescue commit holds the pin: " pinIn))
        (assert (and (= callsP 0) (and (= resP.ok 1) rowP)) (str "p: a branch whose only path outside :owns is the pin is finished work, the gate runs and no writer: calls " (n callsP) " ok " (n resP.ok) " " resP.sig))
        (assert (and (= callsO 1) rowO) (str "p: a real path outside :owns still stops the ahead check, with a journal row: calls " (n callsO)))
        (assert (and (= callsD 0) (and (= resD.ok 1) (and (= aheadD "1") rowD))) (str "d: owned edits left in the tree are committed and go to gating without a writer: calls " (n callsD) " ok " (n resD.ok) " ahead " aheadD " " resD.sig))
        (assert (and (= callsH 1) rowH) (str "h: a red check before a green unit gate still runs the writer, the row carries the unit gate's count: calls " (n callsH)))
        (assert (and (stringContains? taskH "(:aheadRed :head ") (and (stringContains? taskH ":unitGate green :executed 1 :onlyRed \"owned file check3.asl lost ") (stringContains? taskH "only this check is red: fix only it"))) (str "h: the writer's task names the one red check: " (cd/utf8Clip taskH 700)))
        (assert (and (= callsX 1) (and rowX (not redbaseX))) (str "x: a cache fault on the base is no verdict and no remembered red: calls " (n callsX) " " resX.sig))
        (assert stubGone "the stand-in host dir of this run is removed")
        true))
