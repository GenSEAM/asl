(module asl-tools/coord/tests/gateOverlayTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/fleet/run :a fr) (asl-tools/coord/tests/fixtures/pipeFix :a pf) (asl-tools/vcs/vcs :a v)])

; (:m :ref COND-REDBEFORE-OVERLAY :do "red-before runs the branch's version of the gate test on the base code: a task that adds an assert to a test already in main and the code it needs passes gates with a :redBefore receipt; a task that only rewrites the test with an assert the base code already passes is refused")
fn okRes r: (Result cd/Res String) -> cd/Res
  (match r ((ok x) x) ((err _) (cd/Res :tiers "" :ok 0 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig "" :ms 0 :exit -9 :asserts 0 :verdict "")))

fn ! runTests -> Bool
  (let [(root (pf/scratch "gateOverlay" "o"))
        (_ (pf/cleanup root))
        (repo (pf/repoIn root))
        (store (str root "/store"))
        (_ (dirCreate (str repo "/x/tests")))
        (oldTest "echo \"(:gate :asserts 1 :failed 0)\"\necho \"assert 1\"\n")
        (newTest "if [ \"$(cat impl.txt 2>/dev/null)\" != impl ]; then echo \"(:gate :asserts 2 :failed 1)\"; echo \"assert 1\"; echo \"assert 2\"; exit 1; fi\necho \"(:gate :asserts 2 :failed 0)\"\necho \"assert 1\"\necho \"assert 2\"\n")
        (sameTest "echo \"(:gate :asserts 2 :failed 0)\"\necho \"assert 1\"\necho \"assert 2\"\n")
        (_ (fileWrite (str repo "/x/tests/ov.asl") oldTest))
        (_ (fileWrite (str repo "/x/tests/ov2.asl") oldTest))
        (cm (v/commit! repo repo (list "x/tests/ov.asl" "x/tests/ov2.asl") "(:c :a t :do \"tests\" :g none :ev (G))" "warn"))
        (gateOf (fn [(f String)] -> String (str (fr/stubHostPath) " test x/tests/" f)))
        (both (with (pf/unitIn "O1" (gateOf "ov.asl")) :owns (list "impl.txt")))
        (only (with (pf/unitIn "O2" (gateOf "ov2.asl")) :owns (list "impl.txt")))
        (w1 (pf/seedUnit! root both "gating" "impl.txt"))
        (w2 (pf/seedUnit! root only "gating" ""))
        (_ (fileWrite (str w1 "/x/tests/ov.asl") newTest))
        (c1 (v/commit! w1 w1 (list "x/tests/ov.asl") "(:c :a t :do \"test\" :g none :ev (O1))" "warn"))
        (_ (fileWrite (str w2 "/x/tests/ov2.asl") sameTest))
        (c2 (v/commit! w2 w2 (list "x/tests/ov2.asl") "(:c :a t :do \"test\" :g none :ev (O2))" "warn"))
        (d1 (pf/stageChild! root "gates" "O1" (list) (list) 600))
        (d2 (pf/stageChild! root "gates" "O2" (list) (list) 600))
        (r1 (okRes (pf/readResOf! root "O1" "gates")))
        (r2 (okRes (pf/readResOf! root "O2" "gates")))
        (rec1 (resultOr (fileReadString (cd/runPath store "O1" "receipt" "asn")) ""))
        (rec2 (resultOr (fileReadString (cd/runPath store "O2" "receipt" "asn")) ""))
        (rc (cd/realCfg (list "--repo" (str root "/repo") "--home" (str root "/home") "--worktrees" (str root "/wts")) store))
        (direct (cd/redBefore! rc store both (pf/cuIn "O1" "gating" w1 "sh/O1")))
        (memo1 (resultOr (fileReadString (cd/runPath store "O1" "redbase" "asn")) ""))
        (_ (pf/cleanup root))
        (_ (fr/stubRemove!))]
    (do (assert (and (= cm.code 0) (= c1.code 0) (= c2.code 0) (not (stringEmpty? w1)) (not (stringEmpty? w2))) "fixture: test files in main, two branches with commits")
        (assert (and (= d1.exit 0) (= d2.exit 0)) "stage children exit 0")
        (assert (and (= r1.exit 0) (= r1.asserts 2)) (str "test+code task: gate green on the branch with 2 asserts: " (stringFromInt64 r1.exit) "/" (stringFromInt64 r1.asserts) " " r1.sig))
        (assert (and (stringContains? rec1 ":redBefore ((:gate") (stringContains? rec1 ":exit 1")) (str "test+code task: red-before is red with the new assert on the old code: " rec1))
        (assert (and (= (pairFirst direct) 1) (stringContains? memo1 "+")) (str "direct red-before is red and the memo key carries the overlaid blobs: " (stringFromInt64 (pairFirst direct)) " " memo1))
        (assert (and (= r2.exit 3) (stringContains? r2.sig "red-before")) (str "test-only task whose assert the base code passes is refused: " (stringFromInt64 r2.exit) " " r2.sig))
        (assert (stringEmpty? rec2) "refused task: no receipt")
        (assert (stringContains? (cd/redBeforeRefusal (pair 0 2) "t") "red-before") "a green base is a refusal")
        (assert (= (cd/redOverlayPaths (pf/unitIn "Z" "stub test a/b.asl")) (list)) "a gate path outside tests is not overlaid")
        true))
