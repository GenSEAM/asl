(module asl-tools/coord/tests/trainBaseHoldTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/fleet/run :a fr) (asl-tools/coord/tests/fixtures/pipeFix :a pf)])

; (:m :ref N2-TRAIN-RED-VANISH :do "a train that fails only on suites red at the integration base holds the unit in merging with await baseRed instead of counting a failure: after four such results (maxSame 3) the unit still has fails 0 and is not blocked, status names it, an unchanged base head starts no train, a moved head releases it (a knownRed.asn row is a base commit, so it moves the head the same way), and a real unit red still counts and blocks at maxSame; the base is a branch bx the test moves with git branch -f")

fn ctxFor root: String -> cd/Ctx
  (cd/Ctx :dir (str root "/store") :holder "bhTest" :ttlMs 3600000 :maxWait 5 :maxSame 3 :stageSec 60 :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "/usr/bin/true")) :pace (cd/fixedPace 4 4))

fn ! cuNow root: String id: String -> cd/CUnit
  (optionOr (listFind (fn [(x cd/CUnit)] -> Bool (= x.id id)) (cd/readCUnits! (str root "/store"))) (pf/cuIn id "absent" "" ""))

fn resOf sig: String -> cd/Res
  (cd/Res :ok 0 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig sig :ms 0 :exit 1 :asserts 0 :verdict "fail" :tiers "")

fn ! fin! root: String u: st/Task sig: String -> cd/CUnit
  (let [(_ (cd/finish! (ctxFor root) u (cuNow root u.id) (resOf sig)))]
    (cuNow root u.id))

fn ! runTests -> Bool
  (let [(root (pf/scratch "trainBaseHold" "w"))
        (_ (pf/cleanup root))
        (repo (pf/repoIn root))
        (wt (pf/seedUnit! root (pf/unitIn "Q1" "sh check.sh impl.txt") "merging" "impl.txt"))
        (wt2 (pf/seedUnit! root (pf/unitIn "Q2" "sh check.sh impl.txt") "merging" "impl.txt"))
        (_ (pf/sh (str "cd " repo " && git branch -f bx main && echo ok")))
        (_ (fileWrite (cd/repoPath (str root "/store")) repo))
        (uq (with (pf/unitIn "Q1" "sh check.sh impl.txt") :base "bx"))
        (u2 (with (pf/unitIn "Q2" "sh check.sh impl.txt") :base "bx"))
        (_ (st/put! (str root "/store") uq))
        (_ (st/put! (str root "/store") u2))
        (sigBase "train baseRed: asl/b/bTest.asl")
        (h1 (fin! root uq sigBase))
        (h2 (fin! root uq sigBase))
        (h3 (fin! root uq sigBase))
        (h4 (fin! root uq sigBase))
        (statusText (cd/status! (ctxFor root)))
        (stillHeld (cd/launch! (ctxFor root) uq (cuNow root "Q1")))
        (_ (pf/sh (str "cd " repo " && git branch -f bx sh/Q1 && echo ok")))
        (released (cd/launch! (ctxFor root) uq (cuNow root "Q1")))
        (r1 (fin! root u2 "train red: asl/a/aTest.asl"))
        (r2 (fin! root u2 "train red: asl/a/aTest.asl"))
        (r3 (fin! root u2 "train red: asl/a/aTest.asl"))
        (wt3 (pf/seedUnit! root (pf/unitIn "Q3" "sh check.sh impl.txt") "merging" "impl.txt"))
        (wt4 (pf/seedUnit! root (pf/unitIn "Q4" "sh check.sh impl.txt") "merging" "impl.txt"))
        (u3 (with (pf/unitIn "Q3" "sh check.sh impl.txt") :base "bx"))
        (u4 (with (pf/unitIn "Q4" "sh check.sh impl.txt") :base "bx"))
        (_ (st/put! (str root "/store") u3))
        (_ (st/put! (str root "/store") u4))
        (realSig "train red: asl/a/aTest.asl")
        (k1 (fin! root u4 realSig))
        (k2 (fin! root u4 realSig))
        (k3 (fin! root u4 sigBase))
        (_ (pf/sh (str "cd " repo " && git branch -f bx main && echo ok")))
        (k4 (cd/launch! (ctxFor root) u4 (cuNow root "Q4")))
        (k5 (fin! root u4 realSig))
        (dev (str root "/dev"))
        (_ (pf/sh (str "git clone -q " repo " " dev " && git -C " dev " branch d1 origin/main && git -C " dev " branch d2 origin/sh/Q1 && git -C " dev " switch -q d1 && echo ok")))
        (_ (fileWrite (cd/devRepoPath (str root "/store")) (str dev "\n")))
        (_ (pf/sh (str "cd " repo " && git branch -f bx sh/Q1 && echo ok")))
        (d1 (fin! root u3 sigBase))
        (_ (pf/sh (str "cd " repo " && git branch -f bx main && echo ok")))
        (d2 (cd/launch! (ctxFor root) u3 (cuNow root "Q3")))
        (_ (pf/sh (str "git -C " dev " switch -q d2 && echo ok")))
        (d3 (cd/launch! (ctxFor root) u3 (cuNow root "Q3")))
        (tdir (cd/trainsDir (str root "/store") "Q2"))
        (_ (dirCreate tdir))
        (_ (fileWrite (str tdir "/000001.out") "attempt\n"))
        (hadTrains (fileExists? (str tdir "/000001.out")))
        (closed (cd/closeOne! (ctxFor root) "Q2"))
        (hasTrains (fileExists? tdir))
        (afterSt (cuNow root "Q2"))
        (_ (pf/cleanup root))
        (stubGone (fr/stubRemove!))
        (stubLeft (fr/stubDirsOwnedBy (procSelf)))]
    (do (assert (and stubGone (listEmpty? stubLeft)) "the stand-in host dir of this run is removed")
        (assert (and (not (stringEmpty? wt)) (not (stringEmpty? wt2))) "fixture: two unit branches")
        (assert (and (= h1.st "merging") (stringStartsWith? h1.await "baseRed:") (= h1.fails 0)) (str "a baseRed result holds the unit with no failure count: " h1.st " " h1.await " " (stringFromInt64 h1.fails)))
        (assert (and (= h4.st "merging") (= h4.fails 0) (!= h4.st "blocked") (= h2.fails 0) (= h3.fails 0)) (str "four baseRed results at maxSame 3 neither count nor block: " h4.st " " (stringFromInt64 h4.fails)))
        (assert (stringContains? h4.await "asl/b/bTest.asl") (str "the held signature names the red base suite: " h4.sig))
        (assert (stringContains? statusText "(:baseHeld (\"Q1: baseRed:") (str "status names the held unit and its red base suites: " statusText))
        (assert (and (= stillHeld.launched 0) (stringStartsWith? stillHeld.await "baseRed:")) (str "an unchanged base head starts no train: " (stringFromInt64 stillHeld.launched)))
        (assert (and (= released.launched 1) (stringEmpty? released.await) (= released.fails 0)) (str "a moved base head releases the unit to a train: " (stringFromInt64 released.launched) " " released.await))
        (assert (and (= r1.fails 1) (= r1.st "merging") (= r2.fails 2) (= r3.st "blocked")) (str "a real unit red still counts and escalates at maxSame: " (stringFromInt64 r1.fails) " " (stringFromInt64 r2.fails) " " r3.st))
        (assert (and (= k2.fails 2) (stringStartsWith? k3.await "baseRed:") (= k3.fails 2) (= k3.sig realSig) (stringEmpty? k4.await)) (str "a hold keeps the real-red count and signature: " (stringFromInt64 k3.fails) " " k3.sig))
        (assert (and (= k5.fails 3) (= k5.st "blocked")) (str "two real reds, a hold and a third real red make three: " (stringFromInt64 k5.fails) " " k5.st))
        (assert (and (= d1.st "merging") (stringContains? d1.await "baseRed:") (= d2.launched 0) (stringStartsWith? d2.await "baseRed:")) (str "moving the source base while dev HEAD stays does not release: " (stringFromInt64 d2.launched) " " d2.await))
        (assert (and (stringEmpty? d3.await) (!= d3.id "")) (str "moving dev HEAD releases: " (stringFromInt64 d3.launched)))
        (assert (and hadTrains closed (= afterSt.st "merged") (not hasTrains)) (str "closing a blocked unit removes its kept train attempts: " afterSt.st))
        true))
