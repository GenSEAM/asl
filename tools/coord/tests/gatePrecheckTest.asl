(module asl-tools/coord/tests/gatePrecheckTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/fleet/run :a fr) (asl-tools/coord/tests/fixtures/pipeFix :a pf) (asl-tools/vcs/vcs :a v)])

; (:m :ref COND-GATE-PRECHECK :do "the gates stage proves red-before itself: a gate that exits 0 on the merge-base fails at gates with the reason the writer reads (exit 3, no receipt), a gate red on the base passes with the receipt carrying :redBefore; the finish of the refused stage lands the reason on the unit row")
fn ctxOf dir: String -> cd/Ctx
  (cd/Ctx :dir dir :holder "gatePrecheckTest" :ttlMs 600000 :maxWait 0 :maxSame 3 :stageSec 60 :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "/usr/bin/true")) :pace (cd/fixedPace 8 8))

fn ! runTests -> Bool
  (let [(root (pf/scratch "gatePrecheck" "g"))
        (_ (pf/cleanup root))
        (repo (pf/repoIn root))
        (allGreen (str (fr/stubHostPath) " test allgreen.asl"))
        (_ (fileWrite (str repo "/allgreen.asl") "echo \"(:gate :asserts 2 :failed 0)\"\necho \"assert 1\"\necho \"assert 2\"\n"))
        (cm (v/commit! repo repo (list "allgreen.asl") "(:c :a t :do \"allgreen\" :g none :ev (G))" "warn"))
        (store (str root "/store"))
        (bad (pf/unitIn "B1" allGreen))
        (good (pf/unitIn "G1" (pf/gate3)))
        (wtB (pf/seedUnit! root bad "gating" "impl.txt"))
        (wtG (pf/seedUnit! root good "gating" "impl.txt"))
        (db (pf/stageChild! root "gates" "B1" (list) (list) 600))
        (dg (pf/stageChild! root "gates" "G1" (list) (list) 600))
        (rb (pf/readResOf! root "B1" "gates"))
        (rg (pf/readResOf! root "G1" "gates"))
        (recB (resultOr (fileReadString (cd/runPath store "B1" "receipt" "asn")) ""))
        (recG (resultOr (fileReadString (cd/runPath store "G1" "receipt" "asn")) ""))
        (resB (match rb ((ok r) r) ((err _) (cd/Res :tiers "" :ok 0 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig "" :ms 0 :exit -9 :asserts 0 :verdict ""))))
        (ctx (ctxOf store))
        (epoch (match (st/claim! store "B1" "gatePrecheckTest" 600000) ((ok t) (match (st/parseLease t) ((ok l) l.epoch) ((err _) 0))) ((err _) 0)))
        (cb (with (pf/cuIn "B1" "gating" wtB "sh/B1") :epoch epoch :launched 1))
        (_ (cd/writeCUnit! store cb))
        (_ (cd/finish! ctx bad cb resB))
        (after (match (listFind (fn [(c cd/CUnit)] -> Bool (= c.id "B1")) (cd/readCUnits! store)) ((some c) c) ((none) cb)))
        (journal (resultOr (fileReadString (cd/journalPath store)) ""))
        (_ (pf/cleanup root))
        (_ (fr/stubRemove!))]
    (do (assert (= cm.code 0) "fixture: allgreen committed on main")
        (assert (and (not (stringEmpty? repo)) (and (not (stringEmpty? wtB)) (not (stringEmpty? wtG)))) "fixture: repo and two unit worktrees")
        (assert (and (= db.exit 0) (= dg.exit 0)) "both stage children exit 0")
        (assert (and (= resB.exit 3) (stringContains? resB.sig "gates not proven red-before") (stringContains? resB.sig "exits 0 on the merge-base with 2 executed")) (str "base-green gate: exit 3 and the red-before reason with the base asserts: " (stringFromInt64 resB.exit) " " resB.sig))
        (assert (stringEmpty? recB) "base-green gate: no receipt")
        (assert (match rg ((ok r) (and (= r.exit 0) (> r.asserts 0))) ((err _) false)) "red-on-base gate: stage green with executed asserts")
        (assert (stringContains? recG ":redBefore ((:gate") (str "red-on-base gate: receipt carries :redBefore: " recG))
        (assert (and (= after.st "ready") (stringContains? after.sig "gates not proven red-before")) (str "finish lands the reason on the unit row, back to the writer: " after.st " " after.sig))
        (assert (stringContains? journal "red-before") "journal carries the reason")
        true))
