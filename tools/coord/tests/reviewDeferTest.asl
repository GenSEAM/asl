(module asl-tools/coord/tests/reviewDeferTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/fleet/run :a fr) (asl-tools/coord/tests/fixtures/pipeFix :a pf)])

; (:m :ref REVIEW-DEFER-ARBITER :do "a deferred review gets a next step within the (:reviewDefer :waitS S [:arbiter R2|R3|next]) bound: an arbiter review at the named or next rung through the offer file, else blocked reviewDeferred with one escalation; an arbiter that defers again blocks after another bound; a pass, fail or block clears the marks; parks from before the marks are judged by their newest transition; no row changes nothing; the passing of time is a mark rewritten into the past; stores are scratch dirs under this worktree's .asl/cache")

fn ctxFor dir: String -> cd/Ctx
  (cd/Ctx :dir dir :holder "reviewDeferTest" :ttlMs 3600000 :maxWait 5 :maxSame 3 :stageSec 60 :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "/usr/bin/true")) :pace (cd/fixedPace 8 8))

fn ! cuNow dir: String id: String -> cd/CUnit
  (optionOr (listFind (fn [(x cd/CUnit)] -> Bool (= x.id id)) (cd/readCUnits! dir)) (pf/cuIn id "absent" "" ""))

fn resOf verdict: String sig: String -> cd/Res
  (cd/Res :ok 0 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig sig :ms 0 :exit 0 :asserts 0 :verdict verdict :tiers "")

; (:m :do "a unit under review with a live lease, then one review result; a defer journals the await row the review ladder would, with the rung that deferred")
fn ! reviewed! dir: String id: String verdict: String rung: String -> cd/CUnit
  (let [(u (pf/unitIn id "true"))
        (_ (st/put! dir u))
        (c0 (cuNow dir id))
        (epoch (if (> c0.epoch 0) c0.epoch (match (st/claim! dir id "reviewDeferTest" 3600000) ((ok t) (match (st/parseLease t) ((ok l) l.epoch) ((err _) 0))) ((err _) 0))))
        (c (with (if (= c0.st "absent") (pf/cuIn id "reviewing" "" (str "sh/" id)) c0) :st "reviewing" :epoch epoch :launched 1 :parked 0))
        (_ (cd/writeCUnit! dir c))
        (_ (if (= verdict "defer") (ok? (fileAppend (cd/journalPath dir) (str "(:await :unit " id " :rung " rung " :lane laneX :why \"split\")\n"))) false))
        (_ (cd/finish! (ctxFor dir) u c (resOf verdict "laneX")))]
    (cuNow dir id))

fn ! past! path: String -> Bool
  (ok? (fileWrite path "1000\n"))

fn ! has? dir: String text: String -> Bool
  (listAny? (fn [(l String)] -> Bool (stringContains? l text)) (pf/journalLines dir))

fn ! runTests -> Bool
  (let [(root (pf/scratch "reviewDefer" "w"))
        (_ (pf/cleanup root))
        (dir (str root "/store"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (dirCreate (str dir "/tasks")))
        (ctx (ctxFor dir))
        (_ (fileWrite (str dir "/ladder.asn") "(:reviewDefer :waitS 0)\n"))
        (badProblems (cd/ladderProblems dir))
        (_ (fileWrite (str dir "/ladder.asn") ""))
        (n0 (reviewed! dir "D0" "defer" "R1"))
        (mark0 (fileExists? (cd/deferMarkPath dir "D0")))
        (_ (past! (cd/deferMarkPath dir "D0")))
        (swept0 (cd/reviewDeferSweep! ctx))
        (k0 (cuNow dir "D0"))
        (_ (fileWrite (str dir "/ladder.asn") "(:reviewDefer :waitS 60)\n"))
        (goodProblems (cd/ladderProblems dir))
        (_ (reviewed! dir "D1" "defer" "R1"))
        (_ (past! (cd/deferMarkPath dir "D1")))
        (d2 (reviewed! dir "D2" "defer" "R1"))
        (_ (cd/reviewDeferSweep! ctx))
        (b1 (cuNow dir "D1"))
        (w2 (cuNow dir "D2"))
        (esc (resultOr (fileReadString (cd/escalationsPath dir)) ""))
        (_ (fileWrite (str dir "/ladder.asn") "(:reviewDefer :waitS 60 :arbiter next)\n"))
        (_ (reviewed! dir "D3" "defer" "R1"))
        (_ (past! (cd/deferMarkPath dir "D3")))
        (_ (cd/reviewDeferSweep! ctx))
        (a3 (cuNow dir "D3"))
        (offer3 (resultOr (fileReadString (cd/offerPath dir "D3")) ""))
        (rung3 (cd/offeredRung! dir "D3"))
        (offerGone (not (fileExists? (cd/offerPath dir "D3"))))
        (arbRow (has? dir "(:reviewArbiter :unit \"D3\" :rung R2 "))
        (again3 (reviewed! dir "D3" "defer" "R2"))
        (_ (cd/reviewDeferSweep! ctx))
        (still3 (cuNow dir "D3"))
        (_ (past! (cd/arbiterMarkPath dir "D3")))
        (_ (cd/reviewDeferSweep! ctx))
        (b3 (cuNow dir "D3"))
        (_ (reviewed! dir "D4" "defer" "R3"))
        (_ (past! (cd/deferMarkPath dir "D4")))
        (_ (cd/reviewDeferSweep! ctx))
        (b4 (cuNow dir "D4"))
        (_ (reviewed! dir "D5" "defer" "R1"))
        (_ (past! (cd/deferMarkPath dir "D5")))
        (_ (cd/reviewDeferSweep! ctx))
        (f5 (reviewed! dir "D5" "fail" "R2"))
        (cleared5 (and (not (fileExists? (cd/deferMarkPath dir "D5"))) (not (fileExists? (cd/arbiterMarkPath dir "D5")))))
        (_ (fileWrite (str dir "/ladder.asn") "(:reviewDefer :waitS 60)\n"))
        (_ (st/put! dir (pf/unitIn "L1" "true")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "L1" "awaitReview" "" "sh/L1") :parked 1 :await "laneX" :since 1000)))
        (_ (fileAppend (cd/journalPath dir) "(:t :unit \"L1\" :from reviewing :to awaitReview :stage review :model \"\" :tokens 0 :costUsd 0 :verdict \"defer\" :ms 0 :at 1000)\n"))
        (_ (st/put! dir (pf/unitIn "P1" "true")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "P1" "awaitReview" "" "") :parked 1 :await "intakeClass" :since 1000)))
        (_ (fileAppend (cd/journalPath dir) "(:t :unit \"P1\" :from queued :to awaitReview :stage intake :model \"\" :tokens 0 :costUsd 0 :verdict \"parked\" :ms 0 :at 1000)\n"))
        (_ (cd/reviewDeferSweep! ctx))
        (l1 (cuNow dir "L1"))
        (p1 (cuNow dir "P1"))
        (_ (pf/cleanup root))]
    (do (assert (and (listAny? (fn [(p String)] -> Bool (stringContains? p "ladder reviewDefer: :waitS 0 outside")) badProblems)
                     (listAny? (fn [(p String)] -> Bool (stringContains? p ":arbiter R4 is not R2, R3 or next")) (cd/rdErrors "(:reviewDefer :waitS 60 :arbiter R4)"))) (str "a bound out of range and an unknown rung are config problems: " (stringJoin badProblems "; ")))
        (assert (listEmpty? goodProblems) (str "a valid row is no problem: " (stringJoin goodProblems "; ")))
        (assert (and (= n0.st "awaitReview") (and (= n0.parked 1) mark0)) (str "a defer parks the unit and marks when it began: " n0.st))
        (assert (and (= swept0 0) (and (= k0.st "awaitReview") (= k0.parked 1))) (str "no row: a defer past any bound stays parked, today's behaviour: " k0.st))
        (assert (= b1.st "blocked") (str "past the bound with no arbiter the unit is blocked: " b1.st " " b1.sig))
        (assert (stringStartsWith? b1.sig "reviewDeferred: no arbiter configured") (str "with the reason as its signature: " b1.sig))
        (assert (and (= b1.epoch 0) (stringContains? esc "review deferred past the (:reviewDefer :waitS) bound")) (str "its lease dropped and one escalation written: " esc))
        (assert (and (= w2.st "awaitReview") (= w2.parked 1)) (str "within the bound it waits: " w2.st))
        (assert (and (= a3.st "awaitReview") (= a3.parked 0)) (str "past the bound with an arbiter the unit is unparked for review: " a3.st " " (stringFromInt64 a3.parked)))
        (assert (stringContains? offer3 ":to arbiter :rung R2 ") (str "the arbiter is the rung above the one that deferred: " offer3))
        (assert (and (= rung3 "R2") offerGone) (str "the next review starts there once: " rung3))
        (assert arbRow "one reviewArbiter journal row")
        (assert (and (= again3.st "awaitReview") (and (= still3.st "awaitReview") (= still3.parked 1))) (str "an arbiter that defers again waits one more bound: " still3.st))
        (assert (and (= b3.st "blocked") (stringStartsWith? b3.sig "reviewDeferred: the arbiter review gave no verdict")) (str "then it is blocked: " b3.st " " b3.sig))
        (assert (and (= b4.st "blocked") (stringStartsWith? b4.sig "reviewDeferred: no review rung above")) (str "no rung above R3 blocks at once: " b4.st " " b4.sig))
        (assert (and (= f5.st "ready") cleared5) (str "a verdict of the arbiter clears the marks: " f5.st))
        (assert (and (= l1.st "blocked") (stringStartsWith? l1.sig "reviewDeferred: ")) (str "a review defer from before the marks counts from its park: " l1.st " " l1.sig))
        (assert (and (= p1.st "awaitReview") (= p1.parked 1)) (str "a park no review made is never moved: " p1.st))
        (assert (= (cd/arbiterRung "R3" "R1") "R3") "a named rung is used as named")
        (assert (= (cd/arbiterRung "next" "R3") "") "nothing is above R3")
        true))
