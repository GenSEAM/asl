(module asl-tools/coord/tests/flowDrainTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/fleet/run :a fr) (asl-tools/coord/tests/fixtures/pipeFix :a pf)])

; (:m :ref FLOW-DRAIN :do "units are cleared and never sit: reload re-reads a unit's definition from the intake files and resets its counters")
fn ctxOf dir: String -> cd/Ctx
  (cd/Ctx :dir dir :holder "flowDrainTest" :ttlMs 600000 :maxWait 30 :maxSame 3 :stageSec 60 :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "/usr/bin/true")) :pace (cd/fixedPace 8 8))

fn ! cuOf! dir: String id: String -> cd/CUnit
  (optionOr (listFind (fn [(c cd/CUnit)] -> Bool (= c.id id)) (cd/readCUnits! dir)) (pf/cuIn id "missing" "" ""))

fn ! unitOf! dir: String id: String -> st/Task
  (optionOr (listFind (fn [(u st/Task)] -> Bool (= u.id id)) (resultOr (st/readUnits! dir) (list))) (pf/unitIn "missing" ""))

fn ! readOr path: String -> String
  (resultOr (fileReadString path) "")

fn ! journalRows dir: String head: String -> (List String)
  (filter (fn [(l String)] -> Bool (stringStartsWith? l head)) (stringLines (readOr (str dir "/journal.asn"))))

fn ! seed! dir: String id: String stateName: String c: cd/CUnit -> Bool
  (let [(_ (st/put! dir (pf/unitIn id "true")))
        (_ (dirCreate (str dir "/tasks")))
        (_ (fileWrite (str dir "/tasks/" id ".txt") (str "old task of " id)))]
    (ok? (cd/writeCUnit! dir (with c :st stateName))))

; (:m :do "a store with R1 blocked after three vacuous writes (retry count 2, a merge-red addendum), W1 writing, Q1 blocked whose new row waits on D0 (ready), N1 that no row names, P1 whose row has no :owns; the queue file of ladder.asn carries the corrected rows")
fn ! testReload root: String -> Bool
  (let [(dir (str root "/reload"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (queue (str root "/queue.asn"))
        (_ (fileWrite queue (str "(:u :id R1 :auto true :do \"new task of R1\" :owns (\"b.txt\" \"c.txt\") :gate \"./bin/asl test b.asl\")\n"
                                 "(:u :id W1 :auto true :do \"new task of W1\" :owns (\"w.txt\") :gate \"true\")\n"
                                 "(:u :id Q1 :auto true :do \"new task of Q1\" :owns (\"q.txt\") :gate \"true\" :after D0)\n"
                                 "(:u :id P1 :auto true :do \"no owns\" :gate \"true\")\n")))
        (_ (fileWrite (str dir "/ladder.asn") (str "(:queue :path " (st/q queue) " :channel free)\n")))
        (base (pf/cuIn "X" "ready" "" ""))
        (_ (seed! dir "R1" "blocked" (with base :id "R1" :fails 3 :esc 1 :sig "vacuousGate: gate passes on the base" :waited 4)))
        (_ (seed! dir "W1" "writing" (with base :id "W1")))
        (_ (seed! dir "Q1" "blocked" (with base :id "Q1" :sig "waitedOut: deps not merged")))
        (_ (seed! dir "D0" "ready" (with base :id "D0")))
        (_ (seed! dir "N1" "blocked" (with base :id "N1" :sig "x")))
        (_ (seed! dir "P1" "blocked" (with base :id "P1" :sig "y")))
        (_ (fileAppend (str dir "/retries.asn") "(:retry :unit \"R1\" :why \"vacuous\" :n 2 :at 5)\n"))
        (_ (dirCreate (str dir "/runs")))
        (_ (fileWrite (str dir "/runs/R1-mergeRed.txt") "(:mergeRed :round 1)\n"))
        (oldR1 (cd/unitDigest! dir (unitOf! dir "R1")))
        (asked (cd/requestReload! dir (list "R1" "W1" "Q1" "N1" "P1" "ZZ")))
        (done (cd/reloadDrain! (ctxOf dir)))
        (r1 (cuOf! dir "R1"))
        (u1 (unitOf! dir "R1"))
        (rows (journalRows dir "(:reload "))
        (r1Row (optionOr (listFind (fn [(l String)] -> Bool (stringStartsWith? l "(:reload :unit \"R1\" :old ")) rows) ""))
        (refused (fn [(id String) (why String)] -> Bool (listAny? (fn [(l String)] -> Bool (stringStartsWith? l (str "(:reload :unit " (st/q id) " :refused " (st/q why) " "))) rows)))]
    (do (assert asked "the reload request is written")
        (assert (= done 2) (str "R1 and Q1 are reloaded, the rest refused: " (stringFromInt64 done)))
        (assert (= r1.st "ready") (str "a reloaded unit with no pending :after is ready: " r1.st))
        (assert (and (= r1.fails 0) (and (= r1.esc 0) (and (= r1.waited 0) (= r1.sig "")))) (str "its counters are reset: " (stringFromInt64 r1.fails) " " r1.sig))
        (assert (= u1.owns (list "b.txt" "c.txt")) (str "the stored owns come from the corrected row: " (stringJoin u1.owns ",")))
        (assert (= u1.gate "./bin/asl test b.asl") (str "the stored gate comes from the corrected row: " u1.gate))
        (assert (= (readOr (str dir "/tasks/R1.txt")) "new task of R1") "the task text comes from the corrected row")
        (assert (stringContains? r1Row (str ":old " (st/q oldR1) " :new ")) (str "the reload row journals the old digest: " r1Row))
        (assert (not (stringContains? r1Row (str ":new " (st/q oldR1)))) (str "and a different new digest: " r1Row))
        (assert (= (cd/unitDigest! dir u1) (sp1 r1Row)) (str "the new digest is the stored definition's: " r1Row))
        (assert (not (fileExists? (str dir "/runs/R1-mergeRed.txt"))) "the merge-red addendum is gone")
        (assert (= (pairFirst (cd/retryLast! dir "R1")) 0) "the blocked-retry count starts again")
        (assert (= (cuOf! dir "Q1").st "queued") (str "a unit whose new :after is not merged waits queued: " (cuOf! dir "Q1").st))
        (assert (= (unitOf! dir "Q1").after (list "D0")) "its :after comes from the row")
        (assert (= (cuOf! dir "W1").st "writing") "a writing unit is left alone")
        (assert (refused "W1" "writing") (str "and refused with its state: " (stringJoin rows "|")))
        (assert (refused "N1" "noRow") "a unit no intake row names is refused")
        (assert (= (cuOf! dir "N1").sig "x") "and left as it was")
        (assert (refused "P1" "need owns") "a row that is still not importable is refused")
        (assert (refused "ZZ" "unknown") "an id the store does not hold is refused")
        (assert (not (fileExists? (str dir "/reload.asn"))) "the request file is consumed")
        true))

fn sp1 row: String -> String
  (let [(rest (optionOr (listGet (stringSplit row ":new \"") 1) ""))]
    (optionOr (listHead (stringSplit rest "\"")) ""))

; (:m :do "the running tick drains the reload file before it reads the store")
fn ! testReloadTick root: String -> Bool
  (let [(dir (str root "/reloadTick"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (queue (str root "/queueTick.asn"))
        (_ (fileWrite queue "(:u :id T1 :auto true :do \"fixed\" :owns (\"t.txt\") :gate \"true\")\n"))
        (_ (fileWrite (str dir "/ladder.asn") (str "(:queue :path " (st/q queue) ")\n")))
        (_ (seed! dir "T1" "blocked" (with (pf/cuIn "T1" "blocked" "" "") :sig "vacuousGate: v" :esc 1)))
        (_ (cd/requestReload! dir (list "T1")))
        (_ (cd/tick! (ctxOf dir)))
        (rows (journalRows dir "(:reload :unit \"T1\" :old "))]
    (do (assert (= (listLength rows) 1) (str "one tick reloads the unit: " (stringJoin rows "|")))
        (assert (!= (cuOf! dir "T1").st "blocked") (str "and it leaves blocked: " (cuOf! dir "T1").st))
        (assert (= (unitOf! dir "T1").owns (list "t.txt")) "with the corrected owns")
        true))

fn unitAfter id: String after: (List String) -> st/Task
  (with (pf/unitIn id "true") :after after :owns (list (str id ".txt")))

; (:m :do "roots: R blocked for a reason of its own holds A (blocked waiting on R) and B (queued waiting on A); C waits on M, which is merging, so it has no root; D waits on GONE, which the store does not hold")
fn ! testRoots root: String -> Bool
  (let [(dir (str root "/roots"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (units (list (pf/unitIn "R" "true") (unitAfter "A" (list "R")) (unitAfter "B" (list "A")) (pf/unitIn "M" "true") (unitAfter "C" (list "M")) (unitAfter "D" (list "GONE"))))
        (_ (map (fn [(u st/Task)] -> Bool (ok? (st/put! dir u))) units))
        (base (pf/cuIn "X" "queued" "" ""))
        (cus (list (with base :id "R" :st "blocked" :sig "vacuousGate: v") (with base :id "A" :st "blocked" :sig "waitedOut: deps not merged")
                   (with base :id "B") (with base :id "M" :st "merging") (with base :id "C") (with base :id "D")))
        (_ (map (fn [(c cd/CUnit)] -> Bool (ok? (cd/writeCUnit! dir c))) cus))
        (status (cd/status! (ctxOf dir)))
        (counts (cd/rootCounts units cus))]
    (do (assert (= (cd/depRootsOf units cus "B" (list)) (list "R")) (str "B waits through A on the root R: " (stringJoin (cd/depRootsOf units cus "B" (list)) ",")))
        (assert (= (cd/depRootsOf units cus "A" (list)) (list "R")) "A waits on R")
        (assert (listEmpty? (cd/depRootsOf units cus "C" (list))) "a dependency in a stage is no root")
        (assert (= (cd/depRootsOf units cus "D" (list)) (list "GONE")) "a dependency the store does not hold is a root")
        (assert (listEmpty? (cd/waitsOn units cus (with base :id "R" :st "blocked" :sig "vacuousGate: v"))) "a unit blocked for its own reason waits on nothing")
        (assert (= (listLength (filter (fn [(p (Pair String Int64))] -> Bool (and (= (pairFirst p) "R") (= (pairSecond p) 2))) counts)) 1) "R holds two units")
        (assert (stringContains? status "(:root \"R\" :st blocked :holds 2)") (str "status lists the root with the count it holds: " status))
        (assert (stringContains? status "(:root \"GONE\" :st missing :holds 1)") "and a missing root")
        (assert (stringContains? status "(:unit :id \"B\" :st queued :lane \"free\" :fails 0 :parked 0 :waited 0 :waitsOn (\"R\"))") "a waiting unit row names its root")
        (assert (stringContains? status "(:unit :id \"C\" :st queued :lane \"free\" :fails 0 :parked 0 :waited 0)") "a unit with no root names none")
        true))

; (:m :do "same-tick release: Z1 finishes its merge in this tick; A1 (queued) and B1 (blocked by the dependency wait, below maxWait) wait on it and step before it; both are ready after the one tick")
fn ! testRootRelease root: String -> Bool
  (let [(dir (str root "/release"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (st/put! dir (pf/unitIn "Z1" "true")))
        (_ (st/put! dir (unitAfter "A1" (list "Z1"))))
        (_ (st/put! dir (unitAfter "B1" (list "Z1"))))
        (epoch (match (st/claim! dir "Z1" "flowDrainTest" 600000) ((ok t) (match (st/parseLease t) ((ok l) l.epoch) ((err _) 0))) ((err _) 0)))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "Z1" "merging" "" "sh/Z1") :epoch epoch :launched 1)))
        (_ (cd/writeCUnit! dir (pf/cuIn "A1" "queued" "" "")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "B1" "blocked" "" "") :sig "waitedOut: deps not merged" :waited 2)))
        (_ (cd/writeRes! dir "Z1" "merge" (cd/Res :tiers "" :ok 1 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig "" :ms 1 :exit 0 :asserts 0 :verdict "")))
        (_ (cd/tick! (ctxOf dir)))]
    (do (assert (= (cuOf! dir "Z1").st "merged") (str "the root merges in the tick: " (cuOf! dir "Z1").st))
        (assert (= (cuOf! dir "A1").st "ready") (str "a queued dependant is ready in the same tick: " (cuOf! dir "A1").st))
        (assert (= (cuOf! dir "B1").st "ready") (str "a dependant blocked by the wait alone is ready in the same tick: " (cuOf! dir "B1").st))
        (assert (= (cuOf! dir "B1").sig "") "with its wait signature cleared")
        true))

; (:m :do "three lows: requeue and close remove a stale merge-red addendum; a merge-red fix round keeps the solo mark; the stall infra probe reads the Leon journal from the start of the current run, so a providerWait row an earlier run left is no provider stop now")
fn ! testLows root: String -> Bool
  (let [(dir (str root "/lows"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (dirCreate (str dir "/runs")))
        (ctx (ctxOf dir))
        (_ (seed! dir "Q" "blocked" (with (pf/cuIn "Q" "blocked" "" "") :sig "merge failed")))
        (_ (seed! dir "K" "blocked" (with (pf/cuIn "K" "blocked" "" "") :sig "merge failed")))
        (_ (fileWrite (str dir "/runs/Q-mergeRed.txt") "(:mergeRed :round 1)\n"))
        (_ (fileWrite (str dir "/runs/K-mergeRed.txt") "(:mergeRed :round 1)\n"))
        (requeued (cd/requeueOne! ctx (resultOr (st/readUnits! dir) (list)) "Q"))
        (closed (cd/closeOne! ctx "K"))
        (_ (seed! dir "S" "merging" (with (pf/cuIn "S" "merging" "" "sh/S") :await "solo")))
        (s1 (cd/mergeRedFix! ctx (with (pf/cuIn "S" "merging" "" "sh/S") :await "solo") "train red: a/tests/aTest.asl" (cd/MergeRed :suites (list "(:suite \"a/tests/aTest.asl\")") :more 0 :key "k1") 1 2 5))
        (_ (seed! dir "P" "merging" (pf/cuIn "P" "merging" "" "sh/P")))
        (p1 (cd/mergeRedFix! ctx (pf/cuIn "P" "merging" "" "sh/P") "train red: a/tests/aTest.asl" (cd/MergeRed :suites (list "(:suite \"a/tests/aTest.asl\")") :more 0 :key "k2") 1 2 5))
        (wt (str root "/wtL"))
        (_ (dirCreate (str wt "/.asl/run/agentLoop")))
        (_ (fileWrite (str wt "/.asl/run/agentLoop/s1.journal") "(:turn 1)\n(:providerWait :route \"x\")\n"))
        (lc (with (pf/cuIn "L" "writing" wt "sh/L") :wt wt))
        (earlier (cd/stallInfraWhy ctx lc "(:stall :class stalled)" (/ (nowNs) 1000000) 0))
        (later (cd/stallInfraWhy ctx lc "(:stall :class stalled)" (/ (nowNs) 1000000) (+ (/ (nowNs) 1000000) 60000)))]
    (do (assert requeued "the blocked unit is requeued")
        (assert (not (fileExists? (str dir "/runs/Q-mergeRed.txt"))) "a requeue removes the merge-red addendum")
        (assert closed "the blocked unit is closed")
        (assert (not (fileExists? (str dir "/runs/K-mergeRed.txt"))) "a close removes the merge-red addendum")
        (assert (and (= s1.st "ready") (= s1.await "solo")) (str "a fix round keeps the solo mark: " s1.st " " s1.await))
        (assert (and (= p1.st "ready") (= p1.await "")) (str "and adds none: " p1.await))
        (assert (= earlier "provider") (str "a providerWait row inside the run is a provider stop: " earlier))
        (assert (= later "") (str "a providerWait row older than the current run is not: " later))
        true))

fn ctxTok dir: String tokens: Int64 -> cd/Ctx
  (with (ctxOf dir) :pace (cd/fixedPace tokens 8))

; (:m :do "one store per case: M1 and M2 merging (one train at a time, so M2 waits its turn), N1 ready for a first write, X1 ready for a fix round (its branch already written); one tick with the given ladder row and pace tokens; returns the states of M1 M2 N1 X1")
fn ! flowCase root: String name: String ladder: String tokens: Int64 -> (List String)
  (let [(dir (str root "/" name))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (map (fn [(id String)] -> Bool (ok? (st/put! dir (unitAfter id (list))))) (list "M1" "M2" "N1" "X1")))
        (ep (fn [(id String)] -> Int64 (match (st/claim! dir id "flowDrainTest" 600000) ((ok t) (match (st/parseLease t) ((ok l) l.epoch) ((err _) 0))) ((err _) 0))))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "M1" "merging" "" "sh/M1") :epoch (ep "M1"))))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "M2" "merging" "" "sh/M2") :epoch (ep "M2"))))
        (_ (cd/writeCUnit! dir (pf/cuIn "N1" "ready" "" "")))
        (_ (cd/writeCUnit! dir (pf/cuIn "X1" "ready" "" "sh/X1")))
        (_ (if (stringEmpty? ladder) () (let [(_ (fileWrite (str dir "/ladder.asn") (str ladder "\n")))] ())))
        (_ (cd/tick! (ctxTok dir tokens)))
        (m1 (cuOf! dir "M1"))]
    (list (if (= m1.launched 1) "launched" "waiting") (if (= (cuOf! dir "M2").launched 1) "launched" "waiting") (cuOf! dir "N1").st (cuOf! dir "X1").st))

fn ! testFlowRows -> Bool
  (do (assert (listEmpty? (cd/flowErrors "(:flow :order (merge gate review fix new) :newWhen idle)")) "a valid flow row")
      (assert (listEmpty? (cd/flowErrors "(:flow :newWhen always)")) "the order may be left to its default")
      (assert (listEmpty? (cd/flowErrors "(:flow :order (fix merge gate review new))")) "any permutation is an order")
      (assert (not (listEmpty? (cd/flowErrors "(:flow :order (merge gate review fix))"))) "an order missing a stage is rejected")
      (assert (not (listEmpty? (cd/flowErrors "(:flow :order (merge merge review fix new))"))) "an order with a stage twice is rejected")
      (assert (not (listEmpty? (cd/flowErrors "(:flow :order (merge gate review fix fresh))"))) "an unknown stage word is rejected")
      (assert (not (listEmpty? (cd/flowErrors "(:flow :newWhen sometimes)"))) "an unknown newWhen is rejected")
      (assert (not (listEmpty? (cd/flowErrors "(:flow :newWhen idle :slots 3)"))) "an unknown key is rejected")
      (assert (not (cd/flowOn? "")) "no row: flow off")
      (assert (not (cd/flowOn? "(:flow :newWhen never)")) "a rejected row: flow off")
      (assert (cd/flowIdle? "(:flow :newWhen idle)") "idle is read")
      (assert (not (cd/flowIdle? "(:flow)")) "always is the default")
      (assert (= (cd/flowOrderOf "(:flow :order (fix merge gate review new))") (list "fix" "merge" "gate" "review" "new")) "the order is read")
      (assert (= (cd/flowClass (pf/cuIn "A" "ready" "" "sh/A")) "fix") "a ready unit with a branch is a fix round")
      (assert (= (cd/flowClass (pf/cuIn "A" "ready" "" "")) "new") "a ready unit with no branch is new")
      (assert (= (cd/flowClass (with (pf/cuIn "A" "ready" "" "") :sig "mergeRedFix 1/2: train red")) "fix") "a merge-red fix round is a fix round")
      (assert (= (cd/flowClass (pf/cuIn "A" "awaitReview" "" "sh/A")) "review") "awaitReview is review")
      (assert (= (cd/flowClass (pf/cuIn "A" "blocked" "" "sh/A")) "other") "a blocked unit is no class")
      true)

fn ! testFlow root: String -> Bool
  (let [(none0 (flowCase root "flowNone" "" 2))
        (always (flowCase root "flowAlways" "(:flow :order (merge gate review fix new) :newWhen always)" 2))
        (wide (flowCase root "flowWide" "(:flow :newWhen always)" 4))
        (idle (flowCase root "flowIdle" "(:flow :order (merge gate review fix new) :newWhen idle)" 4))
        (bad (flowCase root "flowBad" "(:flow :order (merge gate))" 2))
        (idleDir (str root "/flowIdle"))
        (held (stringTrim (readOr (str idleDir "/flowHeld.asn"))))
        (status (cd/status! (ctxTok idleDir 4)))
        (heldRows (journalRows idleDir "(:flowHeld "))
        (released (cd/flowNote! (ctxTok idleDir 4) (list)))
        (problems (cd/ladderProblems (str root "/flowBad")))]
    (do (assert (= none0 (list "launched" "waiting" "writing" "writing")) (str "no flow row: the first write and the fix round share the capacity as today: " (stringJoin none0 " ")))
        (assert (= always (list "launched" "waiting" "ready" "writing")) (str "downstream first: the merge launch takes a slot, the fix round the other, the first write waits: " (stringJoin always " ")))
        (assert (= wide (list "launched" "waiting" "writing" "writing")) (str "with slots left over the first write is admitted: " (stringJoin wide " ")))
        (assert (= idle (list "launched" "waiting" "ready" "writing")) (str "newWhen idle: a merge waiting its turn holds the first write: " (stringJoin idle " ")))
        (assert (= held "(:flowHeld :stage new :by ((:stage merge :ids (\"M2\"))))") (str "the hold names the stage and the units: " held))
        (assert (stringContains? status held) "status shows why new units are held")
        (assert (= (listLength heldRows) 1) (str "one journal row when the hold starts: " (stringJoin heldRows "|")))
        (assert (= released "released") "the hold ends when nothing downstream lacks a slot")
        (assert (not (fileExists? (str idleDir "/flowHeld.asn"))) "and its marker is removed")
        (assert (= (listLength (journalRows idleDir "(:flowReleased ")) 1) "with one release row")
        (assert (= bad (list "launched" "waiting" "writing" "writing")) (str "a rejected row steps as today: " (stringJoin bad " ")))
        (assert (listAny? (fn [(p String)] -> Bool (stringStartsWith? p "ladder flow: :order")) problems) (str "and is a ladder problem: " (stringJoin problems "|")))
        true))

; (:m :do "dwell: a move to another state stamps :since, a move within the state keeps it; status prints per state the count and the oldest unit with its age and reason; a (:dwell) ladder row journals one row per unit and episode past its bound")
fn ! testDwell root: String -> Bool
  (let [(dir (str root "/dwell"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (ctx (ctxOf dir))
        (now (/ (nowNs) 1000000))
        (_ (st/put! dir (unitAfter "D1" (list))))
        (_ (st/put! dir (unitAfter "D2" (list))))
        (_ (st/put! dir (unitAfter "D3" (list))))
        (moved (cd/move! ctx (with (pf/cuIn "D1" "ready" "" "") :since 7) "blocked" "write" "" 0 0 "x" 0))
        (kept (cd/move! ctx (with moved :since 1000) "blocked" "write" "" 0 0 "y" 0))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "D1" "blocked" "" "") :since (- now 50000) :sig "vacuousGate: v")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "D2" "blocked" "" "") :since (- now 5000) :sig "other")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "D3" "ready" "" "") :since 0)))
        (status (cd/status! ctx))
        (rows (cd/stateRows (cd/readCUnits! dir) now))
        (none0 (cd/dwellNote! ctx))
        (_ (fileWrite (str dir "/ladder.asn") "(:dwell :blocked 30 :ready 10)\n"))
        (first (cd/dwellNote! ctx))
        (again (cd/dwellNote! ctx))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "D1" "blocked" "" "") :since (- now 40000) :sig "vacuousGate: v")))
        (episode (cd/dwellNote! ctx))
        (jr (journalRows dir "(:dwell "))]
    (do (assert (and (>= moved.since now) (= moved.st "blocked")) (str "a move to another state stamps :since: " (stringFromInt64 moved.since)))
        (assert (= kept.since 1000) (str "a move within the state keeps it: " (stringFromInt64 kept.since)))
        (assert (= (cd/parseCUnit (cd/renderCUnit kept)) (ok kept)) "the row keeps :since across render and parse")
        (assert (listContains? rows "(:state :st blocked :n 2 :oldest \"D1\" :ageS 50 :reason \"vacuousGate: v\")") (str "the oldest blocked unit with its age and reason: " (stringJoin rows "|")))
        (assert (listContains? rows "(:state :st ready :n 1 :oldest \"D3\" :ageS -1 :reason \"none\")") "a row of unknown age shows -1")
        (assert (stringContains? status "(:state :st blocked :n 2 :oldest \"D1\" ") "status carries the state rows")
        (assert (listEmpty? (cd/dwellErrors "(:dwell :ready 600 :merging 3600)")) "a valid dwell row")
        (assert (not (listEmpty? (cd/dwellErrors "(:dwell :readyy 5)"))) "an unknown state is rejected")
        (assert (not (listEmpty? (cd/dwellErrors "(:dwell :ready 0)"))) "a bound below 1 is rejected")
        (assert (not (listEmpty? (cd/dwellErrors "(:dwell)"))) "a row with no bound is rejected")
        (assert (= (cd/dwellBound "(:dwell :ready 600)" "merging") -1) "a state the row does not name has no bound")
        (assert (= none0 0) "no dwell row journals nothing")
        (assert (= first 1) (str "one unit past its bound: " (stringFromInt64 first)))
        (assert (= again 0) "once per episode")
        (assert (= episode 1) "a new episode journals again")
        (assert (= (listLength jr) 2) (str "two dwell rows: " (stringJoin jr "|")))
        (assert (stringStartsWith? (optionOr (listHead jr) "") "(:dwell :unit \"D1\" :st blocked :since ") "the row names unit, state and episode")
        true))

fn ! runTests -> Bool
  (let [(root (pf/scratch "flowDrain" "t"))
        (_ (pf/cleanup root))
        (_ (dirCreate root))
        (reload (testReload root))
        (reloadTick (testReloadTick root))
        (roots (testRoots root))
        (release (testRootRelease root))
        (lows (testLows root))
        (flow (testFlow root))
        (dwell (testDwell root))
        (_ (pf/cleanup root))]
    (do (assert reload "reload replaces the definition and resets the counters")
        (assert reloadTick "the tick drains reload requests")
        (assert roots "roots are followed through waiting units and listed with their count")
        (assert release "a merged root releases its dependants in the same tick")
        (assert lows "requeue and close drop the addendum, a fix round keeps solo, the stall probe reads the current run")
        (assert (testFlowRows) "flow rows and unit classes")
        (assert flow "downstream stages take the slots before a first write")
        (assert dwell "state ages in status and dwell rows once per episode")
        true))
