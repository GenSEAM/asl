(module asl-tools/coord/tests/flowDrainTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/fleet/run :a fr) (asl-tools/coord/tests/fixtures/pipeFix :a pf)])

; (:m :ref FLOW-DRAIN :do "units are cleared and never sit: reload re-reads a unit's definition from the intake files and resets its counters")
fn ctxOf dir: String -> cd/Ctx
  (cd/Ctx :dir dir :holder "flowDrainTest" :ttlMs 600000 :maxWait 30 :maxSame 3 :stageSec 60 :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (list "/usr/bin/true")) :pace (cd/fixedPace 8 8))

fn ! cuOf! dir: String id: String -> cd/CUnit
  (optionOr (listFind (fn [(c cd/CUnit)] -> Bool (= c.id id)) (cd/readCUnits! dir)) (pf/cuIn id "missing" "" ""))

fn ! unitOf! dir: String id: String -> st/Task
  (optionOr (listFind (fn [(u st/Task)] -> Bool (= u.id id)) (resultOr (st/readUnits! dir) (list))) (pf/unitIn "missing" ""))

fn ! readOr path: String -> String
  (resultOr (fileReadString path) "")

fn ! journalRows dir: String head: String -> (List String)
  (filter (fn [(l String)] -> Bool (stringStartsWith? l head)) (stringLines (readOr (str dir "/journal.asn"))))

fn ! seed! dir: String id: String stateName: String c: cd/CUnit -> Bool
  (let [(_ (st/put! dir (pf/unitIn id "true")))
        (_ (dirCreate (str dir "/tasks")))
        (_ (fileWrite (str dir "/tasks/" id ".txt") (str "old task of " id)))]
    (ok? (cd/writeCUnit! dir (with c :st stateName))))

; (:m :do "a store with R1 blocked after three vacuous writes (retry count 2, a merge-red addendum), W1 writing, Q1 blocked whose new row waits on D0 (ready), N1 that no row names, P1 whose row has no :owns; the queue file of ladder.asn carries the corrected rows")
fn ! testReload root: String -> Bool
  (let [(dir (str root "/reload"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (queue (str root "/queue.asn"))
        (_ (fileWrite queue (str "(:u :id R1 :auto true :do \"new task of R1\" :owns (\"b.txt\" \"c.txt\") :gate \"./bin/asl test b.asl\")\n"
                                 "(:u :id W1 :auto true :do \"new task of W1\" :owns (\"w.txt\") :gate \"true\")\n"
                                 "(:u :id Q1 :auto true :do \"new task of Q1\" :owns (\"q.txt\") :gate \"true\" :after D0)\n"
                                 "(:u :id P1 :auto true :do \"no owns\" :gate \"true\")\n"
                                 "(:u :id U1 :auto true :do \"after a ghost\" :owns (\"u.txt\") :gate \"true\" :after NOPE)\n")))
        (_ (fileWrite (str dir "/ladder.asn") (str "(:queue :path " (st/q queue) " :channel free)\n")))
        (base (pf/cuIn "X" "ready" "" ""))
        (_ (seed! dir "R1" "blocked" (with base :id "R1" :fails 3 :esc 1 :sig "vacuousGate: gate passes on the base" :waited 4)))
        (_ (seed! dir "W1" "writing" (with base :id "W1")))
        (_ (seed! dir "Q1" "blocked" (with base :id "Q1" :sig "waitedOut: deps not merged")))
        (_ (seed! dir "D0" "ready" (with base :id "D0")))
        (_ (seed! dir "N1" "blocked" (with base :id "N1" :sig "x")))
        (_ (seed! dir "P1" "blocked" (with base :id "P1" :sig "y")))
        (_ (seed! dir "U1" "blocked" (with base :id "U1" :sig "z")))
        (_ (fileAppend (str dir "/journal.asn") (str "(:await :unit \"R1\" :lane \"x\" :why \"quorumStarved: a\")\n(:await :unit \"R1\" :lane \"x\" :why \"quorumStarved: b\")\n")))
        (starvedBefore (listLength (cd/starvedRows dir "R1")))
        (_ (fileAppend (str dir "/retries.asn") "(:retry :unit \"R1\" :why \"vacuous\" :n 2 :at 5)\n"))
        (_ (dirCreate (str dir "/runs")))
        (_ (fileWrite (str dir "/runs/R1-mergeRed.txt") "(:mergeRed :round 1)\n"))
        (oldR1 (cd/unitDigest! dir (unitOf! dir "R1")))
        (asked (cd/requestReload! dir (list "R1" "W1" "Q1" "N1" "P1" "ZZ" "U1")))
        (done (cd/reloadDrain! (ctxOf dir)))
        (r1 (cuOf! dir "R1"))
        (u1 (unitOf! dir "R1"))
        (rows (journalRows dir "(:reload "))
        (r1Row (optionOr (listFind (fn [(l String)] -> Bool (stringStartsWith? l "(:reload :unit \"R1\" :old ")) rows) ""))
        (refused (fn [(id String) (why String)] -> Bool (listAny? (fn [(l String)] -> Bool (stringStartsWith? l (str "(:reload :unit " (st/q id) " :refused " (st/q why) " "))) rows)))]
    (do (assert asked "the reload request is written")
        (assert (= done 2) (str "R1 and Q1 are reloaded, the rest refused: " (stringFromInt64 done)))
        (assert (= r1.st "ready") (str "a reloaded unit with no pending :after is ready: " r1.st))
        (assert (and (= r1.fails 0) (and (= r1.esc 0) (and (= r1.waited 0) (= r1.sig "")))) (str "its counters are reset: " (stringFromInt64 r1.fails) " " r1.sig))
        (assert (= u1.owns (list "b.txt" "c.txt")) (str "the stored owns come from the corrected row: " (stringJoin u1.owns ",")))
        (assert (= u1.gate "./bin/asl test b.asl") (str "the stored gate comes from the corrected row: " u1.gate))
        (assert (= (readOr (str dir "/tasks/R1.txt")) "new task of R1") "the task text comes from the corrected row")
        (assert (stringContains? r1Row (str ":old " (st/q oldR1) " :new ")) (str "the reload row journals the old digest: " r1Row))
        (assert (not (stringContains? r1Row (str ":new " (st/q oldR1)))) (str "and a different new digest: " r1Row))
        (assert (= (cd/unitDigest! dir u1) (sp1 r1Row)) (str "the new digest is the stored definition's: " r1Row))
        (assert (not (fileExists? (str dir "/runs/R1-mergeRed.txt"))) "the merge-red addendum is gone")
        (assert (= (pairFirst (cd/retryLast! dir "R1")) 0) "the blocked-retry count starts again")
        (assert (= (cuOf! dir "Q1").st "queued") (str "a unit whose new :after is not merged waits queued: " (cuOf! dir "Q1").st))
        (assert (= (unitOf! dir "Q1").after (list "D0")) "its :after comes from the row")
        (assert (= (cuOf! dir "W1").st "writing") "a writing unit is left alone")
        (assert (refused "W1" "writing") (str "and refused with its state: " (stringJoin rows "|")))
        (assert (refused "N1" "noRow") "a unit no intake row names is refused")
        (assert (= (cuOf! dir "N1").sig "x") "and left as it was")
        (assert (refused "P1" "need owns") "a row that is still not importable is refused")
        (assert (refused "ZZ" "unknown") "an id the store does not hold is refused")
        (assert (refused "U1" "after unknown NOPE") "a row whose :after names no unit is refused")
        (assert (= starvedBefore 2) "two quorumStarved rows before")
        (assert (= (listLength (cd/starvedRows dir "R1")) 0) "a reload starts the quorumStarved count again")
        (assert (not (fileExists? (str dir "/reload.asn"))) "the request file is consumed")
        true))

fn sp1 row: String -> String
  (let [(rest (optionOr (listGet (stringSplit row ":new \"") 1) ""))]
    (optionOr (listHead (stringSplit rest "\"")) ""))

; (:m :do "the running tick drains the reload file before it reads the store")
fn ! testReloadTick root: String -> Bool
  (let [(dir (str root "/reloadTick"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (queue (str root "/queueTick.asn"))
        (_ (fileWrite queue "(:u :id T1 :auto true :do \"fixed\" :owns (\"t.txt\") :gate \"true\")\n"))
        (_ (fileWrite (str dir "/ladder.asn") (str "(:queue :path " (st/q queue) ")\n")))
        (_ (seed! dir "T1" "blocked" (with (pf/cuIn "T1" "blocked" "" "") :sig "vacuousGate: v" :esc 1)))
        (_ (cd/requestReload! dir (list "T1")))
        (_ (cd/tick! (ctxOf dir)))
        (rows (journalRows dir "(:reload :unit \"T1\" :old "))]
    (do (assert (= (listLength rows) 1) (str "one tick reloads the unit: " (stringJoin rows "|")))
        (assert (!= (cuOf! dir "T1").st "blocked") (str "and it leaves blocked: " (cuOf! dir "T1").st))
        (assert (= (unitOf! dir "T1").owns (list "t.txt")) "with the corrected owns")
        true))

fn unitAfter id: String after: (List String) -> st/Task
  (with (pf/unitIn id "true") :after after :owns (list (str id ".txt")))

; (:m :do "roots: R blocked for a reason of its own holds A (blocked waiting on R) and B (queued waiting on A); C waits on M, which is merging, so it has no root; D waits on GONE, which the store does not hold")
fn ! testRoots root: String -> Bool
  (let [(dir (str root "/roots"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (units (list (pf/unitIn "R" "true") (unitAfter "A" (list "R")) (unitAfter "B" (list "A")) (pf/unitIn "M" "true") (unitAfter "C" (list "M")) (unitAfter "D" (list "GONE"))))
        (_ (map (fn [(u st/Task)] -> Bool (ok? (st/put! dir u))) units))
        (base (pf/cuIn "X" "queued" "" ""))
        (cus (list (with base :id "R" :st "blocked" :sig "vacuousGate: v") (with base :id "A" :st "blocked" :sig "waitedOut: deps not merged")
                   (with base :id "B") (with base :id "M" :st "merging") (with base :id "C") (with base :id "D")))
        (_ (map (fn [(c cd/CUnit)] -> Bool (ok? (cd/writeCUnit! dir c))) cus))
        (status (cd/status! (ctxOf dir)))
        (counts (cd/rootCounts units cus))]
    (do (assert (= (cd/depRootsOf units cus "B" (list)) (list "R")) (str "B waits through A on the root R: " (stringJoin (cd/depRootsOf units cus "B" (list)) ",")))
        (assert (= (cd/depRootsOf units cus "A" (list)) (list "R")) "A waits on R")
        (assert (listEmpty? (cd/depRootsOf units cus "C" (list))) "a dependency in a stage is no root")
        (assert (= (cd/depRootsOf units cus "D" (list)) (list "GONE")) "a dependency the store does not hold is a root")
        (assert (listEmpty? (cd/waitsOn units cus (with base :id "R" :st "blocked" :sig "vacuousGate: v"))) "a unit blocked for its own reason waits on nothing")
        (assert (= (listLength (filter (fn [(p (Pair String Int64))] -> Bool (and (= (pairFirst p) "R") (= (pairSecond p) 2))) counts)) 1) "R holds two units")
        (assert (stringContains? status "(:root \"R\" :st blocked :holds 2)") (str "status lists the root with the count it holds: " status))
        (assert (stringContains? status "(:root \"GONE\" :st missing :holds 1)") "and a missing root")
        (assert (stringContains? status "(:unit :id \"B\" :st queued :lane \"free\" :fails 0 :parked 0 :waited 0 :waitsOn (\"R\"))") "a waiting unit row names its root")
        (assert (stringContains? status "(:unit :id \"C\" :st queued :lane \"free\" :fails 0 :parked 0 :waited 0)") "a unit with no root names none")
        true))

; (:m :do "same-tick release: Z1 finishes its merge in this tick; A1 (queued) and B1 (blocked by the dependency wait, below maxWait) wait on it and step before it; both are ready after the one tick")
fn ! testRootRelease root: String -> Bool
  (let [(dir (str root "/release"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (st/put! dir (pf/unitIn "Z1" "true")))
        (_ (st/put! dir (unitAfter "A1" (list "Z1"))))
        (_ (st/put! dir (unitAfter "B1" (list "Z1"))))
        (epoch (match (st/claim! dir "Z1" "flowDrainTest" 600000) ((ok t) (match (st/parseLease t) ((ok l) l.epoch) ((err _) 0))) ((err _) 0)))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "Z1" "merging" "" "sh/Z1") :epoch epoch :launched 1)))
        (_ (cd/writeCUnit! dir (pf/cuIn "A1" "queued" "" "")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "B1" "blocked" "" "") :sig "waitedOut: deps not merged" :waited 2)))
        (_ (cd/writeRes! dir "Z1" "merge" (cd/Res :tiers "" :ok 1 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig "" :ms 1 :exit 0 :asserts 0 :verdict "")))
        (_ (cd/tick! (ctxOf dir)))]
    (do (assert (= (cuOf! dir "Z1").st "merged") (str "the root merges in the tick: " (cuOf! dir "Z1").st))
        (assert (= (cuOf! dir "A1").st "ready") (str "a queued dependant is ready in the same tick: " (cuOf! dir "A1").st))
        (assert (= (cuOf! dir "B1").st "ready") (str "a dependant blocked by the wait alone is ready in the same tick: " (cuOf! dir "B1").st))
        (assert (= (cuOf! dir "B1").sig "") "with its wait signature cleared")
        true))

; (:m :do "three lows: requeue and close remove a stale merge-red addendum; a merge-red fix round keeps the solo mark; the stall infra probe reads the Leon journal from the start of the current run, so a providerWait row an earlier run left is no provider stop now")
fn ! testLows root: String -> Bool
  (let [(dir (str root "/lows"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (dirCreate (str dir "/runs")))
        (ctx (ctxOf dir))
        (_ (seed! dir "Q" "blocked" (with (pf/cuIn "Q" "blocked" "" "") :sig "merge failed")))
        (_ (seed! dir "K" "blocked" (with (pf/cuIn "K" "blocked" "" "") :sig "merge failed")))
        (_ (fileWrite (str dir "/runs/Q-mergeRed.txt") "(:mergeRed :round 1)\n"))
        (_ (fileWrite (str dir "/runs/K-mergeRed.txt") "(:mergeRed :round 1)\n"))
        (requeued (cd/requeueOne! ctx (resultOr (st/readUnits! dir) (list)) "Q"))
        (closed (cd/closeOne! ctx "K"))
        (_ (seed! dir "S" "merging" (with (pf/cuIn "S" "merging" "" "sh/S") :await "solo")))
        (s1 (cd/mergeRedFix! ctx (with (pf/cuIn "S" "merging" "" "sh/S") :await "solo") "train red: a/tests/aTest.asl" (cd/MergeRed :suites (list "(:suite \"a/tests/aTest.asl\")") :more 0 :key "k1") 1 2 5))
        (_ (seed! dir "P" "merging" (pf/cuIn "P" "merging" "" "sh/P")))
        (p1 (cd/mergeRedFix! ctx (pf/cuIn "P" "merging" "" "sh/P") "train red: a/tests/aTest.asl" (cd/MergeRed :suites (list "(:suite \"a/tests/aTest.asl\")") :more 0 :key "k2") 1 2 5))
        (wt (str root "/wtL"))
        (_ (dirCreate (str wt "/.asl/run/agentLoop")))
        (_ (fileWrite (str wt "/.asl/run/agentLoop/s1.journal") "(:turn 1)\n(:providerWait :route \"x\")\n"))
        (lc (with (pf/cuIn "L" "writing" wt "sh/L") :wt wt))
        (earlier (cd/stallInfraWhy ctx lc "(:stall :class stalled)" (/ (nowNs) 1000000) 0))
        (later (cd/stallInfraWhy ctx lc "(:stall :class stalled)" (/ (nowNs) 1000000) (+ (/ (nowNs) 1000000) 60000)))]
    (do (assert requeued "the blocked unit is requeued")
        (assert (not (fileExists? (str dir "/runs/Q-mergeRed.txt"))) "a requeue removes the merge-red addendum")
        (assert closed "the blocked unit is closed")
        (assert (not (fileExists? (str dir "/runs/K-mergeRed.txt"))) "a close removes the merge-red addendum")
        (assert (and (= s1.st "ready") (= s1.await "solo")) (str "a fix round keeps the solo mark: " s1.st " " s1.await))
        (assert (and (= p1.st "ready") (= p1.await "")) (str "and adds none: " p1.await))
        (assert (= earlier "provider") (str "a providerWait row inside the run is a provider stop: " earlier))
        (assert (= later "") (str "a providerWait row older than the current run is not: " later))
        true))

fn ctxTok dir: String tokens: Int64 -> cd/Ctx
  (with (ctxOf dir) :pace (cd/fixedPace tokens 8))

; (:m :do "one store per case: M1 and M2 merging (one train at a time, so M2 waits its turn), N1 ready for a first write, X1 ready for a fix round (its branch already written); one tick with the given ladder row and pace tokens; returns the states of M1 M2 N1 X1")
fn ! flowCase root: String name: String ladder: String tokens: Int64 -> (List String)
  (let [(dir (str root "/" name))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (map (fn [(id String)] -> Bool (ok? (st/put! dir (unitAfter id (list))))) (list "M1" "M2" "N1" "X1")))
        (ep (fn [(id String)] -> Int64 (match (st/claim! dir id "flowDrainTest" 600000) ((ok t) (match (st/parseLease t) ((ok l) l.epoch) ((err _) 0))) ((err _) 0))))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "M1" "merging" "" "sh/M1") :epoch (ep "M1"))))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "M2" "merging" "" "sh/M2") :epoch (ep "M2"))))
        (_ (cd/writeCUnit! dir (pf/cuIn "N1" "ready" "" "")))
        (_ (cd/writeCUnit! dir (pf/cuIn "X1" "ready" "" "sh/X1")))
        (_ (if (stringEmpty? ladder) () (let [(_ (fileWrite (str dir "/ladder.asn") (str ladder "\n")))] ())))
        (_ (cd/tick! (ctxTok dir tokens)))
        (m1 (cuOf! dir "M1"))]
    (list (if (= m1.launched 1) "launched" "waiting") (if (= (cuOf! dir "M2").launched 1) "launched" "waiting") (cuOf! dir "N1").st (cuOf! dir "X1").st))

fn ! testFlowRows -> Bool
  (do (assert (listEmpty? (cd/flowErrors "(:flow :order (merge gate review fix new) :newWhen idle)")) "a valid flow row")
      (assert (listEmpty? (cd/flowErrors "(:flow :newWhen always)")) "the order may be left to its default")
      (assert (listEmpty? (cd/flowErrors "(:flow :order (fix merge gate review new))")) "any permutation is an order")
      (assert (not (listEmpty? (cd/flowErrors "(:flow :order (merge gate review fix))"))) "an order missing a stage is rejected")
      (assert (not (listEmpty? (cd/flowErrors "(:flow :order (merge merge review fix new))"))) "an order with a stage twice is rejected")
      (assert (not (listEmpty? (cd/flowErrors "(:flow :order (merge gate review fix fresh))"))) "an unknown stage word is rejected")
      (assert (not (listEmpty? (cd/flowErrors "(:flow :newWhen sometimes)"))) "an unknown newWhen is rejected")
      (assert (not (listEmpty? (cd/flowErrors "(:flow :newWhen idle :slots 3)"))) "an unknown key is rejected")
      (assert (not (cd/flowOn? "")) "no row: flow off")
      (assert (not (cd/flowOn? "(:flow :newWhen never)")) "a rejected row: flow off")
      (assert (cd/flowIdle? "(:flow :newWhen idle)") "idle is read")
      (assert (not (cd/flowIdle? "(:flow)")) "always is the default")
      (assert (= (cd/flowOrderOf "(:flow :order (fix merge gate review new))") (list "fix" "merge" "gate" "review" "new")) "the order is read")
      (assert (= (cd/flowClass (pf/cuIn "A" "ready" "" "sh/A")) "fix") "a ready unit with a branch is a fix round")
      (assert (= (cd/flowClass (pf/cuIn "A" "ready" "" "")) "new") "a ready unit with no branch is new")
      (assert (= (cd/flowClass (with (pf/cuIn "A" "ready" "" "") :sig "mergeRedFix 1/2: train red")) "fix") "a merge-red fix round is a fix round")
      (assert (= (cd/flowClass (pf/cuIn "A" "awaitReview" "" "sh/A")) "review") "awaitReview is review")
      (assert (= (cd/flowClass (pf/cuIn "A" "blocked" "" "sh/A")) "other") "a blocked unit is no class")
      true)

; (:m :do "a gate held by the stop level: G1 gating not launched while ctx.hold, N1 ready for a first write; one tick with the given row; returns G1 launched and N1 state")
fn ! holdCase root: String name: String ladder: String -> (List String)
  (let [(dir (str root "/" name))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (map (fn [(id String)] -> Bool (ok? (st/put! dir (unitAfter id (list))))) (list "G1" "N1")))
        (ep (match (st/claim! dir "G1" "flowDrainTest" 600000) ((ok t) (match (st/parseLease t) ((ok l) l.epoch) ((err _) 0))) ((err _) 0)))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "G1" "gating" "" "sh/G1") :epoch ep)))
        (_ (cd/writeCUnit! dir (pf/cuIn "N1" "ready" "" "")))
        (_ (fileWrite (str dir "/ladder.asn") (str ladder "\n")))
        (_ (cd/tick! (with (ctxTok dir 4) :hold true)))]
    (list (if (= (cuOf! dir "G1").launched 1) "launched" "waiting") (cuOf! dir "N1").st))

; (:m :do "a fix round owed this tick: W1 writing a fix round (branch sh/W1) loses its lease and comes back ready in the tick, N1 is ready for a first write, one pace token; returns the states of W1 and N1")
fn ! owedCase root: String name: String ladder: String -> String
  (let [(dir (str root "/" name))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (map (fn [(id String)] -> Bool (ok? (st/put! dir (unitAfter id (list))))) (list "W1" "N1")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "W1" "writing" "" "sh/W1") :launched 1 :epoch 7)))
        (_ (cd/writeCUnit! dir (pf/cuIn "N1" "ready" "" "")))
        (_ (if (stringEmpty? ladder) () (let [(_ (fileWrite (str dir "/ladder.asn") (str ladder "\n")))] ())))
        (_ (cd/tick! (ctxTok dir 1)))]
    (str (cuOf! dir "W1").st " " (cuOf! dir "N1").st))

fn ! testFlow root: String -> Bool
  (let [(owedOff (owedCase root "owedOff" ""))
        (owedIdle (owedCase root "owedIdle" "(:flow :newWhen idle)"))
        (owedAlways (owedCase root "owedAlways" "(:flow :newWhen always)"))
        (none0 (flowCase root "flowNone" "" 2))
        (always (flowCase root "flowAlways" "(:flow :order (merge gate review fix new) :newWhen always)" 1))
        (wide (flowCase root "flowWide" "(:flow :newWhen always)" 4))
        (train (flowCase root "flowTrain" "(:flow :order (merge gate review fix new) :newWhen idle)" 4))
        (idle (holdCase root "flowIdle" "(:flow :order (merge gate review fix new) :newWhen idle)"))
        (open (holdCase root "flowOpen" "(:flow :order (merge gate review fix new) :newWhen always)"))
        (bad (flowCase root "flowBad" "(:flow :order (merge gate))" 2))
        (idleDir (str root "/flowIdle"))
        (held (stringTrim (readOr (str idleDir "/flowHeld.asn"))))
        (status (cd/status! (ctxTok idleDir 4)))
        (heldPair (list (pair "gate" (list "G1"))))
        (again (cd/flowNote! (ctxTok idleDir 4) heldPair))
        (heldRows (journalRows idleDir "(:flowHeld "))
        (released (cd/flowNote! (ctxTok idleDir 4) (list)))
        (problems (cd/ladderProblems (str root "/flowBad")))]
    (do (assert (= owedOff "ready ready") (str "no flow row: the slot freed in the tick is counted from its start, as today: " owedOff))
        (assert (= owedIdle "ready ready") (str "newWhen idle: a fix round that came back in this tick is owed the freed slot: " owedIdle))
        (assert (= owedAlways "ready ready") (str "newWhen always: the new pass leaves the owed slot free too: " owedAlways))
        (assert (= (cd/fixOwed (list (pair "gate" (list "G1")) (pair "fix" (list "F1" "F2")))) 2) "only fix rounds are owed slots")
        (assert (= none0 (list "launched" "waiting" "writing" "writing")) (str "no flow row: the first write and the fix round share the capacity as today: " (stringJoin none0 " ")))
        (assert (= always (list "launched" "waiting" "ready" "writing")) (str "downstream first, one slot: the merge launch holds none (its train is jobserver-bound, WRITER-ADMIT-DECOUPLE), the fix round takes the slot, the first write waits: " (stringJoin always " ")))
        (assert (= wide (list "launched" "waiting" "writing" "writing")) (str "with slots left over the first write is admitted: " (stringJoin wide " ")))
        (assert (= train (list "launched" "waiting" "writing" "writing")) (str "newWhen idle: a merge waiting behind the running train holds no first write: " (stringJoin train " ")))
        (assert (not (fileExists? (str root "/flowTrain/flowHeld.asn"))) "and writes no hold")
        (assert (= idle (list "waiting" "ready")) (str "newWhen idle: a gate that cannot start holds the first write: " (stringJoin idle " ")))
        (assert (= open (list "waiting" "writing")) (str "newWhen always only orders: " (stringJoin open " ")))
        (assert (= held "(:flowHeld :stage new :by ((:stage gate :ids (\"G1\"))))") (str "the hold names the stage and the units: " held))
        (assert (stringContains? status held) "status shows why new units are held")
        (assert (= again "") "a later tick of the same hold returns nothing")
        (assert (= (listLength heldRows) 1) (str "and journals no second row: " (stringJoin heldRows "|")))
        (assert (= released "released") "the hold ends when nothing downstream lacks a slot")
        (assert (not (fileExists? (str idleDir "/flowHeld.asn"))) "and its marker is removed")
        (assert (= (listLength (journalRows idleDir "(:flowReleased ")) 1) "with one release row")
        (assert (= bad (list "launched" "waiting" "writing" "writing")) (str "a rejected row steps as today: " (stringJoin bad " ")))
        (assert (listAny? (fn [(p String)] -> Bool (stringStartsWith? p "ladder flow: :order")) problems) (str "and is a ladder problem: " (stringJoin problems "|")))
        true))

; (:m :do "held judgement: a merge held on a red base, a fix round in provider backoff and a unit whose state changed in the tick are not held; a merge with no train running and a fix round with lane room are")
fn ! testHeldIn root: String -> Bool
  (let [(dir (str root "/heldIn"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (ctx (ctxTok dir 4))
        (mFree (pf/cuIn "MA" "merging" "" "sh/MA"))
        (mBase (with (pf/cuIn "MB" "merging" "" "sh/MB") :await "baseRed:abc train baseRed: x"))
        (fOk (pf/cuIn "FA" "ready" "" "sh/FA"))
        (fWait (pf/cuIn "FB" "ready" "" "sh/FB"))
        (_ (fileWrite (str dir "/providerWait.asn") (str "(:pw :unit \"FB\" :n 1 :until " (stringFromInt64 (+ (/ (nowNs) 1000000) 600000)) ")\n")))
        (cus (list mFree mBase fOk fWait))
        (moved (list (with mFree :st "gating") mBase (with fOk :st "writing") fWait))]
    (do (assert (= (cd/flowHeldIn ctx cus cus "merge") (list "MA")) (str "a merge with no train running is held, one on a red base is not: " (stringJoin (cd/flowHeldIn ctx cus cus "merge") ",")))
        (assert (= (cd/flowHeldIn ctx cus cus "fix") (list "FA")) (str "a fix round in provider backoff is not held: " (stringJoin (cd/flowHeldIn ctx cus cus "fix") ",")))
        (assert (listEmpty? (cd/flowHeldIn ctx moved cus "merge")) "a unit that changed state in this tick is not held")
        (assert (= (cd/flowHeldIn ctx moved cus "fix") (list "FA")) "a fix round that came back from writing in this tick is held: it is owed the next slot")
        true))

; (:m :do "a unit blocked for its own failure is not woken by rootRelease! when its dependencies merge; a reload file a crashed tick left as .taken is reloaded by the next drain")
fn ! testReleaseOwn root: String -> Bool
  (let [(dir (str root "/own"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (st/put! dir (pf/unitIn "Z3" "true")))
        (_ (st/put! dir (unitAfter "F3" (list "Z3"))))
        (_ (cd/writeCUnit! dir (pf/cuIn "Z3" "merged" "" "")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "F3" "blocked" "" "") :sig "fail: gate red")))
        (n0 (cd/rootRelease! (ctxOf dir) (resultOr (st/readUnits! dir) (list))))
        (queue (str root "/ownQueue.asn"))
        (_ (fileWrite queue "(:u :id F3 :auto true :do \"fixed\" :owns (\"f.txt\") :gate \"true\" :after Z3)\n"))
        (_ (fileWrite (str dir "/ladder.asn") (str "(:queue :path " (st/q queue) ")\n")))
        (_ (fileWrite (str dir "/reload.asn.taken") "(:reload :unit \"F3\")\n"))
        (redo (cd/reloadDrain! (ctxOf dir)))]
    (do (assert (= n0 0) "nothing is released")
        (assert (= (cuOf! dir "F3").st "ready") (str "after the reload, not before: " (cuOf! dir "F3").st))
        (assert (= redo 1) "a leftover .taken file is reloaded")
        (assert (not (fileExists? (str dir "/reload.asn.taken"))) "and removed")
        true))

; (:m :do "dwell: a move to another state stamps :since, a move within the state keeps it; status prints per state the count and the oldest unit with its age and reason; a (:dwell) ladder row journals one row per unit and episode past its bound")
fn ! testDwell root: String -> Bool
  (let [(dir (str root "/dwell"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (ctx (ctxOf dir))
        (now (/ (nowNs) 1000000))
        (_ (st/put! dir (unitAfter "D1" (list))))
        (_ (st/put! dir (unitAfter "D2" (list))))
        (_ (st/put! dir (unitAfter "D3" (list))))
        (moved (cd/move! ctx (with (pf/cuIn "D1" "ready" "" "") :since 7) "blocked" "write" "" 0 0 "x" 0))
        (kept (cd/move! ctx (with moved :since 1000) "blocked" "write" "" 0 0 "y" 0))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "D1" "blocked" "" "") :since (- now 50000) :sig "vacuousGate: v")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "D2" "blocked" "" "") :since (- now 5000) :sig "other")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "D3" "ready" "" "") :since 0)))
        (status (cd/status! ctx))
        (rows (cd/stateRows (cd/readCUnits! dir) now))
        (none0 (cd/dwellNote! ctx))
        (_ (fileWrite (str dir "/ladder.asn") "(:dwell :blocked 30 :ready 10)\n"))
        (first (cd/dwellNote! ctx))
        (again (cd/dwellNote! ctx))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "D1" "blocked" "" "") :since (- now 40000) :sig "vacuousGate: v")))
        (episode (cd/dwellNote! ctx))
        (_ (st/put! dir (unitAfter "Q9" (list "ZZ9"))))
        (_ (cd/step! ctx (unitAfter "Q9" (list "ZZ9")) 8))
        (q9 (cuOf! dir "Q9"))
        (jr (journalRows dir "(:dwell "))]
    (do (assert (and (>= moved.since now) (= moved.st "blocked")) (str "a move to another state stamps :since: " (stringFromInt64 moved.since)))
        (assert (= kept.since 1000) (str "a move within the state keeps it: " (stringFromInt64 kept.since)))
        (assert (= (cd/parseCUnit (cd/renderCUnit kept)) (ok kept)) "the row keeps :since across render and parse")
        (assert (listContains? rows "(:state :st blocked :n 2 :oldest \"D1\" :ageS 50 :reason \"vacuousGate: v\")") (str "the oldest blocked unit with its age and reason: " (stringJoin rows "|")))
        (assert (listContains? rows "(:state :st ready :n 1 :oldest \"D3\" :ageS -1 :reason \"none\")") "a row of unknown age shows -1")
        (assert (stringContains? status "(:state :st blocked :n 2 :oldest \"D1\" ") "status carries the state rows")
        (assert (listEmpty? (cd/dwellErrors "(:dwell :ready 600 :merging 3600)")) "a valid dwell row")
        (assert (not (listEmpty? (cd/dwellErrors "(:dwell :readyy 5)"))) "an unknown state is rejected")
        (assert (not (listEmpty? (cd/dwellErrors "(:dwell :ready 0)"))) "a bound below 1 is rejected")
        (assert (not (listEmpty? (cd/dwellErrors "(:dwell)"))) "a row with no bound is rejected")
        (assert (= (cd/dwellBound "(:dwell :ready 600)" "merging") -1) "a state the row does not name has no bound")
        (assert (= none0 0) "no dwell row journals nothing")
        (assert (= first 1) (str "one unit past its bound: " (stringFromInt64 first)))
        (assert (= again 0) "once per episode")
        (assert (= episode 1) "a new episode journals again")
        (assert (and (= q9.st "queued") (>= q9.since now)) (str "a unit row is stamped when it is first stored: " (stringFromInt64 q9.since)))
        (assert (= (listLength jr) 2) (str "two dwell rows: " (stringJoin jr "|")))
        (assert (stringStartsWith? (optionOr (listHead jr) "") "(:dwell :unit \"D1\" :st blocked :since ") "the row names unit, state and episode")
        true))

fn ! aheadCached! dir: String wt: String id: String gate: String -> Bool
  (let [(head (stringTrim (pf/sh (str "git -C " wt " rev-parse HEAD"))))
        (mb (stringTrim (pf/sh (str "git -C " wt " merge-base HEAD main"))))]
    (ok? (fileAppend (str dir "/journal.asn") (str "(:ahead :unit " (st/q id) " :head " (st/q head) " :mb " (st/q mb) " :gate " (st/q gate) " :commits 1 :gateExit 0 :executed 4 :baseExit 1 :verdict gating)\n"))))

; (:m :do "reload by evidence, through aheadGreen!: R2 and K2 each have a commit on sh/UNIT that the cached ahead row calls green (gating, no writer). R2's new row changes its owns: the branch is archived as sh/R2-reload-S with its commit, a fresh worktree starts at the base and aheadGreen! sends it to a writer. K2's new row only changes its channel: branch, worktree and the gating answer stay")
fn ! testReloadArchive root: String -> Bool
  (let [(top (str root "/arch"))
        (_ (dirCreate top))
        (repo (pf/repoIn top))
        (store (str top "/store"))
        (wts (str top "/wts"))
        (uR (pf/unitIn "R2" "true"))
        (uK (pf/unitIn "K2" "true"))
        (wtR (pf/seedUnit! top uR "blocked" "impl.txt"))
        (wtK (pf/seedUnit! top uK "blocked" "impl.txt"))
        (_ (fileWrite (str store "/repo.path") (str repo "\n")))
        (_ (fileWrite (str store "/worktrees.path") (str wts "\n")))
        (_ (fileWrite (str store "/tasks/R2.txt") "r task"))
        (_ (fileWrite (str store "/tasks/K2.txt") "k task"))
        (queue (str top "/queue.asn"))
        (_ (fileWrite queue (str "(:u :id R2 :auto true :do \"r task\" :owns (\"impl.txt\" \"b.txt\") :gate \"true\")\n"
                                 "(:u :id K2 :auto true :do \"k task\" :owns (\"impl.txt\") :gate \"true\" :channel paid)\n")))
        (_ (fileWrite (str store "/ladder.asn") (str "(:queue :path " (st/q queue) ")\n")))
        (_ (aheadCached! store wtR "R2" "true"))
        (_ (aheadCached! store wtK "K2" "true"))
        (rc (cd/realCfg (list "--repo" repo "--worktrees" wts) store))
        (beforeR (cd/aheadGreen! rc store uR (pf/cuIn "R2" "writing" wtR "sh/R2") wtR))
        (headR (stringTrim (pf/sh (str "git -C " repo " rev-parse sh/R2"))))
        (_ (cd/requestReload! store (list "R2" "K2")))
        (done (cd/reloadDrain! (ctxOf store)))
        (r2 (cuOf! store "R2"))
        (k2 (cuOf! store "K2"))
        (archived (stringTrim (pf/sh (str "git -C " repo " for-each-ref '--format=%(refname:short)' 'refs/heads/sh/R2-reload-*'"))))
        (archivedHead (stringTrim (pf/sh (str "git -C " repo " rev-parse " archived))))
        (u2 (unitOf! store "R2"))
        (fresh (cd/attachOrAdd rc u2 wtR))
        (afterR (cd/aheadGreen! rc store u2 (pf/cuIn "R2" "writing" wtR "sh/R2") wtR))
        (afterK (cd/aheadGreen! rc store (unitOf! store "K2") (pf/cuIn "K2" "writing" wtK "sh/K2") wtK))
        (rows (journalRows store "(:reload "))]
    (do (assert (not (stringEmpty? repo)) "the fixture repo is made")
        (assert (some? beforeR) "before the reload the old commit answers gating, no writer would run")
        (assert (= done 2) (str "both units are reloaded: " (stringJoin rows "|")))
        (assert (stringStartsWith? archived "sh/R2-reload-") (str "the old branch is archived under a new name: " archived))
        (assert (= archivedHead headR) "with its commit")
        (assert (and (= r2.branch "") (= r2.wt "")) (str "the unit row forgets the old branch: " r2.branch))
        (assert (ok? fresh) "a fresh worktree is checked out")
        (assert (= (stringTrim (pf/sh (str "git -C " wtR " rev-list --count main..HEAD"))) "0") "it starts at the base with no commit ahead")
        (assert (none? afterR) "and aheadGreen! sends it to a writer")
        (assert (some? afterK) "a reload that only changes the channel keeps the branch and its gating answer")
        (assert (and (= k2.branch "sh/K2") (= k2.lane "paid")) (str "the kept unit keeps its branch on the new lane: " k2.branch " " k2.lane))
        (assert (listAny? (fn [(l String)] -> Bool (and (stringStartsWith? l "(:reload :unit \"R2\" :old ") (stringContains? l " :branch archived :archive \"sh/R2-reload-"))) rows) "the reload row says archived")
        (assert (listAny? (fn [(l String)] -> Bool (and (stringStartsWith? l "(:reload :unit \"K2\" :old ") (stringContains? l " :branch kept "))) rows) "and kept")
        true))

; (:m :do "a reload whose archive fails: F2 has a preOnBase tip ref left (made by fast-import) and no live worktree; G2 has a live worktree outside the store's worktree base, so its removal fails. Both new rows change owns. Each unit is left blocked at stage reload with the reason, one escalation row, its branch and its old definition; archiveName! picks -2 when the same-second name is taken")
fn ! testArchiveFailed root: String -> Bool
  (let [(top (str root "/archFail"))
        (_ (dirCreate top))
        (repo (pf/repoIn top))
        (store (str top "/store"))
        (uF (pf/unitIn "F2" "true"))
        (uG (pf/unitIn "G2" "true"))
        (_ (pf/seedUnit! top uF "blocked" "impl.txt"))
        (wtG (pf/seedUnit! top uG "blocked" "impl.txt"))
        (_ (cd/writeCUnit! store (pf/cuIn "F2" "blocked" (str top "/gone/asex" "-F2") "sh/F2")))
        (refs (pf/sh (str "cd " repo " && sha=$(git rev-parse main) && printf 'reset refs/asex/preOnBase/F2\\nfrom %s\\n\\nreset refs/heads/sh/R9-reload-100\\nfrom %s\\n\\n' $sha $sha | git fast-import --quiet && echo refsOk")))
        (_ (fileWrite (str store "/repo.path") (str repo "\n")))
        (_ (fileWrite (str store "/worktrees.path") (str top "/elsewhere\n")))
        (_ (fileWrite (str store "/tasks/F2.txt") "f task"))
        (_ (fileWrite (str store "/tasks/G2.txt") "g task"))
        (queue (str top "/queue.asn"))
        (_ (fileWrite queue (str "(:u :id F2 :auto true :do \"f task\" :owns (\"impl.txt\" \"f.txt\") :gate \"true\")\n"
                                 "(:u :id G2 :auto true :do \"g task\" :owns (\"impl.txt\" \"g.txt\") :gate \"true\")\n")))
        (_ (fileWrite (str store "/ladder.asn") (str "(:queue :path " (st/q queue) ")\n")))
        (_ (cd/requestReload! store (list "F2" "G2")))
        (done (cd/reloadDrain! (ctxOf store)))
        (f2 (cuOf! store "F2"))
        (g2 (cuOf! store "G2"))
        (esc (stringLines (readOr (str store "/escalations.asn"))))
        (escOf (fn [(id String)] -> Int64 (listLength (filter (fn [(l String)] -> Bool (stringStartsWith? l (str "(:escalate :unit " (st/q id) " "))) esc))))
        (branches (stringTrim (pf/sh (str "git -C " repo " for-each-ref '--format=%(refname:short)' 'refs/heads/sh/F2*' 'refs/heads/sh/G2*'"))))]
    (do (assert (stringContains? refs "refsOk") "the fixture refs are made")
        (assert (= done 2) "both reloads are handled")
        (assert (= (str f2.st " " f2.sig) "blocked reload: archiveFailed preOnBase tip left") (str "a tip left blocks the unit with the reason: " f2.st " " f2.sig))
        (assert (and (= g2.st "blocked") (stringStartsWith? g2.sig "reload: archiveFailed worktree remove: ")) (str "a worktree that cannot be removed blocks it too: " g2.st " " g2.sig))
        (assert (and (= (escOf "F2") 1) (= (escOf "G2") 1)) (str "one escalation row each: " (stringJoin esc "|")))
        (assert (= (unitOf! store "F2").owns (list "impl.txt")) "the definition is not replaced, so the next reload archives again")
        (assert (= branches "sh/F2\nsh/G2") (str "the old branches stay unarchived: " branches))
        (assert (fileExists? wtG) "the live worktree stays")
        (assert (= (cd/archiveName! repo "R9" "100" 0) "sh/R9-reload-100-2") "a taken archive name gets a suffix")
        (assert (= (cd/archiveName! repo "R8" "100" 0) "sh/R8-reload-100") "a free one has none")
        true))

; (:m :do "infra class: a stage that died or timed out is an infra cause; with (:conductor :infraFree true) a unit blocked by it that already used its two retries is retried again, without the key it stays blocked")
fn ! infraCase root: String name: String ladder: String -> String
  (let [(dir (str root "/" name))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (st/put! dir (unitAfter "I1" (list))))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "I1" "blocked" "" "") :sig "stage timeout after 60 s" :esc 1)))
        (_ (fileWrite (str dir "/retries.asn") "(:retry :unit \"I1\" :why \"infra\" :n 2 :at 0)\n"))
        (_ (fileWrite (str dir "/ladder.asn") (str ladder "\n")))
        (_ (cd/retryBlocked! (ctxOf dir) (resultOr (st/readUnits! dir) (list))))]
    (cuOf! dir "I1").st)

fn timeoutRow id: String to: String at: Int64 -> String
  (str "(:t :unit " (st/q id) " :from writing :to " to " :stage write :model \"\" :tokens 0 :costUsd 0.000000 :verdict \"stage timeout after 60 s\" :ms 0 :at " (stringFromInt64 at) ")\n")

fn sigRetry id: String k: Int64 -> String
  (str "(:retry :unit " (st/q id) " :why \"infra\" :n " (stringFromInt64 k) " :sig \"stage timeout after 60 s\" :at " (stringFromInt64 (* k 1000)) ")\n")

; (:m :do "attribution: I1 on lane free timed out in write after two retries of the same signature; O1, also on free, left write at 2500 (to reviewing when it passed, to blocked when it failed too); the result is I1's state and lane after one blocked pass")
fn ! infraRun root: String name: String ladder: String retries: String other: String -> String
  (let [(dir (str root "/" name))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (st/put! dir (unitAfter "I1" (list))))
        (_ (st/put! dir (unitAfter "O1" (list))))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "I1" "blocked" "" "") :sig "stage timeout after 60 s" :esc 1)))
        (_ (cd/writeCUnit! dir (pf/cuIn "O1" (if (= other "blocked") "blocked" "reviewing") "" "")))
        (_ (fileWrite (str dir "/retries.asn") retries))
        (_ (fileWrite (str dir "/journal.asn") (str (if (stringEmpty? other) "" (timeoutRow "O1" other 2500)) (timeoutRow "I1" "blocked" 3000))))
        (_ (if (stringEmpty? ladder) () (let [(_ (fileWrite (str dir "/ladder.asn") (str ladder "\n")))] ())))
        (_ (cd/retryBlocked! (ctxOf dir) (resultOr (st/readUnits! dir) (list))))
        (c (cuOf! dir "I1"))]
    (str c.st " " c.lane))

fn ! testInfra root: String -> Bool
  (let [(ctx (ctxOf (str root "/infraWhy")))
        (_ (dirCreate root))
        (_ (dirCreate (str root "/infraWhy")))
        (_ (fileWrite (str root "/infraWhy/ladder.asn") "(:conductor :infraFree true)\n"))
        (plain (ctxOf (str root "/infraPlain")))
        (_ (dirCreate (str root "/infraPlain")))
        (two (str (sigRetry "I1" 1) (sigRetry "I1" 2)))
        (freeRow "(:conductor :blockedRetryMax 2 :retryBackoffS 1 :infraFree true)")
        (hop (infraRun root "infraHop" "" "" ""))
        (own (infraRun root "infraOwn" freeRow two "reviewing"))
        (outage (infraRun root "infraOutage" freeRow two "blocked"))
        (short (infraRun root "infraShort" freeRow (sigRetry "I1" 2) "reviewing"))
        (hopped (infraRun root "infraHopped" freeRow (str two "(:retry :unit \"I1\" :why \"infra\" :n 3 :sig \"other\" :at 2600)\n") "reviewing"))
        (u (unitAfter "I0" (list)))
        (why (fn [(sig String)] -> String (cd/transientWhy! ctx u (with (pf/cuIn "I0" "blocked" "" "") :sig sig) (list) (nowNs))))
        (free (infraCase root "infraFree" "(:conductor :blockedRetryMax 2 :retryBackoffS 1 :infraFree true)"))
        (capped (infraCase root "infraCapped" "(:conductor :blockedRetryMax 2 :retryBackoffS 1)"))]
    (do (assert (= (why "stage died without a result") "infra") "a stage that died is infra")
        (assert (= (why "stage timeout after 3600 s") "infra") "a stage timeout is infra")
        (assert (= (why "fail: gate red") "") "an own red is not")
        (assert (cd/infraCause? "lease") "a lost lease is an infra cause")
        (assert (not (cd/infraCause? "vacuous")) "the vacuous retry is not")
        (assert (= (cd/retryWaitMs 1000 10 true) 8000) "infra backoff stops doubling at 8 times")
        (assert (= (cd/retryWaitMs 1000 4 false) 16000) "other backoff doubles as before")
        (assert (= free "ready") (str "infraFree: infra retries do not spend the unit's limit: " free))
        (assert (= capped "blocked") (str "without the key the cap holds: " capped))
        (assert (= (cd/transientWhy! plain u (with (pf/cuIn "I0" "blocked" "" "") :sig "stage timeout after 60 s") (list) (nowNs)) "") "without infraFree a stage timeout is not transient")
        (assert (= hop "ready paid") (str "defaults: a write timeout hops the ladder as before: " hop))
        (assert (= own "ready paid") (str "the third timeout in a row while O1 passed write on the lane is own and hops: " own))
        (assert (= outage "ready free") (str "an outage that fails O1 too costs I1 nothing: " outage))
        (assert (= short "ready free") (str "two in a row stay below the bound: " short))
        (assert (= hopped "ready free") (str "another signature ends the run: " hopped))
        (assert (= (cd/infraStreak (stringLines two) "I1" "stage timeout after 60 s" 0) (pair 2 1000)) "the run counts rows of the same signature from its first")
        (assert (= (cd/infraStreak (stringLines two) "I1" "stage timeout after 60 s" 1500) (pair 1 2000)) "rows before a reset do not count")
        (assert (= (cd/infraOwnAfter (str root "/infraWhy")) 3) "the bound defaults to 3")
        (assert (not (listEmpty? (cd/cdErrors "(:conductor :infraOwnAfter 0)"))) "a bound below 1 is rejected")
        (assert (listEmpty? (cd/cdErrors "(:conductor :infraFree true :needsPlan true :infraOwnAfter 5)")) "the keys are known")
        true))

; (:m :do "needsPlan on a fixture repo whose main added and then deleted gone.txt and whose sh/F1 adds own/f.txt and keeps gone.txt (both by one fast-import stream): with (:conductor :needsPlan true) V1 blocked vacuous and S1 owning the deleted gone.txt move to needsPlan; N1 owning newdir/x.txt, G1 owning brandnew/* and F1 owning a file only its branch has stay; B1 behind an unmerged :after stays, B2 behind a merged one moves; D1 waits on V1 and status shows V1 as its root; reload brings V1 back to ready; without the key nothing moves")
fn ! planCase root: String name: String ladder: String -> String
  (let [(top (str root "/" name))
        (_ (dirCreate root))
        (_ (dirCreate top))
        (repo (pf/repoIn top))
        (dir (str top "/store"))
        (stream (str top "/stream.fi"))
        (_ (fileWrite stream (str "commit refs/heads/main\ncommitter t <t@example.invalid> 1700000000 +0000\ndata 3\nadd\nfrom refs/heads/main^0\nM 644 inline gone.txt\ndata 1\nx\n\n"
                                  "commit refs/heads/main\ncommitter t <t@example.invalid> 1700000001 +0000\ndata 3\ndel\nD gone.txt\n\n"
                                  "commit refs/heads/sh/F1\ncommitter t <t@example.invalid> 1700000002 +0000\ndata 3\nown\nfrom refs/heads/main^0\nM 644 inline own/f.txt\ndata 1\nf\nM 644 inline gone.txt\ndata 1\ny\n\n")))
        (fi (pf/sh (str "cd " repo " && git fast-import --quiet < " stream " && echo fiOk")))
        (_ (st/put! dir (unitAfter "V1" (list))))
        (_ (st/put! dir (with (unitAfter "S1" (list)) :owns (list "gone.txt"))))
        (_ (st/put! dir (with (unitAfter "N1" (list)) :owns (list "newdir/x.txt"))))
        (_ (st/put! dir (with (unitAfter "G1" (list)) :owns (list "brandnew/*"))))
        (_ (st/put! dir (with (unitAfter "F1" (list)) :owns (list "own/f.txt" "gone.txt"))))
        (_ (st/put! dir (unitAfter "D1" (list "V1"))))
        (_ (st/put! dir (unitAfter "A1" (list))))
        (_ (st/put! dir (with (unitAfter "B1" (list "A1")) :owns (list "gone.txt"))))
        (_ (st/put! dir (unitAfter "M1" (list))))
        (_ (st/put! dir (with (unitAfter "B2" (list "M1")) :owns (list "gone.txt"))))
        (_ (cd/writeCUnit! dir (pf/cuIn "A1" "writing" "" "")))
        (_ (cd/writeCUnit! dir (pf/cuIn "B1" "queued" "" "")))
        (_ (cd/writeCUnit! dir (pf/cuIn "M1" "merged" "" "")))
        (_ (cd/writeCUnit! dir (pf/cuIn "B2" "queued" "" "")))
        (_ (cd/writeCUnit! dir (pf/cuIn "N1" "queued" "" "")))
        (_ (cd/writeCUnit! dir (pf/cuIn "G1" "queued" "" "")))
        (_ (cd/writeCUnit! dir (pf/cuIn "F1" "ready" "" "sh/F1")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "V1" "blocked" "" "") :sig "vacuousGate: true" :esc 1)))
        (_ (cd/writeCUnit! dir (pf/cuIn "S1" "queued" "" "")))
        (_ (cd/writeCUnit! dir (pf/cuIn "D1" "queued" "" "")))
        (_ (fileWrite (str dir "/repo.path") (str repo "\n")))
        (_ (fileWrite (str dir "/ladder.asn") (str ladder "\n")))
        (n0 (cd/needsPlanSweep! (ctxOf dir) (resultOr (st/readUnits! dir) (list))))]
    (str (if (stringContains? fi "fiOk") "" "noFixture ") (cuOf! dir "V1").st " " (cuOf! dir "S1").st " " (stringFromInt64 n0) " " (cuOf! dir "B1").st " " (cuOf! dir "B2").st
         " " (cuOf! dir "N1").st " " (cuOf! dir "G1").st " " (cuOf! dir "F1").st))

; (:m :do "settled and close: a store whose only unit waits in needsPlan is settled, and conductor close moves it to merged")
fn ! testPlanSettled root: String -> Bool
  (let [(dir (str root "/planSettled"))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (st/put! dir (unitAfter "P9" (list))))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "P9" "needsPlan" "" "") :sig "staleOwns: x")))
        (settled (cd/settled? (ctxOf dir)))
        (closed (cd/closeOne! (ctxOf dir) "P9"))]
    (do (assert settled "a needsPlan unit counts as settled")
        (assert closed "close takes a needsPlan unit")
        (assert (= (cuOf! dir "P9").st "merged") (str "and closes it: " (cuOf! dir "P9").st))
        true))

fn ! testNeedsPlan root: String -> Bool
  (let [(on (planCase root "planOn" "(:conductor :needsPlan true)"))
        (off (planCase root "planOff" "(:conductor :blockedRetryMax 2)"))
        (dir (str root "/planOn/store"))
        (s1 (cuOf! dir "S1"))
        (status (cd/status! (ctxOf dir)))
        (queue (str root "/planQueue.asn"))
        (_ (fileWrite queue "(:u :id V1 :auto true :do \"a gate red on the base\" :owns (\"v.txt\") :gate \"./bin/asl test v.asl\")\n"))
        (_ (fileAppend (str dir "/ladder.asn") (str "(:queue :path " (st/q queue) ")\n")))
        (_ (cd/requestReload! dir (list "V1")))
        (_ (cd/reloadDrain! (ctxOf dir)))]
    (do (assert (testPlanSettled root) "a needsPlan unit is settled and close takes it")
        (assert (= on "needsPlan needsPlan 3 queued needsPlan queued queued ready") (str "a vacuous block and a path deleted on base move to needsPlan; a path in a new directory, a new glob, a file only the unit branch has and a path an unmerged :after unit may create stay; one behind a merged :after moves: " on))
        (assert (= off "blocked queued 0 queued queued queued queued ready") (str "without the key nothing moves: " off))
        (assert (= s1.sig "staleOwns: gone.txt") (str "the reason is kept: " s1.sig))
        (assert (stringContains? status "(:root \"V1\" :st needsPlan :holds 1)") (str "a needsPlan unit is the root of its dependants: " status))
        (assert (stringContains? status "(:state :st needsPlan :n 3 ") "status counts needsPlan")
        (assert (= (cuOf! dir "V1").st "ready") (str "reload is the way out: " (cuOf! dir "V1").st))
        true))

fn resOf sig: String verdict: String -> cd/Res
  (cd/Res :tiers "" :ok 0 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig sig :ms 0 :exit 1 :asserts 0 :verdict verdict :alias "")

; (:m :do "write bound on the unit row: B1 ready with :writes 2 parks at stage bound; D1 ready with :writes 1 is admitted and counted; C1 blocked with :writes 2 is requeued by the operator and admitted again; A1 reviewing with :writes 2 and an unreadable review diff is requeued automatically and keeps its count; R1 reviewing with :writes 2 fails review and goes back owed one write. Returns B1, C1, D1, A1, R1 as state and count")
fn ! boundCase root: String name: String ladder: String -> (List String)
  (let [(dir (str root "/" name))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (map (fn [(id String)] -> Bool (ok? (st/put! dir (unitAfter id (list))))) (list "A1" "B1" "C1" "D1" "R1")))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "B1" "ready" "" "") :writes 2)))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "C1" "blocked" "" "") :writes 2)))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "D1" "ready" "" "") :writes 1)))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "A1" "reviewing" "" "sh/A1") :writes 2)))
        (_ (cd/writeCUnit! dir (with (pf/cuIn "R1" "reviewing" "" "sh/R1") :writes 2)))
        (_ (if (stringEmpty? ladder) () (let [(_ (fileWrite (str dir "/ladder.asn") (str ladder "\n")))] ())))
        (ctx (ctxOf dir))
        (_ (cd/step! ctx (unitAfter "B1" (list)) 8))
        (_ (cd/step! ctx (unitAfter "D1" (list)) 8))
        (_ (cd/requeueOne! ctx (resultOr (st/readUnits! dir) (list)) "C1"))
        (_ (cd/step! ctx (unitAfter "C1" (list)) 8))
        (_ (cd/step! ctx (unitAfter "C1" (list)) 8))
        (_ (cd/finish! ctx (unitAfter "A1" (list)) (cuOf! dir "A1") (resOf "review diff unreadable" "requeue")))
        (_ (cd/finish! ctx (unitAfter "R1" (list)) (cuOf! dir "R1") (resOf "review: a defect" "fail")))
        (of (fn [(id String)] -> String (let [(c (cuOf! dir id))] (str c.st " " (stringFromInt64 c.writes)))))]
    (list (str (of "B1") " " (cuOf! dir "B1").sig) (of "C1") (of "D1") (of "A1") (of "R1")))

fn ! testBound root: String -> Bool
  (let [(off (boundCase root "boundOff" ""))
        (on (boundCase root "boundOn" "(:attempts :maxWrites 2)"))
        (bad (boundCase root "boundBad" "(:attempts :maxWrites 0)"))
        (esc (resultOr (fileReadString (str root "/boundOn/escalations.asn")) ""))
        (mDir (str root "/boundMerge"))
        (_ (dirCreate mDir))
        (m1 (cd/mergeRedFix! (ctxOf mDir) (with (pf/cuIn "M1" "merging" "" "sh/M1") :writes 2) "train red: a/tests/aTest.asl" (cd/MergeRed :suites (list "(:suite \"a/tests/aTest.asl\")") :more 0 :key "k1") 1 2 5))
        (row (cd/renderCUnit (pf/cuIn "Z" "ready" "" "")))]
    (do (assert (listEmpty? (cd/attemptsErrors "(:attempts :maxWrites 12)")) "a valid attempts row")
        (assert (not (listEmpty? (cd/attemptsErrors "(:attempts :maxWrites 0)"))) "a bound below 1 is rejected")
        (assert (not (listEmpty? (cd/attemptsErrors "(:attempts :maxWrites 12 :per day)"))) "an unknown key is rejected")
        (assert (= (cd/attemptsMax "") -1) "no row: no bound")
        (assert (= on (list "blocked 2 writeBound: 2 writes" "writing 1" "writing 2" "ready 2" "ready 1")) (str "bound: park at 2, operator requeue restarts, admission counts, automatic requeue keeps, review fix owed: " (stringJoin on "|")))
        (assert (stringStartsWith? (optionOr (listHead off) "") "writing 2") (str "no row: the unit is written again as today and nothing is counted: " (stringJoin off "|")))
        (assert (= (listGet off 2) (some "writing 1")) (str "no row: an admission adds nothing: " (stringJoin off "|")))
        (assert (stringContains? esc "(:escalate :unit \"B1\" :seen \"writeBound: 2 writes\"") (str "one escalation row names the park: " esc))
        (assert (stringStartsWith? (optionOr (listHead bad) "") "writing") "a rejected row bounds nothing")
        (assert (listAny? (fn [(p String)] -> Bool (stringStartsWith? p "ladder attempts: :maxWrites 0")) (cd/ladderProblems (str root "/boundBad"))) "and is a ladder problem")
        (assert (not (stringContains? row ":writes")) "a row with no counted write is written as before")
        (assert (= (resultOr (cd/parseCUnit (cd/renderCUnit (with (pf/cuIn "Z" "ready" "" "") :writes 3))) (pf/cuIn "Z" "x" "" "")).writes 3) "the count round-trips through the row")
        (assert (= (cd/fixCredit (pf/cuIn "Z" "ready" "" "")).writes 0) "the credit stops at 0")
        (assert (= (str m1.st " " (stringFromInt64 m1.writes)) "ready 1") (str "a merge-red fix round is owed its write too: " m1.st))
        true))

; (:m :do "fix-round bound: R1 is admitted, reviewed and fails review with a new defect each time, six cycles under the given attempts row; returns the number of admissions, R1's state, signature, :writes and :fixes, and its escalation rows, then its state and :fixes after an operator requeue")
fn ! sixCase root: String name: String ladder: String -> String
  (let [(dir (str root "/" name))
        (_ (dirCreate root))
        (_ (dirCreate dir))
        (_ (st/put! dir (unitAfter "R1" (list))))
        (_ (cd/writeCUnit! dir (pf/cuIn "R1" "ready" "" "sh/R1")))
        (_ (fileWrite (str dir "/ladder.asn") (str ladder "\n")))
        (ctx (ctxOf dir))
        (admits (fold (fn [(a Int64) (k Int64)] -> Int64
                        (let [(_ (cd/step! ctx (unitAfter "R1" (list)) 8))
                              (c (cuOf! dir "R1"))]
                          (if (!= c.st "writing") a
                            (let [(_ (cd/writeCUnit! dir (with c :st "reviewing")))
                                  (_ (cd/finish! ctx (unitAfter "R1" (list)) (cuOf! dir "R1") (resOf (str "review: defect " (stringFromInt64 k)) "fail")))]
                              (+ a 1)))))
                      0 (range 0 6)))
        (c (cuOf! dir "R1"))
        (esc (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:escalate :unit \"R1\" ")) (stringLines (readOr (str dir "/escalations.asn")))))
        (_ (cd/requeueOne! ctx (resultOr (st/readUnits! dir) (list)) "R1"))
        (r (cuOf! dir "R1"))]
    (str (stringFromInt64 admits) " " c.st " " c.sig " w" (stringFromInt64 c.writes) " f" (stringFromInt64 c.fixes) " e" (stringFromInt64 (listLength esc)) " r" r.st (stringFromInt64 r.fixes)))

fn ! testFixBound root: String -> Bool
  (let [(on (sixCase root "fixOn" "(:attempts :maxWrites 2 :maxFixRounds 2)"))
        (off (sixCase root "fixOff" "(:attempts :maxWrites 2)"))]
    (do (assert (= on "3 blocked fixBound: 2 rounds w0 f3 e1 rqueued0") (str "six review-fail cycles park after two fix rounds, with one escalation: " on))
        (assert (stringStartsWith? off "6 ") (str "without :maxFixRounds fix rounds are not bounded and do not spend :maxWrites: " off))
        (assert (listEmpty? (cd/attemptsErrors "(:attempts :maxWrites 2 :maxFixRounds 3)")) "the key is known")
        (assert (not (listEmpty? (cd/attemptsErrors "(:attempts :maxWrites 2 :maxFixRounds 0)"))) "a bound below 1 is rejected")
        (assert (= (cd/fixRoundsMax "(:attempts :maxWrites 2)") -1) "no key: off")
        (assert (= (cd/parseCUnit (cd/renderCUnit (with (pf/cuIn "Z" "ready" "" "") :fixes 2))) (ok (with (pf/cuIn "Z" "ready" "" "") :fixes 2))) "the count round-trips through the row")
        true))

fn ! runTests -> Bool
  (let [(root (pf/scratch "flowDrain" "t"))
        (_ (pf/cleanup root))
        (_ (dirCreate root))
        (reload (testReload root))
        (reloadTick (testReloadTick root))
        (archive (testReloadArchive root))
        (archFail (testArchiveFailed root))
        (roots (testRoots root))
        (release (testRootRelease root))
        (lows (testLows root))
        (flow (testFlow root))
        (dwell (testDwell root))
        (heldIn (testHeldIn root))
        (own (testReleaseOwn root))
        (infra (testInfra root))
        (plan (testNeedsPlan root))
        (bound (testBound root))
        (fixBound (testFixBound root))
        (_ (pf/cleanup root))]
    (do (assert reload "reload replaces the definition and resets the counters")
        (assert reloadTick "the tick drains reload requests")
        (assert archive "a reload that changes the work archives the old branch, one that changes only lane or deps keeps it")
        (assert archFail "a reload that cannot archive blocks the unit with one escalation and keeps its definition")
        (assert roots "roots are followed through waiting units and listed with their count")
        (assert release "a merged root releases its dependants in the same tick")
        (assert lows "requeue and close drop the addendum, a fix round keeps solo, the stall probe reads the current run")
        (assert (testFlowRows) "flow rows and unit classes")
        (assert flow "downstream stages take the slots before a first write")
        (assert dwell "state ages in status and dwell rows once per episode")
        (assert heldIn "held judgement per class")
        (assert own "own failures stay blocked, a crashed reload drain is redone")
        (assert infra "infra causes are retried without spending the limit under infraFree")
        (assert plan "defective tasks wait in needsPlan for a reload")
        (assert bound "a write bound parks a unit written too often")
        (assert fixBound "fix rounds have their own bound")
        true))
