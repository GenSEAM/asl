(module asl-tools/coord/tests/conductorTest
  :x [runTests]
  :i [(asl-tools/coord/conductor :a cd) (asl-tools/coord/store :a st) (asl-tools/fleet/run :a fr) (aslGateway/subPace :a sp)])

; (:m :ref CONDUCTOR :do "every store dir is a scratch dir under this worktree's .asl/cache, never ~/.asl; stages are real detached children of a prepared native fixture binary (conductorStage.asl) whose write, review and merge are fakes and whose gates are the conductor's own; every child is deadline-bound by stageSec and killed by stopAll! at the end of its test")
fn ! scratch name: String -> String
  (str (resultOr (realPath ".") ".") "/.asl/cache/conductorTest-" (stringFromInt64 (procSelf)) "-" name)

fn ! cleanup dir: String -> Unit
  (let [(_ (fr/runOneLimited (fr/job (list "rm" "-rf" dir) "." (fr/childEnv (list))) (fr/limits 60 4)))] ())

fn ! fixtureBinary! -> String
  (let [(d (fr/runOneLimited (fr/job (list (fr/nativeCli!) "run" "asl/tools/nativeTest.asl" "prepare" "asl/tools/coord/tests/conductorStage.asl") "." (fr/childEnv (list)))
                             (fr/limits 600 64)))
        (lines (filter (fn [(l String)] -> Bool (stringStartsWith? l "/")) (map stringTrim (stringLines d.out))))]
    (if (= d.exit 0) (optionOr (listGet lines (- (listLength lines) 1)) "") ""))

fn greenGate -> String
  "echo '3 assertion(s) executed (3 passed)'"

fn redGate -> String
  "echo 'suite: ERR_TYPE boom in conductorTest'; echo 'FAIL 1 of 3'; exit 1"

fn task id: String owns: (List String) after: (List String) gate: String lane: String -> st/Task
  (st/Task :id id :owns owns :reads (list) :gate gate :channel lane :model "fake" :base "main" :after after :st "queued" :epoch 0 :receipt "")

fn noExtra stage: String id: String -> (List String)
  (list)

; (:m :do "extra: argv additions per stage and unit, the steering of the fixture")
fn ! ctxWith dir: String bin: String extra: (fn [String String] -> (List String)) tokens: Int64 perLane: Int64 maxWait: Int64 stageSec: Int64 -> cd/Ctx
  (cd/Ctx :dir dir :holder "conductorTest" :ttlMs 600000 :maxWait maxWait :maxSame 3 :stageSec stageSec :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String) (listAppend (list bin "stage" stage u.id "--store" dir) (extra stage u.id)))
          :pace (cd/fixedPace tokens perLane))

fn ! ctxOf dir: String bin: String tokens: Int64 perLane: Int64 maxWait: Int64 -> cd/Ctx
  (ctxWith dir bin noExtra tokens perLane maxWait 60)

fn ! journalLines dir: String -> (List String)
  (match (fileReadString (cd/journalPath dir)) ((ok t) (filter (fn [(l String)] -> Bool (not (stringEmpty? l))) (stringLines t))) ((err _) (list)))

fn ! tosOf dir: String id: String -> (List String)
  (map (fn [(l String)] -> String (optionOr (listHead (stringSplit (optionOr (listGet (stringSplit l ":to ") 1) "") " ")) ""))
       (filter (fn [(l String)] -> Bool (stringContains? l (str "(:t :unit \"" id "\" "))) (journalLines dir)))

fn ! posOf dir: String id: String to: String -> Int64
  (let [(lines (journalLines dir))]
    (optionOr (listFind (fn [(i Int64)] -> Bool (let [(l (optionOr (listGet lines i) ""))] (and (stringContains? l (str "(:t :unit \"" id "\" ")) (stringContains? l (str " :to " to " "))))) (range 0 (listLength lines))) -1))

fn ! fromCount dir: String from: String -> Int64
  (listLength (filter (fn [(l String)] -> Bool (stringContains? l (str " :from " from " "))) (journalLines dir)))

fn ! stOf dir: String id: String -> String
  (match (listFind (fn [(c cd/CUnit)] -> Bool (= c.id id)) (cd/readCUnits! dir)) ((some c) c.st) ((none) "absent"))

fn ! cuOf dir: String id: String -> cd/CUnit
  (optionOr (listFind (fn [(c cd/CUnit)] -> Bool (= c.id id)) (cd/readCUnits! dir)) (cd/CUnit :id "" :st "absent" :lane "" :fails -1 :sig "" :waited 0 :parked 0 :epoch 0 :branch "" :wt "" :model "" :tokens 0 :costMicro 0 :esc 0 :launched 0 :await ""))

fn ! tickUntil! ctx: cd/Ctx dir: String id: String st: String fails: Int64 max: Int64 -> Bool
  (let [(c (cuOf dir id))]
    (cond
      ((and (= c.st st) (= c.fails fails)) true)
      ((<= max 0) false)
      (else (let [(_ (cd/tick! ctx)) (_ (sleepMs 50))] (tickUntil! ctx dir id st fails (- max 1))))))

fn ! putAll! dir: String units: (List st/Task) -> Bool
  (listAll? (fn [(u st/Task)] -> Bool (ok? (st/put! dir u))) units)

fn ! readOr dir: String name: String -> String
  (resultOr (fileReadString (str dir "/" name)) "")

fn ! pidOf dir: String id: String stage: String -> Int64
  (match (cd/runRow dir id stage) ((some r) (pairFirst r)) ((none) -1))

fn ! up? pid: Int64 -> Bool
  (and (> pid 0) (resultOr (procAlive? pid) false))

; (:m :ref CONDUCTOR :do "a DAG A -> (B C) -> D drains to merged in dependency order, and each unit's journal is exactly the transition chain with the spend of its stages")
fn ! testDag bin: String -> Bool
  (let [(dir (scratch "dag"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "A" (list "p/a") (list) (greenGate) "leon") (task "B" (list "p/b") (list "A") (greenGate) "leon")
                                (task "C" (list "p/c") (list "A") (greenGate) "leon") (task "D" (list "p/d") (list "B" "C") (greenGate) "leon"))))
        (ctx (ctxOf dir bin 4 4 400))
        (ticks (cd/drain! ctx 600))
        (chain (list "ready" "writing" "gating" "awaitReview" "reviewing" "merging" "merged"))
        (a (cuOf dir "A"))
        (rows (resultOr (st/readUnits! dir) (list)))
        (tosA (tosOf dir "A")) (tosD (tosOf dir "D")) (stD (stOf dir "D"))
        (mA (posOf dir "A" "merged")) (mB (posOf dir "B" "merged")) (mC (posOf dir "C" "merged"))
        (wB (posOf dir "B" "writing")) (wC (posOf dir "C" "writing")) (wD (posOf dir "D" "writing"))
        (log (readOr dir "merged.log"))
        (_ (cleanup dir))]
    (do (assert put "four units put")
        (assert (= tosA chain) (str "A journal is the full transition chain: " (stringJoin tosA ",")))
        (assert (= tosD chain) (str "D journal is the full transition chain: " (stringJoin tosD ",")))
        (assert (= stD "merged") "D merged")
        (assert (and (< mA wB) (< mA wC)) "B and C start writing only after A is merged")
        (assert (and (< mB wD) (< mC wD)) "D starts writing only after both B and C are merged")
        (assert (and (stringStartsWith? log "A\n") (stringEndsWith? log "D\n") (stringContains? log "\nB\n") (stringContains? log "\nC\n")) (str "the merge stage saw A first, B and C between, D last: " log))
        (assert (and (= a.tokens 150) (= a.costMicro 3500)) (str "A spend is write plus review: " a.tokens " " a.costMicro))
        (assert (listAll? (fn [(u st/Task)] -> Bool (= u.st "done")) rows) "every store row is done after the merges")
        true))

; (:m :ref CONDUCTOR :do "units whose :owns overlap are serialised: the second does not leave ready before the first is merged; a disjoint third runs alongside")
fn ! testOwnsSerialised bin: String -> Bool
  (let [(dir (scratch "owns"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "X" (list "pkg/a") (list) (greenGate) "leon") (task "Y" (list "pkg/a/sub") (list) (greenGate) "leon") (task "Z" (list "pkg/z") (list) (greenGate) "leon"))))
        (ctx (ctxOf dir bin 4 4 400))
        (t1 (cd/tick! ctx))
        (t2 (cd/tick! ctx))
        (afterTwo (list (stOf dir "X") (stOf dir "Y") (stOf dir "Z")))
        (ticks (cd/drain! ctx 600))
        (mX (posOf dir "X" "merged")) (wY (posOf dir "Y" "writing")) (stY (stOf dir "Y")) (wZ (posOf dir "Z" "writing"))
        (_ (cleanup dir))]
    (do (assert put "three units put")
        (assert (= afterTwo (list "writing" "ready" "writing")) (str "after two ticks X and Z write, overlapping Y still waits: " (stringJoin afterTwo ",")))
        (assert (< mX wY) "Y starts writing only after X is merged")
        (assert (= stY "merged") "Y merges eventually")
        (assert (< wZ mX) "the disjoint Z did not wait for X")
        true))

; (:m :ref CONDUCTOR :do "admission = min(ready, capacity, lane allowance): capacity 1 admits only P; allowance 0 keeps S ready with capacity to spare; maxWait 0 proves a capacity wait never escalates (ADMITWAIT)")
fn ! admitted2 bin: String name: String tokens: Int64 slowAllow: Int64 -> (List String)
  (let [(dir (scratch name))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "P" (list "p/p") (list) (greenGate) "leon") (task "Q" (list "p/q") (list) (greenGate) "leon") (task "S" (list "p/s") (list) (greenGate) "slow"))))
        (base (ctxOf dir bin tokens 5 50))
        (ctx (cd/Ctx :dir dir :holder "conductorTest" :ttlMs 600000 :maxWait 0 :maxSame 3 :stageSec 60 :maxDesc 50 :launch base.launch
                     :pace (cd/Pace :tokens (fn [] -> Int64 tokens) :allowance (fn [(lane String)] -> Int64 (if (= lane "slow") slowAllow 5)))))
        (t1 (cd/tick! ctx))
        (t2 (cd/tick! ctx))
        (afterTwo (list (stOf dir "P") (stOf dir "Q") (stOf dir "S")))
        (_ (cd/stopAll! ctx))
        (_ (cleanup dir))]
    afterTwo)

; (:m :ref DEPWAIT :do "a dependency in a stage or ready is no stall; a missing, blocked or failed one is")
fn cuSt id: String st: String -> cd/CUnit
  (cd/CUnit :id id :st st :lane "free" :fails 0 :sig "" :waited 0 :parked 0 :epoch 0 :branch "" :wt "" :model "" :tokens 0 :costMicro 0 :esc 0 :launched 0 :await "")

fn testDepStalled -> Bool
  (let [(u (task "T" (list "p/t") (list "D") (greenGate) "leon"))]
    (do (assert (not (cd/depStalled? u (list (cuSt "D" "writing")))) "a writing dependency is not a stall")
        (assert (not (cd/depStalled? u (list (cuSt "D" "ready")))) "a ready dependency is not a stall")
        (assert (cd/depStalled? u (list (cuSt "D" "blocked"))) "a blocked dependency is a stall")
        (assert (cd/depStalled? u (list (cuSt "X" "writing"))) "a missing dependency is a stall")
        true))

; (:m :ref DEPCHAIN :do "a queued unit waiting on a live dependency is stored as queued, so the unit after it sees a queued dependency, not a missing one: A held ready by allowance 0, B after A, C after B; with maxWait 0 two ticks leave B and C queued")
fn ! testDepChain bin: String -> Bool
  (let [(dir (scratch "chain"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "A" (list "p/a") (list) (greenGate) "slow") (task "B" (list "p/b") (list "A") (greenGate) "slow") (task "C" (list "p/c") (list "B") (greenGate) "slow"))))
        (base (ctxOf dir bin 5 5 50))
        (ctx (cd/Ctx :dir dir :holder "conductorTest" :ttlMs 600000 :maxWait 0 :maxSame 3 :stageSec 60 :maxDesc 50 :launch base.launch
                     :pace (cd/Pace :tokens (fn [] -> Int64 5) :allowance (fn [(lane String)] -> Int64 0))))
        (_ (cd/tick! ctx))
        (_ (cd/tick! ctx))
        (got (list (stOf dir "A") (stOf dir "B") (stOf dir "C")))
        (_ (cd/stopAll! ctx))
        (_ (cleanup dir))]
    (do (assert put "three units put")
        (assert (= got (list "ready" "queued" "queued")) (str "a chain behind a live unit does not block: " (stringJoin got ",")))
        true))

; (:m :ref COORD-WIP-RESCUE :do "stopAll! on a writing unit with edits in its worktree leaves a clean tree: one wip commit on sh/UNIT whose message names the unit and the reason, one (:wip ...) journal row naming branch and sha, the edit reachable from the branch; a second stop writes no second row; fixture repo and worktree live under the scratch dir and are removed")
fn ! gitIn dir: String args: (List String) -> fr/Done
  (fr/runOneLimited (fr/job (cons "git" (listAppend (list "-c" "user.name=t" "-c" "user.email=t@example.invalid" "-c" "commit.gpgsign=false") args)) dir (fr/childEnv (list))) (fr/limits 60 8))

fn ! testWipRescue bin: String -> Bool
  (let [(dir (scratch "wip"))
        (_ (cleanup dir))
        (repo (str dir "/repo"))
        (wt (str dir "/worktrees/asex-W1"))
        (_ (dirCreate repo))
        (_ (gitIn repo (list "init" "-q" "-b" "main")))
        (_ (fileWrite (str repo "/a.txt") "1\n"))
        (_ (gitIn repo (list "add" "-A")))
        (_ (gitIn repo (list "commit" "-q" "-m" "base")))
        (_ (dirCreate (str dir "/worktrees")))
        (mk (gitIn repo (list "worktree" "add" "-q" "-b" "sh/W1" wt "main")))
        (_ (fileWrite (str wt "/a.txt") "2\n"))
        (_ (fileWrite (str wt "/new.txt") "n\n"))
        (_ (fileWrite (str dir "/repo.path") repo))
        (ctx (ctxOf dir bin 5 5 50))
        (_ (cd/writeCUnit! dir (with (cuSt "W1" "writing") :launched 1)))
        (n1 (cd/stopAll! ctx))
        (status (gitIn wt (list "status" "--porcelain")))
        (subject (gitIn wt (list "log" "-1" "--format=%s" "sh/W1")))
        (shown (gitIn wt (list "show" "--stat" "--format=" "sh/W1")))
        (rows1 (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:wip ")) (journalLines dir)))
        (n2 (cd/stopAll! ctx))
        (rows2 (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:wip ")) (journalLines dir)))
        (wipOnly (cd/noCommits? wt "main"))
        (_ (fileWrite (str wt "/real.txt") "r\n"))
        (_ (gitIn wt (list "add" "-A")))
        (_ (gitIn wt (list "commit" "-q" "-m" "real work")))
        (withReal (cd/noCommits? wt "main"))
        (_ (cleanup dir))
        (dirS (scratch "wipskip"))
        (_ (cleanup dirS))
        (repoS (str dirS "/repo"))
        (_ (dirCreate repoS))
        (_ (gitIn repoS (list "init" "-q" "-b" "main")))
        (_ (fileWrite (str repoS "/a.txt") "1\n"))
        (_ (gitIn repoS (list "add" "-A")))
        (_ (gitIn repoS (list "commit" "-q" "-m" "base")))
        (_ (fileWrite (str dirS "/repo.path") repoS))
        (_ (dirCreate (str dirS "/elsewhere")))
        (_ (fileWrite (str dirS "/elsewhere/loose.txt") "l\n"))
        (ctxS (ctxOf dirS bin 5 5 50))
        (_ (cd/writeCUnit! dirS (with (cuSt "W2" "writing") :launched 1 :wt (str dirS "/elsewhere"))))
        (_ (cd/writeCUnit! dirS (with (cuSt "W3" "writing") :launched 1)))
        (_ (cd/stopAll! ctxS))
        (skipRows (filter (fn [(l String)] -> Bool (stringContains? l ":skipped")) (journalLines dirS)))
        (looseKept (fileExists? (str dirS "/elsewhere/loose.txt")))
        (_ (cleanup dirS))]
    (do (assert (= mk.exit 0) "fixture worktree added")
        (assert (= n1 1) "the writing unit was in flight")
        (assert (stringEmpty? (stringTrim status.out)) (str "the worktree is clean after the stop: " status.out))
        (assert (stringContains? subject.out "unit W1 stopped: stopped") (str "wip message names unit and reason: " subject.out))
        (assert (and (stringContains? shown.out "a.txt") (stringContains? shown.out "new.txt")) "tracked edit and untracked file are in the wip commit")
        (assert (= (listLength rows1) 1) "one wip journal row")
        (assert (stringContains? (optionOr (listHead rows1) "") ":branch \"sh/W1\" :sha \"") "the row names branch and sha")
        (assert (= (listLength rows2) 1) "a clean tree adds no second row")
        (assert wipOnly "a wip rescue commit is not progress")
        (assert (not withReal) "a real commit on top of it is progress")
        (assert (= (listLength skipRows) 2) (str "a recorded path that is not a worktree and a derived path that is missing are each journalled as skipped: " (stringJoin skipRows " | ")))
        (assert looseKept "and nothing is touched")
        true))

; (:m :ref LANDED-AUDIT :do "gradeLand! appends one pass row naming the unit and the reviewed head to .asl/mem/grades.asn in the unit worktree and commits only that file on the unit branch; a recorded path that is not a worktree of the repo journals gradeSkipped and writes nothing")
fn ! testGradeLand bin: String -> Bool
  (let [(dir (scratch "grade"))
        (_ (cleanup dir))
        (repo (str dir "/repo"))
        (wt (str dir "/worktrees/asex-G1"))
        (_ (dirCreate repo))
        (_ (gitIn repo (list "init" "-q" "-b" "main")))
        (_ (fileWrite (str repo "/a.txt") "1\n"))
        (_ (gitIn repo (list "add" "-A")))
        (_ (gitIn repo (list "commit" "-q" "-m" "base")))
        (_ (dirCreate (str dir "/worktrees")))
        (mk (gitIn repo (list "worktree" "add" "-q" "-b" "sh/G1" wt "main")))
        (_ (fileWrite (str wt "/a.txt") "2\n"))
        (_ (gitIn wt (list "add" "-A")))
        (_ (gitIn wt (list "commit" "-q" "-m" "work")))
        (reviewed (stringTrim (gitIn wt (list "rev-parse" "HEAD")).out))
        (mainSha (stringTrim (gitIn repo (list "rev-parse" "main")).out))
        (_ (fileWrite (str dir "/repo.path") repo))
        (ctx (ctxOf dir bin 5 5 50))
        (c (with (cuSt "G1" "reviewing") :wt wt))
        (_ (cd/gradeLand! ctx c "G1" "gemini-flash"))
        (ledger (resultOr (fileReadString (str wt "/.asl/mem/grades.asn")) ""))
        (subject (stringTrim (gitIn wt (list "log" "-1" "--format=%s")).out))
        (touched (stringTrim (gitIn wt (list "show" "--name-only" "--format=" "HEAD")).out))
        (status (stringTrim (gitIn wt (list "status" "--porcelain")).out))
        (_ (cd/gradeLand! ctx (with (cuSt "G2" "reviewing") :wt (str dir "/nowhere")) "G2" "gemini-flash"))
        (rows (journalLines dir))
        (_ (cleanup dir))]
    (do (assert (= mk.exit 0) "fixture worktree added")
        (assert (and (stringContains? ledger (str "(:grade :ev \"G1\" :sha \"" reviewed "\" :base \"" mainSha "\" :verdict pass :by \"google\" :at \"")) (stringContains? ledger "Z\")")) (str "the pass row names unit, reviewed head and family: " ledger " / " (stringJoin rows " | ")))
        (assert (stringStartsWith? ledger "(:gradesHead :since \"") (str "a branch without a ledger gets the head row first: " ledger))
        (assert (stringStartsWith? subject "(:c :a grade :do \"unit G1 review pass\"") (str "one ASN grade commit: " subject))
        (assert (= touched ".asl/mem/grades.asn") (str "it touches only the ledger: " touched))
        (assert (stringEmpty? status) "the tree is clean after")
        (assert (listAny? (fn [(l String)] -> Bool (stringStartsWith? l "(:gradeLanded :unit \"G1\"")) rows) "journalled as landed")
        (assert (listAny? (fn [(l String)] -> Bool (stringStartsWith? l "(:gradeSkipped :unit \"G2\"")) rows) "a path that is not a worktree is journalled as skipped")
        true))

; (:m :ref SERVED-ALIAS-JOURNAL :do "fixture receipts: with :servedAlias the journalled model is the alias and :alias is journalled; with only :servedModel the model is that and no :alias is journalled; with neither the older :model tag or unknown decides; bare and quoted values read alike; the Res row keeps the alias across render and parse")
fn ! testServed -> Bool
  (let [(both "(:leon :turns 3 :servedAlias \"gemFlash\" :servedModel \"gemini-3-flash\" :model \"old\" :usage (:input 1 :cached 0 :output 1))")
        (onlyModel "(:leon :servedModel gemini-3-flash :usage (:input 1))")
        (echoed (str "(:tool :out \":servedAlias evil\")\n" both))
        (echoedOnly (str "(:tool :out \":servedAlias evil\")\n(:leon :turns 1 :usage (:input 1))"))
        (oldTag "(:leon :model \"legacy-x\")")
        (nothing "(:leon :turns 3)")
        (dir (scratch "served"))
        (_ (cleanup dir))
        (_ (dirCreate dir))
        (ctx (ctxOf dir "none" 5 5 50))
        (_ (cd/journalA! ctx (cuSt "S1" "writing") "gating" "write" "gemFlash" "gemFlash" 1 0 "written" 5))
        (_ (cd/journalA! ctx (cuSt "S2" "writing") "gating" "write" "m2" "" 1 0 "written" 5))
        (rows (journalLines dir))
        (res (cd/Res :ok 1 :wt "w" :branch "b" :model "gemFlash" :tokens 1 :costMicro 0 :claimedGreen 0 :sig "" :ms 1 :exit 0 :asserts 0 :verdict "" :tiers "" :alias "gemFlash"))
        (back (cd/parseRes (cd/renderRes res)))
        (_ (cleanup dir))]
    (do (assert (and (= (cd/servedModel both) "gemFlash") (= (cd/servedAliasOf both) "gemFlash")) "the served alias wins and is the alias")
        (assert (and (= (cd/servedModel onlyModel) "gemini-3-flash") (stringEmpty? (cd/servedAliasOf onlyModel))) "only :servedModel: that model, no alias")
        (assert (= (cd/servedModel oldTag) "legacy-x") "the older :model tag still decides")
        (assert (= (cd/servedModel nothing) "unknown") "nothing named: unknown")
        (assert (= (cd/servedAliasOf echoed) "gemFlash") "an echoed line earlier in the output never decides, the final receipt row does")
        (assert (stringEmpty? (cd/servedAliasOf echoedOnly)) "and an echoed alias without a receipt naming one is not an alias")
        (assert (stringContains? (optionOr (listGet rows 0) "") ":model \"gemFlash\" :alias \"gemFlash\" :tokens") (str "the row carries :alias after :model: " (optionOr (listGet rows 0) "")))
        (assert (not (stringContains? (optionOr (listGet rows 1) "") ":alias")) "no alias, no :alias")
        (assert (match back ((ok r) (= r.alias "gemFlash")) ((err _) false)) "the Res row keeps the alias")
        true))

; (:m :ref COORD-WIP-RESCUE :do "every path that ends a writer without landing rescues the tree: stopAll!, a lost lease (step!), a failed write (fail!), a stall kill (stallHooks), a provider failure (providerRequeue!), a stale-needs-rebase and a vacuous-gate result (finish!); each is driven on its own dirty scratch worktree and must leave a clean tree and one (:wip ...) row with its own reason, so removing any one hook turns its row red; secret-path untracked files stay out of the commit and are counted as :left; the worktree base follows <store>/worktrees.path")
fn ! wipFixture dir: String base: String id: String -> String
  (let [(repo (str dir "/repo"))
        (wt (str base "/asex-" id))
        (_ (dirCreate dir))
        (_ (dirCreate repo))
        (_ (gitIn repo (list "init" "-q" "-b" "main")))
        (_ (fileWrite (str repo "/a.txt") "1\n"))
        (_ (gitIn repo (list "add" "-A")))
        (_ (gitIn repo (list "commit" "-q" "-m" "base")))
        (_ (dirCreate base))
        (_ (gitIn repo (list "worktree" "add" "-q" "-b" (str "sh/" id) wt "main")))
        (_ (fileWrite (str wt "/a.txt") "2\n"))
        (_ (fileWrite (str wt "/.env") "KEY=1\n"))
        (_ (fileWrite (str dir "/repo.path") repo))]
    wt)

fn ! wipDrive bin: String path: String -> (Pair String String)
  (let [(dir (scratch (str "wp-" path)))
        (_ (cleanup dir))
        (wt (wipFixture dir (str dir "/worktrees") "U"))
        (ctx (ctxOf dir bin 5 5 50))
        (c (with (cuSt "U" "writing") :launched 1 :epoch 5))
        (u (task "U" (list "p/u") (list) (greenGate) "free"))
        (res (cd/Res :ok 0 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig "" :ms 0 :exit 1 :asserts 0 :verdict "" :tiers ""))
        (_ (cd/writeCUnit! dir c))
        (_ (cond
             ((= path "stopAll") (cd/stopAll! ctx))
             ((= path "leaseLost") (cd/step! ctx u 3))
             ((= path "writeFailed") (let [(_ (cd/fail! ctx c "write" "m" "ERR_X boom" 1))] 0))
             ((= path "stalled") (let [(h (cd/stallHooks ctx))] (let [(_ (h.kill "U"))] 0)))
             ((= path "providerFail") (let [(_ (cd/providerRequeue! ctx c (with res :sig "ERR_VENDOR x")))] 0))
             ((= path "staleNeedsRebase") (let [(_ (cd/finish! ctx u c (with res :sig "STALE_NEEDS_REBASE leon aaa main bbb")))] 0))
             (else (let [(_ (cd/finish! ctx u c (with res :sig (cd/vacuousSig "g"))))] 0))))
        (row (optionOr (listHead (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:wip :unit \"U\"")) (journalLines dir))) ""))
        (tracked (stringTrim (gitIn wt (list "show" "--name-only" "--format=" "HEAD")).out))
        (_ (cleanup dir))]
    (pair row tracked))

; (:m :ref WIP-OUTSIDE-OWNS :do "a wip rescue commits tracked edits and the untracked files inside the unit's :owns; an untracked file outside :owns stays in the tree and is journaled as :leftOutside N")
fn ! testWipOutside bin: String -> Bool
  (let [(dir (scratch "wpout"))
        (_ (cleanup dir))
        (wt (wipFixture dir (str dir "/worktrees") "U"))
        (ctx (ctxOf dir bin 5 5 50))
        (_ (st/put! dir (task "U" (list "own") (list) (greenGate) "free")))
        (_ (dirCreate (str wt "/own")))
        (_ (dirCreate (str wt "/other")))
        (_ (fileWrite (str wt "/own/x.txt") "in\n"))
        (_ (fileWrite (str wt "/other/y.txt") "out\n"))
        (_ (cd/writeCUnit! dir (with (cuSt "U" "writing") :launched 1)))
        (_ (cd/stopAll! ctx))
        (row (optionOr (listHead (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:wip :unit \"U\"")) (journalLines dir))) ""))
        (shown (stringTrim (gitIn wt (list "show" "--name-only" "--format=" "HEAD")).out))
        (still (fileExists? (str wt "/other/y.txt")))
        (_ (cleanup dir))]
    (do (assert (stringContains? row ":leftOutside 1") (str "the outside file is counted: " row))
        (assert (and (stringContains? shown "own/x.txt") (stringContains? shown "a.txt")) (str "the owned file and the tracked edit are committed: " shown))
        (assert (not (stringContains? shown "other/y.txt")) (str "the file outside :owns is not committed: " shown))
        (assert still "and it stays in the tree")
        true))

; (:m :ref STALE-FALSE-POSITIVE :do "a dirty unit stale against a main that already equals its leon (nothing moves on main) is rescued by the wip commit, and the moved branch head wakes it for the retry on its clean tree")
fn ! testStaleDirtyWake bin: String -> Bool
  (let [(dir (scratch "stdirty"))
        (_ (cleanup dir))
        (wt (wipFixture dir (str dir "/worktrees") "U"))
        (ctx (ctxOf dir bin 5 5 50))
        (c (with (cuSt "U" "writing") :launched 1 :epoch 5))
        (u (task "U" (list "a.txt") (list) (greenGate) "free"))
        (res (cd/Res :ok 0 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig "STALE_NEEDS_REBASE leon aaaaaaaaa main bbbbbbbbb" :ms 0 :exit 1 :asserts 0 :verdict "" :tiers ""))
        (before (cd/unitHead! dir "U"))
        (_ (cd/writeCUnit! dir c))
        (_ (cd/finish! ctx u c res))
        (blocked (cuOf dir "U"))
        (after (cd/unitHead! dir "U"))
        (_ (cd/staleWake! ctx blocked))
        (woken (cuOf dir "U"))
        (_ (cleanup dir))]
    (do (assert (and (= blocked.st "blocked") (stringContains? blocked.sig (str " head " before))) (str "the stale signature records the head before the rescue: " blocked.sig " vs " before))
        (assert (!= before after) "the wip rescue moved the branch head")
        (assert (= woken.st "ready") (str "so the next tick wakes the unit: " woken.st))
        true))

; (:m :ref GATE-CHECK-TIMEOUT :do "a gate stage that ends in the gateTimeout signature is retried in gating, journaled as (:stop :unit :kind gateTimeout :n N), with no fail count; the fourth consecutive timeout is an ordinary gate failure")
fn ! testGateTimeoutRequeue bin: String -> Bool
  (let [(dir (scratch "gtimeout"))
        (_ (cleanup dir))
        (ctx (ctxOf dir bin 5 5 50))
        (u (task "U" (list "a.txt") (list) (greenGate) "free"))
        (c (with (cuSt "U" "gating") :launched 1 :epoch 5))
        (res (cd/Res :ok 0 :wt "" :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig (cd/gateTimeoutSig "a.asl" 900) :ms 0 :exit 124 :asserts 0 :verdict "" :tiers ""))
        (_ (st/put! dir u))
        (_ (cd/writeCUnit! dir c))
        (_ (cd/gateTimeoutRequeue! ctx u c res))
        (after (cuOf dir "U"))
        (stops (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:stop :unit \"U\" :kind gateTimeout")) (journalLines dir)))
        (_ (cd/writeCUnit! dir (with after :launched 1)))
        (_ (cd/gateTimeoutRequeue! ctx u (with after :launched 1) res))
        (_ (cd/gateTimeoutRequeue! ctx u (with after :launched 1) res))
        (_ (cd/gateTimeoutRequeue! ctx u (with after :launched 1) res))
        (capped (cuOf dir "U"))
        (_ (cleanup dir))]
    (do (assert (and (= after.st "gating") (= after.fails 0)) (str "a gate timeout stays in gating with no fail count: " after.st " " (stringFromInt64 after.fails)))
        (assert (and (= (listLength stops) 1) (stringContains? (optionOr (listHead stops) "") ":n 1")) (str "one (:stop :kind gateTimeout) row: " (stringJoin stops " | ")))
        (assert (!= capped.st "gating") (str "after three timeouts the next one is an ordinary failure: " capped.st))
        true))

; (:m :ref INTAKE-PARKED-WAKE :do "units parked in awaitReview on a name no allowance refresh ever raises wake through a (:wake :await NAME :readyBelow N) ladder row while slots are free and fewer than N units are ready, one per slot; every blocked unit carries a signature")
fn ! testFreeWake bin: String -> Bool
  (let [(dir (scratch "freewake"))
        (_ (cleanup dir))
        (ctx (ctxOf dir bin 5 5 1))
        (parkedU (fn [(id String)] -> cd/CUnit (with (cuSt id "awaitReview") :parked 1 :await "intake-prio" :lane "free")))
        (_ (cd/writeCUnit! dir (parkedU "P1")))
        (_ (cd/writeCUnit! dir (parkedU "P2")))
        (_ (cd/writeCUnit! dir (parkedU "P3")))
        (_ (cd/writeCUnit! dir (cuSt "R1" "ready")))
        (none (cd/freeWake! ctx))
        (_ (fileWrite (str dir "/ladder.asn") "(:wake :await \"intake-prio\" :readyBelow 3)\n"))
        (woke (cd/freeWake! ctx))
        (p1 (cuOf dir "P1"))
        (p3 (cuOf dir "P3"))
        (again (cd/freeWake! ctx))
        (p3b (cuOf dir "P3"))
        (third (cd/freeWake! ctx))
        (_ (cd/writeCUnit! dir (with (cuSt "W1" "queued") :waited 1)))
        (blocked (cd/waitMore! ctx (with (cuSt "W1" "queued") :waited 1) "deps not merged"))
        (plain (cd/move! ctx (cuSt "B1" "reviewing") "blocked" "review" "m" 0 0 "block" 0))
        (_ (cleanup dir))]
    (do (assert (= none 0) "no wake row, nothing wakes")
        (assert (= woke 2) (str "ready below 3 with one ready unit: two woken, one per free slot of the gap: " (stringFromInt64 woke)))
        (assert (and (= p1.parked 0) (= p3.parked 1)) (str "oldest first, the rest stay parked: " (stringFromInt64 p1.parked) (stringFromInt64 p3.parked)))
        (assert (and (= again 1) (and (= p3b.parked 0) (= third 0))) "the next call wakes the last parked unit and then nothing is left")
        (assert (and (= blocked.st "blocked") (stringStartsWith? blocked.sig "waitedOut: ")) (str "a waited-out unit says so: " blocked.sig))
        (assert (and (= plain.st "blocked") (= plain.sig "review: block")) (str "a block without a signature gets stage and reason: " plain.sig))
        (assert (and (not (listEmpty? (cd/wakeErrors "(:wake :await \"x\" :readyBelow 0)"))) (not (listEmpty? (cd/wakeErrors "(:wake :readyBelow 2)"))) (listEmpty? (cd/wakeErrors "(:wake :await \"x\" :readyBelow 2)"))) "wakeErrors rejects a zero bound and a missing name")
        true))

; (:m :ref STALL-MODEL-DEDUPE :do "a stall kill records the profile the unit was running (stalledProfiles.asn) and the pick for its next attempt leaves that profile out while another is configured; an exclusion covering every profile is ignored")
fn ! testStallDedupe bin: String -> Bool
  (let [(lanes "(:writeProfiles :tier free :profiles (pA pB pC) :weights (3 2 1))\n")
        (ids (map (fn [(i Int64)] -> String (str "UNIT" (stringFromInt64 i))) (range 0 120)))
        (picks (map (fn [(id String)] -> String (cd/pickWriteProfileX lanes id "free" "base" "" (list "pA"))) ids))
        (all (map (fn [(id String)] -> String (cd/pickWriteProfileX lanes id "free" "base" "" (list "pA" "pB" "pC"))) ids))
        (plain (map (fn [(id String)] -> String (cd/pickWriteProfile lanes id "free" "base")) ids))
        (hit (optionOr (listFind (fn [(id String)] -> Bool (= (cd/pickWriteProfile lanes id "free" "base") "pA")) ids) "UNIT0"))
        (dir (scratch "stalldedupe"))
        (_ (cleanup dir))
        (ctx (ctxOf dir bin 5 5 50))
        (c (with (cuSt hit "writing") :launched 1 :epoch 5 :model "gemFlash"))
        (_ (st/put! dir (task hit (list "a.txt") (list) (greenGate) "free")))
        (_ (cd/writeCUnit! dir c))
        (_ (fileAppend (cd/journalPath dir) (str "(:profile :unit \"" hit "\" :lane \"free\" :profile \"pA\" :at 1)\n")))
        (_ (cd/stallRequeue! ctx c "free" "(:stall :class stalled)"))
        (stalled (cd/stalledProfilesOf dir hit))
        (other (cd/stalledProfilesOf dir "S2"))
        (_ (fileWrite (str dir "/lanes.asn") lanes))
        (rc (cd/realCfg (list "--lanes" (str dir "/lanes.asn")) dir))
        (viaCfg (cd/writeProfileFor rc dir hit "free"))
        (_ (cleanup dir))]
    (do (assert (not (listAny? (fn [(p String)] -> Bool (= p "pA")) picks)) "the stalled profile is never picked while others exist")
        (assert (= all plain) "an exclusion covering every profile is ignored")
        (assert (= stalled (list "pA")) (str "the stall kill records the profile it was running: " (stringJoin stalled ",")))
        (assert (listEmpty? other) "another unit is not affected")
        (assert (and (!= viaCfg "pA") (!= viaCfg "base")) (str "the real pick for the stalled unit leaves its profile out: " viaCfg))
        true))

; (:m :ref GRADE-COMMIT-AUTH :do "grade commits made before <store>/gradeCommits.asn existed are seeded once at conductor start from the unit branches (committer conductor@localhost, grade subject), so such a branch is not LEDGER_FORGED; a writer commit on top is still a forgery; the seed never repeats and never runs by itself in a guard")
fn ! testGradeSeed bin: String -> Bool
  (let [(dir (scratch "seed"))
        (_ (cleanup dir))
        (wt1 (ledgerFixture dir "S1"))
        (repo (str dir "/repo"))
        (wt2 (str dir "/worktrees/asex-S2"))
        (_ (gitIn repo (list "worktree" "add" "-q" "-b" "sh/S2" wt2 "main")))
        (row "(:grade :ev \"S1\" :sha \"x\" :verdict pass :by \"google\" :at \"t\")")
        (legacy (fn [(wt String) (id String)] -> Int64
                  (let [(_ (fileWrite (str wt "/.asl/mem/grades.asn") (str "(:gradesHead :since \"x\")\n" row "\n")))
                        (_ (gitIn wt (list "add" "-A")))
                        (r (gitIn wt (list "-c" "user.name=conductor" "-c" "user.email=conductor@localhost" "commit" "-q" "-m" (str "(:c :a grade :do \"unit " id " review pass\" :g review :ev (" id "))"))))]
                    r.exit)))
        (l1 (legacy wt1 "S1"))
        (l2 (legacy wt2 "S2"))
        (_ (fileWrite (str wt2 "/.asl/mem/grades.asn") (str "(:gradesHead :since \"x\")\n" row "\n(:grade :ev \"EVIL\" :sha \"y\" :verdict pass :by \"me\" :at \"t\")\n")))
        (_ (gitIn wt2 (list "add" "-A")))
        (_ (gitIn wt2 (list "commit" "-q" "-m" "writer edits the ledger")))
        (before (cd/ledgerForged! dir wt1 "main"))
        (seeded (cd/seedGradeCommits! dir))
        (after1 (cd/ledgerForged! dir wt1 "main"))
        (after2 (cd/ledgerForged! dir wt2 "main"))
        (again (cd/seedGradeCommits! dir))
        (file (resultOr (fileReadString (cd/gradeCommitsPath dir)) ""))
        (_ (cleanup dir))]
    (do (assert (and (= l1 0) (= l2 0)) "legacy grade commits made on both branches")
        (assert before "before the seed an unrecorded legacy grade commit reads as forged")
        (assert (= seeded 2) (str "the two legacy grade commits are seeded: " (stringFromInt64 seeded)))
        (assert (not after1) "after the seed a branch holding only the legacy grade commit is clean")
        (assert after2 "a writer commit on top of a legacy one is still a forgery")
        (assert (= again -1) "the seed never repeats")
        (assert (stringStartsWith? file "(:gradeSeed :n 2)") (str "the store file starts with the seed row: " file))
        true))

fn ! testWipPaths bin: String -> Bool
  (let [(table (list (pair "stopAll" "stopped") (pair "leaseLost" "leaseLost") (pair "writeFailed" "writeFailed ") (pair "stalled" "stalled")
                     (pair "providerFail" "providerFail") (pair "staleNeedsRebase" "staleNeedsRebase") (pair "vacuousGate" "vacuousGate")))
        (outs (map (fn [(p (Pair String String))] -> (Pair String (Pair String String)) (pair (pairFirst p) (wipDrive bin (pairFirst p)))) table))
        (dirB (scratch "wpbase"))
        (_ (cleanup dirB))
        (wtB (wipFixture dirB (str dirB "/custom") "U"))
        (_ (fileWrite (str dirB "/worktrees.path") (str dirB "/custom\n")))
        (ctxB (ctxOf dirB bin 5 5 50))
        (_ (cd/writeCUnit! dirB (with (cuSt "U" "writing") :launched 1)))
        (_ (cd/stopAll! ctxB))
        (rowB (optionOr (listHead (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:wip :unit \"U\"")) (journalLines dirB))) ""))
        (_ (cleanup dirB))]
    (do (assert (listAll? (fn [(o (Pair String (Pair String String)))] -> Bool
                            (let [(want (optionOr (listHead (filter (fn [(p (Pair String String))] -> Bool (= (pairFirst p) (pairFirst o))) table)) (pair "" "")))
                                  (row (pairFirst (pairSecond o)))]
                              (stringContains? row (str ":reason \"" (pairSecond want)))))
                          outs)
                (str "each path journals its own wip reason: " (stringJoin (map (fn [(o (Pair String (Pair String String)))] -> String (str (pairFirst o) "=" (pairFirst (pairSecond o)))) outs) " | ")))
        (assert (listAll? (fn [(o (Pair String (Pair String String)))] -> Bool (stringContains? (pairFirst (pairSecond o)) ":sha \"")) outs) "each row names the wip sha")
        (assert (listAll? (fn [(o (Pair String (Pair String String)))] -> Bool (and (stringContains? (pairSecond (pairSecond o)) "a.txt") (not (stringContains? (pairSecond (pairSecond o)) ".env")))) outs) "the edit is committed and the secret-path file is not")
        (assert (listAll? (fn [(o (Pair String (Pair String String)))] -> Bool (stringContains? (pairFirst (pairSecond o)) ":left 1")) outs) "the left secret file is counted")
        (assert (and (stringContains? rowB ":reason \"stopped\"") (stringContains? rowB ":sha \"")) (str "a unit under the configured worktree base is rescued too: " rowB))
        (assert (stringContains? wtB "/custom/") "and that fixture lives outside repo/../worktrees")
        true))

; (:m :ref LANDED-AUDIT :do "a writer cannot forge a pass row: gradeLand! rebuilds the ledger from the committed HEAD version plus its one row, so a forged row left in the working tree is neither committed nor kept; a writer commit touching .asl/mem/grades.asn fails the write result and a review pass over such a branch, so neither reaches gating or merging; the conductor's own grade commit and a branch that never touches the ledger are not forged")
fn ! ledgerFixture dir: String id: String -> String
  (let [(repo (str dir "/repo"))
        (wt (str dir "/worktrees/asex-" id))
        (_ (dirCreate dir))
        (_ (dirCreate repo))
        (_ (gitIn repo (list "init" "-q" "-b" "main")))
        (_ (dirCreate (str repo "/.asl")))
        (_ (dirCreate (str repo "/.asl/mem")))
        (_ (fileWrite (str repo "/.asl/mem/grades.asn") "(:gradesHead :since \"x\")\n"))
        (_ (fileWrite (str repo "/a.txt") "1\n"))
        (_ (gitIn repo (list "add" "-A")))
        (_ (gitIn repo (list "commit" "-q" "-m" "base")))
        (_ (dirCreate (str dir "/worktrees")))
        (_ (gitIn repo (list "worktree" "add" "-q" "-b" (str "sh/" id) wt "main")))
        (_ (fileWrite (str wt "/a.txt") "2\n"))
        (_ (gitIn wt (list "add" "-A")))
        (_ (gitIn wt (list "commit" "-q" "-m" "work")))
        (_ (fileWrite (str dir "/repo.path") repo))]
    wt)

fn ! testLedgerForge bin: String -> Bool
  (let [(dir (scratch "forge"))
        (_ (cleanup dir))
        (wt (ledgerFixture dir "F1"))
        (ctx (ctxOf dir bin 5 5 50))
        (forgedRow "(:grade :ev \"EVIL\" :sha \"x\" :verdict pass :by \"me\" :at \"t\")")
        (_ (fileWrite (str wt "/.asl/mem/grades.asn") (str "(:gradesHead :since \"x\")\n" forgedRow "\n")))
        (_ (cd/gradeLand! ctx (with (cuSt "F1" "reviewing") :wt wt) "F1" "gemini-flash"))
        (committed (stringTrim (gitIn wt (list "show" "HEAD:.asl/mem/grades.asn")).out))
        (onDisk (resultOr (fileReadString (str wt "/.asl/mem/grades.asn")) ""))
        (guardClean (cd/ledgerForged! dir wt "main"))
        (dir2 (scratch "forge2"))
        (_ (cleanup dir2))
        (wt2 (ledgerFixture dir2 "F2"))
        (ctx2 (ctxOf dir2 bin 5 5 50))
        (_ (fileWrite (str wt2 "/.asl/mem/grades.asn") (str "(:gradesHead :since \"x\")\n" forgedRow "\n")))
        (_ (gitIn wt2 (list "add" "-A")))
        (_ (gitIn wt2 (list "commit" "-q" "-m" "writer edits the ledger")))
        (forgedBranch (cd/ledgerForged! dir2 wt2 "main"))
        (u (task "F2" (list "p/f") (list) (greenGate) "free"))
        (res (cd/Res :ok 1 :wt wt2 :branch "sh/F2" :model "m" :tokens 1 :costMicro 0 :claimedGreen 0 :sig "" :ms 1 :exit 0 :asserts 0 :verdict "" :tiers ""))
        (_ (cd/writeCUnit! dir2 (with (cuSt "F2" "writing") :launched 1)))
        (_ (cd/finish! ctx2 u (with (cuSt "F2" "writing") :launched 1) res))
        (writeSt (stOf dir2 "F2"))
        (writeJournal (stringJoin (journalLines dir2) "\n"))
        (_ (cd/writeCUnit! dir2 (with (cuSt "F2" "reviewing") :launched 1 :wt wt2)))
        (_ (cd/finish! ctx2 u (with (cuSt "F2" "reviewing") :launched 1 :wt wt2) (with res :ok 0 :verdict "pass")))
        (reviewSt (stOf dir2 "F2"))
        (dir3 (scratch "forge3"))
        (_ (cleanup dir3))
        (wt3 (ledgerFixture dir3 "F3"))
        (_ (fileWrite (str wt3 "/.asl/mem/grades.asn") (str "(:gradesHead :since \"x\")\n" forgedRow "\n")))
        (_ (gitIn wt3 (list "add" "-A")))
        (_ (gitIn wt3 (list "-c" "user.email=conductor@localhost" "commit" "-q" "-m" "(:c :a grade :do \"unit F3 review pass\" :g review :ev (F3))")))
        (spoofed (cd/ledgerForged! dir3 wt3 "main"))
        (recordedRows (resultOr (fileReadString (str dir "/gradeCommits.asn")) ""))
        (_ (cleanup dir))
        (_ (cleanup dir2))
        (_ (cleanup dir3))]
    (do (assert (and (stringContains? committed "(:grade :ev \"F1\"") (not (stringContains? committed "EVIL"))) (str "the forged working-tree row is not committed: " committed))
        (assert (not (stringContains? onDisk "EVIL")) "and is not kept in the tree")
        (assert (not guardClean) "the conductor's own grade commit, recorded in the store, is not a forgery")
        (assert (stringContains? recordedRows "(:gradeCommit :unit \"F1\" :sha \"") "the store records each grade commit it makes")
        (assert spoofed "a commit with the conductor's author and a grade subject that the store never recorded is a forgery")
        (assert forgedBranch "a writer commit touching the ledger is a forgery")
        (assert (= writeSt "ready") (str "a forged write result is a failure, not gating: " writeSt))
        (assert (stringContains? writeJournal "LEDGER_FORGED") (str "journalled as LEDGER_FORGED: " writeJournal))
        (assert (not (= reviewSt "merging")) (str "a pass over a forged branch does not reach merging: " reviewSt))
        true))

fn ! testAdmission bin: String -> Bool
  (let [(byTokens (admitted2 bin "admTok" 1 5))
        (byAllowance (admitted2 bin "admAllow" 9 0))]
    (do (assert (= byTokens (list "writing" "ready" "ready")) (str "one slot admits only P: " (stringJoin byTokens ",")))
        (assert (= byAllowance (list "writing" "writing" "ready")) (str "allowance 0 keeps S ready with slots to spare: " (stringJoin byAllowance ",")))
        true))

; (:m :ref CONDUCTOR :do "a gate failing with the same signature 3 times escalates once and blocks; the retries go back through ready")
fn ! testGateEscalates bin: String -> Bool
  (let [(dir (scratch "esc"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "G" (list "p/g") (list) (redGate) "leon"))))
        (ctx (ctxOf dir bin 4 4 400))
        (ticks (cd/drain! ctx 600))
        (g (cuOf dir "G"))
        (esc (readOr dir "escalations.asn"))
        (tos (tosOf dir "G"))
        (status (cd/status! ctx))
        (_ (cleanup dir))]
    (do (assert put "unit put")
        (assert (and (= g.st "blocked") (= g.fails 3)) (str "G blocked after 3 same-signature gate failures: " g.st " " (stringFromInt64 g.fails)))
        (assert (stringContains? g.sig "ERR_TYPE boom") (str "the signature carries the first ERR line: " g.sig))
        (assert (and (stringStartsWith? esc "(:escalate :unit \"G\" :seen \"ERR_TYPE boom") (= (listLength (stringSplit esc "(:escalate")) 2)) (str "exactly one escalate row naming the unit and the signature: " esc))
        (assert (stringContains? esc ":tried") "the escalate row says what was tried")
        (assert (= tos (list "ready" "writing" "gating" "ready" "writing" "gating" "ready" "writing" "gating" "blocked")) (str "failures retry through ready: " (stringJoin tos ",")))
        (assert (stringContains? status "(:blocked (\"G\"))") (str "status lists G blocked: " status))
        (assert (stringContains? status "(:escalations 1)") "status counts the escalation")
        true))

; (:m :ref CONDUCTOR :do "a different failure signature restarts the count: two failures with sig 1 then one with sig 2 do not escalate")
fn ! testSignatureReset bin: String -> Bool
  (let [(dir (scratch "sig"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "H" (list "p/h") (list) (redGate) "leon"))))
        (ctx (ctxOf dir bin 4 4 400))
        (reached (tickUntil! ctx dir "H" "ready" 2 600))
        (h1 (cuOf dir "H"))
        (swapped (st/put! dir (task "H" (list "p/h") (list) "echo 'suite: ERR_OTHER different'; exit 1" "leon")))
        (second (tickUntil! ctx dir "H" "ready" 1 600))
        (h2 (cuOf dir "H"))
        (_ (cd/stopAll! ctx))
        (_ (cleanup dir))]
    (do (assert (and reached (ok? swapped)) (str "H reached two failures and its gate was swapped: " (match swapped ((err e) e) ((ok _) ""))))
        (assert (and (= h1.fails 2) (not (= h1.st "blocked"))) (str "two same failures so far, not blocked: " h1.st " " (stringFromInt64 h1.fails)))
        (assert (and second (stringContains? h2.sig "ERR_OTHER")) (str "a new signature restarts the count at 1: " (stringFromInt64 h2.fails) " " h2.sig))
        true))

; (:m :ref CONDUCTOR :do "a review that defers (quota) parks the unit in awaitReview; ticks leave it there; wake of another lane does nothing; wake of its lane makes it reviewable and it merges")
fn ! testWake bin: String -> Bool
  (let [(dir (scratch "wake"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "W" (list "p/w") (list) (greenGate) "kimi"))))
        (marker (str dir "/deferred"))
        (extra (fn [(stage String) (id String)] -> (List String)
                 (if (= stage "review")
                   (if (fileExists? marker) (list) (let [(_ (fileWrite marker "1"))] (list "--verdict" "defer" "--tokens" "5" "--cost" "100")))
                   (list))))
        (ctx (ctxWith dir bin extra 4 4 400 60))
        (_ (cd/drain! ctx 600))
        (parked (cuOf dir "W"))
        (idle (cd/tick! ctx))
        (other (cd/wake! ctx "leon"))
        (still (cuOf dir "W"))
        (woken (cd/wake! ctx "kimi"))
        (ready (cuOf dir "W"))
        (_ (cd/drain! ctx 600))
        (done (cuOf dir "W"))
        (wakeLogged (stringContains? (stringJoin (journalLines dir) "\n") ":stage wake "))
        (_ (cleanup dir))]
    (do (assert put "unit put")
        (assert (and (= parked.st "awaitReview") (= parked.parked 1)) (str "deferred review parks W: " parked.st " " (stringFromInt64 parked.parked)))
        (assert (= (match idle ((ok c) c) ((err _) -1)) 0) "a tick over a parked unit changes nothing")
        (assert (and (= other 0) (= still.parked 1)) "waking another lane leaves W parked")
        (assert (and (= woken 1) (= ready.parked 0) (= ready.st "awaitReview")) (str "wake kimi unparks W for review: " (stringFromInt64 woken) " " (stringFromInt64 ready.parked)))
        (assert (= done.st "merged") (str "W merges after the wake: " done.st))
        (assert wakeLogged "the wake is journalled")
        true))

; (:m :ref CONDUCTOR :do "the writer's claim is never trusted: a writer reporting green with red gates is not merged, the merge stage is never started, and the unit ends blocked")
fn ! testWriterClaimIgnored bin: String -> Bool
  (let [(dir (scratch "claim"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "L" (list "p/l") (list) (redGate) "leon"))))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--claim" "1") (list))) 4 4 400 60))
        (_ (cd/drain! ctx 600))
        (l (cuOf dir "L"))
        (lines (journalLines dir))
        (claimed (filter (fn [(x String)] -> Bool (stringContains? x ":verdict \"claimedGreen\"")) lines))
        (starts (readOr dir "starts.log"))
        (storeRows (resultOr (st/readUnits! dir) (list)))
        (tos (tosOf dir "L"))
        (_ (cleanup dir))]
    (do (assert put "unit put")
        (assert (not (listEmpty? claimed)) "the writer did claim green, journalled")
        (assert (not (= l.st "merged")) (str "L is not merged: " l.st))
        (assert (not (stringContains? starts "L merge")) (str "the merge stage was never started: " starts))
        (assert (and (listContains? tos "gating") (not (listContains? tos "awaitReview")) (not (listContains? tos "merging"))) (str "L was gated, never reviewed or merged: " (stringJoin tos ",")))
        (assert (listAll? (fn [(u st/Task)] -> Bool (not (= u.st "done"))) storeRows) "the store row is not done")
        true))

; (:m :ref ATTRACTOR-AB :do "--attractor-ab on splits writes by the parity of the id's char-code sum: even runs Leon with :attractor asn, odd without; the option is off by default and then no unit gets an arm")
fn ! testAttractorArm -> Bool
  (let [(off (cd/realCfg (list) "."))
        (on (cd/realCfg (list "--attractor-ab" "on") "."))]
    (do (assert (= (cd/armOf "AA") "asn") "char-code sum 130 is even: arm asn")
        (assert (= (cd/armOf "AB") "off") "char-code sum 131 is odd: arm off")
        (assert (not off.attractorAb) "the option is off by default")
        (assert on.attractorAb "--attractor-ab on turns it on")
        (assert (= (cd/writeArm off "AA") "") "with the option off no unit gets an arm")
        (assert (= (cd/writeArm on "AA") "asn") "with it on the arm follows armOf")
        (assert (= (cd/armExtra "asn") ":attractor asn") "arm asn passes :attractor asn to Leon")
        (assert (= (cd/armExtra "off") "") "arm off passes no extra keys")
        (assert (= (cd/armExtra "") "") "no arm passes no extra keys")
        true))

; (:m :ref CONDUCTOR-VACUOUS-GATE :do "a write whose unit gate already passed on the base is not proven by any edit: it blocks with one escalate row on the first write, no retry, no tier hop, never gated")
fn ! testVacuousBlocks bin: String -> Bool
  (let [(dir (scratch "vacuous"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "V" (list "p/v") (list) (greenGate) "free"))))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--failsig" "vacuousGate: echo green") (list))) 4 4 400 60))
        (_ (cd/drain! ctx 600))
        (v (cuOf dir "V"))
        (esc (readOr dir "escalations.asn"))
        (tos (tosOf dir "V"))
        (_ (cleanup dir))]
    (do (assert put "unit put")
        (assert (= tos (list "ready" "writing" "blocked")) (str "V blocks on its first vacuous write: " (stringJoin tos ",")))
        (assert (= v.lane "free") (str "a vacuous gate does not hop tiers: " v.lane))
        (assert (stringStartsWith? esc "(:escalate :unit \"V\" :seen \"vacuousGate") (str "one escalate row names the vacuous gate: " esc))
        true))

; (:m :ref DEV-PROMOTE-ON-DEPLOY :do "a write refused as stale (its worktree lacks the deployed Leon and could not be rebased) parks the unit blocked :await rebase at once: no failure count, no tier hop, no escalate row, one (:stale ...) journal row")
fn ! testStaleBlocks bin: String -> Bool
  (let [(dir (scratch "stale"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "S" (list "p/s") (list) (greenGate) "free"))))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--failsig" "STALE_NEEDS_REBASE leon abc123def") (list))) 4 4 400 60))
        (_ (cd/drain! ctx 600))
        (s (cuOf dir "S"))
        (esc (readOr dir "escalations.asn"))
        (tos (tosOf dir "S"))
        (stale (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:stale :unit \"S\"")) (journalLines dir)))
        (_ (cleanup dir))]
    (do (assert put "unit put")
        (assert (= tos (list "ready" "writing" "blocked")) (str "S blocks on its first stale write: " (stringJoin tos ",")))
        (assert (and (= s.fails 0) (= s.esc 0)) (str "staleness is not a failure: fails " (stringFromInt64 s.fails) " esc " (stringFromInt64 s.esc)))
        (assert (and (= s.lane "free") (= s.await "rebase")) (str "no tier hop, waits on a rebase: " s.lane " " s.await))
        (assert (not (stringContains? esc "\"S\"")) "no escalate row for a stale unit")
        (assert (= (listLength stale) 1) "one stale journal row")
        true))

; (:m :ref STALE-WAKE :do "a stale-blocked unit stays put while the deployed main (store repo.path) is unchanged, wakes for one write retry when it moves (no fail count, no hop) and is written; a unit still stale after its wake blocks again with one (:lead ...) row, and a further unchanged tick does not retry it")
fn ! testStaleWake bin: String -> Bool
  (let [(dir (scratch "stalewake"))
        (repo (str dir "-repo"))
        (_ (cleanup dir))
        (_ (cleanup repo))
        (sh (fn [(c String)] -> String (resultOr (fr/shellOut c 60000) "")))
        (_ (sh (str "mkdir -p " repo " && cd " repo " && git init -q -b main && git config user.email t@example.invalid && git config user.name t && echo a > a && git add a && git commit -qm a && git branch sh/K")))
        (headA (stringTrim (sh (str "git -C " repo " rev-parse --short=9 HEAD"))))
        (put (putAll! dir (list (task "W" (list "p/w") (list) (greenGate) "free") (task "K" (list "p/k") (list) (greenGate) "free"))))
        (_ (fileWrite (cd/repoPath dir) (str repo "\n")))
        (stale (str "STALE_NEEDS_REBASE leon abc123def main " headA))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--failsig" stale "--writefail" (if (= id "W") "1" "0")) (list))) 4 4 400 60))
        (_ (cd/drain! ctx 600))
        (blocked (and (= (stOf dir "W") "blocked") (= (stOf dir "K") "blocked")))
        (_ (cd/drain! ctx 5))
        (startsOf (fn [(id String)] -> Int64 (listLength (filter (fn [(l String)] -> Bool (= l (str id " write"))) (stringLines (readOr dir "starts.log"))))))
        (quiet (and (= (startsOf "W") 1) (= (startsOf "K") 1)))
        (_ (sh (str "cd " repo " && echo b > b && git add b && git commit -qm b")))
        (_ (cd/drain! ctx 600))
        (_ (cd/drain! ctx 5))
        (w (cuOf dir "W"))
        (k (cuOf dir "K"))
        (leads (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:lead :unit")) (stringLines (readOr dir "escalations.asn"))))
        (woken (filter (fn [(l String)] -> Bool (stringContains? l ":result woken")) (journalLines dir)))
        (wStarts (startsOf "W"))
        (kStarts (startsOf "K"))
        (_ (sh (str "cd " repo " && echo c > c && git add c && git commit -qm c")))
        (_ (cd/drain! ctx 600))
        (_ (cd/drain! ctx 5))
        (k3 (cuOf dir "K"))
        (kStarts3 (startsOf "K"))
        (woken3 (filter (fn [(l String)] -> Bool (stringContains? l ":result woken")) (journalLines dir)))
        (_ (sh (str "cd " repo " && git checkout -q sh/K && echo k > k && git add k && git commit -qm k && git checkout -q main")))
        (_ (cd/drain! ctx 600))
        (_ (cd/drain! ctx 5))
        (kStarts4 (startsOf "K"))
        (woken4 (filter (fn [(l String)] -> Bool (stringContains? l ":result woken")) (journalLines dir)))
        (leads4 (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:lead :unit")) (stringLines (readOr dir "escalations.asn"))))
        (_ (cleanup dir))
        (_ (cleanup repo))]
    (do (assert (and put blocked) "both units block stale on their first write")
        (assert (and (= kStarts3 2) (= k3.st "blocked") (= k3.await "rebase")) (str "K parked with its lead row is not re-claimed when main moves again: starts " (stringFromInt64 kStarts3) " " k3.st))
        (assert (= (listLength woken3) 2) (str "no third wake for the parked unit: " (stringFromInt64 (listLength woken3))))
        (assert (and (= kStarts4 3) (= (listLength woken4) 3) (= (listLength leads4) 1)) (str "a changed own branch head wakes K once, still one lead row: starts " (stringFromInt64 kStarts4) " woken " (stringFromInt64 (listLength woken4))))
        (assert quiet "an unchanged deployed main retries nothing")
        (assert (= w.st "merged") (str "W is woken by the moved main, retried once and written: " w.st))
        (assert (and (= wStarts 2) (and (= w.fails 0) (= w.lane "free"))) (str "W ran two writes, no fail count, no hop: starts " (stringFromInt64 wStarts) " fails " (stringFromInt64 w.fails) " lane " w.lane))
        (assert (and (= k.st "blocked") (= k.await "rebase")) (str "K, still stale after its wake, blocks again: " k.st))
        (assert (= kStarts 2) (str "K was retried exactly once: " (stringFromInt64 kStarts)))
        (assert (and (= (listLength leads) 1) (stringContains? (optionOr (listHead leads) "") "\"K\"")) (str "one lead row, for K: " (stringJoin leads " | ")))
        (assert (= (listLength woken) 2) "one woken journal row per unit")
        true))

; (:m :ref COND-REBASE-WAKE-LOOP :do "(:conductor :staleWakeMax 2) in ladder.asn gives a stale unit two failed wakes before it parks behind its lead row; a third main move wakes nothing; cdErrors rejects unknown keys and values outside 1..100")
fn ! testStaleWakeMax bin: String -> Bool
  (let [(dir (scratch "stalemax"))
        (repo (str dir "-repo"))
        (_ (cleanup dir))
        (_ (cleanup repo))
        (sh (fn [(c String)] -> String (resultOr (fr/shellOut c 60000) "")))
        (_ (sh (str "mkdir -p " repo " && cd " repo " && git init -q -b main && git config user.email t@example.invalid && git config user.name t && echo a > a && git add a && git commit -qm a")))
        (headA (stringTrim (sh (str "git -C " repo " rev-parse --short=9 HEAD"))))
        (put (putAll! dir (list (task "K" (list "p/k") (list) (greenGate) "free"))))
        (_ (fileWrite (cd/repoPath dir) (str repo "\n")))
        (_ (fileWrite (str dir "/ladder.asn") "(:conductor :staleWakeMax 2)\n"))
        (stale (str "STALE_NEEDS_REBASE leon abc123def main " headA))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--failsig" stale "--writefail" "0") (list))) 4 4 400 60))
        (startsOf (fn [(id String)] -> Int64 (listLength (filter (fn [(l String)] -> Bool (= l (str id " write"))) (stringLines (readOr dir "starts.log"))))))
        (leadsOf (fn [(u String)] -> Int64 (listLength (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:lead :unit")) (stringLines (readOr dir "escalations.asn"))))))
        (_ (cd/drain! ctx 600))
        (_ (sh (str "cd " repo " && echo b > b && git add b && git commit -qm b")))
        (_ (cd/drain! ctx 600))
        (_ (cd/drain! ctx 5))
        (s1 (startsOf "K"))
        (l1 (leadsOf "K"))
        (_ (sh (str "cd " repo " && echo c > c && git add c && git commit -qm c")))
        (_ (cd/drain! ctx 600))
        (_ (cd/drain! ctx 5))
        (s2 (startsOf "K"))
        (l2 (leadsOf "K"))
        (_ (sh (str "cd " repo " && echo d > d && git add d && git commit -qm d")))
        (_ (cd/drain! ctx 600))
        (_ (cd/drain! ctx 5))
        (s3 (startsOf "K"))
        (k (cuOf dir "K"))
        (okRow (cd/cdErrors "(:conductor :staleWakeMax 5)"))
        (zero (cd/cdErrors "(:conductor :staleWakeMax 0)"))
        (big (cd/cdErrors "(:conductor :staleWakeMax 101)"))
        (unk (cd/cdErrors "(:conductor :staleWakeMaxx 2)"))
        (_ (cleanup dir))
        (_ (cleanup repo))]
    (do (assert put "unit put")
        (assert (and (= s1 2) (= l1 0)) (str "first failed wake: retried, no lead row yet under max 2: starts " (stringFromInt64 s1) " leads " (stringFromInt64 l1)))
        (assert (and (= s2 3) (= l2 1)) (str "second failed wake parks it behind one lead row: starts " (stringFromInt64 s2) " leads " (stringFromInt64 l2)))
        (assert (and (= s3 3) (= k.st "blocked")) (str "a further main move wakes nothing: starts " (stringFromInt64 s3)))
        (assert (and (listEmpty? okRow) (= (listLength zero) 1) (= (listLength big) 1) (= (listLength unk) 1)) "cdErrors: 5 ok, 0 and 101 out of range, unknown key")
        true))

; (:m :ref CONDUCTOR :do "a unit waiting on a dependency that never merges escalates after maxWait ticks and blocks")
fn ! testWaitEscalates bin: String -> Bool
  (let [(dir (scratch "wait"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "T" (list "p/t") (list "NOPE") (greenGate) "leon"))))
        (ctx (ctxOf dir bin 4 4 3))
        (_ (cd/drain! ctx 20))
        (t (cuOf dir "T"))
        (esc (readOr dir "escalations.asn"))
        (_ (cleanup dir))]
    (do (assert put "unit put")
        (assert (= t.st "blocked") (str "T blocked after waiting: " t.st))
        (assert (stringStartsWith? esc "(:escalate :unit \"T\" :seen \"deps not merged\"") (str "escalate row names the wait cause: " esc))
        true))

; (:m :ref CONDUCTOR :do "stages overlap: with 3 slots and 3 disjoint units whose write stage sleeps 3 s, the third tick still finds all three in writing, each with its own live child pid, and the journal has no unit leaving writing yet; then all three merge")
fn ! testParallel bin: String -> Bool
  (let [(dir (scratch "par"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "U1" (list "p/1") (list) (greenGate) "leon") (task "U2" (list "p/2") (list) (greenGate) "leon") (task "U3" (list "p/3") (list) (greenGate) "leon"))))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--sleep" "3000") (list))) 3 3 400 60))
        (t1 (cd/tick! ctx))
        (t2 (cd/tick! ctx))
        (t3 (cd/tick! ctx))
        (states (list (stOf dir "U1") (stOf dir "U2") (stOf dir "U3")))
        (p1 (pidOf dir "U1" "write")) (p2 (pidOf dir "U2" "write")) (p3 (pidOf dir "U3" "write"))
        (live (list (up? p1) (up? p2) (up? p3)))
        (left (fromCount dir "writing"))
        (_ (cd/drain! ctx 600))
        (final (list (stOf dir "U1") (stOf dir "U2") (stOf dir "U3")))
        (_ (cd/stopAll! ctx))
        (_ (cleanup dir))]
    (do (assert put "three units put")
        (assert (= states (list "writing" "writing" "writing")) (str "all three are in writing at the third tick: " (stringJoin states ",")))
        (assert (and (!= p1 p2) (and (!= p2 p3) (!= p1 p3)) (> p1 0)) (str "three distinct child pids: " (stringFromInt64 p1) " " (stringFromInt64 p2) " " (stringFromInt64 p3)))
        (assert (= live (list true true true)) "all three children are alive at once")
        (assert (= left 0) "no unit has left writing in the journal yet")
        (assert (= final (list "merged" "merged" "merged")) (str "all three merge: " (stringJoin final ",")))
        true))

; (:m :ref CONDUCTOR :do "a stage child killed from outside is a failed stage with a signature and the unit retries through ready")
fn ! testKilledChild bin: String -> Bool
  (let [(dir (scratch "kill"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "K" (list "p/k") (list) (greenGate) "leon"))))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--sleep" "30000") (list))) 2 2 400 60))
        (_ (cd/tick! ctx))
        (_ (cd/tick! ctx))
        (pid (pidOf dir "K" "write"))
        (aliveBefore (up? pid))
        (_ (fr/killTree! pid))
        (failed (tickUntil! ctx dir "K" "ready" 1 200))
        (k (cuOf dir "K"))
        (_ (cd/stopAll! ctx))
        (_ (cleanup dir))]
    (do (assert put "unit put")
        (assert aliveBefore "the write child was alive before the kill")
        (assert failed (str "K failed once and is back in ready: " k.st " " (stringFromInt64 k.fails)))
        (assert (stringContains? k.sig "stage died") (str "the signature says the stage died: " k.sig))
        true))

; (:m :ref CONDUCTOR :do "a stage child past its deadline is killed with its tree and fails with a timeout signature")
fn ! testStageTimeout bin: String -> Bool
  (let [(dir (scratch "tmo"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "O" (list "p/o") (list) (greenGate) "leon"))))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--sleep" "30000") (list))) 2 2 400 1))
        (_ (cd/tick! ctx))
        (_ (cd/tick! ctx))
        (pid (pidOf dir "O" "write"))
        (failed (tickUntil! ctx dir "O" "ready" 1 200))
        (o (cuOf dir "O"))
        (gone (not (up? pid)))
        (_ (cd/stopAll! ctx))
        (_ (cleanup dir))]
    (do (assert put "unit put")
        (assert failed (str "O failed once: " o.st " " (stringFromInt64 o.fails)))
        (assert (stringContains? o.sig "stage timeout") (str "timeout signature: " o.sig))
        (assert gone "the timed-out child is dead")
        true))

; (:m :ref CONDUCTOR :do "a restarted conductor resumes from the store rows: a fresh Ctx after the write child was started finishes the unit without starting the stage again")
fn ! testResume bin: String -> Bool
  (let [(dir (scratch "res"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "R" (list "p/r") (list) (greenGate) "leon"))))
        (extra (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--sleep" "1500") (list))))
        (ctx1 (ctxWith dir bin extra 2 2 400 60))
        (_ (cd/tick! ctx1))
        (_ (cd/tick! ctx1))
        (mid (cuOf dir "R"))
        (pidMid (pidOf dir "R" "write"))
        (ctx2 (ctxWith dir bin extra 2 2 400 60))
        (_ (cd/drain! ctx2 600))
        (r (cuOf dir "R"))
        (starts (readOr dir "starts.log"))
        (tos (tosOf dir "R"))
        (_ (cd/stopAll! ctx2))
        (_ (cleanup dir))]
    (do (assert put "unit put")
        (assert (and (= mid.st "writing") (= mid.launched 1) (> pidMid 0)) (str "the first conductor left R writing with a child: " mid.st " " (stringFromInt64 pidMid)))
        (assert (= r.st "merged") (str "the second conductor finished R: " r.st))
        (assert (= (listLength (stringSplit starts "R write")) 2) (str "the write stage started exactly once: " starts))
        (assert (= tos (list "ready" "writing" "gating" "awaitReview" "reviewing" "merging" "merged")) (str "one clean chain: " (stringJoin tos ",")))
        true))

; (:m :ref CONDUCTOR :do "capacity counts the units already in flight: with 2 slots and 3 disjoint units, ticks after the first admission leave the third in ready until a slot frees, then all three merge")
fn ! testCapacity bin: String -> Bool
  (let [(dir (scratch "cap"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "V1" (list "p/1") (list) (greenGate) "leon") (task "V2" (list "p/2") (list) (greenGate) "leon") (task "V3" (list "p/3") (list) (greenGate) "leon"))))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--sleep" "2000") (list))) 2 9 400 60))
        (t1 (cd/tick! ctx))
        (t2 (cd/tick! ctx))
        (t3 (cd/tick! ctx))
        (t4 (cd/tick! ctx))
        (states (list (stOf dir "V1") (stOf dir "V2") (stOf dir "V3")))
        (_ (cd/drain! ctx 600))
        (final (list (stOf dir "V1") (stOf dir "V2") (stOf dir "V3")))
        (_ (cd/stopAll! ctx))
        (_ (cleanup dir))]
    (do (assert put "three units put")
        (assert (= states (list "writing" "writing" "ready")) (str "two slots in flight, the third waits: " (stringJoin states ",")))
        (assert (= final (list "merged" "merged" "merged")) (str "all three merge in the end: " (stringJoin final ",")))
        true))

; (:m :ref COND3 :do "a merge failure retries the merge, not the write; the journal row carries the reason; the same failure three times escalates; a merge that succeeds on the retry lands")
fn ! testMergeRetry bin: String -> Bool
  (let [(dirA (scratch "mergeA"))
        (dirB (scratch "mergeB"))
        (_ (cleanup dirA))
        (_ (cleanup dirB))
        (ex (fn [(n String)] -> (fn [String String] -> (List String)) (fn [(stage String) (id String)] -> (List String) (if (= stage "merge") (list "--mergefail" n "--failsig" "train red: suite X exit 1") (list)))))
        (_ (putAll! dirA (list (task "M" (list "p/m") (list) (greenGate) "leon"))))
        (_ (putAll! dirB (list (task "M" (list "p/m") (list) (greenGate) "leon"))))
        (ctxA (ctxWith dirA bin (ex "9") 4 4 400 60))
        (ctxB (ctxWith dirB bin (ex "1") 4 4 400 60))
        (_ (cd/drain! ctxA 800))
        (_ (cd/drain! ctxB 800))
        (a (cuOf dirA "M"))
        (b (cuOf dirB "M"))
        (jA (stringJoin (journalLines dirA) "\n"))
        (startsA (readOr dirA "starts.log"))
        (startsB (readOr dirB "starts.log"))
        (_ (cleanup dirA))
        (_ (cleanup dirB))]
    (do (assert (and (= a.st "blocked") (= a.fails 3)) (str "M blocked after 3 merge failures: " a.st " " (stringFromInt64 a.fails)))
        (assert (stringContains? jA ":verdict \"retry: train red: suite X exit 1\"") (str "the journal keeps the merge reason: " jA))
        (assert (stringContains? jA ":verdict \"escalated: train red: suite X exit 1\"") "the escalation row keeps it too")
        (assert (= (listLength (filter (fn [(l String)] -> Bool (= l "M write")) (stringLines startsA))) 1) (str "the write ran once, not again after a merge failure: " startsA))
        (assert (= (listLength (filter (fn [(l String)] -> Bool (= l "M merge")) (stringLines startsA))) 3) "three merge starts")
        (assert (= b.st "merged") (str "a merge that fails once then succeeds lands: " b.st))
        (assert (= (listLength (filter (fn [(l String)] -> Bool (= l "M write")) (stringLines startsB))) 1) "one write")
        true))

fn ! mergeLive dir: String -> Int64
  (listLength (filter (fn [(c cd/CUnit)] -> Bool (and (= c.st "merging") (!= c.launched 0))) (cd/readCUnits! dir)))

fn ! tickMax! ctx: cd/Ctx dir: String peak: Int64 left: Int64 -> Int64
  (let [(both (and (= (stOf dir "S1") "merged") (= (stOf dir "S2") "merged")))]
    (if (or both (<= left 0)) peak
      (let [(_ (cd/tick! ctx)) (live (mergeLive dir)) (_ (sleepMs 50))]
        (tickMax! ctx dir (if (> live peak) live peak) (- left 1)))))

; (:m :ref COND-MERGE-STAGE-RED :do "two reviewed disjoint units whose merge stage sleeps 1.5 s: at no tick are two merge children live, the second merge starts after the first lands, and both reach merged with one merge start each")
fn ! testMergeSerial bin: String -> Bool
  (let [(dir (scratch "mergeSerial"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "S1" (list "p/s1") (list) (greenGate) "leon") (task "S2" (list "p/s2") (list) (greenGate) "leon"))))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "merge") (list "--sleep" "1500") (list))) 4 4 400 60))
        (peak (tickMax! ctx dir 0 600))
        (s1 (stOf dir "S1"))
        (s2 (stOf dir "S2"))
        (starts (stringLines (readOr dir "starts.log")))
        (merges (filter (fn [(l String)] -> Bool (stringEndsWith? l " merge")) starts))
        (merged (readOr dir "merged.log"))
        (_ (cd/stopAll! ctx))
        (_ (cleanup dir))]
    (do (assert put "two units put")
        (assert (= peak 1) (str "one merge child live at a time, peak " (stringFromInt64 peak)))
        (assert (and (= s1 "merged") (= s2 "merged")) (str "both reviewed units reach merged: " s1 " " s2))
        (assert (= (listLength merges) 2) (str "one merge start per unit: " (stringJoin merges ",")))
        (assert (= (listLength (filter (fn [(l String)] -> Bool (not (stringEmpty? l))) (stringLines merged))) 2) (str "two merges landed: " merged))
        true))

fn killedTrainOut -> String
  (str "(:redLive \"asl/tests/corpusTest.asl\" 1 114 :kind suite :err (\"ERR_UNKNOWN_SYMBOL unbound symbol: HOSTFAIL\\\\\\\\\\\\\\\"\\\\\\\")\" \"ERR_ASSERT: assertion failed: case 115 stdout matches recorded behavior\"))\n"
       "\n(:fleetRun :verdict :timeout :pid 1912259 :desc 3 :timeoutMs 3600000 :maxDesc 200 :left 0)\n")

fn doneTrainOut -> String
  (str "(:redLive \"asl/a/aTest.asl\" 1 3 :kind suite :err (\"ERR_ASSERT: a \\\"q\\\" broke\"))\n"
       "(:redLive \"asl/b/bTest.asl\" 1 0 :kind suite :err (\"ERR_UNKNOWN_SYMBOL unbound symbol: X\"))\n"
       "(:train :head \"abc\" :merged \"def\" :branches (\"sh/X\") :changed 2 :selected 2 :keyMs 1 :cached 0 :ran 2 :green 0 :invariants 0"
       " :red ((\"asl/a/aTest.asl\" \"sh/X\" 1 3 :kind suite :why fresh :err (\"ERR_ASSERT: a \\\"q\\\" broke\")))"
       " :preexisting ((\"asl/b/bTest.asl\" \"sh/X\" 1 0 :kind suite :why preexisting)) :assertLoss () :baseKnown 2 :seconds 9)\n")

; (:m :ref COND-MERGE-STAGE-RED :do "a merge signature names the train's own cause: a run.asl timeout kill reads killed: timeout after 3600 s, a finished red train names its fresh red suites by path and drops the preexisting one, neither carries a backslash from the suite output it quotes; a plain gate output keeps its first ERR line")
fn testTrainSig -> Bool
  (let [(killed (cd/gateSig (killedTrainOut)))
        (red (cd/gateSig (doneTrainOut)))
        (plain (cd/gateSig "building\nsuite x: ERR_ASSERT: boom\ndone"))]
    (do (assert (= killed "killed: timeout after 3600 s") (str "a killed train names the kill: " killed))
        (assert (= red "train red: asl/a/aTest.asl") (str "a red train names its fresh red suite: " red))
        (assert (not (or (stringContains? killed "\\") (stringContains? red "\\"))) "no backslash from nested suite output")
        (assert (= plain "ERR_ASSERT: boom") (str "a plain gate output keeps its first ERR line: " plain))
        true))

fn ! verdictOf line: String -> String
  (match (st/rowFields line "t") ((ok fs) (st/textField fs "verdict")) ((err _) "unreadable"))

; (:m :ref COND-MERGE-STAGE-RED :do "a merge signature with a quote and a backslash passes the stage result, the unit row and the journal and is escaped once: each retry row decodes with one read to exactly retry: plus the signature, and the retries carry the same text")
fn ! testMergeVerdictOnce bin: String -> Bool
  (let [(dir (scratch "mergeEsc"))
        (_ (cleanup dir))
        (sig "train red: \"a\\b\" exit 1")
        (_ (putAll! dir (list (task "E" (list "p/e") (list) (greenGate) "leon"))))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "merge") (list "--mergefail" "9" "--failsig" sig) (list))) 4 4 400 60))
        (_ (cd/drain! ctx 800))
        (rows (filter (fn [(l String)] -> Bool (and (stringContains? l "(:t :unit \"E\" ") (stringContains? l " :stage merge "))) (journalLines dir)))
        (verdicts (map verdictOf rows))
        (_ (cleanup dir))]
    (do (assert (= (listLength verdicts) 3) (str "two retries and one escalation: " (stringFromInt64 (listLength verdicts))))
        (assert (= (listTake verdicts 2) (list (str "retry: " sig) (str "retry: " sig))) (str "each retry decodes to the signature once: " (stringJoin verdicts " | ")))
        (assert (= (optionOr (listGet verdicts 2) "") (str "escalated: " sig)) "the escalation row decodes to it too")
        true))

; (:m :ref COND4 :do "a stage cost of -1 (unpriced) journals :priced false and adds nothing to the unit's spend; a priced cost adds and journals no marker")
fn ! testUnpriced bin: String -> Bool
  (let [(dir (scratch "unpriced"))
        (_ (cleanup dir))
        (ex (fn [(stage String) (id String)] -> (List String) (if (= stage "review") (list "--cost" "-1" "--tokens" "10") (list "--cost" "700"))))
        (_ (putAll! dir (list (task "C" (list "p/c") (list) (greenGate) "leon"))))
        (ctx (ctxWith dir bin ex 4 4 400 60))
        (_ (cd/drain! ctx 800))
        (c (cuOf dir "C"))
        (j (stringJoin (journalLines dir) "\n"))
        (_ (cleanup dir))]
    (do (assert (= c.st "merged") (str "C merged: " c.st))
        (assert (stringContains? j ":stage review :model \"fakeReviewer\" :tokens 10 :costUsd 0.000000 :priced false") (str "the unpriced review row says so: " j))
        (assert (= c.costMicro 700) (str "only the priced write counts: " (stringFromInt64 c.costMicro)))
        true))

fn offerExtra v: String t: String -> (fn [String String] -> (List String))
  (fn [(stage String) (id String)] -> (List String) (if (= stage "review") (list "--verdict" v "--tiers" (if (= id "K") "claude" t)) (list)))

fn strongSnap n: Int64 -> (fn [] -> (List (Pair String Int64)))
  (fn [] -> (List (Pair String Int64)) (list (pair "strong" n)))

; (:m :ref COND4 :do "the queue reads escalate :tiers: a unit blocked with (strong claude) is offered to the strong lane when that tier has allowance, goes back to awaitReview with a fresh lease and an offer the review consumes once, and merges after a pass; (claude) only rows and a strong tier without allowance leave the unit blocked")
fn ! testOfferStrong bin: String -> Bool
  (let [(dir (scratch "offer"))
        (_ (cleanup dir))
        (_ (putAll! dir (list (task "S" (list "p/s") (list) (greenGate) "leon") (task "K" (list "p/k") (list) (greenGate) "leon"))))
        (ctx1 (ctxWith dir bin (offerExtra "block" "strong claude") 4 4 400 60))
        (_ (cd/drain! ctx1 800))
        (s0 (cuOf dir "S"))
        (k0 (cuOf dir "K"))
        (rows (readOr dir "escalations.asn"))
        (none (cd/offerStrong! ctx1 (strongSnap 0)))
        (s1 (cuOf dir "S"))
        (one (cd/offerStrong! ctx1 (strongSnap 5)))
        (s2 (cuOf dir "S"))
        (k2 (cuOf dir "K"))
        (offerThere (fileExists? (cd/offerPath dir "S")))
        (ctx2 (ctxWith dir bin (offerExtra "pass" "") 4 4 400 60))
        (_ (cd/drain! ctx2 800))
        (s3 (cuOf dir "S"))
        (first (cd/offeredRung! dir "S"))
        (second (cd/offeredRung! dir "S"))
        (_ (cleanup dir))]
    (do (assert (and (= s0.st "blocked") (= k0.st "blocked")) "both units blocked by the review")
        (assert (and (stringContains? rows ":tiers (strong claude)") (stringContains? rows ":tiers (claude)")) (str "the rows carry their tiers: " rows))
        (assert (and (= none 0) (= s1.st "blocked")) "no strong allowance, no offer")
        (assert (= one 1) (str "one unit offered: " (stringFromInt64 one)))
        (assert (and (= s2.st "awaitReview") (> s2.epoch 0) offerThere) (str "S back in awaitReview with a lease and an offer: " s2.st))
        (assert (= k2.st "blocked") "the claude-only unit stays blocked")
        (assert (= s3.st "merged") (str "S merges after the strong review passes: " s3.st))
        (assert (and (= first "R3") (= second "")) (str "the offer starts the ladder at R3 once: " first "/" second))
        true))

; (:m :ref COND5 :do "the service cycle imports the plan ledger named in <store>/ledger.path: complete rows become units, a row without :owns is parked and written once as a (:need ...) escalation row (deduped over cycles), status lists it; no ledger.path means no import")
fn ! testIntake bin: String -> Bool
  (let [(dir (scratch "intake"))
        (_ (cleanup dir))
        (_ (dirCreate dir))
        (ledger (str dir "/plan.fixture.asn"))
        (_ (fileWrite ledger "(:u :id N1 :auto true :do \"new unit\" :owns (\"p/n1\") :gate \"echo '3 assertion(s) executed (3 passed)'\")\n(:u :id P1 :queue conductor :do \"no owns yet\" :gate \"true\")\n"))
        (ctx (ctxOf dir bin 4 4 400))
        (_ (cd/loopOnce! ctx (strongSnap 0) (fn [] -> Unit ()) false))
        (noCfg (listLength (cd/readCUnits! dir)))
        (_ (fileWrite (cd/ledgerPath dir) (str ledger "\ndev\n")))
        (_ (cd/loopOnce! ctx (strongSnap 0) (fn [] -> Unit ()) false))
        (_ (cd/loopOnce! ctx (strongSnap 0) (fn [] -> Unit ()) false))
        (esc (readOr dir "escalations.asn"))
        (status (cd/status! ctx))
        (n1 (cuOf dir "N1"))
        (_ (cleanup dir))]
    (do (assert (= noCfg 0) "no ledger.path, nothing imported")
        (assert (not (= n1.st "absent")) (str "N1 imported and stepped: " n1.st))
        (assert (and (stringContains? esc "(:need :unit \"P1\" :needs owns :do \"no owns yet\")") (= (listLength (stringSplit esc "(:need ")) 2)) (str "one need row for P1: " esc))
        (assert (stringContains? status "(:parked (\"P1:owns\"))") (str "status lists the parked row: " status))
        true))

; (:m :ref ESC-LEAD-HOOK :do "a fresh lead heartbeat in the store: the lead rung is open")
fn ! beatFresh! dir: String -> Bool
  (ok? (fileWrite (str dir "/leadOnline.asn") (str "(:leadOnline :at " (stringFromInt64 (/ (nowNs) 1000000)) ")\n")))

; (:m :ref WRITEESC :do "a unit failing the write stage maxSame times on lane free is admitted again on paid (count reset, tierHop journalled) and merges there; with every lane failing it blocks only after the last lane, with exactly one escalate row")
fn ! laneCtx dir: String bin: String failing: (List String) -> cd/Ctx
  (cd/Ctx :dir dir :holder "conductorTest" :ttlMs 600000 :maxWait 400 :maxSame 3 :stageSec 60 :maxDesc 50
          :launch (fn [(stage String) (u st/Task) (c cd/CUnit)] -> (List String)
                    (listAppend (list bin "stage" stage u.id "--store" dir) (if (and (= stage "write") (listContains? failing c.lane)) (list "--failsig" (str "writer boom on " c.lane)) (list))))
          :pace (cd/fixedPace 4 4))

fn ! testWriteTierHop bin: String -> Bool
  (let [(dir (scratch "hop"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "T" (list "p/t") (list) (greenGate) "free"))))
        (ctx (laneCtx dir bin (list "free")))
        (ticks (cd/drain! ctx 900))
        (t (cuOf dir "T"))
        (j (stringJoin (journalLines dir) "\n"))
        (esc (readOr dir "escalations.asn"))
        (dir2 (scratch "hop2"))
        (_ (cleanup dir2))
        (put2 (putAll! dir2 (list (task "U" (list "p/u") (list) (greenGate) "free"))))
        (_ (beatFresh! dir2))
        (ctx2 (laneCtx dir2 bin (list "free" "paid" "strong")))
        (ticks2 (cd/drain! ctx2 1200))
        (u (cuOf dir2 "U"))
        (j2 (stringJoin (journalLines dir2) "\n"))
        (esc2 (readOr dir2 "escalations.asn"))
        (_ (cleanup dir))
        (_ (cleanup dir2))]
    (do (assert (and put put2) "units put")
        (assert (stringContains? j "tierHop free->paid") (str "free failed 3x and hopped to paid: " j))
        (assert (and (= t.lane "paid") (not (= t.st "blocked")) (stringEmpty? esc)) (str "T runs on paid, not blocked, no escalate row: " t.lane " " t.st " " esc))
        (assert (and (stringContains? j2 "tierHop free->paid") (stringContains? j2 "tierHop paid->strong")) (str "U hopped through every tier: " j2))
        (assert (stringContains? j2 "tierHop strong->lead") (str "U reached the lead rung: " j2))
        (assert (and (= u.st "blocked") (and (= u.lane "lead") (= u.await "lead"))) (str "U parked for the lead: " u.st " " u.lane " " u.await))
        (assert (= (listLength (stringSplit esc2 "(:escalate")) 2) (str "exactly one escalate row, written after the last tier: " esc2))
        (assert (and (= (listLength (stringSplit esc2 "(:lead :unit \"U\" :at ")) 2) (stringContains? esc2 ":seen \"write failed 2x on strong\"")) (str "one lead row for the follower, carrying the failure: " esc2))
        (assert (= (listLength (stringSplit j2 " :to blocked ")) 2) "blocked once")
        true))

; (:m :ref ESC-LADDER :do "scripted ladder: a unit failing on every rung walks free (3 same-signature fails) -> paid (2) -> strong (2) -> lead, gets the lower rung's failure in its task, and a rung capped at 0 for the day is skipped")
fn ! testEscLadder bin: String -> Bool
  (let [(dir (scratch "ladder"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "L" (list "p/l") (list) (greenGate) "free"))))
        (_ (beatFresh! dir))
        (ctx (laneCtx dir bin (list "free" "paid" "strong")))
        (ticks (cd/drain! ctx 1500))
        (l (cuOf dir "L"))
        (lines (journalLines dir))
        (onLane (fn [(lane String)] -> Int64 (listLength (filter (fn [(r String)] -> Bool (and (stringContains? r "(:t :unit \"L\" :from writing :to ready") (stringContains? r (str ":verdict \"fail: writer boom on " lane)))) lines))))
        (prior (cd/priorNote! dir "L"))
        (dir2 (scratch "ladderCap"))
        (_ (cleanup dir2))
        (put2 (putAll! dir2 (list (task "M" (list "p/m") (list) (greenGate) "free"))))
        (_ (beatFresh! dir2))
        (_ (fileWrite (str dir2 "/ladder.asn") "(:rung :tier paid :perDay 0)\n"))
        (ctx2 (laneCtx dir2 bin (list "free" "paid" "strong")))
        (ticks2 (cd/drain! ctx2 1500))
        (j2 (stringJoin (journalLines dir2) "\n"))
        (m (cuOf dir2 "M"))
        (_ (cleanup dir))
        (_ (cleanup dir2))]
    (do (assert (and put put2) "units put")
        (assert (= (onLane "free") 2) (str "free: 2 retries then the hop on the 3rd: " (stringFromInt64 (onLane "free"))))
        (assert (= (onLane "paid") 1) (str "paid passes up on its 2nd failure: " (stringFromInt64 (onLane "paid"))))
        (assert (= (onLane "strong") 1) (str "strong passes up on its 2nd failure: " (stringFromInt64 (onLane "strong"))))
        (assert (and (= l.st "blocked") (= l.await "lead")) (str "L parked for the lead: " l.st " " l.await))
        (assert (stringStartsWith? prior "(:prior :last \"writer boom on strong\" :history (") (str "the lead hop carries strong's failure as :last, no leading blank line: " prior))
        (assert (and (stringContains? prior "\"free: writer boom on free\"") (stringContains? prior "\"paid: writer boom on paid\"")) (str "earlier rungs stay as :history: " prior))
        (assert (and (stringContains? j2 "tierHop free->strong") (not (stringContains? j2 "->paid"))) (str "a paid rung capped at 0 is skipped: " j2))
        (assert (and (= m.st "blocked") (= m.lane "lead")) (str "M still ends at the lead: " m.st " " m.lane))
        (assert (= (cd/rungCap "(:rung :tier paid :perDay 5)\n" "paid") 5) "rungCap reads :perDay")
        (assert (= (cd/rungCap "" "paid") -1) "no row, no cap")
        (assert (= (cd/hopsSince (list "(:t :verdict \"tierHop free->paid: x\" :at 100)" "(:t :verdict \"tierHop free->paid: y\" :at 5)") "paid" 50) 1) "hops before the day start do not count")
        true))

; (:m :ref ESC-LEAD-HOOK :do "with no lead heartbeat, or one older than leadTtlMs, a unit failing every tier is blocked on strong with the plain escalate row, no lead hop and no (:lead row; leadFresh? reads :at against the ttl")
fn ! testLeadOffline bin: String -> Bool
  (let [(dir (scratch "leadOff"))
        (_ (cleanup dir))
        (put (putAll! dir (list (task "O" (list "p/o") (list) (greenGate) "free"))))
        (stale (fileWrite (str dir "/leadOnline.asn") (str "(:leadOnline :at " (stringFromInt64 (- (/ (nowNs) 1000000) 600000)) ")\n")))
        (ctx (laneCtx dir bin (list "free" "paid" "strong")))
        (ticks (cd/drain! ctx 1200))
        (o (cuOf dir "O"))
        (j (stringJoin (journalLines dir) "\n"))
        (esc (readOr dir "escalations.asn"))
        (_ (cd/tick! ctx))
        (escStale (readOr dir "escalations.asn"))
        (_ (beatFresh! dir))
        (_ (cd/tick! ctx))
        (esc1 (readOr dir "escalations.asn"))
        (_ (cd/tick! ctx))
        (_ (cd/tick! ctx))
        (esc2 (readOr dir "escalations.asn"))
        (_ (cleanup dir))]
    (do (assert (and put (ok? stale)) "unit put, stale heartbeat written")
        (assert (and (stringContains? j "tierHop paid->strong") (not (stringContains? j "->lead"))) (str "a stale heartbeat never opens the lead rung: " j))
        (assert (and (= o.st "blocked") (not (= o.await "lead"))) (str "O blocked without :await lead: " o.st " " o.await))
        (assert (and (= (listLength (stringSplit esc "(:escalate")) 2) (not (stringContains? esc "(:lead "))) (str "one plain escalate row, no lead row: " esc))
        (assert (not (stringContains? escStale "(:lead ")) (str "a stale heartbeat queues nothing for the lead: " escStale))
        (assert (and (= (listLength (stringSplit esc1 "(:lead :unit \"O\" :at ")) 2) (stringContains? esc1 ":seen \"backlog: blocked on strong\"")) (str "a heartbeat appearing queues the blocked unit once: " esc1))
        (assert (= esc1 esc2) (str "later ticks do not queue it again: " esc2))
        (assert (and (cd/leadFresh? "(:leadOnline :at 1000)" 1000) (cd/leadFresh? "(:leadOnline :at 1000)" (+ 1000 (cd/leadTtlMs)))) "a row at the ttl edge is fresh")
        (assert (not (cd/leadFresh? "(:leadOnline :at 1000)" (+ 1001 (cd/leadTtlMs)))) "one ms past the ttl is stale")
        (assert (and (not (cd/leadFresh? "" 5)) (not (cd/leadFresh? "(:leadOnline :at junk)" 5))) "no row or an unreadable row is stale")
        true))

; (:m :ref ESC-BACKLOG-CAP-GATE :do "25 units blocked on a plain escalate and a fresh heartbeat: the first offerBacklog! writes (:lead rows for the 20 oldest blocked, the second the remaining 5, the third none; no unit gets two rows")
fn ! backlogId i: Int64 -> String
  (str "B" (if (< i 10) "0" "") (stringFromInt64 i))

fn ! testBacklogCap -> Bool
  (let [(dir (scratch "cap"))
        (_ (cleanup dir))
        (_ (dirCreate dir))
        (ids (map (fn [(i Int64)] -> String (backlogId i)) (range 1 26)))
        (_ (map (fn [(id String)] -> Bool (ok? (fileAppend (str dir "/journal.asn") (str "(:t :unit \"" id "\" :from writing :to blocked :stage write :model \"\" :tokens 0 :costUsd 0.000000 :verdict \"x\" :ms 1 :at " (stringFromInt64 (+ 1000 (optionOr (stringToInt64 (optionOr (stringSlice id 1 3) "")) 0))) ")\n")))) ids))
        (_ (map (fn [(id String)] -> Bool (do (cd/writeCUnit! dir (cd/CUnit :id id :st "blocked" :lane "strong" :fails 0 :sig "boom" :waited 0 :parked 0 :epoch 0 :branch "" :wt "" :model "" :tokens 0 :costMicro 0 :esc 1 :launched 0 :await "")) true)) ids))
        (now (/ (nowNs) 1000000))
        (_ (beatFresh! dir))
        (n1 (cd/offerBacklog! dir now))
        (e1 (readOr dir "escalations.asn"))
        (n2 (cd/offerBacklog! dir now))
        (e2 (readOr dir "escalations.asn"))
        (n3 (cd/offerBacklog! dir now))
        (e3 (readOr dir "escalations.asn"))
        (rows (fn [(t String)] -> Int64 (- (listLength (stringSplit t "(:lead ")) 1)))
        (_ (cleanup dir))]
    (do (assert (and (= n1 20) (= (rows e1) 20)) (str "the first pass writes exactly the cap: " (stringFromInt64 n1) " " (stringFromInt64 (rows e1))))
        (assert (and (stringContains? e1 "\"B01\"") (stringContains? e1 "\"B20\"") (not (stringContains? e1 "\"B21\""))) "oldest blocked first: B01..B20, not B21")
        (assert (and (= n2 5) (= (rows e2) 25) (stringContains? e2 "\"B25\"")) (str "the second pass writes the other 5: " (stringFromInt64 n2) " " (stringFromInt64 (rows e2))))
        (assert (and (= n3 0) (= e3 e2)) (str "the third pass writes nothing: " (stringFromInt64 n3)))
        true))

; (:m :ref COND-PROVIDER-FAIL-NO-HOP :do "a write failing on the provider class (ERR_VENDOR, no commit) is requeued after the configured backoff with no fail count, no ladder hop and a (:providerFail row, then merges; with :maxInRow 1 and a dead route it is requeued once per rung and then fails normally, so the ladder still ends at blocked; the config row is read from ladder.asn and checked")
fn ! testProviderFail bin: String -> Bool
  (let [(dir (scratch "provfail"))
        (_ (cleanup dir))
        (put (putAll! dir (list (with (task "P" (list "p/p") (list) (greenGate) "free") :base "HEAD"))))
        (row "(:providerFail :backoffS 1 :maxInRow 3 :patterns (\"err_vendor\"))")
        (_ (fileWrite (str dir "/ladder.asn") (str row "\n")))
        (ctx (ctxWith dir bin (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--failsig" "ERR_VENDOR glm 502" "--writefail" "2") (list))) 4 4 400 60))
        (_ (cd/drain! ctx 1500))
        (p (cuOf dir "P"))
        (jr (journalLines dir))
        (provRows (filter (fn [(l String)] -> Bool (stringStartsWith? l "(:providerFail :unit \"P\"")) jr))
        (ats (map (fn [(l String)] -> Int64 (optionOr (stringToInt64 (sp/tokAfter l ":at")) 0)) provRows))
        (gap (- (optionOr (listGet ats 1) 0) (optionOr (listGet ats 0) 0)))
        (j (stringJoin jr "\n"))
        (dir2 (scratch "provfail2"))
        (_ (cleanup dir2))
        (put2 (putAll! dir2 (list (with (task "D" (list "p/d") (list) (greenGate) "free") :base "HEAD"))))
        (_ (fileWrite (str dir2 "/ladder.asn") "(:providerFail :backoffS 1 :maxInRow 1 :patterns (\"err_vendor\"))\n"))
        (ctx2 (ctxWith dir2 bin (fn [(stage String) (id String)] -> (List String) (if (= stage "write") (list "--failsig" "ERR_VENDOR dead") (list))) 4 4 400 60))
        (_ (cd/drain! ctx2 3000))
        (d (cuOf dir2 "D"))
        (j2 (stringJoin (journalLines dir2) "\n"))
        (nProv2 (- (listLength (stringSplit j2 "(:providerFail :unit \"D\"")) 1))
        (repo (str dir "-repo"))
        (_ (cleanup repo))
        (sh (fn [(c String)] -> String (resultOr (fr/shellOut c 60000) "")))
        (_ (sh (str "mkdir -p " repo " && cd " repo " && git init -q -b main && git config user.email t@example.invalid && git config user.name t && echo a > a && git add a && git commit -qm a")))
        (base (stringTrim (sh (str "git -C " repo " rev-parse HEAD"))))
        (u0 (with (task "P" (list "p/p") (list) (greenGate) "free") :base base))
        (res0 (cd/Res :tiers "" :ok 0 :wt repo :branch "" :model "" :tokens 0 :costMicro 0 :claimedGreen 0 :sig "ERR_VENDOR x" :ms 0 :exit 1 :asserts 0 :verdict ""))
        (hitNone (cd/providerHit? ctx u0 p res0))
        (none0 (cd/noCommits? repo base))
        (_ (sh (str "cd " repo " && echo b > b && git add b && git commit -qm b")))
        (hitSome (cd/providerHit? ctx u0 p res0))
        (some1 (cd/noCommits? repo base))
        (_ (cleanup repo))
        (_ (cleanup dir))
        (_ (cleanup dir2))]
    (do (assert (and put put2) "units put")
        (assert (= (cd/pfBackoffS row) 1) "the backoff is read from the config row")
        (assert (and (= (listLength provRows) 2) (>= gap 1000)) (str "two provider fails, the second admitted at least the configured backoff after the first: " (stringFromInt64 (listLength provRows)) " gap " (stringFromInt64 gap)))
        (assert (and (= p.st "merged") (= p.lane "free") (= p.fails 0)) (str "P merged on its own lane with no fail count: " p.st " " p.lane " " (stringFromInt64 p.fails)))
        (assert (and (not (stringContains? j "tierHop")) (not (stringContains? j "verdict \"fail:"))) (str "no ladder hop and no counted failure: " j))
        (assert (and (= d.st "blocked") (stringContains? j2 "tierHop free->paid") (stringContains? j2 "tierHop paid->strong")) (str "a dead route still climbs and ends blocked: " d.st " " j2))
        (assert (or (stringContains? j "(:gradeSkipped :unit \"P\"") (stringContains? j "(:gradeLanded :unit \"P\"")) (str "a review pass journals its grade outcome before the merge: " j))
        (assert (= nProv2 7) (str "with maxInRow 1 each rung requeues once per failure (3+2+2): " (stringFromInt64 nProv2)))
        (assert (and none0 (not some1)) "no commit past base is no progress, a commit is progress")
        (assert (and hitNone (not hitSome)) "a provider-class failure with a commit past base is an ordinary failure, without one it is requeued")
        (assert (and (listEmpty? (cd/pfErrors row)) (listEmpty? (cd/pfErrors ""))) "a valid row and no row pass the config check")
        (assert (>= (listLength (cd/pfErrors "(:providerFail :backoffS 0 :bogus 1 :maxInRow 500 :patterns ())")) 4) "unknown key, backoff 0, maxInRow 500 and empty patterns are rejected")
        (assert (and (= (cd/pfBackoffS "") 60) (= (cd/pfMaxInRow "") 6) (cd/providerFailSig? "gateway ERR_VENDOR glm" (cd/pfPatterns ""))) "the documented defaults apply with no row")
        true))

; (:m :ref ROTATE :do "a (:writeProfiles :tier T :profiles (..) :weights (..)) lanes row picks a profile per unit id by weight, the same id always the same one; without the row the old profile is used")
fn ! testRotateProfiles -> Bool
  (let [(lanes "(:writeProfiles :tier free :profiles (pA pB pC) :weights (3 2 1))\n(:writeProfile :tier paid :profile pX)\n")
        (ids (map (fn [(i Int64)] -> String (str "UNIT" (stringFromInt64 i))) (range 0 600)))
        (picks (map (fn [(id String)] -> String (cd/pickWriteProfile lanes id "free" "base")) ids))
        (picks2 (map (fn [(id String)] -> String (cd/pickWriteProfile lanes id "free" "base")) ids))
        (cnt (fn [(p String)] -> Int64 (listLength (filter (fn [(x String)] -> Bool (= x p)) picks))))
        (a (cnt "pA")) (b (cnt "pB")) (c (cnt "pC"))
        (none1 (cd/pickWriteProfile "" "UNIT1" "free" "base"))
        (other (cd/pickWriteProfile lanes "UNIT1" "strong" "base"))]
    (do (assert (= (+ a (+ b c)) 600) (str "every id got a listed profile: " (stringFromInt64 a) " " (stringFromInt64 b) " " (stringFromInt64 c)))
        (assert (and (> a 250) (< a 350)) (str "pA near half: " (stringFromInt64 a)))
        (assert (and (> b 160) (< b 240)) (str "pB near a third: " (stringFromInt64 b)))
        (assert (and (> c 60) (< c 140)) (str "pC near a sixth: " (stringFromInt64 c)))
        (assert (= picks picks2) "the same id always gets the same profile")
        (assert (= none1 "base") "no row keeps the old profile")
        (assert (= other "base") "a row of another tier keeps the old profile")
        true))

; (:m :ref SCHED :do "with no sched.asn the light pool is the jobserver token count as before; a sched.asn without a state file starts at its :start")
fn ! testNoSchedFile -> Bool
  (let [(home (scratch "nosched"))
        (_ (cleanup home))
        (dir (str home "/store"))
        (_ (dirCreate home))
        (_ (dirCreate dir))
        (tokens ((cd/realPace).tokens))
        (plain ((cd/schedPace dir home).tokens))
        (_ (dirCreate (str home "/.asl")))
        (_ (dirCreate (str home "/.asl/conductor")))
        (_ (fileWrite (str home "/.asl/conductor/sched.asn") "(:sched :min 2 :max 9 :step 1 :start 7)\n"))
        (started (cd/lightSlotsAt! dir home 8000 0.5 8))
        (pressDir (str home "/store2"))
        (_ (dirCreate pressDir))
        (pressed (cd/lightSlotsAt! pressDir home 8000 40.0 8))
        (_ (cleanup home))]
    (do (assert (= plain tokens) (str "no sched.asn: admission equals the token count: " (stringFromInt64 plain) " " (stringFromInt64 tokens)))
        (assert (= started 7) (str "sched.asn without ledger and state starts at :start: " (stringFromInt64 started)))
        (assert (= pressed 6) (str "load above 1.5 x cores steps the first sample down by one: " (stringFromInt64 pressed)))
        true))

fn inStage c: cd/CUnit -> cd/CUnit
  (with c :st "writing" :await "")

fn cuBlocked id: String lane: String -> cd/CUnit
  (cd/CUnit :id id :st "blocked" :lane lane :fails 3 :sig "boom" :waited 31 :parked 0 :epoch 0 :branch "" :wt "" :model "" :tokens 5 :costMicro 7 :esc 1 :launched 0 :await "lead")

; (:m :ref COND-REQUEUE :do "requeue rows put a blocked unit back to queued with a clean count and its store lane, journal one requeue move, ignore a unit in any other state or unknown id, and the request file is consumed once")
fn ! testRequeue -> Bool
  (let [(dir (scratch "requeue"))
        (_ (cleanup dir))
        (units (list (task "RA" (list "p/ra") (list) (greenGate) "free") (task "RB" (list "p/rb") (list) (greenGate) "free")))
        (put (putAll! dir units))
        (_ (cd/writeCUnit! dir (cuBlocked "RA" "lead")))
        (_ (cd/writeCUnit! dir (inStage (cuBlocked "RB" "free"))))
        (ctx (ctxOf dir "none" 0 0 400))
        (asked (cd/requestRequeue! dir (list "RA" "RB" "NOPE")))
        (had (fileExists? (cd/requeuePath dir)))
        (n1 (cd/requeueDrain! ctx units))
        (n2 (cd/requeueDrain! ctx units))
        (a (cuOf dir "RA"))
        (b (cuOf dir "RB"))
        (jr (stringJoin (journalLines dir) "\n"))
        (_ (cleanup dir))]
    (do (assert (and put asked had) "units put and the request file written")
        (assert (= n1 1) (str "only the blocked unit is requeued: " (stringFromInt64 n1)))
        (assert (= n2 0) "the request file is consumed: a second drain requeues nothing")
        (assert (and (= a.st "queued") (= a.fails 0) (= a.esc 0) (= a.waited 0) (= a.lane "free") (stringEmpty? a.await) (stringEmpty? a.sig))
                (str "RA clean and back on its store lane: " a.st " " (stringFromInt64 a.fails) " " a.lane " " a.await))
        (assert (and (= a.tokens 5) (= a.costMicro 7)) "spend is kept")
        (assert (and (= b.st "writing") (= b.fails 3)) (str "a unit in a stage is left alone: " b.st))
        (assert (stringContains? jr "(:t :unit \"RA\" :from blocked :to queued :stage requeue ") (str "one requeue move is journalled: " jr))
        true))

fn quiet c: cd/CUnit st: String -> cd/CUnit
  (with c :st st :sig "" :fails 0 :await "")

; (:m :ref COND-DEP-WAKE :do "a dependent blocked only by deps not merged stays blocked while its root is blocked, wakes to queued once the root is merged or requeued, and a blocked unit with a failure signature is never woken")
fn ! testDepWake -> Bool
  (let [(dir (scratch "depwake"))
        (_ (cleanup dir))
        (units (list (task "DR" (list "p/dr") (list) (greenGate) "free") (task "DD" (list "p/dd") (list "DR") (greenGate) "free") (task "DS" (list "p/ds") (list "DR") (greenGate) "free")))
        (put (putAll! dir units))
        (_ (cd/writeCUnit! dir (cuBlocked "DR" "free")))
        (_ (cd/writeCUnit! dir (quiet (cuBlocked "DD" "free") "blocked")))
        (_ (cd/writeCUnit! dir (cuBlocked "DS" "free")))
        (ctx (ctxOf dir "none" 0 0 30))
        (n1 (cd/depWake! ctx units))
        (d1 (cuOf dir "DD"))
        (_ (cd/writeCUnit! dir (quiet (cuBlocked "DR" "free") "merged")))
        (n2 (cd/depWake! ctx units))
        (d2 (cuOf dir "DD"))
        (s2 (cuOf dir "DS"))
        (_ (cleanup dir))]
    (do (assert put "units put")
        (assert (and (= n1 0) (= d1.st "blocked")) (str "root blocked: dependent stays blocked: " d1.st))
        (assert (and (= n2 1) (= d2.st "queued") (= d2.esc 0) (= d2.waited 0)) (str "root merged: dependent queued clean: " d2.st " " (stringFromInt64 n2)))
        (assert (= s2.st "blocked") (str "a unit with its own failure signature stays blocked: " s2.st))
        true))

; (:m :ref COND-ADMIT-TOKENS :do "writer admission fixtures: a fake jobserver dir (config.asn :tokens N, tokens/tokK with a live :ownerPid) and a fake meminfo, wired by the store's (:writers ...) row")
fn ! admitStore name: String tokens: Int64 held: Int64 memKb: Int64 warm: Bool -> String
  (let [(dir (scratch name))
        (_ (cleanup dir))
        (js (str dir "/js"))
        (_ (dirCreate (str js "/tokens")))
        (_ (fileWrite (str js "/config.asn") (str "(:cfg :tokens " (stringFromInt64 tokens) ")\n")))
        (_ (map (fn [(i Int64)] -> Bool (ok? (fileWrite (str js "/tokens/tok" (stringFromInt64 i)) (str "(:tok :ownerPid " (stringFromInt64 (procSelf)) " :cls writer)\n")))) (range 0 held)))
        (_ (fileWrite (str dir "/mi") (str "MemTotal: 16000000 kB\nMemAvailable: " (stringFromInt64 memKb) " kB\n")))
        (_ (fileWrite (str dir "/ladder.asn") (str "(:writers :minFreeMb 2000 :warmFirst " (if warm "true" "false") " :jobserver \"" js "\" :meminfo \"" dir "/mi\")\n")))]
    dir)

fn ! admitCtx dir: String -> cd/Ctx
  (ctxOf dir "none" 4 4 400)

; (:m :ref COND-ADMIT-TOKENS :do "the gate: free token and memory floor decide, no row means no gate, a bad row means no gate")
fn ! testAdmitGate -> Bool
  (let [(ok1 (admitStore "adm1" 2 0 8000000 false))
        (noTok (admitStore "adm2" 2 2 8000000 false))
        (lowMem (admitStore "adm3" 2 0 1000000 false))
        (noRow (admitStore "adm4" 2 2 100 false))
        (_ (pathRemove (str noRow "/ladder.asn")))
        (badRow (admitStore "adm5" 2 2 100 false))
        (_ (fileWrite (str badRow "/ladder.asn") "(:writers :minFreeMb 2000 :bogus 1)\n"))
        (a (cd/writerHeld? (admitCtx ok1) (list) "X"))
        (b (cd/writerHeld? (admitCtx noTok) (list) "X"))
        (c (cd/writerHeld? (admitCtx lowMem) (list) "X"))
        (d (cd/writerHeld? (admitCtx noRow) (list) "X"))
        (e (cd/writerHeld? (admitCtx badRow) (list) "X"))
        (_ (map cleanup (list ok1 noTok lowMem noRow badRow)))]
    (do (assert (not a) "a free token and memory above the floor: the writer starts")
        (assert b "every token held: the writer waits")
        (assert c "MemAvailable 1000 MB under the 2000 MB floor: the writer waits")
        (assert (not d) "no (:writers) row: no gate")
        (assert (not e) "a row with an unknown key is ignored whole: no gate")
        (assert (cd/admitWriter? 1 2000 2000) "pure: floor is inclusive")
        (assert (not (cd/admitWriter? 1 1999 2000)) "pure: one MB under the floor waits")
        (assert (cd/admitWriter? 1 -1 2000) "pure: unreadable meminfo does not block")
        (assert (not (cd/admitWriter? 0 99999 2000)) "pure: no token waits")
        true))

; (:m :ref COND-ADMIT-TOKENS :do "warm first: the first writer after a start goes alone, the next wait until that writer's journal shows a served turn, then they go and the row says :done")
fn ! testAdmitWarm -> Bool
  (let [(dir (admitStore "admw" 4 0 8000000 true))
        (_ (dirCreate (str dir "/repo")))
        (_ (fileWrite (str dir "/repo.path") (str dir "/repo\n")))
        (ctx (admitCtx dir))
        (cus (list (inStage (cuBlocked "WA" "free"))))
        (firstW (cd/writerHeld? ctx (list) "WA"))
        (secondW (cd/writerHeld? ctx cus "WB"))
        (jd (str dir "/worktrees/asex-WA/.asl/run/agentLoop"))
        (_ (dirCreate jd))
        (still (cd/writerHeld? ctx cus "WB"))
        (_ (fileWrite (str jd "/s.journal") "(:session :id \"s\")\n(:served :turn 1 :model \"m\")\n"))
        (after (cd/writerHeld? ctx cus "WB"))
        (row (readOr dir "warm.asn"))
        (third (cd/writerHeld? ctx cus "WC"))
        (_ (cleanup dir))]
    (do (assert (not firstW) "the first writer after a start is admitted")
        (assert secondW "a second writer waits while the first has no served turn")
        (assert still "still waiting with an empty journal dir")
        (assert (not after) "after the first served turn the next writer starts")
        (assert (and (stringContains? row ":unit \"WA\"") (stringContains? row ":done ")) (str "warm row names the first writer and :done: " row))
        (assert (not third) "and the rest start")
        true))

; (:m :ref COND-ADMIT-TOKENS :do "through the tick: with every token held a ready unit stays ready and journals no claim; freeing a token starts it")
fn ! testAdmitTick bin: String -> Bool
  (let [(dir (admitStore "admt" 1 1 8000000 false))
        (put (putAll! dir (list (task "AW" (list "p/aw") (list) (greenGate) "leon"))))
        (ctx (admitCtx dir))
        (_ (cd/drain! ctx 8))
        (held (cuOf dir "AW"))
        (claimsHeld (listLength (filter (fn [(l String)] -> Bool (stringContains? l " :stage claim ")) (journalLines dir))))
        (_ (pathRemove (str dir "/js/tokens/tok0")))
        (_ (cd/drain! ctx 400))
        (claimsFreed (listLength (filter (fn [(l String)] -> Bool (stringContains? l " :stage claim ")) (journalLines dir))))
        (_ (cd/stopAll! ctx))
        (_ (cleanup dir))]
    (do (assert put "unit put")
        (assert (= held.st "ready") (str "every token held: the unit waits in ready: " held.st))
        (assert (= claimsHeld 0) "and no claim was journalled")
        (assert (> claimsFreed 0) "token freed: the unit is claimed and starts writing")
        true))

fn ! runTests -> Bool
  (let [(bin (fixtureBinary!))]
    (do (assert (not (stringEmpty? bin)) "the fixture stage binary is prepared")
        (assert (testNoSchedFile) "the light pool equals the token count without sched.asn")
        (assert (testRotateProfiles) "writer profiles rotate per unit by weight")
        (assert (testDag bin) "dag order")
        (assert (testOwnsSerialised bin) "overlapping owns serialised")
        (assert (testServed) "the served alias is journalled")
        (assert (testLedgerForge bin) "a writer cannot forge a pass row")
        (assert (testGradeLand bin) "a review pass lands its grade row on the unit branch")
        (assert (testWipPaths bin) "every writer-ending path rescues the tree")
        (assert (testStaleDirtyWake bin) "a dirty stale unit wakes after its wip rescue")
        (assert (testGateTimeoutRequeue bin) "a gate timeout requeues without a fail count")
        (assert (testFreeWake bin) "parked units wake through a free-slot row and blocks carry a signature")
        (assert (testStallDedupe bin) "the retry after a stall avoids the stalled profile")
        (assert (testGradeSeed bin) "legacy grade commits are seeded once")
        (assert (testWipOutside bin) "untracked files outside :owns stay out of the wip commit")
        (assert (testWipRescue bin) "a stopped writer's edits become one wip commit")
        (assert (testAdmission bin) "admission = min(ready, capacity, allowance)")
        (assert (testDepStalled) "dependency waits count only when stalled")
        (assert (testDepChain bin) "a dependency chain behind a live unit waits without blocking")
        (assert (testGateEscalates bin) "3 same-signature gate failures escalate")
        (assert (testWriteTierHop bin) "write failures hop free to paid to strong to lead")
        (assert (testEscLadder bin) "the escalation ladder walks free paid strong lead and skips a capped rung")
        (assert (testLeadOffline bin) "no fresh lead heartbeat: the ladder blocks at strong, no lead hop")
        (assert (testBacklogCap) "the lead backlog is capped per pass, oldest first, never twice")
        (assert (testProviderFail bin) "provider-class write failures requeue after a backoff without a fail count or hop")
        (assert (testSignatureReset bin) "a new signature resets the count")
        (assert (testWake bin) "wake moves a parked unit")
        (assert (testRequeue) "requeue puts a blocked unit back to queued once")
        (assert (testDepWake) "a dependent blocked on deps wakes when its root leaves blocked")
        (assert (testAdmitGate) "writer admission: token and memory floor")
        (assert (testAdmitWarm) "writer admission: warm first")
        (assert (testAdmitTick bin) "writer admission through the tick")
        (assert (testWriterClaimIgnored bin) "writer's green claim is not trusted")
        (assert (testWaitEscalates bin) "waiting past maxWait escalates")
        (assert (testVacuousBlocks bin) "a vacuous-gate write blocks at once")
        (assert (testStaleBlocks bin) "a stale write blocks awaiting a rebase, not as a failure")
        (assert (testStaleWake bin) "a stale-blocked unit wakes once when the deployed main moves")
        (assert (testStaleWakeMax bin) "staleWakeMax from the store config sets the failed wakes before a unit parks")
        (assert (testAttractorArm) "attractor A/B arm by id parity, off by default")
        (assert (testParallel bin) "stages overlap")
        (assert (testCapacity bin) "capacity counts units in flight")
        (assert (testKilledChild bin) "killed child is a failed stage")
        (assert (testStageTimeout bin) "stage deadline kills and fails")
        (assert (testResume bin) "restart resumes from rows")
        (assert (testUnpriced bin) "an unpriced stage journals :priced false")
        (assert (testOfferStrong bin) "the queue offers a blocked unit to the strong lane")
        (assert (testIntake bin) "the service cycle imports the ledger and queues need rows for parked ones")
        (assert (testMergeRetry bin) "a merge failure retries the merge with its reason journalled")
        (assert (testTrainSig) "a merge signature names the train's own cause")
        (assert (testMergeSerial bin) "merge stages run one at a time and both reviewed units merge")
        (assert (testMergeVerdictOnce bin) "a merge verdict is escaped once in the journal")
        true))
