(module asl/tools/fleet/tests/mergeUnitTest
  :x [runTests]
  :i [(asl-tools/fleet/run :a fr) (asl-tools/fleet/mergeUnit :a mu) (asl-tools/vcs/git :a vg) (aslAgent/tests/gitInitKit :a gk)])

; (:m :ref BASH-EXIT-MERGE :do "mergeUnit on a temp repo built through gitInitKit and the vcs module: a green gate merges, a gate red in the worktree and on main is BASE-RED and merges, a gate red in the worktree and green on main is NEW-RED and blocks, a main that moved before the merge is rebased onto and the merge lands on the retry, a failing audit blocks, and waitPid! returns only once the pid is gone; nothing touches the real main or ~/.asl (lock and logs live in the temp dir)")

fn ! write path: String text: String -> Bool
  (ok? (fileWrite path text))

fn ! commitIn! dir: String file: String text: String -> Bool
  (let [(w (write (str dir "/" file) text))
        (tx (vg/prepare! dir (list file)))]
    (and w (and tx.ok (= (vg/finish! dir tx (str "add " file) (list file)).exit 0))))

fn ! addUnit! main: String wtRoot: String briefs: String unit: String file: String gates: String -> Bool
  (let [(wt (str wtRoot "/asex-" unit))
        (a (vg/worktreeAdd! main wt "HEAD"))
        (s (vg/switch! wt (str "fix/" unit) "main"))
        (c (commitIn! wt file (str unit "\n")))
        (b (write (str briefs "/" unit "-leon.asn") (str "(:brief :task \"t\" :owns (\"" file "\") :gates (" gates "))\n")))]
    (and (= a.exit 0) (and (= s.exit 0) (and c b))))

fn ! logOf path: String -> String
  (resultOr (fileReadString path) "")

fn has? text: String event: String -> Bool
  (stringContains? text (str ":event :" event))

fn ! runTests -> Bool
  (and (runCoreTests) (and (runSpeedTests) (and (runLowsTests) (runFanoutTests))))

fn ! runCoreTests -> Bool
  (let [(tmp (str (optionOr (envGet "TMPDIR") "/tmp") "/mergeUnitTest" (stringFromInt64 (nowNs))))
        (main (str tmp "/main"))
        (wtRoot (str tmp "/wt"))
        (briefs (str tmp "/briefs"))
        (dirs (and (ok? (dirCreate main)) (and (ok? (dirCreate wtRoot)) (ok? (dirCreate briefs)))))
        (base (write (str main "/base.txt") "base\n"))
        (cfgFile (write (str main "/.asl.config.asn") "(:aslConfig)\n"))
        (init (gk/initGitRepoWith! main "mergeUnitTest" "merge-unit@example.invalid" (list "base.txt" ".asl.config.asn")))
        (ua (addUnit! main wtRoot briefs "a" "a.txt" "\"test -f a.txt\""))
        (ub (addUnit! main wtRoot briefs "b" "b.txt" "\"test -f nothere.txt\" \"test -f b.txt\""))
        (uc (addUnit! main wtRoot briefs "c" "c.txt" "\"test ! -f c.txt\""))
        (ud (addUnit! main wtRoot briefs "d" "d.txt" "\"test -f d.txt\""))
        (ue (addUnit! main wtRoot briefs "e" "e.txt" "\"test -f e.txt\""))
        (uf (addUnit! main wtRoot briefs "f" "f.txt" "\"test -f f.txt\""))
        (ug (addUnit! main wtRoot briefs "g" "g.txt" "\"test -f g.txt\""))
        (ugSrc (and (ok? (dirCreate (str wtRoot "/asex-g/pkg/src"))) (ok? (dirCreate (str wtRoot "/asex-g/pkg/tests")))))
        (ugFiles (and ugSrc (and (commitIn! (str wtRoot "/asex-g") "pkg/src/mod.asl" "(module pkg/mod\n  :x [f])\n")
                           (and (commitIn! (str wtRoot "/asex-g") "pkg/tests/modTest.asl" "(module pkg/tests/modTest\n  :x [runTests]\n  :i [(pkg/mod :a m)])\nfn runTests -> Bool\n  true\n")
                                (commitIn! (str wtRoot "/asex-g") "pkg/tests/otherTest.asl" "(module pkg/tests/otherTest\n  :x [runTests])\nfn runTests -> Bool\n  true\n")))))
        (uh (addUnit! main wtRoot briefs "h" "h.txt" "\"p=$(ps -o nice= -p $PPID); n=$(ps -o nice= -p $$); test $n -gt $p || test $n -ge 20\""))
        (ui (addUnit! main wtRoot briefs "i" "i.txt" "\"test -f i.txt\""))
        (uj (addUnit! main wtRoot briefs "j" "j.txt" "\"test -f j.txt\""))
        (baseDirs (and (ok? (dirCreate (str main "/pkg/src"))) (and (ok? (dirCreate (str main "/asl/packages/asl-gates/tests"))) (ok? (dirCreate (str main "/asl/doc"))))))
        (baseFiles (and baseDirs (and (commitIn! main "pkg/src/h.asl" "(module pkg/h\n  :x [f])\nfn f -> Bool\n  true\n")
                                (and (commitIn! main "pkg/src/d.asl" "(module pkg/d\n  :x [f])\nfn f -> Bool\n  true\n")
                                (and (commitIn! main "pkg/src/b.asl" "(module pkg/b\n  :x [f])\nfn f -> Bool\n  true\n")
                                     (commitIn! main "asl/packages/asl-gates/tests/docLedgerTest.asl" "(module asl-gates/tests/docLedgerTest\n  :x [runTests])\nfn runTests -> Bool\n  true\n"))))))
        (k1 (addUnit! main wtRoot briefs "k1" "k1.txt" "\"test -f k1.txt\""))
        (k1c (commitIn! (str wtRoot "/asex-k1") "pkg/src/h.asl" "(module pkg/h\n  :x [f g])\nfn f -> Bool\n  true\n"))
        (k2 (addUnit! main wtRoot briefs "k2" "k2.txt" "\"test -f k2.txt\""))
        (k2d (ok? (dirCreate (str wtRoot "/asex-k2/pkg/src"))))
        (k2c (commitIn! (str wtRoot "/asex-k2") "pkg/src/n.asl" "(module pkg/n\n  :x [g])\nfn g -> Bool\n  true\n"))
        (k3 (addUnit! main wtRoot briefs "k3" "k3.txt" "\"test -f k3.txt\""))
        (k3d (ok? (dirCreate (str wtRoot "/asex-k3/pkg/tests"))))
        (k3c (commitIn! (str wtRoot "/asex-k3") "pkg/tests/nTest.asl" "(module pkg/tests/nTest\n  :x [runTests])\nfn runTests -> Bool\n  true\n"))
        (k4 (addUnit! main wtRoot briefs "k4" "k4.txt" "\"test -f k4.txt\""))
        (k4d (ok? (dirCreate (str wtRoot "/asex-k4/asl/doc"))))
        (k4c (commitIn! (str wtRoot "/asex-k4") "asl/doc/x.asn" "(:doc :symbol \"a\" :text \"b\")\n"))
        (k5 (addUnit! main wtRoot briefs "k5" "k5.txt" "\"test -f k5.txt\""))
        (k5c (commitIn! (str wtRoot "/asex-k5") "pkg/src/b.asl" "(module pkg/b\n  :x [f])\nfn f -> Bool\n  false\n"))
        (k7 (addUnit! main wtRoot briefs "k7" "k7.txt" "\"test -f k7.txt\""))
        (k7r (ok? (pathRemove (str wtRoot "/asex-k7/pkg/src/d.asl"))))
        (k7tx (vg/prepare! (str wtRoot "/asex-k7") (list "pkg/src/d.asl")))
        (k7c (and k7tx.ok (= (vg/finish! (str wtRoot "/asex-k7") k7tx "delete d" (list "pkg/src/d.asl")).exit 0)))
        (k8 (addUnit! main wtRoot briefs "k8" "k8.txt" "\"test -f k8.txt\""))
        (k9 (addUnit! main wtRoot briefs "k9" "k9.txt" "\"test -f k9.txt\" \"test  -f k9.txt\""))
        (k10 (addUnit! main wtRoot briefs "k10" "k10.txt" "\"test -f k10.txt\""))
        (k11 (addUnit! main wtRoot briefs "k11" "k11.txt" "\"test -f k11.txt\""))
        (k12 (addUnit! main wtRoot briefs "k12" "k12.txt" "\"test -f k12.txt\""))
        (k6 (addUnit! main wtRoot briefs "k6" "k6.txt" "\"test -f k6.txt\""))
        (cfg (with (mu/defaultCfg) :main main :worktrees wtRoot :briefDir briefs :lock (str tmp "/mainbuild.lock") :audit "none" :gateSecs 60 :testCmd "test -f" :lockWaitS 60 :graphDir (str tmp "/graphs") :checkCmd "true"))
        (logA (str tmp "/a.log"))
        (okA (mu/mergeUnit! (with cfg :log logA) "a"))
        (la (logOf logA))
        (logB (str tmp "/b.log"))
        (okB (mu/mergeUnit! (with cfg :log logB) "b"))
        (lb (logOf logB))
        (logC (str tmp "/c.log"))
        (okC (mu/mergeUnit! (with cfg :log logC) "c"))
        (lc (logOf logC))
        (logD (str tmp "/d.log"))
        (okD (mu/mergeUnitWith! (with cfg :log logD) "d" (fn [] (commitIn! main "moved.txt" "moved\n"))))
        (ld (logOf logD))
        (logE (str tmp "/e.log"))
        (okE (mu/mergeUnit! (with (with cfg :log logE) :audit "echo audit consistency: failed") "e"))
        (le (logOf logE))
        (movedF (commitIn! main "moved2.txt" "moved\n"))
        (dirtyF (write (str wtRoot "/asex-f/.asl.config.asn") "(:aslConfig :dirty true)\n"))
        (logF (str tmp "/f.log"))
        (okF (mu/mergeUnit! (with cfg :log logF) "f"))
        (lf (logOf logF))
        (logG (str tmp "/g.log"))
        (okG (mu/mergeUnit! (with cfg :log logG :graphSelect false) "g"))
        (lg (logOf logG))
        (logH (str tmp "/h.log"))
        (okH (mu/mergeUnit! (with cfg :log logH) "h"))
        (lh (logOf logH))
        (lockMade (ok? (dirCreate (str tmp "/mainbuild.lock"))))
        (aged (ok? (fileUtime (str tmp "/mainbuild.lock") 946684800000000000)))
        (logI (str tmp "/i.log"))
        (okI (mu/mergeUnit! (with cfg :log logI) "i"))
        (li (logOf logI))
        (freshLock (ok? (dirCreate (str tmp "/mainbuild.lock"))))
        (logJ (str tmp "/j.log"))
        (okJ (mu/mergeUnit! (with cfg :log logJ) "j"))
        (lj (logOf logJ))
        (ledgerCmd ":cmd \"test -f asl/packages/asl-gates/tests/docLedgerTest.asl\"")
        (logK1 (str tmp "/k1.log"))
        (okK1 (mu/mergeUnit! (with cfg :log logK1) "k1"))
        (lk1 (logOf logK1))
        (logK2 (str tmp "/k2.log"))
        (okK2 (mu/mergeUnit! (with cfg :log logK2) "k2"))
        (lk2 (logOf logK2))
        (logK3 (str tmp "/k3.log"))
        (okK3 (mu/mergeUnit! (with cfg :log logK3) "k3"))
        (lk3 (logOf logK3))
        (logK4 (str tmp "/k4.log"))
        (okK4 (mu/mergeUnit! (with cfg :log logK4) "k4"))
        (lk4 (logOf logK4))
        (logK5 (str tmp "/k5.log"))
        (okK5 (mu/mergeUnit! (with cfg :log logK5) "k5"))
        (lk5 (logOf logK5))
        (logK7 (str tmp "/k7.log"))
        (okK7 (mu/mergeUnit! (with cfg :log logK7) "k7"))
        (lk7 (logOf logK7))
        (logK6 (str tmp "/k6.log"))
        (cliK6 (fr/runOneLimited (fr/job (list "./bin/asl" "run" "asl/tools/fleet/mergeUnit.asl" "--graph-dir" (str tmp "/graphs") "--main" main "--worktrees" wtRoot "--brief-dir" briefs "--audit" "none" "--lock" (str tmp "/cli.lock") "--lock-wait" "30" "--log" logK6 "--gate-secs" "60" "k6") "." (fr/childEnv (list))) (fr/limits 600 64)))
        (lk6 (logOf logK6))
        (mergedIn (fn [(t String)] -> Int64 (listLength (filter (fn [(l String)] -> Bool (stringContains? l ":event :MERGED")) (stringLines t)))))
        (rulesDir (ok? (dirCreate (str main "/asl/grammar"))))
        (rulesFile (write (str main "/asl/grammar/rules.asn") "(:rules :v 1\n  (:rule :id a :force :invariant :enforcedBy \"test ! -f k8.txt\" :basis (x))\n  (:rule :id b :force :invariant :enforcedBy \"test -f k9.txt\" :basis (x))\n  (:rule :id c :force :invariant :enforcedBy \"test -f skipme.txt\" :basis (x))\n  (:rule :id d :force :orientation :enforcedBy :none :basis (x))\n  (:rule :id e :force :invariant :enforcedBy \"test -f cheap30.txt\" :basis (x))\n  (:rule :id f :force :invariant :enforcedBy \"test -f slow1200.txt\" :basis (x))\n  (:rule :id g :force :invariant :enforcedBy \"test -f newslow.txt\" :basis (x))\n  (:rule :id h :force :invariant :enforcedBy \"test -f \\\"q.txt\\\"\" :basis (x)))\n"))
        (invCfg (with cfg :invariantCosts (list "test ! -f k8.txt=1" "test -f k9.txt=1" "test -f skipme.txt=9999" "test -f cheap30.txt=30" "test -f slow1200.txt=1200" "test -f \"q.txt\"=1") :invariantCapS 120))
        (logK8 (str tmp "/k8.log"))
        (okK8 (mu/mergeUnit! (with invCfg :log logK8) "k8"))
        (lk8 (logOf logK8))
        (logK9 (str tmp "/k9.log"))
        (okK9 (mu/mergeUnit! (with invCfg :log logK9) "k9"))
        (lk9 (logOf logK9))
        (statusBefore (vg/changes! main (list)).out)
        (logK10 (str tmp "/k10.log"))
        (okK10 (mu/mergeUnit! (with invCfg :log logK10) "k10"))
        (lk10 (logOf logK10))
        (statusAfter (vg/changes! main (list)).out)
        (logK11 (str tmp "/k11.log"))
        (okK11 (mu/mergeUnit! (with (with invCfg :invariantCapS 10) :log logK11) "k11"))
        (lk11 (logOf logK11))
        (logK12 (str tmp "/k12.log"))
        (okK12 (mu/mergeUnit! (with (with invCfg :invariantCapS 40) :log logK12) "k12"))
        (lk12 (logOf logK12))
        (um (addUnit! main wtRoot briefs "m" "m.txt" "\"test -f m.txt\""))
        (movedM (commitIn! main "movedM.txt" "moved\n"))
        (logM (str tmp "/m.log"))
        (okM (mu/mergeUnit! (with cfg :log logM :branch "fix/m") "m"))
        (lm (logOf logM))
        (un (addUnit! main wtRoot briefs "n" "n.txt" "\"test -f n.txt\""))
        (logN (str tmp "/n.log"))
        (okN (mu/mergeUnitWith! (with cfg :log logN :branch "fix/n") "n" (fn [] (commitIn! main "movedN.txt" "moved\n"))))
        (ln (logOf logN))
        (pidOut (fr/runOneLimited (fr/job (list "sh" "-c" "sleep 1 >/dev/null 2>&1 & echo $!") "." (fr/childEnv (list))) (fr/limits 20 8)))
        (pid (optionOr (stringToInt64 (stringTrim pidOut.out)) 0))
        (aliveBefore (resultOr (procAlive? pid) false))
        (gone (mu/waitPid! pid 30))
        (aliveAfter (resultOr (procAlive? pid) false))
        (cleaned (ok? (pathRemove tmp)))]
    (do
      (assert (and dirs (and base init)) "the temp main repo is built through gitInitKit")
      (assert (and ua (and ub (and uc (and ud ue)))) "the unit worktrees and briefs are built through the vcs module")
      (assert (and okA (has? la "MERGED") (has? la "GATE") (not (has? la "BASE-RED"))) "a green gate merges")
      (assert (and okB (has? lb "BASE-RED") (has? lb "MERGED") (not (has? lb "NEW-RED"))) "a gate red on main too is BASE-RED and does not block the merge")
      (assert (and (not okC) (has? lc "NEW-RED") (has? lc "GATE-FAIL") (not (has? lc "MERGED"))) "a gate red in the worktree and green on main is NEW-RED and blocks")
      (assert (and okD (has? ld "REBASED-ONTO-MOVED-MAIN") (has? ld "MERGED")) "a main that moved before the merge is rebased onto and the merge lands on the retry")
      (assert (and (not okE) (has? le "AUDIT-FAIL") (not (has? le "MERGED"))) "a failing audit blocks the merge")
      (assert (and aliveBefore gone (not aliveAfter)) "waitPid! returns once the pid is gone")
      (assert (and uf ug ugFiles uh ui uj) "the extra unit worktrees are built")
      (assert (and okF (has? lf "MERGED") (not (has? lf "REBASE-CONFLICT"))) "a dirty tracked .asl.config.asn does not turn the rebase into a false conflict")
      (assert (and okG (stringContains? lg ":cmd \"test -f pkg/tests/modTest.asl\"") (not (stringContains? lg "otherTest"))) "the neighbour test of a changed src module joins the gates and an unrelated test does not")
      (assert (and okH (has? lh "GATE") (not (has? lh "BASE-RED")) (not (has? lh "NEW-RED"))) "gates run niced")
      (assert (and okI (has? li "MAIN-BUILD-LOCK-EXPIRED") (not (has? li "MAIN-BUILD-SKIPPED"))) "a main build lock older than an hour is expired")
      (assert (and okJ (has? lj "MAIN-BUILD-SKIPPED") (not (has? lj "MAIN-BUILD-LOCK-EXPIRED"))) "a fresh main build lock still skips the rebuild")
      (assert (and baseFiles k1 k1c k2 k2d k2c k3 k3d k3c k4 k4d k4c k5 k5c) (str "the ledger-trigger units are built: " (stringJoin (map (fn [(b Bool)] -> String (if b "1" "0")) (list baseDirs baseFiles k1 k1c k2 k2d k2c k3 k3d k3c k4 k4d k4c k5 k5c)) "")))
      (assert (and okK1 (stringContains? lk1 ledgerCmd)) "a changed module header :x list adds the doc ledger gate")
      (assert (and okK2 (stringContains? lk2 ledgerCmd)) "a new .asl file with exports adds the doc ledger gate")
      (assert (and okK3 (stringContains? lk3 ledgerCmd)) "a new tests/*.asl with runTests adds the doc ledger gate")
      (assert (and okK4 (stringContains? lk4 ledgerCmd)) "a touched asl/doc/*.asn adds the doc ledger gate")
      (assert (and k7 k7r k7c okK7 (stringContains? lk7 ledgerCmd)) "an .asl file deleted with a non-empty :x header adds the doc ledger gate")
      (assert (and k8 k9 rulesDir rulesFile (not okK8) (stringContains? lk8 ":event :NEW-RED :cmd \"test ! -f k8.txt\"") (stringContains? lk8 ":event :GATE-FAIL") (not (has? lk8 "MERGED"))) "an invariant gate from the rules file that is red in the worktree and green on main blocks with NEW-RED")
      (assert (and (stringContains? lk8 ":event :SKIPPED-OVERCAP :cmd \"test -f skipme.txt\"") (not (stringContains? lk8 ":event :BASE-RED :cmd \"test -f skipme.txt\""))) "an invariant whose recorded cost exceeds the cap is skipped with an event, not run")
      (assert (and k10 k11 k12 okK10 (stringContains? lk10 ":event :BASE-RED :cmd \"test -f cheap30.txt\"") (stringContains? lk10 ":event :SKIPPED-OVERCAP :cmd \"test -f slow1200.txt\"") (not (stringContains? lk10 ":BASE-RED :cmd \"test -f slow1200.txt\""))) "with cap 120 a 30 s invariant runs and a 1200 s one is skipped")
      (assert (and okK11 (stringContains? lk11 ":event :SKIPPED-OVERCAP :cmd \"test -f cheap30.txt\"") (not (stringContains? lk11 ":BASE-RED :cmd \"test -f cheap30.txt\""))) "with cap 10 the 30 s invariant is skipped too")
      (assert (and okK12 (stringContains? lk12 ":event :BASE-RED :cmd \"test -f cheap30.txt\"") (stringContains? lk12 ":event :SKIPPED-OVERCAP :cmd \"test -f slow1200.txt\"")) "with cap 40 the 30 s invariant runs again")
      (assert (and (stringContains? lk10 ":event :SKIPPED-UNCOSTED :cmd \"test -f newslow.txt\"") (not (stringContains? lk10 ":BASE-RED :cmd \"test -f newslow.txt\""))) "an invariant no cost row names is skipped with SKIPPED-UNCOSTED, never run unasked")
      (assert (stringContains? lk10 ":cmd \"test -f \\\"q.txt\\\"\"") (str "an escaped quote inside :enforcedBy is read as a quote: " lk10))
      (assert (= statusBefore statusAfter) (str "running BASE-RED invariants leaves the main repo status unchanged: [" statusBefore "] vs [" statusAfter "]"))
      (assert (and okK9 (= (listLength (filter (fn [(l String)] -> Bool (and (stringContains? l ":event :GATE") (stringContains? l "k9.txt"))) (stringLines lk9))) 1)) (str "an invariant the brief already names runs once: " lk9))
      (assert (and okK5 (has? lk5 "MERGED") (not (stringContains? lk5 "docLedgerTest"))) "a body-only change does not add the doc ledger gate")
      (assert (and k6 (and (= cliK6.exit 0) (and (= (mergedIn cliK6.out) 1) (= (mergedIn lk6) 1)))) (str "the CLI prints exactly one MERGED line to stdout and the log holds exactly one: exit " cliK6.exit " stdout " (mergedIn cliK6.out) " log " (mergedIn lk6)))
      (assert (and um movedM (not okM) (has? lm "REBASE-FAILED") (stringContains? lm "notOnMain") (not (has? lm "GATE")) (not (has? lm "MERGED"))) (str "a rebase onto the unit's own branch fix/m (unit m) leaves HEAD off the moved main: REBASE-FAILED before any gate: " lm))
      (assert (and un (not okN) (has? ln "GATE") (has? ln "REBASE-FAILED") (not (has? ln "REBASED-ONTO-MOVED-MAIN")) (not (has? ln "FF-FAIL"))) (str "after green gates and a moved main, a no-op rebase is REBASE-FAILED, not REBASED-ONTO-MOVED-MAIN then FF-FAIL: " ln))
      (assert cleaned "the temp tree is removed")
      true))

fn ! addEditUnit! main: String wtRoot: String briefs: String unit: String file: String text: String gates: String -> Bool
  (let [(wt (str wtRoot "/asex-" unit))
        (a (vg/worktreeAdd! main wt "HEAD"))
        (s (vg/switch! wt (str "fix/" unit) "main"))
        (c (commitIn! wt file text))
        (b (write (str briefs "/" unit "-leon.asn") (str "(:brief :task \"t\" :owns (\"" file "\") :gates (" gates "))\n")))]
    (and (= a.exit 0) (and (= s.exit 0) (and c b))))

fn ! tmpRoot -> String
  (str (optionOr (envGet "TMPDIR") "/tmp") "/mergeSpeedTest" (stringFromInt64 (nowNs)))

fn ! cliJob main: String wtRoot: String briefs: String tmp: String log: String unit: String -> fr/Job
  (fr/job (list "./bin/asl" "run" "asl/tools/fleet/mergeUnit.asl" "--graph-dir" (str tmp "/graphs") "--main" main "--worktrees" wtRoot "--brief-dir" briefs "--audit" "none" "--lock" (str tmp "/q.lock") "--log" log "--gate-secs" "120" "--lock-wait" "300" unit) "." (fr/childEnv (list)))

fn lockEvents text: String -> (List String)
  (filter (fn [(l String)] -> Bool (stringContains? l ":event :LOCK-")) (stringLines text))

; (:m :ref (MERGE-NEIGHBOURS-PAR MERGE-QUEUE-LOCK) :do "mergeUnit speed and queueing on a temp repo: two concurrent CLI runs hold the main-merge lock one after the other; a lock whose owner pid is dead is taken over; gates run two at a time (a handshake pair passes only when concurrent) with serial verdicts; the gate order is unknown first then longest by recorded median; selectTrain picks one suite for a body-only change where the import scan picks both")
fn ! runSpeedTests -> Bool
  (let [(tmp (tmpRoot))
        (main (str tmp "/main"))
        (wtRoot (str tmp "/wt"))
        (briefs (str tmp "/briefs"))
        (dirs (and (ok? (dirCreate main)) (and (ok? (dirCreate wtRoot)) (ok? (dirCreate briefs)))))
        (base (write (str main "/base.txt") "base\n"))
        (cfgFile (write (str main "/.asl.config.asn") "(:aslConfig)\n"))
        (init (gk/initGitRepoWith! main "mergeSpeedTest" "merge-unit@example.invalid" (list "base.txt" ".asl.config.asn")))
        (srcDirs (and (ok? (dirCreate (str main "/pkg/src"))) (ok? (dirCreate (str main "/pkg/tests")))))
        (modText "(module pkg/mod\n  :x [f g])\nfn f -> Bool\n  true\nfn g -> Bool\n  true\n")
        (suites (and srcDirs (and (commitIn! main "pkg/src/mod.asl" modText)
                             (and (commitIn! main "pkg/tests/fTest.asl" "(module pkg/tests/fTest\n  :x [runTests]\n  :i [(pkg/mod :a m)])\nfn runTests -> Bool\n  (m/f)\n")
                                  (commitIn! main "pkg/tests/gTest.asl" "(module pkg/tests/gTest\n  :x [runTests]\n  :i [(pkg/mod :a m)])\nfn runTests -> Bool\n  (m/g)\n")))))
        (graphCopy (and (ok? (dirCreate (str main "/tools/fleet"))) (write (str main "/tools/fleet/graph.asl") (resultOr (fileReadString "tools/fleet/graph.asl") ""))))
        (cfg (with (mu/defaultCfg) :main main :worktrees wtRoot :briefDir briefs :lock (str tmp "/mainbuild.lock") :audit "none" :gateSecs 60 :testCmd "test -f" :lockWaitS 60 :graphDir (str tmp "/graphs") :checkCmd "true" :aslBin (str (resultOr (realPath ".") ".") "/bin/asl")))
        (s1 (addEditUnit! main wtRoot briefs "s1" "pkg/src/mod.asl" "(module pkg/mod\n  :x [f g])\nfn f -> Bool\n  true\nfn g -> Bool\n  (not false)\n" "\"test -f base.txt\""))
        (s1c true)
        (logS1 (str tmp "/s1.log"))
        (okS1 (mu/mergeUnit! (with cfg :log logS1 :graphSelect false) "s1"))
        (lsS1 (logOf logS1))
        (s2 (addEditUnit! main wtRoot briefs "s2" "pkg/src/mod.asl" "(module pkg/mod\n  :x [f g])\nfn f -> Bool\n  true\nfn g -> Bool\n  (not (not true))\n" "\"test -f base.txt\""))
        (s2c true)
        (logS2 (str tmp "/s2.log"))
        (okS2 (mu/mergeUnit! (with cfg :log logS2) "s2"))
        (lsS2 (logOf logS2))
        (hsA "\"touch hsA; i=0; while [ ! -f hsB ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i+1)); done; test -f hsB\"")
        (hsB "\"touch hsB; i=0; while [ ! -f hsA ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i+1)); done; test -f hsA\"")
        (p1 (addUnit! main wtRoot briefs "p1" "p1.txt" (str hsA " " hsB " \"test -f nothere.txt\"")))
        (logP1 (str tmp "/p1.log"))
        (okP1 (mu/mergeUnit! (with cfg :log logP1 :gateSlots 2) "p1"))
        (lsP1 (logOf logP1))
        (p2 (addUnit! main wtRoot briefs "p2" "p2.txt" "\"test -f p2.txt\" \"test ! -f p2.txt\""))
        (logP2 (str tmp "/p2.log"))
        (okP2 (mu/mergeUnit! (with cfg :log logP2 :gateSlots 2) "p2"))
        (lsP2 (logOf logP2))
        (staleLock (str tmp "/stale.lock"))
        (staleDir (mu/lockDirOf (with cfg :lock staleLock)))
        (staleMk (and (ok? (dirCreate staleDir)) (write (str staleDir "/pid") "4000000")))
        (st1 (addUnit! main wtRoot briefs "st1" "st1.txt" "\"test -f st1.txt\""))
        (logSt (str tmp "/st.log"))
        (okSt (mu/mergeUnit! (with cfg :log logSt :lock staleLock :aslBin "/nonexistent/asl") "st1"))
        (lsSt (logOf logSt))
        (staleGone (not (ok? (fileStat staleDir))))
        (q1 (addUnit! main wtRoot briefs "q1" "q1.txt" "\"sleep 2; test -f q1.txt\""))
        (q2 (addUnit! main wtRoot briefs "q2" "q2.txt" "\"sleep 2; test -f q2.txt\""))
        (logQ (str tmp "/q.log"))
        (qs (fr/runPoolLimited (list (cliJob main wtRoot briefs tmp logQ "q1") (cliJob main wtRoot briefs tmp logQ "q2")) 2 (fr/limits 900 64)))
        (lq (logOf logQ))
        (lockSeq (lockEvents lq))
        (kinds (map (fn [(l String)] -> String (cond ((stringContains? l "LOCK-ACQUIRED") "A") ((stringContains? l "LOCK-RELEASED") "R") (else "W"))) lockSeq))
        (liveDir (str tmp "/live.lock.merge"))
        (liveMk (and (ok? (dirCreate liveDir)) (write (str liveDir "/pid") (stringFromInt64 (procSelf)))))
        (tookLive (mu/takeOver! (with cfg :log (str tmp "/tl.log")) "tl" liveDir 4000000))
        (liveStill (and (fileExists? liveDir) (= (mu/ownerOf! liveDir) (procSelf))))
        (relOther (str tmp "/relother.lock.merge"))
        (relOtherMk (and (ok? (dirCreate relOther)) (write (str relOther "/pid") "4000001")))
        (relOtherRes (mu/releaseLock! relOther))
        (relOtherStill (and (fileExists? relOther) (= (mu/ownerOf! relOther) 4000001)))
        (relMine (str tmp "/relmine.lock.merge"))
        (relMineMk (and (ok? (dirCreate relMine)) (write (str relMine "/pid") (stringFromInt64 (procSelf)))))
        (relMineRes (mu/releaseLock! relMine))
        (npLock (str tmp "/np.lock"))
        (npDir (mu/lockDirOf (with cfg :lock npLock)))
        (npMk (ok? (dirCreate npDir)))
        (np1 (addUnit! main wtRoot briefs "np1" "np1.txt" "\"test -f np1.txt\""))
        (logNp (str tmp "/np.log"))
        (okNp (mu/mergeUnit! (with cfg :log logNp :lock npLock :lockWaitS 2) "np1"))
        (lsNp (logOf logNp))
        (npStill (fileExists? npDir))
        (lone (addEditUnit! main wtRoot briefs "lone" "lone.asl" "(module lone)\n" "\"test -f base.txt\""))
        (logLone (str tmp "/lone.log"))
        (okLone (mu/mergeUnit! (with cfg :log logLone) "lone"))
        (lsLone (logOf logLone))
        (tkLock (str tmp "/q.lock"))
        (tkDir (mu/lockDirOf (with cfg :lock tkLock)))
        (tkMk (and (ok? (dirCreate tkDir)) (write (str tkDir "/pid") "4000002")))
        (t1 (addUnit! main wtRoot briefs "t1" "t1.txt" "\"sleep 2; test -f t1.txt\""))
        (t2 (addUnit! main wtRoot briefs "t2" "t2.txt" "\"sleep 2; test -f t2.txt\""))
        (logT (str tmp "/t.log"))
        (ts (fr/runPoolLimited (list (cliJob main wtRoot briefs tmp logT "t1") (cliJob main wtRoot briefs tmp logT "t2")) 2 (fr/limits 900 64)))
        (lt (logOf logT))
        (tKinds (filter (fn [(k String)] -> Bool (!= k "W")) (map (fn [(l String)] -> String (cond ((stringContains? l "LOCK-ACQUIRED") "A") ((stringContains? l "LOCK-RELEASED") "R") (else "W"))) (lockEvents lt))))
        (order (mu/gateOrder cfg (list "test -f fast.asl" "test -f slow.asl" "test -f unknown.asl" "other cmd") (mapSet (mapSet (mapEmpty) "fast.asl" 5) "slow.asl" 900)))
        (cleaned (ok? (pathRemove tmp)))]
    (do
      (assert (and graphCopy (stringContains? lsS1 ":event :NEIGHBOUR-SELECTOR :by \"scan\"") (stringContains? lsS2 ":event :NEIGHBOUR-SELECTOR :by \"graph\"") (stringContains? lsSt ":event :NEIGHBOUR-SELECTOR :by \"scan\"")) (str "the selector that ran is named: scan when graphSelect is off or the subprocess fails, graph otherwise: " lsS2 lsSt))
      (assert (and dirs base init suites s1 s1c s2 s2c) "the speed fixtures are built through gitInitKit and the vcs module")
      (assert (and okS1 (stringContains? lsS1 "pkg/tests/fTest.asl") (stringContains? lsS1 "pkg/tests/gTest.asl")) (str "the import scan picks both suites that import the changed module: " lsS1))
      (assert (and okS2 (stringContains? lsS2 ":cmd \"test -f pkg/tests/gTest.asl\"") (not (stringContains? lsS2 "fTest")) (not (stringContains? lsS2 ":cmd \"test -f pkg/src/mod.asl"))) (str "selectTrain at symbol grain picks only the suite that reaches the changed fn on a body-only change: " lsS2))
      (assert (and p1 okP1 (stringContains? lsP1 ":event :GATE :cmd \"touch hsA") (stringContains? lsP1 ":event :GATE :cmd \"touch hsB") (stringContains? lsP1 ":event :BASE-RED :cmd \"test -f nothere.txt\"") (has? lsP1 "MERGED")) (str "two gates that need each other pass only when run at the same time, and a base-red gate keeps its verdict: " lsP1))
      (assert (and p2 (not okP2) (stringContains? lsP2 ":event :NEW-RED :cmd \"test ! -f p2.txt\"") (stringContains? lsP2 ":event :GATE :cmd \"test -f p2.txt\"") (has? lsP2 "GATE-FAIL") (not (has? lsP2 "MERGED"))) (str "a new-red gate blocks while its green sibling keeps its verdict: " lsP2))
      (assert (= order (list 3 2 1 0)) (str "gates start unknown first, then longest recorded median first: " (stringJoin (map stringFromInt64 order) ",")))
      (assert (and staleMk st1 okSt (stringContains? lsSt ":event :LOCK-TAKEOVER :deadPid 4000000") (has? lsSt "MERGED") staleGone) (str "a lock whose owner pid is dead is taken over and removed after the merge: " lsSt))
      (assert (and q1 q2 (listAll? (fn [(d fr/Done)] -> Bool (= d.exit 0)) qs) (= (filter (fn [(k String)] -> Bool (!= k "W")) kinds) (list "A" "R" "A" "R")) (listAny? (fn [(k String)] -> Bool (= k "W")) kinds)) (str "two concurrent mergeUnit runs hold the main-merge lock one after the other: " (stringJoin kinds "") " " lq))
      (assert (and liveMk (not tookLive) liveStill (not (stringContains? (logOf (str tmp "/tl.log")) "LOCK-TAKEOVER"))) "a taker that finds a live pid in the renamed lock undoes the rename, keeps the lock and returns false")
      (assert (and relOtherMk (not relOtherRes) relOtherStill relMineMk relMineRes (not (fileExists? relMine))) "release removes a lock only when its pid file names this process, and puts a foreign lock back")
      (assert (and npMk np1 (not okNp) (stringContains? lsNp ":event :LOCK-TIMEOUT") (not (has? lsNp "MERGED")) npStill) (str "a fresh lock without a pid file is not stolen: the taker times out and the lock stays: " lsNp))
      (assert (and lone okLone (stringContains? lsLone ":event :NEIGHBOUR-SELECTOR :by \"scan\" :why \"graphEmpty\"")) (str "an empty graph answer for a branch that changed files falls back to the scan with why graphEmpty: " lsLone))
      (assert (and tkMk t1 t2 (listAll? (fn [(d fr/Done)] -> Bool (= d.exit 0)) ts) (= tKinds (list "A" "R" "A" "R")) (stringContains? lt ":event :LOCK-TAKEOVER :deadPid 4000002")) (str "two takers on one stale lock: exactly one holds it at a time: " (stringJoin tKinds "") " " lt))
      (assert cleaned "the temp tree is removed")
      true))

; (:m :ref (MERGE-LOCK-RESIDUAL MERGEDOC-LOWS) :do "lock claim and ledger-trigger residuals: a claim renames a private directory holding its pid into place (one winner, never a pidless lock, no private leftovers); a takeover is refused while another takeover claim is live and leaves the stale lock alone; the :x export list is read with any blanks or a newline before the bracket and not from a longer key; the base text of a path comes from the merge base, so a main that deleted the file after the branch point does not hide what the branch changed")
fn ! runLowsTests -> Bool
  (let [(tmp (str (optionOr (envGet "TMPDIR") "/tmp") "/mergeLowsTest" (stringFromInt64 (nowNs))))
        (main (str tmp "/main"))
        (wtRoot (str tmp "/wt"))
        (briefs (str tmp "/briefs"))
        (dirs (and (ok? (dirCreate main)) (and (ok? (dirCreate wtRoot)) (ok? (dirCreate briefs)))))
        (srcDir (ok? (dirCreate (str main "/pkg/src"))))
        (hdr (write (str main "/pkg/src/d.asl") "(module pkg/d\n  :x [dOne dTwo])\n"))
        (base (write (str main "/base.txt") "base\n"))
        (init (gk/initGitRepoWith! main "mergeLowsTest" "merge-lows@example.invalid" (list "base.txt" "pkg/src/d.asl")))
        (um (addUnit! main wtRoot briefs "m" "m.txt" "\"test -f m.txt\""))
        (rmMain (ok? (pathRemove (str main "/pkg/src/d.asl"))))
        (txMain (vg/prepare! main (list "pkg/src/d.asl")))
        (delMain (and txMain.ok (= (vg/finish! main txMain "main deletes d" (list "pkg/src/d.asl")).exit 0)))
        (cfg (with (mu/defaultCfg) :main main :worktrees wtRoot :briefDir briefs :lock (str tmp "/mainbuild.lock") :branch "main"))
        (mergeBaseText (mu/baseText! cfg (str wtRoot "/asex-m") "pkg/src/d.asl"))
        (lockDir (str tmp "/lk/q.lock"))
        (first (mu/claimDir! lockDir))
        (second (mu/claimDir! lockDir))
        (ownedBy (mu/ownerOf! lockDir))
        (leftovers (filter (fn [(n String)] -> Bool (stringContains? n ".new.")) (resultOr (dirList (str tmp "/lk")) (list))))
        (emptyDir (str tmp "/lk/empty.lock"))
        (emptyMk (ok? (dirCreate emptyDir)))
        (emptyClaim (mu/claimDir! emptyDir))
        (emptyStill (ok? (fileStat emptyDir)))
        (staleDir (str tmp "/lk/stale.lock"))
        (staleMk (and (ok? (dirCreate staleDir)) (write (str staleDir "/pid") "4000000")))
        (claimMk (and (ok? (dirCreate (str staleDir ".takeover"))) (write (str staleDir ".takeover/pid") (stringFromInt64 (procSelf)))))
        (tookWhileClaimed (mu/takeOver! (with cfg :log (str tmp "/lows.log")) "lows" staleDir 4000000))
        (staleStill (fileExists? (str staleDir "/pid")))
        (claimStill (fileExists? (str staleDir ".takeover/pid")))
        (freeClaim (ok? (pathRemove (str staleDir ".takeover"))))
        (tookFree (mu/takeOver! (with cfg :log (str tmp "/lows.log")) "lows" staleDir 4000000))
        (staleGone (not (ok? (fileStat staleDir))))
        (claimGone (not (ok? (fileStat (str staleDir ".takeover")))))
        (cleaned (ok? (pathRemove tmp)))]
    (do
      (assert (and dirs srcDir hdr base init um rmMain delMain) "the lows fixtures are built through gitInitKit and the vcs module")
      (assert (and (= (mu/exportHeader ":x  [a b]") "a b") (and (= (mu/exportHeader "(module m\n  :x\n  [a\n   b])") "a b") (and (= (mu/exportHeader ":x[a]") "a") (and (= (mu/exportHeader ":x\t[a b]") "a b") (and (= (mu/exportHeader ":xy [no] :x [yes]") "yes") (= (mu/exportHeader ":x [a b]") "a b")))))) "an :x export list is read with any blanks or a newline before the bracket, and a longer key such as :xy is not one")
      (assert (stringContains? mergeBaseText ":x [dOne dTwo]") (str "baseText! reads the merge base: a main that deleted the file after the branch point does not hide its header: " mergeBaseText))
      (assert (and first (not second) (= ownedBy (procSelf)) (listEmpty? leftovers)) "a claim wins once, its pid file is there when the lock is, and no private directory is left behind")
      (assert (and emptyMk (not emptyClaim) emptyStill) "a claim never replaces an existing empty directory (a legacy half-made lock)")
      (assert (and staleMk claimMk (not tookWhileClaimed) staleStill claimStill) "a takeover is refused while another takeover claim is live, and the stale lock and the other claim stay")
      (assert (and freeClaim tookFree staleGone claimGone) "with no live takeover claim the dead owner's lock is taken over and the claim is released")
      (assert cleaned "the temp tree is removed")
      true))

fn ! suiteNames n: Int64 -> (List String)
  (map (fn [(k Int64)] -> String (str "test -f pkg/tests/n" (stringFromInt64 k) "Test.asl")) (range 0 n))

; (:m :ref MERGE-NEIGHBOUR-FANOUT :do "the neighbour fan-out cap: 272 selected suites of unrecorded cost (60 s each) exceed the 1200 s default budget on 2 slots, so the direct importers are kept, the rest sampled deterministically within the budget, and NEIGHBOUR-CAP names :n :picked :direct :budgetS :costS; 5 suites, or 272 suites recorded at 1 s each, stay untouched with no event; a real merge whose graph selector answers 272 suites runs only the capped set; --neighbour-budget-secs sets the budget")
fn ! runFanoutTests -> Bool
  (let [(tmp (str (optionOr (envGet "TMPDIR") "/tmp") "/mergeFanoutTest" (stringFromInt64 (nowNs))))
        (main (str tmp "/main"))
        (wtRoot (str tmp "/wt"))
        (briefs (str tmp "/briefs"))
        (dirs (and (ok? (dirCreate main)) (and (ok? (dirCreate wtRoot)) (ok? (dirCreate briefs)))))
        (base (write (str main "/base.txt") "base\n"))
        (init (gk/initGitRepoWith! main "mergeFanoutTest" "merge-fanout@example.invalid" (list "base.txt")))
        (cfg (with (mu/defaultCfg) :main main :worktrees wtRoot :briefDir briefs :lock (str tmp "/mainbuild.lock") :audit "none" :gateSecs 60 :testCmd "test -f" :lockWaitS 60 :checkCmd "true" :aslBin (str (resultOr (realPath ".") ".") "/bin/asl")))
        (big (suiteNames 272))
        (direct (listTake big 3))
        (logCap (str tmp "/cap.log"))
        (capped (mu/capNeighbours (with cfg :log logCap) "cap" (mapEmpty) direct big))
        (capped2 (mu/capNeighbours (with cfg :log (str tmp "/cap2.log")) "cap" (mapEmpty) direct big))
        (lcap (logOf logCap))
        (small (mu/capNeighbours (with cfg :log (str tmp "/small.log")) "small" (mapEmpty) (list) (suiteNames 5)))
        (recorded (fold (fn [(m (Map String Int64)) (g String)] -> (Map String Int64) (mapSet m (mu/gateKey cfg g) 1000)) (mapEmpty) big))
        (fast (mu/capNeighbours (with cfg :log (str tmp "/fast.log")) "fast" recorded (list) big))
        (lsmall (logOf (str tmp "/small.log")))
        (lfast (logOf (str tmp "/fast.log")))
        (tight (mu/capNeighbours (with (with cfg :neighbourBudgetS 100) :log (str tmp "/tight.log")) "tight" (mapEmpty) direct big))
        (parsed (mu/parseArgs (list "--neighbour-budget-secs" "300" "u1")))
        (parsedBad (mu/parseArgs (list "--neighbour-budget-secs" "0" "u1")))
        (graphDir (ok? (dirCreate (str main "/tools/fleet"))))
        (graphStub (write (str main "/tools/fleet/graph.asl") "(module fanoutGraph\n  :x [main]\n  :i [])\n\nfn ! main args: (List String) -> (Result Int64 String)\n  (do (fold (fn [(acc Bool) (k Int64)] -> Bool (do (println (str \"pkg/tests/n\" (stringFromInt64 k) \"Test.asl\")) true)) true (range 0 270))\n      (println \"pkg/tests/imp2Test.asl\")\n      (println \"pkg/tests/imp4Test.asl\")\n      (ok 0))\n"))
        (uf (addUnit! main wtRoot briefs "fz" "fz.txt" "\"test -f fz.txt\""))
        (uo (addEditUnit! main wtRoot briefs "fo" "xmod.asl" "(module xmod\n  :x [f])\n" "\"test -f xmod.asl\""))
        (made (and (listAll? (fn [(u String)] -> Bool (ok? (dirCreate (str wtRoot "/asex-" u "/pkg/tests")))) (list "fz" "fo")) (listAll? (fn [(u String)] -> Bool (and (listAll? (fn [(k Int64)] -> Bool (write (str wtRoot "/asex-" u "/pkg/tests/n" (stringFromInt64 k) "Test.asl") "x\n")) (range 0 270)) (and (write (str wtRoot "/asex-" u "/pkg/tests/imp2Test.asl") "(module pkg/tests/imp2Test\n  :i [(xmod :a m)])\n") (write (str wtRoot "/asex-" u "/pkg/tests/imp4Test.asl") "(module pkg/tests/imp4Test\n  :i [(xmod :a m)])\n")))) (list "fz" "fo"))))
        (logFz (str tmp "/fz.log"))
        (okFz (mu/mergeUnit! (with cfg :log logFz) "fz"))
        (lfz (logOf logFz))
        (gatesRun (listLength (filter (fn [(l String)] -> Bool (and (stringContains? l ":event :GATE ") (stringContains? l "pkg/tests/n"))) (stringLines lfz))))
        (logFo (str tmp "/fo.log"))
        (okFo (mu/mergeUnit! (with cfg :log logFo) "fo"))
        (lfo (logOf logFo))
        (importersRun (listLength (filter (fn [(l String)] -> Bool (and (stringContains? l ":event :GATE ") (or (stringContains? l "pkg/tests/imp2Test.asl") (stringContains? l "pkg/tests/imp4Test.asl")))) (stringLines lfo))))
        (boundary (mu/capNeighbours (with (with cfg :neighbourBudgetS 1000) :log (str tmp "/bound.log")) "bound" (mapEmpty) (list) (suiteNames 30)))
        (lbound (logOf (str tmp "/bound.log")))
        (cleaned (ok? (pathRemove tmp)))]
    (do
      (assert (and dirs base init graphDir graphStub uf uo made) "the fan-out fixtures are built through gitInitKit and the vcs module")
      (assert (and (stringContains? lcap ":event :NEIGHBOUR-CAP :n 272 :picked 40 :direct 3 :budgetS 1200 :costS 2400") (< (listLength capped) 272) (= capped capped2) (listAll? (fn [(g String)] -> Bool (listContains? capped g)) direct)) (str "272 suites of unrecorded cost are capped to the 1200 s budget on 2 slots, the 3 direct importers kept, the same sample every time: " lcap " picked " (stringFromInt64 (listLength capped))))
      (assert (and (= small (suiteNames 5)) (not (stringContains? lsmall "NEIGHBOUR-CAP")) (= fast big) (not (stringContains? lfast "NEIGHBOUR-CAP"))) "a small set, or a large set whose recorded medians fit the budget, is returned untouched with no event")
      (assert (and (= (listLength tight) 3) (listAll? (fn [(g String)] -> Bool (listContains? tight g)) direct)) (str "the direct importers are kept even when they alone exceed the budget: " (stringFromInt64 (listLength tight))))
      (assert (and (= parsed.cfg.neighbourBudgetS 300) (stringContains? parsedBad.error "neighbour-budget-secs")) "--neighbour-budget-secs sets the budget and rejects zero")
      (assert (and okFz (stringContains? lfz ":event :NEIGHBOUR-CAP :n 272") (< gatesRun 100) (has? lfz "MERGED")) (str "a merge whose graph selector answers 272 suites runs only the capped set and merges: " (stringFromInt64 gatesRun) " neighbour gates"))
      (assert (and okFo (stringContains? lfo ":event :NEIGHBOUR-CAP :n 272") (stringContains? lfo ":direct 2") (= importersRun 2) (has? lfo "MERGED")) (str "a change outside /src/ (xmod.asl) keeps the two suites that import its module through the cap, so they run as gates: " (stringFromInt64 importersRun)))
      (assert (and (= boundary (suiteNames 30)) (not (stringContains? lbound "NEIGHBOUR-CAP"))) "30 suites of 60 s on 2 slots are 1800 s in total but 900 s of wall time, within a 1000 s budget, so they stay uncapped: the budget is checked against the wall time over the slots")
      (assert cleaned "the temp tree is removed")
      true))
