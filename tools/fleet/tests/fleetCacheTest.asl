(module asl-tools/fleet/tests/fleetCacheTest
  :x [runTests]
  :i [(tools/fleet/cache :a fc) (asl-tools/fleet/run :a fr)])

; (:m :ref FK-CACHEKEY :do "the verdict key carries target triple, libc, clang version and toolchain digest; a verdict exported from another triple is refused on import and never lands where readVerdict looks; every directory here is scratch, never ~/.asl/run")

fn ! scratch tag: String -> String
  (str (optionOr (envGet "TMPDIR") "/tmp") "/fkCacheTest-" (stringFromInt64 (procSelf)) "-" tag)

fn ! runTests -> Bool
  (let [(root (scratch "x"))
        (exportDir (str root "/export"))
        (cacheRoot (str root "/cache"))
        (mac (fc/toolchainOf "arm64-apple-darwin25.1.0" "libSystem-26.1" "Apple clang 17" "bin1"))
        (linux (fc/toolchainOf "x86_64-pc-linux-gnu" "ldd 2.39" "clang 18" "bin1"))
        (libcOther (fc/toolchainOf "arm64-apple-darwin25.1.0" "libSystem-27.0" "Apple clang 17" "bin1"))
        (clangOther (fc/toolchainOf "arm64-apple-darwin25.1.0" "libSystem-26.1" "Apple clang 18" "bin1"))
        (binOther (fc/toolchainOf "arm64-apple-darwin25.1.0" "libSystem-26.1" "Apple clang 17" "bin2"))
        (tripleOther (fc/toolchainOf "x86_64-apple-darwin25.1.0" "libSystem-26.1" "Apple clang 17" "bin1"))
        (kMac (fc/keyWithToolchain "c" "k" mac))
        (_ (assert (= kMac (fc/keyWithToolchain "c" "k" mac)) "key is deterministic"))
        (_ (assert (not (= kMac (fc/keyWithToolchain "c" "k" linux))) "triple changes the key"))
        (_ (assert (not (= kMac (fc/keyWithToolchain "c" "k" tripleOther))) "triple alone changes the key"))
        (_ (assert (not (= kMac (fc/keyWithToolchain "c" "k" libcOther))) "libc changes the key"))
        (_ (assert (not (= kMac (fc/keyWithToolchain "c" "k" clangOther))) "clang version changes the key"))
        (_ (assert (not (= kMac (fc/keyWithToolchain "c" "k" binOther))) "toolchain digest changes the key"))
        (_ (assert (not (= kMac (fc/keyWithToolchain "c2" "k" mac))) "closure still changes the key"))
        (local (fc/probeToolchain!))
        (_ (assert (not (stringEmpty? local.triple)) "local triple probed"))
        (v (fc/Verdict :exit 0 :executed 7 :errors (list)))
        (_ (assert (fc/exportVerdict! exportDir "keyLinux" linux v) "export foreign verdict"))
        (_ (assert (fc/exportVerdict! exportDir "keyMac" mac v) "export same-toolchain verdict"))
        (taken (fc/importInto! exportDir cacheRoot mac))
        (_ (assert (= taken 1) "only the same-toolchain verdict imported"))
        (_ (assert (not (fileExists? (str cacheRoot "/keyLinux"))) "foreign triple verdict never served"))
        (back (resultOr (fileReadString (str cacheRoot "/keyMac")) ""))
        (_ (assert (= (fc/deserialize back).executed 7) "imported verdict reads back"))
        (_ (dirCreate root))
        (memoDir (str root "/memo"))
        (fakeClang (str root "/clang"))
        (_ (fileWrite fakeClang "aaaa"))
        (tick (+ (nowNs) 3600000000000))
        (_ (fileUtime fakeClang tick))
        (counter (str root "/probes"))
        (probes (fn [] -> Int64 (stringLength (resultOr (fileReadString counter) ""))))
        (probe (fn [] -> fc/Toolchain (let [(old (resultOr (fileReadString counter) "")) (_ (fileWrite counter (str old "x")))] mac)))
        (look (fn [(i Int64)] -> fc/Toolchain (fc/memoToolchain! memoDir fakeClang probe)))
        (many (map look (list 1 2 3 4 5)))
        (_ (assert (= (probes) 1) "five lookups probe once"))
        (_ (assert (= (fc/toolchainHeader (optionOr (listGet many 4) mac)) (fc/toolchainHeader mac)) "memoized toolchain equals the probed one"))
        (_ (fileWrite fakeClang "bbbb"))
        (_ (fileUtime fakeClang tick))
        (_ (look 6))
        (_ (assert (= (probes) 2) "a same-size rewrite keeping an mtime not older than the memo (one coarse tick) reprobes"))
        (_ (look 7))
        (_ (assert (= (probes) 2) "unchanged clang is not reprobed"))
        (_ (fileWrite fakeClang "cccc"))
        (_ (look 8))
        (_ (assert (= (probes) 3) "touching clang (same size, new mtime) reprobes"))
        (_ (fileWrite fakeClang "longer clang"))
        (_ (look 9))
        (_ (assert (= (probes) 4) "size change reprobes"))
        (_ (assert (= (listLength (resultOr (dirList memoDir) (list))) 1) "one memo file per clang path"))
        (_ (fr/shellOut (str "/bin/rm -rf " root) 5000))]
    true)
