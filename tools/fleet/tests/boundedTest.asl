(module asl/tools/fleet/tests/boundedTest
  :x [runTests]
  :i [(asl-tools/fleet/run :a fr) (asl/tools/fleet/bounded :a bd)])

; (:m :ref WATCHDOG-GROUP-KILL :do "bounded.asl through its real command line, each case one child of this test run through fleet/run.asl with a 90 s limit: a command past SECS is killed with its whole tree (a sleeper child, a sleeper grandchild in a nested sh, and a nested bin/asl run with its own sleeper) with exit 124 and a timeout note, a command that ends keeps its exit code and output whole, a bad line is refused with exit 2 before any run")
; (:m :ref BOUNDED-RED-SLEEPER :do "the commands write the pids of their sleepers and wrappers into pid files of this run; survivors are judged and cleaned by those pids, never by command text: after the judgement every recorded pid still alive is killed, but only when its command still holds what the recorded process ran (a pid that was reused is left alone), so a red run leaves none and a foreign process, even a sleep with the same number, is never touched; a decoy sleep with the same number, started by this test outside every bounded run, must survive")

fn ! psRow! pid: Int64 -> String
  (stringTrim (fr/runOneLimited (fr/job (list "ps" "-p" (stringFromInt64 pid) "-o" "stat=,command=") "/" (fr/childEnv (list))) (fr/limits 10 8)).out)

fn ! aliveOwn? pid: Int64 -> Bool
  (let [(row (psRow! pid))]
    (and (> pid 1) (and (not (stringEmpty? row)) (not (stringStartsWith? row "Z")))))

; (:m :do "SIGKILL pid only while it is alive and its command holds expect; the count of pids killed")
fn ! killOwn! pid: Int64 expect: String -> Int64
  (if (and (aliveOwn? pid) (stringContains? (psRow! pid) expect))
    (match (procKill pid "SIGKILL") ((ok _) 1) ((err _) 0))
    0)

fn ! pidIn! path: String -> Int64
  (optionOr (stringToInt64 (stringTrim (resultOr (fileReadString path) ""))) 0)

fn ! startDecoy! secs: String -> Int64
  (match (fr/spawnSep (list "sleep" secs) "." (fr/childEnv (list)))
    ((ok r) r.pid)
    ((err _) -1))

fn ! child! root: String argv: (List String) -> fr/Done
  (fr/runOneLimited (fr/job (listAppend (list "./bin/asl" "run" "asl/tools/fleet/bounded.asl") argv) root (fr/childEnv (list))) (fr/limits 90 64))

; (:m :ref BOUNDED-LAUNCHER-GROUP :do "the pid written to path once it is there, polled every 100 ms up to deadlineNs; 0 when it never came")
fn ! pidBy! path: String deadlineNs: Int64 -> Int64
  (let [(p (pidIn! path))]
    (if (or (> p 1) (> (monotonicNs) deadlineNs)) p (do (sleepMs 100) (pidBy! path deadlineNs))))

; (:m :ref BOUNDED-SENTINEL-PS-LATENCY :do "the count of processes whose command line matches pattern, polled every 200 ms until it is 0 or deadlineNs passes; pgrep leaves itself out")
fn ! quietBy! pattern: String deadlineNs: Int64 -> Int64
  (let [(n (listLength (filter (fn [(l String)] -> Bool (not (stringEmpty? (stringTrim l)))) (stringSplit (fr/runOneLimited (fr/job (list "pgrep" "-f" pattern) "/" (fr/childEnv (list))) (fr/limits 10 8)).out "\n"))))]
    (if (or (= n 0) (> (monotonicNs) deadlineNs)) n (do (sleepMs 200) (quietBy! pattern deadlineNs))))

; (:m :ref BOUNDED-LAUNCHER-GROUP :do "true once pid is gone (or a zombie), polled every 200 ms up to deadlineNs")
fn ! goneBy! pid: Int64 deadlineNs: Int64 -> Bool
  (cond
    ((not (aliveOwn? pid)) true)
    ((> (monotonicNs) deadlineNs) false)
    (else (do (sleepMs 200) (goneBy! pid deadlineNs))))

; (:m :ref BOUNDED-LAUNCHER-GROUP :do "a bounded run whose launcher alone is SIGKILLed while its command runs (2 s after the command started: the sentinel learns the command from ps snapshots with 1 s age steps, so a kill inside about the first 1 to 2 s is a known gap): the launcher leads its own group (spawnSep), the command's group is apart from it, so only the sentinel can stop the command; the launcher is reaped here; the pair (wrapper pid, sleeper pid, launcher pid)")
fn ! killedLauncher! root: String dir: String secs: String tag: String env: (List String) slowMark: String slowMode: String -> (List Int64)
  (match (fr/spawnSep (list "./bin/asl" "run" "asl/tools/fleet/bounded.asl" "60" "--" "sh" "-c" (str "echo $$ > " dir "/lw" tag "; sleep " secs " & echo $! > " dir "/ls" tag "; wait")) root (fr/childEnv env))
    ((err _) (list 0 0 0))
    ((ok r)
      (let [(ls (pidBy! (str dir "/ls" tag) (+ (monotonicNs) 60000000000)))
            (lw (pidIn! (str dir "/lw" tag)))
            (_ (sleepMs 2000))
            (_ (procKill r.pid "SIGKILL"))
            (_ (if (stringEmpty? slowMark) true (ok? (fileWrite slowMark (str slowMode "\n")))))
            (_ (procWaitPid r.pid false))
            (_ (fdClose r.outFd))
            (_ (fdClose r.errFd))]
        (list lw ls r.pid))))

fn ! runTests -> Bool
  (let [(root (resultOr (realPath ".") "."))
        (m (mod (procSelf) 90))
        (sa (stringFromInt64 (+ 1000 m)))
        (sb (stringFromInt64 (+ 200 m)))
        (sc (stringFromInt64 (+ 300 m)))
        (sd (stringFromInt64 (+ 400 m)))
        (sl (stringFromInt64 (+ 500 m)))
        (sk (stringFromInt64 (+ 600 m)))
        (sq (stringFromInt64 (+ 700 m)))
        (dir (str (optionOr (envGet "TMPDIR") "/tmp") "/boundedTest-" (stringFromInt64 (procSelf))))
        (_ (dirCreate dir))
        ; (:m :ref BOUNDED-LAUNCHER-GROUP :do "a first run builds bounded.asl: SECS now counts the launch (BOUNDED-WALL-INCLUDES-BUILD), so on a cold cache the 3 s cases below spent their bound on the build and ran nothing")
        (warm (child! root (list "300" "--" "true")))
        (_ (fileWrite (str dir "/esc.pl") "use POSIX; exit 0 if fork; POSIX::setsid(); exit 0 if fork; open(STDIN, '<', '/dev/null'); open(STDOUT, '>', '/dev/null'); open(STDERR, '>', '/dev/null'); open(F, '>', $ARGV[0]); print F $$; close F; exec @ARGV[1..$#ARGV];\n"))
        (_ (fileWrite (str dir "/spin.asl") "(module spin :x [main])\n\nfn ! main args: (List String) -> (Result Int64 String)\n  (do (sleepMs 120000) (ok 0))\n"))
        (decoy (startDecoy! sa))
        (rcpt (str dir "/receipt.asn"))
        ; (:m :ref BOUNDED-PIDS-FLAKE :do "SECS 15, not 3, for the cases whose command must start before the kill: SECS counts the launch (BOUNDED-WALL-INCLUDES-BUILD), a warm launch measured 1.1 to 2.2 s at load 96 on 2026-11-13, and past 3 s at the loads where INTEG23 and INTEG26 went red here with no pid recorded, the command refused at launch")
        (tree (child! root (list "15" "--receipt" rcpt "--" "sh" "-c" (str "echo $$ > " dir "/w1; sleep " sa " & echo $! > " dir "/a; sh -c 'echo $$ > " dir "/w2; sleep " sb " & echo $! > " dir "/b; wait' & wait"))))
        (pa (pidIn! (str dir "/a")))
        (pb (pidIn! (str dir "/b")))
        (w1 (pidIn! (str dir "/w1")))
        (w2 (pidIn! (str dir "/w2")))
        (aliveA (aliveOwn? pa))
        (aliveB (aliveOwn? pb))
        (nested (child! root (list "15" "--" "sh" "-c" (str "echo $$ > " dir "/w3; exec ./bin/asl run asl/tools/fleet/bounded.asl 120 -- sh -c 'sleep " sc " & echo $! > " dir "/c; wait'"))))
        (pc (pidIn! (str dir "/c")))
        (w3 (pidIn! (str dir "/w3")))
        (aliveC (aliveOwn? pc))
        (escape (child! root (list "20" "--" "sh" "-c" (str "perl " dir "/esc.pl " dir "/e sleep " sd "; sleep 1"))))
        (pe (pidIn! (str dir "/e")))
        (escapeeAliveAfterRun (aliveOwn? pe))
        (orphan (child! root (list "15" "--" "sh" "-c" (str "perl " dir "/esc.pl " dir "/o ./bin/asl run " dir "/spin.asl; sleep 100"))))
        (po (pidIn! (str dir "/o")))
        (orphanAlive (aliveOwn? po))
        (orphanKilled (killOwn! po ""))
        (treeReceipt (resultOr (fileReadString rcpt) ""))
        (okRun (child! root (list "20" "--receipt" rcpt "--" "sh" "-c" "echo whole; echo err >&2; exit 7")))
        (bothReceipts (resultOr (fileReadString rcpt) ""))
        (short (child! root (list "5" "--receipt" (str dir "/short.asn") "--" "true")))
        (shortReceipt (resultOr (fileReadString (str dir "/short.asn")) ""))
        (noValue (child! root (list "3" "--receipt" "--" "true")))
        (noCmd (child! root (list "3" "--")))
        (noSep (child! root (list "3" "sleep" "1")))
        (zero (child! root (list "0" "--" "true")))
        (late (fr/runOneLimited (fr/job (list "sh" "-c" (str "sleep 4; exec ./bin/asl run asl/tools/fleet/bounded.asl 3 -- sh -c 'echo ran > " dir "/late'")) root (fr/childEnv (list))) (fr/limits 90 64)))
        (lateRan (fileExists? (str dir "/late")))
        (partial (fr/runOneLimited (fr/job (list "sh" "-c" "sleep 2; exec ./bin/asl run asl/tools/fleet/bounded.asl 5 -- sleep 4") root (fr/childEnv (list))) (fr/limits 90 64)))
        (lk (killedLauncher! root dir sl "" (list) "" ""))
        (lkWrapperGone (goneBy! (optionOr (listGet lk 0) 0) (+ (monotonicNs) 10000000000)))
        (lkSleeperGone (goneBy! (optionOr (listGet lk 1) 0) (+ (monotonicNs) 10000000000)))
        (lkLeft (+ (killOwn! (optionOr (listGet lk 1) 0) (str "sleep " sl)) (killOwn! (optionOr (listGet lk 0) 0) dir)))
        ; (:m :ref BOUNDED-SENTINEL-PS-LATENCY :do "the same kill with every ps the launcher and its sentinel start made slow from the kill on (the samples that found the command stay fast): a PATH shim in this run's dir prints the real ps and then sleeps 5 s (mark post: ages 5 s behind a wall read after ps), or sleeps 5 s and then prints it (mark pre: ages 5 s ahead of a wall read before ps, which the one-ps-run slack covers)")
        (shim (do (dirCreate (str dir "/shim")) (fileWrite (str dir "/shim/ps") (str "#!/bin/sh\ngrep -q pre " dir "/slow 2>/dev/null && sleep 5\n/bin/ps \"$@\"\nrc=$?\ngrep -q post " dir "/slow 2>/dev/null && sleep 5\nexit $rc\n")) (fileChmod (str dir "/shim/ps") 493) true))
        (sp (killedLauncher! root dir sk "s" (list (str "PATH=" dir "/shim:" (optionOr (envGet "PATH") "/usr/bin:/bin"))) (str dir "/slow") "post"))
        (spSleeperGone (goneBy! (optionOr (listGet sp 1) 0) (+ (monotonicNs) 40000000000)))
        (spWrapperGone (goneBy! (optionOr (listGet sp 0) 0) (+ (monotonicNs) 10000000000)))
        (spLeft (+ (killOwn! (optionOr (listGet sp 1) 0) (str "sleep " sk)) (killOwn! (optionOr (listGet sp 0) 0) dir)))
        (_ (pathRemove (str dir "/slow")))
        (pp (killedLauncher! root dir sq "p" (list (str "PATH=" dir "/shim:" (optionOr (envGet "PATH") "/usr/bin:/bin"))) (str dir "/slow") "pre"))
        (ppSleeperGone (goneBy! (optionOr (listGet pp 1) 0) (+ (monotonicNs) 40000000000)))
        (ppWrapperGone (goneBy! (optionOr (listGet pp 0) 0) (+ (monotonicNs) 10000000000)))
        (ppLeft (+ (killOwn! (optionOr (listGet pp 1) 0) (str "sleep " sq)) (killOwn! (optionOr (listGet pp 0) 0) dir)))
        (slowLeft (quietBy! (str dir "/(lw[sp]|shim)") (+ (monotonicNs) 30000000000)))
        (_ (pathRemove (str dir "/slow")))
        (_ (pathRemove (str dir "/shim/ps")))
        (_ (pathRemove (str dir "/shim")))
        (killedOwn (fold (fn [(n Int64) (x (Pair Int64 String))] (+ n (killOwn! (pairFirst x) (pairSecond x)))) 0
                    (list (pair pa (str "sleep " sa)) (pair pb (str "sleep " sb)) (pair pc (str "sleep " sc)) (pair w1 dir) (pair w2 dir) (pair w3 dir))))
        (escapeeKilled (killOwn! pe (str "sleep " sd)))
        (escapeeAliveAfterKill (aliveOwn? pe))
        (decoyAlive (aliveOwn? decoy))
        (decoyKilled (killOwn! decoy (str "sleep " sa)))
        (_ (map (fn [(f String)] (pathRemove (str dir "/" f))) (list "a" "b" "c" "e" "o" "late" "short.asn" "lw" "ls" "lws" "lss" "lwp" "lsp" "receipt.asn" "esc.pl" "spin.asl" "w1" "w2" "w3")))
        (_ (pathRemove dir))]
    (do (assert (= warm.exit 0) (str "the warm-up run of bounded.asl ends 0: " (stringFromInt64 warm.exit) " " warm.out))
        (assert (and (> pa 1) (and (> pb 1) (and (> pc 1) (and (> w1 1) (and (> w2 1) (> w3 1)))))) (str "the commands recorded the pids of their sleepers and wrappers; tree: " tree.out " nested: " nested.out))
        (assert (> decoy 1) "the decoy sleep with the same number as a test sleeper started outside every bounded run")
        (assert (= tree.exit 124) (str "a tree past SECS ends with exit 124: " (stringFromInt64 tree.exit)))
        (assert (stringContains? tree.out ":verdict :timeout") (str "the timeout note is printed: " tree.out))
        (assert (< tree.ms 60000) (str "the 120 s body is killed at SECS 15, long before its end: " (stringFromInt64 tree.ms)))
        (assert (not aliveA) "the direct child's sleeper does not survive")
        (assert (not aliveB) "the sleeper of the nested sh (a grandchild) does not survive")
        (assert (= nested.exit 124) (str "a nested bin/asl run past SECS ends with exit 124: " (stringFromInt64 nested.exit)))
        (assert (not aliveC) "the nested bin/asl run's own sleeper does not survive")
        (assert (and (= okRun.exit 7) (and (stringContains? okRun.out "whole") (stringContains? okRun.out "err"))) (str "a command that ends keeps its exit code and output: " okRun.out))
        (assert (not (stringContains? okRun.out ":verdict")) "an ended command carries no kill note")
        (assert (and (= noCmd.exit 2) (stringContains? noCmd.out "the command is empty")) (str "an empty command is refused: " noCmd.out))
        (assert (and (= noSep.exit 2) (stringContains? noSep.out "the command must follow --")) (str "a missing separator is refused: " noSep.out))
        (assert (and (= zero.exit 2) (stringContains? zero.out "SECS must be a positive integer")) (str "SECS 0 is refused: " zero.out))
        (assert (= late.exit 124) (str "a launch that used all of SECS (4 s before bounded.asl started, SECS 3) ends with exit 124: " (stringFromInt64 late.exit) " " late.out))
        (assert (stringContains? late.out ":phase :launch") (str "the note names the launch as what used the bound: " late.out))
        (assert (not lateRan) "a launch that used all of SECS starts no command")
        (assert (= partial.exit 124) (str "a 4 s command under SECS 5 is killed when the launch took 2 s of it: " (stringFromInt64 partial.exit) " " partial.out))
        (assert (and (> (optionOr (listGet lk 0) 0) 1) (> (optionOr (listGet lk 1) 0) 1)) (str "the killed launcher's command recorded its wrapper and sleeper: " (stringJoin (map stringFromInt64 lk) " ")))
        (assert lkSleeperGone (str "a SIGKILL of the launcher alone takes its command's sleeper with it within 10 s (left for the cleanup kill: " (stringFromInt64 lkLeft) ")"))
        (assert lkWrapperGone "and the command's wrapper sh")
        (assert (and (> (optionOr (listGet sp 0) 0) 1) (> (optionOr (listGet sp 1) 0) 1)) (str "the slow-ps launcher's command recorded its pids: " (stringJoin (map stringFromInt64 sp) " ")))
        (assert spSleeperGone (str "with ps slowed 5 s after it reads at kill time the sentinel still kills the real command within 40 s (left for the cleanup kill: " (stringFromInt64 spLeft) ")"))
        (assert spWrapperGone "and its wrapper sh")
        (assert (and (> (optionOr (listGet pp 0) 0) 1) (> (optionOr (listGet pp 1) 0) 1)) (str "the slow-before-ps launcher's command recorded its pids: " (stringJoin (map stringFromInt64 pp) " ")))
        (assert ppSleeperGone (str "with ps delayed 5 s before it reads, so its ages run 5 s behind the wall read before it, the slack of one ps run still lets the sentinel kill the command within 40 s (left: " (stringFromInt64 ppLeft) ")"))
        (assert ppWrapperGone "and its wrapper sh")
        (assert (= slowLeft 0) (str "the slow-ps launchers, their sentinels and every shim ps are gone before the shim is removed (left: " (stringFromInt64 slowLeft) ")"))
        (assert (= (bd/parseArgs (list "5" "--max-desc" "9" "--" "a" "b")).maxDesc 9) "parseArgs reads --max-desc")
        (assert (= (bd/parseArgs (list "5" "--" "a" "b")).maxDesc 64) "parseArgs defaults maxDesc to 64")
        (assert (stringStartsWith? treeReceipt "(:bounded :verdict :timeout :exit 124 :secs 15 ") (str "a run killed at SECS leaves a timeout receipt line: " treeReceipt))
        (assert (stringContains? treeReceipt ":cmd \"sh\")") (str "the receipt names only the command's first word: " treeReceipt))
        (refute (stringContains? treeReceipt "sleep") "the receipt carries no argument of the command")
        (assert (stringContains? bothReceipts "\n(:bounded :verdict :exit :exit 7 :secs 20 ") (str "a run that ends appends its exit receipt line after the timeout one: " bothReceipts))
        (assert (= (listLength (filter (fn [(l String)] (stringStartsWith? l "(:bounded ")) (stringLines bothReceipts))) 2) "each stop appends exactly one receipt line")
        (assert (and (= short.exit 0) (stringContains? short.out "bounded: SECS 5 is under 10")) (str "SECS under minSecs still runs and warns on stderr: " (stringFromInt64 short.exit) " " short.out))
        (assert (stringContains? shortReceipt ":secs 5 ") (str "the short run left its receipt: " shortReceipt))
        (assert (stringContains? shortReceipt ":warn :secsUnderMin :cmd \"true\")") (str "its receipt carries the warning: " shortReceipt))
        (refute (stringContains? bothReceipts ":warn") (str "a run at SECS 15 or 20 carries no warning: " bothReceipts))
        (assert (and (= noValue.exit 2) (stringContains? noValue.out "--receipt needs a value")) (str "--receipt without a file is refused: " noValue.out))
        (assert (= (bd/parseArgs (list "5" "--receipt" "r.asn" "--max-desc" "9" "--" "a")).receipt "r.asn") "parseArgs reads --receipt before --max-desc")
        (assert (= (bd/parseArgs (list "5" "--receipt" "r.asn" "--max-desc" "9" "--" "a")).maxDesc 9) "parseArgs reads --max-desc after --receipt")
        (assert (> pe 1) "the setsid escapee (a double fork into its own session, parent gone) recorded its pid")
        (assert (= escape.exit 0) (str "the run that left the escapee ends on its own: " (stringFromInt64 escape.exit)))
        (assert (not escapeeAliveAfterKill) (str "the escapee is gone after the recorded-pid kill, a red run leaves none (alive at run end: " (if escapeeAliveAfterRun "yes" "no") ", killed by record: " (stringFromInt64 escapeeKilled) ")"))
        (assert (> po 1) "the orphaned setsid escapee of a timed-out run recorded its pid")
        (assert (= orphan.exit 124) (str "the run with an orphaned setsid escapee ends with exit 124: " (stringFromInt64 orphan.exit)))
        (assert (not orphanAlive) (str "the orphaned setsid escapee (ppid 1, own session, never sampled) does not survive the timeout verdict (killed by record: " (stringFromInt64 orphanKilled) ")"))
        (assert (stringContains? orphan.out ":left 0") (str "the verdict reports nothing left: " orphan.out))
        (assert (= killedOwn 0) (str "a green run leaves none of its recorded pids to kill: " (stringFromInt64 killedOwn)))
        (assert decoyAlive "a foreign sleep with a matching number survives the whole run")
        (assert (= decoyKilled 1) "the decoy is the test's own and is killed at the end")
        true))
