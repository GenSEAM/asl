(module asl-tools/fleet/tests/executedOfTest
  :x [runTests]
  :i [(asl-tools/fleet/run :a fr)])

; (:m :ref GATE-ASSERTS-FROM-LEDGER :do "the executed-assert count of a shell gate counts only in the declared form ./bin/asl test FILE... and only from the verdict lines the host prints last, one per declared file: an echoed count, a count printed by the suite and a verdict count that does not match the declared files are no count")
fn ! gate cmd: String -> fr/Done
  (fr/runShell! cmd (resultOr (realPath ".") ".") (fr/childEnv (list)) (fr/limits 300 100))

fn ! sh! cmd: String -> Bool
  (= (fr/runOneLimited (fr/job (list "sh" "-c" cmd) "." (fr/childEnv (list))) (fr/limits 60 8)).exit 0)

fn count d: fr/Done -> Int64
  (optionOr (fr/executedOf d.out) 0)

fn ! removedClean -> Bool
  (let [(_ (fr/stubRemove!))]
    (and (listEmpty? (fr/stubDirsOwnedBy (procSelf))) (stringEmpty? (fr/stubHostPath))))

fn ! runTests -> Bool
  (let [(three "asl/tools/fleet/tests/fixtures/threeAssertsSuite.asl")
        (noisy "asl/tools/fleet/tests/fixtures/noisySuite.asl")
        (echoed (gate "echo '5 assertion(s) executed (5 passed)'"))
        (echoedForm (gate "echo ./bin/asl test x.asl; echo 'x.asl: 5 assertion(s) executed (5 passed)'"))
        (failEcho (gate "echo 'FAIL x.asl: ERR_ASSERT: boom (after 7 asserts)'"))
        (real (gate (str "./bin/asl test " three)))
        (realEcho (gate (str "./bin/asl test " three "; echo '50 assertion(s) executed (50 passed)'")))
        (realNoisy (gate (str "./bin/asl test " noisy)))
        (chained (gate (str "./bin/asl test " three " && echo '" three ": 50 assertion(s) executed (50 passed)'")))
        (pureTwoOne (fr/gateOut (str "./bin/asl test " three " " noisy) (str three ": 3 assertion(s) executed (3 passed)\n")))
        (pureTwoTwo (fr/gateOut (str "./bin/asl test " three " " noisy) (str three ": 3 assertion(s) executed (3 passed)\n" noisy ": 3 assertion(s) executed (3 passed)\n")))
        (pureOtherPath (fr/gateOut (str "./bin/asl test " three) "other.asl: 3 assertion(s) executed (3 passed)\n"))
        (pureNotLast (fr/gateOut (str "./bin/asl test " three) (str three ": 3 assertion(s) executed (3 passed)\ntrailing noise\n")))
        (pureDupFail (fr/gateOut (str "./bin/asl test " three) (str "FAIL " three ": ERR_ASSERT: a (after 1 asserts)\nFAIL " three ": ERR_ASSERT: b (after 2 asserts)\n")))
        (pureRunVerb (fr/gateOut (str "./bin/asl run " three) (str three ": 3 assertion(s) executed (3 passed)\n")))
        (pureEvilHost (fr/gateOut (str "/tmp/evil/bin/asl test " three) (str three ": 3 assertion(s) executed (3 passed)\n")))
        (stubPath (fr/stubHost!))
        (pureStubProd (fr/gateOut (str (fr/stubHostPath) " test " three) (str three ": 3 assertion(s) executed (3 passed)\n")))
        (pureStubHost (fr/gateOutHost (fr/stubHostPath) (str (fr/stubHostPath) " test " three) (str three ": 3 assertion(s) executed (3 passed)\n")))
        (oldDir (str (fr/stubPrefix) (bytesSha256 (stringToBytes (fr/stubHostText)))))
        (oldPath (fr/stubHostIn! oldDir))
        (deadDir (str (fr/stubPrefix) "999999-deadbeefdeadbeef"))
        (deadPath (fr/stubHostIn! deadDir))
        (ownGate (gate (str stubPath " test green3.asl")))
        (oldGate (gate (str oldPath " test green99.asl")))
        (deadGate (gate (str deadPath " test green99.asl")))
        (livePid (stringTrim (resultOr (fr/shellOut "anc=''; p=$$; while [ \"$p\" -gt 1 ]; do anc=\"$anc $p\"; p=$(ps -o ppid= -p $p | tr -d ' '); done; ps -u $(id -u) -o pid= | tr -d ' ' | while read q; do case \" $anc \" in *\" $q \"*) ;; *) if [ \"$q\" -gt 1 ] && kill -0 $q 2>/dev/null; then echo $q; break; fi;; esac; done" 30000) "")))
        (liveDir (str (fr/stubPrefix) livePid "-cafecafecafecafe"))
        (livePath (if (stringEmpty? livePid) "" (fr/stubHostIn! liveDir)))
        (liveGate (gate (str livePath " test green99.asl")))
        (_ (fr/stubHost!))
        (deadSwept (not (fileExists? deadDir)))
        (_ (sh! (str "rm -rf '" liveDir "'")))
        (_ (sh! (str "rm -rf '" oldDir "' '" deadDir "'")))
        (probeRoot (str (resultOr (realPath ".") ".") "/.asl/cache/executedOfTest-" (stringFromInt64 (procSelf))))
        (_ (sh! (str "rm -rf '" probeRoot "' && mkdir -p '" probeRoot "' && mkdir '" probeRoot "/ro' && chmod 500 '" probeRoot "/ro' && mkdir '" probeRoot "/open' && chmod 777 '" probeRoot "/open' && mkdir '" probeRoot "/real' && ln -s '" probeRoot "/real' '" probeRoot "/link'")))
        (_ (sh! (str "mkdir '" probeRoot "/priv' && chmod 700 '" probeRoot "/priv' && ln -s '" probeRoot "/priv' '" probeRoot "/link700' && mkdir -p '" probeRoot "/filelink/bin' && chmod 700 '" probeRoot "/filelink' && mkdir -p '" probeRoot "/dirasl/bin/asl' && chmod 700 '" probeRoot "/dirasl'")))
        (_ (fileWrite (str probeRoot "/filelink/bin/real") (fr/stubHostText)))
        (_ (sh! (str "ln -s '" probeRoot "/filelink/bin/real' '" probeRoot "/filelink/bin/asl'")))
        (link700 (fr/stubHostIn! (str probeRoot "/link700")))
        (fileLinked (fr/stubVerifiedIn! (str probeRoot "/filelink")))
        (dirAsl (fr/stubHostIn! (str probeRoot "/dirasl")))
        (foreignDirs (filter (fn [(d String)] -> Bool (and (fileExists? d) (fr/privateDir? d))) (list "/private/var/db/Spotlight" "/private/var/db/locationd/Library" "/private/var/db/modelmanagerd" "/private/var/db/terminus" "/root")))
        (fresh (fr/stubHostIn! (str probeRoot "/fresh")))
        (again (fr/stubHostIn! (str probeRoot "/fresh")))
        (planted (fr/stubHostIn! (str probeRoot "/ro")))
        (opened (fr/stubHostIn! (str probeRoot "/open")))
        (linked (fr/stubHostIn! (str probeRoot "/link")))
        (freshMode (match (fileLstat (str probeRoot "/fresh")) ((ok st) (mod st.mode 512)) ((err _) -1)))
        (_ (sh! (str "chmod 700 '" probeRoot "/ro'; chmod 700 '" probeRoot "/open'; rm -rf '" probeRoot "'")))
        (pureRed (fr/gateOut (str "./bin/asl test " three) (str "t.asl:5:9: ERR_ASSERT: assertion failed: x\nFAIL " three ": ERR_ASSERT: assertion failed: x (after 2 asserts)\n")))]
    (do (assert (and (= echoed.exit 0) (= (count echoed) 0) (stringContains? echoed.out "gateFormUndeclared")) (str "an echoed count line is no count: " (stringFromInt64 (count echoed)) " in " echoed.out))
        (assert (= (count echoedForm) 0) (str "an echo that spells the declared form is no count: " (stringFromInt64 (count echoedForm))))
        (assert (= (count failEcho) 0) (str "an echoed FAIL line is no count: " (stringFromInt64 (count failEcho))))
        (assert (and (= real.exit 0) (= (count real) 3)) (str "a real suite of three assertions reads 3: " (stringFromInt64 (count real)) " exit " (stringFromInt64 real.exit) " " real.out))
        (assert (= (count realEcho) 0) (str "a line echoed after a real suite breaks the form: " (stringFromInt64 (count realEcho))))
        (assert (= (count chained) 0) (str "a path-prefixed count echoed after a real suite is a duplicate verdict: " (stringFromInt64 (count chained))))
        (assert (and (= realNoisy.exit 0) (= (count realNoisy) 0) (stringContains? realNoisy.out "gateVerdictInvalid")) (str "a suite that prints its own path-prefixed count is a duplicate verdict: " (stringFromInt64 (count realNoisy)) " in " realNoisy.out))
        (assert (and (none? (fr/executedOf pureTwoOne)) (stringContains? pureTwoOne "gateVerdictInvalid")) "two files declared and one verdict is no count")
        (assert (= (fr/executedOf pureTwoTwo) (some 3)) (str "two files and two verdicts read the last verdict: " pureTwoTwo))
        (assert (none? (fr/executedOf pureOtherPath)) "a verdict of an undeclared path is no count")
        (assert (none? (fr/executedOf pureNotLast)) "a verdict that is not the last line is no count")
        (assert (and (= (fr/executedOf pureRed) (some 2)) (stringContains? pureRed (str "FAIL " three ": ERR_ASSERT"))) (str "a declared FAIL verdict keeps its cause and count: " pureRed))
        (assert (none? (fr/executedOf pureDupFail)) "two FAIL verdicts for one file are no count")
        (assert (none? (fr/executedOf pureRunVerb)) "a verb other than test is no declared form")
        (assert (none? (fr/executedOf pureEvilHost)) "an absolute host other than the stand-in is no declared form")
        (assert (= (fr/executedOf pureStubHost) (some 3)) "the content-addressed stand-in host is a declared form")
        (assert (none? (fr/executedOf pureStubProd)) "production gateOut does not accept the stand-in host, only ./bin/asl bin/asl asl")
        (assert (and (= fresh (str probeRoot "/fresh/bin/asl")) (= again fresh) (= freshMode 448)) (str "a fresh private install: path returned, rewritten and verified on the second call, dir mode 700: " fresh " " (stringFromInt64 freshMode)))
        (assert (stringEmpty? planted) "a planted read-only dir is an error, never used")
        (assert (stringEmpty? opened) "a dir with mode 777 is an error, never used")
        (assert (stringEmpty? linked) "a symlinked dir is an error, never used")
        (assert (stringEmpty? link700) "a 0700 symlink to a 0700 owned dir is an error (symlink check isolated from the mode check)")
        (assert (not fileLinked) "a bin/asl symlink to a file holding the exact text is not verified")
        (assert (stringEmpty? dirAsl) "an install whose bin/asl is a directory fails the post-write verification, never returns a path")
        (assert (listEmpty? foreignDirs) (str "a 0700 directory owned by another user is not private: " (stringJoin foreignDirs ",")))
        (assert (and (= stubPath (fr/stubHostPath)) (= (resultOr (fileReadString stubPath) "") (fr/stubHostText))) "the stand-in host sits at its content-hash path and holds exactly its text")
        (assert (= (count ownGate) 3) (str "production runShell! runs the stand-in this process installed: " (stringFromInt64 (count ownGate))))
        (assert (and (not (stringEmpty? oldPath)) (= (count oldGate) 0)) (str "a private exact-text stand-in at the old fixed name is refused by production: " oldPath " " (stringFromInt64 (count oldGate))))
        (assert (and (not (stringEmpty? deadPath)) (= (count deadGate) 0)) (str "a private exact-text stand-in whose owner pid is dead is refused by production: " deadPath " " (stringFromInt64 (count deadGate))))
        (assert (and (not (stringEmpty? livePid)) (not (stringEmpty? livePath)) (= (count liveGate) 0)) (str "a private exact-text stand-in under a live pid that is not an ancestor is refused: " liveDir " " (stringFromInt64 (count liveGate))))
        (assert deadSwept "stubHost! sweeps a private stand-in dir whose owner pid is dead")
        (assert (removedClean) "stubRemove! leaves no aslStubHost dir of this process and no stub path")
        true))
