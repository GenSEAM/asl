(:leverTable :v 1 :about "candidate harness levers per failure class, hypotheses to test on the same cases, not findings" :date "2026-10-28")
(:lever :failClass typeOption :levers ("card type rule: stringIndexOf listHead listGet mapGet return Option, unwrap with match or optionOr" "card example pair for match on (some x) (none)" "checker feedback line quoted back verbatim in the retry frame"))
(:lever :failClass typeMismatch :levers ("card type rule: Int and Float never mix, int32ToInt64 only on Int32" "retry frame carries the checker line with line number" "route to a model with lower typeMismatch share"))
(:lever :failClass unknownSymbol :levers ("card: camelCase builtin list for the task family" "frame field: (:help :builtin) lookup before writing" "retry frame carries the nearest names"))
(:lever :failClass builtinArity :levers ("card: arity table for the 20 most used builtins" "retry frame carries the checker arity line"))
(:lever :failClass parseBracket :levers ("parser strip of fences and prose before checking" "card: function bodies are bare lines, parens close only their own forms" "autofix delimiter repair (:fix) before retry"))
(:lever :failClass protocol :levers ("frame or parser strip for echoed frames (TURNECHO)" "single-form reply rule in the card" "retry with the parse defect named"))
(:lever :failClass emptyReply :levers ("read reasoning fields when content is empty" "retry once on the same route" "route away after 2 empties"))
(:lever :failClass timeout :levers ("raise per-route timeout for slow models" "split the task into smaller turns" "route to a faster model for this intent"))
(:lever :failClass quota429 :levers ("pacing: subPace allowance per provider" "fallback route in the profile" "defer unit until window reset"))
(:lever :failClass upstream5xx :levers ("retry with backoff" "route balance away from the provider" "breaker cooldown"))
(:lever :failClass upstream4xx :levers ("key or model id check in the route" "drop the alias from the profile until fixed"))
(:lever :failClass ownsViolation :levers ("card: edit only paths in :owns" "frame field: owns listed before every edit turn" "reject-early message naming the owned set"))
(:lever :failClass vacuousGate :levers ("gate generator requires an assert that fails without the change" "plan row names the failing assert before the write"))
(:lever :failClass ioError :levers ("frame field: workspace root and relative path rule" "read before write"))
(:lever :failClass wrongAnswer :levers ("card: answer shape example for the case family" "feedback with precision and recall lines" "best-of-n with oracle gate"))
(:lever :failClass gateRedAssert :levers ("retry frame carries the first failing assert verbatim" "card: write the test first, show the red run"))
(:lever :failClass abandoned :levers ("wall budget and heartbeat so a dead session leaves a result row" "resume from the journal tail"))
(:lever :failClass sessionEscalated :levers ("read the last turn of the journal; escalation names seen and tried" "split the task or raise the model tier"))
(:lever :failClass sessionRejected :levers ("owns or gate preflight message back to the model" "narrow the task text"))
(:lever :failClass sessionFailed :levers ("read the journal tail for the first failing turn"))
(:lever :failClass hostBuild :levers ("rebuild host before the unit starts" "pin the base commit"))
(:lever :failClass gatewayFailed :levers ("inspect gateway log for the alias" "route fallback"))
(:lever :failClass unclassified :levers ("add the signature to failClasses.asn after reading the raw line"))
