(:failClassTable :v 1 :about "static failure classes, first match wins; :any are case-insensitive substrings of outcome plus first error line; :ex are real signatures that classify to their own row" :date "2026-10-28" :src "checker output of asl check, gateway outcome column, benchRun :why, Leon journals, CAL ledgers")
(:failClass :id typeOption :any ("found (option" "expected (option") :ex ("ERR_TYPE_MISMATCH return of f: expected String, found (Option Int64)" "ERR_TYPE_MISMATCH return of i: expected Int64, found (Option _)"))
(:failClass :id typeMismatch :any ("err_type_mismatch" "err_type_field" "err_type " "err_bad_constructor" "expected record, found" "cannot call a variant" "expected an integer, found" "expected a number, found" "expected string or bytes") :ex ("ERR_TYPE_MISMATCH argument to listHead: expected (List _), found String" "ERR_BAD_CONSTRUCTOR Row has no field profile; nothing staged" "ERR_TYPE 'cannot call a Variant'"))
(:failClass :id unknownSymbol :any ("err_unknown_symbol" "unbound symbol" "err_symbol_not_found" "err_unresolved_import" "err_not_exported") :ex ("ERR_UNKNOWN_SYMBOL unbound symbol: stringLen" "ERR_SYMBOL_NOT_FOUND no definition named fooBar" "ERR_UNRESOLVED_IMPORT closure load failed"))
