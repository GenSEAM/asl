(:line :text "ERR_TYPE_MISMATCH return of f: expected String, found (Option Int64)" :expect typeOption)
(:line :text "ERR_TYPE_MISMATCH argument to listHead: expected (List _), found String" :expect typeMismatch)
(:line :text "ERR_UNKNOWN_SYMBOL unbound symbol: stringLen" :expect unknownSymbol)
(:line :text "ERR_ARITY stringLength takes 1 argument(s), given 2" :expect builtinArity)
(:line :text "ERR_UNBALANCED unclosed (" :expect parseBracket)
(:line :text "ERR_PARSE unmatched ')'" :expect parseBracket)
(:line :text "session escalated parse-defect" :expect protocol)
(:line :text "gateway timeout" :expect timeout)
(:line :text "gateway 429" :expect quota429)
(:line :text "gateway breaker 600s" :expect quota429)
(:line :text "gateway 5xx" :expect upstream5xx)
(:line :text "ERR_TXN_ABORTED edit outside owns" :expect ownsViolation)
(:line :text "ERR_NO_GATES" :expect vacuousGate)
(:line :text "ERR_CONSTANT_ASSERT assertion condition is constant" :expect vacuousGate)
(:line :text "session escalated gate red" :expect gateRedAssert)
(:line :text "asserts failed after round -1" :expect gateRedAssert)
(:line :text "fileLineSet precision 15/17 recall 15/15" :expect wrongAnswer)
(:line :text "gateway empty" :expect emptyReply)
(:line :text "the harness printed something never seen before" :expect unclassified)
(:line :text "" :expect unclassified)
