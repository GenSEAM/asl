#!/usr/bin/env bash
set -e

echo "=== [ASL Pre-Commit Gates] Running Verification Chain ==="

# Set standard PATH
export PATH="/usr/local/bin:$PATH"

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT_DIR"

PYTHON=".venv/bin/python"
if [ ! -f "$PYTHON" ]; then
    PYTHON="python3"
fi

echo "--> 1/5: Grammar Conformance & Parity (validate.py)..."
$PYTHON grammar/validate.py

echo "--> 2/5: Closure & Executed Vocabulary Audit (closure_audit.py)..."
$PYTHON grammar/closure_audit.py

echo "--> 3/5: Prelude Code Generator Check (prelude/generate.py --check)..."
$PYTHON prelude/generate.py --check

echo "--> 4/5: Semantic Type & Scope Checker Gate (checker/gate.py)..."
$PYTHON checker/gate.py

echo "--> 5/6: Design Token Contrast & Layer Separation (web/scripts/check-tokens.mjs)..."
( cd web && node scripts/check-tokens.mjs > /dev/null )

echo "--> 6/6: Web Bundle & Deployment Pre-Flight (tools/deploy_check.py)..."
$PYTHON tools/deploy_check.py

echo "=== [ASL Pre-Commit Gates] ALL GATES PASSED CLEANLY ==="
exit 0
