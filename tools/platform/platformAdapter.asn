(:platformAdapter :v 1 :src ADR0081
  :summary "Declared host and platform OS adapter boundary specifications for native compilation."
  :targets [
    (:target :os "darwin" :arch "arm64" :format "Mach-O" :adapter "engine/asl.c" :abi "sysv-arm64")
    (:target :os "darwin" :arch "x86_64" :format "Mach-O" :adapter "engine/asl.c" :abi "sysv-x86_64")
    (:target :os "linux" :arch "x86_64" :format "ELF" :adapter "engine/asl.c" :abi "sysv-elf")
    (:target :os "windows" :arch "x86_64" :format "PE" :adapter "engine/asl.c" :abi "win64")
    (:target :os "wasi" :arch "wasm32" :format "WASM" :adapter "wasm32-wasi" :abi "wasi-preview1")
  ]
  :capabilities [
    :fsRead :fsWrite :fsStat :fsReaddir
    :procSpawn :procWait :procSignal
    :netSocket :timeMonotonic :memAlloc
  ]
)
