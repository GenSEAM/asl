(module ws/asl/tools/mesh/tests/secContainmentTest
  :x [runTests]
  :i [(ws/asl/tools/mesh/cmd :a cmd) (ws/asl/tools/mesh/board :a board)])

fn readFileSafe! p: String -> String
  (resultOr (fileReadString p) "")

fn dictField v: board/AsnValue key: String -> String
  (mt v
    ((board/asnDict entries)
      (mt (board/dictGet entries key)
        ((some val)
          (mt val
            ((board/asnStr s) s)
            (_ "")))
        ((none) "")))
    (_ ""))

fn makePatch tgt: String oldText: String newText: String -> String
  (str "(:replace :target \"" tgt "#f\" :old \"" oldText "\" :new \"" newText "\")")

fn buildLinkChain! root: String index: Int64 end: Int64 outside: String -> Bool
  (if (> index end)
    true
    (let [link (str root "/src/chain" (stringFromInt64 index))
          target (if (= index end) outside (str "chain" (stringFromInt64 (+ index 1))))
          _ (pathSymlink target link)]
      (buildLinkChain! root (+ index 1) end outside)))

fn ! runTests -> Bool
  (let [tmpRoot (optionOr (envGet "TMPDIR") "/tmp")
        resolvedTmpRoot (resultOr (realPath tmpRoot) tmpRoot)
        base (str resolvedTmpRoot "/sec4Test-" (stringFromInt64 (monotonicNs)))
        root (str base "/repo")
        outDir (str base "/out")
        outside (str outDir "/outside.txt")
        outsideSlashLock (str outDir "/victim_created_by_slash_lock")
        gitDir (str root "/.git")
        gitHead (str gitDir "/HEAD")
        srcDir (str root "/src/nested/deep")
        nestedFile (str srcDir "/app.asl")
        topFile (str root "/src/a.asl")
        slashFile (str root "/src/c.asl")
        bLockFile (str root "/src/b.lock")
        deepTargetFile (str root "/src/z.asl")
        lnkOut (str root "/lnk_out")
        lnkIn (str root "/lnk_in")
        lnkFile (str root "/lnk_file")
        gitLink (str root "/gitlink")
        sibRoot (str base "/r")
        sibOut (str base "/r2")
        sibFile (str sibOut "/x")
        _ (dirCreate base)
        _ (dirCreate outDir)
        _ (dirCreate (str root "/.asl/mem/gaps"))
        _ (dirCreate srcDir)
        _ (dirCreate gitDir)
        _ (dirCreate sibRoot)
        _ (dirCreate sibOut)
        _ (fileWrite outside "(+ x 1)\n")
        _ (fileWrite gitHead "ref: refs/heads/main\n")
        _ (fileWrite nestedFile "(+ x 1)\n")
        _ (fileWrite topFile "(+ x 1)\n")
        _ (fileWrite slashFile "(+ x 1)\n")
        _ (fileWrite bLockFile "(+ x 1)\n")
        _ (fileWrite deepTargetFile "(+ x 1)\n")
        _ (fileWrite sibFile "(+ x 1)\n")
        _ (pathSymlink outDir lnkOut)
        _ (pathSymlink (str root "/src/nested") lnkIn)
        _ (pathSymlink outside lnkFile)
        _ (pathSymlink gitDir gitLink)
        lockedFile (str root "/src/locked.asl")
        outsideLock (str outDir "/victim_created_by_lock.lock")
        outsideDoubleLock (str outDir "/victim_created_by_double_lock")
        outsideDeepLock (str outDir "/victim_created_by_deep_lock")
        lockedGitFile (str root "/src/locked_git.asl")
        lockedInFile (str root "/src/locked_in.asl")
        _ (fileWrite lockedFile "(+ x 1)\n")
        _ (fileWrite lockedGitFile "(+ x 1)\n")
        _ (fileWrite lockedInFile "(+ x 1)\n")
        _ (pathSymlink sibOut (str sibRoot "/sib"))
        _ (buildLinkChain! root 0 34 outsideDeepLock)
        _ (pathSymlink "chain0" (str root "/src/z.asl.lock"))
        _ (pathSymlink outsideLock (str root "/src/locked.asl.lock"))
        _ (pathSymlink gitHead (str root "/src/locked_git.asl.lock"))
        _ (pathSymlink topFile (str root "/src/locked_in.asl.lock"))
        _ (pathSymlink outsideSlashLock (str root "/src/c.asl.lock"))
        _ (pathSymlink outsideDoubleLock (str root "/src/b.lock.lock"))
        ctx (cmd/makeCtx root)
        sibCtx (cmd/makeCtx sibRoot)]
    (do
      (assert (= (cmd/normalizeRelPath "") (err "ERR_PATH_EMPTY")) "normalize rejects empty string")
      (assert (= (cmd/normalizeRelPath "   ") (err "ERR_PATH_EMPTY")) "normalize rejects blank whitespace")
      (assert (= (cmd/normalizeRelPath ".") (err "ERR_PATH_EMPTY")) "normalize rejects dot alone")
      (assert (= (cmd/normalizeRelPath "a/..") (err "ERR_PATH_EMPTY")) "normalize rejects canceled dot-dot to empty")
      (assert (= (cmd/normalizeRelPath "/etc/passwd") (err "ERR_PATH_ABSOLUTE")) "normalize rejects leading slash")
      (assert (= (cmd/normalizeRelPath "\\windows\\path") (err "ERR_PATH_ABSOLUTE")) "normalize rejects leading backslash")
      (assert (= (cmd/normalizeRelPath "src/a\x00b.asl") (err "ERR_PATH_NUL_BYTE")) "normalize rejects raw NUL byte")
      (assert (= (cmd/normalizeRelPath "src/a\\0b.asl") (ok (list "src" "a\\0b.asl"))) "normalize accepts literal backslash-zero text")
      (assert (= (cmd/normalizeRelPath "../outside.txt") (err "ERR_PATH_TRAVERSAL")) "normalize rejects leading ..")
      (assert (= (cmd/normalizeRelPath "src/../../outside.txt") (err "ERR_PATH_TRAVERSAL")) "normalize rejects underflowing ..")
      (assert (= (cmd/normalizeRelPath "..") (err "ERR_PATH_TRAVERSAL")) "normalize rejects .. alone")
      (assert (= (cmd/normalizeRelPath "a/b/../../../c") (err "ERR_PATH_TRAVERSAL")) "normalize rejects deep traversal")
      (assert (= (cmd/normalizeRelPath ".git") (err "ERR_PATH_GIT")) "normalize rejects .git alone")
      (assert (= (cmd/normalizeRelPath ".git/config") (err "ERR_PATH_GIT")) "normalize rejects .git/config")
      (assert (= (cmd/normalizeRelPath "src/../.git/HEAD") (err "ERR_PATH_GIT")) "normalize rejects normalized path into .git")
      (assert (= (cmd/normalizeRelPath ".git/hooks/pre-commit") (err "ERR_PATH_GIT")) "normalize rejects .git hooks")
      (assert (= (cmd/normalizeRelPath "src/.GiT/config") (err "ERR_PATH_GIT")) "normalize rejects mixed-case .git component on case-sensitive hosts")
      (assert (= (cmd/normalizeRelPath "src/nested/deep/app.asl") (ok (list "src" "nested" "deep" "app.asl"))) "normalize accepts legitimate nested path")
      (assert (= (cmd/normalizeRelPath "src/nested/../nested/deep/app.asl") (ok (list "src" "nested" "deep" "app.asl"))) "normalize accepts safe internal ..")
      (assert (= (cmd/normalizeRelPath "src/.gitignore") (ok (list "src" ".gitignore"))) "normalize accepts literal .gitignore")
      (assert (= (cmd/normalizeRelPath "src/git_helper.asl") (ok (list "src" "git_helper.asl"))) "normalize accepts literal git in filename")
      (assert (= (cmd/normalizeRelPath "src/a..b.asl") (ok (list "src" "a..b.asl"))) "normalize accepts double-dot inside filename")

      (assert (= (cmd/resolveFixTarget! root "") (err "ERR_PATH_EMPTY")) "resolveFixTarget rejects empty")
      (assert (= (cmd/resolveFixTarget! root "/outside.txt") (err "ERR_PATH_ABSOLUTE")) "resolveFixTarget rejects absolute")
      (assert (= (cmd/resolveFixTarget! root "src/a\x00.asl") (err "ERR_PATH_NUL_BYTE")) "resolveFixTarget rejects NUL byte")
      (assert (= (cmd/resolveFixTarget! root "../outside.txt") (err "ERR_PATH_TRAVERSAL")) "resolveFixTarget rejects traversal")
      (assert (= (cmd/resolveFixTarget! root ".git/HEAD") (err "ERR_PATH_GIT")) "resolveFixTarget rejects .git target")
      (assert (= (cmd/resolveFixTarget! root "lnk_out/outside.txt") (err "ERR_PATH_ESCAPE")) "resolveFixTarget rejects symlink escape")
      (assert (= (cmd/resolveFixTarget! root "src/nested/deep/app.asl") (ok nestedFile)) "resolveFixTarget resolves legitimate nested path")
      (assert (= (cmd/resolveFixTarget! root "lnk_in/deep/app.asl") (ok (str root "/lnk_in/deep/app.asl"))) "resolveFixTarget accepts in-tree symlink")
      (assert (= (cmd/resolveFixTarget! sibRoot "sib/x") (err "ERR_PATH_ESCAPE")) "resolveFixTarget rejects sibling prefix escape")
      (assert (= (cmd/resolveFixTarget! root "lnk_out/nonexistent.txt") (err "ERR_PATH_ESCAPE")) "resolveFixTarget rejects non-existent target under escaping symlink dir")
      (assert (= (cmd/resolveFixTarget! root "lnk_file") (err "ERR_PATH_ESCAPE")) "resolveFixTarget rejects final-component symlink pointing outside")
      (assert (= (cmd/resolveFixTarget! root ".GIT/config") (err "ERR_PATH_GIT")) "resolveFixTarget rejects .GIT/config via parent check")
      (assert (= (cmd/resolveFixTarget! root "gitlink/config") (err "ERR_PATH_GIT")) "resolveFixTarget rejects gitlink/config via parent check")
      (assert (= (cmd/resolveFixTarget! root "src/locked.asl") (err "ERR_PATH_ESCAPE")) "resolveFixTarget rejects target whose .lock sibling escapes")
      (assert (= (cmd/resolveFixTarget! root "src/locked_git.asl") (err "ERR_PATH_GIT")) "resolveFixTarget rejects target whose .lock sibling enters .git")
      (assert (= (cmd/resolveFixTarget! root "src/locked_in.asl") (ok lockedInFile)) "resolveFixTarget accepts target whose .lock sibling is in-tree")

      (let [resDots (cmd/applyPatch! ctx "D-DOTS" (makePatch "../outside.txt" "(+ x 1)" "(+ x 2)"))
            resAbs (cmd/applyPatch! ctx "D-ABS" (makePatch outside "(+ x 1)" "(+ x 2)"))
            resNul (cmd/applyPatch! ctx "D-NUL" (makePatch "src/a\x00.asl" "(+ x 1)" "(+ x 2)"))
            resGit (cmd/applyPatch! ctx "D-GIT" (makePatch ".git/HEAD" "(+ x 1)" "(+ x 2)"))
            resLink (cmd/applyPatch! ctx "D-LINK" (makePatch "lnk_out/outside.txt" "(+ x 1)" "(+ x 2)"))
            resSib (cmd/applyPatch! sibCtx "D-SIB" (makePatch "sib/x" "(+ x 1)" "(+ x 2)"))
            resNonEx (cmd/applyPatch! ctx "D-NONEX" (makePatch "lnk_out/nonexistent.txt" "(+ x 1)" "(+ x 2)"))
            resFileLnk (cmd/applyPatch! ctx "D-FLNK" (makePatch "lnk_file" "(+ x 1)" "(+ x 2)"))
            resGitCase (cmd/applyPatch! ctx "D-GITCASE" (makePatch ".GIT/config" "(+ x 1)" "(+ x 2)"))
            resGitLnk (cmd/applyPatch! ctx "D-GITLNK" (makePatch "gitlink/config" "(+ x 1)" "(+ x 2)"))
            resLockSlash (cmd/applyPatch! ctx "D-SLASHLOCK" (makePatch "src/c.asl/" "(+ x 1)" "(+ x 2)"))
            resDoubleLock (cmd/applyPatch! ctx "D-DOUBLELOCK" (makePatch "src/b.lock" "(+ x 1)" "(+ x 2)"))
            resDeepLock (cmd/applyPatch! ctx "D-DEEPLOCK" (makePatch "src/z.asl" "(+ x 1)" "(+ x 2)"))
            resLock (cmd/applyPatch! ctx "D-LOCK" (makePatch "src/locked.asl" "(+ x 1)" "(+ x 2)"))
            resLockGit (cmd/applyPatch! ctx "D-LOCKGIT" (makePatch "src/locked_git.asl" "(+ x 1)" "(+ x 2)"))]
        (do
          (assert (= (dictField (resultOr resDots (board/asnStr "")) "status") "rejected") "applyPatch rejects ../")
          (assert (= (dictField (resultOr resDots (board/asnStr "")) "error") "ERR_PATH_TRAVERSAL") "applyPatch returns named error ERR_PATH_TRAVERSAL")
          (assert (= (dictField (resultOr resAbs (board/asnStr "")) "status") "rejected") "applyPatch rejects absolute path")
          (assert (= (dictField (resultOr resAbs (board/asnStr "")) "error") "ERR_PATH_ABSOLUTE") "applyPatch returns named error ERR_PATH_ABSOLUTE")
          (assert (= (dictField (resultOr resNul (board/asnStr "")) "status") "rejected") "applyPatch rejects NUL byte")
          (assert (= (dictField (resultOr resNul (board/asnStr "")) "error") "ERR_PATH_NUL_BYTE") "applyPatch returns named error ERR_PATH_NUL_BYTE")
          (assert (= (dictField (resultOr resGit (board/asnStr "")) "status") "rejected") "applyPatch rejects .git path")
          (assert (= (dictField (resultOr resGit (board/asnStr "")) "error") "ERR_PATH_GIT") "applyPatch returns named error ERR_PATH_GIT")
          (assert (= (dictField (resultOr resLink (board/asnStr "")) "status") "rejected") "applyPatch rejects symlink escape")
          (assert (= (dictField (resultOr resLink (board/asnStr "")) "error") "ERR_PATH_ESCAPE") "applyPatch returns named error ERR_PATH_ESCAPE")
          (assert (= (dictField (resultOr resSib (board/asnStr "")) "status") "rejected") "applyPatch rejects sibling prefix escape")
          (assert (= (dictField (resultOr resSib (board/asnStr "")) "error") "ERR_PATH_ESCAPE") "applyPatch returns ERR_PATH_ESCAPE for sibling escape")
          (assert (= (dictField (resultOr resNonEx (board/asnStr "")) "status") "rejected") "applyPatch rejects non-existent target in escaping dir")
          (assert (= (dictField (resultOr resNonEx (board/asnStr "")) "error") "ERR_PATH_ESCAPE") "applyPatch returns ERR_PATH_ESCAPE for non-existent target")
          (assert (= (dictField (resultOr resFileLnk (board/asnStr "")) "status") "rejected") "applyPatch rejects final symlink pointing outside")
          (assert (= (dictField (resultOr resFileLnk (board/asnStr "")) "error") "ERR_PATH_ESCAPE") "applyPatch returns ERR_PATH_ESCAPE for final symlink")
          (assert (= (dictField (resultOr resGitCase (board/asnStr "")) "status") "rejected") "applyPatch rejects .GIT/config")
          (assert (= (dictField (resultOr resGitCase (board/asnStr "")) "error") "ERR_PATH_GIT") "applyPatch returns ERR_PATH_GIT for .GIT/config")
          (assert (= (dictField (resultOr resGitLnk (board/asnStr "")) "status") "rejected") "applyPatch rejects gitlink/config")
          (assert (= (dictField (resultOr resGitLnk (board/asnStr "")) "error") "ERR_PATH_GIT") "applyPatch returns ERR_PATH_GIT for gitlink/config")
          (assert (= (dictField (resultOr resLockSlash (board/asnStr "")) "status") "rejected") "applyPatch rejects slash-normalized target with escaping .lock sibling")
          (assert (err? (fileStat outsideSlashLock)) "slash-normalized escaping lock target was not created")
          (assert (= (dictField (resultOr resDoubleLock (board/asnStr "")) "status") "rejected") "applyPatch rejects target ending in .lock with escaping .lock.lock sibling")
          (assert (err? (fileStat outsideDoubleLock)) "double-lock escaping target was not created")
          (assert (= (dictField (resultOr resDeepLock (board/asnStr "")) "status") "rejected") "applyPatch rejects deep symlink chain ending outside")
          (assert (= (dictField (resultOr resDeepLock (board/asnStr "")) "error") "ERR_PATH_ESCAPE") "deep symlink chain rejection reports containment failure")
          (assert (err? (fileStat outsideDeepLock)) "deep-chain escaping lock file was not created")
          (assert (= (dictField (resultOr resLock (board/asnStr "")) "status") "rejected") "applyPatch rejects target with escaping .lock sibling")
          (assert (= (dictField (resultOr resLock (board/asnStr "")) "error") "ERR_PATH_ESCAPE") "applyPatch returns ERR_PATH_ESCAPE for escaping .lock")
          (assert (err? (fileStat outsideLock)) "outside lock file was NOT created by withFileLock")
          (assert (= (dictField (resultOr resLockGit (board/asnStr "")) "status") "rejected") "applyPatch rejects target with .git .lock sibling")
          (assert (= (dictField (resultOr resLockGit (board/asnStr "")) "error") "ERR_PATH_GIT") "applyPatch returns ERR_PATH_GIT for .git .lock")
          (assert (= (readFileSafe! outside) "(+ x 1)\n") "outside file untouched after rejected escape attempts")
          (assert (= (readFileSafe! gitHead) "ref: refs/heads/main\n") ".git/HEAD untouched after rejected git attempt")
          (assert (= (readFileSafe! sibFile) "(+ x 1)\n") "sibling outside file untouched after rejected escape attempt")))

      (let [raceDir (str root "/race")
            escapedCreated (str outDir "/created_after_parent_swap")
            _ (dirCreate raceDir)
            validated (cmd/resolveFixTarget! root "race/created_after_parent_swap")
            _ (pathRemove raceDir)
            _ (pathSymlink outDir raceDir)
            opened (fileWriteAt root "race/created_after_parent_swap" "must-not-escape")]
        (do
          (assert (ok? validated) "race target passed ASL validation before swap")
          (assert (= opened (err "ERR_PATH_SYMLINK")) "openat rejects parent symlink after validation")
          (assert (err? (fileStat escapedCreated)) "outside file stays absent after parent swap")))

      (let [readSwapTarget (str root "/src/read_leaf_swap")
            attackerRead (str outDir "/attacker_read_sentinel")
            _ (fileWrite attackerRead "attacker content")
            _ (fileWrite readSwapTarget "original content")
            validatedRead (cmd/resolveFixTarget! root "src/read_leaf_swap")
            _ (pathRemove readSwapTarget)
            _ (pathSymlink attackerRead readSwapTarget)
            readRefused (fileReadAt root "src/read_leaf_swap")]
        (do
          (assert (ok? validatedRead) "leaf read target validated before leaf-only swap")
          (assert (= readRefused (err "ERR_PATH_SYMLINK")) "dirfd read refuses swapped leaf with ERR_PATH_SYMLINK")
          (assert (= (readFileSafe! attackerRead) "attacker content") "attacker read sentinel unchanged")))

      (let [writeLinkTarget (str root "/src/write_link_target")
            writeLinkAlias (str root "/src/write_link_alias")
            _ (fileWrite writeLinkTarget "original linked content")
            linkResult (processRun (str "ln '" writeLinkTarget "' '" writeLinkAlias "'"))
            writeLinkResult (fileWriteAt root "src/write_link_target" "replacement content")]
        (do
          (assert (= linkResult.exitCode 0) "hard-link test fixture created")
          (assert (ok? writeLinkResult) "atomic write replaces regular target")
          (assert (= (readFileSafe! writeLinkTarget) "replacement content") "atomic write installs replacement content")
          (assert (= (readFileSafe! writeLinkAlias) "original linked content") "atomic write leaves original hard-link content intact")))

      (let [writeTargetDir (str root "/src/write_target_dir")
            _ (dirCreate writeTargetDir)
            refusedDirWrite (fileWriteAt root "src/write_target_dir" "replacement")
            srcNames (resultOr (dirList (str root "/src")) (list))
            srcNamesText (stringJoin srcNames "\n")]
        (do
          (assert (= refusedDirWrite (err "ERR_PATH_TYPE")) "atomic write refuses directory leaf with ERR_PATH_TYPE")
          (assert (ok? (fileStat writeTargetDir)) "failed write leaves original directory target intact")
          (assert (not (stringContains? srcNamesText ".asl-write-")) "failed write leaves no atomic temp file")))

      (let [targetLink (str root "/src/open_target_link")
            outsideTarget (str outDir "/open_target_sentinel")
            lockLink (str root "/src/open_lock_link.lock")
            outsideLockTarget (str outDir "/open_lock_sentinel")
            _ (fileWrite outsideTarget "target sentinel")
            _ (fileWrite outsideLockTarget "lock sentinel")
            _ (pathSymlink outsideTarget targetLink)
            _ (pathSymlink outsideLockTarget lockLink)
            writeRefused (fileWriteAt root "src/open_target_link" "overwrite")
            lockRefused (fileLockAt root "src/open_lock_link.lock" true)]
        (do
          (assert (= writeRefused (err "ERR_PATH_SYMLINK")) "target open rejects final symlink with named error")
          (assert (= (readFileSafe! outsideTarget) "target sentinel") "outside target sentinel is unchanged")
          (assert (= lockRefused (err "ERR_PATH_SYMLINK")) "lock open rejects final symlink with named error")
          (assert (= (readFileSafe! outsideLockTarget) "lock sentinel") "outside lock sentinel is unchanged")))

      (let [parentLink (str root "/src/open_parent_link")
            _ (pathSymlink outDir parentLink)
            refused (fileWriteAt root "src/open_parent_link/open_parent_sentinel" "overwrite")]
        (do
          (assert (= refused (err "ERR_PATH_SYMLINK")) "openat rejects symlinked parent component")
          (assert (err? (fileStat (str outDir "/open_parent_sentinel"))) "outside parent target remains absent")))

      (let [resInLink (cmd/applyPatch! ctx "D-INLINK" (makePatch "lnk_in/deep/app.asl" "(+ x 1)" "(+ x 8)"))]
        (do
          (assert (= (dictField (resultOr resInLink (board/asnStr "")) "status") "rejected") "applyPatch refuses an in-tree symlink at secure open")
          (assert (= (dictField (resultOr resInLink (board/asnStr "")) "error") "ERR_PATH_SYMLINK") "applyPatch returns named open-time symlink error")
          (assert (= (readFileSafe! outside) "(+ x 1)\n") "outside target is unchanged after applyPatch symlink refusal")))
      (let [resNested (cmd/applyPatch! ctx "D-OK" (makePatch "src/nested/deep/app.asl" "(+ x 1)" "(+ x 2)"))
            resTop (cmd/applyPatch! ctx "D-TOP" (makePatch "src/a.asl" "(+ x 1)" "(+ x 3)"))
            resLockIn (cmd/applyPatch! ctx "D-LOCKIN" (makePatch "src/locked_in.asl" "(+ x 1)" "(+ x 4)"))]
        (do
          (assert (= (dictField (resultOr resNested (board/asnStr "")) "status") "applied") "applyPatch applies legitimate nested fix")
          (assert (= (readFileSafe! nestedFile) "(+ x 2)\n") "nested file updated in place by applyPatch")
          (assert (= (dictField (resultOr resTop (board/asnStr "")) "status") "applied") "applyPatch applies legitimate top-level fix")
          (assert (= (readFileSafe! topFile) "(+ x 3)\n") "top-level file updated in place by applyPatch")
          (assert (= (dictField (resultOr resLockIn (board/asnStr "")) "status") "rejected") "applyPatch refuses in-tree symlink lock component")
          (assert (= (dictField (resultOr resLockIn (board/asnStr "")) "error") "ERR_PATH_SYMLINK") "applyPatch names lock symlink refusal")
          (assert (= (readFileSafe! lockedInFile) "(+ x 1)\n") "lock symlink refusal leaves target unchanged")))

      (assert (ok? (pathRemove base)) "failed to remove containment test tree")
      true))
