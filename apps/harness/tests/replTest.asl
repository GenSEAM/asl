(module aslHarness/replTest :x [testEvalExpression testPatchAstNode testSemanticErrorFormatting runTests] :i [(repl :a repl)])

fn testEvalExpression -> Bool
  (let [(sess0 (repl/newReplSession "sess-alpha")) (resAdd (repl/evalExpression sess0 "(+ 10 20)")) (resMul (repl/evalExpression sess0 "(* 6 7)")) (resSub (repl/evalExpression sess0 "(- 50 8)")) (resLit (repl/evalExpression sess0 "42")) (resBool (repl/evalExpression sess0 "true")) (sessBound (repl/ReplSession :sessionId "sess-beta" :bindings (mapSet (mapEmpty) "x" "15") :history (list))) (resBound (repl/evalExpression sessBound "(+ x 5)")) (resDiv0 (repl/evalExpression sess0 "(/ 10 0)")) (resUnbalanced (repl/evalExpression sess0 "(+ 10 20")) (resEmpty (repl/evalExpression sess0 ""))] (assert (= sess0.sessionId "sess-alpha") "session id matches") (assert resAdd.success "res-add success") (assert (= resAdd.output "30") "res-add output is 30") (assert (< resAdd.latencyMicros 50) "res-add latency < 50") (assert resMul.success "res-mul success") (assert (= resMul.output "42") "res-mul output is 42") (assert (< resMul.latencyMicros 50) "res-mul latency < 50") (assert resSub.success "res-sub success") (assert (= resSub.output "42") "res-sub output is 42") (assert resLit.success "res-lit success") (assert (= resLit.output "42") "res-lit output is 42") (assert resBool.success "res-bool success") (assert (= resBool.output "true") "res-bool output is true") (assert resBound.success "res-bound success") (assert (= resBound.output "20") "res-bound output is 20") (assert (< resBound.latencyMicros 50) "res-bound latency < 50") (assert (not resDiv0.success) "div0 failed") (assert (stringContains? resDiv0.errorDetail "Division by zero") "div0 error message") (assert (not resUnbalanced.success) "unbalanced failed") (assert (stringContains? resUnbalanced.errorDetail "Unbalanced delimiters") "unbalanced error message") (assert (not resEmpty.success) "empty failed") (assert (stringContains? resEmpty.errorDetail "Empty expression") "empty error message") true)

fn testPatchAstNode -> Bool
  (let [(src1 "(fn calc [(x I64)] (+ x 10))") (patched1 (repl/patchAstNode src1 "(+ x 10)" "(* x 2)")) (src2 "(fn old-calc [(x I64)] (+ x 10))") (patched2 (repl/patchAstNode src2 "old-calc" "new-calc")) (src3 "(fn calc [(x I64)] (+ x 10))") (patched3 (repl/patchAstNode src3 "non-existent" "foo")) (patched4 (repl/patchAstNode src3 "" "foo"))] (assert (= patched1 "(fn calc [(x I64)] (* x 2))") "patched1 matches") (assert (= patched2 "(fn new-calc [(x I64)] (+ x 10))") "patched2 matches") (assert (= patched3 src3) "patched3 unchanged") (assert (= patched4 src3) "patched4 unchanged") true)

fn testSemanticErrorFormatting -> Bool
  (let [(err (repl/formatSemanticError "defun" "deprecated syntax: use fn instead" 42))] (assert (stringContains? err "defun") "contains defun") (assert (stringContains? err "deprecated syntax: use fn instead") "contains deprecated syntax") (assert (stringContains? err "42") "contains line 42") (assert (stringContains? err "SemanticError") "contains SemanticError") true)

fn runTests -> Bool
  (do (testEvalExpression) (testPatchAstNode) (testSemanticErrorFormatting) true)
