(module aslHarness/fsmNormalizerTest :x [testKeywordNormalization testDelimiterAutoBalance testNestedFormRepair runTests] :i [(fsmNormalizer :a fsm)])

fn testKeywordNormalization -> Bool
  (let [(t1 (= (fsm/normalizeKeywords "defun") "fn")) (t2 (= (fsm/normalizeKeywords "defn") "fn")) (t3 (= (fsm/normalizeKeywords "lambda") "fn")) (t4 (= (fsm/normalizeKeywords (str "(" "defun add [(x I64) (y I64)] -> I64 (+ x y))")) "(fn add [(x I64) (y I64)] -> I64 (+ x y))")) (t5 (= (fsm/normalizeKeywords "(defn sub [(x I64) (y I64)] -> I64 (- x y))") "(fn sub [(x I64) (y I64)] -> I64 (- x y))")) (t6 (= (fsm/normalizeKeywords "(map (lambda [(x I64)] (+ x 1)) xs)") "(map (fn [(x I64)] (+ x 1)) xs)")) (t7 (= (fsm/normalizeKeywords "(lambda [(x I64)] (* x 2))") "(fn [(x I64)] (* x 2))")) (fr (fsm/FsmResult :repaired "true" :openParens 0 :openBrackets 0 :balanced? true))] (assert t1 "defun -> fn") (assert t2 "defn -> fn") (assert t3 "lambda -> fn") (assert t4 "defun signature normalized") (assert t5 "defn signature normalized") (assert t6 "lambda in map normalized") (assert t7 "lambda expr normalized") (assert (not (stringEmpty? fr.repaired)) "FsmResult repaired string is not empty") (assert fr.balanced? "FsmResult balanced is true") true)

fn testDelimiterAutoBalance -> Bool
  (let [(clean "(fn greet [(name Str)] -> Str (str \"hello \" name))") (rClean (fsm/balanceDelimitersFsm clean)) (dirtyParens "(fn compute [(x I64)] (+ x 1") (rParens (fsm/balanceDelimitersFsm dirtyParens)) (dirtyStr "(fn prompt [] \"unclosed string") (rStr (fsm/balanceDelimitersFsm dirtyStr)) (withDelimsInStr "(fn show [] \"(ignore [delimiters] in strings)\")") (rWithDelims (fsm/balanceDelimitersFsm withDelimsInStr))] (assert rClean.balanced? "clean is balanced") (assert (= rClean.openParens 0) "clean open parens is 0") (assert (= rClean.openBrackets 0) "clean open brackets is 0") (assert (= rClean.repaired clean) "clean repaired matches") (assert (not rParens.balanced?) "dirty parens not balanced") (assert (= rParens.openParens 2) "dirty open parens is 2") (assert (= rParens.openBrackets 0) "dirty open brackets is 0") (assert (= rParens.repaired "(fn compute [(x I64)] (+ x 1))") "dirty parens repaired") (assert (not rStr.balanced?) "dirty str not balanced") (assert (= rStr.openParens 1) "dirty str open parens is 1") (assert (= rStr.openBrackets 0) "dirty str open brackets is 0") (assert (= rStr.repaired "(fn prompt [] \"unclosed string\")") "dirty str repaired") (assert rWithDelims.balanced? "with delims in str is balanced") (assert (= rWithDelims.openParens 0) "with delims open parens is 0") (assert (= rWithDelims.openBrackets 0) "with delims open brackets is 0") (assert (= rWithDelims.repaired withDelimsInStr) "with delims repaired matches") true)

fn testNestedFormRepair -> Bool
  (let [(nestedLet "(let [(a 1) (b 2") (rNested (fsm/balanceDelimitersFsm nestedLet)) (deep "(fn compute [(items (List I64))] (let [(x 10)] (if (> x 0) (+ x 5") (rDeep (fsm/balanceDelimitersFsm deep)) (dirtyFull (str "(" "defun calc [(vals (List I64))] (map (lambda [(v I64)] (* v 2)) (let [(init 0")) (repairedFull (fsm/repairSyntaxFsm dirtyFull))] (assert (not rNested.balanced?) "nested not balanced") (assert (= rNested.openParens 2) "nested open parens is 2") (assert (= rNested.openBrackets 1) "nested open brackets is 1") (assert (= rNested.repaired "(let [(a 1) (b 2)])") "nested repaired matches") (assert (not rDeep.balanced?) "deep not balanced") (assert (= rDeep.openParens 4) "deep open parens is 4") (assert (= rDeep.openBrackets 0) "deep open brackets is 0") (assert (= rDeep.repaired "(fn compute [(items (List I64))] (let [(x 10)] (if (> x 0) (+ x 5))))") "deep repaired matches") (assert (= repairedFull "(fn calc [(vals (List I64))] (map (fn [(v I64)] (* v 2)) (let [(init 0)])))") "full syntax repair matches") true)

fn runTests -> Bool
  (do (testKeywordNormalization) (testDelimiterAutoBalance) (testNestedFormRepair) true)
