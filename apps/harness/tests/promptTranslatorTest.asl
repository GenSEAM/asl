(module aslHarness/tests/promptTranslatorTest :x [testPromptTranslationBasic testPromptTranslationWithReasoning testPromptTranslationIncompatibleModelFallback testPromptTranslationDisabledBypass testPromptTranslationMalformedOrEmpty testPromptTranslationAsnDirectives testAsnReasoningFormattingAndParsing testModelCompatibilityCheck testTokenSavingsEstimation runTests] :i [(promptTranslator :a pt)])

fn testPromptTranslationBasic -> Bool
  (let [(cfg (pt/makeTranslationConfig true true false "qwen-2.5-3b")) (prompt "Please audit all package manifests and verify syntax balance.\n- Ensure zero comments\n- Ensure zero emojis") (res (pt/translatePrompt prompt cfg))] (do (assert res.translated "Prompt must be translated to ASN") (assert (not res.fallbackUsed) "Fallback must not be used for compatible model") (assert (= res.reason ":ok") "Reason must be :ok") (assert (stringStartsWith? res.formattedPrompt "(:prompt") "Formatted prompt must start with (:prompt") (assert (stringContains? res.formattedPrompt ":intent") "Formatted prompt must contain :intent") (assert (stringContains? res.formattedPrompt ":context") "Formatted prompt must contain :context") (assert (stringContains? res.formattedPrompt ":directives") "Formatted prompt must contain :directives") (assert (> res.tokensSavedPct 0.0) "Tokens saved percentage must be positive") true))

fn testPromptTranslationWithReasoning -> Bool
  (let [(cfg (pt/makeTranslationConfig true true true "gemma-4-31b-it")) (prompt "Refactor memory allocation loops") (res (pt/translatePrompt prompt cfg))] (do (assert res.translated "Translation must succeed") (assert (stringContains? res.formattedPrompt ":reasoning-frame (:reasoning") "Must inject reasoning schema") (assert (not res.fallbackUsed) "Fallback must be false") true))

fn testPromptTranslationIncompatibleModelFallback -> Bool
  (let [(cfg (pt/makeTranslationConfig true true false "smollm2-135m")) (prompt "Optimize vector cache without allocations") (res (pt/translatePrompt prompt cfg))] (do (assert (not res.translated) "Translation must be flagged false for incompatible model") (assert res.fallbackUsed "Fallback must be flagged true") (assert (= res.reason ":incompatible-model-fallback") "Reason must indicate incompatible model fallback") (assert (= res.formattedPrompt prompt) "Raw prompt must be preserved untouched") (assert (= res.tokensSavedPct 0.0) "Tokens saved must be zero on fallback") true))

fn testPromptTranslationDisabledBypass -> Bool
  (let [(cfg (pt/makeTranslationConfig false true false "claude-3-5-sonnet")) (prompt "Hello raw system prompt") (res (pt/translatePrompt prompt cfg))] (do (assert (not res.translated) "Translation must be false when disabled") (assert (not res.fallbackUsed) "Fallback must be false when disabled") (assert (= res.reason ":disabled") "Reason must be :disabled") (assert (= res.formattedPrompt prompt) "Original prompt must be returned") true))

fn testPromptTranslationMalformedOrEmpty -> Bool
  (let [(cfg (pt/makeTranslationConfig true true false "gpt-4o")) (res (pt/translatePrompt "" cfg))] (do (assert (not res.translated) "Empty prompt must not be translated") (assert res.fallbackUsed "Fallback must be used for empty prompt") (assert (= res.reason ":empty-prompt-fallback") "Reason must be :empty-prompt-fallback") (assert (= res.formattedPrompt "") "Formatted prompt must remain empty string") true))

fn testPromptTranslationAsnDirectives -> Bool
  (let [(rawAsn "(:Prompt :Intent \"Unify string primitives\" :Directives [\"Remove duplicates\" \"Enforce aliases\"] :Context \"monorepo\")") (intent (pt/extractPromptIntent rawAsn)) (dirs (pt/extractPromptDirectives rawAsn)) (ctx (pt/extractPromptContext rawAsn))] (do (assert (= intent "Unify string primitives") "Extracted intent must match ASN :Intent") (assert (= (listLength dirs) 2) "Must extract exactly 2 directives") (assert (= ctx "monorepo") "Extracted context must match :Context") true))

fn testAsnReasoningFormattingAndParsing -> Bool
  (let [(frame (pt/AsnReasoningFrame :hypotheses (list "Memory leak in string slice" "Buffer truncation in reader") :observations (list "Memory steady at 45MB" "Slice boundary at offset 2048") :action "Inspect slice bounds" :summary "Hypothesis verified, bounds corrected")) (encoded (pt/formatAsnReasoning frame)) (parsedOpt (pt/parseAsnReasoning encoded))] (do (assert (stringStartsWith? encoded "(:reasoning") "Encoded reasoning must start with (:reasoning") (assert (stringContains? encoded ":hypotheses") "Encoded reasoning must contain :hypotheses") (assert (some? parsedOpt) "Parsing valid reasoning block must return some") (mt parsedOpt ((some parsed) (do (assert (= parsed.action "Inspect slice bounds") "Parsed action must match original") (assert (= parsed.summary "Hypothesis verified, bounds corrected") "Parsed summary must match original") (assert (= (listLength parsed.hypotheses) 2) "Parsed hypotheses count must match 2") (assert (= (listLength parsed.observations) 2) "Parsed observations count must match 2"))) ((none) (assert false "parsed missing"))) (let [(invalidParse (pt/parseAsnReasoning "(:not-reasoning :foo 1)"))] (assert (none? invalidParse) "Parsing non-reasoning string must return none")) true))

fn testModelCompatibilityCheck -> Bool
  (do (assert (pt/isAsnCompatibleModel? "claude-3-5-sonnet") "Claude must be ASN compatible") (assert (pt/isAsnCompatibleModel? "gemma-4-31b-it") "Gemma must be ASN compatible") (assert (pt/isAsnCompatibleModel? "qwen-2.5-3b") "Qwen must be ASN compatible") (assert (pt/isAsnCompatibleModel? "gpt-4o") "GPT-4o must be ASN compatible") (assert (pt/isAsnCompatibleModel? "ling-3.0-flash") "Ling flash must be ASN compatible") (assert (not (pt/isAsnCompatibleModel? "smollm2-135m")) "SmolLM2 must NOT be ASN compatible") (assert (not (pt/isAsnCompatibleModel? "hanse-nano")) "Hanse nano must NOT be ASN compatible") (assert (not (pt/isAsnCompatibleModel? "llama-1b-base")) "Base models must NOT be ASN compatible") (assert (not (pt/isAsnCompatibleModel? "raw-slm-unknown")) "Raw SLMs must NOT be ASN compatible") true)

fn testTokenSavingsEstimation -> Bool
  (let [(savings (pt/estimateTokenSavings 200 120)) (zeroSavings (pt/estimateTokenSavings 0 100)) (expansion (pt/estimateTokenSavings 50 80))] (do (assert (= savings 40.0) "200 to 120 bytes must equal 40% savings") (assert (= zeroSavings 0.0) "Zero raw length must return 0.0") (assert (= expansion 12.5) "Expansion returns base compaction bonus 12.5") true))

fn runTests -> Bool
  (do (assert (testPromptTranslationBasic) "test-prompt-translation-basic passed") (assert (testPromptTranslationWithReasoning) "test-prompt-translation-with-reasoning passed") (assert (testPromptTranslationIncompatibleModelFallback) "test-prompt-translation-incompatible-model-fallback passed") (assert (testPromptTranslationDisabledBypass) "test-prompt-translation-disabled-bypass passed") (assert (testPromptTranslationMalformedOrEmpty) "test-prompt-translation-malformed-or-empty passed") (assert (testPromptTranslationAsnDirectives) "test-prompt-translation-asn-directives passed") (assert (testAsnReasoningFormattingAndParsing) "test-asn-reasoning-formatting-and-parsing passed") (assert (testModelCompatibilityCheck) "test-model-compatibility-check passed") (assert (testTokenSavingsEstimation) "test-token-savings-estimation passed") true)
