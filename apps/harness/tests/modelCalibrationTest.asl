(module aslHarness/tests/modelCalibrationTest :x [testCanaryTasksConstruction testParetoScoreComputation testCandidateEvaluation testCalibrationSweepRanking testOptimalCandidateSelection testFormatCalibrationResultAsn testCtrfSummaryParsing testScalarLossAndProgress testContinuousGradientDirectionalSignal testTieredCalibrationTasks testBrowserCeilingAndNanoTasks testCandidateEvaluationWithPromptTranslation testCandidateEvaluationPromptTranslationFallback testCalibrationSweepWithPromptTranslation runTests] :i [(modelCalibration :a mc)])

fn testCanaryTasksConstruction -> Bool
  (let [(canaries (mc/canonicalCanaryTasks)) (c1 (optionOr (listHead canaries) (mc/makeCanaryTask "" "" "" 0 (list) (list))))] (do (assert (= (listLength canaries) 3) "Canary suite must have exactly 3 tasks") (assert (= c1.taskId "CANARY-SYNTAX-01") "First canary must be CANARY-SYNTAX-01") (assert (= c1.kind "syntax") "First canary kind must be syntax") (assert (= (listLength c1.requiredFacts) 1) "First canary must have 1 required fact") true))

fn testParetoScoreComputation -> Bool
  (let [(scoreGood (mc/computeParetoScore 100.0 500 false 80)) (scoreAmn (mc/computeParetoScore 100.0 500 true 80)) (scoreSlow (mc/computeParetoScore 100.0 500 false 800)) (scoreZeroTok (mc/computeParetoScore 100.0 0 false 10)) (scoreZeroPass (mc/computeParetoScore 0.0 500 false 80))] (do (assert (> scoreGood 0.0) "Clean run Pareto score must be positive") (assert (< scoreAmn scoreGood) "Amnesia detection must heavily penalize score") (assert (< scoreSlow scoreGood) "High latency must penalize score") (assert (> scoreZeroTok scoreGood) "Lower tokens must yield higher score") (assert (< scoreZeroPass scoreGood) "Zero pass rate must yield negative or lower score") (assert (<= scoreZeroPass 0.0) "Zero pass rate must be non-positive") true))

fn testCandidateEvaluation -> Bool
  (let [(cand (mc/CalibrationCandidate :modelName "gemma-4-31b-it" :strategy "agent-directed" :temperature 0.2 :budgetCeiling 4096 :asnPromptEnabled false)) (canaries (mc/canonicalCanaryTasks)) (res (mc/evaluateCandidate cand canaries true))] (do (assert (= res.status ":passed") "Candidate should pass canaries under agent-directed") (assert (= res.passRate 100.0) "Pass rate should be 100%") (assert (not res.amnesiaDetected) "Amnesia should not be detected") (assert (> res.avgTokens 0) "Average tokens must be positive") (assert (> res.latencyMs 0) "Latency must be positive") true))

fn testCalibrationSweepRanking -> Bool
  (let [(cfg (mc/CalibrationSweepConfig :modelName "qwen-2.5-3b" :strategies (list "receipts" "agent-directed" "baseline") :temperatures (list 0.0 0.2) :budgetCeilings (list 4096) :dryRun true)) (results (mc/runCalibrationSweep cfg))] (do (assert (= (listLength results) 6) "Sweep must generate 3 strategies * 2 temps = 6 results") (let [(firstRes (optionOr (listHead results) (mc/CalibrationEvaluationResult :candidate (mc/CalibrationCandidate :modelName "" :strategy "" :temperature 0.0 :budgetCeiling 0 :asnPromptEnabled false) :passRate 0.0 :continuousProgress 0.0 :avgTokens 0 :latencyMs 0 :amnesiaDetected false :paretoScore -999.0 :status "" :asnPromptUsed false :asnFallbackTriggered false))) (lastRes (optionOr (listLast results) (mc/CalibrationEvaluationResult :candidate (mc/CalibrationCandidate :modelName "" :strategy "" :temperature 0.0 :budgetCeiling 0 :asnPromptEnabled false) :passRate 0.0 :continuousProgress 0.0 :avgTokens 0 :latencyMs 0 :amnesiaDetected false :paretoScore 999.0 :status "" :asnPromptUsed false :asnFallbackTriggered false)))] (assert (>= firstRes.paretoScore lastRes.paretoScore) "Results must be sorted descending by Pareto score")) true))

fn testOptimalCandidateSelection -> Bool
  (let [(cfg (mc/CalibrationSweepConfig :modelName "gemma-4-31b-it" :strategies (list "receipts" "baseline") :temperatures (list 0.2) :budgetCeilings (list 4096) :dryRun true)) (results (mc/runCalibrationSweep cfg)) (optCand (mc/findOptimalCandidate results))] (mt optCand ((some cand) (do (assert (= cand.strategy "receipts") "Receipts must win over baseline due to token savings") (assert (= cand.modelName "gemma-4-31b-it") "Model name must match") true)) ((none) (do (assert false "Expected some candidate") false))))

fn testFormatCalibrationResultAsn -> Bool
  (let [(cand (mc/CalibrationCandidate :modelName "ling-3.0-flash" :strategy "jit-memory" :temperature 0.0 :budgetCeiling 2048 :asnPromptEnabled false)) (res (mc/CalibrationEvaluationResult :candidate cand :passRate 100.0 :continuousProgress 1.0 :avgTokens 320 :latencyMs 45 :amnesiaDetected false :paretoScore 185.4 :status ":passed" :asnPromptUsed false :asnFallbackTriggered false)) (asnStr (mc/formatCalibrationResultAsn res))] (do (assert (stringStartsWith? asnStr "(:calibration-result") "ASN must start with (:calibration-result") (assert (stringContains? asnStr ":model \"ling-3.0-flash\"") "ASN must contain model") (assert (stringContains? asnStr ":strategy \"jit-memory\"") "ASN must contain strategy") (assert (stringContains? asnStr ":pareto-score 185.4") "ASN must contain score") (assert (stringEndsWith? asnStr ")") "ASN must end with closing paren") true))

fn testCtrfSummaryParsing -> Bool
  (let [(ctrfRaw (str "(\n" "  :results (\n" "    :tool (:name \"pytest\" :version \"8.4.1\")\n" "    :summary (\n" "      :tests 6\n" "      :passed 4\n" "      :failed 2\n" "      :skipped 0\n" "    )\n" "  )\n" ")")) (summary (mc/parseCtrfSummary ctrfRaw))] (do (assert (= summary.totalTests 6) "Total tests must be 6") (assert (= summary.passedTests 4) "Passed tests must be 4") (assert (= summary.failedTests 2) "Failed tests must be 2") (assert (> summary.progressRatio 0.66) "Progress ratio must be > 0.66") (assert (< summary.progressRatio 0.67) "Progress ratio must be < 0.67") true))

fn testScalarLossAndProgress -> Bool
  (let [(metric (mc/computeCeilingLoss "bin-packing-cost" 6000.0 3000.0)) (prog (mc/computeLossProgress metric.normalizedLoss)) (cand (mc/CalibrationCandidate :modelName "gemma-4-31b-it" :strategy "receipts" :temperature 0.2 :budgetCeiling 35000 :asnPromptEnabled false)) (res (mc/evaluateScalarLossTrial cand metric 12000 1500))] (do (assert (= metric.currentVal 6000.0) "Current cost must match 6000.0") (assert (= metric.targetVal 3000.0) "Target ceiling must match 3000.0") (assert (= metric.normalizedLoss 1.0) "Normalized loss must be exactly 1.0 (100% over ceiling)") (assert (= prog 0.5) "Progress ratio for 1.0 loss must be 0.5") (assert (= res.passRate 0.0) "Binary pass rate must be 0.0 when exceeding ceiling") (assert (= res.continuousProgress 0.5) "Continuous progress must be 0.5") (assert (> res.paretoScore 0.0) "Pareto score with 0.5 progress must remain positive") true))

fn testContinuousGradientDirectionalSignal -> Bool
  (let [(cand (mc/CalibrationCandidate :modelName "gemma-4-31b-it" :strategy "agent-directed" :temperature 0.2 :budgetCeiling 35000 :asnPromptEnabled false)) (ctrfPartial ":summary (:tests 6 :passed 4 :failed 2 :skipped 0)") (ctrfZero ":summary (:tests 6 :passed 0 :failed 6 :skipped 0)") (resPartial (mc/evaluateCtrfTrial cand ctrfPartial 25000 3000)) (resZero (mc/evaluateCtrfTrial cand ctrfZero 25000 3000))] (do (assert (= resPartial.passRate 0.0) "Both trials must have 0.0 binary pass rate") (assert (= resZero.passRate 0.0) "Both trials must have 0.0 binary pass rate") (assert (> resPartial.paretoScore resZero.paretoScore) "Partial progress run must score strictly higher than zero progress run") (assert (> resPartial.paretoScore 0.0) "Partial progress with 66.7% subtests must yield positive efficiency") (assert (<= resZero.paretoScore 0.0) "Zero progress must yield non-positive efficiency") true))

fn testTieredCalibrationTasks -> Bool
  (let [(slmTasks (mc/slmCalibrationTasks)) (medTasks (mc/mediumCalibrationTasks)) (frontTasks (mc/frontierCalibrationTasks)) (hardTasks (mc/superHardCalibrationTasks)) (allTasks (mc/fullSpectrumCanaryTasks)) (slmViaTier (mc/tasksForTier "slm")) (medViaTier (mc/tasksForTier "medium")) (frontViaTier (mc/tasksForTier "frontier")) (hardViaTier (mc/tasksForTier "impossible")) (superhardViaTier (mc/tasksForTier "super-hard")) (allViaTier (mc/tasksForTier "all")) (canonViaTier (mc/tasksForTier "other")) (firstSlm (optionOr (listHead slmTasks) (mc/makeCanaryTask "" "" "" 0 (list) (list)))) (firstMed (optionOr (listHead medTasks) (mc/makeCanaryTask "" "" "" 0 (list) (list)))) (firstFront (optionOr (listHead frontTasks) (mc/makeCanaryTask "" "" "" 0 (list) (list)))) (firstHard (optionOr (listHead hardTasks) (mc/makeCanaryTask "" "" "" 0 (list) (list))))] (do (assert (= (listLength slmTasks) 5) "SLM suite must have 5 canary tasks") (assert (= (listLength medTasks) 5) "Medium suite must have 5 canary tasks") (assert (= (listLength frontTasks) 5) "Frontier suite must have 5 challenge tasks") (assert (= (listLength hardTasks) 2) "Super-hard suite must have 2 horizon challenge tasks") (assert (= (listLength allTasks) 17) "Full spectrum canary suite must have 17 tasks") (assert (= (listLength slmViaTier) 5) "Tier slm must return 5 tasks") (assert (= (listLength medViaTier) 5) "Tier medium must return 5 tasks") (assert (= (listLength frontViaTier) 5) "Tier frontier must return 5 tasks") (assert (= (listLength hardViaTier) 2) "Tier impossible must return 2 tasks") (assert (= (listLength superhardViaTier) 2) "Tier super-hard must return 2 tasks") (assert (= (listLength allViaTier) 17) "Tier all must return 17 tasks") (assert (= (listLength canonViaTier) 3) "Default tier must return 3 canonical tasks") (assert (= firstSlm.taskId "SLM-DELIM-01") "First SLM task must be SLM-DELIM-01") (assert (= firstMed.taskId "MED-PARSE-01") "First medium task must be MED-PARSE-01") (assert (= firstFront.taskId "FRONT-HEAP-01") "First frontier task must be FRONT-HEAP-01") (assert (= firstHard.taskId "IMPOSSIBLE-DISTRIB-CONSENSUS-01") "First hard task must be IMPOSSIBLE-DISTRIB-CONSENSUS-01") true))

fn testBrowserCeilingAndNanoTasks -> Bool
  (let [(nanoTasks (mc/nanoCalibrationTasks)) (browserTasks (mc/browserCalibrationTasks)) (nanoViaTier (mc/tasksForTier "nano")) (browserViaTier (mc/tasksForTier "browser")) (firstNano (optionOr (listHead nanoTasks) (mc/makeCanaryTask "" "" "" 0 (list) (list)))) (firstBrowser (optionOr (listHead browserTasks) (mc/makeCanaryTask "" "" "" 0 (list) (list))))] (do (assert (= (listLength nanoTasks) 3) "Nano suite must have 3 canary tasks") (assert (= (listLength browserTasks) 4) "Browser suite must have 4 canary tasks") (assert (= (listLength nanoViaTier) 3) "Tier nano must return 3 tasks") (assert (= (listLength browserViaTier) 4) "Tier browser must return 4 tasks") (assert (= firstNano.taskId "NANO-TAG-01") "First nano task must be NANO-TAG-01") (assert (= firstBrowser.taskId "BROWSER-DOM-01") "First browser task must be BROWSER-DOM-01") (assert (mc/enforceBrowserModelCeiling "SmolLM-135M") "100MB model allowed") (assert (mc/enforceBrowserModelCeiling "Qwen2.5-0.5B") "0.5B model allowed") (assert (mc/enforceBrowserModelCeiling "Qwen2.5-1.5B") "1.5B model allowed") (assert (mc/enforceBrowserModelCeiling "Qwen2.5-3B") "3B ceiling model allowed") (assert (not (mc/enforceBrowserModelCeiling "Qwen2.5-7B")) "7B rejected") (assert (not (mc/enforceBrowserModelCeiling "Gemma-2-9B")) "9B rejected") (assert (not (mc/enforceBrowserModelCeiling "Gemma-4-31B")) "31B rejected") true))

fn testCandidateEvaluationWithPromptTranslation -> Bool
  (let [(canaries (mc/canonicalCanaryTasks)) (candBase (mc/CalibrationCandidate :modelName "qwen-2.5-3b" :strategy "agent-directed" :temperature 0.2 :budgetCeiling 4096 :asnPromptEnabled false)) (candAsn (mc/CalibrationCandidate :modelName "qwen-2.5-3b" :strategy "agent-directed" :temperature 0.2 :budgetCeiling 4096 :asnPromptEnabled true)) (resBase (mc/evaluateCandidate candBase canaries true)) (resAsn (mc/evaluateCandidate candAsn canaries true))] (do (assert (not resBase.asnPromptUsed) "Baseline must not use ASN prompt translation") (assert (not resBase.asnFallbackTriggered) "Baseline must not trigger fallback") (assert resAsn.asnPromptUsed "ASN-enabled candidate must use ASN prompt translation") (assert (not resAsn.asnFallbackTriggered) "ASN-enabled candidate on compatible model must not trigger fallback") (assert (< resAsn.avgTokens resBase.avgTokens) "ASN translation must reduce average prompt tokens") (assert (> resAsn.paretoScore resBase.paretoScore) "ASN translation must improve Pareto score") true))

fn testCandidateEvaluationPromptTranslationFallback -> Bool
  (let [(canaries (mc/canonicalCanaryTasks)) (candNano (mc/CalibrationCandidate :modelName "smollm2-135m" :strategy "baseline" :temperature 0.0 :budgetCeiling 2048 :asnPromptEnabled true)) (resNano (mc/evaluateCandidate candNano canaries true))] (do (assert (not resNano.asnPromptUsed) "Incompatible model must not use ASN prompt") (assert resNano.asnFallbackTriggered "Incompatible model must trigger safe fallback") (assert (= resNano.status ":passed") "Evaluation must complete safely without crashing") true))

fn testCalibrationSweepWithPromptTranslation -> Bool
  (let [(cfg (mc/CalibrationSweepConfig :modelName "qwen-2.5-3b" :strategies (list "receipts" "agent-directed") :temperatures (list 0.2) :budgetCeilings (list 4096) :dryRun true)) (results (mc/runCalibrationSweepWithTranslation cfg (list false true)))] (do (assert (= (listLength results) 4) "Sweep with 2 strats * 1 temp * 1 budget * 2 flags = 4 results") (let [(best (optionOr (listHead results) (mc/CalibrationEvaluationResult :candidate (mc/CalibrationCandidate :modelName "" :strategy "" :temperature 0.0 :budgetCeiling 0 :asnPromptEnabled false) :passRate 0.0 :continuousProgress 0.0 :avgTokens 0 :latencyMs 0 :amnesiaDetected false :paretoScore 0.0 :status "" :asnPromptUsed false :asnFallbackTriggered false)))] (assert best.candidate.asnPromptEnabled "Optimal Pareto candidate should have ASN prompt enabled")) true))

fn runTests -> Bool
  (do (assert (testCanaryTasksConstruction) "canary tasks") (assert (testParetoScoreComputation) "pareto score") (assert (testCandidateEvaluation) "candidate evaluation") (assert (testCalibrationSweepRanking) "sweep ranking") (assert (testOptimalCandidateSelection) "optimal candidate") (assert (testFormatCalibrationResultAsn) "format result asn") (assert (testCtrfSummaryParsing) "ctrf summary") (assert (testScalarLossAndProgress) "scalar loss") (assert (testContinuousGradientDirectionalSignal) "directional signal") (assert (testTieredCalibrationTasks) "tiered tasks") (assert (testBrowserCeilingAndNanoTasks) "browser ceiling") (assert (testCandidateEvaluationWithPromptTranslation) "prompt translation") (assert (testCandidateEvaluationPromptTranslationFallback) "translation fallback") (assert (testCalibrationSweepWithPromptTranslation) "sweep with translation") true)
