(module aslHarness/tests/taskWorkerTest :x [testMakeSpeculativeLane testExecuteSpeculativeLaneIsolation testRaceLanesCompletion testPruneLosingLane testLaneReceiptFormatting testGuardedSpeculativeLane runTests] :i [(taskWorker :a tw) (handoff :a hnd) (aslMem/vfsFork :a vf)])

fn testMakeSpeculativeLane -> Bool
  (let [(lane (tw/makeSpeculativeLane "alpha" 0.2 "fork-alpha-01"))] (do (assert (= lane.laneId "alpha") "Lane id must equal alpha") (assert (= lane.temp 0.2) "Temperature must equal 0.2") (assert (= lane.forkId "fork-alpha-01") "Fork id must equal fork-alpha-01") (assert lane.active "New speculative lane must be active") true))

fn testExecuteSpeculativeLaneIsolation -> Bool
  (let [(briefC (hnd/makeHandoffBrief "t-101" "alpha" "worker-conservative" 0.1 "fix leak" 1000)) (resC (tw/executeSpeculativeLane briefC "fork-alpha")) (briefE (hnd/makeHandoffBrief "t-101" "beta" "worker-exploratory" 0.7 "fix leak" 1000)) (resE (tw/executeSpeculativeLane briefE "fork-beta"))] (do (assert (tw/isLaneSuccessful? resC) "Conservative lane must succeed") (assert (= resC.exitCode 0) "Conservative lane exit code must be 0") (assert (stringContains? resC.output "PASS") "Conservative lane output must indicate pass") (assert (stringContains? resC.output ":affirmative-envelope") "Conservative lane must incorporate affirmative envelope") (assert (not (tw/isLaneSuccessful? resE)) "Exploratory lane must fail") (assert (= resE.exitCode 1) "Exploratory lane exit code must be 1") (assert (stringContains? resE.output "FAIL") "Exploratory lane output must indicate failure") true))

fn testRaceLanesCompletion -> Bool
  (let [(winA (tw/WorkerLaneResult :lane "alpha" :temp 0.1 :exitCode 0 :output "pass" :mutatedPaths (list) :passed true :durationMs 100)) (failB (tw/WorkerLaneResult :lane "beta" :temp 0.7 :exitCode 1 :output "fail" :mutatedPaths (list) :passed false :durationMs 200)) (winB (tw/WorkerLaneResult :lane "beta" :temp 0.7 :exitCode 0 :output "pass" :mutatedPaths (list) :passed true :durationMs 150)) (fastA (tw/WorkerLaneResult :lane "alpha" :temp 0.1 :exitCode 0 :output "pass" :mutatedPaths (list) :passed true :durationMs 80)) (slowB (tw/WorkerLaneResult :lane "beta" :temp 0.7 :exitCode 0 :output "pass" :mutatedPaths (list) :passed true :durationMs 300)) (tieA (tw/WorkerLaneResult :lane "alpha" :temp 0.1 :exitCode 0 :output "pass" :mutatedPaths (list) :passed true :durationMs 100)) (tieB (tw/WorkerLaneResult :lane "beta" :temp 0.7 :exitCode 0 :output "pass" :mutatedPaths (list) :passed true :durationMs 100))] (do (assert (= (tw/raceLanesCompletion winA failB).lane "alpha") "Passing alpha must defeat failing beta") (assert (= (tw/raceLanesCompletion failB winB).lane "beta") "Passing beta must defeat failing alpha") (assert (= (tw/raceLanesCompletion fastA slowB).lane "alpha") "Faster passing lane must win") (assert (= (tw/raceLanesCompletion tieA tieB).lane "alpha") "Tie breaking must prefer lower temperature") true))

fn testPruneLosingLane -> Bool
  (let [(branch (vf/VFSBranch :branchId "branch-loser" :parentId "root" :createdAtMs 1700000000000 :buffers (list) :compensations (list) :status "active" :causalId "")) (pruned (tw/pruneLosingLane branch))] (do (assert (= pruned.status "aborted") "Pruned branch status must be aborted") (assert (not (= pruned.status "active")) "Pruned branch status must not be active") true))

fn testLaneReceiptFormatting -> Bool
  (let [(receipt (tw/LaneReceipt :lane "alpha" :temp 0.2 :exit 0 :ms 125 :rss 48 :delta "(:patch \"foo.asl\")" :vfs "fork-alpha-01")) (formatted (tw/formatLaneReceipt receipt))] (do (assert (stringContains? formatted ":receipt :lane \"alpha\"") "Receipt must contain lane identifier") (assert (stringContains? formatted ":temp 0.2") "Receipt must contain temperature") (assert (stringContains? formatted ":exit 0") "Receipt must contain exit code") (assert (stringContains? formatted ":ms 125") "Receipt must contain elapsed milliseconds") (assert (stringContains? formatted ":rss 48") "Receipt must contain RSS memory") (assert (stringContains? formatted ":delta \"(:patch \\\"foo.asl\\\")\"") "Receipt must contain applied delta") (assert (stringContains? formatted ":vfs \"fork-alpha-01\"") "Receipt must contain VFS fork identifier") true))

fn testGuardedSpeculativeLane -> Bool
  (let [(guard (tw/makeDefaultWorkerGuardrail)) (briefOk (hnd/makeHandoffBrief "t-102" "alpha" "worker-conservative" 0.1 "fix leak" 5000)) (resOk (tw/executeGuardedSpeculativeLane briefOk "fork-alpha" guard)) (briefOver (hnd/makeHandoffBrief "t-103" "alpha" "worker-conservative" 0.1 "fix leak" 50000)) (resOver (tw/executeGuardedSpeculativeLane briefOver "fork-alpha" guard))] (do (assert (tw/isLaneSuccessful? resOk) "Under-budget guarded lane must succeed") (assert (= resOk.exitCode 0) "Under-budget guarded lane exit code must be 0") (assert (not (tw/isLaneSuccessful? resOver)) "Over-budget guarded lane must fail") (assert (= resOver.exitCode 124) "Over-budget guarded lane exit code must be 124") (assert (stringContains? resOver.output "exceeded guardrail ceiling") "Output must indicate guardrail ceiling exceeded") true))

fn runTests -> Bool
  (do (assert (testMakeSpeculativeLane)) (assert (testExecuteSpeculativeLaneIsolation)) (assert (testRaceLanesCompletion)) (assert (testPruneLosingLane)) (assert (testLaneReceiptFormatting)) (assert (testGuardedSpeculativeLane)) true)
