(module harness/tests/sanitizerTraceTest :x [runTests RunTests! testSanitizerSyntaxModernization! testInHarnessVerifierSyntaxModernization! testSanitizeTraceExtraction testSanitizeTokenBudgeting testDualPolarityProbes] :i [(aslHarness/sanitizer :a san) (aslHarness/inHarnessVerifier :a ver)])

fn testSanitizerSyntaxModernization! -> Bool
  (let [(res (fileRead "harness/src/sanitizer.asl"))] (assert (ok? res) "sanitizer.asl exists and is readable") (refute (err? res) "sanitizer.asl refutes read failure") (mt res ((err _) (assert false "sanitizer.asl unreadable")) ((ok content) (assert (> (stringLength content) 0) "sanitizer.asl is non-empty") (refute (= (stringLength content) 0) "sanitizer.asl refutes empty content") (assert (stringContains? content "fn sanitizeTrace") "sanitizer.asl affirms modern fn sanitizeTrace") (assert (stringContains? content "fn formatSanitizedTrace") "sanitizer.asl affirms modern fn formatSanitizedTrace") (assert (stringContains? content "fn isFrameworkNoise?") "sanitizer.asl affirms modern fn isFrameworkNoise?") (assert (stringContains? content "fn estimateTraceTokens") "sanitizer.asl affirms modern fn estimateTraceTokens") (assert (stringContains? content "fn compileRawPromptToIntent") "sanitizer.asl affirms modern fn compileRawPromptToIntent") (refute (stringContains? content "(df sanitizeTrace") "sanitizer.asl refutes legacy (df sanitizeTrace") (refute (stringContains? content "(df makeSanitizedIntent") "sanitizer.asl refutes legacy (df makeSanitizedIntent") (refute (stringContains? content "(df isPhaticWord") "sanitizer.asl refutes legacy (df isPhaticWord") (refute (stringContains? content "(defun ") "sanitizer.asl refutes legacy defun") (refute (stringContains? content "defn ") "sanitizer.asl refutes defn") true)))

fn testInHarnessVerifierSyntaxModernization! -> Bool
  (let [(res (fileRead "harness/src/inHarnessVerifier.asl"))] (assert (ok? res) "inHarnessVerifier.asl exists and is readable") (refute (err? res) "inHarnessVerifier.asl refutes read failure") (mt res ((err _) (assert false "inHarnessVerifier.asl unreadable")) ((ok content) (assert (> (stringLength content) 0) "inHarnessVerifier.asl is non-empty") (refute (= (stringLength content) 0) "inHarnessVerifier.asl refutes empty content") (assert (stringContains? content "fn initTurnState") "inHarnessVerifier.asl affirms modern fn initTurnState") (assert (stringContains? content "fn isMutatingAction?") "inHarnessVerifier.asl affirms modern fn isMutatingAction?") (assert (stringContains? content "fn registerPlanItem") "inHarnessVerifier.asl affirms modern fn registerPlanItem") (refute (stringContains? content "(df initTurnState") "inHarnessVerifier.asl refutes legacy (df initTurnState") (refute (stringContains? content "(df isMutatingAction?") "inHarnessVerifier.asl refutes legacy (df isMutatingAction?") (refute (stringContains? content "(df registerPlanItem") "inHarnessVerifier.asl refutes legacy (df registerPlanItem") (refute (stringContains? content "(defun ") "inHarnessVerifier.asl refutes legacy defun") (refute (stringContains? content "defn ") "inHarnessVerifier.asl refutes defn") true)))

fn testSanitizeTraceExtraction -> Bool
  (let [(rawTrace (str "Traceback (most recent call last):\n" "  File \"/usr/local/lib/python3.11/site-packages/pytest/runner.py\", line 123, in run\n" "    result = call()\n" "  File \"/usr/local/lib/python3.11/site-packages/pluggy/_hooks.py\", line 45, in _hookexec\n" "    return self._inner_hookexec(hook_name, methods, kwargs)\n" "  File \"src/server/auth.py\", line 42, in verify_token\n" "    raise AssertionError(\"Expected valid token, got null\")\n" "AssertionError: Expected valid token, got null\n"))] (let [(trace (san/sanitizeTrace rawTrace 200)) (formatted (san/formatSanitizedTrace trace))] (assert (= trace.targetFile "src/server/auth.py") "target file extracted") (refute (= trace.targetFile "") "target file refutes empty") (assert (= trace.lineNumber 42) "line number extracted as 42") (refute (= trace.lineNumber 0) "line number refutes 0") (assert (stringContains? trace.errorMessage "AssertionError") "error message extracted") (refute (stringContains? trace.errorMessage "pluggy") "error message refutes pluggy") (assert (not (stringContains? trace.sanitizedOutput "site-packages")) "stripped site-packages") (refute (stringContains? trace.sanitizedOutput "site-packages") "refute site-packages in output") (assert (not (stringContains? trace.sanitizedOutput "pluggy")) "stripped pluggy") (refute (stringContains? trace.sanitizedOutput "pluggy") "refute pluggy in output") (assert (stringContains? trace.sanitizedOutput "src/server/auth.py") "contains root file") (refute (not (stringContains? trace.sanitizedOutput "src/server/auth.py")) "refute missing root file") (assert (stringContains? formatted ":sanitized-trace") "formatted contains sanitized-trace") (refute (not (stringContains? formatted ":sanitized-trace")) "refute missing sanitized-trace tag") true))

fn testSanitizeTokenBudgeting -> Bool
  (let [(hugeLine "   at core::panicking::panic_fmt (/rustc/12345/library/core/src/panicking.rs:142)\n") (hugeLog (str hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine hugeLine "  File \"src/core/engine.py\", line 108, in evaluate\n" "    assert state == expected\n" "AssertionError: assert 42 == 100\n" hugeLine hugeLine hugeLine hugeLine hugeLine))] (let [(traceSmall (san/sanitizeTrace hugeLog 50)) (traceCapped (san/sanitizeTrace hugeLog 500))] (assert (<= traceSmall.tokenCount 50) "small trace within 50 tokens") (refute (> traceSmall.tokenCount 50) "refute small trace exceeding 50 tokens") (assert (< traceCapped.tokenCount 300) "capped trace strictly under 300 tokens") (refute (>= traceCapped.tokenCount 300) "refute capped trace >= 300 tokens") (assert (> traceSmall.tokenCount 0) "token count is strictly positive") (refute (<= traceSmall.tokenCount 0) "refute zero token count") (assert (stringContains? traceSmall.errorMessage "AssertionError") "assertion error captured") (refute (not (stringContains? traceSmall.errorMessage "AssertionError")) "refute missing assertion error") (assert (= traceSmall.targetFile "src/core/engine.py") "target file captured") (refute (= traceSmall.targetFile "") "refute empty target file") true))

fn testDualPolarityProbes -> Bool
  (do (assert (san/isFrameworkNoise? "/usr/lib/python3.11/site-packages/pytest/runner.py") "site-packages identified as noise") (refute (not (san/isFrameworkNoise? "/usr/lib/python3.11/site-packages/pytest/runner.py")) "refute site-packages as clean") (assert (san/isFrameworkNoise? "pluggy/_hooks.py") "pluggy identified as noise") (refute (not (san/isFrameworkNoise? "pluggy/_hooks.py")) "refute pluggy as clean") (assert (not (san/isFrameworkNoise? "src/server/auth.py")) "source file identified as clean") (refute (san/isFrameworkNoise? "src/server/auth.py") "refute clean source file as noise") (let [(emptyTrace (san/sanitizeTrace "" 100))] (assert (= emptyTrace.targetFile "") "empty trace has empty target file") (refute (not (= emptyTrace.targetFile "")) "refute non-empty target on empty trace") (assert (= emptyTrace.lineNumber 0) "empty trace has line number 0") (refute (> emptyTrace.lineNumber 0) "refute positive line number on empty trace") (assert (= emptyTrace.errorMessage "") "empty trace has empty error message") (refute (not (= emptyTrace.errorMessage "")) "refute non-empty error on empty trace")) (let [(cleanTurn (ver/initTurnState))] (assert cleanTurn.isTurnGrounded "initial turn state is grounded") (refute (not cleanTurn.isTurnGrounded) "refute ungrounded initial turn state") (assert (= cleanTurn.mutatingActionsCount 0) "zero mutating actions initially") (refute (> cleanTurn.mutatingActionsCount 0) "refute non-zero mutating actions initially") (let [(preRes (ver/auditActionPrecondition cleanTurn "write_to_file"))] (assert (not preRes.approved) "mutating action rejected without plan") (refute preRes.approved "refute unapproved mutating action without plan") (assert (stringContains? preRes.reason "Plan-before-act") "reason cites Plan-before-act") (refute (not (stringContains? preRes.reason "Plan-before-act")) "refute missing Plan-before-act citation"))) true)

fn ! runTests -> Bool
  (do (assert (testSanitizerSyntaxModernization!) "testSanitizerSyntaxModernization passed") (assert (testInHarnessVerifierSyntaxModernization!) "testInHarnessVerifierSyntaxModernization passed") (assert (testSanitizeTraceExtraction) "testSanitizeTraceExtraction passed") (assert (testSanitizeTokenBudgeting) "testSanitizeTokenBudgeting passed") (assert (testDualPolarityProbes) "testDualPolarityProbes passed") true)

fn RunTests! -> Bool
  (runTests)
