(module aslHarness/tests/perceptualLoopTest :x [testCompositeLossCalculation testAntiBlurDefense testConjointGateEvaluation testSpatialPatchRefinement testMonotonicHillClimbing testMaxIterationCircuitBreaker runTests] :i [(perceptualLoop :a pl)])

fn testCompositeLossCalculation -> Bool
  (let [(weights (pl/defaultWeights)) (lossIdeal (pl/calculateCompositeLoss 1.0 0.0 0.0 0.4 0.4 0.2)) (lossWorst (pl/calculateCompositeLoss 0.0 1.0 1.0 0.4 0.4 0.2)) (lossTypical (pl/calculateCompositeLoss 0.90 0.05 0.10 0.4 0.4 0.2))] (assert (== lossIdeal 0.0) "ideal identical match has zero composite loss") (assert (== lossWorst 1.0) "worst match has 1.0 composite loss") (assert (> lossTypical 0.05) "typical match has non-zero loss") (assert (< lossTypical 0.15) "typical match loss within expected bound") (refute (== lossTypical 0.0) "typical match is not perfectly ideal") true)

fn testAntiBlurDefense -> Bool
  (let [(weights (pl/defaultWeights)) (blurSsim 0.94) (blurChamfer 0.18) (isBlur (pl/detectBlurAttack blurSsim blurChamfer 0.88 0.12)) (blurCand (pl/makePerceptualCandidate "c_blur" (list 10.0 10.0) blurSsim blurChamfer 0.05 weights)) (tolerances (pl/defaultTolerances)) (gateResult (pl/evaluateConjointGate blurCand 0.50 tolerances))] (assert isBlur "detectBlurAttack flags smoothed high-ssim high-chamfer sample") (assert blurCand.isBlurAttack "candidate records blur attack flag") (refute gateResult "conjoint gate strictly refutes blur attack") (let [(sharpSsim 0.92) (sharpChamfer 0.04) (isSharpBlur (pl/detectBlurAttack sharpSsim sharpChamfer 0.88 0.12)) (sharpCand (pl/makePerceptualCandidate "c_sharp" (list 10.0 10.0) sharpSsim sharpChamfer 0.05 weights)) (sharpGateResult (pl/evaluateConjointGate sharpCand 0.50 tolerances))] (refute isSharpBlur "genuine sharp candidate is not flagged as blur attack") (assert (not sharpCand.isBlurAttack) "sharp candidate has false blur flag") (assert sharpGateResult "sharp candidate passes conjoint gate")) true)

fn testConjointGateEvaluation -> Bool
  (let [(weights (pl/defaultWeights)) (tolerances (pl/defaultTolerances)) (candGood (pl/makePerceptualCandidate "c_good" (list 5.0) 0.95 0.05 0.05 weights)) (resGood (pl/evaluateConjointGate candGood 0.30 tolerances)) (candWorse (pl/makePerceptualCandidate "c_worse" (list 5.0) 0.90 0.10 0.10 weights)) (resWorse (pl/evaluateConjointGate candWorse 0.05 tolerances)) (candBadColor (pl/makePerceptualCandidate "c_color" (list 5.0) 0.95 0.05 0.35 weights)) (resBadColor (pl/evaluateConjointGate candBadColor 0.50 tolerances))] (assert resGood "candidate with lower loss passes gate") (refute resWorse "candidate with higher loss than current best is rejected") (refute resBadColor "candidate with excessive color deviation is rejected") true)

fn testSpatialPatchRefinement -> Bool
  (let [(weights (pl/defaultWeights)) (baseCand (pl/makePerceptualCandidate "c_base" (list 10.0 20.0 100.0 50.0) 0.80 0.15 0.10 weights)) (delta (list 2.0 -1.0 5.0 0.0)) (refined (pl/spatialPatchRefinement baseCand "c_refined" delta 0.92 0.06 0.04 weights)) (p refined.params) (x (optionOr (listGet p 0) 0.0)) (y (optionOr (listGet p 1) 0.0)) (w (optionOr (listGet p 2) 0.0)) (h (optionOr (listGet p 3) 0.0))] (assert (== x 12.0) "refined X nudged correctly") (assert (== y 19.0) "refined Y nudged correctly") (assert (== w 105.0) "refined W nudged correctly") (assert (== h 50.0) "refined H preserved") (assert (< refined.compositeLoss baseCand.compositeLoss) "refined loss is strictly lower") true)

fn testMonotonicHillClimbing -> Bool
  (let [(weights (pl/defaultWeights)) (tolerances (pl/defaultTolerances)) (c0 (pl/makePerceptualCandidate "c0" (list 0.0) 0.70 0.25 0.20 weights)) (p1 (pl/makePerceptualCandidate "p1" (list 1.0) 0.88 0.10 0.08 weights)) (p2 (pl/makePerceptualCandidate "p2" (list 2.0) 0.96 0.22 0.05 weights)) (p3 (pl/makePerceptualCandidate "p3" (list 3.0) 0.98 0.02 0.01 weights)) (proposals (list p1 p2 p3)) (result (pl/runPerceptualLoop c0 proposals 3 0.05 tolerances))] (assert result.converged "perceptual loop successfully converged") (assert (> result.lossReduction 0.0) "loss reduction is strictly positive") (assert (== result.rejectedCount 1) "exactly 1 candidate (blur attack) rejected") (let [(best result.bestCandidate)] (assert (== best.id "p3") "best candidate is final converged proposal") (assert (< best.compositeLoss 0.05) "final composite loss satisfies convergence threshold")) true)

fn testMaxIterationCircuitBreaker -> Bool
  (let [(weights (pl/defaultWeights)) (tolerances (pl/defaultTolerances)) (c0 (pl/makePerceptualCandidate "c0" (list 0.0) 0.50 0.40 0.30 weights)) (p1 (pl/makePerceptualCandidate "p1" (list 1.0) 0.55 0.35 0.25 weights)) (p2 (pl/makePerceptualCandidate "p2" (list 2.0) 0.60 0.30 0.20 weights)) (p3 (pl/makePerceptualCandidate "p3" (list 3.0) 0.65 0.25 0.15 weights)) (p4 (pl/makePerceptualCandidate "p4" (list 4.0) 0.70 0.20 0.10 weights)) (p5 (pl/makePerceptualCandidate "p5" (list 5.0) 0.75 0.15 0.05 weights)) (longProposals (list p1 p2 p3 p4 p5)) (result (pl/runPerceptualLoop c0 longProposals 10 0.01 tolerances))] (assert (<= result.iterations 3) "circuit breaker enforces max 3 iterations") (assert (== result.iterations 3) "executed exactly 3 iterations before halting") (refute result.converged "not prematurely marked converged when threshold unmet") true)

fn runTests -> Bool
  (and (testCompositeLossCalculation) (and (testAntiBlurDefense) (and (testConjointGateEvaluation) (and (testSpatialPatchRefinement) (and (testMonotonicHillClimbing) (testMaxIterationCircuitBreaker))))))
