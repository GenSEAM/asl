(module aslHarness/synthesisTest :x [testSynthesis5CanonicalSections testSynthesisDiscloseGaps runTests] :i [(synthesis :a syn) (feedback :a fb) (preMortem :a pm)])

fn testSynthesis5CanonicalSections -> Bool
  (let [(rRisk (pm/ConsequenceRisk :description "Potential schema drift in downstream cache" :hopCount 1 :falsificationTrigger "asl test --strict-falsify harness/tests/feedback-test.asl" :severity "low" :isGrounded true)) (scorecard (syn/EpistemicScorecard :confidenceScore 0.98 :verifiedAssertionCount 12 :unverifiedGapCount 0 :calibrationVerdict "calibrated")) (report (syn/format5SectionDelivery "TASK-258" (list "Stage 4 pre-mortem reasoning engine verified" "Strict 2-hop speculation ceiling enforced") (list) (list) (list rRisk) scorecard)) (md report.rawMarkdown)] (do (assert (stringContains? md "## 1. Verified Findings & AST Grounding")) (assert (stringContains? md "## 2. Intent Divergences & Reality Anchors")) (assert (stringContains? md "## 3. Transparent Disclosures & Omissions")) (assert (stringContains? md "## 4. Blast Radius & Downstream Consequences")) (assert (stringContains? md "## 5. Epistemic Calibration Scorecard")) (assert (stringContains? report.section1Findings "Verified Findings & AST Grounding")) (assert (stringContains? report.section4Consequences "schema drift")) (assert (stringContains? report.section5Scorecard "calibrated")) (assert (stringContains? report.section5Scorecard "0.98")) (assert (not (stringEmpty? md))) true))

fn testSynthesisDiscloseGaps -> Bool
  (let [(scorecard (syn/EpistemicScorecard :confidenceScore 0.85 :verifiedAssertionCount 8 :unverifiedGapCount 2 :calibrationVerdict "calibrated")) (reportWithGaps (syn/format5SectionDelivery "TASK-258-GAPS" (list "Verified core AST structure") (list) (list "ARM64 micro-benchmarking deferred to bench wave" "Optional JSON pretty-printing omitted per YAGNI") (list) scorecard)) (reportClean (syn/format5SectionDelivery "TASK-258-CLEAN" (list "All items green") (list) (list) (list) scorecard)) (s3Gaps reportWithGaps.section3Disclosures) (s3Clean reportClean.section3Disclosures)] (do (assert (stringContains? s3Gaps "Transparent Disclosures")) (assert (stringContains? s3Gaps "ARM64 micro-benchmarking")) (assert (stringContains? s3Gaps "Optional JSON pretty-printing")) (assert (stringContains? s3Clean "No unverified gaps or defects observed")) (assert (not (stringContains? s3Clean "ARM64 micro-benchmarking"))) true))

fn runTests -> Bool
  (do (assert (testSynthesis5CanonicalSections)) (assert (testSynthesisDiscloseGaps)) true)
