(module aslHarness/multiClientRunnerTest :x [testClientTargets testInjectionConfigs testCanonicalTasks testInjectionPayloadFormatting testSimulationAndSafetyBlocking testComparativeMetricsEvaluation testReceiptAndSummaryFormatting runTests] :i [(multiClientRunner :a mcr)])

fn testClientTargets -> Bool
  (let [(claude (mcr/makeClaudeClient)) (agy (mcr/makeAntigravityClient)) (agy2 (mcr/makeAgyClient)) (addie (mcr/makeAddieClient)) (ad (mcr/makeAdClient)) (eddie (mcr/makeEddieClient)) (profAgy (mcr/getClientConcurrencyProfile "agy")) (profClaude (mcr/getClientConcurrencyProfile "claude-code")) (profAddie (mcr/getClientConcurrencyProfile "addie")) (profAd (mcr/getClientConcurrencyProfile "ad")) (profEddie (mcr/getClientConcurrencyProfile "eddie"))] (assert (= claude.id "claude-code") "Claude ID must be claude-code") (= claude.engine "claude-3-7-sonnet") (assert (= claude.promptChannel "CLAUDE.md") "Claude prompt channel must be CLAUDE.md") (assert (= agy.id "agy") "Antigravity ID must be agy") (assert (= agy.name "agy") "Antigravity name must be agy") (assert (= agy2.id "agy") "agy2 ID must be agy") (= agy.engine "gemini-2-pro") (assert (= agy.promptChannel "<RULE[user_global]>") "Antigravity channel must be RULE[user_global]") (assert agy.supportsStagedVfs "Antigravity must support staged VFS") (assert (= addie.id "addie") "Addie ID must be addie") (assert (= addie.name "Addie (Native ASL)") "Addie name must be Addie (Native ASL)") (assert (= addie.promptChannel "ADDIE.md") "Addie prompt channel must be ADDIE.md") (assert (= ad.id "addie") "AD alias ID must be addie") (assert (= eddie.id "addie") "Eddie alias ID must be addie") (assert (= profAgy.softLimit 4) "AntiGravity soft limit must be 4") (assert (= profAgy.hardLimit 6) "AntiGravity hard limit must be 6") (assert (= profAgy.flexibility "bounded") "AntiGravity profile must be bounded") (assert (= profClaude.softLimit 4) "Claude Code soft limit must be 4") (assert (= profClaude.hardLimit 8) "Claude Code hard limit must be 8") (assert (= profClaude.flexibility "bounded") "Claude Code profile must be bounded") (assert (= profAddie.softLimit 4) "Addie soft limit must be 4") (assert (= profAddie.hardLimit 8) "Addie hard limit must be 8") (assert (= profAddie.flexibility "elastic") "Addie profile must be elastic") (assert (= profAd.softLimit 4) "AD soft limit must be 4") (assert (= profAd.hardLimit 8) "AD hard limit must be 8") (assert (= profEddie.softLimit 4) "Eddie soft limit must be 4") (assert (= profEddie.hardLimit 8) "Eddie hard limit must be 8") true)

fn testInjectionConfigs -> Bool
  (let [(base (mcr/makeBaselineConfig)) (inj (mcr/makeInjectedConfig))] (assert (= base.armMode "baseline") "Baseline arm mode must be baseline") (assert (not base.withGroundTruth) "Baseline must not enforce ground truth") (assert (not base.withCircuitBreaker) "Baseline must not equip circuit breaker") (assert (= base.maxTokens 100000) "Baseline max tokens is 100000") (assert (= inj.armMode "paradigm-injected") "Injected arm mode must be paradigm-injected") (assert inj.withGroundTruth "Injected arm must enforce ground truth") (assert inj.withAsnCompaction "Injected arm must enable ASN compaction") (assert inj.withCircuitBreaker "Injected arm must equip circuit breaker") (assert (= inj.maxTokens 35000) "Injected max tokens ceiling is 35000") (assert inj.withBlastRadiusGuard "Injected arm must check blast radius") (assert inj.withAbortController "Injected arm must equip abort controller") true)

fn testCanonicalTasks -> Bool
  (let [(tasks (mcr/makeCanonicalBenchmarkTasks))] (assert (= (listLength tasks) 3) "Must define exactly 3 canonical benchmark tasks") (let [(t1 (optionOr (listHead tasks) (mcr/BenchmarkTask :taskId "" :category "" :title "" :description "" :baselineTokens 0 :verificationGate "")))] (assert (= t1.taskId "SWE-006") "Task 1 must be SWE-006") (assert (= t1.category "blast-radius") "Task 1 category must be blast-radius") (assert (= t1.baselineTokens 32000) "SWE-006 baseline tokens must be 32000") true))

fn testInjectionPayloadFormatting -> Bool
  (let [(claude (mcr/makeClaudeClient)) (agy (mcr/makeAntigravityClient)) (inj (mcr/makeInjectedConfig)) (claudePayload (mcr/buildInjectionPayload claude inj)) (agyPayload (mcr/buildInjectionPayload agy inj))] (assert (stringContains? claudePayload "CLAUDE.md") "Claude payload must reference CLAUDE.md") (assert (stringContains? claudePayload ":rule (:ground-truth") "Claude payload must inject ground truth") (assert (stringContains? agyPayload "RULE[user_global]") "Antigravity payload must reference RULE[user_global]") (assert (stringContains? agyPayload "ASL_TOOLBELT_START") "Antigravity payload must activate ASL toolbelt") true)

fn testSimulationAndSafetyBlocking -> Bool
  (let [(claude (mcr/makeClaudeClient)) (baseCfg (mcr/makeBaselineConfig)) (injCfg (mcr/makeInjectedConfig)) (tasks (mcr/makeCanonicalBenchmarkTasks)) (t1 (optionOr (listHead tasks) (mcr/BenchmarkTask :taskId "" :category "" :title "" :description "" :baselineTokens 0 :verificationGate ""))) (baseRun (mcr/simulateClientRun claude baseCfg t1)) (injRun (mcr/simulateClientRun claude injCfg t1))] (assert (= baseRun.tokensConsumed 32000) "Baseline must consume full 32000 tokens") (assert (not baseRun.resolved) "Baseline without harness fails SWE-006") (assert (= baseRun.destructiveAttemptsBlocked 0) "Baseline does not block destructive attempts") (assert injRun.resolved "Injected run resolves task successfully") (assert (< injRun.tokensConsumed 10000) "Injected tokens must be under 10000") (assert (> injRun.tokenSavingsPercent 70.0) "Token savings must exceed 70%") (assert (= injRun.destructiveAttemptsBlocked 2) "Must intercept 2 destructive actions on SWE-006") true)

fn testComparativeMetricsEvaluation -> Bool
  (let [(agy (mcr/makeAntigravityClient)) (baseCfg (mcr/makeBaselineConfig)) (injCfg (mcr/makeInjectedConfig)) (tasks (mcr/makeCanonicalBenchmarkTasks)) (t1 (optionOr (listHead tasks) (mcr/BenchmarkTask :taskId "" :category "" :title "" :description "" :baselineTokens 0 :verificationGate ""))) (baseR1 (mcr/simulateClientRun agy baseCfg t1)) (injR1 (mcr/simulateClientRun agy injCfg t1)) (metric (mcr/evaluateClientMetrics agy (list baseR1) (list injR1)))] (assert (= metric.baselineSolveRate 0.0) "Baseline solve rate is 0.0") (assert (= metric.injectedSolveRate 1.0) "Injected solve rate is 1.0") (assert (> metric.tokenReductionRatio 3.5) "Token reduction ratio must exceed 3.5x") (assert (= metric.safetyViolationsPrevented 2) "Must record 2 prevented violations") (assert (> metric.efficiencyGainPercent 70.0) "Efficiency gain must exceed 70%") true)

fn testReceiptAndSummaryFormatting -> Bool
  (let [(claude (mcr/makeClaudeClient)) (agy (mcr/makeAntigravityClient)) (m1 (mcr/ClientComparisonMetric :clientId "claude-code" :baselineSolveRate 0.0 :injectedSolveRate 1.0 :baselineAvgTokens 32000 :injectedAvgTokens 8320 :tokenReductionRatio 3.84 :safetyViolationsPrevented 2 :efficiencyGainPercent 74.0)) (m2 (mcr/ClientComparisonMetric :clientId "agy" :baselineSolveRate 0.0 :injectedSolveRate 1.0 :baselineAvgTokens 32000 :injectedAvgTokens 8320 :tokenReductionRatio 3.84 :safetyViolationsPrevented 2 :efficiencyGainPercent 74.0)) (rcpt (mcr/formatMultiClientReceipt (list m1 m2))) (summary (mcr/formatRunnerSummary m1 m2))] (assert (stringContains? rcpt ":multi-client-benchmark-receipt") "Receipt must contain header") (assert (stringContains? rcpt "claude-code") "Receipt must list claude-code") (assert (stringContains? rcpt "agy") "Receipt must list agy") (assert (stringContains? summary ":multi-client-runner-summary") "Summary must contain header") (assert (stringContains? summary ":claude-code") "Summary must contain claude-code section") (assert (stringContains? summary ":agy") "Summary must contain agy section") true)

fn testAgentLaunchPreparation -> Bool
  (let [(cfgAgy (mcr/makeAgentLaunchConfig "agy")) (cfgClaude (mcr/makeAgentLaunchConfig "claude-code")) (dirAgy (mcr/formatLaunchDirective cfgAgy)) (dirClaude (mcr/formatLaunchDirective cfgClaude))] (assert (= cfgAgy.clientId "agy") "Config client-id must be agy") (assert cfgAgy.stashAgentsMd "Stash AGENTS.md must be true by default") (assert cfgAgy.injectToolbelt "Inject toolbelt must be true by default") (assert cfgAgy.enforceGroundTruth "Enforce ground truth must be true by default") (assert (stringContains? dirAgy ":client \"agy\"") "Launch directive must target agy") (assert (stringContains? dirAgy ":consultative-agents-md true") "Launch directive must set consultative mode") (assert (stringContains? dirAgy "ASL_TOOLBELT_START") "Launch directive must include toolbelt") (assert (stringContains? dirClaude ":client \"claude-code\"") "Claude directive must target claude-code") true)

fn testOrchestratorConfigurationAndDirective -> Bool
  (let [(defOrch (mcr/defaultOrchestratorConfig)) (cfgOrch (mcr/makeOrchestratorLaunchConfig "agy" "gemini-3.8-flash" "high")) (cfgClaudeOrch (mcr/makeOrchestratorLaunchConfig "claude-code" "gemini-3.8-flash" "high")) (orchDir (mcr/formatOrchestratorDirective defOrch)) (launchDir (mcr/formatLaunchDirective cfgOrch)) (launchClaudeDir (mcr/formatLaunchDirective cfgClaudeOrch))] (assert defOrch.enabled "Default orchestrator must be enabled") (assert (= defOrch.modelName "gateway-teleological") "Default orchestrator model must be gateway-teleological") (assert (= defOrch.reasoningLevel "max") "Default reasoning level must be max") (assert (= defOrch.softLimit 4) "Default soft limit must be 4") (assert (= defOrch.hardLimit 6) "Default hard limit must be 6") (assert defOrch.codeExecutionEnabled "Default code execution must be enabled") (assert defOrch.multiProjectEnabled "Default multi project must be enabled") (assert (= defOrch.orchestrationTarget "intent-graph") "Default orchestration target must be intent-graph") (assert (not defOrch.separateAgentsEnabled) "Separate agents feature flag must be false by default") (assert defOrch.minimalOrchestrator "Minimal orchestrator must be true by default") (assert (= defOrch.claudeMode "automatic") "Claude mode must be automatic") (assert (= defOrch.agyPermissionTier "dangerous-rescue") "Agy permission tier must be dangerous-rescue") (assert (= defOrch.researchTier "coding") "Research tier must be coding") (assert (= defOrch.planningTier "planning") "Planning tier must be planning") (assert (= defOrch.executionTier "coding") "Execution tier must be coding") (assert (= defOrch.upgradePath "gateway-next") "Upgrade path must be gateway-next") (assert (stringContains? orchDir ":rule :orchestrator") "Directive must declare orchestrator rule") (assert (stringContains? orchDir "gateway-teleological") "Directive must reference gateway-teleological") (assert (stringContains? orchDir ":claude-mode \"automatic\"") "Directive must declare claude-mode") (assert (stringContains? orchDir ":agy-permission-tier \"dangerous-rescue\"") "Directive must declare agy-permission-tier") (assert (stringContains? orchDir ":soft-limit 4") "Directive must declare soft limit") (assert (stringContains? orchDir ":hard-limit 6") "Directive must declare hard limit") (assert (stringContains? orchDir ":code-execution true") "Directive must declare code execution") (assert (stringContains? orchDir ":multi-project-orchestration true") "Directive must declare multi-project") (assert (stringContains? orchDir ":orchestration-target \"intent-graph\"") "Directive must declare intent-graph target") (assert (stringContains? orchDir "Baseline delegation: Use Antigravity sub-agents") "Directive must mandate sub-agents baseline") (assert (stringContains? orchDir "Claude Code permission mandate") "Directive must mandate Claude Code automatic mode") (assert (stringContains? orchDir "Antigravity permission mandate") "Directive must mandate Antigravity dangerous rescue mode") (assert (stringContains? orchDir "Context hygiene: Keep orchestrator context minimal") "Directive must mandate context hygiene") (assert (stringContains? orchDir "invoke_subagent") "Directive must mandate invoke_subagent") (assert (stringContains? launchDir ":orchestrator-mode true") "Launch directive must declare orchestrator-mode true") (assert (stringContains? launchDir ":permission-tier \"dangerous-rescue\"") "Launch directive for agy orchestrator must include permission-tier dangerous-rescue") (assert (stringContains? launchDir ":flags [\"--dangerously-skip-permissions\"]") "Launch directive for agy orchestrator must include flags") (assert (stringContains? launchDir "ORCHESTRATOR_START") "Launch directive must include ORCHESTRATOR_START") (assert (stringContains? launchClaudeDir ":orchestrator-mode true") "Launch directive for Claude orchestrator must declare orchestrator-mode true") (assert (stringContains? launchClaudeDir ":claude-mode \"automatic\"") "Launch directive for Claude orchestrator must include claude-mode automatic") (assert (stringContains? launchClaudeDir ":flags [\"--dangerously-skip-permissions\"]") "Launch directive for Claude orchestrator must include flags") true)

fn testOrchestratorPresetsAndQueue -> Bool
  (let [(pRes (mcr/makeOrchestratorPreset "fast-research")) (pArch (mcr/makeOrchestratorPreset "deep-architecture")) (pAudit (mcr/makeOrchestratorPreset "audit-hardening")) (pCanvas (mcr/makeOrchestratorPreset "canvas-interactive")) (q0 (mcr/makeOrchestratorQueue "orch-sess-1" 4)) (t1 (mcr/OrchestratorTaskItem :taskId "task-01" :title "Research CodePod and Canvas Scopes" :assignedRole "researcher" :modelTier "flash" :state "queued" :retryCount 0 :verificationGate "asl test harness/tests/coding-test.asl")) (t2 (mcr/OrchestratorTaskItem :taskId "task-02" :title "Plan Multi-Agent Wave DAG" :assignedRole "planner" :modelTier "pro" :state "queued" :retryCount 0 :verificationGate "asl check harness/results/voice_pipeline_specification.asn")) (q1 (mcr/enqueueOrchestratorTask q0 t1)) (q2 (mcr/enqueueOrchestratorTask q1 t2)) (q3 (mcr/advanceTaskState q2 "task-01" "completed"))] (assert (= pRes.reasoningLevel "low") "Fast research preset reasoning must be low") (assert (= pRes.claudeMode "automatic") "Fast research preset claude mode must be automatic") (assert (= pRes.agyPermissionTier "dangerous-rescue") "Fast research preset agy permission tier must be dangerous-rescue") (assert (= pRes.softLimit 4) "Fast research soft limit must be 4") (assert (= pRes.hardLimit 6) "Fast research hard limit must be 6") (assert (= pRes.maxSubagents 6) "Fast research concurrency must be 6") (assert (= pArch.reasoningLevel "max") "Deep architecture preset reasoning must be max") (assert (= pArch.softLimit 2) "Deep architecture soft limit must be 2") (assert (= pArch.hardLimit 4) "Deep architecture hard limit must be 4") (assert (= pArch.maxSubagents 4) "Deep architecture concurrency must be 4") (assert (= pAudit.reasoningLevel "high") "Audit preset reasoning must be high") (assert (= pCanvas.reasoningLevel "medium") "Canvas preset reasoning must be medium") (assert (= (mcr/countTasksByState q2 "queued") 2) "Initial queued count must be 2") (assert (= (mcr/countTasksByState q3 "completed") 1) "Completed task count must be 1") (assert (= (mcr/countTasksByState q3 "queued") 1) "Remaining queued task count must be 1") true)

fn runTests -> Bool
  (let [(t1 (testClientTargets)) (t2 (testInjectionConfigs)) (t3 (testCanonicalTasks)) (t4 (testInjectionPayloadFormatting)) (t5 (testSimulationAndSafetyBlocking)) (t6 (testComparativeMetricsEvaluation)) (t7 (testReceiptAndSummaryFormatting)) (t8 (testAgentLaunchPreparation)) (t9 (testOrchestratorConfigurationAndDirective)) (t10 (testOrchestratorPresetsAndQueue))] (and t1 (and t2 (and t3 (and t4 (and t5 (and t6 (and t7 (and t8 (and t9 t10))))))))))
