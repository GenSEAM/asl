(module aslHarness/tests/sovereignRunnerTest :x [testBenchmarkMatrixConstruction testSolvableTasksExecution testUnsolvedHardTasksExecution testTimeoutSupervision testMixedChallengeMatrixExecution testBenchmarkReceiptFormatting testMode2StandardPipeline testMode3DeepPipeline testModeComparativeMetrics testGuardrailCircuitBreakerTrip testGuardrailBudgetCeilingTrip runTests] :i [(sovereignRunner :a sr)])

fn testBenchmarkMatrixConstruction -> Bool
  (let [(m (sr/BenchmarkMatrix :id "matrix-sample" :tasks (list "task-a" "task-b") :timeoutMs 5000)) (mEmpty (sr/BenchmarkMatrix :id "matrix-empty" :tasks (list) :timeoutMs 0))] (do (assert (= m.id "matrix-sample") "Matrix ID must match constructor argument") (assert (= (listLength m.tasks) 2) "Task count must equal 2") (assert (= m.timeoutMs 5000) "Timeout must equal 5000") (assert (= mEmpty.id "matrix-empty") "Empty matrix ID must match") (assert (listEmpty? mEmpty.tasks) "Empty matrix task list must be empty") (assert (= mEmpty.timeoutMs 0) "Empty matrix timeout must be zero") true))

fn testSolvableTasksExecution -> Bool
  (let [(m (sr/BenchmarkMatrix :id "matrix-solv" :tasks (list "TB4-SOLV-01" "TB4-SOLV-02") :timeoutMs 30000)) (res (sr/runSovereignMatrix m))] (do (assert (= res.matrixId "matrix-solv") "Result matrix id must match") (assert (= res.passedCount 2) "All 2 solvable tasks must pass") (assert (= res.failedCount 0) "Zero tasks must fail in solvable suite") (assert (= (listLength res.receipts) 2) "Receipt count must equal 2") (assert (stringContains? (optionOr (listHead res.receipts) "") ":status :passed") "First task receipt must indicate passed") (assert (stringContains? (optionOr (listHead res.receipts) "") ":exit 0") "Passed task must record exit code 0") true))

fn testUnsolvedHardTasksExecution -> Bool
  (let [(m (sr/BenchmarkMatrix :id "matrix-hard" :tasks (list "TB4-HARD-01" "TB4-HARD-02" "TB4-HARD-03") :timeoutMs 30000)) (res (sr/runSovereignMatrix m))] (do (assert (= res.passedCount 0) "Zero hard tasks must pass") (assert (= res.failedCount 3) "All 3 hard tasks must fail") (assert (= (listLength res.receipts) 3) "Receipt count must equal 3") (assert (stringContains? (optionOr (listHead res.receipts) "") ":status :failed") "First hard task receipt must indicate failed") (assert (stringContains? (optionOr (listHead res.receipts) "") "unsolved-hard-challenge") "Hard task receipt must state reason unsolved-hard-challenge") true))

fn testTimeoutSupervision -> Bool
  (let [(mZero (sr/BenchmarkMatrix :id "matrix-timeout-zero" :tasks (list "TB4-SOLV-01" "TB4-SOLV-02") :timeoutMs 0)) (resZero (sr/runSovereignMatrix mZero)) (mNeg (sr/BenchmarkMatrix :id "matrix-timeout-neg" :tasks (list "TB4-SOLV-01" "TB4-SOLV-02") :timeoutMs -100)) (resNeg (sr/runSovereignMatrix mNeg))] (do (assert (= resZero.passedCount 0) "Zero tasks must pass under zero timeout") (assert (= resZero.failedCount 2) "Both tasks must fail under zero timeout") (assert (stringContains? (optionOr (listHead resZero.receipts) "") ":reason \"timeout\"") "Receipt must indicate timeout reason") (assert (stringContains? (optionOr (listHead resZero.receipts) "") ":exit 124") "Timed out task must exit with code 124") (assert (= resNeg.failedCount 2) "Both tasks must fail under negative timeout") true))

fn testMixedChallengeMatrixExecution -> Bool
  (let [(m (sr/BenchmarkMatrix :id "terminal-bench-4-challenge-10" :tasks (list "TB4-SOLV-01" "TB4-SOLV-02" "TB4-HARD-01" "TB4-HARD-02" "TB4-HARD-03" "TB4-HARD-04" "TB4-HARD-05" "TB4-HARD-06" "TB4-HARD-07" "TB4-HARD-08") :timeoutMs 60000)) (res (sr/runSovereignMatrix m))] (do (assert (= res.matrixId "terminal-bench-4-challenge-10") "Matrix ID must match challenge 10") (assert (= res.passedCount 2) "Challenge 10 must record exactly 2 passed baseline solvable tasks") (assert (= res.failedCount 8) "Challenge 10 must record exactly 8 failed hardest unsolved tasks") (assert (= (+ res.passedCount res.failedCount) 10) "Total evaluated tasks must equal 10") (assert (= (listLength res.receipts) 10) "Total receipts recorded must equal 10") true))

fn testBenchmarkReceiptFormatting -> Bool
  (let [(m (sr/BenchmarkMatrix :id "terminal-bench-4-challenge-10" :tasks (list "TB4-SOLV-01" "TB4-SOLV-02" "TB4-HARD-01") :timeoutMs 60000)) (res (sr/runSovereignMatrix m)) (receiptStr (sr/formatBenchmarkReceipt res)) (resEmpty (sr/BenchmarkRunResult :matrixId "empty-res" :passedCount 0 :failedCount 0 :receipts (list))) (receiptEmpty (sr/formatBenchmarkReceipt resEmpty))] (do (assert (stringContains? receiptStr "(:benchmark-receipt") "Receipt must open with :benchmark-receipt") (assert (stringContains? receiptStr ":matrix-id \"terminal-bench-4-challenge-10\"") "Receipt must embed matrix identifier") (assert (stringContains? receiptStr ":total-tasks 3") "Receipt must report total-tasks 3") (assert (stringContains? receiptStr ":passed-count 2") "Receipt must report passed-count 2") (assert (stringContains? receiptStr ":failed-count 1") "Receipt must report failed-count 1") (assert (stringContains? receiptEmpty ":receipts []") "Empty receipt must serialize empty receipt list") true))

fn testMode2StandardPipeline -> Bool
  (let [(trace (sr/runEpistemicTask "TB4-SOLV-01" 2 30000)) (steps trace.steps) (dummy (sr/makeEpistemicStep "" "" "" 0 "")) (s0 (optionOr (listGet steps 0) dummy)) (s1 (optionOr (listGet steps 1) dummy)) (s2 (optionOr (listGet steps 2) dummy)) (s3 (optionOr (listGet steps 3) dummy)) (timeoutTrace (sr/runEpistemicTask "TB4-SOLV-01" 2 0))] (do (assert (= (listLength steps) 4) "Mode 2 must produce exactly 4 steps") (assert (= s0.name "scout") "Mode 2 step 0 must be scout") (assert (= s1.name "plan-and-gap") "Mode 2 step 1 must be plan-and-gap") (assert (= s2.name "implement") "Mode 2 step 2 must be implement") (assert (= s3.name "reconcile") "Mode 2 step 3 must be reconcile") (assert trace.passed "Solvable task must pass under Mode 2") (assert (= trace.totalTokens 750) "Mode 2 total token consumption must equal 750") (assert (not timeoutTrace.passed) "Timed out Mode 2 execution must record passed false") (assert (= (listLength timeoutTrace.steps) 0) "Timed out run must have 0 steps") true))

fn testMode3DeepPipeline -> Bool
  (let [(trace (sr/runEpistemicTask "TB4-SOLV-01" 3 30000)) (steps trace.steps) (dummy (sr/makeEpistemicStep "" "" "" 0 "")) (s0 (optionOr (listGet steps 0) dummy)) (s1 (optionOr (listGet steps 1) dummy)) (s2 (optionOr (listGet steps 2) dummy)) (s3 (optionOr (listGet steps 3) dummy)) (s4 (optionOr (listGet steps 4) dummy)) (hardTrace (sr/runEpistemicTask "TB4-HARD-01" 3 30000)) (hardSteps hardTrace.steps) (hardGap (optionOr (listGet hardSteps 2) dummy))] (do (assert (= (listLength steps) 5) "Mode 3 must produce exactly 5 steps") (assert (= s0.name "scout") "Mode 3 step 0 must be scout") (assert (= s1.name "plan") "Mode 3 step 1 must be plan") (assert (= s2.name "gap-audit") "Mode 3 step 2 must be gap-audit") (assert (= s3.name "implement") "Mode 3 step 3 must be implement") (assert (= s4.name "reconcile") "Mode 3 step 4 must be reconcile") (assert trace.passed "Solvable task must pass under Mode 3") (assert (= trace.totalTokens 1080) "Mode 3 total token consumption must equal 1080") (assert (not hardTrace.passed) "Hard challenge must fail under Mode 3") (assert (= hardGap.status ":failed") "Gap audit step must fail on hard challenge") (assert (stringContains? hardGap.receipt "unresolvable-constraint") "Gap audit receipt must identify unresolvable constraint") true))

fn testModeComparativeMetrics -> Bool
  (let [(cmpSolv (sr/compareEpistemicModes "TB4-SOLV-01" 30000)) (t2 (sr/runEpistemicTask "TB4-SOLV-01" 2 30000)) (fmt2 (sr/formatEpistemicTrace t2)) (t3 (sr/runEpistemicTask "TB4-SOLV-01" 3 30000)) (fmt3 (sr/formatEpistemicTrace t3))] (do (assert (or (stringContains? cmpSolv "(:mode-comparison") (stringContains? cmpSolv "(:comparative-epistemic-run")) "Comparative output must contain ASN comparison block") (assert (or (stringContains? cmpSolv ":mode-2") (stringContains? cmpSolv ":mode 2")) "Comparative output must record Mode 2 metrics") (assert (or (stringContains? cmpSolv ":mode-3") (stringContains? cmpSolv ":mode 3")) "Comparative output must record Mode 3 metrics") (assert (stringContains? cmpSolv ":step-delta 1") "Step delta between Mode 3 and Mode 2 must equal 1") (assert (stringContains? cmpSolv ":token-overhead 330") "Token overhead must equal 330") (assert (stringContains? fmt2 "(:epistemic-trace") "Formatted trace 2 must start with :epistemic-trace") (assert (stringContains? fmt2 ":mode 2") "Formatted trace 2 must record :mode 2") (assert (stringContains? fmt2 ":total-tokens 750") "Formatted trace 2 must record total tokens 750") (assert (stringContains? fmt3 "(:epistemic-trace") "Formatted trace 3 must start with :epistemic-trace") (assert (stringContains? fmt3 ":mode 3") "Formatted trace 3 must record :mode 3") (assert (stringContains? fmt3 ":total-tokens 1080") "Formatted trace 3 must record total tokens 1080") true))

fn testGuardrailCircuitBreakerTrip -> Bool
  (let [(guard (sr/makeGuardrail 35000 8 1)) (trace (sr/runGuardedEpistemicTask "TB4-HARD-01" 3 30000 guard)) (steps trace.steps)] (do (assert (not trace.passed) "Hard task under guarded execution must fail") (assert trace.circuitTripped "Trace must record circuit breaker tripped") (assert (not trace.budgetExceeded) "Budget should not be exceeded") (assert (= (listLength steps) 3) "Execution must halt immediately after first failure (gap-audit)") (assert (stringContains? trace.summary "circuit breaker") "Summary must mention circuit breaker") true))

fn testGuardrailBudgetCeilingTrip -> Bool
  (let [(guard (sr/makeGuardrail 300 8 5)) (trace (sr/runGuardedEpistemicTask "TB4-SOLV-01" 3 30000 guard)) (steps trace.steps)] (do (assert (not trace.passed) "Over-budget task execution must record passed false") (assert trace.budgetExceeded "Trace must record budget exceeded") (assert (not trace.circuitTripped) "Circuit breaker must not be tripped on budget halt") (assert (< (listLength steps) 5) "Execution must halt before all 5 steps complete") (assert (stringContains? trace.summary "budget ceiling exceeded") "Summary must state budget ceiling exceeded") true))

fn runTests -> Bool
  (and (testBenchmarkMatrixConstruction) (and (testSolvableTasksExecution) (and (testUnsolvedHardTasksExecution) (and (testTimeoutSupervision) (and (testMixedChallengeMatrixExecution) (and (testBenchmarkReceiptFormatting) (and (testMode2StandardPipeline) (and (testMode3DeepPipeline) (and (testModeComparativeMetrics) (and (testGuardrailCircuitBreakerTrip) (testGuardrailBudgetCeilingTrip)))))))))))
