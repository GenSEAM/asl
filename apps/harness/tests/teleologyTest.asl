(module aslHarness/teleologyTest :x [testScoutMandate testPlannerMandate testImplementerMandate testAuditorMandate testArbiterMandate testMandateTuple testGlobalAntiTamper testCustomMandate testPromptFormatting testAdaptiveDagReplanning testEpistemicPrimitives testValueHierarchyDominance testTriMapReconciliationPass testTriMapOmissionDetection testTriMapBloatDetection testIntentNodeWithTolerance runTests] :i [(teleology :a tel) (multiLensPipeline :a sp)])

fn testScoutMandate -> Bool
  (let [(m (tel/makeScoutMandate)) (vals m.values) (v0 (optionOr (listHead vals) (tel/ValuePriority :priority 0 :valueName "" :rationale "")))] (do (assert (= m.archetypeId "scout")) (assert (stringContains? m.purpose "perceptual")) (assert (>= (listLength m.zoneOfResponsibility) 4)) (assert (>= (listLength m.outOfScope) 4)) (assert (>= (listLength vals) 3)) (assert (= v0.priority 1)) (assert (= v0.valueName "Density & SNR > Verbose Dumps")) (assert (tel/validateActionAgainstMandate m "extract compact AST outline via direct asl form")) (assert (not (tel/validateActionAgainstMandate m "dump full file contents into prompt"))) (assert (not (tel/validateActionAgainstMandate m "dump entire file without outline"))) (assert (not (tel/validateActionAgainstMandate m "modify code in place"))) true))

fn testPlannerMandate -> Bool
  (let [(m (tel/makePlannerMandate)) (vals m.values) (v0 (optionOr (listHead vals) (tel/ValuePriority :priority 0 :valueName "" :rationale "")))] (do (assert (= m.archetypeId "planner")) (assert (stringContains? m.purpose "orchestrator")) (assert (>= (listLength m.zoneOfResponsibility) 4)) (assert (>= (listLength m.outOfScope) 4)) (assert (>= (listLength vals) 3)) (assert (= v0.priority 1)) (assert (= v0.valueName "Falsifiable Gates & Boundary Truth > Speculative Plans")) (assert (tel/validateActionAgainstMandate m "decompose phase into atomic items with gate commands")) (assert (not (tel/validateActionAgainstMandate m "speculative plan without verification gate"))) (assert (not (tel/validateActionAgainstMandate m "plan without gate verification"))) (assert (not (tel/validateActionAgainstMandate m "execute code directly in shell"))) true))

fn testImplementerMandate -> Bool
  (let [(m (tel/makeImplementerMandate)) (vals m.values) (v0 (optionOr (listHead vals) (tel/ValuePriority :priority 0 :valueName "" :rationale "")))] (do (assert (= m.archetypeId "implementer")) (assert (stringContains? m.purpose "Atomic delta executor")) (assert (>= (listLength m.zoneOfResponsibility) 4)) (assert (>= (listLength m.outOfScope) 4)) (assert (>= (listLength vals) 3)) (assert (= v0.priority 1)) (assert (= v0.valueName "Gate Preservation & Zero Weakening > Speed")) (assert (tel/validateActionAgainstMandate m "apply atomic diff and run item gate")) (assert (not (tel/validateActionAgainstMandate m "weaken gate assertion to make it pass"))) (assert (not (tel/validateActionAgainstMandate m "skip test case that fails"))) (assert (not (tel/validateActionAgainstMandate m "remove test to pass gate"))) (assert (not (tel/validateActionAgainstMandate m "self-review and declare phase verified"))) true))

fn testAuditorMandate -> Bool
  (let [(m (tel/makeAuditorMandate)) (vals m.values) (v0 (optionOr (listHead vals) (tel/ValuePriority :priority 0 :valueName "" :rationale "")))] (do (assert (= m.archetypeId "auditor")) (assert (stringContains? m.purpose "truth")) (assert (>= (listLength m.zoneOfResponsibility) 4)) (assert (>= (listLength m.outOfScope) 4)) (assert (>= (listLength vals) 3)) (assert (= v0.priority 1)) (assert (= v0.valueName "Empirical Truth & Falsification > False Consensus")) (assert (tel/validateActionAgainstMandate m "run verification gate and record receipts")) (assert (not (tel/validateActionAgainstMandate m "rubber-stamp unverified assertion"))) (assert (not (tel/validateActionAgainstMandate m "approve without running verification gate"))) (assert (not (tel/validateActionAgainstMandate m "write code to fix bug directly"))) true))

fn testArbiterMandate -> Bool
  (let [(m (tel/makeArbiterMandate)) (vals m.values) (v0 (optionOr (listHead vals) (tel/ValuePriority :priority 0 :valueName "" :rationale "")))] (do (assert (= m.archetypeId "arbiter")) (assert (stringContains? m.purpose "supervisor")) (assert (>= (listLength m.zoneOfResponsibility) 4)) (assert (>= (listLength m.outOfScope) 4)) (assert (>= (listLength vals) 3)) (assert (= v0.priority 1)) (assert (= v0.valueName "Disjoint Authority & Zero Contention")) (assert (tel/validateActionAgainstMandate m "assign task sub-goal to specialized worker")) (assert (not (tel/validateActionAgainstMandate m "monolithic execution without delegation"))) (assert (not (tel/validateActionAgainstMandate m "execute code directly in shell"))) true))

fn testGlobalAntiTamper -> Bool
  (let [(scout (tel/makeScoutMandate)) (planner (tel/makePlannerMandate)) (impl (tel/makeImplementerMandate)) (auditor (tel/makeAuditorMandate)) (arbiter (tel/makeArbiterMandate))] (do (assert (not (tel/validateActionAgainstMandate scout "loosen gate threshold"))) (assert (not (tel/validateActionAgainstMandate planner "bypass gate check"))) (assert (not (tel/validateActionAgainstMandate impl "silent pass on failure"))) (assert (not (tel/validateActionAgainstMandate auditor "unverified assertion approved"))) (assert (not (tel/validateActionAgainstMandate arbiter "weaken gate threshold"))) (assert (not (tel/validateActionAgainstMandate impl "skip gate execution"))) true))

fn testCustomMandate -> Bool
  (let [(v1 (tel/ValuePriority :priority 1 :valueName "Safety" :rationale "Prevent catastrophic state")) (custom (tel/makeAgentMandate "sentinel" "Continuous security invariant sentinel" (list "audit" "guard") (list "weaken" "bypass") (list v1) "Strictly vigilant and non-interactive")) (v0 (optionOr (listHead custom.values) (tel/ValuePriority :priority 0 :valueName "" :rationale "")))] (do (assert (= custom.archetypeId "sentinel")) (assert (= (listLength custom.values) 1)) (assert (= v0.valueName "Safety")) (assert (tel/validateActionAgainstMandate custom "monitor memory metrics")) (assert (not (tel/validateActionAgainstMandate custom "weaken security rule"))) true))

fn testPromptFormatting -> Bool
  (let [(scoutP (tel/formatMandatePrompt (tel/makeScoutMandate))) (planP (tel/formatMandatePrompt (tel/makePlannerMandate))) (implP (tel/formatMandatePrompt (tel/makeImplementerMandate))) (auditP (tel/formatMandatePrompt (tel/makeAuditorMandate)))] (do (assert (stringContains? scoutP "Mandate [scout]")) (assert (stringContains? scoutP "Primary Invariant: Density & SNR > Verbose Dumps")) (assert (stringContains? planP "Mandate [planner]")) (assert (stringContains? implP "Mandate [implementer]")) (assert (stringContains? auditP "Mandate [auditor]")) (assert (< (stringLength scoutP) 500)) (assert (< (stringLength implP) 500)) true))

fn testMandateTuple -> Bool
  (let [(implT (tel/mandate->tuple (tel/makeImplementerMandate))) (auditT (tel/mandate->tuple (tel/makeAuditorMandate))) (scoutT (tel/mandate->tuple (tel/makeScoutMandate))) (planT (tel/mandate->tuple (tel/makePlannerMandate))) (arbT (tel/mandate->tuple (tel/makeArbiterMandate)))] (do (assert (stringContains? implT "(:mandate :id \"implementer\"")) (assert (stringContains? implT ":primary-invariant \"Gate Preservation & Zero Weakening > Speed\"")) (assert (stringContains? auditT "(:mandate :id \"auditor\"")) (assert (stringContains? auditT ":primary-invariant \"Empirical Truth & Falsification > False Consensus\"")) (assert (stringContains? scoutT "(:mandate :id \"scout\"")) (assert (stringContains? planT "(:mandate :id \"planner\"")) (assert (stringContains? arbT "(:mandate :id \"arbiter\"")) (assert (< (stringLength implT) 300)) (assert (< (stringLength auditT) 300)) true))

fn testAdaptiveDagReplanning -> Bool
  (let [(cfg (sp/makeAdaptiveDagConfig 2 true)) (pipe (sp/createMultiLensPipeline "task-test-01" "Implement feature with adaptive fallback"))] (do (assert (= cfg.maxReplanIterations 2)) (assert (= cfg.currentReplanCount 0)) (assert (not (sp/isReplanExhausted? cfg))) (assert (= pipe.finalStatus "pending")) (let [(replan1 (sp/advancePipelineStageAdaptive pipe false "syntax error at line 42" cfg))] (assert (= replan1.finalStatus "replanning")) (assert (= replan1.activeStage "plan")) (assert (> (listLength replan1.phases) (listLength pipe.phases)))) (let [(exhaustedCfg (sp/AdaptiveDAGConfig :maxReplanIterations 2 :currentReplanCount 2 :autoDiagnose true :allowRecovery true))] (assert (sp/isReplanExhausted? exhaustedCfg)) (let [(failedPipe (sp/advancePipelineStageAdaptive pipe false "unresolvable failure" exhaustedCfg))] (assert (= failedPipe.finalStatus "failed")) (assert (not failedPipe.isCompleted)))) true))

fn testEpistemicPrimitives -> Bool
  (let [(gf (sp/recordEpistemicPrimitive "ground-fact" "harness/src/multiLens-pipeline.asl" "AST verified")) (cb (sp/recordEpistemicPrimitive "context-budget" "tokens" "SNR 0.82")) (ar (sp/recordEpistemicPrimitive "adversarial-reflect" "diff" "zero gap detected")) (rr (sp/recordEpistemicPrimitive "reconcile-reality" "asl test" "exit 0 verified"))] (do (assert (= gf.stepType "ground-fact")) (assert gf.executed) (assert (= cb.stepType "context-budget")) (assert (= ar.stepType "adversarial-reflect")) (assert (= rr.stepType "reconcile-reality")) (assert (stringContains? rr.details "exit 0")) true))

fn testValueHierarchyDominance -> Bool
  (do (assert (= (tel/resolveValueConflict 1 2) 1)) (assert (= (tel/resolveValueConflict 0 1) 0)) (assert (= (tel/resolveValueConflict 2 6) 2)) (assert (= (tel/resolveValueConflict 5 3) 3)) (assert (tel/dominatesPriority 0 1)) (assert (tel/dominatesPriority 1 2)) (assert (tel/dominatesPriority 2 3)) (assert (tel/dominatesPriority 3 4)) (assert (tel/dominatesPriority 4 5)) (assert (tel/dominatesPriority 5 6)) (assert (not (tel/dominatesPriority 6 5))) (assert (not (tel/dominatesPriority 3 1))) (assert (stringContains? (tel/getValueName 0) "Human Sovereignty")) (assert (stringContains? (tel/getValueName 1) "Invariant Preservation")) (assert (stringContains? (tel/getValueName 2) "Contractual Intent")) (assert (stringContains? (tel/getValueName 3) "Evidence-Backed")) (assert (stringContains? (tel/getValueName 4) "Minimal Causal Surface")) (assert (stringContains? (tel/getValueName 5) "Lexical SNR")) (assert (stringContains? (tel/getValueName 6) "Execution Velocity")) true)

fn testTriMapReconciliationPass -> Bool
  (let [(sMap (list (tel/makeSMapEntry "Implement rate limiter" (list "R1")) (tel/makeSMapEntry "Max 3 retries" (list "R2")))) (fMap (list (tel/makeFMapEntry "R1" "testRateLimit: 5 asserts" true) (tel/makeFMapEntry "R2" "testMaxRetries: 3 asserts" true))) (bMap (list (tel/makeBMapEntry "H1" "src/client.py" "def request" "R1" true) (tel/makeBMapEntry "H2" "src/client.py" "def retry" "R2" true))) (report (tel/validateReconciliation sMap fMap bMap))] (do (assert report.sMapCovered) (assert report.fMapVerified) (assert report.bMapClean) (assert (listEmpty? report.omittedNodeIds)) (assert (listEmpty? report.bloatHunkIds)) (assert report.passed) true))

fn testTriMapOmissionDetection -> Bool
  (let [(sMap (list (tel/makeSMapEntry "Implement rate limiter" (list "R1")) (tel/makeSMapEntry "Max 3 retries" (list "R2")))) (fMap (list (tel/makeFMapEntry "R1" "testRateLimit: 5 asserts" true) (tel/makeFMapEntry "R2" "" false))) (bMap (list (tel/makeBMapEntry "H1" "src/client.py" "def request" "R1" true))) (report (tel/validateReconciliation sMap fMap bMap))] (do (assert report.sMapCovered) (assert (not report.fMapVerified)) (assert report.bMapClean) (assert (not report.passed)) (assert (= (listLength report.omittedNodeIds) 1)) (assert (= (optionOr (listHead report.omittedNodeIds) "") "R2")) true))

fn testTriMapBloatDetection -> Bool
  (let [(sMap (list (tel/makeSMapEntry "Implement rate limiter" (list "R1")))) (fMap (list (tel/makeFMapEntry "R1" "testRateLimit: 5 asserts" true))) (bMap (list (tel/makeBMapEntry "H1" "src/client.py" "def request" "R1" true) (tel/makeBMapEntry "H2" "src/telemetry.py" "def sendLog" "UNAUTHORIZED" false))) (report (tel/validateReconciliation sMap fMap bMap))] (do (assert report.sMapCovered) (assert report.fMapVerified) (assert (not report.bMapClean)) (assert (not report.passed)) (assert (= (listLength report.bloatHunkIds) 1)) (assert (= (optionOr (listHead report.bloatHunkIds) "") "H2")) true))

fn testIntentNodeWithTolerance -> Bool
  (let [(rNode (tel/makeIntentNode "R1" "Exponential backoff" "exponential backoff to API client" false)) (tNode (tel/makeIntentNode "T1" "Choice of logging library" "use any standard logger" true))] (do (assert (= rNode.id "R1")) (assert (stringContains? rNode.provenanceSpan "exponential backoff")) (assert (not rNode.isTolerance)) (assert (= tNode.id "T1")) (assert tNode.isTolerance) (assert (stringContains? tNode.provenanceSpan "standard logger")) true))

fn runTests -> Bool
  (do (assert (testScoutMandate)) (assert (testPlannerMandate)) (assert (testImplementerMandate)) (assert (testAuditorMandate)) (assert (testArbiterMandate)) (assert (testMandateTuple)) (assert (testGlobalAntiTamper)) (assert (testCustomMandate)) (assert (testPromptFormatting)) (assert (testAdaptiveDagReplanning)) (assert (testEpistemicPrimitives)) (assert (testValueHierarchyDominance)) (assert (testTriMapReconciliationPass)) (assert (testTriMapOmissionDetection)) (assert (testTriMapBloatDetection)) (assert (testIntentNodeWithTolerance)) true)
