(module harness/tests/salesBenchmarkTest :x [loadSalesV04Source! countDelimitersByChars countDelimitersByLexer countWordsInLine countWords isOk testValidParsingViaIndentParser testDelimiterReduction testTokenDensityAndCompaction testD77DualPolarityRefutations runTests] :i [(asl-parser/indentLexer :a lx) (asl-parser/indentParser :a ip) (asl-parser/reader :a rd)])

fn loadSalesV04Source! -> String
  (let [(res (fileRead "harness/fixtures/salesV04.asl"))] (mt res ((ok content) content) ((err _) (let [(altRes (fileRead "fixtures/salesV04.asl"))] (mt altRes ((ok c2) c2) ((err _) ""))))))

fn countDelimitersByChars src: String -> Int64
  (let [(chars (stringChars src))] (fold (fn [(acc Int64) (c String)] -> Int64 (if (or (= c "(") (or (= c ")") (or (= c "[") (= c "]")))) (+ acc 1) acc)) 0 chars))

fn countDelimitersByLexer src: String -> Int64
  (let [(lexRes (lx/tokenizeIndented src)) (toks (pairFirst lexRes))] (fold (fn [(acc Int64) (t lx/IndentToken)] -> Int64 (mt t.kind ((lx/tokLparen) (+ acc 1)) ((lx/tokRparen) (+ acc 1)) ((lx/tokLbracket) (+ acc 1)) ((lx/tokRbracket) (+ acc 1)) (_ acc))) 0 toks))

fn countWordsInLine line: String -> Int64
  (let [(trimmed (stringTrim line))] (if (= (stringLength trimmed) 0) 0 (let [(parts (stringSplit trimmed " "))] (let [(nonEmpty (filter (fn [(p String)] -> Bool (> (stringLength p) 0)) parts))] (listLength nonEmpty)))))

fn countWords text: String -> Int64
  (let [(lines (stringSplit text "\n")) (counts (map countWordsInLine lines))] (fold (fn [(acc Int64) (c Int64)] -> Int64 (+ acc c)) 0 counts))

fn isOk res: (Result rd/SExpr String) -> Bool
  (mt res ((ok _) true) ((err _) false))

fn testValidParsingViaIndentParser src: String -> Bool
  (let [(singleRes (ip/parseIndented src))] (assert (isOk singleRes) "parseIndented must succeed on valid salesV04 source") (let [(formsRes (ip/parseIndentedForms src))] (mt formsRes ((ok forms) (do (assert (>= (listLength forms) 8) "Must parse at least 8 top-level forms") (let [(renderedForms (map (fn [(f rd/SExpr)] -> String (rd/renderPrefix f)) forms)) (allRendered (stringJoin renderedForms "\n"))] (assert (or (stringContains? allRendered "schema Customer") (stringContains? allRendered "dfs Customer")) "Must contain Customer schema") (assert (or (stringContains? allRendered "schema Item") (stringContains? allRendered "dfs Item")) "Must contain Item schema") (assert (or (stringContains? allRendered "schema Order") (stringContains? allRendered "dfs Order")) "Must contain Order schema") (assert (or (stringContains? allRendered "fn validateCustomer") (stringContains? allRendered "df validateCustomer")) "Must contain validateCustomer function") (assert (or (stringContains? allRendered "fn calculateDiscount") (stringContains? allRendered "df calculateDiscount")) "Must contain calculateDiscount function") (assert (or (stringContains? allRendered "fn calculateTax") (stringContains? allRendered "df calculateTax")) "Must contain calculateTax function") (assert (or (stringContains? allRendered "fn validateOrder") (stringContains? allRendered "df validateOrder")) "Must contain validateOrder function") (assert (or (stringContains? allRendered "fn calculateTotal") (stringContains? allRendered "df calculateTotal")) "Must contain calculateTotal function") (assert (or (stringContains? allRendered "fn processOrder") (stringContains? allRendered "df processOrder")) "Must contain processOrder function") (assert (stringContains? allRendered "(mt (validateCustomer") "Must desugar '?' on validateCustomer") (assert (stringContains? allRendered "(mt (validateOrder") "Must desugar '?' on validateOrder") (assert (stringContains? allRendered "((ok __v) __v)") "Must unwrap value in '?' desugaring") (assert (stringContains? allRendered "((err __e) (err __e))") "Must pass the error through in '?' desugaring") (assert (stringContains? allRendered "(.-tier customer)") "Must desugar customer.tier to dot accessor") (assert (stringContains? allRendered "(.-customer order)") "Must desugar order.customer to dot accessor") (assert (stringContains? allRendered "(.-subtotal order)") "Must desugar order.subtotal to dot accessor") true))) ((err msg) (assert false (str "Failed to parse forms from salesV04.asl: " msg)) false))))

fn testDelimiterReduction src: String legacySexpr: String -> Bool
  (let [(v04CharDelims (countDelimitersByChars src)) (v04LexDelims (countDelimitersByLexer src))] (assert (> v04CharDelims 0) "Indented source must contain non-zero delimiters") (assert (= v04CharDelims v04LexDelims) "Char and Lexer delimiter counts must be consistent") (let [(legacyDelims (countDelimitersByChars legacySexpr)) (saved (- legacyDelims v04CharDelims)) (reductionPct (/ (* saved 100) legacyDelims))] (assert (> legacyDelims v04CharDelims) "Legacy S-expressions must require strictly more delimiters") (assert (> reductionPct 30) (str "Delimiter reduction must exceed 30%, observed: " (stringFromInt64 reductionPct) "%")) (assert (>= reductionPct 50) (str "Indented format eliminates redundant closing delimiters: expected >= 50%, got " (stringFromInt64 reductionPct) "%")) true))

fn testTokenDensityAndCompaction src: String legacySexpr: String -> Bool
  (let [(v04Delims (countDelimitersByChars src)) (legacyDelims (countDelimitersByChars legacySexpr)) (v04Chars (stringLength src)) (legacyChars (stringLength legacySexpr)) (v04Words (countWords src)) (legacyWords (countWords legacySexpr)) (v04DelimDensity (/ (* v04Delims 1000) v04Chars)) (legacyDelimDensity (/ (* legacyDelims 1000) legacyChars))] (assert (< v04Chars legacyChars) "Indented format must be character-compact compared to fully parenthesized AST") (assert (> legacyDelims v04Delims) "Indented format has fewer delimiters") (assert (< v04DelimDensity legacyDelimDensity) "Indented format must have strictly lower delimiter density than legacy") (assert (< v04Words legacyWords) "Indented format eliminates closing parenthesis word fragments") true)

fn testD77DualPolarityRefutations src: String legacySexpr: String -> Bool
  (let [(v04Delims (countDelimitersByChars src)) (legacyDelims (countDelimitersByChars legacySexpr)) (saved (- legacyDelims v04Delims)) (reductionPct (/ (* saved 100) legacyDelims))] (refute (<= reductionPct 30) "D77: Refute delimiter reduction <= 30%") (refute (< saved 0) "D77: Refute negative delimiter compaction") (refute (= saved 0) "D77: Refute zero delimiter savings") (refute (stringContains? legacySexpr "?") "D77: Refute unexpanded '?' try operators remaining in AST") (refute (stringContains? legacySexpr "order.customer") "D77: Refute unlowered dot notation in AST") (refute (stringContains? legacySexpr "customer.tier") "D77: Refute unlowered dot notation in AST") (refute (isOk (ip/parseIndented "")) "D77: Refute empty string parsing as valid indented form") (refute (isOk (ip/parseIndented "   \n\n  \n")) "D77: Refute whitespace-only source parsing as valid form") true)

fn ! runTests -> Bool
  (let [(src (loadSalesV04Source!))] (assert (> (stringLength src) 0) "Fixture file harness/fixtures/salesV04.asl must load cleanly") (let [(formsRes (ip/parseIndentedForms src))] (mt formsRes ((ok forms) (let [(renderedForms (map (fn [(f rd/SExpr)] -> String (rd/renderPrefix f)) forms)) (legacySexpr (stringJoin renderedForms "\n"))] (assert (testValidParsingViaIndentParser src) "testValidParsingViaIndentParser passed") (assert (testDelimiterReduction src legacySexpr) "testDelimiterReduction passed") (assert (testTokenDensityAndCompaction src legacySexpr) "testTokenDensityAndCompaction passed") (assert (testD77DualPolarityRefutations src legacySexpr) "testD77DualPolarityRefutations passed") true)) ((err msg) (assert false (str "Failed to parse forms from salesV04.asl: " msg)) false))))
