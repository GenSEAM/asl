(module aslHarness/tests/scoreTest
  :x [runTests near? parenCount]
  :i [(aslHarness/eval :a ev)])

fn scored receipt: String truth: String caseId: String model: String wall: Float64 date: String -> ev/EvalRun
  (mt (ev/scoreCase receipt truth caseId model wall date)
    ((ok run) run)
    ((err e) (do (assert false e) (scored receipt truth caseId model wall "0000-00-00"))))

fn near? a: Float64 b: Float64 -> Bool
  (and (< (- a b) 0.00001) (> (- a b) -0.00001))

fn parenCount s: String ch: String -> Int64
  (- (listLength (stringSplit s ch)) 1)

fn ! caseTasks! -> (List (Pair String String))
  (let [(dir "tests/agentEval/cases")]
    (fold (fn [(acc (List (Pair String String))) (c String)] -> (List (Pair String String))
            (mt (fileReadString (str dir "/" c "/task.asn"))
              ((ok t) (listAppend acc (list (pair c t))))
              ((err _) acc)))
          (list) (listSort (resultOr (dirList dir) (list)))))

fn ! runTests -> Bool
  (let [(truthBackup "(:defect :file \"src/backup.py\" :anchor \"return {\\\"status\\\": \\\"success\\\"\" :kind \"false-green\")")
        (res1 (scored "(:agentReceipt :status :ok :mode :scout :unbacked 0 :turns 1 :findings ((:findings (:claim \"Reports false success\" :file \"src/backup.py\" :anchor \"return {\\\"status\\\": \\\"success\\\"\"))))" truthBackup "scout-false-green" "test-model" 1.2 "2026-09-30"))
        (res2 (scored "(:agentReceipt :status :ok :mode :scout :unbacked 0 :turns 1 :findings ())" truthBackup "scout-false-green" "test-model" 1.5 "2026-09-30"))
        (res3 (scored "(:agentReceipt :status :ok :mode :scout :unbacked 0 :turns 1\n  :findings (\n    (:findings (:claim \"Reports false success\" :file \"src/backup.py\" :anchor \"return {\\\"status\\\": \\\"success\\\"\"))\n    (:findings (:claim \"Irrelevant observation\" :file \"src/other.py\" :anchor \"something_else\"))\n  ))" truthBackup "scout-false-green" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (res4 (scored "(:agentReceipt :status :ok :mode :scout :turns 1 :findings ((:findings (:claim \"Bug\" :file \"src/wrong.py\" :anchor \"return {\\\"status\\\": \\\"success\\\"\"))))" truthBackup "scout-false-green" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (res5 (scored "(:agentReceipt :status :ok :mode :scout :turns 1 :findings ((:findings (:claim \"Settings\" :file \"src/backup.py\" :anchor \"TIMEOUT_SECONDS = 30\"))))" truthBackup "scout-false-green" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (truth6 "(:defects\n  (:defect :file \"src/ring_buffer.py\" :anchor \"if index <= len(self.data):\" :kind \"off-by-one\")\n  (:defect :file \"src/api_client.py\" :anchor \"API_SECRET_KEY\" :kind \"hardcoded-token\"))")
        (res6 (scored "(:agentReceipt :status :ok :mode :scout :turns 1\n  :findings (\n    (:findings (:claim \"Off by one error\" :file \"src/ring_buffer.py\" :anchor \"if index <= len(self.data):\"))\n  ))" truth6 "multi-defect" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (res7 (scored "(:agentReceipt :status :ok :mode :scout :turns 1\n  :findings (\n    (:findings (:claim \"Off by one error\" :file \"src/ring_buffer.py\" :anchor \"if index <= len(self.data):\"))\n    (:findings (:claim \"Hardcoded token\" :file \"src/api_client.py\" :anchor \"API_SECRET_KEY\"))\n  ))" truth6 "multi-defect" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (truthTax "(:gate :cmd \"python3 test_tax.py\" :exit 0)")
        (res8 (scored "(:agentReceipt :status :ok :mode :implement :turns 2 :gates ((:cmd \"python3 test_tax.py\" :exit 0)))" truthTax "implement-tax" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (res9 (scored "(:agentReceipt :status :failed :mode :implement :turns 3 :gates ((:cmd \"python3 test_tax.py\" :exit 1)))" truthTax "implement-tax" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (res9b (scored "(:agentReceipt :status :ok :mode :implement :turns 9 :gates ((:cmd \"python3 test_tax.py\" :exit 1) (:cmd \"python3 test_tax.py\" :exit 0)))" truthTax "implement-tax" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (res9c (scored "(:agentReceipt :status :ok :mode :implement :turns 9 :gates ((:cmd \"python3 test_tax.py\" :exit 0) (:cmd \"python3 test_tax.py\" :exit 1)))" truthTax "implement-tax" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (res10 (scored "(:agentReceipt :status :ok :mode :implement :turns 4 :queueWaitSec 0.45 :execSec 3.82 :gates ((:cmd \"python3 test_tax.py\" :exit 0)))" truthTax "timing-test" "gemini-3.8-flash" 5.12 "2026-09-30"))
        (truth11 "(:defect :file \"src/ring_buffer.py\" :line 16 :kind \"off-by-one\")")
        (res11 (scored "(:agentReceipt :status :ok :mode :scout :turns 1 :findings ((:findings (:claim \"Defect found at line 16\" :file \"src/ring_buffer.py\"))))" truth11 "line-region-test" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (form12 res1.form)
        (dSym (ev/Defect :file "src/backup.py" :anchor "return {\"status\": \"success\"" :kind "" :line (none) :symbol "perform_backup" :raw ""))
        (hit (ev/Finding :file "src/backup.py" :anchor "perform_backup" :claim "perform_backup reports success on failure" :line (none) :raw ""))
        (miss (ev/Finding :file "src/backup.py" :anchor "restore_backup" :claim "restore_backup swallows errors" :line (none) :raw ""))
        (truthScout (ev/parseTruth (resultOr (fileReadString "tests/agentEval/cases/scout-false-green/truth.asn") "")))
        (nested (ev/parseReceipt "(:agentReceipt :status :ok :turns 3 :findings ((:findings (:claim \"a\" :file \"src/backup.py\" :anchor \"if x:\") (:claim \"b\" :file \"src/backup.py\" :anchor \"except E:\"))))").findings)
        (clean "(:agentReceipt :status :ok :deliver :findings :turns 2 :findings ((:findings (:claim \"Defect found at line 16\" :file \"src/ring_buffer.py\"))))")
        (okRun (scored clean truth11 "clean" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (badRun (scored (stringReplace clean ":turns 2" ":turns 2 :written (\"src/ring_buffer.py\")") truth11 "wrote" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (patch (scored "(:agentReceipt :status :ok :deliver :patch :turns 2 :written (\"src/tax.py\") :gates ((:cmd \"python3 test_tax.py\" :exit 0)))" "(:truth (:expectedGate :cmd \"python3 test_tax.py\" :exit 0))" "patch" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (tasks (caseTasks!))
        (batched (scored "(:agentReceipt :status :ok :turns 5 :usage (:input 900 :cached 400 :output 100) :batching (:opsPerTurn 2.5 :singleOpShare 0.25 :opTurns 4))" truth11 "batched" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (planned (scored "(:agentReceipt :status :ok :turns 5 :findings ((:findings (:claim \"x\" :file \"a.py\"))) :batching (:opsPerTurn 2.5 :singleOpShare 0.25 :opTurns 4) :plan (:steps 3 :done 2 :dropped 1 :revisions 1))" truth11 "planned" "gemini-3.8-flash" 0.0 "2026-09-30"))
        (task "(:agent :task \"fix it\" :owns (\"a.py\"))")]
    (do
      (assert (and (= res1.recall 1.0) (and (= res1.precision 1.0) (= res1.status "ok"))) "scoutPerfectRecallAndPrecision")
      (assert (and (= res2.recall 0.0) (and (= res2.precision 0.0) (= res2.status "failed"))) "scoutZeroFindingsZeroRecall")
      (assert (and (= res3.recall 1.0) (and (= res3.precision 0.5) (= res3.status "ok"))) "scoutExtraneousFindingLowerPrecision")
      (assert (and (= res4.recall 0.0) (and (= res4.precision 0.0) (= res4.status "failed"))) "scoutWrongFileNoMatch")
      (assert (and (= res5.recall 0.0) (and (= res5.precision 0.0) (= res5.status "failed"))) "scoutWrongAnchorNoMatch")
      (assert (and (= res6.recall 0.5) (and (= res6.precision 1.0) (= res6.status "failed"))) "scoutMultipleDefectsPartialRecall")
      (assert (and (= res7.recall 1.0) (and (= res7.precision 1.0) (= res7.status "ok"))) "scoutMultipleDefectsFullRecall")
      (assert (and (= res8.recall 1.0) (and (= res8.precision 1.0) (= res8.status "ok"))) "implementGatePass")
      (assert (and (= res9.recall 0.0) (and (= res9.precision 0.0) (= res9.status "failed"))) "implementGateFail")
      (assert (and (= res9b.recall 1.0) (= res9b.status "ok")) "implementGateLastRunGreen")
      (assert (= res9c.recall 0.0) "implementGateLastRunRed")
      (assert (and (= res10.turns 4) (and (near? res10.queueWaitSec 0.45) (near? res10.wallSec 5.12))) "timingAndTurnsExtraction")
      (assert (and (= res11.recall 1.0) (= res11.status "ok")) "lineRegionMatching")
      (assert (and (listAll? (fn [(k String)] -> Bool (stringContains? form12 k)) (list ":evalRun" ":date" ":model" ":case" ":recall" ":precision" ":turns" ":wallSec" ":queueWaitSec" ":status"))
                   (= (parenCount form12 "(") (parenCount form12 ")"))) "evalRunFormFormat")
      (assert (ev/matchFindingToDefect hit dSym) "symbolAnchorMatches")
      (assert (not (ev/matchFindingToDefect miss dSym)) "otherSymbolSameFileMisses")
      (assert (= (mt (listHead truthScout.defects) ((some d) d.symbol) ((none) "")) "perform_backup") "truthCarriesSymbol")
      (assert (= (map (fn [(f ev/Finding)] -> String f.anchor) nested) (list "if x:" "except E:")) "nestedFindingsSplit")
      (assert (and (= okRun.status "ok") (and (stringEmpty? okRun.defect) (and (= badRun.status "failed") (stringContains? badRun.form ":defect \"wrote 1 files on a findings deliverable\"")))) "findingsWriteIsDefect")
      (assert (and (= patch.status "ok") (stringEmpty? patch.defect)) "deliverPatchScoresGates")
      (assert (and (>= (listLength tasks) 9)
                   (and (not (listAny? (fn [(p (Pair String String))] -> Bool (stringContains? (pairSecond p) ":mode")) tasks))
                        (listAll? (fn [(p (Pair String String))] -> Bool (or (not (stringStartsWith? (pairFirst p) "scout-")) (stringContains? (pairSecond p) ":owns ()"))) tasks))) "tasksPassNoMode")
      (assert (and (stringContains? batched.form ":turns 5 :opsPerTurn 2.5 :singleOpShare 0.25 :tokens 1000 ") (= batched.tokens 1000)) "evalRunCarriesBatching")
      (assert (and (= (ev/parseReceipt "(:agentReceipt :status :ok :deliver :patch :turns 1)").mode "implement")
                   (and (= (ev/parseReceipt "(:agentReceipt :status :ok :deliver :findings :turns 1)").mode "scout")
                        (= (ev/parseReceipt "(:agentReceipt :status :ok :mode :implement :turns 1)").mode "implement"))) "receiptDeliverPicksScoring")
      (assert (and (stringEndsWith? planned.form " :plan (:steps 3 :done 2 :dropped 1 :revisions 1))")
                   (and (mt planned.plan ((some pl) (and (= pl.steps 3) (and (= pl.done 2) (and (= pl.dropped 1) (= pl.revisions 1))))) ((none) false))
                        (and (not (stringContains? batched.form ":plan ")) (none? batched.plan)))) "evalRunCarriesPlan")
      (assert (mt (ev/scoreCase "(:agentReceipt :status :ok :mode :scout :turns 1 :findings ())" truth11 "undated" "gemini-3.8-flash" 0.0 "")
                ((err e) (stringStartsWith? e "ERR_DATE: case undated"))
                ((ok run) false)) "emptyDateIsErrDate")
      (assert (stringContains? (ev/buildInvocation task "gemini-3.8-flash" "") ":model \"gemini-3.8-flash\"") "invocationKeepsModelWithoutProfile")
      (assert (and (not (stringContains? (ev/buildInvocation task "profile-agy" "agy") ":model")) (not (stringContains? (ev/buildInvocation task "none" "") ":model"))) "invocationOmitsModelWithProfile")
      true))
