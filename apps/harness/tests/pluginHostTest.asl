(module aslHarness/pluginHostTest :x [testPluginManifestLoading testPriorityAndDependencyOrdering testPreStepMutation testPreToolSecurityBlockingAbort testPostToolPayloadRedaction testStepHookAdapterWiringAndDispatch runTests] :i [(aslAgentCore/onion :a on) (pluginHost :a host) (stepMiddleware :a sm)])

fn testPluginManifestLoading -> Bool
  (let [(res1 (host/loadPluginFromSource ".asl/plugins/guard.asl")) (res2 (host/loadPluginFromSource "plugins/custom-tool.asl")) (resErr (host/loadPluginFromSource "nonexistent/path.asl")) (resEmpty (host/loadPluginFromSource ""))] (do (assert (mt res1 ((ok _) true) ((err _) false)) "Valid plugin source path must load successfully") (assert (mt res1 ((ok m) (= m.id "guard")) ((err _) false)) "Extracted plugin id must equal guard") (assert (mt res1 ((ok m) m.compiled) ((err _) false)) "Pre-compilation flag must be true") (assert (mt res2 ((ok m) (= m.id "custom-tool")) ((err _) false)) "Extracted plugin id must equal custom-tool") (assert (mt resErr ((ok _) false) ((err _) true)) "Nonexistent plugin source must return error") (assert (mt resEmpty ((ok _) false) ((err _) true)) "Empty plugin path must return error") true))

fn testPriorityAndDependencyOrdering -> Bool
  (let [(pTelemetry (host/makePluginConfig "mw-telemetry" ".asl/plugins/telemetry.asl" "telemetry" (list ":step:post") 100)) (pJail (host/makePluginConfig "mw-jail" ".asl/plugins/jail.asl" "jail" (list ":step:pre") 10)) (pAudit (host/makePluginConfig "mw-audit" ".asl/plugins/audit.asl" "audit" (list ":step:pre") 50)) (pipe (host/buildPluginPipeline (list pTelemetry pJail pAudit))) (sortedMws pipe.sorted) (m0 (optionOr (listHead sortedMws) (on/makeMiddleware "" "" (on/kindStepPre) 0 (list) (list)))) (tail1 (optionOr (listTail sortedMws) (list))) (m1 (optionOr (listHead tail1) (on/makeMiddleware "" "" (on/kindStepPre) 0 (list) (list)))) (tail2 (optionOr (listTail tail1) (list))) (m2 (optionOr (listHead tail2) (on/makeMiddleware "" "" (on/kindStepPre) 0 (list) (list))))] (do (assert (= (listLength pipe.middlewares) 3) "Pipeline must contain 3 registered middlewares") (assert (= (listLength sortedMws) 3) "Sorted pipeline must contain 3 middlewares") (assert (= m0.id "mw-jail") "Highest precedence middleware with priority 10 must execute first") (assert (= m1.id "mw-audit") "Intermediate middleware with priority 50 must execute second") (assert (= m2.id "mw-telemetry") "Lowest precedence middleware with priority 100 must execute last") true))

fn testPreStepMutation -> Bool
  (let [(pMutate (host/makePluginConfig "mw-transform" ".asl/plugins/transform.asl" "transform" (list ":step:pre") 20)) (pipe (host/buildPluginPipeline (list pMutate))) (ctx (on/makeStepContext "step-101" "sess-test" 0 "input-raw" "payload-raw")) (dec (host/executeStepPipeline pipe ctx))] (do (assert dec.proceed "Decision must allow turn execution to proceed") (assert dec.mutate "Decision mutate flag must be asserted true") (assert (= dec.action "mutate") "Decision action must be mutate") (assert (not dec.abort) "Decision abort flag must be false") (assert (stringContains? dec.context.input "mw-transform") "Context input must carry transformed payload from middleware") true))

fn testPreToolSecurityBlockingAbort -> Bool
  (let [(pGuard (host/makePluginConfig "mw-jail" ".asl/plugins/jail.asl" "jail" (list ":tool:pre") 10)) (pipe (host/buildPluginPipeline (list pGuard))) (ctxSafe (on/makeStepContext "step-sec-1" "sess-sec" 1 "read safe file" "cat safe.txt")) (decSafe (host/executeStepPipeline pipe ctxSafe)) (ctxBlock (on/makeStepContext "step-sec-2" "sess-sec" 2 "run destructive shell" "blocked: rm -rf /")) (decBlock (host/executeStepPipeline pipe ctxBlock))] (do (assert decSafe.proceed "Safe invocation must proceed through tool guard") (assert (not decSafe.abort) "Safe invocation must not be aborted") (assert (not decBlock.proceed) "Dangerous invocation must be halted") (assert decBlock.abort "Dangerous invocation must assert abort flag") (assert (= decBlock.action "abort") "Dangerous invocation action must equal abort") (assert (stringContains? decBlock.reason "Aborted by middleware") "Decision reason must cite middleware abort") true))

fn testPostToolPayloadRedaction -> Bool
  (let [(pRedact (host/makePluginConfig "mw-redact" ".asl/plugins/redact.asl" "redact" (list ":tool:post") 30)) (pipe (host/buildPluginPipeline (list pRedact))) (ctx (on/makeStepContext "step-red-1" "sess-red" 3 "get credentials" "token=secret_value_xyz")) (dec (host/executeStepPipeline pipe ctx))] (do (assert dec.proceed "Redaction middleware must allow execution to proceed") (assert dec.mutate "Redaction middleware must mark context as mutated") (assert (not dec.abort) "Redaction middleware must not abort safe turns") (assert (not (stringContains? dec.context.payload "secret")) "Payload must not contain raw secret token") (assert (stringContains? dec.context.payload "[REDACTED]") "Payload must contain redacted marker") true))

fn testStepHookAdapterWiringAndDispatch -> Bool
  (let [(pPre (host/makePluginConfig "mw-pre" ".asl/plugins/pre.asl" "pre" (list ":step:pre") 10)) (pPost (host/makePluginConfig "mw-post" ".asl/plugins/post.asl" "post" (list ":step:post") 90)) (pipe (host/buildPluginPipeline (list pPre pPost))) (adapter (sm/wireStepPlugins pipe)) (ctx (on/makeStepContext "step-ad-1" "sess-ad" 4 "clean turn" "payload ok")) (dec (sm/dispatchStepInterceptors adapter ctx))] (do (assert (= adapter.adapterName "asl-step-hook-adapter") "Adapter name must match standard identifier") (assert (> (sm/adapterActiveCount adapter) 0) "Adapter active hook count must be greater than zero") (assert (sm/adapterHasHook? adapter "kind-step-pre") "Adapter must report active kind-step-pre hook") (assert (sm/adapterHasHook? adapter "kind-step-post") "Adapter must report active kind-step-post hook") (assert (not (sm/adapterHasHook? adapter "nonexistent-hook")) "Adapter must not report unregistered hooks") (assert dec.proceed "Adapter interceptor dispatch must proceed on clean input") (assert (not dec.abort) "Adapter interceptor dispatch must not abort on clean input") true))

fn runTests -> Bool
  (and (testPluginManifestLoading) (and (testPriorityAndDependencyOrdering) (and (testPreStepMutation) (and (testPreToolSecurityBlockingAbort) (and (testPostToolPayloadRedaction) (testStepHookAdapterWiringAndDispatch))))))
