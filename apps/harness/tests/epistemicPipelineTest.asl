(module aslHarness/epistemicPipelineTest :x [testPipelineStageEnumeration testReflectionConfigDefaults testFidelityGateEvaluation testFidelityGatePromptOverlap testTaskEntropyFormula testAdaptiveEntropyThresholds test7StagePipelineConstruction testOperationalModelConstructionAndFormatting testEpistemicPipelineExecution runTests] :i [(multiLensPipeline :a sp) (operationalModel :a op)])

fn testPipelineStageEnumeration -> Bool
  (let [(s1 (sp/s1Ingest)) (s2 (sp/s2Reformulate)) (s3 (sp/s3IntentGate)) (s4 (sp/s4Plan)) (s5 (sp/s5PlanGate)) (s6 (sp/s6Implement)) (s7 (sp/s7Verify))] (do (assert (not (= s1 s2))) (assert (not (= s3 s4))) (assert (not (= s5 s6))) (assert (= s1 (sp/s1Ingest))) true))

fn testReflectionConfigDefaults -> Bool
  (let [(cfg (sp/defaultReflectionConfig))] (do (assert (= (listLength cfg.enabledStages) 7)) (assert (not cfg.allowFastPath)) (assert (>= cfg.minFidelityScore 0.95)) (assert cfg.strictFalsify) true))

fn testFidelityGateEvaluation -> Bool
  (let [(cfg (sp/defaultReflectionConfig)) (vPass (sp/ReflectionVerdict :stage (sp/s7Verify) :passed true :hallucinations (list) :omittedConstraints (list) :confidenceScore 0.98)) (vLow (sp/ReflectionVerdict :stage (sp/s7Verify) :passed true :hallucinations (list) :omittedConstraints (list "missing corner case") :confidenceScore 0.82)) (vFail (sp/ReflectionVerdict :stage (sp/s7Verify) :passed false :hallucinations (list "unsupported claim") :omittedConstraints (list) :confidenceScore 0.99))] (do (assert (sp/evaluateFidelityGate vPass cfg)) (assert (not (sp/evaluateFidelityGate vLow cfg))) (assert (not (sp/evaluateFidelityGate vFail cfg))) true))

fn testFidelityGatePromptOverlap -> Bool
  (let [(prompt "Implement cross-agent task contract and verified execution receipts") (goodRef "Will implement cross-agent task contract and verified execution receipts in mesh") (badRef "Unrelated text talking about cooking recipes without any keywords") (vGood (sp/evaluatePromptFidelity prompt goodRef 0.8)) (vBad (sp/evaluatePromptFidelity prompt badRef 0.8))] (do (assert vGood.passed) (assert (>= vGood.confidenceScore 0.8)) (assert (not vBad.passed)) (assert (< vBad.confidenceScore 0.8)) (assert (> (listLength vBad.omittedConstraints) 0)) true))

fn testTaskEntropyFormula -> Bool
  (let [(eLow (sp/computeTaskEntropy 1 0.1 0.1 0.1)) (eHigh (sp/computeTaskEntropy 12 0.9 0.9 0.9))] (do (assert (< eLow 1.0)) (assert (> eHigh 9.0)) (assert (not (= eLow eHigh))) true))

fn testAdaptiveEntropyThresholds -> Bool
  (let [(hLow (sp/computeTaskEntropy 1 0.2 0.1 0.1)) (hMed (sp/computeTaskEntropy 2 0.5 0.5 0.2)) (hHigh (sp/computeTaskEntropy 4 0.9 0.8 0.9)) (profLow (sp/selectPipelineProfile hLow)) (profMed (sp/selectPipelineProfile hMed)) (profHigh (sp/selectPipelineProfile hHigh))] (do (assert (= profLow "fast")) (assert (= profMed "standard")) (assert (= profHigh "full")) (assert (not (= profLow "full"))) true))

fn test7StagePipelineConstruction -> Bool
  (let [(pipe (sp/make7StagePipeline "task-42" "Implement Epistemic Reflection Pipeline")) (phases pipe.phases)] (do (assert (= pipe.taskId "task-42")) (assert (= pipe.activeStage "s1-ingest")) (assert (= (listLength phases) 7)) (assert (= (optionOr (listHead phases) (sp/StepPhase :id "" :name "" :stage "" :gateCommand "" :status "" :findings (list))).stage "s1-ingest")) (assert (not (= (listLength phases) 0))) true))

fn testOperationalModelConstructionAndFormatting -> Bool
  (let [(model (op/makeOperationalModel (list "harness/src/multiLens-pipeline.asl" "harness/src/operational-model.asl") (list "execute-epistemic-pipeline" "OperationalModel") "asl test --strict-falsify" (list "no foreign deps" "zero comments"))) (formatted (op/formatOperationalModel model))] (do (assert (= (listLength model.targetFiles) 2)) (assert (= (listLength model.requiredSymbols) 2)) (assert (= model.expectedExitBehavior "asl test --strict-falsify")) (assert (= (listLength model.forbiddenSideEffects) 2)) (assert (stringContains? formatted ":operational-model")) (assert (stringContains? formatted ":target-files")) (assert (stringContains? formatted "harness/src/multiLens-pipeline.asl")) (assert (stringContains? formatted ":required-symbols")) (assert (stringContains? formatted ":forbidden-side-effects")) (assert (not (stringEmpty? formatted))) true))

fn testEpistemicPipelineExecution -> Bool
  (let [(cfg (sp/defaultReflectionConfig)) (instClean "Refactor harness/src/multiLens-pipeline.asl to implement execute-epistemic-pipeline with zero foreign files and verify via asl test --strict-falsify") (modelClean (op/makeOperationalModel (list "harness/src/multiLens-pipeline.asl") (list "execute-epistemic-pipeline") "asl test --strict-falsify harness/tests/epistemic_pipeline_test.asl" (list "zero foreign files" "never use foreign packages"))) (vClean (sp/executeEpistemicPipeline instClean modelClean cfg)) (instOmitted "Refactor harness/src/multiLens-pipeline.asl and harness/src/operational-model.asl to implement execute-epistemic-pipeline with zero foreign files and verify via asl test --strict-falsify") (modelOmitted (op/makeOperationalModel (list "harness/src/multiLens-pipeline.asl") (list "execute-epistemic-pipeline") "asl test --strict-falsify" (list "zero foreign files"))) (vOmitted (sp/executeEpistemicPipeline instOmitted modelOmitted cfg)) (instHallucinated "Refactor harness/src/multiLens-pipeline.asl to implement execute-epistemic-pipeline with zero foreign files and verify via asl test --strict-falsify") (modelHallucinated (op/makeOperationalModel (list "harness/src/multiLens-pipeline.asl") (list "execute-epistemic-pipeline" "axios-http-client") "asl test --strict-falsify" (list "zero foreign files"))) (vHallucinated (sp/executeEpistemicPipeline instHallucinated modelHallucinated cfg))] (do (assert vClean.passed) (assert (>= vClean.confidenceScore 0.95)) (assert (= (listLength vClean.omittedConstraints) 0)) (assert (= (listLength vClean.hallucinations) 0)) (assert (not vOmitted.passed)) (assert (> (listLength vOmitted.omittedConstraints) 0)) (assert (not vHallucinated.passed)) (assert (> (listLength vHallucinated.hallucinations) 0)) true))

fn runTests -> Bool
  (do (assert (testPipelineStageEnumeration)) (assert (testReflectionConfigDefaults)) (assert (testFidelityGateEvaluation)) (assert (testFidelityGatePromptOverlap)) (assert (testTaskEntropyFormula)) (assert (testAdaptiveEntropyThresholds)) (assert (test7StagePipelineConstruction)) (assert (testOperationalModelConstructionAndFormatting)) (assert (testEpistemicPipelineExecution)) true)
