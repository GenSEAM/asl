(module aslHarness/supervisorHandoffTest :x [testDelegationPlanning testSingleTokenBriefs testSpeculativeDualRace testCleanContextAdjudication testTimeTravelRollback runTests] :i [(delegate :a del) (handoff :a hnd) (taskWorker :a tw) (supervisor :a sup) (aslMem/vfsFork :a vf)])

fn testDelegationPlanning -> Bool
  (let [(planRace (del/makeDelegationPlan "t-001" (del/speculativeRace))) (planSingle (del/makeDelegationPlan "t-002" (del/single))) (planSup (del/makeDelegationPlan "t-003" (del/cleanSupervisor))) (slices (del/multiplexContextSlices "contract: verify CAS" (list "alpha" "beta")))] (do (assert (= planRace.taskId "t-001") "Plan task-id must equal t-001") (assert (= (listLength planRace.lanes) 2) "Speculative race must have exactly 2 lanes") (assert (= (listLength planRace.temperatures) 2) "Speculative race must have 2 temperature bindings") (assert (= (listLength planSingle.lanes) 1) "Single worker delegation must have 1 lane") (assert (= (listLength planSup.lanes) 1) "Clean supervisor delegation must have 1 lane") (assert (= (listLength slices) 2) "Multiplexed context slices must produce 2 slices") (assert (stringContains? (optionOr (listHead slices) "") ":lane \"alpha\"") "First slice must target alpha lane") true))

fn testSingleTokenBriefs -> Bool
  (let [(brief (hnd/makeHandoffBrief "t-100" "alpha" "worker-conservative" 0.1 "optimize inner loop" 2000)) (asnBrief (hnd/formatBriefAsn brief)) (audit (hnd/makeCleanAudit "t-100" "asl check" "alpha" 0 "syntax ok" "" "no diff")) (asnAudit (hnd/formatAuditAsn audit))] (do (assert (stringContains? asnBrief ":task \"t-100\"") "Brief ASN must encode single-token :task key") (assert (stringContains? asnBrief ":lane \"alpha\"") "Brief ASN must encode single-token :lane key") (assert (stringContains? asnBrief ":temp 0.1") "Brief ASN must encode single-token :temp key") (assert (stringContains? asnBrief ":budget 2000") "Brief ASN must encode single-token :budget key") (assert (<= (+ (/ (stringLength asnBrief) 3) 1) 150) "Handoff brief must remain strictly bounded under 150 tokens") (assert (stringContains? asnAudit ":receipt \"exit=0") "Clean audit ASN must encode single-token :receipt key") (assert (stringContains? asnAudit ":pass true") "Clean audit ASN must encode single-token :pass key") true))

fn testSpeculativeDualRace -> Bool
  (let [(briefA (hnd/makeHandoffBrief "t-200" "alpha" "worker-conservative" 0.1 "fix leak" 1000)) (resA (tw/executeSpeculativeLane briefA "fork-alpha")) (briefB (hnd/makeHandoffBrief "t-200" "beta" "worker-exploratory" 0.7 "fix leak" 1000)) (resB (tw/executeSpeculativeLane briefB "fork-beta")) (resFail (tw/WorkerLaneResult :lane "alpha" :temp 0.1 :exitCode 1 :output "err" :mutatedPaths (list) :passed false :durationMs 200)) (resWin (tw/WorkerLaneResult :lane "beta" :temp 0.7 :exitCode 0 :output "ok" :mutatedPaths (list) :passed true :durationMs 150)) (resFast (tw/WorkerLaneResult :lane "alpha" :temp 0.1 :exitCode 0 :output "ok" :mutatedPaths (list) :passed true :durationMs 100)) (resSlow (tw/WorkerLaneResult :lane "beta" :temp 0.7 :exitCode 0 :output "ok" :mutatedPaths (list) :passed true :durationMs 300)) (resTieA (tw/WorkerLaneResult :lane "alpha" :temp 0.1 :exitCode 0 :output "ok" :mutatedPaths (list) :passed true :durationMs 100)) (resTieB (tw/WorkerLaneResult :lane "beta" :temp 0.7 :exitCode 0 :output "ok" :mutatedPaths (list) :passed true :durationMs 100)) (dummyBranch (vf/VFSBranch :branchId "branch-beta" :parentId "root" :createdAtMs 1725793200000 :buffers (list) :compensations (list) :status "active" :causalId "")) (pruned (tw/pruneLosingLane dummyBranch))] (do (assert (tw/isLaneSuccessful? resA) "Conservative lane T=0.1 must succeed cleanly") (assert (not (tw/isLaneSuccessful? resB)) "Exploratory lane T=0.7 with errors must not pass") (assert (= (tw/raceLanesCompletion resA resB).lane "alpha") "First-green decisive race must select passing alpha lane") (assert (= (tw/raceLanesCompletion resFail resWin).lane "beta") "First-green decisive race must select passing beta lane") (assert (= (tw/raceLanesCompletion resFast resSlow).lane "alpha") "Fastest passing trajectory must win latency race") (assert (= (tw/raceLanesCompletion resTieA resTieB).lane "alpha") "Deterministic tie-breaking must favor conservative lower temperature") (assert (= pruned.status "aborted") "Losing branch must be pruned to aborted status") true))

fn testCleanContextAdjudication -> Bool
  (let [(auditPass (hnd/makeCleanAudit "t-300" "asl check" "alpha" 0 "valid" "" "mutated src/foo.asl")) (verdictPass (sup/adjudicateCleanAudit auditPass)) (auditSyntax (hnd/makeCleanAudit "t-301" "asl check" "beta" 1 "" "syntax error at line 5" "")) (verdictSyntax (sup/adjudicateCleanAudit auditSyntax)) (auditFail (hnd/makeCleanAudit "t-302" "asl test" "alpha" 2 "" "assertion failed: expected 4 got 5" "")) (verdictFail (sup/adjudicateCleanAudit auditFail))] (do (assert (= verdictPass.status "pass") "Passing physical audit must receive pass verdict") (assert (= verdictPass.chosenLane "alpha") "Passing audit must select candidate lane") (assert (= verdictPass.confidence 1.0) "Clean passing audit must yield 1.0 confidence") (assert (= verdictSyntax.status "retry") "Syntax error stderr must produce retry verdict") (assert (!= verdictSyntax.hint "") "Retry verdict must supply steering hint") (assert (= verdictFail.status "fail") "Logical assertion failure must produce fail verdict") true))

fn testTimeTravelRollback -> Bool
  (let [(st0 (sup/makeSupervisorState)) (st1 (sup/SupervisorState :activeTasks (list "t-400" "t-401") :checkpoints st0.checkpoints :speculativeEnabled true :cleanAuditEnabled true)) (st2 (sup/setTaskCheckpoint st1 "t-400" "cas-hash-c0ffee")) (stRolled (sup/rollbackTaskState st2 "t-400")) (auditErr (hnd/makeCleanAudit "t-401" "asl gate" "alpha" 1 "" "timeout after 10000ms" "")) (cycleVerdict (sup/runSupervisorCycle stRolled auditErr)) (cleanEnvelopeStr (hnd/formatAuditAsn auditErr))] (do (assert (= (sup/getTaskCheckpoint st2 "t-400") "cas-hash-c0ffee") "Registered CAS checkpoint must be recoverable") (assert (= (listLength stRolled.activeTasks) 1) "Rollback must remove failed task from active task list") (assert (= (optionOr (listHead stRolled.activeTasks) "") "t-401") "Remaining active task must be preserved") (assert (= cycleVerdict.status "retry") "Supervisor cycle must adjudicate timeout receipt into retry") (assert (not (stringContains? cleanEnvelopeStr "sorry")) "Clean audit envelope must contain zero conversational apologies") (assert (not (stringContains? cleanEnvelopeStr "apologize")) "Clean audit envelope must prevent apology loops") true))

fn runTests -> Bool
  (and (testDelegationPlanning) (and (testSingleTokenBriefs) (and (testSpeculativeDualRace) (and (testCleanContextAdjudication) (testTimeTravelRollback)))))
