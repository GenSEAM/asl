(module aslHarness/auditProtocolTest :x [testFindingConstructionAndAccessors testCrutchAndCriticalDetection testAuditVerdictAggregation testMetaAuditAdequacy testAsnSerialization runTests] :i [(auditProtocol :a ap)])

fn testFindingConstructionAndAccessors -> Bool
  (let [(f (ap/makeAuditFinding "crutch-scaffolding" "harness/src/foo.asl" "temp-shim" "def-temp-shim" "Temporary workaround" "C0003" "asl check harness/src/foo.asl"))] (do (assert (= f.category "crutch-scaffolding") "Finding category must match") (assert (= f.filePath "harness/src/foo.asl") "Finding file-path must match") (assert (= f.symbol "temp-shim") "Finding symbol identifier must match") (assert (= f.anchor "def-temp-shim") "Finding anchor must match") (assert (= f.intentRationale "C0003") "Finding intent rationale must match") (assert (= f.remediationGate "asl check harness/src/foo.asl") "Remediation gate must match") true))

fn testCrutchAndCriticalDetection -> Bool
  (let [(fCrutch (ap/makeAuditFinding "crutch-scaffolding" "src/a.asl" "shim" "anc-shim" "shim desc" "C0003" "gate-cmd")) (fDrift (ap/makeAuditFinding "architectural-drift" "src/b.asl" "leak" "anc-leak" "leak desc" "D0034" "gate-cmd")) (fVacuous (ap/makeAuditFinding "vacuous-verification" "tests/c.asl" "empty-test" "anc-test" "vacuous desc" "ground-truth" "gate-cmd")) (fFeature (ap/makeAuditFinding "incomplete-feature" "src/d.asl" "missing-branch" "anc-feat" "feature desc" "intent" "gate-cmd"))] (do (assert (ap/isCrutchFinding? fCrutch) "Crutch finding must be identified as crutch") (assert (not (ap/isCrutchFinding? fDrift)) "Architectural drift is not a crutch") (assert (not (ap/isCrutchFinding? fVacuous)) "Vacuous verification is not a crutch") (assert (not (ap/isCrutchFinding? fFeature)) "Incomplete feature is not a crutch") (assert (ap/isCriticalFinding? fDrift) "Architectural drift must be classified as critical") (assert (ap/isCriticalFinding? fVacuous) "Vacuous verification must be classified as critical") (assert (not (ap/isCriticalFinding? fCrutch)) "Crutch finding is not critical") (assert (not (ap/isCriticalFinding? fFeature)) "Incomplete feature is not critical") true))

fn testAuditVerdictAggregation -> Bool
  (let [(fCrutch (ap/makeAuditFinding "crutch-scaffolding" "src/a.asl" "shim" "anc-shim" "desc" "C0003" "gate")) (fDrift (ap/makeAuditFinding "architectural-drift" "src/b.asl" "leak" "anc-leak" "desc" "D0034" "gate")) (fFeature (ap/makeAuditFinding "incomplete-feature" "src/c.asl" "feat" "anc-feat" "desc" "intent" "gate")) (vEmpty (ap/evaluateAuditFindings (list))) (vCrutch (ap/evaluateAuditFindings (list fCrutch fFeature))) (vCrit (ap/evaluateAuditFindings (list fCrutch fDrift)))] (do (assert vEmpty.passed "Empty findings must pass") (assert (= vEmpty.verdictTag "approve") "Empty findings verdict tag must be approve") (assert (= vEmpty.totalFindings 0) "Empty findings total count must be 0") (assert (= vEmpty.crutchCount 0) "Empty findings crutch count must be 0") (assert vCrutch.passed "Crutch-only findings must pass with amendments") (assert (= vCrutch.verdictTag "approve-with-amendments") "Verdict tag must be approve-with-amendments") (assert (= vCrutch.totalFindings 2) "Total findings count must be 2") (assert (= vCrutch.crutchCount 1) "Crutch count must be 1") (assert (not vCrit.passed) "Critical findings must fail verdict") (assert (= vCrit.verdictTag "reject") "Critical verdict tag must be reject") (assert (= vCrit.totalFindings 2) "Critical total findings count must be 2") (assert (= vCrit.crutchCount 1) "Critical crutch count must be 1") true))

fn testMetaAuditAdequacy -> Bool
  (let [(rPass (ap/makeMetaAuditReport "asl-review" true 92 (list "crutch-scaffolding" "incomplete-feature") (list))) (rLowScore (ap/makeMetaAuditReport "auditor" true 75 (list "crutch-scaffolding") (list))) (rInadequate (ap/makeMetaAuditReport "auditor" false 95 (list) (list))) (rGaps (ap/makeMetaAuditReport "auditor" true 95 (list "crutch-scaffolding") (list "missed-crutch-at-line-10")))] (do (assert (ap/isMetaAuditAdequate? rPass) "High score with no gaps must be adequate") (assert (not (ap/isMetaAuditAdequate? rLowScore)) "Score below 80 must be inadequate") (assert (not (ap/isMetaAuditAdequate? rInadequate)) "Flagged inadequate report must fail") (assert (not (ap/isMetaAuditAdequate? rGaps)) "Report with missing gaps must fail") true))

fn testAsnSerialization -> Bool
  (let [(f (ap/makeAuditFinding "crutch-scaffolding" "harness/src/foo.asl" "temp-shim" "anc-temp" "Temporary workaround" "C0003" "asl check")) (v (ap/makeAuditVerdict true "approve-with-amendments" 1 1 (list f))) (sFinding (ap/formatFindingAsn f)) (sVerdict (ap/formatVerdictAsn v))] (do (assert (stringContains? sFinding ":finding") "Finding ASN must contain :finding tag") (assert (stringContains? sFinding ":cat :crutch-scaffolding") "Finding ASN must contain :cat :crutch-scaffolding") (assert (stringContains? sFinding "harness/src/foo.asl") "Finding ASN must contain file path") (assert (stringContains? sFinding ":sym \"temp-shim\"") "Finding ASN must contain symbol") (assert (stringContains? sFinding ":anchor \"anc-temp\"") "Finding ASN must contain anchor") (assert (not (stringContains? sFinding ":line")) "Finding ASN must NOT contain integer line numbers (ADR D98)") (assert (stringContains? sVerdict ":verdict") "Verdict ASN must contain :verdict tag") (assert (stringContains? sVerdict ":passed true") "Verdict ASN must contain :passed true") (assert (stringContains? sVerdict ":tag :approve-with-amendments") "Verdict ASN must contain :tag") (assert (stringContains? sVerdict ":total 1") "Verdict ASN must contain :total 1") (assert (stringContains? sVerdict ":crutches 1") "Verdict ASN must contain :crutches 1") true))

fn runTests -> Bool
  (do (assert (testFindingConstructionAndAccessors)) (assert (testCrutchAndCriticalDetection)) (assert (testAuditVerdictAggregation)) (assert (testMetaAuditAdequacy)) (assert (testAsnSerialization)) true)
