(module aslHarness/tests/contextBenchTest :x [testBenchTaskCreation testStrategySimulationTokens testVariationalComparisonAndSavings testAmnesiaInterceptionAcrossStrategies testReportFormattingAsn runTests] :i [(contextBench :a cb) (contextAssembler :a ca)])

fn testBenchTaskCreation -> Bool
  (let [(tasks (cb/standardBenchmarkTasks)) (t1 (optionOr (listHead tasks) (cb/makeBenchTask "" "" 0 (list) (list) false)))] (do (assert (= (listLength tasks) 2) "Tasks list length must equal 2") (assert (= t1.taskId "CTX-BENCH-01") "First task ID must match CTX-BENCH-01") (assert (= t1.totalSteps 4) "First task must have 4 steps") (assert (= (listLength t1.requiredFacts) 2) "First task must have 2 required facts") (assert (not t1.hardChallenge) "First task should not be hard challenge") true))

fn testStrategySimulationTokens -> Bool
  (let [(tasks (cb/standardBenchmarkTasks)) (t1 (optionOr (listHead tasks) (cb/makeBenchTask "" "" 0 (list) (list) false))) (mBase (cb/simulateTaskUnderStrategy t1 "baseline" 4096)) (mRcpt (cb/simulateTaskUnderStrategy t1 "receipts" 4096)) (mJit (cb/simulateTaskUnderStrategy t1 "jit-memory" 4096)) (mAgent (cb/simulateTaskUnderStrategy t1 "agent-directed" 4096))] (do (assert (= mBase.strategy "baseline") "m-base strategy must be baseline") (assert (= mRcpt.strategy "receipts") "m-rcpt strategy must be receipts") (assert (= mAgent.strategy "agent-directed") "m-agent strategy must be agent-directed") (assert mBase.passed "m-base must pass solvable task") (assert mRcpt.passed "m-rcpt must pass solvable task") (assert mAgent.passed "m-agent must pass solvable task") (assert (< mRcpt.promptTokens mBase.promptTokens) "Receipts tokens must be less than baseline") (assert (< mAgent.promptTokens mBase.promptTokens) "Agent-directed tokens must be less than baseline") (assert (not mBase.amnesiaDetected) "Baseline must not suffer amnesia") (assert (not mRcpt.amnesiaDetected) "Receipts must retain facts without amnesia") (assert (not mAgent.amnesiaDetected) "Agent-directed must retain facts without amnesia") (assert (> mBase.durationMs 0) "Duration must be positive") (assert (stringContains? mAgent.receipt ":strategy \"agent-directed\"") "Receipt must mention agent-directed") true))

fn testVariationalComparisonAndSavings -> Bool
  (let [(tasks (cb/standardBenchmarkTasks)) (t1 (optionOr (listHead tasks) (cb/makeBenchTask "" "" 0 (list) (list) false))) (rep (cb/compareStrategiesOnTask t1 4096))] (do (assert (= rep.taskId "CTX-BENCH-01") "Report task-id must match") (assert (> rep.receiptsSavingsPct 10.0) "Receipts savings must exceed 10%") (assert (> rep.agentSavingsPct 15.0) "Agent savings must exceed 15%") (assert rep.amnesiaFree "Report must indicate amnesia-free status") (assert (or (= rep.winner "agent-directed") (= rep.winner "receipts")) "Winner must be agent-directed or receipts") (assert (stringContains? rep.summary "CTX-BENCH-01") "Summary must reference task ID") true))

fn testAmnesiaInterceptionAcrossStrategies -> Bool
  (let [(bSys (ca/makeContextBlock "sys" "sys-mandate" 50 "System")) (bFact (ca/makeContextBlock "critical" "task-spec" 100 "Critical invariant [fact: crypto-seed-key-777]")) (taskAmnesia (cb/makeBenchTask "AMNESIA-PROBE-01" "Fact Retention Under Compaction" 5 (list bSys bFact) (list "crypto-seed-key-777") false)) (resRcpt (cb/simulateTaskUnderStrategy taskAmnesia "receipts" 4096)) (resAgent (cb/simulateTaskUnderStrategy taskAmnesia "agent-directed" 4096))] (do (assert (not resRcpt.amnesiaDetected) "Strategy 2 Receipts must preserve critical fact") (assert (not resAgent.amnesiaDetected) "Strategy 4 Agent-Directed must preserve critical fact") (assert resRcpt.passed "Receipts must pass amnesia probe") (assert resAgent.passed "Agent-directed must pass amnesia probe") true))

fn testReportFormattingAsn -> Bool
  (let [(tasks (cb/standardBenchmarkTasks)) (t1 (optionOr (listHead tasks) (cb/makeBenchTask "" "" 0 (list) (list) false))) (rep (cb/compareStrategiesOnTask t1 4096)) (asnStr (cb/formatVariationalReport rep))] (do (assert (stringStartsWith? asnStr "(:context-variational-report") "Report must start with :context-variational-report") (assert (stringContains? asnStr ":baseline-tokens") "Report must include :baseline-tokens") (assert (stringContains? asnStr ":receipts-savings-pct") "Report must include :receipts-savings-pct") (assert (stringContains? asnStr ":agent-directed-tokens") "Report must include :agent-directed-tokens") (assert (stringEndsWith? asnStr ")") "Report must end with closing paren") true))

fn runTests -> Bool
  (and (testBenchTaskCreation) (and (testStrategySimulationTokens) (and (testVariationalComparisonAndSavings) (and (testAmnesiaInterceptionAcrossStrategies) (testReportFormattingAsn)))))
