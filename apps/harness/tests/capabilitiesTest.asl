(module aslHarness/tests/capabilitiesTest :x [testCorpusSeparation testConditionalLoading testExclusionFiltering testSvgPlayground testSvgScenarios runTests] :i [(capabilities :a cap)])

fn hasMarker caps: (List cap/Capability) target: Str -> Bool
  (if (listEmpty? caps) false (let [(head (optionOr (listHead caps) (cap/makeCapability "" "" "conditional" (list) (list) (list) false false 0 ""))) (tail (optionOr (listTail caps) (list)))] (if (= head.marker target) true (hasMarker tail target))))

fn testCorpusSeparation -> Bool
  (let [(caps (cap/defaultCapabilities)) (first (optionOr (listHead caps) (cap/makeCapability "" "" "conditional" (list) (list) (list) false false 0 "")))] (do (assert (= (listLength caps) 10) "Grounded capability corpus must contain ten principles") (assert (= first.marker "visualHierarchy") "First capability marker must use CamelCase") (assert (= first.scope "universal") "visualHierarchy must be universal") (assert first.required "visualHierarchy must be required") (assert (= first.membership 100) "Universal membership must be 100") (assert (> (optionOr (listHead first.links) (cap/makeCapabilityLink "" 0)).strength 0) "Capability links must carry intensity") (assert (hasMarker caps "contrast") "Corpus must include contrast") (assert (hasMarker caps "composition") "Corpus must include composition") (assert (hasMarker caps "viewBox") "Corpus must include viewBox") (assert (hasMarker caps "evidenceLed") "Corpus must include evidenceLed") (assert (hasMarker caps "responsiveLayout") "Corpus must include responsiveLayout") (assert (hasMarker caps "accessibleText") "Corpus must include accessibleText") (assert (hasMarker caps "functionalColour") "Corpus must include functionalColour") (assert (hasMarker caps "spacingScale") "Corpus must include spacingScale") (assert (hasMarker caps "groupSemantics") "Corpus must include groupSemantics") true))

fn testConditionalLoading -> Bool
  (let [(caps (cap/defaultCapabilities)) (off (cap/selectCapabilities caps "svg poster" 10000 false)) (on (cap/selectCapabilities caps "svg poster" 10000 true)) (tight (cap/selectCapabilities caps "svg poster" 20 true)) (receipt on.receipt)] (do (assert (= (listLength off.selected) 0) "Disabled capability layer must be empty") (assert (> (listLength on.selected) 0) "Enabled capability layer must select matches") (assert (= on.optional true) "Capability loading must be explicitly optional") (assert (<= (listLength tight.selected) (listLength on.selected)) "Tight budget cannot select more capabilities") (assert receipt.enabled "Selection receipt must indicate enabled state") (assert (> receipt.spentTokens 0) "Selection receipt must report spent tokens") (assert (= receipt.budgetCeiling 10000) "Selection receipt must reflect budget ceiling") (assert (> (listLength receipt.selectedMarkers) 0) "Selection receipt must list selected markers") true))

fn testExclusionFiltering -> Bool
  (let [(caps (cap/defaultCapabilities)) (standard (cap/selectCapabilities caps "poster diagram" 10000 true)) (excluded (cap/selectCapabilities caps "denseDataTable poster diagram" 10000 true))] (do (assert (hasMarker standard.selected "visualHierarchy") "standard query must select visualHierarchy") (assert (not (hasMarker excluded.selected "visualHierarchy")) "denseDataTable query must exclude visualHierarchy") true))

fn testSvgPlayground -> Bool
  (let [(selection (cap/selectCapabilities (cap/defaultCapabilities) "svg" 10000 true)) (svg selection.svgPrompt)] (do (assert (stringStartsWith? svg "(:svg :v") "SVG playground must start with ASN svg and viewBox") (assert (> (listLength selection.selected) 0) "SVG query must select a capability") (assert (stringContains? svg ":title") "SVG playground must contain title element") (assert (stringContains? svg ":desc") "SVG playground must contain desc element") (assert (stringContains? svg "(:rect") "SVG playground must contain rect primitives") (assert (stringContains? svg "(:txt") "SVG playground must contain text primitives") true))

fn testSvgScenarios -> Bool
  (let [(poster (cap/svgPlaygroundScenario "poster")) (icon (cap/svgPlaygroundScenario "icon")) (diagram (cap/svgPlaygroundScenario "diagram"))] (do (assert (stringContains? poster "Poster Layout") "poster scenario must have poster title") (assert (stringContains? poster "0 0 400 300") "poster scenario must have 400x300 viewBox") (assert (stringContains? icon "System Node Icon") "icon scenario must have icon title") (assert (stringContains? icon "0 0 48 48") "icon scenario must have 48x48 viewBox") (assert (stringContains? diagram "Architecture Diagram") "diagram scenario must have diagram title") (assert (stringContains? diagram "(:g") "diagram scenario must use semantic g containers") true))

fn runTests -> Bool
  (and (testCorpusSeparation) (and (testConditionalLoading) (and (testExclusionFiltering) (and (testSvgPlayground) (testSvgScenarios)))))
