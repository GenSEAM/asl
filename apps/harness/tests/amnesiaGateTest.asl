(module aslHarness/amnesiaGateTest :x [testParseHarnessSuiteStructure testSuiteTestcaseMetadataNotation testRunHarnessSuiteEvaluator testEmulateContextOverflow testInterceptAmnesiaTrigger testVerifyFactsRetainedSuccessAndFailure runTests] :i [(suiteRunner :a sr) (amnesiaGate :a ag)])

fn testParseHarnessSuiteStructure -> Bool
  (let [(formStr "(harness-suite amnesia-pipeline-gate :target agent-core :tests ((test :id tc_overflow_compression :input-tokens 4500 :threshold 3000 :notation cs-expr :asserts ((assert-compact-memory-emitted) (assert-max-tokens-below 1500) (assert-facts-retained (:hash-algo \"argon2id\"))))))") (suite (sr/parseHarnessSuite (list formStr))) (emptySuite (sr/parseHarnessSuite (list "")))] (do (assert (not (stringEmpty? suite.name)) "Suite name must not be empty") (assert (= suite.name "amnesia-pipeline-gate") "Suite name must match declared symbol") (assert (= suite.target "agent-core") "Suite target must match declared target package") (assert (= (listLength suite.tests) 1) "Suite must contain exactly 1 parsed testcase") (assert (= (listLength emptySuite.tests) 0) "Empty suite form must yield 0 testcases") true))

fn testSuiteTestcaseMetadataNotation -> Bool
  (let [(formStr "(harness-suite amnesia-pipeline-gate :target agent-core :tests ((test :id tc_overflow_compression :input-tokens 4500 :threshold 3000 :notation cs-expr :asserts ((assert-compact-memory-emitted) (assert-max-tokens-below 1500) (assert-facts-retained (:hash-algo \"argon2id\"))))))") (suite (sr/parseHarnessSuite (list formStr))) (tests suite.tests) (t (optionOr (listHead tests) (sr/SuiteTest :id "" :inputTokens 0 :threshold 0 :notation "" :asserts (list)))) (altTest (sr/parseSuiteTest (list "(test :id tc_nd_asn :input-tokens 2000 :threshold 1000 :notation nd-asn :asserts ())")))] (do (assert (= t.id "tc_overflow_compression") "Test id must match declared identifier") (assert (= t.inputTokens 4500) "Input tokens must match parsed 4500") (assert (= t.threshold 3000) "Threshold must match parsed 3000") (assert (= t.notation "cs-expr") "Notation must match concise S-expression tag cs-expr") (assert (= altTest.notation "nd-asn") "Notation must match newline-delimited ASN tag nd-asn") true))

fn testRunHarnessSuiteEvaluator -> Bool
  (let [(formStr "(harness-suite amnesia-pipeline-gate :target agent-core :tests ((test :id tc_overflow_compression :input-tokens 4500 :threshold 3000 :notation cs-expr :asserts ((assert-compact-memory-emitted) (assert-max-tokens-below 1500) (assert-facts-retained (:hash-algo \"argon2id\"))))))") (suite (sr/parseHarnessSuite (list formStr))) (outcome (sr/runHarnessSuite suite)) (failingSuite (sr/HarnessSuite :name "failing-suite" :target "agent-core" :tests (list (sr/SuiteTest :id "tc_fail" :inputTokens 5000 :threshold 3000 :notation "cs-expr" :asserts (list "(assert-max-tokens-below 500)"))))) (failOutcome (sr/runHarnessSuite failingSuite))] (do (assert (= outcome.suiteName "amnesia-pipeline-gate") "Outcome suite name must match executed suite") (assert outcome.passed "All assertions in valid suite must pass") (assert (= outcome.totalAsserts 3) "Total assertion count must equal 3") (assert (= outcome.failedAsserts 0) "Failed assertion count must equal 0 on clean pass") (assert (and (not failOutcome.passed) (= failOutcome.failedAsserts 1)) "Failing assertion must mark suite unpassed with failed count 1") true))

fn testEmulateContextOverflow -> Bool
  (let [(facts (list "(:hash-algo \"argon2id\")" "(:key-len 32)")) (ctx (ag/emulateContextOverflow "buf_overflow_1" 4500 3000 facts)) (exactCtx (ag/emulateContextOverflow "buf_exact_boundary" 3000 3000 (list "(:boundary true)")))] (do (assert (>= ctx.tokens ctx.threshold) "Active tokens must exceed compression threshold") (assert (not (listEmpty? ctx.messages)) "Emulated message backlog must not be empty") (assert (= ctx.tokens 4500) "Token volume must match configured input tokens") (assert (listContains? ctx.facts "(:hash-algo \"argon2id\")") "Seeded facts must contain required hash algorithm") (assert (>= exactCtx.tokens exactCtx.threshold) "Exact boundary tokens == threshold must trigger overflow flag") true))

fn testInterceptAmnesiaTrigger -> Bool
  (let [(facts (list "(:hash-algo \"argon2id\")")) (overflowCtx (ag/emulateContextOverflow "buf_trigger_1" 4500 3000 facts)) (res (ag/interceptAmnesiaTrigger overflowCtx)) (nonOverflowCtx (ag/emulateContextOverflow "buf_safe_1" 1500 3000 facts)) (nonOvRes (ag/interceptAmnesiaTrigger nonOverflowCtx))] (do (assert res.triggered "Amnesia cascade must trigger when tokens exceed threshold") (assert (not (stringEmpty? res.chunkId)) "Emitted memory chunk identifier must be non-empty") (assert (< res.postTokens 1500) "Post-compression token volume must be strictly below 1500 ceiling") (assert res.rawEvicted "Raw operational messages must be evicted from active memory") (assert (not nonOvRes.triggered) "Sub-threshold token volume must bypass amnesia trigger") true))

fn testVerifyFactsRetainedSuccessAndFailure -> Bool
  (let [(res1 (ag/verifyFactsRetained (list "argon2id") (list "argon2id" "blake2b"))) (res2 (ag/verifyFactsRetained (list "argon2id" "salt-128") (list "argon2id" "salt-128" "iter-4"))) (res3 (ag/verifyFactsRetained (list "argon2id" "missing-fact") (list "argon2id"))) (res4 (ag/verifyFactsRetained (list "missing") (list "other"))) (res5 (ag/verifyFactsRetained (list) (list "any-fact"))) (res6 (ag/verifyFactsRetained (list "(:hash-algo \"argon2id\")") (list "(:hash-algo \"sha256\")")))] (do (assert (pairFirst res1) "Retained required fact must pass verification") (assert (pairFirst res2) "Multi-fact retention audit must pass when all facts preserved") (assert (not (pairFirst res3)) "Missing fact must cause audit failure") (assert (= (pairSecond res4) (ag/errAmnesiaDataLoss)) "Missing fact must yield ERR_AMNESIA_DATA_LOSS error code") (assert (pairFirst res5) "Empty required facts list must pass vacuously") (assert (and (not (pairFirst res6)) (= (pairSecond res6) (ag/errAmnesiaDataLoss))) "Mismatched fact value must trigger failure with ERR_AMNESIA_DATA_LOSS") true))

fn testRunAmnesiaAudit -> Bool
  (let [(report (ag/runAmnesiaAudit "tc1" 4500 3000 (list "argon2id")))] (assert report.passed "Report should pass") (assert (= report.errorCode "") "No error code") true)

fn runTests -> Bool
  (and (testParseHarnessSuiteStructure) (and (testSuiteTestcaseMetadataNotation) (and (testRunHarnessSuiteEvaluator) (and (testEmulateContextOverflow) (and (testInterceptAmnesiaTrigger) (and (testVerifyFactsRetainedSuccessAndFailure) (testRunAmnesiaAudit)))))))
