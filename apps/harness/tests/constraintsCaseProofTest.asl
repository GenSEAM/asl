(module aslHarness/tests/constraintsCaseProofTest
  :x [runTests violations]
  :i [(caseProofKit :a kit)])

fn row name: String file: String old: String new: String -> kit/Violation
  (kit/Violation :name name :files (if (= file "*") (list "src/freight/planner.py" "src/freight/__init__.py" "CHANGELOG.md") (list file)) :old old :new new)

fn violations -> (List kit/Violation)
  (list (row "nameIsSplitShipment" "*" "split_shipment" "split_parcels")
        (row "argumentOrder" "src/freight/planner.py" "def split_shipment(parcels, max_weight_grams, carrier_code):" "def split_shipment(parcels, carrier_code, max_weight_grams):")
        (row "noLegacyImport" "src/freight/planner.py" "import logging\n" "import logging\nfrom . import legacy\n")
        (row "overweightErrorCode" "src/freight/planner.py" "\"ERR_PARCEL_TOO_HEAVY\"" "\"ERR_OVERWEIGHT\"")
        (row "tariffsUntouched" "src/freight/tariffs.py" "APPEND" "\n# reviewed\n")
        (row "docstringPhrase" "src/freight/planner.py" " Parcels are never reordered." "")
        (row "logFormat" "src/freight/planner.py" "\"split batch=%d parcels=%d grams=%d\"" "\"split batch=%d: %d parcels, %d g\"")
        (row "atMostTwelveParcels" "src/freight/planner.py" "MAX_PARCELS_PER_BATCH = 12" "MAX_PARCELS_PER_BATCH = 20")
        (row "changelogLine" "CHANGELOG.md" "- planner: split_shipment" "- split_shipment")
        (row "exportedInAll" "src/freight/__init__.py" "    \"split_shipment\",\n" ""))

fn ! runTests -> Bool
  (let [(caseDir "tests/agentEval/cases/implement-constraints-long-run")
        (src (str caseDir "/src/freight"))
        (lines (kit/sourceLines src))
        (modules (kit/sourceModules src))
        (chars (kit/sourceChars src))
        (contextAsl (resultOr (fileReadString "asl/agentLoop/context.asl") ""))
        (small (kit/intAfter contextAsl "\nfn smallContextTokens -> Int64\n  "))
        (perToken (kit/intAfter contextAsl "\nfn charsPerToken -> Int64\n  "))
        (ctx (kit/intAfter (resultOr (fileReadString (str caseDir "/task.asn")) "") ":contextTokens "))
        (budget (* (optionOr ctx 0) (optionOr perToken 0)))
        (pyEnv (list "PYTHONDONTWRITEBYTECODE=1"))
        (argv (list "python3" "check_constraints.py"))
        (laid (kit/layCase! caseDir "Constraints"))
        (repo (mt laid ((ok l) l.repo) ((err e) (str "/nonexistent/" e))))
        (base (kit/runIn! argv repo pyEnv))
        (out (pairSecond base))
        (outLines (kit/outputLines out))
        (functional (list "functionDefined" "splitsInOrderByGrams" "carrierLimitCaps" "returnsBatches" "overweightRaises" "unknownCarrierRaises" "emptyGivesNoBatches"))
        (solution (optionOr (envGet "CONSTRAINTS_CASE_SOLUTION") ""))
        (solved (mt laid
                  ((err e) (list (pair (str "layCase " e) false)))
                  ((ok l) (if (stringEmpty? solution)
                            (list)
                            (kit/solutionProof! l caseDir solution (list "src/freight/planner.py" "src/freight/__init__.py" "CHANGELOG.md")
                                                "constraintsLongRun" argv pyEnv (violations))))))]
    (do
      (mt laid ((ok l) (kit/removeLaid! l)) ((err e) (do (println (str "layCase: " e)) false)))
      (assert (and (> lines 2000) (>= modules 5)) "srcOver2000LinesInSeveralModules")
      (assert (and (some? small) (= ctx small)) "taskRunsAtSmallTier")
      (assert (and (> budget 0) (> chars (* budget 3))) "srcOverThreeTranscripts")
      (assert (kit/scoresImplement? (resultOr (fileReadString (str caseDir "/truth.asn")) "") "python3 check_constraints.py") "truthScoresImplement")
      (assert (!= (pairFirst base) 0) "baseExitsNonZero")
      (assert (listAny? (fn [(l String)] -> Bool (and (kit/gateLine? "constraintsLongRun" l) (stringContains? l ":asserts 17 :failed "))) outLines) "baseRanToGateLine")
      (assert (not (listAny? (fn [(w String)] -> Bool (stringContains? out w)) (list "Traceback" "SyntaxError" "ImportError" "ModuleNotFoundError" "does not import"))) "baseNoCrash")
      (assert (listAll? (fn [(n String)] -> Bool (listAny? (fn [(l String)] -> Bool (stringStartsWith? l (str "FAIL " n ":"))) outLines)) functional) "baseFunctionalAllRed")
      (assert (and (listContains? outLines "ok noLegacyImport") (listContains? outLines "ok tariffsUntouched")) "baseKeepsUntouchedConstraints")
      (assert (listAll? (fn [(p (Pair String Bool))] -> Bool (pairSecond p)) solved) "solutionPassesAndEachViolationFailsOnlyItsConstraint")
      true))
