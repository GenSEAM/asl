(module aslHarness/tests/contextAssemblerTest :x [testContextBlockCreation testStrategy1Baseline testStrategy2ReceiptsCompaction testStrategy3JitWorkingMemory testStrategy4AgentCtxOpParsing testStrategy4SelfDirectedAssembly testAssemblePromptDispatcher testEscapedPayloadSerialization testWatermarkCompactionAssembly runTests] :i [(contextAssembler :a ca)])

fn testContextBlockCreation -> Bool
  (let [(b1 (ca/makeContextBlock "sys-1" "sys-mandate" 120 "You are Scout agent")) (b2 (ca/makeContextBlock "spec-1" "task-spec" 0 "Solve challenge TB4-SOLV-01")) (op (ca/makeAgentCtxOp (list "spec-1") (list "turn-0") (list "core/parser.asl")))] (do (assert (= b1.id "sys-1") "b1 ID must match constructor") (assert (= b1.kind "sys-mandate") "b1 kind must match sys-mandate") (assert (= b1.tokens 120) "b1 explicit tokens must equal 120") (assert (= b2.id "spec-1") "b2 ID must match constructor") (assert (> b2.tokens 0) "b2 estimated tokens must be non-zero") (assert (= (listLength op.retain) 1) "op retain list length must equal 1") (assert (= (listLength op.evict) 1) "op evict list length must equal 1") (assert (= (listLength op.prefetch) 1) "op prefetch list length must equal 1") true))

fn testStrategy1Baseline -> Bool
  (let [(b1 (ca/makeContextBlock "b1" "sys-mandate" 100 "System instructions")) (b2 (ca/makeContextBlock "b2" "task-spec" 150 "Task specification")) (b3 (ca/makeContextBlock "b3" "history" 200 "Turn 1 history payload")) (blocks (list b1 b2 b3)) (resUnlimited (ca/assembleBaselineContext blocks 1000)) (resConstrained (ca/assembleBaselineContext blocks 200))] (do (assert (= resUnlimited.strategy "baseline") "Strategy must be baseline") (assert (= resUnlimited.totalTokens 450) "Total tokens must equal 450") (assert (= resUnlimited.retainedCount 3) "All 3 blocks must be retained under 1000 ceiling") (assert (= resUnlimited.evictedCount 0) "Zero blocks evicted under 1000 ceiling") (assert (stringContains? resUnlimited.promptStr "(:block :id \"b1\"") "Prompt must format b1") (assert (stringContains? resUnlimited.promptStr "(:block :id \"b3\"") "Prompt must format b3") (assert (= resConstrained.retainedCount 1) "Only 1 block must fit in 200 ceiling") (assert (= resConstrained.evictedCount 2) "2 blocks must be evicted in 200 ceiling") true))

fn testStrategy2ReceiptsCompaction -> Bool
  (let [(bSys (ca/makeContextBlock "sys" "sys-mandate" 50 "System prompt")) (bT1 (ca/makeContextBlock "t1" "history" 300 "fs-read: src/core.asl dumped 500 lines of file content")) (bT2 (ca/makeContextBlock "t2" "history" 250 "exec-cmd: test gate passed with exit 0")) (bT3 (ca/makeContextBlock "t3" "history" 200 "ast-patch: patched function token-stream")) (blocks (list bSys bT1 bT2 bT3)) (res (ca/assembleReceiptsContext blocks 4096 1))] (do (assert (= res.strategy "receipts") "Strategy must be receipts") (assert (= res.retainedCount 4) "All 4 blocks should be retained") (assert (< res.totalTokens 800) "Total tokens must be compacted below uncompressed 800") (assert (stringContains? res.promptStr "[Turn: fs-read file cached]") "t1 should be compacted into receipt") (assert (stringContains? res.promptStr "[Turn: exec-cmd verified gate]") "t2 should be compacted into receipt") (assert (stringContains? res.promptStr "ast-patch: patched function token-stream") "t3 (most recent) must remain uncompacted") true))

fn testStrategy3JitWorkingMemory -> Bool
  (let [(bSys (ca/makeContextBlock "sys" "sys-mandate" 50 "System prompt")) (bSpec (ca/makeContextBlock "spec" "task-spec" 80 "Specification")) (bT1 (ca/makeContextBlock "t1" "history" 350 "Old history turn")) (bT2 (ca/makeContextBlock "t2" "turn" 300 "Another old turn")) (bAst (ca/makeContextBlock "ast-1" "working-set" 120 "(:sym \"tokenize\" :args [(stream Str)])")) (blocks (list bSys bSpec bT1 bT2 bAst)) (res (ca/assembleJitContext blocks 4096))] (do (assert (= res.strategy "jit-memory") "Strategy must be jit-memory") (assert (= res.retainedCount 3) "Retained count must be 3 (sys, spec, ast-1)") (assert (= res.evictedCount 2) "Evicted count must be 2 (t1, t2 history dropped)") (assert (not (stringContains? res.promptStr "Old history turn")) "Prompt must not contain old history") (assert (stringContains? res.promptStr "tokenize") "Prompt must contain working-set AST") true))

fn testStrategy4AgentCtxOpParsing -> Bool
  (let [(modelResp "(:response :action (:batch (:chk)) :ctx-op (:retain [\"b-spec\" \"ast-core\"] :evict [\"t1\" \"t2\"] :prefetch [\"core/lexer.asl\" \"core/parser.asl\"]) :summary \"checked\")") (parsedOpt (ca/parseAgentCtxOp modelResp)) (noOpResp "(:response :action (:batch (:chk)) :summary \"done\")") (noOpOpt (ca/parseAgentCtxOp noOpResp))] (mt parsedOpt ((some op) (do (assert (= (listLength op.retain) 2) "Retain count must be 2") (assert (= (listLength op.evict) 2) "Evict count must be 2") (assert (= (listLength op.prefetch) 2) "Prefetch count must be 2") (assert (none? noOpOpt) "Response without ctx-op must return none") true)) ((none) (do (assert false "Expected parsed AgentCtxOp") false))))

fn testStrategy4SelfDirectedAssembly -> Bool
  (let [(bSpec (ca/makeContextBlock "b-spec" "task-spec" 100 "Task specification")) (bStale (ca/makeContextBlock "t-stale" "history" 400 "Stale verbose tool output")) (bUseful (ca/makeContextBlock "t-useful" "history" 150 "Important finding")) (blocks (list bSpec bStale bUseful)) (op (ca/makeAgentCtxOp (list "b-spec") (list "t-stale") (list "core/parser.asl"))) (res (ca/assembleAgentDirectedContext blocks 4096 op))] (do (assert (= res.strategy "agent-directed") "Strategy must be agent-directed") (assert (not (stringContains? res.promptStr "t-stale")) "t-stale must be evicted from prompt") (assert (stringContains? res.promptStr "(:prefetch-sym \"core/parser.asl\")") "Prefetched block must be injected") (assert (stringContains? res.promptStr "b-spec") "Retained b-spec must be present") (assert (= res.retainedCount 3) "Retained count should be 3 (b-spec, t-useful, prefetch)") (assert (>= res.evictedCount 1) "Evicted count must be at least 1") true))

fn testAssemblePromptDispatcher -> Bool
  (let [(blocks (list (ca/makeContextBlock "b1" "sys-mandate" 50 "Sys") (ca/makeContextBlock "t1" "history" 200 "Turn 1"))) (cfgB (ca/makeDefaultConfig "baseline")) (cfgR (ca/makeDefaultConfig "receipts")) (cfgJ (ca/makeDefaultConfig "jit-memory")) (resB (ca/assemblePrompt blocks cfgB (none))) (resR (ca/assemblePrompt blocks cfgR (none))) (resJ (ca/assemblePrompt blocks cfgJ (none)))] (do (assert (= resB.strategy "baseline") "cfg-b must produce baseline") (assert (= resR.strategy "receipts") "cfg-r must produce receipts") (assert (= resJ.strategy "jit-memory") "cfg-j must produce jit-memory") true))

fn testEscapedPayloadSerialization -> Bool
  (let [(b (ca/makeContextBlock "raw1" "task-spec" 50 "echo \"hello world\" \\path")) (res (ca/assembleBaselineContext (list b) 1000))] (do (assert (stringContains? res.promptStr "\\\"hello world\\\"") "Quotes must be escaped with backslash") (assert (stringContains? res.promptStr "\\\\path") "Backslash must be escaped") true))

fn testWatermarkCompactionAssembly -> Bool
  (let [(bSys (ca/makeContextBlock "sys" "sys-mandate" 100 "System prompt")) (bT1 (ca/makeContextBlock "t1" "history" 250 "fs-read: src/core.asl dumped 500 lines of file content")) (bT2 (ca/makeContextBlock "t2" "history" 250 "exec-cmd: test gate passed with exit 0")) (bT3 (ca/makeContextBlock "t3" "history" 250 "ast-patch: patched function token-stream")) (blocks (list bSys bT1 bT2 bT3)) (resWatermark (ca/assembleWatermarkContext blocks 1000 5)) (jitBlocks (ca/hydrateJitBlocks (list "make-engine") 2))] (do (assert (= resWatermark.strategy "watermark") "Strategy must be watermark") (assert (> (listLength jitBlocks) 0) "JIT blocks must be hydrated via Engine Gateway") (assert (stringContains? (optionOr (listHead jitBlocks) (ca/makeContextBlock "" "" 0 "")).payload ":jit-result") "JIT payload must contain :jit-result envelope") true))

fn runTests -> Bool
  (and (testContextBlockCreation) (and (testStrategy1Baseline) (and (testStrategy2ReceiptsCompaction) (and (testStrategy3JitWorkingMemory) (and (testStrategy4AgentCtxOpParsing) (and (testStrategy4SelfDirectedAssembly) (and (testAssemblePromptDispatcher) (and (testEscapedPayloadSerialization) (testWatermarkCompactionAssembly)))))))))
