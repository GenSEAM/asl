(:auditPlaybook
  :version "0.1.0"
  :canonicalCli "asl audit [subcmd|target]"
  :residentRpc "asl rpc '(:batch (:chk) ...)'"

  :baselineWalk [
    (:step :seq 1 :cmd "asl audit" :doc "Authoritative sovereign diagnostic: answers 'What is wrong with the project?' across 5 health tiers")
    (:step :seq 2 :cmd "asl audit multimesh --manifest" :doc "Machine-readable 10-tier quality matrix for autonomous agents")
    (:step :seq 3 :cmd "asl gate" :doc "Execute full 7-tier verification gates")
  ]

  :workflows [
    (:flow :id :refactorImpact
      :intent "Audit caller graph and blast radius before modifying symbols or signatures"
      :pipeline [
        (:cmd "asl audit callers <symbol>" :purpose "Discover all callers referencing this symbol across packages")
        (:cmd "asl audit impact <symbol>" :purpose "Compute file-level blast radius and affected lines")
        (:cmd "asl rpc '(:batch (:callers \"<symbol>\") (:impact \"<symbol>\"))'" :purpose "Instant RAM alternative (<5ms)")
      ])

    (:flow :id :localizedTarget
      :intent "Graduated 3-tier inspection of specific file, package, or directory"
      :pipeline [
        (:cmd "asl audit <target>" :purpose "Run Micro-Tier (AST/keywords), Meso-Tier (manifest/exports), and Macro-Tier (boundaries)")
        (:cmd "asl check <file>" :purpose "Verify syntax balance and unclosed forms")
        (:cmd "asl lint <file>" :purpose "Verify anti-pattern idioms and keywords")
      ])

    (:flow :id :hygieneCleanup
      :intent "Identify unreferenced exports, placeholder mocks, and test debt"
      :pipeline [
        (:cmd "asl audit stubs" :purpose "Detect placeholder mocks, TODOs, and vacuous assertions")
        (:cmd "asl audit completeness" :purpose "Audit grounding of all RPC interfaces and grammar symbols")
        (:cmd "asl audit coverage" :purpose "Assert >=80% dual-case coverage and 100% Core Tier coverage")
      ])

    (:flow :id :reconciliation
      :intent "Full forensic signoff before closing task or phase"
      :pipeline [
        (:cmd "asl audit" :purpose "Run authoritative 5-tier sovereign health check")
        (:cmd "asl audit multimesh" :purpose "Run comprehensive 10-tier holistic audit matrix")
        (:cmd "asl gate" :purpose "Run 7 pure ASL verification gates")
      ])
  ]
)
