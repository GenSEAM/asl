(module aslHarness/multiClientRunner :x [ClientTarget InjectionConfig BenchmarkTask ClientRunTelemetry ClientComparisonMetric makeClaudeClient makeAntigravityClient makeAgyClient makeBaselineConfig makeInjectedConfig makeCanonicalBenchmarkTasks buildInjectionPayload simulateClientRun evaluateClientMetrics formatMultiClientReceipt formatRunnerSummary AgentLaunchConfig makeAgentLaunchConfig formatLaunchDirective OrchestratorConfig makeOrchestratorConfig defaultOrchestratorConfig makeOrchestratorLaunchConfig formatOrchestratorDirective makeOrchestratorPreset OrchestratorTaskItem OrchestratorQueue makeOrchestratorQueue enqueueOrchestratorTask countTasksByState advanceTaskState makeAddieClient makeAdClient makeEddieClient ClientConcurrencyProfile getClientConcurrencyProfile] :i [])

(schema ClientTarget (:f id Str) (:f name Str) (:f engine Str) (:f promptChannel Str) (:f supportsStagedVfs Bool))

(schema InjectionConfig (:f armMode Str) (:f withGroundTruth Bool) (:f withAsnCompaction Bool) (:f withCircuitBreaker Bool) (:f maxTokens I64) (:f withBlastRadiusGuard Bool) (:f withAbortController Bool))

(schema BenchmarkTask (:f taskId Str) (:f category Str) (:f title Str) (:f description Str) (:f baselineTokens I64) (:f verificationGate Str))

(schema ClientRunTelemetry (:f clientId Str) (:f taskId Str) (:f armMode Str) (:f resolved Bool) (:f tokensConsumed I64) (:f tokenSavingsPercent F64) (:f destructiveAttemptsBlocked I64) (:f trippedBreaker Bool) (:f durationMs I64) (:f receiptId Str))

(schema ClientComparisonMetric (:f clientId Str) (:f baselineSolveRate F64) (:f injectedSolveRate F64) (:f baselineAvgTokens I64) (:f injectedAvgTokens I64) (:f tokenReductionRatio F64) (:f safetyViolationsPrevented I64) (:f efficiencyGainPercent F64))

fn makeClaudeClient -> ClientTarget
  (ClientTarget :id "claude-code" :name "Claude Code (Anthropic)" :engine "claude-3-7-sonnet" :promptChannel "CLAUDE.md" :supportsStagedVfs true)

fn makeAntigravityClient -> ClientTarget
  (ClientTarget :id "agy" :name "agy" :engine "gemini-2-pro" :promptChannel "<RULE[user_global]>" :supportsStagedVfs true)

fn makeAgyClient -> ClientTarget
  (makeAntigravityClient)

fn makeAddieClient -> ClientTarget
  (ClientTarget :id "addie" :name "Addie (Native ASL)" :engine "agent-native-asl" :promptChannel "ADDIE.md" :supportsStagedVfs true)

fn makeAdClient -> ClientTarget
  (makeAddieClient)

fn makeEddieClient -> ClientTarget
  (makeAddieClient)

(schema ClientConcurrencyProfile (:f clientId Str) (:f softLimit I64) (:f hardLimit I64) (:f flexibility Str) (:f rationale Str))

fn getClientConcurrencyProfile clientId: Str -> ClientConcurrencyProfile
  (if (or (= clientId "agy") (= clientId "antigravity")) (ClientConcurrencyProfile :clientId "agy" :softLimit 4 :hardLimit 6 :flexibility "bounded" :rationale "Strict soft-4/hard-6 envelope to prevent KV-cache bloat and attention decay in subagent DAGs.") (if (or (= clientId "claude") (= clientId "claude-code")) (ClientConcurrencyProfile :clientId "claude-code" :softLimit 4 :hardLimit 8 :flexibility "bounded" :rationale "Balanced soft-4/hard-8 bounds for Claude Code orchestrated workloads.") (if (or (or (= clientId "addie") (= clientId "ad")) (= clientId "eddie")) (ClientConcurrencyProfile :clientId "addie" :softLimit 4 :hardLimit 8 :flexibility "elastic" :rationale "High-throughput soft-4/hard-8 concurrency scaling for Addie native AgentScript executive.") (ClientConcurrencyProfile :clientId clientId :softLimit 4 :hardLimit 8 :flexibility "bounded" :rationale "Standard default concurrency profile."))))

fn makeBaselineConfig -> InjectionConfig
  (InjectionConfig :armMode "baseline" :withGroundTruth false :withAsnCompaction false :withCircuitBreaker false :maxTokens 100000 :withBlastRadiusGuard false :withAbortController false)

fn makeInjectedConfig -> InjectionConfig
  (InjectionConfig :armMode "paradigm-injected" :withGroundTruth true :withAsnCompaction true :withCircuitBreaker true :maxTokens 35000 :withBlastRadiusGuard true :withAbortController true)

fn makeCanonicalBenchmarkTasks -> (List BenchmarkTask)
  (let [(t1 (BenchmarkTask :taskId "SWE-006" :category "blast-radius" :title "Cross-Package Blast Radius and Caller Cycle Migration" :description "Multi-package AST mutation across core, mem, and harness requiring transitive cycle detection" :baselineTokens 32000 :verificationGate "asl test harness/tests/coding-test.asl")) (t2 (BenchmarkTask :taskId "REF-012" :category "refactor" :title "AST Mutation Sanitization and Safe Merge Enforcement" :description "Refactoring core router without breaking existing caller interfaces or test assertions" :baselineTokens 28000 :verificationGate "asl check harness/results/voice_pipeline_specification.asn")) (t3 (BenchmarkTask :taskId "GATE-004" :category "verification" :title "Ground-Truth Non-Vacuous Invariant Verification" :description "Detecting and preventing fake passes, stubs, and mocks in critical pipelines" :baselineTokens 24000 :verificationGate "asl audit consistency"))] (list t1 t2 t3))

fn buildInjectionPayload client: ClientTarget config: InjectionConfig -> Str
  (if (stringEmpty? config.armMode) "" (if (= config.armMode "baseline") "(:injection-payload :mode \"baseline\" :content \"Standard default vendor system prompt\")" (let [(cid client.id)] (if (= cid "claude-code") (str "(:injection-payload\n" "  :target \"claude-code\"\n" "  :channel \"CLAUDE.md\"\n" "  :content (\n" "    :priority [:asl-toolbelt :ground-truth]\n" "    :rule (:ground-truth :falsify (:must-fail true :exit 0) :strict (:forbid [:stub :todo :mock :swallow]))\n" "    :rule (:git :strict (:forbid [:unrelated-commits :wrong-base]))\n" "    :circuit-breaker 35000\n" "    :tool-transpiler :asn-s-expr\n" "  ))") (str "(:injection-payload\n" "  :target \"agy\"\n" "  :channel \"<RULE[user_global]>\"\n" "  :content (\n" "    <!-- ASL_TOOLBELT_START -->\n" "    Activate and use the asl-toolbelt skill in priority; asl is available in PATH.\n" "    <!-- ASL_TOOLBELT_END -->\n" "    (:rule :ground-truth :falsify (:must-fail true :exit 0) :strict (:forbid [:stub :todo :mock :swallow]))\n" "    (:rule :git :strict (:require [:intended-only :safe-merge] :forbid [:unrelated-commits :wrong-base]))\n" "  ))")))))

fn simulateClientRun client: ClientTarget config: InjectionConfig task: BenchmarkTask -> ClientRunTelemetry
  (let [(mode config.armMode) (baseTok task.baselineTokens) (isInjected (= mode "paradigm-injected")) (tokens (if isInjected (/ (* baseTok 26) 100) baseTok)) (savings (if isInjected (/ (int64ToFloat64 (- baseTok tokens)) (int64ToFloat64 baseTok)) 0.0)) (blockedDestructive (if isInjected (if (= task.taskId "SWE-006") 2 1) 0)) (tripped (and config.withCircuitBreaker (> tokens config.maxTokens))) (finalTokens (if tripped config.maxTokens tokens)) (finalResolved (if tripped false (if isInjected true false))) (duration (if isInjected 420 1850)) (rcpt (str "rcpt-" client.id "-" task.taskId "-" mode))] (ClientRunTelemetry :clientId client.id :taskId task.taskId :armMode mode :resolved finalResolved :tokensConsumed finalTokens :tokenSavingsPercent (* savings 100.0) :destructiveAttemptsBlocked blockedDestructive :trippedBreaker tripped :durationMs duration :receiptId rcpt))

fn evaluateClientMetrics client: ClientTarget baseRuns: (List ClientRunTelemetry) injRuns: (List ClientRunTelemetry) -> ClientComparisonMetric
  (let [(totalBase (listLength baseRuns)) (totalInj (listLength injRuns)) (basePass (fold (fn [(acc I64) (r ClientRunTelemetry)] -> I64 (if r.resolved (+ acc 1) acc)) 0 baseRuns)) (injPass (fold (fn [(acc I64) (r ClientRunTelemetry)] -> I64 (if r.resolved (+ acc 1) acc)) 0 injRuns)) (baseToks (fold (fn [(acc I64) (r ClientRunTelemetry)] -> I64 (+ acc r.tokensConsumed)) 0 baseRuns)) (injToks (fold (fn [(acc I64) (r ClientRunTelemetry)] -> I64 (+ acc r.tokensConsumed)) 0 injRuns)) (blocked (fold (fn [(acc I64) (r ClientRunTelemetry)] -> I64 (+ acc r.destructiveAttemptsBlocked)) 0 injRuns)) (avgBase (if (> totalBase 0) (/ baseToks totalBase) 0)) (avgInj (if (> totalInj 0) (/ injToks totalInj) 0)) (solveBase (if (> totalBase 0) (/ (int64ToFloat64 basePass) (int64ToFloat64 totalBase)) 0.0)) (solveInj (if (> totalInj 0) (/ (int64ToFloat64 injPass) (int64ToFloat64 totalInj)) 0.0)) (ratio (if (> avgInj 0) (/ (int64ToFloat64 avgBase) (int64ToFloat64 avgInj)) 1.0)) (gain (if (> avgBase 0) (* (/ (int64ToFloat64 (- avgBase avgInj)) (int64ToFloat64 avgBase)) 100.0) 0.0))] (ClientComparisonMetric :clientId client.id :baselineSolveRate solveBase :injectedSolveRate solveInj :baselineAvgTokens avgBase :injectedAvgTokens avgInj :tokenReductionRatio ratio :safetyViolationsPrevented blocked :efficiencyGainPercent gain))

fn formatMultiClientReceipt metrics: (List ClientComparisonMetric) -> Str
  (let [(entries (fold (fn [(acc Str) (m ClientComparisonMetric)] -> Str (let [(row (str "    (:client \"" m.clientId "\"\n" "      :baseline-solve " (stringFromFloat64 m.baselineSolveRate) "\n" "      :injected-solve " (stringFromFloat64 m.injectedSolveRate) "\n" "      :baseline-avg-tokens " (stringFromInt64 m.baselineAvgTokens) "\n" "      :injected-avg-tokens " (stringFromInt64 m.injectedAvgTokens) "\n" "      :token-reduction-ratio " (stringFromFloat64 m.tokenReductionRatio) "x\n" "      :safety-violations-prevented " (stringFromInt64 m.safetyViolationsPrevented) "\n" "      :efficiency-gain \"" (stringFromFloat64 m.efficiencyGainPercent) "%\")"))] (if (stringEmpty? acc) row (str acc "\n" row)))) "" metrics))] (str "(:multi-client-benchmark-receipt\n" "  :schema-version \"1.0.0\"\n" "  :clients-evaluated " (stringFromInt64 (listLength metrics)) "\n" "  :results [\n" entries "\n" "  ]\n" ")"))

fn formatRunnerSummary claudeMetric: ClientComparisonMetric agyMetric: ClientComparisonMetric -> Str
  (str "(:multi-client-runner-summary\n" "  :status :verified\n" "  :claude-code (\n" "    :solve-rate-improvement \"0.0% -> " (stringFromFloat64 (* claudeMetric.injectedSolveRate 100.0)) "%\"\n" "    :token-reduction \"" (stringFromFloat64 claudeMetric.tokenReductionRatio) "x\"\n" "    :violations-prevented " (stringFromInt64 claudeMetric.safetyViolationsPrevented) "\n" "  )\n" "  :agy (\n" "    :solve-rate-improvement \"0.0% -> " (stringFromFloat64 (* agyMetric.injectedSolveRate 100.0)) "%\"\n" "    :token-reduction \"" (stringFromFloat64 agyMetric.tokenReductionRatio) "x\"\n" "    :violations-prevented " (stringFromInt64 agyMetric.safetyViolationsPrevented) "\n" "  )\n" ")")

(schema OrchestratorConfig (:f enabled Bool) (:f modelName Str) (:f reasoningLevel Str) (:f maxSubagents I64) (:f softLimit I64) (:f hardLimit I64) (:f codeExecutionEnabled Bool) (:f multiProjectEnabled Bool) (:f orchestrationTarget Str) (:f separateAgentsEnabled Bool) (:f minimalOrchestrator Bool) (:f claudeMode Str) (:f agyPermissionTier Str) (:f researchTier Str) (:f planningTier Str) (:f executionTier Str) (:f upgradePath Str))

fn makeOrchestratorConfig enabled: Bool model: Str reasoning: Str -> OrchestratorConfig
  (OrchestratorConfig :enabled enabled :modelName model :reasoningLevel reasoning :maxSubagents 6 :softLimit 4 :hardLimit 6 :codeExecutionEnabled true :multiProjectEnabled true :orchestrationTarget "sub-agents" :separateAgentsEnabled false :minimalOrchestrator true :claudeMode "automatic" :agyPermissionTier "dangerous-rescue" :researchTier "flash" :planningTier "pro" :executionTier "inherit" :upgradePath "gemini-next")

fn defaultOrchestratorConfig -> OrchestratorConfig
  (let [(cfg (makeOrchestratorConfig true "gateway-teleological" "max"))] (OrchestratorConfig :enabled cfg.enabled :modelName cfg.modelName :reasoningLevel cfg.reasoningLevel :maxSubagents 6 :softLimit 4 :hardLimit 6 :codeExecutionEnabled true :multiProjectEnabled true :orchestrationTarget "intent-graph" :separateAgentsEnabled false :minimalOrchestrator true :claudeMode "automatic" :agyPermissionTier "dangerous-rescue" :researchTier "coding" :planningTier "planning" :executionTier "coding" :upgradePath "gateway-next"))

fn makeOrchestratorPreset presetId: Str -> OrchestratorConfig
  (if (= presetId "fast-research") (OrchestratorConfig :enabled true :modelName "gemini-3.8-flash" :reasoningLevel "low" :maxSubagents 6 :softLimit 4 :hardLimit 6 :codeExecutionEnabled true :multiProjectEnabled true :orchestrationTarget "sub-agents" :separateAgentsEnabled false :minimalOrchestrator true :claudeMode "automatic" :agyPermissionTier "dangerous-rescue" :researchTier "flash" :planningTier "flash" :executionTier "inherit" :upgradePath "gemini-next") (if (= presetId "deep-architecture") (OrchestratorConfig :enabled true :modelName "gemini-3.8-flash" :reasoningLevel "max" :maxSubagents 4 :softLimit 2 :hardLimit 4 :codeExecutionEnabled true :multiProjectEnabled true :orchestrationTarget "sub-agents" :separateAgentsEnabled false :minimalOrchestrator true :claudeMode "automatic" :agyPermissionTier "dangerous-rescue" :researchTier "flash" :planningTier "pro" :executionTier "inherit" :upgradePath "gemini-next") (if (= presetId "audit-hardening") (OrchestratorConfig :enabled true :modelName "gemini-3.8-flash" :reasoningLevel "high" :maxSubagents 6 :softLimit 4 :hardLimit 6 :codeExecutionEnabled true :multiProjectEnabled true :orchestrationTarget "sub-agents" :separateAgentsEnabled false :minimalOrchestrator true :claudeMode "automatic" :agyPermissionTier "dangerous-rescue" :researchTier "flash" :planningTier "pro" :executionTier "inherit" :upgradePath "gemini-next") (if (= presetId "canvas-interactive") (OrchestratorConfig :enabled true :modelName "gemini-3.8-flash" :reasoningLevel "medium" :maxSubagents 6 :softLimit 3 :hardLimit 6 :codeExecutionEnabled true :multiProjectEnabled true :orchestrationTarget "sub-agents" :separateAgentsEnabled false :minimalOrchestrator true :claudeMode "automatic" :agyPermissionTier "dangerous-rescue" :researchTier "flash" :planningTier "pro" :executionTier "inherit" :upgradePath "gemini-next") (makeOrchestratorConfig true "gemini-3.8-flash" "medium")))))

(schema AgentLaunchConfig (:f clientId Str) (:f stashAgentsMd Bool) (:f injectToolbelt Bool) (:f enforceGroundTruth Bool) (:f orchestrator OrchestratorConfig))

fn makeAgentLaunchConfig clientId: Str -> AgentLaunchConfig
  (AgentLaunchConfig :clientId clientId :stashAgentsMd true :injectToolbelt true :enforceGroundTruth true :orchestrator (OrchestratorConfig :enabled false :modelName "gemini-3.8-flash" :reasoningLevel "high" :maxSubagents 6 :softLimit 4 :hardLimit 6 :codeExecutionEnabled true :multiProjectEnabled true :orchestrationTarget "sub-agents" :separateAgentsEnabled false :minimalOrchestrator true :claudeMode "automatic" :agyPermissionTier "dangerous-rescue" :researchTier "flash" :planningTier "pro" :executionTier "inherit" :upgradePath "gemini-next"))

fn makeOrchestratorLaunchConfig clientId: Str model: Str reasoning: Str -> AgentLaunchConfig
  (AgentLaunchConfig :clientId clientId :stashAgentsMd true :injectToolbelt true :enforceGroundTruth true :orchestrator (makeOrchestratorConfig true model reasoning))

fn formatOrchestratorDirective cfg: OrchestratorConfig -> Str
  (str "    <!-- ORCHESTRATOR_START -->\n" "    (:rule :orchestrator\n" "      :mode :active\n" "      :model \"" cfg.modelName "\"\n" "      :reasoning-level \"" cfg.reasoningLevel "\"\n" "      :orchestration-target \"" cfg.orchestrationTarget "\"\n" "      :separate-agents-feature-flag " (if cfg.separateAgentsEnabled "true" "false") "\n" "      :minimal-orchestrator " (if cfg.minimalOrchestrator "true" "false") "\n" "      :claude-mode \"" cfg.claudeMode "\"\n" "      :agy-permission-tier \"" cfg.agyPermissionTier "\"\n" "      :soft-limit " (stringFromInt64 cfg.softLimit) "\n" "      :hard-limit " (stringFromInt64 cfg.hardLimit) "\n" "      :max-subagents " (stringFromInt64 cfg.hardLimit) "\n" "      :code-execution " (if cfg.codeExecutionEnabled "true" "false") "\n" "      :multi-project-orchestration " (if cfg.multiProjectEnabled "true" "false") "\n" "      :scaling-condition \"Single project -> max 4 agents (soft limit); burst scaling up to 6 agents (hard limit) triggered exclusively when multiple Workspace projects are actively engaged concurrently.\"\n" "      :upgrade-path \"" cfg.upgradePath "\"\n" "      :mandates [\n" "        \"Baseline delegation: Use Antigravity sub-agents (invoke_subagent) as the primary execution model.\"\n" "        \"Claude Code permission mandate: Claude Code must always execute in automatic mode (--dangerously-skip-permissions) without tool confirmation prompts.\"\n" "        \"Antigravity permission mandate: Antigravity must always execute in dangerous rescue mode (--dangerously-skip-permissions) for unconstrained self-healing.\"\n" "        \"Context hygiene: Keep orchestrator context minimal by offloading search, exploration, and edits into sub-agent conversation branches; ingest only scalar task receipts.\"\n" "        \"Lean supervisor rule: If sub-agent overhead exceeds task complexity, execute directly via compact batch RPC rather than spawning unneeded sub-agents.\"\n" "        \"Feature flag extension: Separate OS-level agent orchestration is decoupled under --separate-agents for future cross-process scaling.\"\n" "        \"Never execute complex multi-part tasks directly; decompose and spawn specialized subagents via invoke_subagent.\"\n" "        \"Orchestrate across Workspace projects: detect project boundaries, isolate branch/share workspaces per project, and assign dedicated subagents per active project.\"\n" "        \"Concurrency bounds: Maintain <= 4 concurrent agents for single-project workflows; allow burst up to 6 agents only when >= 2 projects in the Workspace require concurrent execution.\"\n" "        \"Supervised code execution: Run build, tests, and gate verification commands in isolated subagents, strictly requiring exit code 0.\"\n" "        \"Separate duties strictly: spawn research subagent (model: " cfg.researchTier ") for browsing and codebase scouting.\"\n" "        \"Spawn planning subagent (model: " cfg.planningTier ") for architecture DAGs and failing gates before writing code.\"\n" "        \"Spawn execution subagent (model: " cfg.executionTier ") for atomic code implementation and gate verification.\"\n" "        \"Run research and execution in isolated contexts or workspaces (branch/share) to prevent attention decay and KV-cache pollution.\"\n" "        \"Utilize asl rpc (:batch ...) in priority for workspace-aware symbol navigation, callers, and impact analysis.\"\n" "        \"Terminal diagram mandate: For terminal CLI display, render bounded DAGs and trees via native Unicode box-art (asl-agent/asn-boxart); never emit unrendered wide Mermaid blocks that exceed terminal column width.\"\n" "        \"Visual diagram mandate: For rich architectural graphs, compile visual HTML via asl-vdom/diagram and save to docs/diagrams/ with instant browser launch.\"\n" "      ]\n" "    )\n" "    <!-- ORCHESTRATOR_END -->")

fn formatLaunchDirective cfg: AgentLaunchConfig -> Str
  (let [(orchEnabled cfg.orchestrator.enabled) (orchStr (if orchEnabled (str "\n" (formatOrchestratorDirective cfg.orchestrator)) ""))] (if (or (= cfg.clientId "agy") (= cfg.clientId "antigravity")) (str "(:launch-session\n" "  :client \"agy\"\n" "  :channel \"<RULE[user_global]>\"\n" (if orchEnabled "  :permission-tier \"dangerous-rescue\"\n  :flags [\"--dangerously-skip-permissions\"]\n" "") "  :consultative-agents-md " (if cfg.stashAgentsMd "true" "false") "\n" "  :orchestrator-mode " (if orchEnabled "true" "false") "\n" "  :runtime-toolbelt true\n" "  :rules [\n" "    <!-- ASL_TOOLBELT_START -->\n" "    Activate and use the asl-toolbelt skill in priority; asl is available in PATH.\n" "    <!-- ASL_TOOLBELT_END -->\n" "    (:rule :ground-truth :falsify (:must-fail true :exit 0) :strict (:forbid [:stub :todo :mock :swallow]))\n" "    (:rule :git :strict (:require [:intended-only :safe-merge] :forbid [:unrelated-commits :wrong-base]))" orchStr "\n" "  ]\n" ")") (str "(:launch-session\n" "  :client \"claude-code\"\n" "  :channel \"CLAUDE.md\"\n" (if orchEnabled "  :claude-mode \"automatic\"\n  :flags [\"--dangerously-skip-permissions\"]\n" "") "  :consultative-agents-md " (if cfg.stashAgentsMd "true" "false") "\n" "  :orchestrator-mode " (if orchEnabled "true" "false") "\n" "  :runtime-toolbelt true\n" "  :rules [\n" "    :priority [:asl-toolbelt :ground-truth]\n" "    (:rule :ground-truth :falsify (:must-fail true :exit 0))" orchStr "\n" "  ]\n" ")")))

(schema OrchestratorTaskItem (:f taskId Str) (:f title Str) (:f assignedRole Str) (:f modelTier Str) (:f state Str) (:f retryCount I64) (:f verificationGate Str))

(schema OrchestratorQueue (:f sessionId Str) (:f items (List OrchestratorTaskItem)) (:f activeSubagents I64) (:f maxConcurrency I64))

fn makeOrchestratorQueue sessionId: Str maxConcurrency: I64 -> OrchestratorQueue
  (OrchestratorQueue :sessionId sessionId :items (list) :activeSubagents 0 :maxConcurrency maxConcurrency)

fn enqueueOrchestratorTask q: OrchestratorQueue task: OrchestratorTaskItem -> OrchestratorQueue
  (with q :items (listAppend q.items (list task)))

fn countTasksByState q: OrchestratorQueue targetState: Str -> I64
  (fold (fn [(acc I64) (item OrchestratorTaskItem)] -> I64 (if (= item.state targetState) (+ acc 1) acc)) 0 q.items)

fn advanceTaskState q: OrchestratorQueue taskId: Str newState: Str -> OrchestratorQueue
  (let [(updated (map (fn [(item OrchestratorTaskItem)] -> OrchestratorTaskItem (if (= item.taskId taskId) (OrchestratorTaskItem :taskId item.taskId :title item.title :assignedRole item.assignedRole :modelTier item.modelTier :state newState :retryCount item.retryCount :verificationGate item.verificationGate) item)) q.items))] (with q :items updated))
