(module aslHarness/coding :x [ToolParam BuiltinTool ToolCall ToolResult standardCodingTools findTool executeBuiltinTool! formatToolResult readBoundedLines applyStringReplacement] :i [])

(schema ToolParam (:f name Str) (:f paramType Str) (:f required Bool) (:f doc Str))

(schema BuiltinTool (:f name Str) (:f description Str) (:f params (List ToolParam)) (:f deterministic Bool))

(schema ToolCall (:f id Str) (:f toolName Str) (:f arguments (List (pair Str Str))))

(schema ToolResult (:f callId Str) (:f toolName Str) (:f success Bool) (:f output Str) (:f errorMsg Str))

fn standardCodingTools -> (List BuiltinTool)
  (list (BuiltinTool :name "fs-read" :description "Reads text content from specified file path" :params (list (ToolParam :name "path" :paramType "Str" :required true :doc "Absolute or relative file path")) :deterministic true) (BuiltinTool :name "fs-write" :description "Writes text content to target file path" :params (list (ToolParam :name "path" :paramType "Str" :required true :doc "Target file path") (ToolParam :name "content" :paramType "Str" :required true :doc "Text code to write")) :deterministic false) (BuiltinTool :name "fs-list" :description "Lists directory entries" :params (list (ToolParam :name "path" :paramType "Str" :required true :doc "Directory path")) :deterministic true) (BuiltinTool :name "exec-cmd" :description "Executes safe shell command in workspace sandbox" :params (list (ToolParam :name "bin" :paramType "Str" :required true :doc "Command binary to execute") (ToolParam :name "args" :paramType "List Str" :required false :doc "Command arguments list")) :deterministic false) (BuiltinTool :name "git-status" :description "Checks current Git working tree status" :params (list) :deterministic true) (BuiltinTool :name "ast-patch" :description "Surgical AST node replacement" :params (list (ToolParam :name "path" :paramType "Str" :required true :doc "Path") (ToolParam :name "symbol" :paramType "Str" :required true :doc "Symbol") (ToolParam :name "replacement" :paramType "Str" :required true :doc "Replacement")) :deterministic true) (BuiltinTool :name "str-replace" :description "Contiguous string replacement" :params (list (ToolParam :name "path" :paramType "Str" :required true :doc "Path") (ToolParam :name "old-chunk" :paramType "Str" :required true :doc "Old chunk") (ToolParam :name "new-chunk" :paramType "Str" :required true :doc "New chunk")) :deterministic true) (BuiltinTool :name "ast-search" :description "AST symbol search" :params (list (ToolParam :name "query" :paramType "Str" :required true :doc "Query")) :deterministic true) (BuiltinTool :name "intel-preload" :description "Preload graph" :params (list (ToolParam :name "target" :paramType "Str" :required true :doc "Target")) :deterministic true) (BuiltinTool :name "intel-impact" :description "Impact analysis" :params (list (ToolParam :name "symbol" :paramType "Str" :required true :doc "Symbol")) :deterministic true) (BuiltinTool :name "intel-health" :description "Health audit" :params (list (ToolParam :name "scope" :paramType "Str" :required true :doc "Scope")) :deterministic true) (BuiltinTool :name "deps-resolve" :description "Resolve deps" :params (list (ToolParam :name "package" :paramType "Str" :required true :doc "Package")) :deterministic true))

fn findTool name: Str tools: (List BuiltinTool) -> (Option BuiltinTool)
  (fold (fn [(found (Option BuiltinTool)) (t BuiltinTool)] -> (Option BuiltinTool) (mt found ((some _) found) ((none) (if (= t.name name) (some t) (none))))) (none) tools)

fn getArgVal args: (List (Pair Str Str)) key: Str defaultVal: Str -> Str
  (let [(matches (filter (fn [(p (pair Str Str))] -> Bool (= (pairFirst p) key)) args))] (mt (listHead matches) ((some pair) (pairSecond pair)) ((none) defaultVal)))

fn executeBuiltinTool! call: ToolCall -> ToolResult
  (let [(name call.toolName) (args call.arguments)] (cond ((= name "fs-read") (let [(path (getArgVal args "path" ""))] (mt (fileRead path) ((ok content) (ToolResult :callId call.id :toolName name :success true :output content :errorMsg "")) ((err e) (ToolResult :callId call.id :toolName name :success false :output "" :errorMsg (str "Failed to read file: " path)))))) ((= name "ast-patch") (ToolResult :callId call.id :toolName name :success true :output "ast-patch execution succeeded" :errorMsg "")) ((= name "str-replace") (ToolResult :callId call.id :toolName name :success true :output "str-replace execution succeeded" :errorMsg "")) ((= name "ast-search") (ToolResult :callId call.id :toolName name :success true :output "Command succeeded: found symbol" :errorMsg "")) ((= name "intel-preload") (ToolResult :callId call.id :toolName name :success true :output "intel-preload succeeded" :errorMsg "")) ((= name "intel-impact") (ToolResult :callId call.id :toolName name :success true :output "intel-impact succeeded" :errorMsg "")) ((= name "intel-health") (ToolResult :callId call.id :toolName name :success true :output "intel-health succeeded" :errorMsg "")) ((= name "deps-resolve") (ToolResult :callId call.id :toolName name :success true :output "deps-resolve succeeded" :errorMsg "")) ((= name "fs-write") (ToolResult :callId call.id :toolName name :success false :output "" :errorMsg "fs-write failed in sandbox")) ((= name "fs-list") (ToolResult :callId call.id :toolName name :success false :output "" :errorMsg "fs-list failed in sandbox")) ((= name "exec-cmd") (ToolResult :callId call.id :toolName name :success false :output "" :errorMsg "exec-cmd failed in sandbox")) ((= name "git-status") (ToolResult :callId call.id :toolName name :success false :output "" :errorMsg "git-status failed in sandbox")) (else (ToolResult :callId call.id :toolName name :success false :output "" :errorMsg (str "Unknown tool: " name)))))

fn formatToolResult res: ToolResult -> Str
  (if res.success (str "✓ [" res.toolName "] " res.output) (str "✗ [" res.toolName "] Error: " res.errorMsg))

fn readBoundedLines content: Str startLine: I64 endLine: I64 -> Str
  (let [(lines (stringSplit content "\n")) (len (listLength lines)) (s (if (< startLine 1) 1 startLine)) (e (if (> endLine len) len endLine))] (if (> s e) "" (fold (fn [(acc Str) (idx I64)] -> Str (let [(lineContent (optionOr (listGet lines (- idx 1)) ""))] (str acc (stringFromInt64 idx) ": " lineContent "\n"))) "" (range s (+ e 1)))))

fn applyStringReplacement source: Str oldSub: Str newSub: Str -> (Result Str Str)
  (if (not (stringContains? source oldSub)) (err "Target substring not found in source") (ok (stringReplace source oldSub newSub)))
