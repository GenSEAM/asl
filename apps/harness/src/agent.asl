(module aslHarness/agent :x [AgentState AgentStepOutcome ReflectionVerdict newCodingAgent processModelTurn runAgentTask agentSummary microReflectStep macroReflectAudit] :i [(coding :a c) (firewall :a fw) (fsmNormalizer :a fsm) (repl :a repl) (config :a cfg) (localExec :a lx) (compactor :a comp) (verifier :a v)])

(schema AgentState (:f sessionId Str) (:f taskId Str) (:f iteration I64) (:f maxIterations I64) (:f phase Str) (:f lastError Str) (:f config cfg/HarnessConfig) (:f policy fw/FirewallPolicy) (:f replSess repl/ReplSession) (:f history (List Str)) (:f actionsExecuted (List Str)) (:f actionsBlocked (List Str)) (:f resolved Bool) (:f testCommand Str) (:f reflectionTurns I64))

(schema AgentStepOutcome (:f nextState AgentState) (:f normalizedText Str) (:f executed (List Str)) (:f blocked (List Str)) (:f finished Bool))

(schema ReflectionVerdict (:f passed Bool) (:f needsFix Bool) (:f reason Str) (:f turnCount I64) (:f haltLoop Bool))

fn microReflectStep action: Str resultOutput: Str errorMsg: Str -> Str
  (cond ((not (stringEmpty? errorMsg)) (str "[WARN] Micro-reflection: action '" action "' failed with error: " errorMsg)) ((and (or (= action "fs-write") (= action "ast-patch")) (stringContains? resultOutput "unbalanced")) (str "[WARN] Micro-reflection: action '" action "' produced unbalanced delimiters.")) ((stringEmpty? resultOutput) (str "[WARN] Micro-reflection: action '" action "' returned empty output; verify state.")) (else "[OK] Micro-reflection: action executed cleanly."))

fn macroReflectAudit taskDesc: Str diff: Str testsPassed: Bool reflectionTurn: I64 -> ReflectionVerdict
  (cond ((not testsPassed) (ReflectionVerdict :passed false :needsFix true :reason "Verification gate failed: tests must pass before reflection audit" :turnCount reflectionTurn :haltLoop false)) ((>= reflectionTurn 1) (ReflectionVerdict :passed true :needsFix false :reason "1-turn reflection limit reached: proceeding with transparent gap disclosure" :turnCount reflectionTurn :haltLoop true)) ((or (stringContains? diff "TODO") (or (stringContains? diff "FIXME") (stringContains? diff "unimplemented"))) (ReflectionVerdict :passed false :needsFix true :reason "Unimplemented stub or TODO comment detected in source diff" :turnCount (+ reflectionTurn 1) :haltLoop false)) (else (ReflectionVerdict :passed true :needsFix false :reason "Audit passed: intent reconciled, edge cases covered, zero bloat" :turnCount reflectionTurn :haltLoop true)))

fn newCodingAgent sessionId: Str taskId: Str config: cfg/HarnessConfig -> AgentState
  (let [(policy (fw/defaultFirewallPolicy)) (replSession (repl/newReplSession sessionId))] (AgentState :sessionId sessionId :taskId taskId :iteration 0 :maxIterations 10 :phase "inspect" :lastError "" :config config :policy policy :replSess replSession :history (list) :actionsExecuted (list) :actionsBlocked (list) :resolved false :testCommand "asl test" :reflectionTurns 0))

fn deriveNextPhase text: Str currPhase: Str isDone: Bool -> Str
  (cond (isDone "resolved") ((stringContains? text ":plan") "plan") ((or (stringContains? text "ast-patch") (or (stringContains? text "str-replace") (stringContains? text "fs-write"))) "patch") ((or (stringContains? text "exec-cmd") (or (stringContains? text "asl test") (stringContains? text "pytest"))) "verify") ((or (stringContains? text "fs-read") (stringContains? text "ast-search")) "inspect") (else currPhase))

fn processModelTurn state: AgentState rawOutput: Str -> AgentStepOutcome
  (let [(useFsm (cfg/featureEnabled? state.config "fsm-normalizer")) (useFw (cfg/featureEnabled? state.config "firewall")) (unfenced (comp/extractSexpr rawOutput)) (normalized (if useFsm (fsm/repairSyntaxFsm unfenced) unfenced)) (wantsDone (or (stringContains? normalized ":task-complete") (stringContains? normalized "TASK_RESOLVED"))) (gateVerdict (if wantsDone (v/executeVerificationGate state.testCommand true) (v/VerificationVerdict :allowed false :reason "" :language ""))) (gatePassed (and wantsDone gateVerdict.allowed)) (audit (if gatePassed (macroReflectAudit state.taskId normalized true state.reflectionTurns) (ReflectionVerdict :passed false :needsFix false :reason "" :turnCount 0 :haltLoop true))) (isDone (and gatePassed (not audit.needsFix))) (gateErr (cond ((and wantsDone (not gatePassed)) (v/formatGateRejection state.testCommand gateVerdict.reason)) ((and gatePassed audit.needsFix) (str ":reflect-gap " audit.reason)) (else ""))) (isBlocked (and useFw (or (stringContains? normalized "../") (or (stringContains? normalized "rm -rf") (stringContains? normalized "/etc"))))) (newIter (+ state.iteration 1)) (newReflTurns (if (and gatePassed audit.needsFix) (+ state.reflectionTurns 1) state.reflectionTurns)) (nextPhase (cond (isDone "resolved") ((and gatePassed audit.needsFix) "reflect") ((and wantsDone (not gatePassed)) "patch") (else (deriveNextPhase normalized state.phase false)))) (hasPatch (or (stringContains? normalized "ast-patch") (stringContains? normalized "str-replace"))) (exList (cond (isBlocked (list)) (isDone (list)) (hasPatch (list "surgical-patch" "repl-eval")) (else (list "fs-write" "repl-eval")))) (blkList (cond (isBlocked (list "path-traversal-blocked")) ((and wantsDone (not gatePassed)) (list "verification-gate-failed")) ((and gatePassed audit.needsFix) (list "reflection-gap-detected")) (else (list)))) (newExecuted (if (and (not isBlocked) (not isDone)) (listAppend state.actionsExecuted exList) state.actionsExecuted)) (newBlocked (if (or isBlocked (or (and wantsDone (not gatePassed)) (and gatePassed audit.needsFix))) (listAppend state.actionsBlocked blkList) state.actionsBlocked)) (finished (or isDone (>= newIter state.maxIterations))) (compactedHist (comp/compactHistory (cons normalized state.history) 2)) (nextSt (with state :iteration newIter :phase nextPhase :lastError gateErr :history compactedHist :actionsExecuted newExecuted :actionsBlocked newBlocked :resolved isDone :reflectionTurns newReflTurns))] (AgentStepOutcome :nextState nextSt :normalizedText normalized :executed exList :blocked blkList :finished finished))

fn runAgentTask state: AgentState turns: (List Str) -> AgentState
  (fold (fn [(currSt AgentState) (turn Str)] -> AgentState (if currSt.resolved currSt (let [(outcome (processModelTurn currSt turn))] outcome.nextState))) state turns)

fn agentSummary state: AgentState -> Str
  (str "Agent Session [" state.sessionId "] Task: " state.taskId " | Phase: " state.phase " | Turns: " (stringFromInt64 state.iteration) " | Reflection: " (stringFromInt64 state.reflectionTurns) " | Executed: " (stringFromInt64 (listLength state.actionsExecuted)) " | Blocked: " (stringFromInt64 (listLength state.actionsBlocked)) " | History Size: " (stringFromInt64 (listLength state.history)) " | Resolved: " (if state.resolved "YES" "NO"))
