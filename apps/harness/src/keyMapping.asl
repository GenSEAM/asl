(module aslHarness/keyMapping :x [KeyMappingEntry makeKeyMappingEntry getCanonicalKeyMappings normalizeToCanonicalKey translateToLegacyKey normalizeAsnRecordKeys translateAsnRecordToLegacy auditEmittedAsnKeys RunTests] :i [])

(schema KeyMappingEntry (:f legacy Str) (:f canonical Str) (:f scope Str))

fn makeKeyMappingEntry legacy: Str canonical: Str scope: Str -> KeyMappingEntry
  (KeyMappingEntry :legacy legacy :canonical canonical :scope scope)

fn getCanonicalKeyMappings -> (List KeyMappingEntry)
  (list (makeKeyMappingEntry "exit-code" "exitCode" "execution") (makeKeyMappingEntry "latency-ms" "latencyMs" "performance") (makeKeyMappingEntry "stdout-len" "stdoutLen" "output") (makeKeyMappingEntry "tokens-out" "tokensOut" "telemetry") (makeKeyMappingEntry "tokens-in" "tokensIn" "telemetry") (makeKeyMappingEntry "tok-sec" "tokSec" "telemetry") (makeKeyMappingEntry "duration-ms" "durationMs" "performance") (makeKeyMappingEntry "error-code" "errorCode" "error") (makeKeyMappingEntry "session-id" "sessionId" "identity") (makeKeyMappingEntry "trace-id" "traceId" "tracing") (makeKeyMappingEntry "run-id" "runId" "calibration") (makeKeyMappingEntry "model-id" "modelId" "calibration") (makeKeyMappingEntry "budget-ceiling" "budgetCeiling" "calibration") (makeKeyMappingEntry "pass-rate" "passRate" "calibration") (makeKeyMappingEntry "ctrf-progress" "ctrfProgress" "calibration") (makeKeyMappingEntry "avg-tokens" "avgTokens" "calibration") (makeKeyMappingEntry "amnesia-detected" "amnesiaDetected" "calibration") (makeKeyMappingEntry "pareto-score" "paretoScore" "calibration") (makeKeyMappingEntry "case-id" "caseId" "benchmarking") (makeKeyMappingEntry "matched-intent" "matchedIntent" "benchmarking") (makeKeyMappingEntry "matched-tier" "matchedTier" "benchmarking") (makeKeyMappingEntry "predicted-intent" "predictedIntent" "benchmarking") (makeKeyMappingEntry "predicted-tier" "predictedTier" "benchmarking") (makeKeyMappingEntry "target-url" "targetUrl" "browser") (makeKeyMappingEntry "is-connected" "isConnected" "browser") (makeKeyMappingEntry "mutated-paths" "mutatedPaths" "harness") (makeKeyMappingEntry "continuous-progress" "continuousProgress" "calibration") (makeKeyMappingEntry "entry-id" "entryId" "routing") (makeKeyMappingEntry "timestamp-ms" "timestampMs" "timing") (makeKeyMappingEntry "task-id" "taskId" "task") (makeKeyMappingEntry "prompt-snippet" "promptSnippet" "routing") (makeKeyMappingEntry "entropy-score" "entropyScore" "routing") (makeKeyMappingEntry "selected-tier" "selectedTier" "routing") (makeKeyMappingEntry "executed-locally" "executedLocally" "routing") (makeKeyMappingEntry "tokens-saved" "tokensSaved" "routing") (makeKeyMappingEntry "gate-verdict" "gateVerdict" "routing") (makeKeyMappingEntry "before-digest" "beforeDigest" "trace") (makeKeyMappingEntry "after-digest" "afterDigest" "trace") (makeKeyMappingEntry "parent-digest" "parentDigest" "trace") (makeKeyMappingEntry "runtime-target" "runtimeTarget" "trace") (makeKeyMappingEntry "lost-writes" "lostWrites" "telemetry") (makeKeyMappingEntry "raised-conflicts" "raisedConflicts" "telemetry") (makeKeyMappingEntry "repeated-work-tokens" "repeatedWorkTokens" "telemetry") (makeKeyMappingEntry "completion-rate" "completionRate" "telemetry") (makeKeyMappingEntry "mean-time-to-settlement-ms" "meanTimeToSettlementMs" "telemetry") (makeKeyMappingEntry "lost-writes-delta" "lostWritesDelta" "telemetry") (makeKeyMappingEntry "collision-reduction-factor" "collisionReductionFactor" "telemetry") (makeKeyMappingEntry "conflicts-reduction-factor" "conflictsReductionFactor" "telemetry") (makeKeyMappingEntry "token-overhead-saved" "tokenOverheadSaved" "telemetry") (makeKeyMappingEntry "confidence-interval" "confidenceInterval" "telemetry") (makeKeyMappingEntry "lost-writes-ci-low" "lostWritesCiLow" "telemetry") (makeKeyMappingEntry "lost-writes-ci-high" "lostWritesCiHigh" "telemetry") (makeKeyMappingEntry "sample-iterations" "sampleIterations" "telemetry") (makeKeyMappingEntry "standard-error" "standardError" "telemetry") (makeKeyMappingEntry "orig-len" "origLen" "wire"))

fn normalizeToCanonicalKey key: Str -> Str
  (let [(hasColon (stringStartsWith? key ":")) (cleanKey (if hasColon (optionOr (stringSlice key 1 (stringLength key)) key) key)) (matched (filter (fn [(e KeyMappingEntry)] -> Bool (= e.legacy cleanKey)) (getCanonicalKeyMappings)))] (if (listEmpty? matched) key (let [(firstEntry (optionOr (listHead matched) (KeyMappingEntry :legacy "" :canonical "" :scope "")))] (if hasColon (str ":" firstEntry.canonical) firstEntry.canonical))))

fn translateToLegacyKey key: Str -> Str
  (let [(hasColon (stringStartsWith? key ":")) (cleanKey (if hasColon (optionOr (stringSlice key 1 (stringLength key)) key) key)) (matched (filter (fn [(e KeyMappingEntry)] -> Bool (= e.canonical cleanKey)) (getCanonicalKeyMappings)))] (if (listEmpty? matched) key (let [(firstEntry (optionOr (listHead matched) (KeyMappingEntry :legacy "" :canonical "" :scope "")))] (if hasColon (str ":" firstEntry.legacy) firstEntry.legacy))))

fn normalizeAsnRecordKeys raw: Str -> Str
  (fold (fn [(acc Str) (e KeyMappingEntry)] -> Str (stringReplace acc (str ":" e.legacy " ") (str ":" e.canonical " "))) raw (getCanonicalKeyMappings))

fn translateAsnRecordToLegacy raw: Str -> Str
  (fold (fn [(acc Str) (e KeyMappingEntry)] -> Str (stringReplace acc (str ":" e.canonical " ") (str ":" e.legacy " "))) raw (getCanonicalKeyMappings))

fn auditEmittedAsnKeys raw: Str -> Bool
  (let [(violations (filter (fn [(e KeyMappingEntry)] -> Bool (stringContains? raw (str ":" e.legacy " "))) (getCanonicalKeyMappings)))] (listEmpty? violations))

fn RunTests -> Bool
  (let [(m (makeKeyMappingEntry "test-key" "testKey" "test")) (allMaps (getCanonicalKeyMappings)) (norm (normalizeToCanonicalKey "exit-code")) (normColon (normalizeToCanonicalKey ":exit-code")) (leg (translateToLegacyKey "exitCode")) (legColon (translateToLegacyKey ":exitCode")) (sampleKebab "(:record :exit-code 0 :duration-ms 42 :session-id \"sess1\")") (sampleCamel "(:record :exitCode 0 :durationMs 42 :sessionId \"sess1\")") (convertedNorm (normalizeAsnRecordKeys sampleKebab)) (convertedLeg (translateAsnRecordToLegacy sampleCamel))] (assert (= m.legacy "test-key") "make-key-mapping-entry sets legacy") (assert (= m.canonical "testKey") "make-key-mapping-entry sets canonical") (assert (> (listLength allMaps) 20) "canonical mapping dictionary populated") (assert (= norm "exitCode") "normalize plain key") (assert (= normColon ":exitCode") "normalize colon key") (assert (= leg "exit-code") "translate plain key") (assert (= legColon ":exit-code") "translate colon key") (assert (= convertedNorm sampleCamel) "normalize-asn-record-keys matches camelCase") (assert (= convertedLeg sampleKebab) "translate-asn-record-to-legacy matches kebab-case") (assert (auditEmittedAsnKeys sampleCamel) "audit-emitted-asn-keys accepts camelCase") (assert (not (auditEmittedAsnKeys sampleKebab)) "audit-emitted-asn-keys rejects kebab-case") true)
