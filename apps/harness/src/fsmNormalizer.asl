(module aslHarness/fsmNormalizer :x [FsmState FsmResult normalizeKeywords balanceDelimitersFsm repairSyntaxFsm] :i [])

(enum FsmState (:c fsmIdle [] "FSM is idle outside of any form or string") (:c fsmInForm [] "FSM is inside an active S-expression form") (:c fsmInStr [] "FSM is inside a string literal") (:c fsmInEscape [] "FSM is processing an escaped character in a string"))

(schema FsmResult (:f repaired Str) (:f openParens I64) (:f openBrackets I64) (:f balanced? Bool))

(schema FsmTracker (:f state FsmState) (:f stack (List Str)) (:f openParens I64) (:f openBrackets I64) (:f inComment Bool))

fn popMatchingDelim stack: (List Str) target: Str -> (List Str)
  (if (listEmpty? stack) (list) (let [(h (optionOr (listHead stack) "")) (t (optionOr (listTail stack) (list)))] (if (= h target) t (cons h (popMatchingDelim t target)))))

fn delimsToClosers stack: (List Str) -> Str
  (if (listEmpty? stack) "" (let [(h (optionOr (listHead stack) "")) (t (optionOr (listTail stack) (list))) (closer (if (= h "(") ")" (if (= h "[") "]" "")))] (str closer (delimsToClosers t))))

fn fsmStep st: FsmTracker c: Str -> FsmTracker
  (if st.inComment (if (= c "\n") (with st :inComment false) st) (mt st.state ((fsmInEscape) (with st :state (fsmInStr) :inComment false)) ((fsmInStr) (cond ((= c "\\") (with st :state (fsmInEscape) :inComment false)) ((= c "\"") (let [(p st.openParens) (b st.openBrackets) (nextSt (if (and (= p 0) (= b 0)) (fsmIdle) (fsmInForm)))] (with st :state nextSt :openParens p :openBrackets b :inComment false))) (else st))) (_ (cond ((= c ";") (with st :inComment true)) ((= c "\"") (with st :state (fsmInStr) :inComment false)) ((= c "(") (with st :state (fsmInForm) :stack (cons "(" st.stack) :openParens (+ st.openParens 1) :inComment false)) ((= c "[") (with st :state (fsmInForm) :stack (cons "[" st.stack) :openBrackets (+ st.openBrackets 1) :inComment false)) ((= c ")") (let [(newP (if (> st.openParens 0) (- st.openParens 1) 0)) (newB st.openBrackets) (newStack (popMatchingDelim st.stack "(")) (nextSt (if (and (= newP 0) (= newB 0)) (fsmIdle) (fsmInForm)))] (FsmTracker :state nextSt :stack newStack :openParens newP :openBrackets newB :inComment false))) ((= c "]") (let [(newP st.openParens) (newB (if (> st.openBrackets 0) (- st.openBrackets 1) 0)) (newStack (popMatchingDelim st.stack "[")) (nextSt (if (and (= newP 0) (= newB 0)) (fsmIdle) (fsmInForm)))] (FsmTracker :state nextSt :stack newStack :openParens newP :openBrackets newB :inComment false))) (else st)))))

fn balanceDelimitersFsm source: Str -> FsmResult
  (let [(chars (stringChars source)) (initTracker (FsmTracker :state (fsmIdle) :stack (list) :openParens 0 :openBrackets 0 :inComment false)) (finalTracker (fold (fn [(acc FsmTracker) (ch Str)] (fsmStep acc ch)) initTracker chars)) (st finalTracker.state) (pCount finalTracker.openParens) (bCount finalTracker.openBrackets) (unclosedStack finalTracker.stack) (quoteCloser (mt st ((fsmInEscape) "\\\"\"") ((fsmInStr) "\"") (_ ""))) (delimClosers (delimsToClosers unclosedStack)) (suffix (str quoteCloser delimClosers)) (isBalanced (and (= pCount 0) (and (= bCount 0) (mt st ((fsmIdle) true) (_ false)))))] (FsmResult :repaired (str source suffix) :openParens pCount :openBrackets bCount :balanced? isBalanced))

fn replaceKeywordPatterns s: Str -> Str
  (let [(s1 (stringReplace s (str "(" "defun ") "(fn ")) (s2 (stringReplace s1 "(defun\n" "(fn\n")) (s3 (stringReplace s2 "(defun\t" "(fn\t")) (s4 (stringReplace s3 "(defun[" "(fn [")) (s5 (stringReplace s4 "(defun(" "(fn (")) (s6 (stringReplace s5 "(defn " "(fn ")) (s7 (stringReplace s6 "(defn\n" "(fn\n")) (s8 (stringReplace s7 "(defn\t" "(fn\t")) (s9 (stringReplace s8 "(defn[" "(fn [")) (s10 (stringReplace s9 "(defn(" "(fn (")) (s10b (stringReplace s10 "(df " "(fn ")) (s11 (stringReplace s10b "(lambda " "(fn ")) (s12 (stringReplace s11 "(lambda\n" "(fn\n")) (s13 (stringReplace s12 "(lambda\t" "(fn\t")) (s14 (stringReplace s13 "(lambda[" "(fn [")) (s15 (stringReplace s14 "(lambda(" "(fn (")) (s16 (stringReplace s15 " defun " " fn ")) (s17 (stringReplace s16 " defn " " fn ")) (s17b (stringReplace s17 " df " " fn ")) (s18 (stringReplace s17b " lambda " " fn ")) (s19 (stringReplace s18 "\ndefun " "\nfn ")) (s20 (stringReplace s19 "\ndefn " "\nfn ")) (s20b (stringReplace s20 "\ndf " "\nfn ")) (s21 (stringReplace s20b "\nlambda " "\nfn ")) (s22 (stringReplace s21 "\tdefun " "\tfn ")) (s23 (stringReplace s22 "\tdefn " "\tfn ")) (s23b (stringReplace s23 "\tdf " "\tfn ")) (s24 (stringReplace s23b "\tlambda " "\tfn ")) (s25 (stringReplace s24 "(defstruct " "(schema ")) (s26 (stringReplace s25 "(defrecord " "(schema ")) (s26b (stringReplace s26 "(dfs " "(schema ")) (s27 (stringReplace s26b "(defenum " "(enum ")) (s27b (stringReplace s27 "(dfe " "(enum ")) (s28 (stringReplace s27b " String " " Str ")) (s29 (stringReplace s28 " Int64 " " I64 ")) (s30 (stringReplace s29 " Boolean " " Bool ")) (s31 (stringReplace s30 " Float64 " " F64 "))] s31)

fn normalizeKeywords source: Str -> Str
  (cond ((or (= source "defun") (or (= source "defn") (or (= source "df") (= source "lambda")))) "fn") ((or (= source "defstruct") (or (= source "defrecord") (= source "dfs"))) "schema") ((or (= source "defenum") (= source "dfe")) "enum") (else (let [(step1 (replaceKeywordPatterns source)) (step2 (if (stringStartsWith? step1 "defun ") (str "fn " (optionOr (stringSlice step1 6 (stringLength step1)) "")) step1)) (step3 (if (stringStartsWith? step2 "defn ") (str "fn " (optionOr (stringSlice step2 5 (stringLength step2)) "")) step2)) (step3b (if (stringStartsWith? step3 "df ") (str "fn " (optionOr (stringSlice step3 3 (stringLength step3)) "")) step3)) (step4 (if (stringStartsWith? step3b "lambda ") (str "fn " (optionOr (stringSlice step3b 7 (stringLength step3b)) "")) step3b)) (step5 (if (stringEndsWith? step4 " defun") (str (optionOr (stringSlice step4 0 (- (stringLength step4) 6)) "") " fn") step4)) (step6 (if (stringEndsWith? step5 " defn") (str (optionOr (stringSlice step5 0 (- (stringLength step5) 5)) "") " fn") step5)) (step6b (if (stringEndsWith? step6 " df") (str (optionOr (stringSlice step6 0 (- (stringLength step6) 3)) "") " fn") step6)) (step7 (if (stringEndsWith? step6b " lambda") (str (optionOr (stringSlice step6b 0 (- (stringLength step6b) 7)) "") " fn") step6b))] step7)))

fn stripFencesLocal s: Str -> Str
  (let [(s1 (stringReplace s "```asl\n" "")) (s2 (stringReplace s1 "```asl" "")) (s3 (stringReplace s2 "```\n" "")) (s4 (stringReplace s3 "```" ""))] (stringTrim s4))

fn repairSyntaxFsm source: Str -> Str
  (let [(unfenced (stripFencesLocal source)) (kwRepaired (normalizeKeywords unfenced)) (fsmRes (balanceDelimitersFsm kwRepaired))] fsmRes.repaired)
