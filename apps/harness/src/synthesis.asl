(module aslHarness/synthesis :x [EpistemicScorecard CanonicalDeliveryReport format5SectionDelivery] :i [(feedback :a fb) (preMortem :a pm)])

(schema EpistemicScorecard (:f confidenceScore F64) (:f verifiedAssertionCount I64) (:f unverifiedGapCount I64) (:f calibrationVerdict Str))

(schema CanonicalDeliveryReport (:f section1Findings Str) (:f section2Divergences Str) (:f section3Disclosures Str) (:f section4Consequences Str) (:f section5Scorecard Str) (:f rawMarkdown Str))

fn format5SectionDelivery taskId: Str findings: (List Str) divergences: (List Str) omissions: (List Str) consequences: (List pm/ConsequenceRisk) scorecard: EpistemicScorecard -> CanonicalDeliveryReport
  (let [(s1Body (if (listEmpty? findings) "- No verified findings recorded." (str "- " (stringJoin findings "\n- ")))) (s1 (str "## 1. Verified Findings & AST Grounding\n\n" s1Body)) (s2Body (if (listEmpty? divergences) "- No intent divergences detected. Implementation anchors directly to specification." (str "- " (stringJoin divergences "\n- ")))) (s2 (str "## 2. Intent Divergences & Reality Anchors\n\n" s2Body)) (s3Body (fb/discloseObservedGaps omissions)) (s3 (str "## 3. Transparent Disclosures & Omissions\n\n" s3Body)) (s4Body (if (listEmpty? consequences) "- No downstream consequence risks identified." (stringJoin (map (fn [(r pm/ConsequenceRisk)] -> Str (str "- [" r.severity "] (hops: " (stringFromInt64 r.hopCount) ", grounded: " (if r.isGrounded "true" "false") ") " r.description "\n  Trigger: `" r.falsificationTrigger "`")) consequences) "\n"))) (s4 (str "## 4. Blast Radius & Downstream Consequences\n\n" s4Body)) (s5Body (str "- Confidence Score: " (stringFromFloat64 scorecard.confidenceScore) "\n" "- Verified Assertions: " (stringFromInt64 scorecard.verifiedAssertionCount) "\n" "- Unverified Gaps: " (stringFromInt64 scorecard.unverifiedGapCount) "\n" "- Calibration Verdict: " scorecard.calibrationVerdict)) (s5 (str "## 5. Epistemic Calibration Scorecard\n\n" s5Body)) (rawMd (str "# Canonical Delivery Report: " taskId "\n\n" s1 "\n\n" s2 "\n\n" s3 "\n\n" s4 "\n\n" s5))] (CanonicalDeliveryReport :section1Findings s1 :section2Divergences s2 :section3Disclosures s3 :section4Consequences s4 :section5Scorecard s5 :rawMarkdown rawMd))
