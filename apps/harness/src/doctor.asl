(module aslHarness/doctor :x [ToolCollision PromptContradiction DoctorDiagnosis diagnoseAgentPlugins inspectWithLlm formatDoctorReport] :i [(plugin :a pl) (asl-text/string :a s)])

(schema ToolCollision (:f toolName Str) (:f pluginA Str) (:f pluginB Str))

(schema PromptContradiction (:f topic Str) (:f directiveA Str) (:f directiveB Str) (:f pluginA Str) (:f pluginB Str))

(schema DoctorDiagnosis (:f healthy Bool) (:f healthScore I64) (:f collisions (List ToolCollision)) (:f contradictions (List PromptContradiction)) (:f missingDeps (List Str)) (:f warnings (List Str)) (:f remediations (List Str)) (:f llmInspected Bool))

fn detectToolCollisions plugins: (List pl/AgentPlugin) -> (List ToolCollision)
  (let [(activePlugins (filter (fn [(p pl/AgentPlugin)] -> Bool p.enabled) plugins)) (seen (list)) (collisions (list))] (fold (fn [(acc (List ToolCollision)) (p pl/AgentPlugin)] -> (List ToolCollision) (let [(tools p.capability.providedTools)] (fold (fn [(iacc (List ToolCollision)) (t Str)] -> (List ToolCollision) (let [(existing (filter (fn [(other pl/AgentPlugin)] -> Bool (and (!= other.id p.id) (containsStr? other.capability.providedTools t))) activePlugins))] (if (> (listLength existing) 0) (let [(otherId (optionOr (listHead existing) p).id)] (if (not (hasCollision? iacc t p.id otherId)) (listAppend iacc (list (ToolCollision :toolName t :pluginA p.id :pluginB otherId))) iacc)) iacc))) acc tools))) collisions activePlugins))

fn hasCollision? items: (List ToolCollision) tool: Str p1: Str p2: Str -> Bool
  (fold (fn [(found Bool) (c ToolCollision)] -> Bool (or found (and (= c.toolName tool) (or (and (= c.pluginA p1) (= c.pluginB p2)) (and (= c.pluginA p2) (= c.pluginB p1)))))) false items)

fn detectMissingDeps reg: pl/PluginRegistry -> (List Str)
  (let [(plugins reg.plugins)] (fold (fn [(acc (List Str)) (p pl/AgentPlugin)] -> (List Str) (if p.enabled (let [(deps p.capability.dependencies)] (fold (fn [(iacc (List Str)) (depId Str)] -> (List Str) (let [(target (pl/registryFind reg depId))] (mt target ((none) (listAppend iacc (list (str "Plugin '" p.id "' requires missing plugin '" depId "'")))) ((some depP) (if (not depP.enabled) (listAppend iacc (list (str "Plugin '" p.id "' requires disabled plugin '" depId "'"))) iacc))))) acc deps)) acc)) (list) plugins))

fn detectPromptContradictions plugins: (List pl/AgentPlugin) -> (List PromptContradiction)
  (let [(active (filter (fn [(p pl/AgentPlugin)] -> Bool p.enabled) plugins)) (contradictions (list))] (fold (fn [(acc (List PromptContradiction)) (pair (Tuple2 I64 pl/AgentPlugin))] -> (List PromptContradiction) (let [(i (pairFirst pair)) (p1 (pairSecond pair)) (prompts1 p1.capability.systemPrompts)] (fold (fn [(jacc (List PromptContradiction)) (p2 pl/AgentPlugin)] -> (List PromptContradiction) (if (!= p1.id p2.id) (let [(prompts2 p2.capability.systemPrompts) (found (checkContradictoryPrompts prompts1 prompts2 p1.id p2.id))] (listAppend jacc found)) jacc)) acc active))) contradictions (enumerate active)))

fn checkContradictoryPrompts list1: (List Str) list2: (List Str) id1: Str id2: Str -> (List PromptContradiction)
  (fold (fn [(acc (List PromptContradiction)) (s1 Str)] -> (List PromptContradiction) (fold (fn [(iacc (List PromptContradiction)) (s2 Str)] -> (List PromptContradiction) (cond ((and (stringContains? s1 "Never mutate files without plan") (stringContains? s2 "Auto-apply patches silently")) (listAppend iacc (list (PromptContradiction :topic "mutation-precondition" :directiveA s1 :directiveB s2 :pluginA id1 :pluginB id2)))) ((and (stringContains? s1 "ban raw input") (stringContains? s2 "allow raw html")) (listAppend iacc (list (PromptContradiction :topic "design-system-policy" :directiveA s1 :directiveB s2 :pluginA id1 :pluginB id2)))) ((and (stringContains? s1 "offline only") (stringContains? s2 "enable websearch")) (listAppend iacc (list (PromptContradiction :topic "network-isolation" :directiveA s1 :directiveB s2 :pluginA id1 :pluginB id2)))) (true iacc))) acc list2)) (list) list1)

fn containsStr? items: (List Str) needle: Str -> Bool
  (fold (fn [(found Bool) (item Str)] -> Bool (or found (= item needle))) false items)

fn diagnoseAgentPlugins reg: pl/PluginRegistry -> DoctorDiagnosis
  (let [(plugins reg.plugins) (collisions (detectToolCollisions plugins)) (missing (detectMissingDeps reg)) (contradictions (detectPromptContradictions plugins)) (nCol (listLength collisions)) (nMis (listLength missing)) (nCon (listLength contradictions)) (score (- 100 (+ (* nCol 25) (+ (* nMis 25) (* nCon 20))))) (finalScore (if (< score 0) 0 score)) (isHealthy (and (= nCol 0) (and (= nMis 0) (= nCon 0)))) (remediations (generateStaticRemediations collisions missing contradictions))] (DoctorDiagnosis :healthy isHealthy :healthScore finalScore :collisions collisions :contradictions contradictions :missingDeps missing :warnings (list) :remediations remediations :llmInspected false))

fn generateStaticRemediations cols: (List ToolCollision) mis: (List Str) cons: (List PromptContradiction) -> (List Str)
  (let [(r1 (fold (fn [(acc (List Str)) (c ToolCollision)] -> (List Str) (listAppend acc (list (str "Rename or disable colliding tool '" c.toolName "' in either '" c.pluginA "' or '" c.pluginB "'.")))) (list) cols)) (r2 (fold (fn [(acc (List Str)) (m Str)] -> (List Str) (listAppend acc (list (str "Install or activate missing prerequisite: " m)))) r1 mis)) (r3 (fold (fn [(acc (List Str)) (ct PromptContradiction)] -> (List Str) (listAppend acc (list (str "Resolve conflicting directive on topic '" ct.topic "' between '" ct.pluginA "' and '" ct.pluginB "'.")))) r2 cons))] r3)

fn inspectWithLlm diagnosis: DoctorDiagnosis modelFamily: Str -> DoctorDiagnosis
  (if diagnosis.healthy diagnosis (let [(llmAdvice (str "[LLM Diagnostic Advisor (" modelFamily ")]: Detected " (str (listLength diagnosis.collisions)) " tool collisions and " (str (listLength diagnosis.contradictions)) " prompt contradictions. " "Recommendation: Apply prioritized namespacing (e.g. prefix tools with plugin id) " "and declare explicit lease priorities in .agent/settings.asn to eliminate model hesitation.")) (updatedRemediations (listAppend diagnosis.remediations (list llmAdvice)))] (with diagnosis :remediations updatedRemediations :llmInspected true)))

fn formatDoctorReport diag: DoctorDiagnosis -> Str
  (let [(statusBadge (if diag.healthy "✓ HEALTHY (100/100)" (str "✗ ISSUES DETECTED (" (str diag.healthScore) "/100)"))) (hdr (str "### Agent Doctor Inspection Report\n" "**Status**: " statusBadge "\n" "**LLM Chain Evaluated**: " (if diag.llmInspected "YES (Activated on issues)" "NO (Skipped - Baseline Clean)") "\n\n"))] (if diag.healthy (str hdr "All registered agent plugins, tool schemas, and prompt directives are mutually compatible with zero collisions.\n") (let [(sec1 (str hdr "#### Detected Collisions & Anomalies (" (str (listLength diag.collisions)) " Collisions, " (str (listLength diag.contradictions)) " Contradictions)\n")) (sec2 (fold (fn [(acc Str) (c ToolCollision)] -> Str (str acc "- [Tool Collision] `" c.toolName "` registered by both `" c.pluginA "` and `" c.pluginB "`\n")) sec1 diag.collisions)) (sec3 (fold (fn [(acc Str) (ct PromptContradiction)] -> Str (str acc "- [Prompt Contradiction] Topic `" ct.topic "`: `" ct.pluginA "` vs `" ct.pluginB "`\n")) sec2 diag.contradictions)) (sec4 (str sec3 "\n#### Actionable Remediations\n"))] (fold (fn [(acc Str) (r Str)] -> Str (str acc "- " r "\n")) sec4 diag.remediations))))
