(module prelude/tests/preludeCheckedListTest :x [runTests] :i [])

; (:m :ref COVRATCHET :do "checkedDiv, checkedMod, listMin, listMax, optionToResult had no test: values on both number kinds, the zero and Int64-minimum failure paths, empty lists, ties")
fn runTests -> Bool
  (do
    (assert (= (checkedDiv 7 2) (some 3)) "Int division")
    (assert (= (checkedDiv -7 2) (some -4)) "Int division floors")
    (assert (= (checkedDiv 0 5) (some 0)) "zero numerator")
    (assert (= (checkedDiv 5 0) none) "Int zero divisor is none")
    (assert (= (checkedDiv -9223372036854775808 -1) none) "Int64 minimum over -1 overflows to none")
    (assert (= (checkedDiv -9223372036854775808 1) (some -9223372036854775808)) "Int64 minimum over 1 is exact")
    (assert (= (checkedDiv 7.0 2.0) (some 3.5)) "Float division")
    (assert (= (checkedDiv 1.0 0.0) none) "Float zero divisor is none")
    (assert (= (checkedMod 7 3) (some 1)) "Int remainder")
    (assert (= (checkedMod -7 3) (some 2)) "remainder follows the divisor sign")
    (assert (= (checkedMod 7 -3) (some -2)) "negative divisor")
    (assert (= (checkedMod 5 0) none) "Int zero divisor is none")
    (assert (= (checkedMod 5.5 2.0) (some 1.5)) "Float remainder")
    (assert (= (checkedMod 1.0 0.0) none) "Float zero divisor is none")
    (assert (= (listMin (list 3 1 2)) (some 1)) "minimum of three")
    (assert (= (listMax (list 3 1 2)) (some 3)) "maximum of three")
    (assert (= (listMin (list)) none) "minimum of empty is none")
    (assert (= (listMax (list)) none) "maximum of empty is none")
    (assert (= (listMin (list 7)) (some 7)) "minimum of one")
    (assert (= (listMax (list 7)) (some 7)) "maximum of one")
    (assert (= (listMin (list -5 -9 -1)) (some -9)) "minimum of negatives")
    (assert (= (listMax (list -5 -9 -1)) (some -1)) "maximum of negatives")
    (assert (= (listMin (list 2 2 2)) (some 2)) "minimum of ties")
    (assert (= (listMax (list 1 9 9 3)) (some 9)) "maximum with a repeated top")
    (assert (= (listMin (list 2.5 0.5 1.5)) (some 0.5)) "minimum of floats")
    (assert (= (listMax (list 2.5 0.5 1.5)) (some 2.5)) "maximum of floats")
    (assert (= (listMin (list "b" "a" "c")) (some "a")) "minimum of strings")
    (assert (= (listMax (list "b" "a" "c")) (some "c")) "maximum of strings")
    (assert (= (optionToResult (some 1) "e") (ok 1)) "some becomes ok")
    (assert (= (optionToResult none "e") (err "e")) "none becomes err with the given error")
    (assert (= (optionToResult (some "x") 0) (ok "x")) "the error type is independent of the value type")
    true)
