(module aslWeb/apiPackages :x [packageCatalog])

(schema PackageInfo (:f name Str) (:f version Str) (:f repo Str) (:f desc Str))

fn packageCatalog -> (List Any)
  (do [(PackageInfo :name "@genseam/search" :version "1.0.0" :repo "https://github.com/GenSEAM/search" :desc "SearXNG metasearch engine") (PackageInfo :name "@genseam/mem" :version "1.0.0" :repo "https://github.com/GenSEAM/mem" :desc "In-memory vector database and cosine similarity") (PackageInfo :name "@genseam/fsm" :version "1.0.0" :repo "https://github.com/GenSEAM/fsm" :desc "Algebraic Finite State Machine engine") (PackageInfo :name "@genseam/vdom" :version "1.0.0" :repo "https://github.com/GenSEAM/vdom" :desc "Declarative S-Expression Virtual DOM") (PackageInfo :name "@genseam/harness" :version "1.0.0" :repo "https://github.com/GenSEAM/harness" :desc "Universal Multi-Modal Agent Harness") (PackageInfo :name "@genseam/browser-plugin" :version "1.0.0" :repo "https://github.com/GenSEAM/browser-plugin" :desc "Browser Automation Controller") (PackageInfo :name "@genseam/agent-bus" :version "1.0.0" :repo "https://github.com/GenSEAM/agent-bus" :desc "Inter-Agent Swarm Bus Protocol") (PackageInfo :name "@genseam/eddie" :version "1.0.0" :repo "https://github.com/GenSEAM/eddie" :desc "3-Layer Superposition Swarm Orchestrator") (PackageInfo :name "@genseam/voice" :version "1.0.0" :repo "https://github.com/GenSEAM/voice" :desc "Real-time Voice Stream Assistant") (PackageInfo :name "@genseam/skills" :version "1.0.0" :repo "https://github.com/GenSEAM/skills" :desc "Universal Agent Skills Hub")])
