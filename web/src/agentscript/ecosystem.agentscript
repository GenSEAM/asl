(module web/ecosystem
  :doc "Universal Ecosystem Glue & Multi-Paradigm Interop Engine"
  :export [TargetLanguage TargetStatus Paradigm get-targets-count calculate-token-savings format-bridge-name])

(defenum TargetStatus
  (:case active     [] "Fully verified with differential gate")
  (:case planned    [] "On future language roadmap"))

(defschema TargetLanguage
  (:field name String "Display name of the language")
  (:field slug String "Kebab-case identifier")
  (:field paradigm String "Primary paradigm (OOP, Functional, Systems, Procedural)")
  (:field description String "How AgentScript integrates with its host ecosystem"))

(defenum Paradigm
  (:case oop        [] "Classes, encapsulated methods, inheritance/interfaces")
  (:case functional [] "Immutable values, pure functions, algebraic data types")
  (:case procedural [] "Step-by-step imperative sequences and explicit effect markers"))

(defun get-targets-count [] -> Int64
  :doc "Returns total count of active and planned targets"
  8)

(defun calculate-token-savings [(modules Int64) (daily-calls Int64)] -> Int64
  :doc "Calculates monthly token reduction in millions of tokens"
  (let [(std-tokens (* (* modules 650) daily-calls))
        (as-tokens (* (* modules 142) daily-calls))]
    (let [(monthly-saved (* (- std-tokens as-tokens) 30))]
      (/ monthly-saved 1000000))))

(defun format-bridge-name [(p Paradigm)] -> String
  :doc "Returns descriptive bridge title"
  (match p
    ((oop) "OOP Bridge (Schemas to Classes & Structs)")
    ((functional) "Functional Bridge (Pure S-Expressions & ADTs)")
    ((procedural) "Procedural Bridge (Strict Effect Tracking)")))
