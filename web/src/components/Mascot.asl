(module aslWeb/components/mascot
  :d "Pure Vector SVG Schematic Cyber Chameleon AX-4 Chroma mascot component with cyber-liana anchor under ADR D99"
  :x [viewChameleon
      viewCyberLiana
      chameleonApertureIris]
  :i [(asl-text/string :a s)])

(df chameleonApertureIris [] -> Str
  :d "Pure vector 8-blade camera aperture eye with concentric ocular contour and focal pupil tracking"
  (str "<g class=\"aperture-eye\" id=\"chameleon-aperture-eye\">"
       "<circle cx=\"354\" cy=\"63\" r=\"24\" stroke=\"#C084FC\" stroke-width=\"2.8\" fill=\"var(--asl-surface)\"/>"
       "<g class=\"aperture-blades\">"
       "<path d=\"M 354 43 Q 365 48 368 60\" stroke=\"#C084FC\" stroke-width=\"1.8\" fill=\"none\" transform=\"rotate(0 354 63)\"/>"
       "<path d=\"M 354 43 Q 365 48 368 60\" stroke=\"#C084FC\" stroke-width=\"1.8\" fill=\"none\" transform=\"rotate(45 354 63)\"/>"
       "<path d=\"M 354 43 Q 365 48 368 60\" stroke=\"#C084FC\" stroke-width=\"1.8\" fill=\"none\" transform=\"rotate(90 354 63)\"/>"
       "<path d=\"M 354 43 Q 365 48 368 60\" stroke=\"#C084FC\" stroke-width=\"1.8\" fill=\"none\" transform=\"rotate(135 354 63)\"/>"
       "<path d=\"M 354 43 Q 365 48 368 60\" stroke=\"#C084FC\" stroke-width=\"1.8\" fill=\"none\" transform=\"rotate(180 354 63)\"/>"
       "<path d=\"M 354 43 Q 365 48 368 60\" stroke=\"#C084FC\" stroke-width=\"1.8\" fill=\"none\" transform=\"rotate(225 354 63)\"/>"
       "<path d=\"M 354 43 Q 365 48 368 60\" stroke=\"#C084FC\" stroke-width=\"1.8\" fill=\"none\" transform=\"rotate(270 354 63)\"/>"
       "<path d=\"M 354 43 Q 365 48 368 60\" stroke=\"#C084FC\" stroke-width=\"1.8\" fill=\"none\" transform=\"rotate(315 354 63)\"/>"
       "</g>"
       "<circle cx=\"357\" cy=\"62\" r=\"5.5\" fill=\"#C084FC\" class=\"focal-pupil\"/>"
       "<circle cx=\"358.5\" cy=\"60.5\" r=\"1.8\" fill=\"#FFFFFF\" class=\"pupil-specular\"/>"
       "</g>"))

(df viewCyberLiana [] -> Str
  :d "Pure vector neon cyber-liana vine with emerald gradient and prehensile anchor nodes"
  (str "<g id=\"hero-cyber-liana\" transform=\"translate(10 32) scale(0.48) translate(-34 -4)\" filter=\"url(#asl-glow)\" style=\"transition: opacity 0.25s ease-out, transform 0.25s ease-out; transform-origin: 50px 180px;\">"
       "<path d=\"M 20 50 Q 52 180 100 325\" stroke=\"#059669\" stroke-width=\"3.6\" stroke-linecap=\"round\" fill=\"none\"/>"
       "<path d=\"M 20 50 Q 52 180 100 325\" stroke=\"#34D399\" stroke-width=\"1.4\" stroke-linecap=\"round\" fill=\"none\"/>"
       "<path d=\"M 32 95 C 12 85, 8 105, 32 100\" stroke=\"#10B981\" stroke-width=\"1.8\" fill=\"#10B981\" fill-opacity=\"0.25\"/><path d=\"M 44 150 C 24 140, 20 160, 44 155\" stroke=\"#10B981\" stroke-width=\"1.8\" fill=\"#10B981\" fill-opacity=\"0.25\"/><path d=\"M 68 230 C 88 220, 98 240, 68 235\" stroke=\"#10B981\" stroke-width=\"1.8\" fill=\"#10B981\" fill-opacity=\"0.25\"/><path d=\"M 88 290 C 108 280, 112 300, 88 295\" stroke=\"#10B981\" stroke-width=\"1.8\" fill=\"#10B981\" fill-opacity=\"0.25\"/>"
       "</g>"))

(df viewChameleon [] -> Str
  :d "Renders pure vector Schematic Cyber Chameleon AX-4 Chroma with cyber-liana anchor and dynamic prehensile tail"
  (str "<svg viewBox=\"0 0 200 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"asl-mascot\" id=\"hero-chameleon-svg\" role=\"img\" aria-label=\"Schematic Cyber Chameleon AX-4 Chroma with Prehensile Tail\">\n"
       "<defs>\n"
       "  <filter id=\"asl-glow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n"
       "    <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"2.5\" result=\"blur1\"/>\n"
       "    <feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"0.6\" result=\"blur2\"/>\n"
       "    <feMerge><feMergeNode in=\"blur1\"/><feMergeNode in=\"blur2\"/><feMergeNode in=\"SourceGraphic\"/></feMerge>\n"
       "  </filter>\n"
       "  <linearGradient id=\"neonPurple\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n"
       "    <stop offset=\"0%\" stop-color=\"#fdf4ff\"/>\n"
       "    <stop offset=\"20%\" stop-color=\"#f5d0fe\"/>\n"
       "    <stop offset=\"45%\" stop-color=\"#C084FC\"/>\n"
       "    <stop offset=\"70%\" stop-color=\"var(--asl-signal)\"/>\n"
       "    <stop offset=\"85%\" stop-color=\"#B060FF\"/>\n"
       "    <stop offset=\"100%\" stop-color=\"#7e22ce\"/>\n"
       "  </linearGradient>\n"
       "</defs>\n"
       "<g stroke=\"var(--asl-lineStrong)\" stroke-width=\"0.8\" opacity=\"0.2\" stroke-dasharray=\"3 3\"><line x1=\"10\" y1=\"110\" x2=\"190\" y2=\"110\"/></g>\n"
       (viewCyberLiana) "\n"
       "<g id=\"hero-chameleon-body\" transform=\"translate(10 32) scale(0.48) translate(-34 -4)\" stroke=\"#C084FC\" stroke-width=\"2.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\" filter=\"url(#asl-glow)\" vector-effect=\"non-scaling-stroke\" style=\"transition: transform 0.15s ease-out; transform-origin: 354px 63px;\">\n"
       (chameleonApertureIris) "\n"
