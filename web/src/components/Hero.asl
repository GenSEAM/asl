(module asl-web/hero
  :d "Declarative Hero Banner Component with Chameleon Watermark, Metrics, and Install Terminal"
  :x [render-hero hero-view hero]
  :i [(asl-text/string :a s)
      (asl-web/ui/logo :a logo)])

(df render-hero [] -> Str
  "<section id=\"top\" class=\"relative pt-32 pb-20 sm:pt-36 sm:pb-24 overflow-hidden\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\"><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center\"><div class=\"lg:col-span-7 space-y-6\"><div class=\"flex items-center gap-3.5 sm:gap-4 flex-wrap\"><span class=\"font-sans font-extrabold text-ink text-3xl sm:text-4xl lg:text-5xl tracking-tight leading-none\">Agent<span class=\"text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-indigo-300\">Script</span></span><span class=\"inline-flex items-center p-2 rounded-2xl text-signal bg-signal/15 border border-signal/30 shadow-sm\" title=\"Formally Verified Language Core\"><svg class=\"w-6 h-6 sm:w-7 sm:h-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z\"/></svg></span></div><h1 class=\"text-display font-semibold text-ink text-balance tracking-tight leading-[1.08]\">The Native Language for Autonomous Agents. <span class=\"text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-purple-300 to-indigo-300\">Multi-Runtime, Portable &amp; Token-Efficient.</span></h1><p class=\"text-lead text-ink-2 max-w-prose leading-relaxed\">Every existing language was designed for human typists with fragile indentation. AgentScript is engineered from first principles for autonomous models: single-pass balanced S-expressions, zero syntax repair loops, 57%–65% token savings over JSON, and verified multi-target compilation into Wasm, Rust, TypeScript, and Python.</p><div class=\"flex flex-wrap items-center gap-3 pt-1\"><span class=\"font-mono text-micro text-ink-3 uppercase font-semibold mr-1\">Model Spec:</span><a href=\"/llms.txt\" target=\"_blank\" rel=\"noreferrer\" class=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-signal/40 bg-signal/10 text-signal hover:bg-signal/20 font-mono text-micro font-medium transition-colors\"><svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"/></svg><span>/llms.txt</span></a><a href=\"/llms-full.txt\" target=\"_blank\" rel=\"noreferrer\" class=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-line bg-surface/80 text-ink-2 hover:text-ink hover:border-signal/30 font-mono text-micro font-medium transition-colors\"><svg class=\"w-3.5 h-3.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4\"/></svg><span>/llms-full.txt</span></a><span class=\"text-micro text-amber-300/90 font-mono px-2 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20\">Core &amp; Wire Protocol: Stable · Extended Tools: Under Development</span></div><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2\"><div class=\"p-4 rounded-2xl border border-line bg-surface/80 backdrop-blur-md shadow-sm hover:border-signal/30 transition-all flex items-start gap-3.5\"><div class=\"flex flex-col items-center gap-2 shrink-0\"><span class=\"font-mono text-micro font-bold text-signal px-1.5 py-0.5 rounded bg-signal/10 border border-signal/20\">[A]</span><div class=\"p-2 rounded-xl bg-inset border border-line text-signal\"><svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><rect width=\"20\" height=\"8\" x=\"2\" y=\"2\" rx=\"2\" ry=\"2\" stroke-width=\"2\"/><rect width=\"20\" height=\"8\" x=\"2\" y=\"14\" rx=\"2\" ry=\"2\" stroke-width=\"2\"/><line x1=\"6\" x2=\"6.01\" y1=\"6\" y2=\"6\" stroke-width=\"2\"/><line x1=\"6\" x2=\"6.01\" y1=\"18\" y2=\"18\" stroke-width=\"2\"/></svg></div></div><div><h3 class=\"font-sans font-bold text-ink text-sm\">Token &amp; Time Economy</h3><p class=\"text-meta text-ink-3 mt-1 leading-relaxed\">57%–65% token compaction over verbose JSON/YAML, with a strict ≤ 2-token primitive ceiling.</p></div></div><div class=\"p-4 rounded-2xl border border-line bg-surface/80 backdrop-blur-md shadow-sm hover:border-signal/30 transition-all flex items-start gap-3.5\"><div class=\"flex flex-col items-center gap-2 shrink-0\"><span class=\"font-mono text-micro font-bold text-signal px-1.5 py-0.5 rounded bg-signal/10 border border-signal/20\">[B]</span><div class=\"p-2 rounded-xl bg-inset border border-line text-signal\"><svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><rect width=\"6\" height=\"6\" x=\"9\" y=\"2\" rx=\"1\" stroke-width=\"2\"/><rect width=\"6\" height=\"6\" x=\"2\" y=\"16\" rx=\"1\" stroke-width=\"2\"/><rect width=\"6\" height=\"6\" x=\"16\" y=\"16\" rx=\"1\" stroke-width=\"2\"/><path stroke-width=\"2\" d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3M12 8v4\"/></svg></div></div><div><h3 class=\"font-sans font-bold text-ink text-sm\">Differential Verification</h3><p class=\"text-meta text-ink-3 mt-1 leading-relaxed\">Single source compiles with verified equivalence across Wasm, Rust, TypeScript, and Python.</p></div></div></div></div><div class=\"lg:col-span-5\"><div class=\"p-6 sm:p-7 rounded-3xl border border-line bg-surface/90 backdrop-blur-xl shadow-e3 relative overflow-hidden\"><div class=\"absolute top-2 left-2 font-mono text-[9px] text-ink-3 opacity-40\">+12.00 / ASL</div><div class=\"absolute bottom-2 right-2 font-mono text-[9px] text-ink-3 opacity-40\">CORE-SPEC-V1</div><div class=\"flex items-center justify-between pb-4 border-b border-line\"><div class=\"flex items-center gap-2\"><div class=\"w-2.5 h-2.5 rounded-full bg-red-500/80\"></div><div class=\"w-2.5 h-2.5 rounded-full bg-yellow-500/80\"></div><div class=\"w-2.5 h-2.5 rounded-full bg-green-500/80\"></div><span class=\"ml-2 font-mono text-micro text-ink-3\">asl-cli</span></div><span class=\"font-mono text-micro font-semibold text-signal uppercase\">GET STARTED NOW</span></div><div class=\"mt-5\"><div class=\"flex items-center justify-between mb-2\"><label for=\"install-input\" class=\"font-mono text-micro uppercase text-ink-3 font-semibold\">Install AgentScript CLI</label><div class=\"flex items-center gap-1 bg-inset p-0.5 rounded-lg border border-line text-micro font-mono\"><button type=\"button\" id=\"tab-unix\" onclick=\"var inp=document.getElementById('install-input');var pfx=document.getElementById('install-pfx');inp.value='curl -fsSL https://aslang.dev/install.sh | bash';pfx.textContent='$';this.className='px-2 py-0.5 rounded text-signal bg-surface border border-signal/20 font-medium';document.getElementById('tab-win').className='px-2 py-0.5 rounded text-ink-3 hover:text-ink transition-colors font-medium';\" class=\"px-2 py-0.5 rounded text-signal bg-surface border border-signal/20 font-medium cursor-pointer\">macOS / Linux</button><button type=\"button\" id=\"tab-win\" onclick=\"var inp=document.getElementById('install-input');var pfx=document.getElementById('install-pfx');inp.value='irm https://aslang.dev/install.ps1 | iex';pfx.textContent='PS>';this.className='px-2 py-0.5 rounded text-signal bg-surface border border-signal/20 font-medium';document.getElementById('tab-unix').className='px-2 py-0.5 rounded text-ink-3 hover:text-ink transition-colors font-medium';\" class=\"px-2 py-0.5 rounded text-ink-3 hover:text-ink transition-colors font-medium cursor-pointer\">Windows</button></div></div><div class=\"flex items-center gap-2 p-2.5 rounded-2xl bg-ground border border-line focus-within:border-signal/50 transition-colors\"><span id=\"install-pfx\" class=\"font-mono text-meta text-signal font-semibold select-none pl-2\">$</span><input id=\"install-input\" type=\"text\" readonly value=\"curl -fsSL https://aslang.dev/install.sh | bash\" class=\"flex-1 min-w-0 bg-transparent font-mono text-meta text-ink outline-none select-all\"/><button type=\"button\" onclick=\"var cmd=document.getElementById('install-input').value;navigator.clipboard.writeText(cmd);this.innerHTML='<svg class=\\'w-4 h-4 text-signal\\' fill=\\'none\\' stroke=\\'currentColor\\' viewBox=\\'0 0 24 24\\'><path stroke-linecap=\\'round\\' stroke-linejoin=\\'round\\' stroke-width=\\'2\\' d=\\'M5 13l4 4L19 7\\'/></svg>';var b=this;setTimeout(function(){b.innerHTML='<svg class=\\'w-4 h-4\\' fill=\\'none\\' stroke=\\'currentColor\\' viewBox=\\'0 0 24 24\\'><rect width=\\'14\\' height=\\'14\\' x=\\'8\\' y=\\'8\\' rx=\\'2\\' ry=\\'2\\' stroke-width=\\'2\\'/><path d=\\'M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\\' stroke-width=\\'2\\'/></svg>';},2000)\" aria-label=\"Copy installation command\" class=\"p-2 rounded-xl bg-surface hover:bg-inset text-ink-2 hover:text-ink border border-line transition-all cursor-pointer\"><svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\" stroke-width=\"2\"/><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\" stroke-width=\"2\"/></svg></button></div><div class=\"flex items-center justify-between text-micro text-ink-3 font-mono mt-2 px-1\"><span>Pre-built binary auto-detection</span><span>x64 &amp; arm64 native</span></div></div><div class=\"mt-6 pt-5 border-t border-line/60 grid grid-cols-2 gap-3\"><div class=\"p-3 rounded-2xl bg-inset/70 border border-line/60\"><span class=\"font-mono text-micro text-ink-3 uppercase block\">Token Reduction</span><span class=\"text-lg font-bold text-signal font-mono\">57%–65%</span></div><div class=\"p-3 rounded-2xl bg-inset/70 border border-line/60\"><span class=\"font-mono text-micro text-ink-3 uppercase block\">Syntax Errors</span><span class=\"text-lg font-bold text-green-400 font-mono\">0 Retries</span></div><div class=\"p-3 rounded-2xl bg-inset/70 border border-line/60\"><span class=\"font-mono text-micro text-ink-3 uppercase block\">Wasm Sandbox</span><span class=\"text-lg font-bold text-ink font-mono\">&lt;0.05ms</span></div><div class=\"p-3 rounded-2xl bg-inset/70 border border-line/60\"><span class=\"font-mono text-micro text-ink-3 uppercase block\">Targets</span><span class=\"text-lg font-bold text-ink font-mono\">6 Verified</span></div></div><div class=\"mt-5 pt-4 border-t border-line/60\"><span class=\"font-mono text-micro uppercase text-ink-3 block mb-2\">Verified Compile Targets:</span><div class=\"flex flex-wrap gap-1.5\"><span class=\"px-2.5 py-1 rounded-full border border-line bg-inset font-mono text-micro text-ink-2\">WebAssembly</span><span class=\"px-2.5 py-1 rounded-full border border-line bg-inset font-mono text-micro text-ink-2\">Rust</span><span class=\"px-2.5 py-1 rounded-full border border-line bg-inset font-mono text-micro text-ink-2\">TypeScript</span><span class=\"px-2.5 py-1 rounded-full border border-line bg-inset font-mono text-micro text-ink-2\">Go</span><span class=\"px-2.5 py-1 rounded-full border border-line bg-inset font-mono text-micro text-ink-2\">Python</span><span class=\"px-2.5 py-1 rounded-full border border-line bg-inset font-mono text-micro text-ink-2\">SQL</span></div></div></div></div></div></div></section>")

(df hero-view [] -> Str
  :d "Alias for render-hero"
  (render-hero))

(df hero [] -> Str
  :d "Hero component alias"
  (render-hero))
