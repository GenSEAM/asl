(module aslWeb/ui/logo
  :d "Canonical Chameleon Mascot Mark, Schematic Vectors & Brand Wordmark in pure AgentScript"
  :x [chameleonALogo
      logo
      chameleonSchematic
      chameleonWatermark
      emblem
      wordmark
      viewLogo
      viewApertureGlyph]
  :i [(asl-text/string :a s)])

(df viewApertureGlyph [] -> Str
  :d "Authentic pure vector 8-blade camera aperture brand glyph for aslang.dev"
  "<svg viewBox=\"0 0 32 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"asl-aperture-glyph w-full h-full\" role=\"img\" aria-label=\"AgentScript Aperture Glyph\"><defs><linearGradient id=\"apertureIrisGradSm\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#f3e8ff\"/><stop offset=\"30%\" stop-color=\"#C084FC\"/><stop offset=\"70%\" stop-color=\"#A855F7\"/><stop offset=\"100%\" stop-color=\"#7e22ce\"/></linearGradient><filter id=\"apertureGlow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\"><feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"0.8\" result=\"blur\"/><feMerge><feMergeNode in=\"blur\"/><feMergeNode in=\"SourceGraphic\"/></feMerge></filter></defs><g filter=\"url(#apertureGlow)\"><circle cx=\"16\" cy=\"16\" r=\"14\" stroke=\"url(#apertureIrisGradSm)\" stroke-width=\"2\" fill=\"none\"/><g class=\"aperture-blades\"><path d=\"M 16 3 Q 23 7 25 15\" stroke=\"#C084FC\" stroke-width=\"1.4\" fill=\"none\" transform=\"rotate(0 16 16)\"/><path d=\"M 16 3 Q 23 7 25 15\" stroke=\"#C084FC\" stroke-width=\"1.4\" fill=\"none\" transform=\"rotate(45 16 16)\"/><path d=\"M 16 3 Q 23 7 25 15\" stroke=\"#C084FC\" stroke-width=\"1.4\" fill=\"none\" transform=\"rotate(90 16 16)\"/><path d=\"M 16 3 Q 23 7 25 15\" stroke=\"#C084FC\" stroke-width=\"1.4\" fill=\"none\" transform=\"rotate(135 16 16)\"/><path d=\"M 16 3 Q 23 7 25 15\" stroke=\"#C084FC\" stroke-width=\"1.4\" fill=\"none\" transform=\"rotate(180 16 16)\"/><path d=\"M 16 3 Q 23 7 25 15\" stroke=\"#C084FC\" stroke-width=\"1.4\" fill=\"none\" transform=\"rotate(225 16 16)\"/><path d=\"M 16 3 Q 23 7 25 15\" stroke=\"#C084FC\" stroke-width=\"1.4\" fill=\"none\" transform=\"rotate(270 16 16)\"/><path d=\"M 16 3 Q 23 7 25 15\" stroke=\"#C084FC\" stroke-width=\"1.4\" fill=\"none\" transform=\"rotate(315 16 16)\"/></g><circle cx=\"16\" cy=\"16\" r=\"3.4\" fill=\"url(#apertureIrisGradSm)\"/><circle cx=\"17.2\" cy=\"14.8\" r=\"1\" fill=\"#FFFFFF\"/></g></svg>")

