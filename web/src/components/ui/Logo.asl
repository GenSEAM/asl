(module asl-web/ui/logo
  :d "Chameleon Mark, Schematic Vectors & Brand Wordmark in pure AgentScript"
  :x [chameleon-a-logo logo chameleon-schematic chameleon-watermark emblem wordmark]
  :i [(core/strings :a s)])

(df chameleon-a-logo [] -> Str
  :d "ASL Curled 'a' Chameleon Mark with full gradients and glow filter"
  "<svg viewBox=\"0 0 100 100\" class=\"w-8 h-8\" role=\"img\" aria-label=\"ASL Chameleon Logo\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"chameleonTailGrad\" x1=\"15%\" y1=\"10%\" x2=\"85%\" y2=\"90%\"><stop offset=\"0%\" stop-color=\"#d8b4fe\"/><stop offset=\"35%\" stop-color=\"#c084fc\"/><stop offset=\"70%\" stop-color=\"#a855f7\"/><stop offset=\"100%\" stop-color=\"#7c3aed\"/></linearGradient><linearGradient id=\"chameleonTailStrokeGrad\" x1=\"10%\" y1=\"5%\" x2=\"90%\" y2=\"95%\"><stop offset=\"0%\" stop-color=\"#f3e8ff\" stop-opacity=\"0.8\"/><stop offset=\"50%\" stop-color=\"#c084fc\" stop-opacity=\"0.4\"/><stop offset=\"100%\" stop-color=\"#581c87\" stop-opacity=\"0.6\"/></linearGradient><filter id=\"chameleonTailGlow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\"><feGaussianBlur stdDeviation=\"3\" result=\"blur\"/><feComposite in=\"SourceGraphic\" in2=\"blur\" operator=\"over\"/></filter></defs><path d=\"M 78,82 C 83,72 84,48 81,32 C 77,16 64,8 46,8 C 26,8 13,19 8,36 C 4,52 7,72 18,84 C 28,94 44,95 56,88 C 64,82 68,70 67,58 C 66,44 57,35 44,35 C 32,35 25,44 25,54 C 25,62 31,67 38,67 C 43,67 46,63 46,58 C 46,53 41,52 38,55 C 36,57 34,55 34,52 C 34,46 40,41 46,41 C 53,41 57,48 57,57 C 57,67 50,75 42,76 C 31,77 21,70 17,60 C 14,48 16,36 24,26 C 33,16 46,15 56,19 C 66,24 70,35 70,50 L 70,82 C 70,86 77,86 78,82 Z\" fill=\"url(#chameleonTailGrad)\" stroke=\"url(#chameleonTailStrokeGrad)\" stroke-width=\"1.2\" stroke-linejoin=\"round\" filter=\"url(#chameleonTailGlow)\"/></svg>")

(df logo [] -> Str
  :d "Standard Logo Component alias for ChameleonALogo"
  (chameleon-a-logo))

(df chameleon-schematic [] -> Str
  :d "Refined Schematic Chameleon Full Vector Mascot & Blueprint Mark"
  "<svg viewBox=\"0 0 120 140\" class=\"w-48 h-48\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Schematic Chameleon\"><defs><linearGradient id=\"chameleonLineGrad\" x1=\"20%\" y1=\"0%\" x2=\"80%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#d8b4fe\"/><stop offset=\"50%\" stop-color=\"#c084fc\"/><stop offset=\"100%\" stop-color=\"#818cf8\"/></linearGradient><filter id=\"chameleonAmbientGlow\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\"><feGaussianBlur stdDeviation=\"3\" result=\"glow\"/><feComposite in=\"SourceGraphic\" in2=\"glow\" operator=\"over\"/></filter></defs><g><path d=\"M 52 14 C 62 16, 78 26, 84 38 C 88 47, 85 54, 76 56 C 66 58, 54 54, 48 46\" stroke=\"url(#chameleonLineGrad)\" stroke-width=\"2.0\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M 52 14 C 44 14, 38 22, 42 30 C 30 36, 16 52, 14 74 C 11 98, 22 118, 42 124 C 62 130, 80 118, 78 96 C 75 80, 58 74, 46 84 C 38 92, 44 104, 54 102 C 60 100, 60 92, 54 90 C 50 89, 47 92, 49 95\" stroke=\"url(#chameleonLineGrad)\" stroke-width=\"2.0\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"72\" cy=\"40\" r=\"11\" stroke=\"url(#chameleonLineGrad)\" stroke-width=\"2.0\"/><circle cx=\"72\" cy=\"40\" r=\"4.5\" stroke=\"url(#chameleonLineGrad)\" stroke-width=\"1.8\" fill=\"rgba(216, 180, 254, 0.25)\"/><path d=\"M 48 46 C 56 52, 60 62, 54 72 C 48 80, 38 82, 34 88\" stroke=\"url(#chameleonLineGrad)\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><circle cx=\"52\" cy=\"14\" r=\"1.5\" fill=\"#d8b4fe\" opacity=\"0.8\"/><circle cx=\"84\" cy=\"38\" r=\"1.5\" fill=\"#d8b4fe\" opacity=\"0.8\"/><circle cx=\"42\" cy=\"124\" r=\"1.5\" fill=\"#d8b4fe\" opacity=\"0.8\"/></g></svg>")

(df chameleon-watermark [] -> Str
  :d "Large Ambient Blueprint Watermark for Hero Background"
  "<div class=\"relative w-96 h-96 opacity-20 pointer-events-none select-none\"><svg viewBox=\"0 0 120 140\" class=\"w-full h-full\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Schematic Chameleon Watermark\"><defs><linearGradient id=\"chameleonLineGradWatermark\" x1=\"20%\" y1=\"0%\" x2=\"80%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#d8b4fe\"/><stop offset=\"50%\" stop-color=\"#c084fc\"/><stop offset=\"100%\" stop-color=\"#818cf8\"/></linearGradient></defs><g><path d=\"M 52 14 C 62 16, 78 26, 84 38 C 88 47, 85 54, 76 56 C 66 58, 54 54, 48 46\" stroke=\"url(#chameleonLineGradWatermark)\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M 52 14 C 44 14, 38 22, 42 30 C 30 36, 16 52, 14 74 C 11 98, 22 118, 42 124 C 62 130, 80 118, 78 96 C 75 80, 58 74, 46 84 C 38 92, 44 104, 54 102 C 60 100, 60 92, 54 90 C 50 89, 47 92, 49 95\" stroke=\"url(#chameleonLineGradWatermark)\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"72\" cy=\"40\" r=\"11\" stroke=\"url(#chameleonLineGradWatermark)\" stroke-width=\"1.8\"/><circle cx=\"72\" cy=\"40\" r=\"4.5\" stroke=\"url(#chameleonLineGradWatermark)\" stroke-width=\"1.6\" fill=\"rgba(216, 180, 254, 0.25)\"/><path d=\"M 48 46 C 56 52, 60 62, 54 72 C 48 80, 38 82, 34 88\" stroke=\"url(#chameleonLineGradWatermark)\" stroke-width=\"1.4\" stroke-linecap=\"round\"/><circle cx=\"52\" cy=\"14\" r=\"1.5\" fill=\"#d8b4fe\" opacity=\"0.8\"/><circle cx=\"84\" cy=\"38\" r=\"1.5\" fill=\"#d8b4fe\" opacity=\"0.8\"/><circle cx=\"42\" cy=\"124\" r=\"1.5\" fill=\"#d8b4fe\" opacity=\"0.8\"/></g></svg></div>")

(df emblem [] -> Str
  :d "High-Density Brand Emblem / Visual Seal"
  (s/concat "<div class=\"relative flex items-center justify-center w-24 h-24\"><div class=\"absolute inset-0 rounded-full bg-signal/15 blur-xl\"></div><div class=\"w-full h-full relative z-10\">" (s/concat (chameleon-a-logo) "</div></div>")))

(df wordmark [] -> Str
  :d "Brand Wordmark with Logo and Clean Typography"
  (s/concat "<span class=\"inline-flex items-center gap-2.5\"><span class=\"w-7 h-7 text-signal shrink-0\">" (s/concat (chameleon-a-logo) "</span><span class=\"font-sans font-semibold tracking-tight text-ink text-brand text-lg\">aslang<span class=\"text-signal\">.dev</span></span></span>")))
