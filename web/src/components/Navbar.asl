(module asl-web/navbar
  :d "Declarative Floating Navbar Toolbar Component in pure AgentScript"
  :x [render-navbar navbar-view navbar]
  :i [(core/strings :a s)
      (components/ui/Logo :a logo)
      (components/ThemeToggle :a theme)])

(df render-navbar [] -> Str
  :d "Renders the complete floating navigation bar with Logo, links, search, GitHub and ThemeToggle"
  "<div class=\"fixed top-2 sm:top-3 left-0 right-0 z-50 flex justify-center px-2 sm:px-4 pointer-events-none w-full max-w-[100vw]\"><div class=\"relative pointer-events-auto max-w-6xl w-full\"><header class=\"relative z-10 w-full rounded-full border border-line/80 bg-surface/90 backdrop-blur-2xl px-2 xs:px-3 sm:px-4 h-12 sm:h-14 flex items-center justify-between shadow-e2 transition-all\"><a href=\"/\" class=\"rounded-full shrink-0 flex items-center gap-1.5 sm:gap-2 pr-1 sm:pr-2 group\" title=\"aslang.dev home\"><svg viewBox=\"0 0 100 100\" class=\"w-6 h-6 sm:w-7 sm:h-7 text-signal shrink-0 group-hover:scale-105 transition-transform\" role=\"img\" aria-label=\"ASL Logo\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><defs><linearGradient id=\"chameleonTailGradNav\" x1=\"15%\" y1=\"10%\" x2=\"85%\" y2=\"90%\"><stop offset=\"0%\" stop-color=\"#d8b4fe\"/><stop offset=\"35%\" stop-color=\"#c084fc\"/><stop offset=\"70%\" stop-color=\"#a855f7\"/><stop offset=\"100%\" stop-color=\"#7c3aed\"/></linearGradient></defs><path d=\"M 78,82 C 83,72 84,48 81,32 C 77,16 64,8 46,8 C 26,8 13,19 8,36 C 4,52 7,72 18,84 C 28,94 44,95 56,88 C 64,82 68,70 67,58 C 66,44 57,35 44,35 C 32,35 25,44 25,54 C 25,62 31,67 38,67 C 43,67 46,63 46,58 C 46,53 41,52 38,55 C 36,57 34,55 34,52 C 34,46 40,41 46,41 C 53,41 57,48 57,57 C 57,67 50,75 42,76 C 31,77 21,70 17,60 C 14,48 16,36 24,26 C 33,16 46,15 56,19 C 66,24 70,35 70,50 L 70,82 C 70,86 77,86 78,82 Z\" fill=\"url(#chameleonTailGradNav)\" stroke=\"#d8b4fe\" stroke-width=\"1.2\"/></svg><span class=\"font-sans font-bold tracking-tight text-ink text-sm sm:text-base hidden min-[360px]:inline\">asl<span class=\"hidden xs:inline\">ang<span class=\"text-signal\">.dev</span></span></span></a><nav aria-label=\"Main Navigation\" class=\"flex items-center gap-0.5 xs:gap-1 sm:gap-1.5 shrink-0\"><a href=\"/\" class=\"p-1.5 xs:p-2 nav:px-3.5 nav:py-1.5 rounded-full font-mono text-meta text-ink-2 hover:text-ink hover:bg-inset transition-colors flex items-center gap-1.5 shrink-0\" title=\"Home\"><svg class=\"w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0 text-current\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg><span class=\"hidden nav:inline\">Home</span></a><a href=\"/roadmap\" class=\"p-1.5 xs:p-2 nav:px-3.5 nav:py-1.5 rounded-full font-mono text-meta text-ink-2 hover:text-ink hover:bg-inset transition-colors flex items-center gap-1.5 shrink-0\" title=\"Roadmap\"><svg class=\"w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0 text-current\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M18 6H5a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h13l4-3.5L18 6zM12 13v8\"/></svg><span class=\"hidden nav:inline\">Roadmap</span></a><a href=\"/docs\" class=\"p-1.5 xs:p-2 nav:px-3.5 nav:py-1.5 rounded-full font-mono text-meta text-ink-2 hover:text-ink hover:bg-inset transition-colors flex items-center gap-1.5 shrink-0\" title=\"Docs\"><svg class=\"w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0 text-current\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2zM22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\"/></svg><span class=\"hidden nav:inline\">Docs</span></a><a href=\"/blog\" class=\"p-1.5 xs:p-2 nav:px-3.5 nav:py-1.5 rounded-full font-mono text-meta text-ink-2 hover:text-ink hover:bg-inset transition-colors flex items-center gap-1.5 shrink-0\" title=\"Blog\"><svg class=\"w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0 text-current\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2M18 14h-8M15 18h-5M10 6h8v4h-8z\"/></svg><span class=\"hidden nav:inline\">Blog</span></a></nav><div class=\"flex items-center gap-1 sm:gap-2 shrink-0\"><button type=\"button\" onclick=\"window.dispatchEvent(new CustomEvent('open-search'))\" class=\"flex items-center gap-1.5 p-1.5 xs:p-2 min-[1100px]:px-3 min-[1100px]:py-1.5 rounded-full border border-line bg-inset/80 hover:bg-inset text-ink-3 hover:text-ink font-mono text-micro transition-all shadow-sm shrink-0 cursor-pointer\" aria-label=\"Search documentation\" title=\"Search documentation (⌘K)\"><svg class=\"w-3.5 h-3.5 text-signal shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"8\" stroke-width=\"2\"/><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"m21 21-4.3-4.3\"/></svg><span class=\"hidden min-[1100px]:inline\">Search</span><kbd class=\"hidden min-[1100px]:inline-block px-1.5 py-0.5 rounded bg-surface border border-line font-mono text-[9px] text-ink-3\">⌘K</kbd></button><a href=\"/llms.txt\" target=\"_blank\" rel=\"noreferrer\" class=\"hidden min-[1200px]:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-signal/30 bg-signal/10 hover:bg-signal/20 text-signal font-mono text-micro font-medium transition-colors shrink-0\" title=\"Raw model specification (/llms.txt)\"><svg class=\"w-3 h-3 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z\"/></svg><span>llms.txt</span></a><a href=\"https://github.com/genseam/asl\" target=\"_blank\" rel=\"noreferrer\" class=\"hidden sm:flex items-center gap-1.5 p-2 nav:px-3 nav:py-1.5 rounded-full border border-line bg-surface hover:bg-inset text-ink font-mono text-meta font-medium shadow-sm transition-all shrink-0\" aria-label=\"GitHub Repository\" title=\"GitHub Repository\"><svg class=\"w-4 h-4 fill-current text-ink shrink-0\" viewBox=\"0 0 24 24\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z\"/></svg><span class=\"hidden nav:inline\">GitHub</span></a><button type=\"button\" onclick=\"(function(){var d=document.documentElement;var isDark=d.classList.contains('dark');if(isDark){d.classList.remove('dark');d.classList.add('light');localStorage.setItem('asl-theme','light');}else{d.classList.remove('light');d.classList.add('dark');localStorage.setItem('asl-theme','dark');}})()\" class=\"w-9 h-9 rounded-full border border-line text-ink-2 hover:text-ink hover:border-line-strong transition-colors flex items-center justify-center cursor-pointer\" title=\"Toggle theme\" aria-label=\"Toggle theme\"><svg class=\"w-4 h-4 dark:hidden\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"4\" stroke-width=\"2\"/><path d=\"M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg><svg class=\"w-4 h-4 hidden dark:block\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></div></header></div></div>")

(df navbar-view [] -> Str
  :d "Alias for render-navbar"
  (render-navbar))

(df navbar [] -> Str
  :d "Navbar component alias"
  (render-navbar))
