      <line x1=\"26\" y1=\"21\" x2=\"40\" y2=\"38\" stroke-width=\"1.3\" />
      <ellipse cx=\"40\" cy=\"38\" rx=\"3.5\" ry=\"1.2\" stroke-width=\"1.1\" />
      <g font-family=\"monospace\" font-size=\"6.5\" fill=\"currentColor\" opacity=\"0.6\" transform=\"rotate(-16)\">
