    </g>

    <g transform=\"translate(45, 480) rotate(-30)\" stroke=\"url(#rightBioGrad)\" stroke-width=\"1.0\" opacity=\"0.65\">
      <circle cx=\"0\" cy=\"0\" r=\"22\" />
      <circle cx=\"0\" cy=\"0\" r=\"11\" stroke-dasharray=\"2 2\" />
      <circle cx=\"0\" cy=\"0\" r=\"3\" fill=\"currentColor\" />
