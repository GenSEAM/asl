(module aslWeb/CosmicLandscapeBackground
  :d "Full-Document Cyclic Scattered & Tilted Aerospace Blueprint Background in pure ASL."
  :x [renderBlueprintGrid renderChameleonPerch renderLeftDeflectingStream renderRightCyclicStream renderCosmicBackground cosmicLandscapeBackground]
  :i [(asl-text/string :a s)])

(df renderBlueprintGrid ()
  :d "Fixed technical blueprint grid pattern."
  "<svg aria-hidden=\"true\" class=\"w-full h-full opacity-25 dark:opacity-20 text-line/40 dark:text-line/20\" xmlns=\"http://www.w3.org/2000/svg\"><defs><pattern id=\"fixedBlueprintGrid\" width=\"40\" height=\"40\" patternUnits=\"userSpaceOnUse\"><path d=\"M 40 0 L 0 0 0 40\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.5\" opacity=\"0.4\" /><path d=\"M 200 0 L 0 0 0 200\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.0\" opacity=\"0.6\" /></pattern></defs><rect width=\"100%\" height=\"100%\" fill=\"url(#fixedBlueprintGrid)\" /></svg>")

(df renderChameleonPerch ()
  :d "Top-left canonical chameleon mascot perched on cyber-vine linking to active development."
