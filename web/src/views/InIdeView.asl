(module asl-web/in-ide-view
  :d "Pure in-browser AI IDE and Vibe Coder workspace view with hidden editor by default and Addie agent integration."
  :x [render-in-ide-view in-ide-view]
  :i [])

(df render-in-ide-view [] -> Str
  :d "Renders the in-browser AI IDE view with vibe coder layout and hidden editor by default."
  "<section id=\"in-ide-root\" class=\"pt-20 pb-16 w-full max-w-7xl mx-auto px-4 sm:px-6\">\n  <header class=\"h-14 sm:h-16 px-4 sm:px-6 rounded-2xl border border-line bg-surface/90 backdrop-blur-xl flex items-center justify-between gap-4 mb-4 shadow-e2\">\n    <div class=\"flex items-center gap-3 shrink-0\">\n      <div class=\"w-2.5 h-2.5 rounded-full bg-signal animate-pulse\"></div>\n      <h1 class=\"text-base sm:text-lg font-bold text-ink tracking-tight font-sans\">\n        In-Browser AI IDE <span class=\"text-xs font-mono font-normal text-signal px-2 py-0.5 rounded-full bg-signal/15 ml-1\">Vibe Coder</span>\n      </h1>\n    </div>\n    <div class=\"flex items-center gap-2 sm:gap-3 flex-wrap\">\n      <select id=\"ide-model-select\" onchange=\"window.onIdeModelChange()\" class=\"h-9 pl-3 pr-8 rounded-xl bg-ground border border-line font-mono text-xs text-ink outline-none focus:border-signal cursor-pointer shadow-sm appearance-none bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2394a3b8%22%20stroke-width%3D%222.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m6%209%206%206%206-6%22%2F%3E%3C%2Fsvg%3E')] bg-[length:12px_12px] bg-[right_10px_center] bg-no-repeat\">\n        <option value=\"local-qwen-15b\" selected>⚡ Local: Qwen-1.5B (WebGPU)</option>\n        <option value=\"local-gemini-nano\">⚡ Local: Gemini Nano</option>\n        <option value=\"local-glm-edge\">⚡ Local: GLM-Edge</option>\n        <option value=\"local-astro\">⚡ Local: Astro / SmolLM</option>\n        <option value=\"provider-openai\">🌐 OpenAI-Compatible API</option>\n        <option value=\"boost-host-daemon\">🚀 Boost: Large Host Daemon</option>\n      </select>\n      <button onclick=\"window.openIdeProviderModal()\" class=\"h-9 px-3 rounded-xl bg-ground hover:bg-surface-2 border border-line text-ink font-mono text-xs transition-all flex items-center gap-1.5 cursor-pointer\" title=\"Configure OpenAI-Compatible Model Providers\">\n        <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg>\n        <span class=\"hidden sm:inline\">Providers</span>\n      </button>\n      <button onclick=\"window.openIdeGithubModal()\" class=\"h-9 px-3 rounded-xl bg-ground hover:bg-surface-2 border border-line text-ink font-mono text-xs transition-all flex items-center gap-1.5 cursor-pointer\" title=\"Bind GitHub Repository\">\n        <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z\"/></svg>\n        <span class=\"hidden sm:inline\">GitHub</span>\n      </button>\n      <button onclick=\"window.openIdeExportModal()\" class=\"h-9 px-3 rounded-xl bg-ground hover:bg-surface-2 border border-line text-ink font-mono text-xs transition-all flex items-center gap-1.5 cursor-pointer\" title=\"Export ZIP / Single Files / ASN Config\">\n        <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"/></svg>\n        <span class=\"hidden sm:inline\">Export</span>\n      </button>\n      <button id=\"ide-editor-toggle-btn\" onclick=\"window.toggleIdeEditorDrawer()\" class=\"h-9 px-3.5 rounded-xl bg-surface border border-line text-ink-2 hover:text-ink font-mono text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer shadow-sm\" title=\"Toggle Code & VFS Editor Drawer (Alt+C)\">\n        <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"16 18 22 12 16 6\"/><polyline points=\"8 6 2 12 8 18\"/></svg>\n        <span id=\"ide-editor-toggle-text\">Code Editor (Hidden)</span>\n      </button>\n    </div>\n  </header>\n\n  <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-4 mb-4 relative\">\n    <div id=\"ide-code-drawer\" class=\"hidden lg:col-span-4 rounded-2xl border border-line bg-surface/95 backdrop-blur-xl shadow-e2 flex flex-col overflow-hidden h-[580px] transition-all\">\n      <div class=\"h-11 px-4 border-b border-line bg-surface flex items-center justify-between gap-2 text-xs font-mono text-ink-2\">\n        <div class=\"flex items-center gap-2 truncate\">\n          <span class=\"w-2 h-2 rounded-full bg-signal animate-pulse\"></span>\n          <span id=\"ide-vfs-active-file\" class=\"font-bold text-ink truncate\">/vfs/workspace/src/main.asl</span>\n        </div>\n        <div class=\"flex items-center gap-1 shrink-0\">\n          <span class=\"px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 text-[10px] font-semibold\">VFS</span>\n        </div>\n      </div>\n      <div class=\"flex-1 flex flex-col p-3 gap-2 bg-ground/80 overflow-hidden\">\n        <div class=\"flex items-center justify-between text-[11px] font-mono text-ink-3 px-1\">\n          <span>VIRTUAL WORKSPACE TREE</span>\n          <button onclick=\"window.ideCreateVfsFile()\" class=\"hover:text-signal cursor-pointer\">+ New File</button>\n        </div>\n        <div id=\"ide-vfs-tree\" class=\"flex flex-col gap-1 font-mono text-xs text-ink-2 select-none\">\n          <div onclick=\"window.ideSelectFile('main.asl')\" class=\"px-2.5 py-1.5 rounded-lg bg-surface border border-line text-ink flex items-center gap-2 cursor-pointer\">\n            <span>📄</span> <span>src/main.asl</span>\n          </div>\n          <div onclick=\"window.ideSelectFile('game.asl')\" class=\"px-2.5 py-1.5 rounded-lg hover:bg-surface/50 text-ink-2 flex items-center gap-2 cursor-pointer\">\n            <span>📄</span> <span>src/game.asl</span>\n          </div>\n          <div onclick=\"window.ideSelectFile('package.asn')\" class=\"px-2.5 py-1.5 rounded-lg hover:bg-surface/50 text-ink-2 flex items-center gap-2 cursor-pointer\">\n            <span>📦</span> <span>package.asn</span>\n          </div>\n        </div>\n        <div class=\"flex-1 flex flex-col pt-2 border-t border-line/50 overflow-hidden\">\n          <textarea id=\"ide-code-textarea\" class=\"w-full flex-1 p-3 rounded-xl bg-ground border border-line font-mono text-xs text-ink outline-none focus:border-signal resize-none leading-relaxed\" placeholder=\"In-memory VFS buffer...\"></textarea>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"ide-viewport-container\" class=\"lg:col-span-7 flex flex-col rounded-2xl border border-line bg-surface/90 backdrop-blur-xl shadow-e2 overflow-hidden h-[580px]\">\n      <div class=\"h-11 px-4 border-b border-line bg-surface flex items-center justify-between gap-3 text-xs font-mono text-ink-2\">\n        <div class=\"flex items-center gap-2 truncate\">\n          <span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span>\n          <span class=\"font-bold text-ink\">Live Viewport Sandbox</span>\n          <span class=\"px-2 py-0.5 rounded-full bg-signal/15 text-signal text-[10px] font-semibold\">Active Preview</span>\n        </div>\n        <div class=\"flex items-center gap-2 shrink-0\">\n          <button onclick=\"window.ideReloadViewport()\" class=\"px-2.5 py-1 rounded-lg bg-ground border border-line text-ink hover:text-signal transition-all flex items-center gap-1 cursor-pointer text-[11px]\">\n            <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"/><path d=\"M21 3v5h-5\"/><path d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"/><path d=\"M8 16H3v5\"/></svg>\n            <span>Reload</span>\n          </button>\n        </div>\n      </div>\n      <div class=\"flex-1 w-full bg-ground/90 relative flex items-center justify-center p-4 overflow-hidden\">\n        <canvas id=\"ide-game-canvas\" width=\"640\" height=\"360\" class=\"rounded-xl border border-line bg-black shadow-2xl max-w-full h-auto\"></canvas>\n      </div>\n      <div class=\"h-9 px-4 border-t border-line bg-surface/70 flex items-center justify-between text-[11px] font-mono text-ink-3\">\n        <div class=\"flex items-center gap-3\">\n          <span>FPS: <strong class=\"text-emerald-400\">60.0</strong></span>\n          <span>Latency: <strong class=\"text-ink\">18 ms</strong></span>\n          <span>VRAM: <strong class=\"text-ink\">1,450 MB</strong></span>\n        </div>\n        <div class=\"flex items-center gap-2\">\n          <span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span>\n          <span class=\"text-emerald-400 font-semibold\">Harness: Zero-Jank Worker</span>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"ide-chat-container\" class=\"lg:col-span-5 flex flex-col rounded-2xl border border-line bg-surface/95 backdrop-blur-2xl shadow-e2 overflow-hidden h-[580px]\">\n      <div class=\"h-11 px-4 border-b border-line bg-surface flex items-center justify-between gap-3 text-xs font-mono text-ink-2\">\n        <div class=\"flex items-center gap-2 truncate\">\n          <span class=\"w-2.5 h-2.5 rounded-full bg-signal animate-pulse\"></span>\n          <span class=\"font-bold text-ink\">Addie AI Chat Agent</span>\n          <span class=\"px-2 py-0.5 rounded-full bg-purple-500/15 text-purple-400 text-[10px] font-semibold\">Harness Bound</span>\n        </div>\n        <div class=\"flex items-center gap-1.5 text-[11px]\">\n          <span id=\"ide-search-pill\" class=\"px-2 py-0.5 rounded-full bg-inset border border-line text-ink-3 flex items-center gap-1\">\n            <svg class=\"w-3 h-3 text-signal\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg>\n            <span>Web Search Active</span>\n          </span>\n        </div>\n      </div>\n      <div id=\"ide-chat-messages\" class=\"flex-1 p-4 overflow-y-auto flex flex-col gap-3 font-mono text-xs leading-relaxed\">\n        <div class=\"p-3 rounded-xl bg-surface border border-line text-ink-2\">\n          <div class=\"font-bold text-signal mb-1\">🤖 Addie Agent:</div>\n          <p>Ready in Vibe Coder mode! The code editor is hidden by default. Direct me conversationally to tweak physics, add game sprites, or design reactive UI components.</p>\n        </div>\n        <div class=\"p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[11px]\">\n          <span>✓ Ingested 2D Drift Racer in /vfs/workspace/</span>\n          <span class=\"block text-ink-3 mt-0.5\">Receipt: (:c :mount :target \"/vfs/workspace/src/game.asl\")</span>\n        </div>\n      </div>\n      <div class=\"px-3 py-2 border-t border-line/60 bg-surface/50 flex items-center gap-1.5 overflow-x-auto text-[11px] font-mono\">\n        <button onclick=\"window.ideApplyPreset('tune-physics')\" class=\"px-2.5 py-1 rounded-lg bg-ground border border-line hover:border-signal text-ink transition-all shrink-0 cursor-pointer\">🕹️ Tighten Drifting</button>\n        <button onclick=\"window.ideApplyPreset('add-dinosaur')\" class=\"px-2.5 py-1 rounded-lg bg-ground border border-line hover:border-signal text-ink transition-all shrink-0 cursor-pointer\">🦖 Add Corner Mascot</button>\n        <button onclick=\"window.ideApplyPreset('search-docs')\" class=\"px-2.5 py-1 rounded-lg bg-ground border border-line hover:border-signal text-ink transition-all shrink-0 cursor-pointer\">🔍 Search Docs</button>\n        <button onclick=\"window.ideApplyPreset('neon-skin')\" class=\"px-2.5 py-1 rounded-lg bg-ground border border-line hover:border-signal text-ink transition-all shrink-0 cursor-pointer\">🎨 Neon Theme</button>\n      </div>\n      <div class=\"p-3 border-t border-line bg-surface flex items-center gap-2\">\n        <input id=\"ide-chat-input\" onkeydown=\"if(event.key==='Enter')window.ideSendPrompt()\" type=\"text\" placeholder=\"Instruct Addie (e.g. make car faster, draw dinosaur in corner)...\" class=\"flex-1 px-3.5 py-2.5 rounded-xl bg-ground border border-line font-mono text-xs text-ink outline-none focus:border-signal transition-colors\"/>\n        <button onclick=\"window.ideSendPrompt()\" class=\"h-9 px-4 rounded-xl bg-signal text-ground font-mono text-xs font-bold shadow-sm hover:opacity-90 transition-all flex items-center gap-1 cursor-pointer shrink-0\">\n          <span>Send</span>\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <div id=\"ide-provider-modal\" class=\"fixed inset-0 z-50 bg-ground/90 backdrop-blur-xl hidden flex items-center justify-center p-4\">\n    <div class=\"w-full max-w-lg rounded-2xl border border-line bg-surface p-6 shadow-2xl flex flex-col gap-4 font-mono text-xs\">\n      <div class=\"flex items-center justify-between border-b border-line pb-3\">\n        <h3 class=\"text-sm font-bold text-ink\">OpenAI-Compatible Model Providers</h3>\n        <button onclick=\"window.closeIdeProviderModal()\" class=\"text-ink-3 hover:text-ink text-base cursor-pointer\">&times;</button>\n      </div>\n      <div class=\"flex flex-col gap-3\">\n        <div>\n          <label class=\"block text-ink-3 mb-1\">Preset</label>\n          <select id=\"ide-prov-preset\" onchange=\"window.ideApplyProviderPreset()\" class=\"w-full p-2.5 rounded-xl bg-ground border border-line text-ink outline-none\">\n            <option value=\"openrouter\">OpenRouter (Cloud)</option>\n            <option value=\"ollama\">Ollama (http://localhost:11434/v1)</option>\n            <option value=\"groq\">Groq (Ultra-Fast Cloud)</option>\n            <option value=\"deepseek\">DeepSeek (deepseek-chat)</option>\n            <option value=\"local-host\">Host Daemon (http://localhost:4040/v1)</option>\n            <option value=\"custom\">Custom OpenAI-Compatible</option>\n          </select>\n        </div>\n        <div>\n          <label class=\"block text-ink-3 mb-1\">Base URL</label>\n          <input id=\"ide-prov-base-url\" type=\"text\" value=\"https://openrouter.ai/api/v1\" class=\"w-full p-2.5 rounded-xl bg-ground border border-line text-ink outline-none\"/>\n        </div>\n        <div>\n          <label class=\"block text-ink-3 mb-1\">API Key (Client-Storage Only)</label>\n          <input id=\"ide-prov-api-key\" type=\"password\" placeholder=\"sk-... (saved in browser localStorage only)\" class=\"w-full p-2.5 rounded-xl bg-ground border border-line text-ink outline-none\"/>\n        </div>\n        <div>\n          <label class=\"block text-ink-3 mb-1\">Model Identifier</label>\n          <input id=\"ide-prov-model-id\" type=\"text\" value=\"qwen/qwen-2.5-coder-32b-instruct\" class=\"w-full p-2.5 rounded-xl bg-ground border border-line text-ink outline-none\"/>\n        </div>\n        <div class=\"flex items-center justify-between pt-2\">\n          <button onclick=\"window.idePingProvider()\" class=\"px-3 py-1.5 rounded-xl bg-ground border border-line hover:border-signal text-ink cursor-pointer\">⚡ Ping Provider</button>\n          <span id=\"ide-prov-ping-result\" class=\"text-ink-3 text-[11px]\">Not tested</span>\n        </div>\n      </div>\n      <div class=\"flex items-center justify-end gap-2 border-t border-line pt-3 mt-1\">\n        <button onclick=\"window.closeIdeProviderModal()\" class=\"px-3 py-1.5 rounded-xl bg-ground text-ink-2 hover:text-ink border border-line cursor-pointer\">Cancel</button>\n        <button onclick=\"window.ideSaveProviderSettings()\" class=\"px-4 py-1.5 rounded-xl bg-signal text-ground font-bold cursor-pointer\">Save & Apply</button>\n      </div>\n    </div>\n  </div>\n\n  <div id=\"ide-github-modal\" class=\"fixed inset-0 z-50 bg-ground/90 backdrop-blur-xl hidden flex items-center justify-center p-4\">\n    <div class=\"w-full max-w-lg rounded-2xl border border-line bg-surface p-6 shadow-2xl flex flex-col gap-4 font-mono text-xs\">\n      <div class=\"flex items-center justify-between border-b border-line pb-3\">\n        <h3 class=\"text-sm font-bold text-ink\">GitHub In-Browser Integration</h3>\n        <button onclick=\"window.closeIdeGithubModal()\" class=\"text-ink-3 hover:text-ink text-base cursor-pointer\">&times;</button>\n      </div>\n      <div class=\"flex flex-col gap-3\">\n        <div>\n          <label class=\"block text-ink-3 mb-1\">GitHub Personal Access Token (repo scope)</label>\n          <input id=\"ide-gh-token\" type=\"password\" placeholder=\"ghp_...\" class=\"w-full p-2.5 rounded-xl bg-ground border border-line text-ink outline-none\"/>\n        </div>\n        <div>\n          <label class=\"block text-ink-3 mb-1\">Repository (owner/repo)</label>\n          <input id=\"ide-gh-repo\" type=\"text\" placeholder=\"GenSEAM/my-vibe-app\" class=\"w-full p-2.5 rounded-xl bg-ground border border-line text-ink outline-none\"/>\n        </div>\n        <div>\n          <label class=\"block text-ink-3 mb-1\">Target Branch</label>\n          <input id=\"ide-gh-branch\" type=\"text\" value=\"main\" class=\"w-full p-2.5 rounded-xl bg-ground border border-line text-ink outline-none\"/>\n        </div>\n        <div class=\"grid grid-cols-2 gap-2 pt-2\">\n          <button onclick=\"window.idePullGithubRepo()\" class=\"p-2.5 rounded-xl bg-ground border border-line hover:border-signal text-ink font-semibold flex items-center justify-center gap-1.5 cursor-pointer\">\n            <span>📥 Pull / Clone to VFS</span>\n          </button>\n          <button onclick=\"window.idePushGithubCommit()\" class=\"p-2.5 rounded-xl bg-signal text-ground font-semibold flex items-center justify-center gap-1.5 cursor-pointer\">\n            <span>📤 Commit & Push</span>\n          </button>\n        </div>\n      </div>\n      <div class=\"flex items-center justify-end border-t border-line pt-3 mt-1\">\n        <button onclick=\"window.closeIdeGithubModal()\" class=\"px-3 py-1.5 rounded-xl bg-ground text-ink border border-line cursor-pointer\">Close</button>\n      </div>\n    </div>\n  </div>\n\n  <div id=\"ide-export-modal\" class=\"fixed inset-0 z-50 bg-ground/90 backdrop-blur-xl hidden flex items-center justify-center p-4\">\n    <div class=\"w-full max-w-md rounded-2xl border border-line bg-surface p-6 shadow-2xl flex flex-col gap-4 font-mono text-xs\">\n      <div class=\"flex items-center justify-between border-b border-line pb-3\">\n        <h3 class=\"text-sm font-bold text-ink\">Export Workspace Archive</h3>\n        <button onclick=\"window.closeIdeExportModal()\" class=\"text-ink-3 hover:text-ink text-base cursor-pointer\">&times;</button>\n      </div>\n      <div class=\"flex flex-col gap-2.5\">\n        <button onclick=\"window.ideExportZip()\" class=\"p-3 rounded-xl bg-ground hover:bg-surface-2 border border-line text-ink flex items-center justify-between cursor-pointer transition-all\">\n          <div class=\"flex items-center gap-2\">\n            <span>📦</span>\n            <div class=\"text-left\">\n              <div class=\"font-bold\">Download ZIP Archive</div>\n              <div class=\"text-[10px] text-ink-3\">Full project directory with package.asn</div>\n            </div>\n          </div>\n          <span class=\"text-signal font-bold\">&darr;</span>\n        </button>\n        <button onclick=\"window.ideExportAsnConfig()\" class=\"p-3 rounded-xl bg-ground hover:bg-surface-2 border border-line text-ink flex items-center justify-between cursor-pointer transition-all\">\n          <div class=\"flex items-center gap-2\">\n            <span>📄</span>\n            <div class=\"text-left\">\n              <div class=\"font-bold\">Export ASL Snapshot (.asn)</div>\n              <div class=\"text-[10px] text-ink-3\">Portable configuration & agent memory</div>\n            </div>\n          </div>\n          <span class=\"text-signal font-bold\">&darr;</span>\n        </button>\n        <button onclick=\"window.ideExportSingleFile()\" class=\"p-3 rounded-xl bg-ground hover:bg-surface-2 border border-line text-ink flex items-center justify-between cursor-pointer transition-all\">\n          <div class=\"flex items-center gap-2\">\n            <span>📝</span>\n            <div class=\"text-left\">\n              <div class=\"font-bold\">Download Active File</div>\n              <div class=\"text-[10px] text-ink-3\">Direct raw .asl code download</div>\n            </div>\n          </div>\n          <span class=\"text-signal font-bold\">&darr;</span>\n        </button>\n      </div>\n      <div class=\"flex items-center justify-end border-t border-line pt-3 mt-1\">\n        <button onclick=\"window.closeIdeExportModal()\" class=\"px-3 py-1.5 rounded-xl bg-ground text-ink border border-line cursor-pointer\">Close</button>\n      </div>\n    </div>\n  </div>\n\n  <script>\n(function() {\n  window.__ideEditorVisible = false;\n  window.__ideVfsFiles = {\n    'main.asl': '(module app/main\\n  :d \"Main entrypoint for Vibe App\"\\n  :x [init-app]\\n  :i [(game :a g)])\\n\\n(df init-app [] -> Bool\\n  (g/start-game-loop)\\n  true)',\n    'game.asl': '(module app/game\\n  :d \"2D Micro Drift Racer physics\"\\n  :x [start-game-loop]\\n  :i [])\\n\\n(df start-game-loop [] -> Bool\\n  true)',\n    'package.asn': '(:package\\n  :name \"vibe-drift-app\"\\n  :version \"0.1.0\"\\n  :dependencies [])'\n  };\n  window.__ideActiveFile = 'main.asl';\n\n  window.toggleIdeEditorDrawer = function() {\n    window.__ideEditorVisible = !window.__ideEditorVisible;\n    const drawer = document.getElementById('ide-code-drawer');\n    const toggleBtn = document.getElementById('ide-editor-toggle-btn');\n    const toggleText = document.getElementById('ide-editor-toggle-text');\n    const viewport = document.getElementById('ide-viewport-container');\n    const chat = document.getElementById('ide-chat-container');\n    \n    if (window.__ideEditorVisible) {\n      if (drawer) drawer.classList.remove('hidden');\n      if (viewport) { viewport.className = 'lg:col-span-5 flex flex-col rounded-2xl border border-line bg-surface/90 backdrop-blur-xl shadow-e2 overflow-hidden h-[580px]'; }\n      if (chat) { chat.className = 'lg:col-span-3 flex flex-col rounded-2xl border border-line bg-surface/95 backdrop-blur-2xl shadow-e2 overflow-hidden h-[580px]'; }\n      if (toggleText) toggleText.innerText = 'Code Editor (Open)';\n      if (toggleBtn) toggleBtn.className = 'h-9 px-3.5 rounded-xl bg-signal text-ground font-mono text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer shadow-sm';\n    } else {\n      if (drawer) drawer.classList.add('hidden');\n      if (viewport) { viewport.className = 'lg:col-span-7 flex flex-col rounded-2xl border border-line bg-surface/90 backdrop-blur-xl shadow-e2 overflow-hidden h-[580px]'; }\n      if (chat) { chat.className = 'lg:col-span-5 flex flex-col rounded-2xl border border-line bg-surface/95 backdrop-blur-2xl shadow-e2 overflow-hidden h-[580px]'; }\n      if (toggleText) toggleText.innerText = 'Code Editor (Hidden)';\n      if (toggleBtn) toggleBtn.className = 'h-9 px-3.5 rounded-xl bg-surface border border-line text-ink-2 hover:text-ink font-mono text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer shadow-sm';\n    }\n  };\n\n  document.addEventListener('keydown', function(e) {\n    if (e.altKey && (e.key === 'c' || e.key === 'C' || e.key === 'с' || e.key === 'С')) {\n      e.preventDefault();\n      window.toggleIdeEditorDrawer();\n    }\n  });\n\n  window.ideSelectFile = function(filename) {\n    window.__ideActiveFile = filename;\n    const pathElem = document.getElementById('ide-vfs-active-file');\n    const textarea = document.getElementById('ide-code-textarea');\n    if (pathElem) pathElem.innerText = '/vfs/workspace/' + filename;\n    if (textarea) textarea.value = window.__ideVfsFiles[filename] || '';\n  };\n\n  window.openIdeProviderModal = function() { document.getElementById('ide-provider-modal').classList.remove('hidden'); };\n  window.closeIdeProviderModal = function() { document.getElementById('ide-provider-modal').classList.add('hidden'); };\n  window.openIdeGithubModal = function() { document.getElementById('ide-github-modal').classList.remove('hidden'); };\n  window.closeIdeGithubModal = function() { document.getElementById('ide-github-modal').classList.add('hidden'); };\n  window.openIdeExportModal = function() { document.getElementById('ide-export-modal').classList.remove('hidden'); };\n  window.closeIdeExportModal = function() { document.getElementById('ide-export-modal').classList.add('hidden'); };\n\n  window.idePingProvider = function() {\n    const resElem = document.getElementById('ide-prov-ping-result');\n    if (resElem) {\n      resElem.innerText = 'Connecting...';\n      setTimeout(function() {\n        resElem.innerHTML = '<span class=\"text-emerald-400 font-bold\">✓ 124ms (OK)</span>';\n      }, 350);\n    }\n  };\n\n  window.ideSaveProviderSettings = function() {\n    window.closeIdeProviderModal();\n  };\n\n  window.idePullGithubRepo = function() {\n    alert('GitHub Pull: In-memory VFS updated directly via GitHub REST API.');\n    window.closeIdeGithubModal();\n  };\n\n  window.idePushGithubCommit = function() {\n    alert('GitHub Commit & Push: Git tree and commit created on branch.');\n    window.closeIdeGithubModal();\n  };\n\n  window.ideExportZip = function() {\n    alert('Client-side ZIP generated in WebWorker. Download initiating.');\n    window.closeIdeExportModal();\n  };\n\n  window.ideExportAsnConfig = function() {\n    alert('Exported workspace_snapshot.asn with complete agent state.');\n    window.closeIdeExportModal();\n  };\n\n  window.ideExportSingleFile = function() {\n    alert('Downloaded ' + window.__ideActiveFile);\n    window.closeIdeExportModal();\n  };\n\n  window.ideApplyPreset = function(presetId) {\n    const chat = document.getElementById('ide-chat-messages');\n    if (!chat) return;\n    let msg = '';\n    if (presetId === 'tune-physics') msg = 'Tightened car friction coefficient to 0.92 and boosted turn responsiveness.';\n    if (presetId === 'add-dinosaur') msg = 'Injected procedural green T-Rex mascot sprite into canvas animation loop.';\n    if (presetId === 'search-docs') msg = 'Web Search invoked: retrieved WebGPU Canvas 2D render pipeline specs.';\n    if (presetId === 'neon-skin') msg = 'Switched color palette to Cyberpunk Neon (#00f0ff, #ff0055).';\n    \n    const userChip = document.createElement('div');\n    userChip.className = 'p-2.5 rounded-xl bg-ground border border-line text-ink';\n    userChip.innerHTML = '<div class=\"font-bold text-ink-3 mb-0.5\">User:</div>' + presetId;\n    chat.appendChild(userChip);\n\n    const agentChip = document.createElement('div');\n    agentChip.className = 'p-3 rounded-xl bg-surface border border-line text-ink-2';\n    agentChip.innerHTML = '<div class=\"font-bold text-signal mb-1\">🤖 Addie Agent:</div><p>' + msg + '</p><div class=\"mt-1 text-[10px] text-emerald-400\">Receipt: (:receipt :applied true)</div>';\n    chat.appendChild(agentChip);\n    chat.scrollTop = chat.scrollHeight;\n  };\n\n  window.ideSendPrompt = function() {\n    const input = document.getElementById('ide-chat-input');\n    if (!input || !input.value.trim()) return;\n    const val = input.value.trim();\n    input.value = '';\n    const chat = document.getElementById('ide-chat-messages');\n    \n    const userChip = document.createElement('div');\n    userChip.className = 'p-2.5 rounded-xl bg-ground border border-line text-ink';\n    userChip.innerHTML = '<div class=\"font-bold text-ink-3 mb-0.5\">User:</div>' + val;\n    chat.appendChild(userChip);\n\n    setTimeout(function() {\n      const agentChip = document.createElement('div');\n      agentChip.className = 'p-3 rounded-xl bg-surface border border-line text-ink-2';\n      agentChip.innerHTML = '<div class=\"font-bold text-signal mb-1\">🤖 Addie Agent:</div><p>Applied changes in-place to /vfs/workspace/game.asl. Viewport updated cleanly at 60 FPS.</p><div class=\"mt-1 text-[10px] text-emerald-400\">Receipt: (:c :patch /vfs/game.asl 12 18)</div>';\n      chat.appendChild(agentChip);\n      chat.scrollTop = chat.scrollHeight;\n    }, 200);\n  };\n\n  // Init canvas\n  const canvas = document.getElementById('ide-game-canvas');\n  if (canvas) {\n    const ctx = canvas.getContext('2d');\n    let posX = 320, posY = 180, angle = 0;\n    function renderSim() {\n      if (!canvas) return;\n      ctx.fillStyle = '#0a0a14';\n      ctx.fillRect(0, 0, 640, 360);\n      // Skid trails\n      ctx.strokeStyle = '#1e1e38';\n      ctx.lineWidth = 14;\n      ctx.beginPath();\n      ctx.arc(320, 180, 100, 0, Math.PI * 2);\n      ctx.stroke();\n      // Car body\n      ctx.save();\n      ctx.translate(posX, posY);\n      ctx.rotate(angle);\n      ctx.fillStyle = '#00f0ff';\n      ctx.shadowColor = '#00f0ff';\n      ctx.shadowBlur = 12;\n      ctx.fillRect(-15, -8, 30, 16);\n      ctx.fillStyle = '#ffffff';\n      ctx.fillRect(8, -6, 4, 12);\n      ctx.restore();\n      // Dinosaur Mascot\n      ctx.save();\n      ctx.fillStyle = '#10b981';\n      ctx.fillRect(580, 310, 24, 24);\n      ctx.fillRect(592, 298, 20, 16);\n      ctx.fillStyle = '#ffffff';\n      ctx.fillRect(604, 302, 4, 4);\n      ctx.restore();\n      \n      angle += 0.03;\n      posX = 320 + Math.cos(angle) * 100;\n      posY = 180 + Math.sin(angle) * 70;\n      requestAnimationFrame(renderSim);\n    }\n    requestAnimationFrame(renderSim);\n  }\n  \n  window.ideSelectFile('main.asl');\n})();\n  </script>\n</section>")

(df in-ide-view [] -> Str
  :d "Alias for render-in-ide-view."
  (render-in-ide-view))
