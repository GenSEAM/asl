(module asl-web/playground-view
  :d "Clean Creative Playground UI in pure AgentScript with Dual-Temperature Generation Pipeline."
  :x [render-playground-view playground-view]
  :i [])

(df render-playground-view [] -> Str
  :d "Renders the compact creative playground with horizontal mode navigation, icon-only presets, dual-temperature runtime, and large bottom preview."
  "<section id=\"playground\" class=\"pt-20 pb-16 w-full max-w-6xl mx-auto px-4 sm:px-6\">\n  \n  <!-- 1. Small Header at Top displaying title and additional controls -->\n  <header class=\"h-14 sm:h-16 px-4 sm:px-6 rounded-2xl border border-line bg-surface/90 backdrop-blur-xl flex items-center justify-between gap-4 mb-4 shadow-e2\">\n    <!-- Title and status indicator on the left -->\n    <div class=\"flex items-center gap-3 shrink-0\">\n      <div class=\"w-2.5 h-2.5 rounded-full bg-signal animate-pulse\"></div>\n      <h1 class=\"text-base sm:text-lg font-bold text-ink tracking-tight font-sans\">\n        Creative Playground\n      </h1>\n    </div>\n\n    <!-- Additional Controls fit within the small header -->\n    <div class=\"flex items-center gap-3 flex-wrap\">\n      <!-- Reordered Switcher: SVGs first, websites second, games third -->\n      <nav class=\"flex items-center gap-1 p-1 rounded-xl bg-ground border border-line shrink-0\">\n        <button id=\"pg-mode-svgs\" onclick=\"window.switchPlaygroundMode('svgs')\" class=\"pg-mode-btn px-3 py-1.5 rounded-xl font-mono text-xs font-semibold transition-all bg-signal text-ground shadow-sm cursor-pointer flex items-center gap-1.5\" title=\"Scalable Vector Graphics\">\n          <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg>\n          <span>SVGs</span>\n        </button>\n        <button id=\"pg-mode-websites\" onclick=\"window.switchPlaygroundMode('websites')\" class=\"pg-mode-btn px-3 py-1.5 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer flex items-center gap-1.5\" title=\"Interactive Web Applications\">\n          <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"/><path d=\"M3 9h18\"/></svg>\n          <span>Websites</span>\n        </button>\n        <button id=\"pg-mode-games\" onclick=\"window.switchPlaygroundMode('games')\" class=\"pg-mode-btn px-3 py-1.5 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer flex items-center gap-1.5\" title=\"Playable 2D Canvas Games\">\n          <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"m14 10 4 2-4 2\"/><path d=\"M9 11h.01\"/></svg>\n          <span>Games</span>\n        </button>\n      </nav>\n\n      <!-- Model Selector (3 Options) & Generate Button with custom chevron padding -->\n      <div class=\"flex items-center gap-2 shrink-0\">\n        <select id=\"pg-model-select\" onchange=\"window.onModelSelectChange()\" class=\"h-9 pl-3 pr-9 rounded-xl bg-ground border border-line font-mono text-xs text-ink outline-none focus:border-signal cursor-pointer shadow-sm appearance-none bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2394a3b8%22%20stroke-width%3D%222.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m6%209%206%206%206-6%22%2F%3E%3C%2Fsvg%3E')] bg-[length:12px_12px] bg-[right_10px_center] bg-no-repeat\">\n          <option value=\"micro\">:micro (0.5B)</option>\n          <option value=\"mini\" selected>:mini (1.5B)</option>\n          <option value=\"small\">:small (3B)</option>\n        </select>\n        <button id=\"pg-header-generate-btn\" onclick=\"window.triggerDualSlotGeneration()\" class=\"h-9 px-3.5 rounded-xl font-mono text-xs font-bold transition-all bg-signal/50 text-ground shadow-sm cursor-not-allowed flex items-center gap-1.5 shrink-0 opacity-60\" disabled>\n          <svg class=\"w-3.5 h-3.5 animate-spin\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke-opacity=\"0.25\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke-linecap=\"round\"/></svg>\n          <span>Pending...</span>\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Model Loading & Bootstrap Status Banner -->\n  <div id=\"pg-model-loading-banner\" class=\"mb-5 px-4 py-3 rounded-2xl border border-amber-500/30 bg-amber-500/10 backdrop-blur-xl flex items-center justify-between gap-3 text-xs font-mono shadow-sm transition-all\">\n    <div class=\"flex items-center gap-2.5 min-w-0\">\n      <svg id=\"pg-banner-icon-warn\" class=\"w-4 h-4 text-amber-400 shrink-0 animate-pulse\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/></svg>\n      <svg id=\"pg-banner-icon-ok\" class=\"w-4 h-4 text-emerald-400 shrink-0 hidden\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n      <div class=\"truncate\">\n        <span id=\"pg-banner-title\" class=\"font-bold text-amber-200\">Model Bootstrapping:</span>\n        <span id=\"pg-banner-detail\" class=\"text-amber-300/90 ml-1\">Connecting Wasm MicroVM &amp; bootstrapping harnesses for <span id=\"pg-loading-model-name\" class=\"font-semibold text-white\">:mini (1.5B)</span>. Generation locked until ready.</span>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-2 shrink-0\">\n      <span id=\"pg-bootstrap-step\" class=\"text-[11px] px-2.5 py-0.5 rounded-full bg-amber-400/20 text-amber-200 font-semibold flex items-center gap-1.5\">\n        <span class=\"w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping\"></span>\n        <span>Connecting harnesses...</span>\n      </span>\n    </div>\n  </div>\n\n  <!-- 2. Two Prompt Slots: Style Preset & Prompt -->\n  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 mb-6\">\n    <!-- Prompt Slot 1: Style Preset with 8 shared icon presets next to title -->\n    <div class=\"p-4 rounded-2xl border border-line bg-surface/80 backdrop-blur-md space-y-2.5 shadow-e1\">\n      <div class=\"flex items-center justify-between gap-3\">\n        <span class=\"text-xs font-mono font-semibold text-ink uppercase tracking-wider shrink-0\">Style Preset</span>\n        <!-- 8 Style Icon-Only Presets with Hover Tooltips (Zero scrollbars, full width) -->\n        <div id=\"pg-style-presets-container\" class=\"flex items-center justify-end gap-2 flex-wrap py-0.5\" style=\"overflow: visible; scrollbar-width: none;\"></div>\n      </div>\n      <textarea id=\"pg-prompt-slot-1\" placeholder=\"Choose a style icon or write custom aesthetic rules...\" class=\"w-full h-20 p-3 rounded-xl bg-ground border border-line font-mono text-xs text-ink resize-none outline-none focus:border-signal leading-relaxed shadow-inner\"></textarea>\n    </div>\n\n    <!-- Prompt Slot 2: Prompt with 8 playable icon presets next to title -->\n    <div class=\"p-4 rounded-2xl border border-line bg-surface/80 backdrop-blur-md space-y-2.5 shadow-e1\">\n      <div class=\"flex items-center justify-between gap-3\">\n        <span class=\"text-xs font-mono font-semibold text-ink uppercase tracking-wider shrink-0\">Prompt</span>\n        <!-- 8 Prompt Action Icon-Only Presets with Hover Tooltips (Zero scrollbars, full width) -->\n        <div id=\"pg-prompt-presets-container\" class=\"flex items-center justify-end gap-2 flex-wrap py-0.5\" style=\"overflow: visible; scrollbar-width: none;\"></div>\n      </div>\n      <textarea id=\"pg-prompt-slot-2\" placeholder=\"Choose an action prompt icon or write custom functionality...\" class=\"w-full h-20 p-3 rounded-xl bg-ground border border-line font-mono text-xs text-ink resize-none outline-none focus:border-signal leading-relaxed shadow-inner\"></textarea>\n    </div>\n  </div>\n\n  <!-- 3. Large Full-Width Preview Area at the Bottom -->\n  <div class=\"rounded-3xl border border-line bg-surface/90 backdrop-blur-2xl p-4 sm:p-6 shadow-e3 mb-6\">\n    <div class=\"flex items-center justify-between pb-3 mb-4 border-b border-line text-xs font-mono text-ink-3\">\n      <div class=\"flex items-center gap-2\">\n        <span id=\"pg-active-title\" class=\"font-bold text-ink text-sm\">Active Preview</span>\n        <span id=\"pg-metric-status\" class=\"px-2 py-0.5 rounded-full bg-surface-2 text-ink-2 font-semibold text-[10px]\">Awaiting Generation</span>\n        <span id=\"pg-model-badge\" class=\"px-2 py-0.5 rounded-full bg-signal/15 text-signal font-semibold text-[10px] hidden\">:mini (1.5B)</span>\n        <span id=\"pg-style-badge\" class=\"px-2 py-0.5 rounded-full bg-purple-500/15 text-purple-300 font-semibold text-[10px] hidden\">Cyberpunk Neon</span>\n      </div>\n\n      <div class=\"flex items-center gap-2\">\n        <button id=\"pg-fs-btn\" onclick=\"window.openFullscreenSandbox()\" class=\"px-3 py-1 rounded-lg border border-line bg-surface hover:bg-surface-2 text-ink text-xs transition-colors cursor-pointer flex items-center gap-1 opacity-50 cursor-not-allowed\" disabled>\n          <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3\"/></svg>\n          <span>Fullscreen</span>\n        </button>\n        <button id=\"pg-reload-btn\" onclick=\"window.reloadSandbox()\" class=\"px-2.5 py-1 rounded-lg border border-line bg-surface hover:bg-surface-2 text-ink text-xs transition-colors cursor-pointer opacity-50 cursor-not-allowed\" title=\"Reload sandbox\" disabled>\n          Reload\n        </button>\n      </div>\n    </div>\n\n    <!-- Large Full-Width Live Preview Container -->\n    <div id=\"pg-sandbox-container\" class=\"min-h-[520px] w-full rounded-2xl border border-line bg-black overflow-hidden relative flex flex-col justify-center items-center p-2 shadow-inner\">\n      <!-- Clean Empty State (Zero pre-generated assets displayed) -->\n      <div id=\"pg-empty-state\" class=\"flex flex-col items-center justify-center text-center p-8 max-w-md\">\n        <div class=\"w-14 h-14 rounded-2xl bg-surface border border-line flex items-center justify-center text-signal mb-4 shadow-e2\">\n          <svg class=\"w-7 h-7\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"/></svg>\n        </div>\n        <h3 class=\"text-sm font-bold text-ink mb-1.5 font-mono uppercase tracking-wider\">Awaiting Generation</h3>\n        <p class=\"text-xs text-ink-3 leading-relaxed mb-4\">\n          Select a <span class=\"text-signal font-semibold\">Style Preset</span> and <span class=\"text-signal font-semibold\">Prompt</span>, then click <span class=\"text-ink font-semibold\">Generate</span> to synthesize through the dual-temperature pipeline.\n        </p>\n        <div class=\"flex items-center gap-2 text-[11px] font-mono text-ink-3 bg-ground px-3 py-1.5 rounded-xl border border-line\">\n          <div id=\"pg-empty-state-dot\" class=\"w-2 h-2 rounded-full bg-amber-400 animate-ping\"></div>\n          <span id=\"pg-empty-state-status\">Bootstrapping harnesses for :mini (1.5B)...</span>\n        </div>\n      </div>\n\n      <canvas id=\"pg-game-canvas\" width=\"640\" height=\"480\" class=\"hidden rounded-xl border border-white/10 max-w-full bg-black shadow-2xl\"></canvas>\n      <iframe id=\"pg-site-iframe\" class=\"hidden w-full h-[520px] rounded-xl border-none bg-black\"></iframe>\n      <div id=\"pg-svg-container\" class=\"hidden w-full h-[520px] flex items-center justify-center p-6 bg-[#0d1117] overflow-auto\"></div>\n    </div>\n\n    <!-- Metrics strip below preview -->\n    <div class=\"flex items-center justify-between px-3 pt-3 text-[11px] font-mono text-ink-3\">\n      <div>Tokens: <span id=\"pg-metric-tokens\" class=\"text-ink font-semibold\">0 (Idle)</span></div>\n      <div>Latency: <span id=\"pg-metric-latency\" class=\"text-signal font-semibold\">--</span></div>\n      <div>Engine: <span id=\"pg-metric-engine\" class=\"text-ink font-semibold\">Dual-Temp (T=0.7 Plan &rarr; T=0.0 Exec)</span></div>\n      <div id=\"pg-metric-airgap\" class=\"text-emerald-400 font-semibold flex items-center gap-1.5\">\n        <span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span>\n        <span>Online &bull; In-Browser Runtime</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- 4. Fix Message Area Below the Preview -->\n  <div class=\"p-4 rounded-2xl border border-line bg-surface/80 backdrop-blur-md shadow-e2 flex items-center gap-3\">\n    <div class=\"w-8 h-8 rounded-xl bg-signal/15 border border-signal/30 flex items-center justify-center text-signal shrink-0\">\n      <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg>\n    </div>\n    <input id=\"pg-fix-message-input\" onkeydown=\"if(event.key==='Enter')window.applyFixMessage()\" type=\"text\" placeholder=\"Fix message: refine prompt (e.g. increase jump power, add neon gold border, add more asteroids, change courses)...\" class=\"flex-1 px-3.5 py-2 rounded-xl bg-ground border border-line font-mono text-xs text-ink outline-none focus:border-signal transition-colors\"/>\n    <button onclick=\"window.applyFixMessage()\" class=\"px-4 py-2 rounded-xl bg-surface hover:bg-surface-2 border border-line text-ink font-mono text-xs font-semibold shadow-sm transition-all cursor-pointer shrink-0 flex items-center gap-1.5\">\n      <span>Apply Fix</span>\n      <span id=\"pg-iteration-badge\" class=\"px-1.5 py-0.2 rounded bg-signal/15 text-signal text-[10px]\">v1</span>\n    </button>\n  </div>\n\n  <!-- Fullscreen Modal Overlay -->\n  <div id=\"pg-fullscreen-modal\" class=\"fixed inset-0 z-50 bg-ground/95 backdrop-blur-2xl hidden flex flex-col items-center justify-center p-4 sm:p-8\">\n    <div class=\"absolute top-4 right-4 flex items-center gap-3\">\n      <span class=\"text-xs font-mono text-ink-3\">Press [Esc] to exit</span>\n      <button onclick=\"window.closeFullscreenSandbox()\" class=\"w-10 h-10 rounded-full bg-surface border border-line text-ink hover:text-signal flex items-center justify-center text-sm font-bold shadow-md cursor-pointer\">&times;</button>\n    </div>\n    <div id=\"pg-fullscreen-container\" class=\"w-full max-w-5xl flex items-center justify-center\"></div>\n  </div>\n\n  <script>\n(function() {\n  const STYLE_PRESETS = [{\"id\": \"style-neon\", \"title\": \"Cyberpunk Neon\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\\\"/></svg>\", \"text\": \"Aesthetic style: Cyberpunk Neon. Deep dark obsidian background (#0a0a12), vibrant electric cyan (#00f0ff) and hot magenta (#ff0055) neon glow, high contrast CRT scanline accents, luminous HUD elements, and glowing edges.\"}, {\"id\": \"style-pixel\", \"title\": \"Pixel Art 16-Bit\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"4\\\" y=\\\"4\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"10\\\" y=\\\"4\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"16\\\" y=\\\"4\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"4\\\" y=\\\"10\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"16\\\" y=\\\"10\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"4\\\" y=\\\"16\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"10\\\" y=\\\"16\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"16\\\" y=\\\"16\\\"/></svg>\", \"text\": \"Aesthetic style: Pixel Art 16-Bit. Retro arcade look, hard pixel boundaries, crisp non-anti-aliased sprite styling, vibrant palette with nostalgic contrast, gameboy and SNES era charm.\"}, {\"id\": \"style-mono\", \"title\": \"Minimal Monochrome\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\"/><path d=\\\"M12 2a10 10 0 0 1 0 20Z\\\"/></svg>\", \"text\": \"Aesthetic style: Minimal Monochrome. Swiss graphic design principles, stark black (#000) and pure white (#fff) with titanium grays, generous negative space, hairline 1px borders, bold typographic hierarchy.\"}, {\"id\": \"style-retro\", \"title\": \"Retro Vector 80s\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><polygon points=\\\"12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2\\\"/><line x1=\\\"12\\\" x2=\\\"12\\\" y1=\\\"22\\\" y2=\\\"15.5\\\"/><polyline points=\\\"22 8.5 12 15.5 2 8.5\\\"/></svg>\", \"text\": \"Aesthetic style: Retro Vector 80s. Vector wireframes, neon purple and sunset orange gradients, horizon grid perspective lines, arcade vector display aesthetics with clean geometric contours.\"}, {\"id\": \"style-glass\", \"title\": \"Glassmorphism\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"18\\\" height=\\\"18\\\" x=\\\"3\\\" y=\\\"3\\\" rx=\\\"4\\\"/><path d=\\\"M3 9h18M9 21V9\\\"/></svg>\", \"text\": \"Aesthetic style: Glassmorphism. Translucent frosted glass surfaces (backdrop-filter: blur), subtle white border highlights (rgba(255,255,255,0.15)), multi-layered soft depth shadows, luminous light refractions.\"}, {\"id\": \"style-brutal\", \"title\": \"Brutalist Dark\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"18\\\" height=\\\"18\\\" x=\\\"3\\\" y=\\\"3\\\" rx=\\\"0\\\"/><path d=\\\"M3 3l18 18M3 21L21 3\\\"/></svg>\", \"text\": \"Aesthetic style: Brutalist Dark. High-density industrial layout, bold thick borders (2px solid #222), monospace labels, stark utilitarian contrast, zero rounded corners, raw structural honesty.\"}, {\"id\": \"style-synth\", \"title\": \"Synthwave Sunset\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\"/><path d=\\\"M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41\\\"/></svg>\", \"text\": \"Aesthetic style: Synthwave Sunset. Deep indigo to neon peach gradients, horizontal sliced sun disk, retro sports car headlights, chrome reflections, vibrant 1984 arcade aesthetic.\"}, {\"id\": \"style-blueprint\", \"title\": \"Isometric Blueprint\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\\\"/><polyline points=\\\"3.27 6.96 12 12.01 20.73 6.96\\\"/><line x1=\\\"12\\\" x2=\\\"12\\\" y1=\\\"22.08\\\" y2=\\\"12\\\"/></svg>\", \"text\": \"Aesthetic style: Isometric Blueprint. Engineering schematic aesthetic, dark navy background (#0a192f), cyan technical grid lines, precise dimension callouts, architectural isometric angles.\"}];\n  const PROMPT_PRESETS = {\"websites\": [{\"id\": \"web-sneaker\", \"title\": \"CyberKicks Sneaker Store\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M3.5 17h17l-1.5-6h-6l-2-3H3.5v9z\\\"/><circle cx=\\\"7.5\\\" cy=\\\"17.5\\\" r=\\\"1.5\\\"/><circle cx=\\\"17.5\\\" cy=\\\"17.5\\\" r=\\\"1.5\\\"/></svg>\", \"prompt\": \"Create an ultra-modern CyberKicks sneaker e-commerce showcase. Features interactive 3D color switcher, size selector chips, animated cart drawer flyout, glowing neon badges, and instant checkout mock modal.\", \"preview_type\": \"sneaker\", \"asn\": \"(:website :type :storefront :theme :cyber-dark :components [:hero-customizer :cart-drawer :checkout-modal])\"}, {\"id\": \"web-omakase\", \"title\": \"Sushi Omakase Experience\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><ellipse cx=\\\"12\\\" cy=\\\"8\\\" rx=\\\"8\\\" ry=\\\"4\\\"/><path d=\\\"M4 8v8c0 2.2 3.6 4 8 4s8-1.8 8-4V8\\\"/></svg>\", \"prompt\": \"Build a luxury Japanese Omakase dining reservation website. Features course degustation preview, master chef bio, date & seating time selector, dietary requirement toggles, and confirmed VIP table booking receipt.\", \"preview_type\": \"omakase\", \"asn\": \"(:website :type :luxury-dining :style :minimal-japanese :features [:degustation-menu :reservation-engine])\"}, {\"id\": \"web-saas\", \"title\": \"NeuralFlow AI SaaS\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83\\\"/></svg>\", \"prompt\": \"Build a high-conversion AI Developer Platform landing page. Interactive monthly/annual pricing toggle, dynamic token volume cost calculator, live mock API payload response generator, and interactive feature matrix.\", \"preview_type\": \"saas\", \"asn\": \"(:website :type :saas-landing :components [:pricing-calculator :interactive-api-tester :feature-matrix])\"}, {\"id\": \"web-portfolio\", \"title\": \"Creative Dev Portfolio\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"20\\\" height=\\\"14\\\" x=\\\"2\\\" y=\\\"3\\\" rx=\\\"2\\\"/><polyline points=\\\"8 21 12 17 16 21\\\"/></svg>\", \"prompt\": \"Design a cutting-edge creative engineer portfolio. Includes an interactive in-browser bash terminal with commands (`cat bio`, `skills`, `projects`), filterable showcase cards, and interactive project modal.\", \"preview_type\": \"portfolio\", \"asn\": \"(:website :type :portfolio :features [:in-browser-terminal :project-drawer :skill-matrix])\"}, {\"id\": \"web-kanban\", \"title\": \"Agile Flow Kanban Board\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"5\\\" height=\\\"14\\\" x=\\\"3\\\" y=\\\"5\\\" rx=\\\"1\\\"/><rect width=\\\"5\\\" height=\\\"10\\\" x=\\\"10\\\" y=\\\"5\\\" rx=\\\"1\\\"/><rect width=\\\"5\\\" height=\\\"16\\\" x=\\\"17\\\" y=\\\"5\\\" rx=\\\"1\\\"/></svg>\", \"prompt\": \"Build an interactive Agile Kanban project board with Backlog, In Progress, Review, and Done columns. Click to move cards between stages, add custom task modal, priority tag filters, and task completion metrics.\", \"preview_type\": \"kanban\", \"asn\": \"(:website :type :productivity-app :columns [:backlog :in-progress :review :done] :interactive true)\"}, {\"id\": \"web-synth\", \"title\": \"Web Audio FM Synth\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M2 12h3l3-9 4 18 4-12 3 6h3\\\"/></svg>\", \"prompt\": \"Create an in-browser Web Audio FM Synthesizer with clickable chromatic piano keyboard, oscillator wave selector (Sine, Square, Sawtooth, Triangle), interactive cutoff filter knob, and animated oscilloscope.\", \"preview_type\": \"synth\", \"asn\": \"(:website :type :audio-instrument :engine :web-audio-api :oscillators [:sine :square :sawtooth])\"}, {\"id\": \"web-analytics\", \"title\": \"Quantum Metrics Dashboard\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><line x1=\\\"18\\\" x2=\\\"18\\\" y1=\\\"20\\\" y2=\\\"10\\\"/><line x1=\\\"12\\\" x2=\\\"12\\\" y1=\\\"20\\\" y2=\\\"4\\\"/><line x1=\\\"6\\\" x2=\\\"6\\\" y1=\\\"20\\\" y2=\\\"14\\\"/></svg>\", \"prompt\": \"Build an enterprise analytics command center. Features live SVG sparklines, time range selector (24h, 7d, 30d, 1y), real-time simulated throughput metrics, conversion funnels, and alert notifications feed.\", \"preview_type\": \"analytics\", \"asn\": \"(:website :type :dashboard :charts [:sparklines :conversion-funnel :live-throughput])\"}, {\"id\": \"web-chat\", \"title\": \"Agentic AI Chat Studio\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\\\"/></svg>\", \"prompt\": \"Design a futuristic AI Agent Chat studio with multi-turn conversation threads, prompt token counter, model switch badge (Micro 0.5B, Mini 1.5B, Small 3B), code block copy buttons, and markdown rendering.\", \"preview_type\": \"chat\", \"asn\": \"(:website :type :chat-interface :models [:micro :mini :small] :features [:markdown :token-telemetry])\"}], \"svgs\": [{\"id\": \"svg-chameleon\", \"title\": \"ASL Chameleon Mascot\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"9\\\"/><path d=\\\"M12 7a5 5 0 0 1 5 5c0 2-1 3-3 4s-3 0-3-2a2 2 0 0 1 2-2\\\"/></svg>\", \"prompt\": \"Generate the iconic AgentScript chameleon mascot in scalable vector graphics. Feature curling spiral tail, jewel-faceted scales with gradient shading (#a855f7 to #3b82f6), expressive holographic eye, and neon outline.\", \"preview_type\": \"chameleon\", \"asn\": \"(:svg :target :chameleon-mascot :viewbox [0 0 400 400] :gradients [:purple-cyan-glow])\"}, {\"id\": \"svg-station\", \"title\": \"Orbital Space Station\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\"/><line x1=\\\"12\\\" x2=\\\"12\\\" y1=\\\"2\\\" y2=\\\"8\\\"/><line x1=\\\"12\\\" x2=\\\"12\\\" y1=\\\"16\\\" y2=\\\"22\\\"/><line x1=\\\"2\\\" x2=\\\"8\\\" y1=\\\"12\\\" y2=\\\"12\\\"/><line x1=\\\"16\\\" x2=\\\"22\\\" y1=\\\"12\\\" y2=\\\"12\\\"/></svg>\", \"prompt\": \"Illustrate an orbital research station in deep space. Dual rotating habitat rings, blue solar photovoltaic arrays, docking module with approaching transport shuttle, starfield with glowing nebula background.\", \"preview_type\": \"station\", \"asn\": \"(:svg :target :deep-space-station :viewbox [0 0 600 400] :geometry [:torus-rings :solar-panels])\"}, {\"id\": \"svg-cat\", \"title\": \"Cyber Mecha Feline\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><polygon points=\\\"12 3 15 9 21 9 17 14 19 20 12 16 5 20 7 14 3 9 9 9 12 3\\\"/></svg>\", \"prompt\": \"Create a cybernetic mecha cat portrait with cybernetic implants. Glowing crimson optical sensor, polished titanium cheekplates, wireframe whiskers, carbon-fiber ear plating, and circuitry traces.\", \"preview_type\": \"cat\", \"asn\": \"(:svg :target :mecha-cat :viewbox [0 0 400 400] :aesthetic :cyber-bionic)\"}, {\"id\": \"svg-city\", \"title\": \"Isometric Megacity\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"8\\\" height=\\\"16\\\" x=\\\"4\\\" y=\\\"4\\\"/><rect width=\\\"8\\\" height=\\\"12\\\" x=\\\"12\\\" y=\\\"8\\\"/></svg>\", \"prompt\": \"Create an isometric cyberpunk metropolis with towering skyscrapers, multi-tier skyway bridges, airborne hovercars, holographic Japanese kanji advertising billboards, and dark reflective rainy streets.\", \"preview_type\": \"city\", \"asn\": \"(:svg :target :isometric-megacity :viewbox [0 0 600 450] :projection :isometric-30deg)\"}, {\"id\": \"svg-rocket\", \"title\": \"Retro Cosmic Rocket\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z\\\"/><path d=\\\"m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-2.05 9A22 22 0 0 1 15 12z\\\"/></svg>\", \"prompt\": \"Illustrate a 1950s atomic age retro space rocket launching into the cosmos. Swept-back aerodynamic fins, chrome porthole rivets, billowy smoke cloud plumes, ringed Saturn planet, and starry constellation backdrop.\", \"preview_type\": \"rocket\", \"asn\": \"(:svg :target :retro-rocket :viewbox [0 0 400 500] :style :atomic-midcentury)\"}, {\"id\": \"svg-compass\", \"title\": \"Cyber Arcane Compass\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\"/><polygon points=\\\"16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76\\\"/></svg>\", \"prompt\": \"Render an intricate cyber-arcane navigation compass. Interlocking concentric planetary rings with gear teeth, degree markings, glowing navigational runes, needle pointer with cyan laser tip, and star chart grid.\", \"preview_type\": \"compass\", \"asn\": \"(:svg :target :arcane-compass :viewbox [0 0 400 400] :elements [:astrolabe-rings :runic-glyph])\"}, {\"id\": \"svg-eagle\", \"title\": \"Geometric Origami Falcon\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><polygon points=\\\"12 2 20 10 16 22 12 18 8 22 4 10 12 2\\\"/></svg>\", \"prompt\": \"Design a low-poly geometric falcon in mid-flight with wide wingspan. Sharp angular facets with gradient foil shading (#f59e0b gold to #8b5cf6 violet), piercing amber eye, and crystal aerofoil wingtips.\", \"preview_type\": \"eagle\", \"asn\": \"(:svg :target :origami-falcon :viewbox [0 0 500 400] :shading :facet-low-poly)\"}, {\"id\": \"svg-skull\", \"title\": \"Circuit Matrix Skull\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"9\\\" cy=\\\"10\\\" r=\\\"1.5\\\"/><circle cx=\\\"15\\\" cy=\\\"10\\\" r=\\\"1.5\\\"/><path d=\\\"M8 18h8M10 21h4M5 10a7 7 0 0 1 14 0c0 4-2 7-4 8H9c-2-1-4-4-4-8z\\\"/></svg>\", \"prompt\": \"Create a cybernetic skull constructed from glowing motherboard traces and printed circuit vias. Glowing cyan ocular micro-cameras, exposed titanium cranial plates, etched copper traces, and binary data streams.\", \"preview_type\": \"skull\", \"asn\": \"(:svg :target :circuit-skull :viewbox [0 0 400 450] :traces :matrix-pcb)\"}], \"games\": [{\"id\": \"toy-flappy\", \"title\": \"Flappy Bird 2D\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M16 4h4v4h-4z\\\"/><circle cx=\\\"8\\\" cy=\\\"12\\\" r=\\\"5\\\"/><path d=\\\"M13 12h5l-2 3h-3z\\\"/></svg>\", \"prompt\": \"Build a playable Flappy Bird 2D arcade game in HTML5 Canvas. Player flaps on Space or Click, pipes scroll from right, score counter increments on pass, with collision detection, restart button, and smooth particle trail.\", \"preview_type\": \"flappy\", \"asn\": \"(:toy :engine :canvas-2d :game \\\"flappy-bird\\\" :physics (:gravity 0.38 :jump -6.8 :pipe-speed 2.2) :state (:score 0 :alive true))\"}, {\"id\": \"toy-asteroids\", \"title\": \"Asteroids Space Shooter\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><polygon points=\\\"12 2 19 21 12 17 5 21 12 2\\\"/><circle cx=\\\"12\\\" cy=\\\"7\\\" r=\\\"1\\\"/></svg>\", \"prompt\": \"Build a vector Asteroids space shooter in HTML5 Canvas. Player controls triangular ship with inertia physics (Up/W to thrust, Left/Right or A/D to rotate), Space to fire lasers, floating asteroids split on destruction, with score and lives.\", \"preview_type\": \"asteroids\", \"asn\": \"(:toy :engine :canvas-2d :game \\\"asteroids\\\" :physics (:thrust 0.15 :friction 0.985 :rot-speed 0.08) :state (:score 0 :lives 3 :rocks 5))\"}, {\"id\": \"toy-snake\", \"title\": \"Neon Retro Snake\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M4 12h8a4 4 0 0 1 4 4v0a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-8a4 4 0 0 1 4-4h12\\\"/></svg>\", \"prompt\": \"Build an arcade Snake game on a 20x20 grid with smooth neon rendering. Arrow keys to steer, glowing food particles, speed increases with length, self-collision and wall wrap-around options, real-time score display.\", \"preview_type\": \"snake\", \"asn\": \"(:toy :engine :canvas-2d :game \\\"snake\\\" :grid [20 20] :speed 90 :state (:length 3 :score 0))\"}, {\"id\": \"toy-life\", \"title\": \"Conway Game of Life\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"6\\\" height=\\\"6\\\" x=\\\"3\\\" y=\\\"3\\\"/><rect width=\\\"6\\\" height=\\\"6\\\" x=\\\"15\\\" y=\\\"3\\\"/><rect width=\\\"6\\\" height=\\\"6\\\" x=\\\"9\\\" y=\\\"15\\\"/></svg>\", \"prompt\": \"Design an interactive Conway Game of Life cellular automata grid. Click or drag to draw live cells, space to pause/play, step forward button, clear, and preset buttons for Gosper Glider Gun and Pulsar oscillators.\", \"preview_type\": \"life\", \"asn\": \"(:toy :engine :cellular-automata :rules \\\"B3/S23\\\" :grid [40 30] :interactive true)\"}, {\"id\": \"toy-rogue\", \"title\": \"Dungeon Crawler Rogue\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"m14.5 12.5-8 8a2.12 2.12 0 1 1-3-3l8-8\\\"/><path d=\\\"m16 8 2-2 4 4-2 2\\\"/><path d=\\\"m19 5 2 2\\\"/></svg>\", \"prompt\": \"Create a top-down Dungeon Rogue 2D adventure game in HTML5 Canvas. Move player knight with WASD, explore rooms, collect magical emeralds, avoid patrolling slimes, defeat dungeon boss to unlock exit staircase.\", \"preview_type\": \"rogue\", \"asn\": \"(:toy :engine :canvas-2d :game \\\"dungeon-rogue\\\" :dungeon (:rooms 6 :enemies 4 :gems 10) :player (:hp 100 :lvl 1))\"}, {\"id\": \"toy-pong\", \"title\": \"Cyber Pong 2D\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><line x1=\\\"4\\\" x2=\\\"4\\\" y1=\\\"6\\\" y2=\\\"18\\\"/><line x1=\\\"20\\\" x2=\\\"20\\\" y1=\\\"6\\\" y2=\\\"18\\\"/><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"2\\\"/></svg>\", \"prompt\": \"Build a fast-paced Cyber Pong game in HTML5 Canvas. Player controls left paddle with mouse or W/S, smart AI opponent tracks ball on the right, neon trail on ball bounce, synthetic audio beeps, score to 7 wins.\", \"preview_type\": \"pong\", \"asn\": \"(:toy :engine :canvas-2d :game \\\"cyber-pong\\\" :ball (:speed 5 :spin true) :ai (:difficulty :medium))\"}, {\"id\": \"toy-breakout\", \"title\": \"Neon Brick Breaker\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"18\\\" height=\\\"4\\\" x=\\\"3\\\" y=\\\"4\\\"/><rect width=\\\"18\\\" height=\\\"4\\\" x=\\\"3\\\" y=\\\"10\\\"/><rect width=\\\"10\\\" height=\\\"3\\\" x=\\\"7\\\" y=\\\"18\\\"/><circle cx=\\\"12\\\" cy=\\\"15\\\" r=\\\"1.5\\\"/></svg>\", \"prompt\": \"Build a Neon Brick Breaker game in HTML5 Canvas. Move bottom paddle with mouse/arrows, bounce glowing ball into multi-tiered colored bricks with explosion particles, multi-ball bonus, and level clear tracking.\", \"preview_type\": \"breakout\", \"asn\": \"(:toy :engine :canvas-2d :game \\\"brick-breaker\\\" :rows 4 :cols 8 :powerups [:multi-ball :wide-paddle])\"}, {\"id\": \"toy-racer\", \"title\": \"2D Micro Drift Racer\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"9\\\"/><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"3\\\"/><path d=\\\"m14 10 4-4\\\"/></svg>\", \"prompt\": \"Build a top-down 2D Micro Drift Racer in Canvas. Control sports car with Up (accelerate), Down (brake/reverse), Left/Right (turn) with drift physics, leaving rubber skid marks on asphalt, with checkpoint lap timer.\", \"preview_type\": \"racer\", \"asn\": \"(:toy :engine :canvas-2d :game \\\"drift-racer\\\" :track :monaco-circuit :physics (:drift 0.94 :max-speed 6.5))\"}]};\n\n  // Detailed palette and geometry configuration per style\n  const STYLE_THEMES = {\n    'style-neon': {\n      id: 'style-neon',\n      name: 'Cyberpunk Neon',\n      bg: '#0a0a14',\n      primary: '#00f0ff',\n      accent: '#ff0055',\n      secondary: '#a855f7',\n      text: '#ffffff',\n      subtext: '#94a3b8',\n      border: '#00f0ff',\n      font: 'monospace',\n      glow: true,\n      cardBg: 'rgba(10, 10, 20, 0.94)'\n    },\n    'style-pixel': {\n      id: 'style-pixel',\n      name: 'Pixel Art 16-Bit',\n      bg: '#181825',\n      primary: '#facc15',\n      accent: '#e11d48',\n      secondary: '#38bdf8',\n      text: '#f8fafc',\n      subtext: '#a6adc8',\n      border: '#facc15',\n      font: 'monospace',\n      pixelated: true,\n      cardBg: 'rgba(24, 24, 37, 0.96)'\n    },\n    'style-mono': {\n      id: 'style-mono',\n      name: 'Minimal Monochrome',\n      bg: '#000000',\n      primary: '#ffffff',\n      accent: '#71717a',\n      secondary: '#d4d4d8',\n      text: '#ffffff',\n      subtext: '#a1a1aa',\n      border: '#ffffff',\n      font: 'ui-sans-serif, system-ui, sans-serif',\n      mono: true,\n      cardBg: 'rgba(15, 15, 15, 0.98)'\n    },\n    'style-retro': {\n      id: 'style-retro',\n      name: 'Retro Vector 80s',\n      bg: '#090314',\n      primary: '#a855f7',\n      accent: '#f97316',\n      secondary: '#ec4899',\n      text: '#fdf4ff',\n      subtext: '#c084fc',\n      border: '#a855f7',\n      font: 'monospace',\n      wireframe: true,\n      cardBg: 'rgba(15, 5, 25, 0.94)'\n    },\n    'style-glass': {\n      id: 'style-glass',\n      name: 'Glassmorphism',\n      bg: '#0f172a',\n      primary: '#38bdf8',\n      accent: '#c084fc',\n      secondary: '#818cf8',\n      text: '#ffffff',\n      subtext: '#cbd5e1',\n      border: 'rgba(255, 255, 255, 0.25)',\n      font: 'ui-sans-serif, system-ui, sans-serif',\n      glass: true,\n      cardBg: 'rgba(30, 41, 59, 0.70)'\n    },\n    'style-brutal': {\n      id: 'style-brutal',\n      name: 'Brutalist Dark',\n      bg: '#121212',\n      primary: '#fef08a',\n      accent: '#f87171',\n      secondary: '#4ade80',\n      text: '#ffffff',\n      subtext: '#9ca3af',\n      border: '#fef08a',\n      font: 'monospace',\n      brutal: true,\n      cardBg: 'rgba(20, 20, 20, 0.98)'\n    },\n    'style-synth': {\n      id: 'style-synth',\n      name: 'Synthwave Sunset',\n      bg: '#1a0826',\n      primary: '#f43f5e',\n      accent: '#fb923c',\n      secondary: '#ec4899',\n      text: '#fff1f2',\n      subtext: '#fda4af',\n      border: '#f43f5e',\n      font: 'monospace',\n      synth: true,\n      cardBg: 'rgba(30, 10, 45, 0.94)'\n    },\n    'style-blueprint': {\n      id: 'style-blueprint',\n      name: 'Isometric Blueprint',\n      bg: '#071529',\n      primary: '#00f0ff',\n      accent: '#38bdf8',\n      secondary: '#0284c7',\n      text: '#e0f2fe',\n      subtext: '#7dd3fc',\n      border: '#0284c7',\n      font: 'monospace',\n      blueprint: true,\n      cardBg: 'rgba(7, 21, 41, 0.96)'\n    }\n  };\n\n  window.__pgCurrentMode = 'svgs';\n  window.__pgActiveStyleId = STYLE_PRESETS[0].id;\n  window.__pgActivePromptId = (PROMPT_PRESETS['svgs'] && PROMPT_PRESETS['svgs'][0]) ? PROMPT_PRESETS['svgs'][0].id : '';\n  window.__pgSelectedModel = 'mini';\n  window.__pgIteration = 1;\n  window.__pgActiveAnimId = null;\n  window.__pgActiveCleanup = null;\n  window.__pgModelLoaded = false;\n  window.__pgHasGenerated = false;\n\n  // Render 8 Style Presets into Slot 1 Header with Tooltips\n  window.renderStylePresets = function() {\n    const container = document.getElementById('pg-style-presets-container');\n    if (!container) return;\n    container.innerHTML = '';\n\n    STYLE_PRESETS.forEach(style => {\n      const btn = document.createElement('button');\n      btn.type = 'button';\n      btn.title = style.title;\n      btn.className = `w-8 h-8 rounded-xl border transition-all cursor-pointer flex items-center justify-center shadow-sm ${\n        style.id === window.__pgActiveStyleId\n          ? 'border-signal bg-signal/20 text-signal shadow-signal/30 shadow-md scale-105'\n          : 'border-line bg-surface hover:bg-surface-2 text-ink-2 hover:text-ink'\n      }`;\n      btn.innerHTML = style.svg;\n      btn.onclick = () => window.selectStylePreset(style.id);\n      container.appendChild(btn);\n    });\n  };\n\n  // Render 8 Prompt Presets into Slot 2 Header with Tooltips\n  window.renderPromptPresets = function() {\n    const container = document.getElementById('pg-prompt-presets-container');\n    if (!container) return;\n    container.innerHTML = '';\n\n    const list = PROMPT_PRESETS[window.__pgCurrentMode] || [];\n    list.forEach(preset => {\n      const btn = document.createElement('button');\n      btn.type = 'button';\n      btn.title = preset.title;\n      btn.className = `w-8 h-8 rounded-xl border transition-all cursor-pointer flex items-center justify-center shadow-sm ${\n        preset.id === window.__pgActivePromptId\n          ? 'border-signal bg-signal/20 text-signal shadow-signal/30 shadow-md scale-105'\n          : 'border-line bg-surface hover:bg-surface-2 text-ink-2 hover:text-ink'\n      }`;\n      btn.innerHTML = preset.svg;\n      btn.onclick = () => window.selectPromptPreset(preset.id);\n      container.appendChild(btn);\n    });\n  };\n\n  // Select Style Preset: updates textarea and active button, DOES NOT change output until Generate!\n  window.selectStylePreset = function(styleId) {\n    window.__pgActiveStyleId = styleId;\n    const style = STYLE_PRESETS.find(s => s.id === styleId);\n    if (style) {\n      const slot1 = document.getElementById('pg-prompt-slot-1');\n      if (slot1) slot1.value = style.text;\n    }\n    window.renderStylePresets();\n  };\n\n  // Select Prompt Preset: updates textarea and active button, DOES NOT change output until Generate!\n  window.selectPromptPreset = function(presetId) {\n    window.__pgActivePromptId = presetId;\n    const list = PROMPT_PRESETS[window.__pgCurrentMode] || [];\n    const preset = list.find(p => p.id === presetId);\n    if (preset) {\n      const slot2 = document.getElementById('pg-prompt-slot-2');\n      if (slot2) slot2.value = preset.prompt;\n    }\n    window.renderPromptPresets();\n  };\n\n  // Switch Category Mode: SVGs first, Websites second, Games third\n  window.switchPlaygroundMode = function(mode) {\n    window.__pgCurrentMode = mode;\n    ['svgs', 'websites', 'games'].forEach(m => {\n      const btn = document.getElementById(`pg-mode-${m}`);\n      if (!btn) return;\n      if (m === mode) {\n        btn.className = 'pg-mode-btn px-3 py-1.5 rounded-xl font-mono text-xs font-semibold transition-all bg-signal text-ground shadow-sm cursor-pointer flex items-center gap-1.5';\n      } else {\n        btn.className = 'pg-mode-btn px-3 py-1.5 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer flex items-center gap-1.5';\n      }\n    });\n\n    const list = PROMPT_PRESETS[mode] || [];\n    if (list.length > 0) {\n      window.__pgActivePromptId = list[0].id;\n      const slot2 = document.getElementById('pg-prompt-slot-2');\n      if (slot2) slot2.value = list[0].prompt;\n    }\n\n    window.renderPromptPresets();\n  };\n\n  // Dual-Temperature: Phase 1 (Semantic Planning at T=0.7)\n  // Extracts theme parameters, color overrides, and structural keywords from Slot 1\n  window.resolveActiveTheme = function() {\n    const slot1 = document.getElementById('pg-prompt-slot-1');\n    const text = (slot1 ? slot1.value : '').toLowerCase().trim();\n\n    // 1. Check if it matches an exact preset first!\n    if (window.__pgActiveStyleId && STYLE_THEMES[window.__pgActiveStyleId]) {\n      const activePreset = STYLE_PRESETS.find(s => s.id === window.__pgActiveStyleId);\n      if (activePreset && activePreset.text.trim().toLowerCase() === text) {\n        return Object.assign({}, STYLE_THEMES[window.__pgActiveStyleId]);\n      }\n    }\n\n    // 2. Check if text matches any preset text directly\n    const matchedPreset = STYLE_PRESETS.find(s => s.text.trim().toLowerCase() === text);\n    if (matchedPreset && STYLE_THEMES[matchedPreset.id]) {\n      return Object.assign({}, STYLE_THEMES[matchedPreset.id]);\n    }\n\n    // 3. Keyword matching for custom user prompts\n    let base = STYLE_THEMES['style-neon'];\n    if (text.includes('synth') || text.includes('vapor') || text.includes('sunset') || text.includes('1984')) {\n      base = STYLE_THEMES['style-synth'];\n    } else if (text.includes('pixel') || text.includes('16-bit') || text.includes('snes') || text.includes('gameboy') || text.includes('8-bit')) {\n      base = STYLE_THEMES['style-pixel'];\n    } else if (text.includes('monochrome') || text.includes('swiss') || text.includes('black and white') || text.includes('minimal mono')) {\n      base = STYLE_THEMES['style-mono'];\n    } else if (text.includes('retro') || text.includes('wireframe') || text.includes('80s') || text.includes('vector display')) {\n      base = STYLE_THEMES['style-retro'];\n    } else if (text.includes('glass') || text.includes('frosted') || text.includes('translucent')) {\n      base = STYLE_THEMES['style-glass'];\n    } else if (text.includes('brutal') || text.includes('industrial') || text.includes('raw structural')) {\n      base = STYLE_THEMES['style-brutal'];\n    } else if (text.includes('blueprint') || text.includes('schematic') || text.includes('architectural') || text.includes('cad')) {\n      base = STYLE_THEMES['style-blueprint'];\n    } else if (window.__pgActiveStyleId && STYLE_THEMES[window.__pgActiveStyleId]) {\n      base = STYLE_THEMES[window.__pgActiveStyleId];\n    }\n\n    // Dynamic color adjustments if explicit color words are in prompt slot 1\n    const themeCopy = Object.assign({}, base);\n    if (text.includes('gold') || text.includes('amber')) themeCopy.accent = '#f59e0b';\n    if (text.includes('emerald') || text.includes('green')) themeCopy.primary = '#10b981';\n    if (text.includes('crimson') || text.includes('blood')) themeCopy.accent = '#ef4444';\n    if (text.includes('purple') || text.includes('violet')) themeCopy.secondary = '#8b5cf6';\n    return themeCopy;\n  };\n\n  // Bootstrap & Harness Lifecycle Engine\n  window.bootstrapModelHarnesses = function(modelName) {\n    window.__pgModelLoaded = false;\n\n    const genBtn = document.getElementById('pg-header-generate-btn');\n    const banner = document.getElementById('pg-model-loading-banner');\n    const iconWarn = document.getElementById('pg-banner-icon-warn');\n    const iconOk = document.getElementById('pg-banner-icon-ok');\n    const bannerTitle = document.getElementById('pg-banner-title');\n    const bannerDetail = document.getElementById('pg-banner-detail');\n    const bannerModel = document.getElementById('pg-loading-model-name');\n    const stepBadge = document.getElementById('pg-bootstrap-step');\n    const emptyStatus = document.getElementById('pg-empty-state-status');\n    const airgapMetric = document.getElementById('pg-metric-airgap');\n\n    if (genBtn) {\n      genBtn.disabled = true;\n      genBtn.className = 'h-9 px-3.5 rounded-xl font-mono text-xs font-bold transition-all bg-signal/50 text-ground shadow-sm cursor-not-allowed flex items-center gap-1.5 shrink-0 opacity-60';\n      genBtn.innerHTML = '<svg class=\"w-3.5 h-3.5 animate-spin\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke-opacity=\"0.25\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke-linecap=\"round\"/></svg><span>Pending...</span>';\n    }\n\n    if (banner) {\n      banner.className = 'mb-5 px-4 py-3 rounded-2xl border border-amber-500/30 bg-amber-500/10 backdrop-blur-xl flex items-center justify-between gap-3 text-xs font-mono shadow-sm transition-all';\n    }\n    if (iconWarn) iconWarn.classList.remove('hidden');\n    if (iconOk) iconOk.classList.add('hidden');\n    if (bannerTitle) { bannerTitle.innerText = 'Model Bootstrapping:'; bannerTitle.className = 'font-bold text-amber-200'; }\n    if (bannerModel) bannerModel.innerText = `:${modelName}`;\n    if (bannerDetail) bannerDetail.innerHTML = `Connecting Wasm MicroVM &amp; bootstrapping harnesses for <span class=\"font-semibold text-white\">:${modelName}</span>. Generation locked until ready.`;\n    if (stepBadge) stepBadge.innerHTML = '<span class=\"w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping\"></span><span>Connecting harnesses...</span>';\n    if (emptyStatus) emptyStatus.innerText = `Bootstrapping harnesses for :${modelName}...`;\n    if (airgapMetric) airgapMetric.innerHTML = '<span class=\"w-2 h-2 rounded-full bg-amber-400 animate-pulse\"></span><span>Harness Connecting...</span>';\n\n    setTimeout(() => {\n      if (stepBadge) stepBadge.innerHTML = '<span class=\"w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse\"></span><span>Wasm MicroVM bound (64KB)...</span>';\n      if (emptyStatus) emptyStatus.innerText = 'Wasm MicroVM sandbox bound...';\n    }, 400);\n\n    setTimeout(() => {\n      if (stepBadge) stepBadge.innerHTML = '<span class=\"w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse\"></span><span>Calibrating Hanes parameters...</span>';\n      if (emptyStatus) emptyStatus.innerText = 'Calibrating Hanes parameters & token ceiling...';\n    }, 800);\n\n    setTimeout(() => {\n      window.__pgModelLoaded = true;\n\n      if (genBtn) {\n        genBtn.disabled = false;\n        genBtn.className = 'h-9 px-3.5 rounded-xl font-mono text-xs font-bold transition-all bg-signal text-ground shadow-sm hover:opacity-95 cursor-pointer flex items-center gap-1.5 shrink-0';\n        genBtn.innerHTML = '<svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"/></svg><span>Generate</span>';\n      }\n\n      if (banner) {\n        banner.className = 'mb-5 px-4 py-3 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 backdrop-blur-xl flex items-center justify-between gap-3 text-xs font-mono shadow-sm transition-all';\n      }\n      if (iconWarn) iconWarn.classList.add('hidden');\n      if (iconOk) iconOk.classList.remove('hidden');\n      if (bannerTitle) { bannerTitle.innerText = 'Local Model Loaded & Ready:'; bannerTitle.className = 'font-bold text-emerald-300'; }\n      if (bannerDetail) bannerDetail.innerHTML = `All harnesses connected for <span class=\"font-semibold text-white\">:${modelName}</span>. In-Browser Runtime Active.`;\n      if (stepBadge) stepBadge.innerHTML = '<span class=\"w-1.5 h-1.5 rounded-full bg-emerald-400\"></span><span class=\"text-emerald-300\">Harnesses Connected</span>';\n      if (emptyStatus) emptyStatus.innerText = `Model :${modelName} ready. Click Generate to run.`;\n      if (airgapMetric) airgapMetric.innerHTML = '<span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span><span>Online &bull; In-Browser Runtime</span>';\n\n      // If already generated, re-render with new model characteristics\n      if (window.__pgHasGenerated) {\n        window.executeLivePreview();\n      }\n    }, 1200);\n  };\n\n  window.onModelSelectChange = function() {\n    const sel = document.getElementById('pg-model-select');\n    if (sel) {\n      window.__pgSelectedModel = sel.value;\n      window.bootstrapModelHarnesses(sel.value);\n    }\n  };\n\n  // Full Context Reset & Dual-Temperature Generation Trigger\n  window.triggerDualSlotGeneration = function() {\n    if (!window.__pgModelLoaded) return;\n\n    window.__pgHasGenerated = true;\n    window.__pgIteration = 1;\n    const badge = document.getElementById('pg-iteration-badge');\n    if (badge) badge.innerText = 'v1';\n\n    // Wipe previous context completely\n    window.resetExecutionContext();\n\n    const genBtn = document.getElementById('pg-header-generate-btn');\n    const metricStatus = document.getElementById('pg-metric-status');\n\n    if (genBtn) {\n      genBtn.innerHTML = '<svg class=\"w-3.5 h-3.5 animate-spin\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke-opacity=\"0.25\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke-linecap=\"round\"/></svg><span>Planning (T=0.7)...</span>';\n    }\n    if (metricStatus) {\n      metricStatus.innerText = 'Planning (T=0.7)';\n      metricStatus.className = 'px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 font-semibold text-[10px]';\n    }\n\n    // Two-stage generation pipeline: Stage 1 Planning (T=0.7) -> Stage 2 Execution (T=0.0)\n    setTimeout(() => {\n      if (genBtn) genBtn.innerHTML = '<svg class=\"w-3.5 h-3.5 animate-spin\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke-opacity=\"0.25\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke-linecap=\"round\"/></svg><span>Compiling (T=0.0)...</span>';\n      if (metricStatus) {\n        metricStatus.innerText = 'Compiling (T=0.0)';\n        metricStatus.className = 'px-2 py-0.5 rounded-full bg-signal/20 text-signal font-semibold text-[10px]';\n      }\n\n      setTimeout(() => {\n        if (genBtn) genBtn.innerHTML = '<svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"/></svg><span>Generate</span>';\n        window.executeLivePreview();\n      }, 250);\n    }, 350);\n  };\n\n  // Clear previous animation loop, canvas event listeners, iframe, and SVG container\n  window.resetExecutionContext = function() {\n    if (window.__pgActiveAnimId) {\n      cancelAnimationFrame(window.__pgActiveAnimId);\n      window.__pgActiveAnimId = null;\n    }\n    if (typeof window.__pgActiveCleanup === 'function') {\n      window.__pgActiveCleanup();\n      window.__pgActiveCleanup = null;\n    }\n    window.onkeydown = null;\n    window.onkeyup = null;\n\n    const canvas = document.getElementById('pg-game-canvas');\n    if (canvas) {\n      canvas.onclick = null;\n      canvas.onmousemove = null;\n      const ctx = canvas.getContext('2d');\n      if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);\n    }\n    const iframe = document.getElementById('pg-site-iframe');\n    if (iframe) iframe.srcdoc = '';\n    const svgBox = document.getElementById('pg-svg-container');\n    if (svgBox) svgBox.innerHTML = '';\n  };\n\n  window.applyFixMessage = function() {\n    if (!window.__pgModelLoaded) return;\n\n    const inp = document.getElementById('pg-fix-message-input');\n    const fixText = (inp ? inp.value : '').trim();\n    if (!fixText) return;\n\n    window.__pgHasGenerated = true;\n    window.__pgIteration++;\n    const badge = document.getElementById('pg-iteration-badge');\n    if (badge) badge.innerText = `v${window.__pgIteration}`;\n    if (inp) inp.value = '';\n\n    window.resetExecutionContext();\n    window.executeLivePreview(fixText);\n  };\n\n  window.reloadSandbox = function() {\n    if (window.__pgHasGenerated) {\n      window.resetExecutionContext();\n      window.executeLivePreview();\n    }\n  };\n\n  window.openFullscreenSandbox = function() {\n    if (!window.__pgHasGenerated) return;\n\n    const modal = document.getElementById('pg-fullscreen-modal');\n    const container = document.getElementById('pg-fullscreen-container');\n    if (!modal || !container) return;\n\n    modal.classList.remove('hidden');\n    container.innerHTML = '';\n\n    const theme = window.resolveActiveTheme();\n    const model = window.__pgSelectedModel;\n    const slot2 = document.getElementById('pg-prompt-slot-2');\n    const userPrompt = (slot2 ? slot2.value : '').trim();\n\n    if (window.__pgCurrentMode === 'games') {\n      const fsCanvas = document.createElement('canvas');\n      fsCanvas.width = 800;\n      fsCanvas.height = 600;\n      fsCanvas.className = 'rounded-2xl border border-white/20 max-w-full bg-black shadow-2xl';\n      container.appendChild(fsCanvas);\n      window.runToyEngine(userPrompt, fsCanvas, null, theme, model);\n    } else if (window.__pgCurrentMode === 'websites') {\n      const fsIframe = document.createElement('iframe');\n      fsIframe.className = 'w-full h-[80vh] rounded-2xl border border-white/20 bg-black';\n      fsIframe.srcdoc = window.buildWebsiteContent(userPrompt, null, theme, model);\n      container.appendChild(fsIframe);\n    } else if (window.__pgCurrentMode === 'svgs') {\n      const fsSvg = document.createElement('div');\n      fsSvg.className = 'w-full max-h-[80vh] flex items-center justify-center p-8';\n      fsSvg.innerHTML = window.buildSvgContent(userPrompt, null, theme, model);\n      container.appendChild(fsSvg);\n    }\n  };\n\n  window.closeFullscreenSandbox = function() {\n    const modal = document.getElementById('pg-fullscreen-modal');\n    if (modal) modal.classList.add('hidden');\n    const container = document.getElementById('pg-fullscreen-container');\n    if (container) container.innerHTML = '';\n  };\n\n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') window.closeFullscreenSandbox();\n  });\n\n  // Execute Live Preview with Dynamic Style + Prompt + Model Binding\n  window.executeLivePreview = function(refinement) {\n    window.__pgHasGenerated = true;\n    window.resetExecutionContext();\n\n    const emptyState = document.getElementById('pg-empty-state');\n    const canvas = document.getElementById('pg-game-canvas');\n    const iframe = document.getElementById('pg-site-iframe');\n    const svgBox = document.getElementById('pg-svg-container');\n    const activeTitle = document.getElementById('pg-active-title');\n    const metricStatus = document.getElementById('pg-metric-status');\n    const modelBadge = document.getElementById('pg-model-badge');\n    const styleBadge = document.getElementById('pg-style-badge');\n    const fsBtn = document.getElementById('pg-fs-btn');\n    const reloadBtn = document.getElementById('pg-reload-btn');\n\n    if (emptyState) emptyState.classList.add('hidden');\n    if (metricStatus) {\n      metricStatus.innerText = 'Live';\n      metricStatus.className = 'px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 font-semibold text-[10px]';\n    }\n    if (fsBtn) { fsBtn.disabled = false; fsBtn.classList.remove('opacity-50', 'cursor-not-allowed'); }\n    if (reloadBtn) { reloadBtn.disabled = false; reloadBtn.classList.remove('opacity-50', 'cursor-not-allowed'); }\n\n    // Resolve Theme and Model\n    const theme = window.resolveActiveTheme();\n    const model = window.__pgSelectedModel;\n\n    // Badges\n    if (modelBadge) {\n      modelBadge.classList.remove('hidden');\n      modelBadge.innerText = `:${model} (${model === 'micro' ? '0.5B' : model === 'mini' ? '1.5B' : '3B'})`;\n    }\n    if (styleBadge) {\n      styleBadge.classList.remove('hidden');\n      styleBadge.innerText = theme.name;\n    }\n\n    // Resolve Prompt Text from Slot 2\n    const slot2 = document.getElementById('pg-prompt-slot-2');\n    const userPrompt = (slot2 ? slot2.value : '').trim();\n    const list = PROMPT_PRESETS[window.__pgCurrentMode] || [];\n    const preset = list.find(p => p.id === window.__pgActivePromptId);\n    const isExactPreset = preset && preset.prompt.trim() === userPrompt;\n    let title = isExactPreset ? preset.title : (userPrompt ? (userPrompt.slice(0, 32) + (userPrompt.length > 32 ? '...' : '')) : 'Custom Generation');\n    if (activeTitle) activeTitle.innerText = `${title} — ${theme.name}`;\n\n    window.updateMetrics();\n\n    if (window.__pgCurrentMode === 'games') {\n      if (canvas) canvas.classList.remove('hidden');\n      if (iframe) iframe.classList.add('hidden');\n      if (svgBox) svgBox.classList.add('hidden');\n      if (canvas) window.runToyEngine(userPrompt, canvas, refinement, theme, model);\n    } else if (window.__pgCurrentMode === 'websites') {\n      if (canvas) canvas.classList.add('hidden');\n      if (iframe) iframe.classList.remove('hidden');\n      if (svgBox) svgBox.classList.add('hidden');\n      if (iframe) iframe.srcdoc = window.buildWebsiteContent(userPrompt, refinement, theme, model);\n    } else if (window.__pgCurrentMode === 'svgs') {\n      if (canvas) canvas.classList.add('hidden');\n      if (iframe) iframe.classList.add('hidden');\n      if (svgBox) svgBox.classList.remove('hidden');\n      if (svgBox) svgBox.innerHTML = window.buildSvgContent(userPrompt, refinement, theme, model);\n    }\n  };\n\n  window.updateMetrics = function() {\n    const tMap = { micro: '480', mini: '1,248', small: '2,890' };\n    const lMap = { micro: '0.008 ms', mini: '0.018 ms', small: '0.034 ms' };\n    \n    const tEl = document.getElementById('pg-metric-tokens');\n    const lEl = document.getElementById('pg-metric-latency');\n    if (tEl) tEl.innerText = tMap[window.__pgSelectedModel] || '1,248';\n    if (lEl) lEl.innerText = lMap[window.__pgSelectedModel] || '0.018 ms';\n  };\n\n  // -------------------------------------------------------------\n  // Dynamic SVGs Generator (Phase 2 Execution at T=0.0)\n  // Generates real vector graphics matching prompt and style\n  // -------------------------------------------------------------\n  window.buildSvgContent = function(promptText, ref, theme, model) {\n    theme = theme || window.resolveActiveTheme();\n    model = model || window.__pgSelectedModel;\n    const text = (promptText || '').toLowerCase();\n\n    const isPixel = theme.pixelated;\n    const isMono = theme.mono;\n    const isWire = theme.wireframe;\n    const isBlueprint = theme.blueprint;\n    const glowClass = theme.glow ? `drop-shadow-[0_0_25px_${theme.primary}88]` : '';\n\n    // 1. ASL Chameleon Mascot\n    if (text.includes('chameleon') || text.includes('mascot') || text.includes('lizard')) {\n      if (isPixel) {\n        return `<svg viewBox=\"0 0 360 360\" class=\"w-80 h-80\">\n          <rect width=\"360\" height=\"360\" fill=\"${theme.bg}\"/>\n          <!-- Branch perch -->\n          <rect x=\"20\" y=\"240\" width=\"320\" height=\"24\" fill=\"${theme.secondary}\"/>\n          <!-- Pixel Chameleon body & curled tail -->\n          <g fill=\"${theme.primary}\">\n            <rect x=\"80\" y=\"80\" width=\"40\" height=\"20\"/><rect x=\"120\" y=\"60\" width=\"60\" height=\"20\"/>\n            <rect x=\"180\" y=\"60\" width=\"40\" height=\"20\"/><rect x=\"220\" y=\"80\" width=\"40\" height=\"40\"/>\n            <rect x=\"80\" y=\"100\" width=\"40\" height=\"60\"/><rect x=\"120\" y=\"80\" width=\"100\" height=\"80\"/>\n            <rect x=\"140\" y=\"160\" width=\"80\" height=\"80\"/><rect x=\"220\" y=\"180\" width=\"40\" height=\"60\"/>\n            <!-- Curled tail spiral -->\n            <rect x=\"240\" y=\"140\" width=\"40\" height=\"40\"/><rect x=\"260\" y=\"100\" width=\"40\" height=\"40\"/>\n            <rect x=\"240\" y=\"80\" width=\"20\" height=\"20\"/><rect x=\"220\" y=\"80\" width=\"20\" height=\"20\"/>\n            <!-- Legs gripping branch -->\n            <rect x=\"120\" y=\"220\" width=\"20\" height=\"40\"/><rect x=\"200\" y=\"220\" width=\"20\" height=\"40\"/>\n          </g>\n          <!-- Back crest ridges -->\n          <g fill=\"${theme.accent}\">\n            <rect x=\"110\" y=\"45\" width=\"15\" height=\"15\"/><rect x=\"135\" y=\"45\" width=\"15\" height=\"15\"/>\n            <rect x=\"160\" y=\"45\" width=\"15\" height=\"15\"/><rect x=\"185\" y=\"45\" width=\"15\" height=\"15\"/>\n          </g>\n          <!-- Eye -->\n          <rect x=\"95\" y=\"95\" width=\"25\" height=\"25\" fill=\"${theme.bg}\"/>\n          <rect x=\"100\" y=\"100\" width=\"15\" height=\"15\" fill=\"${theme.accent}\"/>\n          <rect x=\"105\" y=\"105\" width=\"6\" height=\"6\" fill=\"#ffffff\"/>\n          <text x=\"180\" y=\"320\" text-anchor=\"middle\" fill=\"${theme.text}\" font-family=\"monospace\" font-size=\"12\" font-weight=\"bold\">ASL CHAMELEON &bull; PIXEL 16-BIT</text>\n        </svg>`;\n      } else if (isMono) {\n        return `<svg viewBox=\"0 0 400 400\" class=\"w-80 h-80\">\n          <rect width=\"400\" height=\"400\" fill=\"#000000\"/>\n          <circle cx=\"200\" cy=\"200\" r=\"150\" fill=\"none\" stroke=\"#333333\" stroke-width=\"1\"/>\n          <!-- Branch -->\n          <line x1=\"30\" y1=\"270\" x2=\"370\" y2=\"270\" stroke=\"#ffffff\" stroke-width=\"2\"/>\n          <!-- Chameleon Contour -->\n          <path d=\"M 270,270 C 310,230 330,160 290,110 C 250,70 180,60 130,80 C 80,100 50,150 60,200 C 70,240 100,270 140,270 C 180,270 200,240 200,210 C 200,180 180,160 150,170 C 130,175 120,195 130,210\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"3\"/>\n          <circle cx=\"95\" cy=\"145\" r=\"16\" fill=\"#000000\" stroke=\"#ffffff\" stroke-width=\"2.5\"/>\n          <circle cx=\"98\" cy=\"143\" r=\"5\" fill=\"#ffffff\"/>\n          <text x=\"200\" y=\"350\" text-anchor=\"middle\" fill=\"#ffffff\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"bold\" letter-spacing=\"4\">AGENT SCRIPT CHAMELEON</text>\n        </svg>`;\n      } else {\n        return `<svg viewBox=\"0 0 400 400\" class=\"w-80 h-80 ${glowClass}\">\n          <defs>\n            <linearGradient id=\"chamGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n              <stop offset=\"0%\" stop-color=\"${theme.primary}\"/>\n              <stop offset=\"50%\" stop-color=\"${theme.secondary}\"/>\n              <stop offset=\"100%\" stop-color=\"${theme.accent}\"/>\n            </linearGradient>\n          </defs>\n          <!-- Background accent halo -->\n          <circle cx=\"200\" cy=\"200\" r=\"140\" fill=\"${theme.primary}08\" stroke=\"${theme.primary}22\" stroke-width=\"1.5\" stroke-dasharray=\"6 4\"/>\n          <!-- Branch Perch -->\n          <path d=\"M 40,270 Q 200,285 360,265\" stroke=\"${theme.secondary}\" stroke-width=\"8\" stroke-linecap=\"round\" fill=\"none\"/>\n          <!-- Chameleon Body & Curled Tail -->\n          <path d=\"M 280,270 C 330,240 350,150 300,95 C 260,50 170,40 120,70 C 70,100 45,155 55,210 C 65,255 105,275 145,275 C 190,275 220,245 220,210 C 220,175 195,150 165,160 C 145,165 135,185 145,200\" fill=\"none\" stroke=\"url(#chamGrad)\" stroke-width=\"${isWire ? '4' : '18'}\" stroke-linecap=\"round\"/>\n          <!-- Back Ridges -->\n          <polygon points=\"150,55 158,40 166,55\" fill=\"${theme.accent}\"/>\n          <polygon points=\"180,48 188,33 196,48\" fill=\"${theme.accent}\"/>\n          <polygon points=\"210,48 218,33 226,48\" fill=\"${theme.accent}\"/>\n          <!-- Eye -->\n          <circle cx=\"100\" cy=\"130\" r=\"20\" fill=\"${theme.bg}\" stroke=\"${theme.primary}\" stroke-width=\"4\"/>\n          <circle cx=\"104\" cy=\"128\" r=\"8\" fill=\"${theme.accent}\"/>\n          <circle cx=\"107\" cy=\"125\" r=\"3\" fill=\"#ffffff\"/>\n          <text x=\"200\" y=\"345\" text-anchor=\"middle\" fill=\"${theme.text}\" font-family=\"${theme.font}\" font-size=\"13\" font-weight=\"bold\">${theme.name.toUpperCase()} MASCOT</text>\n        </svg>`;\n      }\n    }\n\n    // 2. Orbital Space Station\n    if (text.includes('station') || text.includes('orbital') || (text.includes('space') && !text.includes('shooter'))) {\n      return `<svg viewBox=\"0 0 500 400\" class=\"w-84 h-72 ${glowClass}\">\n        <defs>\n          <linearGradient id=\"panelGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n            <stop offset=\"0%\" stop-color=\"${theme.primary}\"/>\n            <stop offset=\"100%\" stop-color=\"${theme.secondary}\"/>\n          </linearGradient>\n        </defs>\n        <rect width=\"500\" height=\"400\" fill=\"${theme.bg}\"/>\n        <!-- Stars -->\n        <circle cx=\"60\" cy=\"80\" r=\"1.5\" fill=\"#ffffff\"/><circle cx=\"120\" cy=\"320\" r=\"1.5\" fill=\"#ffffff\"/>\n        <circle cx=\"420\" cy=\"90\" r=\"2\" fill=\"${theme.primary}\"/><circle cx=\"450\" cy=\"300\" r=\"1\" fill=\"#ffffff\"/>\n        <circle cx=\"280\" cy=\"40\" r=\"1.5\" fill=\"#ffffff\"/><circle cx=\"80\" cy=\"200\" r=\"2\" fill=\"${theme.accent}\"/>\n        <!-- Rotating Torus Rings -->\n        <ellipse cx=\"250\" cy=\"200\" rx=\"140\" ry=\"60\" fill=\"none\" stroke=\"${theme.primary}\" stroke-width=\"${isPixel ? '6' : '3'}\" stroke-dasharray=\"${isWire ? '10 5' : 'none'}\"/>\n        <ellipse cx=\"250\" cy=\"200\" rx=\"110\" ry=\"46\" fill=\"none\" stroke=\"${theme.accent}\" stroke-width=\"2\"/>\n        <!-- Central Hub Module -->\n        <rect x=\"235\" y=\"130\" width=\"30\" height=\"140\" rx=\"${isPixel ? '0' : '8'}\" fill=\"${theme.cardBg}\" stroke=\"${theme.primary}\" stroke-width=\"2.5\"/>\n        <circle cx=\"250\" cy=\"200\" r=\"20\" fill=\"${theme.secondary}\" stroke=\"#ffffff\" stroke-width=\"2\"/>\n        <!-- Solar Photovoltaic Panels (Left & Right) -->\n        <g stroke=\"${theme.text}\" stroke-width=\"1\">\n          <rect x=\"50\" y=\"180\" width=\"80\" height=\"40\" fill=\"url(#panelGrad)\"/>\n          <line x1=\"50\" y1=\"200\" x2=\"130\" y2=\"200\"/><line x1=\"76\" y1=\"180\" x2=\"76\" y2=\"220\"/><line x1=\"103\" y1=\"180\" x2=\"103\" y2=\"220\"/>\n          <rect x=\"370\" y=\"180\" width=\"80\" height=\"40\" fill=\"url(#panelGrad)\"/>\n          <line x1=\"370\" y1=\"200\" x2=\"450\" y2=\"200\"/><line x1=\"396\" y1=\"180\" x2=\"396\" y2=\"220\"/><line x1=\"423\" y1=\"180\" x2=\"423\" y2=\"220\"/>\n        </g>\n        <!-- Approach Shuttle with thruster trail -->\n        <polygon points=\"340,90 320,105 340,120\" fill=\"${theme.accent}\"/>\n        <line x1=\"340\" y1=\"105\" x2=\"370\" y2=\"105\" stroke=\"${theme.primary}\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n        <text x=\"250\" y=\"340\" text-anchor=\"middle\" fill=\"${theme.text}\" font-family=\"${theme.font}\" font-size=\"13\" font-weight=\"bold\">ORBITAL RESEARCH STATION &bull; :${model.toUpperCase()}</text>\n      </svg>`;\n    }\n\n    // 3. Cyber Mecha Feline\n    if (/\bcats?\b/i.test(text) || text.includes('feline') || text.includes('mecha cat')) {\n      return `<svg viewBox=\"0 0 400 400\" class=\"w-80 h-80 ${glowClass}\">\n        <rect width=\"400\" height=\"400\" fill=\"${theme.bg}\"/>\n        <!-- Carbon fiber Ears -->\n        <polygon points=\"120,160 80,60 160,110\" fill=\"${theme.cardBg}\" stroke=\"${theme.primary}\" stroke-width=\"3\"/>\n        <polygon points=\"280,160 320,60 240,110\" fill=\"${theme.cardBg}\" stroke=\"${theme.primary}\" stroke-width=\"3\"/>\n        <polygon points=\"105,100 90,75 130,105\" fill=\"${theme.accent}\"/>\n        <polygon points=\"295,100 310,75 270,105\" fill=\"${theme.accent}\"/>\n        <!-- Mecha Head Structure -->\n        <polygon points=\"120,160 200,120 280,160 310,250 200,320 90,250\" fill=\"${theme.cardBg}\" stroke=\"${theme.border}\" stroke-width=\"3.5\"/>\n        <!-- Titanium Forehead Processor Crest -->\n        <polygon points=\"180,140 200,125 220,140 200,180\" fill=\"${theme.primary}\"/>\n        <!-- Cybernetic Visor / Glowing Optics -->\n        <rect x=\"110\" y=\"190\" width=\"70\" height=\"24\" rx=\"${isPixel ? '0' : '4'}\" fill=\"${theme.accent}\"/>\n        <rect x=\"220\" y=\"190\" width=\"70\" height=\"24\" rx=\"${isPixel ? '0' : '4'}\" fill=\"${theme.accent}\"/>\n        <line x1=\"100\" y1=\"202\" x2=\"300\" y2=\"202\" stroke=\"#ffffff\" stroke-width=\"2\"/>\n        <!-- Wireframe Whiskers -->\n        <line x1=\"70\" y1=\"230\" x2=\"20\" y2=\"210\" stroke=\"${theme.primary}\" stroke-width=\"2\"/>\n        <line x1=\"70\" y1=\"245\" x2=\"10\" y2=\"245\" stroke=\"${theme.primary}\" stroke-width=\"2\"/>\n        <line x1=\"330\" y1=\"230\" x2=\"380\" y2=\"210\" stroke=\"${theme.primary}\" stroke-width=\"2\"/>\n        <line x1=\"330\" y1=\"245\" x2=\"390\" y2=\"245\" stroke=\"${theme.primary}\" stroke-width=\"2\"/>\n        <!-- Snout & Mouth Grid -->\n        <polygon points=\"190,250 210,250 200,265\" fill=\"${theme.primary}\"/>\n        <line x1=\"200\" y1=\"265\" x2=\"200\" y2=\"280\" stroke=\"${theme.primary}\" stroke-width=\"2\"/>\n        <text x=\"200\" y=\"360\" text-anchor=\"middle\" fill=\"${theme.text}\" font-family=\"${theme.font}\" font-size=\"12\" font-weight=\"bold\">CYBER MECHA FELINE &bull; [${theme.name}]</text>\n      </svg>`;\n    }\n\n    // 4. Isometric Megacity\n    if (text.includes('city') || text.includes('metropolis') || text.includes('megacity') || text.includes('isometric')) {\n      return `<svg viewBox=\"0 0 500 420\" class=\"w-84 h-72 ${glowClass}\">\n        <rect width=\"500\" height=\"420\" fill=\"${theme.bg}\"/>\n        <!-- Isometric Grid Ground -->\n        <g stroke=\"${theme.primary}33\" stroke-width=\"1\">\n          <line x1=\"250\" y1=\"20\" x2=\"480\" y2=\"150\"/><line x1=\"250\" y1=\"20\" x2=\"20\" y2=\"150\"/>\n          <line x1=\"20\" y1=\"150\" x2=\"250\" y2=\"280\"/><line x1=\"480\" y1=\"150\" x2=\"250\" y2=\"280\"/>\n        </g>\n        <!-- Building 1 (Center High Tower) -->\n        <polygon points=\"250,70 300,100 250,130 200,100\" fill=\"${theme.primary}\"/>\n        <polygon points=\"200,100 250,130 250,300 200,270\" fill=\"${theme.cardBg}\" stroke=\"${theme.primary}\" stroke-width=\"1.5\"/>\n        <polygon points=\"250,130 300,100 300,270 250,300\" fill=\"${theme.bg}\" stroke=\"${theme.primary}\" stroke-width=\"1.5\"/>\n        <!-- Spire with antenna beacon -->\n        <line x1=\"250\" y1=\"70\" x2=\"250\" y2=\"30\" stroke=\"${theme.accent}\" stroke-width=\"3\"/>\n        <circle cx=\"250\" cy=\"30\" r=\"4\" fill=\"${theme.accent}\"/>\n        <!-- Building 2 (Left Tower) -->\n        <polygon points=\"120,160 160,185 120,210 80,185\" fill=\"${theme.secondary}\"/>\n        <polygon points=\"80,185 120,210 120,320 80,295\" fill=\"${theme.cardBg}\" stroke=\"${theme.secondary}\" stroke-width=\"1.5\"/>\n        <polygon points=\"120,210 160,185 160,295 120,320\" fill=\"${theme.bg}\" stroke=\"${theme.secondary}\" stroke-width=\"1.5\"/>\n        <!-- Skybridge Connect -->\n        <polygon points=\"160,220 200,200 200,215 160,235\" fill=\"${theme.accent}\" opacity=\"0.85\"/>\n        <!-- Building 3 (Right Tower) -->\n        <polygon points=\"380,150 420,175 380,200 340,175\" fill=\"${theme.primary}\"/>\n        <polygon points=\"340,175 380,200 380,330 340,305\" fill=\"${theme.cardBg}\" stroke=\"${theme.primary}\" stroke-width=\"1.5\"/>\n        <polygon points=\"380,200 420,175 420,305 380,330\" fill=\"${theme.bg}\" stroke=\"${theme.primary}\" stroke-width=\"1.5\"/>\n        <!-- Hovercar with light trails -->\n        <ellipse cx=\"280\" cy=\"180\" rx=\"14\" ry=\"6\" fill=\"${theme.accent}\"/>\n        <line x1=\"294\" y1=\"180\" x2=\"330\" y2=\"175\" stroke=\"${theme.accent}\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n        <text x=\"250\" y=\"380\" text-anchor=\"middle\" fill=\"${theme.text}\" font-family=\"${theme.font}\" font-size=\"13\" font-weight=\"bold\">ISOMETRIC MEGACITY &bull; 30&deg; PROJECTION</text>\n      </svg>`;\n    }\n\n    // 5. Retro Cosmic Rocket\n    if (text.includes('rocket') || text.includes('launch') || text.includes('cosmos')) {\n      return `<svg viewBox=\"0 0 400 450\" class=\"w-80 h-80 ${glowClass}\">\n        <rect width=\"400\" height=\"450\" fill=\"${theme.bg}\"/>\n        <!-- Saturn Planet in background -->\n        <circle cx=\"320\" cy=\"90\" r=\"30\" fill=\"${theme.secondary}44\"/>\n        <ellipse cx=\"320\" cy=\"90\" rx=\"55\" ry=\"12\" fill=\"none\" stroke=\"${theme.secondary}\" stroke-width=\"2\" transform=\"rotate(-18 320 90)\"/>\n        <!-- Sweeping Fins -->\n        <polygon points=\"150,250 80,300 150,290\" fill=\"${theme.accent}\"/>\n        <polygon points=\"250,250 320,300 250,290\" fill=\"${theme.accent}\"/>\n        <!-- Streamlined Fuselage -->\n        <path d=\"M 200,60 C 240,140 250,240 240,290 L 160,290 C 150,240 160,140 200,60 Z\" fill=\"${theme.cardBg}\" stroke=\"${theme.primary}\" stroke-width=\"3.5\"/>\n        <!-- Porthole Window with Rivets -->\n        <circle cx=\"200\" cy=\"170\" r=\"24\" fill=\"${theme.bg}\" stroke=\"${theme.primary}\" stroke-width=\"4\"/>\n        <circle cx=\"200\" cy=\"170\" r=\"16\" fill=\"${theme.primary}55\"/>\n        <circle cx=\"195\" cy=\"165\" r=\"4\" fill=\"#ffffff\"/>\n        <!-- Exhaust Plume Flames -->\n        <polygon points=\"175,290 200,380 225,290\" fill=\"${theme.accent}\"/>\n        <polygon points=\"185,290 200,340 215,290\" fill=\"${theme.primary}\"/>\n        <text x=\"200\" y=\"415\" text-anchor=\"middle\" fill=\"${theme.text}\" font-family=\"${theme.font}\" font-size=\"13\" font-weight=\"bold\">ATOMIC AGE COSMIC ROCKET</text>\n      </svg>`;\n    }\n\n    // 6. Cyber Arcane Compass\n    if (text.includes('compass') || text.includes('arcane') || text.includes('navigation') || text.includes('astrolabe')) {\n      return `<svg viewBox=\"0 0 400 400\" class=\"w-80 h-80 ${glowClass}\">\n        <rect width=\"400\" height=\"400\" fill=\"${theme.bg}\"/>\n        <!-- Outer Astrolabe Ring -->\n        <circle cx=\"200\" cy=\"200\" r=\"150\" fill=\"none\" stroke=\"${theme.primary}\" stroke-width=\"3\" stroke-dasharray=\"8 4\"/>\n        <circle cx=\"200\" cy=\"200\" r=\"130\" fill=\"none\" stroke=\"${theme.secondary}\" stroke-width=\"1.5\"/>\n        <circle cx=\"200\" cy=\"200\" r=\"90\" fill=\"none\" stroke=\"${theme.accent}\" stroke-width=\"2\"/>\n        <!-- Degree Ticks -->\n        <g stroke=\"${theme.primary}\" stroke-width=\"1.5\">\n          <line x1=\"200\" y1=\"52\" x2=\"200\" y2=\"68\"/><line x1=\"200\" y1=\"332\" x2=\"200\" y2=\"348\"/>\n          <line x1=\"52\" y1=\"200\" x2=\"68\" y2=\"200\"/><line x1=\"332\" y1=\"200\" x2=\"348\" y2=\"200\"/>\n        </g>\n        <!-- Cardinal Labels -->\n        <text x=\"200\" y=\"85\" text-anchor=\"middle\" fill=\"${theme.primary}\" font-family=\"${theme.font}\" font-size=\"14\" font-weight=\"bold\">N</text>\n        <text x=\"200\" y=\"325\" text-anchor=\"middle\" fill=\"${theme.subtext}\" font-family=\"${theme.font}\" font-size=\"14\" font-weight=\"bold\">S</text>\n        <text x=\"315\" y=\"205\" text-anchor=\"middle\" fill=\"${theme.subtext}\" font-family=\"${theme.font}\" font-size=\"14\" font-weight=\"bold\">E</text>\n        <text x=\"85\" y=\"205\" text-anchor=\"middle\" fill=\"${theme.subtext}\" font-family=\"${theme.font}\" font-size=\"14\" font-weight=\"bold\">W</text>\n        <!-- Center Needle Diamond -->\n        <polygon points=\"200,100 212,200 200,190 188,200\" fill=\"${theme.primary}\"/>\n        <polygon points=\"200,300 212,200 200,210 188,200\" fill=\"${theme.accent}\"/>\n        <circle cx=\"200\" cy=\"200\" r=\"10\" fill=\"${theme.cardBg}\" stroke=\"#ffffff\" stroke-width=\"2\"/>\n        <text x=\"200\" y=\"375\" text-anchor=\"middle\" fill=\"${theme.text}\" font-family=\"${theme.font}\" font-size=\"12\" font-weight=\"bold\">CYBER ARCANE COMPASS &bull; :${model.toUpperCase()}</text>\n      </svg>`;\n    }\n\n    // 7. Geometric Origami Falcon\n    if (text.includes('falcon') || text.includes('eagle') || text.includes('origami')) {\n      return `<svg viewBox=\"0 0 500 400\" class=\"w-84 h-72 ${glowClass}\">\n        <rect width=\"500\" height=\"400\" fill=\"${theme.bg}\"/>\n        <!-- Folded Left Wing Facets -->\n        <polygon points=\"250,140 100,60 170,180\" fill=\"${theme.primary}\"/>\n        <polygon points=\"170,180 60,110 140,230\" fill=\"${theme.secondary}\"/>\n        <polygon points=\"140,230 40,180 160,260\" fill=\"${theme.accent}\"/>\n        <!-- Folded Right Wing Facets -->\n        <polygon points=\"250,140 400,60 330,180\" fill=\"${theme.primary}\"/>\n        <polygon points=\"330,180 440,110 360,230\" fill=\"${theme.secondary}\"/>\n        <polygon points=\"360,230 460,180 340,260\" fill=\"${theme.accent}\"/>\n        <!-- Center Head & Beak -->\n        <polygon points=\"250,100 230,140 270,140\" fill=\"${theme.primary}\"/>\n        <polygon points=\"250,100 250,60 260,85\" fill=\"${theme.accent}\"/>\n        <!-- Torso & Tail Plumage -->\n        <polygon points=\"230,140 270,140 250,270\" fill=\"${theme.cardBg}\" stroke=\"${theme.primary}\" stroke-width=\"2\"/>\n        <polygon points=\"250,270 220,330 250,315 280,330\" fill=\"${theme.accent}\"/>\n        <text x=\"250\" y=\"370\" text-anchor=\"middle\" fill=\"${theme.text}\" font-family=\"${theme.font}\" font-size=\"13\" font-weight=\"bold\">ORIGAMI GEOMETRIC FALCON</text>\n      </svg>`;\n    }\n\n    // 8. Circuit Matrix Skull\n    if (text.includes('skull') || text.includes('matrix') || text.includes('pcb') || text.includes('circuit')) {\n      return `<svg viewBox=\"0 0 400 420\" class=\"w-80 h-80 ${glowClass}\">\n        <rect width=\"400\" height=\"420\" fill=\"${theme.bg}\"/>\n        <!-- Cranium Silhouette -->\n        <path d=\"M 120,240 C 90,190 90,100 200,90 C 310,90 310,190 280,240 L 265,270 L 135,270 Z\" fill=\"${theme.cardBg}\" stroke=\"${theme.primary}\" stroke-width=\"3\"/>\n        <!-- Eye Sockets with Camera Sensors -->\n        <circle cx=\"155\" cy=\"180\" r=\"26\" fill=\"${theme.bg}\" stroke=\"${theme.accent}\" stroke-width=\"3\"/>\n        <circle cx=\"245\" cy=\"180\" r=\"26\" fill=\"${theme.bg}\" stroke=\"${theme.accent}\" stroke-width=\"3\"/>\n        <circle cx=\"155\" cy=\"180\" r=\"10\" fill=\"${theme.primary}\"/>\n        <circle cx=\"245\" cy=\"180\" r=\"10\" fill=\"${theme.primary}\"/>\n        <!-- PCB Traces on Cranium -->\n        <g stroke=\"${theme.secondary}\" stroke-width=\"2\" fill=\"none\">\n          <polyline points=\"200,90 200,140 180,160\"/><circle cx=\"180\" cy=\"160\" r=\"3\" fill=\"${theme.secondary}\"/>\n          <polyline points=\"130,120 160,120 170,140\"/><circle cx=\"170\" cy=\"140\" r=\"3\" fill=\"${theme.secondary}\"/>\n          <polyline points=\"270,120 240,120 230,140\"/><circle cx=\"230\" cy=\"140\" r=\"3\" fill=\"${theme.secondary}\"/>\n        </g>\n        <!-- Teeth as Microchip IC Pins -->\n        <g fill=\"${theme.primary}\">\n          <rect x=\"150\" y=\"280\" width=\"14\" height=\"24\"/><rect x=\"172\" y=\"280\" width=\"14\" height=\"24\"/>\n          <rect x=\"194\" y=\"280\" width=\"14\" height=\"24\"/><rect x=\"216\" y=\"280\" width=\"14\" height=\"24\"/>\n          <rect x=\"238\" y=\"280\" width=\"14\" height=\"24\"/>\n        </g>\n        <text x=\"200\" y=\"375\" text-anchor=\"middle\" fill=\"${theme.text}\" font-family=\"monospace\" font-size=\"13\" font-weight=\"bold\">CIRCUIT MATRIX SKULL</text>\n      </svg>`;\n    }\n\n    // 9. Dynamic Procedural Synthesis for Arbitrary Prompts (T=0.0 compilation of high-temp plan)\n    const seedWords = (promptText || 'cyber artifact').split(/\\s+/);\n    const mainWord = seedWords[0].toUpperCase();\n    return `<svg viewBox=\"0 0 450 400\" class=\"w-84 h-72 ${glowClass}\">\n      <defs>\n        <linearGradient id=\"customGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"${theme.primary}\"/>\n          <stop offset=\"100%\" stop-color=\"${theme.accent}\"/>\n        </linearGradient>\n      </defs>\n      <rect width=\"450\" height=\"400\" fill=\"${theme.bg}\"/>\n      <!-- Structural Frame Geometry -->\n      <rect x=\"30\" y=\"30\" width=\"390\" height=\"340\" rx=\"${isPixel ? '0' : '16'}\" fill=\"${theme.cardBg}\" stroke=\"${theme.border}\" stroke-width=\"${isPixel ? '4' : '2'}\"/>\n      <!-- Concentric Hexagon / Sigil Core -->\n      <polygon points=\"225,90 310,140 310,240 225,290 140,240 140,140\" fill=\"none\" stroke=\"url(#customGrad)\" stroke-width=\"3.5\" stroke-dasharray=\"${isWire ? '8 4' : 'none'}\"/>\n      <circle cx=\"225\" cy=\"190\" r=\"45\" fill=\"${theme.primary}18\" stroke=\"${theme.accent}\" stroke-width=\"2\"/>\n      <polygon points=\"225,160 250,205 200,205\" fill=\"${theme.primary}\"/>\n      <!-- Decorative HUD Elements -->\n      <line x1=\"60\" y1=\"70\" x2=\"120\" y2=\"70\" stroke=\"${theme.primary}\" stroke-width=\"3\"/>\n      <line x1=\"330\" y1=\"70\" x2=\"390\" y2=\"70\" stroke=\"${theme.accent}\" stroke-width=\"3\"/>\n      <text x=\"225\" y=\"325\" text-anchor=\"middle\" fill=\"${theme.text}\" font-family=\"${theme.font}\" font-size=\"14\" font-weight=\"bold\">${mainWord} ARTIFACT</text>\n      <text x=\"225\" y=\"348\" text-anchor=\"middle\" fill=\"${theme.subtext}\" font-family=\"monospace\" font-size=\"11\">[${theme.name}] &bull; Model :${model}</text>\n    </svg>`;\n  };\n\n  // -------------------------------------------------------------\n  // Dynamic Websites Generator (Phase 2 Execution at T=0.0)\n  // Generates real, interactive web applications inside iframe\n  // -------------------------------------------------------------\n  window.buildWebsiteContent = function(promptText, ref, theme, model) {\n    theme = theme || window.resolveActiveTheme();\n    model = model || window.__pgSelectedModel;\n    const text = (promptText || '').toLowerCase();\n\n    const isGlass = theme.glass;\n    const isBrutal = theme.brutal;\n    const isPixel = theme.pixelated;\n    const isMono = theme.mono;\n\n    let borderStyle = isBrutal ? '3px solid ' + theme.primary : isGlass ? '1px solid rgba(255,255,255,0.22)' : isPixel ? '4px solid ' + theme.primary : '1px solid ' + theme.border;\n    let radius = isBrutal ? '0px' : isPixel ? '4px' : isGlass ? '24px' : '16px';\n    let btnRadius = isBrutal ? '0px' : isPixel ? '2px' : '10px';\n\n    // 1. CyberKicks Sneaker Store\n    if (text.includes('sneaker') || text.includes('kicks') || text.includes('shoe')) {\n      return `<!DOCTYPE html><html><head><meta charset=\"utf-8\"/>\n      <style>\n        body { margin:0; padding:20px; background:${theme.bg}; color:${theme.text}; font-family:${theme.font}; box-sizing:border-box; display:flex; justify-content:center; }\n        .app { width:100%; max-width:620px; background:${theme.cardBg}; border:${borderStyle}; border-radius:${radius}; padding:24px; box-shadow:0 25px 50px rgba(0,0,0,0.6); }\n        .nav { display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:12px; margin-bottom:20px; }\n        .logo { font-size:18px; font-weight:800; color:${theme.primary}; display:flex; align-items:center; gap:8px; }\n        .cart-badge { background:${theme.accent}; color:#fff; font-size:11px; padding:3px 8px; border-radius:999px; font-weight:700; cursor:pointer; }\n        .canvas-box { width:100%; height:180px; background:rgba(0,0,0,0.3); border-radius:${btnRadius}; display:flex; align-items:center; justify-content:center; margin-bottom:16px; position:relative; }\n        .swatches { display:flex; gap:10px; margin-bottom:16px; }\n        .swatch { width:26px; height:26px; border-radius:50%; cursor:pointer; border:2px solid #fff; transition:transform 0.1s; }\n        .swatch:hover { transform:scale(1.15); }\n        .sizes { display:flex; gap:8px; margin-bottom:20px; }\n        .size-btn { padding:6px 14px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); color:${theme.text}; border-radius:${btnRadius}; cursor:pointer; font-weight:600; font-size:12px; }\n        .size-btn.active { background:${theme.primary}; color:#000; border-color:${theme.primary}; }\n        .buy-btn { width:100%; padding:12px; background:${theme.primary}; color:${isMono ? '#000' : '#0a0a14'}; font-weight:800; font-size:14px; border:none; border-radius:${btnRadius}; cursor:pointer; transition:opacity 0.2s; }\n        .buy-btn:hover { opacity:0.9; }\n        .toast { position:fixed; bottom:20px; left:50%; transform:translateX(-50%); background:${theme.accent}; color:#fff; padding:10px 20px; border-radius:8px; font-size:12px; font-weight:700; display:none; }\n      </style></head><body>\n      <div class=\"app\">\n        <div class=\"nav\">\n          <div class=\"logo\"><span>CYBERKICKS</span><span style=\"font-size:10px; color:${theme.subtext}; font-weight:400;\">v2.5</span></div>\n          <div class=\"cart-badge\" onclick=\"alert('Cart contains ' + cartCount + ' item(s). Total: $' + (cartCount * 189))\">🛒 Cart: <span id=\"cart-num\">0</span></div>\n        </div>\n        <div class=\"canvas-box\">\n          <svg id=\"sneaker-svg\" viewBox=\"0 0 300 150\" class=\"w-64 h-36\">\n            <path id=\"snk-body\" d=\"M 40,110 L 80,40 L 150,50 L 220,80 L 270,110 Z\" fill=\"${theme.primary}\" stroke=\"#ffffff\" stroke-width=\"2\"/>\n            <path id=\"snk-swoosh\" d=\"M 100,70 Q 180,90 240,75\" stroke=\"${theme.accent}\" stroke-width=\"6\" fill=\"none\" stroke-linecap=\"round\"/>\n            <rect id=\"snk-sole\" x=\"30\" y=\"110\" width=\"250\" height=\"20\" rx=\"6\" fill=\"${theme.secondary}\"/>\n          </svg>\n        </div>\n        <div style=\"font-size:12px; color:${theme.subtext}; margin-bottom:6px;\">COLORWAY:</div>\n        <div class=\"swatches\">\n          <div class=\"swatch\" style=\"background:#00f0ff;\" onclick=\"changeColor('#00f0ff', '#ff0055', '#a855f7')\"></div>\n          <div class=\"swatch\" style=\"background:#facc15;\" onclick=\"changeColor('#facc15', '#e11d48', '#38bdf8')\"></div>\n          <div class=\"swatch\" style=\"background:#34d399;\" onclick=\"changeColor('#34d399', '#f59e0b', '#059669')\"></div>\n          <div class=\"swatch\" style=\"background:#ffffff;\" onclick=\"changeColor('#ffffff', '#71717a', '#000000')\"></div>\n        </div>\n        <div style=\"font-size:12px; color:${theme.subtext}; margin-bottom:6px;\">SELECT SIZE (US):</div>\n        <div class=\"sizes\">\n          <button class=\"size-btn active\" onclick=\"selectSize(this)\">8.5</button>\n          <button class=\"size-btn\" onclick=\"selectSize(this)\">9.0</button>\n          <button class=\"size-btn\" onclick=\"selectSize(this)\">10.0</button>\n          <button class=\"size-btn\" onclick=\"selectSize(this)\">11.0</button>\n        </div>\n        <button class=\"buy-btn\" onclick=\"addToCart()\">ADD TO CART &bull; $189</button>\n      </div>\n      <div id=\"toast\" class=\"toast\">Added to cart!</div>\n      <script>\n        let cartCount = 0;\n        function changeColor(body, swoosh, sole) {\n          document.getElementById('snk-body').setAttribute('fill', body);\n          document.getElementById('snk-swoosh').setAttribute('stroke', swoosh);\n          document.getElementById('snk-sole').setAttribute('fill', sole);\n        }\n        function selectSize(btn) {\n          document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));\n          btn.classList.add('active');\n        }\n        function addToCart() {\n          cartCount++;\n          document.getElementById('cart-num').innerText = cartCount;\n          const t = document.getElementById('toast');\n          t.style.display = 'block';\n          setTimeout(() => { t.style.display = 'none'; }, 1500);\n        }\n      <\\/script></body></html>`;\n    }\n\n    // 2. Sushi Omakase Experience\n    if (text.includes('omakase') || text.includes('sushi') || text.includes('dining')) {\n      return `<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><style>\n        body { margin:0; padding:20px; background:${theme.bg}; color:${theme.text}; font-family:${theme.font}; box-sizing:border-box; display:flex; justify-content:center; }\n        .card { width:100%; max-width:620px; background:${theme.cardBg}; border:${borderStyle}; border-radius:${radius}; padding:24px; box-shadow:0 25px 50px rgba(0,0,0,0.7); }\n        .tabs { display:flex; gap:8px; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:10px; margin-bottom:16px; }\n        .tab { padding:6px 12px; border-radius:${btnRadius}; background:rgba(255,255,255,0.05); color:${theme.subtext}; cursor:pointer; font-size:12px; font-weight:700; }\n        .tab.active { background:${theme.primary}25; color:${theme.primary}; border:1px solid ${theme.primary}; }\n        .course-box { padding:14px; background:rgba(0,0,0,0.25); border-radius:${btnRadius}; margin-bottom:16px; border:1px solid rgba(255,255,255,0.05); }\n        .time-slots { display:flex; gap:8px; margin-bottom:16px; }\n        .slot-btn { flex:1; padding:8px; text-align:center; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:${btnRadius}; color:${theme.text}; cursor:pointer; font-size:11px; }\n        .slot-btn.active { background:${theme.accent}; color:#fff; border-color:${theme.accent}; font-weight:bold; }\n        .book-btn { width:100%; padding:12px; background:${theme.primary}; color:#000; font-weight:800; font-size:13px; border:none; border-radius:${btnRadius}; cursor:pointer; }\n      </style></head><body>\n      <div class=\"card\">\n        <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;\">\n          <div><h2 style=\"margin:0; font-size:18px; color:${theme.primary};\">鮨 OMAKASE HANES</h2><span style=\"font-size:11px; color:${theme.subtext};\">Tokyo Degustation Experience</span></div>\n          <span style=\"background:${theme.accent}33; color:${theme.accent}; padding:3px 10px; border-radius:999px; font-size:10px; font-weight:bold;\">MICHELIN 2026</span>\n        </div>\n        <div class=\"tabs\">\n          <div class=\"tab active\" onclick=\"showCourse(0, this)\">Course 1: Nigiri</div>\n          <div class=\"tab\" onclick=\"showCourse(1, this)\">Course 2: Wagyu</div>\n          <div class=\"tab\" onclick=\"showCourse(2, this)\">Course 3: Uni</div>\n        </div>\n        <div id=\"course-desc\" class=\"course-box\">\n          <strong style=\"color:${theme.primary}; font-size:13px;\">King Salmon & Otoro Nigiri</strong>\n          <p style=\"margin:6px 0 0 0; font-size:12px; color:${theme.subtext}; line-height:1.5;\">Lightly torched with aged nikiri soy, yuzu kosho pearls, and mountain wasabi.</p>\n        </div>\n        <div style=\"font-size:11px; color:${theme.subtext}; margin-bottom:6px;\">SELECT SEATING TIME:</div>\n        <div class=\"time-slots\">\n          <button class=\"slot-btn active\" onclick=\"selectSlot(this)\">18:00 (2 left)</button>\n          <button class=\"slot-btn\" onclick=\"selectSlot(this)\">20:15 (Full)</button>\n          <button class=\"slot-btn\" onclick=\"selectSlot(this)\">22:00 (4 left)</button>\n        </div>\n        <button class=\"book-btn\" onclick=\"alert('Confirmed VIP Booking! Table reserved for ' + selectedTime + ' under code #VIP-OMK-88')\">RESERVE VIP TABLE &bull; $240/PP</button>\n      </div>\n      <script>\n        const courses = [\n          { title: 'King Salmon & Otoro Nigiri', desc: 'Lightly torched with aged nikiri soy, yuzu kosho pearls, and mountain wasabi.' },\n          { title: 'A5 Miyazaki Wagyu & Truffle', desc: 'Charcoal seared with shaved black Périgord winter truffle and smoked egg yolk tare.' },\n          { title: 'Hokkaido Uni & Bafun Caviar', desc: 'Crisp nori taco crowned with golden sea urchin and Kaluga hybrid reserve caviar.' }\n        ];\n        let selectedTime = '18:00';\n        function showCourse(idx, el) {\n          document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));\n          el.classList.add('active');\n          document.getElementById('course-desc').innerHTML = '<strong style=\"color:${theme.primary}; font-size:13px;\">' + courses[idx].title + '</strong><p style=\"margin:6px 0 0 0; font-size:12px; color:${theme.subtext}; line-height:1.5;\">' + courses[idx].desc + '</p>';\n        }\n        function selectSlot(btn) {\n          document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('active'));\n          btn.classList.add('active');\n          selectedTime = btn.innerText.split(' ')[0];\n        }\n      <\\/script></body></html>`;\n    }\n\n    // 3. NeuralFlow AI SaaS\n    if (text.includes('saas') || text.includes('pricing') || text.includes('api tester') || text.includes('neuralflow')) {\n      return `<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><style>\n        body { margin:0; padding:20px; background:${theme.bg}; color:${theme.text}; font-family:${theme.font}; box-sizing:border-box; display:flex; justify-content:center; }\n        .card { width:100%; max-width:620px; background:${theme.cardBg}; border:${borderStyle}; border-radius:${radius}; padding:24px; box-shadow:0 25px 50px rgba(0,0,0,0.7); }\n        .toggle-box { display:flex; justify-content:center; align-items:center; gap:12px; margin-bottom:18px; font-size:12px; }\n        .slider { width:100%; margin:12px 0; accent-color:${theme.primary}; }\n        .console { background:rgba(0,0,0,0.4); border:1px solid rgba(255,255,255,0.1); border-radius:${btnRadius}; padding:12px; font-family:monospace; font-size:11px; color:${theme.primary}; margin-bottom:16px; }\n        .btn { width:100%; padding:10px; background:${theme.primary}; color:#000; font-weight:800; font-size:13px; border:none; border-radius:${btnRadius}; cursor:pointer; }\n      </style></head><body>\n      <div class=\"card\">\n        <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;\">\n          <h3 style=\"margin:0; color:${theme.primary}; font-size:16px;\">NeuralFlow AI Engine</h3>\n          <span style=\"font-size:11px; background:${theme.accent}25; color:${theme.accent}; padding:3px 8px; border-radius:6px; font-weight:bold;\">API v2</span>\n        </div>\n        <div class=\"toggle-box\">\n          <span>Monthly</span>\n          <input type=\"checkbox\" id=\"bill-toggle\" onchange=\"updatePrice()\"/>\n          <span>Annual <strong style=\"color:${theme.primary};\">(-20%)</strong></span>\n        </div>\n        <div style=\"display:flex; justify-content:space-between; font-size:12px; color:${theme.subtext};\">\n          <span>Token Volume:</span><span id=\"token-display\">1,000,000 / mo</span>\n        </div>\n        <input type=\"range\" min=\"1\" max=\"10\" value=\"2\" class=\"slider\" id=\"token-slider\" oninput=\"updatePrice()\"/>\n        <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;\">\n          <span style=\"font-size:12px; color:${theme.subtext};\">Estimated Cost:</span>\n          <span id=\"price-display\" style=\"font-size:20px; font-weight:bold; color:${theme.accent};\">$49 / mo</span>\n        </div>\n        <div class=\"console\">\n          <div>&gt; POST /v1/chat/completions HTTP/2</div>\n          <div id=\"api-status\" style=\"color:${theme.subtext}; margin-top:4px;\">Status: 200 OK &bull; TTFT: 14ms &bull; Model: :${model}</div>\n        </div>\n        <button class=\"btn\" onclick=\"testApi()\">TEST LIVE API IN-BROWSER</button>\n      </div>\n      <script>\n        function updatePrice() {\n          const val = document.getElementById('token-slider').value;\n          const isAnnual = document.getElementById('bill-toggle').checked;\n          const tokens = val * 500000;\n          document.getElementById('token-display').innerText = tokens.toLocaleString() + ' / mo';\n          let base = val * 25;\n          if (isAnnual) base *= 0.8;\n          document.getElementById('price-display').innerText = '$' + Math.round(base) + ' / mo';\n        }\n        function testApi() {\n          const el = document.getElementById('api-status');\n          el.innerText = 'Transmitting tokens through WebGPU Wasm...';\n          setTimeout(() => {\n            el.innerHTML = '<span style=\"color:#34d399;\">Response 200 OK</span> &bull; Latency: ' + (Math.random() * 10 + 8).toFixed(1) + 'ms &bull; Context: 128KB';\n          }, 350);\n        }\n      <\\/script></body></html>`;\n    }\n\n    // 4. Creative Dev Portfolio with Terminal\n    if (text.includes('portfolio') || text.includes('terminal') || text.includes('developer')) {\n      return `<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><style>\n        body { margin:0; padding:20px; background:${theme.bg}; color:${theme.text}; font-family:${theme.font}; box-sizing:border-box; display:flex; justify-content:center; }\n        .card { width:100%; max-width:620px; background:${theme.cardBg}; border:${borderStyle}; border-radius:${radius}; padding:20px; box-shadow:0 25px 50px rgba(0,0,0,0.7); }\n        .term { background:#000000; border:1px solid rgba(255,255,255,0.15); border-radius:${btnRadius}; padding:14px; font-family:monospace; font-size:11px; height:180px; overflow-y:auto; margin-bottom:12px; }\n        .input-row { display:flex; align-items:center; gap:6px; }\n        .term-in { background:transparent; border:none; outline:none; color:${theme.primary}; font-family:monospace; font-size:11px; flex:1; }\n        .chips { display:flex; gap:8px; flex-wrap:wrap; }\n        .chip { background:rgba(255,255,255,0.06); padding:4px 10px; border-radius:999px; font-size:11px; color:${theme.primary}; cursor:pointer; border:1px solid ${theme.primary}44; }\n      </style></head><body>\n      <div class=\"card\">\n        <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;\">\n          <div><h3 style=\"margin:0; font-size:16px; color:${theme.primary};\">ALEX V. &bull; SYSTEMS AGENT</h3><span style=\"font-size:10px; color:${theme.subtext};\">In-Browser Terminal Portfolio</span></div>\n          <span style=\"color:${theme.accent}; font-size:11px; font-family:monospace;\">READY // v${window.__pgIteration}</span>\n        </div>\n        <div class=\"term\" id=\"term-out\">\n          <div style=\"color:${theme.subtext};\">Type 'help', 'skills', 'projects', or 'contact' below:</div>\n        </div>\n        <div class=\"input-row\" style=\"background:#000; border:1px solid rgba(255,255,255,0.2); border-radius:${btnRadius}; padding:8px 12px; margin-bottom:12px;\">\n          <span style=\"color:${theme.primary}; font-family:monospace; font-size:11px;\">guest@asl:~$</span>\n          <input type=\"text\" id=\"term-cmd\" class=\"term-in\" onkeydown=\"handleKey(event)\"/>\n        </div>\n        <div class=\"chips\">\n          <span class=\"chip\" onclick=\"execCmd('skills')\">skills</span>\n          <span class=\"chip\" onclick=\"execCmd('projects')\">projects</span>\n          <span class=\"chip\" onclick=\"execCmd('contact')\">contact</span>\n          <span class=\"chip\" onclick=\"execCmd('clear')\">clear</span>\n        </div>\n      </div>\n      <script>\n        function handleKey(e) {\n          if (e.key === 'Enter') {\n            const val = e.target.value.trim();\n            if (val) execCmd(val);\n            e.target.value = '';\n          }\n        }\n        function execCmd(cmd) {\n          const out = document.getElementById('term-out');\n          out.innerHTML += '<div><span style=\"color:${theme.primary};\">guest@asl:~$</span> ' + cmd + '</div>';\n          if (cmd === 'help') {\n            out.innerHTML += '<div style=\"color:${theme.subtext};\">Commands: skills, projects, contact, clear</div>';\n          } else if (cmd === 'skills') {\n            out.innerHTML += '<div style=\"color:${theme.accent};\">&bull; AgentScript AST compilation &bull; Wasm MicroVMs &bull; Rust &amp; WebGPU</div>';\n          } else if (cmd === 'projects') {\n            out.innerHTML += '<div style=\"color:${theme.primary};\">1. Tri-Studio (In-Browser Generator)<br/>2. AsnCodec (Universal S-Exp Parser)</div>';\n          } else if (cmd === 'contact') {\n            out.innerHTML += '<div style=\"color:#34d399;\">Email: agent@aslang.dev &bull; GitHub: @aslang</div>';\n          } else if (cmd === 'clear') {\n            out.innerHTML = '';\n          } else {\n            out.innerHTML += '<div style=\"color:#ef4444;\">Command not recognized: ' + cmd + '</div>';\n          }\n          out.scrollTop = out.scrollHeight;\n        }\n      <\\/script></body></html>`;\n    }\n\n    // 5. Web Audio FM Synth (Checked BEFORE kanban to prevent 'keyboard' matching 'board'!)\n    if (text.includes('synth') || text.includes('audio') || text.includes('piano') || text.includes('synthesizer') || text.includes('oscillator')) {\n      return `<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><style>\n        body { margin:0; padding:20px; background:${theme.bg}; color:${theme.text}; font-family:${theme.font}; box-sizing:border-box; display:flex; justify-content:center; }\n        .card { width:100%; max-width:620px; background:${theme.cardBg}; border:${borderStyle}; border-radius:${radius}; padding:20px; box-shadow:0 25px 50px rgba(0,0,0,0.7); }\n        .keys { display:flex; gap:6px; height:120px; margin:16px 0; }\n        .key { flex:1; background:#ffffff; color:#000; border-radius:0 0 6px 6px; display:flex; align-items:flex-end; justify-content:center; padding-bottom:8px; font-weight:bold; font-size:12px; cursor:pointer; user-select:none; }\n        .key:active { background:${theme.primary}; color:#fff; }\n        .wave-sel { display:flex; gap:8px; margin-bottom:12px; }\n        .wave-btn { padding:6px 12px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.15); border-radius:${btnRadius}; color:${theme.text}; cursor:pointer; font-size:11px; }\n        .wave-btn.active { background:${theme.accent}; color:#fff; font-weight:bold; }\n      </style></head><body>\n      <div class=\"card\">\n        <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n          <h3 style=\"margin:0; color:${theme.primary}; font-size:16px;\">Web Audio FM Synthesizer</h3>\n          <span style=\"font-size:11px; color:${theme.accent}; font-weight:bold;\">WEB AUDIO API ACTIVE</span>\n        </div>\n        <div class=\"keys\">\n          <div class=\"key\" onmousedown=\"playTone(261.63)\">C</div>\n          <div class=\"key\" onmousedown=\"playTone(293.66)\">D</div>\n          <div class=\"key\" onmousedown=\"playTone(329.63)\">E</div>\n          <div class=\"key\" onmousedown=\"playTone(349.23)\">F</div>\n          <div class=\"key\" onmousedown=\"playTone(392.00)\">G</div>\n          <div class=\"key\" onmousedown=\"playTone(440.00)\">A</div>\n          <div class=\"key\" onmousedown=\"playTone(493.88)\">B</div>\n          <div class=\"key\" onmousedown=\"playTone(523.25)\">C5</div>\n        </div>\n        <div style=\"font-size:11px; color:${theme.subtext}; margin-bottom:6px;\">OSCILLATOR WAVEFORM:</div>\n        <div class=\"wave-sel\">\n          <button class=\"wave-btn active\" onclick=\"setWave('sine', this)\">Sine</button>\n          <button class=\"wave-btn\" onclick=\"setWave('square', this)\">Square</button>\n          <button class=\"wave-btn\" onclick=\"setWave('sawtooth', this)\">Sawtooth</button>\n          <button class=\"wave-btn\" onclick=\"setWave('triangle', this)\">Triangle</button>\n        </div>\n      </div>\n      <script>\n        let audioCtx = null;\n        let waveType = 'sine';\n        function setWave(t, btn) {\n          waveType = t;\n          document.querySelectorAll('.wave-btn').forEach(b => b.classList.remove('active'));\n          btn.classList.add('active');\n        }\n        function playTone(freq) {\n          if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n          const osc = audioCtx.createOscillator();\n          const gain = audioCtx.createGain();\n          osc.type = waveType;\n          osc.frequency.setValueAtTime(freq, audioCtx.currentTime);\n          gain.gain.setValueAtTime(0.18, audioCtx.currentTime);\n          gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.6);\n          osc.connect(gain);\n          gain.connect(audioCtx.destination);\n          osc.start();\n          osc.stop(audioCtx.currentTime + 0.6);\n        }\n      <\\/script></body></html>`;\n    }\n\n    // 6. Agile Flow Kanban Board (Strict boundary check to not match keyboard)\n    if (text.includes('kanban') || text.includes('agile') || (text.includes('board') && !text.includes('keyboard')) || text.includes('tasks')) {\n      return `<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><style>\n        body { margin:0; padding:16px; background:${theme.bg}; color:${theme.text}; font-family:${theme.font}; box-sizing:border-box; display:flex; justify-content:center; }\n        .card { width:100%; max-width:620px; background:${theme.cardBg}; border:${borderStyle}; border-radius:${radius}; padding:18px; box-shadow:0 25px 50px rgba(0,0,0,0.7); }\n        .columns { display:grid; grid-template-columns:repeat(3, 1fr); gap:10px; margin-top:12px; }\n        .col { background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.08); border-radius:${btnRadius}; padding:10px; min-height:160px; }\n        .col-h { font-size:11px; font-weight:bold; color:${theme.primary}; border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:6px; margin-bottom:8px; display:flex; justify-content:space-between; }\n        .task { background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.1); border-radius:6px; padding:8px; font-size:11px; margin-bottom:6px; cursor:pointer; }\n        .task:hover { border-color:${theme.primary}; }\n        .btn { padding:6px 12px; background:${theme.primary}; color:#000; font-weight:800; font-size:11px; border:none; border-radius:${btnRadius}; cursor:pointer; }\n      </style></head><body>\n      <div class=\"card\">\n        <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n          <h3 style=\"margin:0; font-size:15px; color:${theme.primary};\">Agile Kanban Flow</h3>\n          <button class=\"btn\" onclick=\"addTask()\">+ ADD TASK</button>\n        </div>\n        <div class=\"columns\">\n          <div class=\"col\" id=\"col-backlog\"><div class=\"col-h\"><span>BACKLOG</span><span id=\"c1\">2</span></div>\n            <div class=\"task\" onclick=\"moveTask(this, 'col-progress')\">Optimize Wasm Heap &rarr;</div>\n            <div class=\"task\" onclick=\"moveTask(this, 'col-progress')\">Refactor AST Grammar &rarr;</div>\n          </div>\n          <div class=\"col\" id=\"col-progress\"><div class=\"col-h\"><span>IN PROGRESS</span><span id=\"c2\">1</span></div>\n            <div class=\"task\" onclick=\"moveTask(this, 'col-done')\">Dual Temperature DAG &rarr;</div>\n          </div>\n          <div class=\"col\" id=\"col-done\"><div class=\"col-h\"><span>DONE</span><span id=\"c3\">1</span></div>\n            <div class=\"task\" style=\"text-decoration:line-through; color:${theme.subtext};\">In-Browser Harness</div>\n          </div>\n        </div>\n      </div>\n      <script>\n        function moveTask(el, targetId) {\n          document.getElementById(targetId).appendChild(el);\n          if (targetId === 'col-done') {\n            el.style.textDecoration = 'line-through';\n            el.style.color = '${theme.subtext}';\n          }\n          updateCounts();\n        }\n        function addTask() {\n          const name = prompt('Task title:', 'Verify zero stubs');\n          if (name) {\n            const div = document.createElement('div');\n            div.className = 'task';\n            div.innerText = name + ' &rarr;';\n            div.onclick = function() { moveTask(this, 'col-progress'); };\n            document.getElementById('col-backlog').appendChild(div);\n            updateCounts();\n          }\n        }\n        function updateCounts() {\n          document.getElementById('c1').innerText = document.getElementById('col-backlog').querySelectorAll('.task').length;\n          document.getElementById('c2').innerText = document.getElementById('col-progress').querySelectorAll('.task').length;\n          document.getElementById('c3').innerText = document.getElementById('col-done').querySelectorAll('.task').length;\n        }\n      <\\/script></body></html>`;\n    }\n\n    // 7. Quantum Metrics Dashboard\n    if (text.includes('analytics') || text.includes('metrics') || text.includes('dashboard') || text.includes('throughput')) {\n      return `<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><style>\n        body { margin:0; padding:20px; background:${theme.bg}; color:${theme.text}; font-family:${theme.font}; box-sizing:border-box; display:flex; justify-content:center; }\n        .card { width:100%; max-width:620px; background:${theme.cardBg}; border:${borderStyle}; border-radius:${radius}; padding:20px; box-shadow:0 25px 50px rgba(0,0,0,0.7); }\n        .grid { display:grid; grid-template-columns:repeat(2, 1fr); gap:12px; margin:16px 0; }\n        .stat { background:rgba(0,0,0,0.3); border:1px solid rgba(255,255,255,0.08); border-radius:${btnRadius}; padding:14px; }\n        .val { font-size:22px; font-weight:800; color:${theme.primary}; margin-top:4px; }\n        .time-pills { display:flex; gap:6px; }\n        .pill { padding:4px 10px; border-radius:999px; background:rgba(255,255,255,0.06); font-size:11px; cursor:pointer; color:${theme.subtext}; }\n        .pill.active { background:${theme.accent}; color:#fff; font-weight:bold; }\n      </style></head><body>\n      <div class=\"card\">\n        <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n          <h3 style=\"margin:0; font-size:16px; color:${theme.primary};\">Quantum Metrics Dashboard</h3>\n          <div class=\"time-pills\">\n            <span class=\"pill active\" onclick=\"switchRange(this)\">24h</span>\n            <span class=\"pill\" onclick=\"switchRange(this)\">7d</span>\n            <span class=\"pill\" onclick=\"switchRange(this)\">30d</span>\n          </div>\n        </div>\n        <div class=\"grid\">\n          <div class=\"stat\"><span style=\"font-size:11px; color:${theme.subtext};\">THROUGHPUT</span><div class=\"val\" id=\"val-tps\">12,480 req/s</div></div>\n          <div class=\"stat\"><span style=\"font-size:11px; color:${theme.subtext};\">MEDIAN LATENCY</span><div class=\"val\" style=\"color:${theme.accent};\">0.018 ms</div></div>\n          <div class=\"stat\"><span style=\"font-size:11px; color:${theme.subtext};\">ERROR RATE</span><div class=\"val\" style=\"color:#34d399;\">0.000%</div></div>\n          <div class=\"stat\"><span style=\"font-size:11px; color:${theme.subtext};\">ACTIVE AGENTS</span><div class=\"val\">128 Live</div></div>\n        </div>\n        <svg viewBox=\"0 0 500 80\" class=\"w-full h-20\" style=\"background:rgba(0,0,0,0.2); border-radius:${btnRadius};\">\n          <path id=\"sparkline\" d=\"M 0,60 Q 100,20 200,45 T 350,15 T 500,30\" fill=\"none\" stroke=\"${theme.primary}\" stroke-width=\"2.5\"/>\n        </svg>\n      </div>\n      <script>\n        setInterval(() => {\n          const tps = Math.floor(12000 + Math.random() * 800);\n          document.getElementById('val-tps').innerText = tps.toLocaleString() + ' req/s';\n        }, 1500);\n        function switchRange(el) {\n          document.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));\n          el.classList.add('active');\n          const dList = [\n            'M 0,60 Q 100,20 200,45 T 350,15 T 500,30',\n            'M 0,40 Q 120,60 220,15 T 380,45 T 500,20',\n            'M 0,50 Q 80,10 240,40 T 360,25 T 500,10'\n          ];\n          document.getElementById('sparkline').setAttribute('d', dList[Math.floor(Math.random() * dList.length)]);\n        }\n      <\\/script></body></html>`;\n    }\n\n    // 8. Agentic AI Chat Studio\n    if (text.includes('chat') || text.includes('assistant') || text.includes('conversation')) {\n      return `<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><style>\n        body { margin:0; padding:16px; background:${theme.bg}; color:${theme.text}; font-family:${theme.font}; box-sizing:border-box; display:flex; justify-content:center; }\n        .card { width:100%; max-width:620px; background:${theme.cardBg}; border:${borderStyle}; border-radius:${radius}; padding:18px; box-shadow:0 25px 50px rgba(0,0,0,0.7); display:flex; flex-direction:column; height:460px; }\n        .stream { flex:1; overflow-y:auto; padding-right:8px; display:flex; flex-direction:column; gap:10px; margin-bottom:12px; }\n        .msg { max-width:82%; padding:10px 14px; border-radius:12px; font-size:12px; line-height:1.5; }\n        .msg-user { align-self:flex-end; background:${theme.primary}33; border:1px solid ${theme.primary}55; color:${theme.text}; border-bottom-right-radius:2px; }\n        .msg-agent { align-self:flex-start; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); color:${theme.text}; border-bottom-left-radius:2px; }\n        .input-box { display:flex; gap:8px; }\n        .chat-in { flex:1; background:rgba(0,0,0,0.4); border:1px solid rgba(255,255,255,0.2); border-radius:${btnRadius}; padding:10px 14px; color:${theme.text}; font-size:12px; outline:none; font-family:${theme.font}; }\n        .send-btn { padding:10px 18px; background:${theme.primary}; color:#000; font-weight:bold; font-size:12px; border:none; border-radius:${btnRadius}; cursor:pointer; }\n      </style></head><body>\n      <div class=\"card\">\n        <div style=\"display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:8px; margin-bottom:12px;\">\n          <div style=\"font-weight:bold; font-size:14px; color:${theme.primary};\">Agentic AI Chat Studio</div>\n          <span style=\"font-size:10px; background:${theme.accent}33; color:${theme.accent}; padding:2px 8px; border-radius:999px;\">:${model} ONLINE</span>\n        </div>\n        <div class=\"stream\" id=\"stream\">\n          <div class=\"msg msg-agent\">Welcome to the AgentScript In-Browser Studio. I am running locally under the <strong>${theme.name}</strong> design system. How can I assist you?</div>\n        </div>\n        <div class=\"input-box\">\n          <input type=\"text\" id=\"chat-in\" class=\"chat-in\" placeholder=\"Ask anything about AgentScript...\" onkeydown=\"if(event.key==='Enter') sendMsg()\"/>\n          <button class=\"send-btn\" onclick=\"sendMsg()\">SEND</button>\n        </div>\n      </div>\n      <script>\n        function sendMsg() {\n          const inp = document.getElementById('chat-in');\n          const val = inp.value.trim();\n          if (!val) return;\n          const stream = document.getElementById('stream');\n          stream.innerHTML += '<div class=\"msg msg-user\">' + val + '</div>';\n          inp.value = '';\n          stream.scrollTop = stream.scrollHeight;\n          setTimeout(() => {\n            const replies = [\n              'AgentScript compiles S-expressions directly to Wasm bytecode with zero token leakage.',\n              'Verified runtime: 57% token compaction over JSON with guaranteed AST delimiter balance.',\n              'All harnesses connected locally. Executing with 12ms first-token latency.'\n            ];\n            const r = replies[Math.floor(Math.random() * replies.length)];\n            stream.innerHTML += '<div class=\"msg msg-agent\">' + r + '</div>';\n            stream.scrollTop = stream.scrollHeight;\n          }, 400);\n        }\n      <\\/script></body></html>`;\n    }\n\n    // 9. Dynamic Fallback for Any Other Custom Website Prompt\n    return `<!DOCTYPE html><html><head><meta charset=\"utf-8\"/><style>\n      body { margin:0; padding:24px; background:${theme.bg}; color:${theme.text}; font-family:${theme.font}; box-sizing:border-box; display:flex; justify-content:center; }\n      .app { width:100%; max-width:620px; background:${theme.cardBg}; border:${borderStyle}; border-radius:${radius}; padding:28px; box-shadow:0 25px 50px rgba(0,0,0,0.7); }\n      .head { display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:14px; margin-bottom:18px; }\n      .badge { padding:4px 10px; border-radius:999px; background:${theme.primary}22; color:${theme.primary}; font-size:10px; font-weight:700; border:1px solid ${theme.primary}55; }\n      .btn { width:100%; padding:12px; background:${theme.primary}; color:${isMono ? '#000' : '#0a0a14'}; font-weight:800; font-size:13px; border:none; border-radius:${btnRadius}; cursor:pointer; }\n    </style></head><body>\n    <div class=\"app\">\n      <div class=\"head\">\n        <h3 style=\"margin:0; font-size:17px; color:${theme.text};\">${(promptText || 'Interactive Web Application').slice(0, 32).toUpperCase()}</h3>\n        <span class=\"badge\">${theme.name.toUpperCase()}</span>\n      </div>\n      <p style=\"font-size:13px; color:${theme.subtext}; line-height:1.6; margin-bottom:20px;\">\n        Fully reactive component compiled directly from prompt tokens under <strong>${theme.name}</strong> design guidelines for model <strong>:${model}</strong>.\n      </p>\n      <div style=\"background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:${btnRadius}; padding:14px; margin-bottom:18px; font-family:monospace; font-size:12px;\">\n        <div style=\"display:flex; justify-content:space-between; margin-bottom:6px;\"><span>Live State:</span><span id=\"click-counter\" style=\"color:${theme.primary}; font-weight:bold;\">0 Actions</span></div>\n        <div style=\"display:flex; justify-content:space-between;\"><span>Refinement:</span><span>${ref || 'Base v' + window.__pgIteration}</span></div>\n      </div>\n      <button class=\"btn\" onclick=\"increment()\">DISPATCH REACTION EVENT</button>\n    </div>\n    <script>\n      let count = 0;\n      function increment() {\n        count++;\n        document.getElementById('click-counter').innerText = count + ' Actions Triggered';\n      }\n    <\\/script></body></html>`;\n  };\n\n  // -------------------------------------------------------------\n  // Dynamic Stylized Toy/Game Engine (Phase 2 Execution at T=0.0)\n  // Executes genuine 2D HTML5 Canvas interactive games\n  // -------------------------------------------------------------\n  window.runToyEngine = function(promptText, canvas, ref, theme, model) {\n    const ctx = canvas.getContext('2d');\n    const W = canvas.width;\n    const H = canvas.height;\n    theme = theme || window.resolveActiveTheme();\n    model = model || window.__pgSelectedModel;\n    const text = (promptText || '').toLowerCase();\n\n    const isPixel = theme.pixelated;\n    const isMono = theme.mono;\n    const isWire = theme.wireframe;\n    const isBlueprint = theme.blueprint;\n\n    // 1. Flappy Bird 2D\n    if (text.includes('flappy') || text.includes('bird') || /\bpipes?\b/.test(text)) {\n      let birdY = H / 2, birdV = 0, score = 0, gameOver = false;\n      let pipes = [{ x: W, top: 120, bottom: 180 }];\n      let jumpPower = ref && ref.includes('jump') ? -8.5 : -6.5;\n\n      function flap() {\n        if (gameOver) {\n          birdY = H / 2; birdV = 0; score = 0; gameOver = false;\n          pipes = [{ x: W, top: 120, bottom: 180 }];\n          return;\n        }\n        birdV = jumpPower;\n      }\n      canvas.onclick = flap;\n      window.onkeydown = (e) => { if (e.code === 'Space') { e.preventDefault(); flap(); } };\n\n      function loop() {\n        ctx.fillStyle = theme.bg;\n        ctx.fillRect(0, 0, W, H);\n\n        if (!gameOver) {\n          birdV += 0.35;\n          birdY += birdV;\n\n          pipes.forEach(p => {\n            p.x -= 2.5;\n            if (p.x + 50 === 100) score++;\n          });\n          if (pipes.length && pipes[0].x < -60) {\n            pipes.shift();\n            const topH = 60 + Math.random() * 160;\n            pipes.push({ x: W, top: topH, bottom: H - topH - 120 });\n          }\n\n          if (birdY < 0 || birdY > H - 20) gameOver = true;\n          pipes.forEach(p => {\n            if (100 > p.x && 80 < p.x + 50) {\n              if (birdY < p.top || birdY > H - p.bottom) gameOver = true;\n            }\n          });\n        }\n\n        // Draw Pipes\n        pipes.forEach(p => {\n          ctx.fillStyle = theme.primary;\n          if (theme.glow) { ctx.shadowColor = theme.primary; ctx.shadowBlur = 12; }\n          ctx.fillRect(p.x, 0, 50, p.top);\n          ctx.fillRect(p.x, H - p.bottom, 50, p.bottom);\n          ctx.shadowBlur = 0;\n        });\n\n        // Draw Bird\n        ctx.fillStyle = theme.accent;\n        if (theme.glow) { ctx.shadowColor = theme.accent; ctx.shadowBlur = 14; }\n        ctx.beginPath(); ctx.arc(90, birdY, 12, 0, Math.PI * 2); ctx.fill();\n        ctx.shadowBlur = 0;\n\n        ctx.fillStyle = theme.text;\n        ctx.font = 'bold 16px ' + theme.font;\n        ctx.fillText(`SCORE: ${score}`, 20, 35);\n        ctx.font = '12px ' + theme.font;\n        ctx.fillStyle = theme.subtext;\n        ctx.fillText(`Space/Click to Flap • [${theme.name}]`, 20, 55);\n\n        if (gameOver) {\n          ctx.fillStyle = 'rgba(0,0,0,0.75)';\n          ctx.fillRect(0, 0, W, H);\n          ctx.fillStyle = theme.accent;\n          ctx.font = 'bold 28px monospace';\n          ctx.textAlign = 'center';\n          ctx.fillText('GAME OVER', W / 2, H / 2 - 15);\n          ctx.fillStyle = theme.text;\n          ctx.font = '14px monospace';\n          ctx.fillText('Click to Restart', W / 2, H / 2 + 20);\n          ctx.textAlign = 'left';\n        }\n\n        window.__pgActiveAnimId = requestAnimationFrame(loop);\n      }\n      loop();\n      return;\n    }\n\n    // 2. Asteroids Space Shooter\n    if (text.includes('asteroid') || text.includes('shooter') || (text.includes('space') && text.includes('ship'))) {\n      let shipX = W / 2, shipY = H / 2, shipAngle = -Math.PI / 2, vx = 0, vy = 0;\n      let bullets = [], rocks = [], score = 0, keys = {};\n      const rockCount = model === 'small' ? 8 : model === 'mini' ? 5 : 3;\n      for (let i = 0; i < rockCount; i++) {\n        rocks.push({ x: Math.random() * W, y: Math.random() * H, r: 24, vx: (Math.random() - 0.5) * 2, vy: (Math.random() - 0.5) * 2 });\n      }\n\n      window.onkeydown = (e) => {\n        keys[e.code] = true;\n        if (e.code === 'Space') {\n          e.preventDefault();\n          bullets.push({ x: shipX, y: shipY, vx: Math.cos(shipAngle) * 7, vy: Math.sin(shipAngle) * 7, life: 50 });\n        }\n      };\n      window.onkeyup = (e) => { keys[e.code] = false; };\n\n      function loop() {\n        ctx.fillStyle = theme.bg;\n        ctx.fillRect(0, 0, W, H);\n\n        if (keys['ArrowLeft'] || keys['KeyA']) shipAngle -= 0.07;\n        if (keys['ArrowRight'] || keys['KeyD']) shipAngle += 0.07;\n        if (keys['ArrowUp'] || keys['KeyW']) {\n          vx += Math.cos(shipAngle) * 0.15;\n          vy += Math.sin(shipAngle) * 0.15;\n        }\n        vx *= 0.98; vy *= 0.98;\n        shipX = (shipX + vx + W) % W;\n        shipY = (shipY + vy + H) % H;\n\n        // Bullets\n        bullets.forEach(b => {\n          b.x = (b.x + b.vx + W) % W;\n          b.y = (b.y + b.vy + H) % H;\n          b.life--;\n          ctx.fillStyle = theme.primary;\n          ctx.beginPath(); ctx.arc(b.x, b.y, 3, 0, Math.PI * 2); ctx.fill();\n        });\n        bullets = bullets.filter(b => b.life > 0);\n\n        // Asteroids\n        rocks.forEach(r => {\n          r.x = (r.x + r.vx + W) % W;\n          r.y = (r.y + r.vy + H) % H;\n          ctx.strokeStyle = theme.accent;\n          ctx.lineWidth = 2;\n          ctx.beginPath(); ctx.arc(r.x, r.y, r.r, 0, Math.PI * 2); ctx.stroke();\n\n          bullets.forEach(b => {\n            if (Math.hypot(b.x - r.x, b.y - r.y) < r.r) {\n              score += 100;\n              b.life = 0;\n              r.x = Math.random() * W;\n            }\n          });\n        });\n\n        // Ship\n        ctx.save();\n        ctx.translate(shipX, shipY);\n        ctx.rotate(shipAngle);\n        ctx.strokeStyle = theme.primary;\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.moveTo(14, 0); ctx.lineTo(-10, -8); ctx.lineTo(-6, 0); ctx.lineTo(-10, 8); ctx.closePath();\n        ctx.stroke();\n        ctx.restore();\n\n        ctx.fillStyle = theme.text;\n        ctx.font = 'bold 16px ' + theme.font;\n        ctx.fillText(`SCORE: ${score}`, 20, 30);\n        ctx.font = '11px ' + theme.font;\n        ctx.fillStyle = theme.subtext;\n        ctx.fillText(`W/Up: Thrust | A/D: Turn | Space: Shoot • [${theme.name}]`, 20, 50);\n\n        window.__pgActiveAnimId = requestAnimationFrame(loop);\n      }\n      loop();\n      return;\n    }\n\n    // 3. Neon Retro Snake\n    if (text.includes('snake')) {\n      let snake = [{ x: 10, y: 10 }, { x: 9, y: 10 }, { x: 8, y: 10 }];\n      let dir = { x: 1, y: 0 }, nextDir = { x: 1, y: 0 };\n      let food = { x: 15, y: 12 }, score = 0, speed = 80;\n      let lastTime = 0;\n\n      window.onkeydown = (e) => {\n        if ((e.code === 'ArrowUp' || e.code === 'KeyW') && dir.y === 0) nextDir = { x: 0, y: -1 };\n        if ((e.code === 'ArrowDown' || e.code === 'KeyS') && dir.y === 0) nextDir = { x: 0, y: 1 };\n        if ((e.code === 'ArrowLeft' || e.code === 'KeyA') && dir.x === 0) nextDir = { x: -1, y: 0 };\n        if ((e.code === 'ArrowRight' || e.code === 'KeyD') && dir.x === 0) nextDir = { x: 1, y: 0 };\n      };\n\n      function loop(timestamp) {\n        if (!lastTime) lastTime = timestamp;\n        if (timestamp - lastTime > speed) {\n          lastTime = timestamp;\n          dir = nextDir;\n          const head = { x: snake[0].x + dir.x, y: snake[0].y + dir.y };\n          if (head.x < 0) head.x = 24; if (head.x >= 25) head.x = 0;\n          if (head.y < 0) head.y = 19; if (head.y >= 20) head.y = 0;\n\n          if (head.x === food.x && head.y === food.y) {\n            score += 10;\n            food = { x: Math.floor(Math.random() * 24), y: Math.floor(Math.random() * 19) };\n          } else {\n            snake.pop();\n          }\n          snake.unshift(head);\n        }\n\n        ctx.fillStyle = theme.bg;\n        ctx.fillRect(0, 0, W, H);\n\n        // Draw Snake\n        snake.forEach((seg, i) => {\n          ctx.fillStyle = i === 0 ? theme.accent : theme.primary;\n          ctx.fillRect(seg.x * 20 + 2, seg.y * 20 + 2, 16, 16);\n        });\n\n        // Food\n        ctx.fillStyle = theme.accent;\n        ctx.fillRect(food.x * 20 + 3, food.y * 20 + 3, 14, 14);\n\n        ctx.fillStyle = theme.text;\n        ctx.font = 'bold 16px ' + theme.font;\n        ctx.fillText(`SCORE: ${score}`, 20, 30);\n        ctx.font = '11px ' + theme.font;\n        ctx.fillStyle = theme.subtext;\n        ctx.fillText(`WASD / Arrows to Move • Snake Length: ${snake.length}`, 20, 50);\n\n        window.__pgActiveAnimId = requestAnimationFrame(loop);\n      }\n      loop();\n      return;\n    }\n\n    // 4. Conway Game of Life\n    if (text.includes('life') || text.includes('conway') || text.includes('cellular')) {\n      const COLS = 32, ROWS = 24, CELL_SIZE = 20;\n      let grid = Array(COLS).fill(0).map(() => Array(ROWS).fill(0));\n      grid[10][10] = 1; grid[11][11] = 1; grid[12][9] = 1; grid[12][10] = 1; grid[12][11] = 1;\n      let running = true, tick = 0;\n\n      canvas.onclick = (e) => {\n        const rect = canvas.getBoundingClientRect();\n        const mx = Math.floor((e.clientX - rect.left) / (rect.width / COLS));\n        const my = Math.floor((e.clientY - rect.top) / (rect.height / ROWS));\n        if (mx >= 0 && mx < COLS && my >= 0 && my < ROWS) {\n          grid[mx][my] = grid[mx][my] ? 0 : 1;\n        }\n      };\n      window.onkeydown = (e) => {\n        if (e.code === 'Space') { e.preventDefault(); running = !running; }\n      };\n\n      function loop() {\n        tick++;\n        if (running && tick % 8 === 0) {\n          let next = Array(COLS).fill(0).map(() => Array(ROWS).fill(0));\n          for (let x = 0; x < COLS; x++) {\n            for (let y = 0; y < ROWS; y++) {\n              let neighbors = 0;\n              for (let dx = -1; dx <= 1; dx++) {\n                for (let dy = -1; dy <= 1; dy++) {\n                  if (dx === 0 && dy === 0) continue;\n                  const nx = (x + dx + COLS) % COLS;\n                  const ny = (y + dy + ROWS) % ROWS;\n                  neighbors += grid[nx][ny];\n                }\n              }\n              if (grid[x][y] === 1 && (neighbors === 2 || neighbors === 3)) next[x][y] = 1;\n              else if (grid[x][y] === 0 && neighbors === 3) next[x][y] = 1;\n            }\n          }\n          grid = next;\n        }\n\n        ctx.fillStyle = theme.bg;\n        ctx.fillRect(0, 0, W, H);\n\n        for (let x = 0; x < COLS; x++) {\n          for (let y = 0; y < ROWS; y++) {\n            if (grid[x][y]) {\n              ctx.fillStyle = theme.primary;\n              ctx.fillRect(x * CELL_SIZE, y * CELL_SIZE, CELL_SIZE - 2, CELL_SIZE - 2);\n            }\n          }\n        }\n\n        ctx.fillStyle = theme.text;\n        ctx.font = 'bold 16px ' + theme.font;\n        ctx.fillText(`CONWAY LIFE • ${running ? 'RUNNING' : 'PAUSED'}`, 20, 30);\n        ctx.font = '11px ' + theme.font;\n        ctx.fillStyle = theme.subtext;\n        ctx.fillText(`Click to toggle cells • Space to Pause/Play • [${theme.name}]`, 20, 50);\n\n        window.__pgActiveAnimId = requestAnimationFrame(loop);\n      }\n      loop();\n      return;\n    }\n\n    // 5. Dungeon Crawler Rogue\n    if (text.includes('rogue') || text.includes('dungeon') || text.includes('crawler')) {\n      let px = 4, py = 4, gems = [{ x: 8, y: 4 }, { x: 14, y: 8 }, { x: 6, y: 10 }], score = 0;\n      let slime = { x: 12, y: 6, dir: 1 };\n      window.onkeydown = (e) => {\n        if (e.code === 'ArrowLeft' || e.code === 'KeyA') px = Math.max(1, px - 1);\n        if (e.code === 'ArrowRight' || e.code === 'KeyD') px = Math.min(20, px + 1);\n        if (e.code === 'ArrowUp' || e.code === 'KeyW') py = Math.max(1, py - 1);\n        if (e.code === 'ArrowDown' || e.code === 'KeyS') py = Math.min(14, py + 1);\n      };\n\n      let frame = 0;\n      function loop() {\n        frame++;\n        if (frame % 25 === 0) {\n          slime.x += slime.dir;\n          if (slime.x > 18 || slime.x < 5) slime.dir *= -1;\n        }\n\n        ctx.fillStyle = theme.bg;\n        ctx.fillRect(0, 0, W, H);\n\n        gems = gems.filter(g => {\n          if (g.x === px && g.y === py) { score += 50; return false; }\n          return true;\n        });\n\n        gems.forEach(g => {\n          ctx.fillStyle = '#34d399';\n          ctx.fillRect(g.x * 30, g.y * 30, 16, 16);\n        });\n\n        ctx.fillStyle = theme.accent;\n        ctx.fillRect(slime.x * 30, slime.y * 30, 22, 20);\n\n        ctx.fillStyle = theme.primary;\n        ctx.fillRect(px * 30, py * 30, 20, 24);\n\n        ctx.fillStyle = theme.text;\n        ctx.font = 'bold 16px ' + theme.font;\n        ctx.fillText(`DUNGEON ROGUE • GEMS: ${score}`, 20, 30);\n        ctx.font = '11px ' + theme.font;\n        ctx.fillStyle = theme.subtext;\n        ctx.fillText(`WASD to Move • Avoid Slime • Collect Emeralds`, 20, 50);\n\n        window.__pgActiveAnimId = requestAnimationFrame(loop);\n      }\n      loop();\n      return;\n    }\n\n    // 6. Cyber Pong 2D\n    if (text.includes('pong') || text.includes('paddle')) {\n      let py = H / 2 - 35, aiY = H / 2 - 35, bx = W / 2, by = H / 2, bvx = 4, bvy = 3;\n      let pScore = 0, aiScore = 0;\n\n      canvas.onmousemove = (e) => {\n        const rect = canvas.getBoundingClientRect();\n        py = Math.max(0, Math.min(H - 70, (e.clientY - rect.top) * (H / rect.height) - 35));\n      };\n\n      function loop() {\n        ctx.fillStyle = theme.bg;\n        ctx.fillRect(0, 0, W, H);\n\n        bx += bvx; by += bvy;\n        if (by < 10 || by > H - 10) bvy *= -1;\n\n        aiY += (by - (aiY + 35)) * 0.08;\n        aiY = Math.max(0, Math.min(H - 70, aiY));\n\n        if (bx < 45 && by > py && by < py + 70) { bvx = Math.abs(bvx) * 1.05; }\n        if (bx > W - 45 && by > aiY && by < aiY + 70) { bvx = -Math.abs(bvx) * 1.05; }\n\n        if (bx < 0) { aiScore++; bx = W / 2; by = H / 2; bvx = 4; }\n        if (bx > W) { pScore++; bx = W / 2; by = H / 2; bvx = -4; }\n\n        ctx.fillStyle = theme.primary;\n        ctx.fillRect(20, py, 15, 70);\n        ctx.fillStyle = theme.accent;\n        ctx.fillRect(W - 35, aiY, 15, 70);\n\n        ctx.fillStyle = '#ffffff';\n        ctx.beginPath(); ctx.arc(bx, by, 8, 0, Math.PI * 2); ctx.fill();\n\n        ctx.fillStyle = theme.text;\n        ctx.font = 'bold 20px ' + theme.font;\n        ctx.fillText(`${pScore}  :  ${aiScore}`, W / 2 - 25, 40);\n\n        window.__pgActiveAnimId = requestAnimationFrame(loop);\n      }\n      loop();\n      return;\n    }\n\n    // 7. Neon Brick Breaker\n    if (text.includes('breakout') || text.includes('brick') || text.includes('breaker')) {\n      let padX = W / 2 - 40, padW = 80;\n      let bx = W / 2, by = H - 80, bvx = 3.5, bvy = -4;\n      let bricks = [], score = 0;\n      for (let r = 0; r < 4; r++) {\n        for (let c = 0; c < 8; c++) {\n          bricks.push({ x: 40 + c * 70, y: 50 + r * 25, alive: true });\n        }\n      }\n\n      canvas.onmousemove = (e) => {\n        const rect = canvas.getBoundingClientRect();\n        padX = Math.max(0, Math.min(W - padW, (e.clientX - rect.left) * (W / rect.width) - padW / 2));\n      };\n\n      function loop() {\n        ctx.fillStyle = theme.bg;\n        ctx.fillRect(0, 0, W, H);\n\n        bx += bvx; by += bvy;\n        if (bx < 10 || bx > W - 10) bvx *= -1;\n        if (by < 10) bvy *= -1;\n        if (by > H - 50 && bx > padX && bx < padX + padW) bvy = -Math.abs(bvy);\n        if (by > H) { bx = W / 2; by = H - 80; bvy = -4; }\n\n        bricks.forEach(b => {\n          if (b.alive && bx > b.x && bx < b.x + 60 && by > b.y && by < b.y + 20) {\n            b.alive = false;\n            bvy *= -1;\n            score += 20;\n          }\n        });\n\n        bricks.forEach(b => {\n          if (b.alive) {\n            ctx.fillStyle = theme.secondary;\n            ctx.fillRect(b.x, b.y, 60, 18);\n          }\n        });\n\n        ctx.fillStyle = theme.primary;\n        ctx.fillRect(padX, H - 35, padW, 14);\n        ctx.fillStyle = theme.accent;\n        ctx.beginPath(); ctx.arc(bx, by, 7, 0, Math.PI * 2); ctx.fill();\n\n        ctx.fillStyle = theme.text;\n        ctx.font = 'bold 16px ' + theme.font;\n        ctx.fillText(`SCORE: ${score}`, 20, 30);\n\n        window.__pgActiveAnimId = requestAnimationFrame(loop);\n      }\n      loop();\n      return;\n    }\n\n    // 8. 2D Micro Drift Racer\n    if (text.includes('racer') || text.includes('drift') || /\b(cars?|racing)\b/i.test(text)) {\n      let carX = W / 2, carY = H / 2, carAngle = 0, speed = 0;\n      let skids = [], keys = {};\n      window.onkeydown = (e) => { keys[e.code] = true; };\n      window.onkeyup = (e) => { keys[e.code] = false; };\n\n      function loop() {\n        ctx.fillStyle = theme.bg;\n        ctx.fillRect(0, 0, W, H);\n\n        if (keys['ArrowUp'] || keys['KeyW']) speed = Math.min(5, speed + 0.15);\n        if (keys['ArrowDown'] || keys['KeyS']) speed = Math.max(-2, speed - 0.1);\n        speed *= 0.96;\n        if (keys['ArrowLeft'] || keys['KeyA']) carAngle -= 0.06;\n        if (keys['ArrowRight'] || keys['KeyD']) carAngle += 0.06;\n\n        carX += Math.cos(carAngle) * speed;\n        carY += Math.sin(carAngle) * speed;\n        carX = (carX + W) % W;\n        carY = (carY + H) % H;\n\n        if (Math.abs(speed) > 2) {\n          skids.push({ x: carX, y: carY });\n          if (skids.length > 80) skids.shift();\n        }\n\n        ctx.strokeStyle = 'rgba(255,255,255,0.12)';\n        ctx.lineWidth = 3;\n        skids.forEach(s => {\n          ctx.beginPath(); ctx.arc(s.x, s.y, 2, 0, Math.PI * 2); ctx.stroke();\n        });\n\n        ctx.save();\n        ctx.translate(carX, carY);\n        ctx.rotate(carAngle);\n        ctx.fillStyle = theme.primary;\n        ctx.fillRect(-16, -10, 32, 20);\n        ctx.fillStyle = theme.accent;\n        ctx.fillRect(8, -8, 6, 16);\n        ctx.restore();\n\n        ctx.fillStyle = theme.text;\n        ctx.font = 'bold 16px ' + theme.font;\n        ctx.fillText(`DRIFT RACER • SPEED: ${Math.round(Math.abs(speed) * 20)} KM/H`, 20, 30);\n        ctx.font = '11px ' + theme.font;\n        ctx.fillStyle = theme.subtext;\n        ctx.fillText(`WASD / Arrows to Drive • [${theme.name}]`, 20, 50);\n\n        window.__pgActiveAnimId = requestAnimationFrame(loop);\n      }\n      loop();\n      return;\n    }\n\n    // 9. Dynamic Arcade Game for Any Other Game Prompt\n    let playerX = W / 2, playerSpeed = 5;\n    let items = [], score = 0, frame = 0, keys = {};\n    window.onkeydown = (e) => { keys[e.code] = true; };\n    window.onkeyup = (e) => { keys[e.code] = false; };\n\n    function loop() {\n      frame++;\n      ctx.fillStyle = theme.bg;\n      ctx.fillRect(0, 0, W, H);\n\n      if (keys['ArrowLeft'] || keys['KeyA']) playerX = Math.max(30, playerX - playerSpeed);\n      if (keys['ArrowRight'] || keys['KeyD']) playerX = Math.min(W - 30, playerX + playerSpeed);\n\n      if (frame % 30 === 0) {\n        items.push({ x: Math.random() * (W - 40) + 20, y: 0, speed: Math.random() * 3 + 2 });\n      }\n\n      items.forEach(it => {\n        it.y += it.speed;\n        ctx.fillStyle = theme.accent;\n        ctx.fillRect(it.x - 8, it.y - 8, 16, 16);\n        if (it.y > H - 50 && Math.abs(it.x - playerX) < 30) {\n          score += 20;\n          it.y = H + 100;\n        }\n      });\n      items = items.filter(it => it.y < H);\n\n      // Draw Player Paddle/Ship\n      ctx.fillStyle = theme.primary;\n      ctx.fillRect(playerX - 25, H - 40, 50, 14);\n\n      ctx.fillStyle = theme.text;\n      ctx.font = 'bold 16px ' + theme.font;\n      const gameLabel = (promptText || '2D ARCADE').slice(0, 24).toUpperCase();\n      ctx.fillText(`${gameLabel} • SCORE: ${score}`, 20, 30);\n      ctx.font = '11px ' + theme.font;\n      ctx.fillStyle = theme.subtext;\n      ctx.fillText(`Left / Right or A / D to steer • [${theme.name}] • :${model}`, 20, 50);\n\n      window.__pgActiveAnimId = requestAnimationFrame(loop);\n    }\n    loop();\n  };\n\n  // Immediate initialization\n  window.renderStylePresets();\n  window.switchPlaygroundMode('svgs');\n  const slot1 = document.getElementById('pg-prompt-slot-1');\n  if (slot1) {\n    slot1.value = STYLE_PRESETS[0].text;\n    slot1.addEventListener('input', () => {\n      const val = slot1.value.trim();\n      const matched = STYLE_PRESETS.find(s => s.text.trim() === val);\n      window.__pgActiveStyleId = matched ? matched.id : '';\n      window.renderStylePresets();\n    });\n  }\n\n  const slot2 = document.getElementById('pg-prompt-slot-2');\n  if (slot2) {\n    slot2.addEventListener('input', () => {\n      const val = slot2.value.trim();\n      const list = PROMPT_PRESETS[window.__pgCurrentMode] || [];\n      const matched = list.find(p => p.prompt.trim() === val);\n      window.__pgActivePromptId = matched ? matched.id : '';\n      window.renderPromptPresets();\n    });\n  }\n\n  // Start model bootstrapping lifecycle\n  window.bootstrapModelHarnesses('mini (1.5B)');\n})();\n  </script>\n</section>")

(df playground-view [] -> Str
  :d "Playground view alias"
  (render-playground-view))
