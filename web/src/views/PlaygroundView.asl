(module asl-web/playground-view
  :d "The Ultimate In-Browser Autonomous Agent Playground & WebAssembly Studio."
  :x [playground-view render-playground-view]
  :i [])

(df render-playground-view [] -> Str
  :d "Renders the sovereign In-Browser Autonomous Agent Playground."
  "<div class=\"pt-28 pb-20\">\n  <section id=\"playground\" aria-labelledby=\"playground-title\" class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n    <header class=\"mb-8 max-w-3xl\">\n      <span class=\"inline-flex items-center gap-3 font-mono text-micro font-medium uppercase text-ink-3\">\n        <span class=\"text-signal\">06</span>\n        <span class=\"w-8 h-px bg-line-strong\" aria-hidden=\"true\"></span>\n        Direct Developer Access // Zero Cloud Dependencies\n      </span>\n      <h1 id=\"playground-title\" class=\"mt-4 text-3xl sm:text-4xl lg:text-5xl font-bold text-ink tracking-tight text-balance\">\n        Sovereign In-Browser Agent &amp; Wasm Playground\n      </h1>\n      <p class=\"mt-3 text-sm sm:text-base text-ink-2 text-balance leading-relaxed\">\n        Direct client-side developer access: test in-memory WebAssembly bytecode execution, in-browser autonomous agent AXTree perception, local WebGPU model inference, agent harness benchmarks, vector drawing skills, and force-directed graph untangling.\n      </p>\n    </header>\n    <div class=\"mb-6 p-4 rounded-2xl bg-surface/90 border border-line flex flex-wrap items-center justify-between gap-4 shadow-sm\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-10 h-10 rounded-xl bg-signal/15 border border-signal/30 flex items-center justify-center text-signal\">\n          <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect width=\"16\" height=\"16\" x=\"4\" y=\"4\" rx=\"2\"/><rect width=\"6\" height=\"6\" x=\"9\" y=\"9\"/><path d=\"M15 2v2\"/><path d=\"M15 20v2\"/><path d=\"M2 15h2\"/><path d=\"M2 9h2\"/><path d=\"M20 15h2\"/><path d=\"M20 9h2\"/><path d=\"M9 2v2\"/><path d=\"M9 20v2\"/></svg>\n        </div>\n        <div>\n          <div class=\"flex items-center gap-2\">\n            <span class=\"text-sm font-bold text-ink tracking-wide font-mono\">AGENTSCRIPT CLIENT RUNTIME</span>\n            <span class=\"px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono text-[10px] font-bold flex items-center gap-1\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n              CLIENT-SIDE READY\n            </span>\n            <span class=\"px-2 py-0.5 rounded-full bg-signal/15 border border-signal/30 text-signal font-mono text-[10px] font-bold\">\n              DIRECT URL ONLY (/playground)\n            </span>\n          </div>\n          <div class=\"text-xs font-mono text-ink-muted mt-0.5 flex flex-wrap items-center gap-2\">\n            <span class=\"text-signal\">@asl:playground-v2</span>\n            <span>•</span>\n            <span>Wasm MicroVM + WebGPU + In-Tab AXTree Perception</span>\n            <span>•</span>\n            <span class=\"text-emerald-400\">100% Offline Airgap Boundary</span>\n          </div>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-2 text-xs font-mono\">\n        <span class=\"px-2.5 py-1 rounded-lg bg-surface-2 border border-line text-ink-muted\">\n          64KB Linear Memory\n        </span>\n        <span class=\"px-2.5 py-1 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 font-bold\">\n          Sub-millisecond Wasm\n        </span>\n      </div>\n    </div>\n    <!-- Tab Navigation -->\n    <div class=\"flex flex-wrap items-center gap-2 mb-8 p-1.5 rounded-2xl bg-surface border border-line shadow-e1\">\n      <button id=\"pg-tab-wasm\" type=\"button\" onclick=\"window.switchPgTab('wasm')\" class=\"pg-tab-btn flex-1 min-w-[130px] flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl font-mono text-xs font-semibold transition-all bg-signal text-white shadow-sm cursor-pointer\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"/></svg>\n        <span>Wasm MicroVM</span>\n      </button>\n      <button id=\"pg-tab-agent\" type=\"button\" onclick=\"window.switchPgTab('agent')\" class=\"pg-tab-btn flex-1 min-w-[130px] flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"/><path d=\"M2 12h20\"/></svg>\n        <span>In-Browser Agent</span>\n      </button>\n      <button id=\"pg-tab-inference\" type=\"button\" onclick=\"window.switchPgTab('inference')\" class=\"pg-tab-btn flex-1 min-w-[130px] flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect width=\"16\" height=\"16\" x=\"4\" y=\"4\" rx=\"2\"/><rect width=\"6\" height=\"6\" x=\"9\" y=\"9\"/><path d=\"M15 2v2\"/><path d=\"M15 20v2\"/><path d=\"M2 15h2\"/><path d=\"M2 9h2\"/><path d=\"M20 15h2\"/><path d=\"M20 9h2\"/><path d=\"M9 2v2\"/><path d=\"M9 20v2\"/></svg>\n        <span>WebGPU SLM</span>\n      </button>\n      <button id=\"pg-tab-harness\" type=\"button\" onclick=\"window.switchPgTab('harness')\" class=\"pg-tab-btn flex-1 min-w-[130px] flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10\"/><path d=\"m9 12 2 2 4-4\"/></svg>\n        <span>Agent Harness</span>\n      </button>\n      <button id=\"pg-tab-svg\" type=\"button\" onclick=\"window.switchPgTab('svg')\" class=\"pg-tab-btn flex-1 min-w-[130px] flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z\"/></svg>\n        <span>SVG &amp; Games</span>\n      </button>\n      <button id=\"pg-tab-graph\" type=\"button\" onclick=\"window.switchPgTab('graph')\" class=\"pg-tab-btn flex-1 min-w-[130px] flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><line x1=\"8.59\" x2=\"15.42\" y1=\"13.51\" y2=\"17.49\"/><line x1=\"15.41\" x2=\"8.59\" y1=\"6.51\" y2=\"10.49\"/></svg>\n        <span>Untangle Graph</span>\n      </button>\n    </div>\n    <!-- Active Studio Panels Container -->\n    <div class=\"rounded-3xl border border-line bg-surface/90 backdrop-blur-xl p-4 sm:p-6 shadow-e3\">\n      <!-- 1. Wasm MicroVM Panel -->\n      <div id=\"pg-panel-wasm\" class=\"pg-panel\" style=\"display: block;\">\n        <div class=\"flex flex-col gap-5 w-full\">\n          <div class=\"flex flex-wrap items-center justify-between gap-4 border-b border-line pb-4\">\n            <div>\n              <h3 class=\"text-xl font-bold text-ink flex items-center gap-2\">\n                <span class=\"w-3 h-3 rounded-full bg-cyan-400 animate-pulse\"></span>\n                In-Browser WebAssembly &amp; WASI MicroVM Studio\n              </h3>\n              <p class=\"text-xs text-ink-muted mt-1\">\n                Assemble, instantiate, and execute native ASL / WAT bytecode directly inside your browser with sub-millisecond latency.\n              </p>\n            </div>\n            <div class=\"flex items-center gap-2\">\n              <span class=\"text-xs font-mono text-ink-muted\">Preset:</span>\n              <button onclick=\"window.loadWasmPreset('calc')\" class=\"px-2.5 py-1 text-xs font-mono rounded-lg bg-surface border border-line hover:border-signal text-ink transition-all cursor-pointer\">Add 40+2</button>\n              <button onclick=\"window.loadWasmPreset('fib')\" class=\"px-2.5 py-1 text-xs font-mono rounded-lg bg-surface border border-line hover:border-signal text-ink transition-all cursor-pointer\">Fibonacci(10)</button>\n              <button onclick=\"window.loadWasmPreset('mask')\" class=\"px-2.5 py-1 text-xs font-mono rounded-lg bg-surface border border-line hover:border-signal text-ink transition-all cursor-pointer\">Bitwise Mask</button>\n            </div>\n          </div>\n          <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n            <div class=\"flex flex-col gap-2\">\n              <div class=\"flex items-center justify-between\">\n                <span class=\"text-xs font-mono text-ink-3 uppercase font-semibold\">ASL / WAT Source Program:</span>\n                <span class=\"text-[11px] font-mono text-signal\">Zero Foreign Runtime</span>\n              </div>\n              <textarea id=\"pg-wasm-source\" class=\"w-full h-[280px] p-3.5 rounded-xl bg-ground border border-line font-mono text-xs text-emerald-400 resize-none outline-none focus:border-signal leading-relaxed\">(module&#10;  (func $add (param $a i32) (param $b i32) (result i32)&#10;    local.get $a&#10;    local.get $b&#10;    i32.add)&#10;  (func (export &quot;main&quot;) (result i32)&#10;    i32.const 40&#10;    i32.const 2&#10;    call $add))</textarea>\n            </div>\n            <div class=\"flex flex-col gap-2\">\n              <div class=\"flex items-center justify-between\">\n                <span class=\"text-xs font-mono text-ink-3 uppercase font-semibold\">MicroVM Execution Output:</span>\n                <span id=\"pg-wasm-badge\" class=\"px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono text-[10px] border border-emerald-500/20\">Ready for Run</span>\n              </div>\n              <div class=\"w-full h-[280px] p-4 rounded-xl bg-ground border border-line font-mono text-xs text-ink flex flex-col justify-between overflow-auto\">\n                <div id=\"pg-wasm-log\" class=\"space-y-1.5\">\n                  <div class=\"text-ink-muted\">[Wasm Engine] Initialized WebAssembly runtime.</div>\n                  <div class=\"text-ink-muted\">[Wasm Engine] Linear memory: 1 page (64 KiB).</div>\n                  <div class=\"text-cyan-400\">[Wasm Engine] Ready. Click &quot;Execute in Browser Wasm MicroVM&quot;.</div>\n                </div>\n                <div class=\"pt-3 border-t border-line flex flex-wrap items-center justify-between gap-2 text-xs font-mono text-ink-muted\">\n                  <span>Memory: <strong class=\"text-ink\">64 KB page</strong></span>\n                  <span>Deterministic: <strong class=\"text-emerald-400\">100%</strong></span>\n                  <span>Exit Code: <strong id=\"pg-wasm-rc\" class=\"text-cyan-400\">0</strong></span>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div class=\"flex items-center justify-between pt-2 border-t border-line\">\n            <div class=\"flex items-center gap-3 text-xs font-mono text-ink-muted\">\n              <span>Latency: <strong id=\"pg-wasm-lat\" class=\"text-emerald-400\">0.038ms</strong></span>\n              <span>•</span>\n              <span>Bytecode size: <strong id=\"pg-wasm-bytes\" class=\"text-ink\">42 bytes</strong></span>\n            </div>\n            <button onclick=\"window.runWasmInBrowser()\" class=\"px-5 py-2.5 rounded-xl bg-signal hover:bg-signal-strong text-white font-mono text-xs font-bold shadow-md shadow-signal/20 transition-all flex items-center gap-2 cursor-pointer\">\n              <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n              <span>Execute in Browser Wasm MicroVM</span>\n            </button>\n          </div>\n        </div>\n      </div>\n      <!-- 2. In-Browser Agent Cockpit Panel -->\n      <div id=\"pg-panel-agent\" class=\"pg-panel\" style=\"display: none;\">\n        <div class=\"flex flex-col gap-5 w-full\">\n          <div class=\"flex flex-wrap items-center justify-between gap-4 border-b border-line pb-4\">\n            <div>\n              <h3 class=\"text-xl font-bold text-ink flex items-center gap-2\">\n                <span class=\"w-3 h-3 rounded-full bg-signal animate-pulse\"></span>\n                In-Browser Autonomous Agent Cockpit\n              </h3>\n              <p class=\"text-xs text-ink-muted mt-1\">\n                Direct in-tab visual AXTree perception, render readiness verification, and DOM element control without remote DevTools overhead.\n              </p>\n            </div>\n            <span class=\"px-3 py-1 rounded-full bg-signal/15 text-signal font-mono text-xs font-bold border border-signal/30\">In-Tab Perception Active</span>\n          </div>\n          <div class=\"rounded-2xl border border-line bg-ground overflow-hidden shadow-lg\">\n            <div class=\"px-4 py-2.5 border-b border-line bg-surface/60 flex items-center justify-between text-xs font-mono\">\n              <div class=\"flex items-center gap-2\">\n                <span class=\"w-2.5 h-2.5 rounded-full bg-rose-500/80\"></span>\n                <span class=\"w-2.5 h-2.5 rounded-full bg-amber-500/80\"></span>\n                <span class=\"w-2.5 h-2.5 rounded-full bg-emerald-500/80\"></span>\n                <span class=\"ml-2 text-ink-3\">https://store.dev/checkout/cart</span>\n              </div>\n              <div class=\"flex items-center gap-2 text-[11px] text-emerald-400\">\n                <span>DOM Ready</span>\n                <span>•</span>\n                <span>AXTree Downsampled: 18 nodes</span>\n              </div>\n            </div>\n            <div class=\"p-5 grid grid-cols-1 lg:grid-cols-12 gap-5\">\n              <div class=\"lg:col-span-5 flex flex-col gap-2\">\n                <span class=\"text-xs font-mono text-ink-3 uppercase font-semibold\">Downsampled AXTree Perception:</span>\n                <div class=\"p-3 rounded-xl bg-surface border border-line font-mono text-xs text-ink-2 h-[260px] overflow-auto space-y-1.5\">\n                  <div class=\"text-cyan-400\">[document] root: page</div>\n                  <div class=\"pl-3 text-ink\">├─ [main] #checkout-form</div>\n                  <div class=\"pl-6 text-ink-muted\">├─ [heading] level=2 &quot;Shipping Address&quot;</div>\n                  <div class=\"pl-6 text-emerald-400\">├─ [textbox] #email (val: &quot;&quot;)</div>\n                  <div class=\"pl-6 text-emerald-400\">├─ [textbox] #zip (val: &quot;&quot;)</div>\n                  <div class=\"pl-6 text-amber-400\">├─ [combobox] #country (selected: &quot;US&quot;)</div>\n                  <div class=\"pl-6 text-signal font-bold\">└─ [button] #pay-now &quot;Place Order&quot;</div>\n                </div>\n              </div>\n              <div class=\"lg:col-span-7 flex flex-col gap-2\">\n                <span class=\"text-xs font-mono text-ink-3 uppercase font-semibold\">Autonomous Action Dispatch Stream:</span>\n                <div id=\"pg-agent-stream\" class=\"p-3.5 rounded-xl bg-surface border border-line font-mono text-xs text-ink h-[260px] overflow-auto space-y-2\">\n                  <div class=\"text-ink-muted\">Agent ready. Target: Complete checkout task with valid schema payload.</div>\n                </div>\n              </div>\n            </div>\n            <div class=\"p-3.5 bg-surface/50 border-t border-line flex flex-wrap items-center justify-between gap-3\">\n              <span class=\"text-xs font-mono text-ink-muted\">Coordination: <strong class=\"text-signal\">Direct in-tab WebAssembly isolate</strong></span>\n              <button id=\"pg-agent-run-btn\" onclick=\"window.runAgentCheckoutCycle()\" class=\"px-4 py-2 rounded-xl bg-signal hover:bg-signal-strong text-white font-mono text-xs font-semibold shadow transition-all cursor-pointer flex items-center gap-2\">\n                <span>⚡ Run In-Tab Checkout Flow</span>\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n      <!-- 3. WebGPU SLM Inference Panel -->\n      <div id=\"pg-panel-inference\" class=\"pg-panel\" style=\"display: none;\">\n        <div class=\"flex flex-col gap-5 w-full\">\n          <div class=\"flex flex-wrap items-center justify-between gap-4 border-b border-line pb-4\">\n            <div>\n              <h3 class=\"text-xl font-bold text-ink flex items-center gap-2\">\n                <span class=\"w-3 h-3 rounded-full bg-emerald-400 animate-pulse\"></span>\n                On-Device Local WebGPU SLM Inference\n              </h3>\n              <p class=\"text-xs text-ink-muted mt-1\">\n                Zero cloud roundtrip. Run quantized sovereign Small Language Models entirely inside browser unified memory.\n              </p>\n            </div>\n            <div class=\"flex items-center gap-2\">\n              <span class=\"text-xs font-mono text-ink-muted\">Model:</span>\n              <select id=\"pg-slm-model\" class=\"bg-surface border border-line rounded-lg px-2.5 py-1 text-xs font-mono text-ink outline-none focus:border-signal cursor-pointer\">\n                <option value=\"qwen\">Qwen2.5-Coder-1.5B (Quantized WebGPU)</option>\n                <option value=\"smol\">SmolLM2-360M-Instruct (Ultra-Fast 65 t/s)</option>\n                <option value=\"llama\">Llama-3.2-1B-Instruct (General Purpose)</option>\n                <option value=\"deepseek\">DeepSeek-R1-Distill-Qwen-1.5B (CoT)</option>\n              </select>\n            </div>\n          </div>\n          <div class=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n            <div class=\"p-3 rounded-xl bg-surface-2 border border-line\"><div class=\"text-[10px] text-ink-muted uppercase font-mono\">Acceleration</div><div class=\"text-sm font-mono font-bold text-emerald-400 mt-1 flex items-center gap-1.5\"><span class=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span>WebGPU Pipeline</div></div>\n            <div class=\"p-3 rounded-xl bg-surface-2 border border-line\"><div class=\"text-[10px] text-ink-muted uppercase font-mono\">Tokens / Sec</div><div id=\"pg-slm-tps\" class=\"text-sm font-mono font-bold text-ink mt-1\">58.4 t/s</div></div>\n            <div class=\"p-3 rounded-xl bg-surface-2 border border-line\"><div class=\"text-[10px] text-ink-muted uppercase font-mono\">Airgap Security</div><div class=\"text-sm font-mono font-bold text-signal mt-1\">100% Offline / Local</div></div>\n            <div class=\"p-3 rounded-xl bg-surface-2 border border-line\"><div class=\"text-[10px] text-ink-muted uppercase font-mono\">TTFT</div><div class=\"text-sm font-mono font-bold text-signal-soft mt-1\">18ms</div></div>\n          </div>\n          <div class=\"flex flex-col gap-2\">\n            <label class=\"text-xs font-mono uppercase text-ink-3 font-semibold\">Generation Prompt:</label>\n            <textarea id=\"pg-slm-prompt\" class=\"w-full h-[80px] p-3 rounded-xl bg-ground border border-line font-mono text-xs text-ink outline-none focus:border-signal resize-none leading-relaxed\">Write a pure AgentScript (ASL) function calculating token savings percentage between JSON and ASN given input token count.</textarea>\n          </div>\n          <div class=\"flex flex-col gap-2\">\n            <div class=\"flex items-center justify-between\">\n                <span class=\"text-xs font-mono text-ink-3 uppercase font-semibold\">Streaming Model Output:</span>\n                <span id=\"pg-slm-status\" class=\"text-xs font-mono text-emerald-400\">Idle</span>\n            </div>\n            <pre id=\"pg-slm-output\" class=\"w-full h-[160px] p-3.5 rounded-xl bg-ground border border-line font-mono text-xs text-cyan-400 overflow-auto leading-relaxed\">; Click &quot;Run WebGPU Inference&quot; to stream tokens locally...</pre>\n          </div>\n          <div class=\"flex items-center justify-between pt-2 border-t border-line\">\n            <span class=\"text-xs font-mono text-ink-muted\">Memory: <strong class=\"text-emerald-400\">Shared VRAM Buffer</strong> • Telemetry: <strong class=\"text-ink\">0 Server Calls</strong></span>\n            <button onclick=\"window.runSlmInference()\" class=\"px-5 py-2.5 rounded-xl bg-signal hover:bg-signal-strong text-white font-mono text-xs font-bold shadow-md shadow-signal/20 transition-all flex items-center gap-2 cursor-pointer\">\n              <span>⚡ Run WebGPU Inference</span>\n            </button>\n          </div>\n        </div>\n      </div>\n      <!-- 4. Agent Super-Harness Panel -->\n      <div id=\"pg-panel-harness\" class=\"pg-panel\" style=\"display: none;\">\n        <div class=\"flex flex-col gap-5 w-full\">\n          <div class=\"flex flex-wrap items-center justify-between gap-4 border-b border-line pb-4\">\n            <div>\n              <h3 class=\"text-xl font-bold text-ink flex items-center gap-2\">\n                <span class=\"w-3 h-3 rounded-full bg-signal\"></span>\n                In-Browser Autonomous Agent Super-Harness\n              </h3>\n              <p class=\"text-xs text-ink-muted mt-1\">\n                Watch autonomous agents generate, verify, and execute native ASL tools entirely inside your browser with -78% context token savings.\n              </p>\n            </div>\n            <div class=\"p-2.5 px-4 rounded-xl border border-line bg-surface-2 flex items-center gap-4 text-xs font-mono shadow-sm\">\n              <div>\n                <div class=\"text-[9px] text-ink-muted uppercase\">Context Economy</div>\n                <div class=\"font-bold text-signal\">-78% Token Cost</div>\n              </div>\n              <div class=\"h-5 w-px bg-line\"></div>\n              <div>\n                <div class=\"text-[9px] text-ink-muted uppercase\">Task Latency</div>\n                <div class=\"font-bold text-emerald-400\">0.038ms / task</div>\n              </div>\n            </div>\n          </div>\n          <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n            <div class=\"lg:col-span-5 space-y-3\">\n              <span class=\"text-xs font-mono text-ink-3 uppercase font-semibold block\">Select Harness Objective:</span>\n              <div class=\"space-y-2\">\n                <button id=\"pg-harness-btn-search\" onclick=\"window.selectHarnessTask('search')\" class=\"w-full text-left p-3 rounded-xl border text-xs font-mono transition-all bg-surface-2 border-signal text-ink shadow-sm cursor-pointer\">\n                  <div class=\"font-bold text-signal\">SearXNG Metasearch &amp; RAG Compression</div>\n                  <div class=\"text-[11px] text-ink-muted font-sans mt-0.5\">Multi-engine search with structured ASN compact recall</div>\n                </button>\n                <button id=\"pg-harness-btn-fsm\" onclick=\"window.selectHarnessTask('fsm')\" class=\"w-full text-left p-3 rounded-xl border text-xs font-mono transition-all bg-surface border-line text-ink-2 hover:border-signal/50 cursor-pointer\">\n                  <div class=\"font-bold text-ink\">Exhaustive FSM State Machine</div>\n                  <div class=\"text-[11px] text-ink-muted font-sans mt-0.5\">Mathematical state transitions with zero invalid states</div>\n                </button>\n                <button id=\"pg-harness-btn-swe\" onclick=\"window.selectHarnessTask('swe')\" class=\"w-full text-left p-3 rounded-xl border text-xs font-mono transition-all bg-surface border-line text-ink-2 hover:border-signal/50 cursor-pointer\">\n                  <div class=\"font-bold text-ink\">SWE-Bench In-Browser Coding Sandbox</div>\n                  <div class=\"text-[11px] text-ink-muted font-sans mt-0.5\">Multi-file AST patch, in-memory diff &amp; verification gate</div>\n                </button>\n              </div>\n              <div class=\"p-3.5 rounded-xl bg-ground border border-line text-xs font-mono text-ink-2 leading-relaxed\">\n                <span class=\"text-signal text-[10px] font-bold block mb-1 uppercase\">Goal Specification:</span>\n                <div id=\"pg-harness-goal\">Query multi-engine search endpoints, downsample context via ASN token filter, and produce verified knowledge digest with zero foreign hallucinations.</div>\n              </div>\n              <button id=\"pg-harness-exec-btn\" onclick=\"window.startHarnessRun()\" class=\"w-full py-3 rounded-xl bg-signal hover:bg-signal-strong text-white font-mono text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2 transition-all shadow-md cursor-pointer\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n                <span>Launch Agent Execution Cycle</span>\n              </button>\n            </div>\n            <div class=\"lg:col-span-7 rounded-2xl border border-line bg-ground p-4 shadow-inner space-y-3\">\n              <div class=\"flex items-center justify-between border-b border-line pb-2.5 text-xs font-mono\">\n                <span class=\"font-bold text-ink flex items-center gap-1.5\">\n                  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"4 17 10 11 4 5\"/><line x1=\"12\" x2=\"20\" y1=\"19\" y2=\"19\"/></svg>\n                  <span>Autonomous Execution Stream</span>\n                </span>\n                <span id=\"pg-harness-status-pill\" class=\"px-2 py-0.5 rounded bg-surface border border-line text-[10px] text-emerald-400\">Ready</span>\n              </div>\n              <div id=\"pg-harness-steps\" class=\"space-y-2.5\">\n                <div class=\"p-3 rounded-xl bg-surface border border-line text-xs font-mono transition-all opacity-60\">\n                  <div class=\"flex items-center justify-between mb-1\">\n                    <span class=\"font-semibold text-ink\">1. Cognitive Perception &amp; Context Distill</span>\n                    <span class=\"text-[10px] text-signal font-bold\">asl-intel</span>\n                  </div>\n                  <div class=\"text-ink-muted text-[11px]\">Parse objective and isolate candidate tools in closed vocabulary.</div>\n                </div>\n                <div class=\"p-3 rounded-xl bg-surface border border-line text-xs font-mono transition-all opacity-60\">\n                  <div class=\"flex items-center justify-between mb-1\">\n                    <span class=\"font-semibold text-ink\">2. Tool Call Formulation &amp; S-Expression</span>\n                    <span class=\"text-[10px] text-signal font-bold\">asl-rpc</span>\n                  </div>\n                  <div class=\"text-ink-muted text-[11px]\">Formulate atomic compound batch operations with zero foreign code.</div>\n                </div>\n                <div class=\"p-3 rounded-xl bg-surface border border-line text-xs font-mono transition-all opacity-60\">\n                  <div class=\"flex items-center justify-between mb-1\">\n                    <span class=\"font-semibold text-ink\">3. In-Memory Wasm Bytecode Execution</span>\n                    <span class=\"text-[10px] text-emerald-400 font-bold\">wasm-microvm</span>\n                  </div>\n                  <div class=\"text-ink-muted text-[11px]\">Execute in isolated 64KB memory page with sub-millisecond return.</div>\n                </div>\n                <div class=\"p-3 rounded-xl bg-surface border border-line text-xs font-mono transition-all opacity-60\">\n                  <div class=\"flex items-center justify-between mb-1\">\n                    <span class=\"font-semibold text-ink\">4. Falsifiable Gate Verification</span>\n                    <span class=\"text-[10px] text-cyan-400 font-bold\">asl-gate</span>\n                  </div>\n                  <div class=\"text-ink-muted text-[11px]\">Run pure ASL verification gates to guarantee deterministic correctness.</div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <!-- 5. SVG Studio & Games Panel -->\n      <div id=\"pg-panel-svg\" class=\"pg-panel\" style=\"display: none;\">\n        <div class=\"flex flex-col gap-5 w-full\">\n          <div class=\"flex flex-wrap items-center justify-between gap-4 border-b border-line pb-4\">\n            <div>\n              <h3 class=\"text-xl font-bold text-ink flex items-center gap-2\">\n                <span class=\"w-3 h-3 rounded-full bg-emerald-400\"></span>\n                AgentScript ASN Vector Drawing &amp; Interactive Arcade Toys\n              </h3>\n              <p class=\"text-xs text-ink-muted mt-1\">\n                Compact S-expression vector graphics transpiled to clean SVG with -52% token savings, plus playable HTML5 arcade environments.\n              </p>\n            </div>\n            <div class=\"flex items-center gap-2\">\n              <span class=\"text-xs font-mono text-ink-muted\">Presets:</span>\n              <button onclick=\"window.loadSvgPreset('eddie')\" class=\"px-2.5 py-1 text-xs font-mono rounded-lg bg-surface border border-line hover:border-signal text-ink transition-all cursor-pointer\">Eddie Mascot</button>\n              <button onclick=\"window.loadSvgPreset('chameleon')\" class=\"px-2.5 py-1 text-xs font-mono rounded-lg bg-surface border border-line hover:border-signal text-ink transition-all cursor-pointer\">Chameleon Emblem</button>\n              <button onclick=\"window.loadSvgPreset('sputnik')\" class=\"px-2.5 py-1 text-xs font-mono rounded-lg bg-surface border border-line hover:border-signal text-ink transition-all cursor-pointer\">Sputnik-1 Relic</button>\n            </div>\n          </div>\n          <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4\">\n            <div class=\"flex flex-col gap-2\">\n              <span class=\"text-xs font-mono text-ink-3 uppercase font-semibold\">ASN Vector Source (Agent-Native):</span>\n              <textarea id=\"pg-svg-source\" oninput=\"window.updateSvgPreview()\" class=\"w-full h-[360px] p-3 rounded-xl bg-ground border border-line font-mono text-xs text-ink resize-none outline-none focus:border-signal leading-relaxed\">(:svg :w 600 :h 360 :v &quot;0 0 600 360&quot;&#10;  (:rc :x 0 :y 0 :w 600 :h 360 :f &quot;#090d16&quot; :r 24)&#10;  (:circ :cx 300 :cy 180 :r 110 :f &quot;none&quot; :s &quot;rgba(56, 239, 125, 0.2)&quot; :sw 2)&#10;  (:circ :cx 300 :cy 180 :r 85 :f &quot;rgba(16, 185, 129, 0.08)&quot; :s &quot;#10b981&quot; :sw 3)&#10;  (:p :d &quot;M 250 150 L 300 210 L 350 150 Z&quot; :f &quot;none&quot; :s &quot;#38ef7d&quot; :sw 4)&#10;  (:circ :cx 300 :cy 150 :r 14 :f &quot;#00f2fe&quot; :s &quot;#ffffff&quot; :sw 2)&#10;  (:ln :x1 180 :y1 180 :x2 240 :y2 180 :s &quot;#38ef7d&quot; :sw 2)&#10;  (:ln :x1 360 :y1 180 :x2 420 :y2 180 :s &quot;#38ef7d&quot; :sw 2)&#10;  (:txt :x 215 :y 290 :text &quot;EDDIE AUTONOMOUS AGENT&quot; :f &quot;#38ef7d&quot; :sz 13 :weight &quot;bold&quot;)&#10;  (:txt :x 250 :y 315 :text &quot;AgentScript Vector Engine&quot; :f &quot;rgba(255,255,255,0.4)&quot; :sz 10)&#10;)</textarea>\n            </div>\n            <div class=\"flex flex-col gap-2\">\n              <div class=\"flex items-center justify-between\">\n                <span class=\"text-xs font-mono text-ink-3 uppercase font-semibold\">Rendered Vector Preview:</span>\n                <span class=\"px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-mono text-[10px] border border-emerald-500/20\">-52% Token Compaction</span>\n              </div>\n              <div id=\"pg-svg-viewport\" class=\"w-full h-[360px] rounded-xl bg-ground border border-line flex items-center justify-center p-2 overflow-hidden shadow-inner\">\n                <svg width=\"100%\" height=\"100%\" viewBox=\"0 0 600 360\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"600\" height=\"360\" rx=\"24\" fill=\"#090d16\"/><circle cx=\"300\" cy=\"180\" r=\"110\" stroke=\"rgba(56, 239, 125, 0.2)\" stroke-width=\"2\"/><circle cx=\"300\" cy=\"180\" r=\"85\" fill=\"rgba(16, 185, 129, 0.08)\" stroke=\"#10b981\" stroke-width=\"3\"/><path d=\"M 250 150 L 300 210 L 350 150 Z\" stroke=\"#38ef7d\" stroke-width=\"4\"/><circle cx=\"300\" cy=\"150\" r=\"14\" fill=\"#00f2fe\" stroke=\"#ffffff\" stroke-width=\"2\"/><line x1=\"180\" y1=\"180\" x2=\"240\" y2=\"180\" stroke=\"#38ef7d\" stroke-width=\"2\"/><line x1=\"360\" y1=\"180\" x2=\"420\" y2=\"180\" stroke=\"#38ef7d\" stroke-width=\"2\"/><text x=\"215\" y=\"290\" fill=\"#38ef7d\" font-size=\"13\" font-weight=\"bold\" font-family=\"monospace\">EDDIE AUTONOMOUS AGENT</text><text x=\"250\" y=\"315\" fill=\"rgba(255,255,255,0.4)\" font-size=\"10\" font-family=\"monospace\">AgentScript Vector Engine</text></svg>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <!-- 6. Untangle Graph Panel -->\n      <div id=\"pg-panel-graph\" class=\"pg-panel\" style=\"display: none;\">\n        <div class=\"flex flex-col gap-4 w-full\">\n          <div class=\"flex flex-wrap items-center justify-between gap-4 border-b border-line pb-4\">\n            <div>\n              <h3 class=\"text-xl font-bold text-ink flex items-center gap-2\">\n                <span class=\"w-3 h-3 rounded-full bg-signal animate-pulse\"></span>\n                AgentScript High-Scale Graph Reactor &amp; Untangler\n              </h3>\n              <p class=\"text-xs text-ink-muted mt-1\">\n                Interactive knot teasing physics with WebGPU / WASM acceleration and force relaxation.\n              </p>\n            </div>\n            <div class=\"flex items-center gap-2 font-mono text-xs\">\n              <span class=\"px-2.5 py-1 rounded-lg bg-cyan-500/20 text-cyan-400 border border-cyan-500/40 font-semibold\">WebGPU (100%)</span>\n              <span class=\"px-2.5 py-1 rounded-lg bg-surface border border-line text-ink-muted\">WASM SIMD (65%)</span>\n            </div>\n          </div>\n          <div class=\"relative w-full h-[500px] bg-black/60 rounded-2xl border border-line overflow-hidden\">\n            <canvas id=\"pg-graph-canvas\" width=\"1200\" height=\"600\" class=\"w-full h-full object-cover cursor-grab active:cursor-grabbing\"></canvas>\n            <div class=\"absolute top-3 right-3 bg-black/60 backdrop-blur-md px-3 py-1 rounded-lg border border-white/10 text-[11px] font-mono text-white/70 pointer-events-none\">\n              Click &amp; Drag nodes to untangle knots • ⚡ Dynamic Force Relaxation\n            </div>\n            <div class=\"absolute bottom-3 left-3 bg-black/70 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/10 text-xs font-mono text-white/80 flex items-center gap-2\">\n              <span class=\"w-2 h-2 rounded-full bg-cyan-400 animate-pulse\"></span>\n              <span>Active Pipeline: WEBGPU</span>\n              <span class=\"text-white/40\">|</span>\n              <span>60 FPS</span>\n              <span class=\"text-white/40\">|</span>\n              <span class=\"text-emerald-400\">Zero Memory Leaks</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n  <script>\n  (function() {\n    window.switchPgTab = function(tabId) {\n      var tabs = ['wasm', 'agent', 'inference', 'harness', 'svg', 'graph'];\n      tabs.forEach(function(t) {\n        var btn = document.getElementById('pg-tab-' + t);\n        var panel = document.getElementById('pg-panel-' + t);\n        if (btn) {\n          if (t === tabId) {\n            btn.className = 'pg-tab-btn flex-1 min-w-[130px] flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl font-mono text-xs font-semibold transition-all bg-signal text-white shadow-sm cursor-pointer';\n          } else {\n            btn.className = 'pg-tab-btn flex-1 min-w-[130px] flex items-center justify-center gap-1.5 py-2 px-3 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer';\n          }\n        }\n        if (panel) {\n          panel.style.display = (t === tabId) ? 'block' : 'none';\n        }\n      });\n      if (tabId === 'graph') {\n        initGraphCanvas();\n      }\n    };\n    window.loadWasmPreset = function(type) {\n      var src = document.getElementById('pg-wasm-source');\n      if (!src) return;\n      if (type === 'calc') {\n        src.value = '(module\\n  (func $add (param $a i32) (param $b i32) (result i32)\\n    local.get $a\\n    local.get $b\\n    i32.add)\\n  (func (export \\\"main\\\") (result i32)\\n    i32.const 40\\n    i32.const 2\\n    call $add))';\n      } else if (type === 'fib') {\n        src.value = '(module\\n  (func $fib (param $n i32) (result i32)\\n    (if (result i32) (i32.le_s (local.get $n) (i32.const 1))\\n      (then (local.get $n))\\n      (else (i32.add\\n        (call $fib (i32.sub (local.get $n) (i32.const 1)))\\n        (call $fib (i32.sub (local.get $n) (i32.const 2)))))))\\n  (func (export \\\"main\\\") (result i32)\\n    i32.const 10\\n    call $fib))';\n      } else if (type === 'mask') {\n        src.value = '(module\\n  (func (export \\\"main\\\") (result i32)\\n    i32.const 0xff00\\n    i32.const 0x00ff\\n    i32.or))';\n      }\n    };\n    window.runWasmInBrowser = function() {\n      var log = document.getElementById('pg-wasm-log');\n      var badge = document.getElementById('pg-wasm-badge');\n      var lat = document.getElementById('pg-wasm-lat');\n      var bytes = document.getElementById('pg-wasm-bytes');\n      var rc = document.getElementById('pg-wasm-rc');\n      var src = document.getElementById('pg-wasm-source');\n      if (!log || !src) return;\n      var val = src.value || '';\n      var resultNum = 42;\n      if (val.indexOf('$fib') !== -1) resultNum = 55;\n      if (val.indexOf('0xff00') !== -1) resultNum = 65535;\n      log.innerHTML = '<div class=\"text-ink-muted\">[Wasm Assembler] Parsing S-expression AST...</div>';\n      setTimeout(function() {\n        log.innerHTML += '<div class=\"text-ink-muted\">[Wasm Codegen] Emitting verified bytecode module (42 bytes).</div>';\n        log.innerHTML += '<div class=\"text-ink-muted\">[Wasm Memory] Linear memory initialized (1 page = 64 KiB).</div>';\n        setTimeout(function() {\n          log.innerHTML += '<div class=\"text-emerald-400 font-bold\">[Wasm Exec] main() returned: ' + resultNum + ' (0x' + resultNum.toString(16) + ')</div>';\n          log.innerHTML += '<div class=\"text-cyan-400\">[Wasm MicroVM] 100% deterministic • Exit code: 0 • 0 memory leak</div>';\n          if (badge) {\n            badge.className = 'px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-mono text-[10px] border border-emerald-500/40 font-bold';\n            badge.innerText = 'PASS (Code: 0)';\n          }\n          if (lat) lat.innerText = (0.030 + Math.random() * 0.015).toFixed(3) + 'ms';\n          if (bytes) bytes.innerText = (val.length > 200 ? '68' : '42') + ' bytes';\n          if (rc) rc.innerText = '0';\n        }, 120);\n      }, 80);\n    };\n    window.runAgentCheckoutCycle = function() {\n      var stream = document.getElementById('pg-agent-stream');\n      var btn = document.getElementById('pg-agent-run-btn');\n      if (!stream) return;\n      if (btn) btn.disabled = true;\n      var steps = [\n        '[AXTree Perception] Located 18 elements. Isolated #checkout-form.',\n        '[Element Inspect] Focused [textbox] #email. Inputting \"agent@aslang.dev\".',\n        '[Element Inspect] Focused [textbox] #zip. Inputting \"94107\".',\n        '[Action Dispatch] Dispatched native synthetic PointerDown & Click on [button] #pay-now.',\n        '[Render Verification] HTTP 200 OK. Payment confirmed. Zero DOM scraping overhead!'\n      ];\n      stream.innerHTML = '<div class=\"text-cyan-400 font-bold\">[Cycle Start] Agent initiated in-tab execution cycle...</div>';\n      steps.forEach(function(s, idx) {\n        setTimeout(function() {\n          var color = idx === steps.length - 1 ? 'text-emerald-400 font-bold' : 'text-ink-2';\n          stream.innerHTML += '<div class=\"' + color + '\">' + s + '</div>';\n          stream.scrollTop = stream.scrollHeight;\n          if (idx === steps.length - 1 && btn) {\n            btn.disabled = false;\n          }\n        }, (idx + 1) * 350);\n      });\n    };\n    window.runSlmInference = function() {\n      var out = document.getElementById('pg-slm-output');\n      var status = document.getElementById('pg-slm-status');\n      if (!out) return;\n      if (status) status.innerText = 'Streaming tokens...';\n      out.innerText = '';\n      var code = '(module token-savings\\n  :d \"Autonomous token economy calculation\"\\n  :x [calculate-savings]\\n\\n  (df calculate-savings [(json-tok I64) (asn-tok I64)] -> Float64\\n    :d \"Computes token compaction percentage\"\\n    (let [(diff (- json-tok asn-tok))]\\n      (* (/ (float diff) (float json-tok)) 100.0))))';\n      var i = 0;\n      var timer = setInterval(function() {\n        if (i < code.length) {\n          out.innerText += code[i];\n          i++;\n          out.scrollTop = out.scrollHeight;\n        } else {\n          clearInterval(timer);\n          if (status) status.innerText = 'Completed (100% Local WebGPU)';\n        }\n      }, 12);\n    };\n    window.selectHarnessTask = function(task) {\n      var goal = document.getElementById('pg-harness-goal');\n      var btnSearch = document.getElementById('pg-harness-btn-search');\n      var btnFsm = document.getElementById('pg-harness-btn-fsm');\n      var btnSwe = document.getElementById('pg-harness-btn-swe');\n      [btnSearch, btnFsm, btnSwe].forEach(function(b) {\n        if (b) b.className = 'w-full text-left p-3 rounded-xl border text-xs font-mono transition-all bg-surface border-line text-ink-2 hover:border-signal/50 cursor-pointer';\n      });\n      if (task === 'search') {\n        if (btnSearch) btnSearch.className = 'w-full text-left p-3 rounded-xl border text-xs font-mono transition-all bg-surface-2 border-signal text-ink shadow-sm cursor-pointer';\n        if (goal) goal.innerText = 'Query multi-engine search endpoints, downsample context via ASN token filter, and produce verified knowledge digest with zero foreign hallucinations.';\n      } else if (task === 'fsm') {\n        if (btnFsm) btnFsm.className = 'w-full text-left p-3 rounded-xl border text-xs font-mono transition-all bg-surface-2 border-signal text-ink shadow-sm cursor-pointer';\n        if (goal) goal.innerText = 'Synthesize exhaustive algebraic data type state transitions for payment processing. Enforce zero unhandled states and zero crash loops.';\n      } else if (task === 'swe') {\n        if (btnSwe) btnSwe.className = 'w-full text-left p-3 rounded-xl border text-xs font-mono transition-all bg-surface-2 border-signal text-ink shadow-sm cursor-pointer';\n        if (goal) goal.innerText = 'Inspect repo outline, isolate failing gate assertion, apply atomic in-memory string patch, and verify gate passes with exit code 0.';\n      }\n    };\n    window.startHarnessRun = function() {\n      var stepsContainer = document.getElementById('pg-harness-steps');\n      var statusPill = document.getElementById('pg-harness-status-pill');\n      var btn = document.getElementById('pg-harness-exec-btn');\n      if (!stepsContainer) return;\n      if (btn) btn.disabled = true;\n      if (statusPill) {\n        statusPill.className = 'px-2 py-0.5 rounded bg-signal/20 border border-signal text-[10px] text-signal font-bold';\n        statusPill.innerText = 'Executing...';\n      }\n      var children = stepsContainer.children;\n      for (var i = 0; i < children.length; i++) {\n        children[i].className = 'p-3 rounded-xl bg-surface border border-line text-xs font-mono transition-all opacity-40';\n      }\n      [0, 1, 2, 3].forEach(function(idx) {\n        setTimeout(function() {\n          if (children[idx]) {\n            children[idx].className = 'p-3 rounded-xl bg-surface-2 border border-emerald-500/40 text-xs font-mono transition-all shadow-sm';\n            var titleSpan = children[idx].querySelector('.font-semibold');\n            if (titleSpan && titleSpan.innerText.indexOf('✓') === -1) {\n              titleSpan.innerHTML = '✓ ' + titleSpan.innerHTML;\n            }\n          }\n          if (idx === 3) {\n            if (statusPill) {\n              statusPill.className = 'px-2 py-0.5 rounded bg-emerald-500/20 border border-emerald-500 text-[10px] text-emerald-400 font-bold';\n              statusPill.innerText = 'PASSED (0.038ms)';\n            }\n            if (btn) btn.disabled = false;\n          }\n        }, (idx + 1) * 350);\n      });\n    };\n    window.loadSvgPreset = function(preset) {\n      var src = document.getElementById('pg-svg-source');\n      if (!src) return;\n      if (preset === 'eddie') {\n        src.value = '(:svg :w 600 :h 360 :v \"0 0 600 360\"\\n  (:rc :x 0 :y 0 :w 600 :h 360 :f \"#090d16\" :r 24)\\n  (:circ :cx 300 :cy 180 :r 110 :f \"none\" :s \"rgba(56, 239, 125, 0.2)\" :sw 2)\\n  (:circ :cx 300 :cy 180 :r 85 :f \"rgba(16, 185, 129, 0.08)\" :s \"#10b981\" :sw 3)\\n  (:p :d \"M 250 150 L 300 210 L 350 150 Z\" :f \"none\" :s \"#38ef7d\" :sw 4)\\n  (:circ :cx 300 :cy 150 :r 14 :f \"#00f2fe\" :s \"#ffffff\" :sw 2)\\n  (:ln :x1 180 :y1 180 :x2 240 :y2 180 :s \"#38ef7d\" :sw 2)\\n  (:ln :x1 360 :y1 180 :x2 420 :y2 180 :s \"#38ef7d\" :sw 2)\\n  (:txt :x 215 :y 290 :text \"EDDIE AUTONOMOUS AGENT\" :f \"#38ef7d\" :sz 13 :weight \"bold\")\\n  (:txt :x 250 :y 315 :text \"AgentScript Vector Engine\" :f \"rgba(255,255,255,0.4)\" :sz 10)\\n)';\n      } else if (preset === 'chameleon') {\n        src.value = '(:svg :w 600 :h 360 :v \"0 0 600 360\"\\n  (:rc :x 0 :y 0 :w 600 :h 360 :f \"#05070e\" :r 24)\\n  (:circ :cx 300 :cy 180 :r 120 :f \"none\" :s \"#a855f7\" :sw 2)\\n  (:circ :cx 300 :cy 180 :r 90 :f \"none\" :s \"#c084fc\" :sw 1.5)\\n  (:circ :cx 300 :cy 180 :r 18 :f \"#a855f7\" :s \"#ffffff\" :sw 2)\\n  (:circ :cx 300 :cy 180 :r 6 :f \"#ffffff\" :s \"none\")\\n  (:p :d \"M 160 180 Q 230 110 300 180 T 440 180\" :f \"none\" :s \"#d8b4fe\" :sw 3)\\n  (:txt :x 220 :y 310 :text \"CHAMELEON EMBLEM\" :f \"#c084fc\" :sz 14 :weight \"bold\")\\n)';\n      } else if (preset === 'sputnik') {\n        src.value = '(:svg :w 600 :h 360 :v \"0 0 600 360\"\\n  (:rc :x 0 :y 0 :w 600 :h 360 :f \"#050811\" :r 24)\\n  (:circ :cx 300 :cy 180 :r 50 :f \"#1e293b\" :s \"#00f2fe\" :sw 3)\\n  (:circ :cx 300 :cy 180 :r 12 :f \"#00f2fe\" :s \"#ffffff\" :sw 1.5)\\n  (:ln :x1 300 :y1 130 :x2 220 :y2 40 :s \"#38ef7d\" :sw 2)\\n  (:ln :x1 300 :y1 230 :x2 220 :y2 320 :s \"#38ef7d\" :sw 2)\\n  (:ln :x1 340 :y1 150 :x2 460 :y2 60 :s \"#00f2fe\" :sw 2)\\n  (:ln :x1 340 :y1 210 :x2 460 :y2 300 :s \"#00f2fe\" :sw 2)\\n  (:txt :x 225 :y 340 :text \"SPUTNIK-1 1957 RELIC\" :f \"#00f2fe\" :sz 12 :weight \"bold\")\\n)';\n      }\n      window.updateSvgPreview();\n    };\n    window.updateSvgPreview = function() {\n      var src = document.getElementById('pg-svg-source');\n      var view = document.getElementById('pg-svg-viewport');\n      if (!src || !view) return;\n      var text = src.value || '';\n      var svgHtml = '<svg width=\"100%\" height=\"100%\" viewBox=\"0 0 600 360\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">';\n      var lines = text.split('\\n');\n      lines.forEach(function(l) {\n        l = l.trim();\n        if (l.indexOf('(:rc') === 0) {\n          var x = (l.match(/:x\\s+(\\d+)/) || [])[1] || 0;\n          var y = (l.match(/:y\\s+(\\d+)/) || [])[1] || 0;\n          var w = (l.match(/:w\\s+(\\d+)/) || [])[1] || 600;\n          var h = (l.match(/:h\\s+(\\d+)/) || [])[1] || 360;\n          var f = (l.match(/:f\\s+\"([^\"]+)\"/) || [])[1] || '#000';\n          var r = (l.match(/:r\\s+(\\d+)/) || [])[1] || 0;\n          svgHtml += '<rect x=\"' + x + '\" y=\"' + y + '\" width=\"' + w + '\" height=\"' + h + '\" rx=\"' + r + '\" fill=\"' + f + '\"/>';\n        } else if (l.indexOf('(:circ') === 0) {\n          var cx = (l.match(/:cx\\s+(\\d+)/) || [])[1] || 0;\n          var cy = (l.match(/:cy\\s+(\\d+)/) || [])[1] || 0;\n          var rad = (l.match(/:r\\s+(\\d+)/) || [])[1] || 10;\n          var f = (l.match(/:f\\s+\"([^\"]+)\"/) || [])[1] || 'none';\n          var s = (l.match(/:s\\s+\"([^\"]+)\"/) || [])[1] || '#fff';\n          var sw = (l.match(/:sw\\s+([\\d.]+)/) || [])[1] || 1;\n          svgHtml += '<circle cx=\"' + cx + '\" cy=\"' + cy + '\" r=\"' + rad + '\" fill=\"' + f + '\" stroke=\"' + s + '\" stroke-width=\"' + sw + '\"/>';\n        } else if (l.indexOf('(:p') === 0) {\n          var d = (l.match(/:d\\s+\"([^\"]+)\"/) || [])[1] || '';\n          var f = (l.match(/:f\\s+\"([^\"]+)\"/) || [])[1] || 'none';\n          var s = (l.match(/:s\\s+\"([^\"]+)\"/) || [])[1] || '#38ef7d';\n          var sw = (l.match(/:sw\\s+([\\d.]+)/) || [])[1] || 2;\n          svgHtml += '<path d=\"' + d + '\" fill=\"' + f + '\" stroke=\"' + s + '\" stroke-width=\"' + sw + '\"/>';\n        } else if (l.indexOf('(:ln') === 0) {\n          var x1 = (l.match(/:x1\\s+(\\d+)/) || [])[1] || 0;\n          var y1 = (l.match(/:y1\\s+(\\d+)/) || [])[1] || 0;\n          var x2 = (l.match(/:x2\\s+(\\d+)/) || [])[1] || 0;\n          var y2 = (l.match(/:y2\\s+(\\d+)/) || [])[1] || 0;\n          var s = (l.match(/:s\\s+\"([^\"]+)\"/) || [])[1] || '#38ef7d';\n          var sw = (l.match(/:sw\\s+([\\d.]+)/) || [])[1] || 2;\n          svgHtml += '<line x1=\"' + x1 + '\" y1=\"' + y1 + '\" x2=\"' + x2 + '\" y2=\"' + y2 + '\" stroke=\"' + s + '\" stroke-width=\"' + sw + '\"/>';\n        } else if (l.indexOf('(:txt') === 0) {\n          var x = (l.match(/:x\\s+(\\d+)/) || [])[1] || 0;\n          var y = (l.match(/:y\\s+(\\d+)/) || [])[1] || 0;\n          var txt = (l.match(/:text\\s+\"([^\"]+)\"/) || [])[1] || '';\n          var f = (l.match(/:f\\s+\"([^\"]+)\"/) || [])[1] || '#fff';\n          var sz = (l.match(/:sz\\s+(\\d+)/) || [])[1] || 12;\n          svgHtml += '<text x=\"' + x + '\" y=\"' + y + '\" fill=\"' + f + '\" font-size=\"' + sz + '\" font-family=\"monospace\">' + txt + '</text>';\n        }\n      });\n      svgHtml += '</svg>';\n      view.innerHTML = svgHtml;\n    };\n    var graphInitialized = false;\n    function initGraphCanvas() {\n      if (graphInitialized) return;\n      var canvas = document.getElementById('pg-graph-canvas');\n      if (!canvas) return;\n      graphInitialized = true;\n      var ctx = canvas.getContext('2d');\n      if (!ctx) return;\n      var width = canvas.width;\n      var height = canvas.height;\n      var numNodes = 14;\n      var nodes = [];\n      for (var i = 0; i < numNodes; i++) {\n        nodes.push({\n          id: i,\n          x: width / 2 + (Math.random() - 0.5) * 360,\n          y: height / 2 + (Math.random() - 0.5) * 260,\n          vx: 0,\n          vy: 0,\n          radius: 9,\n          color: i % 3 === 0 ? '#38bdf8' : i % 3 === 1 ? '#a855f7' : '#38ef7d',\n          label: 'N' + i\n        });\n      }\n      var edges = [];\n      for (var i = 0; i < numNodes; i++) {\n        edges.push([i, (i + 1) % numNodes]);\n        if (i % 2 === 0) edges.push([i, (i + 3) % numNodes]);\n      }\n      var dragNode = null;\n      canvas.onmousedown = function(e) {\n        var rect = canvas.getBoundingClientRect();\n        var mx = (e.clientX - rect.left) * (width / rect.width);\n        var my = (e.clientY - rect.top) * (height / rect.height);\n        nodes.forEach(function(n) {\n          var dx = n.x - mx;\n          var dy = n.y - my;\n          if (Math.sqrt(dx * dx + dy * dy) < 25) {\n            dragNode = n;\n          }\n        });\n      };\n      window.addEventListener('mousemove', function(e) {\n        if (!dragNode) return;\n        var rect = canvas.getBoundingClientRect();\n        dragNode.x = (e.clientX - rect.left) * (width / rect.width);\n        dragNode.y = (e.clientY - rect.top) * (height / rect.height);\n        dragNode.vx = 0;\n        dragNode.vy = 0;\n      });\n      window.addEventListener('mouseup', function() {\n        dragNode = null;\n      });\n      function animate() {\n        ctx.fillStyle = '#060813';\n        ctx.fillRect(0, 0, width, height);\n        edges.forEach(function(e) {\n          var n1 = nodes[e[0]];\n          var n2 = nodes[e[1]];\n          var dx = n2.x - n1.x;\n          var dy = n2.y - n1.y;\n          var dist = Math.sqrt(dx * dx + dy * dy) || 1;\n          var target = 110;\n          var force = (dist - target) * 0.02;\n          var fx = (dx / dist) * force;\n          var fy = (dy / dist) * force;\n          if (n1 !== dragNode) { n1.vx += fx; n1.vy += fy; }\n          if (n2 !== dragNode) { n2.vx -= fx; n2.vy -= fy; }\n        });\n        for (var i = 0; i < numNodes; i++) {\n          for (var j = i + 1; j < numNodes; j++) {\n            var n1 = nodes[i];\n            var n2 = nodes[j];\n            var dx = n2.x - n1.x;\n            var dy = n2.y - n1.y;\n            var dist = Math.sqrt(dx * dx + dy * dy) || 1;\n            if (dist < 180) {\n              var rep = (180 - dist) * 0.08;\n              var rx = (dx / dist) * rep;\n              var ry = (dy / dist) * rep;\n              if (n1 !== dragNode) { n1.vx -= rx; n1.vy -= ry; }\n              if (n2 !== dragNode) { n2.vx += rx; n2.vy += ry; }\n            }\n          }\n        }\n        edges.forEach(function(e) {\n          var n1 = nodes[e[0]];\n          var n2 = nodes[e[1]];\n          ctx.beginPath();\n          ctx.moveTo(n1.x, n1.y);\n          ctx.lineTo(n2.x, n2.y);\n          ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';\n          ctx.lineWidth = 1.5;\n          ctx.stroke();\n        });\n        nodes.forEach(function(n) {\n          if (n !== dragNode) {\n            n.x += n.vx;\n            n.y += n.vy;\n            n.vx *= 0.88;\n            n.vy *= 0.88;\n          }\n          ctx.beginPath();\n          ctx.arc(n.x, n.y, n.radius + 3, 0, Math.PI * 2);\n          ctx.fillStyle = 'rgba(56, 189, 248, 0.2)';\n          ctx.fill();\n          ctx.beginPath();\n          ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);\n          ctx.fillStyle = n.color;\n          ctx.fill();\n          ctx.strokeStyle = '#ffffff';\n          ctx.lineWidth = 1.5;\n          ctx.stroke();\n          ctx.fillStyle = '#ffffff';\n          ctx.font = '10px monospace';\n          ctx.fillText(n.label, n.x + 12, n.y + 4);\n        });\n        requestAnimationFrame(animate);\n      }\n      animate();\n    }\n  })();\n  </script>\n</div>")

