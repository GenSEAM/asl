(module asl-web/playground-view
  :d "Pure Procedural Creative Playground with In-Browser Dynamic Generation Pipeline."
  :x [render-playground-view playground-view]
  :i [])

(df render-playground-view [] -> Str
  :d "Renders the pure procedural creative playground with no canned mock assets."
  "<section id=\"playground\" class=\"pt-20 pb-16 w-full max-w-6xl mx-auto px-4 sm:px-6\">\n  \n  \n  <header class=\"h-14 sm:h-16 px-4 sm:px-6 rounded-2xl border border-line bg-surface/90 backdrop-blur-xl flex items-center justify-between gap-4 mb-4 shadow-e2\">\n    \n    <div class=\"flex items-center gap-3 shrink-0\">\n      <div class=\"w-2.5 h-2.5 rounded-full bg-signal animate-pulse\"></div>\n      <h1 class=\"text-base sm:text-lg font-bold text-ink tracking-tight font-sans\">\n        Creative Playground\n      </h1>\n    </div>\n\n    \n    <div class=\"flex items-center gap-3 flex-wrap\">\n      \n      <nav class=\"flex items-center gap-1 p-1 rounded-xl bg-ground border border-line shrink-0\">\n        <button id=\"pg-mode-svgs\" onclick=\"window.switchPlaygroundMode('svgs')\" class=\"pg-mode-btn px-3 py-1.5 rounded-xl font-mono text-xs font-semibold transition-all bg-signal text-ground shadow-sm cursor-pointer flex items-center gap-1.5\" title=\"Scalable Vector Graphics\">\n          <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"/></svg>\n          <span>SVGs</span>\n        </button>\n        <button id=\"pg-mode-websites\" onclick=\"window.switchPlaygroundMode('websites')\" class=\"pg-mode-btn px-3 py-1.5 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer flex items-center gap-1.5\" title=\"Interactive Web Applications\">\n          <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"/><path d=\"M3 9h18\"/></svg>\n          <span>Websites</span>\n        </button>\n        <button id=\"pg-mode-games\" onclick=\"window.switchPlaygroundMode('games')\" class=\"pg-mode-btn px-3 py-1.5 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer flex items-center gap-1.5\" title=\"Playable 2D Canvas Games\">\n          <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"m14 10 4 2-4 2\"/><path d=\"M9 11h.01\"/></svg>\n          <span>Games</span>\n        </button>\n      </nav>\n\n      \n      <div class=\"flex items-center gap-2 shrink-0\">\n        <select id=\"pg-model-select\" onchange=\"window.onModelSelectChange()\" class=\"h-9 pl-3 pr-9 rounded-xl bg-ground border border-line font-mono text-xs text-ink outline-none focus:border-signal cursor-pointer shadow-sm appearance-none bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2212%22%20height%3D%2212%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2394a3b8%22%20stroke-width%3D%222.5%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m6%209%206%206%206-6%22%2F%3E%3C%2Fsvg%3E')] bg-[length:12px_12px] bg-[right_10px_center] bg-no-repeat\">\n          <option value=\"micro\">:micro (0.5B)</option>\n          <option value=\"mini\" selected>:mini (1.5B)</option>\n          <option value=\"small\">:small (3B)</option>\n        </select>\n        <button id=\"pg-header-generate-btn\" onclick=\"window.triggerDualSlotGeneration()\" class=\"h-9 px-3.5 rounded-xl font-mono text-xs font-bold transition-all bg-signal/50 text-ground shadow-sm cursor-not-allowed flex items-center gap-1.5 shrink-0 opacity-60\" disabled>\n          <svg class=\"w-3.5 h-3.5 animate-spin\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke-opacity=\"0.25\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke-linecap=\"round\"/></svg>\n          <span>Pending...</span>\n        </button>\n      </div>\n    </div>\n  </header>\n\n  \n  <div id=\"pg-model-loading-banner\" class=\"mb-4 px-4 py-3 rounded-2xl border border-amber-500/30 bg-amber-500/10 backdrop-blur-md flex items-center justify-between gap-3 text-xs transition-all\">\n    <div class=\"flex items-center gap-2.5\">\n      <span id=\"pg-banner-icon-warn\" class=\"w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping\"></span>\n      <span id=\"pg-banner-icon-ok\" class=\"hidden text-emerald-400 font-bold\"></span>\n      <div>\n        <span id=\"pg-banner-title\" class=\"font-bold text-ink\">Connecting Local Model Substrate:</span>\n        <span id=\"pg-banner-detail\" class=\"text-ink-2 ml-1\">Bootstrapping WebGPU tensors for <strong id=\"pg-loading-model-name\" class=\"font-mono text-ink\">:mini (1.5B)</strong>... generation is locked until ready.</span>\n      </div>\n    </div>\n    <div class=\"flex items-center gap-2 shrink-0\">\n      <span id=\"pg-bootstrap-step\" class=\"font-mono text-[11px] px-2 py-0.5 rounded-full bg-surface border border-line text-ink-2\">Allocating VFS</span>\n    </div>\n  </div>\n\n  \n  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 mb-4\">\n    \n    <div class=\"p-4 rounded-2xl border border-line bg-surface/80 backdrop-blur-md shadow-e2 flex flex-col gap-2.5\">\n      <div class=\"flex items-center justify-between gap-2 flex-wrap\">\n        <span class=\"font-mono text-[11px] font-bold text-ink tracking-wider uppercase\">Style Preset</span>\n        <div id=\"pg-style-presets-container\" class=\"flex items-center gap-1.5 flex-wrap\"></div>\n      </div>\n      <textarea id=\"pg-prompt-slot-1\" rows=\"3\" class=\"w-full p-3 rounded-xl bg-ground border border-line font-mono text-xs text-ink placeholder:text-ink-3 outline-none focus:border-signal transition-colors resize-y\" placeholder=\"Describe aesthetic style, colors, lighting, theme guidelines...\"></textarea>\n    </div>\n\n    \n    <div class=\"p-4 rounded-2xl border border-line bg-surface/80 backdrop-blur-md shadow-e2 flex flex-col gap-2.5\">\n      <div class=\"flex items-center justify-between gap-2 flex-wrap\">\n        <span class=\"font-mono text-[11px] font-bold text-ink tracking-wider uppercase\">Prompt</span>\n        <div id=\"pg-prompt-presets-container\" class=\"flex items-center gap-1.5 flex-wrap\"></div>\n      </div>\n      <textarea id=\"pg-prompt-slot-2\" rows=\"3\" class=\"w-full p-3 rounded-xl bg-ground border border-line font-mono text-xs text-ink placeholder:text-ink-3 outline-none focus:border-signal transition-colors resize-y\" placeholder=\"Describe what to generate, functional behavior, components, physics, interactive rules...\"></textarea>\n    </div>\n  </div>\n\n  \n  <div class=\"rounded-2xl border border-line bg-surface/90 backdrop-blur-xl shadow-e2 overflow-hidden mb-4\">\n    \n    <div class=\"h-11 px-4 border-b border-line bg-surface flex items-center justify-between gap-3 text-xs font-mono text-ink-2\">\n      <div class=\"flex items-center gap-2 overflow-hidden text-ellipsis whitespace-nowrap\">\n        <span class=\"w-2 h-2 rounded-full bg-signal\"></span>\n        <span id=\"pg-active-title\" class=\"font-bold text-ink text-sm\">Active Preview</span>\n        <span id=\"pg-metric-status\" class=\"px-2 py-0.5 rounded-full bg-signal/15 text-signal font-semibold text-[10px]\">Awaiting Generation</span>\n        <span id=\"pg-model-badge\" class=\"px-2 py-0.5 rounded-full bg-inset border border-line text-ink-3 text-[10px] hidden font-mono\"></span>\n        <span id=\"pg-style-badge\" class=\"px-2 py-0.5 rounded-full bg-inset border border-line text-ink-3 text-[10px] hidden font-mono\"></span>\n      </div>\n\n      \n      <div class=\"flex items-center gap-2 shrink-0\">\n        <button id=\"pg-trans-btn\" onclick=\"window.toggleTransparentBackground()\" class=\"px-2.5 py-1 rounded-lg bg-ground border border-line text-ink hover:text-signal transition-all flex items-center gap-1 cursor-pointer\" title=\"Toggle Transparent SVG Background\">\n          <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" stroke-dasharray=\"4 2\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\" fill=\"currentColor\"/></svg>\n          <span class=\"hidden sm:inline\" id=\"pg-trans-btn-text\">Transparent</span>\n        </button>\n        <button id=\"pg-code-btn\" onclick=\"window.toggleCodeEditor()\" class=\"px-2.5 py-1 rounded-lg bg-ground border border-line text-ink hover:text-signal transition-all flex items-center gap-1 cursor-pointer opacity-50 cursor-not-allowed\" disabled title=\"In-Memory VFS Code Editor\">\n          <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polyline points=\"16 18 22 12 16 6\"/><polyline points=\"8 6 2 12 8 18\"/></svg>\n          <span class=\"hidden sm:inline\" id=\"pg-code-btn-text\">Code</span>\n        </button>\n        <button id=\"pg-fs-btn\" onclick=\"window.openFullscreenSandbox()\" class=\"px-2.5 py-1 rounded-lg bg-ground border border-line text-ink hover:text-signal transition-all flex items-center gap-1 cursor-pointer opacity-50 cursor-not-allowed\" disabled title=\"Fullscreen\">\n          <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3\"/></svg>\n          <span class=\"hidden sm:inline\">Fullscreen</span>\n        </button>\n        <button id=\"pg-reload-btn\" onclick=\"window.reloadSandbox()\" class=\"px-2.5 py-1 rounded-lg bg-ground border border-line text-ink hover:text-signal transition-all flex items-center gap-1 cursor-pointer opacity-50 cursor-not-allowed\" disabled title=\"Reload Preview\">\n          <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"/><path d=\"M21 3v5h-5\"/><path d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"/><path d=\"M8 16H3v5\"/></svg>\n          <span class=\"hidden sm:inline\">Reload</span>\n        </button>\n      </div>\n    </div>\n\n    \n    <div id=\"pg-sandbox-container\" class=\"relative w-full min-h-[420px] max-h-[640px] bg-ground/90 flex items-center justify-center p-4 sm:p-6 overflow-hidden\">\n      \n      <div id=\"pg-empty-state\" class=\"flex flex-col items-center justify-center gap-3 text-center p-8 max-w-md\">\n        <div id=\"pg-empty-state-dot\" class=\"w-12 h-12 rounded-2xl bg-signal/15 border border-signal/30 flex items-center justify-center text-signal\">\n          <svg class=\"w-6 h-6 animate-pulse\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"/></svg>\n        </div>\n        <div>\n          <h3 id=\"pg-empty-state-status\" class=\"text-sm font-bold text-ink uppercase tracking-wider font-mono\">Connecting Model Harnesses...</h3>\n          <p class=\"text-xs text-ink-3 mt-1\">Select a Style Preset and Prompt, then click <strong class=\"text-ink\">Generate</strong> to synthesize interactive vectors, web apps, or games directly in browser.</p>\n        </div>\n      </div>\n\n      \n      <canvas id=\"pg-game-canvas\" width=\"640\" height=\"360\" class=\"hidden rounded-xl border border-line bg-black shadow-2xl max-w-full h-auto cursor-crosshair outline-none\" tabindex=\"0\"></canvas>\n\n      \n      <iframe id=\"pg-site-iframe\" class=\"hidden w-full h-[480px] rounded-xl border border-line bg-surface shadow-2xl transition-all\" sandbox=\"allow-scripts allow-same-origin allow-modals allow-forms\"></iframe>\n\n      \n      <div id=\"pg-svg-container\" class=\"hidden flex items-center justify-center w-full h-full min-h-[380px] p-4 transition-all\"></div>\n\n      \n      <div id=\"pg-code-editor-container\" class=\"hidden w-full h-[480px] rounded-xl border border-line bg-surface/95 backdrop-blur-xl flex flex-col shadow-2xl overflow-hidden z-20\">\n        <div class=\"h-10 px-4 border-b border-line bg-surface flex items-center justify-between gap-3 text-xs font-mono text-ink-2\">\n          <div class=\"flex items-center gap-2 overflow-hidden text-ellipsis whitespace-nowrap\">\n            <span class=\"w-2 h-2 rounded-full bg-signal animate-pulse\"></span>\n            <span id=\"pg-vfs-active-path\" class=\"font-bold text-ink\">/vfs/generated/artwork.svg</span>\n            <span id=\"pg-vfs-status-pill\" class=\"px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 font-semibold text-[10px]\">Pristine</span>\n            <span id=\"pg-vfs-cas-badge\" class=\"px-2 py-0.5 rounded-full bg-inset border border-line text-ink-3 text-[10px] font-mono\">#cas</span>\n          </div>\n          <div class=\"flex items-center gap-2 shrink-0\">\n            <button onclick=\"window.saveVfsToCache()\" class=\"px-2.5 py-1 rounded-lg bg-ground border border-line hover:border-signal text-ink hover:text-signal transition-all flex items-center gap-1 cursor-pointer text-[11px]\" title=\"Persist buffer to in-browser cache (Follow-up only)\">\n              <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z\"/><polyline points=\"17 21 17 13 7 13 7 21\"/><polyline points=\"7 3 7 8 15 8\"/></svg>\n              <span>Save Cache</span>\n            </button>\n            <button onclick=\"window.applyInMemoryEdits()\" class=\"px-3 py-1 rounded-lg bg-signal text-ground font-bold shadow-sm hover:opacity-90 transition-all flex items-center gap-1 cursor-pointer text-[11px]\">\n              <svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n              <span>Apply In-Memory Edits</span>\n            </button>\n          </div>\n        </div>\n        <textarea id=\"pg-in-memory-code-editor\" class=\"flex-1 w-full p-4 bg-ground/90 text-ink font-mono text-xs outline-none resize-none overflow-auto border-none leading-relaxed select-text\" placeholder=\"In-memory VFS buffer content...\"></textarea>\n      </div>\n    </div>\n\n    \n    <div class=\"px-4 py-2.5 border-t border-line bg-surface/70 flex items-center justify-between gap-4 flex-wrap text-[11px] font-mono text-ink-3\">\n      <div class=\"flex items-center flex-wrap gap-4\">\n        <div>Tokens: <span id=\"pg-metric-tokens\" class=\"text-ink font-semibold\">1,248</span></div>\n        <div>Latency: <span id=\"pg-metric-latency\" class=\"text-ink font-semibold\">22.4 ms</span></div>\n        <div>Engine: <span id=\"pg-metric-engine\" class=\"text-ink font-semibold\">Wasm/VFS</span></div>\n        <div>Pipeline: <span id=\"pg-metric-profile\" class=\"text-purple-400 font-semibold\">:standard-pipeline</span></div>\n        <div>Agents: <span id=\"pg-metric-agents\" class=\"text-cyan-400 font-semibold\">Planner &rarr; Critic &rarr; Synthesizer</span></div>\n        <div id=\"pg-metric-vfs\" class=\"text-ink-2 font-semibold flex items-center gap-1.5\">\n          <span id=\"pg-vfs-dot\" class=\"w-2 h-2 rounded-full bg-emerald-400\"></span>\n          <span id=\"pg-vfs-telemetry-text\">VFS: /vfs/generated/ (r1)</span>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-3\">\n        <div id=\"pg-metric-context-badge\" class=\"px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 font-semibold text-[10px]\">Context: Fresh (Turn 1)</div>\n        <div class=\"flex items-center gap-2\">\n          <span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span>\n          <span class=\"text-emerald-400 font-semibold\">Gateway: In-Memory ASL Bridge</span>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  \n  <div class=\"p-4 rounded-2xl border border-line bg-surface/80 backdrop-blur-md shadow-e2 flex items-center gap-3\">\n    <div class=\"w-8 h-8 rounded-xl bg-signal/15 border border-signal/30 flex items-center justify-center text-signal shrink-0\">\n      <svg class=\"w-4 h-4\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg>\n    </div>\n    <input id=\"pg-fix-message-input\" onkeydown=\"if(event.key==='Enter')window.applyFixMessage()\" type=\"text\" placeholder=\"Fix message: refine prompt (e.g. increase jump power, add neon gold wings, change colors, add more particles)...\" class=\"flex-1 px-3.5 py-2 rounded-xl bg-ground border border-line font-mono text-xs text-ink outline-none focus:border-signal transition-colors\"/>\n    <button onclick=\"window.applyFixMessage()\" class=\"px-4 py-2 rounded-xl bg-surface hover:bg-surface-2 border border-line text-ink font-mono text-xs font-semibold shadow-sm transition-all cursor-pointer shrink-0 flex items-center gap-1.5\">\n      <span>Apply Fix</span>\n      <span id=\"pg-iteration-badge\" class=\"px-1.5 py-0.2 rounded bg-signal/15 text-signal text-[10px]\">v1</span>\n    </button>\n  </div>\n\n  \n  <div id=\"pg-fullscreen-modal\" class=\"fixed inset-0 z-50 bg-ground/95 backdrop-blur-2xl hidden flex flex-col items-center justify-center p-4 sm:p-8\">\n    <div class=\"absolute top-4 right-4 flex items-center gap-3\">\n      <span class=\"text-xs font-mono text-ink-3\">Press [Esc] to exit</span>\n      <button onclick=\"window.closeFullscreenSandbox()\" class=\"w-10 h-10 rounded-full bg-surface border border-line text-ink hover:text-signal flex items-center justify-center text-sm font-bold shadow-md cursor-pointer\">&times;</button>\n    </div>\n    <div id=\"pg-fullscreen-container\" class=\"w-full max-w-5xl flex items-center justify-center\"></div>\n  </div>\n\n  <script>\n(function() {\n  const STYLE_PRESETS = [{\"id\": \"style-neon\", \"title\": \"Cyberpunk Neon\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\\\"/></svg>\", \"text\": \"Aesthetic style: Cyberpunk Neon. Deep dark obsidian background (#0a0a12), vibrant electric cyan (#00f0ff) and hot magenta (#ff0055) neon glow, high contrast CRT scanline accents, luminous HUD elements, and glowing edges.\"}, {\"id\": \"style-pixel\", \"title\": \"Pixel Art 16-Bit\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"4\\\" y=\\\"4\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"10\\\" y=\\\"4\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"16\\\" y=\\\"4\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"4\\\" y=\\\"10\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"16\\\" y=\\\"10\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"4\\\" y=\\\"16\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"10\\\" y=\\\"16\\\"/><rect width=\\\"4\\\" height=\\\"4\\\" x=\\\"16\\\" y=\\\"16\\\"/></svg>\", \"text\": \"Aesthetic style: Pixel Art 16-Bit. Retro arcade look, hard pixel boundaries, crisp non-anti-aliased sprite styling, vibrant palette with nostalgic contrast, gameboy and SNES era charm.\"}, {\"id\": \"style-mono\", \"title\": \"Minimal Monochrome\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\"/><path d=\\\"M12 2a10 10 0 0 1 0 20Z\\\"/></svg>\", \"text\": \"Aesthetic style: Minimal Monochrome. Swiss graphic design principles, stark black (#000) and pure white (#fff) with titanium grays, generous negative space, hairline 1px borders, bold typographic hierarchy.\"}, {\"id\": \"style-retro\", \"title\": \"Retro Vector 80s\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><polygon points=\\\"12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2\\\"/><line x1=\\\"12\\\" x2=\\\"12\\\" y1=\\\"22\\\" y2=\\\"15.5\\\"/><polyline points=\\\"22 8.5 12 15.5 2 8.5\\\"/></svg>\", \"text\": \"Aesthetic style: Retro Vector 80s. Vector wireframes, neon purple and sunset orange gradients, horizon grid perspective lines, arcade vector display aesthetics with clean geometric contours.\"}, {\"id\": \"style-glass\", \"title\": \"Glassmorphism\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"18\\\" height=\\\"18\\\" x=\\\"3\\\" y=\\\"3\\\" rx=\\\"4\\\"/><path d=\\\"M3 9h18M9 21V9\\\"/></svg>\", \"text\": \"Aesthetic style: Glassmorphism. Translucent frosted glass surfaces (backdrop-filter: blur), subtle white border highlights (rgba(255,255,255,0.15)), multi-layered soft depth shadows, luminous light refractions.\"}, {\"id\": \"style-brutal\", \"title\": \"Brutalist Dark\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"18\\\" height=\\\"18\\\" x=\\\"3\\\" y=\\\"3\\\" rx=\\\"0\\\"/><path d=\\\"M3 3l18 18M3 21L21 3\\\"/></svg>\", \"text\": \"Aesthetic style: Brutalist Dark. High-density industrial layout, bold thick borders (2px solid #222), monospace labels, stark utilitarian contrast, zero rounded corners, raw structural honesty.\"}, {\"id\": \"style-synth\", \"title\": \"Synthwave Sunset\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\"/><path d=\\\"M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41\\\"/></svg>\", \"text\": \"Aesthetic style: Synthwave Sunset. Deep indigo to neon peach gradients, horizontal sliced sun disk, retro sports car headlights, chrome reflections, vibrant 1984 arcade aesthetic.\"}, {\"id\": \"style-blueprint\", \"title\": \"Isometric Blueprint\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\\\"/><polyline points=\\\"3.27 6.96 12 12.01 20.73 6.96\\\"/><line x1=\\\"12\\\" x2=\\\"12\\\" y1=\\\"22.08\\\" y2=\\\"12\\\"/></svg>\", \"text\": \"Aesthetic style: Isometric Blueprint. Engineering schematic aesthetic, dark navy background (#0a192f), cyan technical grid lines, precise dimension callouts, architectural isometric angles.\"}];\n  const PROMPT_PRESETS = {\"websites\": [{\"id\": \"web-sneaker\", \"title\": \"CyberKicks Sneaker Store\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M3.5 17h17l-1.5-6h-6l-2-3H3.5v9z\\\"/><circle cx=\\\"7.5\\\" cy=\\\"17.5\\\" r=\\\"1.5\\\"/><circle cx=\\\"17.5\\\" cy=\\\"17.5\\\" r=\\\"1.5\\\"/></svg>\", \"prompt\": \"Create an ultra-modern CyberKicks sneaker e-commerce showcase. Features interactive 3D color switcher, size selector chips, animated cart drawer flyout, glowing neon badges, and instant checkout mock modal.\"}, {\"id\": \"web-omakase\", \"title\": \"Sushi Omakase Experience\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><ellipse cx=\\\"12\\\" cy=\\\"8\\\" rx=\\\"8\\\" ry=\\\"4\\\"/><path d=\\\"M4 8v8c0 2.2 3.6 4 8 4s8-1.8 8-4V8\\\"/></svg>\", \"prompt\": \"Build a luxury Japanese Omakase dining reservation website. Features course degustation preview, master chef bio, date & seating time selector, dietary requirement toggles, and confirmed VIP table booking receipt.\"}, {\"id\": \"web-saas\", \"title\": \"NeuralFlow AI SaaS\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83\\\"/></svg>\", \"prompt\": \"Build a high-conversion AI Developer Platform landing page. Interactive monthly/annual pricing toggle, dynamic token volume cost calculator, live mock API payload response generator, and interactive feature matrix.\"}, {\"id\": \"web-portfolio\", \"title\": \"Creative Dev Portfolio\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"20\\\" height=\\\"14\\\" x=\\\"2\\\" y=\\\"3\\\" rx=\\\"2\\\"/><polyline points=\\\"8 21 12 17 16 21\\\"/></svg>\", \"prompt\": \"Design a cutting-edge creative engineer portfolio. Includes an interactive in-browser bash terminal with commands (`cat bio`, `skills`, `projects`), filterable showcase cards, and interactive project modal.\"}, {\"id\": \"web-kanban\", \"title\": \"Agile Flow Kanban Board\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"5\\\" height=\\\"14\\\" x=\\\"3\\\" y=\\\"5\\\" rx=\\\"1\\\"/><rect width=\\\"5\\\" height=\\\"10\\\" x=\\\"10\\\" y=\\\"5\\\" rx=\\\"1\\\"/><rect width=\\\"5\\\" height=\\\"16\\\" x=\\\"17\\\" y=\\\"5\\\" rx=\\\"1\\\"/></svg>\", \"prompt\": \"Build an interactive Agile Kanban project board with Backlog, In Progress, Review, and Done columns. Click to move cards between stages, add custom task modal, priority tag filters, and task completion metrics.\"}, {\"id\": \"web-synth\", \"title\": \"Web Audio FM Synth\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M2 12h3l3-9 4 18 4-12 3 6h3\\\"/></svg>\", \"prompt\": \"Create an in-browser Web Audio FM Synthesizer with clickable chromatic piano keyboard, oscillator wave selector (Sine, Square, Sawtooth, Triangle), interactive cutoff filter knob, and animated oscilloscope.\"}, {\"id\": \"web-analytics\", \"title\": \"Quantum Metrics Dashboard\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><line x1=\\\"18\\\" x2=\\\"18\\\" y1=\\\"20\\\" y2=\\\"10\\\"/><line x1=\\\"12\\\" x2=\\\"12\\\" y1=\\\"20\\\" y2=\\\"4\\\"/><line x1=\\\"6\\\" x2=\\\"6\\\" y1=\\\"20\\\" y2=\\\"14\\\"/></svg>\", \"prompt\": \"Build an enterprise analytics command center. Features live SVG sparklines, time range selector (24h, 7d, 30d, 1y), real-time simulated throughput metrics, conversion funnels, and alert notifications feed.\"}, {\"id\": \"web-chat\", \"title\": \"Agentic AI Chat Studio\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\\\"/></svg>\", \"prompt\": \"Design a futuristic AI Agent Chat studio with multi-turn conversation threads, prompt token counter, model switch badge (Micro 0.5B, Mini 1.5B, Small 3B), code block copy buttons, and markdown rendering.\"}], \"svgs\": [{\"id\": \"svg-chameleon\", \"title\": \"ASL Chameleon Mascot\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"9\\\"/><path d=\\\"M12 7a5 5 0 0 1 5 5c0 2-1 3-3 4s-3 0-3-2a2 2 0 0 1 2-2\\\"/></svg>\", \"prompt\": \"Generate the iconic AgentScript chameleon mascot in scalable vector graphics. Feature curling spiral tail, jewel-faceted scales with gradient shading (#a855f7 to #3b82f6), expressive holographic eye, and neon outline.\"}, {\"id\": \"svg-station\", \"title\": \"Orbital Space Station\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"4\\\"/><line x1=\\\"12\\\" x2=\\\"12\\\" y1=\\\"2\\\" y2=\\\"8\\\"/><line x1=\\\"12\\\" x2=\\\"12\\\" y1=\\\"16\\\" y2=\\\"22\\\"/><line x1=\\\"2\\\" x2=\\\"8\\\" y1=\\\"12\\\" y2=\\\"12\\\"/><line x1=\\\"16\\\" x2=\\\"22\\\" y1=\\\"12\\\" y2=\\\"12\\\"/></svg>\", \"prompt\": \"Illustrate an orbital research station in deep space. Dual rotating habitat rings, blue solar photovoltaic arrays, docking module with approaching transport shuttle, starfield with glowing nebula background.\"}, {\"id\": \"svg-cat\", \"title\": \"Cyber Mecha Feline\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><polygon points=\\\"12 3 15 9 21 9 17 14 19 20 12 16 5 20 7 14 3 9 9 9 12 3\\\"/></svg>\", \"prompt\": \"Create a cybernetic mecha cat portrait with cybernetic implants. Glowing crimson optical sensor, polished titanium cheekplates, wireframe whiskers, carbon-fiber ear plating, and circuitry traces.\"}, {\"id\": \"svg-city\", \"title\": \"Isometric Megacity\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"8\\\" height=\\\"16\\\" x=\\\"4\\\" y=\\\"4\\\"/><rect width=\\\"8\\\" height=\\\"12\\\" x=\\\"12\\\" y=\\\"8\\\"/></svg>\", \"prompt\": \"Create an isometric cyberpunk metropolis with towering skyscrapers, multi-tier skyway bridges, airborne hovercars, holographic Japanese kanji advertising billboards, and dark reflective rainy streets.\"}, {\"id\": \"svg-rocket\", \"title\": \"Retro Cosmic Rocket\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z\\\"/><path d=\\\"m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-2.05 9A22 22 0 0 1 15 12z\\\"/></svg>\", \"prompt\": \"Illustrate a 1950s atomic age retro space rocket launching into the cosmos. Swept-back aerodynamic fins, chrome porthole rivets, billowy smoke cloud plumes, ringed Saturn planet, and starry constellation backdrop.\"}, {\"id\": \"svg-compass\", \"title\": \"Cyber Arcane Compass\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"10\\\"/><polygon points=\\\"16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76\\\"/></svg>\", \"prompt\": \"Render an intricate cyber-arcane navigation compass. Interlocking concentric planetary rings with gear teeth, degree markings, glowing navigational runes, needle pointer with cyan laser tip, and star chart grid.\"}, {\"id\": \"svg-eagle\", \"title\": \"Geometric Origami Falcon\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><polygon points=\\\"12 2 20 10 16 22 12 18 8 22 4 10 12 2\\\"/></svg>\", \"prompt\": \"Design a low-poly geometric falcon in mid-flight with wide wingspan. Sharp angular facets with gradient foil shading (#f59e0b gold to #8b5cf6 violet), piercing amber eye, and crystal aerofoil wingtips.\"}, {\"id\": \"svg-skull\", \"title\": \"Circuit Matrix Skull\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"9\\\" cy=\\\"10\\\" r=\\\"1.5\\\"/><circle cx=\\\"15\\\" cy=\\\"10\\\" r=\\\"1.5\\\"/><path d=\\\"M8 18h8M10 21h4M5 10a7 7 0 0 1 14 0c0 4-2 7-4 8H9c-2-1-4-4-4-8z\\\"/></svg>\", \"prompt\": \"Create a cybernetic skull constructed from glowing motherboard traces and printed circuit vias. Glowing cyan ocular micro-cameras, exposed titanium cranial plates, etched copper traces, and binary data streams.\"}], \"games\": [{\"id\": \"toy-flappy\", \"title\": \"Flappy Bird 2D\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M16 4h4v4h-4z\\\"/><circle cx=\\\"8\\\" cy=\\\"12\\\" r=\\\"5\\\"/><path d=\\\"M13 12h5l-2 3h-3z\\\"/></svg>\", \"prompt\": \"Build a playable Flappy Bird 2D arcade game in HTML5 Canvas. Player flaps on Space or Click, pipes scroll from right, score counter increments on pass, with collision detection, restart button, and smooth particle trail.\"}, {\"id\": \"toy-asteroids\", \"title\": \"Asteroids Space Shooter\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><polygon points=\\\"12 2 19 21 12 17 5 21 12 2\\\"/><circle cx=\\\"12\\\" cy=\\\"7\\\" r=\\\"1\\\"/></svg>\", \"prompt\": \"Build a vector Asteroids space shooter in HTML5 Canvas. Player controls triangular ship with inertia physics (Up/W to thrust, Left/Right or A/D to rotate), Space to fire lasers, floating asteroids split on destruction, with score and lives.\"}, {\"id\": \"toy-snake\", \"title\": \"Neon Retro Snake\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"M4 12h8a4 4 0 0 1 4 4v0a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-8a4 4 0 0 1 4-4h12\\\"/></svg>\", \"prompt\": \"Build an arcade Snake game on a 20x20 grid with smooth neon rendering. Arrow keys to steer, glowing food particles, speed increases with length, self-collision and wall wrap-around options, real-time score display.\"}, {\"id\": \"toy-life\", \"title\": \"Conway Game of Life\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"6\\\" height=\\\"6\\\" x=\\\"3\\\" y=\\\"3\\\"/><rect width=\\\"6\\\" height=\\\"6\\\" x=\\\"15\\\" y=\\\"3\\\"/><rect width=\\\"6\\\" height=\\\"6\\\" x=\\\"9\\\" y=\\\"15\\\"/></svg>\", \"prompt\": \"Design an interactive Conway Game of Life cellular automata grid. Click or drag to draw live cells, space to pause/play, step forward button, clear, and preset buttons for Gosper Glider Gun and Pulsar oscillators.\"}, {\"id\": \"toy-rogue\", \"title\": \"Dungeon Crawler Rogue\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><path d=\\\"m14.5 12.5-8 8a2.12 2.12 0 1 1-3-3l8-8\\\"/><path d=\\\"m16 8 2-2 4 4-2 2\\\"/><path d=\\\"m19 5 2 2\\\"/></svg>\", \"prompt\": \"Create a top-down Dungeon Rogue 2D adventure game in HTML5 Canvas. Move player knight with WASD, explore rooms, collect magical emeralds, avoid patrolling slimes, defeat dungeon boss to unlock exit staircase.\"}, {\"id\": \"toy-pong\", \"title\": \"Cyber Pong 2D\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><line x1=\\\"4\\\" x2=\\\"4\\\" y1=\\\"6\\\" y2=\\\"18\\\"/><line x1=\\\"20\\\" x2=\\\"20\\\" y1=\\\"6\\\" y2=\\\"18\\\"/><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"2\\\"/></svg>\", \"prompt\": \"Build a fast-paced Cyber Pong game in HTML5 Canvas. Player controls left paddle with mouse or W/S, smart AI opponent tracks ball on the right, neon trail on ball bounce, synthetic audio beeps, score to 7 wins.\"}, {\"id\": \"toy-breakout\", \"title\": \"Neon Brick Breaker\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><rect width=\\\"18\\\" height=\\\"4\\\" x=\\\"3\\\" y=\\\"4\\\"/><rect width=\\\"18\\\" height=\\\"4\\\" x=\\\"3\\\" y=\\\"10\\\"/><rect width=\\\"10\\\" height=\\\"3\\\" x=\\\"7\\\" y=\\\"18\\\"/><circle cx=\\\"12\\\" cy=\\\"15\\\" r=\\\"1.5\\\"/></svg>\", \"prompt\": \"Build a Neon Brick Breaker game in HTML5 Canvas. Move bottom paddle with mouse/arrows, bounce glowing ball into multi-tiered colored bricks with explosion particles, multi-ball bonus, and level clear tracking.\"}, {\"id\": \"toy-racer\", \"title\": \"2D Micro Drift Racer\", \"svg\": \"<svg class=\\\"w-4 h-4\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\"><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"9\\\"/><circle cx=\\\"12\\\" cy=\\\"12\\\" r=\\\"3\\\"/><path d=\\\"m14 10 4-4\\\"/></svg>\", \"prompt\": \"Build a top-down 2D Micro Drift Racer in Canvas. Control sports car with Up (accelerate), Down (brake/reverse), Left/Right (turn) with drift physics, leaving rubber skid marks on asphalt, with checkpoint lap timer.\"}]};\n\n  window.__pgCurrentMode = 'svgs';\n  window.__pgActiveStyleId = STYLE_PRESETS[0].id;\n  window.__pgActivePromptId = PROMPT_PRESETS['svgs'][0].id;\n  window.__pgSelectedModel = 'mini';\n  window.__pgActiveAnimId = null;\n  window.__pgActiveCleanup = null;\n  window.__pgIteration = 1;\n  window.__pgModelLoaded = false;\n  window.__pgHasGenerated = false;\n\n  window.renderStylePresets = function() {\n    const container = document.getElementById('pg-style-presets-container');\n    if (!container) return;\n    container.innerHTML = '';\n    STYLE_PRESETS.forEach(preset => {\n      const btn = document.createElement('button');\n      btn.className = `p-1.5 rounded-lg border transition-all cursor-pointer flex items-center justify-center ${\n        window.__pgActiveStyleId === preset.id\n          ? 'bg-signal text-ground border-signal shadow-sm'\n          : 'bg-ground text-ink-2 hover:text-ink hover:bg-inset border-line'\n      }`;\n      btn.title = preset.title;\n      btn.innerHTML = preset.svg;\n      btn.onclick = () => window.selectStylePreset(preset.id);\n      container.appendChild(btn);\n    });\n  };\n\n  window.renderPromptPresets = function() {\n    const container = document.getElementById('pg-prompt-presets-container');\n    if (!container) return;\n    container.innerHTML = '';\n    const list = PROMPT_PRESETS[window.__pgCurrentMode] || [];\n    list.forEach(preset => {\n      const btn = document.createElement('button');\n      btn.className = `p-1.5 rounded-lg border transition-all cursor-pointer flex items-center justify-center ${\n        window.__pgActivePromptId === preset.id\n          ? 'bg-signal text-ground border-signal shadow-sm'\n          : 'bg-ground text-ink-2 hover:text-ink hover:bg-inset border-line'\n      }`;\n      btn.title = preset.title;\n      btn.innerHTML = preset.svg;\n      btn.onclick = () => window.selectPromptPreset(preset.id);\n      container.appendChild(btn);\n    });\n  };\n\n  window.selectStylePreset = function(styleId) {\n    window.__pgActiveStyleId = styleId;\n    const style = STYLE_PRESETS.find(s => s.id === styleId);\n    if (style) {\n      const slot1 = document.getElementById('pg-prompt-slot-1');\n      if (slot1) slot1.value = style.text;\n    }\n    window.renderStylePresets();\n  };\n\n  window.selectPromptPreset = function(presetId) {\n    window.__pgActivePromptId = presetId;\n    const list = PROMPT_PRESETS[window.__pgCurrentMode] || [];\n    const preset = list.find(p => p.id === presetId);\n    if (preset) {\n      const slot2 = document.getElementById('pg-prompt-slot-2');\n      if (slot2) slot2.value = preset.prompt;\n    }\n    window.renderPromptPresets();\n  };\n\n  window.switchPlaygroundMode = function(mode) {\n    window.__pgCurrentMode = mode;\n    ['svgs', 'websites', 'games'].forEach(m => {\n      const btn = document.getElementById(`pg-mode-${m}`);\n      if (!btn) return;\n      if (m === mode) {\n        btn.className = 'pg-mode-btn px-3 py-1.5 rounded-xl font-mono text-xs font-semibold transition-all bg-signal text-ground shadow-sm cursor-pointer flex items-center gap-1.5';\n      } else {\n        btn.className = 'pg-mode-btn px-3 py-1.5 rounded-xl font-mono text-xs font-semibold transition-all text-ink-2 hover:text-ink hover:bg-inset cursor-pointer flex items-center gap-1.5';\n      }\n    });\n\n    const list = PROMPT_PRESETS[mode] || [];\n    if (list.length > 0) {\n      window.__pgActivePromptId = list[0].id;\n      const slot2 = document.getElementById('pg-prompt-slot-2');\n      if (slot2) slot2.value = list[0].prompt;\n    }\n\n    window.renderPromptPresets();\n  };\n\n  window.parsePromptFeatures = function(styleText, promptText, modelTier) {\n    const sText = (styleText || '').toLowerCase();\n    const pText = (promptText || '').toLowerCase();\n    const combined = sText + ' ' + pText;\n\n    let bg = '#0a0a14';\n    let primary = '#00f0ff';\n    let secondary = '#ff0055';\n    let accent = '#facc15';\n    let textCol = '#ffffff';\n    let subtext = '#94a3b8';\n    let isPixel = sText.includes('pixel') || sText.includes('16-bit') || sText.includes('snes') || sText.includes('gameboy');\n    let isWire = sText.includes('wire') || sText.includes('line') || sText.includes('retro vector') || sText.includes('80s');\n    let isMono = sText.includes('monochrome') || sText.includes('swiss') || sText.includes('black and white');\n    let isGlass = sText.includes('glass') || sText.includes('frosted') || sText.includes('translucent');\n    let isBrutal = sText.includes('brutal') || sText.includes('industrial') || sText.includes('raw structural');\n\n    const hexMatch = combined.match(/#[0-9a-fA-F]{6}|#[0-9a-fA-F]{3}/g);\n    if (hexMatch && hexMatch.length > 0) {\n      primary = hexMatch[0];\n      if (hexMatch.length > 1) secondary = hexMatch[1];\n      if (hexMatch.length > 2) accent = hexMatch[2];\n    }\n\n    if (combined.includes('emerald') || combined.includes('green') || combined.includes('lime')) primary = '#10b981';\n    if (combined.includes('gold') || combined.includes('amber') || combined.includes('yellow')) accent = '#f59e0b';\n    if (combined.includes('crimson') || combined.includes('ruby') || combined.includes('red')) secondary = '#ef4444';\n    if (combined.includes('purple') || combined.includes('violet') || combined.includes('amethyst')) secondary = '#8b5cf6';\n    if (combined.includes('cyan') || combined.includes('aqua')) primary = '#06b6d4';\n    if (combined.includes('pink') || combined.includes('magenta') || combined.includes('rose')) secondary = '#ec4899';\n    if (combined.includes('blue') && !combined.includes('cyan')) primary = '#3b82f6';\n    if (combined.includes('orange') || combined.includes('peach')) accent = '#f97316';\n    if (combined.includes('white') && isMono) { primary = '#ffffff'; secondary = '#d1d5db'; accent = '#ffffff'; bg = '#050505'; }\n    if (sText.includes('blueprint') || sText.includes('schematic')) {\n      bg = '#07152b'; primary = '#38bdf8'; secondary = '#0284c7'; accent = '#bae6fd';\n    }\n    if (sText.includes('synthwave') || sText.includes('sunset') || sText.includes('vapor')) {\n      bg = '#180726'; primary = '#f43f5e'; secondary = '#a855f7'; accent = '#fbbf24';\n    }\n\n    const tier = modelTier || 'mini';\n    const detailLevel = tier === 'small' ? 3 : tier === 'mini' ? 2 : 1;\n    const tokenBudget = tier === 'small' ? 2560 : tier === 'mini' ? 1280 : 620;\n\n    let pipelineProfile = ':standard-pipeline';\n    let agentPipeline = 'Planner &rarr; Critic &rarr; Synthesizer';\n    let stageTemps = 'T=0.7 Plan &rarr; T=0.0 Exec';\n\n    if (tier === 'micro') {\n      pipelineProfile = ':fast-pipeline';\n      agentPipeline = 'Fast Planner &rarr; Synthesizer';\n      stageTemps = 'T=0.2 Plan &rarr; T=0.0 Exec';\n    } else if (tier === 'small') {\n      pipelineProfile = ':creative-synthesis';\n      agentPipeline = 'Deep Planner &rarr; Auditor/Critic &rarr; Deep Synthesizer';\n      stageTemps = 'T=0.85 Plan &rarr; T=0.4 Reflect &rarr; T=0.0 Exec';\n    }\n\n    const baseSeed = window.__pgExecutionSeed || Date.now();\n    let hash = 0;\n    const key = combined + '::' + tier + '::' + (window.__pgIteration || 1) + '::' + baseSeed;\n    for (let i = 0; i < key.length; i++) {\n      hash = ((hash << 5) - hash) + key.charCodeAt(i);\n      hash |= 0;\n    }\n    const seed = Math.abs(hash);\n\"8 stars\", \"5 columns\", \"speed 20\")\n    const countMatch = pText.match(/\\b(\\d+)\\b/);\n    const countParam = countMatch ? parseInt(countMatch[1]) : (detailLevel * 6);\n\n    let subject = 'emblem';\n    if (pText.includes('rocket') || pText.includes('ship') || pText.includes('ufo') || pText.includes('station') || pText.includes('space')) subject = 'spacecraft';\n    else if (pText.includes('chameleon') || pText.includes('lizard') || pText.includes('reptile') || pText.includes('dragon')) subject = 'creature';\n    else if (pText.includes('cat') || pText.includes('feline') || pText.includes('tiger') || pText.includes('dog') || pText.includes('wolf')) subject = 'feline';\n    else if (pText.includes('city') || pText.includes('skyline') || pText.includes('building') || pText.includes('tower') || pText.includes('megacity')) subject = 'cityscape';\n    else if (pText.includes('skull') || pText.includes('robot') || pText.includes('cyborg') || pText.includes('face') || pText.includes('android')) subject = 'android';\n    else if (pText.includes('compass') || pText.includes('seal') || pText.includes('mandala') || pText.includes('dial') || pText.includes('matrix')) subject = 'compass';\n    else if (pText.includes('falcon') || pText.includes('bird') || pText.includes('eagle') || pText.includes('origami')) subject = 'avian';\n\n    const hasWings = pText.includes('wing') || pText.includes('fly') || pText.includes('feather');\n    const hasHorns = pText.includes('horn') || pText.includes('crest') || pText.includes('ridge');\n    const hasFlames = pText.includes('flame') || pText.includes('fire') || pText.includes('exhaust') || pText.includes('thruster');\n    const hasPlanet = pText.includes('planet') || pText.includes('saturn') || pText.includes('moon') || pText.includes('orbit');\n    const hasCircuits = pText.includes('circuit') || pText.includes('pcb') || pText.includes('chip') || pText.includes('matrix');\n    const hasGlow = sText.includes('glow') || sText.includes('neon') || pText.includes('glow') || pText.includes('luminous');\n\n    return {\n      styleText, promptText, sText, pText,\n      colors: { bg, primary, secondary, accent, text: textCol, subtext },\n      styleMeta: { isPixel, isWire, isMono, isGlass, isBrutal, hasGlow },\n      subject, countParam, hasWings, hasHorns, hasFlames, hasPlanet, hasCircuits,\n      tier, detailLevel, tokenBudget, seed,\n      pipelineProfile: pipelineProfile,\n      agentPipeline: agentPipeline,\n      stageTemps: stageTemps\n    };\n  };\n\n  window.bootstrapModelHarnesses = function(modelName) {\n    window.__pgModelLoaded = false;\n\n    const genBtn = document.getElementById('pg-header-generate-btn');\n    const banner = document.getElementById('pg-model-loading-banner');\n    const iconWarn = document.getElementById('pg-banner-icon-warn');\n    const iconOk = document.getElementById('pg-banner-icon-ok');\n    const bannerTitle = document.getElementById('pg-banner-title');\n    const bannerDetail = document.getElementById('pg-banner-detail');\n    const bannerModel = document.getElementById('pg-loading-model-name');\n    const stepBadge = document.getElementById('pg-bootstrap-step');\n    const emptyStatus = document.getElementById('pg-empty-state-status');\n    const airgapMetric = document.getElementById('pg-metric-airgap');\n\n    if (genBtn) {\n      genBtn.disabled = true;\n      genBtn.className = 'h-9 px-3.5 rounded-xl font-mono text-xs font-bold transition-all bg-signal/50 text-ground shadow-sm cursor-not-allowed flex items-center gap-1.5 shrink-0 opacity-60';\n      genBtn.innerHTML = '<svg class=\"w-3.5 h-3.5 animate-spin\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke-opacity=\"0.25\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke-linecap=\"round\"/></svg><span>Pending...</span>';\n    }\n\n    if (bannerModel) bannerModel.innerText = `:${modelName}`;\n    if (banner) {\n      banner.className = 'mb-4 px-4 py-3 rounded-2xl border border-amber-500/30 bg-amber-500/10 backdrop-blur-md flex items-center justify-between gap-3 text-xs transition-all';\n      if (iconWarn) iconWarn.classList.remove('hidden');\n      if (iconOk) iconOk.classList.add('hidden');\n      if (bannerTitle) bannerTitle.innerText = 'Connecting Local Model Substrate:';\n      if (bannerDetail) bannerDetail.innerHTML = `Bootstrapping WebGPU tensors for <strong class=\"font-mono text-ink\">:${modelName}</strong>... generation is locked until ready.`;\n    }\n\n    const steps = ['Allocating VFS', 'Compiling Wasm Shaders', 'Priming Affirmative Schema', 'Connecting Harnesses'];\n    let idx = 0;\n    const interval = setInterval(() => {\n      idx++;\n      if (idx < steps.length) {\n        if (stepBadge) stepBadge.innerText = steps[idx];\n      } else {\n        clearInterval(interval);\n        window.__pgModelLoaded = true;\n        if (banner) {\n          banner.className = 'mb-4 px-4 py-3 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 backdrop-blur-md flex items-center justify-between gap-3 text-xs transition-all';\n          if (iconWarn) iconWarn.classList.add('hidden');\n          if (iconOk) iconOk.classList.remove('hidden');\n          if (bannerTitle) bannerTitle.innerText = 'Local Model Loaded & Ready:';\n          if (bannerDetail) bannerDetail.innerHTML = `All harnesses connected for <strong class=\"font-mono text-ink\">:${modelName}</strong>. In-Browser Runtime Active.`;\n          if (stepBadge) {\n            stepBadge.innerText = 'Harnesses Connected';\n            stepBadge.className = 'font-mono text-[11px] px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-semibold border border-emerald-500/30';\n          }\n        }\n        if (genBtn) {\n          genBtn.disabled = false;\n          genBtn.className = 'h-9 px-3.5 rounded-xl font-mono text-xs font-bold transition-all bg-signal text-ground hover:opacity-90 shadow-sm cursor-pointer flex items-center gap-1.5 shrink-0';\n          genBtn.innerHTML = '<svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"/></svg><span>Generate</span>';\n        }\n        if (emptyStatus) emptyStatus.innerText = 'Awaiting Generation';\n        if (airgapMetric) airgapMetric.innerHTML = '<span class=\"w-2 h-2 rounded-full bg-emerald-400\"></span><span>Online - In-Browser Runtime</span>';\n      }\n    }, 150);\n  };\n\n  window.onModelSelectChange = function() {\n    const sel = document.getElementById('pg-model-select');\n    if (!sel) return;\n    const val = sel.value;\n    window.__pgSelectedModel = val;\n    const label = val === 'micro' ? 'micro (0.5B)' : val === 'mini' ? 'mini (1.5B)' : 'small (3B)';\n    window.bootstrapModelHarnesses(label);\n    if (window.__pgHasGenerated) {\n      setTimeout(() => window.triggerDualSlotGeneration(), 350);\n    }\n  };\n\n  window.triggerDualSlotGeneration = function() {\n    if (!window.__pgModelLoaded) return;\n\n    window.__pgVFS.clearAllCaches();\n    window.__pgHasGenerated = true;\n    window.__pgIteration = 1;\n    window.__pgCumulativeRefinements = [];\n    window.__pgIsFresh = true;\n    window.__pgExecutionSeed = (Date.now() ^ Math.floor(Math.random() * 0xffffff));\n\n    const badge = document.getElementById('pg-iteration-badge');\n    if (badge) badge.innerText = 'v1';\n\n    const contextBadge = document.getElementById('pg-metric-context-badge');\n    if (contextBadge) {\n      contextBadge.innerText = 'Context: Fresh (Turn 1)';\n      contextBadge.className = 'px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 font-semibold text-[10px]';\n    }\n\n    window.resetExecutionContext();\n\n    const genBtn = document.getElementById('pg-header-generate-btn');\n    const metricStatus = document.getElementById('pg-metric-status');\n\n    if (genBtn) {\n      genBtn.innerHTML = '<svg class=\"w-3.5 h-3.5 animate-spin\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke-opacity=\"0.25\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke-linecap=\"round\"/></svg><span>Planning (T=0.7)...</span>';\n    }\n    if (metricStatus) {\n      metricStatus.innerText = 'Planning (T=0.7)';\n      metricStatus.className = 'px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 font-semibold text-[10px]';\n    }\n\n    setTimeout(() => {\n      if (genBtn) genBtn.innerHTML = '<svg class=\"w-3.5 h-3.5 animate-spin\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke-opacity=\"0.25\"/><path d=\"M12 2a10 10 0 0 1 10 10\" stroke-linecap=\"round\"/></svg><span>Compiling (T=0.0)...</span>';\n      if (metricStatus) {\n        metricStatus.innerText = 'Compiling (T=0.0)';\n        metricStatus.className = 'px-2 py-0.5 rounded-full bg-signal/20 text-signal font-semibold text-[10px]';\n      }\n\n      setTimeout(() => {\n        if (genBtn) genBtn.innerHTML = '<svg class=\"w-3.5 h-3.5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"/></svg><span>Generate</span>';\n        window.executeLivePreview();\n      }, 200);\n    }, 300);\n  };\n\n  window.resetExecutionContext = function() {\n    if (window.__pgActiveAnimId) {\n      cancelAnimationFrame(window.__pgActiveAnimId);\n      window.__pgActiveAnimId = null;\n    }\n    if (typeof window.__pgActiveCleanup === 'function') {\n      window.__pgActiveCleanup();\n      window.__pgActiveCleanup = null;\n    }\n    window.onkeydown = null;\n    window.onkeyup = null;\n\n    const canvas = document.getElementById('pg-game-canvas');\n    if (canvas) {\n      canvas.onclick = null;\n      canvas.onmousemove = null;\n      canvas.onmousedown = null;\n      canvas.onmouseup = null;\n      const ctx = canvas.getContext('2d');\n      if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);\n    }\n\n    const iframe = document.getElementById('pg-site-iframe');\n    if (iframe) iframe.srcdoc = '';\n\n    const svgBox = document.getElementById('pg-svg-container');\n    if (svgBox) svgBox.innerHTML = '';\n  };\n\n  window.applyFixMessage = function() {\n    if (!window.__pgModelLoaded) return;\n\n    const inp = document.getElementById('pg-fix-message-input');\n    const fixText = (inp ? inp.value : '').trim();\n    if (!fixText) return;\n\n    window.__pgHasGenerated = true;\n    window.__pgIteration = (window.__pgIteration || 1) + 1;\n    window.__pgCumulativeRefinements.push(fixText);\n    window.__pgIsFresh = false;\n\n    const badge = document.getElementById('pg-iteration-badge');\n    if (badge) badge.innerText = `v${window.__pgIteration}`;\n\n    const contextBadge = document.getElementById('pg-metric-context-badge');\n    if (contextBadge) {\n      contextBadge.innerText = `Context: Preserved (Turn ${window.__pgIteration})`;\n      contextBadge.className = 'px-2 py-0.5 rounded-full bg-cyan-500/15 text-cyan-400 font-semibold text-[10px]';\n    }\n\n    if (inp) inp.value = '';\n    window.resetExecutionContext();\n    window.executeLivePreview(fixText);\n  };\n\n  window.reloadSandbox = function() {\n    if (window.__pgHasGenerated) {\n      window.resetExecutionContext();\n      window.executeLivePreview();\n    }\n  };\n
  window.__pgTransparentBg = false;
  window.__pgExecutionSeed = Date.now();
  window.__pgCumulativeRefinements = [];

  window.__pgVFS = {
    buffers: {},
    cache: {},
    activePath: null,
    editorOpen: false,

    computeCasHash: function(str) {
      let h = 0x811c9dc5;
      for (let i = 0; i < str.length; i++) {
        h ^= str.charCodeAt(i);
        h = Math.imul(h, 0x01000193);
      }
      return (h >>> 0).toString(16).padStart(8, '0');
    },

    clearAllCaches: function() {
      this.cache = {};
      try {
        const keysToRemove = [];
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && k.startsWith('asl_vfs_')) keysToRemove.push(k);
        }
        keysToRemove.forEach(k => localStorage.removeItem(k));
      } catch(e) {}
      this.buffers = {};
      this.activePath = null;
      this.updateTelemetry();
    },

    write: function(path, content, isEdit) {
      const casHash = this.computeCasHash(content);
      const existing = this.buffers[path];
      if (existing) {
        existing.content = content;
        existing.casHash = casHash;
        if (isEdit) existing.revision++;
        existing.dirty = isEdit ? true : false;
        existing.timestamp = Date.now();
      } else {
        this.buffers[path] = {
          path: path,
          content: content,
          baseContent: content,
          casHash: casHash,
          revision: 1,
          dirty: false,
          timestamp: Date.now()
        };
      }
      this.activePath = path;
      this.updateTelemetry();
      return this.buffers[path];
    },

    read: function(path) {
      const buf = this.buffers[path || this.activePath];
      return buf ? buf.content : '';
    },

    saveToCache: function() {
      if (!this.activePath) return false;
      const buf = this.buffers[this.activePath];
      if (!buf) return false;
      const key = 'asl_vfs_' + this.activePath;
      this.cache[key] = {
        buf: Object.assign({}, buf),
        savedAt: Date.now()
      };
      try {
        localStorage.setItem(key, JSON.stringify(this.cache[key]));
      } catch(e) {}
      this.updateTelemetry();
      return true;
    },

    loadFromCache: function(path) {
      const target = path || this.activePath;
      if (!target) return null;
      const key = 'asl_vfs_' + target;
      let entry = this.cache[key];
      if (!entry) {
        try {
          const raw = localStorage.getItem(key);
          if (raw) entry = JSON.parse(raw);
        } catch(e) {}
      }
      if (entry && entry.buf) {
        this.buffers[target] = Object.assign({}, entry.buf);
        this.activePath = target;
        this.updateTelemetry();
        return this.buffers[target];
      }
      return null;
    },

    updateTelemetry: function() {
      const vfsText = document.getElementById('pg-vfs-telemetry-text');
      const vfsDot = document.getElementById('pg-vfs-dot');
      const activePathLabel = document.getElementById('pg-vfs-active-path');
      const statusPill = document.getElementById('pg-vfs-status-pill');
      const casBadge = document.getElementById('pg-vfs-cas-badge');

      if (!this.activePath || !this.buffers[this.activePath]) {
        if (vfsText) vfsText.innerText = 'VFS: /vfs/generated/ (empty)';
        if (vfsDot) vfsDot.className = 'w-2 h-2 rounded-full bg-slate-500';
        return;
      }

      const buf = this.buffers[this.activePath];
      const shortHash = buf.casHash.slice(0, 6);
      const isDirty = buf.dirty;

      if (vfsText) {
        vfsText.innerText = `VFS: ${buf.path} (r${buf.revision} ${isDirty ? '*dirty ' : ''}#${shortHash})`;
      }
      if (vfsDot) {
        vfsDot.className = `w-2 h-2 rounded-full ${isDirty ? 'bg-amber-400 animate-pulse' : 'bg-emerald-400'}`;
      }
      if (activePathLabel) activePathLabel.innerText = buf.path;
      if (statusPill) {
        statusPill.className = `px-2 py-0.5 rounded-full font-semibold text-[10px] ${isDirty ? 'bg-amber-500/15 text-amber-400' : 'bg-emerald-500/15 text-emerald-400'}`;
        statusPill.innerText = isDirty ? `Dirty (r${buf.revision} Edited)` : `Pristine (r${buf.revision})`;
      }
      if (casBadge) {
        casBadge.innerText = `#${buf.casHash.slice(0, 8)}`;
      }
    }
  };

  window.toggleTransparentBackground = function() {
    window.__pgTransparentBg = !window.__pgTransparentBg;
    const btn = document.getElementById('pg-trans-btn');
    const btnText = document.getElementById('pg-trans-btn-text');
    const svgBox = document.getElementById('pg-svg-container');

    if (window.__pgTransparentBg) {
      if (btn) btn.className = 'px-2.5 py-1 rounded-lg bg-signal/20 border border-signal text-signal transition-all flex items-center gap-1 cursor-pointer font-bold';
      if (btnText) btnText.innerText = 'Transparent (On)';
      if (svgBox) {
        svgBox.style.backgroundImage = 'linear-gradient(45deg, #181824 25%, transparent 25%), linear-gradient(-45deg, #181824 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #181824 75%), linear-gradient(-45deg, transparent 75%, #181824 75%)';
        svgBox.style.backgroundSize = '20px 20px';
        svgBox.style.backgroundPosition = '0 0, 0 10px, 10px -10px, -10px 0px';
      }
    } else {
      if (btn) btn.className = 'px-2.5 py-1 rounded-lg bg-ground border border-line text-ink hover:text-signal transition-all flex items-center gap-1 cursor-pointer';
      if (btnText) btnText.innerText = 'Transparent';
      if (svgBox) {
        svgBox.style.backgroundImage = 'none';
      }
    }
    if (window.__pgHasGenerated) {
      window.executeLivePreview(null, true);
    }
  };

  window.toggleCodeEditor = function() {
    const editorContainer = document.getElementById('pg-code-editor-container');
    const svgContainer = document.getElementById('pg-svg-container');
    const iframe = document.getElementById('pg-site-iframe');
    const canvas = document.getElementById('pg-game-canvas');
    const codeBtn = document.getElementById('pg-code-btn');
    const codeBtnText = document.getElementById('pg-code-btn-text');
    const editor = document.getElementById('pg-in-memory-code-editor');

    if (!editorContainer) return;
    window.__pgVFS.editorOpen = !window.__pgVFS.editorOpen;

    if (window.__pgVFS.editorOpen) {
      editorContainer.classList.remove('hidden');
      if (codeBtn) codeBtn.className = 'px-2.5 py-1 rounded-lg bg-signal text-ground font-bold transition-all flex items-center gap-1 cursor-pointer';
      if (codeBtnText) codeBtnText.innerText = 'Close Code';
      if (editor) editor.value = window.__pgVFS.read();
      window.__pgVFS.updateTelemetry();
    } else {
      editorContainer.classList.add('hidden');
      if (codeBtn) codeBtn.className = 'px-2.5 py-1 rounded-lg bg-ground border border-line text-ink hover:text-signal transition-all flex items-center gap-1 cursor-pointer';
      if (codeBtnText) codeBtnText.innerText = 'Code';
    }
  };

  window.applyInMemoryEdits = function() {
    const editor = document.getElementById('pg-in-memory-code-editor');
    if (!editor || !window.__pgVFS.activePath) return;
    const newContent = editor.value;
    const buf = window.__pgVFS.write(window.__pgVFS.activePath, newContent, true);

    if (window.__pgCurrentMode === 'svgs') {
      const svgBox = document.getElementById('pg-svg-container');
      if (svgBox) svgBox.innerHTML = buf.content;
    } else if (window.__pgCurrentMode === 'websites') {
      const iframe = document.getElementById('pg-site-iframe');
      if (iframe) iframe.srcdoc = buf.content;
    }
    window.__pgVFS.updateTelemetry();
  };

  window.saveVfsToCache = function() {
    const ok = window.__pgVFS.saveToCache();
    const statusPill = document.getElementById('pg-vfs-status-pill');
    if (statusPill && ok) {
      statusPill.innerText = 'Cache Saved!';
      statusPill.className = 'px-2 py-0.5 rounded-full bg-signal/20 text-signal font-bold text-[10px]';
      setTimeout(() => window.__pgVFS.updateTelemetry(), 1200);
    }
  };

  window.openFullscreenSandbox = function() {\n    if (!window.__pgHasGenerated) return;\n\n    const modal = document.getElementById('pg-fullscreen-modal');\n    const container = document.getElementById('pg-fullscreen-container');\n    if (!modal || !container) return;\n\n    modal.classList.remove('hidden');\n    container.innerHTML = '';\n\n    const slot1 = document.getElementById('pg-prompt-slot-1');\n    const slot2 = document.getElementById('pg-prompt-slot-2');\n    const styleText = (slot1 ? slot1.value : '').trim();\n    const promptText = (slot2 ? slot2.value : '').trim();\n    const model = window.__pgSelectedModel || 'mini';\n    const features = window.parsePromptFeatures(styleText, promptText, model);\n\n    if (window.__pgCurrentMode === 'svgs') {\n      const svgHtml = window.compileDynamicSvg(features);\n      container.innerHTML = svgHtml;\n    } else if (window.__pgCurrentMode === 'websites') {\n      const iframe = document.createElement('iframe');\n      iframe.className = 'w-full h-[650px] rounded-2xl border border-line bg-surface shadow-2xl';\n      iframe.srcdoc = window.compileDynamicWebsite(features);\n      container.appendChild(iframe);\n    } else {\n      const canvas = document.createElement('canvas');\n      canvas.width = 720;\n      canvas.height = 420;\n      canvas.className = 'rounded-2xl border border-line bg-black shadow-2xl max-w-full h-auto cursor-crosshair outline-none';\n      container.appendChild(canvas);\n      window.compileDynamicGame(features, canvas);\n    }\n  };\n\n  window.closeFullscreenSandbox = function() {\n    const modal = document.getElementById('pg-fullscreen-modal');\n    if (modal) modal.classList.add('hidden');\n    const container = document.getElementById('pg-fullscreen-container');\n    if (container) container.innerHTML = '';\n  };\n\n  document.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') window.closeFullscreenSandbox();\n  });\n\n  window.executeLivePreview = function(refinement, preserveContent) {\n    window.__pgHasGenerated = true;\n    window.resetExecutionContext();\n\n    const emptyState = document.getElementById('pg-empty-state');\n    const canvas = document.getElementById('pg-game-canvas');\n    const iframe = document.getElementById('pg-site-iframe');\n    const svgBox = document.getElementById('pg-svg-container');\n    const activeTitle = document.getElementById('pg-active-title');\n    const metricStatus = document.getElementById('pg-metric-status');\n    const modelBadge = document.getElementById('pg-model-badge');\n    const styleBadge = document.getElementById('pg-style-badge');\n    const fsBtn = document.getElementById('pg-fs-btn');\n    const reloadBtn = document.getElementById('pg-reload-btn');\n    const codeBtn = document.getElementById('pg-code-btn');\n\n    if (emptyState) emptyState.classList.add('hidden');\n    if (metricStatus) {\n      metricStatus.innerText = 'Live';\n      metricStatus.className = 'px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 font-semibold text-[10px]';\n    }\n    if (fsBtn) { fsBtn.disabled = false; fsBtn.classList.remove('opacity-50', 'cursor-not-allowed'); }\n    if (reloadBtn) { reloadBtn.disabled = false; reloadBtn.classList.remove('opacity-50', 'cursor-not-allowed'); }\n    if (codeBtn) { codeBtn.disabled = false; codeBtn.classList.remove('opacity-50', 'cursor-not-allowed'); }\n\n    const slot1 = document.getElementById('pg-prompt-slot-1');\n    const slot2 = document.getElementById('pg-prompt-slot-2');\n    const styleText = (slot1 ? slot1.value : '').trim();\n    let promptText = (slot2 ? slot2.value : '').trim();\n    if (window.__pgCumulativeRefinements && window.__pgCumulativeRefinements.length > 0) {\n      promptText += \" [Refinements: \" + window.__pgCumulativeRefinements.join('; ') + \"]\";\n    }\n\n    const model = window.__pgSelectedModel || 'mini';\n    const features = window.parsePromptFeatures(styleText, promptText, model);\n\n    const firstPhrase = promptText.split('.')[0].slice(0, 32);\n    const title = firstPhrase ? (firstPhrase + (promptText.length > 32 ? '...' : '')) : 'Procedural Generation';\n    const styleName = styleText ? styleText.slice(0, 20) + (styleText.length > 20 ? '...' : '') : 'Default';\n\n    if (activeTitle) activeTitle.innerText = `${title} -- ${styleName}`;\n    if (modelBadge) {\n      modelBadge.classList.remove('hidden');\n      modelBadge.innerText = `:${model} (${model === 'micro' ? '0.5B' : model === 'mini' ? '1.5B' : '3B'})`;\n    }\n    if (styleBadge) {\n      styleBadge.classList.remove('hidden');\n      styleBadge.innerText = `Detail L${features.detailLevel}`;\n    }\n\n    const latencyEl = document.getElementById('pg-metric-latency');\n    const tokensEl = document.getElementById('pg-metric-tokens');\n    const profileEl = document.getElementById('pg-metric-profile');\n    const agentsEl = document.getElementById('pg-metric-agents');\n\n    if (latencyEl) {\n      const baseLat = model === 'micro' ? 12 : model === 'mini' ? 22 : 34;\n      const jitter = (features.seed % 8) * 0.4;\n      latencyEl.innerText = `${(baseLat + jitter).toFixed(1)} ms`;\n    }\n    if (tokensEl) {\n      const variance = (features.seed % 60);\n      tokensEl.innerText = (features.tokenBudget + variance).toLocaleString();\n    }\n    if (profileEl) {\n      profileEl.innerText = features.pipelineProfile;\n    }\n    if (agentsEl) {\n      agentsEl.innerText = features.agentPipeline;\n    }\n\n    if (window.__pgCurrentMode === 'games') {\n      if (canvas) canvas.classList.remove('hidden');\n      if (iframe) iframe.classList.add('hidden');\n      if (svgBox) svgBox.classList.add('hidden');\n      const gameCode = 'Game Engine: HTML5 Canvas 2D Loop\\nPrompt: ' + promptText + '\\nTier: ' + model + '\\nPipeline: ' + features.pipelineProfile + '\\nAgents: ' + features.agentPipeline + '\\nWasm Shaders Active\\n';\n      window.__pgVFS.write('/vfs/generated/game.js', gameCode, false);\n      if (canvas) window.compileDynamicGame(features, canvas);\n    } else if (window.__pgCurrentMode === 'websites') {\n      if (canvas) canvas.classList.add('hidden');\n      if (iframe) iframe.classList.remove('hidden');\n      if (svgBox) svgBox.classList.add('hidden');\n      const siteMarkup = window.compileDynamicWebsite(features);\n      window.__pgVFS.write('/vfs/generated/index.html', siteMarkup, false);\n      if (iframe) iframe.srcdoc = siteMarkup;\n    } else {\n      if (canvas) canvas.classList.add('hidden');\n      if (iframe) iframe.classList.add('hidden');\n      if (svgBox) svgBox.classList.remove('hidden');\n      const svgMarkup = window.compileDynamicSvg(features);\n      window.__pgVFS.write('/vfs/generated/artwork.svg', svgMarkup, false);\n      if (svgBox) svgBox.innerHTML = svgMarkup;\n    }\n    const editor = document.getElementById('pg-in-memory-code-editor');\n    if (editor && window.__pgVFS.editorOpen) editor.value = window.__pgVFS.read();\n  };\n\n  window.compileDynamicSvg = function(features) {\n    const { colors, styleMeta, subject, countParam, hasWings, hasHorns, hasFlames, hasPlanet, hasCircuits, detailLevel, seed, promptText, styleText } = features;\n    const W = 500, H = 400;\n\n    const defs = `\n      <defs>\n        <linearGradient id=\"gradPrim\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"${colors.primary}\"/>\n          <stop offset=\"100%\" stop-color=\"${colors.secondary}\"/>\n        </linearGradient>\n        <linearGradient id=\"gradAccent\" x1=\"0%\" y1=\"100%\" x2=\"100%\" y2=\"0%\">\n          <stop offset=\"0%\" stop-color=\"${colors.secondary}\"/>\n          <stop offset=\"100%\" stop-color=\"${colors.accent}\"/>\n        </linearGradient>\n        <filter id=\"glowFilter\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n          <feGaussianBlur stdDeviation=\"${styleMeta.hasGlow ? '4' : '1'}\" result=\"blur\"/>\n          <feComposite in=\"SourceGraphic\" in2=\"blur\" operator=\"over\"/>\n        </filter>\n      </defs>`;\n\n    const isExplicitlyTransparent = window.__pgTransparentBg || promptText.toLowerCase().includes('transparent') || promptText.toLowerCase().includes('no background') || promptText.toLowerCase().includes('clean background');\n    let bgMarkup = isExplicitlyTransparent ? '' : `<rect width=\"${W}\" height=\"${H}\" fill=\"${colors.bg}\"/>`;\n\n    let gridMarkup = '';\n    const wantsGrid = styleText.toLowerCase().includes('blueprint') || styleText.toLowerCase().includes('schematic') || promptText.toLowerCase().includes('grid');\n    if (wantsGrid && !isExplicitlyTransparent) {\n      gridMarkup = `<g stroke=\"${colors.primary}22\" stroke-width=\"1\">`;\n      for (let x = 20; x < W; x += 30) gridMarkup += `<line x1=\"${x}\" y1=\"0\" x2=\"${x}\" y2=\"${H}\"/>`;\n      for (let y = 20; y < H; y += 30) gridMarkup += `<line x1=\"0\" y1=\"${y}\" x2=\"${W}\" y2=\"${y}\"/>`;\n      gridMarkup += `</g>`;\n    }\n\n    let particlesMarkup = '';\n    const wantsStars = promptText.toLowerCase().match(/\\b(star|stars|space|nebula|constellation|particle|particles|cosmic)\\b/);\n    if (wantsStars && !isExplicitlyTransparent) {\n      const numStars = Math.min(countParam, 30);\n      for (let i = 0; i < numStars; i++) {\n        const sx = ((seed * (i + 1) * 37) % (W - 40)) + 20;\n        const sy = ((seed * (i + 1) * 71) % (H - 80)) + 20;\n        const sr = (i % 3 === 0) ? 2.5 : 1.5;\n        const sc = (i % 2 === 0) ? colors.accent : colors.primary;\n        particlesMarkup += `<circle cx=\"${sx}\" cy=\"${sy}\" r=\"${sr}\" fill=\"${sc}\" opacity=\"${0.4 + (i % 5) * 0.12}\"/>`;\n      }\n    }\n\n    let planetMarkup = '';\n    if (hasPlanet || subject === 'spacecraft') {\n      planetMarkup = `\n        <g opacity=\"0.85\">\n          <circle cx=\"410\" cy=\"80\" r=\"38\" fill=\"url(#gradAccent)\"/>\n          <ellipse cx=\"410\" cy=\"80\" rx=\"55\" ry=\"12\" fill=\"none\" stroke=\"${colors.accent}\" stroke-width=\"2.5\" transform=\"rotate(-25 410 80)\"/>\n        </g>`;\n    }\n\n    let subjectMarkup = '';\n    const cx = W / 2, cy = H / 2;\n\n    if (subject === 'spacecraft') {\n      subjectMarkup = `\n        <g filter=\"url(#glowFilter)\">\n          \n          ${hasFlames ? `\n            <polygon points=\"${cx - 14},${cy + 75} ${cx + 14},${cy + 75} ${cx},${cy + 120 + (seed % 20)}\" fill=\"${colors.accent}\" opacity=\"0.9\"/>\n            <polygon points=\"${cx - 8},${cy + 75} ${cx + 8},${cy + 75} ${cx},${cy + 105}\" fill=\"#ffffff\"/>\n          ` : ''}\n          \n          <polygon points=\"${cx - 60},${cy + 65} ${cx - 15},${cy + 20} ${cx - 15},${cy + 75}\" fill=\"${colors.secondary}\"/>\n          <polygon points=\"${cx + 60},${cy + 65} ${cx + 15},${cy + 20} ${cx + 15},${cy + 75}\" fill=\"${colors.secondary}\"/>\n          \n          <path d=\"M ${cx},${cy - 85} C ${cx + 35},${cy - 20} ${cx + 30},${cy + 75} ${cx},${cy + 75} C ${cx - 30},${cy + 75} ${cx - 35},${cy - 20} ${cx},${cy - 85} Z\" fill=\"url(#gradPrim)\" stroke=\"${colors.primary}\" stroke-width=\"2\"/>\n          \n          <circle cx=\"${cx}\" cy=\"${cy - 20}\" r=\"18\" fill=\"${colors.bg}\" stroke=\"${colors.accent}\" stroke-width=\"3\"/>\n          <circle cx=\"${cx + 4}\" cy=\"${cy - 24}\" r=\"5\" fill=\"#ffffff\" opacity=\"0.8\"/>\n        </g>`;\n    } else if (subject === 'creature') {\n      let auraRing = '';\n      let dorsalPlates = '';\n      let eyeMarkup = '';\n      let wingsMarkup = '';\n      let bodyStrokeWidth = styleMeta.isWire ? '5' : (detailLevel >= 3 ? '22' : '16');\n\n      if (detailLevel === 1) {\n        eyeMarkup = `\n          <circle cx=\"${cx - 100}\" cy=\"${cy - 60}\" r=\"12\" fill=\"none\" stroke=\"${colors.primary}\" stroke-width=\"2.5\"/>\n          <circle cx=\"${cx - 98}\" cy=\"${cy - 61}\" r=\"4\" fill=\"${colors.accent}\"/>`;\n      } else if (detailLevel === 2) {\n        dorsalPlates = `\n          <circle cx=\"${cx - 40}\" cy=\"${cy - 140}\" r=\"6\" fill=\"${colors.accent}\"/>\n          <circle cx=\"${cx - 10}\" cy=\"${cy - 145}\" r=\"6\" fill=\"${colors.accent}\"/>\n          <circle cx=\"${cx + 20}\" cy=\"${cy - 145}\" r=\"6\" fill=\"${colors.accent}\"/>`;\n        eyeMarkup = `\n          <circle cx=\"${cx - 100}\" cy=\"${cy - 60}\" r=\"18\" fill=\"${colors.bg}\" stroke=\"${colors.primary}\" stroke-width=\"4\"/>\n          <circle cx=\"${cx - 96}\" cy=\"${cy - 62}\" r=\"7\" fill=\"${colors.accent}\"/>\n          <circle cx=\"${cx - 93}\" cy=\"${cy - 65}\" r=\"2.5\" fill=\"#ffffff\"/>`;\n        if (hasWings) {\n          wingsMarkup = `\n            <path d=\"M ${cx - 20},${cy - 10} C ${cx - 70},${cy - 90} ${cx - 20},${cy - 110} ${cx + 40},${cy - 60}\" fill=\"none\" stroke=\"${colors.accent}\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n            <path d=\"M ${cx - 10},${cy - 5} C ${cx - 50},${cy - 70} ${cx - 10},${cy - 90} ${cx + 30},${cy - 50}\" fill=\"none\" stroke=\"${colors.primary}\" stroke-width=\"3\" stroke-linecap=\"round\"/>`;\n        }\n      } else {\n        auraRing = `\n          <g opacity=\"0.6\">\n            <circle cx=\"${cx}\" cy=\"${cy - 30}\" r=\"135\" fill=\"none\" stroke=\"url(#gradPrim)\" stroke-width=\"1.5\" stroke-dasharray=\"8 6\"/>\n            <circle cx=\"${cx}\" cy=\"${cy - 30}\" r=\"145\" fill=\"none\" stroke=\"${colors.accent}\" stroke-width=\"1\" stroke-dasharray=\"2 8\" opacity=\"0.7\"/>\n            <polygon points=\"${cx},${cy - 175} ${cx + 8},${cy - 165} ${cx - 8},${cy - 165}\" fill=\"${colors.accent}\"/>\n            <polygon points=\"${cx + 145},${cy - 30} ${cx + 135},${cy - 22} ${cx + 135},${cy - 38}\" fill=\"${colors.accent}\"/>\n          </g>`;\n        dorsalPlates = `\n          \n          <polygon points=\"${cx - 70},${cy - 125} ${cx - 62},${cy - 155} ${cx - 54},${cy - 125}\" fill=\"url(#gradAccent)\" stroke=\"#ffffff\" stroke-width=\"1\"/>\n          <polygon points=\"${cx - 48},${cy - 138} ${cx - 38},${cy - 170} ${cx - 28},${cy - 138}\" fill=\"url(#gradAccent)\" stroke=\"#ffffff\" stroke-width=\"1\"/>\n          <polygon points=\"${cx - 20},${cy - 146} ${cx - 10},${cy - 180} ${cx},${cy - 146}\" fill=\"url(#gradAccent)\" stroke=\"#ffffff\" stroke-width=\"1.5\"/>\n          <polygon points=\"${cx + 10},${cy - 146} ${cx + 20},${cy - 180} ${cx + 30},${cy - 146}\" fill=\"url(#gradAccent)\" stroke=\"#ffffff\" stroke-width=\"1.5\"/>\n          <polygon points=\"${cx + 40},${cy - 138} ${cx + 50},${cy - 168} ${cx + 60},${cy - 138}\" fill=\"url(#gradAccent)\" stroke=\"#ffffff\" stroke-width=\"1\"/>\n          <polygon points=\"${cx + 70},${cy - 125} ${cx + 78},${cy - 152} ${cx + 86},${cy - 125}\" fill=\"url(#gradAccent)\" stroke=\"#ffffff\" stroke-width=\"1\"/>\n          <polygon points=\"${cx + 96},${cy - 105} ${cx + 103},${cy - 128} ${cx + 110},${cy - 105}\" fill=\"url(#gradAccent)\" stroke=\"#ffffff\" stroke-width=\"0.8\"/>`;\n        eyeMarkup = `\n          \n          <circle cx=\"${cx - 100}\" cy=\"${cy - 60}\" r=\"22\" fill=\"${colors.bg}\" stroke=\"url(#gradPrim)\" stroke-width=\"4.5\"/>\n          <circle cx=\"${cx - 100}\" cy=\"${cy - 60}\" r=\"16\" fill=\"none\" stroke=\"${colors.secondary}\" stroke-width=\"1.5\" stroke-dasharray=\"4 2\"/>\n          <circle cx=\"${cx - 96}\" cy=\"${cy - 62}\" r=\"9\" fill=\"url(#gradAccent)\"/>\n          <circle cx=\"${cx - 94}\" cy=\"${cy - 63}\" r=\"3.5\" fill=\"#ffffff\"/>\n          <circle cx=\"${cx - 99}\" cy=\"${cy - 59}\" r=\"2\" fill=\"#ffffff\" opacity=\"0.8\"/>`;\n        wingsMarkup = `\n          \n          <g opacity=\"0.95\">\n            <path d=\"M ${cx - 25},${cy - 10} C ${cx - 85},${cy - 110} ${cx - 30},${cy - 135} ${cx + 50},${cy - 70}\" fill=\"url(#gradAccent)\" stroke=\"#ffffff\" stroke-width=\"2.5\"/>\n            <path d=\"M ${cx - 15},${cy - 5} C ${cx - 65},${cy - 90} ${cx - 15},${cy - 110} ${cx + 40},${cy - 60}\" stroke=\"${colors.primary}\" stroke-width=\"2\" fill=\"none\"/>\n            <path d=\"M ${cx + 25},${cy - 10} C ${cx + 85},${cy - 110} ${cx + 120},${cy - 125} ${cx + 70},${cy - 60}\" fill=\"url(#gradAccent)\" stroke=\"#ffffff\" stroke-width=\"2.5\" opacity=\"0.85\"/>\n            <path d=\"M ${cx + 35},${cy - 5} C ${cx + 95},${cy - 90} ${cx + 130},${cy - 105} ${cx + 80},${cy - 50}\" stroke=\"${colors.primary}\" stroke-width=\"2\" fill=\"none\"/>\n          </g>`;\n      }\n\n      subjectMarkup = `\n        <g filter=\"url(#glowFilter)\">\n          ${auraRing}\n          \n          <path d=\"M 60,${cy + 70} Q ${cx},${cy + 85} 440,${cy + 60}\" stroke=\"${colors.secondary}\" stroke-width=\"${detailLevel >= 3 ? '10' : '8'}\" stroke-linecap=\"round\" fill=\"none\"/>\n          ${wingsMarkup}\n          \n          <path d=\"M ${cx + 80},${cy + 65} C ${cx + 140},${cy + 35} ${cx + 150},${cy - 50} ${cx + 100},${cy - 95} C ${cx + 60},${cy - 140} ${cx - 30},${cy - 150} ${cx - 80},${cy - 120} C ${cx - 130},${cy - 90} ${cx - 155},${cy - 35} ${cx - 145},${cy + 20} C ${cx - 135},${cy + 65} ${cx - 95},${cy + 85} ${cx - 55},${cy + 85} C ${cx - 10},${cy + 85} ${cx + 20},${cy + 55} ${cx + 20},${cy + 20} C ${cx + 20},${cy - 15} ${cx - 5},${cy - 40} ${cx - 35},${cy - 30} C ${cx - 55},${cy - 25} ${cx - 65},${cy - 5} ${cx - 55},${cy + 10}\" fill=\"none\" stroke=\"url(#gradPrim)\" stroke-width=\"${bodyStrokeWidth}\" stroke-linecap=\"round\"/>\n          ${dorsalPlates}\n          ${eyeMarkup}\n        </g>`;\n    } else if (subject === 'feline') {\n      subjectMarkup = `\n        <g filter=\"url(#glowFilter)\">\n          \n          <polygon points=\"${cx - 70},${cy - 70} ${cx - 95},${cy - 145} ${cx - 35},${cy - 95}\" fill=\"${colors.secondary}\"/>\n          <polygon points=\"${cx + 70},${cy - 70} ${cx + 95},${cy - 145} ${cx + 35},${cy - 95}\" fill=\"${colors.secondary}\"/>\n          \n          <circle cx=\"${cx}\" cy=\"${cy - 30}\" r=\"75\" fill=\"url(#gradPrim)\" stroke=\"${colors.primary}\" stroke-width=\"2\"/>\n          \n          <rect x=\"${cx - 55}\" y=\"${cy - 48}\" width=\"110\" height=\"28\" rx=\"14\" fill=\"${colors.bg}\" stroke=\"${colors.accent}\" stroke-width=\"3\"/>\n          <circle cx=\"${cx - 25}\" cy=\"${cy - 34}\" r=\"7\" fill=\"${colors.accent}\"/>\n          <circle cx=\"${cx + 25}\" cy=\"${cy - 34}\" r=\"7\" fill=\"${colors.accent}\"/>\n          \n          <line x1=\"${cx - 65}\" y1=\"${cy - 10}\" x2=\"${cx - 110}\" y2=\"${cy - 20}\" stroke=\"${colors.primary}\" stroke-width=\"2\"/>\n          <line x1=\"${cx - 65}\" y1=\"${cy + 5}\" x2=\"${cx - 115}\" y2=\"${cy + 10}\" stroke=\"${colors.primary}\" stroke-width=\"2\"/>\n          <line x1=\"${cx + 65}\" y1=\"${cy - 10}\" x2=\"${cx + 110}\" y2=\"${cy - 20}\" stroke=\"${colors.primary}\" stroke-width=\"2\"/>\n          <line x1=\"${cx + 65}\" y1=\"${cy + 5}\" x2=\"${cx + 115}\" y2=\"${cy + 10}\" stroke=\"${colors.primary}\" stroke-width=\"2\"/>\n        </g>`;\n    } else if (subject === 'cityscape') {\n      subjectMarkup = `\n        <g filter=\"url(#glowFilter)\">\n          \n          <rect x=\"${cx - 120}\" y=\"${cy - 30}\" width=\"55\" height=\"150}\" fill=\"${colors.secondary}\" opacity=\"0.8\"/>\n          <rect x=\"${cx - 50}\" y=\"${cy - 110}\" width=\"80\" height=\"230}\" fill=\"url(#gradPrim)\" stroke=\"${colors.primary}\" stroke-width=\"2\"/>\n          <rect x=\"${cx + 45}\" y=\"${cy - 60}\" width=\"65\" height=\"180}\" fill=\"${colors.secondary}\" opacity=\"0.8\"/>\n          \n          <line x1=\"${cx - 10}\" y1=\"${cy - 110}\" x2=\"${cx - 10}\" y2=\"${cy - 160}\" stroke=\"${colors.accent}\" stroke-width=\"3\"/>\n          <circle cx=\"${cx - 10}\" cy=\"${cy - 160}\" r=\"5\" fill=\"${colors.accent}\"/>\n          \n          <g fill=\"${colors.accent}\" opacity=\"0.85\">\n            <rect x=\"${cx - 35}\" y=\"${cy - 85}\" width=\"10\" height=\"12\"/>\n            <rect x=\"${cx - 15}\" y=\"${cy - 85}\" width=\"10\" height=\"12\"/>\n            <rect x=\"${cx + 5}\" y=\"${cy - 85}\" width=\"10\" height=\"12\"/>\n            <rect x=\"${cx - 35}\" y=\"${cy - 55}\" width=\"10\" height=\"12\"/>\n            <rect x=\"${cx + 5}\" y=\"${cy - 55}\" width=\"10\" height=\"12\"/>\n            <rect x=\"${cx - 35}\" y=\"${cy - 25}\" width=\"10\" height=\"12\"/>\n            <rect x=\"${cx - 15}\" y=\"${cy - 25}\" width=\"10\" height=\"12\"/>\n            <rect x=\"${cx + 5}\" y=\"${cy - 25}\" width=\"10\" height=\"12\"/>\n          </g>\n        </g>`;\n    } else if (subject === 'android') {\n      subjectMarkup = `\n        <g filter=\"url(#glowFilter)\">\n          \n          <path d=\"M ${cx - 65},${cy - 20} C ${cx - 65},${cy - 100} ${cx + 65},${cy - 100} ${cx + 65},${cy - 20} C ${cx + 65},${cy + 30} ${cx + 40},${cy + 75} ${cx},${cy + 75} C ${cx - 40},${cy + 75} ${cx - 65},${cy + 30} Z\" fill=\"url(#gradPrim)\" stroke=\"${colors.primary}\" stroke-width=\"2\"/>\n          \n          <circle cx=\"${cx - 28}\" cy=\"${cy - 20}\" r=\"18\" fill=\"${colors.bg}\" stroke=\"${colors.accent}\" stroke-width=\"3\"/>\n          <circle cx=\"${cx + 28}\" cy=\"${cy - 20}\" r=\"18\" fill=\"${colors.bg}\" stroke=\"${colors.accent}\" stroke-width=\"3\"/>\n          <circle cx=\"${cx - 28}\" cy=\"${cy - 20}\" r=\"7\" fill=\"${colors.secondary}\"/>\n          <circle cx=\"${cx + 28}\" cy=\"${cy - 20}\" r=\"7\" fill=\"${colors.secondary}\"/>\n          \n          <path d=\"M ${cx - 50},${cy - 60} L ${cx - 30},${cy - 60} L ${cx - 15},${cy - 75}\" fill=\"none\" stroke=\"${colors.accent}\" stroke-width=\"2\"/>\n          <path d=\"M ${cx + 50},${cy - 60} L ${cx + 30},${cy - 60} L ${cx + 15},${cy - 75}\" fill=\"none\" stroke=\"${colors.accent}\" stroke-width=\"2\"/>\n          \n          <rect x=\"${cx - 25}\" y=\"${cy + 45}\" width=\"10\" height=\"18\" fill=\"${colors.bg}\" stroke=\"${colors.primary}\" stroke-width=\"1.5\"/>\n          <rect x=\"${cx - 5}\" y=\"${cy + 45}\" width=\"10\" height=\"18\" fill=\"${colors.bg}\" stroke=\"${colors.primary}\" stroke-width=\"1.5\"/>\n          <rect x=\"${cx + 15}\" y=\"${cy + 45}\" width=\"10\" height=\"18\" fill=\"${colors.bg}\" stroke=\"${colors.primary}\" stroke-width=\"1.5\"/>\n        </g>`;\n    } else {\n      subjectMarkup = `\n        <g filter=\"url(#glowFilter)\">\n          \n          <polygon points=\"${cx},${cy - 95} ${cx + 80},${cy - 45} ${cx + 80},${cy + 55} ${cx},${cy + 105} ${cx - 80},${cy + 55} ${cx - 80},${cy - 45}\" fill=\"${colors.primary}15\" stroke=\"url(#gradPrim)\" stroke-width=\"3.5\"/>\n          \n          <circle cx=\"${cx}\" cy=\"${cy + 5}\" r=\"55\" fill=\"${colors.bg}\" stroke=\"${colors.accent}\" stroke-width=\"2\" stroke-dasharray=\"8 4\"/>\n          \n          <circle cx=\"${cx}\" cy=\"${cy + 5}\" r=\"26\" fill=\"url(#gradAccent)\"/>\n          <circle cx=\"${cx}\" cy=\"${cy + 5}\" r=\"8\" fill=\"#ffffff\"/>\n          \n          <line x1=\"${cx - 75}\" y1=\"${cy + 5}\" x2=\"${cx + 75}\" y2=\"${cy + 5}\" stroke=\"${colors.primary}\" stroke-width=\"1.5\"/>\n          <line x1=\"${cx}\" y1=\"${cy - 70}\" x2=\"${cx}\" y2=\"${cy + 80}\" stroke=\"${colors.primary}\" stroke-width=\"1.5\"/>\n        </g>`;\n    }\n\n    const labelText = promptText.slice(0, 36).toUpperCase();\n    const bottomLabel = `\n      <g>\n        <rect x=\"50\" y=\"${H - 45}\" width=\"${W - 100}\" height=\"28\" rx=\"8\" fill=\"${colors.bg}\" stroke=\"${colors.primary}44\" stroke-width=\"1\"/>\n        <text x=\"${cx}\" y=\"${H - 27}\" text-anchor=\"middle\" fill=\"${colors.text}\" font-family=\"monospace\" font-size=\"11\" font-weight=\"bold\" letter-spacing=\"1.5\">\n          ${labelText} - :${features.tier.toUpperCase()}\n        </text>\n      </g>`;\n\n    return `<svg viewBox=\"0 0 ${W} ${H}\" class=\"w-full max-w-lg h-auto max-h-[380px] drop-shadow-xl select-none\" xmlns=\"http://www.w3.org/2000/svg\">\n      ${defs}\n      ${bgMarkup}\n      ${gridMarkup}\n      ${particlesMarkup}\n      ${planetMarkup}\n      ${subjectMarkup}\n      ${bottomLabel}\n    </svg>`;\n  };\n\n  window.compileDynamicWebsite = function(features) {\n    const { colors, styleMeta, pText, sText, promptText, styleText, tier, seed } = features;\n\n    let componentBody = '';\n\n    if (pText.includes('store') || pText.includes('shop') || pText.includes('sneaker') || pText.includes('product') || pText.includes('cart')) {\n      componentBody = `\n        <div class=\"card\" style=\"margin-top:16px;\">\n          <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;\">\n            <h3 style=\"margin:0; font-size:16px; color:${colors.primary};\">FEATURED COLLECTION</h3>\n            <span id=\"cart-badge\" style=\"background:${colors.accent}; color:#000; padding:2px 8px; border-radius:12px; font-weight:bold; font-size:11px;\">Cart (0)</span>\n          </div>\n          <div style=\"display:grid; grid-template-columns:repeat(auto-fit, minmax(130px, 1fr)); gap:12px;\">\n            <div style=\"background:rgba(0,0,0,0.3); padding:10px; border-radius:12px; border:1px solid rgba(255,255,255,0.08); text-align:center;\">\n              <div style=\"font-size:24px;\"></div>\n              <div style=\"font-weight:bold; font-size:13px; margin-top:4px;\">CyberKicks V1</div>\n              <div style=\"color:${colors.accent}; font-weight:bold; margin:4px 0;\">$189</div>\n              <button onclick=\"addCart('CyberKicks V1')\" style=\"background:${colors.primary}; color:#000; border:none; padding:5px 12px; border-radius:8px; font-weight:bold; cursor:pointer; font-size:11px; width:100%;\">Add</button>\n            </div>\n            <div style=\"background:rgba(0,0,0,0.3); padding:10px; border-radius:12px; border:1px solid rgba(255,255,255,0.08); text-align:center;\">\n              <div style=\"font-size:24px;\">[pulse]</div>\n              <div style=\"font-weight:bold; font-size:13px; margin-top:4px;\">Runner High-Top</div>\n              <div style=\"color:${colors.accent}; font-weight:bold; margin:4px 0;\">$219</div>\n              <button onclick=\"addCart('Runner High-Top')\" style=\"background:${colors.primary}; color:#000; border:none; padding:5px 12px; border-radius:8px; font-weight:bold; cursor:pointer; font-size:11px; width:100%;\">Add</button>\n            </div>\n          </div>\n        </div>\n        <script>\n          let cartCount = 0;\n          function addCart(name) {\n            cartCount++;\n            document.getElementById('cart-badge').innerText = 'Cart (' + cartCount + ')';\n            alert('Added ' + name + ' to cart! Total items: ' + cartCount);\n          }\n        <\\/script>`;\n    } else if (pText.includes('synth') || pText.includes('audio') || pText.includes('piano') || pText.includes('music')) {\n      componentBody = `\n        <div class=\"card\" style=\"margin-top:16px;\">\n          <h3 style=\"margin:0 0 12px 0; font-size:16px; color:${colors.primary};\">WEB AUDIO FM SYNTHESIZER</h3>\n          <div style=\"display:flex; gap:8px; justify-content:center; margin-bottom:12px;\">\n            <button onclick=\"playNote(261.63)\" style=\"padding:16px 12px; background:#fff; color:#000; font-weight:bold; border-radius:6px; cursor:pointer; border:none;\">C4</button>\n            <button onclick=\"playNote(293.66)\" style=\"padding:16px 12px; background:#fff; color:#000; font-weight:bold; border-radius:6px; cursor:pointer; border:none;\">D4</button>\n            <button onclick=\"playNote(329.63)\" style=\"padding:16px 12px; background:#fff; color:#000; font-weight:bold; border-radius:6px; cursor:pointer; border:none;\">E4</button>\n            <button onclick=\"playNote(349.23)\" style=\"padding:16px 12px; background:#fff; color:#000; font-weight:bold; border-radius:6px; cursor:pointer; border:none;\">F4</button>\n            <button onclick=\"playNote(392.00)\" style=\"padding:16px 12px; background:#fff; color:#000; font-weight:bold; border-radius:6px; cursor:pointer; border:none;\">G4</button>\n            <button onclick=\"playNote(440.00)\" style=\"padding:16px 12px; background:#fff; color:#000; font-weight:bold; border-radius:6px; cursor:pointer; border:none;\">A4</button>\n            <button onclick=\"playNote(493.88)\" style=\"padding:16px 12px; background:#fff; color:#000; font-weight:bold; border-radius:6px; cursor:pointer; border:none;\">B4</button>\n          </div>\n          <div style=\"font-size:11px; color:${colors.subtext}; text-align:center;\">Click keys to synthesize pure audio tones via browser AudioContext.</div>\n        </div>\n        <script>\n          let audioCtx = null;\n          function playNote(freq) {\n            try {\n              if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n              const osc = audioCtx.createOscillator();\n              const gain = audioCtx.createGain();\n              osc.type = 'sawtooth';\n              osc.frequency.setValueAtTime(freq, audioCtx.currentTime);\n              gain.gain.setValueAtTime(0.15, audioCtx.currentTime);\n              gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.4);\n              osc.connect(gain);\n              gain.connect(audioCtx.destination);\n              osc.start();\n              osc.stop(audioCtx.currentTime + 0.4);\n            } catch(e) {}\n          }\n        <\\/script>`;\n    } else if (pText.includes('terminal') || pText.includes('portfolio') || pText.includes('cli') || pText.includes('resume')) {\n      componentBody = `\n        <div class=\"card\" style=\"margin-top:16px; background:#000; border-color:${colors.primary}55;\">\n          <div style=\"font-size:11px; color:${colors.primary}; margin-bottom:8px;\">agent@aslang:~$ help</div>\n          <div id=\"term-out\" style=\"font-size:12px; color:#a7f3d0; line-height:1.6; font-family:monospace;\">\n            <div>Available commands: [skills] [projects] [contact] [clear]</div>\n          </div>\n          <div style=\"display:flex; gap:6px; margin-top:8px;\">\n            <span style=\"color:${colors.accent}; font-weight:bold;\">&gt;</span>\n            <input id=\"term-inp\" onkeydown=\"if(event.key==='Enter')runCmd()\" placeholder=\"type skills or projects...\" style=\"flex:1; background:transparent; border:none; color:#fff; font-family:monospace; outline:none; font-size:12px;\"/>\n          </div>\n        </div>\n        <script>\n          function runCmd() {\n            const inp = document.getElementById('term-inp');\n            const out = document.getElementById('term-out');\n            const val = (inp.value || '').trim().toLowerCase();\n            inp.value = '';\n            if (val === 'clear') { out.innerHTML = ''; return; }\n            if (val === 'skills') out.innerHTML += '<div>- AgentScript AST - Wasm WebGPU - High-Density ASN Protocol</div>';\n            else if (val === 'projects') out.innerHTML += '<div>- Creative Playground Studio - In-Browser Telemetry Suite</div>';\n            else if (val === 'contact') out.innerHTML += '<div>- agent@aslang.dev - https://github.com/aslang</div>';\n            else out.innerHTML += '<div>Command not found: ' + val + '. Try skills or projects.</div>';\n          }\n        <\\/script>`;\n    } else {\n      componentBody = `\n        <div class=\"card\" style=\"margin-top:16px;\">\n          <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;\">\n            <h3 style=\"margin:0; font-size:15px; color:${colors.primary};\">REACTIVE WORKSPACE COMPONENT</h3>\n            <span style=\"background:${colors.primary}22; color:${colors.primary}; padding:2px 8px; border-radius:8px; font-size:11px; font-weight:bold;\">Tier :${tier}</span>\n          </div>\n          <p style=\"font-size:12px; color:${colors.text}; line-height:1.5; margin:0 0 12px 0;\">${promptText}</p>\n          <div style=\"display:flex; gap:8px; flex-wrap:wrap;\">\n            <button onclick=\"counterStep(1)\" style=\"background:${colors.primary}; color:#000; border:none; padding:8px 16px; border-radius:8px; font-weight:bold; cursor:pointer; font-size:12px;\">Action Increment (+1)</button>\n            <button onclick=\"counterStep(-1)\" style=\"background:rgba(255,255,255,0.1); color:#fff; border:1px solid rgba(255,255,255,0.2); padding:8px 16px; border-radius:8px; font-weight:bold; cursor:pointer; font-size:12px;\">Reset</button>\n            <span id=\"counter-val\" style=\"display:flex; align-items:center; font-weight:bold; font-size:14px; margin-left:8px; color:${colors.accent};\">State: 0</span>\n          </div>\n        </div>\n        <script>\n          let count = 0;\n          function counterStep(delta) {\n            if (delta === -1) count = 0; else count += delta;\n            document.getElementById('counter-val').innerText = 'State: ' + count;\n          }\n        <\\/script>`;\n    }\n\n    const firstWord = promptText.split(' ')[0] || 'App';\n    const siteTitle = promptText.slice(0, 24).toUpperCase();\n\n    return `<!DOCTYPE html><html><head><meta charset=\"utf-8\"/>\n      <style>\n        body { margin:0; padding:20px; background:${colors.bg}; color:${colors.text}; font-family:monospace; box-sizing:border-box; display:flex; justify-content:center; }\n        .app { width:100%; max-width:580px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.1); border-radius:16px; padding:20px; box-shadow:0 10px 30px rgba(0,0,0,0.5); }\n        .nav { display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(255,255,255,0.1); padding-bottom:12px; }\n        .logo { font-weight:bold; font-size:15px; color:${colors.primary}; display:flex; align-items:center; gap:6px; }\n        .card { background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:12px; padding:16px; }\n      </style>\n      </head><body>\n        <div class=\"app\">\n          <div class=\"nav\">\n            <div class=\"logo\"><span>[pulse]</span><span>${siteTitle}</span></div>\n            <div style=\"font-size:11px; color:${colors.subtext};\">In-Browser Compilation</div>\n          </div>\n          <div style=\"margin-top:16px;\">\n            <div style=\"font-size:11px; text-transform:uppercase; color:${colors.accent}; letter-spacing:1px; font-weight:bold;\">Compiled from Prompt Tokens</div>\n            <h2 style=\"margin:4px 0 8px 0; font-size:20px; color:${colors.text};\">${promptText.slice(0, 48)}</h2>\n            <div style=\"font-size:12px; color:${colors.subtext}; line-height:1.5;\">${styleText.slice(0, 80)}</div>\n          </div>\n          ${componentBody}\n        </div>\n      </body></html>`;\n  };\n\n  window.compileDynamicGame = function(features, canvas) {\n    const { colors, pText, promptText, tier, seed } = features;\n    const ctx = canvas.getContext('2d');\n    const W = canvas.width, H = canvas.height;\n\n    if (window.__pgActiveAnimId) {\n      cancelAnimationFrame(window.__pgActiveAnimId);\n      window.__pgActiveAnimId = null;\n    }\n    window.onkeydown = null;\n    window.onkeyup = null;\n\n    if (pText.includes('flappy') || pText.includes('flap') || pText.includes('bird')) {\n      let birdY = H / 2, birdVy = 0, score = 0, pipes = [], gameOver = false;\n      const jumpPower = pText.includes('high') ? -7.8 : -6.2;\n\n      function flap() {\n        if (gameOver) {\n          birdY = H / 2; birdVy = 0; score = 0; pipes = []; gameOver = false;\n        } else {\n          birdVy = jumpPower;\n        }\n      }\n\n      canvas.onclick = flap;\n      window.onkeydown = (e) => { if (e.code === 'Space') { e.preventDefault(); flap(); } };\n\n      function loop() {\n        birdVy += 0.32;\n        birdY += birdVy;\n\n        if (pipes.length === 0 || pipes[pipes.length - 1].x < W - 180) {\n          const gap = 110;\n          const topH = Math.floor(Math.random() * (H - gap - 60)) + 30;\n          pipes.push({ x: W, topH, bottomY: topH + gap, passed: false });\n        }\n\n        pipes.forEach(p => { p.x -= 2.2; });\n\n        pipes.forEach(p => {\n          if (!p.passed && p.x < 100) { p.passed = true; score++; }\n          if (100 > p.x && 80 < p.x + 40) {\n            if (birdY - 10 < p.topH || birdY + 10 > p.bottomY) gameOver = true;\n          }\n        });\n\n        if (birdY > H - 15 || birdY < 10) gameOver = true;\n        pipes = pipes.filter(p => p.x > -50);\n\n        ctx.fillStyle = colors.bg;\n        ctx.fillRect(0, 0, W, H);\n\n        ctx.fillStyle = colors.primary;\n        pipes.forEach(p => {\n          ctx.fillRect(p.x, 0, 40, p.topH);\n          ctx.fillRect(p.x, p.bottomY, 40, H - p.bottomY);\n        });\n\n        ctx.fillStyle = colors.accent;\n        ctx.beginPath();\n        ctx.arc(90, birdY, 12, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.fillStyle = '#000';\n        ctx.fillRect(94, birdY - 4, 3, 3);\n\n        ctx.fillStyle = colors.text;\n        ctx.font = 'bold 16px monospace';\n        ctx.fillText(`SCORE: ${score}`, 20, 35);\n        ctx.font = '11px monospace';\n        ctx.fillStyle = colors.subtext;\n        ctx.fillText('Space or Click to Flap - ' + promptText.slice(0, 28), 20, 55);\n\n        if (gameOver) {\n          ctx.fillStyle = 'rgba(0,0,0,0.75)';\n          ctx.fillRect(0, 0, W, H);\n          ctx.fillStyle = colors.secondary;\n          ctx.font = 'bold 24px monospace';\n          ctx.textAlign = 'center';\n          ctx.fillText('GAME OVER', W / 2, H / 2 - 10);\n          ctx.fillStyle = colors.text;\n          ctx.font = '13px monospace';\n          ctx.fillText('Click to Restart', W / 2, H / 2 + 20);\n          ctx.textAlign = 'left';\n        }\n\n        window.__pgActiveAnimId = requestAnimationFrame(loop);\n      }\n      loop();\n    } else if (pText.includes('asteroid') || pText.includes('shooter') || pText.includes('laser')) {\n      let ship = { x: W / 2, y: H / 2, angle: 0, vx: 0, vy: 0 };\n      let bullets = [], rocks = [], score = 0, keys = {};\n\n      for (let i = 0; i < 5; i++) {\n        rocks.push({ x: Math.random() * W, y: Math.random() * H, r: 24, vx: (Math.random() - 0.5) * 1.5, vy: (Math.random() - 0.5) * 1.5 });\n      }\n\n      window.onkeydown = (e) => {\n        keys[e.code] = true;\n        if (e.code === 'Space') {\n          bullets.push({ x: ship.x, y: ship.y, vx: Math.cos(ship.angle) * 6, vy: Math.sin(ship.angle) * 6, life: 50 });\n        }\n      };\n      window.onkeyup = (e) => { keys[e.code] = false; };\n\n      function loop() {\n        if (keys['ArrowLeft'] || keys['KeyA']) ship.angle -= 0.07;\n        if (keys['ArrowRight'] || keys['KeyD']) ship.angle += 0.07;\n        if (keys['ArrowUp'] || keys['KeyW']) {\n          ship.vx += Math.cos(ship.angle) * 0.15;\n          ship.vy += Math.sin(ship.angle) * 0.15;\n        }\n\n        ship.vx *= 0.985; ship.vy *= 0.985;\n        ship.x = (ship.x + ship.vx + W) % W;\n        ship.y = (ship.y + ship.vy + H) % H;\n\n        bullets.forEach(b => { b.x += b.vx; b.y += b.vy; b.life--; });\n        bullets = bullets.filter(b => b.life > 0);\n\n        rocks.forEach(r => {\n          r.x = (r.x + r.vx + W) % W;\n          r.y = (r.y + r.vy + H) % H;\n          bullets.forEach(b => {\n            if (Math.hypot(b.x - r.x, b.y - r.y) < r.r) {\n              score += 50; b.life = 0; r.x = -100;\n            }\n          });\n        });\n        rocks = rocks.filter(r => r.x > -50);\n        if (rocks.length < 3) rocks.push({ x: 0, y: Math.random() * H, r: 20, vx: Math.random() * 1.5, vy: Math.random() * 1.5 });\n\n        ctx.fillStyle = colors.bg;\n        ctx.fillRect(0, 0, W, H);\n\n        ctx.strokeStyle = colors.secondary;\n        ctx.lineWidth = 2;\n        rocks.forEach(r => {\n          ctx.beginPath();\n          ctx.arc(r.x, r.y, r.r, 0, Math.PI * 2);\n          ctx.stroke();\n        });\n\n        ctx.fillStyle = colors.accent;\n        bullets.forEach(b => {\n          ctx.beginPath();\n          ctx.arc(b.x, b.y, 3, 0, Math.PI * 2);\n          ctx.fill();\n        });\n\n        ctx.save();\n        ctx.translate(ship.x, ship.y);\n        ctx.rotate(ship.angle);\n        ctx.strokeStyle = colors.primary;\n        ctx.lineWidth = 2.5;\n        ctx.beginPath();\n        ctx.moveTo(16, 0); ctx.lineTo(-12, -10); ctx.lineTo(-6, 0); ctx.lineTo(-12, 10); ctx.closePath();\n        ctx.stroke();\n        ctx.restore();\n\n        ctx.fillStyle = colors.text;\n        ctx.font = 'bold 16px monospace';\n        ctx.fillText(`SCORE: ${score}`, 20, 30);\n        ctx.font = '11px monospace';\n        ctx.fillStyle = colors.subtext;\n        ctx.fillText('WASD / Arrows to Pilot - Space to Fire Laser', 20, 50);\n\n        window.__pgActiveAnimId = requestAnimationFrame(loop);\n      }\n      loop();\n    } else {\n      let playerX = W / 2, playerSpeed = 5;\n      let items = [], score = 0, frame = 0, keys = {};\n      window.onkeydown = (e) => { keys[e.code] = true; };\n      window.onkeyup = (e) => { keys[e.code] = false; };\n\n      function loop() {\n        frame++;\n        ctx.fillStyle = colors.bg;\n        ctx.fillRect(0, 0, W, H);\n\n        if (keys['ArrowLeft'] || keys['KeyA']) playerX = Math.max(30, playerX - playerSpeed);\n        if (keys['ArrowRight'] || keys['KeyD']) playerX = Math.min(W - 30, playerX + playerSpeed);\n\n        if (frame % 30 === 0) {\n          items.push({ x: Math.random() * (W - 40) + 20, y: 0, speed: Math.random() * 3 + 2 });\n        }\n\n        items.forEach(it => {\n          it.y += it.speed;\n          ctx.fillStyle = colors.accent;\n          ctx.fillRect(it.x - 8, it.y - 8, 16, 16);\n          if (it.y > H - 50 && Math.abs(it.x - playerX) < 30) {\n            score += 20;\n            it.y = H + 100;\n          }\n        });\n        items = items.filter(it => it.y < H);\n\n        ctx.fillStyle = colors.primary;\n        ctx.fillRect(playerX - 25, H - 40, 50, 14);\n\n        ctx.fillStyle = colors.text;\n        ctx.font = 'bold 16px monospace';\n        const gameLabel = promptText.slice(0, 24).toUpperCase();\n        ctx.fillText(`${gameLabel} - SCORE: ${score}`, 20, 30);\n        ctx.font = '11px monospace';\n        ctx.fillStyle = colors.subtext;\n        ctx.fillText('Left / Right or A / D to steer - Tier :' + tier, 20, 50);\n\n        window.__pgActiveAnimId = requestAnimationFrame(loop);\n      }\n      loop();\n    }\n  };\n\n  window.renderStylePresets();\n  window.switchPlaygroundMode('svgs');\n  const slot1 = document.getElementById('pg-prompt-slot-1');\n  if (slot1) {\n    slot1.value = STYLE_PRESETS[0].text;\n    slot1.addEventListener('input', () => {\n      const val = slot1.value.trim();\n      const matched = STYLE_PRESETS.find(s => s.text.trim() === val);\n      window.__pgActiveStyleId = matched ? matched.id : '';\n      window.renderStylePresets();\n    });\n  }\n\n  const slot2 = document.getElementById('pg-prompt-slot-2');\n  if (slot2) {\n    slot2.addEventListener('input', () => {\n      const val = slot2.value.trim();\n      const list = PROMPT_PRESETS[window.__pgCurrentMode] || [];\n      const matched = list.find(p => p.prompt.trim() === val);\n      window.__pgActivePromptId = matched ? matched.id : '';\n      window.renderPromptPresets();\n    });\n  }\n\n  window.bootstrapModelHarnesses('mini (1.5B)');\n})();\n  </script>\n</section>")

(df playground-view [] -> Str
  :d "Playground view alias"
  (render-playground-view))
