(module asl/web/tests/tokenArbitrageTest :x [runTests RunTests! testLegacyRuntimePurged! testFlagshipArticlesRegistered testTokenArbitrageEngine testTelemetryMatrixHydrated! testDualPolarityRefutations] :i [(aslWeb/components/tokenArbitrage :a arb) (aslWeb/blogPosts :a posts)])

fn testLegacyRuntimePurged! -> Bool
  (let [(postsContent (mt (fileRead "asl/web/src/data/blog/posts.asn") ((ok c) c) ((err _) "")))] (assert (not (stringContains? postsContent "asl-eval.mjs")) "Zero occurrences of asl-eval.mjs") (assert (not (stringContains? postsContent "process.hrtime.bigint()")) "Zero occurrences of process.hrtime.bigint()") (assert (not (stringContains? postsContent "Node / Bun / Deno Hosts")) "Zero occurrences of Node/Bun host lists") (assert (not (stringContains? postsContent "evalInV8")) "Zero occurrences of evalInV8") (refute (stringContains? postsContent "asl-eval.mjs") "Blog must refute asl-eval.mjs") (refute (stringContains? postsContent "process.hrtime.bigint()") "Blog must refute process.hrtime.bigint()") (refute (stringContains? postsContent "Node / Bun / Deno Hosts") "Blog must refute Node/Bun/Deno references") (refute (stringContains? postsContent "evalInV8") "Blog must refute evalInV8") true)

fn titleOf p: (Option Any) -> Str
  (mt p ((none) "") ((some post) post.title))

fn testFlagshipArticlesRegistered -> Bool
  (let [(p1 (posts/getPostBySlug "clean-break-v04")) (p2 (posts/getPostBySlug "the-stateless-nine-syscall-kernel")) (p3 (posts/getPostBySlug "s-expression-wire-protocol-vs-json-rpc")) (p4 (posts/getPostBySlug "zero-line-number-invariant")) (p5 (posts/getPostBySlug "slm-inference-apple-silicon"))] (assert (!= p1 none) "clean-break-v04 article exists") (assert (!= p2 none) "the-stateless-nine-syscall-kernel article exists") (assert (!= p3 none) "s-expression-wire-protocol-vs-json-rpc article exists") (assert (!= p4 none) "zero-line-number-invariant article exists") (assert (!= p5 none) "slm-inference-apple-silicon article exists") (assert (!= (titleOf p1) "") "p1 title is non-empty") (assert (!= (titleOf p2) "") "p2 title is non-empty") (assert (!= (titleOf p3) "") "p3 title is non-empty") (assert (!= (titleOf p4) "") "p4 title is non-empty") (assert (!= (titleOf p5) "") "p5 title is non-empty") (refute (= p1 none) "Must refute none p1") (refute (= p2 none) "Must refute none p2") (refute (= p3 none) "Must refute none p3") (refute (= p4 none) "Must refute none p4") (refute (= p5 none) "Must refute none p5") (refute (= (titleOf p1) "") "Must refute empty p1 title") (refute (= (titleOf p2) "") "Must refute empty p2 title") (refute (= (titleOf p3) "") "Must refute empty p3 title") (refute (= (titleOf p4) "") "Must refute empty p4 title") (refute (= (titleOf p5) "") "Must refute empty p5 title") true)

fn testTokenArbitrageEngine -> Bool
  (let [(pySample "def process_events(queue):\n    for event in queue:\n        dispatch(event)") (res (arb/computeTokenSavings pySample "python")) (origTokens (optionOr (mapGet res :originalTokens) 0)) (aslTokens (optionOr (mapGet res :aslTokens) 0)) (savings (optionOr (mapGet res :savingsPercent) 0)) (emitted (optionOr (mapGet res :aslEmitted) ""))] (assert (arb/isArbitrageSupported) "Arbitrage engine is supported") (assert (> origTokens 0) "Original tokens > 0") (assert (> aslTokens 0) "ASL tokens > 0") (assert (> savings 60) "Token savings > 60%") (assert (> (stringLength emitted) 0) "Emitted ASL is non-empty") (refute (not (arb/isArbitrageSupported)) "Must refute unsupported arbitrage") (refute (= aslTokens 0) "ASL tokens must not be 0") (refute (< savings 50) "Savings must not fall below 50%") (refute (= (stringLength emitted) 0) "Emitted ASL must not be empty") true)

fn testTelemetryMatrixHydrated! -> Bool
  (let [(tel (mt (fileRead "asl/web/src/data/telemetry.asn") ((ok c) c) ((err _) "")))] (assert (> (stringLength tel) 0) "Telemetry ASN is non-empty") (assert (stringContains? tel ":m1-telemetry") "Contains M1 telemetry") (assert (stringContains? tel ":m2-telemetry") "Contains M2 telemetry") (assert (stringContains? tel ":m3-telemetry") "Contains M3 telemetry") (assert (stringContains? tel ":syscall-count 9") "Contains 9-syscall count benchmark") (refute (= (stringLength tel) 0) "Telemetry length must not be 0") (refute (not (stringContains? tel ":syscall-count 9")) "Must refute missing 9-syscall claim") (refute (not (stringContains? tel ":m1-telemetry")) "Must refute missing M1 telemetry claim") true)

fn testDualPolarityRefutations -> Bool
  (let [(giantInput (arb/makeOversizedInput 70000)) (clamped (arb/clampInput giantInput))] (assert (<= (stringLength clamped) 65536) "Input clamped to <= 64KB") (assert (> (stringLength clamped) 0) "Clamped input is non-empty") (refute (> (stringLength clamped) 65536) "Clamped input must not exceed 64KB") (refute (= (stringLength clamped) 0) "Clamped input must not be empty") true)

fn ! runTests -> Bool
  (do (testLegacyRuntimePurged!) (testFlagshipArticlesRegistered) (testTokenArbitrageEngine) (testTelemetryMatrixHydrated!) (testDualPolarityRefutations) true)

fn RunTests! -> Bool
  (runTests)
