(module aslWeb/blogParityTest :x [testBlogPostsCount testBlogPostsSlugs testBlogPostsInvariants testBlogQueryHelpers runTests] :i [(aslWeb/blogPosts :a blog)])

fn testBlogPostsCount -> Bool
  (let [(allPosts (blog/getAllPosts))] (assert (= (listLength allPosts) 28) "post count is not 28") (assert (not (= (listLength allPosts) 0)) "post count must not be 0") true)

fn testBlogPostsSlugs -> Bool
  (do (assert (!= (blog/getPostBySlug "clean-break-v04") none) "missing slug clean-break-v04") (assert (!= (blog/getPostBySlug "the-stateless-nine-syscall-kernel") none) "missing slug the-stateless-nine-syscall-kernel") (assert (!= (blog/getPostBySlug "s-expression-wire-protocol-vs-json-rpc") none) "missing slug s-expression-wire-protocol-vs-json-rpc") (assert (!= (blog/getPostBySlug "zero-line-number-invariant") none) "missing slug zero-line-number-invariant") (assert (!= (blog/getPostBySlug "slm-inference-apple-silicon") none) "missing slug slm-inference-apple-silicon") (assert (!= (blog/getPostBySlug "why-3b-local-models-fail-at-python-but-fly-on-s-expressions") none) "missing slug 22") (assert (!= (blog/getPostBySlug "the-death-of-json-rpc-and-zero-copy-wire-protocols") none) "missing slug 23") (assert (!= (blog/getPostBySlug "zero-overhead-test-telemetry-and-resource-observability") none) "missing slug 21") (assert (!= (blog/getPostBySlug "multi-tier-recursive-fractal-memory-and-tree-aggregation") none) "missing slug 20") (assert (!= (blog/getPostBySlug "why-llms-struggle-with-python-and-rust") none) "missing slug 1") (assert (!= (blog/getPostBySlug "token-economy-and-structural-compression") none) "missing slug 2") (assert (!= (blog/getPostBySlug "from-vibe-code-to-wasm-in-0-04ms") none) "missing slug 3") (assert (!= (blog/getPostBySlug "the-token-tax-and-interface-compression") none) "missing slug 4") (assert (!= (blog/getPostBySlug "the-token-density-fallacy-and-machine-understandability") none) "missing slug 5") (assert (!= (blog/getPostBySlug "the-deterministic-agent-os") none) "missing slug 6") (assert (!= (blog/getPostBySlug "the-agent-operational-circle") none) "missing slug 7") (assert (!= (blog/getPostBySlug "the-agentic-toolchain-and-native-action-loops") none) "missing slug 8") (assert (!= (blog/getPostBySlug "inter-agent-protocols-and-wire-frames") none) "missing slug 9") (assert (!= (blog/getPostBySlug "agent-script-the-optimal-agent-language") none) "missing slug 10") (assert (!= (blog/getPostBySlug "the-agent-native-developer-cockpit") none) "missing slug 11") (assert (!= (blog/getPostBySlug "multi-dimensional-observability-for-autonomous-systems") none) "missing slug 12") (assert (!= (blog/getPostBySlug "epistemic-grounding-and-anti-hallucination-firewalls") none) "missing slug 13") (assert (!= (blog/getPostBySlug "zero-server-in-browser-agent-runtimes") none) "missing slug 14") (assert (!= (blog/getPostBySlug "cross-dialect-sql-without-hallucinations") none) "missing slug 15") (assert (!= (blog/getPostBySlug "git-native-agent-memory-and-vector-recall") none) "missing slug 16") (assert (!= (blog/getPostBySlug "kill-80-percent-agent-code-bloat") none) "missing slug 17") (assert (!= (blog/getPostBySlug "why-llms-break-on-svg-xml") none) "missing slug 18") (assert (!= (blog/getPostBySlug "universal-cross-platform-glue-without-drift") none) "missing slug 19") true)

fn testBlogPostsInvariants -> Bool
  (let [(posts (blog/getAllPosts))] (assert (> (listLength posts) 0) "posts list is empty") (let [(p22 (blog/getPostBySlug "why-3b-local-models-fail-at-python-but-fly-on-s-expressions"))] (assert (!= p22 none) "p22 is none") (mt p22 ((none) (assert false "p22 missing")) ((some p22) (assert (!= p22.title "") "p22 title is empty") (assert (!= p22.date "") "p22 date is empty") (assert (!= p22.author "") "p22 author is empty") (assert (!= p22.category "") "p22 category is empty") (assert (!= p22.readTime "") "p22 read-time is empty") (assert (!= p22.excerpt "") "p22 excerpt is empty") (assert (!= p22.content "") "p22 content is empty") (assert (> (listLength p22.tags) 0) "p22 tags empty")))) (let [(p23 (blog/getPostBySlug "the-death-of-json-rpc-and-zero-copy-wire-protocols"))] (assert (!= p23 none) "p23 is none") (mt p23 ((none) (assert false "p23 missing")) ((some p23) (assert (!= p23.title "") "p23 title is empty") (assert (!= p23.date "") "p23 date is empty") (assert (!= p23.author "") "p23 author is empty") (assert (!= p23.category "") "p23 category is empty") (assert (!= p23.readTime "") "p23 read-time is empty") (assert (!= p23.excerpt "") "p23 excerpt is empty") (assert (!= p23.content "") "p23 content is empty") (assert (> (listLength p23.tags) 0) "p23 tags empty")))) (let [(p1 (blog/getPostBySlug "why-llms-struggle-with-python-and-rust"))] (assert (!= p1 none) "p1 is none") (mt p1 ((none) (assert false "p1 missing")) ((some p1) (assert (!= p1.title "") "p1 title is empty") (assert (!= p1.date "") "p1 date is empty") (assert (!= p1.author "") "p1 author is empty") (assert (!= p1.category "") "p1 category is empty") (assert (!= p1.readTime "") "p1 read-time is empty") (assert (!= p1.excerpt "") "p1 excerpt is empty") (assert (!= p1.content "") "p1 content is empty") (assert (> (listLength p1.tags) 0) "p1 tags empty")))) (let [(p21 (blog/getPostBySlug "zero-overhead-test-telemetry-and-resource-observability"))] (assert (!= p21 none) "p21 is none") (mt p21 ((none) (assert false "p21 missing")) ((some p21) (assert (!= p21.title "") "p21 title is empty") (assert (!= p21.date "") "p21 date is empty") (assert (!= p21.author "") "p21 author is empty") (assert (!= p21.category "") "p21 category is empty") (assert (!= p21.readTime "") "p21 read-time is empty") (assert (!= p21.excerpt "") "p21 excerpt is empty") (assert (!= p21.content "") "p21 content is empty") (assert (> (listLength p21.tags) 0) "p21 tags empty")))) (let [(p20 (blog/getPostBySlug "multi-tier-recursive-fractal-memory-and-tree-aggregation"))] (assert (!= p20 none) "p20 is none") (mt p20 ((none) (assert false "p20 missing")) ((some p20) (assert (!= p20.title "") "p20 title is empty") (assert (!= p20.date "") "p20 date is empty") (assert (!= p20.author "") "p20 author is empty") (assert (!= p20.category "") "p20 category is empty") (assert (!= p20.readTime "") "p20 read-time is empty") (assert (!= p20.excerpt "") "p20 excerpt is empty") (assert (!= p20.content "") "p20 content is empty") (assert (> (listLength p20.tags) 0) "p20 tags empty")))) (let [(p19 (blog/getPostBySlug "universal-cross-platform-glue-without-drift"))] (assert (!= p19 none) "p19 is none") (mt p19 ((none) (assert false "p19 missing")) ((some p19) (assert (!= p19.title "") "p19 title is empty") (assert (!= p19.date "") "p19 date is empty") (assert (!= p19.author "") "p19 author is empty") (assert (!= p19.category "") "p19 category is empty") (assert (!= p19.readTime "") "p19 read-time is empty") (assert (!= p19.excerpt "") "p19 excerpt is empty") (assert (!= p19.content "") "p19 content is empty") (assert (> (listLength p19.tags) 0) "p19 tags empty")))) true)

fn testBlogQueryHelpers -> Bool
  (do (assert (= (blog/getPostBySlug "nonexistent-slug") none) "nonexistent slug did not return none") (assert (> (listLength (blog/getFlagshipPosts)) 0) "flagship posts empty") (assert (> (listLength (blog/getPublishedPosts)) 0) "published posts empty") (assert (> (listLength (blog/filterByTag "Pure ASL")) 0) "filter-by-tag Pure ASL empty") (assert (> (listLength (blog/filterByCategory "Language Theory")) 0) "filter-by-category empty") true)

fn runTests -> Bool
  (and (testBlogPostsCount) (testBlogPostsSlugs) (testBlogPostsInvariants) (testBlogQueryHelpers))
