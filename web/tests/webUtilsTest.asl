(module aslWeb/webUtilsTest :x [testDomElement testDomQuery testFormatVdomNode testWebLibQueries runTests] :i [(aslWeb/dom :a dom) (aslWeb/blogPosts :a blog)])

fn testDomElement -> Bool
  (let [(elem (dom/domElement "button" (list (pair "id" "submit-btn") (pair "class" "primary")) (list (dom/text "Click Me"))))] (assert (= (dom/vdomText (optionOr (listHead (dom/vdomChildren elem)) elem)) "Click Me") "child text is not Click Me") (assert (= (dom/vdomText elem) "") "element node text is not empty") (assert (= (dom/vdomTag elem) "button") "tag is not button") (assert (= (listLength (dom/vdomAttrs elem)) 2) "attrs count is not 2") (assert (= (listLength (dom/vdomChildren elem)) 1) "children count is not 1") (let [(emptyElem (dom/domElement "div" (list) (list)))] (assert (= (dom/vdomTag emptyElem) "div") "empty div tag mismatch") (assert (= (listLength (dom/vdomAttrs emptyElem)) 0) "empty div has attrs") (assert (= (listLength (dom/vdomChildren emptyElem)) 0) "empty div has children")) true)

fn testDomQuery -> Bool
  (let [(tree (dom/domElement "main" (list (pair "id" "root")) (list (dom/domElement "nav" (list) (list (dom/domElement "a" (list (pair "href" "/")) (list (dom/text "Home"))))) (dom/domElement "section" (list (pair "class" "content")) (list (dom/domElement "article" (list) (list (dom/domElement "h1" (list) (list (dom/text "Headline"))) (dom/domElement "p" (list) (list (dom/text "Paragraph"))))))))))] (let [(foundH1 (dom/domQuery (some tree) "h1"))] (assert (!= foundH1 none) "h1 element not found") (assert (= (dom/vdomTag (optionOr foundH1 tree)) "h1") "found tag is not h1") (assert (= (listLength (dom/vdomChildren (optionOr foundH1 tree))) 1) "h1 child count mismatch")) (let [(foundA (dom/domQuery (some tree) "a"))] (assert (!= foundA none) "anchor element not found") (assert (= (dom/vdomTag (optionOr foundA tree)) "a") "found tag is not a")) (let [(absent (dom/domQuery (some tree) "footer"))] (assert (= absent none) "nonexistent element did not return none")) (let [(absentNone (dom/domQuery none "div"))] (assert (= absentNone none) "query on none root did not return none")) true)

fn testFormatVdomNode -> Bool
  (do (let [(leaf (dom/domElement "span" (list) (list (dom/text "Hello"))))] (assert (= (dom/formatVdomNode (some leaf)) "<span>Hello</span>") "leaf formatting mismatch")) (let [(leafWithAttr (dom/domElement "input" (list (pair "type" "text") (pair "name" "q")) (list)))] (assert (= (dom/formatVdomNode (some leafWithAttr)) "<input type=\"text\" name=\"q\"></input>") "input formatting mismatch")) (let [(nested (dom/domElement "div" (list (pair "id" "main")) (list (dom/domElement "h1" (list) (list (dom/text "Title"))) (dom/domElement "p" (list) (list (dom/text "Content"))))))] (assert (= (dom/formatVdomNode (some nested)) "<div id=\"main\"><h1>Title</h1><p>Content</p></div>") "nested formatting mismatch")) (assert (= (dom/formatVdomNode none) "") "none node format should be empty string") (assert (= (dom/formatVdomNode (some (dom/text "plain text"))) "plain text") "plain text format mismatch") true)

fn testWebLibQueries -> Bool
  (let [(allPosts (blog/getAllPosts))] (assert (= (listLength allPosts) 28) "total blog posts count should be 28") (let [(archPosts (blog/filterByCategory "Architecture & Language Theory"))] (assert (> (listLength archPosts) 0) "category filter returned empty list") (assert (<= (listLength archPosts) 28) "category filter exceeded total")) (let [(flagship (blog/getFlagshipPosts))] (assert (> (listLength flagship) 0) "flagship posts should not be empty")) (let [(published (blog/getPublishedPosts))] (assert (> (listLength published) 0) "published posts should not be empty")) (let [(aslTagPosts (blog/filterByTag "AgentScript"))] (assert (> (listLength aslTagPosts) 0) "tag filter for AgentScript should return posts")) (let [(validPost (blog/getPostBySlug "the-agentic-toolchain-and-native-action-loops"))] (assert (!= validPost none) "failed to retrieve canonical post by slug") (mt validPost ((none) (assert false "validPost missing")) ((some post) (assert (= post.slug "the-agentic-toolchain-and-native-action-loops") "slug mismatch")))) (let [(missingPost (blog/getPostBySlug "unknown-post-slug"))] (assert (= missingPost none) "unknown slug should return none")) true)

fn runTests -> Bool
  (and (testDomElement) (testDomQuery) (testFormatVdomNode) (testWebLibQueries))
