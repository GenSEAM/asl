(module aslSite/app/theme
  :x [Swatch palette swatchDark swatchLight tokenRules sheet stylesheet]
  :i [(asl-html/css :a c)])

(enum Swatch (:c swatch [(name String) (dark String) (light String)] "one colour role: its dark and light value"))

fn palette -> (List Swatch)
  [(swatch "ground" "#0b080d" "#faf8f9")
   (swatch "sunken" "#070509" "#f2ecf0")
   (swatch "surface" "#120d15" "#ffffff")
   (swatch "surface-hi" "#1c1421" "#fdf9fc")
   (swatch "inset" "#0d0910" "#f5eef3")
   (swatch "line" "#3d283b" "#d6c8d2")
   (swatch "line-strong" "#7d4b71" "#8d7086")
   (swatch "ink" "#f7f1f5" "#1b1419")
   (swatch "ink-2" "#d8cbd5" "#4a3e47")
   (swatch "ink-3" "#a894a3" "#6e5f6b")
   (swatch "signal" "#ff5aa8" "#c2185b")
   (swatch "signal-soft" "#ff8ec4" "#d81b60")
   (swatch "signal-wash" "rgba(255,90,168,.15)" "rgba(194,24,91,.09)")
   (swatch "signal-glow" "rgba(255,90,168,.28)" "rgba(194,24,91,.16)")
   (swatch "leon-skin" "#ffe2e4" "#ffe2e4")
   (swatch "leon-line" "#9c3b6e" "#9c3b6e")]

fn swatchDark s: Swatch -> c/Decl
  (match s ((swatch name dark light) (c/decl (str "--" name) dark)))

fn swatchLight s: Swatch -> c/Decl
  (match s ((swatch name dark light) (c/decl (str "--" name) light)))

fn tokenRules -> (List c/Rule)
  [(c/rule ":root" (listAppend (map swatchDark (palette)) [(c/decl "color-scheme" "dark")]))
   (c/media "(prefers-color-scheme: light)" [(c/rule ":root:not([data-theme=dark])" (listAppend (map swatchLight (palette)) [(c/decl "color-scheme" "light")]))])
   (c/rule ":root[data-theme=light]" (listAppend (map swatchLight (palette)) [(c/decl "color-scheme" "light")]))]

fn v name: String -> String
  (c/cssVar name)

fn d prop: String value: String -> c/Decl
  (c/decl prop value)

fn r selector: String decls: (List c/Decl) -> c/Rule
  (c/rule selector decls)

fn sans -> String
  "ui-sans-serif,system-ui,-apple-system,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif"

fn mono -> String
  "ui-monospace,\"SF Mono\",\"JetBrains Mono\",Menlo,Consolas,\"Liberation Mono\",monospace"

fn base -> (List c/Rule)
  [(r "*,*::before,*::after" [(d "box-sizing" "border-box")])
   (r "html" [(d "-webkit-text-size-adjust" "100%") (d "scroll-padding-top" "4rem")])
   (r "body" [(d "margin" "0") (d "background-color" (v "ground")) (d "background-image" "linear-gradient(to right,rgba(255,90,168,.09) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,90,168,.09) 1px,transparent 1px),linear-gradient(to right,rgba(255,90,168,.032) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,90,168,.032) 1px,transparent 1px)") (d "background-size" "160px 160px,160px 160px,32px 32px,32px 32px") (d "color" (v "ink")) (d "font" (str "15.5px/1.6 " (sans))) (d "-webkit-font-smoothing" "antialiased") (d "overflow-x" "hidden")])
   (r "a" [(d "color" "inherit") (d "text-decoration-color" (v "line-strong")) (d "text-underline-offset" "3px")])
   (r "a:hover" [(d "text-decoration-color" (v "signal")) (d "color" (v "signal-soft"))])
   (r "code,pre,kbd,.mono" [(d "font-family" (mono)) (d "font-variant-ligatures" "none")])
   (r "h1,h2,h3,h4,p,ul,ol,figure,pre,blockquote" [(d "margin" "0")])
   (r ":focus-visible" [(d "outline" (str "2px solid " (v "signal"))) (d "outline-offset" "2px")])
   (r "::selection" [(d "background" (v "signal")) (d "color" "#0b080d")])
   (r ".skip" [(d "position" "absolute") (d "left" "-999px") (d "top" "8px")])
   (r ".skip:focus" [(d "left" "16px") (d "z-index" "60") (d "background" (v "surface")) (d "padding" "8px 12px") (d "border" (str "1px solid " (v "signal")))])
   (c/media "(prefers-reduced-motion: reduce)" [(r "*" [(d "transition" "none !important") (d "animation" "none !important") (d "scroll-behavior" "auto !important")])])]

fn layout -> (List c/Rule)
  [(r ".shell" [(d "max-width" "76rem") (d "margin" "0 auto") (d "padding" "0") (d "border-left" (str "1px solid " (v "line-strong"))) (d "border-right" (str "1px solid " (v "line-strong"))) (d "position" "relative") (d "background" "rgba(11,8,13,.82)")])
   (r ":root[data-theme=light] .shell" [(d "background" "rgba(250,248,249,.88)")])
   (r ".band" [(d "padding" "0") (d "border-top" (str "1px solid " (v "line-strong"))) (d "position" "relative")])
   (r ".band.sunken" [(d "background-color" "rgba(7,5,9,.86)")])
   (r ":root[data-theme=light] .band.sunken" [(d "background-color" "rgba(242,236,240,.86)")])
   (r ".band>.shell::before" [(d "content" "\"┼\"") (d "position" "absolute") (d "top" "-8px") (d "left" "-5.5px") (d "font" (str "700 13px/1 " (mono))) (d "color" (v "signal")) (d "pointer-events" "none") (d "z-index" "5")])
   (r ".band>.shell::after" [(d "content" "\"┼\"") (d "position" "absolute") (d "top" "-8px") (d "right" "-5.5px") (d "font" (str "700 13px/1 " (mono))) (d "color" (v "signal")) (d "pointer-events" "none") (d "z-index" "5")])
   (r ".stack>*+*" [(d "margin-top" "1.1rem")])
   (r ".body" [(d "min-width" "0")])
   (c/media "(min-width: 1024px)" [(r ".sheet" [(d "display" "grid") (d "grid-template-columns" "repeat(12,minmax(0,1fr))")]) (r ".sheet>.head" [(d "grid-column" "1 / 5") (d "border-bottom" "0") (d "border-right" (str "1px solid " (v "line-strong"))) (d "align-content" "start")]) (r ".sheet>.body" [(d "grid-column" "5 / 13")])])]

fn chrome -> (List c/Rule)
  [(r ".top" [(d "position" "sticky") (d "top" "0") (d "z-index" "50") (d "background" "rgba(11,8,13,.95)") (d "backdrop-filter" "blur(10px)") (d "-webkit-backdrop-filter" "blur(10px)") (d "border-bottom" (str "1px solid " (v "line-strong")))])
   (r ":root[data-theme=light] .top" [(d "background" "rgba(250,248,249,.95)")])
   (r ".top .shell" [(d "display" "flex") (d "align-items" "stretch") (d "justify-content" "space-between") (d "height" "56px") (d "padding" "0 0 0 18px")])
   (r ".mark" [(d "display" "inline-flex") (d "align-items" "center") (d "gap" "10px") (d "text-decoration" "none") (d "font" (str "700 .9rem/1 " (mono))) (d "letter-spacing" ".06em") (d "text-transform" "uppercase")])
   (r ".mark-tag" [(d "font" (str "700 .65rem/1 " (mono))) (d "padding" "4px 7px") (d "background" (v "signal")) (d "color" "#0b080d") (d "letter-spacing" ".1em")])
   (r ".links" [(d "display" "flex") (d "align-items" "stretch") (d "gap" "0")])
   (r ".links a" [(d "display" "inline-flex") (d "align-items" "center") (d "padding" "0 16px") (d "border-left" (str "1px solid " (v "line"))) (d "font" (str "600 .74rem/1 " (mono))) (d "text-transform" "uppercase") (d "letter-spacing" ".08em") (d "color" (v "ink-2")) (d "text-decoration" "none") (d "transition" "color .12s,background .12s")])
   (r ".links a:hover,.links a[aria-current=page]" [(d "color" (v "signal-soft")) (d "background" (v "signal-wash")) (d "box-shadow" (str "inset 0 -2px 0 " (v "signal")))])
   (c/media "(max-width: 539px)" [(r ".links .wide" [(d "display" "none")])])
   (r ".toggle" [(d "display" "inline-flex") (d "align-items" "center") (d "justify-content" "center") (d "width" "54px") (d "height" "100%") (d "border" "0") (d "border-left" (str "1px solid " (v "line"))) (d "background" (v "inset")) (d "color" (v "ink-2")) (d "cursor" "pointer")])
   (r ".toggle:hover" [(d "color" (v "signal")) (d "background" (v "signal-wash"))])
   (r ".toggle svg" [(d "width" "15px") (d "height" "15px")])
   (r ".toggle .ring" [(d "fill" "none") (d "stroke" "currentColor") (d "stroke-width" "1.8")])
   (r ".toggle .sun" [(d "fill" "currentColor")])
   (r ".foot" [(d "border-top" (str "1px solid " (v "line-strong"))) (d "padding" "0") (d "color" (v "ink-3")) (d "font-size" ".875rem") (d "background" (v "sunken"))])
   (r ".leon-stage" [(d "display" "flex") (d "justify-content" "center") (d "padding-bottom" "3rem")])
   (r ".leon-stage .leon-dock" [(d "width" "176px")])
   (r ".foot .shell-grid" [(d "display" "grid") (d "gap" "1px") (d "background" (v "line"))])
   (c/media "(min-width: 640px)" [(r ".foot .shell-grid" [(d "grid-template-columns" "repeat(2,minmax(0,1fr))")])])
   (c/media "(min-width: 900px)" [(r ".foot .shell-grid" [(d "grid-template-columns" "240px 2fr 1fr 1fr")])])
   (r ".titleblock" [(d "display" "grid") (d "grid-template-columns" "repeat(2,minmax(0,1fr))") (d "gap" "1px") (d "background" (v "line")) (d "border-top" (str "1px solid " (v "line-strong")))])
   (c/media "(min-width: 768px)" [(r ".titleblock" [(d "grid-template-columns" "repeat(4,minmax(0,1fr))")])])
   (r ".titleblock>div" [(d "background" (v "sunken")) (d "padding" ".9rem 1.75rem") (d "display" "grid") (d "gap" ".2rem")])
   (r ".titleblock b" [(d "font" (str "600 .8rem/1.4 " (mono))) (d "color" (v "ink-2"))])
   (r ".foot .shell-grid>div" [(d "background" (v "sunken")) (d "padding" "2rem 1.75rem")])
   (r ".foot h4" [(d "font" (str "700 .72rem/1.4 " (mono))) (d "text-transform" "uppercase") (d "letter-spacing" ".1em") (d "color" (v "signal-soft")) (d "margin-bottom" ".85rem")])
   (r ".foot ul" [(d "list-style" "none") (d "padding" "0") (d "display" "grid") (d "gap" ".45rem") (d "font-family" (mono)) (d "font-size" ".8rem")])
   (r ".foot a" [(d "text-decoration" "none") (d "color" (v "ink-2"))])
   (r ".foot a:hover" [(d "color" (v "signal"))])]

fn type -> (List c/Rule)
  [(r ".display" [(d "font-family" (sans)) (d "font-size" "clamp(2.1rem,3.2vw + 1rem,3.7rem)") (d "line-height" "1.03") (d "letter-spacing" "-.035em") (d "font-weight" "700") (d "text-wrap" "balance")])
   (r ".display em" [(d "font-style" "normal") (d "color" (v "signal"))])
   (r ".h2" [(d "font-family" (sans)) (d "font-size" "clamp(1.45rem,1.4vw + .8rem,2rem)") (d "line-height" "1.12") (d "letter-spacing" "-.025em") (d "font-weight" "700") (d "text-wrap" "balance")])
   (r ".h3" [(d "font-family" (sans)) (d "font-size" "1.02rem") (d "line-height" "1.3") (d "letter-spacing" "-.01em") (d "font-weight" "650") (d "color" (v "ink"))])
   (r ".lead" [(d "font-size" ".98rem") (d "line-height" "1.65") (d "color" (v "ink-2")) (d "max-width" "46rem")])
   (r ".micro" [(d "font" (str ".72rem/1.4 " (mono))) (d "color" (v "ink-3")) (d "letter-spacing" ".05em") (d "text-transform" "uppercase")])
   (r ".eyebrow" [(d "display" "inline-flex") (d "align-items" "center") (d "gap" "10px") (d "font" (str "700 .72rem/1 " (mono))) (d "text-transform" "uppercase") (d "letter-spacing" ".12em") (d "color" (v "signal-soft"))])
   (r ".eyebrow .idx" [(d "color" (v "signal")) (d "font-weight" "800")])
   (r ".eyebrow .rule" [(d "width" "28px") (d "height" "1px") (d "background" (v "signal"))])
   (r ".head" [(d "position" "relative") (d "display" "grid") (d "gap" ".9rem") (d "padding" "2.25rem 2rem") (d "border-bottom" (str "1px solid " (v "line-strong")))])
   (c/media "(max-width: 639px)" [(r ".head" [(d "padding" "1.75rem 1.25rem")])])]

fn hero -> (List c/Rule)
  [(r ".hero" [(d "padding" "0")])
   (r ".hero-grid" [(d "display" "grid") (d "grid-template-columns" "minmax(0,1fr)") (d "gap" "0") (d "align-items" "stretch")])
   (c/media "(min-width: 900px)" [(r ".hero-grid" [(d "grid-template-columns" "minmax(0,.78fr) minmax(0,1.22fr)")])])
   (r ".hero-art" [(d "position" "relative") (d "display" "grid") (d "gap" "1rem") (d "align-content" "center") (d "justify-items" "center") (d "padding" "3.25rem 1.75rem 2.25rem") (d "background-color" (v "sunken")) (d "background-image" "linear-gradient(to right,rgba(255,90,168,.08) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,90,168,.08) 1px,transparent 1px)") (d "background-size" "20px 20px") (d "border-bottom" (str "1px solid " (v "line-strong")))])
   (c/media "(min-width: 900px)" [(r ".hero-art" [(d "border-bottom" "0") (d "border-right" (str "1px solid " (v "line-strong")))])])
   (r ".hero-art::before" [(d "content" "\"FIG-01 · LEON\"") (d "position" "absolute") (d "top" "12px") (d "left" "14px") (d "font" (str "700 .65rem/1 " (mono))) (d "letter-spacing" ".1em") (d "color" (v "signal"))])
   (r ".hero .stack" [(d "padding" "2.75rem 2.25rem") (d "display" "flex") (d "flex-direction" "column") (d "justify-content" "center")])
   (c/media "(max-width: 639px)" [(r ".hero .stack" [(d "padding" "1.75rem 1.25rem")])])
   (r ".hero-badges" [(d "display" "flex") (d "flex-wrap" "wrap") (d "gap" "8px")])
   (r ".pill" [(d "display" "inline-flex") (d "align-items" "center") (d "gap" "6px") (d "padding" "4px 10px") (d "font" (str "600 .72rem/1.2 " (mono))) (d "background" (v "surface-hi")) (d "border" (str "1px solid " (v "line-strong"))) (d "color" (v "ink-2")) (d "text-transform" "uppercase")])
   (r ".pill.hot" [(d "background" (v "signal-wash")) (d "border-color" (v "signal")) (d "color" (v "signal-soft"))])
   (r ".cmd" [(d "display" "flex") (d "align-items" "center") (d "justify-content" "space-between") (d "gap" "12px") (d "padding" "0 0 0 14px") (d "height" "44px") (d "background" (v "inset")) (d "border" (str "1px solid " (v "signal"))) (d "border-left" (str "4px solid " (v "signal"))) (d "max-width" "36rem")])
   (r ".install" [(d "display" "grid") (d "grid-template-columns" "minmax(0,1fr)") (d "gap" ".5rem")])
   (r ".install .micro a" [(d "color" (v "signal-soft"))])
   (r ".cmd code" [(d "flex" "1") (d "min-width" "0") (d "font-size" ".875rem") (d "color" (v "ink")) (d "overflow-x" "auto") (d "white-space" "nowrap")])
   (r ".cmd .sigil" [(d "color" (v "signal")) (d "user-select" "none") (d "font-weight" "700")])
   (r ".copy" [(d "flex" "none") (d "height" "100%") (d "padding" "0 16px") (d "border" "0") (d "border-left" (str "1px solid " (v "signal"))) (d "background" (v "signal")) (d "color" "#0b080d") (d "font" (str "800 .72rem/1 " (mono))) (d "text-transform" "uppercase") (d "letter-spacing" ".1em") (d "cursor" "pointer")])
   (r ".copy:hover" [(d "background" (v "signal-soft"))])
   (r ".status" [(d "max-width" "40rem") (d "padding" ".75rem 1rem") (d "border" (str "1px solid " (v "line-strong"))) (d "border-left" (str "3px solid " (v "signal"))) (d "background" (v "surface")) (d "font-size" ".875rem") (d "line-height" "1.55") (d "color" (v "ink-2"))])
   (r ".status a" [(d "white-space" "nowrap") (d "color" (v "signal-soft"))])
   (r ".hero .toc" [(d "margin-bottom" "0")])
   (r ".status b" [(d "color" (v "signal-soft")) (d "font-weight" "600")])
   (r ".facts a" [(d "color" (v "ink-3"))])
   (r ".notice" [(d "padding" ".7rem 1rem") (d "border" (str "1px solid " (v "line-strong"))) (d "background" (v "inset")) (d "font-size" ".875rem") (d "line-height" "1.55") (d "color" (v "ink-2"))])
   (r ".facts" [(d "display" "grid") (d "gap" "8px") (d "padding" "1rem 0 0") (d "border-top" (str "1px solid " (v "line"))) (d "list-style" "none")])
   (c/media "(min-width: 640px)" [(r ".facts" [(d "grid-template-columns" "repeat(3,minmax(0,1fr))") (d "gap" "16px")])])
   (r ".facts li" [(d "font" (str ".76rem/1.45 " (mono))) (d "color" (v "ink-3"))])
   (r ".facts li b" [(d "display" "block") (d "font-size" ".95rem") (d "color" (v "signal")) (d "font-weight" "700")])]

fn panels -> (List c/Rule)
  [(r ".grid" [(d "display" "grid") (d "grid-template-columns" "minmax(0,1fr)") (d "gap" "1px") (d "background" (v "line-strong")) (d "border" "0") (d "overflow" "hidden")])
   (c/media "(min-width: 768px)" [(r ".grid.two" [(d "grid-template-columns" "repeat(2,minmax(0,1fr))")]) (r ".grid.three" [(d "grid-template-columns" "repeat(3,minmax(0,1fr))")]) (r ".grid.four" [(d "grid-template-columns" "repeat(2,minmax(0,1fr))")])])
   (c/media "(min-width: 1024px)" [(r ".grid.four" [(d "grid-template-columns" "repeat(4,minmax(0,1fr))")])])
   (r ".cell" [(d "background" (v "surface")) (d "padding" "1.75rem") (d "display" "grid") (d "grid-template-columns" "minmax(0,1fr)") (d "gap" ".85rem") (d "align-content" "start") (d "position" "relative")])
   (r ".cell .n" [(d "font" (str "700 .7rem/1 " (mono))) (d "color" (v "signal-soft")) (d "letter-spacing" ".08em") (d "text-transform" "uppercase")])
   (r ".cell p" [(d "color" (v "ink-2")) (d "font-size" ".92rem")])
   (r ".cell .cost" [(d "font" (str ".75rem/1.5 " (mono))) (d "color" (v "signal-soft")) (d "padding-top" ".75rem") (d "border-top" (str "1px dashed " (v "line-strong")))])
   (r ".cell pre" [(d "background" (v "inset")) (d "border" (str "1px solid " (v "line"))) (d "border-left" (str "3px solid " (v "signal"))) (d "padding" ".85rem 1rem") (d "font-size" ".8rem") (d "line-height" "1.55") (d "overflow-x" "auto") (d "color" (v "ink"))])
   (r ".cell.active" [(d "box-shadow" (str "inset 0 3px 0 " (v "signal")))])
   (r ".dim" [(d "display" "block") (d "width" "100%") (d "height" "10px") (d "fill" "none") (d "stroke" (v "line-strong")) (d "stroke-width" "1.5")])
   (r ".dim path" [(d "vector-effect" "non-scaling-stroke")])
   (r ".cell.active .dim" [(d "stroke" (v "signal"))])
   (r ".cell.active .count" [(d "color" (v "signal"))])
   (r ".count" [(d "font" (str "800 2.5rem/1 " (mono))) (d "letter-spacing" "-.04em") (d "font-variant-numeric" "tabular-nums")])
   (r ".eco-stats" [(d "display" "grid") (d "grid-template-columns" "repeat(2,minmax(0,1fr))") (d "gap" "1px") (d "background" (v "line-strong")) (d "border-bottom" (str "1px solid " (v "line-strong")))])
   (c/media "(min-width: 768px)" [(r ".eco-stats" [(d "grid-template-columns" "repeat(4,minmax(0,1fr))")])])
   (r ".eco-stat" [(d "background" (v "sunken")) (d "box-shadow" (str "inset 0 2px 0 " (v "signal"))) (d "padding" "1.25rem 1.5rem") (d "display" "grid") (d "gap" ".3rem")])
   (r ".eco-stat b" [(d "font" (str "700 1.15rem/1.2 " (sans))) (d "color" (v "signal")) (d "letter-spacing" "-.02em") (d "font-variant-numeric" "tabular-nums")])
   (r ".pkg-tags" [(d "display" "flex") (d "flex-wrap" "wrap") (d "gap" "6px") (d "padding-top" ".5rem")])
   (r ".pkg" [(d "font" (str "600 .68rem/1.2 " (mono))) (d "padding" "3px 7px") (d "background" (v "inset")) (d "border" (str "1px solid " (v "line-strong"))) (d "color" (v "signal-soft")) (d "text-transform" "uppercase") (d "letter-spacing" ".04em")])
   (r ".note" [(d "padding" "1rem 2rem") (d "border-top" (str "1px solid " (v "line-strong"))) (d "background" (v "sunken")) (d "font" (str ".78rem/1.55 " (mono))) (d "color" (v "ink-3"))])
   (r ".steps" [(d "list-style" "none") (d "padding" "0") (d "display" "grid") (d "gap" "1px") (d "background" (v "line-strong"))])
   (r ".steps li" [(d "background" (v "surface")) (d "padding" "1.15rem 2rem") (d "display" "grid") (d "grid-template-columns" "minmax(0,1fr)") (d "gap" ".5rem") (d "align-items" "baseline")])
   (c/media "(min-width: 768px)" [(r ".steps li" [(d "grid-template-columns" "minmax(18rem,24rem) 1fr") (d "gap" "1.5rem")])])
   (r ".steps code" [(d "font-size" ".8125rem") (d "color" (v "signal")) (d "font-weight" "600") (d "overflow-wrap" "anywhere")])
   (r ".steps span" [(d "color" (v "ink-2")) (d "font-size" ".92rem")])
   (r ".proof" [(d "display" "grid") (d "gap" "1px") (d "background" (v "line-strong")) (d "border-top" (str "1px solid " (v "line-strong")))])
   (c/media "(min-width: 768px)" [(r ".proof" [(d "grid-template-columns" "repeat(4,1fr)")])])
   (r ".proof div" [(d "background" (v "sunken")) (d "padding" "1.35rem 1.75rem") (d "display" "grid") (d "gap" ".35rem")])
   (r ".proof b" [(d "font" (str "800 1.55rem/1.1 " (mono))) (d "letter-spacing" "-.02em") (d "font-variant-numeric" "tabular-nums")])
   (r ".proof b.live" [(d "color" (v "signal"))])
   (r ".body>.toc" [(d "margin" "0") (d "padding" "1.25rem 1.75rem")])]

fn prose -> (List c/Rule)
  [(r ".prose" [(d "max-width" "48rem") (d "font-size" "1.02rem") (d "line-height" "1.75") (d "color" (v "ink-2"))])
   (r ".prose>*+*" [(d "margin-top" "1.15em")])
   (r ".prose h1" [(d "font-family" (sans)) (d "font-size" "clamp(1.9rem,2.2vw + 1rem,2.7rem)") (d "line-height" "1.08") (d "letter-spacing" "-.03em") (d "color" (v "ink")) (d "font-weight" "700")])
   (r ".prose h2" [(d "font-family" (sans)) (d "margin-top" "2.4em") (d "font-size" "1.4rem") (d "line-height" "1.25") (d "letter-spacing" "-.02em") (d "color" (v "ink")) (d "font-weight" "700") (d "border-bottom" (str "1px solid " (v "line"))) (d "padding-bottom" ".4em")])
   (r ".prose h3" [(d "font-family" (sans)) (d "margin-top" "1.8em") (d "font-size" "1.08rem") (d "color" (v "signal-soft")) (d "font-weight" "700")])
   (r ".prose strong" [(d "color" (v "ink")) (d "font-weight" "600")])
   (r ".prose ul,.prose ol" [(d "padding-left" "1.25rem")])
   (r ".prose li+li" [(d "margin-top" ".4em")])
   (r ".prose :not(pre)>code" [(d "font-size" ".875em") (d "padding" ".1em .35em") (d "background" (v "inset")) (d "border" (str "1px solid " (v "line-strong"))) (d "color" (v "signal-soft"))])
   (r ".prose pre" [(d "background" (v "inset")) (d "border" (str "1px solid " (v "line-strong"))) (d "border-left" (str "3px solid " (v "signal"))) (d "padding" "1rem 1.1rem") (d "font-size" ".8125rem") (d "line-height" "1.65") (d "overflow-x" "auto") (d "color" (v "ink"))])
   (r ".prose blockquote" [(d "border-left" (str "3px solid " (v "signal"))) (d "padding-left" "1rem") (d "color" (v "ink-2"))])
   (r ".prose .tablewrap" [(d "overflow-x" "auto") (d "border" (str "1px solid " (v "line-strong")))])
   (r ".prose table" [(d "border-collapse" "collapse") (d "width" "100%") (d "font-size" ".875rem")])
   (r ".prose th,.prose td" [(d "padding" ".6rem .8rem") (d "border-bottom" (str "1px solid " (v "line"))) (d "text-align" "left") (d "vertical-align" "top")])
   (r ".prose th" [(d "color" (v "signal-soft")) (d "font" (str "700 .75rem/1.4 " (mono))) (d "text-transform" "uppercase") (d "letter-spacing" ".06em") (d "background" (v "inset"))])
   (r ".prose hr" [(d "border" "0") (d "border-top" (str "1px dashed " (v "line-strong")))])
   (r ".page" [(d "padding" "3.5rem 2.25rem 5rem")])
   (c/media "(max-width: 639px)" [(r ".page" [(d "padding" "2rem 1.25rem 3.5rem")])])
   (r ".byline" [(d "display" "flex") (d "flex-wrap" "wrap") (d "gap" "6px 16px") (d "margin" "1rem 0 2.5rem") (d "font" (str ".8125rem/1.5 " (mono))) (d "color" (v "ink-3"))])
   (r ".posts" [(d "list-style" "none") (d "padding" "0") (d "display" "grid") (d "gap" "1px") (d "background" (v "line-strong")) (d "border" (str "1px solid " (v "line-strong")))])
   (r ".posts li" [(d "background" (v "surface"))])
   (r ".posts a" [(d "display" "grid") (d "gap" ".4rem") (d "padding" "1.25rem 1.5rem") (d "text-decoration" "none")])
   (r ".posts a:hover h3" [(d "color" (v "signal"))])
   (r ".posts p" [(d "color" (v "ink-2")) (d "font-size" ".9375rem")])
   (r ".toc" [(d "display" "flex") (d "flex-wrap" "wrap") (d "gap" "6px") (d "padding" "0") (d "list-style" "none") (d "margin-bottom" "2.5rem")])
   (r ".prose .toc" [(d "padding-left" "0")])
   (r ".toc a" [(d "display" "inline-block") (d "padding" "6px 11px") (d "border" (str "1px solid " (v "line-strong"))) (d "font" (str "600 .72rem/1.2 " (mono))) (d "text-transform" "uppercase") (d "letter-spacing" ".06em") (d "text-decoration" "none") (d "color" (v "ink-2")) (d "background" (v "surface"))])
   (r ".toc a:hover" [(d "color" "#0b080d") (d "border-color" (v "signal")) (d "background" (v "signal"))])]

fn mascot -> (List c/Rule)
  [(r ".cham" [(d "display" "block") (d "fill" "none") (d "stroke" (v "signal")) (d "stroke-linecap" "round") (d "stroke-linejoin" "round") (d "overflow" "visible")])
   (r ".cham .branch" [(d "stroke" (v "signal-soft")) (d "stroke-opacity" ".68")])
   (r ".cham .branch-dash" [(d "stroke" (v "signal-soft")) (d "stroke-opacity" ".42") (d "stroke-dasharray" "5 5") (d "stroke-width" "2.4")])
   (r ".cham .leaf" [(d "stroke" (v "signal-soft")) (d "stroke-opacity" ".65") (d "fill" (v "signal-wash"))])
   (r ".leon" [(d "position" "relative") (d "width" "100%") (d "aspect-ratio" "1/1")])
   (r ".leon-swing" [(d "position" "absolute") (d "inset" "0") (d "transform-origin" "38% 73%") (d "animation" "leon-breathe 4.2s ease-in-out infinite")])
   (r ".leon-art" [(d "display" "block") (d "width" "100%") (d "height" "100%")])
   (r ".leon-lids" [(d "position" "absolute") (d "inset" "0") (d "width" "100%") (d "height" "100%") (d "pointer-events" "none")])
   (r ".leon-lid" [(d "fill" (v "leon-skin")) (d "transform-box" "fill-box") (d "transform-origin" "50% 0") (d "transform" "scaleY(0)") (d "animation" "leon-blink 5.6s ease-in-out infinite")])
   (r ".leon-lash" [(d "fill" "none") (d "stroke" (v "leon-line")) (d "stroke-width" "9") (d "stroke-linecap" "round") (d "opacity" "0") (d "animation" "leon-lash 5.6s ease-in-out infinite")])
   (r "[data-rest=air] .leon-swing" [(d "animation" "none")])
   (r "[data-rest=branch] .leon-swing,[data-rest=foot] .leon-swing" [(d "animation" "leon-land 1.2s ease-out,leon-breathe 4.2s ease-in-out 1.2s infinite")])
   (c/keyframes "leon-breathe" [(pair "0%,100%" [(d "transform" "rotate(0deg) scale(1)")]) (pair "50%" [(d "transform" "rotate(-1.6deg) scale(1.018)")])])
   (c/keyframes "leon-land" [(pair "0%" [(d "transform" "rotate(-16deg) scale(.94,1.06)")]) (pair "30%" [(d "transform" "rotate(10deg) scale(1.04,.96)")]) (pair "55%" [(d "transform" "rotate(-6deg)")]) (pair "78%" [(d "transform" "rotate(3deg)")]) (pair "100%" [(d "transform" "rotate(0deg)")])])
   (c/keyframes "leon-blink" [(pair "0%,91%,100%" [(d "transform" "scaleY(0)")]) (pair "94%,97%" [(d "transform" "scaleY(1)")])])
   (c/keyframes "leon-lash" [(pair "0%,92%,99%,100%" [(d "opacity" "0")]) (pair "94%,97%" [(d "opacity" "1")])])
   (r ".leon-dock" [(d "width" "100%") (d "max-width" "300px") (d "aspect-ratio" "1/1") (d "position" "relative") (d "border" (str "1px dashed " (v "line-strong")))])
   (r ".leon-dock .micro" [(d "position" "absolute") (d "left" "0") (d "top" "calc(100% + .5rem)")])
   (r ".vine-trunk" [(d "stroke" (v "signal-soft")) (d "stroke-width" "3.6") (d "stroke-linecap" "round") (d "opacity" ".72")])
   (r ".vine-branch" [(d "stroke" (v "signal-soft")) (d "stroke-width" "3.0") (d "stroke-linecap" "round") (d "opacity" ".78")])
   (r ".vine-dash" [(d "stroke" (v "signal")) (d "stroke-width" "1.3") (d "stroke-dasharray" "4 4") (d "opacity" ".48")])
   (r ".vine-leaf" [(d "stroke" (v "signal-soft")) (d "stroke-width" "1.2") (d "fill" (v "signal-wash")) (d "opacity" ".72")])
   (r ".cosmic-bg" [(d "position" "fixed") (d "inset" "0") (d "pointer-events" "none") (d "z-index" "30") (d "overflow" "hidden")])
   (r ".chameleon-perch" [(d "position" "fixed") (d "top" "0") (d "left" "0") (d "width" "150px") (d "transform" "translate(6px,60px)") (d "pointer-events" "auto") (d "z-index" "46") (d "will-change" "transform,width")])
   (c/media "(max-width: 639px)" [(r ".chameleon-perch" [(d "width" "64px") (d "transform" "translate(2px,60px)")])])
   (r ".easter-stream" [(d "position" "fixed") (d "top" "0") (d "bottom" "0") (d "width" "180px") (d "height" "100vh") (d "pointer-events" "none") (d "overflow" "visible") (d "opacity" ".68")])
   (r ".easter-stream.left" [(d "left" "0")])
   (r ".easter-stream.right" [(d "right" "0")])
   (c/media "(max-width: 1023px)" [(r ".easter-stream" [(d "opacity" ".32") (d "width" "120px")])])
   (r ".egg-item" [(d "stroke" (v "signal-soft")) (d "stroke-width" "1.25") (d "fill" (v "signal-wash")) (d "will-change" "transform,opacity")])
   (r ".egg-dash" [(d "stroke-dasharray" "3 3") (d "fill" "none")])
   (r ".egg-arc" [(d "stroke" (v "signal")) (d "stroke-width" "1.2") (d "stroke-dasharray" "5 4") (d "opacity" ".32") (d "fill" "none")])
   (r ".egg-txt" [(d "font" (str "600 6.5px/1 " (mono))) (d "fill" (v "signal-soft")) (d "stroke" "none") (d "letter-spacing" ".06em") (d "opacity" ".78")])
   (r ".cham .band" [(d "stroke" (v "signal-soft")) (d "stroke-opacity" ".62")])
   (r ".cham .eye" [(d "fill" "none") (d "stroke" (v "signal"))])
   (r ".cham .iris" [(d "fill" "none") (d "stroke" (v "signal-soft"))])
   (r ".cham .pupil" [(d "fill" (v "signal")) (d "stroke" "none")])
   (r ".cham.small" [(d "width" "28px") (d "height" "28px")])
   (r ".cham.large" [(d "width" "100%") (d "max-width" "320px") (d "height" "auto") (d "object-fit" "contain") (d "margin" "0 auto") (d "filter" (str "drop-shadow(0 14px 32px " (v "signal-glow") ")"))])]

fn sheet -> (List c/Rule)
  (listAppend (tokenRules) (listAppend (base) (listAppend (layout) (listAppend (chrome) (listAppend (type) (listAppend (hero) (listAppend (panels) (listAppend (prose) (mascot)))))))))

fn stylesheet -> String
  (c/renderSheet (sheet))
