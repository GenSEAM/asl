(:package aslSite
 :version "0.2.0"
 :entry "site/main.asl"
 :description "aslang.dev as an ASL program: typed markup, styles as data and the event update, compiled to wasm32 and prerendered"
 :aslFirst true
 :modules [
   "aslSite/main"
   "aslSite/ui/html"
   "aslSite/ui/css"
   "aslSite/ui/bridge"
   "aslSite/ui/markdown"
   "aslSite/app/theme"
   "aslSite/app/msg"
   "aslSite/app/layout"
   "aslSite/app/home"
   "aslSite/app/docs"
   "aslSite/app/blog"
   "aslSite/app/update"
   "aslSite/tools/build"
   "aslSite/tools/posts"
   "aslSite/tools/feeds"
 ]
 :dependencies ["asl-parser" "asl-ir" "asl-target-llvm"])
