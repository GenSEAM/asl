(:stylesheet
  :version "1.0.0"
  :frame "Instrumented Editorial"
  :widthPolicy [
    (:primary-shell "72rem")
    (:prose-measure "68ch")
    (:wide-surface "80rem")
  ]
  :tailwind [:base :components :utilities]
  :layers [
    (:layer
      :name "base"
      :themes [
        (:theme
          :selector ":root"
          :tokens [
            (:ground "248 247 252")
            (:sunken "238 235 245")
            (:surface "255 255 255")
            (:inset "244 242 248")
            (:line "225 219 236")
            (:line-strong "146 128 176")
            (:ink "24 18 36")
            (:ink-2 "76 64 96")
            (:ink-3 "112 98 134")
            (:signal "126 34 206")
            (:signal-soft "147 51 234")
            (:shadow-hue "270 25% 10%")
            (:shadow-strength "0.08")
          ])
        (:theme
          :selector ".dark"
          :tokens [
            (:ground "12 9 20")
            (:sunken "4 2 7")
            (:surface "24 19 39")
            (:inset "17 13 29")
            (:line "48 38 72")
            (:line-strong "136 102 198")
            (:ink "246 244 255")
            (:ink-2 "198 183 253")
            (:ink-3 "152 140 175")
            (:signal "176 96 255")
            (:signal-soft "198 142 255")
            (:shadow-hue "270 50% 5%")
            (:shadow-strength "0.65")
          ])
      ]
      :rules [
        (:rule
          :selector "html"
          :declarations [
            (:scroll-behavior "smooth")
            (:scroll-padding-top "6rem")
            (:width "100%")
            (:max-width "100vw")
            (:overflow-x "hidden")
          ])
        (:rule
          :selector "body"
          :declarations [
            (:margin "0")
            (:width "100%")
            (:max-width "100vw")
            (:background-color "rgb(var(--ground))")
            (:color "rgb(var(--ink))")
            (:font-family "'Inter', system-ui, -apple-system, sans-serif")
            (:overflow-x "hidden")
            (:-webkit-font-smoothing "antialiased")
            (:text-rendering "optimizeLegibility")
          ])
        (:rule
          :selector "code, pre, .font-mono"
          :declarations [
            (:font-family "'Fira Code', 'SFMono-Regular', Menlo, Monaco, Consolas, monospace")
            (:font-variant-ligatures "none")
          ])
        (:rule
          :selector ":focus-visible"
          :declarations [
            (:outline "2px solid rgb(var(--signal))")
            (:outline-offset "3px")
            (:border-radius "4px")
          ])
        (:rule
          :selector "::selection"
          :declarations [
            (:background "rgb(var(--signal) / 0.18)")
            (:color "rgb(var(--ink))")
          ])
        (:rule
          :selector "::-webkit-scrollbar"
          :declarations [
            (:width "8px")
            (:height "8px")
          ])
        (:rule
          :selector "::-webkit-scrollbar-track"
          :declarations [
            (:background "rgb(var(--ground))")
          ])
        (:rule
          :selector "::-webkit-scrollbar-thumb"
          :declarations [
            (:background "rgb(var(--line-strong) / 0.35)")
            (:border-radius "999px")
          ])
        (:rule
          :selector "::-webkit-scrollbar-thumb:hover"
          :declarations [
            (:background "rgb(var(--signal))")
          ])
      ])
    (:layer
      :name "components"
      :rules [
        (:rule
          :selector ".rule-hairline"
          :declarations [
            (:height "1px")
            (:background "rgb(var(--line))")
          ])
      ])
  ]
  :media [
    (:media-query
      :condition "(prefers-reduced-motion: reduce)"
      :rules [
        (:rule
          :selector "html"
          :declarations [
            (:scroll-behavior "auto")
          ])
        (:rule
          :selector "*, *::before, *::after"
          :declarations [
            (:animation-duration "0.01ms !important")
            (:animation-iteration-count "1 !important")
            (:transition-duration "0.01ms !important")
          ])
      ])
  ]
  :widthPolicy [
    (:shell "72rem" "Primary reading shell")
    (:canvas "80rem" "Wide data canvas opt-in")
    (:prose "68ch" "Prose reading measure")
  ]
)
