(:stylesheet
  :version "1.0.0"
  :frame "Instrumented Editorial"
  :widthPolicy [
    (:primaryShell "72rem")
    (:proseMeasure "68ch")
    (:wideSurface "80rem")
  ]
  :tailwind [:base :components :utilities]
  :layers [
    (:layer
      :name "base"
      :themes [
        (:theme
          :selector ":root"
          :tokens [
            (:ground "248 247 252")
            (:sunken "238 235 245")
            (:surface "255 255 255")
            (:inset "244 242 248")
            (:line "225 219 236")
            (:lineStrong "146 128 176")
            (:ink "24 18 36")
            (:ink2 "76 64 96")
            (:ink3 "112 98 134")
            (:signal "126 34 206")
            (:signalSoft "147 51 234")
            (:shadowHue "270 25% 10%")
            (:shadowStrength "0.08")
          ])
        (:theme
          :selector ".dark"
          :tokens [
            (:ground "12 9 20")
            (:sunken "4 2 7")
            (:surface "24 19 39")
            (:inset "17 13 29")
            (:line "48 38 72")
            (:lineStrong "136 102 198")
            (:ink "246 244 255")
            (:ink2 "198 183 253")
            (:ink3 "152 140 175")
            (:signal "176 96 255")
            (:signalSoft "198 142 255")
            (:shadowHue "270 50% 5%")
            (:shadowStrength "0.65")
          ])
      ]
      :rules [
        (:rule
          :selector "html"
          :declarations [
            (:scrollBehavior "smooth")
            (:scrollPaddingTop "6rem")
            (:width "100%")
            (:maxWidth "100vw")
            (:overflowX "hidden")
          ])
        (:rule
          :selector "body"
          :declarations [
            (:margin "0")
            (:width "100%")
            (:maxWidth "100vw")
            (:backgroundColor "rgb(var(--ground))")
            (:color "rgb(var(--ink))")
            (:fontFamily "'Inter', system-ui, -apple-system, sans-serif")
            (:overflowX "hidden")
            (:-webkitFontSmoothing "antialiased")
            (:textRendering "optimizeLegibility")
          ])
        (:rule
          :selector "code, pre, .font-mono"
          :declarations [
            (:fontFamily "'Fira Code', 'SFMono-Regular', Menlo, Monaco, Consolas, monospace")
            (:fontVariantLigatures "none")
          ])
        (:rule
          :selector ":focus-visible"
          :declarations [
            (:outline "2px solid rgb(var(--signal))")
            (:outlineOffset "3px")
            (:borderRadius "4px")
          ])
        (:rule
          :selector "::selection"
          :declarations [
            (:background "rgb(var(--signal) / 0.18)")
            (:color "rgb(var(--ink))")
          ])
        (:rule
          :selector "::-webkit-scrollbar"
          :declarations [
            (:width "8px")
            (:height "8px")
          ])
        (:rule
          :selector "::-webkit-scrollbar-track"
          :declarations [
            (:background "rgb(var(--ground))")
          ])
        (:rule
          :selector "::-webkit-scrollbar-thumb"
          :declarations [
            (:background "rgb(var(--line-strong) / 0.35)")
            (:borderRadius "999px")
          ])
        (:rule
          :selector "::-webkit-scrollbar-thumb:hover"
          :declarations [
            (:background "rgb(var(--signal))")
          ])
      ])
    (:layer
      :name "components"
      :rules [
        (:rule
          :selector ".rule-hairline"
          :declarations [
            (:height "1px")
            (:background "rgb(var(--line))")
          ])
      ])
  ]
  :media [
    (:mediaQuery
      :condition "(prefers-reduced-motion: reduce)"
      :rules [
        (:rule
          :selector "html"
          :declarations [
            (:scrollBehavior "auto")
          ])
        (:rule
          :selector "*, *::before, *::after"
          :declarations [
            (:animationDuration "0.01ms !important")
            (:animationIterationCount "1 !important")
            (:transitionDuration "0.01ms !important")
          ])
      ])
  ]
  :widthPolicy [
    (:shell "72rem" "Primary reading shell")
    (:canvas "80rem" "Wide data canvas opt-in")
    (:prose "68ch" "Prose reading measure")
  ]
)
