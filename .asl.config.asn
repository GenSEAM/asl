(:aslConfig
  :workspace "asl"
  :version "0.1.0"
  :pureAsl true
  :aslFirst true
  :projections [
    (:proj :from "package.asn" :to "package.json" :format "json" :doc "Root ASL NPM manifest")
    (:proj :from "wrangler.asn" :to "wrangler.toml" :format "toml" :doc "Cloudflare Workers configuration")
  ]
  :ignore [
    "scratch/**"
    "tmp/**"
    ".asl/cache/**"
    ".asl/log/**"
    "**/.system_generated/**"
    "**/*.tmp"
    "bench/*.lock"
    "grammar/*.lock"
    "prelude/*.lock"
    ".pre-commit-config.yaml"
    "**/pnpm-lock.yaml"
    "**/package-lock.json"
    "**/pnpm-workspace.yaml"
    "web/dist/**"
  ]
  :gates [1 2 3 4 5 6 7]
  :tokenBaseline 2
  :telemetry (:targetTurnMs 100 :maxTokenCeiling 150)
  :daemon (:resident true :memoryIndex true :maxFiles 2000)
  :coverage (
    :desired 75.0
    :minAssertions 2
    :strictPolarity false
    :discountZeroAsserts true
    :coreDesired 100.0
    :corePackages ["packages/asl-compiler" "packages/asl-parser" "packages/asl-codec" "packages/asl-lint" "packages/asl-gates" "packages/asl-pack"]
    :exclude ["examples/**" "asl-arduino/**" "asl-quantum/**"]
  )
  :tasks [
    (:task :name "project" :cmd "asl project" :doc "Transpile all declared ASN projections to host targets")
    (:task :name "gate" :cmd "asl gate" :doc "Run full 7-gate pure ASL verification")
    (:task :name "test" :cmd "asl test" :doc "Run native ASL test suites")
    (:task :name "coverage" :cmd "asl coverage" :doc "Audit native function test coverage")
    (:task :name "telemetry" :cmd "asl telemetry" :doc "Collect performance telemetry and token metrics")
    (:task :name "web:build" :cmd "sh web/build.sh" :doc "Prerender aslang.dev and compile web/site to site.wasm into web/dist")
    (:task :name "web:test" :cmd "asl test web/tests" :doc "Run the site's ASL test suites")
  ])
